Use DataDict.pkg

Open StatLog
Open DFLastID

Class cStatLogDataDictionary is a DataDictionary

    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to StatLog.File_Number

        Set Add_System_File to DFLastID.File_Number DD_Lock_On_All

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Auto_Increment Field StatLog.ID to File_Field DFLastID.StatLogID

    End_Procedure

    // A torn StatLog save (the "Duplicate records" family the logger retries around - see
    // cRefactorStatusLog.Error_Report) can leave an index key whose DATA record never landed:
    // the error-log grid then shows a phantom row, and deleting it faults err 25 "Record not
    // found" when the delete re-finds by record id (Nils's run 2026-07-11). The user's
    // intent - "this row gone" - is already true on disk, so a missing record is a no-op, not
    // an error: clear the buffer instead (the grid's post-delete refresh drops the row).
    Procedure Request_Delete
        Boolean bOnDisk
        RowID riRec
        Move False to bOnDisk
        Get CurrentRowId to riRec
        If (not(IsNullRowId(riRec))) ;
            Move (FindByRowId(StatLog.File_Number, riRec)) to bOnDisk
        If (bOnDisk = False) Begin
            Send Request_Clear
            Procedure_Return
        End
        Forward Send Request_Delete
    End_Procedure

End_Class
