//Use cRefactorApplication.pkg
Use DataDict.pkg
Use cRDCAutoCreateNewID.pkg
Use cRefactorApplication.pkg
Use cFolderSelDtlDataDictionary.dd

Open SysFile
Open FolderSelHeaA
Open FolderSelHea
Open DFLastID

Set_Attribute DF_FILE_ALIAS  of FolderSelHeaA.File_Number to DF_FILE_IS_ALIAS

Class cFolderSelHeaDataDictionary is a DataDictionary

    Import_Class_Protocol cRDCAutoCreateNewIDMixin

    Procedure Construct_Object
        Forward Send Construct_Object

        Property Integer piLastErr 0
        Property Boolean pbErr False
        // A batch run's folder ticks, and what puts them back (ApplyBatchFolderTicks / RestoreBatchFolderTicks).
        Property Integer   piBatchHeaderID 0
        Property Integer[] paiBatchTickedBefore
        Property Integer[] paiBatchAdded

        Set Main_File to FolderSelHea.File_Number

        Set Add_Client_File to FolderSelDtl.File_Number

        Set Add_System_File to SysFile.File_Number DD_Lock_On_All
        Set Add_System_File to DFLastID.File_Number DD_Lock_On_All
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Auto_Increment Field FolderSelHea.ID to File_Field DFLastID.FolderSelHeaID

        Set Field_Label_Long Field FolderSelHea.UserName to "User Name"
        Set Field_Label_Short Field FolderSelHea.UserName to "User Name"
        Set Field_Class_Name Field FolderSelHea.UserName to "Form"

        Set Field_Label_Long Field FolderSelHea.WorkspaceHomeFolder to "Home Folder"
        Set Field_Label_Short Field FolderSelHea.WorkspaceHomeFolder to "Home Folder"

    End_Procedure

    Procedure Creating
        Integer iID
        Forward Send Creating
        Get psUserName of ghoApplication to FolderSelHea.UserName
//        Get AutoCreateNewID File_Field FolderSelHea.ID True to iID
    End_Procedure

    Procedure SaveErrorState
        Set piLastErr to LastErr
        If (Err = True) Begin
            Set pbErr to True
        End
        Else Begin
            Set pbErr to False
        End
        Move False to Err
        Move 0 to LastErr
    End_Procedure

    Procedure RestoreErrorState
        Get piLastErr to LastErr
        If (pbErr(Self)) Begin
            Move True to Err
        End
        Else Begin
            Move False to Err
        End
    End_Procedure

    Function TotalFolders Returns Integer
        Clear FolderSelHeaA
        Get psHomeTarget  of ghoApplication to FolderSelHeaA.WorkspaceHomeFolder
        Get  psUsername of ghoApplication to FolderSelHeaA.UserName
        Find eq FolderSelHeaA.WorkspaceHomeFolder
        If (Found = False) Begin
            Function_Return 0
        End
        Function_Return FolderSelHeaA.TotalFolders
    End_Function

    Function TotalSelectedFolders Returns Integer
        Clear FolderSelHeaA
        Get psHomeTarget  of ghoApplication to FolderSelHeaA.WorkspaceHomeFolder
        Get  psUsername of ghoApplication to FolderSelHeaA.UserName
        Find eq FolderSelHeaA.WorkspaceHomeFolder
        If (Found = False) Begin
            Function_Return 0
        End
        Function_Return FolderSelHeaA.TotalSelected
    End_Function

    // The PATH twin of TotalSelectedFolders: returns the selected folder names for the CURRENT workspace,
    // self-found by home folder + user through the FolderSelHeaA / FolderSelDtlA ALIASES (so it needs no
    // positioned main buffer and disturbs none). cRefactorApplication calls this to re-sync its
    // pasSelectedFolders cache on every workspace load - keeping SizeOfArray(pasSelectedFolders) in step
    // with TotalSelectedFolders even on load paths (e.g. the dashboard) that never open a folder view.
    Function SelectedFolderPathsByHome Returns String[]
        String[] asFolders asEmpty
        Integer iItem
        Clear FolderSelHeaA
        Get psHomeTarget  of ghoApplication to FolderSelHeaA.WorkspaceHomeFolder
        Get  psUsername of ghoApplication to FolderSelHeaA.UserName
        Find eq FolderSelHeaA.WorkspaceHomeFolder
        If (Found = False) ;
            Function_Return asEmpty
        Constraint_Set (Self + 11) Clear
        Constrained_Clear eq FolderSelDtlA by Index.1
        Constrain FolderSelDtlA.FolderSelHeaID eq FolderSelHeaA.ID
        Constrained_Find First FolderSelDtlA by Index.1
        Move 0 to iItem
        While (Found)
            If (FolderSelDtlA.bSelected = True) Begin
                Move (Trim(FolderSelDtlA.FolderName)) to asFolders[iItem]
                Increment iItem
            End
            Constrained_Find Next
        Loop
        Function_Return asFolders
    End_Function

    // Returns False if save went all right. bLibInclude=False scans only the
    // workspace home; True also follows the .sws library references.
    Function SaveNewHeaderAndChildRecords String sHomeFolder Boolean bLibInclude Returns Boolean
        Boolean bErr bResult
        Integer iID
        String sUserName

        // Preserve the status of the Err system flag:
        Send SaveErrorState

        Get psUsername of ghoApplication to sUserName
        Clear FolderSelHea
        Move sUserName   to FolderSelHea.UserName
        Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
        Find eq FolderSelHea.WorkspaceHomeFolder
        // If we found a record, there is nothing more to do here:
        If (Found = True) Begin
            Function_Return False
        End

        Reread
            Get AutoCreateNewID File_Field FolderSelHea.ID True to iID
            Clear FolderSelHea
            Move iID to FolderSelHea.ID
            Move sUserName   to FolderSelHea.UserName
            Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
            SaveRecord FolderSelHea
        Unlock

        If (Err = False) Begin
            Get PopulateFolderRecords FolderSelHea.ID sHomeFolder sUserName bLibInclude to bErr
        End

        Move Err to bResult
        Send RestoreErrorState
        Function_Return bResult
    End_Function

    // Discovers the workspace's source folders - the home folder PLUS every
    // folder contributed by the workspace's libraries (followed via the .sws
    // [Libraries]/aDependencies references) - and saves a FolderSelDtl record
    // for each one not already present. Existing rows (and their bSelected
    // state) are left untouched by SaveDetailRecord, so this is safe to re-run
    // as a "refresh". An active FolderSelHea record for iHeaderID is assumed.
    // Returns True if a detail record failed to save.
    { Visibility=Private }
    Function PopulateFolderRecords Integer iHeaderID String sHomeFolder String sUserName Boolean bLibInclude Returns Boolean
        Boolean bErr
        Integer iSize iCount iLibSize iLibIdx
        String sSWSFile sFolder
        String[] asStartFolder asFolderArray asLibFolders

        Move sHomeFolder to asStartFolder[0]

        // When bLibInclude, add each library's source folders as extra scan
        // roots so library source files (outside the home) are discovered too.
        Get psSWSFile of ghoApplication to sSWSFile
        If (bLibInclude = True and sSWSFile <> "") Begin
            Get GetWorkspaceLibrarySourceFolders of ghoApplication sSWSFile to asLibFolders
            Move (SizeOfArray(asLibFolders)) to iLibSize
            Decrement iLibSize
            For iLibIdx from 0 to iLibSize
                Move asLibFolders[iLibIdx] to asStartFolder[SizeOfArray(asStartFolder)]
            Loop
        End

        Get AllSourceFolders of ghoApplication asStartFolder to asFolderArray
        Move (SizeOfArray(asFolderArray)) to iSize
        If (iSize = 0) ;
            Function_Return False
        Decrement iSize
        // Start on 1 because the first one is the "Home" folder.
        For iCount from 1 to iSize
            Move asFolderArray[iCount] to sFolder
            // RecursiveSearchFolders returns each START folder WITH a trailing
            // separator but its subfolders WITHOUT one, so a library root the
            // home scan also finds would be stored twice ("...\cDictionary" and
            // "...\cDictionary\"). Strip the trailing separator so the header-
            // scoped de-dup in SaveDetailRecord collapses the two forms (a
            // library OUTSIDE the home is kept, just normalized - not dropped).
            If (Right(sFolder, 1) = CS_DirSeparator) ;
                Move (Left(sFolder, (Length(sFolder) - 1))) to sFolder
            Get SaveDetailRecord iHeaderID sFolder sUserName False to bErr
            If (bErr = True) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Re-runs folder discovery for the CURRENT workspace. bLibInclude True
    // merges newly found folders (home + libraries) WITHOUT disturbing folders
    // already listed or their selected state. bLibInclude False ALSO removes any
    // folder under a library root (so the list matches the unticked "Include
    // library folders" checkbox); the workspace's own folders and any manually
    // added folders are left alone. Returns the NET change in folder count
    // (positive = added, negative = removed, 0 = no change).
    Function RefreshFolderRecords Boolean bLibInclude Returns Integer
        Boolean bErr
        Integer iBefore iAfter
        String sUserName sHomeFolder

        Get psUsername of ghoApplication to sUserName
        Get psHomeTarget  of ghoApplication to sHomeFolder

        Clear FolderSelHea
        Move sUserName   to FolderSelHea.UserName
        Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
        Find eq FolderSelHea.WorkspaceHomeFolder
        If (Found = False) Begin
            // No header yet: do a normal first-time discovery, then report.
            Get SaveNewHeaderAndChildRecords sHomeFolder bLibInclude to bErr
            Clear FolderSelHea
            Move sUserName   to FolderSelHea.UserName
            Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
            Find eq FolderSelHea.WorkspaceHomeFolder
            Move 0 to iAfter
            If (Found = True) ;
                Move FolderSelHea.TotalFolders to iAfter
            Function_Return iAfter
        End

        Move FolderSelHea.TotalFolders to iBefore

        // Libraries excluded: remove any folder under a library root so the list
        // matches the unticked checkbox (the workspace's own folders and any
        // manually added folders are kept). Re-find afterwards so the home
        // re-scan below sees the corrected counters.
        If (bLibInclude = False) Begin
            Send RemoveLibraryFolders FolderSelHea.ID
            Clear FolderSelHea
            Move sUserName   to FolderSelHea.UserName
            Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
            Find eq FolderSelHea.WorkspaceHomeFolder
        End
        // System folders discovered by an OLDER scan (a name that is now in CS_NoFolderList - DfPkg
        // since 2026-08-18) leave on this explicit re-scan, whatever their tick: they would not be
        // offered today, and their files are skipped as write-protected anyway.
        Send RemoveSystemFolders FolderSelHea.ID
        Clear FolderSelHea
        Move sUserName   to FolderSelHea.UserName
        Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
        Find eq FolderSelHea.WorkspaceHomeFolder

        Get PopulateFolderRecords FolderSelHea.ID sHomeFolder sUserName bLibInclude to bErr

        // Re-find for the authoritative updated total.
        Clear FolderSelHea
        Move sUserName   to FolderSelHea.UserName
        Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
        Find eq FolderSelHea.WorkspaceHomeFolder
        Move iBefore to iAfter
        If (Found = True) ;
            Move FolderSelHea.TotalFolders to iAfter
        Function_Return (iAfter - iBefore)
    End_Function

    // True when sFolder equals sRoot or is nested under it (case-insensitive,
    // separator-aware). A trailing separator on either side is ignored.
    { Visibility=Private }
    Function IsFolderUnderRoot String sFolder String sRoot Returns Boolean
        String sLowFolder sLowRoot
        Move (Lowercase(Trim(sFolder))) to sLowFolder
        Move (Lowercase(Trim(sRoot)))   to sLowRoot
        If (Right(sLowFolder, 1) = CS_DirSeparator) ;
            Move (Left(sLowFolder, (Length(sLowFolder) - 1))) to sLowFolder
        If (Right(sLowRoot, 1) = CS_DirSeparator) ;
            Move (Left(sLowRoot, (Length(sLowRoot) - 1))) to sLowRoot
        If (sLowRoot = "") ;
            Function_Return False
        If (sLowFolder = sLowRoot) ;
            Function_Return True
        If (Left(sLowFolder, (Length(sLowRoot) + 1)) = (sLowRoot + CS_DirSeparator)) ;
            Function_Return True
        Function_Return False
    End_Function

    // True when sFolder is under (or equal to) any root in asRoots.
    { Visibility=Private }
    Function IsFolderUnderAnyRoot String sFolder String[] asRoots Returns Boolean
        Integer iRoots iRoot
        Boolean bUnder
        Move (SizeOfArray(asRoots)) to iRoots
        Decrement iRoots
        For iRoot from 0 to iRoots
            Get IsFolderUnderRoot sFolder asRoots[iRoot] to bUnder
            If (bUnder = True) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Deletes the FolderSelDtl rows for iHeaderID whose folder is under a
    // library source root (from the .sws walk), so unticking "Include library
    // folders" + Re-scan drops the library folders. The workspace's own folders
    // (under the home) and any manually added folders are KEPT. Header counters
    // are recomputed from the surviving rows (the alias Delete bypasses the DD's
    // Deleting handler, so the counts must be fixed up explicitly).
    { Visibility=Private }
    Procedure RemoveLibraryFolders Integer iHeaderID
        Integer iTotal iSelected
        String sSWSFile sFolder sHome
        String[] asLibRoots
        Boolean bUnderLib bUnderHome

        Get psSWSFile of ghoApplication to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get GetWorkspaceLibrarySourceFolders of ghoApplication sSWSFile to asLibRoots
        If (SizeOfArray(asLibRoots) = 0) ;
            Procedure_Return
        Get psHomeTarget of ghoApplication to sHome

        Send SaveErrorState

        Constraint_Set Self Clear
        Constrained_Clear eq FolderSelDtlA by Index.2
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Move (Trim(FolderSelDtlA.FolderName)) to sFolder
            Get IsFolderUnderAnyRoot sFolder asLibRoots to bUnderLib
            Get IsFolderUnderRoot    sFolder sHome     to bUnderHome
            // Remove only true library folders - never the workspace's own.
            If (bUnderLib = True and bUnderHome = False) Begin
                Lock
                    Delete FolderSelDtlA
                Unlock
            End
            Constrained_Find Next
        Loop

        // Recompute the header counters from the surviving rows.
        Move 0 to iTotal
        Move 0 to iSelected
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Increment iTotal
            If (FolderSelDtlA.bSelected = True) ;
                Increment iSelected
            Constrained_Find Next
        Loop

        Clear FolderSelHeaA
        Move iHeaderID to FolderSelHeaA.ID
        Find eq FolderSelHeaA.ID
        If (Found = True) Begin
            Reread FolderSelHeaA
                Move iTotal    to FolderSelHeaA.TotalFolders
                Move iSelected to FolderSelHeaA.TotalSelected
                SaveRecord FolderSelHeaA
            Unlock
        End

        Send RestoreErrorState
    End_Procedure

    /* Deletes the FolderSelDtl rows for iHeaderID whose path has a segment in CS_NoFolderList
       (IsFolderInNoFolderList - the same test RecursiveSearchFolders applies when it discovers
       folders). Needed because that list GROWS: "dfpkg" joined it 2026-08-18, and Nils's WinServ
       selection already held E:\WinServ\DfPkg\...\AppSrc from an earlier scan - 249 read-only
       package files ticked like any other source folder. Runs on the explicit Re-scan Folders,
       never on load; the caller reports the count. Header counters recomputed as in
       RemoveLibraryFolders (the alias Delete bypasses the DD's Deleting handler). */
    { Visibility=Private }
    Procedure RemoveSystemFolders Integer iHeaderID
        Integer iTotal iSelected iHomeLen
        String sFolder sHome sBelowHome
        String[] asNoFolderList
        Boolean bSystem

        Get NoFolderListAsArray of ghoApplication False to asNoFolderList
        Get psHomeTarget of ghoApplication to sHome
        Move (Lowercase(Trim(sHome))) to sHome
        If (sHome <> "" and Right(sHome, 1) <> CS_DirSeparator) ;
            Move (sHome + CS_DirSeparator) to sHome
        Move (Length(sHome)) to iHomeLen

        Send SaveErrorState

        Constraint_Set Self Clear
        Constrained_Clear eq FolderSelDtlA by Index.2
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Move (Trim(FolderSelDtlA.FolderName)) to sFolder
            // Only the segments BELOW the workspace home are judged: a home that itself sits under a
            // folder called Data or Programs (C:\Data\MyApp\...) must not lose its whole list, and a
            // library outside the home is not this rule's business. DfPkg is always under the home.
            Move False to bSystem
            If (iHomeLen > 0 and Left(Lowercase(sFolder), iHomeLen) = sHome) Begin
                Move (Right(sFolder, (Length(sFolder) - iHomeLen))) to sBelowHome
                Get IsFolderInNoFolderList of ghoApplication asNoFolderList sBelowHome to bSystem
            End
            If (bSystem = True) Begin
                Lock
                    Delete FolderSelDtlA
                Unlock
            End
            Constrained_Find Next
        Loop

        Move 0 to iTotal
        Move 0 to iSelected
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Increment iTotal
            If (FolderSelDtlA.bSelected = True) ;
                Increment iSelected
            Constrained_Find Next
        Loop

        Clear FolderSelHeaA
        Move iHeaderID to FolderSelHeaA.ID
        Find eq FolderSelHeaA.ID
        If (Found = True) Begin
            Reread FolderSelHeaA
                Move iTotal    to FolderSelHeaA.TotalFolders
                Move iSelected to FolderSelHeaA.TotalSelected
                SaveRecord FolderSelHeaA
            Unlock
        End

        Send RestoreErrorState
    End_Procedure

    /* Drops every selected-folder row AT OR UNDER sRoot, for the current user and workspace, and
       returns how many went. The counters are recomputed from the rows that survive, exactly as
       RemoveLibraryFolders and RemoveSystemFolders do.

       WHY A THIRD REMOVER (Nils 2026-09-10). Neither of those two can reach a library folder that a
       PACKAGE replaced: RemoveLibraryFolders deletes only rows under a declared library root AND
       outside the home, so a tree in <home>\Libraries fails the second test - and once the .sws
       stops declaring it, it is not a library root any more either; RemoveSystemFolders takes only
       CS_NoFolderList names, and Libraries is not one. So the ticks on a folder the build has
       stopped reading are, today, permanent.

       CALLED ONLY BEHIND THE CONFIRMED RETIRE (MaintainLibrariesFT._RetireLibraryFolders), never on
       its own: a tick is the user's curation, and dropping one because the tool thinks the folder
       is stale would be the intent-measuring design rejected on 2026-08-31. It is dropped here
       because the folder it names has just been renamed out from under it, which is a fact rather
       than a guess. */
    Function RemoveSelectedFoldersUnder String sRoot Returns Integer
        Integer iTotal iSelected iGone iHeaderID
        String  sUserName sHomeFolder sFolder
        Boolean bUnder

        Move 0 to iGone
        Move (Trim(sRoot)) to sRoot
        If (sRoot = "") ;
            Function_Return 0
        Get psUsername   of ghoApplication to sUserName
        Get psHomeTarget of ghoApplication to sHomeFolder
        Clear FolderSelHea
        Move sUserName   to FolderSelHea.UserName
        Move sHomeFolder to FolderSelHea.WorkspaceHomeFolder
        Find eq FolderSelHea.WorkspaceHomeFolder
        If (Found = False) ;
            Function_Return 0
        Move FolderSelHea.ID to iHeaderID

        Send SaveErrorState

        Constraint_Set Self Clear
        Constrained_Clear eq FolderSelDtlA by Index.2
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Move (Trim(FolderSelDtlA.FolderName)) to sFolder
            Get IsFolderUnderRoot sFolder sRoot to bUnder
            If (bUnder = True) Begin
                Lock
                    Delete FolderSelDtlA
                Unlock
                Increment iGone
            End
            Constrained_Find Next
        Loop

        // Recompute the header counters from the surviving rows.
        Move 0 to iTotal
        Move 0 to iSelected
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Increment iTotal
            If (FolderSelDtlA.bSelected = True) ;
                Increment iSelected
            Constrained_Find Next
        Loop

        Clear FolderSelHeaA
        Move iHeaderID to FolderSelHeaA.ID
        Find eq FolderSelHeaA.ID
        If (Found = True) Begin
            Reread FolderSelHeaA
                Move iTotal    to FolderSelHeaA.TotalFolders
                Move iSelected to FolderSelHeaA.TotalSelected
                SaveRecord FolderSelHeaA
            Unlock
        End

        Send RestoreErrorState
        Function_Return iGone
    End_Function

    // Note: An active header record (FolderSelHea) must be present
    //       in the global record buffer prior calling this:
    // Returns True if there was an error saving records.
    Function SaveDetailRecord Integer iHeaderID String sFolderName String sUserName Boolean bSelected Returns Boolean
        Boolean bFound bResult

        // Preserve the status of the Err system flag:
        Send SaveErrorState
        Clear FolderSelDtl
        Move iHeaderID   to FolderSelDtl.FolderSelHeaID
        Move sFolderName to FolderSelDtl.FolderName
        Find eq FolderSelDtl.FolderName
        Move (Found) to bFound

        // It any of these are true we need to save, else do nothing.
        If (bFound = False or Trim(sFolderName) <> Trim(FolderSelDtl.FolderName)) Begin
            Reread //FolderSelHeaA FolderSelDtl
                If (bFound = False) Begin
                    Increment FolderSelHea.ChildID
                    Increment FolderSelHea.TotalFolders
                    SaveRecord FolderSelHea
                    Clear FolderSelDtl
                    Move FolderSelHea.ChildID to FolderSelDtl.ID
                    Move FolderSelHea.ID      to FolderSelDtl.FolderSelHeaID
                End
                Move sFolderName to FolderSelDtl.FolderName
                Move bSelected   to FolderSelDtl.bSelected
                SaveRecord FolderSelDtl
            Unlock
        End

        Move Err to bResult
        Send RestoreErrorState
        Function_Return bResult
    End_Function

    // Delets all existing FolderSelDtlA records for the passed FolderSelHeaA.ID
    Function RemoveDetailRecords Integer iHeaID Returns Boolean
        Boolean bErr bResult

        Send SaveErrorState
        Reread FolderSelHeaA
            Move 0 to FolderSelHeaA.ChildID
            SaveRecord FolderSelHeaA
        Unlock

        Constraint_Set Self Clear
        Constrained_Clear eq FolderSelDtlA by Index.2
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaID
        Constrained_Find First FolderSelDtlA by Index.2
        While (Found)
            Lock
                Delete FolderSelDtlA
            Unlock
            Constrained_Find Next
        Loop

        Move (not(Err)) to bResult
        Send RestoreErrorState
        Function_Return (bResult = False)
    End_Function

    // Tick (bSelected = True) the FolderSelDtl rows whose folder matches one of asFolders
    // (full paths) for the CURRENT workspace's header. The Modernization Analyzer's "Auto
    // Select" calls this so the folders involved in the run show up selected in the folders
    // grid afterward (the run itself stays file-precise). Matches the FULL folder name (deep
    // / library folders included) via the FolderSelDtlA alias + a header-scoped lookup - the
    // same bulk-update pattern as RemoveLibraryFolders. Returns the count newly selected.
    Function SelectFoldersByPath String[] asFolders Returns Integer
        Integer iHeaderID iSize iCount iSelected
        String sUserName sHomeFolder sFolder

        Get psUsername of ghoApplication to sUserName
        Get psHomeTarget of ghoApplication to sHomeFolder
        Clear FolderSelHeaA
        Move sUserName   to FolderSelHeaA.UserName
        Move sHomeFolder to FolderSelHeaA.WorkspaceHomeFolder
        Find eq FolderSelHeaA.WorkspaceHomeFolder
        If (Found = False) ;
            Function_Return 0
        Move FolderSelHeaA.ID to iHeaderID

        Send SaveErrorState
        Move 0 to iSelected
        Move (SizeOfArray(asFolders)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move asFolders[iCount] to sFolder
            // Stored folder names carry no trailing separator; ParseFolderName yields one.
            If (Right(sFolder, 1) = CS_DirSeparator) ;
                Move (Left(sFolder, (Length(sFolder) - 1))) to sFolder
            Clear FolderSelDtlA
            Move iHeaderID to FolderSelDtlA.FolderSelHeaID
            Move sFolder   to FolderSelDtlA.FolderName
            Find eq FolderSelDtlA by Index.2
            If (Found and (FolderSelDtlA.bSelected = False)) Begin
                Reread FolderSelDtlA
                    Move True to FolderSelDtlA.bSelected
                    SaveRecord FolderSelDtlA
                    Increment iSelected
                Unlock
            End
        Loop

        // Bump the header's selected counter for the rows we just ticked.
        If (iSelected > 0) Begin
            Clear FolderSelHeaA
            Move iHeaderID to FolderSelHeaA.ID
            Find eq FolderSelHeaA.ID
            If (Found = True) Begin
                Reread FolderSelHeaA
                    Add iSelected to FolderSelHeaA.TotalSelected
                    SaveRecord FolderSelHeaA
                Unlock
            End
        End

        Send RestoreErrorState 
        Send Request_Assign
        Function_Return iSelected
    End_Function

    /* A BATCH RUN'S FOLDERS, TICKED FOR THE RUN (Nils 2026-10-24). A /bm run scans the folders its command
       line names - pasSelectedFolders, filled from the INI - and never reads these ticks, but the Start
       Center's Source folders line does, so it said "None selected" while the run worked on two folders.
       For the run, this workspace's ticks become exactly asFolders:
       - a folder list that was never built is built first, the way the folder view does on load;
       - a folder the list does not have gets a ticked row, as the /folders seed
         (MarkCmdLineSetSelectedFolders) gives it;
       - the header's two counters are recounted from the rows.
       What was ticked before, and which rows were added, stay in this object for RestoreBatchFolderTicks,
       which ExitBatchWithCode sends - so nothing is left for the next Check or Plan run to inherit. Paths
       are matched case-blind; a home-relative entry ("AppSrc") is resolved against the workspace home. */
    Procedure ApplyBatchFolderTicks String[] asFolders
        String[] asWant asWantLow asNames
        Integer[] aiIDs aiBefore aiAdded
        Boolean[] abSel
        String sUserName sHome sHomeDir sFolder sPath sValue
        Integer i iLast iRows iHeaderID
        Boolean bLibInclude bErr bWant

        If (SizeOfArray(asFolders) = 0) ;
            Procedure_Return
        Get psUsername of ghoApplication to sUserName
        Get psHomeTarget of ghoApplication to sHome
        If (sHome = "") ;
            Procedure_Return

        // The folder list, built when it never was.
        Clear FolderSelHeaA
        Move sUserName to FolderSelHeaA.UserName
        Move sHome     to FolderSelHeaA.WorkspaceHomeFolder
        Find eq FolderSelHeaA.WorkspaceHomeFolder
        If (Found = False) Begin
            Get ReadString of ghoApplication CS_Settings CS_IncludeLibFoldersKey "1" to sValue
            Move (sValue <> "0") to bLibInclude
            Get SaveNewHeaderAndChildRecords sHome bLibInclude to bErr
            Clear FolderSelHeaA
            Move sUserName to FolderSelHeaA.UserName
            Move sHome     to FolderSelHeaA.WorkspaceHomeFolder
            Find eq FolderSelHeaA.WorkspaceHomeFolder
        End
        If (Found = False) ;
            Procedure_Return
        Move FolderSelHeaA.ID to iHeaderID

        Send SaveErrorState
        // The command line's folders the way they are stored: no trailing separator, a home-relative name
        // made full.
        Get vFolderFormat sHome to sHomeDir
        Move (SizeOfArray(asFolders) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asFolders[i])) to sFolder
            If (sFolder <> "") Begin
                If (Right(sFolder, 1) = CS_DirSeparator) ;
                    Move (Left(sFolder, (Length(sFolder) - 1))) to sFolder
                Get ParseFolderName sFolder to sPath
                If (sPath = "") ;
                    Move (sHomeDir + sFolder) to sFolder
                If (SearchArray(Lowercase(sFolder), asWantLow) = -1) Begin
                    Move sFolder              to asWant[SizeOfArray(asWant)]
                    Move (Lowercase(sFolder)) to asWantLow[SizeOfArray(asWantLow)]
                End
            End
        Loop

        // Every row of the list as it is now, and what is ticked - kept for the restore.
        Constraint_Set (Self + 12) Clear
        Constrained_Clear eq FolderSelDtlA by Index.1
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.1
        Move 0 to iRows
        While (Found)
            Move FolderSelDtlA.ID                            to aiIDs[iRows]
            Move (Lowercase(Trim(FolderSelDtlA.FolderName))) to asNames[iRows]
            Move FolderSelDtlA.bSelected                     to abSel[iRows]
            If (FolderSelDtlA.bSelected = True) ;
                Move FolderSelDtlA.ID to aiBefore[SizeOfArray(aiBefore)]
            Increment iRows
            Constrained_Find Next
        Loop

        // Ticked exactly where the command line names the folder.
        For i from 0 to (iRows - 1)
            Move (SearchArray(asNames[i], asWantLow) <> -1) to bWant
            If (bWant <> abSel[i]) ;
                Send _SetFolderTick iHeaderID aiIDs[i] bWant
        Loop

        // A folder the list does not have gets a ticked row - the /folders seed's create, its ID from the
        // header's ChildID counter (an alias save bypasses the DD's auto-increment).
        Move (SizeOfArray(asWant) - 1) to iLast
        For i from 0 to iLast
            If (SearchArray(asWantLow[i], asNames) = -1) Begin
                Clear FolderSelHeaA
                Move iHeaderID to FolderSelHeaA.ID
                Find eq FolderSelHeaA.ID
                If (Found) Begin
                    Reread FolderSelHeaA
                        Increment FolderSelHeaA.ChildID
                        SaveRecord FolderSelHeaA
                        Clear FolderSelDtlA
                        Move iHeaderID             to FolderSelDtlA.FolderSelHeaID
                        Move asWant[i]             to FolderSelDtlA.FolderName
                        Move FolderSelHeaA.ChildID to FolderSelDtlA.ID
                        Move True                  to FolderSelDtlA.bSelected
                        SaveRecord FolderSelDtlA
                    Unlock
                    Move FolderSelHeaA.ChildID to aiAdded[SizeOfArray(aiAdded)]
                End
            End
        Loop
        Send _RecountFolderTotals iHeaderID

        Set piBatchHeaderID      to iHeaderID
        Set paiBatchTickedBefore to aiBefore
        Set paiBatchAdded        to aiAdded
        Send RestoreErrorState
    End_Procedure

    /* Puts back what ApplyBatchFolderTicks changed: the rows it added go, every other row gets its earlier
       tick, and the counters are recounted. Once only - a second call finds nothing to do. A folder list
       the apply had to BUILD stays, unticked, the way the folder view would have built it on the next load. */
    Procedure RestoreBatchFolderTicks
        Integer[] aiBefore aiAdded aiIDs aiEmpty
        Boolean[] abSel
        Integer iHeaderID i iLast iRows
        Boolean bWant

        Get piBatchHeaderID to iHeaderID
        If (iHeaderID = 0) ;
            Procedure_Return
        Set piBatchHeaderID to 0
        Get paiBatchTickedBefore to aiBefore
        Get paiBatchAdded        to aiAdded
        Set paiBatchTickedBefore to aiEmpty
        Set paiBatchAdded        to aiEmpty

        Send SaveErrorState
        Move (SizeOfArray(aiAdded) - 1) to iLast
        For i from 0 to iLast
            Clear FolderSelDtlA
            Move iHeaderID  to FolderSelDtlA.FolderSelHeaID
            Move aiAdded[i] to FolderSelDtlA.ID
            Find eq FolderSelDtlA by Index.1
            If (Found) Begin
                Reread FolderSelDtlA
                    Delete FolderSelDtlA
                Unlock
            End
        Loop

        Constraint_Set (Self + 12) Clear
        Constrained_Clear eq FolderSelDtlA by Index.1
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.1
        Move 0 to iRows
        While (Found)
            Move FolderSelDtlA.ID        to aiIDs[iRows]
            Move FolderSelDtlA.bSelected to abSel[iRows]
            Increment iRows
            Constrained_Find Next
        Loop
        For i from 0 to (iRows - 1)
            Move (SearchArray(aiIDs[i], aiBefore) <> -1) to bWant
            If (bWant <> abSel[i]) ;
                Send _SetFolderTick iHeaderID aiIDs[i] bWant
        Loop
        Send _RecountFolderTotals iHeaderID
        Send RestoreErrorState
    End_Procedure

    // One row's tick, written through the alias - which bypasses the DD's counting, so the callers recount.
    { Visibility=Private }
    Procedure _SetFolderTick Integer iHeaderID Integer iID Boolean bTick
        Clear FolderSelDtlA
        Move iHeaderID to FolderSelDtlA.FolderSelHeaID
        Move iID       to FolderSelDtlA.ID
        Find eq FolderSelDtlA by Index.1
        If (Found) Begin
            Reread FolderSelDtlA
                Move bTick to FolderSelDtlA.bSelected
                SaveRecord FolderSelDtlA
            Unlock
        End
    End_Procedure

    // The header's two counters, counted from its rows.
    { Visibility=Private }
    Procedure _RecountFolderTotals Integer iHeaderID
        Integer iTotal iSelected

        Move 0 to iTotal
        Move 0 to iSelected
        Constraint_Set (Self + 13) Clear
        Constrained_Clear eq FolderSelDtlA by Index.1
        Constrain FolderSelDtlA.FolderSelHeaID eq iHeaderID
        Constrained_Find First FolderSelDtlA by Index.1
        While (Found)
            Increment iTotal
            If (FolderSelDtlA.bSelected = True) ;
                Increment iSelected
            Constrained_Find Next
        Loop
        Clear FolderSelHeaA
        Move iHeaderID to FolderSelHeaA.ID
        Find eq FolderSelHeaA.ID
        If (Found) Begin
            Reread FolderSelHeaA
                Move iTotal    to FolderSelHeaA.TotalFolders
                Move iSelected to FolderSelHeaA.TotalSelected
                SaveRecord FolderSelHeaA
            Unlock
        End
    End_Procedure

End_Class
