Use DataDict.pkg
Use cRDCAutoCreateNewID.pkg
Use RefactorConstants.h.pkg
Use cCmdLineIniFile.pkg       // DecodeFunctionName - the ONE tested rule for "Name,Parameter" specs


// We need to create an instance of this class in the cRefactorEngine class.
// That class is instantiated by the cRefactorApplication class - in the End_Construct_Object.
// Hence, we can't have a "Use cFunctionsDataDictionary.pkg" at the top of the
// cRefactorEngine package, as that would render compilation errors in the cRefactorApplicatioon class,
// as that package has a "Use cRefactorEngie.pkg" at the top.
// As a workaround we instead open these files in Construct_Object.
Declare_Datafile SysFile
Declare_Datafile Functions
Declare_Datafile FunctionsA
Declare_Datafile DFLastID

Object oFunctionTypes is a DescriptionValidationTable
    Set Table_Title to "Function Type"
    Procedure Fill_List
        Forward Send Fill_List
        Send Add_Table_Value eStandardFunction   CS_StandardFunction
        Send Add_Table_Value eRemoveFunction     CS_RemoveFunction
        Send Add_Table_Value eRemoveFunctionAll  CS_RemoveFunctionAll
        Send Add_Table_Value eEditorFunction     CS_EditorFunction
        Send Add_Table_Value eReportFunction     CS_ReportFunction
        Send Add_Table_Value eReportFunctionAll  CS_ReportFunctionAll
        Send Add_Table_Value eOtherFunction      CS_OtherFunction
        Send Add_Table_Value eOtherFunctionAll   CS_OtherFunctionAll
    End_Procedure
End_Object

Object oFunctionGroups is a DescriptionValidationTable
    Set Table_Title to "Function Group"
    Procedure Fill_List
        Forward Send Fill_List
        Send Add_Table_Value eFnGroupOther         CS_FnGroupOther
        Send Add_Table_Value eFnGroupModernization CS_FnGroupModernization
        Send Add_Table_Value eFnGroupCleanup       CS_FnGroupCleanup
        Send Add_Table_Value eFnGroupUnicode64     CS_FnGroupUnicode64
    End_Procedure
End_Object

Register_Object oFunctions_sl

Class cFunctionsDataDictionary is a DataDictionary

    Import_Class_Protocol cRDCAutoCreateNewIDMixin

    Procedure Construct_Object
        Forward Send Construct_Object

        Property Integer piFunctionType eAllFunctions

        Open SysFile
        Open Functions
        Open FunctionsA

        Set_Attribute DF_FILE_ALIAS of Functions.File_Number to DF_FILE_IS_MASTER
        Set_Attribute DF_FILE_ALIAS of FunctionsA.File_Number to DF_FILE_IS_ALIAS

        Set Main_File to Functions.File_Number
        Set Add_System_File to SysFile.File_Number DD_Lock_On_All
        Set Add_System_File to DFLastID.File_Number DD_Lock_On_All

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Key_Field_State Field Functions.ID to True
        Set Field_Prompt_Object Field Functions.ID to oFunctions_sl
        Set Status_Help Field Functions.ID to "Automatically generated ID number"
        Set Field_Auto_Increment Field Functions.ID to File_Field DFLastID.FunctionsID

        Set Field_Prompt_Object Field Functions.Function_Name to oFunctions_sl
        Set Status_Help Field Functions.Function_Name to "the name entered must be exactly the same as the function name itself. Then the code must be added to the cRefactorDbView class (cRefactorDbView.pkg). See class code for standard function parameters."

        Set Status_Help Field Functions.Function_Help to "Longer explanation on what the function does. Shows when the mouse hovers above a function grid."

        Set Status_Help Field Functions.SummaryText to "Function summary text that appears after a refactoring has run."

        Set Field_Class_Name Field Functions.Selected to "Checkbox"
        Set Field_Checkbox_Values Field Functions.Selected to "1" "0"
        Set Status_Help Field Functions.Selected to "Selected function"

        Set Field_Value_Table Field Functions.Type to oFunctionTypes
        Set Status_Help Field Functions.Type to "The type of function. The type determines what data is send to the function: Line-by-line, as a String array, or all files as a string array."
        Set Field_Class_Name Field Functions.Type to "Combo"

        Set Field_Value_Table Field Functions.FnGroup to oFunctionGroups
        Set Status_Help Field Functions.FnGroup to "The functional group: Modernization (brings legacy code up to current DataFlex), x64 + Unicode (64-bit/Unicode migration readiness), Cleanup (tidies or removes), or Other. Set via the function's { FnGroup } meta-tag."
        Set Field_Class_Name Field Functions.FnGroup to "Combo"

        Set Field_Class_Name Field Functions.bHasParameter to "Checkbox"
        Set Field_Checkbox_Values Field Functions.bHasParameter to "1" "0"
        Set Status_Help Field Functions.bHasParameter to "This is a system function and may not be changed, because it is handled a bit differently."

        Set Field_Class_Name Field Functions.bPrivate to "Checkbox"
        Set Status_Help Field Functions.bPrivate to "If checked it indicates that it is a private function for your company that should not be shared (Exported/Imported) It is contained in its own package file Used inside the UserDefinedRefactorFunctions.pkg"
        Set Field_Checkbox_Values Field Functions.bPrivate to "1" "0"
        Set Field_Label_Long Field Functions.bPrivate to "Private Function"
        Set Field_Label_Short Field Functions.bPrivate to "Private"

        Set Status_Help Field Functions.Counter to "This will initialize to 0 before each refactor run."
    End_Procedure

    Procedure Field_Defaults
        Forward Send Field_Defaults
        Set Field_Changed_Value Field Functions.Selected to 0
        Set Field_Changed_Value Field Functions.Type to 0
        Set Field_Changed_Value Field Functions.bHasParameter to 0
        Set Field_Changed_Value Field Functions.bPrivate to 0
    End_Procedure

    Procedure Creating
        Integer iID
        Forward Send Creating
//        Get AutoCreateNewID File_Field Functions.ID True to iID
    End_Procedure

    Procedure Update
        Integer iIndex
        Boolean bChangeWriteProtected
        String sFunctionName sParam sValue
        String[] asValidations

        If (Functions.bHasParameter = True) Begin
            Move (Trim(Functions.Parameter)) to sParam
            Move (Trim(Functions.ParameterValidation)) to sValue
            If (sValue <> "") Begin
                // "ANY" signals a free-text parameter: skip list membership check.
                If (Lowercase(sValue) <> "any") Begin
                    Move (StrSplitToArray(sValue, ",")) to asValidations
                    Move (SearchArray(sParam, asValidations)) to iIndex
                    If (iIndex = -1) Begin
                        Send Data_Set_Error -1 DFERR_OPERATOR ("Invalid value. Must be one of:" * String(sValue))
//                    Send UserError ("Invalid value. Must be one of:" * String(sValue))
                    End
                End
            End
        End
        Else Begin
            If (Trim(Functions.Parameter) <> "") Begin
                Send Data_Set_Error -1 DFERR_OPERATOR "This function doesn't use parameters and you are therefore not allowed to enter one."
//                Send UserError "This function doesn't use parameters and you are therefore not allowed to enter one."
            End
        End
        Move (Trim(Functions.Function_Help)) to Functions.Function_Help
        Send AdjustSelected (If(Functions.Selected, 1, 0)) Functions.Type
    End_Procedure

    Procedure Backout
        Send AdjustSelected (If(Functions.Selected, -1, 0)) Functions.Type
    End_Procedure

    Procedure AdjustSelected Integer iState Integer eType
        String sFunctionName
        Integer iTotFunctions

        Get TotalNoOfFunctions to iTotFunctions
        Move (Lowercase(Trim(Functions.Function_Name))) to sFunctionName
        If (sFunctionName = "") Begin
            Procedure_Return
        End

        // Handling of special function.
        If (sFunctionName = Lowercase(CS_CountSourceLines)) Begin
            Move Functions.Selected to SysFile.bCountSourceLines
        End

        If (SysFile.SelectedFunctionTotal <= iTotFunctions) Begin
            Add iState to SysFile.SelectedFunctionTotal
        End
        If (SysFile.SelectedFunctionTotal < 0) Begin
            Move 0 to SysFile.SelectedFunctionTotal
        End

        Case Begin
            Case (eType = eStandardFunction)
                Add iState to SysFile.SelectedeStandardFunction
                If (SysFile.SelectedeStandardFunction < 0) Begin
                    Move 0 to SysFile.SelectedeStandardFunction
                End
                Case Break
            Case (eType = eRemoveFunction)
                Add iState to SysFile.SelectedeRemoveFunction
                If (SysFile.SelectedeRemoveFunction < 0) Begin
                    Move 0 to SysFile.SelectedeRemoveFunction
                End
                Case Break
            Case (eType = eEditorFunction)
                Add iState to SysFile.SelectedeEditorFunction
                If (SysFile.SelectedeEditorFunction < 0) Begin
                    Move 0 to SysFile.SelectedeEditorFunction
                End
                Case Break
            Case (eType = eReportFunction)
                Add iState to SysFile.SelectedeReportFunction
                If (SysFile.SelectedeReportFunction < 0) Begin
                    Move 0 to SysFile.SelectedeReportFunction
                End
                Case Break
            Case (eType = eReportFunctionAll)
                Add iState to SysFile.SelectedeReportAllFunction
                If (SysFile.SelectedeReportAllFunction < 0) Begin
                    Move 0 to SysFile.SelectedeReportAllFunction
                End
                Case Break
            Case (eType = eOtherFunction)
                Add iState to SysFile.SelectedeOtherFunction
                If (SysFile.SelectedeOtherFunction < 0) Begin
                    Move 0 to SysFile.SelectedeOtherFunction
                End
                Case Break
            Case (eType = eOtherFunctionAll)
                Add iState to SysFile.SelectedeOtherAllFunction
                If (SysFile.SelectedeOtherAllFunction < 0) Begin
                    Move 0 to SysFile.SelectedeOtherAllFunction
                End
                Case Break
        Case End

        SaveRecord SysFile
    End_Procedure

    // Pass one of the pre-defined function types.
    // Returns number of selected functions for that passed type.
    { EnumList = "eStandardFunction, eEditorFunction, eReportFunction or eRemoveFunction" }
    Function SelectedTypeFunctions Integer eType Returns Integer
        Integer iItems

        Case Begin
            Case (eType = eStandardFunction)
                Move SysFile.SelectedeStandardFunction to iItems
                Case Break
            Case (eType = eEditorFunction)
                Move SysFile.SelectedeEditorFunction to iItems
                Case Break
            Case (eType = eReportFunction)
                Move SysFile.SelectedeReportFunction to iItems
                Case Break
            Case (eType = eRemoveFunction)
                Move SysFile.SelectedeRemoveFunction to iItems
                Case Break
            Case Else
                Move SysFile.SelectedFunctionTotal to iItems
        Case End

        Function_Return iItems
    End_Function

    // Finds the first selected Function record for the passed type.
    // Returns True if a match was found.
    // NOTE: It leaves the FunctionsA global record buffer after
    //       a successful find, to be used elsewhere.
    Function FindFirstSelectedFunction Integer eType Returns Boolean
        Clear FunctionsA
        Move True  to FunctionsA.Selected
        Move eType to FunctionsA.Type
        Find gt FunctionsA by Index.3
        Function_Return (Found and FunctionsA.Type = eType)
    End_Function

    // Finds the next selected function for the passed type
    // Returns True if a match was found.
    // It is mandatory to start a loop by first calling the
    // FindFirstSelectedFunction function.
    // NOTE: It leaves the FunctionsA global record buffer after
    //       a successful find, to be used elsewhere.
    Function FindNextSelectedFunction Integer eType Returns Boolean
        Move True  to FunctionsA.Selected
        Move eType to FunctionsA.Type
        Find gt FunctionsA by Index.3
        Function_Return (Found and FunctionsA.Type = eType)
    End_Function

    // Returns the total number of selected functions for all types.
    Function TotSelectedFunctions Returns Integer
        Function_Return (SysFile.SelectedFunctionTotal)
    End_Function

    // Returns the total number of functions in the database.
    // We only count Published functions.
    Function TotalNoOfFunctions Returns Integer
        Integer iItems

        Constraint_Set (Self +35) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.bPublished eq 1
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Increment iItems
            Constrained_Find Next
        Loop
        Function_Return iItems
    End_Function

    // Returns the total number of selected functions.
    Function TotalNoSelected Returns Integer
        Integer iItems

        Constraint_Set (Self +5) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrain FunctionsA.bPublished eq 1
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Increment iItems
            Constrained_Find Next
        Loop
        Function_Return iItems
    End_Function

    // Returns the NAMES of every selected published function (Functions.Selected = 1). Mirrors
    // TotalNoSelected's scan but yields the names. The Refactoring Plan dialog's "Show all functions"
    // toggle needs the full ticked set (the plan's suggestions PLUS any the user added), not just the
    // plan's names - so it reads this rather than walking only the plan list.
    Function SelectedPublishedFunctionNames Returns String[]
        String[] asNames

        Constraint_Set (Self +12) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrain FunctionsA.bPublished eq 1
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Move (Trim(FunctionsA.Function_Name)) to asNames[SizeOfArray(asNames)]
            Constrained_Find Next
        Loop
        Function_Return asNames
    End_Function

    // Returns the total number of selected functions.
    Function TotalNoSelectedPerType Integer eType Returns Integer
        Integer iItems

        Constraint_Set (Self +6) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrain FunctionsA.bPublished eq 1
        Constrain FunctionsA.Type eq eType
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Increment iItems
            Constrained_Find Next
        Loop
        Function_Return iItems
    End_Function

    // The NAMES of the selected published functions WITHIN one FnGroup - the group-scoped RUN's
    // function set (Nils 2026-07-16): a Run from a group-filtered view executes ONLY that group's
    // ticks (transient narrow/restore in SelectFunctionsFT's run click, the plan-run pattern).
    Function SelectedPublishedFunctionNamesPerGroup Integer eGroup Returns String[]
        String[] asNames

        Constraint_Set (Self +14) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrain FunctionsA.bPublished eq 1
        Constrain FunctionsA.FnGroup eq eGroup
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Move (Trim(FunctionsA.Function_Name)) to asNames[SizeOfArray(asNames)]
            Constrained_Find Next
        Loop
        Function_Return asNames
    End_Function

    // Selected + published count WITHIN one FnGroup - the group-filtered Select Functions view's
    // Run-button count (Nils 2026-07-16): that button describes what the CONSTRAINED grid shows,
    // while the dashboard's "Functions selected" pill keeps the cross-group total (TotalNoSelected).
    Function TotalNoSelectedPerGroup Integer eGroup Returns Integer
        Integer iItems

        Constraint_Set (Self +13) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrain FunctionsA.bPublished eq 1
        Constrain FunctionsA.FnGroup eq eGroup
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Increment iItems
            Constrained_Find Next
        Loop
        Function_Return iItems
    End_Function

    Procedure ResetSysFile
        Reread SysFile
            Move 0 to SysFile.iCountNumberOfFiles
            Move 0 to SysFile.iCountNumberOfChangedFiles
            Move 0 to SysFile.iCountNumberOfLines
            Get TotalNoSelected to SysFile.SelectedFunctionTotal
            SaveRecord SysFile
        Unlock
        Send ResetAllSysFileSelectionCounters
    End_Procedure

    { EnumList = "eStandardFunction", "eRemoveFunction", "eEditorFunction", "eReportFunction", "eReportFunctionAll", "eOtherFunction", "eOtherFunctionAll"}
    Procedure ResetAllSysFileSelectionCounters
        Integer iCount
        Lock
            Get TotalNoSelectedPerType eStandardFunction to iCount
            Move iCount to SysFile.SelectedeStandardFunction
            Get TotalNoSelectedPerType eRemoveFunction to iCount
            Move iCount to SysFile.SelectedeRemoveFunction
            Get TotalNoSelectedPerType eEditorFunction to iCount
            Move iCount to SysFile.SelectedeEditorFunction
            Get TotalNoSelectedPerType eReportFunction to iCount
            Move iCount to SysFile.SelectedeReportFunction
            Get TotalNoSelectedPerType eReportFunctionAll to iCount
            Move iCount to SysFile.SelectedeReportAllFunction
            Get TotalNoSelectedPerType eOtherFunction to iCount
            Move iCount to SysFile.SelectedeOtherFunction
            Get TotalNoSelectedPerType eOtherFunctionAll to iCount
            Move iCount to SysFile.SelectedeOtherAllFunction
        Unlock
    End_Procedure

    /* The selection counters - the total and each type's - counted again from the ticks, and SAVED (2026-11-20),
       for RestoreCmdLineSelections after a /bm run has put the user's own ticks back. Not ResetSysFile: it also
       zeroes the run's statistics, which the batch result is still written from. Not ResetAllSysFileSelectionCounters
       alone: it counts the per-type counters only, and leaves them in the buffer - the live test left the total
       at the INI's 1 over the user's 31 ticks. */
    Procedure RecountSelectionCounters
        Integer iCount
        Reread SysFile
            Get TotalNoSelected to SysFile.SelectedFunctionTotal
            Get TotalNoSelectedPerType eStandardFunction to iCount
            Move iCount to SysFile.SelectedeStandardFunction
            Get TotalNoSelectedPerType eRemoveFunction to iCount
            Move iCount to SysFile.SelectedeRemoveFunction
            Get TotalNoSelectedPerType eEditorFunction to iCount
            Move iCount to SysFile.SelectedeEditorFunction
            Get TotalNoSelectedPerType eReportFunction to iCount
            Move iCount to SysFile.SelectedeReportFunction
            Get TotalNoSelectedPerType eReportFunctionAll to iCount
            Move iCount to SysFile.SelectedeReportAllFunction
            Get TotalNoSelectedPerType eOtherFunction to iCount
            Move iCount to SysFile.SelectedeOtherFunction
            Get TotalNoSelectedPerType eOtherFunctionAll to iCount
            Move iCount to SysFile.SelectedeOtherAllFunction
            SaveRecord SysFile
        Unlock
    End_Procedure

    // Zeroe's out all function counters
    Procedure ResetFunctionsCounters
        Send ResetSysFile

        Constraint_Set (Self  + 1) Clear
        Constrained_Clear eq FunctionsA by Index.1
        Constrained_Find First FunctionsA by Index.1
        While (Found)
            Reread FunctionsA
                Move 0 to FunctionsA.Counter
                SaveRecord FunctionsA
            Unlock
            Constrained_Find Next
        Loop
    End_Procedure

    Procedure UpdateDataFromMetaTags tFuncLib[] FuncLibArray
        Integer iSize iCount
        String sFunctionName
        Boolean bOK

        Send UnPublishedAllRecords
        Move True to bOK
        Move (SizeOfArray(FuncLibArray)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move FuncLibArray[iCount].sName to sFunctionName
            Clear FunctionsA
            Move sFunctionName to FunctionsA.Function_Name
            Find eq FunctionsA.Function_Name
            If (Found = True) Begin
                Get UpdateRecordFromMetaTag FuncLibArray[iCount] to bOK
                If (bOK = False) Begin
                    Send Data_Set_Error -1 DFERR_PROGRAM "Could not update Functions table record from meta-data! Process 'UpdateFromMetaTags' interrupted."
                    Procedure_Return
                End
            End
            Else Begin
                Get CreateNewRecordFromMetaTag FuncLibArray[iCount] to bOK
                If (bOK = False) Begin
                    Send Data_Set_Error -1 DFERR_PROGRAM "Could not update Functions table record from meta-data! Process 'UpdateFromMetaTags' interrupted."
                    Procedure_Return
                End
            End
        Loop

    End_Procedure

    // Sets all Functions records as unselected. (FunctionsA.Selected = 0)
    // The names of the functions ticked now (2026-11-20) - what a /bm run saves before it ticks the INI's
    // (ApplyCmdLineSelections), so RestoreCmdLineSelections can put them back.
    Function SelectedFunctionNames Returns String[]
        String[] asNames
        Constraint_Set (Self + 16) Clear
        Constrained_Clear eq FunctionsA by Index.3
        Constrain FunctionsA.Selected eq 1
        Constrained_Find First FunctionsA by Index.3
        While (Found)
            Move (Trim(FunctionsA.Function_Name)) to asNames[SizeOfArray(asNames)]
            Constrained_Find Next
        Loop
        Function_Return asNames
    End_Function

    // The file filter in SysFile, read and written (2026-11-20) - for ApplyCmdLineSelections and
    // RestoreCmdLineSelections, which put a /bm INI's filter in and the user's own back, and cannot name SysFile
    // themselves (the application class compiles first in the test runner).
    Function FileExtensionFilter Returns String
        String sFilter
        Reread SysFile
            Move SysFile.FileExtensionFilter to sFilter
        Unlock
        Function_Return sFilter
    End_Function

    Procedure SetFileExtensionFilter String sFilter
        Reread SysFile
            Move sFilter to SysFile.FileExtensionFilter
            SaveRecord SysFile
        Unlock
    End_Procedure

    Procedure UnSelectAllRecords
        Constraint_Set (Self  + 11) Clear
        Constrained_Clear eq FunctionsA by Index.1
        Constrained_Find First FunctionsA by Index.1
        While (Found)
            If (FunctionsA.Selected <> 0) Begin
                Reread FunctionsA
                    Move 0 to FunctionsA.Selected
                    SaveRecord FunctionsA
                Unlock
            End
            Constrained_Find Next
        Loop
    End_Procedure

    // Dumb selector: set Functions.Selected = 1 for each named function. NO companion logic - the callers
    // decide companions in the right layer (the Modernization plan in cModAnalyzer.AddNeededIndicatorCompanions;
    // the manual-grid / batch run-time net in EnsureCompanionsSelected + the DefineSelectMacro param helpers
    // below). Nils, 2026-07-06: the old unconditional companion pull here made the plan tick DeclareRefactoredIndicators /
    // DefineSelectMacro even for a built-in-only Found/Err workspace on the default eLeaveSelect - looked like a bug.
    /* The NAME half of a "Name" / "Name,Parameter" INI spec, delegated to cCmdLineIniFile so
       there is ONE rule and it is the unit-tested one - the encode side and both decode sides
       have to agree, and a second copy here is exactly how they would stop agreeing.

       It also TRIMS, which the old inline split did not: a hand-edited INI reading
       "Name , Parameter" looked up a name with a trailing space and found nothing, silently. */
    Function SpecFunctionName String sSpec Returns String
        Handle hoSpec
        String sName
        Get Create (RefClass(cCmdLineIniFile)) to hoSpec
        Get DecodeFunctionName of hoSpec sSpec to sName
        Send Destroy of hoSpec
        Function_Return sName
    End_Function

    Procedure SelectRecordsFromStringArray String[] asFunctions
        Integer iCount iSize
        String sFunctionName
        Move (SizeOfArray(asFunctions)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Clear FunctionsA
            Get SpecFunctionName asFunctions[iCount] to sFunctionName
            Move sFunctionName to FunctionsA.Function_Name
            Find eq FunctionsA by Index.2
            If (Found = True and (FunctionsA.Selected <> 1)) Begin
                Reread FunctionsA
                    Move 1 to FunctionsA.Selected
                    SaveRecord FunctionsA
                Unlock
            End
        Loop
    End_Procedure

    // The mirror: Functions.Selected = 0 for each named function (a function put on the never-pick list
    // loses its tick, 2026-10-06). A name the table does not have is ignored, as above.
    Procedure UnSelectRecordsFromStringArray String[] asFunctions
        Integer iCount iSize
        String sFunctionName
        Move (SizeOfArray(asFunctions)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Clear FunctionsA
            Get SpecFunctionName asFunctions[iCount] to sFunctionName
            Move sFunctionName to FunctionsA.Function_Name
            Find eq FunctionsA by Index.2
            If (Found = True and (FunctionsA.Selected <> 0)) Begin
                Reread FunctionsA
                    Move 0 to FunctionsA.Selected
                    SaveRecord FunctionsA
                Unlock
            End
        Loop
    End_Procedure

    /* Which of these INI specs name a function this build does not have.

       SelectRecordsFromStringArray finds-or-ignores, which is right for selection but means a
       typo, or a function renamed or dropped in a later DFRefactor, just VANISHES from the run:
       the summary only lists functions that ARE selected, so nothing marks the absence. A batch
       INI is maintained by hand over months, and its whole point is running unattended. Returned
       rather than reported here so the caller decides where it belongs. */
    Function UnknownFunctionNames String[] asFunctions Returns String[]
        Integer iCount iSize
        String sFunctionName
        String[] asUnknown

        Move (SizeOfArray(asFunctions)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Get SpecFunctionName asFunctions[iCount] to sFunctionName
            If (sFunctionName <> "") Begin
                Clear FunctionsA
                Move sFunctionName to FunctionsA.Function_Name
                Find eq FunctionsA by Index.2
                If (Found = False) ;
                    Move sFunctionName to asUnknown[SizeOfArray(asUnknown)]
            End
        Loop
        Function_Return asUnknown
    End_Function

    // Run-time safety net for the MANUAL grid / batch paths ONLY - the engine SKIPS this for a Modernization-plan
    // run (eRunPlan), which already decided its companions precisely in cModAnalyzer. When any selected function
    // is an indicator converter, make sure DeclareRefactoredIndicators is also selected: it re-declares the named
    // indicators the converters would otherwise leave undefined. Unconditional here (the DD cannot source-scan -
    // it compiles before the funclib), but harmless when there is nothing to declare - the refactor's own GATE 1/2
    // return 0. DefineSelectMacro is handled separately + parameter-gated (HasModernizeSelectConverterSelected).
    Procedure EnsureCompanionsSelected
        Boolean bHasConverter
        String[] asSelected
        Integer i iSize
        String sLC
        Get SelectedPublishedFunctionNames to asSelected
        Move (SizeOfArray(asSelected) - 1) to iSize
        Move False to bHasConverter
        For i from 0 to iSize
            Move (Lowercase(Trim(asSelected[i]))) to sLC
            If (sLC = "changelegacyindicators" or sLC = "changesquarebracketsindicators" or sLC = "changeindicatortoboolean") ;
                Move True to bHasConverter
        Loop
        If (bHasConverter = True) Begin
            Move "DeclareRefactoredIndicators" to asSelected[SizeOfArray(asSelected)]
            Send SelectRecordsFromStringArray asSelected
        End
        Send ResetSysFile
    End_Procedure

    // True when a currently-selected indicator converter runs under eModernizeSelect - the only mode that
    // leaves a bare SELECT macro to define (the default eLeaveSelect never does). A cheap Functions.Parameter
    // read (no funclib, no source scan). The engine checks THIS first and only then pays for the whole-file
    // SELECT source scan - so an eLeaveSelect run (the common case) never reads the run file set for it.
    Function HasModernizeSelectConverterSelected Returns Boolean
        String[] asSelected
        Integer i iSize
        String sLC
        Get SelectedPublishedFunctionNames to asSelected
        Move (SizeOfArray(asSelected) - 1) to iSize
        For i from 0 to iSize
            Move (Lowercase(Trim(asSelected[i]))) to sLC
            If (sLC = "changelegacyindicators" or sLC = "changesquarebracketsindicators" or sLC = "changeindicatortoboolean") Begin
                Clear FunctionsA
                Move asSelected[i] to FunctionsA.Function_Name
                Find eq FunctionsA by Index.2
                If (Found = True and (Lowercase(Trim(FunctionsA.Parameter)) = "emodernizeselect")) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    // Same question asked of a NAMED list instead of the current selection: does this PLAN contain an
    // indicator converter that will run under eModernizeSelect? A plan is built before anything is
    // selected, so the selection-based test above cannot answer for it (Nils 2026-07-26 - the plan said
    // 37 functions and the engine then said 38, because the SELECT companion was pulled in at run time,
    // after the plan dialog had already been shown). Same cheap Parameter read, same three converters.
    Function HasModernizeSelectConverterInList String[] asFunctions Returns Boolean
        Integer i iSize
        String sLC
        Move (SizeOfArray(asFunctions) - 1) to iSize
        For i from 0 to iSize
            Move (Lowercase(Trim(asFunctions[i]))) to sLC
            If (sLC = "changelegacyindicators" or sLC = "changesquarebracketsindicators" or sLC = "changeindicatortoboolean") Begin
                Clear FunctionsA
                Move asFunctions[i] to FunctionsA.Function_Name
                Find eq FunctionsA by Index.2
                If (Found = True and (Lowercase(Trim(FunctionsA.Parameter)) = "emodernizeselect")) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    /* True when <sName> is a REPORT-only refactoring function (eReportFunction /
       eReportFunctionAll). Such a function writes a worksheet and changes nothing, so it has no
       business inside a plan RUN - see the filter in TestCompileFT.dg's StartAutoSelect for why
       it is a correctness problem and not just a cost one. Find by Index.2 (Function_Name), the
       same lookup HasModernizeSelectConverterInList above uses. An unknown name answers False:
       a function we cannot classify is left in the plan rather than silently dropped. */
    Function IsReportOnlyFunction String sName Returns Boolean
        Clear FunctionsA
        Move sName to FunctionsA.Function_Name
        Find eq FunctionsA by Index.2
        If (Found = False) ;
            Function_Return False
        Function_Return (FunctionsA.Type = eReportFunction or FunctionsA.Type = eReportFunctionAll)
    End_Function

    // Select the DefineSelectMacro companion. The engine calls this only after confirming BOTH eModernizeSelect
    // (HasModernizeSelectConverterSelected) and a real [Select]/Indicate Select in scope - so it is never a no-op.
    Procedure SelectDefineSelectMacro
        String[] asComp
        Move "DefineSelectMacro" to asComp[0]
        Send SelectRecordsFromStringArray asComp
        Send ResetSysFile
    End_Procedure

    // Returns a CRLF-prefixed list of the PARAMETERIZED functions among asFunctions, each as
    // "    Name  =  <current parameter>" - or "" if none are parameterized. The Modernization
    // Analyzer's Auto Select uses this to warn that such functions only act when their
    // parameter matches the user's code (e.g. a subclassed class); otherwise they silently
    // change nothing. Find is by Index.2 (Function_Name), same as SelectRecordsFromStringArray.
    Function ParameterizedFunctionsInList String[] asFunctions Returns String
        String sResult sCRLF
        Integer i iSize
        Move (Character(13) + Character(10)) to sCRLF
        Move "" to sResult
        Move (SizeOfArray(asFunctions) - 1) to iSize
        For i from 0 to iSize
            Clear FunctionsA
            Move asFunctions[i] to FunctionsA.Function_Name
            Find eq FunctionsA by Index.2
            If (Found and (FunctionsA.bHasParameter = True)) Begin
                Move (sResult + sCRLF + "    " + Trim(FunctionsA.Function_Name) + "  =  " + Trim(FunctionsA.Parameter)) to sResult
            End
        Loop
        Function_Return sResult
    End_Function

    // Sets all Functions records as unpublished. (FunctionsA.bPublished = 0)
    Procedure UnPublishedAllRecords
        Constraint_Set (Self  + 10) Clear
        Constrained_Clear eq FunctionsA by Index.1
        Constrained_Find First FunctionsA by Index.1
        While (Found)
            Reread FunctionsA
                Move 0 to FunctionsA.bPublished
                SaveRecord FunctionsA
            Unlock
            Constrained_Find Next
        Loop
    End_Procedure

    // Sets ONE function's stored Parameter and returns its PREVIOUS value, so a caller can restore it.
    // The engine takes a refactor function's parameter from the TABLE (BuildDispatchList reads
    // FunctionsA.Parameter), not from whoever starts the run - so a caller driving a parameterised refactor
    // for one transient run has to write it here, and must put the user's own value back afterwards. Same
    // rule as the Selected flags: a transient run must leave the standing configuration as it found it.
    Function SetFunctionParameter String sFunctionName String sParameter Returns String
        String sPrev
        Move "" to sPrev
        Clear FunctionsA
        Move sFunctionName to FunctionsA.Function_Name
        Find eq FunctionsA.Function_Name
        If (Found = True) Begin
            Move (Trim(FunctionsA.Parameter)) to sPrev
            Reread FunctionsA
                Move sParameter to FunctionsA.Parameter
                SaveRecord FunctionsA
            Unlock
        End
        Function_Return sPrev
    End_Function

    Function CreateNewRecordFromMetaTag tFuncLib FuncLib Returns Boolean
        Integer iID
        String[] asEnumList
        String sParamValidation

        Move False to Err
        Move FuncLib.FuncEnumList.asEnumList to asEnumList
        Get SanitizeStringArrayValues asEnumList to asEnumList
        Move (StrJoinFromArray(asEnumList, ",")) to sParamValidation

        Clear FunctionsA
        Get AutoCreateNewID File_Field FunctionsA.ID to iID
        Move 1                                   to FunctionsA.bPublished
        Move FuncLib.sName                       to FunctionsA.Function_Name
        Move FuncLib.sHelp                       to FunctionsA.Function_Help
        Move FuncLib.eFunctionType               to FunctionsA.Type
        Move FuncLib.sSummary                    to FunctionsA.SummaryText
        Move FuncLib.bFuncEnumList               to FunctionsA.bHasParameter
        Move FuncLib.FuncEnumList.sInitialValue  to FunctionsA.Parameter
        Move FuncLib.FuncEnumList.sParamHelp     to FunctionsA.ParameterHelp
        Move sParamValidation                    to FunctionsA.ParameterValidation
        Move FuncLib.bPrivate                    to FunctionsA.bPrivate
        Move FuncLib.eFunctionGroup              to FunctionsA.FnGroup
        SaveRecord FunctionsA
        Function_Return (not(Err))
    End_Function

    Function UpdateRecordFromMetaTag tFuncLib FuncLib Returns Boolean
        Integer iID iPos
        String[] asEnumList
        String sParamValidation

        Move False to Err
        Move FuncLib.FuncEnumList.asEnumList to asEnumList
        Get SanitizeStringArrayValues asEnumList to asEnumList
        Move (StrJoinFromArray(asEnumList, ",")) to sParamValidation

        Reread
            Move 1 to FunctionsA.bPublished
            If (Trim(FuncLib.sHelp) <> Trim(FunctionsA.Function_Help)) Begin
                Move FuncLib.sHelp to FunctionsA.Function_Help
            End
            If (Trim(FuncLib.eFunctionType) <> Trim(FunctionsA.Type)) Begin
                Move FuncLib.eFunctionType to FunctionsA.Type
            End
            If (Trim(FuncLib.sSummary) <> Trim(FunctionsA.SummaryText)) Begin
                Move FuncLib.sSummary to FunctionsA.SummaryText
            End
            If (Trim(FuncLib.bFuncEnumList) <> Trim(FunctionsA.bHasParameter)) Begin
                Move FuncLib.bFuncEnumList to FunctionsA.bHasParameter
            End
            // The chosen Parameter is USER state and must persist across
            // restarts, exactly like the Selected state and Export/Import do.
            // { InitialValue } is only a first-use default / fallback, never a
            // per-startup reset. Apply it ONLY when the stored value is blank
            // (first run) or is no longer one of the allowed values (the
            // function's { EnumList } was changed in code) - otherwise keep
            // the user's choice.
            If (Trim(FunctionsA.Parameter) = "") Begin
                Move FuncLib.FuncEnumList.sInitialValue to FunctionsA.Parameter
            End
            Else If (Lowercase(sParamValidation) <> "any") Begin
                Move (SearchArray(Trim(FunctionsA.Parameter), asEnumList)) to iPos
                If (iPos = -1) Begin
                    Move FuncLib.FuncEnumList.sInitialValue to FunctionsA.Parameter
                End
            End
            If (Trim(FuncLib.FuncEnumList.sParamHelp) <> Trim(FunctionsA.ParameterHelp)) Begin
                Move FuncLib.FuncEnumList.sParamHelp    to FunctionsA.ParameterHelp
            End
            If (Trim(sParamValidation) <> Trim(FunctionsA.ParameterValidation)) Begin
                Move sParamValidation to FunctionsA.ParameterValidation
            End
            // bPrivate is fully declarative -- the { Private = True } meta-tag
            // is the only source of truth. Records that used to be marked
            // Private via FunctionMaintenance.vw will be reset to 0 unless
            // their source carries the tag.
            If (Trim(FuncLib.bPrivate) <> Trim(FunctionsA.bPrivate)) Begin
                Move FuncLib.bPrivate to FunctionsA.bPrivate
            End
            // FnGroup is declarative (the { FnGroup } meta-tag is the source of
            // truth); a blank/absent tag yields eFnGroupOther(0).
            If (Trim(FuncLib.eFunctionGroup) <> Trim(FunctionsA.FnGroup)) Begin
                Move FuncLib.eFunctionGroup to FunctionsA.FnGroup
            End
            SaveRecord FunctionsA
        Unlock
        Function_Return (not(Err))
    End_Function

    // Removes any spaces from array string values.
    // Also removes and quotes or double-quotes ("') characters.
    Function SanitizeStringArrayValues String[] asEnumList Returns String[]
        Integer iSize iCount
        Move (SizeOfArray(asEnumList)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move (Trim(asEnumList[iCount])) to asEnumList[iCount]
            Move (Replaces('"', asEnumList[iCount], "")) to asEnumList[iCount]
            Move (Replaces("'", asEnumList[iCount], "")) to asEnumList[iCount]
        Loop
        Function_Return asEnumList
    End_Function

End_Class

#IFDEF Is$WebApp
#ELSE
Use Functions.sl
#ENDIF
