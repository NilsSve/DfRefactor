Use RefactorConstants.h.pkg
// Unit tests for RunOriginText (cRefactorEngine.pkg) - the run-origin label shown in the
// summary log ("Run source:"). RunOriginText is a global, pure enum->label map, so the engine's
// peRunOrigin (set by each entry point; stamped eRunBatch by StartEngine for a /bm run) reads as
// a human-readable line in the saved summary.
Object oRunOriginText is a cTestFixture
    Set psFunctionName to "RunOriginText"

    {Published = True}
    Procedure RunOriginText_Manual
        Send AssertSAreEqual "Manual selection (Start Refactoring)" (RunOriginText(ghoEngine, eRunManual))
    End_Procedure

    {Published = True}
    Procedure RunOriginText_Plan
        Send AssertSAreEqual "Refactor Plan (from Analyze)" (RunOriginText(ghoEngine, eRunPlan))
    End_Procedure

    {Published = True}
    Procedure RunOriginText_DeepScan
        Send AssertSAreEqual "Refactor Plan (from Analyze Source)" (RunOriginText(ghoEngine, eRunDeepScan))
    End_Procedure

    {Published = True}
    Procedure RunOriginText_Batch
        Send AssertSAreEqual "Batch mode (command-line)" (RunOriginText(ghoEngine, eRunBatch))
    End_Procedure

    {Published = True}
    Procedure RunOriginText_TestBench
        Send AssertSAreEqual "Test Bench" (RunOriginText(ghoEngine, eRunTestBench))
    End_Procedure

    // An unknown / uninitialized origin must fall back to the safe "Manual" label, never blank.
    {Published = True}
    Procedure RunOriginText_UnknownDefaultsToManual
        Send AssertSAreEqual "Manual selection (Start Refactoring)" (RunOriginText(ghoEngine, 99))
    End_Procedure

    // Gate for the run summary's subclass-parameter hint: a 0-conversion class converter gets the
    // "set the class-names parameter" line ONLY when it actually exposes an {EnumList} parameter -
    // the grid/list converters do, a plain command converter and an unknown name never (a 0 there
    // must stay hint-free). pFuncLibArray-backed, so it answers in the pure DFUnit runner too.
    {Published = True}
    Procedure RunSummary_FunctionHasEnumListParam
        Boolean bGrid bList bTrim bUnknown bBlank
        Get FunctionHasEnumListParam of ghoFuncLib "RefactorDbGridTocDbCJGrid" to bGrid
        Get FunctionHasEnumListParam of ghoFuncLib "refactordblisttocdbcjgridpromptlist" to bList
        Get FunctionHasEnumListParam of ghoFuncLib "ChangeTrimCommandToFunction" to bTrim
        Get FunctionHasEnumListParam of ghoFuncLib "NoSuchFunctionName" to bUnknown
        Get FunctionHasEnumListParam of ghoFuncLib "" to bBlank
        Send Assert bGrid
        Send Assert bList
        Send AssertFalse bTrim
        Send AssertFalse bUnknown
        Send AssertFalse bBlank
    End_Procedure
End_Object
