//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeIfchangeCommandToAttribute-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-15
//
// Description : Unit tests for the ChangeIfchangeCommandToAttribute refactor function - the
//               obsolete Ifchange command to a DF_FILE_CHANGED read and the test it guarded.
//               They drive the worker (_TransformIfchangeCommands, cRefactorFuncLib); the
//               published function is a one-line call onto it.
//
//               This is the only converter in its family that writes a DECLARATION into someone's
//               method, so most of what is pinned here is about that: one Boolean per method, none
//               where the method already has it - looking FORWARD as well as back, because the
//               declaration sits above its first use and a second run over a method that gained an
//               Ifchange above the converted one would otherwise stop the file compiling.
//
//               The declining cases are all shapes that COMPILE today (verified against DF26), so
//               each is a real line somebody can have written, not a hypothetical.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeIfchangeCommandToAttribute is a cTestFixture
        Set psFunctionName to "ChangeIfchangeCommandToAttribute"

        // ---------------------------------------------------------------- converting

        /* THE DOCS' OWN EXAMPLE - "ifchange pay gosub logchange" - in the shape the DataFlex
           framework uses for this attribute: read it into a Boolean, test the Boolean. */
        { Published = True }
        Procedure Ifchange_DocsExampleConverts
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                 to asCode[0]
            Move "    Ifchange pay gosub logchange" to asCode[1]
            Move "End_Procedure"                    to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual "    Boolean bDfrFileChanged" asCode[1]
            Send AssertSAreEqual "    Get_Attribute DF_FILE_CHANGED of pay.File_Number to bDfrFileChanged" asCode[2]
            Send AssertSAreEqual "    If bDfrFileChanged gosub logchange" asCode[3]
            Send AssertSAreEqual "End_Procedure" asCode[4]
        End_Procedure

        // Indentation and a trailing comment ride across untouched, and so does the guarded
        // command's own casing.
        { Published = True }
        Procedure Ifchange_IndentAndTrailingCommentKept
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                                              to asCode[0]
            Move "        IfChange Customer Send OnCustomerChanged   // log it"  to asCode[1]
            Move "End_Procedure"                                                 to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertSAreEqual "        Boolean bDfrFileChanged" asCode[1]
            Send AssertSAreEqual "        Get_Attribute DF_FILE_CHANGED of Customer.File_Number to bDfrFileChanged" asCode[2]
            Send AssertSAreEqual "        If bDfrFileChanged Send OnCustomerChanged   // log it" asCode[3]
        End_Procedure

        // A file argument already written as <file>.File_Number is used as it stands - the suffix
        // is not doubled.
        { Published = True }
        Procedure Ifchange_FileNumberArgumentIsNotDoubled
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                              to asCode[0]
            Move "    Ifchange pay.File_Number Send OnChanged"   to asCode[1]
            Move "End_Procedure"                                 to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertSAreEqual "    Get_Attribute DF_FILE_CHANGED of pay.File_Number to bDfrFileChanged" asCode[2]
        End_Procedure

        // ---------------------------------------------------------------- one Boolean per method

        // Two commands in ONE method share the one declaration - a second would not compile.
        { Published = True }
        Procedure Ifchange_TwoInOneMethodShareOneDeclaration
            String[] asCode
            Integer iN i iDecls

            Move "Procedure DoSave"                     to asCode[0]
            Move "    Ifchange pay gosub logchange"     to asCode[1]
            Move "    Ifchange cust Send OnCustChanged" to asCode[2]
            Move "End_Procedure"                        to asCode[3]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 2 iN
            Move 0 to iDecls
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = "Boolean bDfrFileChanged") ;
                    Increment iDecls
            Loop
            Send AssertIAreEqual 1 iDecls
            Send AssertIAreEqual 7 (SizeOfArray(asCode))
        End_Procedure

        // A SECOND method needs its own - the flag is a local, and the first one's is out of scope.
        { Published = True }
        Procedure Ifchange_EachMethodGetsItsOwnDeclaration
            String[] asCode
            Integer iN i iDecls

            Move "Procedure DoSave"                 to asCode[0]
            Move "    Ifchange pay gosub logchange" to asCode[1]
            Move "End_Procedure"                    to asCode[2]
            Move "Procedure DoOther"                to asCode[3]
            Move "    Ifchange cust gosub logother" to asCode[4]
            Move "End_Procedure"                    to asCode[5]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 2 iN
            Move 0 to iDecls
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = "Boolean bDfrFileChanged") ;
                    Increment iDecls
            Loop
            Send AssertIAreEqual 2 iDecls
        End_Procedure

        // A method that ALREADY declares the flag keeps the one it has.
        { Published = True }
        Procedure Ifchange_ExistingDeclarationAboveIsReused
            String[] asCode
            Integer iN i iDecls

            Move "Procedure DoSave"                 to asCode[0]
            Move "    Boolean bDfrFileChanged"      to asCode[1]
            Move "    Ifchange pay gosub logchange" to asCode[2]
            Move "End_Procedure"                    to asCode[3]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Move 0 to iDecls
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = "Boolean bDfrFileChanged") ;
                    Increment iDecls
            Loop
            Send AssertIAreEqual 1 iDecls
        End_Procedure

        /* THE FORWARD LOOK, and why it exists: the declaration sits ABOVE its first use, so on a
           method converted earlier that has since gained an Ifchange higher up, a backward-only
           check would add a second one and the file would stop compiling. */
        { Published = True }
        Procedure Ifchange_ExistingDeclarationBelowIsFound
            String[] asCode
            Integer iN i iDecls

            Move "Procedure DoSave"                 to asCode[0]
            Move "    Ifchange pay gosub logchange" to asCode[1]
            Move "    Boolean bDfrFileChanged"      to asCode[2]
            Move "End_Procedure"                    to asCode[3]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Move 0 to iDecls
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = "Boolean bDfrFileChanged") ;
                    Increment iDecls
            Loop
            Send AssertIAreEqual 1 iDecls
        End_Procedure

        // ---------------------------------------------------------------- declining

        /* THE BODY OF A SEMI-COLON CONTINUATION. Three lines here would put the Get_Attribute under
           that If and orphan the rest. The marker is TRAILING, never a line above - an inserted line
           would steal the guard from the statement before it. */
        { Published = True }
        Procedure Ifchange_ContinuationBodyIsDeclinedWithATodo
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                  to asCode[0]
            Move "    If (bGo) ;"                    to asCode[1]
            Move "        Ifchange pay gosub logit"  to asCode[2]
            Move "End_Procedure"                     to asCode[3]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertSAreEqual "    If (bGo) ;" asCode[1]
            Send Assert (asCode[2] contains "        Ifchange pay gosub logit")
            Send Assert (asCode[2] contains "TODO (DFRefactor)")
            Send Assert (asCode[2] contains ";-continuation")
        End_Procedure

        // Outside a Procedure / Function the flag would have to be a global - a bigger decision
        // than this conversion is allowed to make, so it says so and leaves the line.
        { Published = True }
        Procedure Ifchange_OutsideAMethodIsDeclinedWithATodo
            String[] asCode
            Integer iN

            Move "Ifchange pay Send DoSomething" to asCode[0]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 1 (SizeOfArray(asCode))
            Send Assert (asCode[0] contains "TODO (DFRefactor)")
            Send Assert (asCode[0] contains "outside a Procedure")
        End_Procedure

        // A file argument that is not a plain table name: FMAC takes a file NUMBER there too, and
        // nothing in the source says which this is.
        { Published = True }
        Procedure Ifchange_UnresolvableFileArgumentIsDeclinedWithATodo
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                    to asCode[0]
            Move "    Ifchange pay.rec Send OnChange"  to asCode[1]
            Move "End_Procedure"                       to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Send Assert (asCode[1] contains "TODO (DFRefactor)")
            Send Assert (asCode[1] contains "plain table name")
        End_Procedure

        /* NOT AT COMMAND POSITION - and this one is NOT marked either. The Deep Scan rule matches
           the first word too, so there is no row to silence, and a TODO on a line nothing flagged
           would be noise. */
        { Published = True }
        Procedure Ifchange_NonLeadingIsLeftAloneAndUnmarked
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                          to asCode[0]
            Move "    If (bGo) Ifchange pay gosub logchange" to asCode[1]
            Move "End_Procedure"                             to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 0 iN
            Send AssertSAreEqual "    If (bGo) Ifchange pay gosub logchange" asCode[1]
        End_Procedure

        // A comment and a string mention are not the command.
        { Published = True }
        Procedure Ifchange_CommentAndStringAreLeftAlone
            String[] asCode
            Integer iN

            Move "Procedure DoSave"                      to asCode[0]
            Move "    // Ifchange pay gosub logchange"   to asCode[1]
            Move '    Move "Ifchange pay" to sHelp'      to asCode[2]
            Move "End_Procedure"                         to asCode[3]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN

            Send AssertIAreEqual 0 iN
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertSAreEqual "    // Ifchange pay gosub logchange" asCode[1]
            Send AssertSAreEqual '    Move "Ifchange pay" to sHelp' asCode[2]
        End_Procedure

        // ---------------------------------------------------------------- running it twice

        // Converted output holds no Ifchange, so a second pass has nothing to do and changes nothing.
        { Published = True }
        Procedure Ifchange_ConvertedOutputIsStable
            String[] asCode asFirst
            Integer iN i

            Move "Procedure DoSave"                 to asCode[0]
            Move "    Ifchange pay gosub logchange" to asCode[1]
            Move "End_Procedure"                    to asCode[2]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN
            Send AssertIAreEqual 1 iN
            Move asCode to asFirst
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN
            Send AssertIAreEqual 0 iN
            Send AssertIAreEqual (SizeOfArray(asFirst)) (SizeOfArray(asCode))
            For i from 0 to (SizeOfArray(asFirst) - 1)
                Send AssertSAreEqual asFirst[i] asCode[i]
            Loop
        End_Procedure

        // A line already carrying a marker is not marked a second time - re-running must not stack
        // TODOs up on the lines it keeps declining.
        { Published = True }
        Procedure Ifchange_DeclinedLineIsNotMarkedTwice
            String[] asCode
            Integer iN

            Move "Ifchange pay Send DoSomething" to asCode[0]
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN
            Send AssertIAreEqual 1 iN
            Get _TransformIfchangeCommands of ghoFuncLib (&asCode) to iN
            Send AssertIAreEqual 0 iN
            Send AssertIAreEqual 1 (SizeOfArray(asCode))
        End_Procedure

    End_Object
