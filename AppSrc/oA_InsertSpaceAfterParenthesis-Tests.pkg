    Object oA_InsertSpaceAfterParenthesis is a cTestFixture
        Set psFunctionName to "A_InsertSpaceAfterParenthesis"

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_1
            // ))Begin -> )) Begin
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If ((Modrv.dolt Eq 0) Or (Modrv.dolt Eq 1))Begin    // active eller hiden' to sLine
            Move '    If ((Modrv.dolt Eq 0) Or (Modrv.dolt Eq 1)) Begin    // active eller hiden' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_2
            // )Move -> ) Move
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bOk)Move iA to iB' to sLine
            Move '    If (bOk) Move iA to iB' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_3
            // No change needed -- already has a space
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bOk) Move iA to iB' to sLine
            Move '    If (bOk) Move iA to iB' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_4
            // )Send -> ) Send
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (iVal > 0)Send Info_Box "Yes"' to sLine
            Move '    If (iVal > 0) Send Info_Box "Yes"' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_5
            // Should not insert space between ) and a digit or operator
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Move (iA + iB) to iC' to sLine
            Move '    Move (iA + iB) to iC' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_6
            // )Send -> ) Send
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            [Found  ]Set Field_Changed_Value Field Koffhuv.betvillkor_namn  to betvillk.namn' to sLine
            Move '            [Found  ] Set Field_Changed_Value Field Koffhuv.betvillkor_namn  to betvillk.namn' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_StringUntouched
            // A string literal is text, never code: "(C)redit" stays (a live run, 2026-10-24)
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set Status_Help Field Apbody.Dc To "Whether to (C)redit or (D)ebit the expense account."' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_SingleQuotedStringUntouched
            // The same for a single-quoted string
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Move 'Press (Y)es or (N)o' to sPrompt" to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_EndCommentUntouched
            // ]Begin -> ] Begin, but the end comment's (a)b stays
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [Found]Begin // see (a)b' to sLine
            Move '    [Found] Begin // see (a)b' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_CodeBeforeAString
            // )Move -> ) Move in the code, the string after it left as it is
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bOk)Move "(C)redit" to sText' to sLine
            Move '    If (bOk) Move "(C)redit" to sText' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_TabIndented
            // Tab indentation: the positions still line up with the masked line, and the tabs stay
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move (Character(9) + Character(9) + "[Found]Begin") to sLine
            Move (Character(9) + Character(9) + "[Found] Begin") to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_StillLinedUpAfterAnInsert
            // After the first space the string's ']' and ')' are still recognised as string text
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bOk)Move "[x]y (C)redit" to s' to sLine
            Move '    If (bOk) Move "[x]y (C)redit" to s' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_RawMaskedLine
            // A line with only triple quotes: the tokenizer stores the raw, untrimmed line as the masked one,
            // so no indentation is taken off (with it, the shifted spot is the '_' and the space was lost) - )Begin -> ) Begin
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (x = """ab_""")Begin' to sLine
            Move '    If (x = """ab_""") Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure A_InsertSpaceAfterParenthesis_MaskedLineOutOfStep
            // A bare "//" end comment after a string holding "//": the tokenizer cuts the first "//", so the
            // masked line is shifted - the bracket then counts as it did before, )Begin -> ) Begin
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (Pos("http://", sUrl))Begin //' to sLine
            Move 'If (Pos("http://", sUrl)) Begin //' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual sExpected sLine
        End_Procedure

    End_Object
