//****************************************************************************
// $Module type: Test fixture
// $Module name: oRefactorLineSplit-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-28
//
// Description : RefactorSplitLine replaced SciControlLib's cLineParser - 244 lines and an Array
//               subclass - with one function. These pin the edge cases that made it worth writing by
//               hand instead of calling DataFlex's StrSplitToArray, because the difference between the
//               two is exactly one blank element in places where a blank element is not harmless:
//               LoadElementString feeds the language definitions, and those seed ghoFuncLib's keyword
//               arrays. An extra empty keyword does not throw; the engine just stops matching a word
//               nobody notices until a refactor silently skips it.
//
//               EditorSettings_LiveStoreServesVdfLanguage covers the live path end to end (VDF's 264
//               keywords still arrive and still contain "Move"). What is below is the behaviour that
//               path depends on, stated one case at a time.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorLineSplit.pkg

Object oRefactorLineSplit is a cTestFixture
    Set psFunctionName to "RefactorLineSplit"

    // THE ONE THAT MATTERS. The original loops "until the line is empty", so a trailing
    // separator yields nothing extra - "a,b," is TWO parts. StrSplitToArray gives three.
    {Published = True}
    Procedure RefactorLineSplit_TrailingSeparatorAddsNoEmptyPart
        String[] asParts
        Get RefactorSplitLine "a,b," "," to asParts
        Send AssertIAreEqual 2 (SizeOfArray(asParts))
        Send AssertSAreEqual "a" asParts[0]
        Send AssertSAreEqual "b" asParts[1]
    End_Procedure

    // ...but an empty part BETWEEN separators is real data and is kept.
    {Published = True}
    Procedure RefactorLineSplit_InteriorEmptyPartsAreKept
        String[] asParts
        Get RefactorSplitLine "a,,b" "," to asParts
        Send AssertIAreEqual 3 (SizeOfArray(asParts))
        Send AssertSAreEqual "a" asParts[0]
        Send AssertSAreEqual ""  asParts[1]
        Send AssertSAreEqual "b" asParts[2]
    End_Procedure

    // Nothing is trimmed. The parts come back as they were written, spaces and all.
    {Published = True}
    Procedure RefactorLineSplit_DoesNotTrimParts
        String[] asParts
        Get RefactorSplitLine "a , b" "," to asParts
        Send AssertIAreEqual 2 (SizeOfArray(asParts))
        Send AssertSAreEqual "a " asParts[0]
        Send AssertSAreEqual " b" asParts[1]
    End_Procedure

    // A SPACE separator left-trims what remains after each part, so a run of spaces
    // collapses instead of producing a string of empties.
    {Published = True}
    Procedure RefactorLineSplit_SpaceSeparatorCollapsesRuns
        String[] asParts
        Get RefactorSplitLine "one   two three" " " to asParts
        Send AssertIAreEqual 3 (SizeOfArray(asParts))
        Send AssertSAreEqual "one"   asParts[0]
        Send AssertSAreEqual "two"   asParts[1]
        Send AssertSAreEqual "three" asParts[2]
    End_Procedure

    // A multi-character separator - the language definitions join keyword lists with the
    // literal two-character "\n", which is exactly this case.
    {Published = True}
    Procedure RefactorLineSplit_MultiCharacterSeparator
        String[] asParts
        Get RefactorSplitLine "KwA\nKwB\nKwC" "\n" to asParts
        Send AssertIAreEqual 3 (SizeOfArray(asParts))
        Send AssertSAreEqual "KwA" asParts[0]
        Send AssertSAreEqual "KwB" asParts[1]
        Send AssertSAreEqual "KwC" asParts[2]
    End_Procedure

    // No separator present: the whole line is one part.
    {Published = True}
    Procedure RefactorLineSplit_NoSeparatorGivesOnePart
        String[] asParts
        Get RefactorSplitLine "justoneword" "," to asParts
        Send AssertIAreEqual 1 (SizeOfArray(asParts))
        Send AssertSAreEqual "justoneword" asParts[0]
    End_Procedure

    // Degenerate input answers with an empty array rather than a part that is not there.
    // The old class returned an empty Array here too; callers loop over the count.
    {Published = True}
    Procedure RefactorLineSplit_EmptyInputGivesNoParts
        String[] asParts
        Get RefactorSplitLine "" "," to asParts
        Send AssertIAreEqual 0 (SizeOfArray(asParts))
        Get RefactorSplitLine "a,b" "" to asParts
        Send AssertIAreEqual 0 (SizeOfArray(asParts))
    End_Procedure

End_Object
