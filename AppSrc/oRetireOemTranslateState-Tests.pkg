//****************************************************************************
// $Module type: Test fixture
// $Module name: oRetireOemTranslateState-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-19
//
// Description : Oem_Translate_State (W 4540) - it does nothing on a Unicode DataFlex, but the two shapes are not the
//               same problem. A "Set" is a no-op and is commented in place. A "Get ... to <var>" feeds a TEST, so
//               dropping the Get alone would leave the variable at its declared default (False), flip "not(var)" to
//               always-true and run the guarded body unconditionally - in the real WinServ case a Utf8ToAnsi() on its
//               way into a control that is Unicode now. These tests pin that the whole block goes instead, and that
//               every guard leaves the source untouched rather than guessing.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Object oRetireOemTranslateState is a cTestFixture
    Set psFunctionName to "RetireOemTranslateState"

    Function Retired String[] asIn Returns String[]
        Integer iVoid
        Get _RetireOemTranslateStateInLines of ghoFuncLib (&asIn) to iVoid
        Function_Return asIn
    End_Function

    Function RetiredCount String[] asIn Returns Integer
        Integer iN
        Get _RetireOemTranslateStateInLines of ghoFuncLib (&asIn) to iN
        Function_Return iN
    End_Function

    // The 18-of-20 case: a Set inside an Object block. Commented in place, indent kept, marker appended.
    {Published = True}
    Procedure OemState_SetIsCommentedInPlace
        String[] asIn asOut
        Move "        Set Oem_Translate_State to False" to asIn[0]
        Move (Retired(Self, asIn)) to asOut
        Send AssertIAreEqual 1 (SizeOfArray(asOut))
        Send Assert (asOut[0] contains "// Set Oem_Translate_State to False")
        Send Assert (asOut[0] contains "W 4540")
        // The indent survives.
        Send AssertSAreEqual "        " (Left(asOut[0], 8))
    End_Procedure

    // "Set ... of <object> to ..." is the same no-op.
    {Published = True}
    Procedure OemState_SetWithReceiverIsCommented
        String[] asIn asOut
        Move "    Set Oem_Translate_State of (oForm(Self)) to True" to asIn[0]
        Move (Retired(Self, asIn)) to asOut
        Send Assert (asOut[0] contains "// Set Oem_Translate_State of (oForm(Self)) to True")
    End_Procedure

    /* THE WINSERV BLOCK (TextReg.dg:127). The Get AND the If AND its body all go behind the marker;
       the guarded body must not be left to run unconditionally. */
    {Published = True}
    Procedure OemState_GetPlusIfBlockGoesTogether
        String[] asIn asOut

        Move "        Get Oem_Translate_State of (phTextRegParent(Self)) to bOEMTranslateState" to asIn[0]
        Move "        If (not(bOEMTranslateState)) Begin" to asIn[1]
        Move "            Move (Utf8ToAnsi(sText)) to sText" to asIn[2]
        Move "        End" to asIn[3]
        Move "        Move sText to sResult" to asIn[4]
        Move (Retired(Self, asIn)) to asOut
        // 5 marker lines + 4 commented + the untouched tail.
        Send AssertIAreEqual 10 (SizeOfArray(asOut))
        Send Assert (asOut[0] contains "DFRefactor: Oem_Translate_State is obsolete")
        Send Assert (asOut[5] contains "// Get Oem_Translate_State")
        Send Assert (asOut[6] contains "// If (not(bOEMTranslateState)) Begin")
        Send Assert (asOut[7] contains "// Move (Utf8ToAnsi(sText)) to sText")
        Send AssertSAreEqual "        // End" asOut[8]
        // The line after the block is untouched.
        Send AssertSAreEqual "        Move sText to sResult" asOut[9]
    End_Procedure

    /* THE CONTROL FOR EVERY GUARD TEST BELOW. Each of those asserts that NOTHING happens - which is also
       what a broken reader does, so they all passed while the variable name was being truncated by one
       character and no block was ever recognised. This one asserts the positive: the same fixture minus
       the guard-tripping line MUST be retired. If this fails, the guard tests below prove nothing. */
    {Published = True}
    Procedure OemState_ControlThePositiveCaseIsRecognised
        String[] asIn
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        If (not(bOEM)) Begin" to asIn[1]
        Move "            Move 1 to iX" to asIn[2]
        Move "        End" to asIn[3]
        Send AssertIAreEqual 4 (RetiredCount(Self, asIn))
    End_Procedure

    // GUARD: the variable is read somewhere else too -> leave everything alone.
    {Published = True}
    Procedure OemState_GuardVariableUsedElsewhere
        String[] asIn asOut
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        If (not(bOEM)) Begin" to asIn[1]
        Move "            Move 1 to iX" to asIn[2]
        Move "        End" to asIn[3]
        Move "        If (bOEM) Move 2 to iY" to asIn[4]
        Move (Retired(Self, asIn)) to asOut
        Send AssertIAreEqual 5 (SizeOfArray(asOut))
        Send AssertSAreEqual "        Get Oem_Translate_State of (hoX(Self)) to bOEM" asOut[0]
        Send AssertIAreEqual 0 (RetiredCount(Self, asIn))
    End_Procedure

    // GUARD: an Else means one branch is live code - which one is a judgement, so nothing is touched.
    {Published = True}
    Procedure OemState_GuardElseBranch
        String[] asIn asOut
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        If (not(bOEM)) Begin" to asIn[1]
        Move "            Move 1 to iX" to asIn[2]
        Move "        End" to asIn[3]
        Move "        Else Begin" to asIn[4]
        Move "            Move 2 to iX" to asIn[5]
        Move "        End" to asIn[6]
        Move (Retired(Self, asIn)) to asOut
        Send AssertSAreEqual "        Get Oem_Translate_State of (hoX(Self)) to bOEM" asOut[0]
        Send AssertIAreEqual 0 (RetiredCount(Self, asIn))
    End_Procedure

    // GUARD: the Get is not followed by a test of its variable -> not this shape, leave it.
    {Published = True}
    Procedure OemState_GuardNextLineIsNotTheTest
        String[] asIn asOut
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        Send DoSomethingElse" to asIn[1]
        Move (Retired(Self, asIn)) to asOut
        Send AssertSAreEqual "        Get Oem_Translate_State of (hoX(Self)) to bOEM" asOut[0]
        Send AssertIAreEqual 0 (RetiredCount(Self, asIn))
    End_Procedure

    // A declined read site is COUNTED, so the run can name it instead of skipping silently.
    {Published = True}
    Procedure OemState_DeclinedSitesAreCounted
        String[] asIn
        Integer iVoid
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        Send DoSomethingElse" to asIn[1]
        Get _RetireOemTranslateStateInLines of ghoFuncLib (&asIn) to iVoid
        Send AssertIAreEqual 1 (piOemStateDeclined(ghoFuncLib))
    End_Procedure

    // Nested Begin/End inside the block: the MATCHING End closes it, not the first one.
    {Published = True}
    Procedure OemState_NestedBlockFindsMatchingEnd
        String[] asIn asOut
        Move "        Get Oem_Translate_State of (hoX(Self)) to bOEM" to asIn[0]
        Move "        If (not(bOEM)) Begin" to asIn[1]
        Move "            If (bOther) Begin" to asIn[2]
        Move "                Move 1 to iX" to asIn[3]
        Move "            End" to asIn[4]
        Move "        End" to asIn[5]
        Move "        Move 9 to iZ" to asIn[6]
        Move (Retired(Self, asIn)) to asOut
        Send AssertSAreEqual "        Move 9 to iZ" asOut[(SizeOfArray(asOut) - 1)]
        Send Assert (asOut[(SizeOfArray(asOut) - 2)] contains "// End")
    End_Procedure

    // IDEMPOTENT: an already-commented line carries no code, so a re-run leaves it alone.
    {Published = True}
    Procedure OemState_AlreadyCommentedIsUntouched
        String[] asIn asOut
        Move "            //Set Oem_Translate_State to False" to asIn[0]
        Move (Retired(Self, asIn)) to asOut
        Send AssertIAreEqual 1 (SizeOfArray(asOut))
        Send AssertSAreEqual "            //Set Oem_Translate_State to False" asOut[0]
        Send AssertIAreEqual 0 (RetiredCount(Self, asIn))
    End_Procedure

    // A file without the property is returned unchanged, and costs nothing.
    {Published = True}
    Procedure OemState_UnrelatedFileUntouched
        String[] asIn asOut
        Move "Procedure Foo" to asIn[0]
        Move "    Move 1 to iX" to asIn[1]
        Move "End_Procedure" to asIn[2]
        Move (Retired(Self, asIn)) to asOut
        Send AssertIAreEqual 3 (SizeOfArray(asOut))
        Send AssertSAreEqual "    Move 1 to iX" asOut[1]
        Send AssertIAreEqual 0 (RetiredCount(Self, asIn))
    End_Procedure

End_Object
