//****************************************************************************
// $Module type: Test fixture
// $Module name: oSortSourceCode-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-04
//
// Description : Unit tests for cSortSourceCode's method scanning (FillSourceCodeStruct,
//               CopyMethodCode).
//
//               The compiler accepts a Function closed with End_Procedure and the reverse, and
//               real code does it (39 files in one workspace). Until 2026-09-04 both scanners
//               waited for the header's OWN ender: FillSourceCodeStruct ran a mismatched method
//               on to the next matching ender or the End_Class and lost every method in between
//               from the sort, and CopyMethodCode copied to the end of the file. The same defect
//               damaged a workspace through cRemoveUnusedLocals on 2026-09-03.
//
//               Each test pairs the mismatched form with a well-formed neighbour, so a scanner
//               that still leaks shows up as a missing or over-long method, not as a green run.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cSortSourceCode.pkg          // fixture subject
    Object oSortSourceCode_Tests is a cTestFixture
        Set psFunctionName to "SortSourceCode"

        Object oSorter is a cSortSourceCode
        End_Object

        // A class holding a Function closed with End_Procedure, followed by a well-formed Procedure.
        Function _FunctionClosedWithEndProcedure Returns String[]
            String[] asCode

            Move "Class cDraw is a cObject"                     to asCode[0]
            Move "    Function MakeDraw Returns Number"         to asCode[1]
            Move "        Number nId"                           to asCode[2]
            Move "        Move 1 to nId"                        to asCode[3]
            Move "        Function_Return nId"                  to asCode[4]
            Move "    End_Procedure"                            to asCode[5]
            Move ""                                             to asCode[6]
            Move "    Procedure Reset"                          to asCode[7]
            Move "        Send None"                            to asCode[8]
            Move "    End_Procedure"                            to asCode[9]
            Move "End_Class"                                    to asCode[10]
            Function_Return asCode
        End_Function

        // The mirror: a Procedure closed with End_Function, followed by a well-formed Function.
        Function _ProcedureClosedWithEndFunction Returns String[]
            String[] asCode

            Move "Class cDraw is a cObject"                     to asCode[0]
            Move "    Procedure Reset"                          to asCode[1]
            Move "        Send None"                            to asCode[2]
            Move "    End_Function"                             to asCode[3]
            Move "    Function MakeDraw Returns Number"         to asCode[4]
            Move "        Function_Return 1"                    to asCode[5]
            Move "    End_Function"                             to asCode[6]
            Move "End_Class"                                    to asCode[7]
            Function_Return asCode
        End_Function

        {Published = True}
        Procedure FillStruct_FunctionClosedWithEndProcedure_KeepsBothMethods
            String[] asCode
            tSourceCode[] TheData

            Get _FunctionClosedWithEndProcedure to asCode
            Get FillSourceCodeStruct of oSorter asCode to TheData
            Send AssertIAreEqual 1 (SizeOfArray(TheData))
            Send AssertSAreEqual "cDraw" TheData[0].sClassName
            // Before the fix: the Function never closed, so neither method was recorded.
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.FunctionsData))
            Send AssertSAreEqual "MakeDraw" TheData[0].ClassData.FunctionsData[0].sMethodName
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.ProceduresData))
            Send AssertSAreEqual "Reset" TheData[0].ClassData.ProceduresData[0].sMethodName
        End_Procedure

        {Published = True}
        Procedure FillStruct_ProcedureClosedWithEndFunction_KeepsBothMethods
            String[] asCode
            tSourceCode[] TheData

            Get _ProcedureClosedWithEndFunction to asCode
            Get FillSourceCodeStruct of oSorter asCode to TheData
            Send AssertIAreEqual 1 (SizeOfArray(TheData))
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.ProceduresData))
            Send AssertSAreEqual "Reset" TheData[0].ClassData.ProceduresData[0].sMethodName
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.FunctionsData))
            Send AssertSAreEqual "MakeDraw" TheData[0].ClassData.FunctionsData[0].sMethodName
        End_Procedure

        // The positive control: well-formed enders were never the problem and must still work.
        {Published = True}
        Procedure FillStruct_MatchedEnders_KeepsBothMethods
            String[] asCode
            tSourceCode[] TheData

            Get _FunctionClosedWithEndProcedure to asCode
            Move "    End_Function" to asCode[5]
            Get FillSourceCodeStruct of oSorter asCode to TheData
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.FunctionsData))
            Send AssertIAreEqual 1 (SizeOfArray(TheData[0].ClassData.ProceduresData))
        End_Procedure

        {Published = True}
        Procedure CopyMethodCode_FunctionClosedWithEndProcedure_StopsAtTheEnder
            String[] asCode asCodeLC asMethod asExpected

            Get _FunctionClosedWithEndProcedure to asCode
            Get LowercaseStringArray of oSorter asCode to asCodeLC
            Get CopyMethodCode of oSorter asCode asCodeLC "MakeDraw" True to asMethod

            Move "    Function MakeDraw Returns Number"         to asExpected[0]
            Move "        Number nId"                           to asExpected[1]
            Move "        Move 1 to nId"                        to asExpected[2]
            Move "        Function_Return nId"                  to asExpected[3]
            Move "    End_Procedure"                            to asExpected[4]
            // Before the fix: no End_Function ever came, so the copy ran to the end of the file.
            Send AssertArrayAreEqual asExpected asMethod
        End_Procedure

        {Published = True}
        Procedure CopyMethodCode_ProcedureClosedWithEndFunction_StopsAtTheEnder
            String[] asCode asCodeLC asMethod asExpected

            Get _ProcedureClosedWithEndFunction to asCode
            Get LowercaseStringArray of oSorter asCode to asCodeLC
            Get CopyMethodCode of oSorter asCode asCodeLC "Reset" False to asMethod

            Move "    Procedure Reset"                          to asExpected[0]
            Move "        Send None"                            to asExpected[1]
            Move "    End_Function"                             to asExpected[2]
            Send AssertArrayAreEqual asExpected asMethod
        End_Procedure

        // An ender with a trailing comment closes the method too (IsMetaEnd strips it); the old
        // exact-equality test in CopyMethodCode never matched such a line.
        {Published = True}
        Procedure CopyMethodCode_EnderWithTrailingComment_StopsAtTheEnder
            String[] asCode asCodeLC asMethod asExpected

            Move "Function One Returns Integer"                 to asCode[0]
            Move "    Function_Return 1"                        to asCode[1]
            Move "End_Function // One"                          to asCode[2]
            Move "Function Two Returns Integer"                 to asCode[3]
            Move "    Function_Return 2"                        to asCode[4]
            Move "End_Function"                                 to asCode[5]
            Get LowercaseStringArray of oSorter asCode to asCodeLC
            Get CopyMethodCode of oSorter asCode asCodeLC "One" True to asMethod

            Move "Function One Returns Integer"                 to asExpected[0]
            Move "    Function_Return 1"                        to asExpected[1]
            Move "End_Function // One"                          to asExpected[2]
            Send AssertArrayAreEqual asExpected asMethod
        End_Procedure

    End_Object
