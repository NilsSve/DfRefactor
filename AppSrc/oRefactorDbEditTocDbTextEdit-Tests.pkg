// Web-site    : http://www.rdctools.com
// Created     : 2026-07-03
//
// Description : Unit tests for the RefactorDbEditTocDbTextEdit refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRefactorDbEditTocDbTextEdit is a cTestFixture
        Set psFunctionName to "RefactorDbEditTocDbTextEdit"

        // The LegacyApp Customer.vw shape: class swapped, the shared DEO body (Entry_Item/Size/Location)
        // passes through untouched.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_BasicObject
            String[] asCode
            Integer iCount

            Move '        Object oCustomer_Comments is a dbEdit' to asCode[0]
            Move '            Entry_Item Customer.Comments'      to asCode[1]
            Move '            Set Size to 71 242'                to asCode[2]
            Move '            Set Location to 9 9'               to asCode[3]
            Move '        End_Object'                            to asCode[4]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '        Object oCustomer_Comments is a cDbTextEdit' asCode[0]
            Send AssertSAreEqual '            Entry_Item Customer.Comments' asCode[1]
            Send AssertSAreEqual '            Set Size to 71 242' asCode[2]
            Send AssertSAreEqual '        End_Object' asCode[4]
        End_Procedure

        // Wrap_State INSIDE the converted object -> pbWrap; the SAME property in a sibling (non-edit)
        // object is left alone - the translation is scoped to the converted block.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_WrapStateScoped
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a dbEdit'      to asCode[0]
            Move '    Set Wrap_State to True'     to asCode[1]
            Move 'End_Object'                     to asCode[2]
            Move 'Object oGrid is a dbGrid0'      to asCode[3]
            Move '    Set Wrap_State to True'     to asCode[4]
            Move 'End_Object'                     to asCode[5]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Set pbWrap to True' asCode[1]
            Send AssertSAreEqual '    Set Wrap_State to True' asCode[4]
        End_Procedure

        // A legacy property with NO modern equivalent gets the TODO tag - and only ONCE (idempotent).
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_DeadPropTodo
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a dbEdit'          to asCode[0]
            Move '    Set Capslock_State to True'     to asCode[1]
            Move 'End_Object'                         to asCode[2]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send Assert (asCode[1] contains "TODO (DFRefactor)")
            Send Assert (asCode[1] contains "Capslock_State")
            // Second run: the declaration no longer matches and the TODO is not doubled.
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (not(asCode[1] contains "review.  //"))
        End_Procedure

        // A user SUBCLASS definition ('Class dbEdit0 is a dbEdit' - LegacyApp) has its BASE modernised;
        // the subclass name itself is never touched.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_SubclassBase
            String[] asCode
            Integer iCount
            Move 'Class dbEdit0 is a dbEdit'  to asCode[0]
            Move '    Procedure Construct_Object' to asCode[1]
            Move '        Forward Send Construct_Object' to asCode[2]
            Move '    End_Procedure'          to asCode[3]
            Move 'End_Class'                  to asCode[4]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cDbTextEdit.pkg' asCode[0]
            Send AssertSAreEqual 'Class dbEdit0 is a cDbTextEdit' asCode[1]
        End_Procedure

        // The explicit parameter converts objects of a SUBCLASS ('dbEdit0,cDbTextEdit').
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_SubclassObjectsViaParam
            String[] asCode
            Integer iCount
            Move '    Object oSl is a dbEdit0'  to asCode[0]
            Move '        Entry_Item Foo.Bar'   to asCode[1]
            Move '    End_Object'               to asCode[2]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "dbEdit0,cDbTextEdit" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Object oSl is a cDbTextEdit' asCode[0]
        End_Procedure

        // Whole-token: an already-modern cDbTextEdit object is untouched, and an object NAME containing
        // 'Edit' (oEditBox) is never swapped - only the class after 'is a'.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_WholeTokenOnly
            String[] asCode
            Integer iCount
            Move 'Object oEditBox is a cDbTextEdit' to asCode[0]
            Move 'End_Object'                       to asCode[1]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oEditBox is a cDbTextEdit' asCode[0]
        End_Procedure

        // A nested child object inside the converted edit does not end the block early: a Wrap_State
        // AFTER the child still translates.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_NestedChildScope
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a dbEdit'    to asCode[0]
            Move '    Object oChild is a Form'  to asCode[1]
            Move '    End_Object'               to asCode[2]
            Move '    Set Wrap_State to True'   to asCode[3]
            Move 'End_Object'                   to asCode[4]
            Move 'Set Wrap_State to False'      to asCode[5]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertSAreEqual '    Set pbWrap to True' asCode[3]
            Send AssertSAreEqual 'Set Wrap_State to False' asCode[5]
        End_Procedure

        // The class swap must ALSO retire the obsolete 'Use Dftxtwin.pkg' (warning 4536) and bring in the
        // dbEdit target package: dbEdit lives in Dftxtwin.pkg, cDbTextEdit in its own cDbTextEdit.pkg (verified
        // against the DF26 Pkg). Same _EnsureUsePackage the Edit converter uses. (Nils 2026-07-07.)
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_SwapsUsePackage
            String[] asCode
            Integer iCount
            Move 'Use Dftxtwin.pkg'             to asCode[0]
            Move 'Object oNotes is a dbEdit'    to asCode[1]
            Move 'End_Object'                   to asCode[2]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cDbTextEdit.pkg'            asCode[0]
            Send AssertSAreEqual 'Object oNotes is a cDbTextEdit' asCode[1]
        End_Procedure

        // ...but the Use may only be RETIRED when nothing of that package is left in the file. The
        // LegacyApp break (Nils 2026-07-26, 388 errors): VDFTranslator.pkg had its Edit objects
        // converted AND an 'Import_Class_Protocol ExtensionClass dbEdit ...' line, which no converter
        // rewrites. Dropping Dftxtwin.pkg took dbEdit with it -> 4328 Undefined class DBEDIT in the
        // file that defines the whole cLang* family, and the compile fell over behind it.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_KeepsUseWhenClassStillNamed
            String[] asCode
            Integer iCount i
            Boolean bLegacyKept bTargetAdded

            Move 'Use Dftxtwin.pkg'                                        to asCode[0]
            Move 'Object oNotes is a dbEdit'                               to asCode[1]
            Move 'End_Object'                                              to asCode[2]
            Move 'Import_Class_Protocol ExtensionClass dbEdit KeyAction'   to asCode[3]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Move False to bLegacyKept
            Move False to bTargetAdded
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Lowercase(Trim(asCode[i])) = "use dftxtwin.pkg")   Move True to bLegacyKept
                If (Lowercase(Trim(asCode[i])) = "use cdbtextedit.pkg") Move True to bTargetAdded
            Loop
            // The object still converts; both packages are Used, because the file needs both.
            Send AssertIAreEqual 1 iCount
            Send Assert (bLegacyKept and bTargetAdded)
            Send AssertSAreEqual 'Import_Class_Protocol ExtensionClass dbEdit KeyAction' asCode[SizeOfArray(asCode) - 1]
        End_Procedure

        /* AN EMPTY PARAMETER AND THE SUBCLASSES THE CHECK LEARNED (2026-09-07) - the db twin of the Edit test:
           the subclass's base line converts where it is declared, and a sibling already on cDbTextEdit is
           named in the run note as the place the objects could move to. */
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_LearnedSubclassBaseLineAndSiblingNote
            String[] asCode asNames asRoots asNone
            String sNotes
            Integer iCount
            Move "mydbedit" to asNames[0]
            Move "dbedit"   to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move 'Class MyDbTextEdit is a cDbTextEdit'                      to asCode[0]
            Move 'End_Class'                                                to asCode[1]
            Move 'Class MyDbEdit is a dbEdit startmac MY_START_MACRO'        to asCode[2]
            Move '    Procedure Construct_Object'                          to asCode[3]
            Move '        Forward Send Construct_Object'                   to asCode[4]
            Move '    End_Procedure'                                        to asCode[5]
            Move 'End_Class'                                                to asCode[6]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Get RunNotesText of ghoFuncLib "RefactorDbEditTocDbTextEdit" "" to sNotes
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
            Send AssertIAreEqual 1 iCount
            Send Assert ((SearchArray('Class MyDbEdit is a cDbTextEdit startmac MY_START_MACRO', asCode)) >= 0)
            Send Assert (sNotes contains "MyDbTextEdit")
            Send Assert (sNotes contains "retiring MyDbEdit")
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        /* A REAL PACKAGE WITH NO Use AT ALL (2026-11-05): it took dbEdit from whoever Used it first. A class needs its base
           where it stands, so the Use goes in, below the header comment and above the class. Without it the file only
           compiles behind DFAllEnt.pkg, which brings cDbTextEdit along; on its own it stops on U_CDBTEXTEDIT. */
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_AClassWithNoUseGetsItsBase
            String[] asCode
            Integer iCount
            Move '// A db edit that translates its own label'  to asCode[0]
            Move ''                                            to asCode[1]
            Move 'Class cMyDbEdit is a dbEdit'                 to asCode[2]
            Move 'End_Class'                                   to asCode[3]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '// A db edit that translates its own label' asCode[0]
            Send AssertSAreEqual 'Use cDbTextEdit.pkg' asCode[2]
            Send AssertSAreEqual 'Class cMyDbEdit is a cDbTextEdit' asCode[3]
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            // And once is enough.
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // Its old Use is swapped, not added to. The subclass's own name holds "dbEdit" and does not count as the class.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_AClassWithTheOldUseSwapsIt
            String[] asCode
            Integer iCount
            Move 'Use Dftxtwin.pkg'           to asCode[0]
            Move 'Class dbEdit0 is a dbEdit'  to asCode[1]
            Move 'End_Class'                  to asCode[2]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cDbTextEdit.pkg' asCode[0]
            Send AssertSAreEqual 'Class dbEdit0 is a cDbTextEdit' asCode[1]
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
        End_Procedure

        // An OBJECT in a file with no Use stays a fragment: it lives inside whatever Used it.
        { Published = True }
        Procedure RefactorDbEditTocDbTextEdit_AnObjectWithNoUseStaysAFragment
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a dbEdit'  to asCode[0]
            Move 'End_Object'                 to asCode[1]
            Get RefactorDbEditTocDbTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Object oNotes is a cDbTextEdit' asCode[0]
            Send AssertIAreEqual 2 (SizeOfArray(asCode))
        End_Procedure

    End_Object
