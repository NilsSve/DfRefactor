// Web-site    : http://www.rdctools.com
// Created     : 2026-10-05
//
// Description : What ConvertPopupMenuSubclassToCodeJock WRITES, compiled into the test runner.
//
//               The two regions below, between their '// >>>' and '// <<<' lines, are the converter's
//               output for the two legacy classes in oConvertPopupMenuSubclassToCodeJock-Tests.pkg,
//               line for line - the tests compare them, so they cannot drift apart. That makes the
//               text the converter emits code that has been through the DataFlex 26 compiler, and
//               the tests then use the classes: Add_Item, Item_Count, and an item sending its message.
//
//               DO NOT edit a region by hand. Change the converter (cRefactorFuncLib.pkg,
//               _CJPopupClassToContextMenu), run the tests, and paste what the failing comparison
//               says the converter writes.
//
//               Below the regions: two test-only subclasses that answer ItemMessageTarget with a
//               handle the test sets, because a headless test run has no focus object to send to.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cCJCommandBarSystem.pkg

// The messages the second region's Add_Item lines name; the test fixture object defines them.
Register_Procedure FixPopupHitOne
Register_Procedure FixPopupHitTwo

// >>> A
// DFRefactor (ConvertPopupMenuSubclassToCodeJock): one item of a cFixPopupMenu. A CodeJock menu item is an
// object, so Add_Item of cFixPopupMenu makes one of these per item and gives it the message the item sends.
Class cFixPopupMenuItem is a cCJMenuItem
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Integer piItemMessage 0
    End_Procedure

    // Chosen: the message goes where the menu says - see ItemMessageTarget in cFixPopupMenu.
    Procedure OnExecute Variant vCommandBarControl
        Integer iMsg
        Handle  hoTarget
        Get piItemMessage to iMsg
        Get ItemMessageTarget of (Parent(Self)) to hoTarget
        If (iMsg <> 0 and iMsg <> Msg_None and hoTarget > Desktop) Begin
            Send iMsg of hoTarget
        End
    End_Procedure
End_Class

Class cFixPopupMenu is a cCJContextMenu
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Integer piAddedItems 0               // every Add_Item so far, a separator too: what Item_Count answers
        Property Boolean pbItemMade False             // an item object exists
        Property Boolean pbNextItemBeginsGroup False  // a separator came after the last item

    End_Procedure
    Procedure End_Construct_Object
        Forward Send End_Construct_Object
    End_Procedure

    // DFRefactor (ConvertPopupMenuSubclassToCodeJock): the FloatingPopupMenu messages that the code filling
    // this menu uses, kept so that code stays as it is. No message and no text was a separator.
    Procedure Add_Item Integer iMsg String sText
        Handle hoItem
        Set piAddedItems to (piAddedItems(Self) + 1)
        If ((iMsg = 0 or iMsg = Msg_None) and sText = "") Begin
            Set pbNextItemBeginsGroup to (pbItemMade(Self))
            Procedure_Return
        End
        Get Create (RefClass(cFixPopupMenuItem)) to hoItem
        Set psCaption of hoItem to sText
        Set piItemMessage of hoItem to iMsg
        Set pbControlBeginGroup of hoItem to (pbNextItemBeginsGroup(Self))
        Set pbNextItemBeginsGroup to False
        Set pbItemMade to True
    End_Procedure

    Function Item_Count Returns Integer
        Function_Return (piAddedItems(Self))
    End_Function

    // Where an item's message goes: to the object that has the focus, as a FloatingPopupMenu sent it.
    // Answer another object here to send it there instead.
    Function ItemMessageTarget Returns Handle
        Handle hoFocus
        Get Focus of Desktop to hoFocus
        Function_Return hoFocus
    End_Function
End_Class
// <<< A

// >>> B
// DFRefactor (ConvertPopupMenuSubclassToCodeJock): one item of a cFixFilledPopupMenu. A CodeJock menu item is an
// object, so Add_Item of cFixFilledPopupMenu makes one of these per item and gives it the message the item sends.
Class cFixFilledPopupMenuItem is a cCJMenuItem
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Integer piItemMessage 0
    End_Procedure

    // Chosen: the message goes where the menu says - see ItemMessageTarget in cFixFilledPopupMenu.
    Procedure OnExecute Variant vCommandBarControl
        Integer iMsg
        Handle  hoTarget
        Get piItemMessage to iMsg
        Get ItemMessageTarget of (Parent(Self)) to hoTarget
        If (iMsg <> 0 and iMsg <> Msg_None and hoTarget > Desktop) Begin
            Send iMsg of hoTarget
        End
    End_Procedure
End_Class

Class cFixFilledPopupMenu is a cCJContextMenu
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Integer piAddedItems 0               // every Add_Item so far, a separator too: what Item_Count answers
        Property Boolean pbItemMade False             // an item object exists
        Property Boolean pbNextItemBeginsGroup False  // a separator came after the last item
        Send Add_Item msg_FixPopupHitOne "One"
        Send Add_Item Msg_None ""
        Send Add_Item msg_FixPopupHitTwo "Two"
    End_Procedure

    // DFRefactor (ConvertPopupMenuSubclassToCodeJock): the FloatingPopupMenu messages that the code filling
    // this menu uses, kept so that code stays as it is. No message and no text was a separator.
    Procedure Add_Item Integer iMsg String sText
        Handle hoItem
        Set piAddedItems to (piAddedItems(Self) + 1)
        If ((iMsg = 0 or iMsg = Msg_None) and sText = "") Begin
            Set pbNextItemBeginsGroup to (pbItemMade(Self))
            Procedure_Return
        End
        Get Create (RefClass(cFixFilledPopupMenuItem)) to hoItem
        Set psCaption of hoItem to sText
        Set piItemMessage of hoItem to iMsg
        Set pbControlBeginGroup of hoItem to (pbNextItemBeginsGroup(Self))
        Set pbNextItemBeginsGroup to False
        Set pbItemMade to True
    End_Procedure

    Function Item_Count Returns Integer
        Function_Return (piAddedItems(Self))
    End_Function

    // Where an item's message goes: to the object that has the focus, as a FloatingPopupMenu sent it.
    // Answer another object here to send it there instead.
    Function ItemMessageTarget Returns Handle
        Handle hoFocus
        Get Focus of Desktop to hoFocus
        Function_Return hoFocus
    End_Function
End_Class
// <<< B

// ---- Test-only from here: the same two menus, sending to a handle the test sets ----------------
Class cFixPopupMenuProbe is a cFixPopupMenu
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Handle phoProbeTarget 0
    End_Procedure

    Function ItemMessageTarget Returns Handle
        Function_Return (phoProbeTarget(Self))
    End_Function
End_Class

Class cFixFilledPopupMenuProbe is a cFixFilledPopupMenu
    Procedure Construct_Object
        Forward Send Construct_Object
        Property Handle phoProbeTarget 0
    End_Procedure

    Function ItemMessageTarget Returns Handle
        Function_Return (phoProbeTarget(Self))
    End_Function
End_Class
