//****************************************************************************
// $Module type: Test fixture
// $Module name: oRemoveResidentImageOption-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-03
//
// Description : Unit tests for the RemoveResidentImageOption refactor function - the obsolete
//               'Resident' option on the name line of a legacy report image, which a DataFlex 26
//               report can crash on: '/Body Resident' becomes '/Body'.
//
//               Each line goes through the tokenizer first, as in the engine's line pass. The
//               tokenizer marks an image name line as no code to change, which is why the function
//               reads the raw line - a test that skipped the tokenizer would not show that it does.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRemoveResidentImageOption is a cTestFixture
        Set psFunctionName to "RemoveResidentImageOption"

        // Helper: tokenize + run the function on one line, as the engine's line pass does. The lexer
        // state carries from call to call, so a run of calls reads like the lines of one file.
        Function RunLine String ByRef sLine Returns Boolean
            Boolean bChanged
            Send InitializeTokenizer of ghoFuncLib sLine
            Get RemoveResidentImageOption of ghoFuncLib (&sLine) "" to bChanged
            Function_Return bChanged
        End_Function

        // Helper: one line on its own, from a clean lexer state.
        Function RunAlone String ByRef sLine Returns Boolean
            Boolean bChanged
            Send ClearFuncLibProperties of ghoFuncLib
            Get RunLine (&sLine) to bChanged
            Function_Return bChanged
        End_Function

        // The DataFlex 26 help's own BasicReport sample opens its image like this.
        { Published = True }
        Procedure RemoveResident_DocumentedShape
            String sLine
            Boolean bChanged
            Move "/CustHdr Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/CustHdr" sLine
        End_Procedure

        // The word in any letter case.
        { Published = True }
        Procedure RemoveResident_AnyCase
            String sLine
            Boolean bChanged
            Move "/Body RESIDENT" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Body" sLine

            Move "/Body resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Body" sLine
        End_Procedure

        // An image inside a report object is indented: the indentation stays.
        { Published = True }
        Procedure RemoveResident_IndentationKept
            String sLine
            Boolean bChanged
            Move "    /PageTop Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    /PageTop" sLine
        End_Procedure

        // Blanks: a tab before the word, and blanks after it, go with the word.
        { Published = True }
        Procedure RemoveResident_BlanksAroundTheWordGo
            String sLine
            Boolean bChanged
            Move ("/Body" + Character(9) + "Resident") to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Body" sLine

            Move "/Body   Resident   " to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Body" sLine
        End_Procedure

        // "Nor given last" (the DataFlex help): a word after the option stays, and so does a word
        // before it.
        { Published = True }
        Procedure RemoveResident_OtherWordsStay
            String sLine
            Boolean bChanged
            Move "/Screen Resident Help" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Screen Help" sLine

            Move "/Screen Help Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Screen Help" sLine
        End_Procedure

        // A comment after the option stays as written.
        { Published = True }
        Procedure RemoveResident_TrailingCommentKept
            String sLine
            Boolean bChanged
            Move "/Header Resident   // the page header" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Header   // the page header" sLine
        End_Procedure

        // A repeated word goes every time.
        { Published = True }
        Procedure RemoveResident_RepeatedWordGoes
            String sLine
            Boolean bChanged
            Move "/Body Resident Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "/Body" sLine
        End_Procedure

        // A run of images, line by line as in a file: each name line loses the word, the image text
        // between them - the word Resident included - is not touched, and nothing changes after the '/*'.
        { Published = True }
        Procedure RemoveResident_RunOfImagesAsInAFile
            String[] asIn asOut
            String sLine
            Integer i
            Boolean bChanged

            Move "/CustHdr Resident"                          to asIn[0]
            Move "Customer Name Listing           Page:___."  to asIn[1]
            Move "/CustBody Resident"                         to asIn[2]
            Move "Resident since: __/__/__"                   to asIn[3]
            Move "/Footer Resident"                           to asIn[4]
            Move "/*"                                         to asIn[5]
            Move "Move 1 to iResident"                        to asIn[6]
            Send ClearFuncLibProperties of ghoFuncLib
            For i from 0 to (SizeOfArray(asIn) - 1)
                Move asIn[i] to sLine
                Get RunLine (&sLine) to bChanged
                Move sLine to asOut[i]
            Loop
            Send AssertSAreEqual "/CustHdr"                                  asOut[0]
            Send AssertSAreEqual "Customer Name Listing           Page:___." asOut[1]
            Send AssertSAreEqual "/CustBody"                                 asOut[2]
            Send AssertSAreEqual "Resident since: __/__/__"                  asOut[3]
            Send AssertSAreEqual "/Footer"                                   asOut[4]
            Send AssertSAreEqual "/*"                                        asOut[5]
            Send AssertSAreEqual "Move 1 to iResident"                       asOut[6]
        End_Procedure

        // Look-alikes the function must leave alone: an image CALLED Resident, a name that starts
        // with it, a longer word, the word in a comment after the name, a word fused to the name,
        // a commented-out name line, an image's end, and the word in ordinary code.
        { Published = True }
        Procedure RemoveResident_LookAlikesAreLeftAlone
            String sLine
            Boolean bChanged

            Move "/Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/Resident" sLine

            Move "/ResidentList Totals" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/ResidentList Totals" sLine

            Move "/Body Residential" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/Body Residential" sLine

            Move "/Body // resident image" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/Body // resident image" sLine

            Move "/Body.Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/Body.Resident" sLine

            Move "// /Body Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "// /Body Resident" sLine

            Move "/* Resident" to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/* Resident" sLine

            Move 'Move "/Body Resident" to sLine' to sLine
            Get RunAlone (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Move "/Body Resident" to sLine' sLine
        End_Procedure

        // A #HEADER region is never refactored - not even its image name lines.
        { Published = True }
        Procedure RemoveResident_HeaderRegionLeftAlone
            String sLine
            Boolean bChanged
            Send ClearFuncLibProperties of ghoFuncLib
            Set pbInHeader of ghoFuncLib to True
            Move "/Body Resident" to sLine
            Get RunLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "/Body Resident" sLine
            Set pbInHeader of ghoFuncLib to False
        End_Procedure

        // The analyzer's Auto-fix check dry-runs the function on the scanned line alone: the Deep
        // Scan row (DS 9233) must stay Auto-fix for the documented shape.
        { Published = True }
        Procedure RemoveResident_AnalyzerDryRunSeesTheChange
            Boolean bApplies
            Get AutoFixChangesLine of ghoFuncLib "RemoveResidentImageOption" "/CustBody Resident" to bApplies
            Send Assert bApplies
        End_Procedure

    End_Object
