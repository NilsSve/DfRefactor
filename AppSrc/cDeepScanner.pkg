//****************************************************************************
// $Module type: Class Package
// $Module name: cDeepScanner
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Deep Scan: the source-driven obsolete-symbol scanner (see the eDS* enum and the
//               tDeepScanRule/tDeepScanHit structs in RefactorConstants.h.pkg). The Modernization
//               Analyzer triages what the COMPILER says; Deep Scan covers the rest of the retired
//               language surface - the constructs that compile silently (If Not, Chain, Cmdline,
//               the Reg_* family, char-mode leftovers) or that a user wants found WITHOUT compiling.
//
//               The catalog is seeded from the docs' "Obsolete Commands, Functions & Other Symbols"
//               list (187 symbols, harvested 2026-07-10 including each page's replacement guidance).
//               Detection is context-aware on purpose: a naive text search drowns in false positives
//               because most of these names are only obsolete in ONE syntactic position -
//                 - Left/Mid/Pos/Trim/Replace/Insert/Pad/Length/Uppercase/Ascii/Character are obsolete
//                   as COMMANDS; the same names as FUNCTIONS are modern and must never be flagged;
//                 - EQ/GE/GT/LE/LT/NE/IN/MATCH are obsolete only inside command-syntax comparisons
//                   (an If/Else/While/Until line); 'Find EQ' is still supported and is not flagged;
//                 - Not is only legacy in the two-word 'If Not <operand>' form.
//               Lines are matched on their CODE only: string literals and comments are stripped first
//               via the funclib's _CodeOnlyLine, and word matches are boundary-aware (_FindKeywordPos).
//
//               Rules with common-word tokens (Required, Status, Group, Fill...) ship DISABLED - they
//               live in the catalog for completeness and can be switched on when a per-rule UI exists.
//
//               Scan results are tDeepScanHit rows (file handling is the caller's job - see the
//               published DeepScanObsoleteSymbols in oRefactorFuncLib.pkg, which mirrors the
//               GosubGotoReport per-file report loop). The hit carries the same eMod* triage category
//               the Analyzer uses, so a later phase can feed the SAME analyze grid / fix-plan flow.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorConstants.h.pkg
Use RefactorFileIO.pkg   // rfOpenInput/rfOpenOutput + Read_Block (the rules JSON I/O)
Use cEncodingHelpers.pkg // rfReadEncodedFileAsStringArray (ScanFileCached reads its own file)
Use cJsonObject.pkg

// The function library's answer to "can this grid subclass be converted in place?" (CodeJockRefactorFunctions.inc).
// Declared here because the scanner cannot Use the converters - they Use the analyzer, which Uses this.
// The pointer rules' dry run (eDSPointerStringMove) - in the function library, Unicode64RefactorFunctions.inc.
Register_Function _PointerMoveLines String[] asCode String sFn Returns Integer[]
// The (Self) object-reference rule's dry run (eDSSelfObjectRef) - in the function library, CleanupRefactorFunctions.inc.
Register_Function _SelfObjectRefLines String[] asCode Returns Integer[]
Register_Function GridSubclassWhyNot String sClass String sClassFile String[] ByRef asNames String[] ByRef asSupers String[] ByRef asDeclFiles Returns String

Class cDeepScanner is a cObject

    Procedure Construct_Object
        Forward Send Construct_Object
        // Per-scan memo for _DropDeadMenuFileHits: the folder whose menu-file Use map was last
        // built, and that map ("lowerleaf|srcpath" per code-level Use / #Include of a .mn / .mnu
        // in the folder's programs). One scanner lives for one Check (cFTDeepScanDriver), so a
        // program whose Use line a run just commented is seen afresh next Check.
        Property String   psMenuMapFolder ""
        Property String[] pasMenuMap
        // The scan's files (cFTDeepScanDriver._PrimeScanner): the map then covers their folders and the workspace's,
        // built once ("*"), not the menu file's folder alone (2026-11-01, _CJMenuUseMapForFiles). Empty = the old way.
        Property String[] pasMenuMapFiles
        /* THE WORKSPACE'S OWN LEGACY SUBCLASSES (Nils 2026-09-04, LegacyApp): "Class MyDbGrid is a
           dbGrid" and 455 "Object oX is a MyDbGrid" in 243 files no program compiled - invisible
           to the compiler lane, and to this scanner, whose object-declaration rules matched the
           class token literally. Pairs are accumulated from the class-bearing files of a scan
           (LearnSubclassPairsFromLines), then resolved to the rule tokens they descend from
           (ResolveLearnedSubclasses): name -> root, e.g. mydbgrid -> dbgrid, mydbgrid2 -> dbgrid.
           _RuleMatchesLine then treats "is a MyDbGrid" as "is a dbGrid". The set rides the cache
           fingerprint (SubclassFingerprint), so a new subclass rescans every cached file. */
        Property String[] pasPairNames
        Property String[] pasPairBases
        Property String[] pasSubclassNames
        Property String[] pasSubclassRoots
        // Parallel to the pair lists: the class name as written, and the file it was learned from ("" when the
        // caller handed lines only) - psLearningFile is that file while LearnWorkspaceSubclasses walks.
        Property String[] pasPairShown
        Property String[] pasPairFiles
        Property String   psLearningFile ""
        /* CAN EACH LEARNED GRID SUBCLASS BE CONVERTED IN PLACE? (2026-10-04) ConvertGridSubclassToCodeJock
           ports "Class X is a dbGrid" to the CodeJock grid and converts every object of X with it - but only
           a class whose body it can carry. The scan asks it once per subclass and Check
           (JudgeGridSubclasses), and an object of X is offered that conversion only on a yes; on a no its
           row stays an explanation, with the converter's own reason. Lowercase names; "" = it converts.
           The verdicts ride the cache fingerprint (PortVerdictFingerprint): an edit to a class changes what
           every UNCHANGED file's object of it yields. */
        Property String[] pasPortNames
        Property String[] pasPortWhy
    End_Procedure

    /* "Class <name> is a[n] <base>" lines, by the code part of each line, lowercased, appended to the
       pair lists. Any file may carry one; the driver feeds the class-bearing extensions. */
    Procedure LearnSubclassPairsFromLines String[] ByRef asLines
        String[] asNames asBases asShown asPairFiles
        String sCode sLow sW1 sW2 sW3 sW4 sW5 sShown sFile
        Integer i iLast

        Get pasPairNames to asNames
        Get pasPairBases to asBases
        Get pasPairShown to asShown
        Get pasPairFiles to asPairFiles
        Get psLearningFile to sFile
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Pos("class", Lowercase(asLines[i])) > 0) Begin
                Get _CodeOnlyLine of ghoFuncLib asLines[i] to sCode
                Move (Lowercase(Trim(sCode))) to sLow
                Get _NthWord of ghoFuncLib sLow 1 to sW1
                If (sW1 = "class") Begin
                    Get _NthWord of ghoFuncLib sLow 2 to sW2
                    Get _NthWord of ghoFuncLib sLow 3 to sW3
                    Get _NthWord of ghoFuncLib sLow 4 to sW4
                    Get _NthWord of ghoFuncLib sLow 5 to sW5
                    If (sW2 <> "" and sW3 = "is" and (sW4 = "a" or sW4 = "an") and sW5 <> "") Begin
                        Move sW2 to asNames[SizeOfArray(asNames)]
                        Move sW5 to asBases[SizeOfArray(asBases)]
                        Get _NthWord of ghoFuncLib (Trim(sCode)) 2 to sShown
                        Move sShown to asShown[SizeOfArray(asShown)]
                        Move sFile  to asPairFiles[SizeOfArray(asPairFiles)]
                    End
                End
            End
        Loop
        Set pasPairNames to asNames
        Set pasPairBases to asBases
        Set pasPairShown to asShown
        Set pasPairFiles to asPairFiles
    End_Procedure

    /* Resolve the accumulated pairs against the object-declaration rules' tokens: a class whose
       base IS a rule token descends from it; a class whose base is an already-resolved subclass
       descends from that one's root (four passes cover four levels). Fills asOutNames / asOutRoots
       (lowercased, parallel) and returns the count. PURE - unit-tested apart from the scanner. */
    Function ResolveSubclassRoots String[] asNames String[] asBases String[] asRootTokens String[] ByRef asOutNames String[] ByRef asOutRoots Returns Integer
        String[] asEmpty
        String sRoot
        Integer i iLast iPass iAt

        Move asEmpty to asOutNames
        Move asEmpty to asOutRoots
        Move (SizeOfArray(asNames) - 1) to iLast
        For iPass from 1 to 4
            For i from 0 to iLast
                If (SearchArray(asNames[i], asOutNames) = -1) Begin
                    Move "" to sRoot
                    If (SearchArray(asBases[i], asRootTokens) <> -1) ;
                        Move asBases[i] to sRoot
                    Else Begin
                        Move (SearchArray(asBases[i], asOutNames)) to iAt
                        If (iAt <> -1) ;
                            Move asOutRoots[iAt] to sRoot
                    End
                    If (sRoot <> "") Begin
                        Move asNames[i] to asOutNames[SizeOfArray(asOutNames)]
                        Move sRoot      to asOutRoots[SizeOfArray(asOutRoots)]
                    End
                End
            Loop
        Loop
        Function_Return (SizeOfArray(asOutNames))
    End_Function

    /* The object-declaration rules whose objects a subclass can stand in for: the legacy UI
       families. NOT the Workspace program shell (DS "Workspace program shell"): a "Class X is a
       Workspace" is a design decision the shell converter refuses, so "Object oApp is a X" must
       not be listed as a shell to convert - oDeepScanner-Tests pins that shape. */
    Function _SubclassLearningToken String sToken Returns Boolean
        Function_Return (sToken = "dbgrid" or sToken = "grid" or sToken = "dblist" or sToken = "list" or sToken = "dbedit" or sToken = "edit" or sToken = "dftimer" or sToken = "winreport")
    End_Function

    // The pairs learned so far, resolved against the loaded rules' object-declaration tokens.
    Procedure ResolveLearnedSubclasses tDeepScanRule[] ByRef aRules
        String[] asTokens asNames asBases asOutNames asOutRoots
        Integer i iLast iVoid
        Boolean bTakes

        Move (SizeOfArray(aRules) - 1) to iLast
        For i from 0 to iLast
            If (aRules[i].eDSKind = eDSClassDecl and SearchArray(aRules[i].sToken, asTokens) = -1) Begin
                Get _SubclassLearningToken aRules[i].sToken to bTakes
                If (bTakes) ;
                    Move aRules[i].sToken to asTokens[SizeOfArray(asTokens)]
            End
        Loop
        Get pasPairNames to asNames
        Get pasPairBases to asBases
        Get ResolveSubclassRoots asNames asBases asTokens (&asOutNames) (&asOutRoots) to iVoid
        Set pasSubclassNames to asOutNames
        Set pasSubclassRoots to asOutRoots
    End_Procedure

    /* Learn from the files a scan is about to walk: the class-bearing extensions only (packages,
       class files, includes, programs) - a class can be declared anywhere, but that is where they
       live (LegacyApp 2026-09-04: all 110 declarations in .pkg), and reading every .vw/.dg/.sl on
       every Check for the rare exception would add seconds to each one. */
    Procedure LearnWorkspaceSubclasses String[] ByRef asFiles tDeepScanRule[] ByRef aRules
        String[] asLines asEmpty
        String sExt
        Integer i iLast

        Set pasPairNames to asEmpty
        Set pasPairBases to asEmpty
        Set pasPairShown to asEmpty
        Set pasPairFiles to asEmpty
        // A scan may have no run behind it: the files it covers are where code that reads an error number is looked for.
        Set pasErrorReaderScope of ghoFuncLib to asFiles
        Set pbErrorReadersBuilt of ghoFuncLib to False
        Move (SizeOfArray(asFiles) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Right(Trim(asFiles[i]), 4))) to sExt
            If (sExt = ".pkg" or sExt = ".inc" or sExt = ".nui" or sExt = ".utl" or sExt = ".src" or Lowercase(Right(Trim(asFiles[i]), 3)) = ".cl") Begin
                Move (rfReadEncodedFileAsStringArray(asFiles[i])) to asLines
                Set psLearningFile to (Trim(asFiles[i]))
                Send LearnSubclassPairsFromLines (&asLines)
            End
        Loop
        Set psLearningFile to ""
        Send ResolveLearnedSubclasses (&aRules)
        Send JudgeGridSubclasses
    End_Procedure

    /* THE VERDICT ON EVERY LEARNED GRID SUBCLASS (see pasPortNames): asked of the converter itself, through the
       function library (GridSubclassWhyNot -> cGridSubclassPorter.SubclassVerdict), so the Check and the run
       cannot disagree about what converts. A class built on another class of the workspace is not asked: the
       converter takes direct subclasses only. A pair learned from lines alone (no file - the unit tests) gets
       no verdict, and its rows keep the wording that sends the user to the converter to find out. */
    Procedure JudgeGridSubclasses
        String[] asNames asRoots asPairNames asPairBases asPairShown asPairFiles asPortNames asPortWhy
        String   sRoot sWhy sBase
        Integer  i iLast iAt iBase

        Get pasSubclassNames to asNames
        Get pasSubclassRoots to asRoots
        Get pasPairNames     to asPairNames
        Get pasPairBases     to asPairBases
        Get pasPairShown     to asPairShown
        Get pasPairFiles     to asPairFiles
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move asRoots[i] to sRoot
            If (sRoot = "dbgrid" or sRoot = "dblist" or sRoot = "grid") Begin
                Move (SearchArray(asNames[i], asPairNames)) to iAt
                If (iAt <> -1) Begin
                    If (asPairFiles[iAt] <> "") Begin
                        If (asPairBases[iAt] <> sRoot) Begin
                            Move asPairBases[iAt] to sBase
                            Move (SearchArray(sBase, asPairNames)) to iBase
                            If (iBase <> -1) ;
                                Move asPairShown[iBase] to sBase
                            Move ("it is built on " + sBase + ", another workspace class, and only a class built directly on dbGrid, dbList or Grid is converted") to sWhy
                        End
                        Else ;
                            Get GridSubclassWhyNot of ghoFuncLib asPairShown[iAt] asPairFiles[iAt] (&asPairShown) (&asPairBases) (&asPairFiles) to sWhy
                        Move asNames[i] to asPortNames[SizeOfArray(asPortNames)]
                        Move sWhy       to asPortWhy[SizeOfArray(asPortWhy)]
                    End
                End
            End
        Loop
        Set pasPortNames to asPortNames
        Set pasPortWhy   to asPortWhy
    End_Procedure

    // The verdict on one learned grid subclass (lowercase name): "" = ConvertGridSubclassToCodeJock converts it
    // in place, else why not. bKnown comes back False for a class with no verdict.
    Function GridSubclassWhy String sClassLc Boolean ByRef bKnown Returns String
        String[] asPortNames asPortWhy
        Integer  iAt

        Move False to bKnown
        Get pasPortNames to asPortNames
        Move (SearchArray(sClassLc, asPortNames)) to iAt
        If (iAt = -1) ;
            Function_Return ""
        Get pasPortWhy to asPortWhy
        Move True to bKnown
        Function_Return asPortWhy[iAt]
    End_Function

    // True when the class has a verdict and it is yes.
    Function _ConvertsInPlace String sClassLc Returns Boolean
        String  sWhy
        Boolean bKnown
        Get GridSubclassWhy sClassLc (&bKnown) to sWhy
        Function_Return (bKnown = True and sWhy = "")
    End_Function

    /* The verdicts as one string, for the cache fingerprint: "name=+;" for a class that converts, "name=-<why>;"
       for one that does not. The reason is in it because a cached hit carries it in its hint. "|" and ";" are
       taken out of the reason - they are this string's own separators. */
    Function PortVerdictFingerprint Returns String
        String[] asPortNames asPortWhy
        String   sOut sWhy
        Integer  i iLast

        Get pasPortNames to asPortNames
        Get pasPortWhy   to asPortWhy
        Move "" to sOut
        Move (SizeOfArray(asPortNames) - 1) to iLast
        For i from 0 to iLast
            Move (Replaces(";", (Replaces("|", asPortWhy[i], "/")), ",")) to sWhy
            Move (sOut + asPortNames[i] + "=" + If((sWhy = ""), "+", ("-" + sWhy)) + ";") to sOut
        Loop
        Function_Return sOut
    End_Function

    /* PURE, the reverse of PortVerdictFingerprint: the verdicts read back out of a cache fingerprint,
       "<rules version>~<verdicts>|<pairs>|<rules JSON>" - the text after "~" in the part before the FIRST
       "|". How the analyzer learns them after a restart, when no scan has run and the saved cache is all
       there is. A fingerprint from before the verdicts has no "~" there and yields nothing. */
    Procedure PortVerdictsInFingerprint String sFingerprint String[] ByRef asPortNames String[] ByRef asPortWhy
        String[] asParts asNone
        String   sHead sPart
        Integer  iBar iTilde i iLast iEq

        Move asNone to asPortNames
        Move asNone to asPortWhy
        Move (Pos("|", sFingerprint)) to iBar
        If (iBar = 0) ;
            Procedure_Return
        Move (Left(sFingerprint, (iBar - 1))) to sHead
        Move (Pos("~", sHead)) to iTilde
        If (iTilde = 0) ;
            Procedure_Return
        Move (Right(sHead, (Length(sHead) - iTilde))) to sHead
        Move (StrSplitToArray(sHead, ";")) to asParts
        Move (SizeOfArray(asParts) - 1) to iLast
        For i from 0 to iLast
            Move asParts[i] to sPart
            Move (Pos("=", sPart)) to iEq
            If (iEq > 1 and iEq < Length(sPart)) Begin
                Move (Left(sPart, (iEq - 1))) to asPortNames[SizeOfArray(asPortNames)]
                // After "=": "+" = converts (no reason), "-<why>" = does not.
                If (Mid(sPart, 1, (iEq + 1)) = "+") ;
                    Move "" to asPortWhy[SizeOfArray(asPortWhy)]
                Else ;
                    Move (Right(sPart, (Length(sPart) - iEq - 1))) to asPortWhy[SizeOfArray(asPortWhy)]
            End
        Loop
    End_Procedure

    // True when the lowercased class name was learned as a descendant of the rule token.
    Function IsLearnedSubclass String sClassLc String sRootToken Returns Boolean
        String[] asNames asRoots
        Integer iAt

        Get pasSubclassNames to asNames
        Move (SearchArray(sClassLc, asNames)) to iAt
        If (iAt = -1) ;
            Function_Return False
        Get pasSubclassRoots to asRoots
        Function_Return (asRoots[iAt] = sRootToken)
    End_Function

    // True when at least one learned subclass descends from the token - the pre-gate's question.
    Function HasLearnedSubclasses String sRootToken Returns Boolean
        String[] asRoots
        Get pasSubclassRoots to asRoots
        Function_Return (SearchArray(sRootToken, asRoots) <> -1)
    End_Function

    // The learned set as one string, for the cache fingerprint: a different set = a different scan.
    Function SubclassFingerprint Returns String
        String[] asNames asRoots
        String sOut
        Integer i iLast

        Get pasSubclassNames to asNames
        Get pasSubclassRoots to asRoots
        Move "" to sOut
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move (sOut + asNames[i] + "=" + asRoots[i] + ";") to sOut
        Loop
        Function_Return sOut
    End_Function

    /* PURE, the reverse of SubclassFingerprint: the learned pairs read back out of a cache fingerprint,
       "<rules version>|name=root;name=root;...|<rules JSON>" - only the text between the FIRST two "|"
       (the JSON after them may hold "|" of its own, a class name never does). How the converters learn
       the subclasses after a restart, when no scan has run and the saved cache is all there is. */
    Procedure SubclassPairsInFingerprint String sFingerprint String[] ByRef asNames String[] ByRef asRoots
        String[] asPairs asNone
        String   sPairs sPair
        Integer  iFirst iSecond i iLast iEq

        Move asNone to asNames
        Move asNone to asRoots
        Move (Pos("|", sFingerprint)) to iFirst
        If (iFirst = 0) ;
            Procedure_Return
        Move (Right(sFingerprint, (Length(sFingerprint) - iFirst))) to sPairs
        Move (Pos("|", sPairs)) to iSecond
        If (iSecond > 0) ;
            Move (Left(sPairs, (iSecond - 1))) to sPairs
        Move (StrSplitToArray(sPairs, ";")) to asPairs
        Move (SizeOfArray(asPairs) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asPairs[i])) to sPair
            Move (Pos("=", sPair)) to iEq
            If (iEq > 1 and iEq < Length(sPair)) Begin
                Move (Left(sPair, (iEq - 1)))              to asNames[SizeOfArray(asNames)]
                Move (Right(sPair, (Length(sPair) - iEq))) to asRoots[SizeOfArray(asRoots)]
            End
        Loop
    End_Procedure

    /* The note a hit carries when it matched through a learned subclass: which class, of what -
       and what that means for the converter. The four grid converters, run with an EMPTY parameter,
       convert the plain legacy class only and leave an object of a subclass as it is (Nils 2026-10-03 -
       see cGridToCJGridBase.SubclassToLeave: a plain CodeJock class would lose what the subclass adds).
       So such a row carries NO function - a plan run would leave the object as it is - and the note says
       where the work is: ConvertGridSubclassToCodeJock, with the subclass's name as its parameter, ports
       the class in place and converts its objects with it (2026-10-04). A List subclass is still ported by
       hand first, then its objects converted by naming both classes in the List converter's parameter.
       The Edit / dbEdit / WinReport converters swap ONE named class (default 'Edit,cTextEdit') and
       modernise a "Class <sub> is a Edit" line too, so there the subclass's own file is the place
       to run them and its objects follow. ChangeDfTimerTocTimer takes the literal dfTimer only. */
    Function _SubclassMatchNote tDeepScanRule Rule String sCode Boolean ByRef bKeepFn Returns String
        String sClass sLow sTargets sNote sTargetGrid sTargetCol sWhy
        Integer iComma
        Boolean bIs bKnown

        Move True to bKeepFn

        Get _NthWord of ghoFuncLib (Trim(sCode)) 5 to sClass
        Move (Lowercase(sClass)) to sLow
        If (sClass = "" or sLow = Rule.sToken) ;
            Function_Return ""
        Get IsLearnedSubclass sLow Rule.sToken to bIs
        If (bIs = False) ;
            Function_Return ""
        Move (" Matched through the workspace subclass " + sClass + " of " + Rule.sToken + ".") to sNote
        If (Trim(Rule.sRefactorFn) = "") ;
            Function_Return sNote
        Move "" to sTargets
        If (Rule.sToken = "dbgrid") ;
            Move "cDbCJGrid,cDbCJGridColumn" to sTargets
        If (Rule.sToken = "dblist") ;
            Move "cDbCJGridPromptList,cDbCJGridColumn" to sTargets
        If (Rule.sToken = "grid" or Rule.sToken = "list") ;
            Move "cCJGrid,cCJGridColumn" to sTargets
        If (sTargets <> "") Begin
            Move False to bKeepFn
            Move (Pos(",", sTargets)) to iComma
            Move (Left(sTargets, (iComma - 1))) to sTargetGrid
            Move (Right(sTargets, (Length(sTargets) - iComma))) to sTargetCol
            Move (sNote + " " + Trim(Rule.sRefactorFn) + " leaves these objects as they are when its parameter is EMPTY: a plain " + sTargetGrid + " would lose what " + sClass + " adds.") to sNote
            If (Rule.sToken = "list") ;
                Move (sNote + " Port " + sClass + " to a class based on " + sTargetGrid + " first, then convert its objects with the parameter '" + sClass + ",<the new class>," + sTargetCol + "'.") to sNote
            Else Begin
                /* An object of a subclass the subclass converter TAKES never arrives here - it is listed under
                   that converter's own rule (eDSSubclassObject). What arrives is a class it cannot take, and the
                   note gives its reason; or a class with no verdict, sent to the converter to find out. */
                Get GridSubclassWhy sLow (&bKnown) to sWhy
                If (bKnown = True and sWhy <> "") ;
                    Move (sNote + " ConvertGridSubclassToCodeJock cannot convert " + sClass + " in place: " + sWhy + ". Port " + sClass + " by hand to a class based on " + sTargetGrid + ", then convert its objects with the parameter '" + sClass + ",<the new class>," + sTargetCol + "'.") to sNote
                Else ;
                    Move (sNote + " Run ConvertGridSubclassToCodeJock with the parameter '" + sClass + "': it ports " + sClass + " to " + sTargetGrid + " in place and converts these objects with it, or says in its run notes why it cannot.") to sNote
            End
        End
        Else Begin
            /* Not a converter that would act on THIS file's object: the row keeps the family's DS
               number and hint, but carries no function - a plan run here would refactor nothing
               and the row would be a promise the tool cannot keep (the defect the eDSClassDecl /
               eDSClassSubclass split was made for). The note says where the work is instead. */
            Move False to bKeepFn
            If (Rule.sToken = "dftimer") ;
                Move (sNote + " " + Trim(Rule.sRefactorFn) + " takes only the literal dfTimer: port " + sClass + " to cTimer by hand, and these objects follow.") to sNote
            Else ;
                Move (sNote + " Run " + Trim(Rule.sRefactorFn) + " with its default parameter on the file that declares " + sClass + ": it modernises that class's base line, and these objects follow without a change of their own.") to sNote
        End
        Function_Return sNote
    End_Function

    // The three grid families ConvertGridSubclassToCodeJock ports (a List subclass is still ported by hand).
    Function _IsGridPortToken String sToken Returns Boolean
        Function_Return (sToken = "dbgrid" or sToken = "dblist" or sToken = "grid")
    End_Function

    /* THE CLASS LINE of a grid family's subclass rule (dbGrid / Grid / dbList subclass, 2026-10-04). The rule
       offers ConvertGridSubclassToCodeJock, and the offer stands where the Check's verdict says the class
       converts (JudgeGridSubclasses): "" comes back with bKeepFn True, and the rule's own hint is the row's.
       Where it does not, bKeepFn is False and the return value is the row's WHOLE hint - why not, and the
       way by hand; a class with no verdict is sent to the converter to find out. */
    Function _GridClassRowHint tDeepScanRule Rule String sCode Boolean ByRef bKeepFn Returns String
        String  sName sFamily sTargetGrid sTargetCol sWhy sLead
        Boolean bKnown

        Move True to bKeepFn
        Get _NthWord of ghoFuncLib (Trim(sCode)) 2 to sName
        Get GridSubclassWhy (Lowercase(sName)) (&bKnown) to sWhy
        If (bKnown = True and sWhy = "") ;
            Function_Return ""
        Move False to bKeepFn
        Move "cCJGrid"       to sTargetGrid
        Move "cCJGridColumn" to sTargetCol
        If (Rule.sToken = "dbgrid") Begin
            Move "cDbCJGrid"       to sTargetGrid
            Move "cDbCJGridColumn" to sTargetCol
        End
        If (Rule.sToken = "dblist") Begin
            Move "cDbCJGridPromptList" to sTargetGrid
            Move "cDbCJGridColumn"     to sTargetCol
        End
        Get _NthWord of ghoFuncLib (Trim(Rule.sSymbol)) 1 to sFamily
        Move ("Objects of this subclass are listed as " + sFamily + " objects and stay as they are: a plain " + sTargetGrid + " would lose what this class adds.") to sLead
        If (bKnown = True) ;
            Function_Return (sLead + " ConvertGridSubclassToCodeJock cannot convert it in place: " + sWhy + ". Port it by hand to a class based on " + sTargetGrid + ", then convert its objects with the parameter '" + sName + ",<the new class>," + sTargetCol + "'.")
        Function_Return (sLead + " Run ConvertGridSubclassToCodeJock with the parameter '" + sName + "': it converts the class to " + sTargetGrid + " in place together with every object of it, or says in its run notes why it cannot.")
    End_Function

    // Append one rule; mirrors cModAnalyzer.AddRecipe so the seed below reads as a table.
    // iDSNumber (the stable pseudo message number: recipe key + ignore-list key) is assigned
    // from the SEED POSITION (9001, 9002, ...) - the seed is therefore APPEND-ONLY: never
    // insert or reorder rules, or every later rule's number (and standing ignores) shifts.
    Function AddDSRule tDeepScanRule[] aRules String sSymbol String sToken Integer eDSKind Integer eCategory String sRefactorFn String sHint Boolean bEnabled Returns tDeepScanRule[]
        tDeepScanRule Rule
        Move sSymbol     to Rule.sSymbol
        Move sToken      to Rule.sToken
        Move eDSKind     to Rule.eDSKind
        Move eCategory   to Rule.eCategory
        Move sRefactorFn to Rule.sRefactorFn
        Move sHint       to Rule.sHint
        Move bEnabled    to Rule.bEnabled
        Move (CI_DeepScanFirstDSNumber + SizeOfArray(aRules)) to Rule.iDSNumber
        Move Rule to aRules[SizeOfArray(aRules)]
        Function_Return aRules
    End_Function

    // The built-in catalog. Tokens are LOWERCASE (matching lowercases the line words once).
    //
    // ==== MAINTAINER CONTRACT - how and when to change this seed ====
    // WHEN:
    //   - A new converter lands for a legacy construct: route the existing rule to it (edit its
    //     sRefactorFn/eCategory IN PLACE - same DS number = same identity, always safe) or append
    //     a new rule if nothing covers the construct yet.
    //   - A coverage gap shows up (the 4535 Use-extension miss, the obsolete-class family).
    //   - A rule misbehaves: fix its fields in place, or ship it dormant (bEnabled False).
    //     NEVER DELETE a rule - numbers after it would shift (see AddDSRule); to retire one,
    //     set bEnabled False (its recipe stays inert, standing ignores stay valid).
    //   - A live-verified promotion (Suggest -> AutoFix): edit eCategory in place.
    //   - A new DataFlex release extends the docs' obsolete-symbols list: harvest + append.
    // HOW (today's v2/v3/v4 changes are worked examples, tail of this function):
    //   1. APPEND new rules at the TAIL, below a dated "v<n>:" comment. In-place field edits are
    //      fine; position changes never are.
    //   2. Bump CI_DeepScanRulesVersion (RefactorConstants.h.pkg) - WITHOUT the bump,
    //      LoadDeepScanRules keeps serving the existing DeepScanRules.json verbatim and the
    //      change NEVER REACHES anyone who has scanned before. The bump reseeds the JSON and
    //      merges the user's Enabled toggles across by DS number.
    //   3. Bump CI_ModAnalyzerRecipeVersion (cModAnalyzer.pkg) - the rules double as recipes; a
    //      new/re-routed rule is DORMANT in the grid and plan until the recipe table reseeds.
    //   4. A new detection SHAPE needs a new eDSKind (RefactorConstants.h.pkg) + a branch in
    //      _RuleMatchesLine + a cheap pre-gate in ScanLines.
    //   5. Tests in oDeepScanner-Tests.pkg: the legacy form HITS, the modern look-alike does NOT.
    //   6. Compile the runner + run the suite; compile both apps.
    // =============================================================================================
    Function BuildDefaultDeepScanRules Returns tDeepScanRule[]
        tDeepScanRule[] aR

        // ---- Command->function family: obsolete as commands, modern as functions.
        //      Routed to the existing converters (the compiler DOES warn on these - Deep
        //      Scan finds them without a compile).
        Get AddDSRule aR "Ascii command"      "ascii"      eDSCommandPos eModAutoFix "ChangeAsciiCommandToFunction"     "Use the Ascii() function."                        True to aR
        Get AddDSRule aR "Character command"  "character"  eDSCommandPos eModAutoFix "ChangeCharacterCommandToFunction" "Use the Character() function."                    True to aR
        Get AddDSRule aR "Insert command"     "insert"     eDSCommandPos eModAutoFix "ChangeInsertCommandToFunction"    "Use the Insert() function."                       True to aR
        Get AddDSRule aR "Left command"       "left"       eDSCommandPos eModAutoFix "ChangeLeftCommandToFunction"      "Use the Left() function."                         True to aR
        Get AddDSRule aR "Length command"     "length"     eDSCommandPos eModAutoFix "ChangeLengthCommandToFunction"    "Use the Length() function."                       True to aR
        Get AddDSRule aR "Mid command"        "mid"        eDSCommandPos eModAutoFix "ChangeMidCommandToFunction"       "Use the Mid() function."                          True to aR
        Get AddDSRule aR "Pad command"        "pad"        eDSCommandPos eModAutoFix "ChangePadCommandToFunction"       "Use the Pad() function."                          True to aR
        Get AddDSRule aR "Pos command"        "pos"        eDSCommandPos eModAutoFix "ChangePosCommandToFunction"       "Use the Pos() function."                          True to aR
        Get AddDSRule aR "Replace command"    "replace"    eDSCommandPos eModAutoFix "ChangeReplaceCommandToFunction"   "Use the Replace() function."                      True to aR
        Get AddDSRule aR "Right command"      "right"      eDSCommandPos eModAutoFix "ChangeRightCommandToFunction"     "Use the Right() function."                        True to aR
        Get AddDSRule aR "Trim command"       "trim"       eDSCommandPos eModAutoFix "ChangeTrimCommandToFunction"      "Use the Trim() function."                         True to aR
        Get AddDSRule aR "Uppercase command"  "uppercase"  eDSCommandPos eModAutoFix "ChangeUppercaseCommandToFunction" "Use the Uppercase() function."                    True to aR
        Get AddDSRule aR "Zerostring command" "zerostring" eDSCommandPos eModAutoFix "ChangeZeroStringCommandToFunction" "Use the ZeroString() function."                  True to aR
        Get AddDSRule aR "GetAddress command" "getaddress" eDSCommandPos eModAutoFix "ChangeGetAddress"                 "Use the AddressOf() function."                    True to aR

        // ---- Calc / typed-Move family -> Move.
        Get AddDSRule aR "Calc command"       "calc"       eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Calc/Calculate -> Move."                                 True to aR
        Get AddDSRule aR "Calculate command"  "calculate"  eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Calc/Calculate -> Move."                                 True to aR
        Get AddDSRule aR "Movedate command"   "movedate"   eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Movedate -> Move (automatic type checking)."             True to aR
        Get AddDSRule aR "Moveint command"    "moveint"    eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Moveint -> Move (automatic type checking)."              True to aR
        Get AddDSRule aR "Movenum command"    "movenum"    eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Movenum -> Move (automatic type checking)."              True to aR
        Get AddDSRule aR "Movereal command"   "movereal"   eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Movereal -> Move (automatic type checking)."             True to aR
        Get AddDSRule aR "Movestr command"    "movestr"    eDSCommandPos eModAutoFix "ChangeCalcToMoveStatement" "Movestr -> Move (automatic type checking)."              True to aR

        // ---- Misc commands with a direct existing route.
        Get AddDSRule aR "Local keyword"      "local"      eDSCommandPos eModAutoFix "RemoveLocalKeyWord"      "Method variables are local - the keyword is unneeded."     True to aR
        Get AddDSRule aR "System command"     "system"     eDSCommandPos eModAutoFix "ChangeSystemToAbort"     "System -> Abort."                                          True to aR
        Get AddDSRule aR "Sysdate4 command"   "sysdate4"   eDSCommandPos eModAutoFix "ChangeSysdate"           "Sysdate4 -> CurrentDateTime()."                            True to aR
        Get AddDSRule aR "Define_Auto_Increment" "define_auto_increment" eDSCommandPos eModAutoFix "ChangeDefineAutoIncrement" "Use DataDictionary Field_Auto_Increment."  True to aR
        Get AddDSRule aR "Begin_Constraints"  "begin_constraints" eDSCommandPos eModAutoFix "ChangeBeginEndConstraint" "Use the DataDictionary OnConstrain event."         True to aR
        Get AddDSRule aR "End_Constraints"    "end_constraints"   eDSCommandPos eModAutoFix "ChangeBeginEndConstraint" "Use the DataDictionary OnConstrain event."         True to aR
        Get AddDSRule aR "Set_Argument_Size"  "set_argument_size" eDSCommandPos eModSuggest "CommentOutArgumentSizeCommands" "String buffers are dynamic - remove."        True to aR
        Get AddDSRule aR "Get_Argument_Size"  "get_argument_size" eDSCommandPos eModSuggest "CommentOutArgumentSizeCommands" "String buffers are dynamic - remove."        True to aR
        Get AddDSRule aR "Set_Date_Attribute" "set_date_attribute" eDSCommandPos eModSuggest "CommentOutSetDateAttribute" "Use Set_Attribute DF_DATE_FORMAT."              True to aR

        // ---- Indicators (89-per-program, global scope) -> Boolean / properties.
        Get AddDSRule aR "Indicator command"  "indicator"  eDSCommandPos eModSuggest "ChangeLegacyIndicators" "Indicators -> Boolean (run the indicator conversion family)." True to aR
        Get AddDSRule aR "Indicate command"   "indicate"   eDSCommandPos eModAutoFix "ChangeLegacyIndicators" "Indicators -> Boolean (run the indicator conversion family)." True to aR
        Get AddDSRule aR "Ind command"        "ind"        eDSCommandPos eModSuggest "ChangeLegacyIndicators" "Indicators -> Boolean (run the indicator conversion family)." True to aR
        /* RETIRED 2026-07-29 (bEnabled False - never delete a rule, the iDSNumber is an identity).
           425 hits on WinServ, every one carrying the identical advice and none separately
           actionable: eModExplain with NO refactor function, so the rule could only ever say "you
           deal with it" 425 times. Nils: "I agree about Finderr, just ignore them." Its neighbours
           (Indicator / Indicate / Ind) all route to ChangeLegacyIndicators as Suggest; FindErr alone
           had nothing attached. If a converter ever handles it, re-enable and point sRefactorFn at
           it - the rule and its number are kept for exactly that. */
        Get AddDSRule aR "FindErr indicator"  "finderr"    eDSAnywhere   eModExplain ""                       "Use the Found predefined variable / Boolean state."           False to aR

        // ---- Legacy comparison modes: only on command-syntax condition lines
        //      ('Find EQ' etc. is still supported and never matches here).
        Get AddDSRule aR "EQ comparison"     "eq"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use = inside a Boolean expression."                              True to aR
        Get AddDSRule aR "NE comparison"     "ne"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use <> inside a Boolean expression."                             True to aR
        Get AddDSRule aR "GT comparison"     "gt"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use > inside a Boolean expression."                              True to aR
        Get AddDSRule aR "LT comparison"     "lt"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use < inside a Boolean expression."                              True to aR
        Get AddDSRule aR "GE comparison"     "ge"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use >= inside a Boolean expression."                             True to aR
        Get AddDSRule aR "LE comparison"     "le"    eDSConditionLine eModAutoFix "ChangeLegacyOperators" "Use <= inside a Boolean expression."                             True to aR
        Get AddDSRule aR "IN comparison"     "in"    eDSConditionLine eModAutoFix "ChangeInToContains"    "Use the Contains operator."                                      True to aR
        Get AddDSRule aR "MATCH comparison"  "match" eDSConditionLine eModExplain ""                      "Use Contains or Pos(); ?/* wildcard patterns need a manual rewrite." True to aR
        Get AddDSRule aR "If Not (two-word form)" "not" eDSIfNot      eModAutoFix "ChangeIfNotCommandToExpression" "If Not x -> If (Not(x))."                               True to aR

        // ---- Gosub era. 'Return' matches command position only (modern code uses
        //      Procedure_Return / Function_Return, which are different first words).
        Get AddDSRule aR "Gosub command"      "gosub"        eDSCommandPos eModSuggest "GosubGotoReport" "Gosub subroutines -> Procedures/Functions (run the report)."      True to aR
        Get AddDSRule aR "Gosub Return"       "return"       eDSCommandPos eModAutoFix "ChangeReturnToGosubReturn" "Gosub-era Return -> Gosub_Return."                      True to aR
        Get AddDSRule aR "On..Gosub/Goto"     "gosub"        eDSOnDispatch eModSuggest "GosubGotoReport" "On <n> Gosub/Goto -> Case."                                       True to aR
        Get AddDSRule aR "Call command"       "call"         eDSCommandPos eModAutoFix "ChangeCallToSend"                "Call -> Send (procedure call)."                                   True to aR
        Get AddDSRule aR "Chain command"      "chain"        eDSCommandPos eModAutoFix "ChangeChainToRunprogram" "Chain -> Runprogram Wait."                                    True to aR

        // ---- Type/buffer system -> Struct (the report lists the byte-level accessors).
        Get AddDSRule aR "Type command"       "type"           eDSCommandPos eModSuggest "TypeToStructReport" "Type/End_Type -> Struct (run the report first)."             True to aR
        Get AddDSRule aR "End_Type"           "end_type"       eDSCommandPos eModSuggest "TypeToStructReport" "Type/End_Type -> Struct."                                    True to aR
        Get AddDSRule aR "Field (Type member)" "field"         eDSCommandPos eModSuggest "TypeToStructReport" "Type member - becomes a Struct member."                      True to aR
        Get AddDSRule aR "Getbuff command"    "getbuff"        eDSCommandPos eModSuggest "TypeToStructReport" "Type-buffer read - Structs make it direct member access."    True to aR
        Get AddDSRule aR "Getbuff_String"     "getbuff_string" eDSCommandPos eModSuggest "TypeToStructReport" "Type-buffer read - Structs make it direct member access."    True to aR
        Get AddDSRule aR "Put command"        "put"            eDSCommandPos eModSuggest "TypeToStructReport" "Type-buffer write - Structs make it direct member access."   True to aR
        Get AddDSRule aR "Put_String"         "put_string"     eDSCommandPos eModSuggest "TypeToStructReport" "Type-buffer write - Structs make it direct member access."   True to aR
        Get AddDSRule aR "ZeroType command"   "zerotype"       eDSCommandPos eModSuggest "TypeToStructReport" "Not needed with Structs."                                    True to aR
        Get AddDSRule aR "Address declaration" "address"       eDSCommandPos eModSuggest "Win64AddressToPointer" "Address type -> Pointer."                                 True to aR
        Get AddDSRule aR "External_Function16" "external_function16" eDSCommandPos eModExplain ""             "Use External_Function; a 16-bit DLL cannot load - replace the DLL itself." True to aR

        // ---- Shell / program-level constructs.
        //      v56 (2026-09-08): the rule carries its converter (Review). ChangeReplaceDirectiveToDefine
        //      rewrites the ones a Define can express and keeps the value in its own column; it marks the
        //      two shapes that only LOOK convertible, both measured on DF26 - inside an Enum_List, where a
        //      Define with a value resets the running counter a #REPLACE leaves alone, and an unquoted
        //      value with spaces, which the directive swallows to the end of the line. A parenthesised
        //      value stays unflagged: Define resolves it eagerly, the directive does not.
        Get AddDSRule aR "#REPLACE directive" "#replace"     eDSReplaceConst eModAutoFix "ChangeReplaceDirectiveToDefine" "Use 'Define name for value'. The converter takes literal values and leaves a TODO with the reason on the rest." True to aR
        Get AddDSRule aR "Cmdline command"    "cmdline"      eDSCommandPos eModAutoFix "ChangeCmdlineCommandToFunction" "Sequential reads -> cCommandLine via a generated shim."  True to aR
        Get AddDSRule aR "Sysdate command"    "sysdate"      eDSCommandPos eModAutoFix "ChangeSysdate"     "Sysdate -> CurrentDateTime()."                                    True to aR
        Get AddDSRule aR "Error_Report"       "error_report" eDSCommandPos eModExplain ""                "Use the ErrorSystem for error handling."                          True to aR
        Get AddDSRule aR "On Error"           "on error"     eDSCommandPos eModExplain ""                "On Error -> the ErrorSystem (Error_Object_Id)."                   True to aR
        Get AddDSRule aR "LastErr variable"   "lasterr"      eDSAnywhere   eModExplain ""                "Use the ErrorSystem instead of LastErr checks."                   False to aR

        // ---- Windows Registry / profile strings -> cRegistry; INI files -> cIniFile. Routed to the
        //      LegacyRegistryReport worksheet (Review, report only): cRegistry is an OBJECT (key path
        //      in properties), NOT the legacy handle/callback model, so these collapse rather than
        //      1:1-swap and the Reg_Enum_* enumerations need a loop rewrite. Get_Program_Key stays
        //      Explain (no modern equivalent).
        Get AddDSRule aR "Reg_Open_Key"          "reg_open_key"          eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Reg_Close_Key"         "reg_close_key"         eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Reg_Create_Key"        "reg_create_key"        eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Reg_Enum_Key"          "reg_enum_key"          eDSCommandPos eModSuggest "LegacyRegistryReport" "cRegistry class (enumeration callbacks need a loop rewrite)." True to aR
        Get AddDSRule aR "Reg_Enum_Key_Info"     "reg_enum_key_info"     eDSCommandPos eModSuggest "LegacyRegistryReport" "cRegistry class (enumeration callbacks need a loop rewrite)." True to aR
        Get AddDSRule aR "Reg_Enum_Value"        "reg_enum_value"        eDSCommandPos eModSuggest "LegacyRegistryReport" "cRegistry class (enumeration callbacks need a loop rewrite)." True to aR
        Get AddDSRule aR "Reg_Get_Access_Rights" "reg_get_access_rights" eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Reg_Set_Access_Rights" "reg_set_access_rights" eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Get_Profile_String"    "get_profile_string"    eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Set_Profile_String"    "set_profile_string"    eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Get_Foreign_Profile_String" "get_foreign_profile_string" eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class." True to aR
        Get AddDSRule aR "Set_Foreign_Profile_String" "set_foreign_profile_string" eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class." True to aR
        Get AddDSRule aR "Set_App_Profile_String"     "set_app_profile_string"     eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class." True to aR
        Get AddDSRule aR "Get_Registry_Root"     "get_registry_root"     eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Set_Registry_Root"     "set_registry_root"     eDSCommandPos eModSuggest "LegacyRegistryReport" "Windows Registry via the cRegistry class."         True to aR
        Get AddDSRule aR "Get_Program_Key"       "get_program_key"       eDSCommandPos eModExplain "" "No modern equivalent."                                              True to aR
        Get AddDSRule aR "Read_dfini"            "read_dfini"            eDSCommandPos eModSuggest "LegacyRegistryReport" "INI files via the cIniFile class."                 True to aR

        // ---- Database-API attribute COMMANDS -> Get_Attribute/Set_Attribute. Most are routed to
        //      the LegacyDbApiReport worksheet (Review, report only) because they do NOT token-swap:
        //      File_Size has a read AND a set-max form (reversed args), Get_Date_Attribute reads
        //      Y2K/epoch no-op state, and Get_Number_Format reads a format CODE where the modern
        //      attributes read a separator CHARACTER.
        //      THE EXCEPTIONS carry their own converter and are Auto-fix - Get_date_format,
        //      Get_Current_Lockcount, Get_FileList and Set_FileList - each because its replacement
        //      was MEASURED on the runtime or IS the macro's own expansion, not because the docs
        //      paired the two names. That is the bar a symbol here has to clear (v70).
        //      IFCHANGE has a converter too and stays REVIEW (v71): the values were measured equal,
        //      but its rewrite is three lines and a local declaration - the only one in this family
        //      that writes a declaration into the user's method - and it has never run on a real site,
        //      the command appearing in no workspace to hand.
        Get AddDSRule aR "Ifchange command"      "ifchange"          eDSCommandPos eModSuggest "ChangeIfchangeCommandToAttribute" "Read DF_FILE_CHANGED into a Boolean, then test it before the command." True to aR
        Get AddDSRule aR "File_Size"             "file_size"         eDSCommandPos eModSuggest "LegacyDbApiReport" "Use DF_FILE_RECORDS_USED / DF_FILE_MAX_RECORDS."             True to aR
        // v70: NOT a database field - Dll.pkg declares it as a legacy Type member's byte size and
        //      says "Use Structs", so the row belongs to the Type/Struct worksheet.
        Get AddDSRule aR "Size_of_Field"         "size_of_field"     eDSCommandPos eModSuggest "TypeToStructReport" "A legacy Type member's byte size, not a DB field - use a Struct and SizeOfType." True to aR
        // v70: its own converter, Auto-fix - measured value-exact, and FMAC gives this command no
        //      WarningEx, so the scan is the ONLY lane that can ever offer it (see the converter).
        Get AddDSRule aR "Get_Current_Lockcount" "get_current_lockcount" eDSCommandPos eModAutoFix "ChangeGetCurrentLockcountToAttribute" "Get_Attribute DF_TRAN_COUNT to <var> - the same count (measured)." True to aR
        // v69: its own converter, Auto-fix - the swap is value-exact (measured, see the converter).
        Get AddDSRule aR "Get_date_format"       "get_date_format"   eDSCommandPos eModAutoFix "ChangeGetDateFormatToAttribute" "Get_Date_Format to <var> -> Get_Attribute DF_DATE_FORMAT to <var>; same DF_DATE_USA / EUROPEAN / MILITARY values." True to aR
        Get AddDSRule aR "Get_Date_Attribute"    "get_date_attribute" eDSCommandPos eModSuggest "LegacyDbApiReport" "Reads Y2K/epoch no-op state - review (see the report)."     True to aR
        Get AddDSRule aR "Get_number_format"     "get_number_format" eDSCommandPos eModSuggest "LegacyDbApiReport" "Reads a format CODE; DF_DECIMAL_SEPARATOR reads the CHARACTER - not a swap." True to aR
        // v70: their own converter, Auto-fix - FMAC expands both macros to the GET_/SET_ATTRIBUTE
        //      DF_FILELIST_NAME form, so the conversion is what the compiler already does. The
        //      legacy commands take no "to" keyword; the converter inserts it.
        Get AddDSRule aR "Get_filelist"          "get_filelist"      eDSCommandPos eModAutoFix "ChangeFileListCommandToAttribute" "Get_Attribute DF_FILELIST_NAME to <var> - a global attribute, no of <file>." True to aR
        Get AddDSRule aR "Set_filelist"          "set_filelist"      eDSCommandPos eModAutoFix "ChangeFileListCommandToAttribute" "Set_Attribute DF_FILELIST_NAME to <val> - a global attribute, no of <file>." True to aR
        Get AddDSRule aR "Set_dfpath"            "set_dfpath"        eDSCommandPos eModSuggest "LegacyDfPathReport" "cWorkspace pathing: usually redundant (.ws config) - delete / append psSystemDfPath / replace psDfPath (see report)." True to aR
        Get AddDSRule aR "Fieldindex variable"   "fieldindex"        eDSAnywhere   eModSuggest "LegacyDbApiReport" "Loop fields via DF_FILE_NUMBER_FIELDS + Field_Value."                   True to aR
        Get AddDSRule aR "Filenumber variable"   "filenumber"        eDSAnywhere   eModSuggest "LegacyDbApiReport" "Use the DF_FILE_NUMBER attribute."                                      True to aR
        // v70: stays Review, and the hint now says WHY. The old attribute is a Boolean, the new one
        //      a four-value enum, so the name swap that looks obvious is a value bug: False is
        //      RIM_NONE, but True means a trigger fills the column - RIM_EXTERNAL, not the 1 the
        //      swap would leave. It is also in no DF26 driver definition at all.
        Get AddDSRule aR "DF_FILE_PRIMARY_INDEX_TRIGGER" "df_file_primary_index_trigger" eDSAnywhere eModSuggest "LegacyDbApiReport" "Boolean -> the RIM_* enum: False = RIM_NONE, True = RIM_EXTERNAL. Decide per table." True to aR
        Get AddDSRule aR "DF_FILE_TRANSLATE_OEM_TO_ANSI" "df_file_translate_oem_to_ansi" eDSAnywhere eModSuggest "LegacyDbApiReport" "Use DF_FILE_TABLE_CHARACTER_FORMAT."                   True to aR
        // v75: the converter grew into the Y2K triplet and was renamed (see DS 9231-9232 at the tail).
        Get AddDSRule aR "DF_SYSDATE_4_STATE"    "df_sysdate_4_state" eDSAnywhere  eModAutoFix "CommentOutLegacyDateAttributes" "No-op now (dates always 4-digit) and VdfBase.pkg sets it anyway - comment it out."   True to aR

        // ---- Embedded SQL command set -> the cSQL* classes. Routed to the LegacySqlReport worksheet
        //      (Review, report only): the docs give a per-command class.method map (in the hints), but
        //      it is a STATEFUL object port (implicit handle -> explicit cSQLHandleManager /
        //      cSQLConnection / cSQLStatement object), not a token swap. Two renames the docs call out:
        //      SQLGetArguments -> SQLGetArgument, SQLBindFetchFile/SQLFileFetch -> SQLBindFile.
        Get AddDSRule aR "SQLConnect"    "sqlconnect"    eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLHandleManager.SQLConnect."                    True to aR
        Get AddDSRule aR "SQLSetConnect" "sqlsetconnect" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLHandleManager.SQLSetConnect."                 True to aR
        Get AddDSRule aR "SQLFileConnect" "sqlfileconnect" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLHandleManager.SQLFileConnect."             True to aR
        Get AddDSRule aR "SQLDisconnect" "sqldisconnect" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLConnection.SQLDisconnect."                    True to aR
        Get AddDSRule aR "SQLOpen"       "sqlopen"       eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLConnection.SQLOpen."                          True to aR
        Get AddDSRule aR "SQLClose"      "sqlclose"      eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLClose."                          True to aR
        Get AddDSRule aR "SQLPrepare"    "sqlprepare"    eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLPrepare."                        True to aR
        Get AddDSRule aR "SQLExecute"    "sqlexecute"    eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLExecute."                        True to aR
        Get AddDSRule aR "SQLExecDirect" "sqlexecdirect" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLExecDirect."                     True to aR
        Get AddDSRule aR "SQLFetch"      "sqlfetch"      eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLFetch."                          True to aR
        Get AddDSRule aR "SQLGetData"    "sqlgetdata"    eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLGetData."                        True to aR
        Get AddDSRule aR "SQLColumnMap"  "sqlcolumnmap"  eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLColumnMap."                      True to aR
        Get AddDSRule aR "SQLNextResultSet" "sqlnextresultset" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLNextResultSet."          True to aR
        Get AddDSRule aR "SQLStmtAttribute" "sqlstmtattribute" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLStmtAttribute."          True to aR
        Get AddDSRule aR "SQLCall"       "sqlcall"       eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLCall."                           True to aR
        Get AddDSRule aR "SQLGetArguments" "sqlgetarguments" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLGetArgument (singular)."   True to aR
        Get AddDSRule aR "SQLBindFetchFile" "sqlbindfetchfile" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLBindFile."               True to aR
        Get AddDSRule aR "SQLFileFetch"  "sqlfilefetch"  eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLBindFile."                       True to aR
        Get AddDSRule aR "SQLFetchActivatesBuffer" "sqlfetchactivatesbuffer" eDSCommandPos eModSuggest "LegacySqlReport" "Use cSQLStatement.SQLFetchActivatesBuffer." True to aR
        Get AddDSRule aR "CLI_Get_Database_Attribute" "cli_get_database_attribute" eDSCommandPos eModSuggest "LegacySqlReport" "Use Get_Attribute / Set_Attribute (SQL drivers v5+)." True to aR
        Get AddDSRule aR "CLI_Set_Database_Attribute" "cli_set_database_attribute" eDSCommandPos eModSuggest "LegacySqlReport" "Use Get_Attribute / Set_Attribute (SQL drivers v5+)." True to aR
        Get AddDSRule aR "CLI_Get_Driver_Attribute" "cli_get_driver_attribute" eDSCommandPos eModSuggest "LegacySqlReport" "Use Get_Attribute / Set_Attribute (SQL drivers v5+)." True to aR
        Get AddDSRule aR "CLI_Set_Driver_Attribute" "cli_set_driver_attribute" eDSCommandPos eModSuggest "LegacySqlReport" "Use Get_Attribute / Set_Attribute (SQL drivers v5+)." True to aR
        Get AddDSRule aR "DB2_SetConstraint"   "db2_setconstraint"   eDSCommandPos eModSuggest "LegacySqlReport" "Use DF_FILE_SQL_FILTER or Embedded SQL."   True to aR
        Get AddDSRule aR "MSSQL_SetConstraint" "mssql_setconstraint" eDSCommandPos eModSuggest "LegacySqlReport" "Use DF_FILE_SQL_FILTER or Embedded SQL."   True to aR

        // ---- Character-mode UI / menus / reporting era.
        Get AddDSRule aR "DFCreate_Menu"  "dfcreate_menu" eDSCommandPos eModSuggest "ChangeDFCreateMenuToCodeJock" "Converted to a CodeJock command-bar menu; standard DEO items become their shipped cCJ* classes."                                                 True to aR
        Get AddDSRule aR "End_Menu"       "end_menu"      eDSCommandPos eModSuggest "ChangeDFCreateMenuToCodeJock" "Closes a DFCreate_Menu block - the same converter carries the whole block across."                                                 True to aR
        Get AddDSRule aR "UI_Accept"      "ui_accept"     eDSCommandPos eModExplain "" "Popup (modal) / Activate_View."                                                    True to aR
        Get AddDSRule aR "Item_list"      "item_list"     eDSCommandPos eModExplain "" "Character-mode UI - re-implement with modern classes."                             True to aR
        Get AddDSRule aR "End_item_list"  "end_item_list" eDSCommandPos eModExplain "" "Character-mode UI - re-implement with modern classes."                             True to aR
        Get AddDSRule aR "Item_group"     "item_group"    eDSCommandPos eModExplain "" "Character-mode UI - re-implement with modern classes."                             True to aR
        Get AddDSRule aR "End_item_group" "end_item_group" eDSCommandPos eModExplain "" "Character-mode UI - re-implement with modern classes."                            True to aR
        Get AddDSRule aR "Dependent_item" "dependent_item" eDSCommandPos eModExplain "" "Use multiple DEOs bound to the same DataDictionary."                              True to aR
        Get AddDSRule aR "Repeat_item"    "repeat_item"   eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                         True to aR
        Get AddDSRule aR "Name_item"      "name_item"     eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                         True to aR
        Get AddDSRule aR "Name_items"     "name_items"    eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                         True to aR
        Get AddDSRule aR "Name_object"    "name_object"   eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                         True to aR
        Get AddDSRule aR "On_name_item"   "on_name_item"  eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                         True to aR
        Get AddDSRule aR "Entry_name_item" "entry_name_item" eDSCommandPos eModExplain "" "Character-mode UI - no modern equivalent."                                      True to aR
        Get AddDSRule aR "Autopage"       "autopage"      eDSCommandPos eModExplain "" "DEO classes handle this."                                                          True to aR
        Get AddDSRule aR "Despool"        "despool"       eDSCommandPos eModExplain "" "Close Output despools automatically."                                              True to aR
        Get AddDSRule aR "Formfeed"       "formfeed"      eDSCommandPos eModExplain "" "Page breaks via the reporting tool."                                               True to aR
        Get AddDSRule aR "Directory command" "directory"  eDSCommandPos eModExplain "" "Use the dir: driver with Direct_Input."                                            True to aR
        Get AddDSRule aR "Get_Drive_Directory" "get_drive_directory" eDSCommandPos eModExplain "" "Use Get_Directory."                                                     True to aR
        Get AddDSRule aR "Inactivate"     "inactivate"    eDSCommandPos eModExplain "" "Character-mode only - review the intent (clears recnum, keeps values)."            True to aR
        Get AddDSRule aR "Register_Resource" "register_resource" eDSCommandPos eModExplain "" "Use embedded (compiled-in) resources."                                      True to aR
        Get AddDSRule aR "Set_Resource_Library" "set_resource_library" eDSCommandPos eModExplain "" "Use embedded (compiled-in) resources."                                True to aR
        Get AddDSRule aR "Total_Resources" "total_resources" eDSAnywhere eModExplain "" "Use embedded (compiled-in) resources."                                            True to aR
        Get AddDSRule aR "SetCurrencyFormat" "setcurrencyformat" eDSCommandPos eModExplain "" "Use FormatCurrency / DataDictionary masks."                                 True to aR
        Get AddDSRule aR "SetNumberFormat" "setnumberformat" eDSCommandPos eModExplain "" "Use the FormatNumber function."                                                 True to aR
        Get AddDSRule aR "Format command" "format"        eDSCommandPos eModExplain "" "Character-mode only - use DataDictionary Field_Options/masks."                     True to aR
        Get AddDSRule aR "Name command"   "name"          eDSCommandPos eModExplain "" "Character-mode only - remove."                                                     True to aR
        Get AddDSRule aR "Forward_begin_construct" "forward_begin_construct" eDSCommandPos eModExplain "" "The Class framework replaces construct macros."                 True to aR
        Get AddDSRule aR "Forward_end_construct"   "forward_end_construct"   eDSCommandPos eModExplain "" "The Class framework replaces construct macros."                 True to aR

        // ---- Dev-only / character-mode relics: no-ops in a modern GUI app. Routed to
        //      CommentOutObsoleteDevCommands (comments them out, reversibly) - Suggest, because a
        //      "Get_..." relic that fed a variable leaves it unset once the line is commented.
        Get AddDSRule aR "Debug command"  "debug"  eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Remove - dev-only (use the Studio debugger)."                 True to aR
        Get AddDSRule aR "Memory command" "memory" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Remove - dev-only memory display."                            True to aR
        Get AddDSRule aR "Winput command" "winput" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Remove - dev-only (use the Studio debugger)."                 True to aR
        Get AddDSRule aR "Get_current_colors" "get_current_colors" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - use Color/TextColor properties." True to aR
        Get AddDSRule aR "Get_cursor_visible" "get_cursor_visible" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - see the CursorShape class." True to aR
        Get AddDSRule aR "Set_cursor_visible" "set_cursor_visible" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - see the CursorShape class." True to aR
        Get AddDSRule aR "Get_default_map_mode" "get_default_map_mode" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - remove."             True to aR
        Get AddDSRule aR "Set_default_map_mode" "set_default_map_mode" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - remove."             True to aR
        Get AddDSRule aR "Graphics_adjust_coords" "graphics_adjust_coords" eDSCommandPos eModSuggest "CommentOutObsoleteDevCommands" "Character-mode only - remove."         True to aR

        // ---- Predefined variables from the command-string era.
        //      v55 (2026-09-08): both carry their converter (Review). The FUNCTION forms never set them,
        //      so the command converters leave a following read silently stale - a workspace's date
        //      parser broke exactly that way. The converter rewrites the read as the value the command
        //      left; what it cannot derive gets a TODO marker with the reason, which silences the row.
        Get AddDSRule aR "Strmark variable"     "strmark"     eDSAnywhere eModAutoFix "ChangeStrMarkToExpression" "Set only by the legacy string COMMANDS (Pos, Replace, Left, Mid, Insert, Pad); the function forms never set it, so a read after a converted command is stale. The converter rewrites a read as the value the command left (after Pos / Replace: Pos(needle, haystack)), turns a scratch use into a local Integer, and marks what it cannot derive with the reason." True to aR
        Get AddDSRule aR "Strlen variable"      "strlen"      eDSAnywhere eModSuggest "ChangeStrLenToExpression"  "Set only by the legacy string COMMANDS (Pos, Replace, Right, Mid); the function forms never set it, so a read after a converted command is stale. The converter rewrites a read as the value the command left (after Pos / Replace: Length(haystack) - Pos(needle, haystack) + 1), turns a scratch use into a local Integer, and marks what it cannot derive with the reason." True to aR
        /* RETIRED 2026-07-29 (bEnabled False - never delete a rule, the iDSNumber is an identity).
           Nils, on "Move Self to Windowindex" flagged in Plan2.vw: "WindowIndex is a system
           integer ... I think we should just ignore it."

           He is right, and the evidence is in the runtime's own packages - CURRENT DF 26 code uses
           WindowIndex as an ordinary global scratch integer:
               Winuser.pkg:558    Move (InitCommonControls()) to WindowIndex
               seq_chnl.pkg:38    For WindowIndex from 0 to (DF_SEQ_CHANNEL_MAX-1)
               CrystalReport.pkg  Move (CopyMemory(...)) To WindowIndex
           The first of those is the exact shape reported. It is the throwaway sink for a return
           value nobody wants, not character-mode window addressing, so "no equivalent" was wrong
           advice about a line that needs no change at all.

           Second time today a symbol that LOOKS character-mode-era turned out to be in live use by
           DataFlex itself (Windows_Message was the other, W 4534). The check is the same and it is
           cheap: grep the target install's Pkg folder before calling a symbol obsolete. A bare
           eDSAnywhere token match cannot tell "legacy construct" from "name the runtime still
           uses". If a genuinely char-mode INDEXED use can be characterised later, re-enable with a
           narrower kind - the rule and its number are kept for exactly that. */
        Get AddDSRule aR "Windowindex variable" "windowindex" eDSAnywhere eModExplain "" "Character-mode indexed window addressing - no equivalent."                       False to aR
        Get AddDSRule aR "Multiuser indicator"  "multiuser"   eDSAnywhere eModExplain "" "Locking is always available - remove the check."                                 True to aR

        // ---- Field properties / entry options -> DataDictionary Field_Options.
        //      Rare-word ones scan by default; common English words ship DISABLED.
        Get AddDSRule aR "Autoback"     "autoback"     eDSAnywhere eModExplain "" "Character-mode only - no equivalent."                                                   True to aR
        Get AddDSRule aR "Autofind"     "autofind"     eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_AUTOFIND)."                                        True to aR
        Get AddDSRule aR "Autofind_ge"  "autofind_ge"  eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options."                                                      True to aR
        Get AddDSRule aR "Autoreturn"   "autoreturn"   eDSAnywhere eModExplain "" "Character-mode only - no equivalent."                                                   True to aR
        Get AddDSRule aR "Capslock"     "capslock"     eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_CAPSLOCK)."                                        True to aR
        Get AddDSRule aR "Displayonly"  "displayonly"  eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_DISPLAYONLY)."                                     True to aR
        Get AddDSRule aR "Findreq"      "findreq"      eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_FINDREQ)."                                         True to aR
        Get AddDSRule aR "Forceput"     "forceput"     eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options."                                                      True to aR
        Get AddDSRule aR "Noenter"      "noenter"      eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_NOENTER)."                                         True to aR
        Get AddDSRule aR "Noput"        "noput"        eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_NOPUT)."                                           True to aR
        Get AddDSRule aR "Skipfound"    "skipfound"    eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options (DD_SKIPFOUND)."                                       True to aR
        Get AddDSRule aR "Retainall"    "retainall"    eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options."                                                      True to aR
        Get AddDSRule aR "Zero_suppress" "zero_suppress" eDSAnywhere eModSuggest "LegacyFieldOptionsReport" "Use DataDictionary Field_Options."                                                    True to aR
        Get AddDSRule aR "No_calc"      "no_calc"      eDSAnywhere eModExplain "" "Character-mode window option - remove."                                                 True to aR
        Get AddDSRule aR "Float$ option" "float$"      eDSAnywhere eModExplain "" "Use DataDictionary Field_Mask / Currency_Mask."                                         True to aR
        Get AddDSRule aR "Signrt option" "signrt"      eDSAnywhere eModExplain "" "Character-mode print option - remove."                                                  True to aR
        // Common-word tokens: in the catalog for completeness, DISABLED by default.
        Get AddDSRule aR "Required"     "required"     eDSAnywhere eModExplain "" "Use DataDictionary Field_Options (DD_REQUIRED)."                                        False to aR
        Get AddDSRule aR "Retain"       "retain"       eDSAnywhere eModExplain "" "Character-mode field property - remove."                                                False to aR
        Get AddDSRule aR "Status component" "status"   eDSAnywhere eModExplain "" "Use DataDictionary HasRecord / Current_Record."                                         False to aR
        Get AddDSRule aR "Group component"  "group"    eDSAnywhere eModExplain "" "Use Boolean variables / properties."                                                    False to aR
        Get AddDSRule aR "Fill option"      "fill"     eDSAnywhere eModExplain "" "Character-mode print option - remove."                                                  False to aR
        Get AddDSRule aR "Points option"    "points"   eDSAnywhere eModExplain "" "Use DataDictionary Field_Mask / Currency_Mask."                                         False to aR
        Get AddDSRule aR "Suppress option"  "suppress" eDSAnywhere eModExplain "" "Character-mode print option - remove."                                                  False to aR
        Get AddDSRule aR "Thousands option" "thousands" eDSAnywhere eModExplain "" "Use DataDictionary Field_Options."                                                     False to aR

        // v2 (2026-07-11, APPEND-ONLY - new rules go BELOW this line): compiler warning 4535's
        // filename form, found source-side (Nils's paytype.DD Use lines slipped an exhausted
        // scan cycle - the compiler flags them but the catalog had no rule to).
        Get AddDSRule aR "Use without file extension" "use" eDSUseNoExt eModAutoFix "AddUseFileExtension" "Add the file extension to the Use filename (default .pkg) - compiler warning 4535."  True to aR

        // v3 (2026-07-11): the obsolete UI classes with converter routes - the compiler's 4537
        // family found source-side, so an EXHAUSTED scan also means "no obsolete classes" (Nils's
        // LegacyApp3 cycle: scan exhausted, then the first compile rained 'Obsolete class: DBLIST').
        // Functions + categories MIRROR the analyzer's 4537 recipes exactly (grid/plan parity):
        // an { EnumList } parameter on the converter -> Review, a deterministic transform -> Auto-fix.
        Get AddDSRule aR "DfTimer class"   "dftimer"   eDSClassDecl eModAutoFix "ChangeDfTimerTocTimer"               "Use the cTimer class."                        True to aR
        // v81 (2026-10-03): THE GRID CONVERSIONS ARE AUTO-FIX - dbGrid, Grid and List promoted from Review in
        // place, beside dbList, Auto-fix since v3 (Nils: "promote dbGrid to Auto-fix", then "The grids has always
        // had auto-fix status"). They were Review under the rule above - the converters take a parameter - but
        // these rows no longer hand the user a choice: since v80 an EMPTY run converts the PLAIN class only, an
        // object of the workspace's own subclass stays as it is, and that object's row is Explain
        // (_SubclassMatchNote). What the row runs is a fixed transform, as dbList's has been.
        Get AddDSRule aR "dbGrid class"    "dbgrid"    eDSClassDecl eModAutoFix "RefactorDbGridTocDbCJGrid"           "Use the cDbCJGrid class."                     True to aR
        Get AddDSRule aR "Grid class"      "grid"      eDSClassDecl eModAutoFix "RefactorGridToCJGrid"                "Use the cCJGrid class."                       True to aR
        Get AddDSRule aR "dbList class"    "dblist"    eDSClassDecl eModAutoFix "RefactorDbListTocDbCJGridPromptList" "Use the cDbCJGrid class (prompt-list setup)." True to aR
        Get AddDSRule aR "List class"      "list"      eDSClassDecl eModAutoFix "RefactorListToCJGrid"                "Use the cCJGrid class (single column)."       True to aR
        Get AddDSRule aR "dbEdit class"    "dbedit"    eDSClassDecl eModSuggest "RefactorDbEditTocDbTextEdit"         "Use the cDbTextEdit class."                   True to aR
        Get AddDSRule aR "Edit class"      "edit"      eDSClassDecl eModSuggest "RefactorEditTocTextEdit"             "Use the cTextEdit class."                     True to aR
        Get AddDSRule aR "WinReport class" "winreport" eDSClassDecl eModSuggest "RefactorWinReportTocWinReport2"      "Use the cWinReport2 class."                   True to aR

        // v4 (2026-07-11): the SUBCLASS-definition forms ('Class cMy is a dbList') as their own
        // Explain rules. The converters (deliberately) refuse class definitions - rewriting one
        // breaks every instance built on its legacy API - so these rows must never promise a fix
        // (Nils's LegacyApp3 residue: 12 files of 'Class ... is a dbGrid/dbList/DFTimer' rows the plan
        // run could not touch). The workable path rides the hint: port the subclass by hand, then
        // convert its INSTANCES via the matching converter's class-names parameter.
        // v83 (2026-10-04): the dbGrid, Grid and dbList subclass hints name ConvertGridSubclassToCodeJock, which
        // ports such a class IN PLACE and converts every object of it - edited in place. Its objects keep their
        // class name, so the class is not dead code afterwards. A List subclass is still ported by hand: the
        // converter refuses the List family for now.
        // v84 (same day): those three rules CARRY the converter, Auto-fix - a row that only named it in its hint
        // sat in the hand band, and the plan could not run it. The scan asks the converter about each class
        // (JudgeGridSubclasses); a class it cannot take loses the function again and says why (_GridClassRowHint).
        Get AddDSRule aR "DfTimer subclass"   "dftimer"   eDSClassSubclass eModExplain "" "Objects of this subclass are listed as DfTimer objects. ChangeDfTimerTocTimer takes only the literal dfTimer, so port this class to cTimer by hand; its objects then follow."                                 True to aR
        Get AddDSRule aR "dbGrid subclass"    "dbgrid"    eDSClassSubclass eModAutoFix "ConvertGridSubclassToCodeJock" "Workspace subclass of dbGrid; its objects are listed as dbGrid subclass objects. ConvertGridSubclassToCodeJock converts it to cDbCJGrid in place and runs RefactorDbGridTocDbCJGrid on those objects itself." True to aR
        Get AddDSRule aR "Grid subclass"      "grid"      eDSClassSubclass eModAutoFix "ConvertGridSubclassToCodeJock" "Workspace subclass of Grid; its objects are listed as Grid subclass objects. ConvertGridSubclassToCodeJock converts it to cCJGrid in place and runs RefactorGridToCJGrid on those objects itself." True to aR
        Get AddDSRule aR "dbList subclass"    "dblist"    eDSClassSubclass eModAutoFix "ConvertGridSubclassToCodeJock" "Workspace subclass of dbList; its objects are listed as dbList subclass objects. ConvertGridSubclassToCodeJock converts it to cDbCJGridPromptList in place and runs RefactorDbListTocDbCJGridPromptList on those objects itself." True to aR
        Get AddDSRule aR "List subclass"      "list"      eDSClassSubclass eModExplain "" "Objects of this subclass are listed as List objects and stay as they are: a plain cCJGrid would lose what this class adds. Port it to a class based on cCJGrid by hand, then convert its objects with the parameter 'ThisClass,YourNewClass,cCJGridColumn'. When none are left, remove this class - it is dead code."  True to aR
        // v96 (2026-11-05): so does the WinReport subclass row, which v54 left an Explain telling the user to run it by hand.
        // v54 (2026-09-07): the two edit subclass rows carry their converter (Suggest, like the object rows), so
        // the plan runs it on the DECLARING file - the base line is where the conversion is, the objects follow.
        // Until then the row was an Explain telling the user to run the converter there by hand, and a plan
        // run over the objects' files reported 0 converted (a workspace with two aps-style subclasses).
        Get AddDSRule aR "dbEdit subclass"    "dbedit"    eDSClassSubclass eModSuggest "RefactorDbEditTocDbTextEdit" "Objects of this subclass are listed as dbEdit objects. RefactorDbEditTocDbTextEdit converts this base line to cDbTextEdit (its default parameter) and the objects follow without a change of their own; the plan runs it on this file. A workspace subclass that already derives from cDbTextEdit is named in the run notes as the place the objects could move to instead." True to aR
        Get AddDSRule aR "Edit subclass"      "edit"      eDSClassSubclass eModSuggest "RefactorEditTocTextEdit"     "Objects of this subclass are listed as Edit objects. RefactorEditTocTextEdit converts this base line to cTextEdit (its default parameter) and the objects follow without a change of their own; the plan runs it on this file. A workspace subclass that already derives from cTextEdit is named in the run notes as the place the objects could move to instead."     True to aR
        Get AddDSRule aR "WinReport subclass" "winreport" eDSClassSubclass eModSuggest "RefactorWinReportTocWinReport2" "Objects of this subclass are listed as WinReport objects. RefactorWinReportTocWinReport2 converts this base line to cWinReport2 (its default parameter) and the objects follow without a change of their own; the plan runs it on this file."              True to aR

        // v14 (Nils 2026-07-16): the legacy DAW utility function Get_File_Exists (func.pkg) -> the
        // native File_Exist command. Two-word command-position token: only the Get-CALL form flags
        // (the shape the converter rewrites); a function-style expression call - (Get_File_Exists(x))
        // - stays quiet, matching the converter's deliberate bail (not line-local).
        Get AddDSRule aR "Get_File_Exists function" "get get_file_exists" eDSCommandPos eModAutoFix "ChangeGetFileExistsToFileExist" "File_Exist <file> <var> - the native command; note it takes NO 'to' token." True to aR

        /* v20 (Nils 2026-07-30): the legacy pre-Studio program shell - 'Object <n> is a Workspace'
           from Workspc.pkg, which modern DataFlex no longer ships.

           The catalog said NOTHING about this construct. On the DF18 workspace that prompted it, 201
           .src files carry the shell and the only thing the scan had to say about any of them was DS
           9059 on their '#REPLACE CURRENT$WORKSPACE' line, advising a Define - the wrong fix, on the
           wrong line, for a file whose actual problem is that its program shell predates cApplication.
           That advice is now suppressed in the eDSReplaceConst branch and this rule carries the file
           instead.

           SUGGEST, not AutoFix, for two reasons that both matter: the converter needs its .ws-file
           parameter set for the workspace being converted (it becomes 'Set psAutoOpenWorkspace to
           "<parameter>"', and the shipped default Config.ws is right for very few real programs), and
           it scaffolds a whole modern shell - command bars, help, client area - which is a change to
           read before trusting. This also matches the 4313/4345/4328 ModRecipes already routed to the
           same function, so the compiler lane and the scan lane agree on its category.

           eDSClassDecl, so only the OBJECT declaration flags. 'Class X is a Workspace' deliberately
           does not: the converter refuses to re-base a subclass, and a scan row promising a fix the
           plan run cannot deliver is the exact defect that split eDSClassDecl from eDSClassSubclass. */
        Get AddDSRule aR "Workspace program shell" "workspace" eDSClassDecl eModSuggest "RefactorWorkspaceTocApplication" "The pre-Studio program shell (Workspc.pkg, no longer shipped) - RefactorWorkspaceTocApplication converts it to 'Object oApplication is a cApplication' and scaffolds the modern shell. Set its parameter to this workspace's .ws file first." True to aR

        /* v21 (Nils 2026-07-31): ToANSI / ToOEM, which the COMPILER LANE CANNOT LOCATE.

           The compiler reports 4534 wherever a command that calls them is USED, not where the call
           is written - so a workspace-defined command whose body calls ToANSI produces a warning on
           every one of its hundreds of call sites and none at all on the package that contains the
           actual call. VerifyAutoFix then (correctly) demotes every one of those call sites to
           Explain, because the obsolete construct is genuinely not on those lines. Net effect: the
           one file worth editing is invisible to the analyzer, and the user is told about hundreds
           of lines that are not the problem.

           A scan-lane rule has no such blind spot - it reads the source where it sits, so it finds
           the call inside the command body. This is the mirror image of the macro-expansion guard
           rather than a duplicate of it: the guard suppresses the sites that only LOOK guilty, and
           these rules surface the site that actually is.

           AutoFix is safe despite UnicodeOemAnsiFunctions not handling every form (the
           'Get ToANSI x to y' command shape is a known gap): a DS AutoFix row is dry-run verified
           against the real line before it is offered, so a shape the converter cannot touch demotes
           itself to Explain.

           Whole-word matched via _FindKeywordPos, so the modern Utf8ToAnsi / Utf8ToOem - which
           CONTAIN these tokens as substrings - never flag. */
        Get AddDSRule aR "ToANSI function" "toansi" eDSAnywhere eModAutoFix "UnicodeOemAnsiFunctions" "Utf8ToAnsi(<string>) - the Unicode-safe replacement. ToANSI is the pre-Unicode conversion." True to aR
        Get AddDSRule aR "ToOEM function"  "tooem"  eDSAnywhere eModAutoFix "UnicodeOemAnsiFunctions" "Utf8ToOem(<string>) - the Unicode-safe replacement. ToOEM is the pre-Unicode conversion."   True to aR

        /* v23 (Nils 2026-08-03): symbols DELETED from the DataFlex install, where the compiler lane
           has nothing helpful to say - found by diffing the DfVersion-*.json catalogues across
           18.1 -> 26.0 and then VERIFYING each one against the real Pkg folders.

           TWO DIFFERENT SILENCES, both worth a scan-lane rule:

           1. THE DF26 DELETIONS. WebConvertClient.pkg and VDFISDataStruct.pkg are gone from DF26,
              and cIniFile.pkg dropped its GetPrivateProfileString wrapper. Nothing replaced any of
              them, so a call site produces an undefined-symbol error naming the symbol and offering
              no route - and the user cannot tell "renamed" from "withdrawn" from the message.

           2. THE VANISHED FLEXCOM FAMILY - the more interesting case. Flexcom.pkg, FlexcomWA.pkg
              and Fole_api.pkg shipped in DF20.1 WITH friendly 4536 "obsolete package" messages. In
              DF23.0 the packages were deleted, and their obsolete messages went with them. So the
              guidance got WORSE with the upgrade: 20.1 said "this is obsolete", 23.0+ says only
              4313 "Include file not found". The scan can say what the compiler no longer can.

           EXPLAIN with no refactor function, all seven. There is no mechanical rewrite for any of
           them - a withdrawn API needs a decision about what replaces it, and GetPrivateProfileString
           in particular is NOT a rename: its replacement is 'Get ReadString of <a cIniFile object>',
           which needs an object the call site does not have. An AutoFix promise the plan run cannot
           keep is the defect eDSClassDecl was split from eDSClassSubclass to avoid.

           NOT added here, deliberately: OldcCJReportControl.pkg (23.0) and cCollection.pkg (24.0).
           Both are flagged obsolete but still SHIP in 26.0, so their 4536 messages are alive in the
           install and the compiler lane already carries them - a scan rule would only duplicate a
           row the analyzer produces with better line information. */
        Get AddDSRule aR "ConvertToClient function"   "converttoclient"   eDSAnywhere eModExplain "" "Withdrawn in DF26 with WebConvertClient.pkg, which the install no longer ships. Nothing replaced it - the web value conversion has to be done by the calling code."  True to aR
        Get AddDSRule aR "ConvertFromClient function" "convertfromclient" eDSAnywhere eModExplain "" "Withdrawn in DF26 with WebConvertClient.pkg, which the install no longer ships. Nothing replaced it - the web value conversion has to be done by the calling code."  True to aR
        Get AddDSRule aR "VDFISData struct"           "vdfisdata"         eDSAnywhere eModExplain "" "Withdrawn in DF26 with VDFISDataStruct.pkg, which the install no longer ships. The internet-session structure is no longer part of the published surface."          True to aR
        Get AddDSRule aR "GetPrivateProfileString"    "getprivateprofilestring" eDSAnywhere eModExplain "" "DF26 dropped this wrapper from cIniFile.pkg. Use a cIniFile object: Set psFileName, then Get ReadString of it - a rewrite, not a rename, because it needs an object." True to aR
        Get AddDSRule aR "Flexcom.pkg"                "flexcom"           eDSAnywhere eModExplain "" "Deleted from the install in DF23 - and its 4536 'obsolete package' message went with it, so the compiler now says only 'Include file not found'. Use the DataFlex COM support (Use FlexCOM classes via the Studio COM proxy generator)." True to aR
        Get AddDSRule aR "FlexcomWA.pkg"              "flexcomwa"         eDSAnywhere eModExplain "" "Deleted from the install in DF23, together with its 4536 'obsolete package' message. The compiler now reports only 'Include file not found'." True to aR
        Get AddDSRule aR "Fole_api.pkg"               "fole_api"          eDSAnywhere eModExplain "" "Deleted from the install in DF23 - it was part of Flexcom.pkg, which went with it. The compiler now reports only 'Include file not found'." True to aR

        /* v24 (Nils 2026-08-04): the CodeJock Report -> Grid rename of DF 23.0, now that
           ChangeCodeJockReportToGrid can do it.

           Same shape as the Flexcom family above: cCJReportControl.pkg does not exist in DF23+, so
           "Use cCJReportControl.pkg" gets a bare 4313 "Include file not found". The helpful 4536
           "use cCJGridControl.pkg instead" message DOES exist - but it sits on
           OldcCJReportControl.pkg, a file nobody references. The guidance and the breakage are on
           two different file names, so the compiler lane alone never connects them.

           AutoFix here rather than Explain, unlike its neighbours, because there IS a converter and
           the rewrite is exact: rule plus two exceptions maps all 214 symbols onto names that exist.
           The token is the CLASS/package name, not "report" - see the converter's own header for the
           ComReport* trap that makes word-matching unsafe. */
        Get AddDSRule aR "cCJReportControl.pkg" "ccjreportcontrol" eDSAnywhere eModAutoFix "ChangeCodeJockReportToGrid" "Renamed to cCJGridControl.pkg in DF23 when CodeJock renamed the control - the package and every cCJReport*/xtpReport* name in it become their Grid form together." True to aR

        /* v25: Crystal Reports (Nils 2026-08-09: "the support for it has been dropped and any usage
           of Crystal needs to be dropped and the reports moved to a more modern alternative, such as
           DataFlex Reports. There is nothing we can do in this area, more than warn").

           EXPLAIN, and it always will be. Every other Explain rule here describes a rewrite someone
           could do by hand; this one cannot, in principle. The .rpt files, the viewer control, the
           database bindings and the print pipeline all move together to another product, and no
           source transformation carries a report definition across. Offering anything but a warning
           would be the "action offered without checking it could act" defect this app keeps finding
           in itself - so the hint names the destination and stops.

           Measured first, like every rule here: 339 Use lines across the DF18/DF19 trees, spread
           over 14 package names - which is why it matches the FAMILY (eDSUseContains) rather than
           enumerating names that were only ever a snapshot. */
        Get AddDSRule aR "Crystal Reports package" "crystal" eDSUseContains eModExplain "" "Crystal Reports support has been dropped - move these reports to a modern reporting tool such as DataFlex Reports. No refactoring can carry this over: the report definitions, the viewer and the data bindings migrate together, so treat each Use line as one report set to retire." True to aR


        /* v28: method overloading (Nils 2026-08-23, after the Overloaded work on the 4544 lane).

           NOT AN ERROR, and the hint has to lead with that. An overloaded name compiles, links and
           runs; DataFlex resolves it by PARAMETER COUNT, so its variants may legally return
           different types. Measured on DF26 the same day: two Overloaded declarations of one name
           with different return types compile AND resolve in an expression, where the identical
           pair without the token raises 4544. That is precisely why this is a Suggest and never an
           AutoFix - there is nothing broken to fix, only a technique the DataFlex documentation
           calls obsolete.

           SUGGEST WITH A REAL ACTION. A function-less recipe is forced to Explain by
           _DemoteFunctionlessToExplain, so labelling this Suggest with no sRefactorFn would have
           been a lie the grid quietly corrected. The action is FunctionReturnMismatchReport, which
           lists every overloaded name with each of its declarations under its own heading - the
           same eReportFunctionAll shape LegacyDbApiReport and GosubGotoReport are wired as here.
           Retiring an overload set is a design decision per name, not a rewrite: give the variants
           distinct names, or take one argument list and read Num_Arguments. Neither can be chosen
           for the user, so the report tells them where the sets are and stops.

           Token matching is safe by construction. eDSAnywhere is boundary-aware and code-only, so
           an identifier that merely contains the word - bOverloaded, _NameIsOverloadedInLines - is
           not a hit, and neither is the word inside a comment or a string literal. */
        Get AddDSRule aR "Overloaded method" "overloaded" eDSAnywhere eModSuggest "FunctionReturnMismatchReport" "Method overloading is documented as obsolete. Nothing is broken - DataFlex tells the variants apart by PARAMETER COUNT, so they may legally return different types and this can never raise error 4544. To retire it, give the variants distinct names, or take one argument list and read Num_Arguments. The report lists every overloaded name with its declarations." True to aR

        /* v29 (2026-08-26): THE x64 BUG THE COMPILER NEVER REPORTS.

           An External_Function written for a 32-bit build that types a pointer argument as Integer
           compiles clean on x64 and truncates the address at run time - no error, no warning, a
           wrong pointer. There is no compiler message for it, which is precisely why it belongs in
           a Deep Scan rule rather than a ModRecipe: the Modernization Analyzer can only react to
           what the compiler says, and here it says nothing.

           THE RULE ASKS THE CONVERTER. eDSApiDeclTypes joins the ";"-continued declaration and then
           calls _CorrectedApiDecl - ConvertWinAPIDeclarationTypes' own decision function - so a
           hit is by construction a line that converter would change. Everything it refuses
           (uncatalogued API, parameter count disagreeing with the SDK, types already correct, or
           an API needing both bitness arms) is not a hit, which is the honest reading: there is
           nothing here for this to do.

           SUGGEST, NOT AutoFix. The fix is unambiguous where it fires, but it rewrites an API
           binding and the compiler cannot check the result - the one thing that would catch a
           mistake is absent. Promote it the way any rule graduates, after a workspace has been
           through it. */
        Get AddDSRule aR "External_Function 64-bit types" "external_function" eDSApiDeclTypes eModAutoFix ;
            "ConvertWinAPIDeclarationTypes" ;
            "Declares an Integer or DWord where the Windows API takes a pointer. On a 64-bit build that compiles cleanly and truncates the address at run time. The corrected declaration is right on both platforms - DataFlex sizes Pointer/Handle/LongPtr per build - so no #IFDEF is needed." ;
            True to aR

        /* v31 (2026-08-27): THE FLEXCOM BLOCKER - the one finding that HALTS refactoring.

           A FlexCOM-era COM proxy (rcmail.pkg on LegacyApp4, generated 2007) is written
           against a helper DataFlex 26 does not ship, so no refactoring can make it compile - and
           the engine now refuses to start a write-run over a workspace that Uses it
           (InitializeEngine, the FlexCOM halt). This row is the board's half of that: it explains
           WHY, before the user hits the halt. Explain with no function on purpose - the fix is the
           Studio's Import COM Object Library wizard, and a Use-swap to FlexCOM20.pkg cannot work
           because the generated bodies speak the old helper's dialect.

           The token carries the DOT so FlexCOM20.pkg never matches - the same one-character
           distinction the engine's halt uses. */
        Get AddDSRule aR "FlexCOM (retired COM helper)" "flexcom." eDSUseContains eModExplain "" ;
            "This file is built on FlexCOM.pkg, the FlexCOM-era COM helper that DataFlex 26 no longer ships. Refactoring is HALTED for the workspace until the COM proxy is re-generated (Studio: Import COM Object Library; the component must be installed and registered) and call sites adapted. Changing the Use to FlexCOM20.pkg cannot work - the generated code is written against the old helper." ;
            True to aR

        /* v33 (2026-08-28): THE ANSI-WITH-WIDE-TWIN row (DS 9221). GuardAnsiExternalFunctionWithWide
           has built the guarded A/W pair since mid-August - original ANSI declaration kept for
           older releases, the W declaration (from the catalogue, local name kept) for Unicode
           DataFlex - but carried NO recipe and no rule, so nothing ever offered it. The harvest
           multiplied its reach the day before: the W-arm source went from 56 rows to 1,294. */
        Get AddDSRule aR "ANSI External_Function (wide twin available)" "external_function" eDSAnsiApiWide eModAutoFix ;
            "GuardAnsiExternalFunctionWithWide" ;
            "This declaration binds the ANSI (...A) entry point, and the catalogue holds its wide (...W) twin. The fix wraps the pair: the workspace's ANSI declaration kept for older DataFlex releases, the W declaration - Unicode-correct, under the same local name - for current ones. Calls that fill text buffers may need hand review; the External_Function report tags those [structural]." ;
            True to aR

        /* v36: the legacy Replace COMMAND (Nils 2026-08-29, a customer's mech_imp.dg:
           'if (sSep = ".") replace "," in sQty with "."'). Its 'in' keyword baited DS 9041 into
           routing it at ChangeInToContains, which correctly no-ops on it - six auto-fixable lines
           parked in "needs hand migration". The 9041 matcher now declines Replace-command lines
           and this rule owns them: Replace <find> In <var> With <new> -> Move (Replace(<find>,
           <var>, <new>)) to <var> - Replace(), not Replaces(): the command replaces the FIRST
           occurrence, and so does the function. AutoFix per Nils ("we definitely should be able
           to refactor it"); the analyzer's dry-run demotion still parks any line the converter
           declines. */
        Get AddDSRule aR "Replace command" "replace" eDSReplaceCommand eModAutoFix "ChangeReplaceCommandToFunction" ;
            "Replace x In v With y (first occurrence, in place) -> Move (Replace(x, v, y)) to v." True to aR

        /* v37: the CodeJock xtpReport* CONSTANTS in their own right (Nils 2026-08-30: "didn't we
           create a refactoring function to specifically change all such instances? ... it is not
           being triggered").

           The v24 rule above and the converter's { ModRecipe } BOTH keyed on the PACKAGE name
           cCJReportControl, which assumes the migration is always found whole. It is not. A
           workspace can sit on the modern base class - 'Class LcGrid is a cDbCJGrid', no
           cCJReportControl anywhere - and still carry 'Set peVisualTheme to
           xtpReportThemeVisualStudio2012Light' from before the DF23 rename. Nothing in such a file
           mentions the package, so BOTH lanes were blind to it and the build broke on a constant
           the converter has always known how to rewrite.

           PREFIX, not whole word: eDSAnywhere's boundary check ends the token, so "xtpreport"
           cannot see xtpReportTheme... - hence eDSTokenPrefix. Disjoint from the package rule by
           construction (a Use line carries no xtpReport name), so no line is reported twice.

           Only the xtp* half needs this. A cCJReport* CLASS name cannot stand alone - the class has
           to be declared somewhere, and the only file that still declares it is the obsolete
           package, whose own name the v24 rule matches. */
        Get AddDSRule aR "xtpReport constant" "xtpreport" eDSTokenPrefix eModAutoFix "ChangeCodeJockReportToGrid" ;
            "Renamed xtpGrid* in DF23 when CodeJock renamed the control. Defined now only in the obsolete OldcCJReportControl.pkg, so without it the name does not resolve - the compiler reports it as an unresolved forward reference, never as a rename." ;
            True to aR

        /* v39 (2026-08-31): THE LEGACY TYPE BUFFER THAT HAS A SHIPPED STRUCT (DS 9224). The
           ZeroType/Put/GetBuff rules above all route to TypeToStructReport, which reports and
           changes nothing - so a workspace's byte-buffer clusters showed up as rows whose only
           offer was Ignore (Nils 2026-08-31: the same four tokens after every Check).
           ChangeLegacyTypeToWinStruct converts them where DataFlex itself replaced the Type with
           a tWin<X> struct and marshals that struct to the same API. This rule fires ONLY where
           the converter would actually act: it asks the converter's own _WinStructClusterWhyNot,
           so the row and the run cannot disagree. Everything it declines stays with the report
           rules, which is where a hand migration belongs. */
        Get AddDSRule aR "Legacy Type buffer (shipped Struct available)" "zerotype" eDSTypeToWinStruct eModAutoFix ;
            "ChangeLegacyTypeToWinStruct" ;
            "This buffer is a legacy Type byte-block, and DataFlex now ships a Struct for the same Windows API. The fix retypes the declaration, drops the ZeroType (a Struct local is already zero), turns Put/GetBuff into plain Moves and <Type>_size into SizeOfType - leaving AddressOf exactly as it is, because passing the struct to the API is the point." ;
            True to aR

        /* v43 (2026-09-01): THE WIN32 TYPE BUFFER THAT HAS A CONVERTER, AND NOBODY KNEW (DS 9225).
           ChangeExternalFunctionCallers has existed since 2026-08-30 and no rule has ever offered
           it - the ZeroType/Put/GetBuff rules above all route to TypeToStructReport, so a workspace
           whose buffers it converts perfectly saw only "run the report" and Ignore. That is the
           gap that sent a whole day into building a converter which already existed (Nils
           2026-09-01, WinServ's ProcessMessages.pkg).

           It fires only where the run would act, and it establishes that by running the converter
           on a copy of the file and reporting the ZeroType lines that disappeared - see
           _RuleMatchesLine. Disjoint from DS 9224 in practice because that one needs a tWin<X>
           twin in the install while this needs an entry in the harvested SDK catalogue; where both
           could claim a line, 9224 is the narrower and more conservative fix and is seeded first. */
        Get AddDSRule aR "Win32 Type buffer (SDK struct available)" "zerotype" eDSWin32BufferConvertible eModAutoFix ;
            "ChangeExternalFunctionCallers" ;
            "This buffer is a legacy Type byte-block handed to a Windows API. The fix comments the Type out, puts a Struct in its place under the same member names, and rewrites the calling code: ZeroType, Put..At, GetBuff and a hand-written Repeat(Character(0), <Type>_SIZE) all become struct member access, while AddressOf is left exactly as it is. Where the SDK catalogue recognises the struct you also get its exact member types and the alignment padding a legacy block cannot express - the x64 fix a compiler cannot see, where a legacy block declares 4 bytes and Windows writes 8. Where it does not, the Type's member types are carried across unchanged: the layout is preserved exactly, but a member already wrong for 64-bit stays wrong." ;
            True to aR

        /* v60 (2026-09-09): THE SUPPRESSION THAT TRAVELS. Every other rule here names a construct that
           is merely old; this one names a directive that is actively wrong. 'CompilerWarnings Off' is a
           plain switch - measured, it does NOT end with the file that issued it, the way 'Suspend' does -
           so one that is never closed silences every file compiled after it, and a library carries that
           into its consumers' builds. Nothing in either lane would ever say so: the compiler cannot warn
           about warnings it was told not to emit.
           Explain-only, and deliberately: where the muted region was meant to end is the author's
           decision, and closing it at end-of-file would be a guess dressed as a fix. */
        Get AddDSRule aR "Unpaired CompilerWarnings Off" "compilerwarnings off" eDSUnpairedWarningsOff eModExplain "" ;
            "Unlike Suspend, an Off does not end with its file - with no 'On' it silences every file compiled after this one too. Add the 'On' where the muted region ends." ;
            True to aR

        /* v66 (2026-09-13): THE LEGACY RIGHT-CLICK MENU (DS 9227-9230). FloatingPopupMenu and
           dbFloatingPopupMenu are { Obsolete=True } in the DF26 packages - 48 objects in 27 files of
           the test workspaces, every one reached by name from 'Set Floating_Menu_Object' lines - and
           the analyzer's only word on them was a hand-migrate Explain (Nils: "There are a lot of
           FloatingPopupMenu objects in this workspace"). ChangeFloatingPopupMenuToCodeJock converts
           the OBJECT form in place, name kept; Suggest, like the other class converters, until a live
           run has been read. The SUBCLASS form stays Explain, as the whole family does: a class
           definition is never rewritten.
           v68 (same day): the two object rows PROMOTED to Auto-fix after Nils's live runs on his
           workspace ("Nice, that works well") - every shape the converter cannot take is refused under
           a marker that both lanes re-ask, so an Auto-fix row never promises a run that declines
           unseen.
           v87 (2026-10-05): THE FloatingPopupMenu SUBCLASS IS OFFERED ITS OWN CONVERTER (Nils, on the one
           popup row a workspace had left after its plan run: "Couldn't we provide a refactoring function
           for FloatingPopupMenu ...?"). That class was empty, created at run time and filled through
           Add_Item - nothing the object converter could read. ConvertPopupMenuSubclassToCodeJock ports
           such a class in place and lets it answer Add_Item and Item_Count itself. REVIEW, not Auto-fix:
           the class file cannot show which other legacy messages some code sends to the menu, and those
           fail when they run. _SweepRules asks the converter about each class (a dry run) and keeps the
           offer only where it converts; where it does not, the row is an explanation with the
           converter's reason, on every Check - no marker is written. The dbFloatingPopupMenu subclass
           rule stays as it was: that class inherits ten items. */
        Get AddDSRule aR "FloatingPopupMenu class"      "floatingpopupmenu"   eDSClassDecl     eModAutoFix "ChangeFloatingPopupMenuToCodeJock" "Use the cCJContextMenu class: the object keeps its name, its items become cCJMenuItem children, its Popup override rides along."                                                     True to aR
        Get AddDSRule aR "dbFloatingPopupMenu class"    "dbfloatingpopupmenu" eDSClassDecl     eModAutoFix "ChangeFloatingPopupMenuToCodeJock" "Use the cCJContextMenu class: the ten inherited DEO items become the shipped cCJ*MenuItem classes, the object's own items follow, its name is kept."                       True to aR
        Get AddDSRule aR "FloatingPopupMenu subclass"   "floatingpopupmenu"   eDSClassSubclass eModSuggest "ConvertPopupMenuSubclassToCodeJock" "Workspace subclass of FloatingPopupMenu. ConvertPopupMenuSubclassToCodeJock converts it to cCJContextMenu in place and gives the class its own Add_Item and Item_Count, so the code that fills the menu at run time stays as it is. Look before you run it: any other FloatingPopupMenu message sent to the menu is not carried, and objects of this subclass are not listed." True to aR
        Get AddDSRule aR "dbFloatingPopupMenu subclass" "dbfloatingpopupmenu" eDSClassSubclass eModExplain "" "Port this class to cCJContextMenu by hand - the ten inherited DEO items are the shipped cCJ*MenuItem classes. ChangeFloatingPopupMenuToCodeJock takes only the literal class, and objects of this subclass are NOT flagged: find them yourself." True to aR

        /* v75 (2026-09-18): THE REST OF THE Y2K TRIPLET (DS 9231-9232). The old Studio wrote three
           Set_Attribute lines into every new program - DF_SYSDATE_4_STATE, DF_DATE_4_STATE and
           DF_EPOCH_VALUE - and VdfBase.pkg has set all three itself since DataFlex 12 (True / True / 30,
           "Y2K has come and gone"; the block is still there in DF26 and DF27). Only the first was
           catalogued. The other two are NOT no-ops: DF_DATE_4_STATE still drives the year width of a
           date-to-string conversion and DF_EPOCH_VALUE still decides how a 2-digit year is read, so
           the converter comments a line out only when it repeats VdfBase's value ('to True' / 'to 30')
           and leaves an override - the old Studio template's own 'DF_DATE_4_STATE to False' among
           them - and any Get_Attribute verbatim; the analyzer's dry-run then hands that row to
           Explain, so an Auto-fix row never changes behaviour (Nils 2026-09-18: "it seems logical that
           any and all of them should be commented out", with the guard agreed). */
        Get AddDSRule aR "DF_DATE_4_STATE" "df_date_4_state" eDSAnywhere eModAutoFix "CommentOutLegacyDateAttributes" ;
            "VdfBase.pkg sets it True: a 'Set_Attribute DF_DATE_4_STATE to True' is redundant and is commented out; any other value is a deliberate override and stays." True to aR
        Get AddDSRule aR "DF_EPOCH_VALUE"  "df_epoch_value"  eDSAnywhere eModAutoFix "CommentOutLegacyDateAttributes" ;
            "VdfBase.pkg sets it to 30: a 'Set_Attribute DF_EPOCH_VALUE to 30' is redundant and is commented out; any other value changes how 2-digit years are read and stays." True to aR

        /* v79 (2026-10-03): THE RESIDENT IMAGE OPTION (DS 9233). A legacy report image's name line
           took options, and 'Resident' ('/Body Resident') kept the image in memory so a report did
           not read it from disk for every line it printed. The option is obsolete - character mode
           and BasicReport only - and a DataFlex 26 report whose image still carries it crashes, or
           prints output that is no use (Nils 2026-10-03). The compiler says nothing about it, so
           the scan is the only lane that can offer the fix. Auto-fix: RemoveResidentImageOption
           removes the word and nothing else, and the word never changed what an image prints. The
           rule reads the name line itself (eDSImageOption), which every other rule is kept away
           from - see _SweepImageNameRules. */
        Get AddDSRule aR "Resident image option" "resident" eDSImageOption eModAutoFix "RemoveResidentImageOption" ;
            "Obsolete: Resident only kept the image in memory, and a DataFlex 26 report can crash on it. The fix removes the word; what the image prints is unchanged." True to aR

        /* v84 (2026-10-04): AN OBJECT OF THE WORKSPACE'S OWN GRID SUBCLASS (DS 9234-9236). The family rules above
           (dbGrid / Grid / dbList class) list such an object too, through the learned subclasses, but their
           converters leave it as it is - a plain CodeJock grid would lose what the subclass adds - so those rows
           are explanations. ConvertGridSubclassToCodeJock is the converter that takes them: it ports the CLASS
           in place and every object with it. On a workspace whose grids are all objects of its own subclasses
           that is every grid there is - 2,110 of them sat in the hand band (Nils: "these grid conversions are
           one of the big points for the whole tool!"). An object matches here only where the converter says it
           converts the class (JudgeGridSubclasses), and the family rule then steps back, so each object is
           listed once. Auto-fix: with an empty parameter the run is a fixed transform, each class all or nothing.
           v85 (2026-10-05): the six hints - these three and the three class-line rules above - NAME the object
           converter the function runs itself (Nils: "it should somehow be made very clear that the
           ConvertGridSubclassToCodeJock calls the RefactorDbGridTocDbCJGrid, RefactorDbListTocDbCJGridPromptList
           and RefactorGridToCJGrid functions" - a plan listing the one function over 1,143 files read as wrong). */
        Get AddDSRule aR "dbGrid subclass object" "dbgrid" eDSSubclassObject eModAutoFix "ConvertGridSubclassToCodeJock" ;
            "An object of a workspace subclass of dbGrid. ConvertGridSubclassToCodeJock converts the class to cDbCJGrid in place and runs RefactorDbGridTocDbCJGrid on this object itself." True to aR
        Get AddDSRule aR "Grid subclass object"   "grid"   eDSSubclassObject eModAutoFix "ConvertGridSubclassToCodeJock" ;
            "An object of a workspace subclass of Grid. ConvertGridSubclassToCodeJock converts the class to cCJGrid in place and runs RefactorGridToCJGrid on this object itself." True to aR
        Get AddDSRule aR "dbList subclass object" "dblist" eDSSubclassObject eModAutoFix "ConvertGridSubclassToCodeJock" ;
            "An object of a workspace subclass of dbList. ConvertGridSubclassToCodeJock converts the class to cDbCJGridPromptList in place and runs RefactorDbListTocDbCJGridPromptList on this object itself." True to aR

        /* v91 (2026-10-20): THE OBSOLETE INCR, DECR AND SUB COMMANDS. Their converters had compiler recipes only
           (warning 4533, "command: Incr" ...), so a source scan never listed them: the Test Bench's Analyze found
           no row for 'incr iInt', 'decr iInt' or 'sub 5 from iInt' (Nils 2026-10-20). Command position, like the
           Pad and Mid rules; Increment, Decrement and Subtract are other words and are never flagged. */
        Get AddDSRule aR "Incr command" "incr" eDSCommandPos eModAutoFix "ChangeIncrToIncrement" "Use the Increment command." True to aR
        Get AddDSRule aR "Decr command" "decr" eDSCommandPos eModAutoFix "ChangeDecrToDecrement" "Use the Decrement command." True to aR
        Get AddDSRule aR "Sub command"  "sub"  eDSCommandPos eModAutoFix "ChangeSubToSubtract"   "Use the Subtract command."  True to aR

        /* v92 (2026-10-20): THE POINTER/STRING MOVES OF COMPILE ERROR 4539. 'Move aResult to sResult' is
           wrong only because aResult is declared an Address, so no line rule can see it; the converters read
           the method's declarations and parameters, and they rewrite only when both types are known. So this
           kind asks them: a dry run of the converter over a copy of the file, one row per line it would
           rewrite (_PointerMoveHits) - the scan lists exactly what the fix fixes (Nils 2026-10-20, the Test
           Bench's Analyze found neither direction). */
        Get AddDSRule aR "Pointer to String Move" "pointer" eDSPointerStringMove eModAutoFix "UnicodePointerToString" ;
            "A Pointer or Address moved to a String is compile error 4539 from DataFlex 2022: wrap it in PointerToString()." True to aR
        Get AddDSRule aR "String to Pointer Move" "pointer" eDSPointerStringMove eModAutoFix "UnicodeStringToPointer" ;
            "A String moved to a Pointer or Address is compile error 4539 from DataFlex 2022: copy it with MemCopy()." True to aR

        /* v93 (2026-10-23): GAPS FROM THE DATAFLEX DOCS' "MIGRATING OLDER APPLICATIONS" CHAPTER (Nils 2026-10-23).
           DFTrue / DFFalse: old names for True / False, still compiled and never warned about, so this scan
           is the only place they show up. Whole words in code only (eDSAnywhere); ChangeDfTrueDfFalse
           was made word-aware for these rows, so a name like bDfTrueSet is never a hit and never changed. */
        Get AddDSRule aR "DFTrue"  "dftrue"  eDSAnywhere eModAutoFix "ChangeDfTrueDfFalse" ;
            "DFTrue is an old name for True: write True." True to aR
        Get AddDSRule aR "DFFalse" "dffalse" eDSAnywhere eModAutoFix "ChangeDfTrueDfFalse" ;
            "DFFalse is an old name for False: write False." True to aR
        /* ...and the Error command with a literal number (kind eDSErrorNumber). DataFlex names most of its
           own numbers in errornum.inc, and 'Error 25' IS 'Error DFERR_REC_NOT_FOUND' - the name is a
           #REPLACE of the number - so the rename is Auto-fix (DS 9244), and its row says the name. A
           number DataFlex does not name (Error 300, Error 999: 3,585 of the 4,000 on the test drive,
           2026-10-23) was Explain (DS 9245). Since v95 the ones with a safe automatic answer are DS 9252's, at
           the tail, and DS 9245 keeps the rest: no text of their own, a Flexerrs.dat record, or code that reads
           the number. Which rule owns a line is the target version's errornum.inc's call, read through
           ghoFuncLib, and then cRefactorFuncLib._MadeUpErrorWhyNot's. */
        Get AddDSRule aR "Error number (named)" "error" eDSErrorNumber eModAutoFix "ChangeErrorNumberToName" ;
            "An Error number DataFlex has a name for: write the name." True to aR
        Get AddDSRule aR "Error number (not named)" "error" eDSErrorNumber eModExplain "" ;
            "An Error number DataFlex has no name for, which the automatic fix leaves alone." True to aR
        /* ...and (oName(Self)) -> (oName), DataFlex 8.2's Easy Object Referencing (kind eDSSelfObjectRef).
           Tidy Up: the long form still compiles. The rows come from RemoveSelfFromObjectReferences' own dry
           run, so the scan lists exactly what the fix changes. Shipped OFF and as Review (v93): 98,288
           references on the test drive would bury every other row of a Check (Nils 2026-10-23), and the
           function had not had a live run. v98: Auto-fix and ON (Nils 2026-10-30) - the 2026-10-24 live run on
           a workspace copy changed 10,960 references, every line as an independent model predicted, and the
           workspace's programs compiled with the same errors and warnings before and after. A saved file
           older than v98 holds the old OFF as a default, not a choice (_SeedSwitchedOnAfterFile). */
        Get AddDSRule aR "(Self) in an object reference" "self" eDSSelfObjectRef eModAutoFix "RemoveSelfFromObjectReferences" ;
            "(oName(Self)) can be written (oName) since DataFlex 8.2: it is the same object." True to aR

        /* v94 (2026-10-23): PHASE 2 OF THE MIGRATION-CHAPTER GAPS (Nils 2026-10-23). The authority for the old
           names is DataFlex's own Pkg\VdfBase.pkg - 27 '#Replace U_<old> U_<new>' lines, the same on 18.1, 19.1
           and 26 - not the docs' 8.3 lists, which are wrong for Desktop and BaseClass (cObject, not cUIObject).
           A probe on DataFlex 26 (non-visual) found every rename below exact; the counts are the test drive's.
           'for DFDesktop' -> the Desktop keyword, the docs' own rule: both reach the desktop only (3 uses). */
        Get AddDSRule aR "for DFDesktop method" "dfdesktop" eDSObsoleteMethodTarget eModAutoFix "ChangeObsoleteMethodTarget" ;
            "for DFDesktop is the old way to write a desktop method: write Desktop after the method name." True to aR
        // 'for Desktop' / 'for BaseClass' -> 'for cObject', the class they already are (190 uses, 18 workspaces).
        Get AddDSRule aR "for Desktop / for BaseClass method" "desktop" eDSObsoleteMethodTarget eModAutoFix "ChangeObsoleteMethodTarget" ;
            "for Desktop and for BaseClass mean for cObject: write for cObject, the same class. The parameter Desktop writes the Desktop keyword instead, for a method meant for the desktop." True to aR
        // The old class names in a class position (about 410 uses: DFObject 289, Message 42, DFControl 21...).
        // The row says the new name.
        Get AddDSRule aR "Old class name" "classname" eDSObsoleteClassName eModAutoFix "ChangeObsoleteClassNames" ;
            "An old name for a DataFlex class: write its current name, the same class." True to aR
        /* Field_Main_Index (15 calls, 0 augmentations): the docs ask for File_Field_Index, but on a DD that asks
           the DD owning the table, so the answer can differ - Review. An augmentation is Explain. */
        Get AddDSRule aR "Field_Main_Index call" "field_main_index" eDSFieldMainIndex eModSuggest "ChangeFieldMainIndexToFileFieldIndex" ;
            "Field_Main_Index is obsolete: File_Field_Index asks the DD that owns the table. On a Data_Set the answer is the same; on a DD it is -1 when the table is not in the DD structure, and that DD's Ordering wins." True to aR
        Get AddDSRule aR "Field_Main_Index augmentation" "field_main_index" eDSFieldMainIndex eModExplain "" ;
            "An augmentation of the obsolete Field_Main_Index, which DataFlex's own classes no longer send. Move it to the DD that owns the table as Function Field_Index Integer iField Returns Integer." True to aR


        /* v95 (2026-11-05): A MADE-UP ERROR NUMBER WITH ITS OWN TEXT (DS 9252, Nils 2026-11-05: 84 rows of a real workspace,
           all of them this). See cRefactorFuncLib._MadeUpErrorWhyNot for what stays with DS 9245. */
        Get AddDSRule aR "Error number with its own text" "error" eDSErrorNumber eModAutoFix "ChangeErrorNumberToGenericError" ;
            "An Error number DataFlex has no name for, with its own text: write a generic error." True to aR

        /* v106 (2026-11-05): READS OF THE RETIRED ghoWorkspace GLOBAL (DS 9253 / 9254, Nils 2026-11-05). Until now only
           a compile brought these out, one program at a time, so a Check could say "Nothing left to fix" with 487 of
           them waiting in a test workspace's AppSrc. Review, not Auto-fix: 157 of those 487 do not look at the path's last
           character right after the read, and no installed DataFlex holds Workspc.pkg any more to show what the old
           property returned. Both rules ask cRefactorFuncLib._LegacyWorkspaceRead, as the converter does, so a Review
           row is exactly a line the fix changes. */
        Get AddDSRule aR "ghoWorkspace path read" "ghoworkspace" eDSLegacyWorkspaceRead eModSuggest "ChangeLegacyWorkspaceAccessors" ;
            "ghoWorkspace no longer exists in DataFlex: read the path from phoWorkspace(ghoApplication)." True to aR
        Get AddDSRule aR "ghoWorkspace read with no new name" "ghoworkspace" eDSLegacyWorkspaceRead eModExplain "" ;
            "ghoWorkspace no longer exists in DataFlex, and this name has no new property to read. Change this line by hand." True to aR

        Function_Return aR
    End_Function

    // ---- Rules persistence: the catalog as an EDITABLE JSON (Nils 2026-07-11) -------------
    // DFRefactor's own Data folder holds DeepScanRules.json - the per-rule enable UI edits it,
    // and every scan/recipe consumer loads THROUGH it (LoadDeepScanRules) so a user's toggles
    // hold. On a SEED-version mismatch (CI_DeepScanRulesVersion bumped: new rules, re-routed
    // functions) the file reseeds from the built-in catalog with the user's bEnabled toggles
    // MERGED ACROSS by the stable iDSNumber. All paths are explicit parameters so the unit
    // tests never touch the real file.

    Function DeepScanRulesJsonPath Returns String
        tWorkspacePaths WS
        Get pOrgWS of ghoApplication to WS
        Function_Return (vFolderFormat(WS.sData) + CS_DeepScanRulesJson)
    End_Function

    // Parse the rules file; iVersion 0 (empty rows) when absent or unparseable.
    Function _ReadDeepScanRulesFile String sPath Returns tDeepScanRulesFile
        Handle hoJson
        tDeepScanRulesFile TheFile

        Get rfParseJsonFile sPath to hoJson
        If (hoJson <> 0) Begin
            Get JsonToDataType of hoJson to TheFile
            Send Destroy of hoJson
        End
        Function_Return TheFile
    End_Function

    // Persist the rules at an EXPLICIT seed version (pretty, NO BOM - a BOM breaks ParseUtf8).
    // WriteDeepScanRules uses the current version; the unit tests use this to fabricate a STALE
    // (version 0) file and prove the reseed-and-merge path.
    Procedure WriteDeepScanRulesAtVersion tDeepScanRule[] aRules String sPath Integer iVersion
        Handle hoJson
        UChar[] ucJson
        Integer iCh
        tDeepScanRulesFile TheFile

        Move iVersion to TheFile.iVersion
        Move aRules   to TheFile.aRules
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson TheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sPath to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // Persist the rules at the current seed version. Mirrors WriteIgnored.
    Procedure WriteDeepScanRules tDeepScanRule[] aRules String sPath
        Send WriteDeepScanRulesAtVersion aRules sPath CI_DeepScanRulesVersion
    End_Procedure

    // Test-only: write a STALE (version 0) file so LoadDeepScanRules reseeds + merges toggles.
    Procedure WriteStaleDeepScanRules tDeepScanRule[] aRules String sPath
        Send WriteDeepScanRulesAtVersion aRules sPath 0
    End_Procedure

    /* A RULE WE SWITCHED ON AFTER SHIPPING IT OFF. Every saved file holds such a rule as False, and the
       toggle merge (LoadDeepScanRules) cannot tell that default from a user's choice - so a rule we turn
       on later would stay off for everyone who already had the file. Each entry names the rules version
       that switched the rule on: a file older than that holds the old default, and the seed's True
       stands; from that version on the user's toggle wins, as for any other rule. */
    Function _SeedSwitchedOnAfterFile Integer iDSNumber Integer iFileVersion Returns Boolean
        // DS 9246, (Self) in an object reference: on at v98 (Nils 2026-10-30, after the 2026-10-24 live run)
        If (iDSNumber = 9246 and iFileVersion < 98) ;
            Function_Return True
        Function_Return False
    End_Function

    // The rules every consumer scans/classifies with: the JSON when current; else the built-in
    // seed with the old file's bEnabled toggles merged across by iDSNumber, written back.
    Function LoadDeepScanRules String sPath Returns tDeepScanRule[]
        tDeepScanRulesFile TheFile
        tDeepScanRule[] aSeed
        Integer i j iSeed iOld

        Get _ReadDeepScanRulesFile sPath to TheFile
        If (TheFile.iVersion = CI_DeepScanRulesVersion and SizeOfArray(TheFile.aRules) > 0) ;
            Function_Return TheFile.aRules
        Get BuildDefaultDeepScanRules to aSeed
        /* Stale/absent file: carry the user's Enabled toggles into the fresh seed, then persist -
           EXCEPT onto a rule the seed itself ships DISABLED.

           Retiring a rule is done with bEnabled False in BuildDefaultDeepScanRules (never a delete -
           iDSNumber is an identity). But this merge used to copy the user's saved toggle over it
           unconditionally, and every existing user's file has the rule enabled from before it was
           retired - so a retirement could only ever reach a FRESH install. DS 9034 (FindErr) was
           retired on 2026-07-29 and came straight back on Nils's next run, still 425 rows.

           A seed-disabled rule is a decision by US about the rule itself, not a preference: it stays
           off. A seed-ENABLED rule still honours whatever the user toggled - unless we switched it on
           after the file was written (_SeedSwitchedOnAfterFile): the file's OFF is then the old default. */
        Move (SizeOfArray(aSeed) - 1)         to iSeed
        Move (SizeOfArray(TheFile.aRules) - 1) to iOld
        For i from 0 to iSeed
            If (aSeed[i].bEnabled = True and _SeedSwitchedOnAfterFile(Self, aSeed[i].iDSNumber, TheFile.iVersion) = False) Begin
                For j from 0 to iOld
                    If (TheFile.aRules[j].iDSNumber = aSeed[i].iDSNumber) ;
                        Move TheFile.aRules[j].bEnabled to aSeed[i].bEnabled
                Loop
            End
        Loop
        Send WriteDeepScanRules aSeed sPath
        Function_Return aSeed
    End_Function

    // Human label for a hit's triage category (the same wording the Analyzer grid uses).
    Function DSCategoryText Integer eCategory Returns String
        If (eCategory = eModAutoFix) ;
            Function_Return "Auto-fix"
        If (eCategory = eModSuggest) ;
            Function_Return "Review"
        Function_Return "Explain"
    End_Function

    // Does the CONDITION part of a command-syntax If / Else-If / While / Until line carry
    // sToken as a whole WORD? Word-level walk on purpose (Nils's false-positive harvest
    // 2026-07-11):
    //   - 'Daysched.In' is ONE word - a table.column whose column is named like an operator must
    //     never match (boundary matching saw the '.' as a boundary and hit the IN rule);
    //   - everything AFTER a find / constrained_find / constrain keyword belongs to THAT
    //     command's still-supported syntax, so the walk STOPS there:
    //     'If iSortorder eq 0 Constrained_Find ge Arbk by index.1' - the eq IS the legacy
    //     condition (flag it), the ge is a FIND MODE (leave it).
    // sLowCode is the lowercased code-only line; the walk starts at word 2 (word 1 is the
    // If/Else/While/Until the caller already checked).
    Function _DSConditionOpHit String sLowCode String sToken Returns Boolean
        String sWord
        Integer iWord

        Move 2 to iWord
        Repeat
            Get _NthWord of ghoFuncLib sLowCode iWord to sWord
            // STOP at the statement/db-command that ENDS the condition - everything after belongs to it, not
            // the boolean condition: a find MODE (find / constrained_find / constrain), OR a message SEND whose
            // args carry a relational mode, e.g. 'if lhDDO send request_read to lhDDO GT file# ord#' - GT is the
            // Request_Read find mode, not a comparison (Nils 2026-07-15; ChangeLegacyOperators leaves it too).
            If (sWord = "find" or sWord = "constrained_find" or sWord = "constrain" or sWord = "send") ;
                Function_Return False
            If (sWord = sToken) ;
                Function_Return True
            Increment iWord
        Until (sWord = "")
        Function_Return False
    End_Function

    // Does ONE rule match ONE code-only line? sW1/sW2/sW3 are the line's first three
    // whitespace-delimited words, pre-extracted and lowercased by the caller (one
    // extraction per line, not per rule). sCode is the _CodeOnlyLine output - string
    // literals are masked and comments cut, so neither can ever match.
    /* The legacy Replace COMMAND on this (code-only, string-masked) line: bounded 'replace'
       NOT followed by '(' - 'Replace(' / 'Replaces(' are the modern functions - preceded only
       by line start, ')' or ']' (a one-line 'If (...)' or '[ind]' prefix), with bounded 'in'
       and 'with' following in order. Mirrors ChangeReplaceCommandToFunction's own SHAPE gates, so
       the grid and the fix cannot drift apart. */
    Function _DSIsReplaceCommandLine String sCode Returns Boolean
        String sLow sCh
        Integer iPos iAfter iIn iWith iBefore

        Move (Lowercase(sCode)) to sLow
        Get _FindKeywordPos of ghoFuncLib sLow "replace" True 1 to iPos
        If (iPos = 0) ;
            Function_Return False
        // not the function form: next non-space char after the keyword must not be "("
        Move (iPos + 7) to iAfter
        While (iAfter <= Length(sLow) and Mid(sLow, 1, iAfter) = " ")
            Increment iAfter
        Loop
        If (iAfter <= Length(sLow) and Mid(sLow, 1, iAfter) = "(") ;
            Function_Return False
        // command position: only whitespace, a ")" or a "]" may precede it
        Move (iPos - 1) to iBefore
        While (iBefore >= 1 and Mid(sLow, 1, iBefore) = " ")
            Decrement iBefore
        Loop
        If (iBefore >= 1) Begin
            Move (Mid(sLow, 1, iBefore)) to sCh
            If (sCh <> ")" and sCh <> "]") ;
                Function_Return False
        End
        Get _FindKeywordPos of ghoFuncLib sLow "in" True iAfter to iIn
        If (iIn = 0) ;
            Function_Return False
        Get _FindKeywordPos of ghoFuncLib sLow "with" True (iIn + 2) to iWith
        Function_Return (iWith > iIn)
    End_Function

    /* THE CONVERTER'S OWN NOTE about the Type this accessor line names - "Type <name> left as
       written - <why>", whole, so the row names the Type (Nils 2026-10-06) - or "" when the line is
       not an accessor, its Type was not declined, or an EARLIER accessor of the same Type already
       owns the row. The notes are the run's own, read back rather than re-derived, so the row can
       never say something the run would not. */
    Function _Win32DeclineNoteForLine String[] ByRef asAllCode String[] ByRef asNotes Integer iLine Returns String
        String[] asWords asEarly
        String sType sBuf sTypeE sBufE sWant sLow
        Integer i iLast iPos
        Boolean bIsAcc bEarlier

        Get _SplitSourceWords of ghoFuncLib asAllCode[iLine] to asWords
        Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuf) to bIsAcc
        If (bIsAcc = False) ;
            Function_Return ""
        Move ("type " + Lowercase(Trim(sType)) + " left as written - ") to sWant
        Move (SizeOfArray(asNotes) - 1) to iLast
        Move -1 to iPos
        For i from 0 to iLast
            If (iPos = -1) Begin
                Move (Lowercase(asNotes[i])) to sLow
                If (Left(sLow, Length(sWant)) = sWant) ;
                    Move i to iPos
            End
        Loop
        If (iPos = -1) ;
            Function_Return ""
        // an earlier accessor of this Type owns the row
        For i from 0 to (iLine - 1)
            Get _SplitSourceWords of ghoFuncLib asAllCode[i] to asEarly
            Get _AccessorTypeBuffer of ghoFuncLib asEarly (&sTypeE) (&sBufE) to bEarlier
            If (bEarlier = True) Begin
                If (Lowercase(Trim(sTypeE)) = Lowercase(Trim(sType))) ;
                    Function_Return ""
            End
        Loop
        Function_Return (Trim(asNotes[iPos]))
    End_Function

    // The bracket-Indicate normalisation ScanLines applies (see the comment there): when the code after
    // the leading '[...]' group opens with the Indicate word - or Ind, its obsolete spelling - sCode / sLow /
    // sW1..3 become that code's; any other bracket-prefixed line is left exactly as it was. Locals in,
    // locals out - ByRef on purpose.
    Procedure _DSStripIndicateBracket String ByRef sCode String ByRef sLow String ByRef sW1 String ByRef sW2 String ByRef sW3
        String sRest sLowRest sB1
        Integer iClose

        Move (Pos("]", sCode)) to iClose
        If (iClose = 0) ;
            Procedure_Return
        Move (Trim(Mid(sCode, (Length(sCode) - iClose), (iClose + 1)))) to sRest
        Move (Lowercase(sRest)) to sLowRest
        Get _NthWord of ghoFuncLib sLowRest 1 to sB1
        If (sB1 <> "indicate" and sB1 <> "ind") ;
            Procedure_Return
        Move sRest    to sCode
        Move sLowRest to sLow
        Get _NthWord of ghoFuncLib sLowRest 1 to sW1
        Get _NthWord of ghoFuncLib sLowRest 2 to sW2
        Get _NthWord of ghoFuncLib sLowRest 3 to sW3
    End_Procedure

    // The Else step ScanLines takes before the bracket step (rules v90): sCode / sLow / sW1..3 become the
    // statement's after the Else word, so the bracket step and the rules read it as they would read it
    // standing alone - the way ChangeLegacyIndicators converts it (2026-10-06). Locals in, locals out -
    // ByRef on purpose, like _DSStripIndicateBracket.
    Procedure _DSStripLeadingElse String ByRef sCode String ByRef sLow String ByRef sW1 String ByRef sW2 String ByRef sW3
        String sRest

        Move (Trim(sCode)) to sRest
        Move (Trim(Mid(sRest, Length(sRest), 5))) to sRest      // the words after 'else'
        Move sRest to sCode
        Move (Lowercase(sRest)) to sLow
        Get _NthWord of ghoFuncLib sLow 1 to sW1
        Get _NthWord of ghoFuncLib sLow 2 to sW2
        Get _NthWord of ghoFuncLib sLow 3 to sW3
    End_Procedure

    Function _RuleMatchesLine tDeepScanRule Rule String sCode String sW1 String sW2 String sW3 ;
            String[] ByRef asAllCode String[] ByRef asApiCat ;
            tTypeBufferCluster[] ByRef aTypeClu Boolean ByRef bTypeCluDone ;
            String[] ByRef asWin32Conv Boolean ByRef bWin32ConvDone ;
            String[] ByRef asWin32Notes String ByRef sDeclineNote ;
            Integer iLine Returns Boolean
        String sTok1 sTok2 sCh sDecl sHead sNote sFixed sRaw sCont sWhyNot sTok3 sTok4
        String[] asWords
        Boolean bFileTest
        String sCatA sCatW
        String[] asAccW asEarlyW
        Boolean bGuarded bStillThere
        Integer iAt iLast iConv
        Boolean bIsKeyword bOwnPair bEarlier bOwnsRow
        Integer iErrNum iErrPos iErrLen
        String sErrName
        Boolean bErrKnown
        Integer iDSPos iDSLen iDSUse
        String sDSWord

        Move "" to sDeclineNote

        /* THE IMAGE NAME LINE (DS 9233). sCode is the RAW name line here, never the code-only text -
           _SweepImageNameRules is the only caller that hands this kind a line. The converter reads
           the line through the same helper, so a hit is exactly a line RemoveResidentImageOption
           changes. */
        If (Rule.eDSKind = eDSImageOption) Begin
            Get _ImageNameOptionPos of ghoFuncLib sCode Rule.sToken to iAt
            Function_Return (iAt > 0)
        End

        /* AN ERROR COMMAND WITH A LITERAL NUMBER (DS 9244 / 9245 / 9252). One decision for the scan and the fix
           (_ErrorCommandNumber); then the target version's errornum.inc decides: DS 9244 takes the numbers
           DataFlex names. Of the others _MadeUpErrorWhyNot decides, DS 9252 taking the ones its converter
           changes and DS 9245 the rest. Names not known at all (no install, no cache) is no row from any -
           "not known" must never read as "not named". */
        If (Rule.eDSKind = eDSErrorNumber) Begin
            Get _ErrorCommandNumber of ghoFuncLib sCode (&iErrPos) (&iErrLen) to iErrNum
            If (iErrNum <= 0) ;
                Function_Return False
            Get ErrorNamesKnown of ghoFuncLib to bErrKnown
            If (bErrKnown = False) ;
                Function_Return False
            Get ErrorNameForNumber of ghoFuncLib iErrNum to sErrName
            If (Trim(Rule.sRefactorFn) = "ChangeErrorNumberToName") ;
                Function_Return (sErrName <> "")
            If (sErrName <> "") ;
                Function_Return False
            Get _MadeUpErrorWhyNot of ghoFuncLib asAllCode[iLine] to sWhyNot
            If (Trim(Rule.sRefactorFn) <> "") ;
                Function_Return (sWhyNot = "")
            Function_Return (sWhyNot <> "")
        End

        /* THE OBSOLETE 'for' TARGETS AND CLASS NAMES, AND Field_Main_Index (DS 9247-9251). Each asks the
           decision function its converter asks, so a row is exactly a line the fix changes. */
        If (Rule.eDSKind = eDSObsoleteMethodTarget) Begin
            Get _ObsoleteMethodTarget of ghoFuncLib sCode (&iDSPos) (&iDSLen) to sDSWord
            If (sDSWord = "") ;
                Function_Return False
            If (Rule.sToken = "dfdesktop") ;
                Function_Return (sDSWord = "dfdesktop")
            Function_Return (sDSWord <> "dfdesktop")
        End
        If (Rule.eDSKind = eDSObsoleteClassName) Begin
            Get _ObsoleteClassNameAt of ghoFuncLib sCode 1 (&iDSPos) (&iDSLen) to sDSWord
            Function_Return (sDSWord <> "")
        End
        If (Rule.eDSKind = eDSFieldMainIndex) Begin
            Get _FieldMainIndexUse of ghoFuncLib sCode (&iDSPos) to iDSUse
            If (Trim(Rule.sRefactorFn) <> "") ;
                Function_Return (iDSUse = 1)
            Function_Return (iDSUse = 2)
        End
        // A READ OF THE RETIRED ghoWorkspace GLOBAL (DS 9253 / 9254): the converter's own decision again.
        If (Rule.eDSKind = eDSLegacyWorkspaceRead) Begin
            Get _LegacyWorkspaceRead of ghoFuncLib sCode (&sDSWord) (&sTok1) to iDSUse
            If (Trim(Rule.sRefactorFn) <> "") ;
                Function_Return (iDSUse = 1)
            Function_Return (iDSUse = 2)
        End

        /* THE ONE KIND THAT READS PAST ITS OWN LINE. The types of an External_Function usually sit
           on ";"-continued lines, so judging the first line alone would miss most declarations -
           and flagging one merely because the API is catalogued would flag the correct ones too.
           Join the block, then ask the CONVERTER'S own decision function: a hit here is exactly a
           line ConvertWinAPIDeclarationTypes would change, so the grid and the fix cannot drift
           apart. Everything it refuses - uncatalogued, count mismatch, already correct, needs both
           bitness arms - answers "" and is silently not a hit, which is the right reading: there is
           nothing here for this converter to do. */
        /* THE ANSI-WITH-WIDE-TWIN RULE (DS 9221). An "...A" entry point still binds the ANSI API;
           since the harvest the catalogue almost always holds the W twin, and
           GuardAnsiExternalFunctionWithWide builds the guarded pair from it. Wired here because
           the converter existed for two weeks with NO recipe and no rule - reachable only from
           the manual picker, which is how an agreed feature stays invisible (Nils, 2026-08-28:
           "did we not agree...?" - we had, and nothing offered it).

           Skips: a non-A entry; an A entry with no W twin catalogued (nothing to build from);
           and a declaration already inside IS$WIN64 or directly under a #IF - both mean someone
           already manages it, ours or the user's. */
        If (Rule.eDSKind = eDSAnsiApiWide) Begin
            If (iLine < 0 or iLine > (SizeOfArray(asAllCode) - 1)) ;
                Function_Return False
            Move asAllCode[iLine] to sRaw
            Get _ExternalFnHeadPacked of ghoFuncLib sRaw to sHead
            If (sHead = "") ;
                Function_Return False
            /* One check subsumes both former ones (2026-08-29): _InsideConditionalArm covers
               IS$WIN64 regions AND every other #IF/#IFDEF variant arm (cFilesystem's
               #IF (!@ < 200) batch gates), including the converter's own emitted pair - the A
               arm sits inside the #IF it wrote. #IFNDEF declare-once guards stay flaggable. */
            /* ...and OUR OWN emitted pair is finished work, not a finding. State 2 keeps the
               bannered gate enterable for the RETYPER (see _InsideConditionalArmEx), which is
               right for that converter and wrong for this rule: without this the rule re-raised
               its own output on every scan, leaving a Run button that could only refuse on the
               very declarations where the pairing had already worked (Nils 2026-08-31).
               Asked here, not inside _InsideConditionalArm, so the retyper is unaffected. */
            Get _InsideConditionalArmEx of ghoFuncLib (&asAllCode) iLine (&bOwnPair) to bGuarded
            If (bGuarded = True or bOwnPair = True) ;
                Function_Return False
            // head = NAME|dll|entry ; the entry must end in "a" and the W twin must exist
            Move (Pos("|", sHead)) to iAt
            Move (Right(sHead, (Length(sHead) - iAt))) to sDecl
            Move (Pos("|", sDecl)) to iAt
            Move (Left(sDecl, (iAt - 1))) to sTok1
            Move (Right(sDecl, (Length(sDecl) - iAt))) to sTok2
            If (Right(sTok2, 1) <> "a") ;
                Function_Return False
            If (SizeOfArray(asApiCat) = 0) Begin
                Send RefreshWinAPICatalogsFromJson of ghoFuncLib
                Get pasWinAPICatalog of ghoFuncLib to asApiCat
            End
            Get _WinAPIPrototypeFromCat of ghoFuncLib (&asApiCat) sTok1 (Left(sTok2, (Length(sTok2) - 1)) + "w") to sNote
            If (sNote = "") ;
                Function_Return False
            /* ...AND THE CONVERTER MUST ACTUALLY BE ABLE TO PAIR IT (Nils 2026-08-31: "we can
               can't have that Run the refactoring plan button sit there for ever. There is simply
               no point of having it if it cannot do anything"). A catalogued W twin is necessary
               and not sufficient: GuardAnsiExternalFunctionWithWide refuses a binding whose local
               parameters declare Pointer where the twin marshals text (the AddressOf convention),
               and one whose parameter list does not line up with the twin at all. Those were still
               raised here, so the board offered a Run button over a declaration the run could only
               decline - the shape this rule exists to find, minus the fix.
               Read past the line exactly as the eDSApiDeclTypes rule above does, then ask the
               CONVERTER'S OWN reason function, so the grid and the fix cannot drift. */
            Get _LineWithoutEndComment of ghoFuncLib sRaw to sDecl
            Move (Trim(sDecl)) to sDecl
            Move iLine to iAt
            Move (SizeOfArray(asAllCode) - 1) to iLast
            While (Right(sDecl, 1) = ";" and iAt < iLast)
                Move (Trim(Left(sDecl, (Length(sDecl) - 1)))) to sDecl
                Increment iAt
                Get _LineWithoutEndComment of ghoFuncLib asAllCode[iAt] to sCont
                Move (sDecl + " " + Trim(sCont)) to sDecl
            Loop
            Get _WinAPIDataFlexDeclFromCat of ghoFuncLib (&asApiCat) sTok1 (Left(sTok2, (Length(sTok2) - 1)) + "w") to sFixed
            /* The RAW rows for the struct-split check, ByRef off the array this scan already
               holds - NOT through WinAPIPrototype, which copies the whole 18,000-row catalogue
               per call and would pay that on every declaration line in the workspace. */
            Get _WinAPIPrototypeFromCat of ghoFuncLib (&asApiCat) sTok1 sTok2 to sCatA
            Get _WinAPIPrototypeFromCat of ghoFuncLib (&asApiCat) sTok1 (Left(sTok2, (Length(sTok2) - 1)) + "w") to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sDecl sFixed sCatA sCatW to sWhyNot
            Function_Return (sWhyNot = "")
        End
        /* DS 9224 - the legacy Type buffer that has a shipped Struct. Reads past its own line for
           the same reason the two kinds around it do, and then asks the CONVERTER'S OWN predicate:
           a hit here is exactly a cluster ChangeLegacyTypeToWinStruct would rewrite, so the board
           cannot offer a Run button the run then refuses - the shape that cost three rounds on
           2026-08-31 alone.
           The clusters are graded ONCE PER FILE and carried ByRef: the grading walks the whole
           file, so a file with a dozen ZeroType lines would otherwise pay a dozen whole-file walks.
           bAddressIsOk True - for these verified pairs the taken address IS the point. */
        If (Rule.eDSKind = eDSTypeToWinStruct) Begin
            If (iLine < 0 or iLine > (SizeOfArray(asAllCode) - 1)) ;
                Function_Return False
            Get _SplitSourceWords of ghoFuncLib asAllCode[iLine] to asAccW
            Get _AccessorTypeBuffer of ghoFuncLib asAccW (&sTok1) (&sTok2) to bIsKeyword
            If (bIsKeyword = False) ;
                Function_Return False
            Get _WinStructTwinName of ghoFuncLib sTok1 to sNote
            If (sNote = "") ;
                Function_Return False
            If (bTypeCluDone = False) Begin
                Get _TypeClustersFromLinesEx of ghoFuncLib asAllCode "" True to aTypeClu
                Move True to bTypeCluDone
            End
            Move (SizeOfArray(aTypeClu) - 1) to iLast
            For iAt from 0 to iLast
                If (Lowercase(aTypeClu[iAt].sBuffer) = Lowercase(sTok2)) Begin
                    If (Lowercase(aTypeClu[iAt].sTypeName) = Lowercase(sTok1)) Begin
                        If (SearchArray((iLine + 1), aTypeClu[iAt].aiAccLines) <> -1) Begin
                            Get _WinStructClusterWhyNot of ghoFuncLib aTypeClu[iAt] (&asAllCode) to sNote
                            Function_Return (sNote = "")
                        End
                    End
                End
            Loop
            Function_Return False
        End
        /* DS 9225 - the legacy Win32 Type buffer ChangeExternalFunctionCallers actually converts.

           THE RULE ASKS THE RUN ITSELF, which is as close as this app has come to making a row and
           its Run one decision rather than two. There is no WhyNot predicate to borrow here the way
           DS 9224 borrows _WinStructClusterWhyNot - the converter's refusals are spread through
           _ConvertWin32TypeBuffersInLines, and copying them out would be exactly the second opinion
           that drifts. So the scan runs the converter on a COPY of the file, once, and reads the
           answer off the result.

           THE PER-LINE SIGNAL IS THAT THE LINE IS GONE. Every cluster the converter takes has its
           ZeroType rewritten into "Move <x>Empty to <buf>", so a ZeroType line that still appears
           verbatim in the converted copy is one the run declined - a Type with no catalogue entry,
           a buffer used in a way it does not rewrite, a member that would not resolve. Reporting
           only the lines that VANISH means the board can never offer a Run that comes back "0
           lines" (DS 9221, 2026-08-31).

           Two identical ZeroType lines where only one cluster converts leave the text present, so
           NEITHER is flagged. That is the safe direction: under-report rather than promise a fix
           for the cluster that was refused.

           ONE ROW PER CLUSTER - which used to come free, and no longer does. Keying the pre-gate
           on ZeroType alone gave a cluster exactly one candidate line, but it also made the rule
           blind to any buffer that has no ZeroType at all: zeroed by hand with
           "Move (Repeat(Character(0), <Type>_SIZE)) to buf" and reached through Put, the file was
           never examined and the only row it could raise was the report-only one, whose sole
           affordance is Ignore (vsWin32ids.pkg; Nils asked why the Put sounded no alarm,
           2026-09-01).

           So the gate now admits Put/GetBuff/FillType too, and the one-row-per-cluster property
           has to be kept HERE instead. Every accessor line in a converted cluster vanishes, so
           each would otherwise raise its own row for a single fix - the row multiplication this
           board keeps having to unlearn. Keep the FIRST accessor line naming a given buffer and
           decline the rest; where a cluster has a ZeroType that is still its ZeroType, so nothing
           changes for the files that already worked.

           The earlier line needs no vanish-test of its own: a Type converts all-or-nothing, so if
           THIS line vanished, every accessor on the same buffer did. */
        If (Rule.eDSKind = eDSWin32BufferConvertible) Begin
            If (iLine < 0 or iLine > (SizeOfArray(asAllCode) - 1)) ;
                Function_Return False
            If (bWin32ConvDone = False) Begin
                Move True to bWin32ConvDone
                Move asAllCode to asWin32Conv
                Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asWin32Conv) (&asWin32Notes) to iConv
                // Nothing converted: empty the copy so the test below is one SizeOfArray, not a
                // whole-file scan per ZeroType line in a file that was never going to convert.
                If (iConv = 0) ;
                    Move (ResizeArray(asWin32Conv, 0)) to asWin32Conv
            End
            Move (Trim(asAllCode[iLine])) to sNote
            If (sNote = "") ;
                Function_Return False
            // An emptied copy means nothing in the file converted, so every line is still there.
            Move (SizeOfArray(asWin32Conv) = 0) to bStillThere
            Move (SizeOfArray(asWin32Conv) - 1) to iLast
            For iAt from 0 to iLast
                If (bStillThere = False and Trim(asWin32Conv[iAt]) = sNote) ;
                    Move True to bStillThere
            Loop
            /* A TYPE THE RUN DECLINED GETS ONE EXPLAIN ROW, CARRYING THE RUN'S OWN REASON (Nils
               2026-09-13, asking how a file whose Type the converter would not take could be
               offered anything but Ignore). The line did not vanish, so this is not a fix - but
               the converter wrote down WHY, and that note is the most useful thing the board can
               say here: "line 63 hands the buffer to the API directly" tells the reader what to
               change; "run the report first" does not. One row per Type, on the first accessor
               that names it - the ownership rule the converted case below already uses - and
               ScanLines turns a non-blank sDeclineNote into Explain with the note as the hint. */
            If (bStillThere = True) Begin
                Get _Win32DeclineNoteForLine (&asAllCode) (&asWin32Notes) iLine to sDeclineNote
                Function_Return (sDeclineNote <> "")
            End
            // The line was converted. Does it OWN the cluster's row, or did an earlier accessor
            // on the same buffer already claim it? See the note above.
            Get _SplitSourceWords of ghoFuncLib asAllCode[iLine] to asAccW
            Get _AccessorTypeBuffer of ghoFuncLib asAccW (&sTok1) (&sTok2) to bIsKeyword
            /* The first line of a command a ";" carries on names no buffer, so it reads as "not an
               accessor" - and it belongs to the cluster whose row an earlier line owns (2026-11-04). */
            If (bIsKeyword = False) Begin
                Get _LineWithoutEndComment of ghoFuncLib asAllCode[iLine] to sNote
                Function_Return (Right(Trim(sNote), 1) <> ";")
            End
            Move True to bOwnsRow
            For iAt from 0 to (iLine - 1)
                If (bOwnsRow = True) Begin
                    Get _SplitSourceWords of ghoFuncLib asAllCode[iAt] to asEarlyW
                    Get _AccessorTypeBuffer of ghoFuncLib asEarlyW (&sTok3) (&sTok4) to bEarlier
                    If (bEarlier = True) Begin
                        If (Lowercase(Trim(sTok4)) = Lowercase(Trim(sTok2))) ;
                            Move False to bOwnsRow
                    End
                End
            Loop
            Function_Return bOwnsRow
        End
        If (Rule.eDSKind = eDSApiDeclTypes) Begin
            /* THE RAW LINE, NOT sCode. Every other kind reads the code-only text, where string
               literals are masked to spaces - and an External_Function's entry point IS a quoted
               literal, so there it arrives as a bare pair of quotes and the dll token reads as ".
               _ExternalFnHeadPacked's own header warns about exactly this with the lexer's
               splitter; the masking pass does it too. asAllCode is the untouched source, which is
               also what the converter walks, so rule and fix see the same text. */
            If (iLine < 0 or iLine > (SizeOfArray(asAllCode) - 1)) ;
                Function_Return False
            Move asAllCode[iLine] to sRaw
            Get _ExternalFnHeadPacked of ghoFuncLib sRaw to sHead
            If (sHead = "") ;
                Function_Return False
            // A declaration inside an IS$WIN64 region is already bitness-managed - ours from an
            // earlier guarded-pair emission, or the user's own - and flagging its #ELSE arm would
            // report the very thing the pair exists to preserve.
            // Any conditional variant arm means author-managed - the same rule the converter
            // itself applies, so the grid and the fix cannot drift apart (2026-08-29).
            Get _InsideConditionalArm of ghoFuncLib (&asAllCode) iLine to bGuarded
            If (bGuarded = True) ;
                Function_Return False
            // Join COMMENT-STRIPPED, string literals intact - a mid-declaration line ending in
            // a comment does not end in ";", and absorbed prose was counted as parameters.
            Get _LineWithoutEndComment of ghoFuncLib sRaw to sDecl
            Move (Trim(sDecl)) to sDecl
            Move iLine to iAt
            Move (SizeOfArray(asAllCode) - 1) to iLast
            While (Right(sDecl, 1) = ";" and iAt < iLast)
                Move (Trim(Left(sDecl, (Length(sDecl) - 1)))) to sDecl
                Increment iAt
                Get _LineWithoutEndComment of ghoFuncLib asAllCode[iAt] to sCont
                Move (sDecl + " " + Trim(sCont)) to sDecl
            Loop
            Move "" to sNote
            /* The catalogue rides ByRef from ScanLines and is filled LAZILY here - once per file,
               and only for files that declare anything. At 1,294 rows a property Get per
               declaration was an array copy per declaration, ~250MB of string copying across the
               WinServ scan (2026-08-28); a file with no External_Function now pays nothing. */
            If (SizeOfArray(asApiCat) = 0) Begin
                Send RefreshWinAPICatalogsFromJson of ghoFuncLib
                Get pasWinAPICatalog of ghoFuncLib to asApiCat
            End
            Get _CorrectedApiDecl of ghoFuncLib sRaw sDecl sHead (&asApiCat) (&sNote) to sFixed
            Function_Return (sFixed <> "")
        End

        /* AN UNPAIRED 'CompilerWarnings Off' (DS 9226). Reads past its own line - the directive is a
           finding only because of what does not follow it. A later 'On' closes the region and there is
           nothing to report; 'Suspend' does not close anything (it has no counterpart at all) and a
           second 'Off' is not a nesting level, because Off is a plain switch rather than a stack.
           asAllCode arrives COMMENT-STRIPPED from this kind's one call site, so an 'On' written inside a
           block comment cannot close the region - the false negative here is the dangerous direction. */
        If (Rule.eDSKind = eDSUnpairedWarningsOff) Begin
            If (sW2 <> "off") ;
                Function_Return False
            Move (SizeOfArray(asAllCode) - 1) to iLast
            For iAt from (iLine + 1) to iLast
                Get _NthWord of ghoFuncLib (Lowercase(asAllCode[iAt])) 1 to sTok1
                If (sTok1 = "compilerwarnings") Begin
                    Get _NthWord of ghoFuncLib (Lowercase(asAllCode[iAt])) 2 to sTok2
                    If (sTok2 = "on") ;
                        Function_Return False
                End
            Loop
            Function_Return True
        End
        If (Rule.eDSKind = eDSCommandPos) Begin
            Get _NthWord of ghoFuncLib Rule.sToken 1 to sTok1
            Get _NthWord of ghoFuncLib Rule.sToken 2 to sTok2
            If (sTok2 = "") Begin
                If (sW1 <> sTok1) ;
                    Function_Return False
                // 'Trim' is BOTH a legacy command ('Trim <src> to <dst>', which ChangeTrimCommandToFunction
                // rewrites) AND a modern function ('Trim(x)' / 'Trim (x)'). Only the COMMAND form - marked by
                // a whole-word 'to' on the line - is fixable; a Trim(...) call in an expression, especially on
                // a ';'-continuation line where the '(' opened on the line ABOVE (LegacyApp2 Avbrott.src
                // '... + Trim (Comp.Namn) + ...'), has no 'to' and would be an UNFIXABLE Deep Scan hit (the
                // converter correctly no-ops on it). Mirror the converter's guard so the grid == the fix.
                If (sTok1 = "trim" and _FindKeywordPos(ghoFuncLib, sCode, CS_To, True, 1) = 0) ;
                    Function_Return False
                Function_Return True
            End
            Function_Return (sW1 = sTok1 and sW2 = sTok2)
        End
        If (Rule.eDSKind = eDSAnywhere) ;
            Function_Return (_FindKeywordPos(ghoFuncLib, sCode, Rule.sToken, True, 1) > 0)
        // VENDOR-NAMESPACE PREFIX: bounded at the token's START, open at its end - so "xtpreport"
        // matches xtpReportThemeVisualStudio2012Light, which the whole-word kind above cannot see.
        If (Rule.eDSKind = eDSTokenPrefix) ;
            Function_Return (_FindKeywordPos(ghoFuncLib, sCode, Rule.sToken, False, 1) > 0)
        If (Rule.eDSKind = eDSConditionLine) Begin
            // Only a CONDITION line qualifies: If/While/Until, or an Else that continues with
            // If - a bare 'else <command>' (else Find gt ..., else Constrain ... eq ...) is that
            // command's own still-supported syntax, never the legacy comparison (Nils's
            // false-positive harvest 2026-07-11).
            If (sW1 <> "if" and sW1 <> "while" and sW1 <> "until") Begin
                // ...or an 'Indicate <x> as <condition>': its 'as' side is a condition, and the operator
                // converter rewrites it there - with or without a '[bracket]' in front, which ScanLines
                // has already stepped over for this shape (2026-09-17).
                If ((sW1 <> "else" or sW2 <> "if") and (sW1 <> "indicate" or sW3 <> "as")) ;
                    Function_Return False
            End
            /* The 'in' comparison rule must not claim the Replace COMMAND's own 'in' keyword:
               'if (cond) replace "," in sQty with "."' is the legacy Replace command guarded by
               a one-line If, and routing it at ChangeInToContains parked six auto-fixable lines
               in "needs hand migration" (2026-08-29). The Replace-command rule owns that line. */
            If (Rule.sToken = "in" and _DSIsReplaceCommandLine(Self, sCode)) ;
                Function_Return False
            Function_Return (_DSConditionOpHit(Self, Lowercase(sCode), Rule.sToken))
        End
        If (Rule.eDSKind = eDSReplaceCommand) ;
            Function_Return (_DSIsReplaceCommandLine(Self, sCode))
        If (Rule.eDSKind = eDSIfNot) Begin
            // 'If Not <operand>' / 'Else If Not <operand>' - the word AFTER Not being a
            // parenthesized token ('If Not (Found)') is still the legacy two-word form;
            // the MODERN form has the Not inside the parens ('If (Not(Found))'), where
            // word 2 starts with '(' and never equals the bare word 'not'.
            /* ...UNLESS the operand is a legacy file-test COMMAND: 'If Not Status <file> stmt'.
               Status takes a file argument and is not a Boolean, so the converter declines the
               line (2026-09-19) - and the line needs nothing: both this form and the one-word
               IFNOT form compile clean on DataFlex 26 (measured 2026-09-20 with a probe program,
               and the workspace listing drew no error on the line). A row that says "fix it by
               hand" for a line that needs no fix is noise (Nils), so the rule does not fire. The
               operand is word 3 of 'If Not X', word 4 of 'Else If Not X'. */
            If (sW1 = "if" and sW2 = "not") Begin
                Get _IsLegacyFileTestCommand of ghoFuncLib (Lowercase(sW3)) to bFileTest
                Function_Return (bFileTest = False)
            End
            If (sW1 = "else" and sW2 = "if" and sW3 = "not") Begin
                Get _SplitSourceWords of ghoFuncLib sCode to asWords
                If (SizeOfArray(asWords) >= 4) Begin
                    Get _IsLegacyFileTestCommand of ghoFuncLib (Lowercase(asWords[3])) to bFileTest
                    Function_Return (bFileTest = False)
                End
                Function_Return True
            End
            Function_Return False
        End
        If (Rule.eDSKind = eDSOnDispatch) Begin
            // 'On <expr> Gosub/Goto label ...' - but NOT 'On Error ...', which has its
            // own catalog rule with its own hint.
            If (sW1 <> "on" or sW2 = "error") ;
                Function_Return False
            If (_FindKeywordPos(ghoFuncLib, sCode, "gosub", True, 1) > 0) ;
                Function_Return True
            Function_Return (_FindKeywordPos(ghoFuncLib, sCode, "goto", True, 1) > 0)
        End
        /* '#REPLACE <name> <value>' - but ONLY where <name> is not a DataFlex keyword.

           The rule this replaces matched EVERY #REPLACE line and led with "-> 'Define name for
           value'". That advice is wrong for a keyword substitution: '#REPLACE End_Procedure
           End_Procedure_Profiler' (Nils 2026-07-28) redefines a LANGUAGE KEYWORD, and Define makes a
           named constant - it cannot do that. Replacing a keyword is definitionally a macro and
           never a constant, so _IsKeyWord decides it exactly rather than by heuristic.

           A #REPLACE with no second word is malformed or a continuation; it names nothing we can
           reason about, so it is not flagged. */
        If (Rule.eDSKind = eDSReplaceConst) Begin
            If (sW1 <> "#replace") ;
                Function_Return False
            If (sW2 = "") ;
                Function_Return False
            Get _IsReservedWord of ghoFuncLib sW2 to bIsKeyword
            If (bIsKeyword = True) ;
                Function_Return False
            /* AND NOT THE LEGACY SHELL'S WORKSPACE-NAME MACRO (Nils 2026-07-30, on a DF18 workspace
               where 174 .src files carry it). '#REPLACE CURRENT$WORKSPACE "MyApp"' passes every test
               above - the name is no keyword and the value is a quoted literal - so 9059 called it a
               Define candidate. It is not one. The token's only consumer is 'Set WorkspaceName to
               CURRENT$WORKSPACE' inside 'Object x is a Workspace', and RefactorWorkspaceTocApplication
               COMMENTS THE #REPLACE OUT as part of converting that shell. Rewriting it as a Define
               would preserve a constant feeding an object that is about to stop existing - work that
               the real fix then has to undo.

               The file is not left unflagged: the Workspace-shell rule appended to the seed below
               carries it, on the declaration line the converter actually acts on. One finding per
               file, naming the function that fixes it. */
            If (sW2 = "current$workspace") ;
                Function_Return False
            /* AND THE VALUE MUST LOOK LIKE A CONSTANT. Checking only the NAME was not enough - Nils
               found '#Replace SELECT |!C' still flagged (MeterFunctions.pkg), where SELECT is not in
               any keyword list but the VALUE is a macro token. A constant is a number or a quoted
               string; anything else - an identifier, a directive fragment, '|!C' - is substitution
               machinery that Define cannot express. Cheap first-character test, deliberately: it
               takes the tail of a genuine constant ("500", "RDC Tools") and rejects everything that
               opens with a letter, a pipe, a bang or a hash. */
            Move (Left(sW3, 1)) to sCh
            If (sCh = "") ;
                Function_Return False
            If (sCh >= "0" and sCh <= "9") ;
                Function_Return True
            /* A NEGATIVE constant is a constant too (v56, 2026-09-08): measured convertible, and
               there are 25 of them in the DataFlex install alone. A PARENTHESISED value is NOT
               added, although it looks like one - a Define resolves its value at its own line while
               the directive stays lazy text, so '(A ior B)' is error 4328 wherever A and B come
               later. The grid must offer exactly what the converter takes. */
            If (sCh = "-" and Length(sW3) > 1) Begin
                Move (Mid(sW3, 1, 2)) to sCh
                Function_Return (sCh >= "0" and sCh <= "9")
            End
            Function_Return (sCh = '"' or sCh = "'")
        End
        If (Rule.eDSKind = eDSUseNoExt) Begin
            // 'Use <name>' whose filename lacks an extension (the compiler's 4535). MIRRORS
            // AddUseFileExtension's guards exactly (a hit only where the converter acts, the
            // grid/plan parity rule): a bare unquoted name with no '.' - quoted paths (their
            // literals arrive MASKED here, so the quote is the tell) and dotted names never flag.
            If (sW1 <> "use" or sW2 = "") ;
                Function_Return False
            If (Left(sW2, 1) = '"' or Left(sW2, 1) = "'") ;
                Function_Return False
            // ...nor 'Use UI', the character-mode base the converter leaves as it is (2026-09-23).
            If (Lowercase(sW2) = "ui") ;
                Function_Return False
            Function_Return (not(sW2 contains "."))
        End
        If (Rule.eDSKind = eDSUseContains) Begin
            // 'Use <name>' where the FILENAME contains the token - the package family form. Substring,
            // not whole-word, because that is the point: cCrystal.pkg, rcCrystalReport.pkg and
            // crystalrep2.pkg are one dependency under three names. Quoted paths are skipped for the
            // same reason eDSUseNoExt skips them - a literal arrives MASKED here, so its own text
            // cannot be trusted, and the quote is the tell.
            If (sW1 <> "use" or sW2 = "") ;
                Function_Return False
            If (Left(sW2, 1) = '"' or Left(sW2, 1) = "'") ;
                Function_Return False
            Function_Return (Lowercase(sW2) contains Rule.sToken)
        End
        If (Rule.eDSKind = eDSSubclassObject) Begin
            // 'Object <name> is a <Class>', <Class> a subclass of the rule's family that
            // ConvertGridSubclassToCodeJock converts in place (JudgeGridSubclasses said so).
            If (sW1 <> "object" or sW3 <> "is") ;
                Function_Return False
            Get _NthWord of ghoFuncLib (Lowercase(sCode)) 4 to sTok1
            If (sTok1 <> "a" and sTok1 <> "an") ;
                Function_Return False
            Get _NthWord of ghoFuncLib (Lowercase(sCode)) 5 to sTok2
            If (IsLearnedSubclass(Self, sTok2, Rule.sToken) = False) ;
                Function_Return False
            Function_Return (_ConvertsInPlace(Self, sTok2))
        End
        If (Rule.eDSKind = eDSClassDecl or Rule.eDSKind = eDSClassSubclass) Begin
            // 'Object <name> is a <Class>' (eDSClassDecl) vs 'Class <name> is a <Class>'
            // (eDSClassSubclass) - the compiler's 4537 family, source-side. The declaration
            // anchor is what makes even common-word class names (List, Grid, Edit) unambiguous -
            // the token is only checked at word 5 of the canonical shape, so a variable or a
            // mention anywhere else never flags. The TWO kinds exist because the converters can
            // transform OBJECT declarations but (deliberately) never a SUBCLASS definition -
            // Nils's LegacyApp3 residue 2026-07-11: the scan promised Auto-fix on 'Class
            // cDynamicDbList is a dbList' rows the plan run then could not touch.
            If (Rule.eDSKind = eDSClassDecl) Begin
                If (sW1 <> "object") ;
                    Function_Return False
            End
            Else Begin
                If (sW1 <> "class") ;
                    Function_Return False
            End
            If (sW3 <> "is") ;
                Function_Return False
            Get _NthWord of ghoFuncLib (Lowercase(sCode)) 4 to sTok1
            If (sTok1 <> "a" and sTok1 <> "an") ;
                Function_Return False
            Get _NthWord of ghoFuncLib (Lowercase(sCode)) 5 to sTok2
            If (sTok2 = Rule.sToken) ;
                Function_Return True
            // ...or the workspace's own subclass of it (LegacyApp's MyDbGrid, 2026-09-04) - see the
            // memo on the constructor. Nothing learned = exactly the literal match of before.
            If (IsLearnedSubclass(Self, sTok2, Rule.sToken) = False) ;
                Function_Return False
            // ...unless the subclass converter takes that subclass: its object is then listed under that
            // converter's own rule (eDSSubclassObject, 2026-10-04), once, and not here as well.
            If (Rule.eDSKind = eDSClassDecl) ;
                Function_Return (not(_ConvertsInPlace(Self, sTok2)))
            Function_Return True
        End
        Function_Return False
    End_Function

    // The per-line rule sweep, split out of ScanLines (Nils 2026-07-15) so the macro-message + warning-suspend
    // guards there read cleanly. sCode = the _CodeOnlyLine text, sLow = its lowercase, sW1/sW2/sW3 = its first
    // three words; iLine is 0-based (the hit records iLine+1). Appends every rule hit to aHits. A pure move-out
    // of the former inline loop - same cheap per-kind pre-gate, then the boundary-aware _RuleMatchesLine authority
    // on the survivors. aRules / asTok1 / aHits are ByRef (this runs once per code line - a by-value array param
    // would deep-copy the whole catalog every call).
    /* aTypeClu / bTypeCluDone ride through from ScanLines for the same reason asApiCat does:
       DS 9224's grading walks the WHOLE file, so it is done once per file and carried, not
       recomputed per candidate line. */
    Procedure _SweepRules String sCode String sLow String sW1 String sW2 String sW3 Integer iLine String[] ByRef asAllCode String[] ByRef asApiCat tTypeBufferCluster[] ByRef aTypeClu Boolean ByRef bTypeCluDone String[] ByRef asWin32Conv Boolean ByRef bWin32ConvDone String[] ByRef asWin32Notes tDeepScanRule[] ByRef aRules String[] ByRef asTok1 tDeepScanHit[] ByRef aHits Boolean bMacroBody
        tDeepScanHit Hit
        String[] asMacroSafe
        Integer iRule iRules eKind
        Boolean bPlausible bMatch bKeepFn
        String  sNote sDeclineNote sNewName
        Integer iErrNum iErrPos iErrLen

        If (bMacroBody = True) ;
            Move (StrSplitToArray(CS_DSMacroSafeTokens, "|")) to asMacroSafe
        Move (SizeOfArray(aRules) - 1) to iRules
        For iRule from 0 to iRules
            If (aRules[iRule].bEnabled = True and (bMacroBody = False or SearchArray(aRules[iRule].sToken, asMacroSafe) <> -1)) Begin
                // Cheap NECESSARY-condition gate per detection kind; only survivors
                // pay for the boundary-aware verification below.
                Move aRules[iRule].eDSKind to eKind
                Move False to bPlausible
                If (eKind = eDSCommandPos) ;
                    Move (sW1 = asTok1[iRule]) to bPlausible
                If (eKind = eDSAnywhere) ;
                    Move (Pos(aRules[iRule].sToken, sLow) > 0) to bPlausible
                // Same cheap substring gate as eDSAnywhere - the difference (the token may be the
                // START of a longer name) is settled by _RuleMatchesLine, not here.
                If (eKind = eDSTokenPrefix) ;
                    Move (Pos(aRules[iRule].sToken, sLow) > 0) to bPlausible
                If (eKind = eDSConditionLine) Begin
                    // ...and an 'Indicate <x> as <condition>' - its 'as' side IS a condition (2026-09-17).
                    If (sW1 = "if" or sW1 = "while" or sW1 = "until" or (sW1 = "else" and sW2 = "if") or (sW1 = "indicate" and sW3 = "as")) ;
                        Move (Pos(aRules[iRule].sToken, sLow) > 0) to bPlausible
                End
                If (eKind = eDSIfNot) ;
                    Move ((sW1 = "if" and sW2 = "not") or sW1 = "else") to bPlausible
                If (eKind = eDSOnDispatch) ;
                    Move (sW1 = "on") to bPlausible
                If (eKind = eDSUseNoExt) ;
                    Move (sW1 = "use") to bPlausible
                If (eKind = eDSUseContains) ;
                    Move (sW1 = "use") to bPlausible
                If (eKind = eDSClassDecl) Begin
                    If (sW1 = "object") ;
                        Move (Pos(aRules[iRule].sToken, sLow) > 0 or HasLearnedSubclasses(Self, aRules[iRule].sToken)) to bPlausible
                End
                If (eKind = eDSClassSubclass) Begin
                    If (sW1 = "class") ;
                        Move (Pos(aRules[iRule].sToken, sLow) > 0 or HasLearnedSubclasses(Self, aRules[iRule].sToken)) to bPlausible
                End
                If (eKind = eDSSubclassObject) Begin
                    If (sW1 = "object") ;
                        Move (HasLearnedSubclasses(Self, aRules[iRule].sToken)) to bPlausible
                End
                If (eKind = eDSReplaceConst) ;
                    Move (sW1 = "#replace") to bPlausible
                If (eKind = eDSApiDeclTypes) ;
                    Move (sW1 = "external_function") to bPlausible
                If (eKind = eDSAnsiApiWide) ;
                    Move (sW1 = "external_function") to bPlausible
                // Reached only from ScanLines' GUARD A branch, which is where a directive line is swept:
                // the ordinary path latches on it and never gets here.
                If (eKind = eDSUnpairedWarningsOff) ;
                    Move (sW1 = asTok1[iRule]) to bPlausible
                /* THE PRE-GATE IS WHY A FILE GETS A ROW AT ALL, and "zerotype" alone made both
                   AutoFix rules blind to any Type buffer written without one. vsWin32ids.pkg
                   zeroes its buffer by hand and reaches the API through Put, so neither rule ever
                   examined the file: the only row it could raise was the report-only Put row,
                   whose sole affordance is Ignore. The converter's ability was never the binding
                   constraint here - this test was (Nils 2026-09-01).

                   FIRST WORDS ONLY, deliberately. Admitting every line containing "_size" would
                   take the population from 6 files to 142 across three real workspaces - a 24x
                   widening of a per-file converter pass - and buy nothing, because the one file
                   that zeroes by hand also has a Put and is already admitted. Measured before it
                   was written, not assumed. */
                If (eKind = eDSTypeToWinStruct or eKind = eDSWin32BufferConvertible) ;
                    Move (sW1 = "zerotype" or sW1 = "filltype" or sW1 = "put" or sW1 = "getbuff" or sW1 = "put_string" or sW1 = "getbuff_string") to bPlausible
                If (eKind = eDSReplaceCommand) ;
                    Move (Pos("replace", sLow) > 0) to bPlausible
                If (eKind = eDSErrorNumber) ;
                    Move (Pos("error", sLow) > 0) to bPlausible
                If (eKind = eDSObsoleteMethodTarget) ;
                    Move ((sW1 = "procedure" or sW1 = "function") and Pos("for", sLow) > 0) to bPlausible
                // 'is' then a space or a tab, not the text "is a": 'is  a DFPanel' and a tab are rows too (2026-10-24).
                If (eKind = eDSObsoleteClassName) ;
                    Move (Pos("is ", sLow) > 0 or Pos("is" + Character(9), sLow) > 0 or Pos("refclass", sLow) > 0 or Pos("u_", sLow) > 0 or ((sW1 = "procedure" or sW1 = "function") and Pos("for", sLow) > 0)) to bPlausible
                If (eKind = eDSFieldMainIndex) ;
                    Move (Pos("field_main_index", sLow) > 0) to bPlausible
                If (eKind = eDSLegacyWorkspaceRead) ;
                    Move (sW1 = "get" and Pos("ghoworkspace", sLow) > 0) to bPlausible
                If (bPlausible = True) Begin
                    Get _RuleMatchesLine aRules[iRule] sCode sW1 sW2 sW3 (&asAllCode) (&asApiCat) (&aTypeClu) (&bTypeCluDone) (&asWin32Conv) (&bWin32ConvDone) (&asWin32Notes) (&sDeclineNote) iLine to bMatch
                    If (bMatch = True) Begin
                        Move (iLine + 1)               to Hit.iLine
                        Move aRules[iRule].sSymbol     to Hit.sSymbol
                        Move aRules[iRule].eCategory   to Hit.eCategory
                        Move aRules[iRule].sRefactorFn to Hit.sRefactorFn
                        Move aRules[iRule].sHint       to Hit.sHint
                        Move aRules[iRule].iDSNumber   to Hit.iDSNumber
                        // DS 9225 on a Type the run declined: Explain, with the run's own reason as
                        // the hint (see _RuleMatchesLine, eDSWin32BufferConvertible).
                        If (sDeclineNote <> "") Begin
                            Move eModExplain to Hit.eCategory
                            Move ""          to Hit.sRefactorFn
                            Move (Trim(aRules[iRule].sRefactorFn) + " does not convert this buffer. " + sDeclineNote ;
                                + ". Fix that and run Check again, or replace the Type with a Struct by hand.") to Hit.sHint
                        End
                        /* The class line of a grid subclass: the rule offers the subclass converter, and
                           the Check's verdict on THIS class decides whether the offer stands (2026-10-04). */
                        If (eKind = eDSClassSubclass and _IsGridPortToken(Self, aRules[iRule].sToken) = True) Begin
                            Move True to bKeepFn
                            Get _GridClassRowHint aRules[iRule] sCode (&bKeepFn) to sNote
                            If (bKeepFn = False) Begin
                                Move sNote       to Hit.sHint
                                Move eModExplain to Hit.eCategory
                                Move ""          to Hit.sRefactorFn
                            End
                        End
                        /* The class line of a FloatingPopupMenu subclass (2026-10-05): the rule offers
                           ConvertPopupMenuSubclassToCodeJock, and a dry run of THIS class decides whether the
                           offer stands - the question the run itself asks before it writes
                           (cRefactorFuncLib._CJPopupClassWhyNot). A class it would leave is an explanation
                           with the reason. No marker is involved, so that row is there on every Check until
                           the class has been ported. */
                        Else If (eKind = eDSClassSubclass and aRules[iRule].sToken = "floatingpopupmenu" and Trim(aRules[iRule].sRefactorFn) <> "") Begin
                            Get _CJPopupClassWhyNot of ghoFuncLib (&asAllCode) iLine to sNote
                            If (sNote <> "") Begin
                                Move ("Workspace subclass of FloatingPopupMenu. " + Trim(aRules[iRule].sRefactorFn) + " cannot convert it: " + sNote + ". Port it to cCJContextMenu by hand. Objects of this subclass are not listed.") to Hit.sHint
                                Move eModExplain to Hit.eCategory
                                Move ""          to Hit.sRefactorFn
                            End
                        End
                        Else If (eKind = eDSClassDecl or eKind = eDSClassSubclass) Begin
                            Move True to bKeepFn
                            Get _SubclassMatchNote aRules[iRule] sCode (&bKeepFn) to sNote
                            If (sNote <> "") Begin
                                Move (Hit.sHint + sNote) to Hit.sHint
                                If (bKeepFn = False) Begin
                                    Move eModExplain to Hit.eCategory
                                    Move ""          to Hit.sRefactorFn
                                End
                            End
                        End
                        // The rename rule's row (DS 9244) says the name the fix will write, the generic rule's (DS 9252)
                        // what changes, and the row of a number that stays (DS 9245) why it stays.
                        If (eKind = eDSErrorNumber) Begin
                            Get _ErrorCommandNumber of ghoFuncLib sCode (&iErrPos) (&iErrLen) to iErrNum
                            If (Trim(Hit.sRefactorFn) = "ChangeErrorNumberToName") Begin
                                Get ErrorNameForNumber of ghoFuncLib iErrNum to sNote
                                Move ("Error " + String(iErrNum) + " has a name: write Error " + sNote + ". The number stays the same, so nothing an error handler sees changes.") to Hit.sHint
                            End
                            Else If (Trim(Hit.sRefactorFn) <> "") ;
                                Move ("Error " + String(iErrNum) + " has a made-up number and its own text, and nothing reads the number: write Error DFERR_OPERATOR. The text stays, and it shows in a plain message box instead of the Unhandled Program Error dialog.") to Hit.sHint
                            Else ;
                                Get _MadeUpErrorWhyNot of ghoFuncLib asAllCode[iLine] to Hit.sHint
                        End
                        // The old-class-name row (DS 9249) says the name it becomes.
                        If (eKind = eDSObsoleteClassName) Begin
                            Get _ObsoleteClassNameAt of ghoFuncLib sCode 1 (&iErrPos) (&iErrLen) to sNote
                            If (sNote <> "") ;
                                Move (Trim(Mid(sCode, iErrLen, iErrPos)) + " is an old name for " + sNote + ": write " + sNote + ". It is the same class, so nothing changes.") to Hit.sHint
                        End
                        // The row of a ghoWorkspace read (DS 9253 / 9254) says what it becomes, or that nothing can.
                        If (eKind = eDSLegacyWorkspaceRead) Begin
                            Get _LegacyWorkspaceRead of ghoFuncLib sCode (&sNote) (&sNewName) to iErrNum
                            If (sNewName <> "") ;
                                Move ("ghoWorkspace no longer exists in DataFlex: write Get " + sNewName + " of (phoWorkspace(ghoApplication)). Check any code that adds a file name to this path, as the path may or may not end in a backslash.") to Hit.sHint
                            Else ;
                                Move ("ghoWorkspace no longer exists in DataFlex, and " + sNote + " has no new property to read. Change this line by hand.") to Hit.sHint
                        End
                        /* A HIT INSIDE A MACRO BODY IS REPORTED, NEVER OFFERED AS A FIX (Nils 2026-09-07:
                           "no macro code should ever be refactored").

                           On 2026-07-31 such a hit was capped at Review with its converter still named:
                           the engine rewrote a #COMMAND body like any other line then, and a macro body
                           is a TEMPLATE - one edit changes what every use of the command emits - so the
                           change wanted a person deciding to make it. Since 09-07 the engine leaves every
                           macro line as written, whatever function runs (the library's macro-code guard), so a row that
                           still named the converter could only put it in a plan that changes nothing:
                           "0 lines Renamed", and the row back after the next Check (Nils 2026-10-04,
                           ToAnsi inside a #COMMAND body of a workspace's language package).

                           The hit itself stays: the compiler reports these calls at the command's call
                           sites and never in its body, so this row is the only place they show (see
                           CS_DSMacroSafeTokens). It is Explain, with no function, and it says the change
                           is the user's to make by hand. */
                        If (bMacroBody = True and Hit.sRefactorFn <> "") Begin
                            Move (Hit.sHint + " This line is inside a #COMMAND body, and DFRefactor never changes macro code - " + Hit.sRefactorFn + " leaves it as it is. Change it by hand if you want it changed.") to Hit.sHint
                            Move eModExplain to Hit.eCategory
                            Move ""          to Hit.sRefactorFn
                        End
                        Move Hit to aHits[SizeOfArray(aHits)]
                    End
                End
            End
        Loop
    End_Procedure

    /* THE IMAGE NAME LINE ('/Body Resident'), swept here and nowhere else. ScanLines blanks every
       line of a legacy report image, the name line included, because an image's words are its name
       and its text, never code - no rule above may see them. The image-option rules (eDSImageOption)
       are the exception, and they read the RAW name line through this sweep alone. iLine is 0-based;
       a hit records iLine+1. The ByRef arguments of _RuleMatchesLine are empty stand-ins: this kind
       needs none of them. */
    Procedure _SweepImageNameRules String sRaw Integer iLine tDeepScanRule[] ByRef aRules tDeepScanHit[] ByRef aHits
        tDeepScanHit Hit
        String[] asNoCode asNoCat asNoConv asNoNotes
        tTypeBufferCluster[] aNoClu
        Boolean bNoClu bNoConv bMatch
        String sNoNote
        Integer iRule iRules

        Move (SizeOfArray(aRules) - 1) to iRules
        For iRule from 0 to iRules
            If (aRules[iRule].bEnabled = True and aRules[iRule].eDSKind = eDSImageOption) Begin
                Get _RuleMatchesLine aRules[iRule] sRaw "" "" "" (&asNoCode) (&asNoCat) (&aNoClu) (&bNoClu) (&asNoConv) (&bNoConv) (&asNoNotes) (&sNoNote) iLine to bMatch
                If (bMatch = True) Begin
                    Move (iLine + 1)               to Hit.iLine
                    Move aRules[iRule].sSymbol     to Hit.sSymbol
                    Move aRules[iRule].eCategory   to Hit.eCategory
                    Move aRules[iRule].sRefactorFn to Hit.sRefactorFn
                    Move aRules[iRule].sHint       to Hit.sHint
                    Move aRules[iRule].iDSNumber   to Hit.iDSNumber
                    Move Hit to aHits[SizeOfArray(aHits)]
                End
            End
        Loop
    End_Procedure

    // GUARD B helper (Nils 2026-07-15): for a procedure/function opening at iStart, return the line index of its
    // matching end_procedure / end_function IF the message BODY invokes a '!' macro command (making the whole
    // message legacy character-mode code to leave untouched); else -1 (scan the message normally). Reads the
    // CACHED code-only lines, so a '!' in a comment or string is already blanked and never triggers. Messages do
    // not nest, so the first matching end_ closes it; an unclosed message returns -1 (scan on, never over-skip).
    Function _MacroMessageEndLine String[] ByRef asCodeOnly Integer iStart Returns Integer
        String sW1 sEndKw
        Integer i iSize iEnd
        Boolean bHasMacro

        Move (SizeOfArray(asCodeOnly) - 1) to iSize
        Get _NthWord of ghoFuncLib (Lowercase(asCodeOnly[iStart])) 1 to sW1
        If (sW1 = "function") ;
            Move "end_function" to sEndKw
        Else ;
            Move "end_procedure" to sEndKw
        Move False to bHasMacro
        Move -1 to iEnd
        For i from (iStart + 1) to iSize
            Get _NthWord of ghoFuncLib (Lowercase(asCodeOnly[i])) 1 to sW1
            If (sW1 = sEndKw) Begin
                Move i to iEnd
                Move iSize to i   // canonical DF loop-exit
            End
            Else If (Pos("!", asCodeOnly[i]) > 0) ;
                Move True to bHasMacro
        Loop
        If (bHasMacro = True and iEnd >= 0) ;
            Function_Return iEnd
        Function_Return -1
    End_Function

    // Scan one file's lines against the catalog. Returns every hit with its 1-based
    // line number; a line CAN produce more than one hit (distinct rules). Disabled
    // rules never match. Blank / comment-only lines are skipped after the code-only
    // reduction, so the per-rule work only runs on real code.
    // PERFORMANCE (Nils 2026-07-10, the 1698-file LegacyApp3 scan crawled): the rule tokens'
    // first/second words are precomputed ONCE per scan, and every rule is PRE-GATED per
    // line with NATIVE compares / Pos() on a once-lowercased line - necessary conditions
    // only, so no interpreted per-character helper (_NthWord on the token, _FindKeywordPos)
    // runs for the overwhelmingly common no-match case. _RuleMatchesLine stays the
    // correctness authority and runs only on the rare plausible candidates.
    Function ScanLines String[] ByRef asCode tDeepScanRule[] ByRef aRules Returns tDeepScanHit[]
        tDeepScanHit[] aHits
        String[] asTok1 asCodeOnly
        String[] asApiCat     // the API catalogue, fetched once per file on first declaration
        tTypeBufferCluster[] aTypeClu   // the byte-buffer clusters, graded once per file (DS 9224)
        String[] asWin32Conv            // the file as ChangeExternalFunctionCallers would leave it, run once (DS 9225)
        String[] asWin32Notes           // ...and that run's notes: a declined Type's reason becomes its Explain row
        Boolean bWin32ConvDone
        Boolean bTypeCluDone
        String sCode sLow sW1 sW2 sW3 sPrev
        Integer iLine iSize iRule iRules iSkipTo
        Boolean bInMacro bSkipTodo bSuspended bInImage bImgEnd bImgStart bHolds
        tLineInfo[] aInfo
        Boolean[] abMls

        Move (SizeOfArray(asCode) - 1) to iSize
        Move (SizeOfArray(aRules) - 1) to iRules
        For iRule from 0 to iRules
            Get _NthWord of ghoFuncLib aRules[iRule].sToken 1 to asTok1[iRule]
        Loop
        // PER-FILE progress (Nils 2026-07-26): the OVERALL bar advances per file, so on a big file
        // the panel looked frozen for the whole scan of it. Scale the per-file bar to this file's
        // lines and step it through both walks below - the strip pass and the rule pass - so the
        // panel keeps moving inside one file. Time-gated inside _NudgeLineProgress, and a no-op
        // when no panel is showing (batch mode, the DFUnit runner). A CACHED file never gets here,
        // which is right: there is no walk to report.
        Send _StartFileLineProgress of ghoFuncLib (iSize + 1)
        // Strip comments + string literals ONCE per line (_CodeOnlyLine), cached: the main scan below AND the
        // macro-message look-ahead (Guard B, _MacroMessageEndLine) both read this, so _CodeOnlyLine is never
        // re-run, and a '!' that survives here is genuine code (a '!' in a comment / string is already blanked).
        //
        // ...AND BLANK EVERY LINE OF A DF 23 '/* ... */' BLOCK COMMENT (found 2026-08-16 writing the
        // scanner's tests). _CodeOnlyLine is per-line and knows only '//' and quotes, so a legacy command
        // sitting inside a block comment - modernized workspaces are full of them - was flagged Auto-fix,
        // and the converter, whose lexer DOES know block comments, then refused: a row that never clears.
        // Same line-granularity contract as the lexer (Tokenizer -> _IsDF23CommentStart / _IsDF23CommentEnd,
        // both quote-masked and '//'-aware): the line that opens the block is a comment WHOLE (so is a
        // trailing '/* note */' on a code line - the converters skip that line too, and grid == fix), a
        // same-line '*/' does not carry, and everything up to and including the closing line is blank.
        // Image state is tracked here as well so a legacy report image's '/*' END marker never opens a
        // block; the main loop below still re-derives image state off the raw lines (unchanged).
        // ...AND A DF 23 MULTI-LINE STRING (2026-10-24): its body lines and its closing line are text, and on the
        // opening line only the code before the string counts. Since 2026-10-29 this pass reads the file walk every
        // lane reads (the library's ScanSourceFile) - an @-string's too, which ends at its first closing
        // quote - so a row here is a line the converters act on; a #COMMAND line in a string's text is blank
        // here, so it opens no macro body below either. A report image's lines keep their code: the loop below
        // tracks images itself.
        Get ScanSourceFile of ghoFuncLib (&asCode) to aInfo
        For iLine from 0 to iSize
            If (Mod(iLine, 64) = 0) ;
                Send _NudgeLineProgress of ghoFuncLib iLine (iSize + 1) "Reading line:"
            Move (aInfo[iLine].sOpenIn <> "") to abMls[iLine]
            Move "" to asCodeOnly[iLine]
            If (aInfo[iLine].eKind = LK_Code or aInfo[iLine].eKind = LK_Image or aInfo[iLine].eKind = LK_Header) ;
                Get _CodeOnlyLine of ghoFuncLib asCode[iLine] to asCodeOnly[iLine]
            If (aInfo[iLine].eKind = LK_StringOpener) ;
                Get _MultiLineStringOpenerCode of ghoFuncLib asCode[iLine] to asCodeOnly[iLine]
        Loop
        Move False to bInMacro
        Move False to bSuspended
        Move False to bInImage
        For iLine from 0 to iSize
            If (Mod(iLine, 64) = 0) ;
                Send _NudgeLineProgress of ghoFuncLib iLine (iSize + 1) "Scanning line:"
            Move asCodeOnly[iLine] to sCode
            // IMAGE / PAGE skip (Nils 2026-07-15): legacy report-page content ('/PageName' .. '/*') is literal
            // report text, so its words (GT / LE / EQ ...) are NOT operators - the converters already bail on
            // it via the tokenizer's bIsInImage, and Deep Scan must too. Track state on the RAW line
            // (IsImageStart/IsImageEnd LTrim + are indentation-tolerant), then BLANK sCode for any image line so
            // the existing non-blank gate below skips it - no separate branch. IsImageStart = '/' + a letter
            // (a '//' comment / a '/*' end are not), IsImageEnd = a leading '/*'.
            If (bInImage = True) Begin
                Get IsImageEnd of ghoFuncLib asCode[iLine] to bImgEnd
                Move "" to sCode
                If (bImgEnd = True) Begin
                    Move False to bInImage
                End
                // ...and the NEXT image's name line ends this one: a report's images usually come in
                // one run (a header, a body and a footer image, then the '/*'), so every name line is
                // swept, not just the first.
                Else Begin
                    Get IsImageStart of ghoFuncLib asCode[iLine] to bImgStart
                    If (bImgStart = True and bInMacro = False and bSuspended = False) ;
                        Send _SweepImageNameRules asCode[iLine] iLine (&aRules) (&aHits)
                End
            End
            Else Begin
                Get IsImageStart of ghoFuncLib asCode[iLine] to bImgStart
                // A '/api' line inside a multi-line string is the string's text, not a report image (2026-10-24).
                If (bImgStart = True and abMls[iLine] = True) ;
                    Move False to bImgStart
                If (bImgStart = True) Begin
                    Move True to bInImage
                    Move "" to sCode
                    // The name line's own words are options, not code: only the image-option rules
                    // read it (_SweepImageNameRules), under the same macro and warnings-off guards as
                    // every other rule.
                    If (bInMacro = False and bSuspended = False) ;
                        Send _SweepImageNameRules asCode[iLine] iLine (&aRules) (&aHits)
                End
            End
            If (Trim(sCode) <> "") Begin
                Move (Lowercase(sCode)) to sLow
                Get _NthWord of ghoFuncLib sLow 1 to sW1
                Get _NthWord of ghoFuncLib sLow 2 to sW2
                Get _NthWord of ghoFuncLib sLow 3 to sW3
                /* A LEGACY CONDITIONAL PREFIX in front of an Indicate ('[found] indicate found as ...',
                   '[~x] Indicate y as ...') is the bracket-Indicate form the converter rewrites - and it
                   hid the line from every rule keyed on the first words: the Indicate rule (command
                   position) and the comparison rules (condition line) both read '[found]' as word 1.
                   A 2005-era file's two continued Indicate pairs raised no row at all, so once the
                   rest of its rows were spent the pairs were invisible and the plan empty (Nils
                   2026-09-17: "did not suggest any refactoring plan"). For THIS shape only, the words
                   and the code are taken from after the bracket group; a bracket in front of any other
                   command stays as it was ('[cond] Replace ...' is not at command position - tested).
                   Ind, Indicate's obsolete spelling, is the same shape (rules v89, GitHub 2026-10-06).
                   An Else in front of Indicate, Ind or a bracket hid the line the same way - 'Else Indicate
                   X False' raised no row - and the converter takes the statement after the Else as it
                   would take it alone (rules v90, Nils 2026-10-06), so the words are taken from after the
                   Else first.
                   An 'Else If' line keeps its words: the condition rules read it as it stands. */
                If (sW1 = "else" and (sW2 = "indicate" or sW2 = "ind" or Left(sW2, 1) = "[")) ;
                    Send _DSStripLeadingElse (&sCode) (&sLow) (&sW1) (&sW2) (&sW3)
                If (Left(sW1, 1) = "[") ;
                    Send _DSStripIndicateBracket (&sCode) (&sLow) (&sW1) (&sW2) (&sW3)
                // MACRO-COMMAND definitions (#COMMAND .. #ENDCOMMAND) are skipped WHOLE: their
                // body lines look exactly like legacy commands - that is what a macro emits -
                // but they carry !-argument tokens no converter can rewrite, so flagging them
                // produced auto-fix rows a plan run can never clear (AL_FUNC.PKG's Insert rows,
                // Nils 2026-07-10). The #COMMAND line itself is skipped too - the macro NAME is
                // often a legacy command word.
                If (sW1 = "#command") Begin
                    Move True to bInMacro
                End
                Else If (sW1 = "#endcommand") Begin
                    Move False to bInMacro
                End
                /* ...EXCEPT the rules that match a FUNCTION NAME whose fix is a pure rename
                   (CS_DSMacroSafeTokens). The blanket skip above is right for rules that match
                   COMMAND syntax - a macro body is full of command-shaped lines carrying '!'
                   argument tokens, and rewriting those produced auto-fix rows a plan run could
                   never clear. It is wrong for ToANSI / ToOEM: those are ordinary function calls
                   that happen to sit inside a macro body, and renaming one to Utf8ToAnsi is safe
                   whatever its argument - including '!1', which the rename simply carries through.

                   Without this a workspace's own output commands hide their conversion calls
                   completely: the compiler blames the command's CALL SITES (never the body) and the
                   scan skipped the body, so the only lines worth editing were invisible to both
                   lanes (Nils 2026-07-31, a LangText package: three of its five ToAnsi calls take a
                   plain global, two take '!1', and all five are rewritable).
                   Since 2026-10-04 such a hit is REPORTED and not offered: the engine never changes macro
                   code, so the row is Explain with no function (see _SweepRules). */
                /* ORDER MATTERS (2026-09-09): the latch is read BEFORE the macro-body sweep below, because
                   the compiler honours the directive inside a #COMMAND body too - an Off/On pair there mutes
                   every expansion of that macro and nothing else, and an unpaired Off keeps running past
                   #ENDCOMMAND. Read after the sweep, a CompilerWarnings line in a body was consumed as an
                   ordinary line and the region never latched. */
                /* GUARD A (Nils 2026-07-15; vocabulary corrected 2026-09-09). Honour the author's OWN
                   compiler-warning opt-out: where they told the COMPILER to stop warning, Deep Scan - a
                   warning-like report - stays quiet too. Region latch (like bInMacro); the directive lines
                   skip too, and it resets per file (bSuspended starts False).

                   THE PAIR THIS GUARD WAS WRITTEN AGAINST DOES NOT EXIST. 'CompilerWarnings Resume' is not
                   DataFlex - it is Error 4345, "Type check error RESUME, INVALID LITERAL" - so the un-latch
                   could never fire on a file that compiles, and the form the language does have was not
                   recognised at all. Measured against DF26:
                     Suspend    one-way, and it dies with the file that issued it - the parent's next line
                                warns again. It has no counterpart.
                     Off / On   a plain switch. On restores it; an UNPAIRED Off does NOT die with its file,
                                it silences everything compiled after it.
                   The DF26 install writes Off/On 27 times each against four bare Suspends, so the form that
                   went unrecognised was the common one.

                   Modelled PER FILE for both, because the scan reads a file on its own and has no Use graph
                   to carry a leak across: a bare Off latches to the end of THIS file and no further. The
                   residue is the scan reporting a line the compiler is quiet about further downstream,
                   which is the safe direction for a report. 'Resume' stays tolerated as an un-latch - it
                   cannot reach here from a file that compiles, but Deep Scan also reads files that are
                   never built, and the intent there is unambiguous. A surrounding #IF is not evaluated - a
                   bare Suspend is treated as active, a safe over-skip. */
                Else If (sW1 = "compilerwarnings" and (sW2 = "suspend" or sW2 = "off")) Begin
                    /* THE DIRECTIVE LINE IS ITSELF SCANNABLE, for DS 9226 and in practice for nothing
                       else: every other kind's pre-gate wants a first word this line does not have. Swept
                       BEFORE the latch, and with bMacroBody False regardless of bInMacro or bSuspended,
                       because the finding is about THIS directive and not about code the author muted - a
                       mute cannot legitimately silence the report that it never closes, and one inside a
                       macro body is if anything worse. The COMMENT-STRIPPED array goes in so the rule's
                       look-ahead cannot be closed by an 'On' sitting inside a block comment. */
                    Send _SweepRules sCode sLow sW1 sW2 sW3 iLine (&asCodeOnly) (&asApiCat) (&aTypeClu) (&bTypeCluDone) (&asWin32Conv) (&bWin32ConvDone) (&asWin32Notes) (&aRules) (&asTok1) (&aHits) False
                    Move True to bSuspended
                End
                Else If (sW1 = "compilerwarnings" and (sW2 = "on" or sW2 = "resume")) Begin
                    Move False to bSuspended
                End
                Else If (bInMacro = True and bSuspended = False) Begin
                    Send _SweepRules sCode sLow sW1 sW2 sW3 iLine (&asCode) (&asApiCat) (&aTypeClu) (&bTypeCluDone) (&asWin32Conv) (&bWin32ConvDone) (&asWin32Notes) (&aRules) (&asTok1) (&aHits) True
                End
                Else If (bInMacro = False and bSuspended = False) Begin
                    // GUARD B (Nils 2026-07-15): a procedure/function that INVOKES a '!' macro command is legacy
                    // character-mode code end to end - the '!' lines PLUS the indicator / repeat / loop lines they
                    // drive - so skip the WHOLE message, not just the '!' lines. Peek to its end_; if the body uses
                    // a '!' macro, jump iLine there (the For's Increment steps to the line after). '!' is read off
                    // the code-only text, so a '!' in a comment or string never triggers (the 193-false-hit case).
                    Move -1 to iSkipTo
                    If (sW1 = "procedure" or sW1 = "function") ;
                        Get _MacroMessageEndLine (&asCodeOnly) iLine to iSkipTo
                    If (iSkipTo >= 0) Begin
                        Move iSkipTo to iLine
                    End
                    Else Begin
                        // A DFRefactor skip-marker means a converter already saw this line and REFUSED
                        // with written guidance - re-flagging it every scan as Auto-fix promises a fix
                        // that never comes (Nils 2026-07-11/12). TWO placements:
                        //   ABOVE (own comment line): '//TODO dfTimer->cTimer (skipped): ...'
                        //   TRAILING (same line): '... // TODO (DFRefactor): NOT converted - strmark'
                        //                         '... // NOTE (DFRefactor): kept as Indicator ...'
                        // The marker in the source IS the outcome, so the scan stays quiet about it.
                        Move False to bSkipTodo
                        Move (Lowercase(asCode[iLine])) to sPrev
                        If ((sPrev contains "(dfrefactor)") and ((sPrev contains "todo") or (sPrev contains "note"))) ;
                            Move True to bSkipTodo
                        If (bSkipTodo = False and iLine > 0) Begin
                            Move (Lowercase(Trim(asCode[iLine - 1]))) to sPrev
                            If (Left(sPrev, 2) = "//" and ((sPrev contains "todo") or (sPrev contains "note"))) Begin
                                If ((sPrev contains "skipped") or (sPrev contains "dfrefactor")) ;
                                    Move True to bSkipTodo
                            End
                        End
                        /* THE POPUP CONVERTER'S OWN MARKER IS A QUESTION, NOT AN ANSWER (2026-09-13): the
                           version that refused wrote it, and the version scanning may take the shape by
                           now - the first live run refused a ';'-continued item list that the same day's
                           build reads. Ask the converter (a dry run of the object); a refusal that still
                           stands keeps the scan quiet as before, one that no longer does lets the rules
                           run, so the row comes back with the offer and the run replaces the marker. */
                        If (bSkipTodo = True and (sPrev contains "changefloatingpopupmenutocodejock left")) Begin
                            Get _CJPopupMarkerStillHolds of ghoFuncLib (&asCode) iLine to bHolds
                            If (bHolds = False) ;
                                Move False to bSkipTodo
                        End
                        If (bSkipTodo = False) ;
                            Send _SweepRules sCode sLow sW1 sW2 sW3 iLine (&asCode) (&asApiCat) (&aTypeClu) (&bTypeCluDone) (&asWin32Conv) (&bWin32ConvDone) (&asWin32Notes) (&aRules) (&asTok1) (&aHits) False
                    End
                End
            End
        Loop
        // The pointer/string Moves are not a line match: the converters' dry run over the whole file.
        Send _PointerMoveHits (&asCode) (&aRules) (&aHits)
        // ...and neither are the (Self) object references (v93).
        Send _SelfObjectRefHits (&asCode) (&aRules) (&aHits)
        Function_Return aHits
    End_Function

    /* eDSSelfObjectRef (v93, 2026-10-23): RemoveSelfFromObjectReferences runs over a copy of the file
       (ghoFuncLib._SelfObjectRefLines), and every line it would change is a row for the rule - the v92
       pattern, because which names are objects is a fact about the whole file. The rule ships OFF, and a
       rule that is off costs nothing here. */
    Procedure _SelfObjectRefHits String[] ByRef asCode tDeepScanRule[] ByRef aRules tDeepScanHit[] ByRef aHits
        tDeepScanHit Hit
        Integer[] aiLines
        Integer iRule iRules i iLast

        If (ghoFuncLib = 0) ;
            Procedure_Return
        Move (SizeOfArray(aRules) - 1) to iRules
        For iRule from 0 to iRules
            If (aRules[iRule].bEnabled = True and aRules[iRule].eDSKind = eDSSelfObjectRef) Begin
                Get _SelfObjectRefLines of ghoFuncLib asCode to aiLines
                Move (SizeOfArray(aiLines) - 1) to iLast
                For i from 0 to iLast
                    Move (aiLines[i] + 1)          to Hit.iLine
                    Move aRules[iRule].sSymbol     to Hit.sSymbol
                    Move aRules[iRule].eCategory   to Hit.eCategory
                    Move aRules[iRule].sRefactorFn to Hit.sRefactorFn
                    Move aRules[iRule].sHint       to Hit.sHint
                    Move aRules[iRule].iDSNumber   to Hit.iDSNumber
                    Move Hit to aHits[SizeOfArray(aHits)]
                Loop
            End
        Loop
    End_Procedure

    /* eDSPointerStringMove (v92, 2026-10-20): each enabled pointer rule's converter runs over a copy of the
       file (ghoFuncLib._PointerMoveLines), and every line it would rewrite is a row for that rule. The
       converters gate themselves: a file with no "pointer" and no "address" text costs one text search. */
    Procedure _PointerMoveHits String[] ByRef asCode tDeepScanRule[] ByRef aRules tDeepScanHit[] ByRef aHits
        tDeepScanHit Hit
        Integer[] aiLines
        Integer iRule iRules i iLast

        If (ghoFuncLib = 0) ;
            Procedure_Return
        Move (SizeOfArray(aRules) - 1) to iRules
        For iRule from 0 to iRules
            If (aRules[iRule].bEnabled = True and aRules[iRule].eDSKind = eDSPointerStringMove) Begin
                Get _PointerMoveLines of ghoFuncLib asCode aRules[iRule].sRefactorFn to aiLines
                Move (SizeOfArray(aiLines) - 1) to iLast
                For i from 0 to iLast
                    Move (aiLines[i] + 1)          to Hit.iLine
                    Move aRules[iRule].sSymbol     to Hit.sSymbol
                    Move aRules[iRule].eCategory   to Hit.eCategory
                    Move aRules[iRule].sRefactorFn to Hit.sRefactorFn
                    Move aRules[iRule].sHint       to Hit.sHint
                    Move aRules[iRule].iDSNumber   to Hit.iDSNumber
                    Move Hit to aHits[SizeOfArray(aHits)]
                Loop
            End
        Loop
    End_Procedure

    // ---- Incremental scan cache (Nils 2026-07-16) -------------------------------------
    // The Deep Scan -> Run Fix Plan -> re-scan convergence loop re-read every file each
    // pass; between passes only the files the plan run (or a Studio edit) touched can
    // produce different hits, because ScanLines is a pure per-file function of
    // (file contents, rules): the hits array is fresh per call, every region latch
    // (bInMacro/bSuspended/bInImage) resets per file, and aRules is ByRef only to skip
    // the deep copy - nothing mutates it. The two methods below exploit that: per file,
    // an unchanged (last-write time + size) under an unchanged rules fingerprint means
    // the cached hits ARE the scan result - no read, no scan. The cache struct itself is
    // OWNED BY THE CALLER (tDeepScanCache, threaded ByRef) so it can outlive this
    // per-scan object - the dashboard keeps it for the session in pDeepScanCache.

    // Call ONCE before a scan loop. Fingerprints the loaded rules (their full JSON); a
    // mismatch flushes EVERY entry - a rule toggle/reseed changes what ScanLines would
    // return for UNCHANGED files, so no per-file freshness test can save the entries.
    Procedure ValidateScanCache tDeepScanRule[] ByRef aRules tDeepScanCache ByRef Cache
        Handle hoJson
        String sFp
        String[] asNone
        tDeepScanFileCacheEntry[] aNone

        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson aRules
        Get Stringify of hoJson to sFp
        Send Destroy of hoJson
        /* THE VERSION IS PART OF THE FINGERPRINT (Nils 2026-07-29 - "the bug is back regarding
           #REPLACE"). The rules DATA alone is not enough: narrowing DS 9059 to require a
           constant-shaped VALUE changed the MATCHER CODE and left the rule record byte-identical,
           so this fingerprint did not move, the cache was never flushed, and every file kept the
           hits the OLD matcher had produced. MeterFunctions.pkg:3 '#Replace SELECT |!C' was still
           listed while a unit test on that exact line proved the new matcher rejects it.

           CI_DeepScanRulesVersion is bumped for ANY rule or matcher change (the catalog contract
           already requires it), so folding it in makes the cache honest about code changes it
           cannot otherwise see.

           IT HAPPENED AGAIN 2026-07-31, the same way: ToANSI/ToOEM were given reach into #COMMAND
           bodies - a pure matcher change, rule records byte-identical - and the bump was skipped on
           the reasoning that "the rule data has not changed". Every file kept its cached empty
           result and the new finding stayed invisible. ANY change to what the scanner FINDS is a
           version bump, including one that only widens where it looks. */
        // ...and the learned subclass set (2026-09-04): a new "Class X is a dbGrid" changes what an
        // UNCHANGED file's "Object oY is a X" line yields, exactly as a rule toggle does.
        // ...and the converter's verdict on each grid subclass (2026-10-04, PortVerdictFingerprint): it decides
        // which rule an object of that subclass is listed under. After "~", ahead of the first "|", so
        // SubclassPairsInFingerprint - which reads between the first two - is not disturbed.
        Move (String(CI_DeepScanRulesVersion) + "~" + (PortVerdictFingerprint(Self)) + "|" + (SubclassFingerprint(Self)) + "|" + sFp) to sFp
        If (sFp <> Cache.sRulesFingerprint) Begin
            Move asNone to Cache.asPathsLow
            Move aNone  to Cache.aEntries
            Move sFp    to Cache.sRulesFingerprint
        End
    End_Procedure

    // The per-file cache front of ScanLines. Freshness = EXACT last-write time + size
    // match, so ANY writer - the engine's fix plan, a Studio edit, a backup restore -
    // invalidates naturally (which is why this beats tracking "files the plan touched":
    // manual fixes between scans are part of the convergence loop). A miss reads + scans
    // + upserts IN PLACE, so a cancelled scan keeps the per-file work already done (each
    // entry is valid on its own). bFromCache lets the caller count reuse for its status
    // line. A vanished file degrades safely: empty read -> no hits, cached like any scan.
    /* A LANGUAGE FILE'S #REPLACE ENTRIES ARE NOT CONSTANTS (Nils 2026-08-09: "there should never be
       a SCAN flag for constant-type #REPLACE, if the file name is something like Language_XXX.inc,
       because those files are used by DataFlex system to compile an app for a particular
       language").

       The eDSReplaceConst rule looks for '#REPLACE name value' that a Define could express - real
       advice in ordinary source. In a Language_*.inc it is exactly wrong: the whole file IS the
       substitution mechanism DataFlex compiles a localised app with, one file per language, and
       converting those to Defines would break the thing the file exists to do. Every entry in such
       a file matches the rule, so the finding is not merely unhelpful - it buries the file in hits.

       Filtered by the rule's DS NUMBER rather than its display name: the number is the stable
       identity (it keys the ignore list and the recipe table), a caption is prose.

       Applied BEFORE the cache is written, so a cached read is already filtered and the two paths
       cannot disagree. */
    Function _DropLanguageFileConstHits String sFullFileName tDeepScanHit[] aHits tDeepScanRule[] ByRef aRules Returns tDeepScanHit[]
        tDeepScanHit[] aOut
        Integer[] aiDrop
        String sBase
        Integer i iLast iPos

        Move (Lowercase(sFullFileName)) to sBase
        Move (RightPos("\", sBase)) to iPos
        If (iPos > 0) ;
            Move (Right(sBase, (Length(sBase) - iPos))) to sBase
        // The documented shape is Language_<something>.inc. Deliberately NOT a bare "language"
        // prefix: a user file called LanguageRules.inc is ordinary source and deserves the finding.
        If (Left(sBase, 9) <> "language_" or Right(sBase, 4) <> ".inc") ;
            Function_Return aHits
        Move (SizeOfArray(aRules) - 1) to iLast
        For i from 0 to iLast
            If (aRules[i].eDSKind = eDSReplaceConst) ;
                Move aRules[i].iDSNumber to aiDrop[SizeOfArray(aiDrop)]
        Loop
        If (SizeOfArray(aiDrop) = 0) ;
            Function_Return aHits
        Move (SizeOfArray(aHits) - 1) to iLast
        For i from 0 to iLast
            If (SearchArray(aHits[i].iDSNumber, aiDrop) = -1) ;
                Move aHits[i] to aOut[SizeOfArray(aOut)]
        Loop
        Function_Return aOut
    End_Function

    /* A MENU FILE NO PROGRAM PULLS IN IS NOT A FINDING (Nils 2026-09-04, LegacyApp). The
       DFCreate_Menu / End_Menu rules fire where the lines ARE - the .mn fragment - but the converter
       runs on the PROGRAM that says "Use LegacyApp_5.mn" and comments that line when it converts; the
       fragment stays as the record of the legacy menu, compiled by nothing. So after a conversion
       the next Check re-flagged all 16 fragments, the plan re-offered them, and the run had no
       live Use to follow: "Run the refactoring plan" forever, changing nothing. A .mn / .mnu with
       no code-level Use / #Include in any .src of its own folder loses the menu converter's hits
       here; every other rule's hit on it stays, and a dead menu file is Tidy Up's business (the
       unused source files report). Applied AFTER the cache, on every Check: liveness is a fact
       about OTHER files, so it cannot ride the fragment's own cache entry.

       A PULLDOWN IN A .pkg, AND A MENU THE CONVERTER CANNOT REACH (Nils 2026-09-11: a plan offered
       three files and refactored 0). Only a .mn / .mnu / .inc was judged, so a legacy menu in a .pkg
       kept the converter's name whatever pulled it in. Every file but a program is judged now: a
       program's menu reaches it (the chain follows any #Include) -> kept; it is named only by menu
       files that are themselves dead -> dropped, as before; a .mn / .mnu / .inc nothing names ->
       dropped, as before. A file of any OTHER kind that no menu names at all is not dropped: a
       program may Use it - the converter never follows a Use of a package - so it may be live, and a
       live legacy menu must stay on the board. It stays, as Explain with no function, and the hint
       says why the plan cannot take it. */
    Function _DropDeadMenuFileHits String sFullFileName tDeepScanHit[] aHits tDeepScanRule[] ByRef aRules Returns tDeepScanHit[]
        tDeepScanHit[] aOut
        String[] asMap asProgs asScanFiles
        Integer[] aiDrop
        String sLow sLeaf sFolder sHint
        Integer i iLast
        Boolean bLive bNamed bMenuFile

        Move (Lowercase(Trim(sFullFileName))) to sLow
        // A program is where the converter writes, so its hits are always its business; any other
        // file is judged by whether a program's menu reaches it - see _CJProgramsPullingIn.
        If (Right(sLow, 4) = ".src") ;
            Function_Return aHits
        If (SizeOfArray(aHits) = 0) ;
            Function_Return aHits
        // Only the menu converter's rules are in question - if none fired here, nothing to judge
        // (and no folder read for an .inc that merely holds an obsolete command).
        Move (SizeOfArray(aRules) - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(Trim(aRules[i].sRefactorFn)) = "changedfcreatemenutocodejock") ;
                Move aRules[i].iDSNumber to aiDrop[SizeOfArray(aiDrop)]
        Loop
        Move False to bLive
        Move (SizeOfArray(aHits) - 1) to iLast
        For i from 0 to iLast
            If (SearchArray(aHits[i].iDSNumber, aiDrop) <> -1) ;
                Move True to bLive         // reused: "has a menu-converter hit at all"
        Loop
        If (bLive = False or SizeOfArray(aiDrop) = 0) ;
            Function_Return aHits
        Move (Lowercase(vFolderFormat(ExtractFilePath(sFullFileName)))) to sFolder
        Move (Lowercase(ExtractFileName(sFullFileName))) to sLeaf
        Get pasMenuMapFiles to asScanFiles
        If (SizeOfArray(asScanFiles) > 0) Begin
            If (psMenuMapFolder(Self) <> "*") Begin
                Get _CJMenuUseMapForFiles of ghoFuncLib asScanFiles sFolder to asMap
                Set pasMenuMap to asMap
                Set psMenuMapFolder to "*"
            End
        End
        Else If (sFolder <> psMenuMapFolder(Self)) Begin
            Get _CJMenuUseMapForFolder of ghoFuncLib sFolder to asMap
            Set pasMenuMap to asMap
            Set psMenuMapFolder to sFolder
        End
        Get pasMenuMap to asMap
        Get _CJProgramsPullingIn of ghoFuncLib sLeaf (&asMap) 0 to asProgs
        Move (SizeOfArray(asProgs) > 0) to bLive
        If (bLive = True) ;
            Function_Return aHits
        // Not reached. Named by no menu, and not a menu file itself: it may be Used - kept, as Explain.
        Move (Right(sLow, 3) = ".mn" or Right(sLow, 4) = ".mnu" or Right(sLow, 4) = ".inc") to bMenuFile
        Get _CJMapNamesLeaf of ghoFuncLib sLeaf (&asMap) to bNamed
        If (bMenuFile = False and bNamed = False) Begin
            Move ("No program's menu reaches this file, so the menu converter cannot: it converts a program's " ;
                + "DFCreate_Menu block, a .mn / .mnu file the program Uses, and what those #Include. If a " ;
                + "program still Uses this file, port its menu by hand; if nothing does, it is dead code " ;
                + "(the UnusedSourceFiles report lists such files).") to sHint
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (SearchArray(aHits[i].iDSNumber, aiDrop) <> -1) Begin
                    Move eModExplain to aHits[i].eCategory
                    Move ""          to aHits[i].sRefactorFn
                    Move sHint       to aHits[i].sHint
                End
            Loop
            Function_Return aHits
        End
        // Only the menu converter's rules go - by the converter they name, never by caption.
        Move (SizeOfArray(aHits) - 1) to iLast
        For i from 0 to iLast
            If (SearchArray(aHits[i].iDSNumber, aiDrop) = -1) ;
                Move aHits[i] to aOut[SizeOfArray(aOut)]
        Loop
        Function_Return aOut
    End_Function

    Function ScanFileCached String sFullFileName tDeepScanRule[] ByRef aRules tDeepScanCache ByRef Cache Boolean ByRef bFromCache Returns tDeepScanHit[]
        tDeepScanFileCacheEntry Entry
        tDeepScanHit[] aHits
        String[] asCode
        String sLow
        DateTime dtWrite
        Integer iSize iIdx

        Move (Lowercase(sFullFileName))            to sLow
        Move (rfFileDate(sFullFileName))           to dtWrite
        Move (rfFileSizeLive(sFullFileName))       to iSize
        Move (SearchArray(sLow, Cache.asPathsLow)) to iIdx
        If (iIdx >= 0) Begin
            If (Cache.aEntries[iIdx].dtLastWrite = dtWrite and Cache.aEntries[iIdx].iFileSize = iSize) Begin
                Move True to bFromCache
                Move Cache.aEntries[iIdx].aHits to aHits
                // Liveness is re-judged on every Check, cached hits or not (see the function).
                Get _DropDeadMenuFileHits sFullFileName aHits (&aRules) to aHits
                Function_Return aHits
            End
        End
        Move False to bFromCache
        Move (rfReadEncodedFileAsStringArray(sFullFileName)) to asCode
        Get ScanLines (&asCode) (&aRules) to aHits
        Get _DropLanguageFileConstHits sFullFileName aHits (&aRules) to aHits
        Move sLow    to Entry.sFileLow
        Move dtWrite to Entry.dtLastWrite
        Move iSize   to Entry.iFileSize
        Move aHits   to Entry.aHits
        If (iIdx >= 0) ;
            Move Entry to Cache.aEntries[iIdx]
        Else Begin
            Move sLow  to Cache.asPathsLow[SizeOfArray(Cache.asPathsLow)]
            Move Entry to Cache.aEntries[SizeOfArray(Cache.aEntries)]
        End
        // The cache keeps the file's OWN hits; what a dead menu file loses is decided afterwards.
        Get _DropDeadMenuFileHits sFullFileName aHits (&aRules) to aHits
        Function_Return aHits
    End_Function

    // Convert one file's scan hits into synthetic compiler-message rows - the analyzer
    // grid / fix-plan currency (tCompileError). bDeepScan marks them for the "DS <n>"
    // message token; iErrorNo carries the rule's stable DS number, which the recipe table
    // ALSO carries (cModAnalyzer._AddDeepScanRecipes), so ClassifyFromRecipes and
    // PlanFromMessages route them exactly like compiler messages - one matcher for the
    // grid AND the plan, per the golden rule. The hit's OWN verdict rides along too
    // (eScanCategory / sScanFn / sScanHint): one rule's hits are not all alike, and the
    // recipe keyed by its number cannot know which were demoted - see VerifyScanVerdict.
    Function HitsToMessages tDeepScanHit[] aHits String sFileName Returns tCompileError[]
        tCompileError[] aMsgs
        tCompileError Msg
        Integer i iLast

        Move (SizeOfArray(aHits) - 1) to iLast
        For i from 0 to iLast
            Move False              to Msg.bError
            Move True               to Msg.bDeepScan
            Move aHits[i].iDSNumber to Msg.iErrorNo
            Move aHits[i].iLine     to Msg.iLine
            Move sFileName          to Msg.sFileName
            Move aHits[i].sSymbol   to Msg.sErrorTxt
            Move ""                 to Msg.sText
            Move aHits[i].eCategory   to Msg.eScanCategory
            Move aHits[i].sRefactorFn to Msg.sScanFn
            Move aHits[i].sHint       to Msg.sScanHint
            Move Msg to aMsgs[SizeOfArray(aMsgs)]
        Loop
        Function_Return aMsgs
    End_Function

End_Class
