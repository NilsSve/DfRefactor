// DropSelfConfirmFT.dg
//
// The FlexTron twin of DropSelfConfirm.dg: the same question - "replace 'oBar(Self)' with
// 'oBar'?" - asked once per candidate, with the same two options the user can carry to the
// next one, and the same answer. Only the buttons differ: Yes / No / Cancel are framework
// buttons (cFTWebButton, RDCFlexTron) on a grid host of 8 px columns, as in the other FT
// dialogs.
//
// HOW DFRefactorFT GETS THIS ONE. The editor packages Use the dialog themselves
// (cRefactorEditorCommands.pkg), and every program that edits code gets it through them. So
// DFRefactorFT.src Uses this file BEFORE them, and this file defines C_OwnDropSelfConfirm;
// cRefactorEditorCommands.pkg then leaves DropSelfConfirm.dg out. Both files define the same
// object, oDropSelfConfirm_dg - the editor reaches the dialog by that name - so the two must
// never both be in: used after the editor packages, this file stops the build (below).
//
// THE RETURN VALUE is DropSelfConfirm.dg's, bit for bit: MBR_Yes / MBR_No / MBR_Cancel OR-ed
// with CI_DropSelfPadded and CI_DropSelfRemember, which cRefactorEditorCommands decodes.

Use Windows.pkg
Use cFTModalPanel.pkg
Use cFTCheckBoxCaption.pkg      // a check box's caption the FT colours reach
Use cFTGridHost.pkg             // the answer's host - a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg  // cFTWebButton - Yes, No and Cancel

// DropSelfConfirm.dg defines the two answer bits too. If they exist already, it is in the
// program - this file came after the editor packages, and there would be two oDropSelfConfirm_dg.
#IFDEF CI_DropSelfPadded
#ERROR DFERR_PROGRAM "Use DropSelfConfirmFT.dg before the editor packages - DropSelfConfirm.dg is in the program already."
#ENDIF

// Tells cRefactorEditorCommands.pkg to leave DropSelfConfirm.dg out.
Define C_OwnDropSelfConfirm for 1

// The two checkbox bits, at DropSelfConfirm.dg's values (MessageBox2's MBR_CHECKED and
// MBR_CHECKED2 before that).
Define CI_DropSelfPadded   for |CI$01000000
Define CI_DropSelfRemember for |CI$02000000

Object oDropSelfConfirm_dg is a cFTModalPanel
    Set Size to 108 268
    Set Label to "Change into suggestion?"
    Set Locate_Mode to CENTER_ON_PARENT

    // What the caller gets back, assembled on the way out. A property rather than a
    // return value because a ModalPanel's buttons cannot return one - Popup does.
    Property Integer piAnswer 0

    Object oQuestion_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 26 250
        Set Location to 8 9
        Set Label to ""
    End_Object

    /* THE TWO OPTIONS: a check box, and its caption beside it (cFTCheckBoxCaption). The panel gives its children
       the FT colours, and a check box's own caption stays in the Windows theme's colour - unreadable on the dark
       ground, as CmdLineIniFileExporterFT's were. A click on a caption ticks its box. */
    Object oPadded_cb is a CheckBox
        Set Size to 10 10
        Set Location to 42 11
        Set Label to ""
        On_Key kEnter Send AnswerNo    // Enter answers No - see AnswerNo
    End_Object

    Object oPadded_tb is a cFTCheckBoxCaption
        Set Location to 43 22
        Set Label to "Keep same width padded with spaces"
        Set phoCheckBox to (oPadded_cb(Self))
    End_Object

    Object oRemember_cb is a CheckBox
        Set Size to 10 10
        Set Location to 56 11
        Set Label to ""
        On_Key kEnter Send AnswerNo    // Enter answers No - see AnswerNo
    End_Object

    Object oRemember_tb is a cFTCheckBoxCaption
        Set Location to 57 22
        Set Label to "Remember the choice for this object"
        Set phoCheckBox to (oRemember_cb(Self))
    End_Object

    /* YES / NO / CANCEL, in Studio's order at the bottom right - framework buttons on a grid host of
       8 px columns, where the three native buttons sat. No keeps the default the old call gave it
       (MB_DEFBUTTON2): Enter answers No (AnswerNo, below), and No wears the main action's amber.
       This dialog can be asked many times in one run, and a held-down Enter should not rewrite a file.
       A check on Yes, an x on No and a stop sign on Cancel, which ends the run: the three are told
       apart by their shape, not by colour. Each answers in OnButtonClick, after the web click has
       returned (the library's click relay) - Answer closes the panel, which cannot happen inside the
       click. The spans fit the captions: Yes and No at the 78 px minimum, Cancel ~78 px with its glyph. */
    Object oAnswerBar is a cFTGridHost
        Set Location to 76 76
        Set Size to 20 188
        Set peAnchors to anBottomRight
        Set piColumnCount to 35         // column 0, then Yes' 11, No's 11 and Cancel's 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oYesBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Yes"
            Set psCSSClass to "ftbtn ftg-check"
            Set psToolTip to "Make this change, then go on to the next one."

            Procedure OnButtonClick
                Send Answer of oDropSelfConfirm_dg MBR_Yes
            End_Procedure
        End_Object

        Object oNoBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 11
            Set psCaption to "No"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-close"
            Set psToolTip to "Leave this one as it is, and go on to the next one. Enter answers No."

            Procedure OnButtonClick
                Send Answer of oDropSelfConfirm_dg MBR_No
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 23
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-stop"
            Set psToolTip to "Stop here. The changes you already made stay; nothing more is asked."

            Procedure OnButtonClick
                Send Answer of oDropSelfConfirm_dg MBR_Cancel
            End_Procedure
        End_Object
    End_Object

    // Fold the two checkbox states into the answer and close. One place builds the
    // return value, so the three buttons cannot disagree about its shape.
    Procedure Answer Integer iButton
        Integer iRetVal
        Move iButton to iRetVal
        If (Checked_State(oPadded_cb(Self))) ;
            Move (iRetVal ior CI_DropSelfPadded) to iRetVal
        If (Checked_State(oRemember_cb(Self))) ;
            Move (iRetVal ior CI_DropSelfRemember) to iRetVal
        Set piAnswer to iRetVal
        Send Close_Panel
    End_Procedure

    // The title-bar icon, set the way ScintillaFind / Replace / Goto set theirs - on
    // Page rather than in the object body, because the panel needs its window before an
    // icon can be attached to it.
    Procedure Page Integer iPageObject
        Forward Send Page iPageObject
        Set Icon to "Default.ico"
    End_Procedure

    // Escape means Cancel, not "No" - stopping the run is a different decision from
    // declining this one line. Its own parameterless procedure because On_Key cannot
    // carry an argument.
    Procedure AnswerCancel
        Send Answer MBR_Cancel
    End_Procedure

    On_Key kCancel Send AnswerCancel

    /* Enter means No, as it did when No was the dialog's default button. The two check boxes bind it,
       not the panel: the focus starts on them, and a web button that has the focus takes its own
       Enter - a binding on the whole panel could answer No on top of it. */
    Procedure AnswerNo
        Send Answer MBR_No
    End_Procedure

    /* The entry point. Fills the dialog, shows it, and hands back the encoded answer.
       Written as a function so the call site reads as one question and one answer
       rather than a set-up, a popup and a read. */
    Function Ask String sQuestion Boolean bPadded Boolean bRemember Returns Integer
        Set Label         of oQuestion_tb to sQuestion
        Set Checked_State of oPadded_cb   to bPadded
        Set Checked_State of oRemember_cb to bRemember
        Set piAnswer to MBR_Cancel      // closed by the window frame = Cancel
        Send Popup
        Function_Return (piAnswer(Self))
    End_Function

End_Object
