    Object oChangeCallToSend is a cTestFixture
        Set psFunctionName to "ChangeCallToSend"

        // Call <procedure> [args] -> Send <procedure> [args]; the name + args ride through intact.
        {Published = True}
        Procedure ChangeCallToSend_Basic
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Call MyProc value1 value2' to sLine
            Move 'Send MyProc value1 value2' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCallToSend of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure ChangeCallToSend_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        Call DoWork' to sLine
            Move '        Send DoWork' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCallToSend of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A longer identifier that merely STARTS with 'Call' must NOT be swapped (whole-token match).
        {Published = True}
        Procedure ChangeCallToSend_NoMatchPrefix
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Callback Foo' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCallToSend of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Callback Foo' sLine
        End_Procedure

    End_Object
