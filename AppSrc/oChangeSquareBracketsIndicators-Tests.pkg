    Object oChangeSquareBracketsIndicators is a cTestFixture
        Set psFunctionName to "ChangeSquareBracketsIndicators"

        { Published = True }
        Procedure ChangeSquareBracketsIndicators_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [Found ~Found] Begin' to sLine
            Move '    If (Found and Not(Found)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        { Published = True }
        Procedure ChangeSquareBracketsIndicators_2
            // Regression test: an array-index bracket [0] that appears inside a parenthesised
            // expression must NOT be treated as an indicator bracket.
            // Bug: the while loop operated on sOverstrikeLine which does not mask paren content,
            //      so [0] in daPeriodDates[0] was incorrectly converted to (select).
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[select] Indicate select as (from_datum = daPeriodDates[0])' to sLine
            Move 'If (select) Indicate select as (from_datum = daPeriodDates[0])' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-10): the UI parameter combo stores the enum NAME
        // ("eModernizeSelect") in Functions.Parameter and the engine passes it verbatim.
        // The old bare Move of that name into the Integer enum left the gate at
        // eLeaveSelect, so the opt-in never worked from the UI - only in tests, which
        // pass the numeric constant. _ParameterIsEnum accepts both forms; this is the
        // NAME-string twin of test _2.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SelectByParameterName
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[select] Indicate select as (from_datum = daPeriodDates[0])' to sLine
            Move 'If (select) Indicate select as (from_datum = daPeriodDates[0])' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) "eModernizeSelect" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-10): invoke EXACTLY the way cRefactorEngine does - a DYNAMIC
        // message id (Eval) with the parameter in a variable, not a direct compile-time
        // call. The direct-call tests were green while the engine run still ignored the
        // parameter; this pins the engine's dispatch style. (The fix: the gate no longer
        // consults num_arguments, which is unreliable across dispatch styles - "" simply
        // matches nothing.)
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_EngineStyleInvocation
            String sLine sExpected sParameter
            Boolean bChanged
            Integer iFunctionID
            tTokenizer TokenizerData
            Move '[select] Indicate select as (from_datum = daPeriodDates[0])' to sLine
            Move 'If (select) Indicate select as (from_datum = daPeriodDates[0])' to sExpected
            Move "eModernizeSelect" to sParameter
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Move (Eval("get_" - "ChangeSquareBracketsIndicators")) to iFunctionID
            Get iFunctionID of ghoFuncLib (&sLine) sParameter to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Line with no bracket indicator must be returned unchanged and return False.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move x to y" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move x to y" sLine
        End_Procedure

        // Single indicator at start of line: "If" must be prepended; also verifies bChanged = True.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SimpleSingleIndicator
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[Found]" to sLine
            Move "If (Found)" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Tilde (~) in isolation must produce Not() expression.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TildeNegation
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[~bActive]" to sLine
            Move "If (Not(gbbActive))" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Lines containing GROUP must not be converted (guard returns False unchanged).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_GroupGuard
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[select] Group" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "[select] Group" sLine
        End_Procedure

        // Repeat keyword: indicator expression becomes the While condition.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_RepeatToWhile
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[bRunning] Repeat" to sLine
            Move "While (gbbRunning)" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Loop keyword: '[cond] Loop' is a conditional loop-BACK, so it becomes the post-test 'Until (Not(cond))'
        // - keeping the exit test. A bare 'Loop' would spin forever (LegacyApp files.nui '[~seqeof] loop').
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_LoopToUntil
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[bRunning] Loop" to sLine
            Move "Until (Not(gbbRunning))" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The negated form collapses its double-negative: '[~seqeof] loop' -> 'Until (seqeof)' (LegacyApp files.nui).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TildeLoopToUntil
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[~seqeof] loop" to sLine
            Move "Until (seqeof)" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // 'not [indicator]' (negation OUTSIDE the bracket) is skipped: the bare 'not' before '[Found]' mangles to
        // a dangling 'Until (not)' -> bogus '~' (LegacyApp TIDR/over051). Left as the obsolete-indicator warning.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_NotBeforeBracketSkipped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Until not [Found]" to sLine
            Move "Until not [Found]" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression: with the default eLeaveSelect, the [select] bracket is left untouched
        // (SELECT is an old-FMAC macro with no valid modern bare form).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SelectLeftAloneByDefault
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[select] Indicate select as (from_datum = daPeriodDates[0])' to sLine
            Move '[select] Indicate select as (from_datum = daPeriodDates[0])' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression: a LEADING bracket + If + Indicate compound must be left unchanged - converting the
        // leading bracket would yield "If (Found) If sCustCode ne "" Indicate ..." (double-If garbage).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_LeadingBracketIfIndicateCompound
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        [Found] If sCustCode ne "" Indicate Found as Billto.Cust_Code eq sCustCode' to sLine
            Move '        [Found] If sCustCode ne "" Indicate Found as Billto.Cust_Code eq sCustCode' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // ...and the same compound spelled with Ind, Indicate's obsolete spelling (GitHub 2026-10-06).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_LeadingBracketIfIndCompound
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        [Found] If iCount ne 0 ind ready as Invoice.Qty gt 0' to sLine
            Move '        [Found] If iCount ne 0 ind ready as Invoice.Qty gt 0' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // AN ELSE IN FRONT (2026-10-06): a bracket behind an Else became an expression with no If -
        // 'Else (found) Move 1 to iCount', which does not compile. The If goes in after the Else now.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_ElseBracketGetsItsIf
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Else [found] Move 1 to iCount' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    Else If (found) Move 1 to iCount' sLine
            Send Assert bChanged
            Move 'Else [~found] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'Else If (Not(found)) Begin' sLine
            Send Assert bChanged
        End_Procedure

        // Regression: a space right after "[" (e.g. "[ Found]") used to leave the line un-refactored - the
        // lone "[" token seeded an empty FirstBoolean and the bracket flag was lost. The tokenizer now merges
        // a lone "[" into the next token (mirrors the lone-"]" merge), so it parses like "[Found]".
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SpaceAfterLeftBracket
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[ Found] Begin' to sLine
            Move 'If (Found) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-25): a BARE array-index bracket "[0]" (not inside parens) in an
        // indexed-property Set must NOT be treated as a boolean indicator. It was mangled to
        // "Set (Form_Datatype)". _IsIndicatorStatement now rejects numeric bracket bodies. This is
        // the unmasked twin of test _2 (where daPeriodDates[0] is masked by | pipes inside parens).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_ArrayIndexNotIndicator
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            Set Form_Datatype [0] to Mask_Window' to sLine
            Move '            Set Form_Datatype [0] to Mask_Window' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression twin: spaces on BOTH sides "[ Found ]" (lone "[" + lone "]") also normalize.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SpacesBothSidesBracket
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[ Found ] Begin' to sLine
            Move 'If (Found) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-25): a NEGATED square indicator with a SPACE after the tilde, "[~ err]",
        // tokenizes as "[~" + "err]" - the name was stranded, so the line was never modernized and
        // recurred after every recompile. Must become If (Not(err)) ... like the glued "[~err]" form.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TildeSpaceNegation
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[~ err] Begin' to sLine
            Move 'If (Not(err)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Twin: spaces on BOTH sides of the negated indicator "[ ~ err ]" also normalize (the lone-[ and
        // lone-] edge merges collapse it to "[~" + "err]", then the tilde-space fix pulls the name).
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TildeSpacesBothSides
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[ ~ err ] Begin' to sLine
            Move 'If (Not(err)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-25): a TAB before "to" in an indicator-prefixed Move used to mangle to
        // "If (Found) Move (CodeType.Description<TAB>to)" (destination dropped, src+to paren-wrapped),
        // because the overstrike fast-path left the tab in, gluing "Description<TAB>to" into one token so
        // "to" was never seen as the keyword. Tabs now normalize to a space and the Move stays intact.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TabBeforeToInMove
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move ('[Found] Move CodeType.Description' + (Character(9)) + 'to RetVal') to sLine
            Move 'If (Found) Move CodeType.Description to RetVal' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Shared safety net (_IndicatorLineIsMalformed) used by BOTH indicator converters to revert a broken
        // conversion. Tested DIRECTLY: the full-file ';)' mangle (LegacyApp UFUNC.INC '[FINDERR];  Begin' ->
        // '(FINDERR;)', err 52) and the conditionless-If mangle are context-dependent and don't reliably
        // reproduce single-line, but the detector itself is pure.
        {Published = True}
        Procedure IndicatorLineIsMalformed_SwallowedSemicolon
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'If (FINDERR;) Begin' '[FINDERR]; Begin' to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        Procedure IndicatorLineIsMalformed_ConditionlessIf
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'If Move (0) to gbiOK' '[iOK] Move 0 to gbiOK' to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        Procedure IndicatorLineIsMalformed_ParenthesisedCompoundKept
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'If (gbP_END and (gbX eq Y)) Error 107' '[P_END] If X eq Y Error 107' to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        Procedure IndicatorLineIsMalformed_PlainMoveKept
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'Move (True) to Found' 'Indicate Found as True' to bResult
            Send AssertFalse bResult
        End_Procedure

        // A 'begin' block-opener dropped during conversion orphans the matching 'end' (4348/4326; LegacyApp
        // files.nui 'ifnot [seqeof] begin'). The guard reverts; the real fix keeps 'begin' (test
        // ChangeLegacyIndicators_72), this is the safety net for any other path that loses it.
        {Published = True}
        Procedure IndicatorLineIsMalformed_BeginDropped
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'ifnot (seqeof)' 'ifnot [seqeof] begin' to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        Procedure IndicatorLineIsMalformed_BeginKept
            Boolean bResult
            Get _IndicatorLineIsMalformed of ghoFuncLib 'ifnot (seqeof) begin' 'ifnot [seqeof] begin' to bResult
            Send AssertFalse bResult
        End_Procedure

        // A bracketed built-in indicator ALREADY prefixed with 'If' - 'If [FINDERR] Begin' - modernizes the
        // bracket in place to 'If (FINDERR) Begin' (the existing 'If' stays; no double-If, because the line no
        // longer starts with "("). NOTE: the DF compiler emits NO obsolete-indicator warning for a bracketed
        // built-in like [FINDERR], so the Modernization Analyzer (driven by .prn output) never surfaces it -
        // "it doesn't trigger there" is expected, not a bug. A manual/explicit indicator run still fixes it.
        // (Nils walked the LegacyApp grid, 2026-07-01.)
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_IfFinderrBegin
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If [FINDERR] Begin' to sLine
            Move 'If (FINDERR) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (LegacyApp 2026-07-05): legacy SPACED array indexing - an identifier, then
        // spaces, then '[index]' - is NOT an indicator group. The converter mangled
        // 'Move asNames [iCount ] to sTerm' into 'Move (asNames)', dropping the index AND the
        // destination (_IsIndexBracket now classifies it as an index; the numeric-body guard could
        // not, because the body is an identifier). The line must be left untouched.
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_SpacedArrayIndexUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                Move asNames [iCount ] to sTerm ' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '                Move asNames [iCount ] to sTerm ' sLine
        End_Procedure

        /* A #HEADER ... #ENDHEADER region is PRECOMPILED into <program>.pkd, and rewriting a
           line inside it invalidates that .pkd silently: the compiler only warns and then
           compiles against the stale symbol table, reporting errors that describe nothing in
           the source. This is the exact line of ChangeSquareBracketsIndicators_1 - which the
           converter SHOULD rewrite normally - and it must survive verbatim inside a header
           (389 phantom errors on LegacyApp's main .src, Nils 2026-07-26). */
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_InsideHeaderRegionUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Get Tokenizer of ghoFuncLib '#HEADER' to TokenizerData
            Move '    [Found ~Found] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = True)
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    [Found ~Found] Begin' sLine
        End_Procedure

        /* The same line, in a #COMMAND macro OUTSIDE any header, positioned the way the real
           macro positions it: past a Function closed by End_Procedure (the mismatch the lexer
           deliberately tolerates) and past a complete Procedure. The bracket guards a goto
           label, so converting it here breaks the macro for every caller.

           The bIsInCommand guard at the top of this converter was always correct - the LEXER
           was dropping the flag. End_Function / End_Procedure called the blanket
           _ClearRefactoringProperties, which wipes EVERY scope flag including pbInCommand, so
           only a macro's first few lines were ever protected. */
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_MacroBodyAfterMethodEndUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Get Tokenizer of ghoFuncLib '#COMMAND Deferred_Panel R' to TokenizerData
            Send Assert (TokenizerData.bIsInCommand = True)
            Get Tokenizer of ghoFuncLib '    Function !1_Handle Returns Handle' to TokenizerData
            Get Tokenizer of ghoFuncLib '        Function_Return hoView' to TokenizerData
            Get Tokenizer of ghoFuncLib '    End_Procedure' to TokenizerData
            Get Tokenizer of ghoFuncLib '    Procedure !1' to TokenizerData
            Get Tokenizer of ghoFuncLib '    End_Procedure' to TokenizerData

            Move '    [Found ~Found] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send Assert (TokenizerData.bIsInCommand = True)
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    [Found ~Found] Begin' sLine
        End_Procedure

        // 'ifnot [seqeof] begin' (2026-09-07): the one line of a 145-file run this converter touched came out
        // as 'ifnot ( and seqeof) begin' - an empty left operand joined by 'and'. ChangeLegacyIndicators makes
        // it 'ifnot (seqeof) begin' (its test 72); this function must say the same.
        { Published = True }
        { Description = "A leading ifnot with one bracket indicator converts to ifnot (name), never to an empty operand" }
        Procedure ChangeSquareBracketsIndicators_IfNotBracket
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot [seqeof] begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'ifnot (seqeof) begin' sLine
        End_Procedure

        /* TWO BOOLEANS IN TWO BRACKETS (2026-11-01): '[A] [B] Clear Inv' put the condition in twice - 'If (A and B) (A
           and B) Clear Inv' - and '[A][B]' was one indicator 'A][B'. Both are converted as '[A B]'. An array index
           opens no statement and is never read as a bracket of booleans. */
        { Published = True }
        Procedure ChangeSquareBracketsIndicators_TwoBracketsAreOneCondition
            String[] asIn asExpected
            String sLine sRest
            Boolean bChanged
            Integer i
            tTokenizer TokenizerData
            Move '    [Ready] [~Found] Clear Inv'                    to asIn[0]
            Move '    If (gbReady and Not(Found)) Clear Inv'         to asExpected[0]
            Move '    [Ready][~Found] Move 1 to iCount'              to asIn[1]
            Move '    If (gbReady and Not(Found)) Move 1 to iCount'  to asExpected[1]
            Move '    [~Ready][~Found] Loop'                         to asIn[2]
            Move '    Until (Not(Not(gbReady) and Not(Found)))'      to asExpected[2]
            For i from 0 to (SizeOfArray(asIn) - 1)
                Move asIn[i] to sLine
                Get Tokenizer of ghoFuncLib sLine to TokenizerData
                Get ChangeSquareBracketsIndicators of ghoFuncLib (&sLine) "" to bChanged
                Send AssertSAreEqual asExpected[i] sLine
            Loop
            Get _LeadingTwoBooleans of ghoFuncLib "    Move aGrid[i][j] to iX" False (&sRest) to sLine
            Send AssertSAreEqual "" sLine
            Get _LeadingTwoBooleans of ghoFuncLib "    [Not Found] [Ready] Begin" False (&sRest) to sLine
            Send AssertSAreEqual "" sLine
            Get _LeadingTwoBooleans of ghoFuncLib "    [A] [B] [C] Begin" False (&sRest) to sLine
            Send AssertSAreEqual "" sLine
        End_Procedure

    End_Object
