    // Unit tests for RemovePropertyPrivate (eOtherFunction). It strips 'Private' from Property declarations
    // EXCEPT a property that backs a same-named custom 'Procedure Set'/'Function' (the private-backing-store
    // idiom), where Private is load-bearing - removing it collides the auto accessor with the custom one and
    // un-registers the property (every access then 4328-undefined; LegacyApp hit this on PMINIMUMSIZE /
    // P_AUTO_COLUMN / CDDRecordSet.Current_Record). Whole-file 2-pass: collect accessor names, then strip
    // Private only from the safe properties. ClearFuncLibProperties is sent first (as the engine does before
    // every eOtherFunction) so the stateful tokeniser starts clean.
    Object oRemovePropertyPrivate is a cTestFixture
        Set psFunctionName to "RemovePropertyPrivate"

        // A plain Private property (no same-named accessor) loses Private; one line changed.
        {Published = True}
        Procedure RemovePropertyPrivate_PlainStripped
            Integer iResult
            String[] asCode
            Move 'Property Boolean pbState Private' to asCode[0]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send AssertSAreEqual 'Property Boolean pbState' asCode[0]
        End_Procedure

        // Lowercase keyword is also removed.
        {Published = True}
        Procedure RemovePropertyPrivate_LowercaseStripped
            Integer iResult
            String[] asCode
            Move 'Property Boolean pbState private' to asCode[0]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertSAreEqual 'Property Boolean pbState' asCode[0]
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure RemovePropertyPrivate_IndentPreserved
            Integer iResult
            String[] asCode
            Move '    Property String psName Private' to asCode[0]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertSAreEqual '    Property String psName' asCode[0]
        End_Procedure

        // Non-property lines are untouched and report 0 changes.
        {Published = True}
        Procedure RemovePropertyPrivate_NonPropertyNoChange
            Integer iResult
            String[] asCode
            Move 'Move sA to sB' to asCode[0]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual 'Move sA to sB' asCode[0]
        End_Procedure

        // A comment line is never touched.
        {Published = True}
        Procedure RemovePropertyPrivate_CommentNoChange
            Integer iResult
            String[] asCode
            Move '// Property Boolean pbState Private' to asCode[0]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual '// Property Boolean pbState Private' asCode[0]
        End_Procedure

        // BACKING-STORE GUARD: a Private property paired with a same-named 'Procedure Set' AND 'Function'
        // KEEPS Private (removing it would collide the auto accessor with the custom one). 0 changes.
        {Published = True}
        Procedure RemovePropertyPrivate_BackingStoreKept
            Integer iResult
            String[] asCode
            Move '    Property Integer pMinimumSize Private 0'           to asCode[0]
            Move '    Procedure Set pMinimumSize Integer x# Integer y#'  to asCode[1]
            Move '    End_Procedure'                                     to asCode[2]
            Move '    Function pMinimumSize Returns Integer'             to asCode[3]
            Move '        Function_Return 0'                             to asCode[4]
            Move '    End_Function'                                      to asCode[5]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual '    Property Integer pMinimumSize Private 0' asCode[0]
        End_Procedure

        // The setter alone (Procedure Set <name>) is enough to protect the backing property.
        {Published = True}
        Procedure RemovePropertyPrivate_SetterOnlyKept
            Integer iResult
            String[] asCode
            Move 'Property Integer p_Auto_Column Private 1'  to asCode[0]
            Move 'Procedure Set p_Auto_Column Integer col#' to asCode[1]
            Move 'End_Procedure'                            to asCode[2]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual 'Property Integer p_Auto_Column Private 1' asCode[0]
        End_Procedure

        // MIXED: a backing-store property is KEPT while an unrelated plain Private property in the same file
        // is still stripped - the guard is per-name, not whole-file-off.
        {Published = True}
        Procedure RemovePropertyPrivate_MixedKeepsAndStrips
            Integer iResult
            String[] asCode
            Move 'Property Integer pMinimumSize Private 0' to asCode[0]
            Move 'Procedure Set pMinimumSize Integer x#'   to asCode[1]
            Move 'End_Procedure'                           to asCode[2]
            Move 'Property Boolean pbPlain Private'         to asCode[3]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send AssertSAreEqual 'Property Integer pMinimumSize Private 0' asCode[0]
            Send AssertSAreEqual 'Property Boolean pbPlain' asCode[3]
        End_Procedure

        // QUALIFIED-ACCESS GUARD: a property reached via 'class.property' (a VDFQuery mixin idiom) registers
        // under its scoped Private name; stripping Private breaks every qualified access (4328; LegacyApp aps.pkg
        // on aps_panel_mx.p_resize_in_progress). The dotted use must KEEP Private even with no same-named
        // accessor. 0 changes.
        {Published = True}
        Procedure RemovePropertyPrivate_QualifiedAccessKept
            Integer iResult
            String[] asCode
            Move 'Property Integer p_resize_in_progress Private 1'        to asCode[0]
            Move 'ifnot (aps_panel_mx.p_resize_in_progress(self)) Begin'  to asCode[1]
            Move 'End'                                                    to asCode[2]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual 'Property Integer p_resize_in_progress Private 1' asCode[0]
        End_Procedure

        // --- WouldRemovePropertyChange: the analyzer's FAST demote check. It must give the SAME yes/no as
        //     actually running RemovePropertyPrivate/Public (that full run over ~hundreds of files was 26s of
        //     the analyze), so each test also asserts bWould = (real iChanges > 0). ---

        // A strippable plain Private -> True, and the real run agrees.
        {Published = True}
        Procedure WouldRemovePropertyChange_PlainPrivateTrue
            Integer iResult
            Boolean bWould
            String[] asCode asRun
            Move 'Property Boolean pbState Private' to asCode[0]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWould
            Send Assert bWould
            Move asCode to asRun
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asRun) "" to iResult
            Send Assert (bWould = (iResult > 0))
        End_Procedure

        // Backing-store-only file: the real function changes nothing, so the check is False (this is the very
        // case the demote exists for - PMINIMUMSIZE / APS_* recurring as Auto-fix).
        {Published = True}
        Procedure WouldRemovePropertyChange_BackingStoreFalse
            Integer iResult
            Boolean bWould
            String[] asCode asRun
            Move '    Property Integer pMinimumSize Private 0'          to asCode[0]
            Move '    Procedure Set pMinimumSize Integer x# Integer y#' to asCode[1]
            Move '    End_Procedure'                                    to asCode[2]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWould
            Send AssertFalse bWould
            Move asCode to asRun
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asRun) "" to iResult
            Send Assert (bWould = (iResult > 0))
        End_Procedure

        // Mixed: a backing store + an unrelated plain Private -> the file WOULD change (the plain one strips).
        {Published = True}
        Procedure WouldRemovePropertyChange_MixedTrue
            Integer iResult
            Boolean bWould
            String[] asCode asRun
            Move 'Property Integer pMinimumSize Private 0' to asCode[0]
            Move 'Procedure Set pMinimumSize Integer x#'   to asCode[1]
            Move 'End_Procedure'                           to asCode[2]
            Move 'Property Boolean pbPlain Private'         to asCode[3]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWould
            Send Assert bWould
            Move asCode to asRun
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asRun) "" to iResult
            Send Assert (bWould = (iResult > 0))
        End_Procedure

        // Qualified 'class.property' use protects the Private -> no change -> False.
        {Published = True}
        Procedure WouldRemovePropertyChange_QualifiedFalse
            Boolean bWould
            String[] asCode
            Move 'Property Integer p_resize_in_progress Private 1'        to asCode[0]
            Move 'ifnot (aps_panel_mx.p_resize_in_progress(self)) Begin'  to asCode[1]
            Move 'End'                                                    to asCode[2]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWould
            Send AssertFalse bWould
        End_Procedure

        // A // comment property line is never a change.
        {Published = True}
        Procedure WouldRemovePropertyChange_CommentFalse
            Boolean bWould
            String[] asCode
            Move '// Property Boolean pbState Private' to asCode[0]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWould
            Send AssertFalse bWould
        End_Procedure

        // Public is unconditional (no backing-store PASS): any 'Property ... Public' line -> True.
        {Published = True}
        Procedure WouldRemovePropertyChange_PublicTrue
            Boolean bWould
            String[] asCode
            Move 'Property Integer piCount Public 0' to asCode[0]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "public" to bWould
            Send Assert bWould
        End_Procedure

        // No property at all -> False for both keywords.
        {Published = True}
        Procedure WouldRemovePropertyChange_NoPropertyFalse
            Boolean bWouldPriv bWouldPub
            String[] asCode
            Move 'Move sA to sB' to asCode[0]
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "private" to bWouldPriv
            Get WouldRemovePropertyChange of ghoFuncLib (&asCode) "public" to bWouldPub
            Send AssertFalse bWouldPriv
            Send AssertFalse bWouldPub
        End_Procedure

        /* A PRIVATE PROPERTY READ THROUGH '!$.' KEEPS PRIVATE (2026-09-07): '!$' is the current-class macro,
           so '!$.pMin' is a class.property access that registers under the scoped Private name. Stripping
           Private left 40 such reads undefined in one class. */
        {Published = True}
        { Description = "A Private property accessed as !$.name keeps Private" }
        Procedure RemovePropertyPrivate_ClassMacroAccessKeepsPrivate
            Integer iResult
            String[] asCode
            Move 'Class cScale is a cObject'                 to asCode[0]
            Move '  Procedure Construct_Object'              to asCode[1]
            Move '    Forward Send Construct_Object'         to asCode[2]
            Move '    Property Number pMin Private 0'        to asCode[3]
            Move '  End_Procedure'                           to asCode[4]
            Move '  Function Range Returns Number'           to asCode[5]
            // the '!' is built at run time (Character(33)): a literal '!' sequence in source is macro syntax
            Move ('    Function_Return (' + Character(33) + '$.pMin(Self) * 2)')   to asCode[6]
            Move '  End_Function'                            to asCode[7]
            Move 'End_Class'                                 to asCode[8]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual '    Property Number pMin Private 0' asCode[3]
        End_Procedure

        // One class declared the same property twice - once public, once Private - and the strip merged the
        // two storages. A public twin anywhere in the file protects the Private declaration.
        {Published = True}
        { Description = "A Private property with a same-named public twin keeps Private" }
        Procedure RemovePropertyPrivate_PublicTwinKeepsPrivate
            Integer iResult
            String[] asCode
            Move 'Property Number pMin 0'            to asCode[0]
            Move 'Property Number pMin Private 0'    to asCode[1]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertSAreEqual 'Property Number pMin Private 0' asCode[1]
        End_Procedure

        // Positive control: the two guards protect their own names only; an unrelated Private property in
        // the same file is still stripped.
        {Published = True}
        { Description = "The guards protect their own names only - an unrelated Private property is still stripped" }
        Procedure RemovePropertyPrivate_UnrelatedStillStripped
            Integer iResult
            String[] asCode
            Move 'Property Number pMin 0'                 to asCode[0]
            Move 'Property Number pMin Private 0'         to asCode[1]
            Move 'Property Number pOther Private 0'       to asCode[2]
            Move ('Move (' + Character(33) + '$.pMin(Self)) to nX')   to asCode[3]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send AssertSAreEqual 'Property Number pMin Private 0' asCode[1]
            Send Assert (Pos("Private", asCode[2]) = 0)
            Send Assert (Pos("pOther", asCode[2]) > 0)
        End_Procedure

        // A Property line in a multi-line string or a #HEADER region is text (2026-10-29): left as written,
        // while the one in code still loses Private.
        {Published = True}
        Procedure RemovePropertyPrivate_StringAndHeaderLeftAlone
            Integer iResult
            String[] asCode
            Move '#HEADER'                               to asCode[0]
            Move 'Property Boolean pbH Private'          to asCode[1]
            Move '#ENDHEADER'                            to asCode[2]
            Move 'Object oX is a cObject'                to asCode[3]
            Move '    Property Boolean pbA Private'      to asCode[4]
            Move '    Set psHtml to """'                 to asCode[5]
            Move '        Property Boolean pbB Private'  to asCode[6]
            Move '        """'                           to asCode[7]
            Move 'End_Object'                            to asCode[8]
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemovePropertyPrivate of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send AssertSAreEqual 'Property Boolean pbH Private'          asCode[1]
            Send AssertSAreEqual '    Property Boolean pbA'              asCode[4]
            Send AssertSAreEqual '        Property Boolean pbB Private'  asCode[6]
        End_Procedure

    End_Object
