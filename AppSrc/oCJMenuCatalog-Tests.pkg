//****************************************************************************
// $Module type: Test fixture
// $Module name: oCJMenuCatalog-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-11
//
// Description : Unit tests for the CodeJock menu catalogue (CJMenuCatalog.inc + CJMenuClassForMessage).
//
//               The catalogue is DATA, so what these tests pin is not clever logic - it is that the data
//               actually LOADS and that the probe answers with the shipped class name. That matters more than
//               it sounds: an .inc catalogue is spliced in by #Include, so a mis-encoded file or a renamed
//               adder fails at COMPILE time, but a silently EMPTY array fails at run time and looks exactly
//               like "this workspace had no standard menu items" - the converter would then rewrite every
//               File/Navigate item as a generic cCJMenuItem and nobody would notice until the menus shipped.
//
//               The lookup is deliberately case-insensitive on the message: the legacy sources spell 'send'
//               and 'Send', 'Request_Clear' and 'REQUEST_CLEAR', and DataFlex does not care - so neither may we.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCJMenuCatalog is a cTestFixture
        Set psFunctionName to "CJMenuCatalog"

        // The catalogue is non-empty - i.e. the #Include actually spliced.
        {Published = True}
        Procedure CJMC_CatalogueLoads
            String[] asCat
            Get pasCJMenuCatalog of ghoFuncLib to asCat
            Send Assert (SizeOfArray(asCat) > 0)
        End_Procedure

        // The DEO record actions resolve to the classes the install ships.
        {Published = True}
        Procedure CJMC_FileFamilyResolves
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Request_Clear" to sClass
            Send AssertSAreEqual "cCJClearMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Request_Clear_All" to sClass
            Send AssertSAreEqual "cCJClearAllMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Request_Delete" to sClass
            Send AssertSAreEqual "cCJDeleteMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Request_Save" to sClass
            Send AssertSAreEqual "cCJSaveMenuItem" sClass
        End_Procedure

        // Find_GE is the plain "Find" - the one most likely to be mis-mapped to cCJFindNextMenuItem.
        {Published = True}
        Procedure CJMC_FindFamilyResolves
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Find_GE" to sClass
            Send AssertSAreEqual "cCJFindMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Find_Next" to sClass
            Send AssertSAreEqual "cCJFindNextMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "SuperFind_Previous" to sClass
            Send AssertSAreEqual "cCJSuperFindPreviousMenuItem" sClass
        End_Procedure

        // Navigate + About, the other two pulldowns with shipped counterparts.
        {Published = True}
        Procedure CJMC_NavigateAndAboutResolve
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Switch_Next_Area" to sClass
            Send AssertSAreEqual "cCJNextAreaMenu" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Switch_Prior_View" to sClass
            Send AssertSAreEqual "cCJPriorViewMenu" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Activate_About" to sClass
            Send AssertSAreEqual "cCJAboutMenuItem" sClass
        End_Procedure

        // Case-insensitive, and tolerant of the whitespace a real On_Item line carries.
        {Published = True}
        Procedure CJMC_MatchIsCaseInsensitive
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "REQUEST_CLEAR" to sClass
            Send AssertSAreEqual "cCJClearMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "request_clear" to sClass
            Send AssertSAreEqual "cCJClearMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "  Find_GE  " to sClass
            Send AssertSAreEqual "cCJFindMenuItem" sClass
        End_Procedure

        // The Edit + Window families the DefaultCommandBarSystem template uses. Delete vs Request_Delete
        // is the trap: one is the EDIT delete (cut-buffer), the other deletes the RECORD.
        {Published = True}
        Procedure CJMC_EditAndWindowFamiliesResolve
            String sClass

            Get CJMenuClassForMessage of ghoFuncLib "Cut" to sClass
            Send AssertSAreEqual "cCJCutMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Delete" to sClass
            Send AssertSAreEqual "cCJDeleteEditMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Request_Delete" to sClass
            Send AssertSAreEqual "cCJDeleteMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Cascade_Windows" to sClass
            Send AssertSAreEqual "cCJCascadeMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Toggle_StatusBar" to sClass
            Send AssertSAreEqual "cCJStatusbarMenuItem" sClass
            Get CJMenuClassForMessage of ghoFuncLib "Exit_Application" to sClass
            Send AssertSAreEqual "cCJExitMenuItem" sClass
        End_Procedure

        // Toggle_ToolBar has NO shipped counterpart while its Statusbar sibling does - pinned so a
        // future 'obvious' symmetry fix cannot invent a class that does not exist.
        {Published = True}
        Procedure CJMC_ToolBarToggleHasNoCounterpart
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Toggle_ToolBar" to sClass
            Send AssertSAreEqual "" sClass
        End_Procedure

        // NEGATIVE: a program's OWN message is not in the catalogue, and "" is the correct answer -
        // the converter turns that into a generic cCJMenuItem rather than dropping the item. A blank
        // message must not resolve to anything either (a separator's 'send NONE' is handled upstream).
        {Published = True}
        Procedure CJMC_UnknownMessageReturnsBlank
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Activate_ConMan" to sClass
            Send AssertSAreEqual "" sClass
            Get CJMenuClassForMessage of ghoFuncLib "" to sClass
            Send AssertSAreEqual "" sClass
        End_Procedure

        // A message that merely CONTAINS a catalogue key must not match it - Find_GE_Extended is not
        // Find_GE. The probe compares whole entries, so this pins that it never degrades to a Pos().
        {Published = True}
        Procedure CJMC_PartialMessageDoesNotMatch
            String sClass
            Get CJMenuClassForMessage of ghoFuncLib "Find_GE_Extended" to sClass
            Send AssertSAreEqual "" sClass
            Get CJMenuClassForMessage of ghoFuncLib "My_Request_Clear" to sClass
            Send AssertSAreEqual "" sClass
        End_Procedure

    End_Object
