        {Published = True}
        Procedure ChangeLegacyOperators_18
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Fdel Eq 1 Begin // skapa fil om delar finns****************************************' to sLine
            Move 'If (Fdel = 1) Begin // skapa fil om delar finns****************************************' to sExpected
