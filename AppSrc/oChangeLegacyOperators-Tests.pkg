        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_19
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If cfgfile.admin_sys Eq "1" Begin // Comment ' to sLine
            Move 'If (cfgfile.admin_sys = "1") Begin // Comment' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_20
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If cfgfile.model_ord   Eq "J" Trim machines.mtype   to Modelno' to sLine
            Move 'If (cfgfile.model_ord = "J") Trim machines.mtype to Modelno' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_21
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (Trim(kontakt.namn))  Eq (Trim(namn)) Begin' to sLine
            Move 'If ((Trim(kontakt.namn)) = (Trim(namn))) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_22
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If sOne Eq "A" Insert "B" in sOne At 2' to sLine
            Move 'If (sOne = "A") Insert "B" in sOne At 2' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_23
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (Number(Val(Kunder_DD, "CUSTS.BALANCE"))) Gt (Number(Val(Kunder_DD, "CUSTS.LIMIT"))) Begin' to sLine
            Move '    If (Number(Val(Kunder_DD, "CUSTS.BALANCE")) > (Number(Val(Kunder_DD, "CUSTS.LIMIT")))) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        // Regression test: semicolon (line-continuation char) must stay outside the expression.
        // Bug: "Else If sStart gt "";" was becoming "Else If (sStart > "";)" -- semicolon trapped inside.
        Procedure ChangeLegacyOperators_24
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '           Else If sStart gt "";' to sLine
            Move '           Else If (sStart > "");' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_25
            // Regression test: semicolon after a numeric literal must stay outside the parentheses.
            // Bug: "If (Length(sMin)) eq 1;" was becoming "If ((Length(sMin)) = 1;)" -- semicolon trapped inside.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        If (Length(sMin)) eq 1;' to sLine
            Move '        If ((Length(sMin)) = 1);' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A ';'-continued If whose parenthesised OR-chain of EQ comparisons is SPLIT across two physical
        // lines: the opening line has an unclosed '(' + trailing ';', the continuation line a dangling
        // ')'. The per-line extractor can't build a balanced expression, and the continuation line trips
        // the db-mode shape guard - so the EQs were LEFT unconverted (the analyzer flagged it, the plan
        // no-op'd). The paren-imbalance continuation path converts each line in place (Nils 2026-07-14).
        {Published = True}
        Procedure ChangeLegacyOperators_MultiLineSemicolon
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            // Opening line: unclosed '(' + trailing ';'
            Move '            If (MertechInc_DriverName EQ ORAFLEX or MertechInc_DriverName EQ SQLFLEX or MertechInc_DriverName EQ MDSDB2 or ;' to sLine
            Move '            If (MertechInc_DriverName = ORAFLEX or MertechInc_DriverName = SQLFLEX or MertechInc_DriverName = MDSDB2 or ;' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
            // Continuation line: dangling ')'
            Move '                MertechInc_DriverName EQ MDSPgSQL or MertechInc_DriverName EQ MDSMySQL) Move MertechInc_iCount to MertechInc_iLoop' to sLine
            Move '                MertechInc_DriverName = MDSPgSQL or MertechInc_DriverName = MDSMySQL) Move MertechInc_iCount to MertechInc_iLoop' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // MALFORMED unbalanced line that STARTS with a command keyword (a dropped '(' old char-mode DataFlex
        // tolerated: 'If MyTable.Ref eq sKey)'). Until 2026-09-05 it was LEFT VERBATIM (never half-converted to
        // 'If ... = X)', whose modern '=' would lack the wrap while the ')' stays unbalanced) - which left the
        // board nothing to offer but "Ignore all". Now the one stray ')' is dropped and the line converts as
        // the balanced condition it meant to be. Distinct from the ';'-continuation above, which starts with
        // an operand and keeps its in-place conversion.
        {Published = True}
        Procedure ChangeLegacyOperators_MalformedLeadingIfExcessCloseParen
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If MyTable.Ref eq sKey)' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (MyTable.Ref = sKey)' sLine
        End_Procedure

        // LegacyApp2 PurchReg.VW (substring-Constrain regression): a balanced 'If <var> eq "<string>"' whose var
        // name CONTAINS 'Constrain' (sConstrain) must still modernise to 'If (<var> = "<string>")'. Four
        // substring 'constrain ' matches in the expression parser used to drop the comparison -> 'eq' stayed.
        {Published = True}
        Procedure ChangeLegacyOperators_IfConstrainVarEqStringLiteral
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If sConstrain eq "1" Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'If (sConstrain = "1") Begin' sLine
        End_Procedure

        // A plain var (no 'Constrain' substring) with a string literal converts normally.
        {Published = True}
        Procedure ChangeLegacyOperators_IfPlainVarEqStringLiteral
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If sFoo eq "1" Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'If (sFoo = "1") Begin' sLine
        End_Procedure

        // The 'Constrain'-containing var with a NUMERIC literal - proves it is the var NAME, not the string.
        {Published = True}
        Procedure ChangeLegacyOperators_IfConstrainVarEqNumeric
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If sConstrain eq 1 Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'If (sConstrain = 1) Begin' sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_26
            // Compound `If (X) Ne Y If <unparenthesised-bool> <command>` — the second
            // sub-expression has no parens, so the outer-paren wrap must locate the body
            // via asLineTokens (the first command keyword) instead of expecting `) and (`.
            // Bare `Not <ident>` is also rewritten as `Not(<ident>)`: command-style `Not`
            // is legal standalone but rejected by the compiler inside the parenthesised
            // compound that the wrap produces.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (Item_Count(Self)) Ne 0 If Not iType Set psObjectFilled to sClass' to sLine
            Move 'If (((Item_Count(Self)) <> 0) and Not(iType)) Set psObjectFilled to sClass' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_27
            // `Constrain X.Y Eq Z` lines must be preserved verbatim — `Eq` here is a
            // Constrain mode keyword (per the DataFlex language reference), not an
            // expression operator. Even when a parenthesised guard precedes Constrain
            // (`If (iThis) Constrain ASDB.PCLASS Eq 0`), the right-hand side of the
            // Constrain keyword must not be touched. Without the guard, the old behaviour
            // produced `If (iThis) Constrain (ASDB.PCLASS = 0)`, which the compiler rejects.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (iThis) Constrain ASDB.PCLASS Eq 0' to sLine
            Move 'If (iThis) Constrain ASDB.PCLASS Eq 0' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_28
            // Three-If compound (DataFlex's max-Ifs-per-line) with a lowercase `not`
            // in the middle sub-expression. The old `) If ` -> `) and ` substitution
            // only catches the FIRST inner If (preceded by `)`); the third inner If
            // (preceded by a bare token like `iRet`) was left as ` If ` inside the
            // outer-wrapped parens — and the compiler rejects ` If ` there. Also,
            // the lowercase `not` needs to be rewritten to function-call form, just
            // like the capital-N case from ChangeLegacyOperators_26.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (iType Ne iASDB_TYPE_PROPERTY) If not iRet If iRun Send Info_Box sType' to sLine
            Move 'If ((iType <> iASDB_TYPE_PROPERTY) and not(iRet) and iRun) Send Info_Box sType' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_29
            // Regression: GT/GE/LT/LE/EQ are the relational FIND modes of a database read too. In
            // "If (Found) Send REQUEST_READ of hoServer GT hFile iIndex" the read command is neither the
            // First nor the Second left command ("If"/"Send"), so the old Find-only guard missed it and
            // mangled the line into "If ((Found) Send REQUEST_READ of hoServer > hFile) iIndex". Leave verbatim.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (Found) Send REQUEST_READ of hoServer GT hFile iIndex' to sLine
            Move 'If (Found) Send REQUEST_READ of hoServer GT hFile iIndex' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_30
            // The bare "Send REQUEST_READ of hoDD GT hTable iIndex" form: REQUEST_READ is not "Find", so the
            // old guard skipped only Send FIND. Token-scanning the read commands leaves this untouched too.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Send REQUEST_READ of hoDD GT hTable iIndex' to sLine
            Move 'Send REQUEST_READ of hoDD GT hTable iIndex' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_31
            // Regression (Nils 2026-07-12): a chained If whose FIRST condition has a PARENTHESISED left
            // operand and a BARE right operand ("((year#/4)*4) eq year#"), FOLLOWED by another condition
            // that also carries parens. _FindFirstExpression's old "is there ANY ')' after the operator"
            // (RightPos) test counted the ')' belonging to the LATER condition, wrongly routed the first
            // comparison through _ExtractParenthesisExpression (which returns only the LEFT paren group),
            // and DROPPED its "eq year#" tail - the line came out with a dangling "= year#" and would not
            // compile. The fix matches the first '(' to its OWN ')' to decide enclosed-vs-left-operand.
            // This is the same root cause as the reported "If first_wd# eq 3 If ((year#/4)*4) eq year#
            // Ifnot ((year#/100)*100) eq year# Begin" mangling - a preceding Ifnot converter's
            // "If (Not(...))" is just another later paren that used to trip the same RightPos test.
            // NOTE: the sExpected below is hand-traced (no compiler in the authoring env). If this is the
            // ONLY fixture that fails and the actual output merely differs in paren count / spacing while
            // the "eq year#" tail is present (no dangling "= year#"), adopt the actual as sExpected.
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If ((year#/4)*4) eq year# If ((year#/100)*100) eq mo# Begin' to sLine
            Move '    If ((((year#/4)*4) = year#) and (((year#/100)*100) = mo#)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (Nils 2026-08-17, WinServ: 30+ 'Error 52 Bad format of expression (operator)
        // INDICATE' lines): 'If (<cond>) Indicate <target> as <legacy comparison>' - a line the
        // indicator converters left legacy (eLeaveSelect, or an unhandled shape). The expression
        // extractor swallows everything from the FIRST '(' to the comparison's right operand into
        // ONE fabricated token, and the rebuild emitted 'If ((select) Indicate Select as X = "A")'
        // = an Indicate COMMAND inside an expression. The operators of such a line live in the
        // 'as' expression (and the condition): convert them there and wrap the comparison as the
        // documented '(expression)' Indicate form - valid legacy code that still compiles.
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_Wrapped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If (select) Indicate Select as DRAFT_A.STATUS Eq "A"' to sLine
            Move '            If (select) Indicate Select as (DRAFT_A.STATUS = "A")' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Same, with an end comment and a bare-word right operand (WinServ Personer_sms.VW).
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_EndComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                If (Select) Indicate Select as Person.status eq 0 // aktiva' to sLine
            Move '                If (Select) Indicate Select as (Person.status = 0) // aktiva' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A parenthesised LEFT operand after 'as' (WinServ GAF.dg): the extractor's paren count
        // balanced, so the fabricated swallow used to fire here too. One outer pair around the whole
        // comparison, the operand's own parens kept.
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_ParenLeftOperand
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If (Select) Indicate Select as (Uppercase(DRAFT_A.USER)) Ge From_user' to sLine
            Move '            If (Select) Indicate Select as ((Uppercase(DRAFT_A.USER)) >= From_user)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The condition's own legacy operator modernises with it; the 'as' side that is already the
        // '(expression)' form is converted in place, not wrapped again.
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_CondAndParenExpr
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (iA eq 1) Indicate HIT as (Custs.status ne 0)' to sLine
            Move '    If (iA = 1) Indicate HIT as (Custs.status <> 0)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A legacy IN / MATCH on the 'as' side is compile-INVALID inside parens (ChangeInToContains
        // owns IN): that tail stays VERBATIM (unwrapped legacy form 2 still compiles) while the
        // condition's operator modernises - never the fabricated-token mangle.
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_InTailVerbatim
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    If (iA eq 1) Indicate SELECT as sTran IN 'APINV,APCDT'" to sLine
            Move "    If (iA = 1) Indicate SELECT as sTran IN 'APINV,APCDT'" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // VConstrain (DataFlex.lng: 'VConstrain {file#} {field#} {mode} {value}') - Constrain's
        // by-number twin - carries a MODE word, not a comparison (Nils 2026-08-17, WinServ:
        // 'VConstrain iFile iField EQ vValue' was wrapped into 'VConstrain iFile (iField = vValue)'
        // = E 4345 "#$, ARGUMENT REQUIRED", twice). Now in the db-command family: left VERBATIM.
        {Published = True}
        Procedure ChangeLegacyOperators_VConstrainModeWordUntouched
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        VConstrain iFile iField EQ vValue' to sLine
            Move '        VConstrain iFile iField EQ vValue' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ...and, like 'If <cond> Constrain ...', a leading If-condition before a VConstrain still
        // modernises while the command's own mode word stays legacy.
        {Published = True}
        Procedure ChangeLegacyOperators_IfConditionBeforeVConstrain
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        If iType eq 1 VConstrain iFile iField EQ vValue' to sLine
            Move '        If (iType = 1) VConstrain iFile iField EQ vValue' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* A USER-DEFINED command after the right operand is the NEXT COMMAND on the line, not part of
           the comparison (a workspace, 2026-09-05, one report file, six lines: the MyWritePos macro - a #COMMAND of the
           application, so in no keyword list - was swallowed into the condition, and the line came out
           'If (Cust.Flag = "1" MyWritePos "*"  18.7 (FONT_DEFAULT))' = Error 52 six times). */
        {Published = True}
        Procedure ChangeLegacyOperators_OperandThenUserDefinedCommand
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                If Cust.Flag EQ "1" MyWritePos "*"  18.7 (FONT_DEFAULT)' to sLine
            Move '                If (Cust.Flag = "1") MyWritePos "*" 18.7 (FONT_DEFAULT)' to sExpected   // the rebuild single-spaces the tail
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* THE RUNNER IS NOT THE APP. pasOperators is seeded from the target install's DataFlex.lng, and
           DataFlex 26's has no eq/ne/gt/ge/lt/le - the runner, seeded from the editor settings, has them.
           With them present the test above passed while the workspace broke; with them stripped, as the app
           has it, the tail cut swallowed the rest of the line into the comparison. Emulate the app's list
           and convert the same line; the operator list is restored before the assert so a failure
           cannot leak into the next test (TearDown re-seeds as well). */
        {Published = True}
        Procedure ChangeLegacyOperators_UserDefinedCommand_CatalogueWithoutLegacyWords
            String[] asOps asKeep
            String sLine sExpected sLow
            Integer i iMax
            Boolean bChanged
            tTokenizer TokenizerData
            Get pasOperators of ghoFuncLib to asOps
            Move (SizeOfArray(asOps) - 1) to iMax
            For i from 0 to iMax
                Move (Lowercase(asOps[i])) to sLow
                If (sLow <> "eq" and sLow <> "ne" and sLow <> "gt" and sLow <> "ge" and sLow <> "lt" and sLow <> "le") ;
                    Move asOps[i] to asKeep[SizeOfArray(asKeep)]
            Loop
            Set pasOperators of ghoFuncLib to asKeep
            Move '                If Cust.Flag EQ "1" MyWritePos "*"  18.7 (FONT_DEFAULT)' to sLine
            Move '                If (Cust.Flag = "1") MyWritePos "*" 18.7 (FONT_DEFAULT)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Set pasOperators of ghoFuncLib to asOps
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* CALC AFTER THE OPERAND, as the APP sees it (2026-10-31): DataFlex 26's language lists no Calc, so the
           keyword cut skipped it and the condition swallowed the command - 'If (iDay = Tuesday Calc (dDate
           -1)) to dStart'. Calc and Calculate are taken out of pasKeyWords to emulate that. */
        {Published = True}
        Procedure ChangeLegacyOperators_CalcAfterTheOperandWithoutACalcKeyword
            String[] asWords asKeep
            String sLine sExpected sLow
            Integer i iMax
            Boolean bChanged
            tTokenizer TokenizerData
            Get pasKeyWords of ghoFuncLib to asWords
            Move (SizeOfArray(asWords) - 1) to iMax
            For i from 0 to iMax
                Move (Lowercase(asWords[i])) to sLow
                If (sLow <> "calc" and sLow <> "calculate") ;
                    Move asWords[i] to asKeep[SizeOfArray(asKeep)]
            Loop
            Set pasKeyWords of ghoFuncLib to asKeep
            Move '          If iDay eq Tuesday   Calc (dDate -1) to dStart' to sLine
            Move '          If (iDay = Tuesday) Calc (dDate -1) to dStart' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Set pasKeyWords of ghoFuncLib to asWords
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The same shape with a KNOWN command after the operand, for contrast - pinned so the fix for
        // the unknown one cannot regress it.
        {Published = True}
        Procedure ChangeLegacyOperators_OperandThenKnownCommand
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                If Cust.Flag EQ "1" Move 18.7 to nPos' to sLine
            Move '                If (Cust.Flag = "1") Move 18.7 to nPos' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A COMMAND-FUNCTION word after a parenthesised operand is the NEXT COMMAND on the line, not
        // part of the comparison (Nils 2026-08-18, WinServ x3: the Character command was swallowed into
        // the condition - 'If (sFalt_sep = (_("Tab")) Character (9)) to inter' = Error 52 + 4298).
        {Published = True}
        Procedure ChangeLegacyOperators_ParenOperandThenCharacterCommand
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If sFalt_sep eq (_("Tab")) Character (9) to inter // Tab' to sLine
            Move '            If (sFalt_sep = (_("Tab"))) Character (9) to inter // Tab' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ...while the same word INSIDE the operand's parens is part of the expression: the tail cut
        // tracks paren depth, so a bare 'Trim' at depth 1 is not a cut point, and a glued 'Trim(sY)' is
        // not the bare word at all. (The cut is pinned directly - the runner's keyword list happens to
        // know 'Character', so the whole-line case above cannot show the difference the FT build saw;
        // and 'If sX eq ( Trim (sY) ) Begin' with SPACED parens was mangled elsewhere in the extractor
        // until 2026-08-30 - a separate defect, fixed in _FirstKeyWordInArray and pinned by
        // ChangeLegacyOperators_SpacedParenOperandSurvives below.)
        {Published = True}
        Procedure ChangeLegacyOperators_TailCutIsDepthAware
            String sOut sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            Get _CutBeforeCommandFunctionWord of ghoFuncLib 'eq ( Trim (sY) ) Begin' to sOut
            Send AssertSAreEqual 'eq ( Trim (sY) ) Begin' sOut
            Get _CutBeforeCommandFunctionWord of ghoFuncLib 'eq (_("Tab")) Character (9) to inter' to sOut
            Send AssertSAreEqual 'eq (_("Tab"))' sOut
            Get _CutBeforeCommandFunctionWord of ghoFuncLib 'ne (Trim(sA)) Length sB to iL' to sOut
            Send AssertSAreEqual 'ne (Trim(sA))' sOut
            Move '    If sX eq (Trim(sY)) Begin' to sLine
            Move '    If (sX = (Trim(sY))) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* SPACES INSIDE THE OPERAND PARENS, fixed 2026-08-30 after being carried as a known defect
           since 08-18. This produced

               If (sX = ()) ( Trim (sY) ) Begin

           - the operand replaced by an empty pair and then left dangling after it, which does not
           compile. The cause was _FirstKeyWordInArray finding "Trim" INSIDE the parens and ending
           the tail there; it now ignores keywords above paren depth zero.

           The glued twin below it is why this hid so long: "eq (Trim(sY))" is ONE space-separated
           token, so the inner Trim is never tested on its own. Both forms are asserted here, and
           the authors spacing survives into the output either way - a converter that reformatted
           the operand would make its own diff unreadable. */
        {Published = True}
        Procedure ChangeLegacyOperators_SpacedParenOperandSurvives
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    If sX eq ( Trim (sY) ) Begin"   to sLine
            Move "    If (sX = ( Trim (sY) )) Begin"  to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            // the glued twin, unchanged by the depth fix - the positive control for it
            Move "    If sX eq (Trim(sY)) Begin"      to sLine
            Move "    If (sX = (Trim(sY))) Begin"     to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // No legacy operator anywhere on such a line -> untouched (nothing to modernise).
        {Published = True}
        Procedure ChangeLegacyOperators_IfCondIndicateAs_AlreadyModern
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (Select) Indicate Select as (KONTAKT.Status >= From_Status)' to sLine
            Move '    If (Select) Indicate Select as (KONTAKT.Status >= From_Status)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* A LITERAL KEEPS ITS VALUE THROUGH THE REBUILD (Nils 2026-09-23). The line is rebuilt from the
           tokenizer's tokens, so a literal handed to the wrong token is written out: the "C" below came
           out as "WA" - the program then stores something else, and compiles fine. The second line
           broke the other way round: "AB" was pasted into the condition in place of "CD"; and with
           "CDE", which no longer matched, nothing went back - the mask (sA = "^^^") was written out. */
        {Published = True}
        Procedure ChangeLegacyOperators_LiteralsKeepTheirValues
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'if ((Functions.Parameter eq "TP") or (Functions.Parameter eq "WA")) move "C" to Functions.Parameter' to sLine
            Move 'if ((Functions.Parameter = "TP") or (Functions.Parameter = "WA")) move "C" to Functions.Parameter' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Move '    Send Info_Box "AB" (sA eq "CD")' to sLine
            Move '    Send Info_Box "AB" (sA = "CD")' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Move '    Send Info_Box "AB" (sA eq "CDE")' to sLine
            Move '    Send Info_Box "AB" (sA = "CDE")' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            // an argument glued behind a literal (a report formula) - it was dropped from the line
            Move ('    If sA eq "" Send AssignFormula of hoReport "logo"(' + "'" + '"0"' + "'" + ')') to sLine
            Move ('    If (sA = "") Send AssignFormula of hoReport "logo"(' + "'" + '"0"' + "'" + ')') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            // a ';' glued to the literal continues the statement on the next line - it must stay (LAST:
            // the ';' leaves the next line a continuation)
            Move '    If sA eq "X" Send Stop_Box "Hello";' to sLine
            Move '    If (sA = "X") Send Stop_Box "Hello";' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

    End_Object
