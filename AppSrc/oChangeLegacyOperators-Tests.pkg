    Object oChangeLegacyOperators is a cTestFixture
        Set psFunctionName to "ChangeLegacyOperators"

        /* ONE STRAY ')' ON A KEYWORD-LED LEGACY CONDITION IS REPAIRED (2026-09-05): "If Cust.Code eq sCode) ;"
           is a dropped '(' the old compiler tolerated - the stray goes and the line converts as the balanced
           condition it meant to be, whatever follows it (a continuation ';', a Begin, nothing). Two strays
           stay verbatim (hand work), and a bare continuation TAIL with excess ')' - no keyword first - keeps
           its in-place conversion, as before. */
        {Published = True}
        Procedure ChangeLegacyOperators_OneStrayClosingParenIsRepaired
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    If Cust.Code eq sCode) ;" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged "a continuation line converts"
            Send Assert (sLine contains "If (Cust.Code = sCode)") sLine
            Send Assert (Right(Trim(sLine), 1) = ";") sLine
            Send Assert (not(sLine contains "))")) "the stray is gone"
            Send AssertSAreEqual "    " (Left(sLine, 4))
            Move "    If Cust.Code eq sOther) Begin" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged "a Begin line converts"
            Send Assert (sLine contains "If (Cust.Code = sOther)") sLine
            Send Assert (Right(Trim(sLine), 5) = "Begin") sLine
            Move "    While Cust.Code ne sCode)" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged "a bare While converts"
            Send Assert (sLine contains "While (Cust.Code <> sCode)") sLine
            Move '    If Cust.Flag eq "1") ;' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged "a string operand is no obstacle"
            Send Assert (sLine contains 'If (Cust.Flag = "1")') sLine
            // two strays: hand work, verbatim
            Move "    If Cust.Code eq sCode)) ;" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    If Cust.Code eq sCode)) ;" sLine
            // a continuation tail (no keyword first) keeps the in-place conversion of the split case
            Move "    Cust.Code eq sCode) Move 1 to i" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Cust.Code = sCode) Move 1 to i" sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    While ((Found eq True) and (iA Eq iB))" to sLine
            Move "    While ((Found = True) and (iA = iB))" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    While  iL  lt  13" to sLine
            Move "    While (iL < 13)" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A date-format string CONSTANT in a comparison is wrapped in Date() when the operator is modernised
        // (Nils 2026-07-15): '(ddate > "2016-12-31")' does NOT compile - the compiler reads the ISO string as
        // American MM-DD-YYYY - so Date() defers the coercion to RUNTIME, reproducing what the legacy command
        // form 'If ddate gt "2016-12-31"' did (it compiled + ran).
        // A db-read message SEND whose relational MODE follows the object (Nils 2026-07-15):
        // 'if lhDDO send request_read to lhDDO GT file# ord#' - GT is the Request_Read find MODE
        // (Procedure Request_Read Integer eFindMode ...), NOT a comparison. The tokenizer fabricates
        // '(lhDDO GT file#)' and the db-command branch's rebuild wrongly materialised those parens into
        // the message args. Since the leading 'if lhDDO' condition has NO operator, the whole line must
        // be left VERBATIM (no rebuild).
        {Published = True}
        Procedure ChangeLegacyOperators_SendRequestReadFindModeUntouched
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '          if lhDDO send request_read to lhDDO GT file# ord#' to sLine
            Move '          if lhDDO send request_read to lhDDO GT file# ord#' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A USER-DEFINED message whose middle argument is a relational MODE constant (Nils 2026-07-24,
        // LegacyApp avtalsfakt.vw): 'Send AddConstrain of hSqlConstrain "MACHINES.MNO" GE from_mnr'
        // against 'Procedure AddConstrain String sField Integer mode String sConstrain'. GE is the
        // Integer mode ARGUMENT, not a comparison - DataFlex only allows an expression in argument
        // position inside parens. The tokenizer fabricates '("MACHINES.MNO" GE from_mnr)', and the
        // rebuild collapsed three arguments into ONE boolean: err 14 at compile time on numeric
        // operands, silently broken dispatch on string ones. The whole line must stay VERBATIM.
        // The Get dispatch form takes the same guard.
        {Published = True}
        Procedure ChangeLegacyOperators_SendArgumentModeUntouched
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            Move '                            Send AddConstrain of hSqlConstrain "MACHINES.MNO" GE from_mnr' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
            Move '    Get FindRec of oCache "MACHINES.MNO" GE from_mnr to bOk' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The guard must not overreach: a Send whose legacy operator sits inside REAL source parens
        // is a genuine expression argument and still modernises.
        {Published = True}
        Procedure ChangeLegacyOperators_SendParenthesisedExpressionStillConverts
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Send DoIt of oWorker (iA ge iB)' to sLine
            Move '    Send DoIt of oWorker (iA >= iB)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_DateConstantWrapped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If ddate gt "2016-12-31" Begin' to sLine
            Move '    If (ddate > Date("2016-12-31")) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Wrap selectivity (Nils 2026-07-15): only a DATE-shaped literal adjacent to a relational operator is
        // wrapped. A non-date string stays bare; a date on the LEFT of the operator is wrapped too.
        {Published = True}
        Procedure ChangeLegacyOperators_DateWrapOperandSelectivity
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If sType eq "ABC" Begin' to sLine
            Move '    If (sType = "ABC") Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Move '    If "2016-12-31" lt ddate Begin' to sLine
            Move '    If (Date("2016-12-31") < ddate) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A chained If whose FIRST condition is a bare legacy 'If not (X)' must NOT be chain-combined
        // into the invalid 'If not (X) and (Y)' (Nils 2026-07-13; would not compile). The nested Ifs
        // are kept and only the operator is modernised (EQ -> =). ChangeIfNotCommandToExpression, which
        // sorts BEFORE this, wraps the not to '(Not(X))' when co-selected, and THEN the combine fires
        // (next test). Standalone, this keeps the output valid legacy instead of a compile error.
        {Published = True}
        Procedure ChangeLegacyOperators_ChainedLeadingIfNotNotCombined
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If not (MORE_ROWS) If (Orders.Emp_Nr EQ Emp.Emp_Nr) Goto NextOrder' to sLine
            Move '    If not (MORE_ROWS) If (Orders.Emp_Nr = Emp.Emp_Nr) Goto NextOrder'  to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Once the not has been wrapped ('(Not(X))'), the chain DOES combine into a single, correctly
        // outer-parenthesised condition - the valid end state after ChangeIfNot + ChangeLegacyOperators.
        {Published = True}
        Procedure ChangeLegacyOperators_ChainedNotWrappedCombines
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (Not(MORE_ROWS)) If (Orders.Emp_Nr EQ Emp.Emp_Nr) Goto NextOrder'      to sLine
            Move '    If ((Not(MORE_ROWS)) and (Orders.Emp_Nr = Emp.Emp_Nr)) Goto NextOrder'    to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Operator CASE coverage (Nils 2026-07-13, real find 'If not arbk.arb_indat lE w_at_datum'):
        // the lower-first/UPPER-second forms 'lE'/'gE'/'nE'/'eQ' were silently left unconverted -
        // _ReplaceLegacyOperators built the ' LE ' form twice and never the ' lE ' form. Every case
        // combination must now convert. (The 'lt'/'Eq'/'LE'/'le' forms already worked and stay green
        // in the other fixtures.)
        {Published = True}
        Procedure ChangeLegacyOperators_MixedCaseLowerUpper
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '    If (iA lE iB) gosub_return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    If (iA <= iB) gosub_return' sLine
            Move '    If (iA gE iB) gosub_return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    If (iA >= iB) gosub_return' sLine
            Move '    If (iA nE iB) gosub_return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    If (iA <> iB) gosub_return' sLine
            Move '    If (iA eQ iB) gosub_return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    If (iA = iB) gosub_return' sLine
        End_Procedure

        // The reported real-world line, in the form it reaches ChangeLegacyOperators after the outer
        // If-not has been wrapped: the mixed-case 'lE' inside 'Not(... lE ...)' now converts too.
        {Published = True}
        Procedure ChangeLegacyOperators_NotWrappedMixedCaseLe
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (Not(arbk.arb_indat lE w_at_datum)) gosub_return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual '    If (Not(arbk.arb_indat <= w_at_datum)) gosub_return' sLine
        End_Procedure

        // A conditional Constrain (Nils 2026-07-13): the If CONDITION's eq modernises to =, but the
        // CONSTRAIN's relational eq (a database MODE, not a comparison) stays legacy. Previously the
        // whole line bailed on the Constrain guard, so the If condition was never modernised.
        {Published = True}
        Procedure ChangeLegacyOperators_IfConditionBeforeConstrain
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        If iTexttyp eq 0 Constrain Term2.Typ eq 0'   to sLine
            Move '        If (iTexttyp = 0) Constrain Term2.Typ eq 0'  to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A BARE Constrain (no leading If) is left untouched - its eq is a database mode, not a comparison.
        {Published = True}
        Procedure ChangeLegacyOperators_BareConstrainUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Constrain Term2.Typ eq 0' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Constrain Term2.Typ eq 0' sLine
        End_Procedure

        // A chained If whose secondary keyword is UPPERCASE 'IF' (Nils 2026-07-13). The parser folds the
        // whole compound into one expression token '((frvflex_0_tid) IF w_at_ordinarie& eq "X")'; the
        // ') If ' -> ') and ' combine must be CASE-INSENSITIVE or the 'IF' COMMAND is left inside the
        // expression (illegal). Result: 'and' (the correct modernisation of a nested If-condition; the
        // second operand needs no parens - '=' binds tighter than 'and').
        {Published = True}
        Procedure ChangeLegacyOperators_ChainedUppercaseIf
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        if (frvflex_0_tid) IF w_at_ordinarie& eq "X" move 0 to w_at_totaltid&'  to sLine
            Move '        if ((frvflex_0_tid) and w_at_ordinarie& = "X") move 0 to w_at_totaltid&' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A chained If with a LOWERCASE leading 'if' and two SEPARATE parenthesised conditions (Nils
        // 2026-07-13). The ') if ' combine joins them with 'and', but the outer-paren WRAP was gated by
        // a case-sensitive Pos("If ") that missed the lowercase 'if', leaving the bare 'and' at command
        // level -> compile Error 4298 "Command not found AND". The wrap must add the outer parens.
        {Published = True}
        Procedure ChangeLegacyOperators_ChainedLowercaseIfWrap
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        if summa_frv_komp gt 0 if balance.aterf1 gt 0 begin'         to sLine
            Move '        if ((summa_frv_komp > 0) and (balance.aterf1 > 0)) begin'    to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Constrained_Clear / Constrained_Find (and Find) use GT/GE/LT/LE/EQ as a relational MODE, not a
        // comparison - the whole line must be LEFT UNTOUCHED (Nils 2026-07-13: 'Constrained_Clear LE Anst
        // By index.1' was wrapped into the illegal '(Constrained_Clear <= Anst)' expression). Guarded by
        // shape: a statement can't start with '<operand> <relational-op>', so a relational second word
        // means the first word is a db command.
        {Published = True}
        Procedure ChangeLegacyOperators_ConstrainedModeUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '    Constrained_Clear LE Anst By index.1' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Constrained_Clear LE Anst By index.1' sLine
            Move '    Constrained_Clear GE Anst by Index.1' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Constrained_Clear GE Anst by Index.1' sLine
            Move '    Constrained_Find LE Anst by index.1' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Constrained_Find LE Anst by index.1' sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyOperators_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Send Find to Self EQ 1" to sLine
            Move "    Send Find to Self EQ 1" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

