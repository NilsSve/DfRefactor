//****************************************************************************
// $Module type: Class
// $Module name: cRefactorCJToolPanel
// $Author     : DFRefactor
//
// Description : This program's docks - the compiler output (CompilerOutput.dg), Test Compile (TestCompileFT.dg)
//               and the merged bottom dock (OutputDockFT.dg) - are the RDC Windows library's cRDCCJToolPanel
//               (1.0.4: a Container3d presented by a CodeJock dialog bar, the dragged height remembered across
//               runs, a floor under a drag; until 2026-10-08 this program's own cCJToolPanel.pkg, The Hammer's,
//               and cFTCJToolPanel.pkg) with the compile-output context menu: the command-bar system that builds
//               it is this program's, so the class names it. The grids inside a dock show the menu as
//               phoToolPanelContextMenu of the dock.
//****************************************************************************
Use cRDCCJToolPanel.pkg              // the dock (RDCToolsLib)
Use cCompilerOutputContextMenu.pkg   // cCompileOutputCJCommandBarSystem - the menu, and the system that builds it

Class cRefactorCJToolPanel is a cRDCCJToolPanel

    // The command-bar system class that builds the dock's context menu: cRDCCJToolPanel creates one of it in
    // End_Construct_Object, and its OnCreateCommandBars hands the menu to phoToolPanelContextMenu.
    Function ToolPanelContextMenuClass Returns Integer
        Function_Return (RefClass(cCompileOutputCJCommandBarSystem))
    End_Function

End_Class
