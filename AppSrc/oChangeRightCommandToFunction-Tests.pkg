    Object oChangeRightCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeRightCommandToFunction"

        {Published = True}
        Procedure ChangeRightCommandToFunction_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Right sPath to sPath (Length(sPath) - iSepPos)' to sLine
            Move 'Move (Right(sPath, (Length(sPath) - iSepPos))) to sPath' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Literal integer length parameter.
        {Published = True}
        Procedure ChangeRightCommandToFunction_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Right sText to sResult 5' to sLine
            Move 'Move (Right(sText, 5)) to sResult' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure ChangeRightCommandToFunction_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Right sPath to sExt (Length(sPath) - iPos)' to sLine
            Move '    Move (Right(sPath, (Length(sPath) - iPos))) to sExt' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // No Right command present -- bChanged must be False.
        {Published = True}
        Procedure ChangeRightCommandToFunction_4
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move sA to sB' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
        End_Procedure

        // Proper no-match guard: line unchanged and bChanged = False.
        {Published = True}
        Procedure ChangeRightCommandToFunction_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move x to y" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move x to y" sLine
        End_Procedure

        // Variable length argument; also verifies bChanged = True.
        {Published = True}
        Procedure ChangeRightCommandToFunction_bChanged
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Right sText to sResult iLen" to sLine
            Move "Move (Right(sText, iLen)) to sResult" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Err-4509 regression (2026-07-05): a Right line whose DESTINATION is the last token - no
        // trailing length - read ONE PAST the token array and crashed the engine run. That is the
        // STRMARK form (the count comes from the previous string command), unbuildable as a
        // function - and since 2026-07-11 (Nils) the exact command-position shape is TAGGED with a
        // review TODO instead of bailing silently. Idempotent on the second pass.
        {Published = True}
        Procedure ChangeRightCommandToFunction_NoLengthGetsTodoTag
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Right sText to sResult" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "TODO (DFRefactor)")
            Send Assert (Left(sLine, 22) = "Right sText to sResult")
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // False match: 'Right' as a plain VARIABLE sitting as the line's last token - the other
        // err-4509 crash shape. Must be left untouched, bChanged False (the arity pre-check bails
        // because nothing follows the destination).
        {Published = True}
        Procedure ChangeRightCommandToFunction_VariableNamedRightUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move Right to sX" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move Right to sX" sLine
        End_Procedure

    End_Object
