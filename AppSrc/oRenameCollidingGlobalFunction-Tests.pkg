//****************************************************************************
// $Module type: Test fixture
// $Module name: oRenameCollidingGlobalFunction-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-23
//
// Description : Unit tests for RenameCollidingGlobalFunction (the public wrapper on ghoFuncLib; core =
//               _RenameGlobalNameInLines in cRefactorFuncLib). It renames a GLOBAL function away from a name the
//               newer DataFlex owns: the Global declaration, expression calls (<Old>( - spaces allowed), and
//               OF-LESS Get statements. Get/Send ... OF <object> forms are NEVER touched - the of-form is the
//               class method (usually the native API) the name clashes with. Masked + whole-word, so literals,
//               comments and longer names (SplitX) never rename. Born from Nils's 164 hand edits for SPLIT
//               (2026-07-23).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Object oRenameCollidingGlobalFunction is a cTestFixture
    Set psFunctionName to "RenameCollidingGlobalFunction"

    // The Global declaration renames; the parameter's default new name appends X.
    {Published = True}
    Procedure RenameGlobal_Declaration_Renamed
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "Function Split Global String sText String sSep Returns String" to asCode[0]
        Move "    Function_Return sText" to asCode[1]
        Move "End_Function"              to asCode[2]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "Function SplitX Global String sText String sSep Returns String" asCode[0]
    End_Procedure

    // A plain Function WITHOUT the Global keyword is a class METHOD - left alone.
    {Published = True}
    Procedure RenameGlobal_MethodDeclaration_Untouched
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "Function Split String sText Returns String" to asCode[0]
        Move "End_Function"                               to asCode[1]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual "Function Split String sText Returns String" asCode[0]
    End_Procedure

    // Expression calls rename - including several on one line, spliced right-to-left.
    {Published = True}
    Procedure RenameGlobal_ExpressionCalls_Renamed
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move '    Move (Split(sA, ";") + Split(sB, ",")) to sBoth' to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 2)
        Send AssertSAreEqual '    Move (SplitX(sA, ";") + SplitX(sB, ",")) to sBoth' asCode[0]
    End_Procedure

    // The of-less Get statement form renames...
    {Published = True}
    Procedure RenameGlobal_GetStatement_Renamed
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "    Get SQLExecute sSQL to sResult" to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "SQLExecute" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "    Get SQLExecuteX sSQL to sResult" asCode[0]
    End_Procedure

    // ...but the OF-form is OBJECT-targeted (the native statement API) and must survive untouched.
    {Published = True}
    Procedure RenameGlobal_OfForms_Untouched
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "    Send SQLExecute of hStmt sQuery"       to asCode[0]
        Move "    Get SQLExecute of hoStmt sQ to sR"     to asCode[1]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "SQLExecute" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual "    Send SQLExecute of hStmt sQuery"   asCode[0]
        Send AssertSAreEqual "    Get SQLExecute of hoStmt sQ to sR" asCode[1]
    End_Procedure

    // String literals and comments are masked - never renamed.
    {Published = True}
    Procedure RenameGlobal_LiteralsAndComments_Untouched
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move '    Move "call Split(x) here" to sDoc  // Split( in a comment' to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual '    Move "call Split(x) here" to sDoc  // Split( in a comment' asCode[0]
    End_Procedure

    // Whole-word boundaries: longer names never match, and a re-run is a no-op (idempotent) -
    // which is also what UNIFIES a half-migrated workspace (X-sites are simply not matched).
    {Published = True}
    Procedure RenameGlobal_BoundariesAndIdempotence
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "    Move (SplitX(sA, ';') + MySplit(sB)) to sC" to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual "    Move (SplitX(sA, ';') + MySplit(sB)) to sC" asCode[0]
    End_Procedure

    // Explicit OldName|NewName parameter overrides the X default.
    {Published = True}
    Procedure RenameGlobal_ExplicitNewName
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "    Move (Split(sA, ';')) to sB" to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split|WsSplit" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "    Move (WsSplit(sA, ';')) to sB" asCode[0]
    End_Procedure

    // A spaced call ("Split (sA)") renames too - real code writes it (the _RenameMaskedCalls gap).
    {Published = True}
    Procedure RenameGlobal_SpacedCall_Renamed
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "    Move (Split (sA, ';')) to sB" to asCode[0]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode) "Split" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "    Move (SplitX (sA, ';')) to sB" asCode[0]
    End_Procedure

    /* ---- RenameCollidingClass (2026-09-03): the CLASS flavour of the duplicate-name error 4345 ----
       Core = _RenameClassNameInLines. Five class-reference shapes rename (the U_<Class> symbol was
       missed on the first live run - WinServ regexp.pkg 'Get Create U_cRegEx', which on DF26 then
       binds to the NATIVE class in silence); a Use line naming the file, a same-named variable and a
       longer name do not. */
    {Published = True}
    Procedure RenameClass_FourShapes_Renamed_OthersUntouched
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move "Use cRegEx.pkg"                                   to asCode[0]
        Move "Class cRegEx is a cObject"                        to asCode[1]
        Move "    Procedure Construct_Object"                   to asCode[2]
        Move "End_Class"                                        to asCode[3]
        Move "Object oRx is a cRegEx"                           to asCode[4]
        Move "End_Object"                                       to asCode[5]
        Move "Class cMyRegEx is an cRegEx"                      to asCode[6]
        Move "    Get Create (RefClass( cRegEx )) to hoRx"      to asCode[7]
        Move "Procedure Reset for cRegEx"                       to asCode[8]
        Move "    Move cRegEx to sName // cRegEx as a variable" to asCode[9]
        Move "Object oRx2 is a cRegExHelper"                    to asCode[10]
        Move "    Get Create U_cRegEx to hRegEx // U_cRegEx"    to asCode[11]
        Move "    Move (U_cRegEx + u_cRegEx) to iTwo"           to asCode[12]
        Get RenameCollidingClass of ghoFuncLib (&asCode) "cRegEx" to iCount
        Send Assert (iCount = 8)
        Send AssertSAreEqual "Use cRegEx.pkg"                                   asCode[0]
        Send AssertSAreEqual "Class cRegExX is a cObject"                       asCode[1]
        Send AssertSAreEqual "Object oRx is a cRegExX"                          asCode[4]
        Send AssertSAreEqual "Class cMyRegEx is an cRegExX"                     asCode[6]
        Send AssertSAreEqual "    Get Create (RefClass( cRegExX )) to hoRx"     asCode[7]
        Send AssertSAreEqual "Procedure Reset for cRegExX"                      asCode[8]
        Send AssertSAreEqual "    Move cRegEx to sName // cRegEx as a variable" asCode[9]
        Send AssertSAreEqual "Object oRx2 is a cRegExHelper"                    asCode[10]
        // (e) the U_<Class> class-id symbol: the user's own "U_" / "u_" spelling kept, the comment not.
        Send AssertSAreEqual "    Get Create U_cRegExX to hRegEx // U_cRegEx"   asCode[11]
        Send AssertSAreEqual "    Move (U_cRegExX + u_cRegExX) to iTwo"         asCode[12]
    End_Procedure

    // Old|New parameter form, and a second run finds nothing (idempotent).
    {Published = True}
    Procedure RenameClass_OldNewParameter_AndIdempotent
        String[] asCode
        Integer iCount iAgain
        Send ClearFuncLibProperties of ghoFuncLib
        Move "Object oRx is a cRegEx" to asCode[0]
        Get RenameCollidingClass of ghoFuncLib (&asCode) "cRegEx|cWsRegEx" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "Object oRx is a cWsRegEx" asCode[0]
        Get RenameCollidingClass of ghoFuncLib (&asCode) "cRegEx|cWsRegEx" to iAgain
        Send Assert (iAgain = 0)
    End_Procedure

    // A string literal, a trailing comment and a whole-line comment spelling the shape are never touched.
    {Published = True}
    Procedure RenameClass_LiteralAndComment_Untouched
        String[] asCode
        Integer iCount
        Send ClearFuncLibProperties of ghoFuncLib
        Move '    Move "is a cRegEx" to sText  // was: is a cRegEx' to asCode[0]
        Move '    // Object oX is a cRegEx (old)'                 to asCode[1]
        Get RenameCollidingClass of ghoFuncLib (&asCode) "cRegEx" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual '    Move "is a cRegEx" to sText  // was: is a cRegEx' asCode[0]
        Send AssertSAreEqual '    // Object oX is a cRegEx (old)'                 asCode[1]
    End_Procedure

    // The install class walk's line reader: first-token only, tabs folded, one name per class, no dupes.
    {Published = True}
    Procedure RenameClass_ClassNamesFromLines
        String[] asCode asNames
        Move "Use cObject.pkg"                              to asCode[0]
        Move "Class cRegEx is a cObject"                    to asCode[1]
        Move (Character(9) + "Class" + Character(9) + "cHttpTransfer is a cObject") to asCode[2]
        Move "    Move x to y // the class cFake is not one" to asCode[3]
        Move "Class cRegEx is a cObject"                    to asCode[4]
        Get _ClassNamesFromLines of ghoFuncLib asCode to asNames
        Send Assert (SizeOfArray(asNames) = 2)
        Send AssertSAreEqual "cRegEx"        asNames[0]
        Send AssertSAreEqual "cHttpTransfer" asNames[1]
    End_Procedure

End_Object
