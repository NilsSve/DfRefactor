//****************************************************************************
// $Module type: Test fixture
// $Module name: oShadowedPackageFiles-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-30
//
// Description : Unit tests for cShadowedPackageFiles - the report that names package files
//               existing in more than one place, and which copy the compiler used.
//
//               The two functions tested here are the PURE ones: reading a resolution out of a
//               compiler listing line, and picking the copies that lost. Everything else in that
//               class is file I/O against a real workspace.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oShadowedPackageFiles is a cTestFixture
        Set psFunctionName to "ShadowedPackageFilesReport"

        // Helper: reach the class's pure functions through an instance (like the scanner tests).
        Function ParseListingLine String sLine String ByRef sPath Returns String
            Handle ho
            String sLeaf
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get IncludedFileFromPrnLine of ho sLine (&sPath) to sLeaf
            Send Destroy of ho
            Function_Return sLeaf
        End_Function

        Function Shadows String sLeaf String sWinner String[] asCandidates Returns String[]
            Handle ho
            String[] asOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get ShadowCopiesOf of ho sLeaf sWinner asCandidates to asOut
            Send Destroy of ho
            Function_Return asOut
        End_Function

        /* The real listing shape, taken verbatim from a compiler .prn. The leaf comes back
           lowercased (it is a lookup key; Windows hides filename case anyway) and the path exactly
           as written, because the path is what the report prints for a person to act on. */
        { Published = True }
        Procedure ShadowedPackages_ParsesRealListingLine
            String sPath sLeaf
            Get ParseListingLine 'Including file: vWin32fh.pkg    (E:\Ws\DfPkg\SomeLib_VDFQuery20-5b1a6941\AppSrc\vWin32fh.pkg)' (&sPath) to sLeaf
            Send AssertSAreEqual "vwin32fh.pkg" sLeaf
            Send AssertSAreEqual 'E:\Ws\DfPkg\SomeLib_VDFQuery20-5b1a6941\AppSrc\vWin32fh.pkg' sPath
        End_Procedure

        /* A PATH MAY CONTAIN ITS OWN PARENTHESES - "Program Files (x86)" is the everyday case.
           The wrapper's "(" is the FIRST one and its ")" the LAST, so the inner pair must not
           truncate the path. This is the line that would have shipped broken. */
        { Published = True }
        Procedure ShadowedPackages_PathWithParenthesesSurvives
            String sPath sLeaf
            Get ParseListingLine 'Including file: dfallent.pkg    (C:\Program Files (x86)\DataFlex 26.0\Pkg\dfallent.pkg)' (&sPath) to sLeaf
            Send AssertSAreEqual "dfallent.pkg" sLeaf
            Send AssertSAreEqual 'C:\Program Files (x86)\DataFlex 26.0\Pkg\dfallent.pkg' sPath
        End_Procedure

        // Anything that is not an include record answers "" - the listing is mostly source text,
        // and a line merely MENTIONING the words must not be read as a resolution.
        { Published = True }
        Procedure ShadowedPackages_NonIncludeLinesIgnored
            String sPath sLeaf
            Get ParseListingLine '126333>>>>>Use vWin32fh.pkg' (&sPath) to sLeaf
            Send AssertSAreEqual "" sLeaf
            Get ParseListingLine '// Including file: notreally.pkg without any path' (&sPath) to sLeaf
            Send AssertSAreEqual "" sLeaf
            Get ParseListingLine '' (&sPath) to sLeaf
            Send AssertSAreEqual "" sLeaf
        End_Procedure

        /* The losers, and only the losers. The winner is excluded by full path even though it
           shares the leaf, the match is case-insensitive on both, and a DIFFERENT file name is
           never collected - that last one is what keeps a deliberate fork ("..._ext.pkg") out of
           the report entirely. */
        { Published = True }
        Procedure ShadowedPackages_CollectsOtherCopiesNotTheWinnerNorOtherNames
            String[] asAll asOut
            Move 'E:\Ws\DfPkg\SomeLib\AppSrc\vWin32fh.pkg' to asAll[0]
            Move 'E:\Ws\Libraries\vwin32fh\VWIN32FH.PKG'   to asAll[1]
            Move 'E:\Ws\AppSrc\vwin32fh_ext.pkg'           to asAll[2]
            Move 'E:\Ws\Libraries\VDFQuery\AppSrc\vWin32fh.pkg' to asAll[3]
            Move 'E:\Ws\AppSrc\Something.pkg'              to asAll[4]
            Get Shadows "vwin32fh.pkg" 'E:\Ws\DfPkg\SomeLib\AppSrc\vWin32fh.pkg' asAll to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            Send AssertSAreEqual 'E:\Ws\Libraries\vwin32fh\VWIN32FH.PKG' asOut[0]
            Send AssertSAreEqual 'E:\Ws\Libraries\VDFQuery\AppSrc\vWin32fh.pkg' asOut[1]
        End_Procedure

        // The winner's own path differing only by CASE is still the winner, not a shadow - the two
        // records reach the report from different sources (a listing and a directory walk).
        { Published = True }
        Procedure ShadowedPackages_WinnerMatchedCaseInsensitively
            String[] asAll asOut
            Move 'E:\WS\APPSRC\Alpha.pkg' to asAll[0]
            Get Shadows "alpha.pkg" 'e:\ws\appsrc\alpha.pkg' asAll to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        // A file with exactly one copy produces nothing - the report must stay silent on the
        // ordinary case, which is nearly every file in a workspace.
        { Published = True }
        Procedure ShadowedPackages_SingleCopyIsNotAFinding
            String[] asAll asOut
            Move 'E:\Ws\AppSrc\Lonely.pkg' to asAll[0]
            Move 'E:\Ws\AppSrc\Other.pkg'  to asAll[1]
            Get Shadows "lonely.pkg" 'E:\Ws\AppSrc\Lonely.pkg' asAll to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        /* Pairing a leftover Libraries\ folder with the package that replaced it. The two use
           different naming conventions - "Data Folder Selector" against
           "NilsSve_DataFolderSelector_Library_DF26-40f317da" - so both sides are reduced to letters
           and digits before comparing. */
        { Published = True }
        Procedure ShadowedPackages_FolderNameNormalisedForPackageMatching
            Handle ho
            String sA sB
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get NormalisedFolderName of ho "Data Folder Selector" to sA
            Send AssertSAreEqual "datafolderselector" sA
            Get NormalisedFolderName of ho "NilsSve_DataFolderSelector_Library_DF26-40f317da" to sB
            Send Assert (sB contains sA)
            // The containment is one-way on purpose: a library called "lib" must not claim every
            // package whose name happens to hold those letters, so the LIBRARY name is the needle.
            Get NormalisedFolderName of ho "DUF" to sA
            Get NormalisedFolderName of ho "NilsSve_DUFLibrary26.0-25ae4a4d" to sB
            Send Assert (sB contains sA)
            Send Assert (not(sA contains sB))
            Send Destroy of ho
        End_Procedure

        /* Only the extensions a Use resolves by NAME count when comparing an old library tree with
           its package - a stray .bak or a bitmap says nothing about whether code would be lost.
           WIDENED 2026-09-15: this test used to pin "PkgDoc.vw" as NOT a source leaf, and that was
           the blind spot - libraries ship .utl / .nui / .vw and the install ships .dg / .vw / .mac,
           so a workspace's own copy of any of them was invisible to every sweep. A .src stays out. */
        { Published = True }
        Procedure ShadowedPackages_OnlySourceLeavesAreCompared
            Handle ho
            Boolean b
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get IsSourceLeaf of ho "vWin32fh.pkg" to b
            Send Assert (b = True)
            Get IsSourceLeaf of ho "LoginEncryptionKey.INC" to b
            Send Assert (b = True)
            Get IsSourceLeaf of ho "vwin32fh.h" to b
            Send Assert (b = True)
            Get IsSourceLeaf of ho "PkgDoc.vw" to b
            Send Assert (b = True) "a .vw is Used by name - the install ships two"
            Get IsSourceLeaf of ho "DATES.UTL" to b
            Send Assert (b = True) "a .utl is what a library's utility files are called"
            Get IsSourceLeaf of ho "dates.nui" to b
            Send Assert (b = True)
            Get IsSourceLeaf of ho "MonthCalendarPrompt.dg" to b
            Send Assert (b = True) "the install ships .dg files"
            Get IsSourceLeaf of ho "Case.mac" to b
            Send Assert (b = True)
            Get IsSourceLeaf of ho "readme.txt" to b
            Send Assert (b = False)
            Get IsSourceLeaf of ho "Main.src" to b
            Send Assert (b = False) "a program is never Used"
            Get IsSourceLeaf of ho "Order.bak" to b
            Send Assert (b = False)
            Send Destroy of ho
        End_Procedure

        /* The folder a removed .sws entry belongs to - what the Libraries dialog offers to retire.
           It is the DIRECT CHILD of Libraries\, not the .sws file's own parent: a library routinely
           keeps its .sws in a subfolder (vWin32fh's is in StudioLibrary\), and retiring that would
           leave the library half-present and still findable. */
        { Published = True }
        Procedure ShadowedPackages_RetirableFolderIsTheChildOfLibraries
            Handle ho
            String sOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get RetirableLibraryFolder of ho 'E:\Ws' 'Libraries\DUF\DUFLibrary26.0.sws' to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\DUF' sOut
            // Nested .sws - still the child of Libraries, not the StudioLibrary folder.
            Get RetirableLibraryFolder of ho 'E:\Ws' 'Libraries\vwin32fh\StudioLibrary\vWin32fh-Library-DF26.0.sws' to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\vwin32fh' sOut
            // Forward slashes (a JSON .sws writes them) resolve the same way.
            Get RetirableLibraryFolder of ho 'E:\Ws' 'Libraries/Data Folder Selector/DFS.sws' to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\Data Folder Selector' sOut
            Send Destroy of ho
        End_Procedure

        /* REFUSES anything it must not touch. A library declared by absolute path into another
           project is shared with whatever else declares it; a folder outside this workspace is not
           this workspace's to rename; and a .sws sitting directly in Libraries\ names no folder of
           its own. Each answers "" - the dialog then offers nothing, which is the safe outcome. */
        { Published = True }
        Procedure ShadowedPackages_RetirableFolderRefusesWhatIsNotOurs
            Handle ho
            String sOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get RetirableLibraryFolder of ho 'E:\Ws' 'C:\Shared\SomeLib\SomeLib.sws' to sOut
            Send AssertSAreEqual "" sOut
            Get RetirableLibraryFolder of ho 'E:\Ws' '..\Elsewhere\Lib\Lib.sws' to sOut
            Send AssertSAreEqual "" sOut
            Get RetirableLibraryFolder of ho 'E:\Ws' 'Libraries\Loose.sws' to sOut
            Send AssertSAreEqual "" sOut
            Get RetirableLibraryFolder of ho 'E:\Ws' '' to sOut
            Send AssertSAreEqual "" sOut
            Send Destroy of ho
        End_Procedure

        Function OwnSource String sPath String sHome Returns Boolean
            Handle ho
            Boolean bOK
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get IsWorkspaceOwnSource of ho sPath sHome to bOK
            Send Destroy of ho
            Function_Return bOK
        End_Function

        /* THE DISCRIMINATOR FOR PART 3, and the reason that part is not noise. Every workspace
           shares file names with the DataFlex install - measured at 10 on one legacy workspace and
           28 on another - so "same name as an install file" cannot be the trigger. WHERE the winning
           copy lives separates the two populations exactly: a package pool or a library folder
           carries such a name on purpose (DfAbout.pkg, StdAbout.pkg, cSelectFolderDialog.pkg and
           MSSqldrv.pkg all do, and none is a defect), while the applications own folders carrying one
           is the dangerous case. Both halves are asserted: without the negative cases a rule that
           answered True to everything would pass just as well. */
        {Published = True}
        Procedure Shadow_OwnSourceVersusThePools
            String sHome
            Move "E:\Ws" to sHome
            // the applications own source - the serious kind
            Send Assert (OwnSource(Self, "E:\Ws\Pkg\errornum.inc", sHome))
            Send Assert (OwnSource(Self, "E:\Ws\AppSrc\Prnt_dlg.pkg", sHome))
            // a package checkout or a library folder - carries the name deliberately
            Send Assert (OwnSource(Self, "E:\Ws\DfPkg\Someone_Lib26.0-abc\DfAbout.pkg", sHome) = False)
            Send Assert (OwnSource(Self, "E:\Ws\Libraries\DFAbout\DfAbout.pkg", sHome) = False)
            // outside the workspace altogether - the install copy itself is never "ours"
            Send Assert (OwnSource(Self, "C:\Program Files\DataFlex 26.0\Pkg\errornum.inc", sHome) = False)
            // case must not decide it: Windows paths arrive in whatever case the listing had
            Send Assert (OwnSource(Self, "e:\ws\pkg\ERRORNUM.INC", sHome))
            Send Assert (OwnSource(Self, "E:\Ws\dfpkg\X\DfAbout.pkg", sHome) = False)
        End_Procedure

        // Helper: the pure classifier behind the sys-override line, reached through an instance.
        // The install folder is a made-up path - only the NAMES it ships are consulted.
        Function Classified String[] asLeaf String[] asWinner String[] asAll String[] asShipped String sHome ;
                String[] ByRef asOutLeaf String[] ByRef asOutPath String[] ByRef asOutInst Integer[] ByRef aiClass Returns Integer
            Handle ho
            Integer iCount
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get InstallCopiesClassified of ho (&asLeaf) (&asWinner) (&asAll) (&asShipped) sHome "C:\DF\Pkg" ;
                (&asOutLeaf) (&asOutPath) (&asOutInst) (&aiClass) to iCount
            Send Destroy of ho
            Function_Return iCount
        End_Function

        /* A COPY THE BUILD NEVER READ IS A FINDING TOO (Nils 2026-09-13: "system file copies that
           are not reached by the compiler" must be offered the rename). The listing says the
           INSTALLED copy compiled; the sweep finds the same name in the workspace's own source. It
           is class 1, its own path is named, and so is the install file it stands in front of. */
        { Published = True }
        Procedure Shadow_CopyTheBuildDidNotReadIsClassOne
            String[] asLeaf asWinner asAll asShipped asOutLeaf asOutPath asOutInst
            Integer[] aiClass
            Integer iCount
            Move "dfabout.pkg"                 to asLeaf[0]
            Move "C:\DF\Pkg\DfAbout.pkg"      to asWinner[0]
            Move "E:\Ws\Extra\DfAbout.pkg"    to asAll[0]
            Move "E:\Ws\AppSrc\Order.pkg"     to asAll[1]
            Move "dfabout.pkg"                 to asShipped[0]
            Get Classified asLeaf asWinner asAll asShipped "E:\Ws" (&asOutLeaf) (&asOutPath) (&asOutInst) (&aiClass) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 1 (aiClass[0])
            Send AssertSAreEqual "DfAbout.pkg" (asOutLeaf[0])
            Send AssertSAreEqual "E:\Ws\Extra\DfAbout.pkg" (asOutPath[0])
            Send AssertSAreEqual "C:\DF\Pkg\DfAbout.pkg" (asOutInst[0])
        End_Procedure

        /* The compiled copy that IS the workspace's own stays class 0 - and the sweep, which finds
           that same path again (spelled as the disk spells it), must not list it a second time as a
           copy the build did not read. */
        { Published = True }
        Procedure Shadow_TheCompiledOwnCopyIsClassZeroAndListedOnce
            String[] asLeaf asWinner asAll asShipped asOutLeaf asOutPath asOutInst
            Integer[] aiClass
            Integer iCount
            Move "errornum.inc"                to asLeaf[0]
            Move "E:\Ws\Pkg\errornum.inc"     to asWinner[0]
            Move "E:\Ws\Pkg\ERRORNUM.INC"     to asAll[0]
            Move "errornum.inc"                to asShipped[0]
            Get Classified asLeaf asWinner asAll asShipped "E:\Ws" (&asOutLeaf) (&asOutPath) (&asOutInst) (&aiClass) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 0 (aiClass[0])
            Send AssertSAreEqual "E:\Ws\Pkg\errornum.inc" (asOutPath[0])
        End_Procedure

        // Neither a pool copy (a package checkout, a library folder) nor a name the install does
        // not ship is a copy of a system file - the same two exclusions the override test applies.
        { Published = True }
        Procedure Shadow_PoolCopiesAndUnshippedNamesAreNotSystemFileCopies
            String[] asLeaf asWinner asAll asShipped asOutLeaf asOutPath asOutInst
            Integer[] aiClass
            Integer iCount
            Move "E:\Ws\DfPkg\Someone_Lib26.0-abc\DfAbout.pkg" to asAll[0]
            Move "E:\Ws\Libraries\Foo\DfAbout.pkg"           to asAll[1]
            Move "E:\Ws\AppSrc\MyOwn.pkg"                     to asAll[2]
            Move "dfabout.pkg"                                 to asShipped[0]
            Get Classified asLeaf asWinner asAll asShipped "E:\Ws" (&asOutLeaf) (&asOutPath) (&asOutInst) (&aiClass) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        /* A FILE NAME A LIBRARY ALSO USES IS NO FINDING (Nils 2026-10-05: "It is actually perfectly OK with
           duplicate filenames, as long as they are not a DataFlex system package. Thus all other
           'duplicates' should be removed from the dialog" - and, asked about the report: "Yes!"). From
           2026-09-15 until then this sweep answered a row for the copy the build did not read and counted
           the compiled one, which is not on this disk, as moved away. Now it answers nothing. No install
           is known to the runner, so nothing else can answer either; the kept-copies list is pointed at a
           file that does not exist. */
        { Published = True }
        Procedure Shadow_LibraryFileCopiesAreNotListed
            Handle ho
            String[] asLeaf asWinner asAll asErr
            tShadowCopy[] aRows
            Integer iCount iGone
            Move "working.pkg"                                       to asLeaf[0]
            Move "E:\Ws\AppSrc\Working.pkg"                       to asWinner[0]     // the workspace's copy compiled
            Move "E:\Ws\AppSrc\Working.pkg"                       to asAll[0]
            Move "E:\Ws\Libraries\RDCToolsLib\AppSrc\Working.pkg" to asAll[1]     // the library's file
            Move "E:\Ws\Extra\Working.pkg"                        to asAll[2]     // a copy the build did not read
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_NoKeptShadows.json")
            Get ShadowCopiesFrom of ho (&asLeaf) (&asWinner) "E:\Ws" (&asAll) (&asErr) (&aRows) (&iGone) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 0 (SizeOfArray(aRows))
            Send AssertIAreEqual 0 iGone
            Send Destroy of ho
        End_Procedure

        /* THE ONE COPY THAT IS RIGHT BY DESIGN. LoginEncryptionKey.inc is the Studio's generated,
           per-application key; DUF, VDFQuery and Filesystem each ship a template of it (Nils
           2026-09-15: "always leave LoginEncryptionKey.inc"). The classifier may never flag it,
           whatever the reference set ships - the negative here is the control that keeps an app's key
           off the rename list. */
        { Published = True }
        Procedure Shadow_StudioGeneratedKeyIsNeverACopy
            String[] asLeaf asWinner asAll asShipped asOutLeaf asOutPath asOutShipped
            Integer[] aiClass
            Integer iCount
            Move "loginencryptionkey.inc"                  to asLeaf[0]
            Move "E:\Ws\AppSrc\LoginEncryptionKey.inc"  to asWinner[0]
            Move "E:\Ws\AppSrc\LoginEncryptionKey.inc"  to asAll[0]
            Move "E:\Ws\Libraries\DUF\AppSrc\LoginEncryptionKey.inc" to asAll[1]
            Move "loginencryptionkey.inc" to asShipped[0]
            Get Classified asLeaf asWinner asAll asShipped "E:\Ws" (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiClass) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // One row from one classified copy: the kind, the class and the source name - and NO tick
        // yet, because that needs the two files' bytes, which the pure row builder never reads.
        { Published = True }
        Procedure Shadow_RowCarriesKindSourceAndClass
            Handle ho
            tShadowCopy Row
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get ShadowRowFrom of ho "errornum.inc" "E:\Ws\Pkg\errornum.inc" "C:\DF\Pkg\errornum.inc" eShadowInstall 1 to Row
            Send AssertSAreEqual "errornum.inc" (Row.sLeaf)
            Send AssertSAreEqual "E:\Ws\Pkg\errornum.inc" (Row.sPath)
            Send AssertSAreEqual "C:\DF\Pkg\errornum.inc" (Row.sShipped)
            Send AssertSAreEqual "DataFlex" (Row.sSource)
            Send AssertIAreEqual eShadowInstall (Row.eKind)
            Send AssertIAreEqual 1 (Row.iClass)
            Send Assert (Row.bTicked = False) "a row must not arrive ticked before its content was compared"
            Send Destroy of ho
        End_Procedure

        /* THE TWO NAMED FILES, and they pull in OPPOSITE directions (Nils 2026-09-16:
           "errornum.inc should always have a suggestion to be renamed").

           LoginEncryptionKey.inc is never offered at all - it is right by design, per application.
           errornum.inc is always offered even though it DIFFERS - it does not fork the constants,
           it starves them: its include guard stops the shipped file loading, so the 93 constants
           the 1992 copy never had come back undefined.

           The boundary matters as much as the members: an ordinary DIFFERENT file must keep the
           general default of "let a human look", or the exception has quietly become the rule. */
        {Published = True}
        Procedure Shadow_ErrorNumIsAlwaysOfferedAndLoginKeyNever
            Handle ho
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            // the always-RETIRE member, in the spellings a disk can hand over
            Send Assert (IsAlwaysRetireFile(ho, "errornum.inc"))  "errornum.inc must always be offered"
            Send Assert (IsAlwaysRetireFile(ho, "ERRORNUM.INC"))  "the test is case-insensitive"
            Send Assert (IsAlwaysRetireFile(ho, " errornum.inc ")) "a padded leaf must still match"
            // the always-LEAVE member is NOT also an always-retire one
            Send Assert (IsAlwaysRetireFile(ho, "LoginEncryptionKey.inc") = False) ;
                "the two named lists must not overlap"
            Send Assert (IsPerAppGeneratedFile(ho, "LoginEncryptionKey.inc"))
            Send Assert (IsPerAppGeneratedFile(ho, "errornum.inc") = False)
            // THE BOUNDARY: an ordinary file is in neither list, so it keeps the general default
            Send Assert (IsAlwaysRetireFile(ho, "Working.pkg") = False)
            Send Assert (IsPerAppGeneratedFile(ho, "Working.pkg") = False)
            // a near-miss name must not be swept in by a partial match
            Send Assert (IsAlwaysRetireFile(ho, "errornum.pkg") = False)
            Send Assert (IsAlwaysRetireFile(ho, "myerrornum.inc") = False)
            Send Destroy of ho
        End_Procedure

        // Helper: the lines of a Language_Current.inc as DataFlex ships one, per language.
        Function LanguageLines String sLanguage Returns String[]
            String[] asLines
            Move "// define current language. Included by LanguageText.pkg or LanguageTextWebApp.pkg" to asLines[0]
            Move "// (see LanguageText.pkg for a list of supported languages)." to asLines[1]
            Move "" to asLines[2]
            Move ("Define Language$Current for Language$" + sLanguage) to asLines[3]
            Move ("#Include Language_" + sLanguage + ".inc") to asLines[4]
            Function_Return asLines
        End_Function

        // Helper: an empty scratch folder for one language test, with its separator.
        Function LanguageScratchFolder String sName Returns String
            String sFolder
            Boolean bOk
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_Language" + CS_DirSeparator + sName) to sFolder
            Move (rfRemoveFolderTree(sFolder)) to bOk
            Move (rfDirectoryCreateEx(sFolder, False)) to bOk
            Send Assert bOk "the scratch folder could not be made"
            Function_Return (vFolderFormat(sFolder))
        End_Function

        // Helper: the scratch folders go, once a language test is done.
        Procedure RemoveLanguageScratch
            Boolean bOk
            Move (rfRemoveFolderTree(vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_Language")) to bOk
        End_Procedure

        // Helper: these lines into this file.
        Procedure WriteLanguageFile String sFile String[] asLines
            Boolean bOk
            Get rfWriteEncodedFileFromStringArray (&asLines) sFile C_NewLine False to bOk
            Send Assert bOk ("could not write " + sFile)
        End_Procedure

        /* WHAT MAKES Language_Current.inc A SETTING (Nils 2026-11-05: leave it off the list). It names
           its language AND includes its texts. Measured: the Define alone leaves every C_$ text
           undefined, 237 errors, so that form must answer "" and stay listed as the broken copy it is. */
        {Published = True}
        Procedure Shadow_LanguageSettingNamesItsLanguageAndItsTexts
            Handle ho
            String[] asLines asNone
            String sInclude sOut

            Get Create (RefClass(cShadowedPackageFiles)) to ho
            // as DataFlex ships it
            Get LanguageLines "Svenska" to asLines
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "Svenska" sOut
            Send AssertSAreEqual "Language_Svenska.inc" sInclude
            // the spellings the shipped files and hand edits use, and a comment after each line
            Move "   DEFINE  Language$Current  For  Language$Norsk   // my language" to asLines[3]
            Move "#INCLUDE Language_Norsk.inc // its texts" to asLines[4]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "Norsk" sOut
            Send AssertSAreEqual "Language_Norsk.inc" sInclude
            // THE OLD FORM: the Define alone is no setting, whatever it names
            Get LanguageLines "Svenska" to asLines
            Move "" to asLines[4]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            // the texts alone name no language
            Get LanguageLines "Svenska" to asLines
            Move "" to asLines[3]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            // commented out is not there
            Get LanguageLines "Svenska" to asLines
            Move "// Define Language$Current for Language$Svenska" to asLines[3]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            // a value that is not a named language, and another symbol that happens to be defined
            Get LanguageLines "Svenska" to asLines
            Move "Define Language$Current for 2" to asLines[3]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            Move "Define Language$CurrentOther for Language$Svenska" to asLines[3]
            Get LanguageSettingOf of ho (&asLines) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            // nothing at all
            Get LanguageSettingOf of ho (&asNone) (&sInclude) to sOut
            Send AssertSAreEqual "" sOut
            Send AssertSAreEqual "" sInclude
            Send Destroy of ho
        End_Procedure

        /* THE RENAME CANNOT TAKE A LANGUAGE ANY MORE. A working setting is no row, whether this build
           compiled it or not, so it reaches neither the line, the dialog nor the report. The controls
           are what make that worth anything: the broken Define-only file with the same name IS a row,
           and so is a text file holding the same lines, because only that one name is a setting. */
        {Published = True}
        Procedure Shadow_LanguageSettingGetsNoRowButABrokenOneDoes
            Handle ho
            tShadowCopy[] aRows
            String[] asLines asDefineOnly asLeaf asPath asShipped
            Integer[] aiClass
            String sFolder sFile sText
            Integer iGone

            Get LanguageScratchFolder "Rows" to sFolder
            Move (sFolder + "Language_Current.inc") to sFile
            Move (sFolder + "Language_English.inc") to sText
            Get LanguageLines "Svenska" to asLines
            Send WriteLanguageFile sFile asLines
            Send WriteLanguageFile sText asLines
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to (sFolder + "NoKept.json")

            // class 0, what this build compiled
            Move "Language_Current.inc" to asLeaf[0]
            Move sFile to asPath[0]
            Move 'C:\DF\Pkg\Language_Current.inc' to asShipped[0]
            Move 0 to aiClass[0]
            Send _AppendShadowRows of ho (&aRows) (&asLeaf) (&asPath) (&asShipped) (&aiClass) eShadowInstall (&iGone)
            Send AssertIAreEqual 0 (SizeOfArray(aRows))
            // class 1, the same file where the build did not read it
            Move 1 to aiClass[0]
            Send _AppendShadowRows of ho (&aRows) (&asLeaf) (&asPath) (&asShipped) (&aiClass) eShadowInstall (&iGone)
            Send AssertIAreEqual 0 (SizeOfArray(aRows))
            Send AssertIAreEqual 0 iGone

            // the text file with the same lines keeps the general rule
            Move "Language_English.inc" to asLeaf[0]
            Move sText to asPath[0]
            Move 'C:\DF\Pkg\Language_English.inc' to asShipped[0]
            Send _AppendShadowRows of ho (&aRows) (&asLeaf) (&asPath) (&asShipped) (&aiClass) eShadowInstall (&iGone)
            Send AssertIAreEqual 1 (SizeOfArray(aRows))

            // the Define alone: listed, unticked, like any copy that differs
            Move (ResizeArray(aRows, 0)) to aRows
            Move "Define Language$Current for Language$Svenska" to asDefineOnly[0]
            Send WriteLanguageFile sFile asDefineOnly
            Move "Language_Current.inc" to asLeaf[0]
            Move sFile to asPath[0]
            Move 'C:\DF\Pkg\Language_Current.inc' to asShipped[0]
            Send _AppendShadowRows of ho (&aRows) (&asLeaf) (&asPath) (&asShipped) (&aiClass) eShadowInstall (&iGone)
            Send AssertIAreEqual 1 (SizeOfArray(aRows))
            If (SizeOfArray(aRows) = 1) ;
                Send AssertFalse (aRows[0].bTicked) "a broken setting that differs must not arrive ticked"
            Send Destroy of ho
            Send RemoveLanguageScratch
        End_Procedure

        /* WHICH FOLDERS THE OFFER LOOKS IN. Only what the compiler searches and the workspace owns: a
           setting in a folder off the path was never read, so a rename took nothing from it. */
        {Published = True}
        Procedure Shadow_OwnFoldersOnSearchPathKeepTheirOrder
            Handle ho
            String[] asOut
            String sOut

            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get OwnFoldersOnSearchPath of ho 'E:\Ws\AppSrc;E:\Ws\DfPkg\Lib-1.0\AppSrc; E:\Ws\Libraries\Foo\AppSrc;C:\DF\Pkg;;E:\Ws\DdSrc' 'E:\Ws' to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            If (SizeOfArray(asOut) = 2) Begin
                Send AssertSAreEqual 'E:\Ws\AppSrc' asOut[0]
                Send AssertSAreEqual 'E:\Ws\DdSrc' asOut[1]
            End
            Get OwnFoldersOnSearchPath of ho '' 'E:\Ws' to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Get LiveLanguageSettingPath of ho 'E:\Ws\AppSrc\language_current.inc.shadowed2' to sOut
            Send AssertSAreEqual 'E:\Ws\AppSrc\Language_Current.inc' sOut
            Send Destroy of ho
        End_Procedure

        /* THE WAY BACK (Nils 2026-11-05: yes, offer it on the board). Offered only when renaming it
           back would do what the offer says, so every reason not to has its own assert, and the
           positive comes first: it is what the negatives are measured against. */
        {Published = True}
        Procedure Shadow_RetiredLanguageSettingIsOfferedOnlyWhenItWouldMatter
            Handle ho
            String[] asLines asDefineOnly asFolders asNone asRead
            String sOwn sOther sInstall sRetired sTexts sLive sNumbered sLanguage sOut sWhy
            Boolean bThere bOk

            Get LanguageScratchFolder "Own"     to sOwn
            Get LanguageScratchFolder "Other"   to sOther
            Get LanguageScratchFolder "Install" to sInstall
            Move sOwn   to asFolders[0]
            Move sOther to asFolders[1]
            Move (sOwn + "Language_Current.inc.shadowed") to sRetired
            Move (sOwn + "Language_Current.inc") to sLive
            Move (sOwn + "Language_Svenska.inc") to sTexts
            Get LanguageLines "Svenska" to asLines
            Send WriteLanguageFile sRetired asLines
            Send WriteLanguageFile sTexts asLines
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to (sInstall + "Kept.json")

            // OFFERED: another language than the install's, its texts in reach, nothing live
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual (Lowercase(sRetired)) (Lowercase(sOut))
            Send AssertSAreEqual "Svenska" sLanguage

            // the install picks the same language: the rename changed nothing
            Get RetiredLanguageSettingIn of ho asFolders sInstall "svenska" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut
            Send AssertSAreEqual "" sLanguage

            // its folder is not on the search path
            Get RetiredLanguageSettingIn of ho asNone sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut

            // MEASURED, 238 errors: its texts out of reach must not be offered...
            Move (rfDeleteFile(sTexts)) to bOk
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut
            // ...and the install holding them is reach enough
            Send WriteLanguageFile (sInstall + "Language_Svenska.inc") asLines
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual (Lowercase(sRetired)) (Lowercase(sOut))
            Move (rfDeleteFile(sInstall + "Language_Svenska.inc")) to bOk
            Send WriteLanguageFile sTexts asLines

            // a live setting anywhere on the path is the answer now
            Send WriteLanguageFile (sOther + "Language_Current.inc") asLines
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut
            Move (rfDeleteFile(sOther + "Language_Current.inc")) to bOk

            // the Define alone was broken: the rename was right
            Move "Define Language$Current for Language$Svenska" to asDefineOnly[0]
            Send WriteLanguageFile sRetired asDefineOnly
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut
            Send WriteLanguageFile sRetired asLines

            // the board's other answer ends the line, and only that file's
            Send RememberKept of ho sRetired "Language_Current.inc.shadowed"
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut
            Send ForgetKept of ho sRetired
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual (Lowercase(sRetired)) (Lowercase(sOut))

            // a numbered twin is found when the plain name is gone
            Move (sRetired + "2") to sNumbered
            Move (rfRenameFile(sRetired, sNumbered)) to sWhy
            Send AssertSAreEqual "" sWhy
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual (Lowercase(sNumbered)) (Lowercase(sOut))
            Move (rfRenameFile(sNumbered, sRetired)) to sWhy
            Send AssertSAreEqual "" sWhy

            // RENAMED BACK: the live name holds the same lines, the retired one is gone, and the
            // offer ends because a live setting now answers
            Get RestoreLanguageSetting of ho sRetired to sWhy
            Send AssertSAreEqual "" sWhy
            File_Exist sRetired bThere
            Send AssertFalse bThere "the retired name should be gone"
            Move (rfReadEncodedFileAsStringArray(sLive)) to asRead
            Send AssertIAreEqual (SizeOfArray(asLines)) (SizeOfArray(asRead))
            Get RetiredLanguageSettingIn of ho asFolders sInstall "English" (&sLanguage) to sOut
            Send AssertSAreEqual "" sOut

            // never over a live file: a retired twin stays, and the reason is given
            Send WriteLanguageFile sRetired asDefineOnly
            Get RestoreLanguageSetting of ho sRetired to sWhy
            Send Assert (sWhy <> "") "a rename back must refuse to overwrite a live setting"
            Move (rfReadEncodedFileAsStringArray(sLive)) to asRead
            Send AssertIAreEqual (SizeOfArray(asLines)) (SizeOfArray(asRead))

            Send Destroy of ho
            Send RemoveLanguageScratch
        End_Procedure

        /* WHAT MAKES A "KEEP" STICK (2026-09-15). The dialog's "keep the other M" records the
           unticked copies as the user's forks, and from then on the line and the dialog leave them
           out - until the "M kept" chip forgets them. Written only by that press, never inferred.

           The round-trip is driven through psKeptShadowsFile, and that seam is why this test is
           worth anything: under UnitTests ghoApplication is a plain cApplication, so the
           production path builder (SavedPlanJsonPath) COMPILES and returns "" - a fixture that went
           through it would write nowhere, read nothing back, and pass. See
           [[feedback_test_runner_app_class]].

           All three states are pinned, and the NEGATIVE is the one that matters: if IsKeptShadow
           ever answered True for a path never kept, the line would silently stop offering copies
           the user never judged - a failure that looks exactly like nothing being wrong. */
        { Published = True }
        Procedure Shadow_KeptPathIsRemembered
            Handle ho
            String sScratch sDataPath sPathA sPathB
            Boolean bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_KeptShadowsTest.json") to sScratch
            Move (rfDeleteFile(sScratch)) to bOk
            Move 'E:\Ws\AppSrc\Working.pkg'   to sPathA
            Move 'E:\Ws\AppSrc\StartProg.pkg' to sPathB

            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to sScratch

            // Nothing kept yet - both must still be offered.
            Send Assert (IsKeptShadow(ho, sPathA) = False) "an untouched path was reported as kept"
            Send Assert (IsKeptShadow(ho, sPathB) = False)

            // Keep one. It is remembered; its neighbour is NOT.
            Send RememberKept of ho sPathA "Working.pkg"
            Send Assert (IsKeptShadow(ho, sPathA) = True)  "a kept path was forgotten"
            Send Assert (IsKeptShadow(ho, sPathB) = False) "keeping one path marked another"

            // Idempotent - a second keep of the same path must not double the record or lose it.
            Send RememberKept of ho sPathA "Working.pkg"
            Send Assert (IsKeptShadow(ho, sPathA) = True)

            // ...and it SURVIVES a fresh object, which is the whole point: the record is on disk,
            // not in this instance.
            Send Destroy of ho
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to sScratch
            Send Assert (IsKeptShadow(ho, sPathA) = True) "the record did not survive a reload"

            // The way back, for a user who changes their mind.
            Send ForgetKept of ho sPathA
            Send Assert (IsKeptShadow(ho, sPathA) = False) "ForgetKept left the path recorded"
            Send Destroy of ho

            Move (rfDeleteFile(sScratch)) to bOk
        End_Procedure

        // Helpers: the two pure predicates behind the board's replaced-library line, reached
        // through an instance like the rest of this fixture.
        Function Orphaned String sLibFolder String[] asDeclared Returns Boolean
            Handle ho
            Boolean bOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get IsOrphanedLibraryFolder of ho sLibFolder asDeclared to bOut
            Send Destroy of ho
            Function_Return bOut
        End_Function

        Function RetireName String sFolder String[] asTaken Returns String
            Handle ho
            String sOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get RetireTargetName of ho sFolder asTaken to sOut
            Send Destroy of ho
            Function_Return sOut
        End_Function

        Function ShadowName String sFile String[] asTaken Returns String
            Handle ho
            String sOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get ShadowTargetName of ho sFile asTaken to sOut
            Send Destroy of ho
            Function_Return sOut
        End_Function

        /* WHAT KEEPS A LIBRARY FOLDER ALIVE IS A DECLARED PATH, NOT ITS NAME. This is the whole
           reason the detector cannot use the .sws text: a git dependency's URL contains the name of
           the library it replaced, so a name test would call every replaced folder declared for
           ever. The declared set here is what GetWorkspaceLibrarySourceFolders answers - source
           folders of libraries the workspace still declares - and a folder survives only when one
           of them is AT or UNDER it.

           The sibling case is the one a prefix test gets wrong: Libraries\Foo must not be kept
           alive by a declaration inside Libraries\FooBar. */
        {Published = True}
        Procedure ShadowedPackages_OrphanedFolderIsDecidedByDeclaredPaths
            String[] asDeclared asNone

            Move 'E:\Ws\Libraries\Kept\AppSrc'    to asDeclared[0]
            Move 'E:\Ws\Libraries\FooBar\AppSrc'  to asDeclared[1]
            Move 'E:\Ws\Libraries\AtItself'       to asDeclared[2]

            // Declared THROUGH a source folder inside it, and declared AS itself: both keep it.
            Send AssertFalse (Orphaned(Self, 'E:\Ws\Libraries\Kept',     asDeclared))
            Send AssertFalse (Orphaned(Self, 'E:\Ws\Libraries\AtItself', asDeclared))
            // Nothing points into it - the state a library-to-package swap leaves behind.
            Send Assert      (Orphaned(Self, 'E:\Ws\Libraries\Gone',     asDeclared))
            // A SIBLING whose name merely starts the same must not keep it alive.
            Send Assert      (Orphaned(Self, 'E:\Ws\Libraries\Foo',      asDeclared))
            // Windows hides path case, and a trailing separator is not a difference.
            Send AssertFalse (Orphaned(Self, 'e:\ws\libraries\KEPT',     asDeclared))
            Send AssertFalse (Orphaned(Self, 'E:\Ws\Libraries\Kept\',    asDeclared))
            // An earlier round already retired these - they are not offered twice.
            Send AssertFalse (Orphaned(Self, 'E:\Ws\Libraries\Gone.OLD',  asDeclared))
            Send AssertFalse (Orphaned(Self, 'E:\Ws\Libraries\Gone.OLD2', asDeclared))
            // Only the LAST segment is judged, so a workspace living under an .old path is safe.
            Send Assert      (Orphaned(Self, 'E:\Ws.old\Libraries\Gone',  asDeclared))
            // Nothing declared at all: every folder there is orphaned.
            Send Assert      (Orphaned(Self, 'E:\Ws\Libraries\Kept',     asNone))
            Send AssertFalse (Orphaned(Self, '',                          asDeclared))
        End_Procedure

        /* THE FILE TWIN OF THE RETIRE NAME (2026-09-14). A first [Rename them] leaves <file>.shadowed, a
           Revert puts the live copy back, "Offer them again" forgets the retire, and the next [Rename
           them] must step past that twin instead of failing on it - three "a file of that name already
           exists" refusals on a real copy, and a row that kept offering the same press. */
        {Published = True}
        Procedure ShadowedPackages_ShadowTargetNameNumbersPastTheTakenOnes
            String[] asTaken asNone
            String sOut
            Integer i

            Get ShadowName 'E:\Ws\AppSrc\oMenu.pkg' asNone to sOut
            Send AssertSAreEqual 'E:\Ws\AppSrc\oMenu.pkg.shadowed' sOut
            // The taken list arrives LOWERCASED (the caller folds it); the file does not.
            Move 'e:\ws\appsrc\omenu.pkg.shadowed' to asTaken[0]
            Get ShadowName 'E:\Ws\AppSrc\oMenu.pkg' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\AppSrc\oMenu.pkg.shadowed2' sOut
            Move 'e:\ws\appsrc\omenu.pkg.shadowed2' to asTaken[1]
            Get ShadowName 'E:\Ws\AppSrc\oMenu.pkg' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\AppSrc\oMenu.pkg.shadowed3' sOut
            // another file's twin is not in the way
            Get ShadowName 'E:\Ws\AppSrc\oOther.pkg' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\AppSrc\oOther.pkg.shadowed' sOut
            // every name up to 99 taken: "" rather than a 100th guess, which the caller reports
            Move (ResizeArray(asTaken, 0)) to asTaken
            Move 'e:\ws\appsrc\omenu.pkg.shadowed' to asTaken[0]
            For i from 2 to 99
                Move ('e:\ws\appsrc\omenu.pkg.shadowed' + String(i)) to asTaken[SizeOfArray(asTaken)]
            Loop
            Get ShadowName 'E:\Ws\AppSrc\oMenu.pkg' asTaken to sOut
            Send AssertSAreEqual '' sOut
            Get ShadowName '' asNone to sOut
            Send AssertSAreEqual '' sOut
        End_Procedure

        // ...and the twins are found ON DISK beside the file, and compared by content.
        {Published = True}
        Procedure ShadowedPackages_TakenTwinsAreFoundBesideTheFile
            Handle ho
            String[] asLines asTaken
            String sDataPath sFile sTwin
            Boolean bOk bSame
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "ZShadowTwin.pkg") to sFile
            Move (sFile + ".shadowed") to sTwin
            Move "Use Windows.pkg" to asLines[0]
            Move "// a copy"       to asLines[1]
            Get rfWriteEncodedFileFromStringArray (&asLines) sFile C_NewLine False to bOk
            Send Assert bOk
            Get rfWriteEncodedFileFromStringArray (&asLines) sTwin C_NewLine False to bOk
            Send Assert bOk
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get _ShadowNamesTaken of ho sFile to asTaken
            Send AssertIAreEqual 1 (SizeOfArray(asTaken))
            If (SizeOfArray(asTaken) = 1) ;
                Send AssertSAreEqual (Lowercase(sTwin)) asTaken[0]
            Get _SameFileContent of ho sFile sTwin to bSame
            Send Assert bSame
            Move "// changed" to asLines[1]
            Get rfWriteEncodedFileFromStringArray (&asLines) sTwin C_NewLine False to bOk
            Get _SameFileContent of ho sFile sTwin to bSame
            Send AssertFalse bSame
            Send Destroy of ho
            Move (rfDeleteFile(sFile)) to iVoid
            Move (rfDeleteFile(sTwin)) to iVoid
        End_Procedure

        /* THE RETIRE NAME STEPS OVER WHAT IS ALREADY THERE. rfRenameFile refuses to overwrite, so a
           name that is taken fails the rename rather than destroying the copy an earlier retire
           left - but only a correct number reaches a free name at all, and that copy is the only
           thing the user could restore from. */
        {Published = True}
        Procedure ShadowedPackages_RetireNameNumbersPastTheTakenOnes
            String[] asTaken asNone
            String sOut
            Integer i

            Get RetireName 'E:\Ws\Libraries\DUF' asNone to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\DUF.OLD' sOut

            // The taken list arrives LOWERCASED (the caller folds it); the folder does not.
            Move 'e:\ws\libraries\duf.old' to asTaken[0]
            Get RetireName 'E:\Ws\Libraries\DUF' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\DUF.OLD2' sOut

            Move 'e:\ws\libraries\duf.old2' to asTaken[1]
            Get RetireName 'E:\Ws\Libraries\DUF' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\DUF.OLD3' sOut

            // A trailing separator must not become "DUF\.OLD".
            Get RetireName 'E:\Ws\Libraries\DUF\' asNone to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\DUF.OLD' sOut

            // A sibling of ANOTHER name is not in the way.
            Move 'e:\ws\libraries\other.old' to asTaken[2]
            Get RetireName 'E:\Ws\Libraries\Other2' asTaken to sOut
            Send AssertSAreEqual 'E:\Ws\Libraries\Other2.OLD' sOut

            // Every name up to 99 taken: "" rather than a 100th guess, which the caller reports.
            Move (ResizeArray(asTaken, 0)) to asTaken
            Move 'e:\ws\libraries\duf.old' to asTaken[0]
            For i from 2 to 99
                Move ('e:\ws\libraries\duf.old' + String(i)) to asTaken[SizeOfArray(asTaken)]
            Loop
            Get RetireName 'E:\Ws\Libraries\DUF' asTaken to sOut
            Send AssertSAreEqual '' sOut

            Get RetireName '' asNone to sOut
            Send AssertSAreEqual '' sOut
        End_Procedure

        // Helper: LibraryFoldersNoLongerListed, reached through an instance like the rest here.
        Function NoLongerListed String sHome String[] asBefore String[] asNow Returns String[]
            Handle ho
            String[] asOut
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get LibraryFoldersNoLongerListed of ho sHome asBefore asNow to asOut
            Send Destroy of ho
            Function_Return asOut
        End_Function

        /* WHAT A LIST CHANGE STOPPED USING IS A FOLDER, NOT AN ENTRY. The question the Libraries
           dialog asks at close is built from this. Alpha lost its only entry: offered. Beta lost one
           of its two .sws files and keeps the other: NOT offered - renaming it would break the build
           on the entry the user kept. Gamma lost both of its entries: offered ONCE. An entry outside
           <home>\Libraries (a pool beside the home) is never this code's to offer. */
        {Published = True}
        Procedure ShadowedPackages_NoLongerListedIsFolderAgainstFolder
            String[] asBefore asNow asOut

            Move 'Libraries\Alpha\Alpha19.1.sws' to asBefore[0]
            Move 'Libraries\Beta\Beta19.1.sws'   to asBefore[1]
            Move 'Libraries\Beta\Beta25.0.sws'   to asBefore[2]
            Move 'Libraries\Gamma\Gamma19.1.sws' to asBefore[3]
            Move 'Libraries\Gamma\Gamma25.0.sws' to asBefore[4]
            Move '..\Pool\Delta\Delta.sws'       to asBefore[5]

            Move 'Libraries\Beta\Beta25.0.sws'   to asNow[0]

            Get NoLongerListed 'E:\Ws' asBefore asNow to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            If (SizeOfArray(asOut) = 2) Begin
                Send AssertSAreEqual 'E:\Ws\Libraries\Alpha' asOut[0]
                Send AssertSAreEqual 'E:\Ws\Libraries\Gamma' asOut[1]
            End

            // Nothing removed: nothing to offer, so the dialog closes without a question.
            Get NoLongerListed 'E:\Ws' asBefore asBefore to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        /* THE CONVERSION IS NOT A REMOVAL. df-cli rewrites every entry when it converts a workspace
           to the JSON format - forward slashes, and whatever case the tool writes - and a library
           kept through that must not be offered. Only the one that became a GIT dependency is: its
           URL names the library, but names no folder, and a name test would have kept it forever.
           An absolute entry into the home's Libraries is the same folder as the relative one. */
        {Published = True}
        Procedure ShadowedPackages_NoLongerListedSurvivesTheJsonConversion
            String[] asBefore asNow asOut

            Move 'Libraries\Alpha\Alpha19.1.sws' to asBefore[0]
            Move 'Libraries\Beta\Beta19.1.sws'   to asBefore[1]
            Move 'Libraries\Gamma\Gamma19.1.sws' to asBefore[2]

            Move 'libraries/ALPHA/Alpha19.1.sws'               to asNow[0]
            Move 'https://github.com/Someone/Library-Beta.git' to asNow[1]
            Move 'E:\Ws\Libraries\Gamma\Gamma26.0.sws'         to asNow[2]

            Get NoLongerListed 'E:\Ws' asBefore asNow to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            If (SizeOfArray(asOut) = 1) ;
                Send AssertSAreEqual 'E:\Ws\Libraries\Beta' asOut[0]
        End_Procedure

        /* THE NOTE IS DECIDED BY WHAT THE BUILD COMPILED, NOT BY A NAME COUNT (2026-09-11). It used to
           say "N copies of this file exist here; the build uses THIS one" on any row whose file name
           occurred twice under the home - true or not, and never saying where the other copy was.
           Now the row about the compiled copy gets NO note, a row about a different file of a
           compiled name gets the compiled copy named, and a name the build never compiled gets
           nothing. */
        {Published = True}
        Procedure ShadowedPackages_NoteOnlyWhereTheBuildCompiledAnotherCopy
            String[] asCompiled asLeaf asBuilt
            Integer iAt

            Move 'E:\Ws\AppSrc\Helpers.pkg'                       to asCompiled[0]
            Move 'E:\Ws\AppSrc\Main.src'                          to asCompiled[1]
            Move 'C:\Program Files\DataFlex 26.0\Pkg\Windows.pkg' to asCompiled[2]
            Move 'E:\Ws\AppSrc\pers.pkg'                          to asCompiled[3]

            Move (CompiledLeafIndex(asCompiled, &asBuilt)) to asLeaf
            Send AssertIAreEqual 4 (SizeOfArray(asLeaf))
            Send AssertIAreEqual 4 (SizeOfArray(asBuilt))

            Move (BinarySearchArray(FileLeafLower('E:\Ws\AppSrc\Helpers.pkg'), asLeaf)) to iAt
            Send Assert (iAt <> -1) "a compiled file's name must be in the index"
            If (iAt <> -1) Begin
                // The row IS the compiled copy, whatever its case: nothing to say.
                Send AssertSAreEqual '' (CompiledCopyFor('E:\Ws\AppSrc\Helpers.pkg', asBuilt[iAt]))
                Send AssertSAreEqual '' (CompiledCopyFor('e:\ws\appsrc\HELPERS.PKG', asBuilt[iAt]))
                // A row about ANOTHER file of that name - a language-variant folder the build never
                // searches: the compiled copy is named.
                Send AssertSAreEqual 'E:\Ws\AppSrc\Helpers.pkg' (CompiledCopyFor('E:\Ws\AppSrc\Variant\Helpers.pkg', asBuilt[iAt]))
            End
            // A local copy of an install package the build did NOT pick: the installed one is named.
            Move (BinarySearchArray(FileLeafLower('E:\Ws\AppSrc\Windows.pkg'), asLeaf)) to iAt
            Send Assert (iAt <> -1) "an install package's name must be in the index too"
            If (iAt <> -1) ;
                Send AssertSAreEqual 'C:\Program Files\DataFlex 26.0\Pkg\Windows.pkg' (CompiledCopyFor('E:\Ws\AppSrc\Windows.pkg', asBuilt[iAt]))
            // A name the build never compiled is not in the index, so no note.
            Send AssertIAreEqual (-1) (BinarySearchArray(FileLeafLower('E:\Ws\AppSrc\Unused.pkg'), asLeaf))
            // A name that is the TAIL of another ("pers.pkg" in "Helpers.pkg") is its own entry.
            Move (BinarySearchArray('pers.pkg', asLeaf)) to iAt
            Send Assert (iAt <> -1) "pers.pkg is its own entry"
            If (iAt <> -1) ;
                Send AssertSAreEqual 'E:\Ws\AppSrc\pers.pkg' (CompiledCopyFor('E:\Ws\Other\pers.pkg', asBuilt[iAt]))
        End_Procedure

        /* TWO COMPILED FILES OF ONE NAME - a Use naming a relative path can do it. Both are kept; a
           row about either is the compiled copy, and a row about a third file of that name is told
           about the first. No listing is an empty index. */
        {Published = True}
        Procedure ShadowedPackages_TwoCompiledFilesOfOneName
            String[] asCompiled asLeaf asBuilt asNone
            Integer iAt

            Move 'E:\Ws\AppSrc\Helpers.pkg'     to asCompiled[0]
            Move 'E:\Ws\AppSrc\Sub\Helpers.pkg' to asCompiled[1]
            Move (CompiledLeafIndex(asCompiled, &asBuilt)) to asLeaf
            Send AssertIAreEqual 1 (SizeOfArray(asLeaf))
            Move (BinarySearchArray('helpers.pkg', asLeaf)) to iAt
            Send AssertIAreEqual 0 iAt
            If (iAt = 0) Begin
                Send AssertSAreEqual '' (CompiledCopyFor('E:\Ws\AppSrc\Helpers.pkg',     asBuilt[0]))
                Send AssertSAreEqual '' (CompiledCopyFor('E:\Ws\AppSrc\Sub\Helpers.pkg', asBuilt[0]))
                Send AssertSAreEqual 'E:\Ws\AppSrc\Helpers.pkg' (CompiledCopyFor('E:\Ws\Old\Helpers.pkg', asBuilt[0]))
            End

            Move (CompiledLeafIndex(asNone, &asBuilt)) to asLeaf
            Send AssertIAreEqual 0 (SizeOfArray(asLeaf))
            Send AssertIAreEqual 0 (SizeOfArray(asBuilt))
        End_Procedure

        /* THE WORDS. The program comes from the listing's own name (Main.x64.prn is Main.src's), and
           the compiled copy is shown relative to the home when it is inside it - so the note fits
           the cell it leads - but a folder that merely STARTS like the home is not inside it. */
        {Published = True}
        Procedure ShadowedPackages_NoteNamesProgramAndCopy
            Send AssertSAreEqual 'Main.src' (ProgramOfListing('E:\Ws\AppSrc\Main.x64.prn'))
            Send AssertSAreEqual 'Main.src' (ProgramOfListing('E:\Ws\AppSrc\Main.prn'))
            Send AssertSAreEqual ''         (ProgramOfListing('E:\Ws\AppSrc\Main.err'))
            Send AssertSAreEqual ''         (ProgramOfListing(''))

            Send AssertSAreEqual 'Main.src compiles AppSrc\Helpers.pkg, not this copy.' ;
                (Trim(CompiledElsewhereNote('Main.src', 'E:\Ws\AppSrc\Helpers.pkg', 'E:\Ws')))
            Send AssertSAreEqual 'Main.src compiles AppSrc\Helpers.pkg, not this copy.' ;
                (Trim(CompiledElsewhereNote('Main.src', 'e:\ws\AppSrc\Helpers.pkg', 'E:\Ws\')))
            Send AssertSAreEqual 'Main.src compiles E:\Ws2\AppSrc\Helpers.pkg, not this copy.' ;
                (Trim(CompiledElsewhereNote('Main.src', 'E:\Ws2\AppSrc\Helpers.pkg', 'E:\Ws')))
            Send AssertSAreEqual 'The last build compiled AppSrc\Helpers.pkg, not this copy.' ;
                (Trim(CompiledElsewhereNote('', 'E:\Ws\AppSrc\Helpers.pkg', 'E:\Ws')))
            Send AssertSAreEqual '' (CompiledElsewhereNote('Main.src', '', 'E:\Ws'))
        End_Procedure

        /* A COPY COMPILED IN PLACE OF THE FILE OF A PACKAGE THAT FAILS (2026-11-12). A workspace's leftover
           AppSrc\LANGUAGE.PKG won over VDFQuery20's language.pkg, and the package's dates.nui failed against
           it - 76 errors, none of them pointing at the copy. First the pieces: the package a pool file sits
           in, its name, and the file an ERROR line of a listing names (a warning's is not counted). */
        { Published = True }
        Procedure Shadow_FailingPackage_RootNameAndErrorFile
            Handle ho
            String s
            Send AssertSAreEqual "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\" (PoolPackageRootOf("E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"))
            Send AssertSAreEqual "C:\ProgramData\DataFlex\Packages\Cache\Owner_Lib-1.0.1\" (PoolPackageRootOf("C:\ProgramData\DataFlex\Packages\Cache\Owner_Lib-1.0.1\AppSrc\a.pkg"))
            Send AssertSAreEqual "" (PoolPackageRootOf("E:\Ws\AppSrc\LANGUAGE.PKG"))
            Send AssertSAreEqual "" (PoolPackageRootOf("E:\Ws\DfPkg\loose.pkg"))
            Send AssertSAreEqual "VDFQuery20" (PoolPackageDisplayNameOf("E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c047b1a5ce0f9b0434ef588b0fcba5cf36\AppSrc\language.pkg"))
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get ErrorFileFromPrnLine of ho "ERROR: 52 Undefined symbol ON LINE: 67 (67) OF FILE: E:\Ws\DfPkg\P-1\AppSrc\dates.nui" to s
            Send AssertSAreEqual "E:\Ws\DfPkg\P-1\AppSrc\dates.nui" s
            Get ErrorFileFromPrnLine of ho "WARNING: 4534 A warning ON LINE: 3 (3) OF FILE: E:\Ws\DfPkg\P-1\AppSrc\a.pkg" to s
            Send AssertSAreEqual "" s
            Get ErrorFileFromPrnLine of ho "    Move 1 to iX  // ERROR: not a message" to s
            Send AssertSAreEqual "" s
            Send Destroy of ho
        End_Procedure

        // Helper: FailingPackageCopies through an instance, with the home E:\Ws.
        Function FailingCopies String[] asLeaf String[] asWinner String[] asAll String[] asErr ;
                String[] ByRef asOutLeaf String[] ByRef asOutPath String[] ByRef asOutShipped Integer[] ByRef aiErrors Returns Integer
            Handle ho
            Integer iCount
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get FailingPackageCopies of ho (&asLeaf) (&asWinner) (&asAll) (&asErr) "E:\Ws" ;
                (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send Destroy of ho
            Function_Return iCount
        End_Function

        // The case itself: the copy, the package's file it stood in front of, and the package's errors.
        { Published = True }
        Procedure Shadow_FailingPackage_CompiledCopyIsFound
            String[] asLeaf asWinner asAll asErr asOutLeaf asOutPath asOutShipped
            Integer[] aiErrors
            Integer iCount
            Move "language.pkg"                                                to asLeaf[0]
            Move "E:\Ws\AppSrc\LANGUAGE.PKG"                                   to asWinner[0]
            Move "dates.nui"                                                   to asLeaf[1]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asWinner[1]
            Move "E:\Ws\AppSrc\LANGUAGE.PKG"                                   to asAll[0]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\language.pkg"   to asAll[1]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asAll[2]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asErr[0]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asErr[1]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asErr[2]
            Move "E:\Ws\AppSrc\Main.src"                                       to asErr[3]     // the workspace's own error: no package
            Get FailingCopies asLeaf asWinner asAll asErr (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual "LANGUAGE.PKG" asOutLeaf[0]
            Send AssertSAreEqual "E:\Ws\AppSrc\LANGUAGE.PKG" asOutPath[0]
            Send AssertSAreEqual "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\language.pkg" asOutShipped[0]
            Send AssertIAreEqual 3 aiErrors[0]
        End_Procedure

        /* ...AND NOTHING ELSE, which is what keeps Nils's rule of 2026-10-05: no row when the package has
           no error in this build, when the errors are another package's, when the build compiled the
           package's own file, or when the build did not read the workspace's copy. */
        { Published = True }
        Procedure Shadow_FailingPackage_NoRowWithoutItsErrors
            String[] asLeaf asWinner asAll asErr asNone asOther asOutLeaf asOutPath asOutShipped
            Integer[] aiErrors
            Integer iCount
            Move "E:\Ws\AppSrc\LANGUAGE.PKG"                                   to asAll[0]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\language.pkg"   to asAll[1]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui"      to asErr[0]
            Move "E:\Ws\DfPkg\Someone_Other-1.0.0\AppSrc\x.pkg"                to asOther[0]
            // the workspace's copy compiled ...
            Move "language.pkg"                to asLeaf[0]
            Move "E:\Ws\AppSrc\LANGUAGE.PKG"   to asWinner[0]
            // ... with no errors at all, and with another package's
            Get FailingCopies asLeaf asWinner asAll asNone (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send AssertIAreEqual 0 iCount
            Get FailingCopies asLeaf asWinner asAll asOther (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send AssertIAreEqual 0 iCount
            // the package's own file compiled
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\language.pkg" to asWinner[0]
            Get FailingCopies asLeaf asWinner asAll asErr (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send AssertIAreEqual 0 iCount
            // the workspace's copy not read: the build compiled another name only
            Move "dates.nui" to asLeaf[0]
            Move "E:\Ws\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui" to asWinner[0]
            Get FailingCopies asLeaf asWinner asAll asErr (&asOutLeaf) (&asOutPath) (&asOutShipped) (&aiErrors) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        /* THE ROW, ON A REAL DISK: two scratch files, the workspace's copy differing from the package's.
           One row of the second kind, named by the package, with its errors, compiled, and NOT ticked -
           it differs, and a package can fail for reasons of its own. */
        { Published = True }
        Procedure Shadow_FailingPackage_RowOnDisk
            Handle ho
            String[] asLeaf asWinner asAll asErr asLines
            tShadowCopy[] aRows
            String sHome sCopy sPkgFile
            Integer iCount iGone
            Boolean bOk
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_FailingPackage") to sHome
            Move (rfRemoveFolderTree(sHome)) to bOk
            Move (sHome + "\AppSrc\LANGUAGE.PKG") to sCopy
            Move (sHome + "\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\language.pkg") to sPkgFile
            Move (rfDirectoryCreateEx((sHome + "\AppSrc"), False)) to bOk
            Send Assert bOk "the scratch AppSrc could not be made"
            Move (rfDirectoryCreateEx((sHome + "\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc"), False)) to bOk
            Send Assert bOk "the scratch package folder could not be made"
            Move "Define lng_default for !@" to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) sCopy C_NewLine False to bOk
            Send Assert bOk "could not write the copy"
            Move "Define lng_default for LNG_ENGLISH" to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) sPkgFile C_NewLine False to bOk
            Send Assert bOk "could not write the package's file"
            Move "language.pkg" to asLeaf[0]
            Move sCopy          to asWinner[0]
            Move sCopy          to asAll[0]
            Move sPkgFile       to asAll[1]
            Move (sHome + "\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui") to asErr[0]
            Move (sHome + "\DfPkg\NilsSve_VDFQuery20-904dc8c\AppSrc\dates.nui") to asErr[1]
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Set psKeptShadowsFile of ho to (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_NoKeptShadows.json")
            Get ShadowCopiesFrom of ho (&asLeaf) (&asWinner) sHome (&asAll) (&asErr) (&aRows) (&iGone) to iCount
            Send Destroy of ho
            Move (rfRemoveFolderTree(sHome)) to bOk
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 0 iGone
            If (iCount = 1) Begin
                Send AssertIAreEqual eShadowFailingPackage aRows[0].eKind
                Send AssertIAreEqual 0 aRows[0].iClass
                Send AssertSAreEqual "VDFQuery20" aRows[0].sSource
                Send AssertIAreEqual 2 aRows[0].iPackageErrors
                Send AssertSAreEqual sPkgFile aRows[0].sShipped
                Send AssertFalse aRows[0].bSame
                Send AssertFalse aRows[0].bTicked
            End
        End_Procedure

        /* WHAT A COPY DECLARES (2026-11-12): by a line's first word, comments left out, a Class's methods
           and properties apart - they are used as messages only. */
        { Published = True }
        Procedure Shadow_AddsNothingUsed_DeclaredNames
            Handle ho
            String[] asLines asNames asMethods
            Move "Class cPrnX is a cObject"                          to asLines[0]
            Move "    Procedure PageSetupDlg"                        to asLines[1]
            Move "    End_Procedure"                                 to asLines[2]
            Move "    Property Integer Prompt_Print_Dialog 0"        to asLines[3]
            Move "    Function PointerToString Pointer p Returns String" to asLines[4]
            Move "    End_Function"                                  to asLines[5]
            Move "End_Class"                                         to asLines[6]
            Move "Define C_X for 1  // Procedure NotThis"            to asLines[7]
            Move "Struct tPOINT"                                     to asLines[8]
            Move "/* Function Hidden"                                to asLines[9]
            Move "   Procedure AlsoHidden */ #Replace RX 2"          to asLines[10]
            Move "Procedure Set Glob Global Integer i"               to asLines[11]
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Send DeclaredNamesOf of ho (&asLines) (&asNames) (&asMethods)
            Send Destroy of ho
            // RX is live code: it follows the end of the block comment on the same line
            Send AssertSAreEqual "CPRNX|PAGESETUPDLG|PROMPT_PRINT_DIALOG|POINTERTOSTRING|C_X|TPOINT|RX|GLOB" (StrJoinFromArray(asNames, "|"))
            Send AssertSAreEqual "PAGESETUPDLG|PROMPT_PRINT_DIALOG|POINTERTOSTRING" (StrJoinFromArray(asMethods, "|"))
        End_Procedure

        /* WHAT COUNTS AS A USE: a method's name only as a message, so a call of the built-in function of the
           same name is none; a plain name as a whole word, and not a field's (a dot in front). */
        { Published = True }
        Procedure Shadow_AddsNothingUsed_NameUseOnLine
            Handle ho
            Boolean b
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get NameUseOnLine of ho "MOVE (POINTERTOSTRING(LPX)) TO S" "POINTERTOSTRING" True to b
            Send AssertFalse b
            Get NameUseOnLine of ho "GET POINTERTOSTRING OF HO TO S" "POINTERTOSTRING" True to b
            Send Assert b "Get X is a use of a method"
            Get NameUseOnLine of ho "MOVE (POINTERTOSTRING(SELF, X)) TO S" "POINTERTOSTRING" True to b
            Send Assert b "X(Self is a use of a method"
            Get NameUseOnLine of ho "SEND DELEGATE GET_POINTERTOSTRING" "POINTERTOSTRING" True to b
            Send Assert b "get_X is a use of a method"
            Get NameUseOnLine of ho "TPOINT PT" "TPOINT" False to b
            Send Assert b "a plain name as a whole word"
            Get NameUseOnLine of ho "TPOINTS PT" "TPOINT" False to b
            Send AssertFalse b
            Get NameUseOnLine of ho "MOVE CUSTOMER.TPOINT TO X" "TPOINT" False to b
            Send AssertFalse b
            Send Destroy of ho
        End_Procedure

        /* ON A REAL DISK. A scratch "install" ships Prnx.pkg, which Uses Helper.pkg (Struct tPOINT); the
           workspace's copy of Prnx.pkg differs: it declares tPOINT too (the shipped file has it through its
           Use - not an addition) and adds one method. Nothing uses the method: ticked. Another file sends it:
           not ticked. A copy with no declaration at all (a DFCreate_Menu menu) stays unticked; an identical
           row is not asked. */
        { Published = True }
        Procedure Shadow_AddsNothingUsed_OnDisk
            Handle ho
            String[] asLines asFiles
            tShadowCopy[] aRows aNone
            String sRoot sInstall sHome sCopy sMenu
            Integer iCount
            Boolean bOk
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_AddsNothing") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (sRoot + "\Pkg") to sInstall
            Move (sRoot + "\Ws") to sHome
            Move (rfDirectoryCreateEx(sInstall, False)) to bOk
            Move (rfDirectoryCreateEx((sHome + "\AppSrc"), False)) to bOk
            Send Assert bOk "the scratch folders could not be made"
            Move "Use Helper.pkg"               to asLines[0]
            Move "Class cPrnX is a cObject"     to asLines[1]
            Move "    Procedure Show"           to asLines[2]
            Move "    End_Procedure"            to asLines[3]
            Move "End_Class"                    to asLines[4]
            Move "DFCreate_Menu Shipped_Menu"   to asLines[5]
            Get rfWriteEncodedFileFromStringArray (&asLines) (sInstall + "\Prnx.pkg") C_NewLine False to bOk
            Move (ResizeArray(asLines, 0)) to asLines
            Move "Struct tPOINT"                to asLines[0]
            Move "End_Struct"                   to asLines[1]
            Get rfWriteEncodedFileFromStringArray (&asLines) (sInstall + "\Helper.pkg") C_NewLine False to bOk
            Move (ResizeArray(asLines, 0)) to asLines
            Move "Struct tPOINT"                to asLines[0]
            Move "End_Struct"                   to asLines[1]
            Move "Class cPrnX is a cObject"     to asLines[2]
            Move "    Procedure Show"           to asLines[3]
            Move "    End_Procedure"            to asLines[4]
            Move "    Procedure PageSetupDlg"   to asLines[5]
            Move "    End_Procedure"            to asLines[6]
            Move "End_Class"                    to asLines[7]
            Move (sHome + "\AppSrc\Prnx.pkg") to sCopy
            Get rfWriteEncodedFileFromStringArray (&asLines) sCopy C_NewLine False to bOk
            Move (ResizeArray(asLines, 0)) to asLines
            Move "DFCreate_Menu Other_Menu"     to asLines[0]
            Move (sHome + "\AppSrc\Menu.inc") to sMenu
            Get rfWriteEncodedFileFromStringArray (&asLines) sMenu C_NewLine False to bOk
            Move (ResizeArray(asLines, 0)) to asLines
            Move "Use Prnx.pkg"                 to asLines[0]
            Move "Send Show of oPrn  // Send PageSetupDlg of oPrn is only a comment" to asLines[1]
            Get rfWriteEncodedFileFromStringArray (&asLines) (sHome + "\AppSrc\Main.src") C_NewLine False to bOk
            Send Assert bOk "the scratch files could not be written"
            Move sCopy to asFiles[0]
            Move sMenu to asFiles[1]
            Move (sHome + "\AppSrc\Main.src") to asFiles[2]
            Move sCopy                          to aRows[0].sPath
            Move (sInstall + "\Prnx.pkg")      to aRows[0].sShipped
            Move sMenu                          to aRows[1].sPath
            Move (sInstall + "\Prnx.pkg")      to aRows[1].sShipped
            Move sCopy                          to aRows[2].sPath
            Move (sInstall + "\Prnx.pkg")      to aRows[2].sShipped
            Move True                           to aRows[2].bSame
            Get Create (RefClass(cShadowedPackageFiles)) to ho
            Get MarkCopiesThatAddNothingUsed of ho (&aRows) (&asFiles) sInstall to iCount
            Send AssertIAreEqual 1 iCount
            Send Assert (aRows[0].bAddsNothingUsed and aRows[0].bTicked) "the copy whose one addition nothing uses is ticked"
            Send AssertFalse aRows[1].bTicked
            Send AssertFalse aRows[2].bAddsNothingUsed
            // now another file sends the added method
            Move (ResizeArray(asLines, 0)) to asLines
            Move "Send PageSetupDlg of oPrn"    to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) (sHome + "\AppSrc\Other.pkg") C_NewLine False to bOk
            Move (sHome + "\AppSrc\Other.pkg") to asFiles[3]
            Move False to aRows[0].bTicked
            Move False to aRows[0].bAddsNothingUsed
            Get MarkCopiesThatAddNothingUsed of ho (&aRows) (&asFiles) sInstall to iCount
            Send Destroy of ho
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Send AssertIAreEqual 0 iCount
            Send AssertFalse aRows[0].bTicked
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

    End_Object
