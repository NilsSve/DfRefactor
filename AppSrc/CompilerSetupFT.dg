//****************************************************************************
// FT (FlexTron) copy of CompilerSetup.dg - dark-themed, fully web-hosted.
// The shared/native original (CompilerSetup.dg) stays clean for production; only the FT build Uses
// this copy (DFRefactorFT.src). Convention: FlexTron-only change = a new FT file.
//
// Changes vs CompilerSetup.dg:
//   - ALL controls are hosted web controls in ONE DATA-AWARE grid host, cFTDbGridHost (oCompilerSetupHost), on
//     8 px columns: the Compiler path + Build Options are cWebForms that stretch with the dialog, the four
//     actions (Select / Help / Save / Close) are cFTWebButtons right after the fields, and a cWebLabel carries
//     the note. A button's work runs in its OnButtonClick, after the web click has returned.
//   - The DD (oSysFile_DD) lives INSIDE the host and the two cWebForms are DD-bound
//     (Entry_Item SysFile.CompilerPath / CompilerOptions + Set Server to the DD). DataFlex's DEO coupling
//     then drives display + save automatically - so NO manual seed. (Far less code than the first attempt,
//     which hosted the fields NON-DD in a plain cLocalWebControlHost and hand-rolled the seed / WebGet-on-save
//     / DD-find - see git history; the data-aware host is the idiomatic DataFlex way for DD-backed data.)
//   - DoSave pushes the current field values into the DD and Send Request_Save's it - a TARGETED save at
//     the DD, NEVER a Broadcast Recursive (that faults err 98 GET_SERVERDEO on the web buttons).
//   - Help is a shell launch; Select pops the OS file dialog + applies the df-cli-vs-legacy
//     build-options auto-fill.
//****************************************************************************
Use Dfentry.pkg
Use Dfspnfrm.pkg
Use DfSpnent.pkg
Use cLinkLabel.pkg
Use cRegistry.pkg
Use RefactorConstants.h.pkg
Use cFTDbModalPanel.pkg
Use cRDCDbHeaderGroup.pkg
Use cRDCButtonDPI.pkg
Use cRDCCheckbox.pkg
Use cRDCComboForm.pkg
Use cRDCRegKeyForm.pkg
Use cRDCDbForm.pkg
Use cRefactorCheckbox.pkg
Use vWin32fh.pkg
Use FTAllWebControlClasses.pkg
Use cFTDbGridHost.pkg            // FT: the data-aware host on a grid of 8 px columns (RDCFlexTron)
Use cFTWebLabel.pkg

Use cSysFileDataDictionary.dd
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

/* +13 vertical units of AIR under the last row (Nils 2026-08-06), which is about one button
   row - the Save/Close pair sat hard against the bottom edge with nothing under it.

   Panel and host grow by the SAME 13 so their relationship is untouched: the host keeps its
   5-unit bottom margin and its anAll anchors, and the extra height lands inside the grid,
   which packs its rows top-down and leaves the remainder below the last one. piMinSize grows
   with them - otherwise the dialog could be dragged back down to a height where the air is the
   first thing lost, which is the opposite of the point.

   The buttons are the standard FT ones now (29 px, in 33 px rows), so if it reads as too tight or
   too airy, these are the three numbers: 95 / 84 / 92. */
Object oCompilerSetup_dg is a cFTDbModalPanel
    Set Size to 95 475
    Set Label to "Target DataFlex Version (Compiler Settings)"
    // The fixed columns - the labels, the suffix fields and the four buttons - need 512 px, about 342
    // units: narrower than that, the grid would cut Help and Close off.
    Set piMinSize to 92 364
    Set Location to 1 2
    Set Icon to "CompileProject.ico"

    Object oOpenDialog is a OpenDialog
        Set Dialog_Caption to "Select a DataFlex compiler"
        Set Filter_String to "Programs|*.exe|Any file|*.*" 
        Set Initial_Folder to "C:\Program Files"
    End_Object

    /* ONE DATA-AWARE GRID HOST (cFTDbGridHost) holds every control and OWNS the DD: oSysFile_DD is declared
       INSIDE it and the two cWebForms are DD-bound (Entry_Item + Set Server), so the framework displays and
       saves them through the DD.

       THE GRID, on 8 px columns (Nils 2026-09-30: the buttons should behave like the other buttons, and "the
       gap between the forms and the buttons is way too wide"). Every field row ends where the buttons begin:
       Compiler: and Build Options: stretch with the dialog, the two suffix fields share the extra width, and
       the buttons - 11 columns each - sit right after them.
           0..23   x86 suffix: its 128 px label and 64 px of field; column 24 takes half the extra width
           25..42  x64 suffix: an 80 px label and 64 px of field;   column 43 takes the other half
           0..43   Compiler: and Build Options:
           44..54  Select / Save             55..65  Help / Close
       In August each pair became one HTML bar, because separate framework buttons drifted apart in the
       proportional 12-column grid this host had then; on 8 px columns a button's span is its width, so they
       keep their place. */
    Object oCompilerSetupHost is a cFTDbGridHost
        Set Location to 6 8
        // 71 -> 84: the panel's +13 passed straight through, so the 5-unit bottom margin between
        // host and panel edge is unchanged and the new height becomes air under the last row.
        Set Size to 84 459
        // anAll: the host grows with the dialog, and its two stretch columns with it.
        Set peAnchors to anAll
        Set piColumnCount to 66
        Set psColumnWidths to "24/1fr 43/1fr"
        Set psRowHeights to "0/max-content"     // the note's row is as tall as the note; the others are FT rows

        Object oSysFile_DD is a cSysFileDataDictionary
        End_Object
    
        Set Main_DD to oSysFile_DD
        Set Server  to oSysFile_DD

        Object oNote_lbl is a cFTWebLabel
            Set piRowIndex to 0
            Set piColumnIndex to 0
            Set piColumnSpan  to 66
            Set psCaption to "Select Target DataFlex version by selecting a compiler for that version"
            // No psTextColor: it is an INLINE style on an inner element that no stylesheet can
            // override, so setting it locks this label out of the light theme even though the
            // value is a palette token. cFTWebLabel already sets psCSSClass "FtCompact", and
            // application.css colours it there. (cFTWebLabel.pkg says exactly this at its head.)
            Set psToolTip to ("The best way of knowing which refactoring functions are needed, when moving" + C_NewLine + ;
                               "to a new DataFlex version, is to test-compile with the new dataflex compiler." + C_NewLine + ;
                               "Here you select the target DataFlex version compiler")
        End_Object

        Object oCompiler_wf is a cFTWebForm
            Entry_Item SysFile.CompilerPath
            Set Server to oSysFile_DD
            Set piRowIndex to 1
            Set piColumnSpan  to 44
            Set psLabel to "Compiler:"
            Set psToolTip to ("The best way of knowing which refactoring functions are needed, when moving" + C_NewLine + ;
                               "to a new DataFlex version, is to test-compile with the new dataflex compiler." + C_NewLine + ;
                               "Here you select the target DataFlex version compiler")
        End_Object

        Object oSelectBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 44
            Set piColumnSpan to 11
            Set psCaption to "Select"
            Set psToolTip to "Select the target DataFlex version compiler - test-compiling with it is the best way to know which refactoring functions are needed."

            // After the web click: it pops the OS file dialog, which cannot open inside the click (4410).
            Procedure OnButtonClick
                Send SelectCompiler of (oCompilerSetup_dg(Self))
            End_Procedure
        End_Object

        Object oHelpBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 55
            Set piColumnSpan to 11
            Set psCaption to "Help"
            Set psCSSClass to "ftbtn ftg-help"
            Set psToolTip to "Help for compiler options"

            Procedure OnButtonClick
                Runprogram Shell Background "https://docs.dataaccess.com/dataflexhelp/mergedProjects/Tools/Compiler_Options.htm"
            End_Procedure
        End_Object

        // Row 2 - Build Options (EDITABLE), the same width as Compiler: above.
        Object oCompOptions_wf is a cFTWebForm
            Entry_Item SysFile.CompilerOptions 
            Set Server to oSysFile_DD
            Set piRowIndex to 2
            Set piColumnSpan  to 44
            Set psLabel to "Build Options:"
        End_Object

        // Row 3 - the 32/64-bit OUTPUT SUFFIXES to use when a program's .cfg has none (legacy pre-DF20
        // workspaces): temporarily injected into the .cfg for the compile + used as the compiled-file
        // resolvers' fallback (cRefactorApplication.InjectCfgSuffixes / cCompileMixin.DefaultSuffix).
        // NOT DD-bound - registry-persisted per user (Nils 2026-07-08). Seeded design-time from the app
        // props, which End_Construct_Object loaded from the registry long before this panel constructs.
        Object oSuffix32_wf is a cFTWebForm
            Set piRowIndex to 3
            Set piColumnSpan  to 25
            Set psLabel to "x86 suffix:"
            Set psValue to (psCompilerSuffix32(ghoApplication))
            Set psToolTip to ("Output-file suffix for 32-bit builds when the program's .cfg [Compiler] section" + C_NewLine + ;
                              "has no 32BitSuffix key (legacy pre-DF20 workspaces). The Studio suggestion is" + C_NewLine + ;
                              "blank - a 32-bit build keeps its historical name (Skinning.exe).")
        End_Object

        Object oSuffix64_wf is a cFTWebForm
            Set piRowIndex to 3
            Set piColumnIndex to 25
            Set piColumnSpan  to 19
            Set piLabelOffset to 80           // its label beside x86's field, not in Compiler:'s 128 px
            Set psLabel to "x64 suffix:"
            Set psValue to (psCompilerSuffix64(ghoApplication))
            Set psToolTip to ("Output-file suffix for 64-bit builds when the program's .cfg [Compiler] section" + C_NewLine + ;
                              "has no 64BitSuffix key (legacy pre-DF20 workspaces). The Studio suggestion is" + C_NewLine + ;
                              "x64 - a 64-bit build then writes Skinningx64.exe and no longer collides with" + C_NewLine + ;
                              "a 32-bit Skinning.exe. The key is injected only for the compile and removed after.")
        End_Object

        Object oSaveBtn is a cFTWebButton
            Set piRowIndex to 3
            Set piColumnIndex to 44
            Set piColumnSpan to 11
            Set psCaption to "Save"
            Set psCSSClass to "ftbtn ftg-check"
            Set psToolTip to "(Alt+O / Ctrl+S) Save the compiler path and build options."

            Procedure OnButtonClick
                Send DoSave of (oCompilerSetup_dg(Self))
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piRowIndex to 3
            Set piColumnIndex to 55
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "(Alt+C / Esc) Close this dialog."

            Procedure OnButtonClick
                Send Close_Panel of (oCompilerSetup_dg(Self))
            End_Procedure
        End_Object
    End_Object

    // Lives on the panel beside DoSave and reaches the web forms by bare name, exactly as DoSave does.
    // Run from the Select button's OnButtonClick, after the web click: it pops an OS file dialog and can
    // raise FTInfoBox, and a modal opened inside the WebView2 pump faults err 4410.
    Procedure SelectCompiler
        Integer bOpen
        String sFileName sCurrentComOptions sComOptions
        Boolean bSwapped bNoConsole

        Get Show_Dialog of oOpenDialog to bOpen
        If (bOpen) Begin
            Move "" to sComOptions
            Get File_Name of oOpenDialog to sFileName
            // Normalize the WINDOWED compiler to its console sibling AT SELECTION - DFComp.exe
            // detaches, so every downstream read sees a half-written build. ONE canonical check:
            // cCompileMixin.NormalizeCompilerPath (DoSave guards a hand-TYPED path the same way).
            Get NormalizeCompilerPath of ghoApplication sFileName (&bSwapped) (&bNoConsole) to sFileName
            If (bSwapped = True) Begin
                Send FTInfoBox ("DFComp.exe starts the compile in its own window and returns immediately, so DFRefactor cannot track the compile - the result, live error output and warnings would read a half-written build.\n\nUsing the console compiler beside it instead:\n" + sFileName) "Compiler adjusted"
            End
            Else If (bNoConsole = True) Begin
                Send FTInfoBox "DFComp.exe starts the compile in its own window and returns immediately, so the compile result, live error output and the warnings display will be unreliable.\n\nNo DfCompConsole.exe was found in the same folder; keeping your selection." "Compiler warning"
            End
            If (Lowercase(sFileName) contains "df-cli") Begin
                WebGet psValue of oCompOptions_wf to sCurrentComOptions
                If (sCurrentComOptions = "" or sCurrentComOptions contains "-x") ;
                    Move CS_CompOptionsDfCli to sComOptions
            End
            Else Begin
                WebGet psValue of oCompOptions_wf to sCurrentComOptions
                /* The CONSOLE family's flags - not CS_CompOptions, which is keyed on the DataFlex
                   that built DFRefactor and now yields the df-cli string, so selecting a DF25
                   DfCompConsole filled the field with flags it cannot read (Nils 2026-08-20). */
                If (sCurrentComOptions = "" or sCurrentComOptions contains "--rebuild") ;
                    Move CS_CompOptionsConsole to sComOptions
            End
            WebSet psValue of oCompiler_wf to sFileName
            If (sComOptions <> "") Begin
                WebSet psValue of oCompOptions_wf to sComOptions
            End    
        End
    End_Procedure

    // FT: save the two DD-bound fields. With the cWebForms bound (Entry_Item) the DD stays positioned on
    // the SysFile record, so this pushes the current values into the DD and Send Request_Save's it - a
    // TARGETED save at the DD (NEVER a Broadcast Recursive, which faults err 98 GET_SERVERDEO on the
    // cWebButtonFTs). sPath/sOpts also feed the ghoApplication compiler props + the status line.
    Procedure DoSave
        String sPath sOpts s32 s64
        Boolean bSwapped bNoConsole

        WebGet psValue of oCompiler_wf    to sPath
        WebGet psValue of oCompOptions_wf to sOpts
        // The output-suffix pair is registry-persisted (the setters write the registry), not DD-saved.
        WebGet psValue of oSuffix32_wf to s32
        WebGet psValue of oSuffix64_wf to s64
        Set psCompilerSuffix32 of ghoApplication to s32
        Set psCompilerSuffix64 of ghoApplication to s64
        // A hand-TYPED DFComp.exe path bypasses the Select button's guard - normalize here too
        // (cCompileMixin.NormalizeCompilerPath; Nils 2026-07-04). On a swap the field is updated
        // so what the user SEES is what gets saved.
        Get NormalizeCompilerPath of ghoApplication sPath (&bSwapped) (&bNoConsole) to sPath
        If (bSwapped = True) Begin
            WebSet psValue of oCompiler_wf to sPath
            Send FTInfoBox ("DFComp.exe starts the compile in its own window and returns immediately, so DFRefactor cannot track the compile - the result, live error output and warnings would read a half-written build.\n\nSaving the console compiler beside it instead:\n" + sPath) "Compiler adjusted"
        End
        Else If (bNoConsole = True) Begin
            Send FTInfoBox "DFComp.exe starts the compile in its own window and returns immediately, so the compile result, live error output and the warnings display will be unreliable.\n\nNo DfCompConsole.exe was found in the same folder; saving your selection as-is." "Compiler warning"
        End
        Set Field_Changed_Value of oSysFile_DD Field SysFile.CompilerPath    to sPath
        Set Field_Changed_Value of oSysFile_DD Field SysFile.CompilerOptions to sOpts
        Send Request_Save of oSysFile_DD
        Set psCompiler of ghoApplication to sPath
        Set psCompOpt  of ghoApplication to sOpts
        Set StatusText of (Statusbar_Id(Self)) to "Changes saved."
    End_Procedure

    // FT: make sure a SysFile config record exists for the DD-bound forms to show/edit (the data-aware host
    // finds + displays it automatically; this just seeds the first record if the file is empty).
    Procedure Activating
        If (SysFile.Recnum = 0) ;
            Find ge SysFile by Recnum
    End_Procedure

    Procedure Request_Clear
    End_Procedure

    On_Key Key_Alt+Key_O  Send DoSave
    On_Key Key_Ctrl+Key_S Send DoSave
    On_Key Key_Alt+Key_C  Send Close_Panel
    On_Key kCancel        Send Close_Panel
End_Object
