// ScintillaGotoFT.dg
//
// The FlexTron twin of ScintillaGoto.dg, the editor's Go To Line dialog: the same line field and the
// same RequestDetails, on an FT panel, with OK and Cancel as framework buttons (cFTWebButton,
// RDCFlexTron) on a grid host of 8 px columns.
//
// HOW DFRefactorFT GETS THIS ONE, as DropSelfConfirmFT.dg: cRefactorEditorCommands.pkg Uses the
// dialog itself, and every program that edits code gets it through that package. DFRefactorFT.src
// Uses this file BEFORE it, this file defines C_OwnGotoDialog, and the package then leaves
// ScintillaGoto.dg out. Both files define oGotoDialog - the package reaches the dialog by that name -
// so the two must never both be in: used after the package, this file stops the build (below).
//
// LAID OUT as Windows' own Go To Line: the field across the top, OK and Cancel at the bottom right
// (the original stacked them beside the field). A fixed size: the original could only be made wider,
// which only stretched the field, and a resizable FT panel gets a status bar under it.
Use Windows.pkg
Use RefactorMessageQueue.pkg
Use ScintillaFindControls.pkg
Use cFTModalPanel.pkg
Use cFTGridHost.pkg             // OK and Cancel's host - a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg  // cFTWebButton - OK and Cancel

// cRefactorEditorCommands.pkg declares tDropSelfResponse. If it exists already, the package is in the
// program and has brought ScintillaGoto.dg with it - there would be two oGotoDialog.
#IFDEF _STRUCT_tDropSelfResponse
#ERROR DFERR_PROGRAM "Use ScintillaGotoFT.dg before the editor packages - ScintillaGoto.dg is in the program already."
#ENDIF

// Tells cRefactorEditorCommands.pkg to leave ScintillaGoto.dg out.
Define C_OwnGotoDialog for 1

Object oGotoDialog is a cFTModalPanel
    Set Size to 56 138
    Set Label to "Go To Line"
    Set Location to 44 47
    //Set Locate_Mode to POPUP_LOCATE -- locate mode isn't smart enough
    Set Border_Style to Border_Dialog
    Property Boolean pbCancel

    Object oLineFm is a cFindForm
        Set Size to 13 88
        Set Location to 10 43
        Set Label to "&Line:"
        Set Label_Col_Offset to 2
        Set Label_Justification_Mode to JMode_Right
        Set Form_DataType To Mask_Numeric_Window
        Set Form_Mask To "Z*"
        On_Key kEnter Send GotoOK       // Enter goes to the line - see the buttons below
    End_Object

    /* OK / CANCEL at the bottom right - framework buttons on a grid host of 8 px columns, right-aligned
       with the field. OK keeps the default it had: Enter in the field goes to the line (bound on the
       field, not the panel - a web button that has the focus takes its own Enter), and OK wears the main
       action's amber. Each runs in OnButtonClick, after the web click has returned (the library's click
       relay) - closing the panel cannot happen inside the click. The spans fit the captions: OK at the
       78 px minimum, Cancel ~78 px with its glyph. */
    Object oGotoButtons is a cFTGridHost
        Set Location to 28 8
        Set Size to 20 128
        Set piColumnCount to 24         // column 0, then OK's 11 and Cancel's 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oOKBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "OK"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-check"
            Set psToolTip to "Go to the line. Enter in the field does the same."

            Procedure OnButtonClick
                Send GotoOK of oGotoDialog
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close without moving."

            Procedure OnButtonClick
                Send GotoCancel of oGotoDialog
            End_Procedure
        End_Object
    End_Object

    // OK: close, and RequestDetails reads the field.
    Procedure GotoOK
        Set pbCancel to False
        Send Close_Panel
    End_Procedure

    // Cancel - the button, Esc or the window's X: close, and RequestDetails answers -1.
    Procedure GotoCancel
        Set pbCancel to True
        Send Close_Panel
    End_Procedure

    On_Key Key_Alt+Key_L Send Activate of oLineFm
    On_Key Key_Alt+Key_O Send GotoOK
    On_Key kCancel       Send GotoCancel

    /* THE FIELD'S LABEL takes its colour from its parent - this panel (Label_TextColor clNone) - and the
       panel's FTColorChildren gives the FT ink to the children, not to the panel itself: on the dark
       ground the label would stay dark. So it gets the ink here, each time the children get theirs. */
    Procedure FTColorChildren
        Forward Send FTColorChildren
        Set Label_TextColor of oLineFm to (FTThemeInk())
    End_Procedure

    Procedure RequestDetails Integer ByRef iLine
        Boolean bCancel

        Set pbCancel    to True     // closed with the window's X = Cancel; GotoOK clears it
        Set Value       of oLineFm  to ""
        Send Popup
        Get pbCancel to bCancel
        If (not(bCancel)) Begin
            Get Value   of oLineFm  to iLine
            Decrement iLine
            If (iLine<0) Begin
                Move 0 to iLine
            End
        End
        Else Begin
            Move -1 to iLine
        End
    End_Procedure

End_Object
