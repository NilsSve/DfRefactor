    Object oConvertWinAPIDeclarationTypes is a cTestFixture
        Set psFunctionName to "ConvertWinAPIDeclarationTypes"

        /* The bug the compiler cannot see: Integer where the API takes a pointer. On x64 that
           compiles clean and truncates the address at run time. SHBrowseForFolderW is catalogued,
           and its SDK prototype takes an LPBROWSEINFOW - a pointer. */
        {Published = True}
        Procedure ApiTypes_CorrectsAnX86TypedPointer
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            /* THE GUARDED PAIR (Nils, 2026-08-28): corrected declaration under IS$WIN64, the
               ORIGINAL kept verbatim in the #ELSE arm so an x86 build compiles byte-identical
               source. And the LOCAL parameter name survives the retype: "Pointer pv", never the
               SDK's spelling replacing the user's. */
            Send Assert (Pos((Character(35) + "IFDEF IS$WIN64"), sAll) > 0)
            Send Assert (Pos((Character(35) + "ELSE"), sAll) > 0)
            Send Assert (Pos((Character(35) + "ENDIF"), sAll) > 0)
            Send Assert (Pos("Pointer pv", sAll) > 0)
            Send Assert (Pos('External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer', sAll) > 0)
        End_Procedure

        // The local NAME, ENTRY POINT and DLL all survive - call sites use the name, an ...A
        // wrapper must stay ...A, and the same entry point in another library is another function.
        {Published = True}
        Procedure ApiTypes_KeepsNameEntryAndDll
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            // The x64 arm keeps the local alias, entry point and dll - the corrected head appears
            // TWICE in the pair (once per arm), both times spelled the user's way.
            Send Assert (Pos('External_Function GetObject "GetObjectA" gdi32.dll ;', sAll) > 0)
            // ...and the corrected arm is multi-line Pkg style, one parameter per continuation.
            Send Assert (Pos((" ;" + (Character(10)) + "    Handle h ;"), sAll) > 0)
        End_Procedure

        // IDEMPOTENT: the corrected declaration is left alone on a second pass, so re-running over
        // a converted workspace changes nothing rather than churning it.
        {Published = True}
        Procedure ApiTypes_SecondPassChangesNothing
            String[] asCode asNotes
            Integer iCount
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        /* THE REGRESSION THIS FIXTURE EXISTS FOR. A ";"-continued declaration that is NOT
           converted must come back with every line intact. The first draft of the walker kept only
           the first line of a block it declined, which silently deleted the parameters of every
           declaration it left alone - the worst possible outcome for a refusal. */
        {Published = True}
        Procedure ApiTypes_DeclinedContinuationBlockSurvivesWhole
            String[] asCode asNotes
            Integer iCount
            Move 'External_Function NoSuchApiAnywhere "NoSuchEntryPoint" nosuch.dll ;' to asCode[0]
            Move '    Integer hWnd Integer lpBuffer ;'                                 to asCode[1]
            Move '    Returns Integer'                                                 to asCode[2]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Send AssertSAreEqual 'External_Function NoSuchApiAnywhere "NoSuchEntryPoint" nosuch.dll ;' asCode[0]
            Send AssertSAreEqual '    Integer hWnd Integer lpBuffer ;' asCode[1]
            Send AssertSAreEqual '    Returns Integer' asCode[2]
        End_Procedure

        // Ordinary code around a declaration is passed through untouched, in order.
        {Published = True}
        Procedure ApiTypes_SurroundingLinesUntouched
            String[] asCode asNotes
            Integer iCount
            Move '// a comment'                                                     to asCode[0]
            Move 'External_Function NoSuchApiAnywhere "NoSuchEntryPoint" nosuch.dll Integer x Returns Integer' to asCode[1]
            Move 'Procedure Foo'                                                    to asCode[2]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Send AssertSAreEqual '// a comment' asCode[0]
            Send AssertSAreEqual 'Procedure Foo' asCode[2]
        End_Procedure

        /* The four whose exported entry point changes with the bitness are REFUSED, not retyped -
           they need both arms guarded, which is a different rewrite. And the refusal is noted:
           a silent skip here would read as "nothing was wrong with it". */
        {Published = True}
        Procedure ApiTypes_BitnessFamilyIsRefusedAndNoted
            String[] asCode asNotes
            Integer iCount
            Move 'External_Function GetWindowLongPtr "GetWindowLongW" User32.dll Handle hWnd Integer offset Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (SizeOfArray(asNotes) > 0)
            Send Assert (Pos("GetWindowLongPtr", asNotes[0]) > 0)
            Send Assert (Pos("both", Lowercase(asNotes[0])) > 0)
        End_Procedure

        /* AN EMPTY CATALOGUE MUST ANNOUNCE ITSELF. With the JSON gone or unreadable every lookup
           refuses, the run reports "corrected 0", and that is indistinguishable from a workspace
           with nothing to correct. Here the catalogue is emptied by hand and the converter is
           expected to leave the line alone AND to have a reason recorded - the reason being the
           whole point, since the silence is what misleads. */
        {Published = True}
        Procedure ApiTypes_EmptyCatalogueIsAnnouncedNotSilent
            String[] asCode asNotes asSaved asNone asProblems
            Integer iCount
            // Empty the catalogue, and mark it loaded so the lazy refresh does not refill it.
            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Set pasWinAPICatalog of ghoFuncLib to asNone
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Move "A missing catalogue reads as nothing to do" to asProblems[0]
            Set pasWinAPILoadProblems of ghoFuncLib to asProblems

            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount

            // Put the catalogue back before asserting, so a failure here cannot poison the rest.
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' asCode[0]
            // And the reason is available to report - this is what stops the silence.
            Get pasWinAPILoadProblems of ghoFuncLib to asProblems
            Send Assert (SizeOfArray(asProblems) > 0)
        End_Procedure

        // THE LOCAL TYPE SPELLING SURVIVES WHERE THE CLASSES AGREE: "DWord c" stays DWord beside
        // the SDK's "Integer c" (same four bytes), while "Integer pv" still becomes Pointer -
        // the corrected arm differs from the user's code only where pointer width demands it.
        {Published = True}
        Procedure ApiTypes_ClassAgreeingLocalTypeSurvives
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h DWord c Integer pv Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("DWord c", sAll) > 0)
            Send Assert (Pos("Pointer pv", sAll) > 0)
        End_Procedure

        /* THE VOID RETURN NEVER FORCES A RECEIVER CHANGE (alpha era, Nils 2026-08-28).
           keybd_event returns void, and "Move (KeyboardEvent(...)) to iVoid" must keep compiling
           while dwExtraInfo still gets its genuine ULONG_PTR correction. No note either: nothing
           about the return changed.

           THE NEGATIVE ASSERTION BELOW IS THE POINT, and it is here because its absence let a
           real regression through (2026-08-30). This test used to check only that "Returns
           Pointer" was absent - which stayed true when upstream cec3389 respelled the catalogue's
           void return from "Integer" to "Void_Type" and the emitter duly began writing "Returns
           Void_Type" over the user's "Returns Integer". 2273 tests passed while 1384 APIs had
           started breaking their receivers. Assert what must be THERE and what must NOT, never
           just the one wrong spelling you happen to have in mind. */
        {Published = True}
        Procedure ApiTypes_VoidReturnKeepsTheLocalReturn
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Move 'External_Function KeyboardEvent "keybd_event" USER32.DLL ;' to asCode[0]
            Move 'Integer bVk ;'        to asCode[1]
            Move 'Integer bScan ;'      to asCode[2]
            Move 'Integer dwFlags ;'    to asCode[3]
            Move 'Integer dwExtraInfo ;' to asCode[4]
            Move 'Returns Integer'      to asCode[5]
            Move 'Move (KeyboardEvent(iKey,0,0,0)) to iVoid' to asCode[6]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("ULongPtr dwExtraInfo", sAll) > 0)
            Send Assert (Pos("Returns Pointer", sAll) = 0)
            // The user's own return, still there - and no spelling of the SDK's void anywhere in
            // either arm. Lowercased so a casing change upstream cannot slip past the guard.
            Send Assert (Pos("Returns Integer", sAll) > 0)
            Send Assert (Pos("void_type", (Lowercase(sAll))) = 0)
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
        End_Procedure

        /* ...AND WHEN THE REST ALREADY AGREES, THE VOID RETURN LEAVES IT A NO-OP. The companion
           to the test above, on the OTHER decision the rule touches: _ApiDeclTypesAgree. Here the
           parameters are already exactly what the catalogue says, so the only thing that could
           still call this declaration "wrong" is the return - and a void return must not. Without
           the rule stated there too, every one of the 1384 void APIs would be rewritten on every
           run, and a second run over a converted workspace would churn instead of settling. */
        {Published = True}
        Procedure ApiTypes_VoidReturnAgreesSoNothingChanges
            String[] asCode asNotes
            String sDecl
            Integer iCount
            Move ("External_Function KeyboardEvent " + (Character(34)) + "keybd_event" + (Character(34)) ;
                + " USER32.DLL UChar bVk UChar bScan UInteger dwFlags ULongPtr dwExtraInfo Returns Integer") to sDecl
            Send ClearFuncLibProperties of ghoFuncLib
            Move sDecl to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asCode))
            Send AssertSAreEqual sDecl asCode[0]
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
        End_Procedure

        /* WHEN THE RETURN GENUINELY WIDENS, THE CALL SITES ARE NAMED. ShellExecute returns an
           HINSTANCE; a local "Returns Integer" was truncating it on x64, the corrected arm says
           Handle, and the receiver that stops compiling is the surfaced bug - the note says
           WHERE first, before the compile does. */
        {Published = True}
        Procedure ApiTypes_ReturnWideningNamesTheCallSites
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Boolean bFound
            Move 'External_Function efShell "ShellExecuteA" shell32.dll Handle hw String a String b String c String d Integer n Returns Integer' to asCode[0]
            Move 'Move (efShell(hw,"open",sFile,"","",1)) to iRet' to asCode[1]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move False to bFound
            For i from 0 to (SizeOfArray(asNotes) - 1)
                If ((asNotes[i] contains "efShell") and (asNotes[i] contains "pointer-sized")) Begin
                    Move True to bFound
                    // the call line, by its ORIGINAL number - line 2 of the fixture.
                    Send Assert (asNotes[i] contains "line 2")
                End
            Loop
            Send Assert bFound
        End_Procedure

        /* POINTER-VS-MARSHAL IS A CALLING CONVENTION, NOT A TYPING BUG (Nils 2026-08-28, the
           vWin32fhA.h aha moment). A binding that declares Pointer where the SDK marshals text
           does its own conversion, and its call sites pass AddressOf'd buffers - "correcting"
           it to String would re-marshal an address. Both are pointer-sized: there is no x64
           defect to fix. Refused whole, with the reason on record. */
        {Published = True}
        Procedure ApiTypes_PointerVsMarshalIsRefusedNotRetyped
            String[] asCode asNotes
            Boolean bFound
            Integer iCount i
            Move 'External_Function vWin32_ShellExecute "ShellExecuteA" shell32.dll Handle hWnd Pointer lpOperation Pointer lpFile Pointer lpParameters Pointer lpDirectory DWord iShowCmd Returns Handle' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asCode))
            Send AssertSAreEqual 'External_Function vWin32_ShellExecute "ShellExecuteA" shell32.dll Handle hWnd Pointer lpOperation Pointer lpFile Pointer lpParameters Pointer lpDirectory DWord iShowCmd Returns Handle' asCode[0]
            Move False to bFound
            For i from 0 to (SizeOfArray(asNotes) - 1)
                If (asNotes[i] contains "manual-conversion") ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        /* THE WIPE MUST DISARM THE LOAD LATCH. _AddAllKeyWords re-runs the (now empty) catalogue
           seeds on every compiler/target switch; until 2026-08-28 that wiped the loaded rows while
           pbWinAPICatalogsLoaded stayed True, so the rest of the session ran on an empty catalogue
           with a CLEAN load record - a whole WinServ plan run answered "0 lines" with no note,
           while the converters proved sound headlessly. The wipe now drops the latch, and the
           positive control is the point: after the wipe, a real lookup lazily reloads the JSON
           and answers again. */
        {Published = True}
        Procedure ApiTypes_SeedWipeDisarmsTheLoadLatch
            String[] asFake asCat
            Boolean bLoaded
            String sProto

            // Simulate the loaded state the keyword re-seed used to destroy.
            Move "fake.dll|fakeentry|DF|External_Function Fake ..." to asFake[0]
            Set pasWinAPICatalog of ghoFuncLib to asFake
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True

            Send _CreateWinAPICatalogArray of ghoFuncLib   // the _AddAllKeyWords re-seed path

            Get pbWinAPICatalogsLoaded of ghoFuncLib to bLoaded
            Send Assert (bLoaded = False)
            Get pasWinAPICatalog of ghoFuncLib to asCat
            Send AssertIAreEqual 0 (SizeOfArray(asCat))
            // Positive control: the next lookup reloads the real Data\WinAPICatalog.json.
            Get WinAPIPrototype of ghoFuncLib "shell32.dll" "shellexecutew" to sProto
            Send Assert (sProto <> "")
        End_Procedure


        /* A BARE ENTRY POINT IS ANSWERED BY A ROW, NEVER BY A SPELLING RULE (2026-09-12). The
           lookup used to append "a", then "w", until something matched, which put a wide-bound
           export (kernel32's bare ReplaceFile) and a name no dll exports (GetPrivateProfileString)
           against an ANSI prototype. Both halves are asserted from one fake catalogue: the A and W
           rows alone do not answer for the bare name, and the measured alias row does.

           The array is sorted the way the load point sorts it - the binary search's whole pact is
           that sortedness, and a hand-built fake bypasses the one place that establishes it. */
        {Published = True}
        Procedure ApiTypes_BareEntryPointNeedsAMeasuredRow
            String[] asFake asSaved
            String sWithoutRow sWithRow

            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Move 'zz.dll|fooa|DF|External_Function FooA "FooA" ZZ.dll String p Returns Integer'  to asFake[0]
            Move 'zz.dll|foow|DF|External_Function FooW "FooW" ZZ.dll WString p Returns Integer' to asFake[1]
            Move (SortArray(asFake, Desktop, RefFunc(DFSTRICMP))) to asFake
            Set pasWinAPICatalog of ghoFuncLib to asFake
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIPrototype of ghoFuncLib "zz.dll" "foo" to sWithoutRow

            Move 'zz.dll|foo|DF|External_Function FooA "FooA" ZZ.dll String p Returns Integer' to asFake[2]
            Move (SortArray(asFake, Desktop, RefFunc(DFSTRICMP))) to asFake
            Set pasWinAPICatalog of ghoFuncLib to asFake
            Get WinAPIPrototype of ghoFuncLib "zz.dll" "foo" to sWithRow

            // Put the catalogue back BEFORE asserting, so a failure here cannot poison what follows.
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sWithoutRow
            Send Assert (Pos("FooA", sWithRow) > 0)
        End_Procedure

        /* Conditional VARIANT arms are hands-off (2026-08-29): cFilesystem's batch gates. The
           converter used to read parameter lists ACROSS the arms and refuse with nonsense
           counts; now it counts the skip and says so in one note, and the source is untouched. */
        { Published = True }
        Procedure ApiTypes_HandsOffInsideVariantArms
            String[] asCode asNotes
            String sAll
            Integer iCount i

            Move (Character(35) + 'IF (' + Character(33) + '@ < 200)') to asCode[0]
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[1]
            Move (Character(35) + 'ELSE') to asCode[2]
            Move 'External_Function GetObject "GetObjectW" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[3]
            Move (Character(35) + 'ENDIF') to asCode[4]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sAll + asNotes[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("author-managed", sAll) > 0) "the skip must be said, not silent"
            Send Assert (Pos("refused", sAll) = 0) "no nonsense cross-arm refusals"
        End_Procedure

        // The #IFNDEF declare-once guard is a wrapper, not a variant: still converted.
        { Published = True }
        Procedure ApiTypes_IfndefGuardStaysConvertible
            String[] asCode asNotes
            Integer iCount

            Move (Character(35) + 'IFNDEF get_GetObject') to asCode[0]
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[1]
            Move (Character(35) + 'ENDIF') to asCode[2]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
        End_Procedure

        /* The comment-carrying continuation style (cFilesystem, 2026-08-29): a mid-declaration
           line ends with its COMMENT, not with ";" - the joiner used to stop there and count the
           absorbed prose as parameters ("fsDeleteFile declares 8 parameter(s)"). Joined
           comment-stripped, the declaration parses and converts exactly like its one-line twin. */
        { Published = True }
        Procedure ApiTypes_CommentCarryingContinuationsJoinClean
            String[] asCode asNotes
            String sAll
            Integer iCount i

            Move 'External_Function GetObject "GetObjectA" gdi32.dll ;' to asCode[0]
            Move 'Handle h ;      // object handle' to asCode[1]
            Move 'Integer c ;     // byte count' to asCode[2]
            Move 'Integer pv ;    // buffer for the object data' to asCode[3]
            Move 'Returns Integer // bytes written' to asCode[4]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sAll + asNotes[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("declares", sAll) = 0) "prose words must never be counted as parameters"
        End_Procedure

    End_Object

