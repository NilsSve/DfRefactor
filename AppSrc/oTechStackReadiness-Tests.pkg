//****************************************************************************
// $Module type: Test fixture
// $Module name: oTechStackReadiness-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-11-20
//
// Description : Unit tests for TechStackReadinessReport's scan core (_TechStackScanFile) and its
//               summary (_TechStackReportLines) - what a workspace uses that DataFlex's TechStack
//               changes or does not run yet.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oTechStackReadiness_Tests is a cTestFixture
        Set psFunctionName to "TechStackReadiness"

        // Helper: one zero per topic.
        Function NoSites Returns Integer[]
            Integer[] ai
            Integer i
            For i from 0 to (CI_TSTopicCount - 1)
                Move 0 to ai[i]
            Loop
            Function_Return ai
        End_Function

        /* THE DATA LAYER: each topic on its own line, at command position or anywhere on the code; a comment, a
           string and an Entry_Item of an expression do not count. The table commands are counted and not listed. */
        { Published = True }
        Procedure TechStack_DataLayer
            String[] asCode asReport
            Integer[] aiSites
            Integer iN
            Move "Open Customer"                                          to asCode[0]
            Move "Relate Customer"                                        to asCode[1]
            Move "Set Main_File to Customer.File_Number"                  to asCode[2]
            Move "Send Add_Server_File Vendor.File_Number"                to asCode[3]
            Move "Make_File Customer"                                     to asCode[4]
            Move "Procedure Validate_Save"                                to asCode[5]
            Move "End_Procedure"                                          to asCode[6]
            Move "Set Field_Validate_msg Field Customer.Name to (RefProc(Check))" to asCode[7]
            Move "Entry_Item Customer.Name"                               to asCode[8]
            Move "Entry_Item (Trim(sName))"                               to asCode[9]
            Move "Find gt Customer by Index.1"                            to asCode[10]
            Move "Clear Customer"                                         to asCode[11]
            Move "SaveRecord Customer"                                    to asCode[12]
            Move "// Open Customer and Relate it"                         to asCode[13]
            Move 'Move "Open Customer" to sText'                          to asCode[14]
            Get NoSites to aiSites
            Get _TechStackScanFile of ghoFuncLib (&asCode) False (&aiSites) (&asReport) to iN
            Send AssertIAreEqual 1 aiSites[CI_TSOpen]
            Send AssertIAreEqual 1 aiSites[CI_TSRelate]
            Send AssertIAreEqual 2 aiSites[CI_TSFileNumber]
            Send AssertIAreEqual 1 aiSites[CI_TSMainFile]
            Send AssertIAreEqual 1 aiSites[CI_TSServerFile]
            Send AssertIAreEqual 1 aiSites[CI_TSMakeFile]
            Send AssertIAreEqual 1 aiSites[CI_TSValidate]
            Send AssertIAreEqual 1 aiSites[CI_TSFieldValidate]
            Send AssertIAreEqual 1 aiSites[CI_TSEntryItem]
            Send AssertIAreEqual 3 aiSites[CI_TSTableCommand]
            Send AssertIAreEqual 13 iN
            // Lines 1-6, 8 and 9 are listed - 8 lines - and the three table commands as one count line.
            Send AssertIAreEqual 9 (SizeOfArray(asReport))
            Send AssertSAreEqual "  Line 3 [File_Number, Main_File]:  Set Main_File to Customer.File_Number" asReport[2]
            Send Assert (Pos("3 table command(s)", asReport[8]) > 0) asReport[8]
        End_Procedure

        // A #COMMAND body defines a command; what it says is no use of the data layer.
        { Published = True }
        Procedure TechStack_MacroBodyIsSkipped
            String[] asCode asReport
            Integer[] aiSites
            Integer iN
            Move ((Character(35)) + "COMMAND MyOpen R")   to asCode[0]
            Move "    Open MyTable"                      to asCode[1]
            Move ((Character(35)) + "ENDCOMMAND")        to asCode[2]
            Move "Open Customer"                         to asCode[3]
            Get NoSites to aiSites
            Get _TechStackScanFile of ghoFuncLib (&asCode) False (&aiSites) (&asReport) to iN
            Send AssertIAreEqual 1 aiSites[CI_TSOpen]
            Send AssertIAreEqual 1 iN
        End_Procedure

        // cHttpTransfer and its kin, COM/ActiveX, SOAP and External_Function - and a whole Windows UI file once.
        { Published = True }
        Procedure TechStack_NotYetAndHttp
            String[] asCode asReport
            Integer[] aiSites
            Integer iN
            Move "Object oHttp is a cJsonHttpTransfer"                                 to asCode[0]
            Move "Class cMyGrid is a cComActiveXControl"                               to asCode[1]
            Move "Object oWS is a cClientWebService"                                   to asCode[2]
            Move 'External_Function GetTickCountEx "GetTickCount" kernel32.dll Returns DWord' to asCode[3]
            Move "Object oNotHttp is a cHttpTransferHelper"                            to asCode[4]
            Get NoSites to aiSites
            Get _TechStackScanFile of ghoFuncLib (&asCode) True (&aiSites) (&asReport) to iN
            Send AssertIAreEqual 1 aiSites[CI_TSHttpTransfer]
            Send AssertIAreEqual 1 aiSites[CI_TSComActiveX]
            Send AssertIAreEqual 1 aiSites[CI_TSSoap]
            Send AssertIAreEqual 1 aiSites[CI_TSExternalFunction]
            Send AssertIAreEqual 1 aiSites[CI_TSWindowsUI]
            Send AssertIAreEqual 5 iN
            Send Assert (Pos("Windows UI file", asReport[0]) > 0) asReport[0]
        End_Procedure

        /* A STRING MOVED INTO A BOOLEAN, by the types the method declares - its parameters among them. An empty
           literal, a number and a String target do not count, and a name declared in another method is not seen. */
        { Published = True }
        Procedure TechStack_StringToBoolean
            String[] asCode asReport
            Integer[] aiSites
            Integer iN
            Move "Procedure Go Boolean bParam"   to asCode[0]
            Move "    Boolean bOK"               to asCode[1]
            Move "    String sAnswer"            to asCode[2]
            Move '    Move "Yes" to bOK'         to asCode[3]
            Move "    Move sAnswer to bOK"       to asCode[4]
            Move '    Move "" to bOK'            to asCode[5]
            Move "    Move 1 to bOK"             to asCode[6]
            Move '    Move "Yes" to sAnswer'     to asCode[7]
            Move "    Move 'x' to bParam"        to asCode[8]
            Move "End_Procedure"                 to asCode[9]
            Move "Procedure Other"               to asCode[10]
            Move '    Move "Yes" to bOK'         to asCode[11]
            Move "End_Procedure"                 to asCode[12]
            Get NoSites to aiSites
            Get _TechStackScanFile of ghoFuncLib (&asCode) False (&aiSites) (&asReport) to iN
            Send AssertIAreEqual 3 aiSites[CI_TSStringToBoolean]
            Send AssertIAreEqual 3 iN
            Send Assert (Pos("Line 4 [String->Boolean]", asReport[0]) > 0) asReport[0]
            Send Assert (Pos("Line 9 [String->Boolean]", asReport[2]) > 0) asReport[2]
        End_Procedure

        // The summary: the four groups with their DAW pages, and per topic its sites and files.
        { Published = True }
        Procedure TechStack_ReportLines
            String[] asOut
            String sAll
            Integer[] aiSites aiFiles
            Get NoSites to aiSites
            Get NoSites to aiFiles
            Move 3 to aiSites[CI_TSOpen]
            Move 2 to aiFiles[CI_TSOpen]
            Get _TechStackReportLines of ghoFuncLib (&aiSites) (&aiFiles) 40 to asOut
            Move (StrJoinFromArray(asOut, "|")) to sAll
            Send Assert (Pos("Files read: 40.", sAll) > 0) "the files read"
            Send Assert (Pos("THE DATA LAYER - https://tsdocs.dataflex.dev/", sAll) > 0) "the data layer's page"
            Send Assert (Pos("HTTP - https://www.dataflex.dev/", sAll) > 0) "the HTTP page"
            Send Assert (Pos("NOT SUPPORTED YET - https://tsdocs.dataflex.dev/Roadmap/", sAll) > 0) "the roadmap"
            Send Assert (Pos("BREAKING IN 27.0.113 - https://tsdocs.dataflex.dev/Release-Notes/", sAll) > 0) "the release notes"
            Send Assert (Pos("3 site(s) in 2 file(s)", sAll) > 0) "Open's sites and files"
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

    End_Object
