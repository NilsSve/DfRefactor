//
// Description : Unit tests for the LegacyFieldOptionsReport scan core (_LegacyFieldOptionsScanFile, cRefactorFuncLib):
//               a pure whole-file classifier - no engine/file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oLegacyFieldOptionsReport is a cTestFixture
        Set psFunctionName to "LegacyFieldOptionsReport"

        // Character-mode entry options are flagged ANYWHERE on the line - including PARENTHESISED forms
        // like '(displayonly)' - and the DD_* target is named. Multiple options on one line are reported
        // once (deduped). A MODERN line that only mentions the DD_* constant (DD_CAPSLOCK) is NOT flagged:
        // _FindKeywordPos treats '_' as an identifier char, so 'capslock' is not a whole word inside it.
        {Published = True}
        Procedure LegacyFieldOptionsReport_ScanFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    Entry_Client Customer.Name (displayonly) (noenter)"               to asCode[0]
            Move "    Object oName is a dbForm autofind"                                to asCode[1]
            Move "    Set Field_Option DD_CAPSLOCK of oDD Field Customer.Name to True"  to asCode[2]
            Move "    Move iX to iY"                                                    to asCode[3]
            Get _LegacyFieldOptionsScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 2 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "DD_DISPLAYONLY")   // parenthesised (displayonly)
            Send Assert (sAll contains "DD_NOENTER")       // second option on the same line, deduped in
            Send Assert (sAll contains "Line 2:")
            Send Assert (sAll contains "DD_AUTOFIND")      // bare trailing autofind
            // the modern DD_CAPSLOCK mention (line 3) and plain code (line 4) are NOT flagged
            Send Assert (not(sAll contains "Line 3:"))
            Send Assert (not(sAll contains "Line 4:"))
        End_Procedure

        // No entry options -> nothing; a modern DD accessor is not mistaken for a legacy option.
        {Published = True}
        Procedure LegacyFieldOptionsReport_NoHits
            String[] asCode asReport
            Integer iN
            Move "    Set psCaption of oForm to sText"              to asCode[0]
            Move "    Get Field_Changed_Value of oDD to bChanged"   to asCode[1]
            Get _LegacyFieldOptionsScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

    End_Object
