//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeDFCreateMenuToCodeJock-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-11
//
// Description : Unit tests for DFCreate_Menu -> CodeJock: the parsing primitives and the block emitter.
//
//               The primitives carry the whole risk of the converter - everything downstream just assembles
//               text around what they return - and the emitter is where the grammar becomes a tree. Every
//               fixture is built from a line that actually occurs in the DF18/DF19 trees, not from an invented
//               shape: the awkward cases (a trailing "To Current_Object", single-quoted Status_Help, a caption
//               containing the word "send", a property declared in the middle of a menu) were all found by
//               reading real menus, and each one is here because it would otherwise have been got wrong.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
    Object oChangeDFCreateMenuToCodeJock is a cTestFixture
        Set psFunctionName to "ChangeDFCreateMenuToCodeJock"

        // ---- object names out of captions -------------------------------------------------------
        {Published = True}
        Procedure CJMenu_NameFromCaption
            String sName
            Get _CJMenuNameFromCaption of ghoFuncLib "&Contact Manager" "_MenuItem" to sName
            Send AssertSAreEqual "oContactManager_MenuItem" sName
            Get _CJMenuNameFromCaption of ghoFuncLib "&Contact Type Entry/Edit" "_MenuItem" to sName
            Send AssertSAreEqual "oContactTypeEntryEdit_MenuItem" sName
            Get _CJMenuNameFromCaption of ghoFuncLib "&File" "_Menu" to sName
            Send AssertSAreEqual "oFile_Menu" sName
        End_Procedure

        // A digit-leading caption cannot become a digit-leading identifier ("&1. Batch..." is real -
        // DataScrub.src numbers its whole View menu that way).
        {Published = True}
        Procedure CJMenu_NameFromDigitLeadingCaption
            String sName
            Get _CJMenuNameFromCaption of ghoFuncLib "&1. Batch Header Integrity Check" "_MenuItem" to sName
            Send AssertSAreEqual "oM1BatchHeaderIntegrityCheck_MenuItem" sName
        End_Procedure

        // A caption with characters outside ASCII (Swedish umlauts, codes 214 and 246) yields an ASCII name.
        // Measured 2026-09-13: a decoded umlaut compares ABOVE "z" / "Z", so the range test drops it - this
        // pins that, because a raw-read probe once made it look otherwise (an undecoded OEM byte rides on
        // the letter before it and compares as that letter).
        {Published = True}
        Procedure CJMenu_NameFromNonAsciiCaption
            String sName
            Get _CJMenuNameFromCaption of ghoFuncLib ("&" + Character(214) + "ppna fil") "_MenuItem" to sName
            Send AssertSAreEqual "oppnafil_MenuItem" sName
            Get _CJMenuNameFromCaption of ghoFuncLib ("&S" + Character(246) + "k") "_Menu" to sName
            Send AssertSAreEqual "oSk_Menu" sName
        End_Procedure

        // A caption with nothing usable in it still has to yield a legal name.
        {Published = True}
        Procedure CJMenu_NameFromEmptyCaption
            String sName
            Get _CJMenuNameFromCaption of ghoFuncLib "" "_MenuItem" to sName
            Send AssertSAreEqual "oItem_MenuItem" sName
            Get _CJMenuNameFromCaption of ghoFuncLib "---" "_MenuItem" to sName
            Send AssertSAreEqual "oItem_MenuItem" sName
        End_Procedure

        // ---- quoted text ------------------------------------------------------------------------
        {Published = True}
        Procedure CJMenu_QuotedText
            String sOut
            Get _CJQuotedText of ghoFuncLib 'On_Item "&Contact Manager \aCtrl+1"      Send Activate_ConMan' to sOut
            Send AssertSAreEqual "&Contact Manager \aCtrl+1" sOut
            // Single quotes: the form File_PM.inc uses for Status_Help.
            Get _CJQuotedText of ghoFuncLib "        Set Status_Help To 'Clear current record'" to sOut
            Send AssertSAreEqual "Clear current record" sOut
            // A separator carries an EMPTY literal - "" is the honest answer for it.
            Get _CJQuotedText of ghoFuncLib 'On_Item "" send NONE' to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        // ---- accelerators -----------------------------------------------------------------------
        {Published = True}
        Procedure CJMenu_AcceleratorSplit
            String sOut
            Get _CJCaptionWithoutAccel of ghoFuncLib "&Clear/Add\aF5" to sOut
            Send AssertSAreEqual "&Clear/Add" sOut
            // The \a marker survives, because the accelerator is emitted as a VERBATIM comment.
            Get _CJAcceleratorOf of ghoFuncLib "&Clear/Add\aF5" to sOut
            Send AssertSAreEqual "\aF5" sOut
            Get _CJCaptionWithoutAccel of ghoFuncLib "&Help Topic" to sOut
            Send AssertSAreEqual "&Help Topic" sOut
            Get _CJAcceleratorOf of ghoFuncLib "&Help Topic" to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        // ---- the message -------------------------------------------------------------------------
        {Published = True}
        Procedure CJMenu_MessageFromOnItem
            String sOut
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "&Clear/Add\aF5" send Request_Clear' to sOut
            Send AssertSAreEqual "Request_Clear" sOut
            // A trailing receiver must not be swallowed into the message (Win_PM.inc's real form).
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "&Tool-bar"  send Toggle_ToolBar   To Current_Object' to sOut
            Send AssertSAreEqual "Toggle_ToolBar" sOut
            // Mixed case, because the legacy sources spell it both ways on adjacent lines.
            Get _CJMessageFromOnItem of ghoFuncLib 'on_item "&Context Help"          send Extended_Help' to sOut
            Send AssertSAreEqual "Extended_Help" sOut
        End_Procedure

        // A separator's `send NONE` is not a message - "" tells the caller to set pbControlBeginGroup
        // on the NEXT item instead of emitting an object.
        {Published = True}
        Procedure CJMenu_SeparatorHasNoMessage
            String sOut
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "" send NONE' to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        // The LAST send wins, so a caption containing the word "send" cannot hijack the parse.
        {Published = True}
        Procedure CJMenu_CaptionContainingSendDoesNotWin
            String sOut
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "&Resend the report" send Activate_Resend' to sOut
            Send AssertSAreEqual "Activate_Resend" sOut
        End_Procedure

        // A line with no send at all yields "" rather than garbage.
        {Published = True}
        Procedure CJMenu_NoSendYieldsBlank
            String sOut
            Get _CJMessageFromOnItem of ghoFuncLib '    Set Status_Help To "Available Views"' to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        // ---- block delimiters --------------------------------------------------------------------
        {Published = True}
        Procedure CJMenu_OpenAndCloseDetection
            Boolean bOK
            Get _CJIsMenuOpen of ghoFuncLib "    DFCreate_Menu Main_Menu" to bOK
            Send Assert (bOK = True)
            Get _CJIsMenuClose of ghoFuncLib "        End_Pull_Down" to bOK
            Send Assert (bOK = True)
            Get _CJIsMenuClose of ghoFuncLib "    End_Menu" to bOK
            Send Assert (bOK = True)
            Get _CJIsMenuOpen of ghoFuncLib '    On_Item "&Find\aF9" send Find_GE' to bOK
            Send Assert (bOK = False)
            Get _CJIsMenuClose of ghoFuncLib '    On_Item "&Find\aF9" send Find_GE' to bOK
            Send Assert (bOK = False)
        End_Procedure

        // ---- the emitter, end to end -------------------------------------------------------------
        // A real File pulldown: every item is a catalogue hit, so NONE may carry a psCaption (the
        // shipped class supplies its own localized one) and each gets pbAddToDesignerMenu.
        {Published = True}
        Procedure CJMenu_EmitFilePulldown
            String[] asBlock asOut
            Integer iCount

            Move 'DFCreate_Menu "&File" File_Menu is a DEOPopupMenu' to asBlock[0]
            Move '    On_Item "&Clear/Add\aF5" send Request_Clear'   to asBlock[1]
            Move "        Set Status_Help To 'Clear current record'" to asBlock[2]
            Move '    On_Item "&Delete\aShift+F2" send Request_Delete' to asBlock[3]
            Move "    End_Pull_Down" to asBlock[4]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Send AssertIAreEqual 3 iCount
            Send AssertSAreEqual "Object oFile_Menu is a cCJMenuItem" asOut[0]
            Send AssertSAreEqual "    Set peControlType to xtpControlPopup" asOut[1]
            Send AssertSAreEqual '    Set psCaption to "&File"' asOut[2]
            Send AssertSAreEqual "    Object oClearAdd_MenuItem is a cCJClearMenuItem" asOut[3]
            Send AssertSAreEqual "        Set pbAddToDesignerMenu to True" asOut[4]
        End_Procedure

        // A program's OWN item: no catalogue hit, so it keeps its caption and gets an OnExecute that
        // sends the same message - carried across, never dropped.
        {Published = True}
        Procedure CJMenu_EmitGenericItemKeepsMessage
            String[] asBlock asOut
            Integer iCount iLine iSize
            Boolean bSawSend bSawCaption

            Move 'DFCreate_Menu "&View" ViewPopupMenu is a ViewPopupMenu' to asBlock[0]
            Move '    On_Item "&Contact Manager \aCtrl+1" Send Activate_ConMan' to asBlock[1]
            Move "End_Pull_Down" to asBlock[2]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Move False to bSawSend
            Move False to bSawCaption
            Move (SizeOfArray(asOut) - 1) to iSize
            For iLine from 0 to iSize
                If ((Trim(asOut[iLine])) = "Send Activate_ConMan") ;
                    Move True to bSawSend
                If ((Trim(asOut[iLine])) = 'Set psCaption to "&Contact Manager"') ;
                    Move True to bSawCaption
            Loop
            Send Assert (bSawSend = True)
            Send Assert (bSawCaption = True)
        End_Procedure

        // A separator decorates the NEXT item rather than becoming an object of its own.
        {Published = True}
        Procedure CJMenu_SeparatorBecomesBeginGroup
            String[] asBlock asOut
            Integer iCount iLine iSize
            Boolean bSawGroup

            Move 'DFCreate_Menu "&Help" Help_Menu' to asBlock[0]
            Move '    on_item "&Help Topic" send Help_on_topic' to asBlock[1]
            Move '    on_item "" send NONE' to asBlock[2]
            Move '    On_item "About" Send Activate_About' to asBlock[3]
            Move "End_Pull_Down" to asBlock[4]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            // two real items - the separator is not one of them
            Send AssertIAreEqual 3 iCount
            Move False to bSawGroup
            Move (SizeOfArray(asOut) - 1) to iSize
            For iLine from 0 to iSize
                If ((Trim(asOut[iLine])) = "Set pbControlBeginGroup to True") ;
                    Move True to bSawGroup
            Loop
            Send Assert (bSawGroup = True)
        End_Procedure

        // A line the grammar does not cover is COMMENTED, never dropped - Win_PM.inc really does
        // declare a property in the middle of its menu.
        {Published = True}
        Procedure CJMenu_UnknownLineIsCarriedCommented
            String[] asBlock asOut
            Integer iCount iLine iSize
            Boolean bCarried

            Move 'DFCreate_Menu "&Options" Options_Menu' to asBlock[0]
            Move "    Set select_mode to Multi_Select" to asBlock[1]
            Move "End_Pull_Down" to asBlock[2]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Move False to bCarried
            Move (SizeOfArray(asOut) - 1) to iSize
            For iLine from 0 to iSize
                If ((Pos("Set select_mode to Multi_Select", asOut[iLine])) > 0) ;
                    Move True to bCarried
            Loop
            Send Assert (bCarried = True)
        End_Procedure

        // The Window pulldown is recognised by the MESSAGES it holds, never by its caption.
        {Published = True}
        Procedure CJMenu_WindowPulldownBecomesMDIContainer
            String[] asBlock asOut
            Integer iCount
            Move 'DFCreate_Menu "&Window" Window_Menu' to asBlock[0]
            Move '    On_Item "&Cascade" send Cascade_Windows' to asBlock[1]
            Move "End_Pull_Down" to asBlock[2]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Send AssertSAreEqual "Object oWindow_Menu is a cCJMDIWindowsMenuItem" asOut[0]
        End_Procedure

        // ...and a pulldown WITHOUT those messages stays an ordinary popup, whatever it is called.
        {Published = True}
        Procedure CJMenu_PlainPulldownIsNotMDI
            String[] asBlock asOut
            Integer iCount
            Move 'DFCreate_Menu "&Window" Window_Menu' to asBlock[0]
            Move '    On_Item "&Something" send Activate_Something' to asBlock[1]
            Move "End_Pull_Down" to asBlock[2]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Send AssertSAreEqual "Object oWindow_Menu is a cCJMenuItem" asOut[0]
        End_Procedure

        // Status_Help AFTER End_Pull_Down describes the PULLDOWN, not the item before it.
        {Published = True}
        Procedure CJMenu_StatusHelpAfterCloseBelongsToPulldown
            String[] asBlock asOut
            Integer iCount
            Move 'DFCreate_Menu "&View" ViewPopupMenu is a ViewPopupMenu' to asBlock[0]
            Move '    On_Item "&Contact Manager" Send Activate_ConMan' to asBlock[1]
            Move "End_Pull_Down" to asBlock[2]
            Move 'Set Status_Help To "Available Views"' to asBlock[3]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iCount
            Send AssertSAreEqual '    Set psToolTip to "Available Views"' asOut[3]
        End_Procedure

        // ---- #INCLUDE expansion -----------------------------------------------------------------
        // Nils's first live Auto-fix run (2026-08-16) faulted 4381 in _CJExpandMenuIncludes on the
        // very first #INCLUDE line: the array was "emptied" with Move "" (a string into a String[]
        // is a runtime conversion error the compiler lets through), and no test had ever handed the
        // function an include line. These three do - the missing-file case is the exact branch.

        // A block with no #INCLUDE passes through untouched, line for line.
        {Published = True}
        Procedure CJMenu_ExpandIncludes_NoIncludeIsPassthrough
            String[] asBlock asOut
            Move 'DFCreate_Menu Main_Menu' to asBlock[0]
            Move '    On_Item "&Find\aF9" send Find_GE' to asBlock[1]
            Move "End_Menu" to asBlock[2]
            Get _CJExpandMenuIncludes of ghoFuncLib (&asBlock) "" to asOut
            Send AssertArrayAreEqual asBlock asOut
        End_Procedure

        // A fragment that cannot be found is kept as its ORIGINAL line - never dropped, never a fault.
        {Published = True}
        Procedure CJMenu_ExpandIncludes_MissingFragmentKeepsLine
            String[] asBlock asOut
            String sDataPath
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move 'DFCreate_Menu Main_Menu' to asBlock[0]
            Move '    #INCLUDE _NoSuchFragment_.inc   // file pulldown' to asBlock[1]
            Move "End_Menu" to asBlock[2]
            Get _CJExpandMenuIncludes of ghoFuncLib (&asBlock) sDataPath to asOut
            Send AssertIAreEqual 3 (SizeOfArray(asOut))
            Send AssertSAreEqual asBlock[1] asOut[1]
        End_Procedure

        // A fragment that IS there is inlined below its (now commented) #INCLUDE line; a trailing
        // end-of-line comment on the include line must not become part of the file name.
        {Published = True}
        Procedure CJMenu_ExpandIncludes_FragmentIsInlined
            String[] asBlock asOut asFrag
            String sDataPath sFrag
            Boolean bOk
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_CJFrag_.inc") to sFrag
            Move 'DFCreate_Menu "&File" File_Menu is a DEOPopupMenu' to asFrag[0]
            Move '    On_Item "&Clear/Add\aF5" send Request_Clear' to asFrag[1]
            Move "End_Pull_Down" to asFrag[2]
            Get rfWriteEncodedFileFromStringArray (&asFrag) sFrag C_NewLine False to bOk
            Send Assert bOk
            Move 'DFCreate_Menu Main_Menu' to asBlock[0]
            Move '    #INCLUDE _CJFrag_.inc   // file pulldown' to asBlock[1]
            Move "End_Menu" to asBlock[2]
            Get _CJExpandMenuIncludes of ghoFuncLib (&asBlock) sDataPath to asOut
            Move (rfDeleteFile(sFrag)) to iVoid
            // 3 block lines - the include line - + its commented echo + 3 fragment lines = 6
            Send AssertIAreEqual 6 (SizeOfArray(asOut))
            Send AssertSAreEqual asBlock[0] asOut[0]
            Send Assert ((Pos("#INCLUDE _CJFrag_.inc", asOut[1])) > 0)
            Send Assert ((Left(Trim(asOut[1]), 2)) = "//")
            Send AssertSAreEqual asFrag[0] asOut[2]
            Send AssertSAreEqual asFrag[1] asOut[3]
            Send AssertSAreEqual asFrag[2] asOut[4]
            Send AssertSAreEqual "End_Menu" asOut[5]
        End_Procedure

        // ---- The root caption (2026-09-04, LegacyApp ORDER.SRC) --------------------------------------
        // Quotes inside the root line's trailing COMMENT are not a caption: the root stays a menu bar.
        {Published = True}
        Procedure CJMenu_RootCaptionInComment_StaysMenuBar
            String[] asBlock asOut
            Integer iEmitted i
            Boolean bBar bPopupFromComment

            Move 'DFCreate_Menu Main_Menu //"LegacyApp Business System"'    to asBlock[0]
            Move 'DFCreate_Menu "&File" File_Menu is a DEOPopupMenu'      to asBlock[1]
            Move '    On_Item "&Clear/Add\aF5" send Request_Clear'         to asBlock[2]
            Move "End_Pull_Down"                                           to asBlock[3]
            Move "End_Menu"                                                to asBlock[4]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iEmitted
            Send Assert (iEmitted > 0)
            Move False to bBar
            Move False to bPopupFromComment
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (asOut[i] contains "is a cCJMenuBar") ;
                    Move True to bBar
                If (asOut[i] contains "LegacyAppBusinessSystem") ;
                    Move True to bPopupFromComment
            Loop
            Send Assert bBar
            Send AssertFalse bPopupFromComment
        End_Procedure

        // ---- Hand-written code in the menu (2026-09-04, LegacyApp Order.mn) ------------------------
        // A Procedure inside the block REFUSES the program: nothing emitted, nothing changed, and the
        // count + first name are left for the run note. A commented-out procedure does not count.
        {Published = True}
        Procedure CJMenu_UserProcedureInBlock_Refused
            String[] asCode asOrig
            String sDataPath sFirst
            Integer iEmitted iProcs

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Object Main is a Panel"                                    to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                               to asCode[1]
            Move '    DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu' to asCode[2]
            Move "    //  Procedure OnChange"                                to asCode[3]
            Move "    Procedure OnChange"                                    to asCode[4]
            Move "        Send DoSomething"                                  to asCode[5]
            Move "    End_Procedure"                                         to asCode[6]
            Move '    On_Item "&New" Send Activate_New'                      to asCode[7]
            Move "    End_Pull_Down"                                         to asCode[8]
            Move "    End_Menu"                                              to asCode[9]
            Move "    Object oClientArea is a ClientArea"                    to asCode[10]
            Move "    End_Object"                                            to asCode[11]
            Move "End_Object"                                                to asCode[12]
            Move asCode to asOrig
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send AssertIAreEqual 0 iEmitted
            Send AssertIAreEqual (SizeOfArray(asOrig)) (SizeOfArray(asCode))
            Send AssertSAreEqual asOrig[4] asCode[4]
            Get piCJUserProcs of ghoFuncLib to iProcs
            Get psCJFirstUserProc of ghoFuncLib to sFirst
            Send AssertIAreEqual 1 iProcs
            Send AssertSAreEqual "OnChange" sFirst
        End_Procedure

        // ---- OnInitMenu -> OnPopupInit (Nils 2026-09-04: "we should be able to deal with them") --
        // Order.mn's shape in miniature: a user lookup, an If/Else, Shadow_State by literal index -
        // with the Item keyword and without - Select_State, a separator that takes an index, an
        // index past the end, a trailing comment, a commented-out line. The procedure lands inside
        // the popup after its children; nothing of the body is "carried across for review".
        {Published = True}
        Procedure CJMenu_OnInitMenu_BecomesOnPopupInit
            String[] asBlock asOut
            Integer iEmitted i iProc iEnd iEndObj
            Boolean bA bC bChecked bSep bPast bVerbatim bReview bComment

            Move 'DFCreate_Menu Main_Menu'                                       to asBlock[0]
            Move 'DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu'       to asBlock[1]
            Move 'Procedure OnInitMenu'                                           to asBlock[2]
            Move '    Integer iuser'                                              to asBlock[3]
            Move '    Move (fusernr(Self)) to iuser'                              to asBlock[4]
            Move '    If (userinfo.no_order = "1") Begin'                         to asBlock[5]
            Move '        Set shadow_state Item 0 to true'                        to asBlock[6]
            Move '        //        set shadow_state item 2 to true'              to asBlock[7]
            Move '        Set shadow_state Item 1 to (fStopView(Self, "01", "100"))   //SttNewPr' to asBlock[8]
            Move '    End'                                                        to asBlock[9]
            Move '    Else Begin'                                                 to asBlock[10]
            Move '        Set shadow_state 2 to false'                            to asBlock[11]
            Move '        Set select_state Item 2 to (bDone)'                     to asBlock[12]
            Move '        Set shadow_state Item 7 to true'                        to asBlock[13]
            Move '    End'                                                        to asBlock[14]
            Move 'End_Procedure'                                                  to asBlock[15]
            Move 'On_Item "&Alpha" Send Activate_Alpha'                           to asBlock[16]
            Move 'On_Item "" Send none'                                           to asBlock[17]
            Move 'On_Item "&Charlie" Send Activate_Charlie'                       to asBlock[18]
            Move 'End_Pull_Down'                                                  to asBlock[19]
            Move 'End_Menu'                                                       to asBlock[20]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iEmitted
            Send Assert (iEmitted > 0)
            Move -1 to iProc
            Move -1 to iEnd
            Move -1 to iEndObj
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (asOut[i] contains "Procedure OnPopupInit Variant vCommandBarControl Handle hoCommandBarControls") ;
                    Move i to iProc
                If (asOut[i] contains "Set pbEnabled of (oAlpha_MenuItem(Self)) to False") ;
                    Move True to bA
                If (asOut[i] contains "Set pbEnabled of (oCharlie_MenuItem(Self)) to True") ;
                    Move True to bC
                If (asOut[i] contains "Set pbChecked of (oCharlie_MenuItem(Self)) to (bDone)") ;
                    Move True to bChecked
                If (asOut[i] contains "item 1 is a separator line") ;
                    Move True to bSep
                If (asOut[i] contains "item 7 is a separator line") ;
                    Move True to bPast
                If (asOut[i] contains "Move (fusernr(Self)) to iuser" and not (asOut[i] contains "TODO")) ;
                    Move True to bVerbatim
                If (asOut[i] contains "//        set shadow_state item 2 to true") ;
                    Move True to bComment
                If (asOut[i] contains "not part of the menu grammar") ;
                    Move True to bReview
                If (iProc >= 0 and iEnd < 0 and Trim(asOut[i]) = "End_Procedure") ;
                    Move i to iEnd
                If (iEnd >= 0 and iEndObj < 0 and Trim(asOut[i]) = "End_Object") ;
                    Move i to iEndObj
            Loop
            Send Assert (iProc > 0)
            Send Assert bA
            Send Assert bC
            Send Assert bChecked
            Send Assert bSep
            Send Assert bPast
            Send Assert bVerbatim
            Send Assert bComment
            Send AssertFalse bReview
            // the procedure closes right before the popup's own End_Object
            Send AssertIAreEqual (iEnd + 1) iEndObj
            // the first child came BEFORE the procedure
            Move False to bA
            For i from 0 to (iProc - 1)
                If (asOut[i] contains "Object oAlpha_MenuItem is a") ;
                    Move True to bA
            Loop
            Send Assert bA
        End_Procedure

        // Two items with the same caption in one pulldown get distinct object names, and the
        // translated Shadow_State lines address each by its own name (Order.mn's Utskrifter has
        // four such pairs; DF26 compiles the twins without a word and reaches only one of them).
        {Published = True}
        Procedure CJMenu_TwinCaptions_GetUniqueNames
            String[] asBlock asOut
            Integer iEmitted i
            Boolean bFirst bSecond bMap1 bMap2

            Move 'DFCreate_Menu Main_Menu'                                       to asBlock[0]
            Move 'DFCreate_Menu "&Print" PrintPopupMenu is a ViewPopupMenu'       to asBlock[1]
            Move 'Procedure OnInitMenu'                                           to asBlock[2]
            Move '    Set shadow_state Item 0 to true'                            to asBlock[3]
            Move '    Set shadow_state Item 1 to false'                           to asBlock[4]
            Move 'End_Procedure'                                                  to asBlock[5]
            Move 'On_Item "Due invoices" Send Activate_DueA'                      to asBlock[6]
            Move 'On_Item "Due invoices" Send Activate_DueB'                      to asBlock[7]
            Move 'End_Pull_Down'                                                  to asBlock[8]
            Move 'End_Menu'                                                       to asBlock[9]
            Get _CJMenuBlockToObjects of ghoFuncLib asBlock "" (&asOut) to iEmitted
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (asOut[i] contains "Object oDueinvoices_MenuItem is a") ;
                    Move True to bFirst
                If (asOut[i] contains "Object oDueinvoices_MenuItem_2 is a") ;
                    Move True to bSecond
                If (asOut[i] contains "Set pbEnabled of (oDueinvoices_MenuItem(Self)) to False") ;
                    Move True to bMap1
                If (asOut[i] contains "Set pbEnabled of (oDueinvoices_MenuItem_2(Self)) to True") ;
                    Move True to bMap2
            Loop
            Send Assert bFirst
            Send Assert bSecond
            Send Assert bMap1
            Send Assert bMap2
        End_Procedure

        // With only an OnInitMenu in it, the program CONVERTS (it used to be refused).
        {Published = True}
        Procedure CJMenu_OnInitMenuAlone_Converts
            String[] asCode
            String sDataPath sFirst
            Integer iEmitted iProcs

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Object Main is a Panel"                                    to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                               to asCode[1]
            Move '    DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu' to asCode[2]
            Move "    Procedure OnInitMenu"                                  to asCode[3]
            Move "        Set shadow_state Item 0 to True"                   to asCode[4]
            Move "    End_Procedure"                                         to asCode[5]
            Move '    On_Item "&New" Send Activate_New'                      to asCode[6]
            Move "    End_Pull_Down"                                         to asCode[7]
            Move "    End_Menu"                                              to asCode[8]
            Move "    Object oClientArea is a ClientArea"                    to asCode[9]
            Move "    End_Object"                                            to asCode[10]
            Move "End_Object"                                                to asCode[11]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Get piCJUserProcs of ghoFuncLib to iProcs
            Get psCJFirstUserProc of ghoFuncLib to sFirst
            Send AssertIAreEqual 0 iProcs
            Send AssertSAreEqual "" sFirst
        End_Procedure

        // A #included file with no menu grammar - MyShadow.pkg's helper functions - is not inlined:
        // it stays a live #Include inside the menu bar object, and it does not refuse the program.
        {Published = True}
        Procedure CJMenu_MethodsInclude_KeptLiveInMenuBar
            String[] asCode asShadow
            String sDataPath sShadow
            Integer iEmitted iProcs iVoid i iBar iInc
            Boolean bOk bCommented

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "_CJShadow_.pkg") to sShadow
            Move "Open Amenu"                                                to asShadow[0]
            Move "Function fStopView String smenu String sview Returns Integer" to asShadow[1]
            Move "    Function_Return 0"                                     to asShadow[2]
            Move "End_Procedure"                                             to asShadow[3]
            Get rfWriteEncodedFileFromStringArray (&asShadow) sShadow C_NewLine False to bOk
            Move "Object Main is a Panel"                                    to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                               to asCode[1]
            Move "#include _CJShadow_.pkg"                                   to asCode[2]
            Move '    DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu' to asCode[3]
            Move '    On_Item "&New" Send Activate_New'                      to asCode[4]
            Move "    End_Pull_Down"                                         to asCode[5]
            Move "    End_Menu"                                              to asCode[6]
            Move "    Object oClientArea is a ClientArea"                    to asCode[7]
            Move "    End_Object"                                            to asCode[8]
            Move "End_Object"                                                to asCode[9]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Move (rfDeleteFile(sShadow)) to iVoid
            Send Assert (iEmitted > 0)
            Get piCJUserProcs of ghoFuncLib to iProcs
            Send AssertIAreEqual 0 iProcs
            Move -1 to iBar
            Move -1 to iInc
            Move False to bCommented
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "Object oMenuBar is a cCJMenuBar") ;
                    Move i to iBar
                If (Left(Trim(asCode[i]), 8) = "#Include" and asCode[i] contains "_CJShadow_.pkg") ;
                    Move i to iInc
                If (asCode[i] contains "Function fStopView") ;
                    Move True to bCommented
            Loop
            Send Assert (iBar >= 0)
            Send Assert (iInc > iBar)
            Send AssertFalse bCommented
        End_Procedure

        // POSITIVE CONTROL: the same menu without the procedure converts, and the counters read 0.
        {Published = True}
        Procedure CJMenu_NoUserProcedure_Converts
            String[] asCode
