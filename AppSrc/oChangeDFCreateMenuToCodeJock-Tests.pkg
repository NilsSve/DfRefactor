            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Object Main is a Panel"                                    to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                               to asCode[1]
            Move '    DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu' to asCode[2]
            Move "    //  Procedure OnInitMenu"                              to asCode[3]
            Move '    On_Item "&New" Send Activate_New'                      to asCode[4]
            Move "    End_Pull_Down"                                         to asCode[5]
            Move "    End_Menu"                                              to asCode[6]
            Move "    Object oClientArea is a ClientArea"                    to asCode[7]
            Move "    End_Object"                                            to asCode[8]
            Move "End_Object"                                                to asCode[9]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Get piCJUserProcs of ghoFuncLib to iProcs
            Get psCJFirstUserProc of ghoFuncLib to sFirst
            Send AssertIAreEqual 0 iProcs
            Send AssertSAreEqual "" sFirst
        End_Procedure

        // ---- Shipped fragments keep their grammar only (2026-09-04) ----------------------------
        // File_pm.inc's shape: a #warning, the pulldown, items with Status_Help, an OnInitMenu body.
        // The grammar survives, the code does not, and the count says how much went.
        {Published = True}
        Procedure CJMenu_ShippedFragment_GrammarOnly
            String[] asInc asOut
            Integer iOmitted

            Move '#warning DFERR_COMP_WARNING_OBSOLETE_PACKAGE "Obsolete Package: File_pm.inc"' to asInc[0]
            Move 'DFCreate_Menu "&File" File_Menu is a DEOPopupMenu'                          to asInc[1]
            Move '    On_Item "&Clear/Add\aF5" Send Request_Clear'                             to asInc[2]
            Move "        Set Status_Help to 'Clear current record / Add a new record'"         to asInc[3]
            Move ""                                                                             to asInc[4]
            Move "    Procedure OnInitMenu"                                                     to asInc[5]
            Move "        Integer Obj# IsDeo"                                                   to asInc[6]
            Move "        Get Focus of desktop to Obj#"                                         to asInc[7]
            Move "        Set Shadow_State Item 0 to (not(IsDeo))"                              to asInc[8]
            Move "    End_Procedure"                                                            to asInc[9]
            Move "    // a comment survives, it weighs nothing"                                 to asInc[10]
            Move "End_Pull_Down"                                                                to asInc[11]
            Get _CJShippedFragmentGrammarOnly of ghoFuncLib (&asInc) (&iOmitted) to asOut
            Send AssertIAreEqual 6 iOmitted
            Send AssertIAreEqual 6 (SizeOfArray(asOut))
            Send AssertSAreEqual asInc[1]  asOut[0]
            Send AssertSAreEqual asInc[2]  asOut[1]
            Send AssertSAreEqual asInc[3]  asOut[2]
            Send AssertSAreEqual asInc[4]  asOut[3]
            Send AssertSAreEqual asInc[10] asOut[4]
            Send AssertSAreEqual asInc[11] asOut[5]
        End_Procedure

        // ---- Fragment resolution (2026-09-04) ------------------------------------------------
        // The program's folder wins; a name found nowhere resolves to "" (psTargetPkgFolder is
        // blank under the runner, so the install branch cannot be reached here - it is the same
        // vFolderFormat + name test, against the folder the analyzer already scans).
        {Published = True}
        Procedure CJMenu_ResolveFragment_BaseDirThenNothing
            String[] asFrag
            String sDataPath sFrag sPath
            Boolean bOk bInstall
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "_CJRes_.inc") to sFrag
            Move "End_Pull_Down" to asFrag[0]
            Get rfWriteEncodedFileFromStringArray (&asFrag) sFrag C_NewLine False to bOk
            Get _CJResolveFragmentPath of ghoFuncLib "_CJRes_.inc" sDataPath (&bInstall) to sPath
            Move (rfDeleteFile(sFrag)) to iVoid
            Send AssertSAreEqual (Lowercase(sFrag)) (Lowercase(sPath))
            Send AssertFalse bInstall
            Get _CJResolveFragmentPath of ghoFuncLib "_CJNoSuch_.inc" sDataPath (&bInstall) to sPath
            Send AssertSAreEqual "" sPath
        End_Procedure

        // ---- The anchor (2026-09-04, LegacyApp) ---------------------------------------------------
        // A SUBCLASSED client area anchors: the token after "is a" ends in "clientarea". A class
        // that merely contains the word does not.
        {Published = True}
        Procedure CJMenu_Anchor_SubclassedClientArea
            String[] asCode
            String sIndent
            Integer iAnchor
            Boolean bFound bWrap

            Move "Object Main is a cAmPanel"                          to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                        to asCode[1]
            Move "    End_Menu"                                       to asCode[2]
            Move "    Object oHelper is a cClientAreaHelper"          to asCode[3]
            Move "    End_Object"                                     to asCode[4]
            Move "    Object Client_Area is a cAmAppClientArea"       to asCode[5]
            Move "    End_Object"                                     to asCode[6]
            Move "End_Object"                                         to asCode[7]
            Get _CJFindMenuAnchor of ghoFuncLib (&asCode) (&iAnchor) (&bWrap) (&sIndent) to bFound
            Send Assert bFound
            Send AssertIAreEqual 5 iAnchor
            Send Assert bWrap
            Send AssertSAreEqual "    " sIndent
        End_Procedure

        // ---- The .mn route (2026-09-04, LegacyApp) --------------------------------------------
        // The program carries "Use X.mn" and no block of its own: the block is read out of the
        // menu file, the CodeJock tree lands at the anchor, the Use line is commented, and the
        // menu file on disk is untouched.
        {Published = True}
        Procedure CJMenu_UsedFragment_ConvertedIntoProgram
            String[] asCode asMn asBack
            String sDataPath sMn
            Boolean bOk bSys bUseCommented
            Integer iEmitted iVoid i

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath   // psDataPath has no trailing separator
            Move (sDataPath + "_CJUsed_.mn") to sMn
            Move "DFCreate_Menu Main_Menu"                              to asMn[0]
            Move 'DFCreate_Menu "&File" File_Menu is a DEOPopupMenu'   to asMn[1]
            Move '    On_Item "&Clear/Add\aF5" send Request_Clear'     to asMn[2]
            Move "End_Pull_Down"                                        to asMn[3]
            Move "End_Menu"                                             to asMn[4]
            Get rfWriteEncodedFileFromStringArray (&asMn) sMn C_NewLine False to bOk
            Send Assert bOk
            Move "Object Main is a Panel"                     to asCode[0]
            Move "Use _CJUsed_.mn //  Menu package."          to asCode[1]
            Move "    Object oClientArea is a ClientArea"     to asCode[2]
            Move "    End_Object"                             to asCode[3]
            Move "End_Object"                                 to asCode[4]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Move (rfReadEncodedFileAsStringArray(sMn)) to asBack
            Move (rfDeleteFile(sMn)) to iVoid
            Send Assert (iEmitted > 0)
            Move False to bSys
            Move False to bUseCommented
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "is a cCJCommandBarSystem") ;
                    Move True to bSys
                If (asCode[i] contains "Use _CJUsed_.mn" and Left(Trim(asCode[i]), 2) = "//") ;
                    Move True to bUseCommented
            Loop
            Send Assert bSys
            Send Assert bUseCommented
            // the menu file came back exactly as written
            Send AssertIAreEqual 5 (SizeOfArray(asBack))
            Send AssertSAreEqual asMn[0] asBack[0]
            Send AssertSAreEqual asMn[4] asBack[4]
        End_Procedure

        // A program with neither a block nor a Use of a menu file is left alone (0), as before.
        {Published = True}
        Procedure CJMenu_NoBlockNoFragment_Untouched
            String[] asCode
            String sDataPath
            Integer iEmitted

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move "Object Main is a Panel"                     to asCode[0]
            Move "Use cApplication.pkg"                       to asCode[1]
            Move "    Object oClientArea is a ClientArea"     to asCode[2]
            Move "    End_Object"                             to asCode[3]
            Move "End_Object"                                 to asCode[4]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send AssertIAreEqual 0 iEmitted
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // The includer search: the .src that says "Use <leaf>" is found, one that does not is not,
        // a commented Use does not count - and a pulldown .inc that only a menu file #includes
        // resolves through that menu file to the SAME program (LegacyApp's HELP_APP.inc); one whose
        // menu file nothing uses resolves to nobody.
        {Published = True}
        Procedure CJMenu_IncludersOfFragment_FindsTheProgram
            String[] asProg asOther asMn asDeadMn asFound
            String sDataPath sProg sOther sMn sDeadMn
            Boolean bOk
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath   // psDataPath has no trailing separator
            Move (sDataPath + "_CJProg_.src")  to sProg
            Move (sDataPath + "_CJOther_.src") to sOther
            Move (sDataPath + "_CJUsed2_.mn")  to sMn
            Move (sDataPath + "_CJDead2_.mn")  to sDeadMn
            Move "Object Main is a Panel"                     to asProg[0]
            Move "Use _CJUsed2_.mn //  Menu package."         to asProg[1]
            Move "End_Object"                                 to asProg[2]
            Move "Object Main is a Panel"                     to asOther[0]
            Move "// Use _CJUsed2_.mn"                        to asOther[1]
            Move "Use _CJUsed2_.mnx"                          to asOther[2]
            Move "End_Object"                                 to asOther[3]
            Move "DFCreate_Menu Main_Menu"                    to asMn[0]
            Move "#include _CJHelp_.inc   // help pulldown"   to asMn[1]
            Move "End_Menu"                                   to asMn[2]
            Move "DFCreate_Menu Main_Menu"                    to asDeadMn[0]
            Move "#include _CJOrphan_.inc"                    to asDeadMn[1]
            Move "End_Menu"                                   to asDeadMn[2]
            Get rfWriteEncodedFileFromStringArray (&asProg)   sProg   C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asOther)  sOther  C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asMn)     sMn     C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asDeadMn) sDeadMn C_NewLine False to bOk
            Get _CJIncludersOfFragment of ghoFuncLib (sDataPath + "_CJUsed2_.mn") to asFound
            Send AssertIAreEqual 1 (SizeOfArray(asFound))
            Send AssertSAreEqual (Lowercase(sProg)) (Lowercase(asFound[0]))
            // the .inc, one hop down, reaches the same program
            Get _CJIncludersOfFragment of ghoFuncLib (sDataPath + "_CJHelp_.inc") to asFound
            Send AssertIAreEqual 1 (SizeOfArray(asFound))
            Send AssertSAreEqual (Lowercase(sProg)) (Lowercase(asFound[0]))
            // the .inc whose menu file nobody uses reaches nobody
            Get _CJIncludersOfFragment of ghoFuncLib (sDataPath + "_CJOrphan_.inc") to asFound
            Send AssertIAreEqual 0 (SizeOfArray(asFound))
            Move (rfDeleteFile(sProg))   to iVoid
            Move (rfDeleteFile(sOther))  to iVoid
            Move (rfDeleteFile(sMn))     to iVoid
            Move (rfDeleteFile(sDeadMn)) to iVoid
        End_Procedure

        // ---- The packages the emitted tree needs (2026-09-07) ---------------------------------------
        /* DfAllEnt brings the command bar system, the menu bar and cCJMenuItem; the standard items (Exit,
           the status bar, cascade/tile/minimize/restore/arrange) live in cCJStandardMenuItemClasses.pkg and
           the Windows pulldown's container in cCJMDIWindowsMenuItem.pkg. A converted program that Used
           neither compiled with twenty 'MUST BE DEFINED' errors. */

        // Index of the first line whose trimmed lowercase text starts with sPrefix and contains sNeedle; -1 when none.
        Function IndexOfUse String[] asLines String sNeedle Returns Integer
            Integer i iLast
            String sLow
            Move (SizeOfArray(asLines) - 1) to iLast
            For i from 0 to iLast
                Move (Lowercase(Trim(asLines[i]))) to sLow
                If (Left(sLow, 4) = "use " and (sLow contains Lowercase(sNeedle))) ;
                    Function_Return i
            Loop
            Function_Return -1
        End_Function

        Function CountOfUse String[] asLines String sNeedle Returns Integer
            Integer i iLast iN
            String sLow
            Move (SizeOfArray(asLines) - 1) to iLast
            Move 0 to iN
            For i from 0 to iLast
                Move (Lowercase(Trim(asLines[i]))) to sLow
                If (Left(sLow, 4) = "use " and (sLow contains Lowercase(sNeedle))) ;
                    Increment iN
            Loop
            Function_Return iN
        End_Function

        // A Window pulldown recognised by its messages: both packages, after the last top-level Use and
        // before the program's first top-level Object.
        {Published = True}
        Procedure CJMenu_PackagesOfTheTreeAreUsed
            String[] asCode
            String sDataPath
            Integer iEmitted iStd iMdi iWin iMain i
            Boolean bMdiObject bCascadeObject

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                                                  to asCode[0]
            Move "Use Windows.pkg"                                                   to asCode[1]
            Move ""                                                                  to asCode[2]
            Move "Object Main is a Panel"                                           to asCode[3]
            Move "    DFCreate_Menu Main_Menu"                                      to asCode[4]
            Move '    DFCreate_Menu "&Window" WindowPullDown is a ViewPopupMenu'     to asCode[5]
            Move '    On_Item "&Cascade" Send Cascade_Windows'                      to asCode[6]
            Move '    On_Item "Tile &Horizontally" Send Tile_Windows_Horizontally'  to asCode[7]
            Move '    On_Item "&Arrange Icons" Send Arrange_Icons'                  to asCode[8]
            Move "    End_Pull_Down"                                                to asCode[9]
            Move "    End_Menu"                                                     to asCode[10]
            Move "    Object oClientArea is a ClientArea"                           to asCode[11]
            Move "    End_Object"                                                   to asCode[12]
            Move "End_Object"                                                       to asCode[13]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Move False to bMdiObject
            Move False to bCascadeObject
            Move -1 to iMain
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Lowercase(asCode[i]) contains "is a ccjmdiwindowsmenuitem") ;
                    Move True to bMdiObject
                If (Lowercase(asCode[i]) contains "is a ccjcascademenuitem") ;
                    Move True to bCascadeObject
                If (iMain = -1 and Lowercase(asCode[i]) = "object main is a panel") ;
                    Move i to iMain
            Loop
            Send Assert bMdiObject
            Send Assert bCascadeObject
            Get IndexOfUse asCode "windows.pkg"                    to iWin
            Get IndexOfUse asCode "ccjstandardmenuitemclasses.pkg" to iStd
            Get IndexOfUse asCode "ccjmdiwindowsmenuitem.pkg"      to iMdi
            Send Assert (iStd > iWin)
            Send Assert (iMdi > iWin)
            Send Assert (iStd < iMain)
            Send Assert (iMdi < iMain)
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, "ccjstandardmenuitemclasses.pkg"))
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, "ccjmdiwindowsmenuitem.pkg"))
        End_Procedure

        // The About item's own package (2026-10-31): cCJAboutMenuItem.pkg, once, before the first top-level Object -
        // it was counted among the standard items, and the converted program failed with 'MUST BE DEFINED'.
        {Published = True}
        Procedure CJMenu_AboutItemGetsItsOwnPackage
            String[] asCode
            String sDataPath
            Integer iEmitted iAbout iMain i
            Boolean bAboutObject

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                                                  to asCode[0]
            Move ""                                                                  to asCode[1]
            Move "Object Main is a Panel"                                           to asCode[2]
            Move "    DFCreate_Menu Main_Menu"                                      to asCode[3]
            Move '    DFCreate_Menu "&Help" HelpPullDown is a ViewPopupMenu'         to asCode[4]
            Move '    On_Item "&About" Send Activate_About'                         to asCode[5]
            Move "    End_Pull_Down"                                                to asCode[6]
            Move "    End_Menu"                                                     to asCode[7]
            Move "    Object oClientArea is a ClientArea"                           to asCode[8]
            Move "    End_Object"                                                   to asCode[9]
            Move "End_Object"                                                       to asCode[10]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Move False to bAboutObject
            Move -1 to iMain
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Lowercase(asCode[i]) contains "is a ccjaboutmenuitem") ;
                    Move True to bAboutObject
                If (iMain = -1 and Lowercase(asCode[i]) = "object main is a panel") ;
                    Move i to iMain
            Loop
            Send Assert bAboutObject "the About item is a cCJAboutMenuItem"
            Get IndexOfUse asCode "ccjaboutmenuitem.pkg" to iAbout
            Send Assert (iAbout > 0 and iAbout < iMain) ("Use cCJAboutMenuItem.pkg at " + String(iAbout) + ", Main at " + String(iMain))
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, "ccjaboutmenuitem.pkg"))
        End_Procedure

        // Already Used: nothing is added twice.
        {Published = True}
        Procedure CJMenu_PackagesNotDuplicatedWhenAlreadyUsed
            String[] asCode
            String sDataPath
            Integer iEmitted

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                                                  to asCode[0]
            Move "Use cCJStandardMenuItemClasses.pkg"                                to asCode[1]
            Move "Use cCJMDIWindowsMenuItem.pkg"                                     to asCode[2]
            Move "Object Main is a Panel"                                           to asCode[3]
            Move "    DFCreate_Menu Main_Menu"                                      to asCode[4]
            Move '    DFCreate_Menu "&Window" WindowPullDown is a ViewPopupMenu'     to asCode[5]
            Move '    On_Item "&Cascade" Send Cascade_Windows'                      to asCode[6]
            Move "    End_Pull_Down"                                                to asCode[7]
            Move "    End_Menu"                                                     to asCode[8]
            Move "    Object oClientArea is a ClientArea"                           to asCode[9]
            Move "    End_Object"                                                   to asCode[10]
            Move "End_Object"                                                       to asCode[11]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, "ccjstandardmenuitemclasses.pkg"))
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, "ccjmdiwindowsmenuitem.pkg"))
        End_Procedure

        // A menu of plain items needs nothing beyond what DfAllEnt brings: no Use line is added.
        {Published = True}
        Procedure CJMenu_PlainMenuAddsNoPackages
            String[] asCode
            String sDataPath
            Integer iEmitted

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                                                  to asCode[0]
            Move "Object Main is a Panel"                                           to asCode[1]
            Move "    DFCreate_Menu Main_Menu"                                      to asCode[2]
            Move '    DFCreate_Menu "&File" FilePullDown is a ViewPopupMenu'         to asCode[3]
            Move '    On_Item "&New" Send Activate_New'                             to asCode[4]
            Move "    End_Pull_Down"                                                to asCode[5]
            Move "    End_Menu"                                                     to asCode[6]
            Move "    Object oClientArea is a ClientArea"                           to asCode[7]
            Move "    End_Object"                                                   to asCode[8]
            Move "End_Object"                                                       to asCode[9]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Send AssertIAreEqual 0 (CountOfUse(Self, asCode, "ccjstandardmenuitemclasses.pkg"))
            Send AssertIAreEqual 0 (CountOfUse(Self, asCode, "ccjmdiwindowsmenuitem.pkg"))
        End_Procedure

        // ---- A dotted legacy message name survives (2026-09-07) --------------------------------------
        // The identifier after 'send' was read as letters, digits and underscores only, so a dotted name was
        // cut at the dot: the converted item then sent a message that exists and does nothing.
        {Published = True}
        Procedure CJMenu_DottedMessageKeptWhole
            String[] asCode
            String sDataPath sMsg
            Integer iEmitted i
            Boolean bFound

            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "Show" Send Report.ShowOpenFiles' to sMsg
            Send AssertSAreEqual "Report.ShowOpenFiles" sMsg
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "Count" Send count#' to sMsg
            Send AssertSAreEqual "count#" sMsg
            Get _CJMessageFromOnItem of ghoFuncLib 'On_Item "Do" Send Do_It$ To Current_Object' to sMsg
            Send AssertSAreEqual "Do_It$" sMsg

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                                                  to asCode[0]
            Move "Object Main is a Panel"                                           to asCode[1]
            Move "    DFCreate_Menu Main_Menu"                                      to asCode[2]
            Move '    DFCreate_Menu "&File" FilePullDown is a ViewPopupMenu'         to asCode[3]
            Move '    On_Item "Show open" Send Report.ShowOpenFiles'                to asCode[4]
            Move "    End_Pull_Down"                                                to asCode[5]
            Move "    End_Menu"                                                     to asCode[6]
            Move "    Object oClientArea is a ClientArea"                           to asCode[7]
            Move "    End_Object"                                                   to asCode[8]
            Move "End_Object"                                                       to asCode[9]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Send Assert (iEmitted > 0)
            Move False to bFound
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = "Send Report.ShowOpenFiles") ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        // ---- An EMPTY legacy menu (2026-09-11) -----------------------------------------------------
        // A program Uses a menu file whose Main_Menu holds nothing: there was nothing to emit, so a run
        // returned 0, left the Use live, and the scan offered it again at every Check. It is retired
        // now: the Use commented with a marker, no menu bar added, the menu file untouched.
        {Published = True}
        Procedure CJMenu_EmptyUsedMenu_RetiredWithoutMenuBar
            String[] asCode asMn asBack
            String sDataPath sMn
            Boolean bOk bUseCommented bMark bMenuBar bEmpty
            Integer iEmitted iVoid i

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "_CJEmpty_.mn") to sMn
            Move "DFCreate_Menu Main_Menu"      to asMn[0]
            Move ""                             to asMn[1]
            Move "End_Menu // Main_Menu"        to asMn[2]
            Move ""                             to asMn[3]
            Move "Register_Object Client_Area"  to asMn[4]
            Get rfWriteEncodedFileFromStringArray (&asMn) sMn C_NewLine False to bOk
            Send Assert bOk
            Move "Object Main is a Panel"                                to asCode[0]
            Move "Use _CJEmpty_.mn //  Menu package."                    to asCode[1]
            Move "    Object oCommandBarSystem is a cCJCommandBarSystem" to asCode[2]
            Move "    End_Object"                                        to asCode[3]
            Move "    Object oClientArea is a ClientArea"                to asCode[4]
            Move "    End_Object"                                        to asCode[5]
            Move "End_Object"                                            to asCode[6]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Get pbCJEmptyMenu of ghoFuncLib to bEmpty
            Move (rfReadEncodedFileAsStringArray(sMn)) to asBack
            Move (rfDeleteFile(sMn)) to iVoid
            Send AssertIAreEqual 0 iEmitted
            Send Assert bEmpty
            Move False to bUseCommented
            Move False to bMark
            Move False to bMenuBar
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "Use _CJEmpty_.mn" and Left(Trim(asCode[i]), 2) = "//") ;
                    Move True to bUseCommented
                If (asCode[i] contains "is EMPTY") ;
                    Move True to bMark
                If (asCode[i] contains "cCJMenuBar") ;
                    Move True to bMenuBar
            Loop
            Send Assert bUseCommented
            Send Assert bMark
            Send Assert (bMenuBar = False)
            // one line added - the marker - and nothing emitted
            Send AssertIAreEqual 8 (SizeOfArray(asCode))
            // the menu file came back exactly as written
            Send AssertIAreEqual 5 (SizeOfArray(asBack))
            Send AssertSAreEqual asMn[4] asBack[4]
        End_Procedure

        // The same in the program itself: the block is commented where it stands, one marker above it,
        // and nothing else - no command bar system brought in, no packages added.
        {Published = True}
        Procedure CJMenu_EmptyOwnBlock_Retired
            String[] asCode
            String sDataPath
            Integer iEmitted i iCommented
            Boolean bSys bEmpty

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Use DfAllEnt.pkg"                           to asCode[0]
            Move "Object Main is a Panel"                     to asCode[1]
            Move "    DFCreate_Menu Main_Menu"                to asCode[2]
            Move "    End_Menu"                               to asCode[3]
            Move "    Object oClientArea is a ClientArea"     to asCode[4]
            Move "    End_Object"                             to asCode[5]
            Move "End_Object"                                 to asCode[6]
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Get pbCJEmptyMenu of ghoFuncLib to bEmpty
            Send AssertIAreEqual 0 iEmitted
            Send Assert bEmpty
            Send AssertIAreEqual 8 (SizeOfArray(asCode))
            Move False to bSys
            Move 0 to iCommented
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "cCJCommandBarSystem") ;
                    Move True to bSys
                If (Left(Trim(asCode[i]), 2) = "//") ;
                    Increment iCommented
            Loop
            Send Assert (bSys = False)
            // the marker and the two legacy lines
            Send AssertIAreEqual 3 iCommented
            Send AssertIAreEqual 1 (CountOfUse(Self, asCode, ".pkg"))
        End_Procedure

        // NOT empty: a block whose only content is an #include the converter cannot read also emits
        // nothing - and must never be retired as empty. The program is left exactly as it was, and the
        // reason is kept for the run notes.
        {Published = True}
        Procedure CJMenu_UnreadableFragmentOnly_NotRetired
            String[] asCode asOrig
            String sDataPath sDecline
            Integer iEmitted i
            Boolean bSame bEmpty

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Object Main is a Panel"                     to asCode[0]
            Move "    DFCreate_Menu Main_Menu"                to asCode[1]
            Move "        #include _CJNoSuchFragment_.inc"    to asCode[2]
            Move "    End_Menu"                               to asCode[3]
            Move "    Object oClientArea is a ClientArea"     to asCode[4]
            Move "    End_Object"                             to asCode[5]
            Move "End_Object"                                 to asCode[6]
            Move asCode to asOrig
            Get _CJConvertMenuInFile of ghoFuncLib (&asCode) sDataPath to iEmitted
            Get pbCJEmptyMenu of ghoFuncLib to bEmpty
            Get psCJDecline of ghoFuncLib to sDecline
            Send AssertIAreEqual 0 iEmitted
            Send Assert (bEmpty = False)
            Send Assert (sDecline <> "")
            Send AssertIAreEqual (SizeOfArray(asOrig)) (SizeOfArray(asCode))
            Move True to bSame
            For i from 0 to (SizeOfArray(asOrig) - 1)
                If (asCode[i] <> asOrig[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame
        End_Procedure

        // What counts as empty: the root and its close, blanks and comments - nothing else.
        {Published = True}
        Procedure CJMenu_MenuBlockIsEmpty_OnlyTheRootAndItsClose
            String[] asB asNone
            Boolean b

            Move "DFCreate_Menu Main_Menu"    to asB[0]
            Move ""                           to asB[1]
            Move "// a comment"               to asB[2]
            Move "End_Menu // Main_Menu"      to asB[3]
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asB) to b
            Send Assert b
            // an item is content
            Move 'On_Item "&About" Send Activate_About' to asB[2]
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asB) to b
            Send Assert (b = False)
            // a captioned DFCreate_Menu is a pulldown - content, even with nothing in it
            Move 'DFCreate_Menu "&Help" Help_Menu' to asB[2]
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asB) to b
            Send Assert (b = False)
            // an #include is content, read or not
            Move "#include File_PM.inc"       to asB[2]
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asB) to b
            Send Assert (b = False)
            // so is any other code line
            Move "Set Status_Help to 'Help'"  to asB[2]
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asB) to b
            Send Assert (b = False)
            // and no block at all is not an empty menu
            Get _CJMenuBlockIsEmpty of ghoFuncLib (&asNone) to b
            Send Assert (b = False)
        End_Procedure

        // A pulldown in a .pkg (2026-09-11): #included by a menu file a program uses, it reaches that
        // program as an .inc one does. A .pkg the program merely Uses does not - the converter never
        // follows a Use of a package, so the run must not claim it will.
        {Published = True}
        Procedure CJMenu_IncludersOfFragment_PackagePulldown
            String[] asProg asMn asPulled asUsed
            String sDataPath sProg sMn
            Boolean bOk
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "_CJPkProg_.src") to sProg
            Move (sDataPath + "_CJPkMenu_.mn")  to sMn
            Move "Object Main is a Panel"                     to asProg[0]
            Move "Use _CJPkMenu_.mn //  Menu package."        to asProg[1]
            Move "Use _CJPkUsed_.pkg"                         to asProg[2]
            Move "End_Object"                                 to asProg[3]
            Move "DFCreate_Menu Main_Menu"                    to asMn[0]
            Move "#include _CJPkPull_.pkg   // help pulldown" to asMn[1]
            Move "End_Menu"                                   to asMn[2]
            Get rfWriteEncodedFileFromStringArray (&asProg) sProg C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asMn)   sMn   C_NewLine False to bOk
            Get _CJIncludersOfFragment of ghoFuncLib (sDataPath + "_CJPkPull_.pkg") to asPulled
            Get _CJIncludersOfFragment of ghoFuncLib (sDataPath + "_CJPkUsed_.pkg") to asUsed
            Move (rfDeleteFile(sProg)) to iVoid
            Move (rfDeleteFile(sMn))   to iVoid
            Send AssertIAreEqual 1 (SizeOfArray(asPulled))
            If (SizeOfArray(asPulled) > 0) ;
                Send AssertSAreEqual (Lowercase(sProg)) (Lowercase(asPulled[0]))
            Send AssertIAreEqual 0 (SizeOfArray(asUsed))
        End_Procedure

        // The run's MENU fragments are found by content (2026-09-11): a .mn a program uses resolves to
        // it; a .pkg holding a pulldown nobody pulls in is listed as a menu fragment with no program
        // (the run notes then say so); a .pkg with no menu is not a fragment at all; a .src is the
        // program itself and is never listed here.
        {Published = True}
        Procedure CJMenu_FragmentProgramMap_ByContent
            String[] asProg asMn asLoose asPlain asFiles asMenuFrags asMap
            String sDataPath sProg sMn sLoose sPlain
            Boolean bOk
            Integer iVoid

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move (sDataPath + "_CJFmProg_.src")  to sProg
            Move (sDataPath + "_CJFmMenu_.mn")   to sMn
            Move (sDataPath + "_CJFmLoose_.pkg") to sLoose
            Move (sDataPath + "_CJFmPlain_.pkg") to sPlain
            Move "Object Main is a Panel"               to asProg[0]
            Move "Use _CJFmMenu_.mn //  Menu package."  to asProg[1]
            Move "End_Object"                           to asProg[2]
            Move "DFCreate_Menu Main_Menu"              to asMn[0]
            Move 'On_Item "&About" Send Activate_About' to asMn[1]
            Move "End_Menu"                             to asMn[2]
            Move 'DFCreate_Menu "&Help" Help_Menu'      to asLoose[0]
            Move 'On_Item "&About" Send Activate_About' to asLoose[1]
            Move "End_Pull_Down"                        to asLoose[2]
            Move "Procedure DoNothing"                  to asPlain[0]
            Move "End_Procedure"                        to asPlain[1]
            Get rfWriteEncodedFileFromStringArray (&asProg)  sProg  C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asMn)    sMn    C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asLoose) sLoose C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asPlain) sPlain C_NewLine False to bOk
            Move sProg  to asFiles[0]
            Move sMn    to asFiles[1]
            Move sLoose to asFiles[2]
            Move sPlain to asFiles[3]
            Get _CJFragmentProgramMap of ghoFuncLib (&asFiles) (&asMenuFrags) to asMap
            Move (rfDeleteFile(sProg))  to iVoid
            Move (rfDeleteFile(sMn))    to iVoid
            Move (rfDeleteFile(sLoose)) to iVoid
            Move (rfDeleteFile(sPlain)) to iVoid
            Send AssertIAreEqual 2 (SizeOfArray(asMenuFrags))
            Send Assert (SearchArray(Lowercase(sMn), asMenuFrags) <> -1)
            Send Assert (SearchArray(Lowercase(sLoose), asMenuFrags) <> -1)
            // one row: the menu file, to the program that uses it
            Send AssertIAreEqual 1 (SizeOfArray(asMap))
            If (SizeOfArray(asMap) > 0) ;
                Send AssertSAreEqual (Lowercase("_CJFmMenu_.mn|" + sProg)) (Lowercase(asMap[0]))
        End_Procedure

        // The packages a converted menu needs compile in every case: after the #ENDIF, not after the Use inside it.
        {Published = True}
        Procedure CJMenu_EnsureUsesStaysOutOfAConditional
            String[] asCode asNeed
            Integer iN

            Move "Use DfAllEnt.pkg"                                  to asCode[0]
            Move (Character(35) + "IFDEF SOME_FLAG")                 to asCode[1]
            Move "Use Extra.pkg"                                     to asCode[2]
            Move (Character(35) + "ENDIF")                           to asCode[3]
            Move "Object Main is a Panel"                            to asCode[4]
            Move "End_Object"                                        to asCode[5]
            Move "cCJCommandBarSystem.pkg"                           to asNeed[0]
            Get _CJEnsureUses of ghoFuncLib (&asCode) (&asNeed) "why" to iN
            Send AssertIAreEqual 1 iN
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[3]
            Send Assert (Pos("Use cCJCommandBarSystem.pkg", asCode[4]) = 1) asCode[4]
        End_Procedure

        /* A MENU LEFT AS IT IS STILL COMPILES (2026-11-01): DataFlex 26 compiles DFCreate_Menu only with Dfmenu.pkg and
           its ViewPopupMenu / DEOPopupMenu only with Dfdeomnu.pkg, which Uses Dfmenu.pkg - both still shipped, obsolete.
           A program whose menu the converter leaves - here for a procedure of its own in the pulldown - gets
           'Use Dfdeomnu.pkg' after its last Use before Main, once; the menu itself is untouched. */
        {Published = True}
        Procedure CJMenu_LeftMenuGetsTheLegacyMenuPackage
            String[] asProg asOut
            String sRoot sFile
            Integer iItems1 iItems2 i iUses iMenuLine
            Boolean bOk bKept1 bKept2
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_KeepMenu\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (sRoot + "_CJKeep_.src") to sFile
            Move "Use DfAllEnt.pkg"                                   to asProg[0]
            Move "Object Main is a Panel"                             to asProg[1]
            Move "    DFCreate_Menu Main_Menu"                        to asProg[2]
            Move '        DFCreate_Menu "&File" File_Menu is a PopupMenu' to asProg[3]
            Move '        On_Item "&Print" Send DoPrint'              to asProg[4]
            Move "        Procedure DoPrint"                          to asProg[5]
            Move "        End_Procedure"                              to asProg[6]
            Move "        End_Pull_Down"                              to asProg[7]
            Move "    End_Menu"                                       to asProg[8]
            Move "    Object oClientArea is a ClientArea"             to asProg[9]
            Move "    End_Object"                                     to asProg[10]
            Move "End_Object"                                         to asProg[11]
            Get rfWriteEncodedFileFromStringArray (&asProg) sFile C_NewLine False to bOk
            Get _CJConvertProgramFile of ghoFuncLib sFile False to iItems1
            Get pbCJLegacyMenuKept of ghoFuncLib to bKept1
            Get _CJConvertProgramFile of ghoFuncLib sFile False to iItems2
            Get pbCJLegacyMenuKept of ghoFuncLib to bKept2
            Move (rfReadEncodedFileAsStringArray(sFile)) to asOut
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move 0 to iUses
            Move -1 to iMenuLine
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (Lowercase(Trim(asOut[i])) contains "use dfdeomnu.pkg") ;
                    Increment iUses
                If (Trim(asOut[i]) = "DFCreate_Menu Main_Menu") ;
                    Move i to iMenuLine
            Loop
            Send AssertIAreEqual 0 iItems1
            Send Assert bKept1 "the first run adds the Use"
            Send AssertFalse bKept2
            Send AssertIAreEqual 1 iUses
            Send Assert (Lowercase(Trim(asOut[1])) contains "use dfdeomnu.pkg") ("after the last Use: " + asOut[1])
            Send Assert (iMenuLine > 0) "the legacy menu itself stays"
        End_Procedure

        /* A FILE A PROGRAM PULLS IN IS LOOKED FOR AS DATAFLEX LOOKS (2026-11-01): beside the program, then in the
           workspace's source folders - a workspace with AppSrcPath '.\AppSrc;.\Pkg' keeps its menu files in Pkg\, and
           'Use <menu>.mn' found nothing beside the program. On folders in the Windows TEMP folder, named as the
           workspace's source roots: the menu file in Pkg\ is found from AppSrc\; a name no folder has comes back "". */
        {Published = True}
        Procedure CJMenu_FindInWorkspaceLooksInTheSourceFolders
            String[] asRoots asMn asNone
            String sRoot sPath sOther
            Boolean bOk
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_FindInWs\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "AppSrc\"), False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Pkg\"), False)) to bOk
            Move "DFCreate_Menu Main_Menu" to asMn[0]
            Move "End_Menu"                to asMn[1]
            Get rfWriteEncodedFileFromStringArray (&asMn) (sRoot + "Pkg\_CJFiwMenu_.mn") C_NewLine False to bOk
            Move (sRoot + "AppSrc\") to asRoots[0]
            Move (sRoot + "Pkg\")    to asRoots[1]
            Set pasCJSourceRootsOverride of ghoFuncLib to asRoots
            Get _CJFindInWorkspace of ghoFuncLib "_CJFiwMenu_.mn" (sRoot + "AppSrc\") to sPath
            Get _CJFindInWorkspace of ghoFuncLib "_NoSuchMenuFile_.mn" (sRoot + "AppSrc\") to sOther
            Set pasCJSourceRootsOverride of ghoFuncLib to asNone
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Send AssertSAreEqual (Lowercase(sRoot + "Pkg\_CJFiwMenu_.mn")) (Lowercase(sPath))
            Send AssertSAreEqual "" sOther
        End_Procedure

        /* A MENU FILE IN ANOTHER FOLDER THAN ITS PROGRAM (2026-11-01): one workspace keeps its menu files in Pkg\ and its
           programs in AppSrc\, and the map of the menu file's folder alone held no program - all three were skipped as
           pulled in by nobody. The menu file, and the pulldown it #includes, reach the program in the other folder. */
        {Published = True}
        Procedure CJMenu_FragmentInAnotherFolderReachesItsProgram
            String[] asProg asMn asInc asFiles asMenuFrags asMap
            String sRoot sProg sMn sInc
            Boolean bOk
            Integer i iProg

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_MenuFolders\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Prog\"), False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Pkg\"), False)) to bOk
            Move (sRoot + "Prog\_CJAfApp_.src")  to sProg
            Move (sRoot + "Pkg\_CJAfMenu_.mn")   to sMn
            Move (sRoot + "Pkg\_CJAfHelp_pm.inc") to sInc
            Move "Object Main is a Panel"                    to asProg[0]
            Move "    Use _CJAfMenu_.mn //  Menu package."    to asProg[1]
            Move "End_Object"                                to asProg[2]
            Move "DFCreate_Menu Main_Menu"                   to asMn[0]
            Move "  #Include _CJAfHelp_pm.inc"               to asMn[1]
            Move "End_Menu"                                  to asMn[2]
            Move 'DFCreate_Menu "&Help" Help_Menu'           to asInc[0]
            Move 'On_Item "&About" Send Activate_About'      to asInc[1]
            Move "End_Pull_Down"                             to asInc[2]
            Get rfWriteEncodedFileFromStringArray (&asProg) sProg C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asMn)   sMn   C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asInc)  sInc  C_NewLine False to bOk
            Move sProg to asFiles[0]
            Move sMn   to asFiles[1]
            Move sInc  to asFiles[2]
            Get _CJFragmentProgramMap of ghoFuncLib (&asFiles) (&asMenuFrags) to asMap
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move 0 to iProg
            For i from 0 to (SizeOfArray(asMap) - 1)
                If (Lowercase(asMap[i]) = Lowercase("_CJAfMenu_.mn|" + sProg) or Lowercase(asMap[i]) = Lowercase("_CJAfHelp_pm.inc|" + sProg)) ;
                    Increment iProg
            Loop
            Send AssertIAreEqual 2 (SizeOfArray(asMenuFrags))
            Send AssertIAreEqual 2 iProg
        End_Procedure

    End_Object
