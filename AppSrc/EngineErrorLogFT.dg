Use Windows.pkg
Use seq_chnl.pkg
Use RefactorConstants.h.pkg       // the shared constants
Use cFTDbModalPanel.pkg
Use cFTDbCJGrid.pkg
Use cRDCDbCJGridColumn.pkg
Use cRDCButtonDPI.pkg
Use cFTGridHost.pkg               // FT: the button bar - one host on a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg    // FT: cFTWebButton - the bar's buttons

Use cStatLogDataDictionary.dd
Use cDbTextEdit.pkg
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

Object oEngineErrorLog_dg is a cFTDbModalPanel
    Set Label to "Refactor Engine Error Log - Errors that occured while Refactoring Code"
    Set Size to 247 574
    Set piMinSize to 89 211
    Set Location to 2 2
    Set Icon to "ErrorLog.ico"

    Object oStatLog_DD is a cStatLogDataDictionary
    End_Object

    Set Main_DD to oStatLog_DD
    Set Server to oStatLog_DD

    Object oInternalErrors_grd is a cFTDbCJGrid
        Set Size to 117 556
        Set Location to 12 10
        Set pbAllowEdit to True
        Set pbAutoAppend to False
        Set pbAllowDeleteRow to True  
        Set pbDbShowRemoveItemMenuItem to True 
        Set phoCheckbox_Col to 0 
        Set phoData_Col to 0
        Set pbDescendingIndexInUse to True

        Object oStatLog_FunctionName is a cRDCDbCJGridColumn
            Entry_Item StatLog.FunctionName
            Set piWidth to 204
            Set psCaption to "Function Name"
        End_Object

        Object oStatLog_Description is a cRDCDbCJGridColumn
            Entry_Item StatLog.Description
            Set piWidth to 552
            Set psCaption to "Description - (Press Ctrl+C to copy an iErrLine value)"
            Set psToolTip to "Top Tip: If you see a description text that has a 'iErrLine = nnnnn', it is possible, in debug mode in the Studio, to press Alt+G, enter value and go to the offending source line."
        End_Object

        Object oStatLog_Date is a cRDCDbCJGridColumn
            Entry_Item StatLog.Date
            Set piWidth to 83
            Set psCaption to "Date"  
            Set pbVisible to False
        End_Object

        Object oStatLog_Time is a cRDCDbCJGridColumn
            Entry_Item StatLog.Time
            Set piWidth to 171
            Set psCaption to "Time"
        End_Object
        
        Procedure End_Construct_Object       
            Forward Send End_Construct_Object
            Set phoContextMenu to oDEOEditContextMenu // DAW standard context menu 
        End_Procedure
        
        Procedure Copy
            Integer iPos iLen
            Boolean bOk
            String sErrNum
            
            Get Field_Current_Value of oStatLog_DD Field StatLog.Description to sErrNum
            Move (Pos("Err Line:", sErrNum)) to iPos
            If (iPos = 0) Begin
                Procedure_Return
            End

            Move (Length("Err Line:")) to iLen
            Move (Trim(Mid(sErrNum, Length(sErrNum), (iPos + iLen)))) to sErrNum
            Move (Pos(" ", sErrNum)) to iPos
            If (iPos <> 0) Begin
                Move (Trim(Left(sErrNum, iPos))) to sErrNum
            End
            Get rfSetClipboardText sErrNum to bOk
            If (bOk = False) ;
                Procedure_Return
            
            Set StatusText of (Statusbar_Id(Self)) to ("Err Line:" * String(sErrNum) * "value copied to Windows clipboard.Press Alt+G in the Studio, while in debug mode, paste the value, to find the source line where the error occured.")
        End_Procedure 
        
        Procedure DoSetCheckboxFooterText  
            Integer iErrors 
            
            Get_Attribute DF_FILE_RECORDS_USED of StatLog.File_Number to iErrors
            Set psFooterText of oStatLog_FunctionName to ("Total number of errors:" * String(iErrors))
        End_Procedure
          
        Procedure Request_Clear
        End_Procedure
    
    
        On_Key Key_Delete       Send Request_Delete
        On_Key Key_Shift+Key_F2 Send Request_Delete  
        On_Key Key_Ctrl+Key_C   Send Copy
    End_Object

    Object oDbTextEdit1 is a cDbTextEdit
        Entry_Item StatLog.Stack
        Set Location to 130 10
        Set Size to 87 556
        Set Enabled_State to False
        Set peAnchors to anBottomLeft
    End_Object

    /* THE BUTTON BAR: one grid host of 8 px columns and two framework buttons (cFTWebButton, RDCFlexTron), as in
       ShowOtherLogFilesFT.dg. A button's work runs in OnButtonClick, after the web click has returned (the
       library's click relay), so the Yes/No box and Close_Panel can run there - no timer of this dialog's own.
       The plain host, not the data-aware one: the bar holds no field bound to the StatLog DD. Column 0 takes
       the rest of the width, so the buttons keep to the right edge; each span fits its caption (Delete All
       Records ~117 px, Close ~71 px, measured 2026-09-30). The host is 160 units wide - about 240 px at 1.5 px a
       unit, for the buttons' 216 - and starts right of the tip text, which the old 240-unit bar covered. Until
       then this bar was HTML chips (BarButtonHtml) with a click-id OnClick and a 1 ms defer timer. */
    Object oWebBottomBar is a cFTGridHost
        Set Location to 220 410
        Set Size to 20 160
        Set peAnchors to anBottomRight
        Set piColumnCount to 28         // column 0, then Delete's 16 and Close's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oDeleteAllBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 16
            Set psCaption to "Delete All Records"
            Set psToolTip to "Delete ALL logged error records."

            Procedure OnButtonClick
                Send DoDeleteAll of (oEngineErrorLog_dg(Self))
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piColumnIndex to 17
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close this dialog."

            Procedure OnButtonClick
                Send DoClose of (oEngineErrorLog_dg(Self))
            End_Procedure
        End_Object
    End_Object

    // The Delete-All action (was oZeroFile_btn.OnClick), run from the Delete button's OnButtonClick, after the
    // web click. Operates on the StatLog table directly + a grid Send (MoveToFirstRow) - no by-handle grid GET, so
    // the err-98 wall does not apply. The wipe loop is synchronous (no pump), so Close can't race it.
    Procedure DoDeleteAll
        Integer eResponse

        Get FTYesNoBox "Are you sure you want to delete all logged error messages?" to eResponse
        If (eResponse <> MBR_Yes) Begin
            Procedure_Return
        End
        Send Cursor_Wait of Cursor_Control
        Open StatLog
        Clear StatLog
        Find gt StatLog by Index.1
        While (Found)
            Delete StatLog
            Find gt StatLog by Index.1
        Loop
        Send Request_Assign of oStatLog_DD StatLog.File_Number
        Send Cursor_Ready of Cursor_Control
        Send MoveToFirstRow of oInternalErrors_grd
    End_Procedure

    // The Close action (was oClose_btn.OnClick), from the Close button's OnButtonClick and from Alt+C. Both
    // run inside the modal's own message pump, so Close_Panel cleanly ends the modal loop.
    Procedure DoClose
        Send Close_Panel
    End_Procedure

    Object oDebugInfo_txt is a TextBox
        Set Auto_Size_State to False
        Set Size to 17 397
        Set Location to 227 12
        Set Label to "Top Tip: If you see a description text that has a 'Err Line: nnnnn', You can - whíle the Studio is in debug mode, to press Alt+G, enter the iErrLine value to go to that source line. (Ctrl+C to copy iErrLine value)"
        Set Justification_Mode to JMode_Left
        Set peAnchors to anBottomLeftRight
    End_Object

    On_Key Key_Alt+Key_C Send DoClose      // was KeyAction of oClose_btn (now the web Close button)
End_Object
