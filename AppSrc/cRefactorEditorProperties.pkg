    End_Function

    Procedure Set piLineNumbering Integer iValue
        Send SetIniValue "PILINENUMBERING" 0 0 (String(iValue))
    End_Procedure
    Function piLineNumbering Returns Integer
        String sValue
        Get IniValueEx "PILINENUMBERING" 0 0 to sValue
        If (Trim(sValue) = "") ;
            Function_Return False
        Function_Return (Integer(sValue))
    End_Function

