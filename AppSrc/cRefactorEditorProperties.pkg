//****************************************************************************
// $Module type: Class Package
// $Module name: cRefactorEditorProperties
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-27
//
// Description : The editor settings CONTRACT, written out.
//
//               WHAT IT REPLACES. cEditorProperties.pkg declared ~160 properties through INI_Property,
//               a compile-time macro in cIniManager.pkg that emitted a Set/Get pair per property plus
//               the tag registration the store indexes by. Clever, and completely opaque: you could
//               not read the class and see what a property did, only that one existed, and the macro
//               carried a stack-based compiler-variable protocol (#PUSH / #SPOP / #SET) to keep the
//               declarations in step with each other.
//
//               DFRefactor uses 35 of those ~160. They are written out below by hand, one visible
//               Set/Get pair each - longer on the page and shorter to understand. The 125 members that
//               were only ever The Hammer's (skins, code tips, DBExplorer paths, VCS integration,
//               custom menu utilities, recent-file lists) simply are not here.
//
//               WHAT THE ACCESSORS DO. Each reads or writes one tag in cRefactorSettingsStore. The tag
//               name is the property name UPPERCASED, at row 0 sub 0 for a scalar. That mapping is not
//               decorative: it is what makes an existing ScintillaEdit.json readable, and it is pinned
//               by tests in oEditorSettings-Tests.pkg along with every sub-value INDEX below.
//
//               DO NOT RENUMBER THE SUB-VALUES. Their order is the order the old macro assigned by
//               declaration position. A saved language definition read against a different numbering
//               hands back keywords where operators are expected - and nothing fails loudly; the
//               editor just quietly stops recognising DataFlex.
//
//               DEFAULTS are carried over exactly, including the three that default TRUE (matching
//               braces, indent guides, select-whole-line). A tag that was never written reads as ""
//               from the store, so each getter supplies its own default rather than expecting the
//               store to know one.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cRefactorSettingsStore.pkg

/* The language DFRefactor edits. It was the literal "VDF" in three places - the editor's
   LoadEntries and the settings dialog's load and save - and "VDF" is the pre-2004 name.
   Nils, 2026-07-28: call it DF.

   This is a stored NAME, not just a caption: it is psLanguages row 0's own value and the
   psLanguage setting, and the editor does FindLanguage on it. Changing the literal alone
   would make that lookup miss, the keyword arrays come back empty, and ghoFuncLib quietly
   stop recognising DataFlex - so cRefactorEditorSettings migrates the stored name on
   load. See MigrateLanguageName there. */
#IFNDEF CS_EditorLanguage
Define CS_EditorLanguage     for "DF"
Define CS_EditorLanguageWas  for "VDF"     // migrated from, on first load
#ENDIF

/* The handle every consumer reads the settings through. It used to be declared in the
   library's oEditorProperties.pkg, which is why the editor chain had to Use that file -
   and therefore dragged in cEditorProperties, cIniManager, cSciCommandHotKeySupport and
   the rest of the settings stack. Declaring it beside the class that defines the
   properties is both its natural home and what lets those Use lines go. */
#IFNDEF ghoEditorProperties
Global_Variable Integer ghoEditorProperties
Move 0 to ghoEditorProperties
#ENDIF

Class cRefactorEditorProperties is a cRefactorSettingsStore

    Procedure Construct_Object
        Forward Send Construct_Object
        Send RegisterSettingTags
    End_Procedure

    // Every tag this class owns, and whether it holds one row or many. Registering up
    // front means IniValueCount answers 0 for "never written" rather than "no such tag".
    Procedure RegisterSettingTags
        Send AddTag "PSCOLORS" False
        Send AddTag "PSCOLORSCHEMA" False
        Send AddTag "PSFONTSTYLES" False
        Send AddTag "PSFONTFACE" False
        Send AddTag "PSEDITORHOTKEYS" False
        Send AddTag "PSLANGUAGE" False
        Send AddTag "PILINENUMBERING" False
        Send AddTag "PBLEFTMARGIN" False
        Send AddTag "PIAUTOINDENTMODE" False
        Send AddTag "PITABSIZE" False
        Send AddTag "PBTABEXPAND" False
        Send AddTag "PBNORMALIZECASE" False
        Send AddTag "PBTRIMEOLONSAVE" False
        Send AddTag "PBSHOWMATCHINGBRACES" False
        Send AddTag "PBSHOWINDENTGUIDES" False
        Send AddTag "PBSELECTWHOLELINE" False
        Send AddTag "PBSCROLLBARH" False
        Send AddTag "PBSCROLLBARV" False
        Send AddTag "PBWHOLEWORD" False
        Send AddTag "PBCASESENSITIVE" False
        Send AddTag "PSLANGUAGES"    True
        Send AddTag "PSCOLORSCHEMAS" True
    End_Procedure

    // ==================================================================================
    // Scalars. Tag = the property name uppercased, row 0, sub 0.
    // ==================================================================================

    // the current scheme's colours - readable form since 2026-07-27
    Procedure Set psColors String sValue
        Send SetIniValue "PSCOLORS" 0 0 sValue
    End_Procedure
    Function psColors Returns String
        Function_Return (IniValueEx(Self, "PSCOLORS", 0, 0))
    End_Function

    // the current scheme's NAME
    Procedure Set psColorSchema String sValue
        Send SetIniValue "PSCOLORSCHEMA" 0 0 sValue
    End_Procedure
    Function psColorSchema Returns String
        Function_Return (IniValueEx(Self, "PSCOLORSCHEMA", 0, 0))
    End_Function

    // legacy packed font flags; blank once a scheme is saved readably
    Procedure Set psFontStyles String sValue
        Send SetIniValue "PSFONTSTYLES" 0 0 sValue
    End_Procedure
    Function psFontStyles Returns String
        Function_Return (IniValueEx(Self, "PSFONTSTYLES", 0, 0))
    End_Function

    // e.g. "11pt; 0; Consolas"
    Procedure Set psFontFace String sValue
