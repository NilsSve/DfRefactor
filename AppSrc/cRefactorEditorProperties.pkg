    // ==================================================================================
    // psLanguages - multi-row.
    // One row per language definition. szKeywords and the two scope lists are what
    // LoadEntries feeds ghoFuncLib's keyword arrays from - handle with care.
    // ==================================================================================

    Procedure Set psLanguages Integer iRow String sValue
        Send SetIniValue "PSLANGUAGES" iRow 0 sValue
    End_Procedure
    Function psLanguages Integer iRow Returns String
        Function_Return (IniValueEx(Self, "PSLANGUAGES", iRow, 0))
    End_Function
    Function psLanguages.Count Returns Integer
        Function_Return (IniValueCount(Self, "PSLANGUAGES"))
    End_Function
    Procedure psLanguages.DeleteItem Integer iRow
        Send DeleteItem "PSLANGUAGES" iRow
    End_Procedure
    Procedure psLanguages.DeleteAllItems
        Send DeleteAllItems "PSLANGUAGES"
    End_Procedure

