    // ==================================================================================
    // Lookups, carried over EXACTLY - including the disagreement between the first two.
    // FindColorSchema is case-SENSITIVE (it compared with "=", and DataFlex "=" on
    // strings is case-sensitive); DeleteColorSchema is case-INSENSITIVE (it uppercases
    // both sides). Measured 2026-07-27, and pinned by tests. Changing either is a
    // behaviour change that wants deciding on purpose, not slipped in while porting.
    // ==================================================================================

    Function FindColorSchema String sName Returns Integer
        Integer iC iCount
        Move (Trim(sName)) to sName
        Get psColorSchemas.Count to iCount
        For iC from 0 to (iCount - 1)
            If (psColorSchemas(Self, iC) = sName) ;
                Function_Return iC
        Loop
        Function_Return -1
    End_Function

    Procedure DeleteColorSchema String sName
        Integer iC iCount
        Move (Uppercase(Trim(sName))) to sName
        Get psColorSchemas.Count to iCount
        For iC from 0 to (iCount - 1)
            If (Uppercase(psColorSchemas(Self, iC)) = sName) Begin
                Send psColorSchemas.DeleteItem iC
                Procedure_Return
            End
        Loop
    End_Procedure

    Function FindLanguage String sName Returns Integer
        Integer iC iCount
        Move (Uppercase(Trim(sName))) to sName
        Get psLanguages.Count to iCount
        For iC from 0 to (iCount - 1)
            If (Uppercase(psLanguages(Self, iC)) = sName) ;
                Function_Return iC
        Loop
        Function_Return -1
    End_Function

    Procedure DeleteLanguage String sName
        Integer iAt
        Get FindLanguage sName to iAt
        If (iAt >= 0) ;
            Send psLanguages.DeleteItem iAt
    End_Procedure

    /* Back to nothing-has-been-read. Sent before a load so a re-read replaces the store
       rather than merging into it - callers (and the JSON round-trip test) rely on the
       name, which is why it keeps the old one.

       The tag REGISTRATION is put straight back, and that matters: registration is what
       distinguishes "this setting has never been written" (count 0, getter supplies its
       declared default) from "there is no such setting". Clearing without re-registering
       would leave the class unable to answer for its own members until something wrote
       to them. */
    Procedure DoInit
        Send ClearStore
        Send RegisterSettingTags
    End_Procedure

    /* ==================================================================================
       Load and save.

       LoadIni and SaveIni keep their names because every call site in the program uses
       them ("Send SaveIni of ghoEditorProperties"), and they are declared HERE rather
       than on the JSON subclass so those call sites - which compile earlier - can see
       them. The two Store procedures are the seam the subclass fills in: empty here,
       because this class has an opinion about what a setting IS and none about where it
       is kept.

       WHAT THE LIBRARY'S LoadIni ALSO DID, and why none of it is here:
         * RegisterAllLanguages and RegisterLanguage - the latter's entire body was the
           comment "codemax only!". Both are gone: the settings dialog was the last
           caller and it no longer sends it.
         * DoChangeCurrentFolder psStartUpPath - changed the PROCESS's current directory
           as a side effect of reading settings. DFRefactor never sets psStartUpPath so
           it was already a no-op, and it is the kind of side effect a settings load has
           no business having.
         * Editor_LoadAllMacros / Editor_SaveAllMacros - the editor macro system.
           DFRefactor has no macros.
         * SetEditorHotKeys - this one is real and is NOT dropped: it lives on the subclass,
           which is compiled after the hotkey support and can call it without dragging
           that package in here.
       ================================================================================== */

    Procedure LoadIni
        Send ReadSettingsStore
    End_Procedure

    Procedure SaveIni
        Send WriteSettingsStore
    End_Procedure

    // The persistence seam - overridden by cRefactorEditorSettings, which reads and
    // writes Data\ScintillaEdit.json.
    Procedure ReadSettingsStore
    End_Procedure

    Procedure WriteSettingsStore
    End_Procedure


End_Class