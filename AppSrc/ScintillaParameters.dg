Use cImageList32.pkg
Use dfSpnFrm.pkg
Use dfLine.pkg
Use dfTreeVw.pkg
Use Colr_Dlg.pkg
Use cTextEdit.pkg
Use Font_dlg.pkg

Use cFTModalPanel.pkg
Use cRefactorEditorSettings.pkg     // the settings contract this dialog edits
Use RefactorLineSplit.pkg           // RefactorSplitLine - replaces the library's
                                    // Array-derived cLineParser
Use cRefactorHotKeys.pkg            // the Keyboard page: oSciCommandHotKeys,
                                    // tSciCommandHotKey, tShortCut, KeysToString.
                                    // Arrived transitively through
                                    // oEditorProperties before; named explicitly now.
Use ScintillaSettingsControls.pkg
// THColorer.pkg used to be Used here. It is gone from DFRefactor entirely: this was its
// last entry point, and with the preview rebuilt nothing was left of it but three theme
// NAME constants (TH_DefSchema_White_Str and friends) that cEditorColourScheme already
// declares as CS_ThemeWhite and friends - the same strings, twice.
Use cEditorColourScheme.pkg         // where the built-in themes are declared
Use cSchemePreview.pkg              // the preview: a real Scintilla control, same renderer
                                    // as the editor
Use cSCWsGrid.pkg
Use RefactorConstants.h.pkg
Use cRDCHeaderGroup.pkg
Use cRDCButtonDPI.pkg

Struct tFontSpecs
    String sFontName
    Integer iSize
    Integer iCharSet
End_Struct

Function ScintillaFontAsStruct Global String sFace Returns tFontSpecs
    Integer iSize iCharSet
    String sFont sFontSz sCharSet
    tFontSpecs FontSpecs

    If (sFace = "") Begin
        Move "11pt; 0; Courier New"             to sFace
    End
    Move (Left(sFace, Pos(';', sFace)))         to sFontSz
    Move (Trim(Replace(sFontSz, sFace, "")))    to sFace
    Move (Replaces(' ', sFontSz, ""))           to sFontSz
    Move (Left(sFontSz, Length(sFontSz)-3))     to FontSpecs.iSize
    Move (Left(sFace, Pos(';', sFace)))         to sCharSet
    Move (Trim(Replace(sCharSet, sFace, "")))   to FontSpecs.sFontName
    Move (Left(sCharSet, Length(sCharSet)-1))   to FontSpecs.iCharSet

    Function_Return FontSpecs
End_Function

Function ScintillaEditorFontFormat Global tFontSpecs FontSpecs Returns String
    Function_Return (String(FontSpecs.iSize) + "pt;" * String(FontSpecs.iCharSet) + ";" * FontSpecs.sFontName)
End_Function

Function ScintillaReadableFontFormat Global String sFace Returns String
    tFontSpecs FontSpecs
    Get ScintillaFontAsStruct sFace to FontSpecs
    Function_Return (FontSpecs.sFontName + "," * String(FontSpecs.iSize) + "pt")
End_Function

Object oScintillaParameters_dg is a cFTModalPanel
    Set Size to 258 447
    Set Label to "Editor Settings"
    Set piMinSize to 238 439
    Set Location to 2 2
    Set Icon to "EditorSettings.ico"
    // Its own colours, not the FT panel's: a colour box shows the chosen colour in its Color, which the
    // panel's colouring of its children would paint over (cFTModalPanel's FTColorChildren).
    Set pbFTColorChildren to False

    // The built-in themes, declared readably in cEditorColourScheme.pkg. This dialog asks
    // it what the built-ins are and what each one looks like; nothing here holds a theme.
    Object oColorSchemeSource is a cEditorColourScheme
    End_Object

    /* The scheme being EDITED - the Colors page's working copy, loaded on Popup and
       written back by SaveEntries. Every control on that page reads and writes this
       object and then asks the preview to repaint from it, which is what makes an
       unsaved change visible.

       It replaces gtColorer[], the global array of structs the page used to edit in
       place. That array was shared with the editor, so "the Colors page" and "what is
       on screen" were the same storage and a cancelled dialog had already changed the
       editor. A working copy cannot do that. */
    Object oEditingScheme is a cEditorColourScheme
    End_Object

    /* ---- Color-schema resolution (Nils 2026-07-27) --------------------------------------
       ONE resolver, CUSTOM FIRST. A user-saved schema may carry the same name as a shipped
       default ("Lucas" is both a built-in AND a custom row saved years ago), and the old
       OnChange resolved built-ins first: selecting "Lucas" applied the shipped palette
       (background 025,025,025 - near black) over the custom lime one the workspace had
       lived with for years - "that changed the Lucas theme to be black". The custom row
       itself was never touched (verified byte-identical against the frozen ini); only the
       APPLIED colors were wrong. The user's own definition outranks the shipped default.

       Returns True when the name resolved; sSchema/sFontStyles carry the palette. Built-in
       constants may pack colors and font styles into one comma-joined string - split here,
       once, instead of at every caller. */
    Function ResolveColorSchema String sName String ByRef sSchema String ByRef sFontStyles Returns Boolean
        Integer iC iPos

        Get FindColorSchema of ghoEditorProperties sName to iC
        If (iC >= 0) Begin
            Get psColorSchemas.psSchemaColors     of ghoEditorProperties Item iC to sSchema
            Get psColorSchemas.psSchemaFontStyles of ghoEditorProperties Item iC to sFontStyles
            Function_Return True
        End
        // Built-ins come from cEditorColourScheme, which is where they are declared -
        // readably, one line per element - rather than from packed string constants.
        // The packed pair it hands back is a transitional adapter: the rest of this
        // dialog and the settings store still speak that format.
        Move "" to sSchema
        If (IsBuiltIn(oColorSchemeSource(Self), sName) = False) ;
            Function_Return False
        Send LoadBuiltIn of oColorSchemeSource sName
        Get LegacyPackedColors     of oColorSchemeSource to sSchema
        Get LegacyPackedFontStyles of oColorSchemeSource to sFontStyles
        Function_Return True
    End_Function

    /* Load a named scheme into a scheme OBJECT - the same custom-first rule as
       ResolveColorSchema, but landing in the object the page edits rather than in a pair
       of strings.

       An UNSHADOWED built-in is loaded from its DECLARATION rather than through
       ResolveColorSchema, which hands back the packed pair. The declaration is the
       source of truth and the packed pair is a lossy view of it: 42 colour slots and 17
       font-style slots, with nowhere to put a selection text colour or a selection
       alpha. None of the shipped built-ins sets either today - they all leave the
       selection to be derived - so nothing is lost right now. The point is that the
       first one to set it would lose it silently, and there is no reason to send a
       theme out through a narrower format and back when it is right there in code.

       A custom has nothing else to be read from, so it does take that route.
       LoadFromSettings sniffs, so a schema saved by an older build still reads. */
    Function LoadSchemaInto Handle hoScheme String sName Returns Boolean
        Boolean bFound
        Integer iC
        String  sColors sFontStyles

        Get FindColorSchema of ghoEditorProperties sName to iC
        If (iC < 0 and IsBuiltIn(hoScheme, sName)) Begin
            Send LoadBuiltIn of hoScheme sName
            Function_Return True
        End
        Get ResolveColorSchema sName (&sColors) (&sFontStyles) to bFound
        If (bFound = False) ;
            Function_Return False
        Send LoadFromSettings of hoScheme sName sColors sFontStyles
        Function_Return True
    End_Function

    /* The Color Theme combo's list: built-ins first (skipping any SHADOWED by a custom of
       the same name - matching the resolver, so the one visible "Lucas" IS the custom one),
       then the customs, themselves deduplicated. The old fill appended both lists blindly,
       which is where the two "Lucas" entries came from. Pure list-builder: testable. */
    Function SchemaComboNames Returns String[]
        Integer iC iCount
        String sStr
        String[] asBuiltin asCustom asNames

        Get psColorSchemas.Count of ghoEditorProperties to iCount
        For iC from 0 to (iCount - 1)
            Get psColorSchemas of ghoEditorProperties Item iC to sStr
            If (Trim(sStr) <> "") Begin
                If (SearchArray(sStr, asCustom, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                    Move sStr to asCustom[SizeOfArray(asCustom)]
            End
        Loop
        // The built-in list comes from the scheme class, so adding a theme there puts it
        // in this combo with no second list to remember to update.
        Get BuiltInNames of oColorSchemeSource to asBuiltin
        For iC from 0 to (SizeOfArray(asBuiltin) - 1)
            If (SearchArray(asBuiltin[iC], asCustom, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                Move asBuiltin[iC] to asNames[SizeOfArray(asNames)]
        Loop
        For iC from 0 to (SizeOfArray(asCustom) - 1)
            Move asCustom[iC] to asNames[SizeOfArray(asNames)]
        Loop
        Function_Return asNames
    End_Function

    Object oImages_lst is a cImageList32
        Set piMaxImages to 4
        Procedure OnCreate
            Integer iItem
            Get AddIcon "Colors.ico"            to iItem
            Get AddIcon "KeyWords.ico"          to iItem
            Get AddIcon "Keyboard.ico"          to iItem
            Get AddIcon "EditorSettings.ico"    to iItem
        End_Procedure
    End_Object

    Object oEditorTabDialog is a TabDialog
        Set Size to 228 441
        Set Location to 4 3
        Set phoImageList to oImages_lst
        Set peAnchors to anAll

        Object oColorFontPage is a TabPage
            Set Label to "Color/Font"
            Set piImageIndex to 0

            Object oSchemaSelect_grp is a cRDCHeaderGroup
                Set Size to 206 428
                Set Location to 5 4
                Set Label to "Colors and Font"
                Set psImage to "Colors.ico"
                Set peAnchors to anAll

                Object oCategory is a TreeView
                    Set Size to 153 106
                    Set Location to 46 7
                    Set pbFullRowSelect to True
                    Set piTextColor to clBlack
                    Set pbExplorerStyle to True
                    Set peAnchors to anTopBottomLeft

                    /* One row per element the scheme class knows about, in its own
                       order, with the element enum as the item data. The list used to
                       come from gtColorer[], which meant adding an element to the
                       scheme and adding it to this tree were two separate edits that
                       could disagree. */
                    Procedure OnCreateTree
                        Handle  hItem
                        Integer eElement iItems

                        Get ElementCount of oEditingScheme to iItems
                        For eElement from 0 to (iItems - 1)
                            Get AddTreeItem (ElementName(oEditingScheme, eElement)) 0 eElement 0 0 to hItem
                        Loop
                        Set Visible_State of oColor         to False
                        Set Visible_State of oBackground    to False
                    End_Procedure

                    /* Show the selected element's appearance. Which controls apply is
                       the scheme's answer, not a local table: the page has no background
                       of its own, the margins and the selection carry no font, and the
                       selection's second colour is worked out from the scheme rather
                       than picked (see ResolvedSelectionBackColor). */
                    Procedure OnItemChanged Handle hItem Handle hItemOld
                        Boolean bHasBack bHasFont
                        Integer eElement
                        tEditorStyle Appearance

                        Get ItemData hItem to eElement
                        Get StyleFor          of oEditingScheme eElement to Appearance
                        Get ElementHasBackColor of oEditingScheme eElement to bHasBack
                        Get ElementHasFontStyle of oEditingScheme eElement to bHasFont

                        Set Visible_State of oColor         to True
                        Set Visible_State of oBackground    to bHasBack
                        Set Visible_State of oFontBold      to bHasFont
                        Set Visible_State of oFontItalics   to bHasFont
                        Set Visible_State of oFontUnderline to bHasFont

                        Set piColorerIndex of oColor         to eElement
                        Set piColorerIndex of oBackground    to eElement
                        Set piColorerIndex of oFontBold      to eElement
                        Set piColorerIndex of oFontItalics   to eElement
                        Set piColorerIndex of oFontUnderline to eElement

                        Set SelectedColor of oColor to Appearance.iForeColor
                        If (bHasBack) ;
                            Set SelectedColor of oBackground to Appearance.iBackColor
                        Set Checked_State of oFontBold      to Appearance.bBold
                        Set Checked_State of oFontItalics   to Appearance.bItalic
                        Set Checked_State of oFontUnderline to Appearance.bUnderline

                        Send mGeneratePreview
                    End_Procedure

                    /* Re-read the selected element from the scheme. Needed whenever the
                       scheme changed underneath the tree without the SELECTION changing
                       - picking a theme, or opening the dialog - because the pickers
                       otherwise keep showing the previous theme's colours. */
                    Procedure RefreshElementControls
                        Handle hItem
                        Get CurrentTreeItem to hItem
                        If (hItem = 0) ;
                            Procedure_Return
                        Send OnItemChanged hItem 0
                    End_Procedure

                    On_Key Key_Up_Arrow Send Up
                    On_Key Key_Down_Arrow Send Down
                    On_Key Key_F2           Send Request_SaveAllEntries
                    On_Key Key_Ctrl+Key_F2  Send Request_SaveAllEntries
                    On_Key kCancel          Send Close_Panel
                End_Object

                Object oColor is a cColorBox
                    Set Size to 22 105
                    Set Location to 47 120
                    Set Label to "Color"
                    Procedure OnColorChange
                        Integer iColor
                        Get SelectedColor to iColor
                        Send SetElementForeColor of oEditingScheme (piColorerIndex(Self)) iColor
                        Send mGeneratePreview
                        Delegate Send NotifyChange
                    End_Procedure
                End_Object

                Object oBackground is a cColorBox
                    Set Size to 22 105
                    Set Location to 72 120
                    Set Label to "Background"
                    Procedure OnColorChange
                        Integer iColor
                        Get SelectedColor to iColor
                        Send SetElementBackColor of oEditingScheme (piColorerIndex(Self)) iColor
                        Send mGeneratePreview
                        Delegate Send NotifyChange
                    End_Procedure
                End_Object

                Object oFontBold is a CheckBox
                    Property Integer piColorerIndex
                    Set Size to 10 50
                    Set Location to 107 151
                    Set Label to "Bold"
                    Set FontWeight to fw_Bold
                    Set Visible_State to False
                    Procedure OnChange
                        Boolean bOn
                        If (Focus(Desktop)=Self) Begin
                            Get Checked_State to bOn
                            Send SetElementBold of oEditingScheme (piColorerIndex(Self)) bOn
                            Send mGeneratePreview
                            Delegate Send NotifyChange
                        End
                    End_Procedure
                End_Object

                Object oFontItalics is a CheckBox
                    Property Integer piColorerIndex
                    Set Size to 10 50
                    Set Location to 118 151
                    Set Label to "Italics"
                    Set FontItalics to True
                    Set Visible_State to False
                    Procedure OnChange
                        Boolean bOn
                        If (Focus(Desktop)=Self) Begin
                            Get Checked_State to bOn
                            Send SetElementItalic of oEditingScheme (piColorerIndex(Self)) bOn
                            Send mGeneratePreview
                            Delegate Send NotifyChange
                        End
                    End_Procedure
                End_Object

                Object oFontUnderline is a CheckBox
                    Property Integer piColorerIndex
                    Set Size to 10 50
                    Set Location to 129 151
                    Set Label to "Underline"
                    Set FontUnderline to True
                    Set Visible_State to False
                    /* Underline is stored and round-trips, but Scintilla's DataFlex
                       lexer styles do not draw it - it was a CodeMax feature. The
                       checkbox stays because a scheme file may carry the flag and
                       silently dropping a user's setting is worse than a control whose
                       effect the preview cannot show. */
                    Procedure OnChange
                        Boolean bOn
                        If (Focus(Desktop)=Self) Begin
                            Get Checked_State to bOn
                            Send SetElementUnderline of oEditingScheme (piColorerIndex(Self)) bOn
                            Send mGeneratePreview
                            Delegate Send NotifyChange
                        End
                    End_Procedure
                End_Object

                /* The preview. It used to be three objects - a Container3d painted with
                   the Left Margin colour, a TextBox with "01 02 03..." typed into its
                   label standing in for the line-number margin, and a RichEdit
                   (cEditorPreview) imitating Scintilla's syntax colouring token by
                   token from ninety lines of Add* calls below.

                   It is now one real Scintilla control running the real DataFlex lexer
                   through the editor's own rendering class, so its margins are margins
                   and its colours are the colours the editor will use. See
                   cSchemePreview.pkg. */
                Object oPreview is a Container3d
                    Set Size to 157 190
                    Set Location to 46 232
                    Set Border_Style to Border_ClientEdge
                    Set peAnchors to anAll

                    Object oEditorPreview is a cSchemePreview
                        Set Size to 155 188
                        Set Location to 0 0
                        Set peAnchors to anAll
                    End_Object

                End_Object

                // We want these two "top" object down here so that
                // the treeview is automatically taking the focus.
                Object oSchemaSelect is a ComboForm
                    Set Size to 13 106
                    Set Location to 30 7
                    Set Label to "Color Theme:"
                    Set Label_Col_Offset to 0
                    Set Label_Justification_Mode to JMode_Top
                    Set Label_Row_Offset to 1

                    Procedure Combo_Fill_List
                        Integer iC
                        String  sCur
                        String[] asNames

                        // Built-ins + customs, deduplicated - a custom SHADOWS a built-in of
                        // the same name (see SchemaComboNames; the double "Lucas" fix).
                        Get SchemaComboNames of (oScintillaParameters_dg(Self)) to asNames
                        For iC from 0 to (SizeOfArray(asNames) - 1)
                            Send Combo_Add_Item asNames[iC]
                        Loop
                        Get psColorSchema of ghoEditorProperties to sCur
                        If (sCur = "") Begin
                            Move CS_ThemeLime to sCur
                            Set psColorSchema of ghoEditorProperties to sCur
                        End

                        Set Value to sCur
                        Set Entry_State to False
                    End_Procedure

                    Procedure OnChange
                        Boolean bFound
                        String sName

                        If (Focus(Desktop) = Self) Begin
                            Get Value to sName
                            // CUSTOM FIRST, built-in fallback - the ONE rule (see
                            // LoadSchemaInto and ResolveColorSchema under it; the "Lucas
                            // turned black" fix). An unknown name falls back to White,
                            // the old default.
                            Get LoadSchemaInto of (oScintillaParameters_dg(Self)) oEditingScheme sName to bFound
                            If (bFound = False) ;
                                Get LoadSchemaInto of (oScintillaParameters_dg(Self)) oEditingScheme CS_ThemeWhite to bFound
                            // Whatever it resolved to, the scheme is now called what the
                            // combo says - that is the name SaveEntries writes under.
                            Set psSchemeName of oEditingScheme to sName

                            Send RefreshElementControls to oCategory
                            Send mGeneratePreview to oSchemaSelect

                            Delegate Send NotifyChange
                        End
                    End_Procedure

                    On_Key Key_F2           Send Request_SaveAllEntries
                    On_Key Key_Ctrl+Key_F2  Send Request_SaveAllEntries
                    On_Key kCancel          Send Close_Panel
                End_Object

                Object oFontFace is a Form
                    Set Size to 13 105
                    Set Location to 30 120
                    Set Label_Col_Offset to 0
                    Set Label_Justification_Mode to JMode_Top
                    Set Prompt_Button_Mode to PB_PromptOn
                    Set Label to "Font:"
                    Set Label_Row_Offset to 1

                    // The editor font, size & type is saved as a string with
                    // the format: "11pt; 0; Consolas" in the .ini file. This is
                    // also the format used to populate the popup font selection dialog.
                    // However, we like to present the font as "Consolas, 11pt".
                    Property String private.psEditorFont ""

                    Procedure Set psEditorFont String sFont
                        String sFontText
                        Set private.psEditorFont to sFont
                        Get ScintillaReadableFontFormat sFont to sFontText
                        Set Value to sFontText
                    End_Procedure

                    Function psEditorFont Returns String
                        Function_Return (private.psEditorFont(Self))
                    End_Function

                    Procedure Key Integer iKey Returns Integer
                        Integer iRetVal
                        // Left, Right, Shft+Left, Shift+Right, Home, End, Shft+Home, Shft+End
                        If ((iKey=260)or(iKey=261)or(iKey=5127)or(iKey=5128)or ;
                        (iKey=294)or(iKey=295)or(iKey=5129)or(iKey=5130) ) ;
                        Forward Get Msg_Key iKey to iRetVal
                        Procedure_Return iRetVal
                    End_Procedure

                    Function CanPaste Returns Boolean
                        Function_Return False
                    End_Function
                    Function CanCut Returns Boolean
                        Function_Return False
                    End_Function
                    Function CanDelete Returns Boolean
                        Function_Return False
                    End_Function
                    Function CanUndo Returns Boolean
                        Function_Return False
                    End_Function
                    Procedure Paste Integer Arg1 Integer Arg2 Integer Arg3
                    End_Procedure
                    Procedure Cut Integer Arg1 Integer Arg2 Integer Arg3
                    End_Procedure
                    Procedure Delete
                    End_Procedure
                    Procedure Undo
                    End_Procedure

                    Procedure Prompt
                        Handle hoFontDlg
                        Integer iOK
                        tFontSpecs FontSpecs
                        String sFace sSize sCharSet sFontText

                        Get psEditorFont to sFace
                        Get ScintillaFontAsStruct sFace to FontSpecs
                        Get Create (RefClass(FontDialog)) to hoFontDlg

                        Set FixedPitchOnly_State    of hoFontDlg to True
                        Set FaceName                of hoFontDlg to FontSpecs.sFontName
                        Set FontPointSize           of hoFontDlg to (FontSpecs.iSize * 10)
                        Set FontCharSet             of hoFontDlg to FontSpecs.iCharSet
                        Set FontItalic              of hoFontDlg to False
                        Set FontUnderline           of hoFontDlg to False
                        Set FontWeight              of hoFontDlg to FW_REGULAR
                        Set FontType                of hoFontDlg to REGULAR_FONTTYPE
                        Get FontDialog              of hoFontDlg to iOK
                        If (iOk) Begin
                            Move "" to FontSpecs.sFontName
                            Move 0  to FontSpecs.iSize
                            Move 0  to FontSpecs.iCharSet
                            // Note: We _must_ trim the FaceName, FontPointSize & FontCharSet, else we can't append anything to the string.
                            // Perhaps the functions does not make a proper DataFlex string ending?
                            Get FaceName                of hoFontDlg to sFace
                            Move (CString(sFace))       to FontSpecs.sFontName
                            Get FontPointSize           of hoFontDlg to sSize
                            Move (CString(sSize))       to sSize
                            If (sSize = "") Begin
                                Move 110    to sSize
                            End
                            Move (sSize / 10)           to FontSpecs.iSize
                            Get FontCharSet             of hoFontDlg to sCharSet
                            Move (CString(sCharSet))    to FontSpecs.iCharSet
                            Append sFontText FontSpecs.sFontName ", " (String(FontSpecs.iSize)) "pt"

                            Set Value                   to sFontText
                            Get ScintillaEditorFontFormat FontSpecs to sFace
                            Set psEditorFont            to sFace
                            Send mGeneratePreview
                            Delegate Send NotifyChange
                        End
                        Send Destroy                    to hoFontDlg
                    End_Procedure

                End_Object

                /* Repaint the preview from the scheme being edited. Called after every
                   change on this page - a colour, a font style, a theme, the font.

                   This used to be a hundred and thirty lines: it re-coloured the two
                   fake margin objects from gtColorer[], then rebuilt the sample text
                   token by token with ninety Add* calls into a RichEdit, each one a
                   hand-written guess at what Scintilla would do with that token. The
                   preview is now the editor's own renderer, so all of that is one
                   handover of the scheme plus the font the user has picked but not yet
                   saved. */
                Procedure mGeneratePreview
                    String sFont
                    tFontSpecs FontSpecs

                    Get psEditorFont of oFontFace to sFont
                    Get ScintillaFontAsStruct sFont to FontSpecs
                    Send ShowScheme to oEditorPreview oEditingScheme ;
                                       FontSpecs.sFontName FontSpecs.iSize
                End_Procedure

                Object oColorSelectionInfo_tb is a TextBox
                    Set Auto_Size_State to False
                    Set Size to 24 105
                    Set Location to 150 120
                    Set Label to "Click on a color above to select a new color from the popup dialog"
                    Set Justification_Mode to JMode_Left
                    Set FontItalics to True
                End_Object

                // We need this because we're not on the first tab page and
                // the tab page will come up empty without it.
                Procedure Add_Focus Handle hoParent Returns Integer
                    Integer iRetVal
                    Forward Get Msg_Add_Focus hoParent to iRetVal
                    Send mGeneratePreview
                    Procedure_Return iRetVal
                End_Procedure

            End_Object
            
            /* Colors & Fonts. The scheme is written in the READABLE form - one line per
               element, "MetaTags=128,0,128;-;B" - which is what SerializeScheme produces and
               what the editor reads back through LoadFromSettings.

               It used to write the packed pair: a 504-character run of digits for the
               colours and a second string for the font flags, positional, with each
               element at a hardcoded offset. That format is still READ (LoadFromSettings
               sniffs it, so an install that has never opened this dialog still renders),
               but nothing writes it any more. psFontStyles is blanked deliberately -
               the readable form carries the flags inline, and leaving the old string
               behind would be a second copy of the same facts waiting to disagree. */
            Procedure SaveEntries
                Integer iC
                String sColors sFontFace sSchemaName

                Get Value of oSchemaSelect to sSchemaName
                If (sSchemaName <> "") Begin
                    Set psSchemeName of oEditingScheme to sSchemaName
                    Get SerializeScheme    of oEditingScheme to sColors
                    // A built-in is not written back as a user scheme - it is already
                    // declared in code. Asking the scheme class means this can never
                    // fall out of step with the list the combo shows, which is how
                    // "Lucas" ended up a name that could never be given colours.
                    If (IsBuiltIn(oColorSchemeSource(Self), sSchemaName) = False) Begin
                        Get FindColorSchema of ghoEditorProperties sSchemaName to iC
                        If (iC < 0) Begin
                            Get psColorSchemas.Count           of ghoEditorProperties to iC
                        End
                        Set psColorSchemas                     of ghoEditorProperties Item iC  to sSchemaName
                        Set psColorSchemas.psSchemaColors      of ghoEditorProperties Item iC  to sColors
                        Set psColorSchemas.psSchemaFontStyles  of ghoEditorProperties Item iC  to ""
                    End
                    Set psColorSchema  of ghoEditorProperties  to sSchemaName
                    Set psColors       of ghoEditorProperties  to sColors
                    Set psFontStyles   of ghoEditorProperties  to ""
                End

                // Font
                Get psEditorFont of oFontFace   to sFontFace
                If (sFontFace = "") Begin
                    Move "11pt; 0; Courier New" to sFontFace
                End
                Set psFontFace             of ghoEditorProperties to sFontFace

            End_Procedure
        
            On_Key Key_F2           Send Request_SaveAllEntries
            On_Key Key_Ctrl+Key_F2  Send Request_SaveAllEntries
            On_Key kCancel          Send Close_Panel
        End_Object

        Object oLanguagePage is a TabPage
            Set Label to "Language"
            Set piImageIndex to 1

            Object oLanguageGroup is a cRDCHeaderGroup
                Set Size to 206 428
                Set Location to 5 4
                Set psImage to "KeyWords.ico"
                Set Label to "Keywords and Operators"
                Set psNote to "Used by Editor when the 'Adjust Upper/Lowercase' refactor function is selected"
                Set peAnchors to anAll

                Object oScopes is a cSCWsGrid
                    Set Size to 137 180
                    Set Location to 35 6
                    Set Line_Width to 2 0
                    Set GridLine_Mode to Grid_Visible_None

                    Set Form_Width 0 to 85
                    Set Header_Label 0 to "Scope Start"
                    Set Status_Help Item 0 to "Scope keyword start"

                    Set Form_Width 1 to 85
                    Set Header_Label 1 to "Scope End"
                    Set Status_Help Item 1 to "Scope keyword stop"
                    Set peAnchors to anTopBottom

                    Property String psSepCharacter "\n"

                    Procedure OnChange Integer iItem
                        Integer iScopes
                        Delegate Send NotifyChange
                        Get Item_Count to iScopes
                        Set Label of oScopesInfo_tb to ("Scopes:" * String(iScopes / 2))
                    End_Procedure

                    Procedure Add_New_Line String sStart String sStop Integer iColor
                        Send Add_Item Msg_None sStart
                        If (iColor) Begin
                            Set ItemTextColor (Item_Count(Self) - 1) to iColor
                        End
                        Send Add_Item Msg_None sStop
                        If (iColor) Begin
                            Set ItemTextColor (Item_Count(Self) - 1) to iColor
                        End
                    End_Procedure

                    Procedure mInsertLine
                        Send Add_New_Line "" "" clRed
                        Send OnChange 0
                        Send End_of_Data
                    End_Procedure

                    Procedure mRemoveLine
                        Integer iRowBase
                        If (Item_Count(Self) = 0) Begin
                            Procedure_Return
                        End
                        Get Base_Row_Item (Current_Item(Self)) to iRowBase
                        Send Delete_Item (iRowBase + 1)
                        Send Delete_Item iRowBase
                        Send OnChange 0
                    End_Procedure

                    Procedure mMoveDown
                        Integer iCount iRowBase
                        String  sStart sStop

                        Get Item_Count to iCount
                        Get Base_Row_Item (Current_Item(Self)) to iRowBase
                        Get Value Item iRowBase to sStart
                        Get Value Item (iRowBase + 1) to sStop
                        If (sStart = "") Begin
                            Set Current_Item to iRowBase
                        End
                        Else If (sStop = "") Begin
                            Set Current_Item to (iRowBase + 1)
                        End
                        Else Begin
                            If (iRowBase = (iCount - 2)) Begin
                                Send mInsertLine
                                Set Current_Item to (iRowBase + 2)
                            End
                            Send Down
                            Set Current_Item to (iRowBase + 2)
                        End
                    End_Procedure

                    Procedure mMoveUp
                        Integer iRowBase
                        String  sStart sStop

                        Get Base_Row_Item (Current_Item(Self)) to iRowBase
                        Get Value Item iRowBase to sStart
                        Get Value Item (iRowBase + 1) to sStop
                        If (sStart = "" and sStop = "") Begin
                            Send mRemoveLine
                        End
                        Else If (sStart = "" or sStop = "") Begin
                            Send Stop_Box "Scope 'Start' and 'Stop' keywords must be specified!" "Problem"
                        End
                        Else Begin
                            Send Up
                        End
                    End_Procedure

                    Function GetValue Integer iColumn Returns String
                        Integer iC iColumns
                        String  sRet sSep

                        Move (Low(Matrix_Size(Self))) to iColumns
                        Get psSepCharacter to sSep
                        If (sSep = "") Begin
                            Move "\n" to sSep
                        End
                        For iC From 0 to (Item_Count(Self) - 1)
                            If (Value(Self, iC + iColumn) <> "") Begin
                                If (sRet <> "") Begin
                                    Move (sRet + sSep) to sRet
                                End
                                Move (sRet + Value(Self, iC + iColumn)) to sRet
                            End
                            Move (iC + iColumns - 1) to iC
                        Loop
                        Function_Return sRet
                    End_Function

                    Procedure DoLoad tSCLanguage ByRef ltSCLanguage
                        Integer iScope iScopes
                        Send Delete_Data
                        Move (SizeOfArray(ltSCLanguage.saScopeStart)) to iScopes
                        For iScope From 0 to (iScopes -1)
                            Send Add_New_Line ltSCLanguage.saScopeStart[iScope] ltSCLanguage.saScopeStop[iScope] 0
                        Loop
                        Set Label of oScopesInfo_tb to ("Scopes:" * String(iScopes))
                    End_Procedure

                    On_Key Key_F2           Send Request_SaveAllEntries
                    On_Key Key_Ctrl+Key_F2  Send Request_SaveAllEntries
                    On_Key kCancel          Send Close_Panel
                    On_Key kDownArrow       Send mMoveDown
                    On_Key kUpArrow         Send mMoveUp
                    On_Key Key_Tab          Send mMoveDown
                End_Object

