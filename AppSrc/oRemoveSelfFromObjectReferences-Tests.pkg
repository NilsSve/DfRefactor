    Object oRemoveSelfFromObjectReferences is a cTestFixture
        Set psFunctionName to "RemoveSelfFromObjectReferences"

        // An object the file declares: both references lose (Self), the parentheses around them stay.
        {Published = True}
        Procedure RemoveSelfFromObjectReferences_DeclaredObject
            String[] asCode
            Integer iCount
            Move "Object oCustomer_DD is a Customer_DataDictionary"  to asCode[0]
            Move "End_Object"                                        to asCode[1]
            Move "    Set Server to (oCustomer_DD(Self))"            to asCode[2]
            Move "    Send Clear of (oCustomer_DD( self ))"          to asCode[3]
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual "    Set Server to (oCustomer_DD)" asCode[2]
            Send AssertSAreEqual "    Send Clear of (oCustomer_DD)" asCode[3]
        End_Procedure

        // A property call and an object the file does not declare stay as they are.
        {Published = True}
        Procedure RemoveSelfFromObjectReferences_NotAnObjectOfThisFile
            String[] asCode
            Integer iCount
            Move "Object oCustomer_DD is a Customer_DataDictionary"  to asCode[0]
            Move "End_Object"                                        to asCode[1]
            Move "Move (piCount(Self)) to iCount"                    to asCode[2]
            Move "Move (oOrderView(Self)) to hoView"                 to asCode[3]
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual "Move (piCount(Self)) to iCount" asCode[2]
            Send AssertSAreEqual "Move (oOrderView(Self)) to hoView" asCode[3]
        End_Procedure

        // A variable with the object's name: the short form would read the variable, so nothing changes.
        {Published = True}
        Procedure RemoveSelfFromObjectReferences_VariableOfTheSameName
            String[] asCode
            Integer iCount
            Move "Handle oCustomer_DD"                               to asCode[0]
            Move "Object oCustomer_DD is a Customer_DataDictionary"  to asCode[1]
            Move "End_Object"                                        to asCode[2]
            Move "Set Server to (oCustomer_DD(Self))"                to asCode[3]
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual "Set Server to (oCustomer_DD(Self))" asCode[3]
        End_Procedure

        // Comments, strings, a block comment, a #COMMAND body and a #HEADER region are never touched.
        {Published = True}
        Procedure RemoveSelfFromObjectReferences_NotCode
            String[] asCode asBefore
            Integer iCount i
            Boolean bSame
            Move "Object oCustomer_DD is a Customer_DataDictionary"  to asCode[0]
            Move "End_Object"                                        to asCode[1]
            Move "// Set Server to (oCustomer_DD(Self))"             to asCode[2]
            Move 'Move "(oCustomer_DD(Self))" to sText'              to asCode[3]
            Move "/*"                                                to asCode[4]
            Move "Set Server to (oCustomer_DD(Self))"                to asCode[5]
            Move "*/"                                                to asCode[6]
            Move "#COMMAND MyCommand"                                to asCode[7]
            Move "    Send Clear of (oCustomer_DD(Self))"            to asCode[8]
            Move "#ENDCOMMAND"                                       to asCode[9]
            Move "#HEADER"                                           to asCode[10]
            Move "    Send Clear of (oCustomer_DD(Self))"            to asCode[11]
            Move "#ENDHEADER"                                        to asCode[12]
            Move asCode to asBefore
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Move True to bSame
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] <> asBefore[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame "no line changed"
        End_Procedure

        // A nested reference loses its innermost (Self) only; the code after an end comment is kept.
        {Published = True}
        Procedure RemoveSelfFromObjectReferences_NestedAndEndComment
            String[] asCode
            Integer iCount
            Move "Object oB is a cObject"                            to asCode[0]
            Move "End_Object"                                        to asCode[1]
            Move "Move (oA(oB(Self))) to hoA // (oB(Self))"          to asCode[2]
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual "Move (oA(oB)) to hoA // (oB(Self))" asCode[2]
        End_Procedure

    End_Object
