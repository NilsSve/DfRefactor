// Web-site    : http://www.rdctools.com
// Created     : 2026-07-16
//
// Description : Unit tests for the ChangeGetFileExistsToFileExist refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeGetFileExistsToFileExist is a cTestFixture
        Set psFunctionName to "ChangeGetFileExistsToFileExist"

        // The clean Get-call form converts: Get Get_File_Exists <file> to <var> -> File_Exist <file> <var>
        // (File_Exist takes NO 'to' token).
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_Basic
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get Get_File_Exists sFileFrom to iRetval' to sLine
            Move 'File_Exist sFileFrom iRetval'             to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Indentation is preserved; the function name matches case-insensitively (LegacyApp2's
        // 'Get_file_exists' spelling).
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_IndentAndCase
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        Get Get_file_exists sDir to bFileExist' to sLine
            Move '        File_Exist sDir bFileExist'             to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A trailing end comment survives the rebuild.
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_EndCommentKept
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get Get_File_Exists sFileTo to iRetval // Function in Funcs.pkg' to sLine
            Move 'File_Exist sFileTo iRetval  // Function in Funcs.pkg'            to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A string-literal argument rides through VERBATIM - even one containing '\to\' (the
        // 'to' search runs on the overstrike, where the literal is masked).
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_LiteralArg
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get Get_File_Exists "c:\to\hello.txt" to bExists' to sLine
            Move 'File_Exist "c:\to\hello.txt" bExists'             to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A parenthesised expression argument (inner spaces included) rides through verbatim.
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_ExpressionArg
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get Get_File_Exists (sPath + sName) to iRet' to sLine
            Move 'File_Exist (sPath + sName) iRet'             to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The shapes that must NOT convert: the modern command (idempotence), the expression-form
        // call (not line-local), a commented line, a LONGER name that merely starts the same, and
        // an 'of' clause (not the global-function shape).
        {Published = True}
        Procedure ChangeGetFileExistsToFileExist_NoChange
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move 'File_Exist sFile bOk' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'File_Exist sFile bOk' sLine
            Move 'Move (Get_File_Exists(sF)) to iRet' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Move '// Get Get_File_Exists sFile to iRet' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Move 'Get Get_File_Exists_Ex sFile to iRet' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Move 'Get Get_File_Exists of oFileHelper sFile to iRet' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetFileExistsToFileExist of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
        End_Procedure

    End_Object
