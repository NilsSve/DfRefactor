//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeStrMarkToExpression-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-08
//
// Description : Unit tests for the ChangeStrMarkToExpression refactor function: a read of the
//               legacy strmark predefined variable becomes the expression the preceding string
//               command left in it. The expected values follow the DataFlex 26 run time
//               (measured 2026-09-08): Pos and Replace leave strmark = Pos(needle, haystack),
//               Replace on the value BEFORE the replacement; Left / Pad / Insert leave their count
//               or position; a count-less Left / Mid / Pad takes the value and leaves it; the
//               function forms leave it untouched.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeStrMarkToExpression is a cTestFixture
        Set psFunctionName to "ChangeStrMarkToExpression"

        // A Pos command and the read on the next line: the read becomes Pos(needle, haystack) in
        // place. The command line stays - it may still set Found.
        { Published = True }
        Procedure ChangeStrMarkToExpression_PosCommand_ReadBecomesPosFunction
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    Pos " " in sName'              to asCode[2]
            Move '    Move strmark to iPos'          to asCode[3]
            Move 'End_Procedure'                     to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Pos " " in sName'                asCode[2]
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iPos'  asCode[3]
        End_Procedure

        // A Pos WITH a destination still leaves strmark; the read derives from the operands.
        { Published = True }
        Procedure ChangeStrMarkToExpression_PosWithDestination_ReadStillDerives
            String[] asCode
            Integer iCount

            Move 'Procedure FindComma String sList'  to asCode[0]
            Move '    Integer iComma iAgain'         to asCode[1]
            Move '    Pos "," in sList to iComma'    to asCode[2]
            Move '    Move strmark to iAgain'        to asCode[3]
            Move 'End_Procedure'                     to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Pos "," in sList to iComma'        asCode[2]
            Send AssertSAreEqual '    Move (Pos(",", sList)) to iAgain'  asCode[3]
        End_Procedure

        // Inside an existing expression the call goes in bare; a bare read is parenthesised.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ReadInsideExpression_GoesInBare
            String[] asCode
            Integer iCount

            Move 'Function FirstWordLength String sName Returns Integer'    to asCode[0]
            Move '    Pos " " in sName'                                     to asCode[1]
            Move '    If (strmark > 0) Function_Return (strmark - 1)'       to asCode[2]
            Move '    Function_Return strmark'                              to asCode[3]
            Move 'End_Function'                                             to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual '    If (Pos(" ", sName) > 0) Function_Return (Pos(" ", sName) - 1)' asCode[2]
            Send AssertSAreEqual '    Function_Return (Pos(" ", sName))'                            asCode[3]
        End_Procedure

        // A Replace changes the very string it searched, so its strmark exists only BEFORE it runs:
        // a plain 'Move strmark to x' moves above the Replace line, as Pos(needle, haystack). The
        // nested block keeps its own pair; 'if [found] begin' is not this function's business.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ReplaceCommand_PlainMoveLiftsAboveIt
            String[] asCode
            Integer iCount

            Move 'procedure SplitOnSeparator global string sText' to asCode[0]
            Move '  integer iFirst iSecond'                        to asCode[1]
            Move '  string sWork sSep'                             to asCode[2]
            Move '  move sText to sWork'                           to asCode[3]
            Move '  replace sSep in sWork with "$"'                to asCode[4]
            Move '  move strmark to iFirst'                        to asCode[5]
            Move '  if [found] begin'                              to asCode[6]
            Move '    replace sSep in sWork with "$"'              to asCode[7]
            Move '    move strmark to iSecond'                     to asCode[8]
            Move '  end'                                           to asCode[9]
            Move 'end_procedure'                                   to asCode[10]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 11 (SizeOfArray(asCode))
            Send AssertSAreEqual '  move sText to sWork'                   asCode[3]
            Send AssertSAreEqual '  Move (Pos(sSep, sWork)) to iFirst'     asCode[4]
            Send AssertSAreEqual '  replace sSep in sWork with "$"'        asCode[5]
            Send AssertSAreEqual '  if [found] begin'                      asCode[6]
            Send AssertSAreEqual '    Move (Pos(sSep, sWork)) to iSecond'  asCode[7]
            Send AssertSAreEqual '    replace sSep in sWork with "$"'      asCode[8]
            Send AssertSAreEqual '  end'                                   asCode[9]
            Send AssertSAreEqual 'end_procedure'                           asCode[10]
        End_Procedure

        // The Replace() FUNCTION never sets strmark: a read after a converted command is already
        // stale. The converted line is taken as the producer, the read moves above it, and the run
        // notes say so.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ReplaceFunctionForm_StaleReadRepaired
            String[] asCode
            Integer iCount
            String sNotes

            Move 'Procedure SplitOnSeparator String sText'          to asCode[0]
            Move '    Integer iFirst'                                to asCode[1]
            Move '    String sWork sSep'                             to asCode[2]
            Move '    Move (Replace(sSep, sWork, "$")) to sWork'     to asCode[3]
            Move '    Move strmark to iFirst'                        to asCode[4]
            Move 'End_Procedure'                                     to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Move (Pos(sSep, sWork)) to iFirst'        asCode[3]
            Send AssertSAreEqual '    Move (Replace(sSep, sWork, "$")) to sWork' asCode[4]
            Get RunNotesText of ghoFuncLib "ChangeStrMarkToExpression" "" to sNotes
            Send Assert (sNotes contains "already stale")
        End_Procedure

        // The same for a converted Pos: in place, since Pos() changes nothing.
        { Published = True }
        Procedure ChangeStrMarkToExpression_PosFunctionForm_StaleReadRepaired
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'           to asCode[0]
            Move '    Integer iPos iAgain'                    to asCode[1]
            Move '    Move (Pos(" ", sName)) to iPos'         to asCode[2]
            Move '    Move strmark to iAgain'                 to asCode[3]
            Move 'End_Procedure'                              to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iAgain' asCode[3]
        End_Procedure

        // A conditional producer (a one-line If) leaves a run-time question: declined, with the
        // reason on the line. Nothing else moves.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ConditionalReplace_Declined
            String[] asCode
            Integer iCount

            Move 'Procedure Fix String sText'                                    to asCode[0]
            Move '    Integer iAt'                                               to asCode[1]
            Move '    If (sText contains "a") Replace "a" in sText with "b"'     to asCode[2]
            Move '    Move strmark to iAt'                                       to asCode[3]
            Move 'End_Procedure'                                                 to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send Assert (Left(asCode[3], 51) = '    Move strmark to iAt   // TODO (DFRefactor): NOT')
            Send Assert (asCode[3] contains "conditional")
        End_Procedure

        // A block boundary between the Replace and the read: the moved assignment would run at the
        // wrong time, so the read keeps its line with the reason.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ReadAcrossBlockBoundary_Declined
            String[] asCode
            Integer iCount

            Move 'Procedure Fix String sList Boolean bLog'      to asCode[0]
            Move '    Integer iAt'                               to asCode[1]
            Move '    Replace "," in sList with ";"'             to asCode[2]
            Move '    If (bLog) Begin'                           to asCode[3]
            Move '        Move strmark to iAt'                   to asCode[4]
            Move '    End'                                       to asCode[5]
            Move 'End_Procedure'                                 to asCode[6]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 7 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Replace "," in sList with ";"' asCode[2]
            Send Assert (asCode[4] contains "TODO (DFRefactor)")
            Send Assert (asCode[4] contains "block boundary")
        End_Procedure

        // An operand assigned between the command and the read: the derived value would be wrong.
        // The reason names the operand in its source casing.
        { Published = True }
        Procedure ChangeStrMarkToExpression_OperandChangedBetween_Declined
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    Pos " " in sName'              to asCode[2]
            Move '    Move "" to sName'              to asCode[3]
            Move '    Move strmark to iPos'          to asCode[4]
            Move 'End_Procedure'                     to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[4] contains "TODO (DFRefactor)")
            Send Assert (asCode[4] contains "sName is changed")
        End_Procedure

        // An operand only READ between the command and the read leaves the value valid (a count-
        // less Left takes strmark and leaves it, measured): the read converts.
        { Published = True }
        Procedure ChangeStrMarkToExpression_OperandOnlyReadBetween_StillConverts
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    String sHead'                  to asCode[2]
            Move '    Pos " " in sName'              to asCode[3]
            Move '    Left sName to sHead'           to asCode[4]
            Move '    Move strmark to iPos'          to asCode[5]
            Move 'End_Procedure'                     to asCode[6]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Left sName to sHead'              asCode[4]
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iPos'   asCode[5]
        End_Procedure

        // No string command before the read in its method: the value comes from elsewhere.
        { Published = True }
        Procedure ChangeStrMarkToExpression_NoProducer_Declined
            String[] asCode
            Integer iCount

            Move 'Procedure ReadIt'              to asCode[0]
            Move '    Integer iPos'              to asCode[1]
            Move '    Move strmark to iPos'      to asCode[2]
            Move 'End_Procedure'                 to asCode[3]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[2] contains "TODO (DFRefactor)")
            Send Assert (asCode[2] contains "no string command")
        End_Procedure

        // Left with a count leaves that count in strmark (measured): the read becomes the count.
        { Published = True }
        Procedure ChangeStrMarkToExpression_LeftWithCount_ReadBecomesTheCount
            String[] asCode
            Integer iCount

            Move 'Procedure Split String sPath Integer iSep'  to asCode[0]
            Move '    Integer iKeep'                          to asCode[1]
            Move '    String sDir'                            to asCode[2]
            Move '    Left sPath to sDir (iSep - 1)'          to asCode[3]
            Move '    Move strmark to iKeep'                  to asCode[4]
            Move 'End_Procedure'                              to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move (iSep - 1) to iKeep' asCode[4]
        End_Procedure

        // A write that feeds a count-less Left is the legacy input channel of that command: the
        // global stays, the write keeps its line with the reason, no local is declared.
        { Published = True }
        Procedure ChangeStrMarkToExpression_CountLessLeft_WriteKeepsTheGlobal
            String[] asCode
            Integer iCount

            Move 'Procedure Head String sText'    to asCode[0]
            Move '    String sHead'               to asCode[1]
            Move '    Move 7 to strmark'          to asCode[2]
            Move '    Left sText to sHead'        to asCode[3]
            Move 'End_Procedure'                  to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send Assert (Left(asCode[2], 21) = '    Move 7 to strmark')
            Send Assert (asCode[2] contains "count-less")
            Send AssertSAreEqual '    Left sText to sHead' asCode[3]
        End_Procedure

        // A value written and never read back is a discarded return: it goes to iVoid, declared as
        // the first line of the body. A second run finds nothing to do.
        { Published = True }
        Procedure ChangeStrMarkToExpression_PureSink_BecomesIVoid
            String[] asCode
            Integer iCount

            Move 'Procedure DropFile String sFile'                to asCode[0]
            Move '    Pointer lpName'                             to asCode[1]
            Move '    Move (AddressOf(sFile)) to lpName'          to asCode[2]
            Move '    Move (SomeApiCall(lpName)) to strmark'      to asCode[3]
            Move 'End_Procedure'                                  to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Integer iVoid'                          asCode[1]
            Send AssertSAreEqual '    Pointer lpName'                         asCode[2]
            Send AssertSAreEqual '    Move (SomeApiCall(lpName)) to iVoid'    asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Integer iVoid' asCode[1]
        End_Procedure

        // Written and read back within the method: a scratch integer, so a local named after what
        // it replaces (iStrMark), both lines renamed.
        { Published = True }
        Procedure ChangeStrMarkToExpression_ScratchUse_BecomesLocalIStrMark
            String[] asCode
            Integer iCount

            Move 'Procedure Count String sText'           to asCode[0]
            Move '    Integer iTotal'                     to asCode[1]
            Move '    Move 5 to strmark'                  to asCode[2]
            Move '    Move (strmark * 2) to iTotal'       to asCode[3]
            Move 'End_Procedure'                          to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Integer iStrMark'                asCode[1]
            Send AssertSAreEqual '    Move 5 to iStrMark'              asCode[3]
            Send AssertSAreEqual '    Move (iStrMark * 2) to iTotal'   asCode[4]
        End_Procedure

        // Outside every procedure and function no local can stand in for the global: marked.
        { Published = True }
        Procedure ChangeStrMarkToExpression_OutsideMethod_Declined
            String[] asCode
            Integer iCount

            Move 'Integer giPos'                 to asCode[0]
            Move 'Move strmark to giPos'         to asCode[1]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[1] contains "TODO (DFRefactor)")
            Send Assert (asCode[1] contains "outside a procedure or function")
        End_Procedure

        // A longer identifier that CONTAINS the name is not the variable (boundary-aware).
        { Published = True }
        Procedure ChangeStrMarkToExpression_LongerIdentifier_Untouched
            String[] asCode
            Integer iCount

            Move 'Procedure Sum'                          to asCode[0]
            Move '    Integer iStrmarkTotal iX'           to asCode[1]
            Move '    Move iStrmarkTotal to iX'           to asCode[2]
            Move 'End_Procedure'                          to asCode[3]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Move iStrmarkTotal to iX' asCode[2]
        End_Procedure

        // The name inside a string literal or a comment is text, not the variable.
        { Published = True }
        Procedure ChangeStrMarkToExpression_StringAndComment_Untouched
            String[] asCode
            Integer iCount

            Move 'Procedure Note'                              to asCode[0]
            Move '    String sX'                               to asCode[1]
            Move '    // strmark is a legacy variable'         to asCode[2]
            Move '    Move "strmark" to sX'                    to asCode[3]
            Move 'End_Procedure'                               to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual '    // strmark is a legacy variable' asCode[2]
            Send AssertSAreEqual '    Move "strmark" to sX'            asCode[3]
        End_Procedure

        // The read line's own trailing comment travels with the moved assignment.
        { Published = True }
        Procedure ChangeStrMarkToExpression_TrailingComment_TravelsWithTheMovedLine
            String[] asCode
            Integer iCount

            Move 'Procedure Split String sWork String sSep'               to asCode[0]
            Move '    Integer iFirst'                                     to asCode[1]
            Move '    Replace sSep in sWork with "$"'                     to asCode[2]
            Move '    Move strmark to iFirst // where the separator was'  to asCode[3]
            Move 'End_Procedure'                                          to asCode[4]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move (Pos(sSep, sWork)) to iFirst  // where the separator was' asCode[2]
            Send AssertSAreEqual '    Replace sSep in sWork with "$"'                                asCode[3]
        End_Procedure

        // A header continued over ';' lines: the local is declared after the LAST header line.
        { Published = True }
        Procedure ChangeStrMarkToExpression_HeaderContinuation_DeclarationFollowsIt
            String[] asCode
            Integer iCount

            Move 'Procedure Store String sA ;'               to asCode[0]
            Move '        String sB'                         to asCode[1]
            Move '    Move (Api(sA, sB)) to strmark'         to asCode[2]
            Move 'End_Procedure'                             to asCode[3]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual 'Procedure Store String sA ;'        asCode[0]
            Send AssertSAreEqual '        String sB'                  asCode[1]
            Send AssertSAreEqual '    Integer iVoid'                  asCode[2]
            Send AssertSAreEqual '    Move (Api(sA, sB)) to iVoid'    asCode[3]
        End_Procedure

        // Sysdate sets strmark to something no expression can state (the docs' own warning): a read
        // whose nearest setter is such a command is declined, naming it.
        { Published = True }
        Procedure ChangeStrMarkToExpression_OpaqueSetterBetween_Declined
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    Date dToday'                   to asCode[2]
            Move '    Pos " " in sName'              to asCode[3]
            Move '    Sysdate dToday'                to asCode[4]
            Move '    Move strmark to iPos'          to asCode[5]
            Move 'End_Procedure'                     to asCode[6]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[5] contains "TODO (DFRefactor)")
            Send Assert (asCode[5] contains "sysdate")
        End_Procedure

        // A second run over a marked line adds nothing: the marker IS the outcome.
        { Published = True }
        Procedure ChangeStrMarkToExpression_Marker_NotDuplicatedOnRerun
            String[] asCode
            String sMarked
            Integer iCount

            Move 'Procedure ReadIt'              to asCode[0]
            Move '    Integer iPos'              to asCode[1]
            Move '    Move strmark to iPos'      to asCode[2]
            Move 'End_Procedure'                 to asCode[3]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Move asCode[2] to sMarked
            Send Assert (sMarked contains "TODO (DFRefactor)")
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertSAreEqual sMarked asCode[2]
        End_Procedure

        // Two reads of one Pos: both derive from it (the first read does not change the operands).
        { Published = True }
        Procedure ChangeStrMarkToExpression_TwoReadsOfOnePos_BothConvert
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iA iB'                 to asCode[1]
            Move '    Pos " " in sName'              to asCode[2]
            Move '    Move strmark to iA'            to asCode[3]
            Move '    Move strmark to iB'            to asCode[4]
            Move 'End_Procedure'                     to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iA' asCode[3]
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iB' asCode[4]
        End_Procedure

        // Mid with a length only TAKES strmark as its start (measured) and leaves it: it is no
        // producer for strmark, so a read after it has no string command to derive from.
        { Published = True }
        Procedure ChangeStrMarkToExpression_MidWithLengthOnly_TakesStrMarkAndSetsNothing
            String[] asCode
            Integer iCount

            Move 'Procedure Cut String sText'        to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    String sPart'                  to asCode[2]
            Move '    Mid sText to sPart 5'          to asCode[3]
            Move '    Move strmark to iPos'          to asCode[4]
            Move 'End_Procedure'                     to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '    Mid sText to sPart 5' asCode[3]
            Send Assert (asCode[4] contains "no string command")
        End_Procedure

        // Mid with length AND start leaves the start in strmark (measured).
        { Published = True }
        Procedure ChangeStrMarkToExpression_MidWithStart_ReadBecomesTheStart
            String[] asCode
            Integer iCount

            Move 'Procedure Cut String sText Integer iFrom'   to asCode[0]
            Move '    Integer iPos'                           to asCode[1]
            Move '    String sPart'                           to asCode[2]
            Move '    Mid sText to sPart 5 (iFrom + 1)'       to asCode[3]
            Move '    Move strmark to iPos'                   to asCode[4]
            Move 'End_Procedure'                              to asCode[5]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move (iFrom + 1) to iPos' asCode[4]
        End_Procedure

        // Two methods in one file are independent: a scratch local in the first, a Pos read in the
        // second - and the line shift from the first method's declaration does not derail the second.
        { Published = True }
        Procedure ChangeStrMarkToExpression_TwoMethods_Independent
            String[] asCode
            Integer iCount

            Move 'Procedure First'                        to asCode[0]
            Move '    Move (Api()) to strmark'            to asCode[1]
            Move 'End_Procedure'                          to asCode[2]
            Move ''                                       to asCode[3]
            Move 'Procedure Second String sName'          to asCode[4]
            Move '    Integer iPos'                       to asCode[5]
            Move '    Pos " " in sName'                   to asCode[6]
            Move '    Move strmark to iPos'               to asCode[7]
            Move 'End_Procedure'                          to asCode[8]
            Get ChangeStrMarkToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 10 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Integer iVoid'                    asCode[1]
            Send AssertSAreEqual '    Move (Api()) to iVoid'            asCode[2]
            Send AssertSAreEqual '    Move (Pos(" ", sName)) to iPos'   asCode[8]
        End_Procedure

    End_Object
