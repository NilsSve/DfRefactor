//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangedLineCount-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-03
//
// Description : cRefactorUtilities.ChangedLineCount - the editor pass's measure of its own work.
//
//               It exists because the editor functions had no honest one: they returned Changed_State
//               ("is the document different from its last save point"), which after the file is loaded
//               into the control is true regardless of what the function did. The engine counted one per
//               FILE and the summary printed it as "lines". Nils, 2026-08-03, pinned it by running the
//               same workspace twice with ten lines un-indented in between - "25 lines Reindented code"
//               both times, 25 being the number of files.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangedLineCount is a cTestFixture
        Set psFunctionName to "ChangedLineCount"

        {Published = True}
        Procedure ChangedLines_IdenticalIsZero
            String[] asA asB
            Integer iCount
            Move "Send Foo" to asA[0]
            Move "    Send Bar" to asA[1]
            Move asA to asB
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // Indentation is a change. This is the exact case that reported zero for a whole run.
        {Published = True}
        Procedure ChangedLines_IndentCountsAsAChange
            String[] asA asB
            Integer iCount
            Move "Send Foo"     to asA[0]
            Move "Send Bar"     to asA[1]
            Move "Send Baz"     to asA[2]
            Move "    Send Foo" to asB[0]
            Move "    Send Bar" to asB[1]
            Move "Send Baz"     to asB[2]
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 2 iCount
        End_Procedure

        /* CASE-ONLY EDITS COUNT. EditorNormalizeCase changes nothing else, so a case-insensitive
           comparison here would report every one of its runs as zero work. DataFlex "=" on
           strings is case-sensitive, which is what makes this hold. */
        {Published = True}
        Procedure ChangedLines_CaseOnlyChangeCounts
            String[] asA asB
            Integer iCount
            Move "send foo of oBar" to asA[0]
            Move "Send Foo of oBar" to asB[0]
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 1 iCount
        End_Procedure

        // A line split into two: the differing line in the overlap plus the extra line.
        {Published = True}
        Procedure ChangedLines_AddedLinesCount
            String[] asA asB
            Integer iCount
            Move "If (bX) Send Foo" to asA[0]
            Move "If (bX) ;"        to asB[0]
            Move "    Send Foo"     to asB[1]
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 2 iCount
        End_Procedure

        {Published = True}
        Procedure ChangedLines_RemovedLinesCount
            String[] asA asB
            Integer iCount
            Move "Send Foo" to asA[0]
            Move ""         to asA[1]
            Move ""         to asA[2]
            Move "Send Foo" to asB[0]
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 2 iCount
        End_Procedure

        // Both empty, and one empty - no crash, no phantom count.
        {Published = True}
        Procedure ChangedLines_EmptyArrays
            String[] asA asB asC
            Integer iCount
            Get ChangedLineCount of ghoFuncLib asA asB to iCount
            Send AssertIAreEqual 0 iCount
            Move "Send Foo" to asC[0]
            Get ChangedLineCount of ghoFuncLib asA asC to iCount
            Send AssertIAreEqual 1 iCount
            Get ChangedLineCount of ghoFuncLib asC asA to iCount
            Send AssertIAreEqual 1 iCount
        End_Procedure

    End_Object
