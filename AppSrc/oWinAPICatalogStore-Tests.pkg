// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oWinAPICatalogStore is a cTestFixture
        Set psFunctionName to "cWinAPICatalogStore"

        // A scratch path in the workspace Data folder - never the real WinAPICatalog.json.
        Function _ScratchCatalogPath Returns String
            String sDataPath
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Function_Return (vFolderFormat(sDataPath) + "_WinAPICatalogTest.tmp")
        End_Function

        // A row's identity is its first N "|" fields: dll|entry for an API, the name alone for a
        // struct. Two rows with the same key are the same entry however their payload differs.
        {Published = True}
        Procedure WinAPIStore_RowKeyIsTheLeadingFields
            Handle ho
            String sKey
            Get Create (RefClass(cWinAPICatalogStore)) to ho
            Get _RowKey of ho "shell32.dll|SHBrowseForFolderW|STDAPI_(x) y(z);" 2 to sKey
            Send AssertSAreEqual "shell32.dll|shbrowseforfolderw|" sKey
            Get _RowKey of ho "BROWSEINFOW|{ HWND hwndOwner; }" 1 to sKey
            Send AssertSAreEqual "browseinfow|" sKey
            Send Destroy of ho
        End_Procedure

        // The file IS the catalogue: what it holds is what loads, verbatim.
        {Published = True}
        Procedure WinAPIStore_FileIsTheCatalogue
            Handle ho
            String sPath sProblem
            String[] asRows asOut
            Integer iRetval
            Get Create (RefClass(cWinAPICatalogStore)) to ho
            Get _ScratchCatalogPath to sPath
            Move "kernel32.dll|foo|PROTO-FROM-FILE" to asRows[0]
            Send WriteCatalog of ho asRows sPath
            Get LoadCatalog of ho sPath to asOut
            Get psLastProblem of ho to sProblem
            Send Destroy of ho
            Get vDeleteFile sPath to iRetval
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "kernel32.dll|foo|PROTO-FROM-FILE" asOut[0]
            Send AssertSAreEqual "" sProblem
        End_Procedure

        /* THE TEST THIS FIXTURE EXISTS FOR, now that the file is the only copy. An older format
           version must NOT cause a rewrite: with no compiled seed there is nothing to rewrite the
           file FROM, so rewriting it would destroy the very rows being asked for. The rows load as
           they are, the file is left alone, and the mismatch is reported. */
        {Published = True}
        Procedure WinAPIStore_OldVersionLoadsAndIsNotRewritten
            Handle ho
            String sPath sProblem
            String[] asOld asOut asReRead
            Integer iRetval
            Get Create (RefClass(cWinAPICatalogStore)) to ho
            Get _ScratchCatalogPath to sPath
            Move "user32.dll|MyOwnApi|PROTO-THE-USER-ADDED" to asOld[0]
            Send WriteCatalogAtVersion of ho asOld sPath 0
            Get LoadCatalog of ho sPath to asOut
            Get psLastProblem of ho to sProblem
            // ...and the file on disk still says version 0 with the row intact.
            Get LoadCatalog of ho sPath to asReRead
            Send Destroy of ho
            Get vDeleteFile sPath to iRetval
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "user32.dll|MyOwnApi|PROTO-THE-USER-ADDED" asOut[0]
            Send AssertIAreEqual 1 (SizeOfArray(asReRead))
            Send Assert (sProblem <> "")
        End_Procedure

        /* A MISSING FILE MUST COMPLAIN. It degrades safely - every converter refuses an API it
           cannot find - but silently, and "no conversions" reads exactly like "nothing needed
           converting". That is the failure this records rather than swallows. */
        {Published = True}
        Procedure WinAPIStore_MissingFileIsReportedNotSwallowed
            Handle ho
            String sPath sProblem
            String[] asOut
            Integer iRetval
            Get Create (RefClass(cWinAPICatalogStore)) to ho
            Get _ScratchCatalogPath to sPath
            Get vDeleteFile sPath to iRetval
            Get LoadCatalog of ho sPath to asOut
            Get psLastProblem of ho to sProblem
            Send Destroy of ho
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (Pos("not found", sProblem) > 0)
        End_Procedure

        // No workspace resolved yet: empty path, empty catalogue, and a reason - never a file
        // written to whatever the current directory happens to be.
        {Published = True}
        Procedure WinAPIStore_EmptyPathIsReported
            Handle ho
            String sProblem
            String[] asOut
            Get Create (RefClass(cWinAPICatalogStore)) to ho
            Get LoadCatalog of ho "" to asOut
            Get psLastProblem of ho to sProblem
            Send Destroy of ho
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (sProblem <> "")
        End_Procedure

    End_Object
