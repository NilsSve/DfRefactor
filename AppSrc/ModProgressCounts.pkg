//
// Description : The rules for reading a modernization-progress entry's counts - what each number
//               means and what it is called. A leaf package: constants in, strings and structs out,
//               no objects and no state, so the core application, the FlexTron surfaces and the
//               test runner can all share one answer.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorConstants.h.pkg

/*
    Package:    ModProgressCounts.pkg
    Purpose:    One place for "what is this number", because four surfaces ask - the dashboard's
                progress tile, the history modal's table, its trend line and its clipboard export -
                and before this they each answered for themselves and had drifted apart.

    THE SPLIT (Nils 2026-09-15). A progress entry used to carry ONE count for two different things:
    the compiler's warnings and the source scanner's findings. After an Analyze Source over a
    workspace whose compile was clean, the tile read "796 warnings", of which not one was a warning.
    tModProgressEntry.iWarn is now the compiler's alone and iScan is the scanner's; the burn-down
    magnitude is their SUM, which is exactly what the single field used to hold, so no existing
    trend or sparkline moves.
*/

/* THE WORD FOR A SERIES' OWN COUNT. A compile lap is stored under its program name and counts the
   compiler's warnings; an Analyze Source lap is stored under the reserved CS_ModProgressDeepScanLabel
   and counts findings. Used by the trend line and the clipboard export, which report one series at a
   time. (The table and the tile show both numbers side by side and name each one outright.) */
Function ModProgressCountNoun Global String sProgram Returns String
    If (sProgram = CS_ModProgressDeepScanLabel) ;
        Function_Return "findings"
    Function_Return "warnings"
End_Function

/* BACK-FILL ONE ENTRY READ FROM AN OLDER FILE, where iScan did not exist and iWarn held both
   numbers added together. Called by ReadModProgress on every entry, so no other reader has to
   know the file ever had another shape.

   A scan lap has no compiler warnings BY CONSTRUCTION - the analyzer tallies a scan finding into
   its own counter and never into the warning one - so an old scan row's iWarn IS its finding
   count, and moving it across recovers the row exactly. An old COMPILE row cannot be split after
   the fact: if pending findings were merged into that analysis they are already inside iWarn with
   nothing to separate them by. It is left as it is, which is what it always claimed to be, and
   the one thing not worth doing about it is guessing.

   Safe to run on a NEW entry: a new scan row has iWarn 0, so the move is a no-op. */
Function ModProgressBackFilledEntry Global tModProgressEntry E Returns tModProgressEntry
    If (E.sProgram = CS_ModProgressDeepScanLabel and E.iScan = 0) Begin
        Move E.iWarn to E.iScan
        Move 0       to E.iWarn
    End
    Function_Return E
End_Function

// What a lap was burning down, all of it - the magnitude the trend line and the sparkline plot.
// Identical to what the single iWarn field held before the split, for an old row and a new one
// alike, which is why no existing burn-down gets a step in it.
Function ModProgressTotalCount Global tModProgressEntry E Returns Integer
    Function_Return (E.iWarn + E.iScan)
End_Function
