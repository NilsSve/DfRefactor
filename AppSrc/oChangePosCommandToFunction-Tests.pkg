    Object oChangePosCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangePosCommandToFunction"

        {Published = True}
        Procedure ChangePosCommandToFunction_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Pos "-"  in sIns to iPos' to sLine
            Move 'Move (Pos("-",sIns)) to iPos' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangePosCommandToFunction_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   If (iA <> iB) Pos "   "  in sIns to iPos // End comment' to sLine
            Move '   If (iA <> iB) Move (Pos("   ",sIns)) to iPos // End comment' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Line with no Pos command must be returned unchanged and return False.
        {Published = True}
        Procedure ChangePosCommandToFunction_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move x to y" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move x to y" sLine
        End_Procedure

        // Variable arguments (not string literals); also verifies bChanged = True.
        {Published = True}
        Procedure ChangePosCommandToFunction_VariableArgs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Pos sDelim in sValue to iPos" to sLine
            Move "Move (Pos(sDelim,sValue)) to iPos" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // No-destination Pos (legacy [Found] side-effect form, e.g. inside a 'While [Found]') has no
        // 'to <dest>' to write into - it must be LEFT untouched, never converted to a dangling 'Move (...) to'
        // (LegacyApp OVRV0410.PKG regression).
        {Published = True}
        Procedure ChangePosCommandToFunction_NoDestKept
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Pos " " in strSOKTEXT' to sLine
            // Without the line pass's look-ahead nothing below can be checked: never converted.
            Send _ResetLookAhead
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Pos " " in strSOKTEXT' sLine
        End_Procedure


        // The look-ahead off again, so no later test sees this one's source.
        Procedure _ResetLookAhead
            String[] asNone
            Set pasLinePassSource of ghoFuncLib to asNone
            Set pbLinePassSideProducts of ghoFuncLib to False
            Set piLinePassIndex of ghoFuncLib to -1
        End_Procedure

        // Pos with no 'to', nothing below reading strmark or strlen (ChangeStrMarkToExpression has rewritten
        // them): only Found is left, and the function form sets it. From a Data Access report (2026-11-27),
        // where the line stayed legacy - warning 4531 - for good.
        { Published = True }
        Procedure ChangePosCommandToFunction_NoDestBecomesFound
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Pos '.' in sFileName"                                                to asCode[0]
            Move "    If (Pos('.', sFileName) > 0) Begin"                                  to asCode[1]
            Move "        Function_Return (Right(sFileName, Length(sFileName) - Pos('.', sFileName)))" to asCode[2]
            Move "    End"                                                                 to asCode[3]
            Move "    Function_Return ''"                                                  to asCode[4]
            Move "End_Function"                                                            to asCode[5]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send _ResetLookAhead
            Send Assert bChanged
            Send AssertSAreEqual "    Move (Pos('.', sFileName) > 0) to Found" sLine
        End_Procedure

        // ...but while strmark is still read below, the command is what sets it: the line stays.
        { Published = True }
        Procedure ChangePosCommandToFunction_NoDestStrMarkReadBelowKept
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Pos '.' in sFileName"                          to asCode[0]
            Move "    If (strmark > 0) Begin"                        to asCode[1]
            Move "        Function_Return (Left(sFileName, strmark - 1))" to asCode[2]
            Move "    End"                                           to asCode[3]
            Move "End_Function"                                      to asCode[4]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send _ResetLookAhead
            Send AssertSAreEqual "    Pos '.' in sFileName" (Left(sLine, 24))
        End_Procedure

        // A string text with " in " in it is no keyword: the needle is the whole literal.
        { Published = True }
        Procedure ChangePosCommandToFunction_NoDestInInsideTheNeedle
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  Pos " in " in sText'  to asCode[0]
            Move '  If (Found) Send Hit'  to asCode[1]
            Move 'End_Procedure'          to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send _ResetLookAhead
            Send Assert bChanged
            Send AssertSAreEqual '  Move (Pos(" in ", sText) > 0) to Found' sLine
        End_Procedure

    End_Object
