    Object oFunctionReturnMismatchReport is a cTestFixture
        Set psFunctionName to "FunctionReturnMismatchReport"

        // Harvests a Function declaration's name + return type (the token after Returns).
        { Published = True }
        Procedure RetMismatch_HarvestsFunctionReturnType
            String[] asLines
            tNameDecl[] aDecls
            Move 'Function Value Variant vKey Returns Variant' to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'Value'    aDecls[0].sName
            Send AssertSAreEqual 'Function' aDecls[0].sKind
            Send AssertSAreEqual 'Variant'  aDecls[0].sReturnType
            Send Assert (aDecls[0].iLine = 1)
        End_Procedure

        // A Property's type sits BEFORE the name (Property <type> <name>).
        { Published = True }
        Procedure RetMismatch_HarvestsProperty
            String[] asLines
            tNameDecl[] aDecls
            Move 'Property String pbSilent False' to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'pbSilent' aDecls[0].sName
            Send AssertSAreEqual 'Property' aDecls[0].sKind
            Send AssertSAreEqual 'String'   aDecls[0].sReturnType
        End_Procedure

        // A Function with no Returns clause registers as (untyped) - part of the same ambiguity class.
        { Published = True }
        Procedure RetMismatch_UntypedFunction
            String[] asLines
            tNameDecl[] aDecls
            Move 'Function DoThing Integer iArg' to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual '(untyped)' aDecls[0].sReturnType
        End_Procedure

        // Register_Function is always global; its return type is read the same way.
        { Published = True }
        Procedure RetMismatch_RegisterFunctionIsGlobal
            String[] asLines
            tNameDecl[] aDecls
            Move 'Register_Function Bar String s Returns Integer' to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'Bar'     aDecls[0].sName
            Send AssertSAreEqual 'Integer' aDecls[0].sReturnType
            Send Assert (aDecls[0].bGlobal = True)
        End_Procedure

        // A #COMMAND macro TEMPLATE (function !1 ... returns !2) is not a real declaration - the "!"
        // placeholders would otherwise mint a phantom "!1" collision (VDFQuery .nui/.utl files). The
        // "!" is built via Character(33): a literal "!" in a .pkg string trips the compiler's own macro
        // preprocessor (error 4337), the same reason #COMMAND tokens are Character()-built.
        { Published = True }
        Procedure RetMismatch_SkipsMacroPlaceholders
            String[] asLines
            String sBang
            tNameDecl[] aDecls
            Move (Character(33)) to sBang
            Move ('function ' + sBang + '1 integer liRow returns ' + sBang + '2') to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "array.nui" to aDecls
            Send Assert (SizeOfArray(aDecls) = 0)
        End_Procedure

        // Function_Return, a Get/Move CALL of the name, and other statements are NOT declarations.
        { Published = True }
        Procedure RetMismatch_SkipsCallsAndReturns
            String[] asLines
            tNameDecl[] aDecls
            Move 'Function_Return sVal'          to asLines[0]
            Move 'Get Value of oX to yVal'       to asLines[1]
            Move 'Move (Value(Self)) to zVal'    to asLines[2]
            Move '// Function Value returns ...' to asLines[3]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 0)
        End_Procedure

        // THE LegacyApp case: three Value declarations disagreeing on the return type (Variant / Number)
        // -> one contested name. This is what turns ~765 call sites into 4544 errors under DF 25/26.
        { Published = True }
        Procedure RetMismatch_DetectsValueCollision
            String[] asLines asColliding
            tNameDecl[] aDecls
            Move 'Function Value Variant vKey Returns Variant' to asLines[0]
            Move 'Function Value String sKey Returns Variant'  to asLines[1]
            Move 'Function Value String sKey Returns Number'   to asLines[2]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 1)
            Send AssertSAreEqual 'Value' asColliding[0]
        End_Procedure

        // THE other LegacyApp case: pbSilent declared String in one place, Boolean in another.
        { Published = True }
        Procedure RetMismatch_DetectsPbSilentCollision
            String[] asLines asColliding
            tNameDecl[] aDecls
            Move 'Property String pbSilent False'  to asLines[0]
            Move 'Property Boolean pbSilent False' to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 1)
            Send AssertSAreEqual 'pbSilent' asColliding[0]
        End_Procedure

        // A name declared consistently (same type everywhere) is NOT a collision - the common case
        // that keeps the report low-noise (piWidth is Integer in a hundred objects, never flagged).
        { Published = True }
        Procedure RetMismatch_ConsistentTypeNotFlagged
            String[] asLines asColliding
            tNameDecl[] aDecls
            Move 'Property Integer piWidth 0' to asLines[0]
            Move 'Property Integer piWidth 0' to asLines[1]
            Move 'Property Integer piWidth 5' to asLines[2]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 0)
        End_Procedure

        // --- Second pass: expression-call-site counting (ERRORING vs LATENT) ---

        // The expression form "Value(" is counted; the statement form "Get Value of obj" is NOT (it
        // does not provoke 4544). A suffix like MyValue( must not match the target "value".
        { Published = True }
        Procedure RetMismatch_CountsExpressionCallsOnly
            String[] asLines asTargets
            Integer[] aiCounts
            Move 'Move (Value(Self)) to xVal'      to asLines[0]
            Move 'Get Value of oObj to yVal'       to asLines[1]
            Move 'If (oList.Value(iKey) = 3) Begin' to asLines[2]
            Move 'Move (MyValue(z)) to wVal'       to asLines[3]
            Move 'value' to asTargets[0]
            Get _CountNameCallsInLines of ghoFuncLib asLines asTargets to aiCounts
            // Line 0 (Value(Self)) + line 2 (.Value(iKey)) = 2; the Get-of form and MyValue( do not count.
            Send Assert (aiCounts[0] = 2)
        End_Procedure

        // A property used in an expression counts too (pbSilent(Self)); a bare "(" with no identifier
        // before it (a grouping paren) is ignored.
        { Published = True }
        Procedure RetMismatch_CountsPropertyExpressionAndIgnoresBareParen
            String[] asLines asTargets
            Integer[] aiCounts
            Move 'If (pbSilent(Self)) Procedure_Return' to asLines[0]
            Move 'Move (1 + 2) to iSum'                 to asLines[1]
            Move 'pbsilent' to asTargets[0]
            Get _CountNameCallsInLines of ghoFuncLib asLines asTargets to aiCounts
            Send Assert (aiCounts[0] = 1)
        End_Procedure

        // A name that only appears in statement form / declarations has ZERO expression calls = LATENT.
        { Published = True }
        Procedure RetMismatch_LatentHasZeroCalls
            String[] asLines asTargets
            Integer[] aiCounts
            Move 'Set constraint_val to "x"'        to asLines[0]
            Move 'Get constraint_val to sTmp'       to asLines[1]
            Move 'Property String constraint_val ""' to asLines[2]
            Move 'constraint_val' to asTargets[0]
            Get _CountNameCallsInLines of ghoFuncLib asLines asTargets to aiCounts
            Send Assert (aiCounts[0] = 0)
        End_Procedure

        // A "(" inside a string literal or comment is masked out - not counted.
        { Published = True }
        Procedure RetMismatch_IgnoresCallsInStringsAndComments
            String[] asTargets asLines
            Integer[] aiCounts
            Move ('Move "Value(x) in a string" to sTmp')  to asLines[0]
            Move '// Value(y) in a comment'               to asLines[1]
            Move 'value' to asTargets[0]
            Get _CountNameCallsInLines of ghoFuncLib asLines asTargets to aiCounts
            Send Assert (aiCounts[0] = 0)
        End_Procedure

        // --- Third pass: the declarations the TARGET DataFlex itself ships ---

        // THE TRAP, pinned. Nils, 2026-07-22: "DF 25 is fine with using (Value(oObject... syntaxes."
        // Right - the call sites are innocent. But the fix everyone reaches for first is to make the
        // offending library agree with ITSELF, and that changes nothing: DataFlex declares Value as
        // String in nine of its own packages, and its side cannot be moved. Here the two workspace
        // declarations agree perfectly (one distinct type -> no collision reported), and the name still
        // 4544s the moment DataFlex's own declaration is in the set. Which is exactly why the report
        // reads the install packages: without them it would recommend the change that does not work.
        { Published = True }
        Procedure RetMismatch_OwnDeclsAgreeingStillCollideWithDataFlex
            String[] asOwn asDf asColliding
            tNameDecl[] aOwn aDf aBoth
            Integer i iLast

            Move 'Function Value String sKey Returns Variant'  to asOwn[0]
            Move 'Function Value Variant vKey Returns Variant' to asOwn[1]
            Get _NameDeclsFromLines of ghoFuncLib asOwn "cHashTable.pkg" to aOwn
            // The workspace on its own looks consistent - ONE return type, nothing to report.
            Get _CollidingNames of ghoFuncLib aOwn to asColliding
            Send Assert (SizeOfArray(asColliding) = 0)
            // Add what DataFlex declares for the same name, as InstallNameDeclsForNames harvests it.
            Move 'Function Value Integer iItem Returns String' to asDf[0]
            Get _NameDeclsFromLines of ghoFuncLib asDf "cBaseDEO.pkg" to aDf
            Move aOwn to aBoth
            Move (SizeOfArray(aDf) - 1) to iLast
            For i from 0 to iLast
                Move aDf[i] to aBoth[SizeOfArray(aBoth)]
            Loop
            Get _CollidingNames of ghoFuncLib aBoth to asColliding
            Send Assert (SizeOfArray(asColliding) = 1)
            Send AssertSAreEqual 'Value' asColliding[0]
        End_Procedure

        // Distinct TYPES, not declarations: Variant twice + Number once = 2, which is what the report
        // prints ("declared in 3 place(s), with 2 different return type(s)").
        { Published = True }
        Procedure RetMismatch_DistinctTypeCountCountsUniqueTypesOnly
            String[] asLines
            tNameDecl[] aDecls
            Integer iTypes
            Move 'Function Value String sKey Returns Variant'  to asLines[0]
            Move 'Function Value Variant vKey Returns Variant' to asLines[1]
            Move 'Function Value String sKey Returns Number'   to asLines[2]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _DistinctTypeCount of ghoFuncLib aDecls to iTypes
            Send Assert (iTypes = 2)
        End_Procedure

        // Picks every declaration of ONE name, case-insensitively, and leaves the others alone - the
        // per-name grouping the report's blocks are built from.
        { Published = True }
        Procedure RetMismatch_DeclsForNamePicksOnlyThatNameAnyCase
            String[] asLines
            tNameDecl[] aDecls aPicked
            Move 'Function Value String sKey Returns Variant'   to asLines[0]
            Move 'Function Sum String sKey Returns Number'      to asLines[1]
            Move 'Function VALUE Integer iItem Returns String'  to asLines[2]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _DeclsForName of ghoFuncLib aDecls "value" to aPicked
            Send Assert (SizeOfArray(aPicked) = 2)
            Send AssertSAreEqual 'Variant' aPicked[0].sReturnType
            Send AssertSAreEqual 'String'  aPicked[1].sReturnType
        End_Procedure

        // The install-scan pre-gate: hits on a DECLARATION of the needle, misses on a different name.
        { Published = True }
        Procedure RetMismatch_LinesDeclareAnyHitAndMiss
            String[] asLines asNeedles
            Boolean bHit
            Move 'Function Value Integer iItem Returns String' to asLines[0]
            Move 'Procedure Set Something Integer iArg'        to asLines[1]
            Move 'value' to asNeedles[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = True)
            Move 'pbsilent' to asNeedles[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = False)
        End_Procedure

        // THE reason the gate is declaration-shaped rather than a substring test. Every line here
        // mentions "value" - as a call, in a comment, as a parameter name - and not one of them could
        // yield a declaration. On the name Value that is most of the DataFlex install, so a mention-gate
        // would skip nothing and the install pass would cost a full uncached walk every time.
        { Published = True }
        Procedure RetMismatch_LinesDeclareAnyIgnoresMereMentions
            String[] asLines asNeedles
            Boolean bHit
            Move 'Move (Value(Self)) to sTmp'                to asLines[0]
            Move '// the value of the thing'                 to asLines[1]
            Move 'Get Value of oX to sTmp'                   to asLines[2]
            Move 'Procedure DoIt String sValue'              to asLines[3]
            Move 'value' to asNeedles[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = False)
        End_Procedure

        // An indented declaration still counts - real source is never flush left.
        { Published = True }
        Procedure RetMismatch_LinesDeclareAnyAcceptsIndentedDeclaration
            String[] asLines asNeedles
            Boolean bHit
            Move '        Function Value String sKey Returns Variant' to asLines[0]
            Move 'value' to asNeedles[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = True)
        End_Procedure

        // No needles = nothing to look for. Guards the caller that asks about an empty name set.
        { Published = True }
        Procedure RetMismatch_LinesDeclareAnyEmptyNeedlesIsFalse
            String[] asLines asNeedles
            Boolean bHit
            Move 'Function Value Integer iItem Returns String' to asLines[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = False)
        End_Procedure

        // Harvests Global Function/Procedure names from install-package lines; a non-Global function
        // (an ordinary class method) is NOT a shipped global name. Feeds the shared install walk.
        { Published = True }
        Procedure RetMismatch_HarvestsNativeGlobalNames
            String[] asLines asNames
            Move 'Function Utf8ToOem Global String sValue Returns String' to asLines[0]
            Move 'Procedure DoLocalThing Integer iArg'                    to asLines[1]
            Move 'Function ToANSI Global String sString Returns String'   to asLines[2]
            Get _GlobalFuncNamesFromLines of ghoFuncLib asLines to asNames
            Send Assert (SizeOfArray(asNames) = 2)
            Send AssertSAreEqual 'Utf8ToOem' asNames[0]
            Send AssertSAreEqual 'ToANSI'    asNames[1]
        End_Procedure

        /* The install's OWN list of compiler built-ins (Lib\GlobalFunctions.lst), which the harvest
           above structurally cannot see: those names are declared in no .pkg source, so a source walk
           finds 2 of the 85. Parsed here from lines rather than a file so it runs without an install.

           The awkward forms are the point: no parameters at all, several parameters, and a name whose
           return type the file omits - blank is recorded rather than guessed, because "unknown return
           type" and "returns nothing" are different facts. */
        { Published = True }
        Procedure RetMismatch_ParsesInstallBuiltInFunctionList
            String[] asLines
            tBuiltInFunc[] aFuncs

            Move 'Abs: (Real rValue) [Real]'                    to asLines[0]
            Move 'CurrentDateTime: () [DateTime]'               to asLines[1]
            Move 'Cast: (AnyType v, Type-name) [AnyType]'       to asLines[2]
            Move ''                                             to asLines[3]   // blank -> not an entry
            Move 'NoReturnStated: (Integer i)'                  to asLines[4]
            Get _BuiltInFuncsFromLines of ghoFuncLib asLines to aFuncs
            Send AssertIAreEqual 4 (SizeOfArray(aFuncs))
            Send AssertSAreEqual 'Abs'             aFuncs[0].sName
            Send AssertSAreEqual '(Real rValue)'   aFuncs[0].sParams
            Send AssertSAreEqual 'Real'            aFuncs[0].sReturns
            Send AssertSAreEqual 'CurrentDateTime' aFuncs[1].sName
            Send AssertSAreEqual '()'              aFuncs[1].sParams
            Send AssertSAreEqual 'DateTime'        aFuncs[1].sReturns
            Send AssertSAreEqual '(AnyType v, Type-name)' aFuncs[2].sParams
            // A line stating no return type records a BLANK one, not a guess.
            Send AssertSAreEqual 'NoReturnStated'  aFuncs[3].sName
            Send AssertSAreEqual ''                aFuncs[3].sReturns
        End_Procedure

        // An External_Function declaration is a declaration too. The 4390 "already defined as an
        // external_function" flavor (the WinInet pair, 2026-07-23) was invisible while these were
        // skipped - the guided row's Show declarations opened a report that named nothing.
        { Published = True }
        Procedure RetMismatch_HarvestsExternalFunction
            String[] asLines
            tNameDecl[] aDecls
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Handle hInternet DWord dwOption Pointer lpBuffer Pointer lpdwBufferLength Returns Boolean' to asLines[0]
            Get _NameDeclsFromLines of ghoFuncLib asLines "InternetOption.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'WinAPI_InternetQueryOption' aDecls[0].sName
            Send AssertSAreEqual 'External_Function'          aDecls[0].sKind
            Send AssertSAreEqual 'Boolean'                    aDecls[0].sReturnType
            Send Assert (aDecls[0].bGlobal = True)
        End_Procedure

        // DataFlex's own Pkg writes External_Functions one parameter per line, continued with ";" -
        // the Returns sits lines below the name. Followed down the chain; still anchored to line 1.
        { Published = True }
        Procedure RetMismatch_ExternalFunctionContinuationReturns
            String[] asLines
            tNameDecl[] aDecls

            Move 'External_Function WinAPI_InternetSetOption "InternetSetOptionW" WinInet.dll ;' to asLines[0]
            Move '    Handle hInternet ;'     to asLines[1]
            Move '    DWord dwOption ;'       to asLines[2]
            Move '    Pointer lpBuffer ;'     to asLines[3]
            Move '    DWord dwBufferLength ;' to asLines[4]
            Move '    Returns Integer'        to asLines[5]
            Get _NameDeclsFromLines of ghoFuncLib asLines "cHttpTransfer.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'WinAPI_InternetSetOption' aDecls[0].sName
            Send AssertSAreEqual 'Integer'                  aDecls[0].sReturnType
            Send Assert (aDecls[0].iLine = 1)
        End_Procedure

        // No ";" = no continuation: a Returns-shaped line BELOW an uncontinued declaration must not
        // be claimed by it.
        { Published = True }
        Procedure RetMismatch_NoContinuationNoReturnsLeak
            String[] asLines
            tNameDecl[] aDecls
            Move 'Function DoThing Integer iArg' to asLines[0]
            Move '    Returns Integer'           to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual '(untyped)' aDecls[0].sReturnType
        End_Procedure

        // The install pre-gate must let a package through on an External_Function line, or the
        // DataFlex side of a duplicate-external clash is never harvested at all.
        { Published = True }
        Procedure RetMismatch_LinesDeclareAnySeesExternalFunction
            String[] asLines asNeedles
            Boolean bHit
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionW" WinInet.dll ;' to asLines[0]
            Move 'winapi_internetqueryoption' to asNeedles[0]
            Get _LinesDeclareAny of ghoFuncLib asLines asNeedles to bHit
            Send Assert (bHit = True)
        End_Procedure


        /* ---- The Overloaded token -------------------------------------------------------------
           Measured against DF26 on 2026-08-23: two Overloaded declarations of one name with
           DIFFERENT return types compile, and an expression call against them resolves - no 4544.
           Strip the token from the same pair and the expression call raises "4544: Function
           GET_FOO with ambiguous return type used in expression". DataFlex overloads on PARAMETER
           COUNT, so with the token the compiler always knows which return type applies.

           Each guard test below is paired with a POSITIVE CONTROL on the identical declarations
           minus the token: a guard that silently swallowed real collisions would pass the negative
           half all by itself. */

        // The harvester records the token, and does not invent it.
        { Published = True }
        Procedure RetMismatch_HarvestsOverloadedToken
            String[] asLines
            tNameDecl[] aDecls
            Move "Function Foo Overloaded String sVal Returns String" to asLines[0]
            Move "Function Bar String sVal Returns String"            to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 2)
            Send Assert (aDecls[0].bOverloaded = True)
            Send AssertSAreEqual "Foo"    aDecls[0].sName
            Send AssertSAreEqual "String" aDecls[0].sReturnType
            Send Assert (aDecls[1].bOverloaded = False)
        End_Procedure

        // The three states, over a set already narrowed to one name.
        { Published = True }
        Procedure RetMismatch_OverloadedStateNoneAllMixed
            String[] asLines
            tNameDecl[] aDecls
            Integer iState

            Move "Function Foo Returns Integer"                       to asLines[0]
            Move "Function Foo String sVal Returns String"            to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _OverloadedState of ghoFuncLib aDecls to iState
            Send Assert (iState = CI_OverloadNone)

            Move "Function Foo Overloaded Returns Integer"            to asLines[0]
            Move "Function Foo Overloaded String sVal Returns String" to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _OverloadedState of ghoFuncLib aDecls to iState
            Send Assert (iState = CI_OverloadAll)

            Move "Function Foo Overloaded Returns Integer"            to asLines[0]
            Move "Function Foo String sVal Returns String"            to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _OverloadedState of ghoFuncLib aDecls to iState
            Send Assert (iState = CI_OverloadMixed)
        End_Procedure

        // THE GUARD: an all-Overloaded pair is not a 4544 - it cannot raise one.
        { Published = True }
        Procedure RetMismatch_OverloadedPairIsNotACollision
            String[] asLines
            tNameDecl[] aDecls
            String[] asColliding
            Move "Function Foo Overloaded Returns Integer"            to asLines[0]
            Move "Function Foo Overloaded String sVal Returns String" to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 0)
        End_Procedure

        // POSITIVE CONTROL for the test above: the SAME declarations without the token still collide.
        // Without this, a guard that dropped everything would look correct.
        { Published = True }
        Procedure RetMismatch_SamePairWithoutOverloadedStillCollides
            String[] asLines
            tNameDecl[] aDecls
            String[] asColliding
            Move "Function Foo Returns Integer"            to asLines[0]
            Move "Function Foo String sVal Returns String" to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 1)
            Send AssertSAreEqual "Foo" asColliding[0]
        End_Procedure

        // A MIXED set is error 4390, a real break - it must NOT be swallowed by the guard.
        { Published = True }
        Procedure RetMismatch_MixedOverloadedIsStillReported
            String[] asLines
            tNameDecl[] aDecls
            String[] asColliding
            Move "Function Foo Overloaded Returns Integer"  to asLines[0]
            Move "Function Foo String sVal Returns String"  to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames of ghoFuncLib aDecls to asColliding
            Send Assert (SizeOfArray(asColliding) = 1)
            Send AssertSAreEqual "Foo" asColliding[0]
        End_Procedure

        // _OverloadedNames names exactly what the guard drops - so the report can list it.
        { Published = True }
        Procedure RetMismatch_OverloadedNamesListsWhatWasDropped
            String[] asLines
            tNameDecl[] aDecls
            String[] asOvl
            Move "Function Foo Overloaded Returns Integer"            to asLines[0]
            Move "Function Foo Overloaded String sVal Returns String" to asLines[1]
            Move "Function Bar Returns Integer"                       to asLines[2]
            Move "Function Bar String sVal Returns String"            to asLines[3]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _OverloadedNames of ghoFuncLib aDecls to asOvl
            Send Assert (SizeOfArray(asOvl) = 1)
            Send AssertSAreEqual "Foo" asOvl[0]
        End_Procedure

        // One return type under an Overloaded name is not contested at all, so neither list holds it.
        { Published = True }
        Procedure RetMismatch_OverloadedSameTypeIsInNeitherList
            String[] asLines
            tNameDecl[] aDecls
            String[] asColliding asOvl
            Move "Function Foo Overloaded Returns String"             to asLines[0]
            Move "Function Foo Overloaded String sVal Returns String" to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _CollidingNames  of ghoFuncLib aDecls to asColliding
            Get _OverloadedNames of ghoFuncLib aDecls to asOvl
            Send Assert (SizeOfArray(asColliding) = 0)
            Send Assert (SizeOfArray(asOvl) = 0)
        End_Procedure

        // The line-level test both fixers use before they touch anything.
        { Published = True }
        Procedure RetMismatch_NameIsOverloadedInLines
            String[] asLines
            Boolean bOvl
            Move "Function Foo Overloaded String sVal Returns String" to asLines[0]
            Move "Function Bar String sVal Returns String"            to asLines[1]
            Get _NameIsOverloadedInLines of ghoFuncLib asLines "Foo" to bOvl
            Send Assert (bOvl = True)
            // POSITIVE CONTROL: a plain declaration in the SAME file does not answer True just
            // because some other function on the page is overloaded.
            Get _NameIsOverloadedInLines of ghoFuncLib asLines "Bar" to bOvl
            Send Assert (bOvl = False)
        End_Procedure

        // Align leaves an Overloaded declaration alone, and still retypes an ordinary one.
        { Published = True }
        Procedure RetMismatch_AlignSkipsOverloadedDeclaration
            String[] asLines
            Integer iChanged
            Move "Function Foo Overloaded Returns Integer" to asLines[0]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asLines) "Foo" "String" to iChanged
            Send Assert (iChanged = 0)
            Send AssertSAreEqual "Function Foo Overloaded Returns Integer" asLines[0]
            // POSITIVE CONTROL: the same rewrite on a non-overloaded declaration still happens.
            Move "Function Foo Returns Integer" to asLines[0]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asLines) "Foo" "String" to iChanged
            Send Assert (iChanged = 1)
            Send AssertSAreEqual "Function Foo Returns String" asLines[0]
        End_Procedure

        /* A GENERATED COM PROXY DECLARES NOTHING OF YOURS - the guard that was missing on
           2026-08-26, when ComItem was offered as a one-click rename and renamed 214 declarations
           across nine vendor packages (MSWORD.pkg, Excel9.pkg, msoutl.pkg, the Codejock wrapper),
           unresolving every "Set ComItem" in the workspace.

           These files sit in the workspace, so every declaration in them counted as one of the
           user's OWN, and a name DataFlex generates came out looking renameable. Harvest nothing
           from them and the rest follows: with no declarations of its own the name is neither
           renameable nor alignable, and the flow falls through to the call-site rewrite.

           TWO FILES, IDENTICAL BUT FOR THE MARKER LINE. That is the whole point - the zero below
           has to come from the marker and not from the content, which is what the positive control
           proves. An ABSOLUTE path in the workspace Data folder: a relative .pkg name resolves via
           the DataFlex SOURCE search path, not the cwd Direct_Output writes to (the trap the
           ModAnalyzer proxy test documents). */
        { Published = True }
        Procedure RetMismatch_ComProxyDeclarationsAreNotYours
            String sDataPath sProxy sPlain
            String[] asFiles
            Integer iProxy iPlain iRetval

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath) + "dfr_test_proxy_decls.pkg") to sProxy
            Move (vFolderFormat(sDataPath) + "dfr_test_plain_decls.pkg") to sPlain

            // The 4544 shape: ONE name, two return types.
            Direct_Output sProxy
            Writeln ("// " + CS_DFCOMProxyClasses + " C:\Somewhere\Some.ocx")
            Writeln "Function DfrTestContestedName Integer llIndex Returns Variant"
            Writeln "End_Function"
            Writeln "Function DfrTestContestedName Integer llIndex Returns String"
            Writeln "End_Function"
            Close_Output

            // The same pair, in an ordinary package - only the marker line differs.
            Direct_Output sPlain
            Writeln "// An ordinary workspace package."
            Writeln "Function DfrTestContestedName Integer llIndex Returns Variant"
            Writeln "End_Function"
            Writeln "Function DfrTestContestedName Integer llIndex Returns String"
            Writeln "End_Function"
            Close_Output

            Move sProxy to asFiles[0]
            Get FunctionReturnMismatchReport of ghoFuncLib (&asFiles) "" to iProxy
            Move (ResizeArray(asFiles, 0)) to asFiles
            Move sPlain to asFiles[0]
            Get FunctionReturnMismatchReport of ghoFuncLib (&asFiles) "" to iPlain

            Get vDeleteFile sProxy to iRetval
            Get vDeleteFile sPlain to iRetval

            // Nothing in a generated wrapper is a declaration of the user's, so nothing collides.
            Send AssertIAreEqual 0 iProxy
            // POSITIVE CONTROL: the identical pair in an ordinary file DOES collide. Without this
            // the test would still pass if the report had simply stopped finding anything at all.
            Send Assert (iPlain > 0)
        End_Procedure

        /* THE WRAPPER-CLASS CASE. A workspace that binds a Windows API usually declares the name
           TWICE: the External_Function, and a method of the class that wraps it. Requiring every
           declaration of yours to be an External_Function therefore failed exactly where the
           finding is most common - Prnt_dlg.pkg's PageSetupDlg - and the flow fell through to a
           rename that renamed the METHOD, leaving the real duplicate in place (2026-08-26). */
        {Published = True}
        Procedure DupExternal_MethodBesideTheDeclarationStillCounts
            tNameDecl[] aOwn aDf
            Boolean bDup
            Move "PageSetupDlg"      to aOwn[0].sName
            Move "External_Function" to aOwn[0].sKind
            Move "PageSetupDlg"      to aOwn[1].sName
            Move "Function"          to aOwn[1].sKind     // the wrapper class's method
            Move "PageSetupDlg"      to aDf[0].sName
            Move "External_Function" to aDf[0].sKind
            Get _IsDuplicateExternalPair of ghoFuncLib aOwn aDf to bDup
            Send Assert bDup
        End_Procedure

        // POSITIVE CONTROL: the plain case both sides External_Function still answers True, so a
        // pass above is the widened rule and not the function having stopped discriminating.
        {Published = True}
        Procedure DupExternal_PlainPairStillCounts
            tNameDecl[] aOwn aDf
            Boolean bDup
            Move "External_Function" to aOwn[0].sKind
            Move "External_Function" to aDf[0].sKind
            Get _IsDuplicateExternalPair of ghoFuncLib aOwn aDf to bDup
            Send Assert bDup
        End_Procedure

        // NONE of yours is an External_Function: nothing for a guard to wrap, so this is not the
        // duplicate-API flavour and the rename/align lanes are right to have it.
        {Published = True}
        Procedure DupExternal_MethodOnlyIsNotADuplicatePair
            tNameDecl[] aOwn aDf
            Boolean bDup
            Move "Function"          to aOwn[0].sKind
            Move "External_Function" to aDf[0].sKind
            Get _IsDuplicateExternalPair of ghoFuncLib aOwn aDf to bDup
            Send Assert (bDup = False)
        End_Procedure

        // DataFlex's side must be ALL External_Function - that is what says the name binds an API.
        // A DataFlex METHOD of the same name is a different collision entirely.
        {Published = True}
        Procedure DupExternal_DataFlexMethodIsNotAnApiDuplicate
            tNameDecl[] aOwn aDf
            Boolean bDup
            Move "External_Function" to aOwn[0].sKind
            Move "External_Function" to aDf[0].sKind
            Move "Function"          to aDf[1].sKind
            Get _IsDuplicateExternalPair of ghoFuncLib aOwn aDf to bDup
            Send Assert (bDup = False)
        End_Procedure

        /* CONDITIONAL ARMS (Nils 2026-09-20): the exact shape the wide guard writes - one name in the
           sibling arms of one #IF block, nested - reported as "3 declarations, 2 return types, align
           them". Only one arm compiles: it is ONE declaration, the last arm's. The directive words are
           built from Character(35) - a literal one in a .pkg string is consumed by FMAC. */
        {Published = True}
        Procedure CondArms_SiblingArmsOfOneBlockAreOneDeclaration
            String[] asLines
            tNameDecl[] aDecls
            Move (Character(35) + "IF (" + Character(33) + "@ < 191)")                          to asLines[0]
            Move (Character(35) + "IFDEF IS$WIN64")                                              to asLines[1]
            Move 'External_Function SetConsoleTitle "SetConsoleTitleA" Kernel32.dll String lpszTitle Returns Integer' to asLines[2]
            Move (Character(35) + "ELSE")                                                        to asLines[3]
            Move 'External_Function SetConsoleTitle "SetConsoleTitleA" Kernel32.dll String lpszTitle Returns Number'  to asLines[4]
            Move (Character(35) + "ENDIF")                                                       to asLines[5]
            Move (Character(35) + "ELSE")                                                        to asLines[6]
            Move 'External_Function SetConsoleTitle "SetConsoleTitleW" Kernel32.dll WString lpszTitle Returns Integer' to asLines[7]
            Move (Character(35) + "ENDIF")                                                       to asLines[8]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 1)
            Send AssertSAreEqual 'SetConsoleTitle' aDecls[0].sName
            Send AssertSAreEqual 'Integer'         aDecls[0].sReturnType
            Send Assert (aDecls[0].iLine = 8)          // the last arm stands for the block
        End_Procedure

        // POSITIVE CONTROL: the same two declarations with no arms around them are still two.
        {Published = True}
        Procedure CondArms_UnguardedTwinsStillCollide
            String[] asLines
            tNameDecl[] aDecls
            Move 'External_Function SetConsoleTitle "SetConsoleTitleA" Kernel32.dll String lpszTitle Returns Integer' to asLines[0]
            Move 'External_Function SetConsoleTitle "SetConsoleTitleA" Kernel32.dll String lpszTitle Returns Number'  to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 2)
        End_Procedure

        // A declaration OUTSIDE a block beside one INSIDE it: both can compile, so both stay. And two
        // blocks in sequence are different blocks - an arm of each is not an alternative of the other.
        {Published = True}
        Procedure CondArms_OutsideAndInsideAreTwo
            String[] asLines
            tNameDecl[] aDecls
            Move 'Function Split String sText Returns Integer'   to asLines[0]
            Move (Character(35) + "IFDEF IS$WIN64")               to asLines[1]
            Move 'Function Split String sText Returns String'    to asLines[2]
            Move (Character(35) + "ENDIF")                        to asLines[3]
            Move (Character(35) + "IFDEF IS$WIN64")               to asLines[4]
            Move 'Function Split String sText Returns Variant'   to asLines[5]
            Move (Character(35) + "ENDIF")                        to asLines[6]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Send Assert (SizeOfArray(aDecls) = 3)
        End_Procedure

        // The predicate on its own: shared block + different arm = alternatives; anything else not.
        {Published = True}
        Procedure CondArms_AlternativesPredicate
            Boolean bAlt
            Get _AreConditionalAlternatives of ghoFuncLib "0:0" "0:1" to bAlt
            Send Assert (bAlt = True)
            Get _AreConditionalAlternatives of ghoFuncLib "0:0/1:0" "0:0/1:1" to bAlt
            Send Assert (bAlt = True)
            Get _AreConditionalAlternatives of ghoFuncLib "0:0/1:0" "0:1" to bAlt
            Send Assert (bAlt = True)
            Get _AreConditionalAlternatives of ghoFuncLib "0:0" "0:0" to bAlt
            Send Assert (bAlt = False)
            Get _AreConditionalAlternatives of ghoFuncLib "" "0:0" to bAlt
            Send Assert (bAlt = False)
            Get _AreConditionalAlternatives of ghoFuncLib "0:0" "0:0/1:1" to bAlt
            Send Assert (bAlt = False)
            Get _AreConditionalAlternatives of ghoFuncLib "0:0" "1:0" to bAlt
            Send Assert (bAlt = False)
        End_Procedure

    End_Object
