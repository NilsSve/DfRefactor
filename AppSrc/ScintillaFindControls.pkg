//
// Description : The controls the Find, Replace and Goto dialogs are built from, plus the options
//               record those dialogs fill in and hand back to the editor.
//
//               Local to DFRefactor (Nils, 2026-07-27). This was half of the library's THDialog.pkg,
//               a name that said who wrote it rather than what it holds - and what it held was two
//               unrelated families of classes: these three Find controls, and the settings-dialog
//               controls that now live in ScintillaSettingsControls.pkg. Splitting them means each
//               file can be read on its own.
//
//               What the Find controls have in common, and the only reason they are subclasses at
//               all: each one swallows the pending hotkey before acting, so pressing the shortcut
//               that opened the dialog does not also ring the system bell.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Windows.pkg
Use RefactorMessageQueue.pkg   // DispatchHotkey

// Search direction, and what a replace applies to.
#IFNDEF FindUp
Define FindUp   For 0
Define FindDown For 1
Define ReplaceSelection For 0
Define ReplaceBuffer    For 1
#ENDIF

/* Everything a Find or Replace dialog asks for and answers with. The dialogs fill this
   in; the editor reads bStartFind / bReplaceAll to learn what the user actually asked
   for, and the three flag fields to set the search options. */
Struct tFindReplaceOptions
    String  sSearchText
    String  sReplaceText
    Boolean bWordMatch
    Boolean bMatchCase
    Boolean bRegExp
    Boolean bPreserveCase
    Integer eFindOptions      // FindUp / FindDown
    Boolean bDocumentStart    // search from the top rather than from the caret
    Boolean bStartFind
    Boolean bMarkAll
    Boolean bReplace
    Boolean bReplaceAll
    Boolean bCancel
End_Struct

Class cFindCheckBox is a CheckBox
    Procedure doToggle
        Boolean bState
        Send DispatchHotkey        // swallow the shortcut so it does not ring the bell
        Send Activate
        Get Checked_State to bState
        Set Checked_State to (not(bState))
    End_Procedure
End_Class

Class cFindForm is a Form
    Procedure Activate Returns Integer
        Integer iRetVal
        Send DispatchHotkey
        Forward Get msg_Activate to iRetVal
        Procedure_Return iRetVal
    End_Procedure
End_Class

/* The search-text combo. It remembers what has been searched for, most recent first,
   and re-selecting an old term moves it back to the top rather than duplicating it. */
Class cFindComboForm is a ComboForm
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Combo_Sort_State to False      // recency order, not alphabetical
        Property String[] pSearchStrings
    End_Procedure

    Procedure Activate Returns Integer
        Integer iRetVal
        Send DispatchHotkey
        Forward Get msg_Activate to iRetVal
        Procedure_Return iRetVal
    End_Procedure

    Procedure Combo_Fill_List
        Integer  iItem iCount
        String[] asSearchStrings

        Get pSearchStrings to asSearchStrings
        Move (SizeOfArray(asSearchStrings)) to iCount
        If (iCount = 0) ;
            Procedure_Return
        Send Combo_Delete_Data
        For iItem from 0 to (iCount - 1)
            Send Combo_Add_Item asSearchStrings[iItem]
        Loop
        Set Value to asSearchStrings[0]
    End_Procedure

    Procedure AddSearchString String sValue
        Integer  iIndex
        String[] asSearchStrings

        If (sValue = "") ;
            Procedure_Return
        Get pSearchStrings to asSearchStrings
        // Case-insensitive, and the comparator runs on Desktop - on Self it is not found.
        Move (SearchArray(sValue, asSearchStrings, Desktop, (RefFunc(DFSTRICMP)))) to iIndex
        If (iIndex > -1) ;
            Move (RemoveFromArray(asSearchStrings, iIndex)) to asSearchStrings
        Move (InsertInArray(asSearchStrings, 0, sValue)) to asSearchStrings
        Set pSearchStrings to asSearchStrings
    End_Procedure

    Procedure Set SearchValue String sValue
        If (sValue = "") ;
            Procedure_Return
        Send AddSearchString sValue
        Send Combo_Fill_List
    End_Procedure
End_Class
