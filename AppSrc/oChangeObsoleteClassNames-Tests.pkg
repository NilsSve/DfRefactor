    Object oChangeObsoleteClassNames is a cTestFixture
        Set psFunctionName to "ChangeObsoleteClassNames"

        // One line through the whole-file function.
        Function _Convert String sLine Returns String
            String[] asCode
            Integer iCount
            Move sLine to asCode[0]
            Get ChangeObsoleteClassNames of ghoFuncLib (&asCode) "" to iCount
            Function_Return asCode[0]
        End_Function

        // A file: declarations after a method, a block comment and the count of changed lines.
        {Published = True}
        Procedure ChangeObsoleteClassNames_File
            String[] asCode
            Integer iCount
            Move "Procedure Paint for dfPanel"          to asCode[0]
            Move "End_Procedure"                        to asCode[1]
            Move "/*"                                   to asCode[2]
            Move "Class cOld is a DFControl"            to asCode[3]
            Move "*/"                                   to asCode[4]
            Move "Class cMyControl is a DFControl"      to asCode[5]
            Move "End_Class"                            to asCode[6]
            Get ChangeObsoleteClassNames of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual "Procedure Paint for DfBasePanel" asCode[0]
            Send AssertSAreEqual "Class cOld is a DFControl" asCode[3]
            Send AssertSAreEqual "Class cMyControl is a DfBaseControl" asCode[5]
        End_Procedure

        // 'is a' / 'is an': the class and object declarations.
        {Published = True}
        Procedure ChangeObsoleteClassNames_IsA
            String sLine
            Get _Convert "Class cMyControl is a DFControl" to sLine
            Send AssertSAreEqual "Class cMyControl is a DfBaseControl" sLine
            Get _Convert "    Object oImageList is an ImageList" to sLine
            Send AssertSAreEqual "    Object oImageList is a DfBaseImageList" sLine
            Get _Convert "Object oLogin is a Message" to sLine
            Send AssertSAreEqual "Object oLogin is a cUIObject" sLine
            Get _Convert "class cDefaultPrinter is a BaseClass" to sLine
            Send AssertSAreEqual "class cDefaultPrinter is a cObject" sLine
            Get _Convert "Object TimerObj Is A  DFPanel" to sLine
            Send AssertSAreEqual "Object TimerObj Is A  DfBasePanel" sLine
        End_Procedure

        // The article follows the new name: 'is an' -> 'is a' in any case and spacing, a wrong 'an' in front of a
        // consonant included, and two renames on one line stay lined up.
        {Published = True}
        Procedure ChangeObsoleteClassNames_Article
            String sLine
            Get _Convert "OBJECT oImages IS AN ImageList" to sLine
            Send AssertSAreEqual "OBJECT oImages IS A DfBaseImageList" sLine
            Get _Convert "Object oImages Is An ImageList" to sLine
            Send AssertSAreEqual "Object oImages Is A DfBaseImageList" sLine
            Get _Convert "Object oImages is  an   ImageList" to sLine
            Send AssertSAreEqual "Object oImages is  a   DfBaseImageList" sLine
            Get _Convert ("Object oImages is" + Character(9) + "an" + Character(9) + "ImageList") to sLine
            Send AssertSAreEqual ("Object oImages is" + Character(9) + "a" + Character(9) + "DfBaseImageList") sLine
            Get _Convert "Class cMyList is an DFList" to sLine
            Send AssertSAreEqual "Class cMyList is a DfBaseList" sLine
            Get _Convert "Object oImages is an ImageList is an DFPanel" to sLine
            Send AssertSAreEqual "Object oImages is a DfBaseImageList is a DfBasePanel" sLine
        End_Procedure

        // A method header's 'for', RefClass() and U_ names.
        {Published = True}
        Procedure ChangeObsoleteClassNames_ForRefClassAndU
            String sLine
            Get _Convert "Procedure Paint for dfPanel" to sLine
            Send AssertSAreEqual "Procedure Paint for DfBasePanel" sLine
            Get _Convert "Get Create (RefClass(DFObject)) to hoObj" to sLine
            Send AssertSAreEqual "Get Create (RefClass(DfBaseObject)) to hoObj" sLine
            Get _Convert "Get Create U_ImageList to hoImages" to sLine
            Send AssertSAreEqual "Get Create U_DfBaseImageList to hoImages" sLine
            Get _Convert "Move (U_Desktop = U_BaseClass) to bSame" to sLine
            Send AssertSAreEqual "Move (U_cObject = U_cObject) to bSame" sLine
        End_Procedure

        // Current classes, names that only contain an old one, a string, a comment and the method
        // converter's 'for Desktop' stay as they are.
        {Published = True}
        Procedure ChangeObsoleteClassNames_LeavesTheRest
            String[] asLines
            String sLine
            Integer i
            Boolean bAny
            Move "Object oImages is a cImageList"           to asLines[0]
            Move "Class cMessageBox is a ModalPanel"        to asLines[1]
            Move 'Move "is a Message" to sText'             to asLines[2]
            Move "// Object oX is a DFControl"              to asLines[3]
            Move "Procedure Close for Desktop"              to asLines[4]
            Move "Send Message_Box sMessage"                to asLines[5]
            Move "Move U_cObject to iClass"                 to asLines[6]
            Move False to bAny
            For i from 0 to (SizeOfArray(asLines) - 1)
                Get _Convert asLines[i] to sLine
                If (sLine <> asLines[i]) ;
                    Move True to bAny
            Loop
            Send AssertFalse bAny
        End_Procedure

    End_Object
