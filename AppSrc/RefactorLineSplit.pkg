//****************************************************************************
// $Module type: Package
// $Module name: RefactorLineSplit
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-28
//
// Description : Split a delimited string into its parts.
//
//               WHAT IT REPLACES. SciControlLib's cLineParser.pkg - 244 lines, and a class derived
//               from the legacy Array class, so using it meant Create, set a property, Send, read back
//               through Item_Count and "Value Item n", then Destroy_Object. Six lines and an object
//               lifetime to split a string.
//
//               That file is a real parser and most of it is genuinely clever: a language-token mode
//               that understands DataFlex comments, indicators, strings and bracket nesting, and a
//               skip-sequence so a separator of "\" does not chop a UNC prefix in half. DFRefactor
//               used none of it. Both call sites - the identical LoadElementString in
//               cRefactorScintillaEditor.pkg and ScintillaParameters.dg - set a separator and read the
//               plain parts back out.
//
//               So this is the plain path, as a function, and the language-token mode stays behind in
//               the library where the Hammer can go on using it.
//
//               FAITHFUL TO ParseLineStd, INCLUDING ITS EDGE CASES, which is why this is not simply a
//               call to DataFlex's StrSplitToArray:
//
//                 * A TRAILING SEPARATOR PRODUCES NO EMPTY PART. The original loops "Until the line is
//                   empty", so "a,b," yields two parts, not three. StrSplitToArray yields three. That
//                   difference would quietly add a blank language element or keyword.
//                 * Empty parts BETWEEN separators are kept - "a,,b" is three parts, the middle one
//                   empty. Only a trailing one disappears, and only because the loop ends.
//                 * A SPACE separator left-trims what remains after each part, so runs of spaces
//                   collapse rather than producing a string of empties.
//                 * Nothing is trimmed otherwise. The parts come back as they were written.
//
//               The original's 500-iteration escape hatch is not carried over. It existed because the
//               loop could fail to consume anything and spin forever; this one always removes the part
//               it just read, so the line strictly shrinks and the loop always ends.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use Windows.pkg

/* The parts of sLine, split on sSeparator. See the header for exactly which edge cases
   this reproduces - they are the reason it is not StrSplitToArray. */
Function RefactorSplitLine Global String sLine String sSeparator Returns String[]
    Boolean bSpaceSep
    Integer iPos iSepLen iAt
    String  sPart
    String[] asParts

    Move (Length(sSeparator)) to iSepLen
    If (iSepLen = 0 or sLine = "") ;
        Function_Return asParts
    Move (sSeparator = " ") to bSpaceSep

    Repeat
        Move (Pos(sSeparator, sLine)) to iPos
        If (iPos = 0) ;
            Move (Length(sLine)) to iPos            // no separator left: the rest is one part

        Move (Left(sLine, iPos + iSepLen - 1)) to sPart
        Move (Replace(sPart, sLine, "")) to sLine   // Replace = FIRST occurrence only
        If (Right(sPart, iSepLen) = sSeparator) ;
            Move (Left(sPart, Length(sPart) - iSepLen)) to sPart
        If (bSpaceSep) ;
            Move (LTrim(sLine)) to sLine

        Move sPart to asParts[-1]
//        Move (SizeOfArray(asParts)) to iAt
//        Move sPart to asParts[iAt]
    Until (sLine = "")

    Function_Return asParts
End_Function

/* Split a delimited string and APPEND the parts to an existing array.
   This was a Procedure LoadElementString duplicated character-for-character in
   cRefactorScintillaEditor.pkg and ScintillaParameters.dg - both filling a tSCLanguage
   from the stored language definition. Appending rather than replacing is deliberate and
   is what both callers relied on: a tSCLanguage is filled field by field, and a caller
   may add to an array that already holds something. */
Procedure RefactorAppendSplitLine Global String sLine String sSeparator String[] ByRef saTarget
    Integer iCount iSize //iAt
    String[] asParts

    Get RefactorSplitLine sLine sSeparator to asParts
    Move (SizeOfArray(asParts) -1) to iSize
    For iCount from 0 to iSize
//    For iC from 0 to (SizeOfArray(asParts) - 1)
        Move asParts[iCount] to saTarget[-1]
//        Move (SizeOfArray(saTarget)) to iAt
//        Move asParts[iC] to saTarget[iAt]
    Loop
End_Procedure
