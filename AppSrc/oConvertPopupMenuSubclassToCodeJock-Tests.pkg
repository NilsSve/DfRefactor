//****************************************************************************
// $Module type: Test fixture
// $Module name: oConvertPopupMenuSubclassToCodeJock-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-05
//
// Description : Unit tests for a workspace subclass of FloatingPopupMenu -> a subclass of
//               cCJContextMenu, in place: the class emitter, the Check's verdict and the in-file walk.
//
//               The first shape is the one read out of a test workspace: an EMPTY subclass that a
//               tree view creates at run time and fills through Add_Item. The emitter's output for
//               it - and for a class that adds its items in its own constructor - is compared line
//               for line with PopupSubclassPortedFixture.pkg, which the test runner COMPILES; the
//               last tests then use those compiled classes. So what the converter writes is not
//               only text that looks right: it has been through the compiler, its Add_Item makes
//               items, and a chosen item's message arrives.
//
//               What a test here cannot show is the popup on the screen - that takes a window, a
//               cCJCommandBarSystem and a right click.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oConvertPopupMenuSubclassToCodeJock_Tests is a cTestFixture
        Set psFunctionName to "ConvertPopupMenuSubclassToCodeJock"

        // What the two test messages count - see FixPopupHitOne / FixPopupHitTwo.
        Property Integer piPopupHitOne 0
        Property Integer piPopupHitTwo 0

        // The class block through the emitter, with line 0 as its file position.
        Function Ported String[] asBlock String ByRef sWhyNot Returns String[]
            String[] asOut
            Boolean bOK
            Get _CJPopupClassToContextMenu of ghoFuncLib (&asBlock) 0 (&asOut) (&sWhyNot) to bOK
            Function_Return asOut
        End_Function

        // True when one of asLines, trimmed, is exactly sWant.
        Function HasLine String[] asLines String sWant Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asLines) - 1)
                If ((Trim(asLines[i])) = sWant) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // The index of the first line (trimmed) equal to sWant, -1 when none - for ORDER assertions.
        Function LineAt String[] asLines String sWant Returns Integer
            Integer i
            For i from 0 to (SizeOfArray(asLines) - 1)
                If ((Trim(asLines[i])) = sWant) ;
                    Function_Return i
            Loop
            Function_Return -1
        End_Function

        Function Joined String[] asLines Returns String
            String sOut
            Integer i
            Move "" to sOut
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move (sOut + asLines[i] + "|") to sOut
            Loop
            Function_Return sOut
        End_Function

        // The lines of the compiled fixture between its '// >>> <tag>' and '// <<< <tag>' lines.
        Function FixtureRegion String sTag Returns String[]
            String[] asAll asOut
            String sPath
            Integer i iSemi
            Boolean bIn

            Get psAppSrcPath of (phoWorkspace(ghoApplication)) to sPath
            Move (Pos(";", sPath)) to iSemi
            If (iSemi > 0) ;
                Move (Left(sPath, (iSemi - 1))) to sPath
            Move (vFolderFormat(sPath) + "PopupSubclassPortedFixture.pkg") to sPath
            Move (rfReadEncodedFileAsStringArray(sPath)) to asAll
            Move False to bIn
            For i from 0 to (SizeOfArray(asAll) - 1)
                If ((Trim(asAll[i])) = ("// <<< " + sTag)) ;
                    Move False to bIn
                If (bIn = True) ;
                    Move asAll[i] to asOut[-1]
                If ((Trim(asAll[i])) = ("// >>> " + sTag)) ;
                    Move True to bIn
            Loop
            Function_Return asOut
        End_Function

        // "" when the two are the same line for line; otherwise where they first part.
        Function FirstDifference String[] asGot String[] asWant Returns String
            Integer i iGot iWant

            Move (SizeOfArray(asGot))  to iGot
            Move (SizeOfArray(asWant)) to iWant
            If (iWant = 0) ;
                Function_Return "the fixture region was not found - PopupSubclassPortedFixture.pkg could not be read from AppSrc"
            For i from 0 to ((iGot max iWant) - 1)
                If (i >= iGot) ;
                    Function_Return ("line " + String(i + 1) + ": the converter stops here, the fixture goes on with '" + asWant[i] + "'")
                If (i >= iWant) ;
                    Function_Return ("line " + String(i + 1) + ": the fixture stops here, the converter goes on with '" + asGot[i] + "'")
                If (asGot[i] <> asWant[i]) ;
                    Function_Return ("line " + String(i + 1) + ": the converter writes '" + asGot[i] + "', the fixture has '" + asWant[i] + "'")
            Loop
            Function_Return ""
        End_Function

        // The two messages the compiled menus' items send.
        Procedure FixPopupHitOne
            Set piPopupHitOne to (piPopupHitOne(Self) + 1)
        End_Procedure

        Procedure FixPopupHitTwo
            Set piPopupHitTwo to (piPopupHitTwo(Self) + 1)
        End_Procedure

        // The shape read out of the workspace: an empty subclass, both constructors only forwarding.
        Function EmptySubclass Returns String[]
            String[] asBlock
            Move 'Class cFixPopupMenu is a FloatingPopupMenu'   to asBlock[0]
            Move '    Procedure Construct_Object'               to asBlock[1]
            Move '        Forward Send Construct_Object'        to asBlock[2]
            Move ''                                             to asBlock[3]
            Move '    End_Procedure'                            to asBlock[4]
            Move '    Procedure End_Construct_Object'           to asBlock[5]
            Move '        Forward Send End_Construct_Object'    to asBlock[6]
            Move '    End_Procedure'                            to asBlock[7]
            Move 'End_Class'                                    to asBlock[8]
            Function_Return asBlock
        End_Function

        // A class that adds its items in its own constructor: the lines stay and reach the new Add_Item.
        Function FilledSubclass Returns String[]
            String[] asBlock
            Move 'Class cFixFilledPopupMenu is a FloatingPopupMenu'   to asBlock[0]
            Move '    Procedure Construct_Object'                     to asBlock[1]
            Move '        Forward Send Construct_Object'              to asBlock[2]
            Move '        Send Add_Item msg_FixPopupHitOne "One"'     to asBlock[3]
            Move '        Send Add_Item Msg_None ""'                  to asBlock[4]
            Move '        Send Add_Item msg_FixPopupHitTwo "Two"'     to asBlock[5]
            Move '    End_Procedure'                                  to asBlock[6]
            Move 'End_Class'                                          to asBlock[7]
            Function_Return asBlock
        End_Function

        // ---- the emitter: what it writes is what the test runner compiled ------------------------

        {Published = True}
        Procedure PopupClass_EmptySubclassIsWrittenAsTheCompiledFixture
            String[] asBlock asOut asWant
            String sWhyNot

            Get EmptySubclass to asBlock
            Get Ported asBlock (&sWhyNot) to asOut
            Get FixtureRegion "A" to asWant
            Send AssertSAreEqual "" (sWhyNot + FirstDifference(Self, asOut, asWant))
        End_Procedure

        {Published = True}
        Procedure PopupClass_ConstructorItemsAreWrittenAsTheCompiledFixture
            String[] asBlock asOut asWant
            String sWhyNot

            Get FilledSubclass to asBlock
            Get Ported asBlock (&sWhyNot) to asOut
            Get FixtureRegion "B" to asWant
            Send AssertSAreEqual "" (sWhyNot + FirstDifference(Self, asOut, asWant))
        End_Procedure

        // The body's own lines stay, in their order, between the new class line and the new members.
        {Published = True}
        Procedure PopupClass_BodyLinesStayInOrder
            String[] asBlock asOut
            String sWhyNot sAfterClass sLast
            Integer iClass iEnd iAdd iLast

            Get EmptySubclass to asBlock
            Get Ported asBlock (&sWhyNot) to asOut
            Get LineAt asOut "Class cFixPopupMenu is a cCJContextMenu" to iClass
            Get LineAt asOut "Forward Send End_Construct_Object"       to iEnd
            Get LineAt asOut "Procedure Add_Item Integer iMsg String sText" to iAdd
            Move (SizeOfArray(asOut) - 1) to iLast
            // the line under the class line is the class's own Construct_Object, as it was
            Move "" to sAfterClass
            Move "" to sLast
            If (iClass >= 0 and iClass < iLast) ;
                Move (Trim(asOut[iClass + 1])) to sAfterClass
            If (iLast >= 0) ;
                Move asOut[iLast] to sLast
            Send Assert (iClass > 0 and iClass < iEnd and iEnd < iAdd and iAdd < iLast and sAfterClass = "Procedure Construct_Object" and sLast = "End_Class") (Joined(Self, asOut))
        End_Procedure

        // No Construct_Object at all: the class gets one, because the three properties need a home.
        {Published = True}
        Procedure PopupClass_NoConstructorGetsOne
            String[] asBlock asOut
            String sWhyNot

            Move 'Class cBarePopup is a FloatingPopupMenu'  to asBlock[0]
            Move 'End_Class'                               to asBlock[1]
            Get Ported asBlock (&sWhyNot) to asOut
            Send Assert (sWhyNot = "" and HasLine(Self, asOut, "Class cBarePopup is a cCJContextMenu") and HasLine(Self, asOut, "Class cBarePopupItem is a cCJMenuItem") and LineAt(Self, asOut, "Procedure Construct_Object") >= 0 and LineAt(Self, asOut, "Property Integer piAddedItems 0               // every Add_Item so far, a separator too: what Item_Count answers") > LineAt(Self, asOut, "Class cBarePopup is a cCJContextMenu")) (sWhyNot + " " + Joined(Self, asOut))
        End_Procedure

        // Only the BASE is replaced: a class whose own name holds the word keeps its name, and the
        // line keeps its spelling, its indent and its comment.
        {Published = True}
        Procedure PopupClass_OnlyTheBaseOfTheClassLineChanges
            String[] asBlock asOut
            String sWhyNot

            Move '  class cMyFloatingPopupMenu is a floatingpopupmenu   // the tree menu'  to asBlock[0]
            Move '  End_Class'                                                          to asBlock[1]
            Get Ported asBlock (&sWhyNot) to asOut
            Send Assert (sWhyNot = "" and LineAt(Self, asOut, "class cMyFloatingPopupMenu is a cCJContextMenu   // the tree menu") >= 0 and HasLine(Self, asOut, "Class cMyFloatingPopupMenuItem is a cCJMenuItem")) (sWhyNot + " " + Joined(Self, asOut))
        End_Procedure

        // A block comment in the class body is a comment like any other: carried as written, and an
        // End_Class or an Add_Item inside it is not code.
        {Published = True}
        Procedure PopupClass_BlockCommentInTheBodyIsCarried
            String[] asBlock asOut
            String sWhyNot

            Move 'Class cFixPopupMenu is a FloatingPopupMenu'       to asBlock[0]
            Move '    /* The tree view fills this menu itself:'     to asBlock[1]
            Move '         Send Delete_Data of hoMenu'              to asBlock[2]
            Move '       and there is no End_Class in here. */'     to asBlock[3]
            Move '    Procedure Construct_Object'                   to asBlock[4]
            Move '        Forward Send Construct_Object'            to asBlock[5]
            Move '    End_Procedure'                                to asBlock[6]
            Move 'End_Class'                                        to asBlock[7]
            Get Ported asBlock (&sWhyNot) to asOut
            Send Assert (sWhyNot = "" and HasLine(Self, asOut, "/* The tree view fills this menu itself:") and HasLine(Self, asOut, "Send Delete_Data of hoMenu") and HasLine(Self, asOut, "and there is no End_Class in here. */") and HasLine(Self, asOut, "Class cFixPopupMenu is a cCJContextMenu")) (sWhyNot + " " + Joined(Self, asOut))
        End_Procedure

        // ---- refusals: one line the converter does not know leaves the whole class ----------------

        // A hand-written method may send or answer what a cCJContextMenu does not have. The class
        // WITHOUT it converts - the positive control for every refusal below.
        {Published = True}
        Procedure PopupClass_HandWrittenMethodRefusesTheClass
            String[] asBlock asOut
            String sWhyNot sControl

            Get EmptySubclass to asBlock
            Get Ported asBlock (&sControl) to asOut
            Move '    Procedure OnInitMenu'   to asBlock[8]
            Move '    End_Procedure'          to asBlock[9]
            Move 'End_Class'                  to asBlock[10]
            Move (ResizeArray(asOut, 0)) to asOut
            Get Ported asBlock (&sWhyNot) to asOut
            Send AssertSAreEqual "control []; line 9 is a hand-written procedure (OnInitMenu), and what it sends or answers may not exist in a cCJContextMenu; lines 0" ("control [" + sControl + "]; " + sWhyNot + "; lines " + String(SizeOfArray(asOut)))
        End_Procedure

        // Anything in a constructor besides forwarding, Add_Item and Property: Delete_Data here.
        {Published = True}
        Procedure PopupClass_ConstructorThatDoesMoreRefusesTheClass
            String[] asBlock asOut
            String sWhyNot

            Get FilledSubclass to asBlock
            Move '        Send Delete_Data'   to asBlock[4]
            Get Ported asBlock (&sWhyNot) to asOut
            Send AssertSAreEqual "line 5 does more than add an item: 'Send Delete_Data'" sWhyNot
        End_Procedure

        // Add_Item needs the class's new properties, and they are declared right after the forward.
        {Published = True}
        Procedure PopupClass_AddItemBeforeTheForwardRefusesTheClass
            String[] asBlock asOut
            String sWhyNot

            Get FilledSubclass to asBlock
            Move '        Send Add_Item msg_FixPopupHitOne "One"'     to asBlock[2]
            Move '        Forward Send Construct_Object'              to asBlock[3]
            Get Ported asBlock (&sWhyNot) to asOut
            Send AssertSAreEqual "line 3 adds an item before Construct_Object is forwarded" sWhyNot
        End_Procedure

        {Published = True}
        Procedure PopupClass_ConstructorThatDoesNotForwardRefusesTheClass
            String[] asBlock asOut
            String sWhyNot

            Move 'Class cFixPopupMenu is a FloatingPopupMenu'   to asBlock[0]
            Move '    Procedure Construct_Object'               to asBlock[1]
            Move '    End_Procedure'                            to asBlock[2]
            Move 'End_Class'                                    to asBlock[3]
            Get Ported asBlock (&sWhyNot) to asOut
            Send AssertSAreEqual "its Construct_Object does not forward to the class it is built on" sWhyNot
        End_Procedure

        // ---- the Check's verdict: the same answer, asked of a file ---------------------------------

        // "" for the class that converts; the reason for one with no End_Class, and for one whose
        // item class name is taken in the file.
        {Published = True}
        Procedure PopupClass_VerdictSaysWhyNot
            String[] asCode
            String sYes sNoEnd sTaken

            Get EmptySubclass to asCode
            Get _CJPopupClassWhyNot of ghoFuncLib (&asCode) 0 to sYes
            Move 'Class cFixPopupMenuItem is a cObject'  to asCode[9]
            Move 'End_Class'                             to asCode[10]
            Get _CJPopupClassWhyNot of ghoFuncLib (&asCode) 0 to sTaken
            Move (ResizeArray(asCode, 0)) to asCode
            Move 'Class cFixPopupMenu is a FloatingPopupMenu'   to asCode[0]
            Move '    Procedure Construct_Object'               to asCode[1]
            Get _CJPopupClassWhyNot of ghoFuncLib (&asCode) 0 to sNoEnd
            Send AssertSAreEqual "[] [the class has no End_Class] [this file already declares a class named cFixPopupMenuItem, the name the menu's item class takes]" ("[" + sYes + "] [" + sNoEnd + "] [" + sTaken + "]")
        End_Procedure

        // A dbFloatingPopupMenu subclass inherits ten items and is not this converter's: no name, no verdict asked.
        {Published = True}
        Procedure PopupClass_DbSubclassIsNotTaken
            String sPlain sDb sObject
            Get _CJPopupClassDeclName of ghoFuncLib "Class cA is a FloatingPopupMenu"    to sPlain
            Get _CJPopupClassDeclName of ghoFuncLib "Class cB is a dbFloatingPopupMenu"  to sDb
            Get _CJPopupClassDeclName of ghoFuncLib "Object oC is a FloatingPopupMenu"   to sObject
            Send AssertSAreEqual "[cA] [] []" ("[" + sPlain + "] [" + sDb + "] [" + sObject + "]")
        End_Procedure

        // ---- the walk over a file ------------------------------------------------------------------

        // The class converts where it stands, the code that creates and fills the menu is not
        // touched, the package of the two CodeJock classes joins the file's Use lines - and a second
        // run finds nothing left to do.
        {Published = True}
        Procedure PopupClass_FileWalkConvertsInPlaceAndLeavesTheCallers
            String[] asCode asDone asRefused asAgain
            String sAfter
            Integer iCount iSecond iUse iLastUse

            Move 'Use DfTreeVw.pkg'                                             to asCode[0]
            Move 'Use Working.pkg // the working message'                       to asCode[1]
            Move ''                                                             to asCode[2]
            Move 'Class cTreePop is a FloatingPopupMenu'                        to asCode[3]
            Move '    Procedure Construct_Object'                               to asCode[4]
            Move '        Forward Send Construct_Object'                        to asCode[5]
            Move '    End_Procedure'                                            to asCode[6]
            Move 'End_Class'                                                    to asCode[7]
            Move ''                                                             to asCode[8]
            Move 'Class cTree is a TreeView'                                    to asCode[9]
            Move '    Procedure Construct_Object'                               to asCode[10]
            Move '        Handle ho'                                            to asCode[11]
            Move '        Forward Send Construct_Object'                        to asCode[12]
            Move '        Property Handle phoPopupMenu 0'                       to asCode[13]
            Move '        Get Create (RefClass(cTreePop)) to ho'                to asCode[14]
            Move '        Set phoPopupMenu to ho'                               to asCode[15]
            Move '    End_Procedure'                                            to asCode[16]
            Move '    Procedure AddMenuItem Integer iMsg String sText'          to asCode[17]
            Move '        Send Add_Item of (phoPopupMenu(Self)) iMsg sText'     to asCode[18]
            Move '    End_Procedure'                                            to asCode[19]
            Move 'End_Class'                                                    to asCode[20]
            Get _CJConvertPopupClassesInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Get Joined asCode to sAfter
            Move asCode to asAgain
            Get _CJConvertPopupClassesInFile of ghoFuncLib (&asAgain) (&asDone) (&asRefused) to iSecond
            Get LineAt asCode "Use cCJCommandBarSystem.pkg   // ConvertPopupMenuSubclassToCodeJock: cCJContextMenu and cCJMenuItem" to iUse
            Get LineAt asCode "Use Working.pkg // the working message" to iLastUse
            Send Assert (iCount = 1 and iSecond = 0 and SizeOfArray(asRefused) = 0 and iUse = (iLastUse + 1) and HasLine(Self, asCode, "Class cTreePop is a cCJContextMenu") and HasLine(Self, asCode, "Class cTreePopItem is a cCJMenuItem") and HasLine(Self, asCode, "Get Create (RefClass(cTreePop)) to ho") and HasLine(Self, asCode, "Send Add_Item of (phoPopupMenu(Self)) iMsg sText") and HasLine(Self, asCode, "Class cTree is a TreeView") and sAfter = Joined(Self, asAgain)) ("converted " + String(iCount) + ", second run " + String(iSecond) + ", Use at " + String(iUse) + " after " + String(iLastUse) + ": " + sAfter)
        End_Procedure

        // A class inside a block comment is not a class: it is not converted, not refused, not touched -
        // while the real one below it converts (the positive control). The verdict says the same of it.
        {Published = True}
        Procedure PopupClass_FileWalkSkipsAClassInsideABlockComment
            String[] asCode asDone asRefused asBefore
            String sVerdict sOld
            Integer iCount

            Move '/* the menu as it was:'                          to asCode[0]
            Move 'Class cOldPop is a FloatingPopupMenu'            to asCode[1]
            Move 'End_Class */'                                    to asCode[2]
            Move 'Class cTreePop is a FloatingPopupMenu'           to asCode[3]
            Move 'End_Class'                                       to asCode[4]
            Move asCode to asBefore
            Get _CJPopupClassWhyNot of ghoFuncLib (&asBefore) 1 to sVerdict
            Get _CJConvertPopupClassesInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            // (the Use line the conversion adds goes to the top of a file that has none, so find the line)
            Move "the commented class line is gone" to sOld
            If (HasLine(Self, asCode, "Class cOldPop is a FloatingPopupMenu")) ;
                Move "the commented class line is as written" to sOld
            Send AssertSAreEqual "1 cTreePop| [] [the commented class line is as written] [the line does not declare a FloatingPopupMenu subclass]" (String(iCount) + " " + Joined(Self, asDone) + " [" + Joined(Self, asRefused) + "] [" + sOld + "] [" + sVerdict + "]")
        End_Procedure

        // A class that is left is left EXACTLY as written - no marker above it - and named with its reason.
        {Published = True}
        Procedure PopupClass_FileWalkLeavesARefusedClassUntouched
            String[] asCode asDone asRefused
            String sBefore
            Integer iCount

            Move 'Class cTreePop is a FloatingPopupMenu'   to asCode[0]
            Move '    Procedure OnInitMenu'                to asCode[1]
            Move '    End_Procedure'                       to asCode[2]
            Move 'End_Class'                               to asCode[3]
            Get Joined asCode to sBefore
            Get _CJConvertPopupClassesInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertSAreEqual (sBefore + " 0 cTreePop|line 2 is a hand-written procedure (OnInitMenu), and what it sends or answers may not exist in a cCJContextMenu|") (Joined(Self, asCode) + " " + String(iCount) + " " + Joined(Self, asRefused))
        End_Procedure

        // ---- the compiled classes at work ------------------------------------------------------------

        /* "NO MESSAGE" IS TWO VALUES, and the first draft of the converter knew only one. Msg_None is a
           real message id (50 here), not 0 - this fixture's first run said so - while the legacy menu
           skipped a 0 itself. Both must make a separator when there is no text either: three Add_Items
           counted, and the item after each separator is still reached. */
        {Published = True}
        Procedure PopupClass_Compiled_ZeroAndMsgNoneAreBothASeparator
            Handle hoMenu
            Integer iCount

            Set piPopupHitOne to 0
            Set piPopupHitTwo to 0
            Get Create (RefClass(cFixPopupMenuProbe)) to hoMenu
            Set phoProbeTarget of hoMenu to Self
            Send Add_Item of hoMenu 0 ""
            Send Add_Item of hoMenu msg_FixPopupHitOne "One"
            Send Add_Item of hoMenu Msg_None ""
            Send Add_Item of hoMenu msg_FixPopupHitTwo "Two"
            Get Item_Count of hoMenu to iCount
            Broadcast No_Stop Send Execute of hoMenu
            Send Destroy of hoMenu
            Send AssertSAreEqual "Msg_None is not 0: yes, count 4, one 1, two 1" ("Msg_None is not 0: " + (If((Msg_None <> 0), "yes", "no")) + ", count " + String(iCount) + ", one " + String(piPopupHitOne(Self)) + ", two " + String(piPopupHitTwo(Self)))
        End_Procedure

        // A caption with no message - a 0 or Msg_None - is an item that sends nothing when it is
        // chosen, with a target to send to: no error, and the item with a message is still reached.
        {Published = True}
        Procedure PopupClass_Compiled_ACaptionWithNoMessageSendsNothing
            Handle hoMenu
            Integer iCount

            Set piPopupHitOne to 0
            Set piPopupHitTwo to 0
            Get Create (RefClass(cFixPopupMenuProbe)) to hoMenu
            Set phoProbeTarget of hoMenu to Self
            Send Add_Item of hoMenu 0 "A caption, message 0"
            Send Add_Item of hoMenu Msg_None "A caption, Msg_None"
            Send Add_Item of hoMenu msg_FixPopupHitTwo "Two"
            Get Item_Count of hoMenu to iCount
            Broadcast No_Stop Send Execute of hoMenu
            Send Destroy of hoMenu
            Send AssertSAreEqual "count 3, one 0, two 1" ("count " + String(iCount) + ", one " + String(piPopupHitOne(Self)) + ", two " + String(piPopupHitTwo(Self)))
        End_Procedure

        // An empty menu, filled from outside as the tree view does it: Item_Count counts every Add_Item,
        // the separator makes no object, and each item sends its own message once when it is chosen.
        {Published = True}
        Procedure PopupClass_Compiled_ItemsAddedFromOutsideSendTheirMessages
            Handle hoMenu
            Integer iBefore iCount

            Set piPopupHitOne to 0
            Set piPopupHitTwo to 0
            Get Create (RefClass(cFixPopupMenuProbe)) to hoMenu
            Set phoProbeTarget of hoMenu to Self
            Get Item_Count of hoMenu to iBefore
            Send Add_Item of hoMenu msg_FixPopupHitOne "One"
            Send Add_Item of hoMenu Msg_None ""
            Send Add_Item of hoMenu msg_FixPopupHitTwo "Two"
            Get Item_Count of hoMenu to iCount
            Broadcast No_Stop Send Execute of hoMenu
            Send Destroy of hoMenu
            Send AssertSAreEqual "before 0, count 3, one 1, two 1" ("before " + String(iBefore) + ", count " + String(iCount) + ", one " + String(piPopupHitOne(Self)) + ", two " + String(piPopupHitTwo(Self)))
        End_Procedure

        // The class that adds its items in its own constructor: they are there when it has been created.
        {Published = True}
        Procedure PopupClass_Compiled_ConstructorItemsSendTheirMessages
            Handle hoMenu
            Integer iCount

            Set piPopupHitOne to 0
            Set piPopupHitTwo to 0
            Get Create (RefClass(cFixFilledPopupMenuProbe)) to hoMenu
            Set phoProbeTarget of hoMenu to Self
            Get Item_Count of hoMenu to iCount
            Broadcast No_Stop Send Execute of hoMenu
            Send Destroy of hoMenu
            Send AssertSAreEqual "count 3, one 1, two 1" ("count " + String(iCount) + ", one " + String(piPopupHitOne(Self)) + ", two " + String(piPopupHitTwo(Self)))
        End_Procedure

        // With no target - ItemMessageTarget answers 0, as it does when nothing has the focus - an
        // item that has a message sends nothing either.
        {Published = True}
        Procedure PopupClass_Compiled_NoTargetSendsNothing
            Handle hoMenu
            Integer iCount

            Set piPopupHitOne to 0
            Set piPopupHitTwo to 0
            Get Create (RefClass(cFixPopupMenuProbe)) to hoMenu
            Send Add_Item of hoMenu Msg_None "Only a caption"
            Send Add_Item of hoMenu msg_FixPopupHitOne "One"
            Get Item_Count of hoMenu to iCount
            // no target yet: the item with a message has nowhere to send it
            Broadcast No_Stop Send Execute of hoMenu
            Send Destroy of hoMenu
            Send AssertSAreEqual "count 2, one 0, two 0" ("count " + String(iCount) + ", one " + String(piPopupHitOne(Self)) + ", two " + String(piPopupHitTwo(Self)))
        End_Procedure

    End_Object
