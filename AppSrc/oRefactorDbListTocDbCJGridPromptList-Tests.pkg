// oRefactorDbListTocDbCJGridPromptList-Tests.pkg
//
// Unit tests for cDbListTocDbCJGridPromptList.pkg
// (data-aware legacy dbList -> cDbCJGridPromptList subclass of cDbGridTocDbCJGrid).
// Included by oUnit_Tests.pkg inside the oRefactorFuncLib_Tests fixture object.
//
// Test groups:
//   oListClassDetection          - IsGridDeclaration (dblist pattern + exact match)
//   oListClassRename             - end-to-end class rename dbList -> cDbCJGridPromptList
//   oSelectionPropTranslation    - IsTranslatableGridProperty + TranslateGridProperty
//   oPromptCallbackHint          - one-time Prompt_Callback TODO header emission
//   oInheritedColumnConversion   - inherited Begin_Row/Entry_Item + Main_File handling

Use cDbListTocDbCJGridPromptList.pkg

Object oRefactorDbListTocDbCJGridPromptList is a cTestFixture
    Set psFunctionName to "RefactorDbListTocDbCJGridPromptList"

    // -----------------------------------------------------------------------
    // oListClassDetection - IsGridDeclaration
    // -----------------------------------------------------------------------
    Object oListClassDetection is a cTestFixture
        Set psFunctionName to "IsGridDeclaration (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        {Published = True}
        { Description = "Bare 'dbList' class is detected by pattern" }
        Procedure DbList_DetectedByPattern
            Boolean bResult
            Get IsGridDeclaration of oWorker "object osel1 is a dblist" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "Any class ending in 'dblist' is detected by pattern" }
        Procedure CustomDbList_DetectedByPattern
            Boolean bResult
            Get IsGridDeclaration of oWorker "object osel1 is a cmydblist" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "A 'dbgrid' class is NOT detected by the dblist converter" }
        Procedure DbGrid_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a dbgrid" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "A non-list object is NOT detected" }
        Procedure NonList_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object oform1 is a cdbform" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "With explicit sParameter, exact class match is used (custom name)" }
        Procedure ExactMatch_CustomClass
            Boolean bResult bOK
            Get ParseAndSetParameter of oWorker "cMyList,cDbCJGridPromptList" to bOK
            Get IsGridDeclaration of oWorker "object o1 is a cmylist" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "With explicit sParameter, the 'dblist' pattern is NOT used" }
        Procedure ExactMatch_PatternDisabled
            Boolean bResult bOK
            Get ParseAndSetParameter of oWorker "cMyList,cDbCJGridPromptList" to bOK
            Get IsGridDeclaration of oWorker "object o1 is a dblist" to bResult
            Send AssertFalse bResult
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oListClassRename - end-to-end class rename
    // -----------------------------------------------------------------------
    Object oListClassRename is a cTestFixture
        Set psFunctionName to "ClassRename (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        {Published = True}
        { Description = "dbList class name is replaced with cDbCJGridPromptList" }
        Procedure ClassNameReplaced
            String[] asInput asOutput
            Integer  iGrids

            Move "Object oSelectCustomer is a dbList" to asInput[0]
            Move "End_Object"                          to asInput[1]

            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a cdbcjgridpromptlist")
        End_Procedure

        {Published = True}
        { Description = "Returns 0 and leaves source unchanged for non-list object" }
        Procedure NonList_Unchanged
            String[] asInput asOutput
            Integer  iGrids

            Move "Object oForm1 is a cDbForm" to asInput[0]
            Move "End_Object"                 to asInput[1]

            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput

            Send AssertIAreEqual 0 iGrids
            Send AssertSAreEqual "Object oForm1 is a cDbForm" asOutput[0]
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oSelectionPropTranslation - dbList selection-behaviour properties
    // -----------------------------------------------------------------------
    Object oSelectionPropTranslation is a cTestFixture
        Set psFunctionName to "SelectionPropTranslation (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // Wrap one Set line inside a minimal dbList and return the output.
        Function RunOneProp String sSetLine Returns String[]
            String[] asInput asOutput
            Integer  iGrids
            Move "Object oSel is a dbList" to asInput[0]
            Move ("    " + sSetLine)       to asInput[1]
            Move "End_Object"              to asInput[2]
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        Function OutputContains String[] asOutput String sNeedle Returns Boolean
            Integer iIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains sNeedle) Function_Return True
            Loop
            Function_Return False
        End_Function

        // --- IsTranslatableGridProperty direct unit tests ---

        {Published = True}
        { Description = "Auto_Server_State is recognised as translatable" }
        Procedure AutoServer_IsTranslatable
            Boolean bResult
            Get IsTranslatableGridProperty of oWorker "set auto_server_state to true" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "Auto_Index_State is recognised as translatable (intercepted before base removal)" }
        Procedure AutoIndex_IsTranslatable
            Boolean bResult
            Get IsTranslatableGridProperty of oWorker "set auto_index_state to true" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "A non-dbList Set property still delegates to the base (highlight_row_state)" }
        Procedure BaseProp_StillTranslatable
            Boolean bResult
            Get IsTranslatableGridProperty of oWorker "set highlight_row_state to true" to bResult
            Send Assert bResult
        End_Procedure

        // --- End-to-end translation ---

        {Published = True}
        { Description = "Auto_Server_State True -> Set pbAutoServer to True" }
        Procedure AutoServer_Mapped
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Auto_Server_State to True" to asOutput
            Get OutputContains asOutput "Set pbAutoServer to True" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Auto_Column_State False -> Set pbAutoColumn to False" }
        Procedure AutoColumn_Mapped
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Auto_Column_State to False" to asOutput
            Get OutputContains asOutput "Set pbAutoColumn to False" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Popup_Search_State True -> Set pbAutoSearch to True" }
        Procedure PopupSearch_Mapped
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Popup_Search_State to True" to asOutput
            Get OutputContains asOutput "Set pbAutoSearch to True" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Export_Item_State True -> Set peUpdateMode to umPromptValue + TODO" }
        Procedure ExportItem_MappedToUpdateMode
            String[] asOutput
            Boolean  bMode bTodo
            Get RunOneProp "Set Export_Item_State to True" to asOutput
            Get OutputContains asOutput "Set peUpdateMode to umPromptValue" to bMode
            Get OutputContains asOutput "// TODO: dbList Export_Item_State" to bTodo
            Send Assert (bMode and bTodo)
        End_Procedure

        {Published = True}
        { Description = "Auto_Index_State -> TODO comment only (no silent removal)" }
        Procedure AutoIndex_TodoOnly
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Auto_Index_State to True" to asOutput
            Get OutputContains asOutput "// TODO: dbList Auto_Index_State" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Move_Value_Out_State -> TODO comment mentioning umPromptNonInvoking" }
        Procedure MoveValueOut_TodoOnly
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Move_Value_Out_State to False" to asOutput
            Get OutputContains asOutput "umPromptNonInvoking" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Auto_Shadow_State -> TODO comment only" }
        Procedure AutoShadow_TodoOnly
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Auto_Shadow_State to True" to asOutput
            Get OutputContains asOutput "// TODO: dbList Auto_Shadow_State" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Auto_Label_State -> TODO comment only" }
        Procedure AutoLabel_TodoOnly
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Auto_Label_State to True" to asOutput
            Get OutputContains asOutput "// TODO: dbList Auto_Label_State" to bFound
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Seed_List_State -> TODO comment only (no executable Set survives)" }
        Procedure SeedList_TodoOnly
            String[] asOutput
            Boolean  bFound
            Get RunOneProp "Set Seed_List_State to False" to asOutput
            Get OutputContains asOutput "// TODO: dbList Seed_List_State" to bFound
            Send Assert bFound
        End_Procedure

        // A prompt list keeps only the focus rectangle: it selects its rows itself, and a pbSelectionEnable from
        // 'Set Highlight_Row_State to False' would switch that off (2026-10-04).
        {Published = True}
        { Description = "Highlight_Row_State on a dbList -> pbShowRowFocus only, never pbSelectionEnable" }
        Procedure HighlightRowState_RectangleOnly
            String[] asOutput
            Boolean  bFocus bSelection
            Get RunOneProp "Set Highlight_Row_State to False" to asOutput
            Get OutputContains asOutput "Set pbShowRowFocus to False" to bFocus
            Get OutputContains asOutput "pbSelectionEnable" to bSelection
            Send Assert (bFocus and not(bSelection))
        End_Procedure

        // 2026-10-04: a TODO by choice (Nils), naming the closest property.
        {Published = True}
        { Description = "Export_Column -> TODO naming piUpdateColumn" }
        Procedure ExportColumn_TodoOnly
            String[] asOutput
            Boolean  bTodo bClosest
            Get RunOneProp "Set Export_Column to 1" to asOutput
            Get OutputContains asOutput "// TODO: dbList Export_Column" to bTodo
            Get OutputContains asOutput "piUpdateColumn" to bClosest
            Send Assert (bTodo and bClosest)
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oPromptCallbackHint - one-time Prompt_Callback TODO header
    // -----------------------------------------------------------------------
    Object oPromptCallbackHint is a cTestFixture
        Set psFunctionName to "PromptCallbackHint (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        {Published = True}
        { Description = "A converted dbList emits the Prompt_Callback / peUpdateMode TODO header once" }
        Procedure PromptCallbackHint_Emitted
            String[] asInput asOutput
            Integer  iGrids iIdx iCallback iMode

            Move "Object oSel is a dbList"                to asInput[0]
            Move "    Set Main_File to Customer.File_Number" to asInput[1]
            Move "    Begin_Row"                           to asInput[2]
            Move "        Entry_Item Customer.Name"        to asInput[3]
            Move "    End_Row"                             to asInput[4]
            Move "End_Object"                              to asInput[5]

            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput

            Move 0 to iCallback
            Move 0 to iMode
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Prompt_Callback") Increment iCallback
                If (asOutput[iIdx] contains "umPromptValue")   Increment iMode
            Loop
            // Emitted exactly once (one-time per converted list).
            Send AssertIAreEqual 1 iCallback
            Send Assert (iMode >= 1)
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oInheritedColumnConversion - inherited dbGrid->cDbCJGrid machinery
    // -----------------------------------------------------------------------
    Object oInheritedColumnConversion is a cTestFixture
        Set psFunctionName to "InheritedColumnConversion (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function OutputContains String[] asOutput String sNeedle Returns Boolean
            Integer iIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains sNeedle) Function_Return True
            Loop
            Function_Return False
        End_Function

        {Published = True}
        { Description = "Entry_Item becomes a cDbCJGridColumn child object (inherited behaviour)" }
        Procedure EntryItem_BecomesColumnObject
            String[] asInput asOutput
            Integer  iGrids
            Boolean  bColObj bEntry

            Move "Object oSel is a dbList"            to asInput[0]
            Move "    Begin_Row"                       to asInput[1]
            Move "        Entry_Item Customer.Name"    to asInput[2]
            Move "    End_Row"                         to asInput[3]
            Move "End_Object"                          to asInput[4]

            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput

            Send AssertIAreEqual 1 iGrids
            Get OutputContains asOutput "is a cDbCJGridColumn" to bColObj
            Get OutputContains asOutput "Entry_Item Customer.Name" to bEntry
            Send Assert (bColObj and bEntry)
        End_Procedure

        {Published = True}
        { Description = "Set Main_File is commented out with a Set Server hint (inherited behaviour)" }
        Procedure MainFile_CommentedWithServerHint
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bMainCommented bServerHint

            Move "Object oSel is a dbList"                   to asInput[0]
            Move "    Set Main_File to Customer.File_Number"  to asInput[1]
            Move "    Begin_Row"                              to asInput[2]
            Move "        Entry_Item Customer.Name"           to asInput[3]
            Move "    End_Row"                                to asInput[4]
            Move "End_Object"                                 to asInput[5]

            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput

            Move False to bMainCommented
            Move False to bServerHint
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Left(asOutput[iIdx], 2) = "//" and Lowercase(asOutput[iIdx]) contains "set main_file") Move True to bMainCommented
                If (Lowercase(asOutput[iIdx]) contains "set server to ocustomer_dd") Move True to bServerHint
            Loop
            Send Assert (bMainCommented and bServerHint)
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oNonLiteralColumnGuard - a column index / form-width parsed out of a per-column
    // grid line that is NOT a numeric literal (e.g. "Set Header_Label Item iCol to ..."
    // or "Set Form_Width Item 0 to C_Width") must yield -1 and be SKIPPED, not crash.
    // Regression for the DF26 Integer(<string>) fault in ParseColumnItemIndex/ParseFormWidth
    // (cGridToCJGridBase) that aborted RefactorDbListTocDbCJGridPromptList on a plan run
    // (fixed 2026-06-21 via the _DigitsToIntOrMinus1 digit-guard + width caller-guards).
    // -----------------------------------------------------------------------
    Object oNonLiteralColumnGuard is a cTestFixture
        Set psFunctionName to "NonLiteralColumnGuard (cGridToCJGridBase)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        {Published = True}
        { Description = "A numeric column index ('item 2') parses to its value" }
        Procedure NumericColumnIndex_Parsed
            Integer iIdx
            Get ParseColumnItemIndex of oWorker "set header_label item 2 to abc" "header_label" to iIdx
            Send AssertIAreEqual 2 iIdx
        End_Procedure

        {Published = True}
        { Description = "A NON-numeric column index ('item iCol') returns -1, not a fault" }
        Procedure NonNumericColumnIndex_ReturnsMinus1
            Integer iIdx
            Get ParseColumnItemIndex of oWorker "set header_label item icol to abc" "header_label" to iIdx
            Send AssertIAreEqual -1 iIdx
        End_Procedure

        {Published = True}
        { Description = "A numeric form-width ('to 120') parses to its value" }
        Procedure NumericFormWidth_Parsed
            Integer iWidth
            Get ParseFormWidth of oWorker "set form_width item 0 to 120" to iWidth
            Send AssertIAreEqual 120 iWidth
        End_Procedure

        {Published = True}
        { Description = "A NON-numeric form-width ('to C_Width') returns -1, not a fault" }
        Procedure NonNumericFormWidth_ReturnsMinus1
            Integer iWidth
            Get ParseFormWidth of oWorker "set form_width item 0 to c_width" to iWidth
            Send AssertIAreEqual -1 iWidth
        End_Procedure

        {Published = True}
        { Description = "A grid with a non-literal column-property index converts without crashing" }
        Procedure NonLiteralColumnProperty_DoesNotCrashTransform
            String[] asInput
            Integer  iGrids

            Move "Object oSel is a dbList"            to asInput[0]
            Move "    Set Form_Width Item iCol to 100" to asInput[1]
            Move "    Begin_Row"                       to asInput[2]
            Move "        Entry_Item Customer.Name"    to asInput[3]
            Move "    End_Row"                         to asInput[4]
            Move "End_Object"                          to asInput[5]

            Set pasSource of oWorker to asInput
            // Before the fix this faulted inside ParseColumnItemIndex (Integer("iCol")) and aborted
            // the run; simply returning here + converting the grid proves the guard works.
            Get TransformSource of oWorker to iGrids
            Send AssertIAreEqual 1 iGrids
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oUsePackageFixup - the file's "Use" directive follows the class conversion
    // (dbList's dedicated Dfsellst.pkg -> the cDbCJGridPromptList package)
    // -----------------------------------------------------------------------
    Object oUsePackageFixup is a cTestFixture
        Set psFunctionName to "UsePackageFixup (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        Function ArrayHasLine String[] asArr String sLine Returns Boolean
            Integer i iMax
            Move (SizeOfArray(asArr) - 1) to iMax
            For i from 0 to iMax
                If (asArr[i] = sLine) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        Function CountLines String[] asArr String sLine Returns Integer
            Integer i iMax iN
            Move 0 to iN
            Move (SizeOfArray(asArr) - 1) to iMax
            For i from 0 to iMax
                If (asArr[i] = sLine) ;
                    Increment iN
            Loop
            Function_Return iN
        End_Function

        // The user's exact case: Use Dfsellst.pkg becomes Use cDbCJGridPromptList.pkg.
        {Published = True}
        { Description = "Use Dfsellst.pkg is swapped in place for the target package" }
        Procedure LegacyUse_SwappedInPlace
            String[] asInput asOutput
            Boolean  bLegacyGone
            Move "Use Dfsellst.pkg"             to asInput[0]
            Move "Object oSel is a dbList"      to asInput[1]
            Move "End_Object"                   to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Use cDbCJGridPromptList.pkg" asOutput[0]
            Get ArrayHasLine asOutput "Use Dfsellst.pkg" to bLegacyGone
            Send AssertFalse bLegacyGone
        End_Procedure

        // The legacy package match is case-insensitive.
        {Published = True}
        { Description = "Lowercase 'use dfsellst.pkg' is matched and swapped" }
        Procedure LegacyUse_CaseInsensitive
            String[] asInput asOutput
            Move "use dfsellst.pkg"             to asInput[0]
            Move "Object oSel is a dbList"      to asInput[1]
            Move "End_Object"                   to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Use cDbCJGridPromptList.pkg" asOutput[0]
        End_Procedure

        // Target package already Used: it is not duplicated.
        {Published = True}
        { Description = "Target package already Used -> not duplicated" }
        Procedure TargetAlreadyPresent_NoDuplicate
            String[] asInput asOutput
            Integer  iCount
            Move "Use cDbCJGridPromptList.pkg"  to asInput[0]
            Move "Object oSel is a dbList"      to asInput[1]
            Move "End_Object"                   to asInput[2]
            Get RunTransform_as asInput to asOutput
            Get CountLines asOutput "Use cDbCJGridPromptList.pkg" to iCount
            Send AssertIAreEqual 1 iCount
        End_Procedure

        // Legacy pulled in transitively (some other Use, no Dfsellst): the target
        // package is appended to the leading Use block.
        {Published = True}
        { Description = "Target injected after the leading Use block when no legacy Use present" }
        Procedure NoLegacyUse_InjectedAfterUses
            String[] asInput asOutput
            Move "Use MyAppFramework.pkg"       to asInput[0]
            Move ""                             to asInput[1]
            Move "Object oSel is a dbList"      to asInput[2]
            Move "End_Object"                   to asInput[3]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Use MyAppFramework.pkg"      asOutput[0]
            Send AssertSAreEqual "Use cDbCJGridPromptList.pkg" asOutput[1]
            Send AssertSAreEqual ""                            asOutput[2]
        End_Procedure

        /* THE REPORTED BUG (Nils 2026-08-10). A file that already Used the target package kept its
           Use Dfsellst.pkg, so the compiler went on reporting the obsolete package for a file whose
           dbLists had all converted. The legacy Use is commented out - not deleted - once nothing
           in the file needs it. */
        {Published = True}
        { Description = "Target already present -> the dead legacy Use is commented out" }
        Procedure TargetPresent_DeadLegacyUseCommentedOut
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use cDbCJGridPromptList.pkg"  to asInput[0]
            Move "Use Dfsellst.pkg"             to asInput[1]
            Move "Object oSel is a dbList"      to asInput[2]
            Move "End_Object"                   to asInput[3]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "//Use Dfsellst.pkg" asOutput[1]
            Get ArrayHasLine asOutput "Use Dfsellst.pkg" to bLegacyLive
            Send AssertFalse bLegacyLive
        End_Procedure

        /* THE GUARD, both ways round. Dfsellst.pkg also defines dbListRow, so a file that still
           declares one needs the package however many dbLists converted - the Use must survive
           BOTH the comment-out branch (target already present) and the swap branch (target not
           present, where removing it would take dbListRow's class with it). */
        {Published = True}
        { Description = "A surviving dbListRow keeps the legacy Use alive (target already present)" }
        Procedure TargetPresent_LegacyUseKeptWhenStillNeeded
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use cDbCJGridPromptList.pkg"  to asInput[0]
            Move "Use Dfsellst.pkg"             to asInput[1]
            Move "Object oSel is a dbList"      to asInput[2]
            Move "End_Object"                   to asInput[3]
            Move "Object oRow is a dbListRow"   to asInput[4]
            Move "End_Object"                   to asInput[5]
            Get RunTransform_as asInput to asOutput
            Get ArrayHasLine asOutput "Use Dfsellst.pkg" to bLegacyLive
            Send Assert bLegacyLive
        End_Procedure

        {Published = True}
        { Description = "A surviving dbListRow blocks the swap - target is ADDED, legacy stays" }
        Procedure SwapBlocked_WhenLegacyStillNeeded
            String[] asInput asOutput
            Boolean  bLegacyLive bTargetAdded
            Move "Use Dfsellst.pkg"             to asInput[0]
            Move "Object oSel is a dbList"      to asInput[1]
            Move "End_Object"                   to asInput[2]
            Move "Object oRow is a dbListRow"   to asInput[3]
            Move "End_Object"                   to asInput[4]
            Get RunTransform_as asInput to asOutput
            Get ArrayHasLine asOutput "Use Dfsellst.pkg"             to bLegacyLive
            Get ArrayHasLine asOutput "Use cDbCJGridPromptList.pkg"  to bTargetAdded
            Send Assert bLegacyLive
            Send Assert bTargetAdded
        End_Procedure

        // A fragment with NO Use lines at all is left alone (no lone Use at line 1).
        {Published = True}
        { Description = "No Use lines -> no Use injected (fragment untouched but for the rename)" }
        Procedure NoUseLines_NoInjection
            String[] asInput asOutput
            Boolean  bAnyUse
            Move "Object oSel is a dbList"      to asInput[0]
            Move "End_Object"                   to asInput[1]
            Get RunTransform_as asInput to asOutput
            Send Assert (Lowercase(asOutput[0]) contains "is a cdbcjgridpromptlist")
            Get ArrayHasLine asOutput "Use cDbCJGridPromptList.pkg" to bAnyUse
            Send AssertFalse bAnyUse
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oLegacyPropInRenamedMethod - a legacy grid property inside a renamed method
    // body (Mouse_Click -> OnRowDoubleClick) is removed, not passed through verbatim
    // -----------------------------------------------------------------------
    Object oLegacyPropInRenamedMethod is a cTestFixture
        Set psFunctionName to "LegacyPropInRenamedMethod (cDbListTocDbCJGridPromptList)"

        Object oWorker is a cDbListTocDbCJGridPromptList
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        // A legacy grid property inside the converted Mouse_Click body must not survive as an
        // EXECUTABLE Set (it has no cDbCJGridPromptList equivalent). It is handled exactly as at
        // grid level - Auto_Index_State and Seed_List_State each become a TODO hint - so a mention
        // in a // TODO comment is fine, but no "Set <prop>" statement may remain.
        {Published = True}
        { Description = "Legacy Set inside a renamed method body is not left as an executable Set" }
        Procedure LegacyProp_InRenamedMethod_Handled
            String[] asInput asOutput
            Integer  i iMax
            String   sL
            Boolean  bNoExecSet bMethodRenamed

            Move "Object oSel is a dbList"                              to asInput[0]
            Move "    Procedure Mouse_Click Integer iWin Integer iChar" to asInput[1]
            Move "        Set Auto_Index_State to True"                 to asInput[2]
            Move "        Set Seed_List_State to False"                 to asInput[3]
            Move "    End_Procedure"                                    to asInput[4]
            Move "End_Object"                                          to asInput[5]

            Get RunTransform_as asInput to asOutput

            Move True  to bNoExecSet
            Move False to bMethodRenamed
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                Move (Lowercase(Trim(asOutput[i]))) to sL
                If (Left(sL, 4) = "set " and (sL contains "auto_index_state" or sL contains "seed_list_state")) ;
                    Move False to bNoExecSet
                If (sL contains "procedure onrowdoubleclick") ;
                    Move True to bMethodRenamed
            Loop
            Send Assert bMethodRenamed
            Send Assert bNoExecSet
        End_Procedure

        // A NON-legacy Set inside the body must survive (only legacy grid props are stripped).
        {Published = True}
        { Description = "A normal Set inside a renamed method body is preserved" }
        Procedure NormalSet_InRenamedMethod_Kept
            String[] asInput asOutput
            Integer  i iMax
            Boolean  bKept

            Move "Object oSel is a dbList"                              to asInput[0]
            Move "    Procedure Mouse_Click Integer iWin Integer iChar" to asInput[1]
            Move "        Set piMyValue to 5"                           to asInput[2]
            Move "    End_Procedure"                                    to asInput[3]
            Move "End_Object"                                          to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bKept
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (Lowercase(asOutput[i]) contains "set pimyvalue to 5") ;
                    Move True to bKept
            Loop
            Send Assert bKept
        End_Procedure

    End_Object

End_Object
