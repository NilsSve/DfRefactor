//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeUppercaseCommandToFunction-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-19
//
// Description : Unit tests for ChangeUppercaseCommandToFunction - "Uppercase <arg> to <dest>" ->
//               "Move (Uppercase(<arg>)) to <dest>" (4531 obsolete-string-command family).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeUppercaseCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeUppercaseCommandToFunction"

        {Published = True}
        Procedure ChangeUppercaseCommandToFunction_InPlace
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Uppercase sVal to sVal" to sLine
            Move "Move (Uppercase(sVal)) to sVal" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Real-world casing ("UpperCase") + indentation; the canonical "Uppercase" is emitted.
        Procedure ChangeUppercaseCommandToFunction_CamelCaseIndent
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    UpperCase sPassWord to sPassWord" to sLine
            Move "    Move (Uppercase(sPassWord)) to sPassWord" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // A table.field argument survives intact (position-based extraction, not a single-token grab).
        Procedure ChangeUppercaseCommandToFunction_TableField
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Uppercase USER.SPRAK to sLang" to sLine
            Move "Move (Uppercase(USER.SPRAK)) to sLang" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // An existing Uppercase() function CALL is left untouched (keyword not followed by whitespace).
        Procedure ChangeUppercaseCommandToFunction_CallUntouched
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move (Uppercase(sVal)) to sX" to sLine
            Move "Move (Uppercase(sVal)) to sX" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // The IN-PLACE form "Uppercase <var>" (NO "to") - the command uppercases <var> in place, so the
        // destination IS the argument. This is the common LegacyApp form ("uppercase sUserName") that the
        // "to"-required extractor used to skip, leaving the 4531 warning un-cleared. (Nils 2026-07-01.)
        {Published = True}
        Procedure ChangeUppercaseCommandToFunction_NoToInPlace
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "uppercase sUserName" to sLine
            Move "Move (Uppercase(sUserName)) to sUserName" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // In-place + indentation (LegacyApp DDsrc\tidd0110.DD:365 "uppercase sArtnr"): the nose is preserved.
        {Published = True}
        Procedure ChangeUppercaseCommandToFunction_NoToIndented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "          uppercase sArtnr" to sLine
            Move "          Move (Uppercase(sArtnr)) to sArtnr" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // In-place with a dotted table.field argument - captured whole (no inner blank), used as both source
        // and destination.
        {Published = True}
        Procedure ChangeUppercaseCommandToFunction_NoToTableField
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Uppercase USER.SPRAK" to sLine
            Move "Move (Uppercase(USER.SPRAK)) to USER.SPRAK" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // In-place with a trailing comment: the argument ends at the blank before "//", and the comment tail
        // is preserved verbatim from the raw line.
        {Published = True}
        Procedure ChangeUppercaseCommandToFunction_NoToTrailingComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Uppercase sVal  // note" to sLine
            Move "Move (Uppercase(sVal)) to sVal  // note" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeUppercaseCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

    End_Object
