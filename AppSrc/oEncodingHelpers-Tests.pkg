    Object oEncodingHelpers is a cTestFixture
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
        Set psFunctionName to "EncodingHelpers"

        // ASCII round-trip: OEM encode then decode returns the original string.
        {Published = True}
        Procedure rfUtf8LineToOemBytes_AsciiRoundTrip
            String sInput sResult
            UChar[] ucaBytes
            Move "Hello, World!" to sInput
            Move (rfUtf8LineToOemBytes(sInput)) to ucaBytes
            Move (rfOemBytesToUtf8(ucaBytes)) to sResult
            Send AssertSAreEqual sInput sResult
        End_Procedure

        // One ASCII character = one OEM byte.
        {Published = True}
        Procedure rfUtf8LineToOemBytes_ByteCount
            UChar[] ucaBytes
            Move (rfUtf8LineToOemBytes("Hello")) to ucaBytes
            Send AssertIAreEqual 5 (SizeOfArray(ucaBytes))
        End_Procedure

        // Empty string returns a zero-length UChar[].
        {Published = True}
        Procedure rfUtf8LineToOemBytes_Empty
            UChar[] ucaBytes
            Move (rfUtf8LineToOemBytes("")) to ucaBytes
            Send AssertIAreEqual 0 (SizeOfArray(ucaBytes))
        End_Procedure

        // ASCII round-trip: UTF-8 encode then decode returns the original string.
        {Published = True}
        Procedure rfStringToUtf8Bytes_AsciiRoundTrip
            String sInput sResult
            UChar[] ucaBytes
            Move "DataFlex source" to sInput
            Move (rfStringToUtf8Bytes(sInput)) to ucaBytes
            Move (rfUtf8BytesToString(ucaBytes)) to sResult
            Send AssertSAreEqual sInput sResult
        End_Procedure

        // One ASCII character = one UTF-8 byte.
        {Published = True}
        Procedure rfStringToUtf8Bytes_ByteCount
            UChar[] ucaBytes
            Move (rfStringToUtf8Bytes("Hello")) to ucaBytes
            Send AssertIAreEqual 5 (SizeOfArray(ucaBytes))
        End_Procedure

        // Empty string returns a zero-length UChar[].
        {Published = True}
        Procedure rfStringToUtf8Bytes_Empty
            UChar[] ucaBytes
            Move (rfStringToUtf8Bytes("")) to ucaBytes
            Send AssertIAreEqual 0 (SizeOfArray(ucaBytes))
        End_Procedure

        // Empty UChar[] input returns an empty string.
        {Published = True}
        Procedure rfOemBytesToUtf8_Empty
            UChar[] ucaEmpty
            String sResult
            Move (rfOemBytesToUtf8(ucaEmpty)) to sResult
            Send AssertSAreEqual "" sResult
        End_Procedure

        // Empty UChar[] input returns an empty string.
        {Published = True}
        Procedure rfUtf8BytesToString_Empty
            UChar[] ucaEmpty
            String sResult
            Move (rfUtf8BytesToString(ucaEmpty)) to sResult
            Send AssertSAreEqual "" sResult
        End_Procedure

        // OEM file round-trip: write then read back; array must match exactly.
        // NOTE: tests use phoWorkspace (not pOrgWS) because UnitTests
        // is built on cApplication, not cRefactorApplication.
        {Published = True}
        Procedure WriteAndReadOem_RoundTrip
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asWrite asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Use SQL.pkg"   to asWrite[0]
            Move ""              to asWrite[1]
            Move "Set x to True" to asWrite[2]
            Get rfWriteEncodedFileFromStringArray (&asWrite) sTempFile C_NewLine False to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertArrayAreEqual asWrite asRead
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // UTF-8 file round-trip: write then read back; array must match exactly.
        {Published = True}
        Procedure WriteAndReadUtf8_RoundTrip
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asWrite asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Use SQL.pkg"   to asWrite[0]
            Move ""              to asWrite[1]
            Move "Set x to True" to asWrite[2]
            Get rfWriteEncodedFileFromStringArray (&asWrite) sTempFile C_NewLine True to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertArrayAreEqual asWrite asRead
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* THE TRAILING LINE BREAK IS NOT IN THE ARRAY, which is why these assert on the file's SIZE.
           A file ending in a break deliberately gains no phantom empty last line, so both shapes read
           back as the same array - an array comparison would pass either way and prove nothing. */
        {Published = True}
        Procedure TrailingLineBreak_WrittenOnlyWhenAsked
            Boolean bOk bEnds
            Integer iVoid iSizeWithout iSizeWith
            String sDataPath sTempFile
            String[] asWrite asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Use SQL.pkg"   to asWrite[0]
            Move "Set x to True" to asWrite[1]
            Get rfWriteEncodedFileFromStringArrayEx (&asWrite) sTempFile C_NewLine False False to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iSizeWithout
            Move (rfReadEncodedFileLines(sTempFile, False, &bEnds)) to asRead
            Send AssertFalse bEnds
            Send AssertArrayAreEqual asWrite asRead
            Get rfWriteEncodedFileFromStringArrayEx (&asWrite) sTempFile C_NewLine False True to bOk
            Move (rfFileSize(sTempFile)) to iSizeWith
            Move (rfReadEncodedFileLines(sTempFile, False, &bEnds)) to asRead
            Send Assert bEnds
            // The break is the ONLY difference, and it adds no line to the array.
            Send AssertIAreEqual (iSizeWithout + Length(C_NewLine)) iSizeWith
            Send AssertArrayAreEqual asWrite asRead
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* THE DEFECT, reproduced and fixed (2026-09-09). Read a BOM-less file that ends with a line
           break, write the array straight back, and the terminator used to be gone - the array cannot
           carry it and the writer's default is not to add one. Two of six files written over a legacy
           workspace came back a terminator short this way. The second half is the POSITIVE CONTROL:
           the four-argument name still drops it, which is the old default its other callers rely on. */
        {Published = True}
        Procedure OemRoundTrip_KeepsTheTrailingLineBreak
            Boolean bOk bEnds
            Integer iVoid iBefore
            String sDataPath sTempFile
            String[] asWrite asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Use SQL.pkg"   to asWrite[0]
            Move "Set x to True" to asWrite[1]
            Get rfWriteEncodedFileFromStringArrayEx (&asWrite) sTempFile C_NewLine False True to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iBefore
            Move (rfReadEncodedFileLines(sTempFile, False, &bEnds)) to asRead
            Send Assert bEnds
            Get rfWriteEncodedFileFromStringArrayEx (&asRead) sTempFile C_NewLine False bEnds to bOk
            Send AssertIAreEqual iBefore (rfFileSize(sTempFile))
            // Positive control: the four-argument name is unchanged and still loses it.
            Get rfWriteEncodedFileFromStringArray (&asRead) sTempFile C_NewLine False to bOk
            Send AssertIAreEqual (iBefore - Length(C_NewLine)) (rfFileSize(sTempFile))
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* The BOM path always tracked the terminator - that is why only BOM-less files lost one - so
           this is here to prove the new flag did not disturb it. The BOM itself is 3 of the bytes. */
        {Published = True}
        Procedure Utf8RoundTrip_KeepsTheTrailingLineBreak
            Boolean bOk bEnds
            Integer iVoid iBefore
            String sDataPath sTempFile
            String[] asWrite asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Use SQL.pkg"   to asWrite[0]
            Move "Set x to True" to asWrite[1]
            Get rfWriteEncodedFileFromStringArrayEx (&asWrite) sTempFile C_NewLine True True to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iBefore
            Move (rfReadEncodedFileLines(sTempFile, False, &bEnds)) to asRead
            Send Assert bEnds
            Send AssertArrayAreEqual asWrite asRead
            Get rfWriteEncodedFileFromStringArrayEx (&asRead) sTempFile C_NewLine True bEnds to bOk
            Send AssertIAreEqual iBefore (rfFileSize(sTempFile))
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // UTF-8 write prepends the BOM -- rfFileHasBOM must return True.
        {Published = True}
        Procedure rfFileHasBOM_True
            Boolean bOk bResult
            Integer iVoid
            String sDataPath sTempFile
            String[] asLines
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "x" to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) sTempFile C_NewLine True to bOk
            Move (rfFileHasBOM(sTempFile)) to bResult
            Send Assert bResult
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // OEM write has no BOM -- rfFileHasBOM must return False.
        {Published = True}
        Procedure rfFileHasBOM_False
            Boolean bOk bResult
            Integer iVoid
            String sDataPath sTempFile
            String[] asLines
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "x" to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) sTempFile C_NewLine False to bOk
            Move (rfFileHasBOM(sTempFile)) to bResult
            Send AssertFalse bResult
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // A file shorter than 3 bytes cannot carry a BOM -- must return False.
        {Published = True}
        Procedure rfFileHasBOM_TooSmall
            Integer iChannel iVoid
            Boolean bResult
            String sDataPath sTempFile
            UChar[] ucaSmall

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move 65 to ucaSmall[0]
            Move 66 to ucaSmall[1]
            Move (Seq_New_Channel()) to iChannel
            Direct_Output Channel iChannel ("binary:" + sTempFile)
            Write Channel iChannel ucaSmall
            Close_Output Channel iChannel
            Send Seq_Release_Channel iChannel
            Move (rfFileHasBOM(sTempFile)) to bResult
            Send AssertFalse bResult
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // ==================================================================================
        // CHARACTERIZATION for the SciControlLib rewrite (phase 0, Nils 2026-07-26).
        // The round-trip tests above are ASCII-only; everything encoding-CRITICAL - extended
        // characters, the BOM strip, line-break detection - was unpinned. These tests freeze
        // the ENGINE side of the editor<->engine file contract before any editor rewrite
        // touches the other side. Byte-level fixtures are written by the tests themselves
        // (never literal extended characters in this source - they get mangled in transit),
        // and the assertions avoid glyph/codepage assumptions: byte 134 is a real extended
        // character in both CP437 and CP850, and the tests assert INVERSE-ness (read->write
        // reproduces the exact bytes), not which glyph the codepage maps it to.
        // ==================================================================================

        Function WriteBytesToFile UChar[] ucaBytes String sFilePath Returns Boolean
            Integer iChannel
            Move (Seq_New_Channel()) to iChannel
            If (iChannel < 0) ;
                Function_Return False
            Direct_Output Channel iChannel ("binary:" + sFilePath)
            Write Channel iChannel ucaBytes
            Close_Output Channel iChannel
            Send Seq_Release_Channel iChannel
            Function_Return True
        End_Function

        Function ReadBytesFromFile String sFilePath Returns UChar[]
            Integer iChannel iSize
            UChar[] ucaBytes

            Move (rfFileSize(sFilePath)) to iSize
            If (iSize <= 0) ;
                Function_Return ucaBytes
            Move (Seq_New_Channel()) to iChannel
            If (iChannel < 0) ;
                Function_Return ucaBytes
            Direct_Input Channel iChannel ("binary:" + sFilePath)
            Read_Block Channel iChannel ucaBytes iSize
            Close_Input Channel iChannel
            Send Seq_Release_Channel iChannel
            Function_Return ucaBytes
        End_Function

        // An OEM file holding an extended byte must survive read -> write BYTE-EXACT.
        // "A" 134 "b" CRLF "x": whatever glyph the system OEM codepage maps 134 to, the
        // read (OEM -> internal Unicode) followed by the write (internal -> OEM) must
        // reproduce the original bytes - or the engine corrupts every non-ASCII legacy
        // file it rewrites (LegacyCode.pkg is DELIBERATELY OEM; customer files too).
        {Published = True}
        Procedure Oem_ExtendedByteRoundTrip_ByteExact
            Boolean bOk bSame
            Integer iVoid i
            String sDataPath sFileA sFileB
            String[] asRead
            UChar[] ucaIn ucaOut

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTestA.tmp") to sFileA
            Move (sDataPath + "_EncTestB.tmp") to sFileB
            Move 65  to ucaIn[0]     // A
            Move 134 to ucaIn[1]     // extended char (a-ring in CP437 AND CP850)
            Move 98  to ucaIn[2]     // b
            Move 13  to ucaIn[3]
            Move 10  to ucaIn[4]
            Move 120 to ucaIn[5]     // x
            Get WriteBytesToFile ucaIn sFileA to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sFileA)) to asRead
            Send Assert (SizeOfArray(asRead) = 2)
            Get rfWriteEncodedFileFromStringArray (&asRead) sFileB C_NewLine False to bOk
            Send Assert bOk
            Get ReadBytesFromFile sFileB to ucaOut
            Move (SizeOfArray(ucaOut) = SizeOfArray(ucaIn)) to bSame
            If (bSame = True) Begin
                For i from 0 to (SizeOfArray(ucaIn) - 1)
                    If (ucaOut[i] <> ucaIn[i]) ;
                        Move False to bSame
                Loop
            End
            Send Assert bSame
            Move (rfDeleteFile(sFileA)) to iVoid
            Move (rfDeleteFile(sFileB)) to iVoid
        End_Procedure

        // The SAME extended-character content must survive crossing to UTF-8 and back:
        // read from an OEM file, write as UTF-8 (BOM + multi-byte char), read again -
        // string-identical. This is the exact editor<->engine exchange when one side is
        // UTF-8 and the other OEM.
        {Published = True}
        Procedure Utf8_ExtendedCharCrossEncodingRoundTrip
            Boolean bOk
            Integer iVoid
            String sDataPath sFileA sFileB
            String[] asOem asUtf8
            UChar[] ucaIn

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTestA.tmp") to sFileA
            Move (sDataPath + "_EncTestB.tmp") to sFileB
            Move 65  to ucaIn[0]
            Move 134 to ucaIn[1]
            Move 98  to ucaIn[2]
            Get WriteBytesToFile ucaIn sFileA to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sFileA)) to asOem
            Send Assert (SizeOfArray(asOem) = 1)
            Get rfWriteEncodedFileFromStringArray (&asOem) sFileB C_NewLine True to bOk
            Send Assert bOk
            Send Assert (rfFileHasBOM(sFileB))
            // The extended char must be MULTI-byte on disk in UTF-8: 3 BOM + 'A' + 2+ + 'b'.
            Send Assert (rfFileSize(sFileB) >= 6)
            Move (rfReadEncodedFileAsStringArray(sFileB)) to asUtf8
            Send AssertArrayAreEqual asOem asUtf8
            Move (rfDeleteFile(sFileA)) to iVoid
            Move (rfDeleteFile(sFileB)) to iVoid
        End_Procedure

        // The 3 BOM bytes must NEVER reach asLines[0] - a leaked BOM becomes an invisible
        // first-column character that breaks first-token dispatch on the file's first line.
        {Published = True}
        Procedure Utf8Read_BomNotInFirstLine
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asRead
            UChar[] ucaIn

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move 239 to ucaIn[0]    // EF
            Move 187 to ucaIn[1]    // BB
            Move 191 to ucaIn[2]    // BF
            Move 65  to ucaIn[3]    // A
            Move 98  to ucaIn[4]    // b
            Move 13  to ucaIn[5]
            Move 10  to ucaIn[6]
            Move 67  to ucaIn[7]    // C
            Get WriteBytesToFile ucaIn sTempFile to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send Assert (SizeOfArray(asRead) = 2)
            Send AssertSAreEqual "Ab" asRead[0]
            Send AssertSAreEqual "C"  asRead[1]
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // Line-break detection: CRLF file -> C_NewLine, LF-only file -> CS_LF. The rewrite
        // must preserve a file's own convention, and this is the function that decides it.
        {Published = True}
        Procedure DetectFileLineBreak_CrlfVsLf
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile sBreak
            UChar[] ucaCrlf ucaLf

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move 65 to ucaCrlf[0]
            Move 13 to ucaCrlf[1]
            Move 10 to ucaCrlf[2]
            Move 66 to ucaCrlf[3]
            Get WriteBytesToFile ucaCrlf sTempFile to bOk
            Send Assert bOk
            Move (rfDetectFileLineBreak(sTempFile)) to sBreak
            Send AssertSAreEqual C_NewLine sBreak
            Move 65 to ucaLf[0]
            Move 10 to ucaLf[1]
            Move 66 to ucaLf[2]
            Get WriteBytesToFile ucaLf sTempFile to bOk
            Send Assert bOk
            Move (rfDetectFileLineBreak(sTempFile)) to sBreak
            Send AssertSAreEqual CS_LF sBreak
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // An OEM write must add NO BOM and start at the first content byte.
        {Published = True}
        Procedure OemWrite_NoBomAdded
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asWrite
            UChar[] ucaOut
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move "Abc" to asWrite[0]
            Get rfWriteEncodedFileFromStringArray (&asWrite) sTempFile C_NewLine False to bOk
            Send Assert bOk
            Send AssertFalse (rfFileHasBOM(sTempFile))
            Get ReadBytesFromFile sTempFile to ucaOut
            Send Assert (SizeOfArray(ucaOut) > 0)
            Send Assert (ucaOut[0] = 65)
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        // Appends the ASCII text of sText, one byte per character. The NUL fixtures below are built at
        // the BYTE level, because the point under test is what the reader makes of bytes no String
        // literal can carry.
        Procedure AppendAsciiBytes UChar[] ByRef ucaBytes String sText
            Integer i iLen iDst
            Move (Length(sText)) to iLen
            Move (SizeOfArray(ucaBytes)) to iDst
            For i from 1 to iLen
                Move (Ascii(Mid(sText, 1, i))) to ucaBytes[iDst]
                Increment iDst
            Loop
        End_Procedure

        /* A NUL BYTE MUST NOT COST THE REST OF THE DECODE WINDOW (2026-09-07): a junk line of the bytes
           00 02 in the middle of an 8 KB window ended the window's text at the NUL - PointerToString
           stops there - and 96 lines vanished from a file the compiler itself accepted. Every line after
           the NUL survives, and the junk line survives as the two characters it is. */
        {Published = True}
        { Description = "A NUL byte inside a decode window keeps every line after it, and the line it sits on" }
        Procedure NulByte_LinesAfterItSurvive_Oem
            Boolean bOk
            Integer iVoid i
            String sDataPath sTempFile
            String[] asRead
            UChar[] ucaIn
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Send AppendAsciiBytes (&ucaIn) "Line1"
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Move 0  to ucaIn[SizeOfArray(ucaIn)]
            Move 2  to ucaIn[SizeOfArray(ucaIn)]
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            // 300 body lines of ~60 bytes: the file spans more than two 8 KB decode windows.
            For i from 1 to 300
                Send AppendAsciiBytes (&ucaIn) ("Body line " + String(i) + " padded so the file outgrows one window.")
                Move 13 to ucaIn[SizeOfArray(ucaIn)]
                Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Loop
            Send AppendAsciiBytes (&ucaIn) "Last"
            Get WriteBytesToFile ucaIn sTempFile to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertIAreEqual 303 (SizeOfArray(asRead))
            Send AssertSAreEqual "Line1" asRead[0]
            Send AssertSAreEqual "Body line 1 padded so the file outgrows one window." asRead[2]
            Send AssertSAreEqual "Body line 300 padded so the file outgrows one window." asRead[301]
            Send AssertSAreEqual "Last" asRead[302]
            // The junk line itself: two characters, the first the NUL.
            Send AssertIAreEqual 2 (Length(asRead[1]))
            Send AssertIAreEqual 0 (Ascii(asRead[1]))
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        {Published = True}
        { Description = "A file with a NUL byte reads and writes back byte for byte" }
        Procedure NulByte_RoundTrip_ByteExact
            Boolean bOk bSame
            Integer iVoid i iMax
            String sDataPath sTempFile
            String[] asRead
            UChar[] ucaIn ucaOut
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Send AppendAsciiBytes (&ucaIn) "A"
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Move 0  to ucaIn[SizeOfArray(ucaIn)]
            Move 2  to ucaIn[SizeOfArray(ucaIn)]
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Send AppendAsciiBytes (&ucaIn) "B"
            Get WriteBytesToFile ucaIn sTempFile to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertIAreEqual 3 (SizeOfArray(asRead))
            Get rfWriteEncodedFileFromStringArray (&asRead) sTempFile C_NewLine False to bOk
            Send Assert bOk
            Get ReadBytesFromFile sTempFile to ucaOut
            Move (SizeOfArray(ucaIn) = SizeOfArray(ucaOut)) to bSame
            If (bSame = True) Begin
                Move (SizeOfArray(ucaIn) - 1) to iMax
                For i from 0 to iMax
                    If (ucaIn[i] <> ucaOut[i]) ;
                        Move False to bSame
                Loop
            End
            Send Assert bSame
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        {Published = True}
        { Description = "The UTF-8 (BOM) decoder keeps the lines after a NUL byte too" }
        Procedure NulByte_LinesAfterItSurvive_Utf8
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asRead
            UChar[] ucaIn
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Move 239 to ucaIn[0]    // EF
            Move 187 to ucaIn[1]    // BB
            Move 191 to ucaIn[2]    // BF
            Send AppendAsciiBytes (&ucaIn) "Ab"
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Move 0  to ucaIn[SizeOfArray(ucaIn)]
            Move 2  to ucaIn[SizeOfArray(ucaIn)]
            Move 13 to ucaIn[SizeOfArray(ucaIn)]
            Move 10 to ucaIn[SizeOfArray(ucaIn)]
            Send AppendAsciiBytes (&ucaIn) "C"
            Get WriteBytesToFile ucaIn sTempFile to bOk
            Send Assert bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertIAreEqual 3 (SizeOfArray(asRead))
            Send AssertSAreEqual "Ab" asRead[0]
            Send AssertSAreEqual "C"  asRead[2]
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        {Published = True}
        { Description = "rfFirstNulLine names the line of the first NUL byte, 0 for a clean file" }
        Procedure FirstNulLine_LineOrZero
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            UChar[] ucaWithNul ucaClean
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Send AppendAsciiBytes (&ucaWithNul) "A"
            Move 13 to ucaWithNul[SizeOfArray(ucaWithNul)]
            Move 10 to ucaWithNul[SizeOfArray(ucaWithNul)]
            Move 0  to ucaWithNul[SizeOfArray(ucaWithNul)]
            Get WriteBytesToFile ucaWithNul sTempFile to bOk
            Send Assert bOk
            Send AssertIAreEqual 2 (rfFirstNulLine(sTempFile))
            Send AppendAsciiBytes (&ucaClean) "A"
            Move 13 to ucaClean[SizeOfArray(ucaClean)]
            Move 10 to ucaClean[SizeOfArray(ucaClean)]
            Send AppendAsciiBytes (&ucaClean) "B"
            Get WriteBytesToFile ucaClean sTempFile to bOk
            Send Assert bOk
            Send AssertIAreEqual 0 (rfFirstNulLine(sTempFile))
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* A TOOL'S REDIRECTED OUTPUT, each line read as what its bytes are (2026-09-30). The file df-cli's
           logs are: its own messages in the Windows code page - E5 E4 F6 is "åäö" in 1252, the Western code
           page every machine this runs on has - the registry's text in UTF-8 - E2 80 99 is U+2019 - and no
           BOM. CR LF, LF, an empty line and an unterminated last line on the way. */
        Function ToolOutputBytes Returns UChar[]
            UChar[] uca
            Send AppendAsciiBytes (&uca) "ok"
            Move 13  to uca[SizeOfArray(uca)]
            Move 10  to uca[SizeOfArray(uca)]
            Send AppendAsciiBytes (&uca) "x "
            Move 229 to uca[SizeOfArray(uca)]
            Move 228 to uca[SizeOfArray(uca)]
            Move 246 to uca[SizeOfArray(uca)]
            Move 13  to uca[SizeOfArray(uca)]
            Move 10  to uca[SizeOfArray(uca)]
            Move 10  to uca[SizeOfArray(uca)]
            Send AppendAsciiBytes (&uca) "API"
            Move 226 to uca[SizeOfArray(uca)]
            Move 128 to uca[SizeOfArray(uca)]
            Move 153 to uca[SizeOfArray(uca)]
            Send AppendAsciiBytes (&uca) "s"
            Move 10  to uca[SizeOfArray(uca)]
            Send AppendAsciiBytes (&uca) "end"
            Function_Return uca
        End_Function

        {Published = True}
        { Description = "rfReadToolOutputLines reads a Windows code page line and a UTF-8 line from one file, each as itself" }
        Procedure ToolOutput_EachLineAsItsBytes
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asWant asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Get WriteBytesToFile (ToolOutputBytes(Self)) sTempFile to bOk
            Move "ok"    to asWant[0]
            Move "x åäö" to asWant[1]
            Move ""      to asWant[2]
            Move "API’s" to asWant[3]
            Move "end"   to asWant[4]
            Move (rfReadToolOutputLines(sTempFile)) to asRead
            Send AssertArrayAreEqual asWant asRead
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* THE POSITIVE CONTROL: the file above is one the BOM rule gets wrong - read as OEM, its Windows code
           page line is not "x åäö" (it was "x Õõ÷" in the Convert dialog) - so the test above cannot pass by
           the new reader doing what the old one did. */
        {Published = True}
        { Description = "The BOM rule misreads the Windows code page line rfReadToolOutputLines reads right" }
        Procedure ToolOutput_TheBomRuleMisreadsIt
            Boolean bOk
            Integer iVoid
            String sDataPath sTempFile
            String[] asRead
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_EncTest.tmp") to sTempFile
            Get WriteBytesToFile (ToolOutputBytes(Self)) sTempFile to bOk
            Move (rfReadEncodedFileAsStringArray(sTempFile)) to asRead
            Send AssertFalse (asRead[1] = "x åäö")
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

    End_Object
