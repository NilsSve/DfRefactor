//
// Contents:
//  Unfortunately the naming style of datadictionaries over time has not been constant.
//  The new style is
//    Object o<tablename>_DD is a c<TableName>Datadictionary
//  They also have a switch so you can keep on using the legacy style name which is
//    Object o<tablename>_DD is a <tablename>_Datadictionary
//
//  However before VDF12, the
//    Object <tableName>_DD is a <tablename>_Datadictionary
//
//  This caused tremendous headaches as due to the extra "o" we ended up with name clashes
//  all over the place. Copying old code into new views/dialogs simply breaks and if your
//  codebase has mixed styles then the compiler will not catch that.
//  A code nightmare.
//
//  This program allows you to switch between the following code styles:
//
//  <TableName>_DD              == eDDOldStyle
//  o<TableName>_DD             == eDDStudioStyle
//
//
// How this code works:
// 1. It scans your source file and for each file it will locate the datadictionary objects
//    These datadictionary objects are then stored in an array
// 2. We read the whole filelist into another array so that we know what table names can be
//    used.
// 3. The DDOs found in step 1) are classified against the filelist items and we determine
//    the DDO style used for the declared DDOs. DDOs that could be verified are labeled
//    on style used and marked as being verified.
// 4. We scan the source again and replace the verified DDOs with the style wanted.
// 5. Write the source out to disk (overwriting the original)
//
//
// Please note that if your source already contains unknown DD objects (eg. You copied old
// style code from another version of your appinto new style code) that this parser will
// not try to correct that. The starting point should be correct working code.
//
// Note if a detected DDO is in commented out source code then we will still replace it,
// this is to make sure uncommenting code doesn't break the source.
// Commented out DDO declarations are -not- detected.
//
// The following use cases are not supported by the DDRestyler:
//   - include files,
//   - source files with incorrect DDOs already in there
//       (eg. declare o<table>_DD but later on use <table>_DD)
//   - references to DDO's not declared in the source file (non autonomous usage) - except by object path,
//     <DDO>(<parent object>(...)), which is renamed with the DDO in every file of the run (2026-11-01)
//
//*****************************************************************************************
Use seq_chnl.pkg
Use vwin32fh.pkg
Use RefactorConstants.h.pkg
Use cEncodingHelpers.pkg
Use RefactorStatusPanel.pkg

// The function library's write-time guard (cRefactorFuncLib), which this package is compiled before.
Register_Function _GuardedWriteEncodedFile String sFile String[] ByRef asNew Boolean bIsUtf8 Returns Boolean

Declare_Datafile SysFile

Struct tFileListDDO
    Integer iFileNum
    String  sRootName     // actual filename
    String  sDisplayName  // description
    String  sTable        // datadictionary name is based on sTable (see aliases)
End_Struct

Struct tDDO
    String  sDDO          // sDDO name
    Boolean bVerified     // sDDO name has been verified against filelist
    Integer eDDOStyle     // DDO naming style
    Integer iLine         // source line where the DDO is declared
    Integer iFileNum      // Not needed at this stage, but we got the data, so stick it in
    String  sTableName    // Just as easy to have
    String  sContainer    // the object it is declared in, lowercase ("" at the top): another file reaches it through that
End_Struct

Class cDataFiles is a cObject
    Procedure Construct_Object
        Forward Send Construct_Object
        Property tFileListDDO[] pFileList
    End_Procedure
    
    // Loops through the Filelist.cfg and enumerates all tables.
    Procedure EnumerateAllFiles
        Integer iFile iIndex 
        String sRoot sDisplay sTable
        tFileListDDO[] aFilelist

        Move (ResizeArray(aFilelist,0)) to aFilelist
        Move 0 to iFile
        Move 0 to iIndex
        Repeat
            Get_Attribute DF_FILE_NEXT_USED of iFile to iFile
            If (iFile > 0) Begin
                Get_Attribute DF_FILE_ROOT_NAME    of iFile to sRoot
                Get_Attribute DF_FILE_DISPLAY_NAME of iFile to sDisplay
                Get_Attribute DF_FILE_LOGICAL_NAME of iFile to sTable
                Move iFile    to aFilelist[iIndex].iFileNum
                Move sRoot    to aFilelist[iIndex].sRootName
                Move sDisplay to aFilelist[iIndex].sDisplayName
                Move sTable   to aFilelist[iIndex].sTable
                Increment iIndex
            End
        Until (iFile = 0)
        
        Set pFileList to aFilelist
    End_Procedure

End_Class

Class cDDOReStyler is a cObject
    Procedure Construct_Object
        Forward Send Construct_Object
  
        Property String   psFileName  ""
        Property String[] pasSource
        Property tDDO[]   pDDObjects
        Property Boolean  pbStrict       True   // Only replace verified DDOs, non strict not supported atm (Search code if need)
        Property Integer  peDDOStyle eDDNewStyle
        Property Boolean  pbCamelCaseTableName True // For new tablename Camel Case the TableName in the object

        Property String psHomeTarget
        Property String[] pasAllFiles
        Property Integer piFileCount
        Property Boolean pbLastFileWasUtf8 False
        // The DDOs another file can reach by object path (CollectPathRenames): "<old ddo>(<parent object>", lowercase,
        // the new name for each, and the keys sorted for the lookup.
        Property String[] pasPathRenameKeys
        Property String[] pasPathRenameNew
        Property String[] pasPathRenameSorted

        Object oDataFiles is a cDataFiles
        End_Object

    End_Procedure

    Function StartDDORestyler Returns Integer
        Boolean bOk bStop bSwapped bCancel
        Integer iCount iSize
        String[] asAllFiles
        String sSWSFile

        Set piFileCount to 0
        Get pasAllFiles to asAllFiles
        Move (SizeOfArray(asAllFiles)) to iSize
        Decrement iSize
        Set piPosition  of ghoProgressBar to 0
        Set piAdvanceBy of ghoProgressBar to 1
        Set piMaximum   of ghoProgressBar to (iSize + 1)

        // Enumerate the TARGET workspace's tables exactly once here, with the
        // active filelist redirected for ONLY this metadata call, then restore
        // it immediately. The per-file loop below (ApplyNewStyle, WriteFile)
        // can raise runtime errors; keeping the redirect window this tight
        // guarantees those errors are logged to DFRefactor's OWN
        // StatLog/Functions tables - a wider window corrupts that logging.
        // ClassifyDDObjects reuses this cached oDataFiles.pFileList.
        Get psSWSFile of ghoApplication to sSWSFile
        Get ApplyTargetFilelist of ghoApplication sSWSFile to bSwapped
        Send EnumerateAllFiles of oDataFiles
        If (bSwapped) Begin
            Send RestoreActiveFilelist of ghoApplication
        End
        // A DDO another file reaches by its object path is renamed there too.
        Send CollectPathRenames asAllFiles (peDDOStyle(Self))

        For iCount from 0 to iSize
            Send RestyleDDObjects asAllFiles[iCount] (peDDOStyle(Self))
            If (Active_State(ghoStatusPanel) = True) Begin
                // File-No counter in the CAPTION (consistent with the engine + the other whole-file
                // functions); the full path goes to the multi-line TableName line (panel field
                // conventions - see RefactorStatusPanel.pkg).
                Set Caption_Text of ghoStatusPanel to ("DD restyle - File No:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set TableName_Text of ghoStatusPanel to asAllFiles[iCount]
            End
            // Mid-run cancel: the old inner Cancel_Check was REMOVED (its End_Status
            // deactivates the panel, swallowing the signal - same bug as
            // cRemoveUnusedLocals). Poll the side-effect-free accessor instead and bail;
            // the engine's outer Cancel_Check at the eOtherFunctionsAll boundary then
            // runs the confirm pipeline once. Files already restyled stay restyled,
            // like any engine cancel.
            Get pbUserCancelRequested of ghoEngine to bCancel
            If (bCancel = True) ;
                Move iSize to iCount
        Loop
        
        Function_Return (piFileCount(Self))
    End_Function

    Procedure ReadFile String sFileName
        String[] asSource

        Set psFileName        to sFileName
        Set pbLastFileWasUtf8 to (rfFileHasBOM(sFileName))
        Move (rfReadEncodedFileAsStringArray(sFileName)) to asSource
        Set pasSource to asSource
    End_Procedure

    Procedure WriteFile
        Boolean  bExists bOK bIsUtf8
        String   sFileName
        String[] asSource

        Get psFileName        to sFileName
        Get pbLastFileWasUtf8 to bIsUtf8
        Get vFilePathExists sFileName to bExists
        If (bExists = False) Begin
            Error DFERR_PROGRAM ("File not found:" * String(sFileName) * "WriteFile (cDDOReStyler)")
            Procedure_Return
        End
        Get pasSource to asSource
        // Through the write-time guard, like every pass that writes its own files: macro code, a multi-line
        // string's text and #HEADER lines are never refactored. It also keeps the file's own line breaks and
        // whether it ended with one.
        Get _GuardedWriteEncodedFile of ghoFuncLib sFileName (&asSource) bIsUtf8 to bOK
    End_Procedure

    // Scans the whole file and locates the declared datadictionary objects based on that
    // the line will start with "Object" and ends with "_DataDictionary".
    //
    // The search is case insensitive, commented out source will be ignored.
    //
    // Example line that will be detected:
    //  Object oCustomer_DD is a Customer_DataDictionary
    //
    // Each DDO also gets the object it is declared in (sContainer): another file reaches it through that name -
    // Customer_DD(Invoice_vw(...)) - see CollectPathRenames.
    Procedure FindCurrentDDObjects
        Integer iCount iLine iPos iSpaceChars iDDO
        String  sLine sDDObject sNline sName sParent   // sNline: the line normalized, lowercase and trimmed
        String[] asSource asParents
        tDDO[] DDObjects

        Move 0 to iDDO
        Move (ResizeArray(DDObjects, 0)) to DDObjects
        Get pasSource to asSource
        
        Move (SizeOfArray(asSource) -1) to iCount
        If (iCount >= 0) Begin
            For iLine from 0 to iCount
                Move asSource[iLine] to sLine
                Move (Lowercase(Trim(sLine))) to sNline
                If (Left(sNline, 10) = "end_object" and SizeOfArray(asParents) > 0) ;
                    Move (ResizeArray(asParents, (SizeOfArray(asParents) - 1))) to asParents
                If (Pos("object ", sNline) = 1) Begin
                    Move "" to sParent
                    If (SizeOfArray(asParents) > 0) ;
                        Move asParents[SizeOfArray(asParents) - 1] to sParent
                    Move (Trim(Right(sNline, (Length(sNline) - 7)))) to sName
                    If (Pos(" ", sName) > 0) ;
                        Move (Left(sName, (Pos(" ", sName) - 1))) to sName
                    Move sName to asParents[SizeOfArray(asParents)]
                    Move (Pos("_datadictionary", sNline)) to iPos
                    If (iPos > 0) Begin
                        Move (Replace("object ", sNline, "")) to sNline
                        // Space characters on the left? Count them
                        Move (Length(sNline) - (Length(Ltrim(sNline)))) to iSpaceChars
                        Move (Ltrim(sNline)) to sNline // Remove them
                        Move (Pos(CS_S, sNline)) to iPos
                        If (iPos <> 0) Begin
                            Move (Mid(Ltrim(sLine), (iPos -1), (8 + iSpaceChars))) to sDDObject
                            Move sDDObject  to DDObjects[iDDO].sDDO
                            Move iLine      to DDObjects[iDDO].iLine
                            Move False      to DDObjects[iDDO].bVerified
                            Move eDDUnknown to DDObjects[iDDO].eDDOStyle
                            Move sParent    to DDObjects[iDDO].sContainer
                            Increment iDDO
                        End
                    End
                End
            Loop
        End
        
        Set pDDObjects to DDObjects
    End_Procedure

    // Helper function for comparing tablenames in the filelist
    //
    // Custom comparison function:
    //   Returns (GT) if struct value in first parameter > struct value in second parameter.
    //   Returns (LT) if struct value in first parameter < struct value in second parameter.
    //   Otherwise returns (EQ).
    Function CompareTableNames tFileListDDO  List1 tFileListDDO List2 Returns Integer
        Move (Lowercase(List1.sTable)) to List1.sTable
        Move (Lowercase(List2.sTable)) to List2.sTable
        If (List1.sTable > List2.sTable) Begin
            Function_Return (GT)
        End
        Else If (List1.sTable < List2.sTable) Begin
            Function_Return (LT)
        End
        Function_Return (EQ)
    End_Function

    // Looks at the DD Objects found in the source and
    // tests them against the filelist plus determines the type
    Procedure ClassifyDDObjects
        Boolean bHasObjectPrefix bHasDDPostfix bHasDataDictionaryPostfix
        Integer iListSize iCount iDDO iFile
        String sDDO sTableName sTableNameO // exception if tablename actually starts with letter O
        tDDO[] DDObjects
        tFileListDDO SearchFile
        tFileListDDO[] FileList

        // oDataFiles.pFileList was populated once by StartDDORestyler (with the
        // filelist briefly redirected to the target workspace). Reuse it - do
        // NOT re-enumerate here: that would require the redirect to be active
        // during the error-prone per-file processing.
        Get pFileList of oDataFiles    to FileList
        Move (SizeOfArray(FileList)-1) to iListSize
        Get pDDObjects to DDObjects
        Move (SizeOfArray(DDObjects)-1) to iCount
        
        If (iListSize >= 0 and iCount >= 0) Begin
            For iDDO from 0 to iCount
                Move False to bHasObjectPrefix
                Move False to bHasDDPostfix
                Move False to bHasDataDictionaryPostfix
                Move ""    to sTableNameO
                Move DDObjects[iDDO].sDDO to sDDO
                Move (Trim(sDDO)) to sTableName
                If (sTableName<>"") Begin
                    If (Lowercase(Left(sTableName, 1)) = "o") Begin
                        Move True to bHasObjectPrefix
                        Move (Replace(Mid(sTableName, 1, 1), sTableName, "")) to sTableName
                        Move (Trim(sDDO)) to sTableNameO // What if tablename actually starts with a letter "o" ?
                    End
                    If (Lowercase(Right(sTableName, 3)) = "_dd") Begin
                        Move True to bHasDDPostFix
                        Move (Left(sTableName,Length(sTableName) -3)) to sTableName
                        If (sTableNameO <> "") Begin
                            Move (Left(sTableNameO,Length(sTableNameO) -3)) to sTableNameO
                        End
                    End
                    Else If (Lowercase(Right(sTableName, 15)) = "_datadictionary") Begin
                        Move True to bHasDataDictionaryPostFix
                        Move (Left(sTableName, Length(sTableName) -15)) to sTableName
                        If (sTableNameO <> "") Begin
                            Move (Left(sTableNameO,Length(sTableNameO) -15)) to sTableNameO
                        End
                    End
                    Move sTableName to SearchFile.sTable
                    Move (SearchArray(SearchFile,FileList, Self, (RefFunc(CompareTableNames)) )) to iFile
                    If (iFile >- 1) Begin
                        Move True to DDObjects[iDDO].bVerified
                        Move FileList[iFile].iFileNum to DDObjects[iDDO].iFileNum
                        Move FileList[iFile].sTable   to DDObjects[iDDO].sTableName
                    End
                    Else If (sTableNameO <> "") Begin
                        Move sTableNameO to SearchFile.sTable
                        Move (SearchArray(SearchFile,FileList, Self, (RefFunc(CompareTableNames)) )) to iFile
                        If (iFile >- 1) Begin
                            Move False to bHasObjectPrefix
                            Move True  to DDObjects[iDDO].bVerified
                            Move FileList[iFile].iFileNum to DDObjects[iDDO].iFileNum
                            Move FileList[iFile].sTable   to DDObjects[iDDO].sTableName
                        End
                    End
                    If (bHasObjectPrefix = False and bHasDDPostfix) Begin
                        Move eDDOldStyle to DDObjects[iDDO].eDDOStyle
                    End
                    Else If (bHasObjectPrefix) Begin
                        If (bHasDDPostfix) Begin
                            Move eDDStudioStyle to DDObjects[iDDO].eDDOStyle
                        End
                    End
                End
            Loop
            Set pDDObjects to DDObjects
        End
    End_Procedure

    Function NewStyleName String sTableName Integer eNewStyle Returns String
        String  sDDStyle
        Boolean bCamelCase

        Get pbCamelCaseTableName to bCamelCase
        If (bCamelCase) Begin
            // Camel Case makes the whole tablename lowercase except for the first Letter
            Move (lowercase(sTableName)) to sTableName
            Move (Overstrike(Uppercase(Left(sTableName,1)),sTableName,1)) to sTableName
        End

        Case Begin
            Case (eNewStyle = eDDOldStyle)
                Move (sTableName + "_DD") to sDDStyle
                Case Break
            Case (eNewStyle = eDDStudioStyle)
                Move ("o" + sTableName + "_DD") to sDDStyle
                Case Break
            Case (eNewStyle = eDDNewStyle)
                Move ("o" + sTableName + "_DD") to sDDStyle
                Case Break
            Case Else
                Error DFErr_Program ("Unexpected error new style" * Trim(eNewStyle) * "is undefined.")
        Case End
        Function_Return sDDStyle
    End_Function

    Procedure ApplyNewStyleForTable tDDO DDObject
        Boolean bUpdated
        Integer eNewStyle eOldStyle iCount iLine iPos iLen
        String sLine sNline sNOldDDName sNewDDName
        String[] asSource

        Get peDDOStyle to eNewStyle
        Move DDObject.eDDOStyle to eOldStyle
        If (eNewStyle <> eOldStyle) Begin
            Get pasSource to asSource
            Move (Lowercase(DDObject.sDDO)) to sNOldDDName
            Move (Length(sNOldDDName))      to iLen
            Get NewStyleName DDObject.sTableName eNewStyle to sNewDDName
            Move (SizeOfArray(asSource) -1)  to iCount
            
            If (iCount >= 0) Begin
                For iLine from 0 to iCount
                    Move False to bUpdated
                    Move asSource[iLine] to sLine
                    
                    // End of line happens, see Set DDO_Server To <table>_DD
                    Move (sLine + CS_S) to sLine
                    Move (Lowercase(sLine)) to sNline
                    // Valid separate characters are: " ",",","(",")", EOL
                    // The DDO objects are _never_ at the start of the line
                    Move (Replaces(",", sNline, CS_S)) to sNline
                    Move (Replaces("(", sNline, CS_S)) to sNline
                    Move (Replaces(")", sNline, CS_S)) to sNline

                    // Only one type of replacement left, easy testing :)
                    Move (Pos(CS_S + sNOldDDName + CS_S, sNline)) to iPos
                    While (iPos <> 0)
                        Move True to bUpdated
                        Move (Replace(CS_S + sNOldDDName + CS_S, sNline, CS_S + sNewDDName + CS_S)) to sNline
                        // Don't know correct case in the actual line, use remove+insert
                        // Can't use replace on the real line as it will end up replacing replaced
                        Move (Remove(sLine, (iPos +1), iLen)) to sLine
                        Move (Insert(sNewDDName, sLine, (iPos +1))) to sLine

                        Move (Pos(CS_S + sNOldDDName + CS_S, sNline)) to iPos
                    Loop
                    If (bUpdated) Begin
                        // Strip ONLY the sentinel space appended on line 401, not
                        // every trailing whitespace char - users keep formatting on
                        // their comment lines and that whitespace must round-trip.
                        Move (Left(sLine, (Length(sLine) - 1))) to asSource[iLine]
                    End
                Loop
                Set pasSource to asSource
            End
        End
    End_Procedure

    // Does ApplyNewStyle rename this DDO to eStyle? Strict (the default) renames only a DDO verified against the
    // filelist: an unverified one is skipped quietly, not raised as an Error - those fired during the (former)
    // filelist redirect and on a re-run cascaded into an error storm and a corrupt run summary. Never a DDO whose
    // style was not recognised, nor one already in the style asked for. Non strict needs DDObject.sTableName filled
    // in still.
    Function WillRestyle tDDO DDObject Integer eStyle Returns Boolean
        If (pbStrict(Self) = True and DDObject.bVerified = False) ;
            Function_Return False
        If (DDObject.eDDOStyle = eDDUnknown or DDObject.eDDOStyle = eStyle) ;
            Function_Return False
        Function_Return True
    End_Function

    Function ApplyNewStyle Returns Integer
        Integer iFile iCount eStyle iFileCount
        tDDO[]  DDObjects

        Move 0 to iFileCount
        Get peDDOStyle to eStyle

        If (eStyle <> eDDUnknown) Begin
            Get pDDObjects to DDObjects
            Move (SizeOfArray(DDObjects) - 1) to iCount
            For iFile from 0 to iCount
                If (WillRestyle(Self, DDObjects[iFile], eStyle) = True) Begin
                    Send ApplyNewStyleForTable DDObjects[iFile]
                    Increment iFileCount
                End
            Loop
        End
        Function_Return iFileCount
    End_Function

    /* A DDO ANOTHER FILE REACHES BY ITS OBJECT PATH (2026-11-01). A program, a lookup or another view reaches a
       view's DDO by naming it with its parent - 'Send Request_Assign to (Customer_DD(Invoice_vw(Client_Area(Main))))'
       - and the rename reached only the file that declares the DDO, so in a whole-workspace run each such line named
       an object that no longer existed: 17 errors in 8 files of one workspace. This first pass over all the files
       finds every DDO the restyle renames, with the object it is declared in (AddPathRenames); each file then renames
       '<old>(<parent>' as well (ApplyPathRenames). Only that form: a file that reaches the DDO another way - an
       include, delegation - is still not followed, and nor is a file outside the run. */
    Procedure CollectPathRenames String[] asAllFiles Integer eStyle
        String[] asNone asMasked
        tWholeFileMask Mask Empty
        Integer iFile iLast iMacro
        Boolean bCancel

        Set pasPathRenameKeys   to asNone
        Set pasPathRenameNew    to asNone
        Set pasPathRenameSorted to asNone
        If (eStyle = eDDUnknown) ;
            Procedure_Return
        Move (SizeOfArray(asAllFiles) - 1) to iLast
        For iFile from 0 to iLast
            If (Active_State(ghoStatusPanel) = True) ;
                Set Caption_Text of ghoStatusPanel to ("DD restyle - finding the DDOs, File No:" * String(iFile + 1) * "of:" * String(iLast + 1))
            Send ReadFile asAllFiles[iFile]
            Get pasSource to asMasked
            Move Empty to Mask
            Get MaskForTransform of ghoFuncLib (&asMasked) (&Mask) to iMacro
            Set pasSource to asMasked
            Send FindCurrentDDObjects
            Send ClassifyDDObjects
            Send AddPathRenames eStyle
            Get pbUserCancelRequested of ghoEngine to bCancel
            If (bCancel = True) ;
                Move iLast to iFile
        Loop
    End_Procedure

    // The current file's DDOs (pDDObjects) that the restyle renames and another file can reach by object path - one
    // declared in an object - added to pasPathRenameKeys as "<old>(<parent>", lowercase, with the new name in
    // pasPathRenameNew; pasPathRenameSorted is the keys sorted, for the lookup. A "rename" to the same name - an
    // o<table>_DD counts as the Studio style, and the new style writes it the same - is left out.
    Procedure AddPathRenames Integer eStyle
        String[] asKeys asNew asSorted
        String sKey sOld sNew
        tDDO[] DDObjects
        Integer iDDO iLast

        Get pasPathRenameKeys to asKeys
        Get pasPathRenameNew  to asNew
        Get pDDObjects to DDObjects
        Move (SizeOfArray(DDObjects) - 1) to iLast
        For iDDO from 0 to iLast
            If (DDObjects[iDDO].sContainer <> "" and WillRestyle(Self, DDObjects[iDDO], eStyle) = True) Begin
                Move (Lowercase(Trim(DDObjects[iDDO].sDDO))) to sOld
                Move (NewStyleName(Self, DDObjects[iDDO].sTableName, eStyle)) to sNew
                Move (sOld + "(" + DDObjects[iDDO].sContainer) to sKey
                If (Lowercase(sNew) <> sOld and SearchArray(sKey, asKeys) = -1) Begin
                    Move sKey to asKeys[SizeOfArray(asKeys)]
                    Move sNew to asNew[SizeOfArray(asNew)]
                End
            End
        Loop
        Move (SortArray(asKeys)) to asSorted
        Set pasPathRenameKeys   to asKeys
        Set pasPathRenameNew    to asNew
        Set pasPathRenameSorted to asSorted
    End_Procedure

    // Can sChar be part of an object name?
    Function IsNameChar String sChar Returns Boolean
        If (sChar = "") ;
            Function_Return False
        Function_Return (Pos(Lowercase(sChar), "abcdefghijklmnopqrstuvwxyz0123456789_@#$") > 0)
    End_Function

    // Renames, in the current file (pasSource), every "<old>(<parent>" CollectPathRenames found - a DDO of another
    // file, reached by its object path - to the DDO's new name. Returns how many.
    Function ApplyPathRenames Returns Integer
        String[] asSource asKeys asNew asSorted
        String sLine sKey
        Integer iLine iLast iParen iB iEnd iA iStart iAt iLen iCount

        Get pasPathRenameSorted to asSorted
        If (SizeOfArray(asSorted) = 0) ;
            Function_Return 0
        Get pasPathRenameKeys to asKeys
        Get pasPathRenameNew  to asNew
        Get pasSource to asSource
        Move 0 to iCount
        Move (SizeOfArray(asSource) - 1) to iLast
        For iLine from 0 to iLast
            Move asSource[iLine] to sLine
            Move 0 to iParen
            If (Pos("(", sLine) > 0) ;
                Move (Length(sLine)) to iParen
            // Right to left, so a rename leaves the positions still to visit where they were.
            While (iParen > 0)
                If (Mid(sLine, 1, iParen) = "(") Begin
                    // the name before the parenthesis...
                    Move (iParen - 1) to iEnd
                    While (iEnd > 0 and Mid(sLine, 1, iEnd) = " ")
                        Decrement iEnd
                    Loop
                    Move iEnd to iB
                    While (iB > 0 and IsNameChar(Self, Mid(sLine, 1, iB)) = True)
                        Decrement iB
                    Loop
                    // ...and the name after it
                    Move (Length(sLine)) to iLen
                    Move (iParen + 1) to iStart
                    While (iStart <= iLen and Mid(sLine, 1, iStart) = " ")
                        Increment iStart
                    Loop
                    Move iStart to iA
                    While (iA <= iLen and IsNameChar(Self, Mid(sLine, 1, iA)) = True)
                        Increment iA
                    Loop
                    If (iEnd > iB and iA > iStart) Begin
                        Move (Lowercase(Mid(sLine, (iEnd - iB), (iB + 1))) + "(" + Lowercase(Mid(sLine, (iA - iStart), iStart))) to sKey
                        If (BinarySearchArray(sKey, asSorted) > -1) Begin
                            Move (SearchArray(sKey, asKeys)) to iAt
                            Move (Left(sLine, iB) + asNew[iAt] + Mid(sLine, iLen, (iEnd + 1))) to sLine
                            Increment iCount
                        End
                    End
                    // A name holds no parenthesis: go on before it.
                    Move (iB + 1) to iParen
                End
                Decrement iParen
            Loop
            Move sLine to asSource[iLine]
        Loop
        If (iCount > 0) ;
            Set pasSource to asSource
        Function_Return iCount
    End_Function

    // Code that handles the restyle on the DD Object in the source filename supplied
    // and changes it to the new style eDDStyle
    Procedure RestyleDDObjects String sFileName Integer eDDStyle
        Integer iChangedFiles iVoid iMacro iLost iPath
        String[] asBefore asAfter asMasked
        tWholeFileMask Mask

        Send ReadFile sFilename
        /* A block comment's, a report image's and a string's text and the macro code are masked away while the DDOs
           are found and renamed, and put back after (cRefactorFuncLib's MaskForTransform, 2026-10-30): a commented-out
           DDO is no DDO, and comment text is never refactored. */
        Get pasSource to asBefore
        Move asBefore to asMasked
        Get MaskForTransform of ghoFuncLib (&asMasked) (&Mask) to iMacro
        Set pasSource to asMasked
        Send FindCurrentDDObjects
        Send ClassifyDDObjects
        Set peDDOStyle to eDDStyle
        Get ApplyNewStyle to iVoid
        Get ApplyPathRenames to iPath
        If (iPath > 0) ;
            Send AddRunNote of ghoFuncLib (psExecutionContext(ghoFuncLib)) (sFileName + ":" * String(iPath) * "reference(s) to a DDO of another file, by its object path, renamed with it.")
        Get pasSource to asAfter
        Get UnmaskAfterTransform of ghoFuncLib (&asAfter) (&Mask) to iLost
        Set pasSource to asAfter
        If (iLost > 0) ;
            Send AddRunNote of ghoFuncLib (psExecutionContext(ghoFuncLib)) (sFileName + ":" * String(iLost) * "line(s) of comment, image or string text or macro code the conversion had removed were put back where they were - check the file.")
        // ApplyNewStyle's replace counter also counts NO-OP replacements - e.g.
        // a DDO already in the target style but classified as a different enum
        // (o<table>_DD is eDDStudioStyle, yet target eDDNewStyle also emits
        // o<table>_DD), so the counter can't tell whether the file truly
        // changed. Compare the source before/after instead (same approach the
        // engine uses) - the only reliable signal. piFileCount is the number
        // of CHANGED files the run summary reports; count and rewrite a file
        // only when its content genuinely changed.
        If (IsSameArray(asBefore, asAfter) = False) Begin
            Get piFileCount to iChangedFiles
            Set piFileCount to (iChangedFiles + 1)
            If (pbReadOnly(ghoFuncLib) = False) Begin
                Send WriteFile
            End
        End
    End_Procedure

End_Class
