//****************************************************************************
// $Module type: Test fixture
// $Module name: oSourceFolderSearch-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-30
//
// Description : Unit tests for the source-folder search's never-scan test (the function library's
//               RecursiveFolderSearch, _NoScanBase, _FolderPartToTest, IsFolderInNoFolderList): only the part of
//               a folder's path below the workspace home is tested, so a workspace kept under a folder named
//               Data, Programs, Help ... lists its folders, while its own Data, Programs and DfPkg folders and
//               its backup folder stay out of a source search.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorFileIO.pkg           // rfDirectoryCreateEx / rfRemoveFolderTree
    Object oSourceFolderSearch_Tests is a cTestFixture
        Set psFunctionName to "RecursiveSearchFolders"

        // The skip list a source search uses - the backup folder's name included.
        Function _SourceList Returns String[]
            String[] asList
            Get NoFolderListAsArray of ghoFuncLib False to asList
            Function_Return asList
        End_Function

        // Is sFolder skipped by a search that measures from sBase?
        Function _Skipped String sFolder String sBase String[] asList Returns Boolean
            String sPart
            Boolean bSkip
            Get _FolderPartToTest of ghoFuncLib sFolder sBase to sPart
            Get IsFolderInNoFolderList of ghoFuncLib asList sPart to bSkip
            Function_Return bSkip
        End_Function

        // Does asFolders hold sFolder - case and a trailing separator aside?
        Function _HasFolder String[] asFolders String sFolder Returns Boolean
            Integer i iLast
            String sWant
            Move (Lowercase(vFolderFormat(sFolder))) to sWant
            Move (SizeOfArray(asFolders) - 1) to iLast
            For i from 0 to iLast
                If (Lowercase(vFolderFormat(asFolders[i])) = sWant) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        {Published = True}
        Procedure FolderSearch_HomeUnderANeverScanName
            // A workspace kept under a folder named Data lists its own folders (2026-10-30: it listed none - the
            // whole path was tested, and every path held 'data'). Its own Data and Programs folders, a library in
            // its DfPkg folder and its backup folder stay out; a folder outside the home is tested on its full
            // path, as before, and so is every folder when there is no home.
            String[] asList
            String sHome sPart
            Boolean bSkip
            Get _SourceList to asList
            Move "D:\Data\Projects\MyApp\" to sHome
            Get _FolderPartToTest of ghoFuncLib "D:\Data\Projects\MyApp\AppSrc" sHome to sPart
            Send AssertSAreEqual "AppSrc" sPart
            Get _Skipped "D:\Data\Projects\MyApp\AppSrc" sHome asList to bSkip
            Send Assert (bSkip = False) "AppSrc, under a home in D:\Data"
            Get _Skipped "D:\Data\Projects\MyApp\AppSrc\Reports" sHome asList to bSkip
            Send Assert (bSkip = False) "a subfolder of AppSrc"
            Get _Skipped "D:\Data\Projects\MyApp\Data" sHome asList to bSkip
            Send Assert (bSkip = True) "the workspace's own Data folder"
            Get _Skipped "D:\Data\Projects\MyApp\Programs" sHome asList to bSkip
            Send Assert (bSkip = True) "the workspace's own Programs folder"
            Get _Skipped "D:\Data\Projects\MyApp\DfPkg\RDC_Lib-1.0\AppSrc" sHome asList to bSkip
            Send Assert (bSkip = True) "a library in the workspace's DfPkg folder"
            Get _Skipped "D:\Data\Projects\MyApp\DFRefactor_Backup\D\Data\Projects\MyApp\AppSrc" sHome asList to bSkip
            Send Assert (bSkip = True) "the backup folder, in a source search"
            Get _Skipped "E:\Install\Libs\MyLib\AppSrc" sHome asList to bSkip
            Send Assert (bSkip = True) "a folder outside the home: its full path, as before"
            Get _Skipped "E:\Libs\MyLib\AppSrc" sHome asList to bSkip
            Send Assert (bSkip = False) "a library outside the home with no such name"
            Get _Skipped "D:\Data\Projects\MyApp\AppSrc" "" asList to bSkip
            Send Assert (bSkip = True) "no home: the full path, as before"
        End_Procedure

        {Published = True}
        Procedure FolderSearch_BackupSearchMeasuresFromTheHomesMirror
            // A search in the backup folder measures from the home's mirror there - a backup mirrors its file's
            // full path, so every backed-up folder of a home in D:\Data held 'data' too (2026-10-30)
            String[] asList
            String sHome sBase
            Boolean bSkip
            Move "D:\Data\Projects\MyApp\" to sHome
            Get _NoScanBase of ghoFuncLib "D:\Data\Projects\MyApp\AppSrc" sHome to sBase
            Send AssertSAreEqual sHome sBase
            Get _NoScanBase of ghoFuncLib "D:\Data\Projects\MyApp\DFRefactor_Backup" sHome to sBase
            Send AssertSAreEqual "D:\Data\Projects\MyApp\DFRefactor_Backup\D\Data\Projects\MyApp\" sBase
            Get NoFolderListAsArray of ghoFuncLib True to asList
            Get _Skipped "D:\Data\Projects\MyApp\DFRefactor_Backup\D\Data\Projects\MyApp\AppSrc" sBase asList to bSkip
            Send Assert (bSkip = False) "a backed-up AppSrc of a home in D:\Data"
            Get _NoScanBase of ghoFuncLib "D:\Data\Projects\MyApp\AppSrc" "" to sBase
            Send AssertSAreEqual "" sBase
        End_Procedure

        {Published = True}
        Procedure FolderSearch_OnDisk_HomeUnderData
            // The search itself, on a folder tree in the Windows TEMP folder: a home in ...\Data\Proj lists its
            // AppSrc and AppSrc's subfolder; its own Data folder, its DfPkg library and its backup folder stay out
            // of a source search, and a search in the backup folder finds the backed-up AppSrc.
            String[] asFolders asList
            String sRoot sHome sMirror
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_FolderSearch\") to sRoot
            Move (sRoot + "Data\Proj\") to sHome
            Move (sHome + "DFRefactor_Backup\" + Replace(":", sHome, "")) to sMirror
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx((sHome + "AppSrc\Reports\"), False)) to bOk
            Send Assert bOk "the fixture: AppSrc\Reports"
            Move (rfDirectoryCreateEx((sHome + "Data\"), False)) to bOk
            Move (rfDirectoryCreateEx((sHome + "DfPkg\RDC_Lib-1.0\AppSrc\"), False)) to bOk
            Move (rfDirectoryCreateEx((sMirror + "AppSrc\"), False)) to bOk
            Send Assert bOk "the fixture: the backed-up AppSrc"

            Get _SourceList to asList
            Get RecursiveFolderSearch of ghoFuncLib sHome sHome asList to asFolders
            Send Assert (_HasFolder(Self, asFolders, (sHome + "AppSrc"))) "AppSrc is listed"
            Send Assert (_HasFolder(Self, asFolders, (sHome + "AppSrc\Reports"))) "AppSrc\Reports is listed"
            Send Assert (_HasFolder(Self, asFolders, (sHome + "Data")) = False) "the home's own Data folder is not"
            Send Assert (_HasFolder(Self, asFolders, (sHome + "DfPkg\RDC_Lib-1.0\AppSrc")) = False) "the DfPkg library is not"
            Send Assert (_HasFolder(Self, asFolders, (sMirror + "AppSrc")) = False) "the backup folder is not"
            Get NoFolderListAsArray of ghoFuncLib True to asList
            Get RecursiveFolderSearch of ghoFuncLib (sHome + "DFRefactor_Backup") sHome asList to asFolders
            Send Assert (_HasFolder(Self, asFolders, (sMirror + "AppSrc"))) "the backup search finds the backed-up AppSrc"
            Move (rfRemoveFolderTree(sRoot)) to bOk
        End_Procedure

    End_Object
