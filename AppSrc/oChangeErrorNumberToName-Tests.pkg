    Object oChangeErrorNumberToName is a cTestFixture
        Set psFunctionName to "ChangeErrorNumberToName"

        // A small fixed catalogue, so the tests need no DataFlex install.
        Procedure _UseErrorNames
            tErrorName[] aNames
            Move 25                     to aNames[0].iNumber
            Move "DFERR_REC_NOT_FOUND"  to aNames[0].sName
            Move 100                    to aNames[1].iNumber
            Move "DFERR_OPERATOR_ERROR" to aNames[1].sName
            Set paErrorNames of ghoFuncLib to aNames
            Set pbErrorNamesLoaded of ghoFuncLib to True
        End_Procedure

        Procedure _ForgetErrorNames
            tErrorName[] aNames
            Set paErrorNames of ghoFuncLib to aNames
            Set pbErrorNamesLoaded of ghoFuncLib to False
        End_Procedure

        // A named number on its own line.
        {Published = True}
        Procedure ChangeErrorNumberToName_Plain
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send _UseErrorNames
            Move "    Error 25" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeErrorNumberToName of ghoFuncLib (&sLine) to bChanged
            Send _ForgetErrorNames
            Send Assert bChanged
            Send AssertSAreEqual "    Error DFERR_REC_NOT_FOUND" sLine
        End_Procedure

        // After an If condition, with a message text: only the number changes.
        {Published = True}
        Procedure ChangeErrorNumberToName_AfterIfWithText
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Send _UseErrorNames
            Move 'If (iErr = 0) Error 100 "Bad value 25"' to sLine
            Move 'If (iErr = 0) Error DFERR_OPERATOR_ERROR "Bad value 25"' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeErrorNumberToName of ghoFuncLib (&sLine) to bChanged
            Send _ForgetErrorNames
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // After Else, and after an indicator bracket.
        {Published = True}
        Procedure ChangeErrorNumberToName_ElseAndBracket
            String sLine sLine2
            Boolean bChanged
            tTokenizer TokenizerData
            Send _UseErrorNames
            Move "Else Error 25" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeErrorNumberToName of ghoFuncLib (&sLine) to bChanged
            Move "[found] error 25" to sLine2
            Get Tokenizer of ghoFuncLib sLine2 to TokenizerData
            Get ChangeErrorNumberToName of ghoFuncLib (&sLine2) to bChanged
            Send _ForgetErrorNames
            Send AssertSAreEqual "Else Error DFERR_REC_NOT_FOUND" sLine
            Send AssertSAreEqual "[found] error DFERR_REC_NOT_FOUND" sLine2
        End_Procedure

        // A number DataFlex does not name stays as it is.
        {Published = True}
        Procedure ChangeErrorNumberToName_NotNamedKept
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send _UseErrorNames
            Move 'Error 300 "Wrong"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeErrorNumberToName of ghoFuncLib (&sLine) to bChanged
            Send _ForgetErrorNames
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Error 300 "Wrong"' sLine
        End_Procedure

        // Not the Error command: a string literal, Error_Report, a named error and Send Error.
        {Published = True}
        Procedure ChangeErrorNumberToName_NotTheCommand
            String[] asLines
            String sLine
            Boolean bChanged bAny
            Integer i
            tTokenizer TokenizerData
            Send _UseErrorNames
            Move 'Move "Error 25" to sText'     to asLines[0]
            Move "Send Error_Report 25"         to asLines[1]
            Move "Error DFERR_REC_NOT_FOUND"    to asLines[2]
            Move "Send Error 25"                to asLines[3]
            Move False to bAny
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move asLines[i] to sLine
                Get Tokenizer of ghoFuncLib sLine to TokenizerData
                Get ChangeErrorNumberToName of ghoFuncLib (&sLine) to bChanged
                If (bChanged = True or sLine <> asLines[i]) ;
                    Move True to bAny
            Loop
            Send _ForgetErrorNames
            Send AssertFalse bAny
        End_Procedure

        // The errornum.inc parser: a DFERR_ name with a whole number is an entry, the include guard and
        // anything else are not.
        {Published = True}
        Procedure ChangeErrorNumberToName_ParseErrorNumInc
            String[] asLines
            tErrorName[] aNames
            Move "#IFDEF ERRORNUM_INCLUDED"                                 to asLines[0]
            Move "#REPLACE ERRORNUM_INCLUDED |CI1"                          to asLines[1]
            Move "#REPLACE DFERR_DISK_FULL                                 1" to asLines[2]
            Move ("  #replace dferr_rec_not_found" + Character(9) + "25")  to asLines[3]
            Move "// #REPLACE DFERR_COMMENT 7"                              to asLines[4]
            Move "#REPLACE DFERR_NOT_A_NUMBER 12A"                          to asLines[5]
            Get _ErrorNamesFromLines of ghoFuncLib asLines to aNames
            Send AssertIAreEqual 2 (SizeOfArray(aNames))
            If (SizeOfArray(aNames) = 2) Begin
                Send Assert (aNames[0].iNumber = 1 and aNames[0].sName = "DFERR_DISK_FULL") "first"
                Send Assert (aNames[1].iNumber = 25 and aNames[1].sName = "dferr_rec_not_found") "second"
            End
        End_Procedure

    End_Object

    /* 'Error 300 "Text"' -> 'Error DFERR_OPERATOR "Text"'. The numbers code reads and the Flexerrs.dat records are measured
       on real files in the Windows TEMP folder, with a run file list: a test without one gets no readers at all. */
    Object oChangeErrorNumberToGenericError is a cTestFixture
        Set psFunctionName to "ChangeErrorNumberToGenericError"

        Procedure _UseErrorNames
            tErrorName[] aNames
            Move 25               to aNames[0].iNumber
            Move "DFERR_REC_NOT_FOUND" to aNames[0].sName
            Move 4401             to aNames[1].iNumber
            Move "DFERR_OPERATOR" to aNames[1].sName
            Move 4402             to aNames[2].iNumber
            Move "DFERR_PROGRAM"  to aNames[2].sName
            Set paErrorNames of ghoFuncLib to aNames
            Set pbErrorNamesLoaded of ghoFuncLib to True
        End_Procedure

        Function _Converted String sIn String sParameter Returns String
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move sIn to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeErrorNumberToGenericError of ghoFuncLib (&sLine) sParameter to bChanged
            If (bChanged = False and sLine <> sIn) ;
                Move "CHANGED WITHOUT SAYING SO" to sLine
            Function_Return sLine
        End_Function

        // The number goes and the text stays, at its place on the line.
        {Published = True}
        Procedure Generic_TheNumberGoesAndTheTextStays
            Send _UseErrorNames
            Send AssertSAreEqual '    Error DFERR_OPERATOR "Ange ett nummer"' (_Converted(Self, '    Error 300 "Ange ett nummer"', ""))
            Send AssertSAreEqual "    If (iErr > 0) Error DFERR_OPERATOR 'Fel' // why" (_Converted(Self, "    If (iErr > 0) Error 900 'Fel' // why", ""))
            Send AssertSAreEqual 'Else Error DFERR_OPERATOR "x"' (_Converted(Self, 'Else Error 303 "x"', ""))
        End_Procedure

        // A variable or an expression after the number is text too.
        {Published = True}
        Procedure Generic_AVariableOrAnExpressionIsText
            Send _UseErrorNames
            Send AssertSAreEqual "Error DFERR_OPERATOR sTemp" (_Converted(Self, "Error 305 sTemp", ""))
            Send AssertSAreEqual 'Error DFERR_OPERATOR ("a" * sB)' (_Converted(Self, 'Error 25100 ("a" * sB)', ""))
        End_Procedure

        // The parameter's other value, and a blank or unknown one meaning the default.
        {Published = True}
        Procedure Generic_TheParameterChoosesTheError
            Send _UseErrorNames
            Send AssertSAreEqual 'Error DFERR_PROGRAM "x"' (_Converted(Self, 'Error 300 "x"', "DFERR_PROGRAM"))
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' (_Converted(Self, 'Error 300 "x"', "DFERR_OPERATOR"))
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' (_Converted(Self, 'Error 300 "x"', "something else"))
        End_Procedure

        // No text of its own, a line that goes on, a number DataFlex names, and what is not the command at all.
        {Published = True}
        Procedure Generic_WhatIsLeftAlone
            String[] asLines
            String sOut
            Integer i
            Boolean bAny
            Send _UseErrorNames
            Move "Error 300"                to asLines[0]
            Move "    Error 300 // no text" to asLines[1]
            Move "Error 300 ;"              to asLines[2]
            Move 'Error 25 "x"'             to asLines[3]
            Move 'Error DFERR_OPERATOR "x"' to asLines[4]
            Move 'Send Error 300 "x"'       to asLines[5]
            Move 'Move "Error 300 x" to s'  to asLines[6]
            Move '// Error 300 "x"'         to asLines[7]
            Move False to bAny
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move (_Converted(Self, asLines[i], "")) to sOut
                If (sOut <> asLines[i]) ;
                    Move True to bAny
            Loop
            Send AssertFalse bAny
        End_Procedure

        // Not knowing the target's names must not read as "not named".
        {Published = True}
        Procedure Generic_NamesNotKnownChangeNothing
            tErrorName[] aNone
            Set paErrorNames of ghoFuncLib to aNone
            Set pbErrorNamesLoaded of ghoFuncLib to True
            Send AssertSAreEqual 'Error 300 "x"' (_Converted(Self, 'Error 300 "x"', ""))
        End_Procedure

        Procedure _WriteLines String sFile String[] asLines
            Integer iCh i
            Move (rfOpenOutput(sFile)) to iCh
            If (iCh >= 0) Begin
                For i from 0 to (SizeOfArray(asLines) - 1)
                    Writeln channel iCh asLines[i]
                Loop
                Send rfCloseOutput iCh
            End
        End_Procedure

        /* All these numbers become one, so one code tells apart keeps its number: in the run, outside it, in an error
           handler's body. A number in a comment or a string, or on a line that has nothing to do with errors, is no reader. */
        {Published = True}
        Procedure Generic_ANumberCodeReadsKeepsItsNumber
            tRefactorSettings Settings Saved
            String[] asRun asLib asFolders asNone
            String sRoot sWhy
            Boolean bOk
            String s300 s303 s304 s307 s305 s306 s308 s309

            Send _UseErrorNames
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_ErrorReaders\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Lib\"), False)) to bOk
            Send Assert bOk "the fixture folders"
            Move "Procedure A"                                       to asRun[0]
            Move "    If (LastErr = 300) Move 1 to i"                to asRun[1]
            Move "    Send Ignore_Error of Error_Object_Id 303"      to asRun[2]
            Move "    Move 305 to iWidth"                            to asRun[3]
            Move "    // LastErr = 306"                              to asRun[4]
            Move '    Move "Trap_Error 308" to sText'                to asRun[5]
            Move "End_Procedure"                                     to asRun[6]
            Move "Procedure Error_Report Integer iNum Integer iLine String sText" to asRun[7]
            Move "    If (iNum = 304) Move 1 to i"                   to asRun[8]
            Move "End_Procedure"                                     to asRun[9]
            Move "Procedure B"                                       to asRun[10]
            Move "    Move 309 to iOther"                            to asRun[11]
            Move "End_Procedure"                                     to asRun[12]
            Send _WriteLines (sRoot + "Run.pkg") asRun
            Move "Send Trap_Error of Error_Object_Id 307"            to asLib[0]
            Send _WriteLines (sRoot + "Lib\Outside.pkg") asLib

            Get pRefactorSettings of ghoFuncLib to Saved
            Move Saved to Settings
            Move "*.pkg" to Settings.sFileFilter
            Move (ResizeArray(Settings.FileData.asFullFileNames, 0)) to Settings.FileData.asFullFileNames
            Move (sRoot + "Run.pkg") to Settings.FileData.asFullFileNames[0]
            Set pRefactorSettings of ghoFuncLib to Settings
            Move (sRoot + "Lib\") to asFolders[0]
            Set pasOutsideReaderFolders of ghoFuncLib to asFolders
            Set pbErrorReadersBuilt of ghoFuncLib to False

            Move (_Converted(Self, 'Error 300 "x"', "")) to s300
            Move (_Converted(Self, 'Error 303 "x"', "")) to s303
            Move (_Converted(Self, 'Error 304 "x"', "")) to s304
            Move (_Converted(Self, 'Error 307 "x"', "")) to s307
            Move (_Converted(Self, 'Error 305 "x"', "")) to s305
            Move (_Converted(Self, 'Error 306 "x"', "")) to s306
            Move (_Converted(Self, 'Error 308 "x"', "")) to s308
            Move (_Converted(Self, 'Error 309 "x"', "")) to s309
            Get _MadeUpErrorWhyNot of ghoFuncLib 'Error 307 "x"' to sWhy

            Set pRefactorSettings of ghoFuncLib to Saved
            Set pasOutsideReaderFolders of ghoFuncLib to asNone
            Set pbErrorReadersBuilt of ghoFuncLib to False
            Move (rfRemoveFolderTree(sRoot)) to bOk

            Send AssertSAreEqual 'Error 300 "x"' s300
            Send AssertSAreEqual 'Error 303 "x"' s303
            Send AssertSAreEqual 'Error 304 "x"' s304
            Send AssertSAreEqual 'Error 307 "x"' s307
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' s305
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' s306
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' s308
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' s309
            Send Assert (Pos("Outside.pkg", sWhy) > 0) sWhy
        End_Procedure

        // A Flexerrs.dat of iLastRec records with a text at iRec: the shape measured on a real one.
        Procedure _WriteFlexErrs String sFile Integer iLastRec Integer iRec
            UChar[] ucFile
            Integer i iLast iCh

            Move (512 + (64 * (iLastRec + 1)) - 1) to iLast
            For i from 0 to iLast
                Move 0 to ucFile[i]
            Loop
            Move 88 to ucFile[512 + (64 * iRec)]
            Move (rfOpenOutput(sFile)) to iCh
            If (iCh >= 0) Begin
                Write channel iCh ucFile
                Send rfCloseOutput iCh
            End
        End_Procedure

        // DataFlex shows a record's text above the line's own, so a number with a record keeps it.
        {Published = True}
        Procedure Generic_AFlexErrsRecordKeepsTheNumber
            String[] asFolders asNone
            String sRoot s300 s900 sUnread
            Boolean bOk

            Send _UseErrorNames
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_FlexErrs\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Send _WriteFlexErrs (sRoot + "Flexerrs.dat") 300 300
            Move sRoot to asFolders[0]
            Set pasFlexErrsFolders of ghoFuncLib to asFolders
            Set pbFlexErrsRead of ghoFuncLib to False
            Move (_Converted(Self, 'Error 300 "x"', "")) to s300
            Move (_Converted(Self, 'Error 299 "x"', "")) to s900

            // A file of another shape: nothing can be said about any number.
            Send _WriteFlexErrs (sRoot + "Flexerrs.dat") 300 300
            Direct_Output channel 9 (sRoot + "Flexerrs.dat")
            Writeln channel 9 "not that file"
            Close_Output channel 9
            Set pbFlexErrsRead of ghoFuncLib to False
            Move (_Converted(Self, 'Error 299 "x"', "")) to sUnread

            Set pasFlexErrsFolders of ghoFuncLib to asNone
            Set pbFlexErrsRead of ghoFuncLib to False
            Move (rfRemoveFolderTree(sRoot)) to bOk

            Send AssertSAreEqual 'Error 300 "x"' s300
            Send AssertSAreEqual 'Error DFERR_OPERATOR "x"' s900
            Send AssertSAreEqual 'Error 299 "x"' sUnread
        End_Procedure

        Procedure TearDown
            tErrorName[] aNone
            Set paErrorNames of ghoFuncLib to aNone
            Set pbErrorNamesLoaded of ghoFuncLib to False
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
