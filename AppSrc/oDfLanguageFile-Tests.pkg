//****************************************************************************
// $Module type: Test fixture
// $Module name: oDfLanguageFile-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-01
//
// Description : Unit tests for cDfLanguageFile - the Studio's own language definition, <install>\Lib\DataFlex.lng.
//
//               Parsed from LINES here, never from a file, so these run on a machine with no DataFlex install
//               and cannot be broken by one being upgraded underneath them. The fixture below is the real
//               file's shape, trimmed: attributes in the same order, tokens one per line, the same two token
//               groups on Scope Keywords.
//
//               The SCOPE PAIRS are what this file was read for. Two flat sets can say that Begin opens and
//               that Until closes; only the pairing says Until closes Begin and End_Class does not.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oDfLanguageFile_Tests is a cTestFixture
        Set psFunctionName to "DfLanguageFile"

        Object oLang is a cDfLanguageFile
        End_Object

        // The real file's shape: four tokensets we collect, plus ones we must ignore.
        Function _Fixture Returns String[]
            String[] asL

            Move '<language name="DataFlex" casesensitive="no">'                                  to asL[0]
            Move '  <tokenset name="Whitespace" id="whitespace" forecolor="green">'               to asL[1]
            Move '    <tokens>'                                                                   to asL[2]
            Move '      <token regexp="yes" action="1001">\s+</token>'                            to asL[3]
            Move '    </tokens>'                                                                  to asL[4]
            Move '  </tokenset>'                                                                  to asL[5]
            Move '  <tokenset name="Scope Keywords" id="scopekeywords" inheritfrom="Keywords">'   to asL[6]
            Move '    <tokens>'                                                                   to asL[7]
            Move '      <token>Begin</token>'                                                     to asL[8]
            Move '      <token>Begin</token>'                                                     to asL[9]
            Move '      <token>Class</token>'                                                     to asL[10]
            Move '    </tokens>'                                                                  to asL[11]
            Move '    <tokens2>'                                                                  to asL[12]
            Move '      <token>End</token>'                                                       to asL[13]
            Move '      <token>Until</token>'                                                     to asL[14]
            Move '      <token>End_Class</token>'                                                 to asL[15]
            Move '    </tokens2>'                                                                 to asL[16]
            Move '  </tokenset>'                                                                  to asL[17]
            Move '  <tokenset name="Keywords" id="keywords" forecolor="blue">'                    to asL[18]
            Move '    <tokens>'                                                                   to asL[19]
            Move '      <token>Abort</token>'                                                     to asL[20]
            Move '      <token>Activate_View</token>'                                             to asL[21]
            Move '    </tokens>'                                                                  to asL[22]
            Move '  </tokenset>'                                                                  to asL[23]
            Move '  <tokenset name="Operators" id="operators">'                                   to asL[24]
            Move '    <tokens>'                                                                   to asL[25]
            Move '      <token>contains</token>'                                                  to asL[26]
            Move '    </tokens>'                                                                  to asL[27]
            Move '  </tokenset>'                                                                  to asL[28]
            Move '  <tokenset name="SQL Keywords" id="sqlkeywords">'                              to asL[29]
            Move '    <tokens>'                                                                   to asL[30]
            Move '      <token>ABSOLUTE</token>'                                                  to asL[31]
            Move '    </tokens>'                                                                  to asL[32]
            Move '  </tokenset>'                                                                  to asL[33]
            Move '  <tokenset name="Meta Data Tags" id="metadatatags">'                           to asL[34]
            Move '    <tokens>'                                                                   to asL[35]
            Move '      <token>Category</token>'                                                  to asL[36]
            Move '    </tokens>'                                                                  to asL[37]
            Move '  </tokenset>'                                                                  to asL[38]
            Move '</language>'                                                                    to asL[39]
            Function_Return asL
        End_Function

        /* Collects the four sets it is meant to, and NOTHING else. SQL Keywords is in the fixture on
           purpose: the real file carries 268 of them, and taking every tokenset would put SQL's
           reserved words into DataFlex's keyword list. The regexp token is the other exclusion -
           letting one through would put "\s+" in a list of words. */
        {Published = True}
        Procedure DfLang_CollectsOnlyTheFourSetsItNeeds
            String[] asLines
            tDfLanguage Lang

            Get _Fixture to asLines
            Get ParseLines of oLang asLines to Lang
            Send AssertIAreEqual 2 (SizeOfArray(Lang.asKeywords))
            Send AssertSAreEqual "Abort" Lang.asKeywords[0]
            Send AssertSAreEqual "Activate_View" Lang.asKeywords[1]
            Send AssertIAreEqual 1 (SizeOfArray(Lang.asOperators))
            Send AssertSAreEqual "contains" Lang.asOperators[0]
            Send AssertIAreEqual 1 (SizeOfArray(Lang.asMetaTags))
            Send AssertSAreEqual "Category" Lang.asMetaTags[0]
            // SQL's reserved words are not DataFlex keywords.
            Send Assert (SearchArray("ABSOLUTE", Lang.asKeywords) = -1) "SQL keyword leaked into the DataFlex set"
            // A regexp token is a pattern, not a word.
            Send Assert (SearchArray("\s+", Lang.asKeywords) = -1) "a regexp token leaked into the keyword set"
        End_Procedure

        /* THE PAIRING, which is why this file is read at all. Same index = closes with, and one opener
           legitimately has several partners: Begin ends with End OR Until. A matcher must therefore ask
           "is this pair present", never "what is Begin's partner" - the second question has no single
           answer and any code that assumes it does is wrong on the most common keyword in the language. */
        {Published = True}
        Procedure DfLang_ScopeKeywordsArePairedByIndex
            String[] asLines
            tDfLanguage Lang

            Get _Fixture to asLines
            Get ParseLines of oLang asLines to Lang
            Send AssertIAreEqual 3 (SizeOfArray(Lang.asScopeStart))
            Send AssertIAreEqual 3 (SizeOfArray(Lang.asScopeEnd))
            Send AssertSAreEqual "Begin"     Lang.asScopeStart[0]
            Send AssertSAreEqual "End"       Lang.asScopeEnd[0]
            Send AssertSAreEqual "Begin"     Lang.asScopeStart[1]
            Send AssertSAreEqual "Until"     Lang.asScopeEnd[1]
            Send AssertSAreEqual "Class"     Lang.asScopeStart[2]
            Send AssertSAreEqual "End_Class" Lang.asScopeEnd[2]
            // One opener, several partners - both true.
            Send Assert (ScopeEndMatches(oLang, &Lang, "Begin", "End"))   "Begin/End should pair"
            Send Assert (ScopeEndMatches(oLang, &Lang, "begin", "UNTIL")) "pairing must be case-insensitive"
            // And the pairing REFUSES what two flat sets would have accepted: End_Class is a valid
            // closer and Begin is a valid opener, but End_Class does not close Begin.
            Send Assert (not(ScopeEndMatches(oLang, &Lang, "Begin", "End_Class"))) "End_Class must not close Begin"
            Send Assert (not(ScopeEndMatches(oLang, &Lang, "Class", "End")))       "End must not close Class"
        End_Procedure

        /* A file that yields uneven pair arrays yields NO pairs. Losing them is recoverable - every
           caller falls back to the flat sets - while a mis-paired list would silently claim that
           Until closes Class. Wrong is worse than absent, and this is where that is decided. */
        {Published = True}
        Procedure DfLang_UnevenPairsAreDroppedRatherThanMisaligned
            String[] asLines
            tDfLanguage Lang

            Move '<tokenset name="Scope Keywords">' to asLines[0]
            Move '  <tokens>'                       to asLines[1]
            Move '    <token>Begin</token>'         to asLines[2]
            Move '    <token>Class</token>'         to asLines[3]
            Move '  </tokens>'                      to asLines[4]
            Move '  <tokens2>'                      to asLines[5]
            Move '    <token>End</token>'           to asLines[6]
            Move '  </tokens2>'                     to asLines[7]
            Move '</tokenset>'                      to asLines[8]
            Get ParseLines of oLang asLines to Lang
            Send AssertIAreEqual 0 (SizeOfArray(Lang.asScopeStart))
            Send AssertIAreEqual 0 (SizeOfArray(Lang.asScopeEnd))
        End_Procedure

        // No install, no catalogue - and an empty one rather than an error, because every caller
        // reads empty as "keep the lists you already had".
        {Published = True}
        Procedure DfLang_MissingInstallYieldsAnEmptyCatalogue
            tDfLanguage Lang
            Get LoadFromInstall of oLang "C:\__no_such_install__\Pkg" to Lang
            Send AssertIAreEqual 0 (SizeOfArray(Lang.asKeywords))
            Send AssertIAreEqual 0 (SizeOfArray(Lang.asScopeStart))
            Send AssertSAreEqual "" (LanguageFilePathFor(oLang, ""))
        End_Procedure

        /* THE PAIRS INSIDE THE FUNCLIB, which is where the scope tracker reads them.

           The funclib normally fills these from the install; there is none under the test runner, so
           they are set directly here - which is also the only way to test the loaded-pairs branch at
           all. _ScopeEndClosesStart is what the tracker asks, and its contract is the important part:
           a False means "not known to close", NEVER "known not to close", because the caller uses it
           as an extra acceptance on top of its own hardcoded keyword. */
        {Published = True}
        Procedure DfLang_FuncLibAnswersFromThePairTable
            String[] asStart asEnd

            Move "begin" to asStart[0]
            Move "begin" to asStart[1]
            Move "class" to asStart[2]
            Move "end"       to asEnd[0]
            Move "until"     to asEnd[1]
            Move "end_class" to asEnd[2]
            Set pasScopePairStart of ghoFuncLib to asStart
            Set pasScopePairEnd   of ghoFuncLib to asEnd

            Send Assert (_ScopeEndClosesStart(ghoFuncLib, "Begin", "End"))   "Begin/End should pair"
            Send Assert (_ScopeEndClosesStart(ghoFuncLib, "BEGIN", "until")) "pairing must be case-insensitive"
            Send Assert (_ScopeEndClosesStart(ghoFuncLib, "Class", "End_Class")) "Class/End_Class should pair"
            // What the flat sets could never refuse: both words are valid scope keywords, but this
            // pair is not in the language.
            Send Assert (not(_ScopeEndClosesStart(ghoFuncLib, "Class", "End")))     "End must not close Class"
            Send Assert (not(_ScopeEndClosesStart(ghoFuncLib, "Begin", "End_Class"))) "End_Class must not close Begin"
        End_Procedure

        /* NO PAIRS = NO OPINION. With no install to read the table is empty, and every answer must be
           False so the callers fall back to the keyword they hardcoded. This is the property that
           makes consulting the install safe: it can add a closer nobody wrote down, and can never
           contradict one that already worked. A test rather than a comment because the failure it
           guards against - the table quietly vetoing a real End_Class - would be silent. */
        {Published = True}
        Procedure DfLang_NoPairsMeansNoOpinionNotAVeto
            String[] asNone
            Set pasScopePairStart of ghoFuncLib to asNone
            Set pasScopePairEnd   of ghoFuncLib to asNone
            Send Assert (not(_ScopeEndClosesStart(ghoFuncLib, "Class", "End_Class"))) "empty table must answer False"
            // ...and the tracker still recognises the real thing from its own constant.
            Send Assert (_IsClassEnd(ghoFuncLib, "End_Class"))       "End_Class must still close a class with no pairs"
            Send Assert (_IsClassEnd(ghoFuncLib, "    End_Class  ")) "indented End_Class must still be seen"
            Send Assert (_IsStructEnd(ghoFuncLib, "  End_Struct"))   "indented End_Struct must still be seen"
        End_Procedure

        /* THE LEGACY WORDS JOIN THE OPERATOR LIST WHATEVER THE CATALOGUE SAYS. DataFlex 26's DataFlex.lng
           lists only the modern operators; a funclib seeded from it answered _IsOperator("eq") = False,
           which is what broke the expression-tail cut on a workspace (2026-09-05). Injected through the same
           cache _InstallLanguage reads, so this exercises _AddAllKeyWords exactly as the app runs it. */
        {Published = True}
        Procedure DfLang_LegacyComparisonWordsJoinTheOperatorList
            String[] asL asOps
            tDfLanguage Lang LangNone
            Get _Fixture to asL                                   // its Operators set holds 'contains' only
            Get ParseLines of oLang asL to Lang
            Set psLangPkgFolder   of ghoFuncLib to "x:\injected"
            Set psLangCacheKey    of ghoFuncLib to "x:\injected"
            Set paInstallLanguage of ghoFuncLib to Lang
            Send _AddAllKeyWords of ghoFuncLib
            Get pasOperators of ghoFuncLib to asOps
            /* RESTORE BEFORE ASSERTING, and re-seed: _AddAllKeyWords runs at construction and when the
               target changes, NOT from _InitializeFuncLib, so the injected two-keyword catalogue would
               otherwise stay in the funclib for every fixture after this one (13 unrelated failures on the
               first run of this test - Move was no longer a keyword). */
            Set psLangPkgFolder   of ghoFuncLib to ""
            Set psLangCacheKey    of ghoFuncLib to ""
            Set paInstallLanguage of ghoFuncLib to LangNone
            Send _AddAllKeyWords of ghoFuncLib
            Send Assert (SearchArray("contains", asOps) <> -1) "the catalogue's own operator must stay"
            Send Assert (SearchArray("eq", asOps) <> -1) "eq must be an operator"
            Send Assert (SearchArray("ne", asOps) <> -1) "ne must be an operator"
            Send Assert (SearchArray("gt", asOps) <> -1) "gt must be an operator"
            Send Assert (SearchArray("ge", asOps) <> -1) "ge must be an operator"
            Send Assert (SearchArray("lt", asOps) <> -1) "lt must be an operator"
            Send Assert (SearchArray("le", asOps) <> -1) "le must be an operator"
            Send Assert (_IsOperator(ghoFuncLib, "EQ")) "_IsOperator must say yes to EQ, case-insensitively"
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
