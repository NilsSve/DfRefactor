//****************************************************************************
// $Module type: Test fixture
// $Module name: oEditorColourScheme-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-27
//
// Description : "Compare every element" - no element enum is negative, so this can never match one.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
#IFNDEF CI_NoSkipElement
Define CI_NoSkipElement for -1
#ENDIF

    Object oEditorColourScheme is a cTestFixture
        Set psFunctionName to "EditorColourScheme"

        Object oScheme is a cEditorColourScheme
        End_Object

        /* The packed strings the schemes used to be declared as, kept HERE rather than
           in production code: their only remaining job is to prove the readable
           declarations in cEditorColourScheme.pkg reproduce the original colours
           exactly, and to pin the migration reader that converts a saved scheme.
           Nothing writes this format any more. */
        Function LegacyWhite Returns String
            Function_Return ""
        End_Function

        Function LegacyBlack Returns String
            Function_Return ""
        End_Function

        Function LegacyBlue Returns String
            Function_Return ""
        End_Function

        Function LegacyLime Returns String
            Function_Return ""
        End_Function

        Function LegacySerene Returns String
            Function_Return ",000000000000001000000001000001000000000000000000000000"
        End_Function

        Function LegacySahara Returns String
            Function_Return ",000000000000000000000000000000000000000000000001000000"
        End_Function

        /* Compare two schemes element for element - the check that matters, because a
           mismatch means a colour moved when the positional offsets were retired.

           eSkipElement is for the one case where a built-in was deliberately CHANGED
           rather than transcribed, so "matches the packed original" is the wrong
           question for that element alone. Pass CI_NoSkipElement to compare everything;
           only the caller that owns the divergence may name an element, and it has to
           say why. Everything else stays strict. */
        Procedure AssertSchemesMatch Handle hoExpected Handle hoActual Integer eSkipElement
            Integer eElement
            tEditorStyle Expected Actual

            For eElement from 0 to (ElementCount(hoActual) - 1)
                // Selection is DERIVED from the page colour now, not declared, so the
                // built-ins no longer carry the packed original's value for it. The old
                // dark-scheme selections were unusable anyway - a dark blue drawn
                // translucently over a near-black page is invisible.
                If (eElement <> eEC_Selection and eElement <> eSkipElement) Begin
                Get StyleFor of hoExpected eElement to Expected
                Get StyleFor of hoActual   eElement to Actual
                Send AssertIAreEqual Expected.iForeColor Actual.iForeColor
                Send AssertIAreEqual Expected.iBackColor Actual.iBackColor
                Send AssertIAreEqual Expected.bBold      Actual.bBold
                Send AssertIAreEqual Expected.bItalic    Actual.bItalic
                End
            Loop
        End_Procedure

        // The readable White declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInWhite_MatchesLegacyPacked
            Handle hoLegacy
            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeWhite (LegacyWhite(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoLegacy
        End_Procedure

        // The readable Black declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInBlack_MatchesLegacyPacked
            Handle hoLegacy
            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeBlack (LegacyBlack(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoLegacy
        End_Procedure

        // The readable Blue declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInBlue_MatchesLegacyPacked
            Handle hoLegacy
            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeBlue (LegacyBlue(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeBlue
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoLegacy
        End_Procedure

        // The readable Lime declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInLime_MatchesLegacyPacked
            Handle hoLegacy

            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeLime (LegacyLime(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeLime
            /* eEC_BraceHighlight is EXCLUDED, and only here. The packed original declares
               RGB(255,26,26) on RGB(49,60,83) - a red brace on the page colour, so the only
               visible effect was that the brace turned red. Brace pairs are drawn as a
               translucent box now (see HighlightTintColor), which needs a background that
               differs from the page, so Lime's was corrected on 2026-07-28. Every other
               element still has to match the original exactly. */
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) eEC_BraceHighlight
            Send Destroy of hoLegacy
        End_Procedure

        // The readable Serene declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInSerene_MatchesLegacyPacked
            Handle hoLegacy
            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeSerene (LegacySerene(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeSerene
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoLegacy
        End_Procedure

        // The readable Sahara declaration matches the packed original, element for element.
        {Published = True}
        Procedure BuiltInSahara_MatchesLegacyPacked
            Handle hoLegacy
            Get Create (RefClass(cEditorColourScheme)) to hoLegacy
            Send LoadLegacyPacked of hoLegacy CS_ThemeSahara (LegacySahara(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeSahara
            Send AssertSchemesMatch hoLegacy (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoLegacy
        End_Procedure

        // A scheme survives a write and read unchanged.
        {Published = True}
        Procedure Serialize_RoundTripsEveryElement
            Handle hoCopy
            String sScheme
            Send LoadBuiltIn of oScheme CS_ThemeLime
            Get Create (RefClass(cEditorColourScheme)) to hoCopy
            Get SerializeScheme of (oScheme(Self)) to sScheme
            Send DeserializeScheme of hoCopy sScheme
            Send AssertSAreEqual CS_ThemeLime (psSchemeName(hoCopy))
            Send AssertSchemesMatch (oScheme(Self)) hoCopy CI_NoSkipElement
            Send Destroy of hoCopy
        End_Procedure

        // Bold survives the round trip. Serene is the built-in that carries it.
        {Published = True}
        Procedure Serialize_KeepsFontFlags
            Handle hoCopy
            String sScheme
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeSerene
            Get Create (RefClass(cEditorColourScheme)) to hoCopy
            Get SerializeScheme of (oScheme(Self)) to sScheme
            Send DeserializeScheme of hoCopy sScheme
            Get StyleFor of hoCopy eEC_ScopeKeywords to Appearance
            Send AssertIAreEqual True Appearance.bBold
            Send Destroy of hoCopy
        End_Procedure

        // "No colour of its own" survives as itself and is not confused with white.
        {Published = True}
        Procedure Serialize_KeepsTheNoColourMarker
            Handle hoCopy
            String sScheme
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Get Create (RefClass(cEditorColourScheme)) to hoCopy
            Get SerializeScheme of (oScheme(Self)) to sScheme
            Send DeserializeScheme of hoCopy sScheme
            Get StyleFor of hoCopy eEC_Selection to Appearance
            Send AssertIAreEqual CI_NoColour Appearance.iBackColor
            Send Destroy of hoCopy
        End_Procedure

        // The stored form is readable: an element appears by name, not by position.
        {Published = True}
        Procedure Serialize_IsReadable
            String sText
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Get SerializeScheme of (oScheme(Self)) to sText
            Send AssertIAreEqual True (Pos("Keywords=0,0,255;", sText) > 0)
            Send AssertIAreEqual True (Pos("Scheme=White", sText) > 0)
        End_Procedure

        // A file written by a later version still loads: unknown elements are skipped
        // and the ones that are present still apply.
        {Published = True}
        Procedure Deserialize_IgnoresUnknownElements
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send DeserializeScheme of oScheme ("Scheme=Custom" + C_NewLine + "Sparkle=1,2,3;4,5,6;B" + C_NewLine + "Text=10,20,30;default;")
            Get StyleFor of oScheme eEC_Text to Appearance
            Send AssertIAreEqual (RGB(10,20,30)) Appearance.iForeColor
            Send AssertIAreEqual CI_NoColour Appearance.iBackColor
            Send AssertSAreEqual "Custom" (psSchemeName(oScheme(Self)))
        End_Procedure

        // An element the file does not mention keeps the value it already had.
        {Published = True}
        Procedure Deserialize_LeavesUnmentionedElementsAlone
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Send DeserializeScheme of oScheme "Text=1,1,1;2,2,2;"
            Get StyleFor of oScheme eEC_Keywords to Appearance
            Send AssertIAreEqual (RGB(140,215,240)) Appearance.iForeColor
        End_Procedure

        // The old all-255 sentinel becomes the no-colour marker, not opaque white.
        {Published = True}
        Procedure LoadLegacyPacked_SentinelBecomesNoColour
            tEditorStyle Appearance
            Send LoadLegacyPacked of oScheme "Probe" (LegacyWhite(Self)) ""
            Get StyleFor of oScheme eEC_Window to Appearance
            Send AssertIAreEqual CI_NoColour Appearance.iForeColor
        End_Procedure

        // Two of the built-in strings carried their font styles comma-appended; the
        // reader has to split them off rather than read them as more colours.
        {Published = True}
        Procedure LoadLegacyPacked_SplitsAppendedFontStyles
            tEditorStyle Appearance
            Send LoadLegacyPacked of oScheme CS_ThemeSerene (LegacySerene(Self)) ""
            Get StyleFor of oScheme eEC_ScopeKeywords to Appearance
            Send AssertIAreEqual True Appearance.bBold
            Get StyleFor of oScheme eEC_PreProcessor to Appearance
            Send AssertIAreEqual (RGB(255,190,120)) Appearance.iForeColor
        End_Procedure

        // Every element has a label and a tag, so the settings dialog can list them all
        // and the stored file can name them.
        {Published = True}
        Procedure EveryElementHasANameAndTag
            Integer eElement
            For eElement from 0 to (ElementCount(oScheme(Self)) - 1)
                Send AssertIAreEqual True (ElementName(oScheme(Self), eElement) <> "")
                Send AssertIAreEqual eElement (ElementFromTag(oScheme(Self), ElementTag(oScheme(Self), eElement)))
            Loop
        End_Procedure

        // The Lucas colours, recovered from a saved scheme. The built-in of that name
        // used to be a byte-for-byte copy of Black - a placeholder nobody filled in -
        // and the save path refuses to store a scheme whose name is already a built-in,
        // so it could not be given colours through the dialog either.
        Function RecoveredLucas Returns String
            Function_Return ""
        End_Function

        // The declaration matches the scheme it was recovered from.
        {Published = True}
        Procedure BuiltInLucas_MatchesRecoveredScheme
            Handle hoRecovered
            Get Create (RefClass(cEditorColourScheme)) to hoRecovered
            Send LoadLegacyPacked of hoRecovered CS_ThemeLucas (RecoveredLucas(Self)) ""
            Send LoadBuiltIn of oScheme CS_ThemeLucas
            Send AssertSchemesMatch hoRecovered (oScheme(Self)) CI_NoSkipElement
            Send Destroy of hoRecovered
        End_Procedure

        // Lucas is a real built-in now, and no longer just Black under another name -
        // this is the check that would have caught the original placeholder.
        {Published = True}
        Procedure LucasIsABuiltInAndNotBlack
            tEditorStyle Lucas Black
            Send AssertIAreEqual True (IsBuiltIn(oScheme(Self), CS_ThemeLucas))
            Send LoadBuiltIn of oScheme CS_ThemeLucas
            Get StyleFor of oScheme eEC_Window to Lucas
            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Get StyleFor of oScheme eEC_Window to Black
            Send AssertIAreEqual False (Lucas.iForeColor = Black.iForeColor)
        End_Procedure

        // The DataFlex scheme mirrors Studio 25's own Dark colours. Pinned here so an
        // edit that scrambles the element mapping fails rather than just looking odd:
        // the near-black ground, green comments, light-blue keywords, peach strings and
        // pink meta tags are the signature of that scheme.
        /* The DataFlex scheme's colours now come from the install's Lib\DataFlex.lng where it can be
           read, with the transcribed literals as the fallback. This tests the PARSER against the real
           file's shape, since the loader itself needs an install and the test runner has no target
           set - so the assertions above exercise the fallback path and this one covers the read.

           The two rejections matter as much as the reads. A named colour ("purple") and a light-only
           tokenset must both come back ABSENT, not as some default colour: absent means the built-in
           literal stands, while a wrong colour would silently repaint the editor. "Scope Keywords" is
           the real instance of the second case - it declares no darkforecolor in DF 25. */
        {Published = True}
        Procedure BuiltInDataFlex_ParsesTheInstallDarkPalette
            String[] asLines
            tLngTokenColour[] aC

            Move '<tokenset name="Line Comments" id="linecomments" forecolor="green" darkforecolor="RGB(60,220,70)" type="scope">' to asLines[0]
            Move '<tokenset name="Keywords" forecolor="blue" darkforecolor="RGB(55,212,255)">'                                    to asLines[1]
            Move '<tokenset name="Quoted Filename" forecolor="purple" darkforecolor="purple">'                                    to asLines[2]
            Move '<tokenset name="Scope Keywords" forecolor="blue">'                                                              to asLines[3]
            Move '            <token>Begin</token>'                                                                               to asLines[4]
            Get _LngDarkColoursFromLines of oScheme asLines to aC
            // Two RGB entries parsed; the named colour and the light-only set are absent.
            Send AssertIAreEqual 2 (SizeOfArray(aC))
            Send AssertSAreEqual "Line Comments" aC[0].sTokenSet
            Send AssertIAreEqual (RGB(60,220,70)) aC[0].iDark
            Send AssertSAreEqual "Keywords" aC[1].sTokenSet
            Send AssertIAreEqual (RGB(55,212,255)) aC[1].iDark
            // Absent -> the caller's own literal survives, which is what keeps the scheme complete.
            Send AssertIAreEqual (RGB(1,2,3)) (_LngDark(oScheme, "Scope Keywords", (RGB(1,2,3))))
            Send AssertIAreEqual (RGB(1,2,3)) (_LngDark(oScheme, "No Such Tokenset", (RGB(1,2,3))))
        End_Procedure

        {Published = True}
        Procedure BuiltInDataFlex_MatchesStudioColours
            tEditorStyle Appearance

            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Get StyleFor of oScheme eEC_Window to Appearance
            Send AssertIAreEqual (RGB(16,16,16)) Appearance.iForeColor
            Get StyleFor of oScheme eEC_Comments to Appearance
            Send AssertIAreEqual (RGB(60,220,70)) Appearance.iForeColor
            Get StyleFor of oScheme eEC_Keywords to Appearance
            Send AssertIAreEqual (RGB(55,212,255)) Appearance.iForeColor
            Get StyleFor of oScheme eEC_Strings to Appearance
            Send AssertIAreEqual (RGB(255,190,154)) Appearance.iForeColor
            Get StyleFor of oScheme eEC_MetaTags to Appearance
            Send AssertIAreEqual (RGB(255,120,180)) Appearance.iForeColor
        End_Procedure

        /* The elements Studio has no counterpart for still end up with a colour -
           leaving one unset would make an unmatched brace invisible. Selection is in
           that group but is DERIVED rather than declared, so it is checked through the
           resolver. */
        {Published = True}
        Procedure BuiltInDataFlex_FillsTheElementsStudioLacks
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Get StyleFor of oScheme eEC_UnmatchedBrace to Appearance
            Send AssertIAreEqual False (Appearance.iForeColor = CI_NoColour)
            Get StyleFor of oScheme eEC_StringTyping to Appearance
            Send AssertIAreEqual False (Appearance.iForeColor = CI_NoColour)
            Send AssertIAreEqual False (ResolvedSelectionBackColor(oScheme(Self)) = CI_NoColour)
        End_Procedure

        /* A colour whose GREEN channel is non-zero, written out and read back. This is
           the case that exposed DataFlex's Low() taking the low SIXTEEN bits rather than
           the low byte: red swallowed green, and because the wrong split still summed
           back to the right value through RGB(), every existing round-trip test passed
           while the stored text said "52595,0,235" instead of "115,205,235". */
        {Published = True}
        Procedure ColourToText_SplitsAllThreeChannels
            Send AssertSAreEqual "115,205,235" (ColourToText(oScheme(Self), RGB(115,205,235)))
            Send AssertSAreEqual "default"     (ColourToText(oScheme(Self), CI_NoColour))
            Send AssertIAreEqual (RGB(115,205,235)) (ColourFromText(oScheme(Self), "115,205,235"))
        End_Procedure

        // Same channel trap in the packed adapter the settings dialog still speaks.
        {Published = True}
        Procedure LegacyPacked_RoundTripsAColourWithGreen
            Handle hoCopy
            tEditorStyle Expected Actual
            Send LoadBuiltIn of oScheme CS_ThemeBlue
            Get StyleFor of oScheme eEC_Keywords to Expected
            Get Create (RefClass(cEditorColourScheme)) to hoCopy
            Send LoadLegacyPacked of hoCopy CS_ThemeBlue (LegacyPackedColors(oScheme(Self))) (LegacyPackedFontStyles(oScheme(Self)))
            Get StyleFor of hoCopy eEC_Keywords to Actual
            Send AssertIAreEqual Expected.iForeColor Actual.iForeColor
            Send AssertIAreEqual Expected.iBackColor Actual.iBackColor
            Send Destroy of hoCopy
        End_Procedure

        /* The Selection element's two slots do not mean fore/back the usual way - the
           packed format only ever had one selection colour and it was the BACKGROUND.
           These accessors exist so no caller has to remember that. */
        {Published = True}
        Procedure SelectionColors_BackAndTextAreDistinct
            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Send SetSelectionColors of oScheme (RGB(10,20,30)) (RGB(40,50,60))
            Send AssertIAreEqual (RGB(10,20,30)) (SelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual (RGB(40,50,60)) (SelectionTextColor(oScheme(Self)))
        End_Procedure

        /* No built-in declares a selection colour any more - it is DERIVED from the
           page, so a scheme nobody wrote gets a readable one too. Dark pages select
           with white drawn translucently, keeping every token's colour; light pages
           get the pale blue they always had, solid. */
        {Published = True}
        Procedure SelectionAppearance_DerivedFromThePage
            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Send AssertIAreEqual True (IsDarkScheme(oScheme(Self)))
            Send AssertIAreEqual (RGB(255,255,255)) (ResolvedSelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual CI_SelectionWash    (ResolvedSelectionAlpha(oScheme(Self)))

            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Send AssertIAreEqual True (IsDarkScheme(oScheme(Self)))
            Send AssertIAreEqual (RGB(255,255,255)) (ResolvedSelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual CI_SelectionWash    (ResolvedSelectionAlpha(oScheme(Self)))

            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send AssertIAreEqual False (IsDarkScheme(oScheme(Self)))
            Send AssertIAreEqual (RGB(170,195,240)) (ResolvedSelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual SC_ALPHA_NOALPHA    (ResolvedSelectionAlpha(oScheme(Self)))

            // Sahara is a cream page - light, despite not being white.
            Send LoadBuiltIn of oScheme CS_ThemeSahara
            Send AssertIAreEqual False (IsDarkScheme(oScheme(Self)))
            Send AssertIAreEqual SC_ALPHA_NOALPHA (ResolvedSelectionAlpha(oScheme(Self)))
        End_Procedure

        /* THE BRACE-HIGHLIGHT TINT. A matched brace pair is drawn as a translucent box in
           ONE colour, so HighlightTintColor has to pick which of a scheme's two it means.
           The background, when the scheme actually declared one. */
        {Published = True}
        Procedure HighlightTint_PrefersTheBackground
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send AssertIAreEqual (RGB(200,225,255)) ;
                (HighlightTintColor(oScheme(Self), eEC_BraceHighlight))

            // The DataFlex scheme's was converted from the Studio's own, and is a grey.
            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Send AssertIAreEqual (RGB(192,192,192)) ;
                (HighlightTintColor(oScheme(Self), eEC_BraceHighlight))
        End_Procedure

        /* A background equal to the page declares no highlight at all, whatever it says -
           you cannot see a box painted in the colour behind it. The foreground is what
           carries the meaning then, so that is the tint. This is the shape Lime was in. */
        {Published = True}
        Procedure HighlightTint_BackgroundEqualToThePageFallsBackToTheForeground
            Send BeginScheme of oScheme "TintProbe"
            Send DefineStyle of oScheme eEC_Window         (RGB(49,60,83))  CI_NoColour     False False
            Send DefineStyle of oScheme eEC_BraceHighlight (RGB(255,26,26)) (RGB(49,60,83)) False False
            Send AssertIAreEqual (RGB(255,26,26)) ;
                (HighlightTintColor(oScheme(Self), eEC_BraceHighlight))
        End_Procedure

        // ...and a scheme that declared neither still has to be visible, so it washes
        // against the page rather than returning CI_NoColour to the renderer.
        {Published = True}
        Procedure HighlightTint_UndeclaredWashesAgainstThePage
            Send BeginScheme of oScheme "TintProbeDark"
            Send DefineStyle of oScheme eEC_Window         (RGB(16,16,16)) CI_NoColour False False
            Send DefineStyle of oScheme eEC_BraceHighlight CI_NoColour     CI_NoColour False False
            Send AssertIAreEqual (RGB(255,255,255)) ;
                (HighlightTintColor(oScheme(Self), eEC_BraceHighlight))

            Send BeginScheme of oScheme "TintProbeLight"
            Send DefineStyle of oScheme eEC_Window         (RGB(255,255,255)) CI_NoColour False False
            Send DefineStyle of oScheme eEC_BraceHighlight CI_NoColour        CI_NoColour False False
            Send AssertIAreEqual (RGB(0,0,0)) ;
                (HighlightTintColor(oScheme(Self), eEC_BraceHighlight))
        End_Procedure

        /* THE REGRESSION. Lime shipped with eEC_BraceHighlight's background set to the page
           colour, so its highlight was really a red foreground - the brace changed colour
           instead of gaining a marker, which is what sent Nils looking (2026-07-28). Nothing
           caught it because a fore/back pair is always SOMETHING; it takes asking whether
           the pair says "highlight" to see that this one did not.

           So ask it of every built-in: the tint must come from the DECLARED BACKGROUND, not
           from the foreground fallback. "Is it visible" is the weaker question and Lime
           passed it - red on slate is perfectly visible; it was just the wrong mechanism.
           The question that fails on old Lime is "did this scheme declare a highlight at
           all", and comparing the tint to the background is how you ask it.

           Applies to the unmatched state too - a warning you cannot see is not a warning. */
        {Published = True}
        Procedure HighlightTint_EveryBuiltInDeclaresARealBraceHighlight
            Integer i iPage iMatch iBad
            String[] asNames
            tEditorStyle PageStyle MatchStyle BadStyle

            Move CS_ThemeWhite    to asNames[0]
            Move CS_ThemeBlack    to asNames[1]
            Move CS_ThemeBlue     to asNames[2]
            Move CS_ThemeLime     to asNames[3]
            Move CS_ThemeSerene   to asNames[4]
            Move CS_ThemeSahara   to asNames[5]
            Move CS_ThemeLucas    to asNames[6]
            Move CS_ThemeDataFlex to asNames[7]

            For i from 0 to (SizeOfArray(asNames) - 1)
                Send LoadBuiltIn of oScheme asNames[i]
                Get StyleFor of (oScheme(Self)) eEC_Window         to PageStyle
                Get StyleFor of (oScheme(Self)) eEC_BraceHighlight to MatchStyle
                Get StyleFor of (oScheme(Self)) eEC_UnmatchedBrace to BadStyle
                Move PageStyle.iForeColor to iPage
                Get HighlightTintColor of (oScheme(Self)) eEC_BraceHighlight to iMatch
                Get HighlightTintColor of (oScheme(Self)) eEC_UnmatchedBrace to iBad

                // The tint came from the declared background, not the fallback. This is the
                // assert old Lime fails. Named per scheme, so a failure says WHICH one - the
                // suite reports the message, not the loop counter.
                Send AssertIAreEqual MatchStyle.iBackColor iMatch ;
                    ("Brace highlight declares no background of its own in scheme " + asNames[i])
                Send AssertIAreEqual BadStyle.iBackColor iBad ;
                    ("Unmatched brace declares no background of its own in scheme " + asNames[i])
                // ...and it is not the page colour wearing a different name.
                Send AssertIAreNotEqual iPage iMatch ;
                    ("Brace highlight tint equals the page colour in scheme " + asNames[i])
                Send AssertIAreNotEqual iPage iBad ;
                    ("Unmatched-brace tint equals the page colour in scheme " + asNames[i])
            Loop
        End_Procedure

        // Every dark built-in derives the same readable selection - the point of making
        // it a rule rather than eight copies of a colour.
        {Published = True}
        Procedure SelectionAppearance_EveryDarkBuiltInAgrees
            Integer i
            String[] asDark

            Move CS_ThemeBlack    to asDark[0]
            Move CS_ThemeBlue     to asDark[1]
            Move CS_ThemeLime     to asDark[2]
            Move CS_ThemeSerene   to asDark[3]
            Move CS_ThemeLucas    to asDark[4]
            Move CS_ThemeDataFlex to asDark[5]
            For i from 0 to (SizeOfArray(asDark) - 1)
                Send LoadBuiltIn of oScheme asDark[i]
                Send AssertIAreEqual True (IsDarkScheme(oScheme(Self)))
                Send AssertIAreEqual (RGB(255,255,255)) (ResolvedSelectionBackColor(oScheme(Self)))
                Send AssertIAreEqual CI_SelectionWash (ResolvedSelectionAlpha(oScheme(Self)))
            Loop
        End_Procedure

        // A scheme that names its own selection colour keeps it - the rule is a default,
        // not an override.
        {Published = True}
        Procedure SelectionAppearance_DeclaredColourWins
            Send LoadBuiltIn of oScheme CS_ThemeBlack
            Send SetSelectionColors of oScheme (RGB(90,0,0)) (RGB(255,255,0))
            Set piSelectionAlpha of oScheme to SC_ALPHA_NOALPHA
            Send AssertIAreEqual (RGB(90,0,0))    (ResolvedSelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual (RGB(255,255,0)) (SelectionTextColor(oScheme(Self)))
            Send AssertIAreEqual SC_ALPHA_NOALPHA (ResolvedSelectionAlpha(oScheme(Self)))
        End_Procedure

        // A page colour set from outside decides it too, which is how a user's own
        // scheme gets a readable selection without declaring one.
        {Published = True}
        Procedure SelectionAppearance_FollowsAPageColourSetFromOutside
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send SetWindowColor of oScheme (RGB(20,20,20))
            Send AssertIAreEqual True (IsDarkScheme(oScheme(Self)))
            Send AssertIAreEqual (RGB(255,255,255)) (ResolvedSelectionBackColor(oScheme(Self)))
            Send AssertIAreEqual CI_SelectionWash (ResolvedSelectionAlpha(oScheme(Self)))
        End_Procedure

        // Translucency survives a write and read, like any other scheme setting.
        {Published = True}
        Procedure SelectionTranslucency_RoundTrips
            Handle hoCopy
            String sScheme
            Send LoadBuiltIn of oScheme CS_ThemeDataFlex
            Get Create (RefClass(cEditorColourScheme)) to hoCopy
            Get SerializeScheme of (oScheme(Self)) to sScheme
            Send DeserializeScheme of hoCopy sScheme
            Send AssertIAreEqual (piSelectionAlpha(oScheme(Self))) (piSelectionAlpha(hoCopy))
            Send AssertIAreEqual (ResolvedSelectionBackColor(oScheme(Self))) (ResolvedSelectionBackColor(hoCopy))
            Send Destroy of hoCopy
        End_Procedure

        /* The settings may still hold the old packed pair, so the loader sniffs the
           content rather than versioning the setting - a scheme converts the first time
           it is loaded, with nothing to remember to run. */
        {Published = True}
        Procedure LoadFromSettings_ReadsThePackedFormWhenItFindsIt
            tEditorStyle Appearance
            Send AssertIAreEqual True  (LooksPacked(oScheme(Self), LegacyBlue(Self)))
            Send LoadFromSettings of oScheme CS_ThemeBlue (LegacyBlue(Self)) ""
            Get StyleFor of oScheme eEC_Keywords to Appearance
            Send AssertIAreEqual (RGB(115,205,235)) Appearance.iForeColor
        End_Procedure

        // ...and the readable form is not mistaken for it.
        {Published = True}
        Procedure LoadFromSettings_ReadsTheReadableForm
            String sText
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeBlue
            Get SerializeScheme of (oScheme(Self)) to sText
            Send AssertIAreEqual False (LooksPacked(oScheme(Self), sText))
            Send LoadBuiltIn of oScheme CS_ThemeWhite
            Send LoadFromSettings of oScheme CS_ThemeBlue sText ""
            Get StyleFor of oScheme eEC_Keywords to Appearance
            Send AssertIAreEqual (RGB(115,205,235)) Appearance.iForeColor
            Send AssertSAreEqual CS_ThemeBlue (psSchemeName(oScheme(Self)))
        End_Procedure

        /* SerializeScheme joins with the store's own separator, so the JSON holds one array
           entry per element rather than a single unreadable run. */
        {Published = True}
        Procedure Serialize_JoinsWithTheStoreSeparator
            String sText
            Send LoadBuiltIn of oScheme CS_ThemeBlue
            Get SerializeScheme of (oScheme(Self)) to sText
            Send AssertIAreEqual True (Pos(CS_SchemeLineBreak, sText) > 0)
            Send AssertIAreEqual 0 (Pos(C_NewLine, sText))
            Send AssertIAreEqual 0 (Pos(Character(10), sText))
        End_Procedure

        // Which fields an element actually has - the settings dialog hides the controls
        // that would do nothing. The page has no background of its own; a margin no font.
        {Published = True}
        Procedure ElementFields_SayWhatAnElementCarries
            Send AssertIAreEqual False (ElementHasBackColor(oScheme(Self), eEC_Window))
            Send AssertIAreEqual False (ElementHasFontStyle(oScheme(Self), eEC_Window))
            Send AssertIAreEqual True  (ElementHasBackColor(oScheme(Self), eEC_Keywords))
            Send AssertIAreEqual True  (ElementHasFontStyle(oScheme(Self), eEC_Keywords))
            Send AssertIAreEqual False (ElementHasFontStyle(oScheme(Self), eEC_Selection))
        End_Procedure

        // Editing one field leaves the others alone - what the dialog's controls do.
        {Published = True}
        Procedure SetElementFields_ChangeOnlyWhatTheyName
            tEditorStyle Appearance
            Send LoadBuiltIn of oScheme CS_ThemeBlue
            Send SetElementForeColor of oScheme eEC_Keywords (RGB(1,2,3))
            Send SetElementBold      of oScheme eEC_Keywords True
            Get StyleFor of oScheme eEC_Keywords to Appearance
            Send AssertIAreEqual (RGB(1,2,3))  Appearance.iForeColor
            Send AssertIAreEqual (RGB(0,0,128)) Appearance.iBackColor
            Send AssertIAreEqual True Appearance.bBold
            Send AssertIAreEqual False Appearance.bItalic
        End_Procedure

        // Every built-in name loads a scheme that reports that name back, so the theme
        // combo and the stored setting can never drift apart.
        {Published = True}
        Procedure EveryBuiltInReportsItsOwnName
            Integer i
            String[] asNames
            Get BuiltInNames of oScheme to asNames
            For i from 0 to (SizeOfArray(asNames) - 1)
                Send LoadBuiltIn of oScheme asNames[i]
                Send AssertSAreEqual asNames[i] (psSchemeName(oScheme(Self)))
            Loop
        End_Procedure

    End_Object
