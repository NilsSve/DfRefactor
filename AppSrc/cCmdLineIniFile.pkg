//****************************************************************************
// $Module type: Class Package
// $Module name: cCmdLineIniFile
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-03
//
// Description : THE COMMAND-LINE INI CONTRACT, in one testable place (Nils 2026-08-03).
//
//               The /bm INI feed had no unit tests, and the reason was structural rather than neglect:
//               the EXPORT lived on a modal dialog (CmdLineIniFileExporter.dg) and the IMPORT inline in
//               DFRefactor.src / DFRefactorFT.src. Neither is in UnitTests's include list, so
//               there was nothing a fixture could reach. This class is the seam - the rules that decide
//               what a key looks like and what a value means, with no dialog, no database and no file.
//
//               A STANDALONE CLASS ON PURPOSE, not members on cRefactorApplication: the test runner
//               builds a plain cApplication, so anything hung on cRefactorApplication compiles fine in a
//               fixture and silently returns nothing. See feedback_test_runner_app_class - that trap cost
//               a long debugging session once already. Fixtures do Get Create (RefClass(cCmdLineIniFile)),
//               the same pattern cDeepScanner and cLibraryInventory use.
//
//               What is here is only the PURE half. Reading and writing the file stays with cIniFile at
//               the call sites, and the database work (which folders, which functions are selected) stays
//               where the tables are. What moved is every rule that can be got wrong silently.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorConstants.h.pkg   // CS_CmdIniFileName - the base INI name the default path splices into

/* GLOBAL, deliberately - the class method below just forwards to it.

   Both exporters call this straight, with no object in sight. They must: the FT exporter seeds
   its path field from oWebIniFile_wf.OnStartup, which runs INSIDE the WebView2 pump, and a
   Get Create / Send Destroy pair there HUNG the program (2026-08-22 - the same class of wall
   this file's siblings document for YesNo boxes and Close_Panel). A pure global has nothing to
   create, so there is nothing for the pump to re-enter.

   The class method stays so the DFUnit fixture can keep calling it by handle. */
Function rfDefaultIniFileName Global String sSWSFile String sProgramsFolder Returns String
    String  sName sFile
    Integer iPos

    Move (RightPos("\", sSWSFile)) to iPos
    If (iPos > 0) ;
        Move (Right(sSWSFile, (Length(sSWSFile) - iPos))) to sName
    Else ;
        Move sSWSFile to sName
    Move (Pos(".", sName)) to iPos
    If (iPos <> 0) ;
        Move (Left(sName, iPos - 1)) to sName
    Move (Replaces(" ", sName, "_")) to sName

    Move CS_CmdIniFileName to sFile
    Move (Pos(".", sFile)) to iPos
    If (iPos <> 0 and sName <> "") ;
        Move (Insert(("_" + sName), sFile, iPos)) to sFile

    // Trim first, then the separator - vFolderFormat, which the call sites used before they
    // were pointed here, does exactly this.
    Move (Trim(sProgramsFolder)) to sProgramsFolder
    If (sProgramsFolder <> "" and Right(sProgramsFolder, 1) <> "\") ;
        Move (sProgramsFolder + "\") to sProgramsFolder
    Function_Return (sProgramsFolder + sFile)
End_Function

Class cCmdLineIniFile is a cObject

    /* THE FUNCTION-SPEC ENCODING for the [Functions Section] entries: "Name" when the
       function takes no parameter, "Name,Parameter" when it does.

       The comma is the separator and the FIRST one wins, which is what lets a parameter
       contain commas of its own - an enum list like "eA,eB" survives the round trip
       because only the leading comma is structural. Encode and decode live next to each
       other so that property cannot be broken from one side alone. */
    Function EncodeFunctionSpec String sName String sParameter Returns String
        Move (Trim(sName)) to sName
        Move (Trim(sParameter)) to sParameter
        If (sParameter = "") ;
            Function_Return sName
        Function_Return (sName + "," + sParameter)
    End_Function

    // The function NAME half of a spec - the whole string when there is no parameter.
    Function DecodeFunctionName String sSpec Returns String
        Integer iPos
        Move (Trim(sSpec)) to sSpec
        Move (Pos(",", sSpec)) to iPos
        If (iPos = 0) ;
            Function_Return sSpec
        Function_Return (Trim(Left(sSpec, iPos - 1)))
    End_Function

    // The PARAMETER half - "" when the spec carries none. Everything after the first
    // comma, so an embedded comma is preserved rather than truncated.
    Function DecodeFunctionParameter String sSpec Returns String
        Integer iPos
        Move (Trim(sSpec)) to sSpec
        Move (Pos(",", sSpec)) to iPos
        If (iPos = 0) ;
            Function_Return ""
        Function_Return (Trim(Mid(sSpec, (Length(sSpec) - iPos), (iPos + 1))))
    End_Function

    /* The default INI path the exporter offers: CS_CmdIniFileName with the TARGET workspace's
       name spliced in before its extension, in the folder the caller passes.

       Both exporters pass pOrgWS.sPrograms - DFRefactor's OWN Programs folder, NOT the folder
       of the workspace being refactored. Every export therefore lands in one shared folder,
       which is exactly why the workspace name is spliced into the FILE name: two workspaces
       exported side by side would otherwise overwrite each other. That folder is also where
       /bm looks up a bare file name, so an exported INI can be run by name alone.
       (Until 2026-08-22 this comment said "the workspace's Programs folder" and nothing in
       production called this function at all - the two exporters each had their own copy of
       the logic - so the comment drifted free of the code that shipped, and the tests could
       not catch it: they pass the folder IN.)

       Takes the pieces rather than reading pOrgWS / pTargetWS itself, which is what makes
       it testable at all. Spaces in the workspace name become underscores because this
       path ends up on a command line, where an unquoted space is two arguments.

       The extension is cut at the FIRST dot, matching the behaviour this replaces:
       "DFRefactor25.0.sws" is meant to yield "DFRefactor25", not "DFRefactor25.0". */
    Function DefaultIniFileName String sSWSFile String sProgramsFolder Returns String
        Function_Return (rfDefaultIniFileName(sSWSFile, sProgramsFolder))
    End_Function

End_Class
