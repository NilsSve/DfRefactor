//****************************************************************************
// $Module type: Test fixture
// $Module name: oRemoveTypefaceLine-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for RemoveTypefaceLine - the generalized successor of RemoveSansSerif
//               (the font is now the parameter; * = every Set Typeface line).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRemoveTypefaceLine is a cTestFixture
        Set psFunctionName to "RemoveTypefaceLine"

        // The classic default: MS Sans Serif, double-quoted, case-insensitive.
        {Published = True}
        Procedure RemoveTypefaceLine_DefaultFont
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Set TypeFace to "MS Sans serif"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "MS Sans Serif" to bChanged
            Send Assert bChanged
        End_Procedure

        // Single-quoted variant + leading indentation are also matched.
        {Published = True}
        Procedure RemoveTypefaceLine_QuoteStyleAndIndent
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Set TypeFace to 'MS Sans Serif'" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "MS Sans Serif" to bChanged
            Send Assert bChanged
        End_Procedure

        // The PARAMETER picks the font: a Courier line matches "Courier"...
        {Published = True}
        Procedure RemoveTypefaceLine_OtherFontViaParameter
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Set Typeface to "Courier New"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "Courier New" to bChanged
            Send Assert bChanged
        End_Procedure

        // ...and does NOT match a different font (the old hardwired behavior, inverted).
        {Published = True}
        Procedure RemoveTypefaceLine_WrongFontUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Set Typeface to "Courier New"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "MS Sans Serif" to bChanged
            Send Assert (bChanged = False)
        End_Procedure

        // * removes every Set Typeface line, whatever the font.
        {Published = True}
        Procedure RemoveTypefaceLine_WildcardAnyFont
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set Typeface to "Fixedsys"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "*" to bChanged
            Send Assert bChanged
        End_Procedure

        // Unrelated line mentioning the font -- bChanged must be False.
        {Published = True}
        Procedure RemoveTypefaceLine_MentionUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move "MS Sans Serif" to sFont' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "MS Sans Serif" to bChanged
            Send Assert (bChanged = False)
        End_Procedure

        // A COMMENTED Set Typeface line stays (the old anywhere-match removed those too).
        {Published = True}
        Procedure RemoveTypefaceLine_CommentedLineUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '// Set Typeface to "MS Sans Serif"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveTypefaceLine of ghoFuncLib (&sLine) "MS Sans Serif" to bChanged
            Send Assert (bChanged = False)
        End_Procedure

    End_Object
