Use RefactorConstants.h.pkg
/* THE NEVER-PICK GATE (2026-10-06). A GitHub report on a DataFlex 3.2 program: "set 'local' to 'never run'
   but it did". The list only kept the tool from ticking a function; now the engine refuses it at both
   dispatch points, from the list it reads with the run settings (pasNeverPickRun). The gate is a pure test
   of that property, so the fixture seeds it and clears it again. */
Object oNeverPickGate is a cTestFixture
    Set psFunctionName to "NeverPickGate"

    Procedure TearDown
        String[] asNone
        Set pasNeverPickRun of ghoEngine to asNone
        Send _InitializeFuncLib of ghoFuncLib
    End_Procedure

    // A listed function is skipped, case-blind; one not listed is not; an empty list skips nothing.
    {Published = True}
    Procedure NeverPickGate_ListedFunctionIsSkipped
        String[] asList asNone
        Boolean bSkip
        Set pasNeverPickRun of ghoEngine to asNone
        Get _SkipForNeverPick of ghoEngine "RemoveLocalKeyWord" to bSkip
        Send AssertFalse bSkip
        Move "RemoveLocalKeyWord" to asList[0]
        Move "ChangeChainToRunprogram" to asList[1]
        Set pasNeverPickRun of ghoEngine to asList
        Get _SkipForNeverPick of ghoEngine "RemoveLocalKeyWord" to bSkip
        Send Assert bSkip
        Get _SkipForNeverPick of ghoEngine "removelocalkeyword" to bSkip
        Send Assert bSkip
        Get _SkipForNeverPick of ghoEngine " ChangeChainToRunprogram " to bSkip
        Send Assert bSkip
        Get _SkipForNeverPick of ghoEngine "ChangeLegacyOperators" to bSkip
        Send AssertFalse bSkip
    End_Procedure

    // The skip is written down for the summary: one run note, naming the list.
    {Published = True}
    Procedure NeverPickGate_SkipLeavesARunNote
        String[] asList
        String sNotes
        Boolean bSkip
        Move "RemoveLocalKeyWord" to asList[0]
        Set pasNeverPickRun of ghoEngine to asList
        Get _SkipForNeverPick of ghoEngine "RemoveLocalKeyWord" to bSkip
        Send Assert bSkip
        Get RunNotesText of ghoFuncLib "RemoveLocalKeyWord" "" to sNotes
        Send Assert (Pos("never-pick list", sNotes) > 0) sNotes
        Send Assert (Pos("does not run", sNotes) > 0) sNotes
    End_Procedure
End_Object
