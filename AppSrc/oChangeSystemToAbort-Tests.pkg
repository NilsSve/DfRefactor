    Object oChangeSystemToAbort is a cTestFixture
        Set psFunctionName to "ChangeSystemToAbort"

        // Bare 'System' command -> 'Abort'.
        {Published = True}
        Procedure ChangeSystemToAbort_Bare
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "System" to sLine
            Move "Abort" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSystemToAbort of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure ChangeSystemToAbort_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "        System" to sLine
            Move "        Abort" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSystemToAbort of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // A longer identifier that merely STARTS with 'System' must NOT be swapped (whole-token match).
        {Published = True}
        Procedure ChangeSystemToAbort_NoMatchPrefix
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "SystemXyz Foo" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSystemToAbort of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "SystemXyz Foo" sLine
        End_Procedure

        // 'System' not in the leading command position is left alone.
        {Published = True}
        Procedure ChangeSystemToAbort_NoMatchNonLeading
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Get System_State to iX" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSystemToAbort of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Get System_State to iX" sLine
        End_Procedure

    End_Object
