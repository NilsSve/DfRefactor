//****************************************************************************
// $Module type: Test fixture
// $Module name: oMetaTagHealth-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-24
//
// Description : Unit tests for the meta-tag health scan (rfMetaTagHealthScan, MetaTagHealth.pkg)
//               and its rfLeadingIndent helper: a pure whole-file checker - no engine or file state.
//
//               NOTE ON THE FIXTURES: the delimiter under test is a triple double-quote, which cannot be
//               typed literally here - it would open an aligned multiline string in THIS file. Every fixture
//               therefore builds it from Character(34), which is also why the tests read a little oddly.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use MetaTagHealth.pkg            // the meta-tag checker
    Object oMetaTagHealth is a cTestFixture
        Set psFunctionName to "rfMetaTagHealthScan"

        // --- _LeadingIndent: leading spaces/tabs on a raw line. ---
        {Published = True}
        Procedure MetaTagHealth_LeadingIndent
            Integer iN
            String sTab
            Move (Character(9)) to sTab
            Move (rfLeadingIndent("no indent")) to iN
            Send AssertIAreEqual 0 iN
            Move (rfLeadingIndent("    four spaces")) to iN
            Send AssertIAreEqual 4 iN
            Move (rfLeadingIndent((sTab + sTab + "two tabs"))) to iN
            Send AssertIAreEqual 2 iN
            Move (rfLeadingIndent("")) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // --- RULE 1 FIRES: a body line short of the closing delimiter's indent. ---
        {Published = True}
        Procedure MetaTagHealth_Rule1_Fires
            String[] asCode asReport
            String sQ sAll
            Integer iN i

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ)         to asCode[0]
            Move "        Properly indented body line" to asCode[1]
            Move "    Pasted in flush left"            to asCode[2]   // indent 4 < closing 8 -> CRASH
            Move ("        " + sQ + " }")              to asCode[3]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 3:")            // the offending line, 1-based
            Send Assert (sAll contains "RULE 1")
            Send Assert (sAll contains "CRASHES THE COMPILER")
            Send Assert (not(sAll contains "Line 2:"))       // the well-indented line is not flagged
        End_Procedure

        // --- POSITIVE CONTROL: the same block, correctly indented, is silent. A blank body line
        //     is safe too (verified against the compiler), so it must not be mistaken for indent 0.
        {Published = True}
        Procedure MetaTagHealth_Rule1_CleanBlockAndBlankLine
            String[] asCode asReport
            String sQ
            Integer iN
            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ)          to asCode[0]
            Move "        First body line"              to asCode[1]
            Move ""                                     to asCode[2]   // blank - safe
            Move "            More deeply indented"     to asCode[3]   // deeper than closing - safe
            Move ("        " + sQ + " }")               to asCode[4]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // --- The rule is relative to the CLOSING delimiter, not to a fixed column: the same body
        //     indent passes under a shallow closing and fails under a deeper one.
        {Published = True}
        Procedure MetaTagHealth_Rule1_IsRelativeToTheCloser
            String[] asCode asReport
            String sQ
            Integer iN

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            // body 4, closing 4 -> fine
            Move ("    { Description = " + sQ) to asCode[0]
            Move "    Body at four"            to asCode[1]
            Move ("    " + sQ + " }")          to asCode[2]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
            // the SAME body indent, closing at 8 -> crash
            Move ("    { Description = " + sQ) to asCode[0]
            Move "    Body at four"            to asCode[1]
            Move ("        " + sQ + " }")      to asCode[2]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
        End_Procedure

        // --- RULE 2: over the crash limit is reported as fatal; over budget but under the limit
        //     is reported as a warning that does NOT claim the build is broken.
        {Published = True}
        Procedure MetaTagHealth_Rule2_SizeTiers
            String[] asCode asReport
            String sQ sFill sAll
            Integer iN i

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move "" to sFill
            For i from 1 to 8
                Move (sFill + "abcdefghij") to sFill        // exactly 80 characters
            Loop
            // 25 body lines of 88 characters -> ~2258, past CI_MetaTagCrashChars.
            Move ("    { Description = " + sQ) to asCode[0]
            For i from 1 to 25
                Move ("        " + sFill) to asCode[i]
            Loop
            Move ("        " + sQ + " }") to asCode[26]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "RULE 2")
            Send Assert (sAll contains "CRASHES THE COMPILER")
        End_Procedure

        {Published = True}
        Procedure MetaTagHealth_Rule2_WarnsBeforeItBreaks
            String[] asCode asReport asEmpty
            String sQ sFill sAll
            Integer iN i

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move "" to sFill
            For i from 1 to 8
                Move (sFill + "abcdefghij") to sFill
            Loop
            // 23 body lines -> ~2080: over CI_MetaTagMaxSafeChars, still under the crash limit.
            Move ("    { Description = " + sQ) to asCode[0]
            For i from 1 to 23
                Move ("        " + sFill) to asCode[i]
            Loop
            Move ("        " + sQ + " }") to asCode[24]
            Move asEmpty to asReport
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "RULE 2")
            Send Assert (sAll contains "budget")
            // A warning must NOT claim the build is broken - it still compiles today.
            Send Assert (not(sAll contains "CRASHES THE COMPILER"))
        End_Procedure

        // --- A short, well-formed block is silent, and a file with no triple-quote at all exits
        //     on the pre-gate. Both are the "no false alarm" controls.
        {Published = True}
        Procedure MetaTagHealth_QuietOnHealthySource
            String[] asCode asReport asEmpty
            String sQ
            Integer iN

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ)                 to asCode[0]
            Move "        Swaps the obsolete command."         to asCode[1]
            Move "        { MethodType = eStandardFunction }"  to asCode[2]
            Move ("        " + sQ + " }")                      to asCode[3]
            Move "    Function ChangeSomething Returns Boolean" to asCode[4]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
            // No triple-quote anywhere -> the file pre-gate returns 0 without scanning.
            Move asEmpty to asCode
            Move "    // Just ordinary source" to asCode[0]
            Move "    Move 1 to iCount"        to asCode[1]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // --- A value opened and closed on ONE line has no body lines: nothing to check, and it
        //     must not be mistaken for an unterminated block.
        {Published = True}
        Procedure MetaTagHealth_SingleLineValueIsSkipped
            String[] asCode asReport
            String sQ
            Integer iN
            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ + "one liner" + sQ + " }") to asCode[0]
            Move "    Function ChangeSomething Returns Boolean"          to asCode[1]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // --- An opening with no closing delimiter is reported rather than silently ignored:
        //     it is a broken build too, and the cause is otherwise invisible.
        {Published = True}
        Procedure MetaTagHealth_UnterminatedValueIsReported
            String[] asCode asReport
            String sQ sAll
            Integer iN i

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ)   to asCode[0]
            Move "        A body line"           to asCode[1]
            Move "    Function Oops Returns Boolean" to asCode[2]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "UNTERMINATED")
        End_Procedure

        // --- RULE 3: a brace in the PROSE truncates the help text at that point. Not a crash,
        //     which is why it needs catching - ParseHelpText takes everything before the first
        //     brace, so a sentence naming a tag silently throws the rest of the description away.
        {Published = True}
        Procedure MetaTagHealth_Rule3_BraceInProseIsReported
            String[] asCode asReport asEmpty
            String sQ sAll
            Integer iN i

            Move ((Character(34)) + (Character(34)) + (Character(34))) to sQ
            Move ("    { Description = " + sQ)                     to asCode[0]
            Move "        Pastes a paragraph into a { Description } and loses the rest." to asCode[1]
            Move "        { MethodType = eStandardFunction }"      to asCode[2]
            Move ("        " + sQ + " }")                          to asCode[3]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "RULE 3")
            Send Assert (sAll contains "TRUNCATES")
            // POSITIVE CONTROL: the real sub-tags open braces too and must NOT be flagged.
            Move asEmpty to asCode
            Move asEmpty to asReport
            Move ("    { Description = " + sQ)                     to asCode[0]
            Move "        Swaps the obsolete command for the modern one." to asCode[1]
            Move "        { MethodType = eStandardFunction }"      to asCode[2]
            Move "        { FnGroup = Modernization }"             to asCode[3]
            Move ("        " + sQ + " }")                          to asCode[4]
            Move (rfMetaTagHealthScan(&asCode, &asReport)) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

    End_Object
