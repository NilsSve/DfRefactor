//****************************************************************************
// $Module type: Test fixture
// $Module name: oConvertGosubToProcedure-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-13
//
// Description : Unit tests for the Gosub -> Procedure converter (Phase 2). The pure plan/line cores live in
//               cRefactorFuncLib (_GosubConvertPlan, _GosubCallLineToSend, _GosubOnLineToCase,
//               _GosubTransformBodyLine); the whole-file assembly is ConvertGosubToProcedure (eOtherFunction,
//               oRefactorFuncLib). All identifiers are GENERIC by design (never customer source).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oConvertGosubToProcedure is a cTestFixture
        Set psFunctionName to "ConvertGosubToProcedure"

        // --- Plan: a self-contained subroutine is CONVERTIBLE, with its block bounds. ---
        {Published = True}
        Procedure ConvertGosub_Plan_Candidate
            String[] asCode asCandLabels asCandOrig
            Integer[] aiCandStart aiCandEnd
            Integer iN

            Move "entry_pt:"          to asCode[0]
            Move "    gosub calc_it"   to asCode[1]
            Move "    gosub_return"    to asCode[2]
            Move "calc_it:"           to asCode[3]
            Move "    move 1 to iSum"  to asCode[4]
            Move "    gosub_return"    to asCode[5]
            Get _GosubConvertPlan of ghoFuncLib (&asCode) (&asCandLabels) (&asCandOrig) (&aiCandStart) (&aiCandEnd) to iN
            Send AssertIAreEqual 1 iN
            Send Assert (asCandLabels[0] = "calc_it")
            Send AssertIAreEqual 3 aiCandStart[0]
            Send AssertIAreEqual 5 aiCandEnd[0]
        End_Procedure

        // --- Plan closure: a candidate that CALLS a MANUAL subroutine is withdrawn (a residual Gosub
        //     would illegally cross the extracted Procedure's boundary). ---
        {Published = True}
        Procedure ConvertGosub_Plan_ClosureExcludesCaller
            String[] asCode asCandLabels asCandOrig
            Integer[] aiCandStart aiCandEnd
            Integer iN

            Move "main_start:"                 to asCode[0]
            Move "    gosub a_sub"             to asCode[1]
            Move "    procedure_return"        to asCode[2]
            Move "a_sub:"                      to asCode[3]
            Move "    gosub b_sub"             to asCode[4]
            Move "    gosub_return"            to asCode[5]
            Move "b_sub:"                      to asCode[6]
            Move "    gosub_return skip_place" to asCode[7]   // label-arg return -> b_sub is MANUAL
            Move "    gosub_return"            to asCode[8]
            Get _GosubConvertPlan of ghoFuncLib (&asCode) (&asCandLabels) (&asCandOrig) (&aiCandStart) (&aiCandEnd) to iN
            Send AssertIAreEqual 0 iN          // a_sub excluded because it calls the manual b_sub
        End_Procedure

        /* --- ON ERROR GOSUB is an error trap (2026-11-02): FMAC stores the label as the error handler. It became a Case
               on a symbol called 'error', and the label a Procedure inside the 'If False Begin' wrapper around it. --- */
        {Published = True}
        Procedure ConvertGosub_OnErrorIsAnErrorTrap
            String[] asCode asOriginal asCase asCand asOrig
            Integer iN i
            Boolean bTrap

            Get _GosubOnIsErrorTrap of ghoFuncLib "    On Error Gosub my_trap  // the handler" to bTrap
            Send Assert bTrap "On Error Gosub"
            Get _GosubOnIsErrorTrap of ghoFuncLib "    On iMode Gosub calc_it print_it" to bTrap
            Send AssertFalse bTrap
            Get _GosubOnIsErrorTrap of ghoFuncLib "    gosub calc_it" to bTrap
            Send AssertFalse bTrap

            Move "my_trap" to asCand[0]
            Move "my_trap" to asOrig[0]
            Get _GosubOnLineToCase of ghoFuncLib "    on error gosub my_trap" (&asCand) (&asOrig) (&asCase) to iN
            Send AssertIAreEqual 0 iN

            Move "Function Foo Returns Integer"   to asCode[0]
            Move "    on error gosub my_trap"     to asCode[1]
            Move "    Function_Return 1"          to asCode[2]
            Move "End_Function"                   to asCode[3]
            Move "my_trap:"                       to asCode[4]
            Move "    move 0 to windowindex"      to asCode[5]
            Move "    gosub_return"               to asCode[6]
            Move asCode to asOriginal
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 0 iN
            For i from 0 to 6
                Send AssertSAreEqual asOriginal[i] asCode[i]
            Loop
        End_Procedure

        /* --- A block is a Procedure only if it is one piece of code (2026-11-02). A block runs to the next called label or
               the end of the file, so one with a method below it took the method in, and one inside an If..Begin took
               the End with it. --- */
        {Published = True}
        Procedure ConvertGosub_Plan_BlockMustBeOnePieceOfCode
            String[] asCode asEmpty asCandLabels asCandOrig
            Integer[] aiCandStart aiCandEnd
            Integer iN

            Move "gosub a_sub"                    to asCode[0]
            Move "abort"                          to asCode[1]
            Move "a_sub:"                         to asCode[2]
            Move "    move 1 to iX"               to asCode[3]
            Move "    gosub_return"               to asCode[4]
            Move "Function Later Returns Integer" to asCode[5]
            Move "End_Function"                   to asCode[6]
            Get _GosubConvertPlan of ghoFuncLib (&asCode) (&asCandLabels) (&asCandOrig) (&aiCandStart) (&aiCandEnd) to iN
            Send AssertIAreEqual 0 iN

            Move asEmpty to asCode
            Move "gosub a_sub"                    to asCode[0]
            Move "if False begin"                 to asCode[1]
            Move "a_sub:"                         to asCode[2]
            Move "    gosub_return"               to asCode[3]
            Move "end"                            to asCode[4]
            Get _GosubConvertPlan of ghoFuncLib (&asCode) (&asCandLabels) (&asCandOrig) (&aiCandStart) (&aiCandEnd) to iN
            Send AssertIAreEqual 0 iN

            // Blocks inside the subroutine are its own: this one still converts.
            Move asEmpty to asCode
            Move "gosub a_sub"                    to asCode[0]
            Move "abort"                          to asCode[1]
            Move "a_sub:"                         to asCode[2]
            Move "    if iX eq 1 begin"           to asCode[3]
            Move "        move 2 to iX"           to asCode[4]
            Move "    end"                        to asCode[5]
            Move "    gosub_return"               to asCode[6]
            Get _GosubConvertPlan of ghoFuncLib (&asCode) (&asCandLabels) (&asCandOrig) (&aiCandStart) (&aiCandEnd) to iN
            Send AssertIAreEqual 1 iN
        End_Procedure

        // The report says the same as the plan, and what the ON ERROR line is.
        {Published = True}
        Procedure GosubAudit_ReportsAnErrorTrap
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    on error gosub my_trap"     to asCode[0]
            Move "my_trap:"                       to asCode[1]
            Move "    gosub_return"               to asCode[2]
            Get _GosubAuditFile of ghoFuncLib (&asCode) (&asReport) to iN
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (Pos("MANUAL", sAll) > 0) sAll
            Send Assert (Pos("an error trap, not a dispatch", sAll) > 0) sAll
            Send Assert (Pos("rewrite as a Case block", sAll) = 0) sAll
        End_Procedure

        // --- 'Gosub X' -> 'Send X_Sub': plain, inline-If, comment preserved, non-convertible left alone. ---
        {Published = True}
        Procedure ConvertGosub_CallLineToSend
            String[] asCand asOrig
            String s

            Move "calc_it" to asCand[0]
            Move "calc_it" to asOrig[0]
            Get _GosubCallLineToSend of ghoFuncLib "    gosub calc_it" (&asCand) (&asOrig) to s
            Send AssertSAreEqual "    Send calc_it_Sub" s
            Get _GosubCallLineToSend of ghoFuncLib "    If iX eq 1 gosub calc_it" (&asCand) (&asOrig) to s
            Send AssertSAreEqual "    If iX eq 1 Send calc_it_Sub" s
            Get _GosubCallLineToSend of ghoFuncLib "    gosub calc_it   // do it" (&asCand) (&asOrig) to s
            Send AssertSAreEqual "    Send calc_it_Sub   // do it" s
            // a target that is not in the convertible set passes through unchanged
            Get _GosubCallLineToSend of ghoFuncLib "    gosub other_sub" (&asCand) (&asOrig) to s
            Send AssertSAreEqual "    gosub other_sub" s
        End_Procedure

        // --- 'ON <expr> GOSUB l1 l2' -> a Case block of Send calls (original casing preserved). ---
        {Published = True}
        Procedure ConvertGosub_OnLineToCase
            String[] asCand asOrig asCase
            String sAll
            Integer iN i

            Move "calc_it"   to asCand[0]
            Move "print_row" to asCand[1]
            Move "Calc_It"   to asOrig[0]
            Move "Print_Row" to asOrig[1]
            Get _GosubOnLineToCase of ghoFuncLib "    On iMode Gosub calc_it print_row" (&asCand) (&asOrig) (&asCase) to iN
            Send Assert (iN > 0)
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCase) - 1)
                Move (sAll + asCase[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Case Begin")
            Send Assert (sAll contains "Case (iMode = 1)")
            Send Assert (sAll contains "Send Calc_It_Sub")
            Send Assert (sAll contains "Case (iMode = 2)")
            Send Assert (sAll contains "Send Print_Row_Sub")
            Send Assert (sAll contains "Case End")
            // a dispatch with a non-convertible target is NOT rewritten
            Get _GosubOnLineToCase of ghoFuncLib "    On iMode Gosub calc_it missing" (&asCand) (&asOrig) (&asCase) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // --- Body-line transform: 'Gosub_Return' -> 'Procedure_Return' only INSIDE an extracted block. ---
        {Published = True}
        Procedure ConvertGosub_TransformBodyLine
            String[] asCand asOrig asBody
            Integer iN

            Move "calc_it" to asCand[0]
            Move "calc_it" to asOrig[0]
            Get _GosubTransformBodyLine of ghoFuncLib "    gosub_return" True (&asCand) (&asOrig) (&asBody) to iN
            Send AssertSAreEqual "    Procedure_Return" asBody[0]
            // outside a converted block a top-level Gosub_Return is left alone
            Get _GosubTransformBodyLine of ghoFuncLib "    gosub_return" False (&asCand) (&asOrig) (&asBody) to iN
            Send AssertSAreEqual "    gosub_return" asBody[0]
            // a Gosub call converts in either context
            Get _GosubTransformBodyLine of ghoFuncLib "    gosub calc_it" False (&asCand) (&asOrig) (&asBody) to iN
            Send AssertSAreEqual "    Send calc_it_Sub" asBody[0]
            // an unrelated line passes through
            Get _GosubTransformBodyLine of ghoFuncLib "    move 1 to iX" True (&asCand) (&asOrig) (&asBody) to iN
            Send AssertSAreEqual "    move 1 to iX" asBody[0]
        End_Procedure

        // --- Whole file: a candidate subroutine becomes a global Procedure; its Gosub calls and
        //     Gosub_Returns convert; the entry code's own Gosub_Return is left alone. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_Candidate
            String[] asCode
            Integer iN

            Move "entry_pt:"          to asCode[0]
            Move "    gosub calc_it"   to asCode[1]
            Move "    gosub_return"    to asCode[2]
            Move "calc_it:"           to asCode[3]
            Move "    move 1 to iSum"  to asCode[4]
            Move "    gosub_return"    to asCode[5]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 1 iN
            Send AssertSAreEqual "    Send calc_it_Sub" asCode[1]
            Send AssertSAreEqual "    gosub_return"     asCode[2]     // entry return untouched
            Send Assert (asCode[3] contains "Procedure calc_it_Sub GLOBAL")
            Send AssertSAreEqual "    Procedure_Return" asCode[5]
            Send AssertSAreEqual "End_Procedure"        asCode[6]
        End_Procedure

        // --- Whole file: a MANUAL subroutine (label-arg Gosub_Return) is left entirely untouched. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_ManualUntouched
            String[] asCode
            Integer iN

            Move "entry_pt:"                            to asCode[0]
            Move "    gosub weird_sub"                  to asCode[1]
            Move "    gosub_return"                     to asCode[2]
            Move "weird_sub:"                           to asCode[3]
            Move "    if iX eq 1 gosub_return elsewhere" to asCode[4]   // kind-3 return -> MANUAL
            Move "    gosub_return"                     to asCode[5]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 0 iN
            Send AssertSAreEqual "    gosub weird_sub" asCode[1]
            Send AssertSAreEqual "weird_sub:"          asCode[3]
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
        End_Procedure

        // --- Whole file: a file-scope variable referenced inside a converted sub is promoted to
        //     Global_Variable (with a marker); an unreferenced one is left bare. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_VarPromotion
            String[] asCode
            Integer iN

            Move "String sName"           to asCode[0]   // referenced by calc_it -> promote
            Move "Integer iUnused"        to asCode[1]   // not referenced -> stays bare
            Move "entry_pt:"              to asCode[2]
            Move "    gosub calc_it"       to asCode[3]
            Move "    gosub_return"        to asCode[4]
            Move "calc_it:"               to asCode[5]
            Move "    move sName to sName" to asCode[6]
            Move "    gosub_return"        to asCode[7]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 1 iN
            Send Assert (asCode[0] contains "promoted to Global_Variable")
            Send AssertSAreEqual "Global_Variable String sName" asCode[1]
            Send AssertSAreEqual "Integer iUnused"              asCode[2]   // unchanged, unreferenced
            Send Assert (asCode[6] contains "Procedure calc_it_Sub GLOBAL")
        End_Procedure

        // --- Whole file: an ON..GOSUB in the entry code becomes a Case block of Sends, and both
        //     dispatched subroutines become global Procedures. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_OnGosub
            String[] asCode
            String sAll
            Integer iN i

            Move "entry_pt:"                        to asCode[0]
            Move "    On iMode Gosub calc_it print_it" to asCode[1]
            Move "    gosub_return"                 to asCode[2]
            Move "calc_it:"                         to asCode[3]
            Move "    move 1 to iX"                  to asCode[4]
            Move "    gosub_return"                 to asCode[5]
            Move "print_it:"                        to asCode[6]
            Move "    move 2 to iX"                  to asCode[7]
            Move "    gosub_return"                 to asCode[8]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 2 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Case Begin")
            Send Assert (sAll contains "Send calc_it_Sub")
            Send Assert (sAll contains "Send print_it_Sub")
            Send Assert (sAll contains "Case End")
            Send Assert (sAll contains "Procedure calc_it_Sub GLOBAL")
            Send Assert (sAll contains "Procedure print_it_Sub GLOBAL")
        End_Procedure

        // --- Whole file: a report image's and a block comment's text are no code (2026-10-30). Read raw, the
        //     image line started with a type word and named a variable the subroutine uses, so it was
        //     "promoted" - the printed image changed - and the comment's "Object" line nested every line below
        //     it, so the real declaration was not promoted. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_ImageAndCommentTextUntouched
            String[] asCode
            Integer iN

            Move "/Head_Img"                   to asCode[0]
            Move "Date      Name      Amount"   to asCode[1]
            Move "/*"                          to asCode[2]
            Move "/* Notes on the old module:"  to asCode[3]
            Move "   Object oOld is a cObject"  to asCode[4]
            Move "   String Amount"             to asCode[5]
            Move "*/"                          to asCode[6]
            Move "String Amount"               to asCode[7]
            Move "entry_pt:"                   to asCode[8]
            Move "    gosub calc_it"            to asCode[9]
            Move "    gosub_return"             to asCode[10]
            Move "calc_it:"                    to asCode[11]
            Move "    move 1 to Amount"         to asCode[12]
            Move "    gosub_return"             to asCode[13]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 16 (SizeOfArray(asCode))
            Send AssertSAreEqual "Date      Name      Amount"     asCode[1]   // the image's text, as written
            Send AssertSAreEqual "   Object oOld is a cObject"    asCode[4]
            Send AssertSAreEqual "   String Amount"               asCode[5]   // the comment's text, as written
            Send Assert (asCode[7] contains "promoted to Global_Variable")
            Send AssertSAreEqual "Global_Variable String Amount"  asCode[8]
            Send AssertSAreEqual "    Send calc_it_Sub"           asCode[10]
            Send Assert (asCode[12] contains "Procedure calc_it_Sub GLOBAL")
            Send AssertSAreEqual "    Procedure_Return"           asCode[14]
            Send AssertSAreEqual "End_Procedure"                  asCode[15]
        End_Procedure

        // --- Whole file: commented-out Gosub code is no code (2026-10-30). Read raw, its label split the real
        //     subroutine, which then had no Gosub_Return in its block, and the commented-out one was converted
        //     instead: its Procedure line was written inside the comment and its End_Procedure in the code
        //     below - a file that no longer compiled. ---
        {Published = True}
        Procedure ConvertGosub_WholeFile_CommentedOutSubroutine
            String[] asCode
            Integer iN

            Move "entry_pt:"          to asCode[0]
            Move "    gosub calc_it"   to asCode[1]
            Move "    gosub_return"    to asCode[2]
            Move "calc_it:"           to asCode[3]
            Move "    move 1 to iX"    to asCode[4]
            Move "/*  gosub old_sub"   to asCode[5]
            Move "old_sub:"           to asCode[6]
            Move "    gosub_return"    to asCode[7]
            Move "*/"                 to asCode[8]
            Move "    gosub_return"    to asCode[9]
            Get ConvertGosubToProcedure of ghoFuncLib (&asCode) "" to iN
            Send AssertIAreEqual 1 iN
            Send AssertIAreEqual 11 (SizeOfArray(asCode))
            Send AssertSAreEqual "    Send calc_it_Sub"  asCode[1]
            Send Assert (asCode[3] contains "Procedure calc_it_Sub GLOBAL")
            Send AssertSAreEqual "/*  gosub old_sub"     asCode[5]   // the comment, as written
            Send AssertSAreEqual "old_sub:"              asCode[6]
            Send AssertSAreEqual "    gosub_return"      asCode[7]
            Send AssertSAreEqual "    Procedure_Return"  asCode[9]
            Send AssertSAreEqual "End_Procedure"         asCode[10]
        End_Procedure

    End_Object
