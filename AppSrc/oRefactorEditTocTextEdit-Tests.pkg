// Web-site    : http://www.rdctools.com
// Created     : 2026-07-03
//
// Description : Unit tests for the RefactorEditTocTextEdit refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRefactorEditTocTextEdit is a cTestFixture
        Set psFunctionName to "RefactorEditTocTextEdit"

        // The LegacyApp BESB0010TEST.vw shape: lowercase class + 'Is A' casing - matched case-insensitively,
        // the surrounding casing preserved, the class written canonically.
        { Published = True }
        Procedure RefactorEditTocTextEdit_CaseInsensitive
            String[] asCode
            Integer iCount
            Move '                                Object ruta4 Is A edit' to asCode[0]
            Move '                                    Set Size to 60 100' to asCode[1]
            Move '                                End_Object'             to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '                                Object ruta4 Is A cTextEdit' asCode[0]
        End_Procedure

        // Legacy DataFlex also accepts the 'is an' article ('Object text_formatter is an edit' -
        // WinServ Serv_avtal_upp.rv, 2026-07-17): the scan's class rule matched it but the
        // converter required ' is a ' and silently skipped. Converts now, the n dropped (the
        // target class is consonant-initial), surrounding casing preserved.
        { Published = True }
        Procedure RefactorEditTocTextEdit_IsAnArticle
            String[] asCode
            Integer iCount
            Move '    Object text_formatter is an edit'   to asCode[0]
            Move '        Set Location to 308 33'         to asCode[1]
            Move '    End_Object'                         to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Object text_formatter is a cTextEdit' asCode[0]
        End_Procedure

        // Whole-token: a dbEdit object is NEVER touched by the Edit converter (dbEdit has its own).
        { Published = True }
        Procedure RefactorEditTocTextEdit_DbEditNotTouched
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a dbEdit' to asCode[0]
            Move 'End_Object'                to asCode[1]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oNotes is a dbEdit' asCode[0]
        End_Procedure

        // Wrap_State inside the converted Edit -> pbWrap.
        { Published = True }
        Procedure RefactorEditTocTextEdit_WrapState
            String[] asCode
            Integer iCount
            Move 'Object oText is a Edit'    to asCode[0]
            Move '    Set Wrap_State to False' to asCode[1]
            Move 'End_Object'                to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Set pbWrap to False' asCode[1]
        End_Procedure

        // A commented-out declaration is skipped (the AB-generated '//     X is a Edit' headers).
        { Published = True }
        Procedure RefactorEditTocTextEdit_CommentSkipped
            String[] asCode
            Integer iCount
            Move '//     SelectionEdit is a Edit'  to asCode[0]
            Move 'Object SelectionEdit is a Edit'  to asCode[1]
            Move 'End_Object'                      to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '//     SelectionEdit is a Edit' asCode[0]
            Send AssertSAreEqual 'Object SelectionEdit is a cTextEdit' asCode[1]
        End_Procedure

        // The class swap must ALSO retire the obsolete 'Use Dftxtwin.pkg' it leaves behind, or every later
        // compile re-flags warning 4536 (Nils 2026-07-06). Case-insensitive on the package name.
        { Published = True }
        Procedure RefactorEditTocTextEdit_SwapsUsePackage
            String[] asCode
            Integer iCount
            Move 'Use Dftxtwin.pkg'            to asCode[0]
            Move 'Object oNotes is a Edit'     to asCode[1]
            Move 'End_Object'                  to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cTextEdit.pkg'             asCode[0]
            Send AssertSAreEqual 'Object oNotes is a cTextEdit'  asCode[1]
        End_Procedure

        // Edit taken straight from Windows.pkg (NO Dftxtwin to swap): cTextEdit lives in its own package and is
        // NOT reachable via Windows.pkg, so the converter must APPEND 'Use cTextEdit.pkg' after the leading Use
        // block, or cTextEdit is an undefined class (Nils 2026-07-07).
        { Published = True }
        Procedure RefactorEditTocTextEdit_AppendsUsePackageWhenNoLegacy
            String[] asCode
            Integer iCount
            Move 'Use Windows.pkg'            to asCode[0]
            Move 'Object oNotes is a Edit'    to asCode[1]
            Move 'End_Object'                 to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send Assert (SizeOfArray(asCode) = 4)
            Send AssertSAreEqual 'Use Windows.pkg'              asCode[0]
            Send AssertSAreEqual 'Use cTextEdit.pkg'            asCode[1]
            Send AssertSAreEqual 'Object oNotes is a cTextEdit' asCode[2]
        End_Procedure

        // Both the obsolete Dftxtwin AND the target cTextEdit.pkg already Used: drop the obsolete one (no
        // duplicate Use, and warning 4536 cleared) rather than swapping in a second cTextEdit.pkg (2026-07-07).
        { Published = True }
        Procedure RefactorEditTocTextEdit_DropsLegacyWhenTargetPresent
            String[] asCode
            Integer iCount
            Move 'Use cTextEdit.pkg'          to asCode[0]
            Move 'Use Dftxtwin.pkg'           to asCode[1]
            Move 'Object oNotes is a Edit'    to asCode[2]
            Move 'End_Object'                 to asCode[3]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send Assert (SizeOfArray(asCode) = 3)
            Send AssertSAreEqual 'Use cTextEdit.pkg'            asCode[0]
            Send AssertSAreEqual 'Object oNotes is a cTextEdit' asCode[1]
        End_Procedure

        /* THE STILL-NEEDED BRANCH - the one that faulted live on 2026-07-28.

           This is the VDFTranslator.pkg shape: an Edit converts, but the file ALSO names dbEdit
           on an Import_Class_Protocol line that no converter rewrites. Dftxtwin.pkg owns dbEdit,
           so it must NOT be retired (dropping it cost the 388-error run) - the target Use is
           APPENDED after the leading Use block and both packages stay.

           That branch called `Get GetIndent`, a method of cGridToCJGridBase - a class family the
           funclib does not descend from - so the message went unanswered, delegated funclib ->
           ClientArea -> Main -> Desktop, and died as runtime Error 98. Late binding means the
           compiler saw nothing; it took a file matching ALL FOUR conditions (an Edit to convert,
           a surviving legacy class, no target Use, and a leading Use block) to reach it, which is
           why one file in a whole workspace found it.

           The indented Use block is deliberate: it pins that the appended line inherits the
           indent of the last Use, which is the value the faulting Get was trying to produce. */
        { Published = True }
        Procedure RefactorEditTocTextEdit_LegacyPkgStillNeededAppendsTarget
            String[] asCode
            Integer iCount

            Move '    Use Windows.pkg'                                                to asCode[0]
            Move '    Use Dftxtwin.pkg'                                               to asCode[1]
            Move '    Import_Class_Protocol ExtensionClass dbEdit KeyAction_On_Key'   to asCode[2]
            Move '    Object ruta is a Edit'                                          to asCode[3]
            Move '    End_Object'                                                     to asCode[4]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            // The Edit converted...
            Send AssertSAreEqual '    Object ruta is a cTextEdit' asCode[4]
            // ...the legacy Use SURVIVED, because dbEdit still needs it...
            Send AssertSAreEqual '    Use Dftxtwin.pkg' asCode[1]
            // ...and the target was appended after the leading Use block, at that block's indent.
            Send AssertSAreEqual '    Use cTextEdit.pkg' asCode[2]
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
        End_Procedure

        // ---- 2026-09-07 ----------------------------------------------------------------------------
        // The plain Scroll_Bar_Visible_State has no cTextEdit equivalent either: its Horizontal_ / Vertical_
        // twins were tagged and the plain form rode through. Tagged now, never removed.
        { Published = True }
        Procedure RefactorEditTocTextEdit_PlainScrollBarStateFlagged
            String[] asCode
            Integer iCount i iAt
            Move 'Object oNote is an Edit'                       to asCode[0]
            Move '    Set Scroll_Bar_Visible_State to False'    to asCode[1]
            Move '    Set Size to 60 100'                        to asCode[2]
            Move 'End_Object'                                    to asCode[3]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Move -1 to iAt
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Lowercase(asCode[i]) contains "scroll_bar_visible_state") ;
                    Move i to iAt
            Loop
            Send Assert (iAt >= 0)
            Send Assert (asCode[iAt] contains "TODO (DFRefactor)")
            Send Assert (Left(Trim(asCode[iAt]), 31) = "Set Scroll_Bar_Visible_State to")
        End_Procedure

        /* AN EMPTY PARAMETER AND THE SUBCLASSES THE CHECK LEARNED (2026-09-07). The subclass's own base line
           converts - the plain pair matches it, trailing macro arguments and all - and when the file already
           declares a sibling on the modern base, the run note says the objects could move there instead. */
        { Published = True }
        Procedure RefactorEditTocTextEdit_LearnedSubclassBaseLineAndSiblingNote
            String[] asCode asNames asRoots asNone
            String sNotes
            Integer iCount
            Move "myedit" to asNames[0]
            Move "edit"   to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move 'Class MyTextEdit is a cTextEdit'                          to asCode[0]
            Move 'End_Class'                                                to asCode[1]
            Move 'Class MyEdit is an Edit startmac MY_START_MACRO'           to asCode[2]
            Move '    Procedure Construct_Object'                          to asCode[3]
            Move '        Forward Send Construct_Object'                   to asCode[4]
            Move '    End_Procedure'                                        to asCode[5]
            Move 'End_Class'                                                to asCode[6]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Get RunNotesText of ghoFuncLib "RefactorEditTocTextEdit" "" to sNotes
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
            Send AssertIAreEqual 1 iCount
            Send Assert ((SearchArray('Class MyEdit is a cTextEdit startmac MY_START_MACRO', asCode)) >= 0)
            Send Assert (sNotes contains "MyTextEdit")
            Send Assert (sNotes contains "retiring MyEdit")
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // An object of a learned subclass is left alone - it follows its class - and the run note says so.
        { Published = True }
        Procedure RefactorEditTocTextEdit_ObjectsOfLearnedSubclassFollowTheirClass
            String[] asCode asNames asRoots asNone
            String sNotes
            Integer iCount
            Move "myedit" to asNames[0]
            Move "edit"   to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move 'Object oNote is a MyEdit'      to asCode[0]
            Move '    Set Size to 60 100'        to asCode[1]
            Move 'End_Object'                    to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Get RunNotesText of ghoFuncLib "RefactorEditTocTextEdit" "" to sNotes
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oNote is a MyEdit' asCode[0]
            Send Assert (sNotes contains "follow their class")
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        /* A REAL PACKAGE WITH NO Use AT ALL (2026-11-05): it took Edit from whoever Used it first. A class needs its base
           where it stands, so the Use goes in, below the header comment and above the class. Without it the file only
           compiles behind DFAllEnt.pkg, which brings cTextEdit along; on its own it stops on U_CTEXTEDIT. */
        { Published = True }
        Procedure RefactorEditTocTextEdit_AClassWithNoUseGetsItsBase
            String[] asCode
            Integer iCount
            Move '// An edit that translates its own label'  to asCode[0]
            Move ''                                          to asCode[1]
            Move 'Class cMyEdit is a Edit'                   to asCode[2]
            Move 'End_Class'                                 to asCode[3]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '// An edit that translates its own label' asCode[0]
            Send AssertSAreEqual 'Use cTextEdit.pkg' asCode[2]
            Send AssertSAreEqual 'Class cMyEdit is a cTextEdit' asCode[3]
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            // And once is enough.
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // Its old Use is swapped, not added to.
        { Published = True }
        Procedure RefactorEditTocTextEdit_AClassWithTheOldUseSwapsIt
            String[] asCode
            Integer iCount
            Move 'Use Dftxtwin.pkg'         to asCode[0]
            Move 'Class cMyEdit is a Edit'  to asCode[1]
            Move 'End_Class'                to asCode[2]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cTextEdit.pkg' asCode[0]
            Send AssertSAreEqual 'Class cMyEdit is a cTextEdit' asCode[1]
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
        End_Procedure

        // An OBJECT in a file with no Use stays a fragment: it lives inside whatever Used it.
        { Published = True }
        Procedure RefactorEditTocTextEdit_AnObjectWithNoUseStaysAFragment
            String[] asCode
            Integer iCount
            Move 'Object oNotes is a Edit'  to asCode[0]
            Move 'End_Object'               to asCode[1]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Object oNotes is a cTextEdit' asCode[0]
            Send AssertIAreEqual 2 (SizeOfArray(asCode))
        End_Procedure

        // A workspace's own target: which package holds it is unknown, so no Use is guessed.
        { Published = True }
        Procedure RefactorEditTocTextEdit_AClassOnAWorkspaceTargetGetsNoUse
            String[] asCode
            Integer iCount
            Move 'Class cMyEdit is a Edit'  to asCode[0]
            Move 'End_Class'                to asCode[1]
            Get RefactorEditTocTextEdit of ghoFuncLib (&asCode) "Edit,cMyTextEdit" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Class cMyEdit is a cMyTextEdit' asCode[0]
            Send AssertIAreEqual 2 (SizeOfArray(asCode))
        End_Procedure

    End_Object
