//****************************************************************************
// $Module type: Test fixture
// $Module name: oUnicodeBufferPairToString-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-29
//
// Description : Unit tests for the UnicodeBufferPairToString refactoring function (the public
//               wrapper on ghoFuncLib, which drives cUnicodePointerToString.ParseFilePairs).
//
//               It collapses the DF 19.1 two-line buffer-conversion idiom
//                   Move (OemToUtf8Buffer((AddressOf(sVar)),(Length(sVar)))) to aBuf
//                   Move aBuf to sVar
//               into the single DF 20+ line
//                   Move (OemToUtf8(sVar)) to sVar
//
//               The tests that matter most here are the ones that must NOT fire: this
//               function DELETES a line, so every guard gets a fixture proving it holds.
//               Each test feeds a small synthetic file, resets the lexer state first
//               (ClearFuncLibProperties, as the engine does per file), then checks both the
//               returned count AND the resulting array length - a collapse that fails to
//               remove the second line would otherwise pass on the count alone.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oUnicodeBufferPairToString is a cTestFixture
        Set psFunctionName to "UnicodeBufferPairToString"

        // The canonical pair, exactly as Nils reported it.
        {Published = True}
        Procedure UnicodeBufferPair_OemToUtf8_Collapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    String sEncoding"                                                         to asCode[1]
            Move "    UChar[] aEncoding"                                                        to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(sEncoding)),(Length(sEncoding)))) to aEncoding" to asCode[3]
            Move "    Move aEncoding to sEncoding"                                              to asCode[4]
            Move "End_Procedure"                                                                to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (OemToUtf8(sEncoding)) to sEncoding" asCode[3]
            // The second line is GONE, so the file is one line shorter and what
            // followed the pair has moved up.
            Send Assert ((SizeOfArray(asCode)) = 5)
            Send AssertSAreEqual "End_Procedure" asCode[4]
        End_Procedure

        // The other three CharTranslate pairs resolve through the same sibling map,
        // and SizeOfString is accepted alongside Length.
        {Published = True}
        Procedure UnicodeBufferPair_Utf8ToOem_SizeOfString_Collapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                    to asCode[0]
            Move "    String sTxt"                                                                  to asCode[1]
            Move "    UChar[] aBuf"                                                                 to asCode[2]
            Move "    Move (Utf8ToOemBuffer(AddressOf(sTxt),SizeOfString(sTxt))) to aBuf"           to asCode[3]
            Move "    Move aBuf to sTxt"                                                            to asCode[4]
            Move "End_Procedure"                                                                    to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (Utf8ToOem(sTxt)) to sTxt" asCode[3]
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // GUARD 1: the length is taken from a DIFFERENT variable, so the call is not
        // converting one string in place - leave it for a hand migration.
        {Published = True}
        Procedure UnicodeBufferPair_DifferentLengthVar_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    String sOne sTwo"                                                         to asCode[1]
            Move "    UChar[] aBuf"                                                             to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(sOne)),(Length(sTwo)))) to aBuf"         to asCode[3]
            Move "    Move aBuf to sOne"                                                        to asCode[4]
            Move "End_Procedure"                                                                to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // GUARD 2: the buffer is handed back to a DIFFERENT string, so the pair is not
        // an in-place conversion.
        {Published = True}
        Procedure UnicodeBufferPair_ReturnsToOtherVar_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    String sSrc sDst"                                                         to asCode[1]
            Move "    UChar[] aBuf"                                                             to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(sSrc)),(Length(sSrc)))) to aBuf"         to asCode[3]
            Move "    Move aBuf to sDst"                                                        to asCode[4]
            Move "End_Procedure"                                                                to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // GUARD 3 - THE ONE THAT PROTECTS AGAINST SILENT BREAKAGE. The buffer is read
        // again after the pair, so deleting the assignment would orphan that read.
        {Published = True}
        Procedure UnicodeBufferPair_BufferUsedLater_Untouched
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    String sEnc"                                                              to asCode[1]
            Move "    UChar[] aBuf"                                                             to asCode[2]
            Move "    Integer iLen"                                                             to asCode[3]
            Move "    Move (OemToUtf8Buffer((AddressOf(sEnc)),(Length(sEnc)))) to aBuf"         to asCode[4]
            Move "    Move aBuf to sEnc"                                                        to asCode[5]
            Move "    Move (SizeOfArray(aBuf)) to iLen"                                         to asCode[6]
            Move "End_Procedure"                                                                to asCode[7]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 8)
        End_Procedure

        // GUARD 4: the converted variable is not a declared String, so the types are
        // not known well enough to rewrite.
        {Published = True}
        Procedure UnicodeBufferPair_NonStringVar_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    UChar[] aRaw"                                                             to asCode[1]
            Move "    UChar[] aBuf"                                                             to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(aRaw)),(Length(aRaw)))) to aBuf"         to asCode[3]
            Move "    Move aBuf to aRaw"                                                        to asCode[4]
            Move "End_Procedure"                                                                to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // A trailing comment on either line is refused rather than deleted with it.
        {Published = True}
        Procedure UnicodeBufferPair_TrailingComment_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                        to asCode[0]
            Move "    String sEnc"                                                                      to asCode[1]
            Move "    UChar[] aBuf"                                                                     to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(sEnc)),(Length(sEnc)))) to aBuf"                 to asCode[3]
            Move "    Move aBuf to sEnc  // keep this note"                                             to asCode[4]
            Move "End_Procedure"                                                                        to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // The ONE-argument buffer call belongs to UnicodePointerToString; this function
        // must not touch it (nor delete the line after it).
        {Published = True}
        Procedure UnicodeBufferPair_SingleArgCall_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                            to asCode[0]
            Move "    String sEnc"                                          to asCode[1]
            Move "    Move (OemToUtf8Buffer(sEnc)) to sEnc"                 to asCode[2]
            Move "    Move sEnc to sEnc"                                    to asCode[3]
            Move "End_Procedure"                                            to asCode[4]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // An unrelated two-argument call must not be mistaken for a buffer conversion.
        {Published = True}
        Procedure UnicodeBufferPair_OtherFunction_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                            to asCode[0]
            Move "    String sEnc"                                                          to asCode[1]
            Move "    UChar[] aBuf"                                                         to asCode[2]
            Move "    Move (SomeOtherCall((AddressOf(sEnc)),(Length(sEnc)))) to aBuf"       to asCode[3]
            Move "    Move aBuf to sEnc"                                                    to asCode[4]
            Move "End_Procedure"                                                            to asCode[5]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // Two pairs in one file both collapse, and the rebuild keeps every other line
        // in order - the index-shifting trap of deleting inside the walk.
        {Published = True}
        Procedure UnicodeBufferPair_TwoPairs_BothCollapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                                                to asCode[0]
            Move "    String sA"                                                                to asCode[1]
            Move "    UChar[] aOne"                                                             to asCode[2]
            Move "    Move (OemToUtf8Buffer((AddressOf(sA)),(Length(sA)))) to aOne"             to asCode[3]
            Move "    Move aOne to sA"                                                          to asCode[4]
            Move "    Send DoSomething"                                                         to asCode[5]
            Move "End_Procedure"                                                                to asCode[6]
            Move "Procedure Bar"                                                                to asCode[7]
            Move "    String sB"                                                                to asCode[8]
            Move "    UChar[] aTwo"                                                             to asCode[9]
            Move "    Move (Utf8ToOemBuffer((AddressOf(sB)),(Length(sB)))) to aTwo"             to asCode[10]
            Move "    Move aTwo to sB"                                                          to asCode[11]
            Move "End_Procedure"                                                                to asCode[12]
            Get UnicodeBufferPairToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 2)
            Send AssertSAreEqual "    Move (OemToUtf8(sA)) to sA" asCode[3]
            Send AssertSAreEqual "    Send DoSomething"           asCode[4]
            Send AssertSAreEqual "End_Procedure"                  asCode[5]
            Send AssertSAreEqual "    Move (Utf8ToOem(sB)) to sB" asCode[9]
            Send Assert ((SizeOfArray(asCode)) = 11)
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
