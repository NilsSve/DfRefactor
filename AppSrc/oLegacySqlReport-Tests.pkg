//
// Description : Unit tests for the LegacySqlReport scan core (_LegacySqlScanFile, cRefactorFuncLib): a pure
//               whole-file classifier - no engine/file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oLegacySqlReport is a cTestFixture
        Set psFunctionName to "LegacySqlReport"

        // Each legacy Embedded-SQL command at command position reports the RIGHT class.method note
        // (which also proves the parallel watch/hint arrays stay index-aligned); a mention inside a
        // string and a modern cSQL* call are NOT flagged.
        {Published = True}
        Procedure LegacySqlReport_ScanFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    SQLConnect sDsn sUser sPass to hConn"    to asCode[0]
            Move "    SQLPrepare hStmt sSql"                   to asCode[1]
            Move "    SQLGetArguments hStmt"                   to asCode[2]
            Move '    Move "sqlconnect" to sLabel'             to asCode[3]
            Move "    Get SQLDone of hStmt to bOk"             to asCode[4]
            Move "    CLI_Get_Database_Attribute hConn x to y" to asCode[5]
            Get _LegacySqlScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 4 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "cSQLHandleManager.SQLConnect")   // SQLConnect
            Send Assert (sAll contains "cSQLStatement.SQLPrepare")       // SQLPrepare
            Send Assert (sAll contains "RENAMED to singular")            // SQLGetArguments rename note
            Send Assert (sAll contains "Get_Attribute")                  // CLI_Get_Database_Attribute
            // the masked-string line (4) and the modern cSQL* call (5) are NOT flagged
            Send Assert (not(sAll contains "Line 4:"))
            Send Assert (not(sAll contains "Line 5:"))
        End_Procedure

        // No legacy SQL commands -> nothing; a modern "Get <cSQL method> of <obj>" is not mistaken for
        // a legacy command.
        {Published = True}
        Procedure LegacySqlReport_NoHits
            String[] asCode asReport
            Integer iN
            Move "    Move 1 to iX"                          to asCode[0]
            Move "    Get SQLColumnValue of hStmt 1 to sVal" to asCode[1]
            Get _LegacySqlScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

    End_Object
