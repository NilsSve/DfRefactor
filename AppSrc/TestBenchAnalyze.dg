// TestBenchAnalyze.dg
//
// The Test Bench's Analyze (Nils 2026-10-20): scans the Legacy Code editor's file with the Deep Scan
// rules and builds the fix plan the way the main program's single-file Analyze Source does - the same
// scan (cDeepScanner.ScanFileCached + HitsToMessages), the same plan (cModAnalyzer.PlanFromMessages,
// companions included) and the same report-function filter as the plan run (TestCompileFT.dg). The
// findings are listed; "Select functions" makes the plan's functions the selection that Start
// Refactoring runs, and "Go to line" (or a double-click) shows a finding's line in the editor.
// Built like GotoDefinitionPicker.dg: a plain ModalPanel with a read-only cCJGrid.
//
// Not done here, unlike the main program: the workspace's own legacy subclasses are not learned (the
// scan knows only the built-in classes), and the scan cache is not used (one file, scanned afresh).
Use cRDCModalPanel.pkg
Use cCJGrid.pkg
Use cCJGridColumn.pkg 
Use cRDCCJGrid.pkg
Use cTextEdit.pkg
Use cDeepScanner.pkg
Use cModAnalyzer.pkg
Use cSysFileDataDictionary.dd
Use cFunctionsDataDictionary.dd

Object oTestBenchAnalyze is a cRDCModalPanel
    Set Size to 181 560
    Set Label to "Analyze"
    Set piMinSize to 150 360
    Set Location to 20 20
    Set peAnchors to anAll
    Set Icon to "analyze.ico"
    Set Border_Style to Border_Thick

    Property tDeepScanHit[] paHits
    // Each hit's category as the Analyzer names it, parallel to paHits.
    Property String[]       pasCategories
    // The functions "Select functions" selects: the plan's, without the report functions.
    Property String[]       pasFunctions
    // How the dialog was closed: 0 = Close, 1 = Select functions, 2 = Go to line (piGotoLine).
    Property Integer        piResult 0
    Property Integer        piGotoLine 0

    Object oHits_grd is a cRDCCJGrid
        Set Size to 149 544
        Set Location to 8 8
        Set peAnchors to anAll
        Set pbAllowEdit to False
        Set pbFocusSubItems to False
        Set pbAutoAppend to False
        Set pbAutoSave to False

        Object oLine_col is a cCJGridColumn
            Set piWidth to 45
            Set psCaption to "Line"
        End_Object

        Object oCategory_col is a cCJGridColumn
            Set piWidth to 70
            Set psCaption to "Category"
        End_Object

        Object oFound_col is a cCJGridColumn
            Set piWidth to 150
            Set psCaption to "Issue Found"
        End_Object

        Object oFunction_col is a cCJGridColumn
            Set piWidth to 190
            Set psCaption to "Refactoring Function"
        End_Object

        Object oHint_col is a cCJGridColumn
            Set piWidth to 450
            Set psCaption to "Hint"
        End_Object

        // The row's line number as a number, for Go to line - kept out of sight.
        Object oLineNo_col is a cCJGridColumn
            Set piWidth to 10
            Set pbVisible to False
            Set psCaption to "LineNo"
        End_Object

        Procedure LoadData
            tDataSourceRow[] TheData TheDataEmpty
            tDeepScanHit[] aHits
            String[] asCats
            Integer i iMax iLine iCat iFound iFn iHint iLineNo

            If (not(IsComObjectCreated(Self))) ;
                Procedure_Return
            Get paHits to aHits
            Get pasCategories to asCats
            Get piColumnId of oLine_col     to iLine
            Get piColumnId of oCategory_col to iCat
            Get piColumnId of oFound_col    to iFound
            Get piColumnId of oFunction_col to iFn
            Get piColumnId of oHint_col     to iHint
            Get piColumnId of oLineNo_col   to iLineNo
            Move (SizeOfArray(aHits) - 1) to iMax
            For i from 0 to iMax
                Move (String(aHits[i].iLine)) to TheData[i].sValue[iLine]
                Move ""                       to TheData[i].sValue[iCat]
                If (i < SizeOfArray(asCats)) ;
                    Move asCats[i]            to TheData[i].sValue[iCat]
                Move aHits[i].sSymbol         to TheData[i].sValue[iFound]
                Move aHits[i].sRefactorFn     to TheData[i].sValue[iFn]
                Move aHits[i].sHint           to TheData[i].sValue[iHint]
                Move (String(aHits[i].iLine)) to TheData[i].sValue[iLineNo]
            Loop
            If (iMax >= 0) Begin
                Send ReInitializeData TheData False
                Send MoveToFirstRow
            End
            Else ;
                Send InitializeData TheDataEmpty
        End_Procedure

        // Rows are loaded from both ends of the creation order - whichever comes second finds
        // the grid created and does the work; LoadData is a no-op until then.
        Procedure OnCreate
            Forward Send OnCreate
            Send LoadData
        End_Procedure

        Procedure GoToSelected
            String sLine
            Get SelectedRowValue of oLineNo_col to sLine
            If (sLine <> "") Begin
                Set piGotoLine to (Cast(sLine, Integer))
                Set piResult to 2
                Send Close_Panel
            End
        End_Procedure

        Procedure OnRowDoubleClick Integer iRow Integer iCol
            Forward Send OnRowDoubleClick iRow iCol
            Send GoToSelected
        End_Procedure

        On_Key kEnter Send GoToSelected
    End_Object

//    Object oPlan_tb is a TextBox
//        Set Size to 10 300
//        Set Location to 162 8
//        Set peAnchors to anBottomLeft
//        Set Label to "Functions to select:"
//    End_Object
//
//    Object oPlan_edt is a cTextEdit
//        Set Size to 38 544
//        Set Location to 182 8
//        Set peAnchors to anBottomLeftRight
//        Set Read_Only_State to True
//    End_Object

    Object oSelect_btn is a Button
        Set Size to 14 99
        Set Label to "&Select Refactor functions"
        Set Location to 164 343
        Set peAnchors to anBottomRight
        Set Default_State to True
        Set psToolTip to "This will Auto-select these refactoring functions."

        Procedure OnClick
            Set piResult to 1
            Send Close_Panel
        End_Procedure
    End_Object

    Object oGoto_btn is a Button
        Set Size to 14 50
        Set Label to "&Go to line"
        Set Location to 164 448
        Set peAnchors to anBottomRight
        Set psToolTip to "Shows the line of the selected finding in the Legacy Code editor (or double-click the row)."

        Procedure OnClick
            Send GoToSelected of oHits_grd
        End_Procedure
    End_Object

    Object oClose_btn is a Button
        Set Size to 14 50
        Set Label to "Close"
        Set Location to 164 502
        Set peAnchors to anBottomRight

        Procedure OnClick
            Send Close_Panel
        End_Procedure
    End_Object

    On_Key kCancel Send KeyAction of oClose_btn

    Procedure Activating
        String[] asFns
        String sList
        Integer i iMax

        Forward Send Activating
        Send LoadData of oHits_grd
        Get pasFunctions to asFns
        Move (SizeOfArray(asFns) - 1) to iMax
        For i from 0 to iMax
            If (sList <> "") ;
                Move (sList + ", ") to sList
            Move (sList + asFns[i]) to sList
        Loop
//        If (iMax < 0) Begin
//            Set Label of oPlan_tb to "Functions to select: none"
//            Move "None of the findings has a refactor function that runs here: they are to review or to fix by hand (see the Hint column)." to sList
//        End
//        Else ;
//            Set Label of oPlan_tb to ("Functions to select:" * String(iMax + 1))
//        Set Value of oPlan_edt to sList
        Set Enabled_State of oSelect_btn to (iMax >= 0)
    End_Procedure

    // The plan's functions become the selection (the functions selected now are unselected first),
    // and SysFile's selection counters are recounted through hoSysFileDD: the selection is written
    // record by record (cFunctionsDataDictionary.SelectRecordsFromStringArray), which leaves the
    // counters alone, and the view saves SysFile from its DD on every idle, so a direct SysFile write
    // would be overwritten. "Count Source Lines (only)" is cleared, or the run would only count lines.
    Procedure _SelectFunctions String[] asFns Handle hoSysFileDD
        Handle hoDD
        Integer iCount

        Get Create (RefClass(cFunctionsDataDictionary)) to hoDD
        Send UnSelectAllRecords of hoDD
        Send SelectRecordsFromStringArray of hoDD asFns
        Get TotalNoSelected of hoDD to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedFunctionTotal to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.bCountSourceLines to 0
        Get TotalNoSelectedPerType of hoDD eStandardFunction to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeStandardFunction to iCount
        Get TotalNoSelectedPerType of hoDD eRemoveFunction to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeRemoveFunction to iCount
        Get TotalNoSelectedPerType of hoDD eEditorFunction to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeEditorFunction to iCount
        Get TotalNoSelectedPerType of hoDD eReportFunction to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeReportFunction to iCount
        Get TotalNoSelectedPerType of hoDD eReportFunctionAll to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeReportAllFunction to iCount
        Get TotalNoSelectedPerType of hoDD eOtherFunction to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeOtherFunction to iCount
        Get TotalNoSelectedPerType of hoDD eOtherFunctionAll to iCount
        Set Field_Changed_Value of hoSysFileDD Field SysFile.SelectedeOtherAllFunction to iCount
        Send Destroy of hoDD
        Send Request_Save of hoSysFileDD
    End_Procedure

    // Analyzes sFile (the Legacy Code editor's file, as saved) and shows the findings. hoEditor is
    // that editor (Go to line); hoSysFileDD is the view's SysFile DD (Select functions).
    Procedure AnalyzeFile String sFile Handle hoEditor Handle hoSysFileDD
        Handle hoScanner hoAnalyzer hoDD
        tDeepScanRule[] aRules
        tDeepScanCache Cache
        tDeepScanHit[] aHits
        tCompileError[] aMsgs
        tModRefactorPlan Plan
        String[] asCats asFns
        Boolean bFromCache bIsReport
        Integer i iMax iLine iRetval

        Send Cursor_Wait of Cursor_Control
        // The scan: the saved rules (with the user's Enabled toggles), one file, no cache.
        Get Create (RefClass(cDeepScanner)) to hoScanner
        Get LoadDeepScanRules of hoScanner (DeepScanRulesJsonPath(hoScanner)) to aRules
        Get ScanFileCached of hoScanner sFile (&aRules) (&Cache) (&bFromCache) to aHits
        Move (SizeOfArray(aHits) - 1) to iMax
        For i from 0 to iMax
            Get DSCategoryText of hoScanner aHits[i].eCategory to asCats[i]
        Loop
        Get HitsToMessages of hoScanner aHits sFile to aMsgs
        Send Destroy of hoScanner
        If (iMax < 0) Begin
            Send Cursor_Ready of Cursor_Control
            Send Info_Box ("No findings in:\n" + sFile)
            Procedure_Return
        End

        // The plan: the main program's (source checks and companion functions included); with no
        // scope root, as the Test Compile plan does.
        Get Create (RefClass(cModAnalyzer)) to hoAnalyzer
        Get PlanFromMessages of hoAnalyzer aMsgs "" to Plan
        Send Destroy of hoAnalyzer

        // Report functions do not belong in a plan run (see TestCompileFT.dg): they change nothing.
        Get Create (RefClass(cFunctionsDataDictionary)) to hoDD
        Move (SizeOfArray(Plan.asFunctions) - 1) to iMax
        For i from 0 to iMax
            Get IsReportOnlyFunction of hoDD Plan.asFunctions[i] to bIsReport
            If (bIsReport = False) ;
                Move Plan.asFunctions[i] to asFns[SizeOfArray(asFns)]
        Loop
        Send Destroy of hoDD

        Set paHits        to aHits
        Set pasCategories to asCats
        Set pasFunctions  to asFns
        Set piResult      to 0
        Set Label to ("Analyze -" * String(SizeOfArray(aHits)) * "finding(s) in" * sFile)
        Send Cursor_Ready of Cursor_Control
        Send Popup

        If (piResult(Self) = 1) Begin
            Send _SelectFunctions asFns hoSysFileDD
            Get YesNo_Box (String(SizeOfArray(asFns)) * "function(s) selected. Start Refactoring now?") to iRetval
            If (iRetval = MBR_Yes) Begin
                Send StartRefactoreCode of ghoApplication
            End
        End
        Else If (piResult(Self) = 2) Begin
            // Scintilla counts lines from 0; a finding's line from 1.
            Get piGotoLine to iLine
            Send Activate of hoEditor
            Send EditorMessage of hoEditor SCI_GOTOLINE (iLine - 1)
        End
    End_Procedure

End_Object
