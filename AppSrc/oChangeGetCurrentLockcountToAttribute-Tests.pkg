//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeGetCurrentLockcountToAttribute-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-15
//
// Description : Unit tests for the ChangeGetCurrentLockcountToAttribute refactor function - the
//               obsolete Get_Current_Lockcount command to Get_Attribute DF_TRAN_COUNT.
//
//               The converting shapes are the spellings a real legacy workspace uses: the command
//               capitalised, the 'to' lowercase or capitalised, the target a descriptive name or a
//               single letter. The equivalence behind the conversion is measured, not assumed -
//               see the converter's header for the probe and its numbers.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeGetCurrentLockcountToAttribute is a cTestFixture
        Set psFunctionName to "ChangeGetCurrentLockcountToAttribute"

        // Helper: tokenize + convert one line, hand back the result and whether it changed.
        Function ConvertLine String ByRef sLine Returns Boolean
            Boolean bChanged
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetCurrentLockcountToAttribute of ghoFuncLib (&sLine) "" to bChanged
            Function_Return bChanged
        End_Function

        // The real-world spellings, each keeping its indentation, its 'to' casing and its target.
        { Published = True }
        Procedure GetCurrentLockcount_MeasuredShapesConvert
            String sLine
            Boolean bChanged

            Move "        Get_Current_Lockcount to iLockCount" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "        Get_Attribute DF_TRAN_COUNT to iLockCount" sLine

            Move "    Get_Current_Lockcount to x" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_TRAN_COUNT to x" sLine

            Move "    Get_Current_Lockcount To x" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_TRAN_COUNT To x" sLine

            Move "    get_current_lockcount to iLocks" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_TRAN_COUNT to iLocks" sLine
        End_Procedure

        // Bare, no indentation.
        { Published = True }
        Procedure GetCurrentLockcount_Bare
            String sLine
            Boolean bChanged
            Move "Get_Current_Lockcount to iCount" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "Get_Attribute DF_TRAN_COUNT to iCount" sLine
        End_Procedure

        // A trailing comment rides along untouched - including one that itself says 'to'.
        { Published = True }
        Procedure GetCurrentLockcount_TrailingCommentKept
            String sLine
            Boolean bChanged
            Move "    Get_Current_Lockcount to x   // 0 when nothing is held; used to guard the save" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_TRAN_COUNT to x   // 0 when nothing is held; used to guard the save" sLine
        End_Procedure

        // Idempotent: the converted line leads with Get_Attribute and is never matched again.
        { Published = True }
        Procedure GetCurrentLockcount_ConvertedLineIsLeftAlone
            String sLine
            Boolean bChanged
            Move "    Get_Attribute DF_TRAN_COUNT to x" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Attribute DF_TRAN_COUNT to x" sLine
        End_Procedure

        // A longer identifier that merely STARTS with the keyword is not the command (whole token).
        { Published = True }
        Procedure GetCurrentLockcount_PrefixIsNotTheCommand
            String sLine
            Boolean bChanged
            Move "    Get_Current_LockcountText to sX" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Current_LockcountText to sX" sLine
        End_Procedure

        // Not at command position: a Get of a method that happens to carry the name is left alone.
        { Published = True }
        Procedure GetCurrentLockcount_NonLeadingIsLeftAlone
            String sLine
            Boolean bChanged
            Move "    Get Get_Current_Lockcount of oLocks to iX" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get Get_Current_Lockcount of oLocks to iX" sLine
        End_Procedure

        // A comment line and a string mention are not the command.
        { Published = True }
        Procedure GetCurrentLockcount_CommentAndStringAreLeftAlone
            String sLine
            Boolean bChanged
            Move "    // Get_Current_Lockcount to x - the old way" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    // Get_Current_Lockcount to x - the old way" sLine

            Move '    Move "Get_Current_Lockcount to x" to sHelp' to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Move "Get_Current_Lockcount to x" to sHelp' sLine
        End_Procedure

        /* NO 'to' TAIL - not a shape the compiler accepts, so the converter declines rather than
           moving the error to a different line. The 'to' is looked for on the MASKED line, so one
           inside a trailing comment does not count (the POSITIVE control for that guard is the
           trailing-comment test above, which converts because the real 'to' is there too). */
        { Published = True }
        Procedure GetCurrentLockcount_NoTargetIsDeclined
            String sLine
            Boolean bChanged
            Move "    Get_Current_Lockcount" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Current_Lockcount" sLine

            Move "    Get_Current_Lockcount   // used to read the depth" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Current_Lockcount   // used to read the depth" sLine
        End_Procedure

    End_Object
