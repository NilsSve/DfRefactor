//****************************************************************************
// $Module type: Test fixture
// $Module name: oAddFunctionReturnsKeyword-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the AddFunctionReturnsKeyword refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oAddFunctionReturnsKeyword is a cTestFixture
        Set psFunctionName to "AddFunctionReturnsKeyword"

        // The real error-wall shape: a bare no-arg declaration whose body returns integer status
        // codes - error 4392 on a modern compiler. Inference reads the literals -> Returns Integer.
        { Published = True }
        Procedure AddFunctionReturns_IntegerCodeBody
            String[] asCode
            Integer iCount

            Move 'Function Insert_Period'      to asCode[0]
            Move '    Integer iVal'            to asCode[1]
            Move '    If (iVal < 1) Begin'     to asCode[2]
            Move '        Function_Return 1'   to asCode[3]
            Move '    End'                     to asCode[4]
            Move '    Function_Return 0'       to asCode[5]
            Move 'End_Function'                to asCode[6]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function Insert_Period Returns Integer' asCode[0]
            Send AssertSAreEqual '        Function_Return 1'              asCode[3]
        End_Procedure

        // A returned bare name resolves against the body's OWN local declarations
        // (the Verify_Exit_Application shape: 'Integer ReturnValue' + 'Function_Return ReturnValue').
        { Published = True }
        Procedure AddFunctionReturns_LocalVariableResolved
            String[] asCode
            Integer iCount
            Move 'Function Verify_Exit_Application'  to asCode[0]
            Move '    Integer ReturnValue'           to asCode[1]
            Move '    Move 0 to ReturnValue'         to asCode[2]
            Move '    Function_Return ReturnValue'   to asCode[3]
            Move 'End_Function'                      to asCode[4]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function Verify_Exit_Application Returns Integer' asCode[0]
        End_Procedure

        // A string-literal return -> Returns String (the literal is masked by the code-only view,
        // but its quote survives to classify).
        { Published = True }
        Procedure AddFunctionReturns_StringLiteral
            String[] asCode
            Integer iCount
            Move 'Function DefaultCode'          to asCode[0]
            Move "    Function_Return 'ABC'"     to asCode[1]
            Move 'End_Function'                  to asCode[2]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function DefaultCode Returns String' asCode[0]
        End_Procedure

        // Mixed integer + string returns merge to the safe catch-all: String.
        { Published = True }
        Procedure AddFunctionReturns_MixedIntegerStringIsString
            String[] asCode
            Integer iCount
            Move 'Function GetCode'              to asCode[0]
            Move '    Integer iMode'             to asCode[1]
            Move '    If (iMode = 1) Begin'      to asCode[2]
            Move '        Function_Return 7'     to asCode[3]
            Move '    End'                       to asCode[4]
            Move "    Function_Return 'X'"       to asCode[5]
            Move 'End_Function'                  to asCode[6]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function GetCode Returns String' asCode[0]
        End_Procedure

        // Integer widens to Number when a decimal literal shows up.
        { Published = True }
        Procedure AddFunctionReturns_IntegerPlusDecimalIsNumber
            String[] asCode
            Integer iCount
            Move 'Function GetFactor'          to asCode[0]
            Move '    Function_Return 1'       to asCode[1]
            Move '    Function_Return 2.5'     to asCode[2]
            Move 'End_Function'                to asCode[3]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function GetFactor Returns Number' asCode[0]
        End_Procedure

        // True/False literal returns -> Returns Boolean.
        { Published = True }
        Procedure AddFunctionReturns_BooleanLiterals
            String[] asCode
            Integer iCount
            Move 'Function IsReady'            to asCode[0]
            Move '    Function_Return False'   to asCode[1]
            Move '    Function_Return True'    to asCode[2]
            Move 'End_Function'                to asCode[3]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function IsReady Returns Boolean' asCode[0]
        End_Procedure

        // A ';'-continued declaration whose CONTINUATION line already carries Returns is left
        // alone - the check must see the whole logical line, not just the first physical one.
        { Published = True }
        Procedure AddFunctionReturns_ContinuationAlreadyHasReturnsUntouched
            String[] asCode
            Integer iCount
            Move 'Function IsRetroActive Integer iEmpNo String sCode ;' to asCode[0]
            Move '    Date dFrom Date dTo Returns Integer'              to asCode[1]
            Move '    Function_Return 1'                                to asCode[2]
            Move 'End_Function'                                         to asCode[3]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Function IsRetroActive Integer iEmpNo String sCode ;' asCode[0]
            Send AssertSAreEqual '    Date dFrom Date dTo Returns Integer'              asCode[1]
        End_Procedure

        // A ';'-continued declaration MISSING Returns gets the clause on the LAST physical line.
        { Published = True }
        Procedure AddFunctionReturns_ContinuationMissingReturnsAppendsOnLastLine
            String[] asCode
            Integer iCount
            Move 'Function CalcTotal Integer iA ;' to asCode[0]
            Move '    Integer iB'                  to asCode[1]
            Move '    Function_Return 3'           to asCode[2]
            Move 'End_Function'                    to asCode[3]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function CalcTotal Integer iA ;'  asCode[0]
            Send AssertSAreEqual '    Integer iB Returns Integer'   asCode[1]
        End_Procedure

        // A modern declaration is not this function's business.
        { Published = True }
        Procedure AddFunctionReturns_AlreadyHasReturnsUntouched
            String[] asCode
            Integer iCount
            Move 'Function Modern String sIn Returns String' to asCode[0]
            Move '    Function_Return sIn'                   to asCode[1]
            Move 'End_Function'                              to asCode[2]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Function Modern String sIn Returns String' asCode[0]
        End_Procedure

        // A body that gives nothing to read (an expression return) defaults to Integer and is
        // flagged for review - any Returns type compiles where the bare declaration hard-fails.
        { Published = True }
        Procedure AddFunctionReturns_NothingToInferDefaultsIntegerWithTodo
            String[] asCode
            Integer iCount
            Move 'Function GetItem'                     to asCode[0]
            Move '    Function_Return (NextItem(Self))' to asCode[1]
            Move 'End_Function'                         to asCode[2]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function GetItem Returns Integer   // TODO (DFRefactor): return type could not be inferred - verify.' asCode[0]
        End_Procedure

        // A trailing comment on the declaration line survives, with the clause spliced in front.
        { Published = True }
        Procedure AddFunctionReturns_TrailingCommentPreserved
            String[] asCode
            Integer iCount
            Move 'Function GetStatus // legacy status code' to asCode[0]
            Move '    Function_Return 2'                    to asCode[1]
            Move 'End_Function'                             to asCode[2]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Function GetStatus Returns Integer   // legacy status code' asCode[0]
        End_Procedure

        // A commented-out declaration is never touched.
        { Published = True }
        Procedure AddFunctionReturns_CommentedOutDeclUntouched
            String[] asCode
            Integer iCount
            Move '// Function OldOne'          to asCode[0]
            Move '//     Function_Return 1'    to asCode[1]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '// Function OldOne' asCode[0]
        End_Procedure

        // Two functions in one file are inferred INDEPENDENTLY (the locals map and the merged
        // type reset per declaration).
        { Published = True }
        Procedure AddFunctionReturns_TwoFunctionsInferredIndependently
            String[] asCode
            Integer iCount
            Move 'Function GetName'         to asCode[0]
            Move "    Function_Return 'A'"  to asCode[1]
            Move 'End_Function'             to asCode[2]
            Move 'Function GetCount'        to asCode[3]
            Move '    Function_Return 5'    to asCode[4]
            Move 'End_Function'             to asCode[5]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual 'Function GetName Returns String'   asCode[0]
            Send AssertSAreEqual 'Function GetCount Returns Integer' asCode[3]
        End_Procedure

        // An indented declaration inside an Object body converts too (4392 hits them all the
        // same) - and the indent survives.
        { Published = True }
        Procedure AddFunctionReturns_ObjectBodyIndentPreserved
            String[] asCode
            Integer iCount
            Move 'Object oMain is a Panel'               to asCode[0]
            Move '    Function Verify_Exit_Application'  to asCode[1]
            Move '        Integer ReturnValue'           to asCode[2]
            Move '        Function_Return ReturnValue'   to asCode[3]
            Move '    End_Function'                      to asCode[4]
            Move 'End_Object'                            to asCode[5]
            Get AddFunctionReturnsKeyword of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Function Verify_Exit_Application Returns Integer' asCode[1]
        End_Procedure

    End_Object
