//****************************************************************************
// $Module type: Test fixture
// $Module name: oCIScan-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-11-20
//
// Description : Unit tests for cCIScan - the CI check's fingerprints, its baseline, and the JSON
//               and SARIF it writes (DFRefactorFT /scan <ini>).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCIScan_Tests is a cTestFixture
        Set psFunctionName to "CIScan"

        // Helper: the scratch folder, with its separator.
        Function ScratchFolder Returns String
            Function_Return (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_CIScan" + CS_DirSeparator)
        End_Function

        // Helper: one finding as Analyze Source's message would make it, numbered later.
        Function Finding String sRule String sFile String sText String sCategory Returns tCIScanFinding
            tCIScanFinding F
            Move sRule     to F.sRule
            Move sFile     to F.sFile
            Move sText     to F.sText
            Move sCategory to F.sCategory
            Move "Get_date_format command" to F.sSymbol
            Move "Use Get_Attribute DF_DATE_FORMAT." to F.sHint
            Move 7 to F.iLine
            Function_Return F
        End_Function

        // THE LINE THE FINGERPRINT HOLDS: tabs, runs of spaces, the case and a carriage return do not count.
        { Published = True }
        Procedure CIScan_NormalisedLine
            Handle ho
            String s
            Get Create (RefClass(cCIScan)) to ho
            Get NormalisedLine of ho ((Character(9)) + "Get_Date_Format   To  sDate " + (Character(13))) to s
            Send AssertSAreEqual "get_date_format to sdate" s
            Send Destroy of ho
        End_Procedure

        /* THE FILE, RELATIVE TO THE WORKSPACE: the same on every machine that checks it out. Under the home folder
           (any case, with or without its last backslash) the rest of the path; on the same drive "../"; on another
           drive the full path - always with "/". */
        { Published = True }
        Procedure CIScan_RelativePath
            Handle ho
            String s
            Get Create (RefClass(cCIScan)) to ho
            Get RelativePath of ho "E:\LegacyApp10\AppSrc\Order.vw" "e:\LegacyApp10\" to s
            Send AssertSAreEqual "AppSrc/Order.vw" s
            Get RelativePath of ho "E:\LegacyApp10\AppSrc\Order.vw" "E:\LegacyApp10" to s
            Send AssertSAreEqual "AppSrc/Order.vw" s
            Get RelativePath of ho "E:\Libs\RDC\cGrid.pkg" "E:\LegacyApp10\" to s
            Send AssertSAreEqual "../Libs/RDC/cGrid.pkg" s
            Get RelativePath of ho "D:\Other\X.pkg" "E:\LegacyApp10\" to s
            Send AssertSAreEqual "D:/Other/X.pkg" s
            Send Destroy of ho
        End_Procedure

        /* THE FINGERPRINT: the rule, file, text and occurrence - computed outside DataFlex for these values, so the
           BigInt arithmetic is checked too - and never the line number. */
        { Published = True }
        Procedure CIScan_Fingerprint
            Handle ho
            String s1 s2 s3
            Get Create (RefClass(cCIScan)) to ho
            Get Fingerprint of ho "DS9086" "AppSrc/Order.vw" "get_date_format to sdate" 1 to s1
            Send AssertSAreEqual "2fa3ecc816b6532a" s1
            Get Fingerprint of ho "DS9086" "AppSrc/Order.vw" "get_date_format to sdate" 2 to s2
            Send AssertSAreEqual "2fa3ecc916b6532b" s2
            Get Fingerprint of ho "DS9087" "AppSrc/Order.vw" "get_date_format to sdate" 1 to s3
            Send Assert (s3 <> s1) "another rule, another fingerprint"
            Send Destroy of ho
        End_Procedure

        /* THE SAME TEXT TWICE IN A FILE: the two are told apart by their order, 1 and 2, and the count starts again
           in the next file - so the second file's first one has the first file's first fingerprint's numbering. */
        { Published = True }
        Procedure CIScan_NumberedFindings
            Handle ho
            tCIScanFinding[] aF
            Get Create (RefClass(cCIScan)) to ho
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "get_date_format to sdate", "Auto-fix")) to aF[0]
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "get_date_format to sdate", "Auto-fix")) to aF[1]
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "get_date_format to sother", "Auto-fix")) to aF[2]
            Move (Finding(Self, "DS9086", "AppSrc/B.vw", "get_date_format to sdate", "Auto-fix")) to aF[3]
            Get NumberedFindings of ho aF to aF
            Send AssertIAreEqual 1 aF[0].iOccurrence
            Send AssertIAreEqual 2 aF[1].iOccurrence
            Send AssertIAreEqual 1 aF[2].iOccurrence
            Send AssertIAreEqual 1 aF[3].iOccurrence
            Send Assert (aF[0].sFingerprint <> aF[1].sFingerprint) "the two occurrences differ"
            Send Assert (aF[0].sFingerprint <> aF[3].sFingerprint) "another file, another fingerprint"
            Send AssertIAreEqual 16 (Length(aF[0].sFingerprint))
            Send Destroy of ho
        End_Procedure

        /* AGAINST THE BASELINE: a finding it holds is not new, one it does not is, and what it holds that is no
           longer found is counted as gone. */
        { Published = True }
        Procedure CIScan_MarkNewFindings
            Handle ho
            tCIScanFinding[] aF
            String[] asBase
            Integer iNew iGone
            Get Create (RefClass(cCIScan)) to ho
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "line a", "Auto-fix")) to aF[0]
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "line c", "Auto-fix")) to aF[1]
            Get NumberedFindings of ho aF to aF
            Move aF[0].sFingerprint to asBase[0]
            Move "0000000000000000" to asBase[1]
            Get MarkNewFindings of ho (&aF) asBase (&iGone) to iNew
            Send AssertIAreEqual 1 iNew
            Send AssertIAreEqual 1 iGone
            Send Assert (aF[0].bNew = False) "the baseline holds the first"
            Send Assert (aF[1].bNew = True) "the second is new"
            Send Destroy of ho
        End_Procedure

        /* THE SARIF: one rule per DS number found, a result per finding with its file relative to SRCROOT, its
           level (Explain is a note), its fingerprint and its baseline state; SARIF's own key names in the JSON. */
        { Published = True }
        Procedure CIScan_Sarif
            Handle ho hoJson
            tCIScanFinding[] aF
            tSarifLog Log
            String sJson
            Get Create (RefClass(cCIScan)) to ho
            Move (Finding(Self, "DS9086", "AppSrc/My Order.vw", "line a", "Auto-fix")) to aF[0]
            Move (Finding(Self, "DS9086", "AppSrc/A.vw", "line b", "Auto-fix")) to aF[1]
            Move (Finding(Self, "DS9201", "AppSrc/A.vw", "line c", "Explain")) to aF[2]
            Get NumberedFindings of ho aF to aF
            Move True to aF[2].bNew
            Get SarifFor of ho (&aF) "E:\My Ws\" to Log
            Send AssertSAreEqual "2.1.0" Log.version
            Send AssertIAreEqual 2 (SizeOfArray(Log.runs[0].tool.driver.rules))
            Send AssertIAreEqual 3 (SizeOfArray(Log.runs[0].results))
            Send AssertSAreEqual "file:///E:/My%20Ws/" Log.runs[0].originalUriBaseIds.SRCROOT.uri
            Send AssertSAreEqual "AppSrc/My%20Order.vw" Log.runs[0].results[0].locations[0].physicalLocation.artifactLocation.uri
            Send AssertSAreEqual "SRCROOT" Log.runs[0].results[0].locations[0].physicalLocation.artifactLocation.uriBaseId
            Send AssertIAreEqual 7 Log.runs[0].results[0].locations[0].physicalLocation.region.startLine
            Send AssertSAreEqual "warning" Log.runs[0].results[0].level
            Send AssertSAreEqual "note" Log.runs[0].results[2].level
            Send AssertSAreEqual "unchanged" Log.runs[0].results[0].baselineState
            Send AssertSAreEqual "new" Log.runs[0].results[2].baselineState
            Send AssertSAreEqual aF[0].sFingerprint Log.runs[0].results[0].partialFingerprints.dfrefactorHitV1
            Get Create (RefClass(cJsonObject)) to hoJson
            Send DataTypeToJson of hoJson Log
            Get Stringify of hoJson to sJson
            Send Destroy of hoJson
            Send Assert (Pos('"partialFingerprints":', sJson) > 0) "SARIF's key, in its case"
            Send Assert (Pos('"artifactLocation":', sJson) > 0) "SARIF's key, in its case"
            Send Assert (Pos('"startLine":', sJson) > 0) "SARIF's key, in its case"
            Send Destroy of ho
        End_Procedure

        /* ON A REAL DISK: Analyze Source's messages become findings with their lines read from the file, a baseline
           written from them reads back as their fingerprints, a missing baseline is "not found", and a file that is
           no baseline says why rather than passing for an empty one. */
        { Published = True }
        Procedure CIScan_FindingsAndBaselineOnDisk
            Handle ho
            tCompileError[] aMsgs
            tCIScanFinding[] aF
            tCIScanBaseline Baseline
            String[] asLines asFps
            String sFolder sFile sBase sWhy sCreated
            Boolean bOk bFound

            Move (ScratchFolder(Self)) to sFolder
            Move (rfRemoveFolderTree(sFolder)) to bOk
            Move (rfDirectoryCreateEx(sFolder, False)) to bOk
            Move (sFolder + "Order.vw") to sFile
            Move "Procedure Go" to asLines[0]
            Move ("    Get_Date_Format  To sDate" + (Character(9))) to asLines[1]
            Move "End_Procedure" to asLines[2]
            Get rfWriteEncodedFileFromStringArray (&asLines) sFile C_NewLine False to bOk
            Send Assert bOk ("could not write " + sFile)
            Move True     to aMsgs[0].bDeepScan
            Move 9086     to aMsgs[0].iErrorNo
            Move 2        to aMsgs[0].iLine
            Move sFile    to aMsgs[0].sFileName
            Move "Get_date_format command" to aMsgs[0].sErrorTxt
            Move eModAutoFix to aMsgs[0].eScanCategory
            Move "ChangeGetDateFormatToAttribute" to aMsgs[0].sScanFn
            Move False    to aMsgs[1].bDeepScan          // a compiler message: not a finding
            Move 4328     to aMsgs[1].iErrorNo
            Move sFile    to aMsgs[1].sFileName

            Get Create (RefClass(cCIScan)) to ho
            Get FindingsFromMessages of ho (&aMsgs) sFolder to aF
            Send AssertIAreEqual 1 (SizeOfArray(aF))
            Send AssertSAreEqual "DS9086" aF[0].sRule
            Send AssertSAreEqual "Order.vw" aF[0].sFile
            Send AssertSAreEqual "get_date_format to sdate" aF[0].sText
            Send AssertSAreEqual "Auto-fix" aF[0].sCategory

            Move (sFolder + "Ws.baseline.json") to sBase
            Get BaselineFingerprints of ho sBase (&bFound) (&sCreated) (&sWhy) to asFps
            Send Assert (bFound = False) "no file, no baseline"
            Send AssertSAreEqual "" sWhy
            Get BaselineFor of ho (&aF) "E:\Ws\Ws.sws" "2026-11-20 10:00" to Baseline
            Get WriteBaseline of ho Baseline sBase to bOk
            Send Assert bOk "the baseline was written"
            Get BaselineFingerprints of ho sBase (&bFound) (&sCreated) (&sWhy) to asFps
            Send Assert bFound "the baseline is there"
            Send AssertSAreEqual "" sWhy
            Send AssertIAreEqual 1 (SizeOfArray(asFps))
            Send AssertSAreEqual aF[0].sFingerprint asFps[0]
            Send AssertSAreEqual "2026-11-20 10:00" sCreated

            Get rfWriteEncodedFileFromStringArray (&asLines) sBase C_NewLine False to bOk
            Get BaselineFingerprints of ho sBase (&bFound) (&sCreated) (&sWhy) to asFps
            Send Assert (sWhy <> "") "a file that is no baseline says so"
            Send Destroy of ho
            Move (rfRemoveFolderTree(sFolder)) to bOk
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

    End_Object
