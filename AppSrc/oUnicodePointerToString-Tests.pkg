    // Unit tests for the UnicodePointerToString refactoring function (the public
    // wrapper on ghoFuncLib, which drives the cUnicodePointerToString class).
    // It wraps a bare  Move <Pointer/Address local> to <String local>  with
    // PointerToString(), and renames the DF 19.1 buffer idiom
    //   Move (<XxxBuffer>(<String>)) to <String>
    // to the String-returning CharTranslate sibling (Utf8ToOem & co) - and ONLY
    // those, leaving every other Move untouched.
    //
    // Each test feeds a small synthetic source file as a String array, resets the
    // lexer state first (ClearFuncLibProperties, as the engine does per file), then
    // checks the returned rewrite count and the affected line.
    Object oUnicodePointerToString is a cTestFixture
        Set psFunctionName to "UnicodePointerToString"

        // A declared Address source + String dest -> wrapped.
        {Published = True}
        Procedure UnicodePointerToString_Address_Wrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sStr"             to asCode[1]
            Move "    Address aPtr"            to asCode[2]
            Move "    Move aPtr to sStr"       to asCode[3]
            Move "    Function_Return sStr"    to asCode[4]
            Move "End_Function"                to asCode[5]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(aPtr)) to sStr" asCode[3]
        End_Procedure

        // A declared Pointer source also qualifies (same 4539).
        {Published = True}
        Procedure UnicodePointerToString_Pointer_Wrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sData"            to asCode[1]
            Move "    Pointer pData"           to asCode[2]
            Move "    Move pData to sData"     to asCode[3]
            Move "End_Function"                to asCode[4]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(pData)) to sData" asCode[3]
        End_Procedure

        // REGRESSION: an early Function_Return BEFORE the Move must NOT wipe the
        // per-method type map (the bug the class first shipped with - _IsFunction-
        // Declaration matched "Function_Return", resetting the pointer/string sets).
        {Published = True}
        Procedure UnicodePointerToString_FunctionReturnBeforeMove_Wrapped
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Bar Global Integer iIn Returns String" to asCode[0]
            Move "    String sResult"          to asCode[1]
            Move "    Address aResult"         to asCode[2]
            Move "    If (iIn = 0) Begin"      to asCode[3]
            Move "        Function_Return sResult" to asCode[4]
            Move "    End"                     to asCode[5]
            Move "    Move aResult to sResult" to asCode[6]
            Move "    Function_Return sResult" to asCode[7]
            Move "End_Function"                to asCode[8]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(aResult)) to sResult" asCode[6]
        End_Procedure

        // Integer -> Integer is untouched (count 0, line unchanged).
        {Published = True}
        Procedure UnicodePointerToString_IntegerMove_NotWrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns Integer" to asCode[0]
            Move "    Integer iA iB"           to asCode[1]
            Move "    Move iA to iB"           to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move iA to iB" asCode[2]
        End_Procedure

        // String -> Address (the reverse direction) is OUT OF SCOPE - untouched.
        {Published = True}
        Procedure UnicodePointerToString_StringToAddress_NotWrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns Integer" to asCode[0]
            Move "    String sX"               to asCode[1]
            Move "    Address aY"              to asCode[2]
            Move "    Move sX to aY"           to asCode[3]
            Move "End_Function"                to asCode[4]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move sX to aY" asCode[3]
        End_Procedure

        // Per-method scope: a Pointer/Address declared in one method must not
        // license a Move in another method (guards the per-method scope reset).
        {Published = True}
        Procedure UnicodePointerToString_ScopeIsolation_NotWrapped
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function A Global Returns Integer" to asCode[0]
            Move "    Address aPtr"            to asCode[1]
            Move "End_Function"                to asCode[2]
            Move "Function B Global Returns String" to asCode[3]
            Move "    String sStr"             to asCode[4]
            Move "    Move aPtr to sStr"       to asCode[5]
            Move "End_Function"                to asCode[6]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move aPtr to sStr" asCode[5]
        End_Procedure

        // REGRESSION: a preceding Function closed with End_Procedure leaves the
        // lexer stuck in-method. The OLD transition-based detection would then NOT
        // reset at the next method, leaking the previous method's Pointer/String
        // locals in and wrongly wrapping a Move that references them. Signature-line
        // detection resets at the new method regardless, so the leak can't happen.
        {Published = True}
        Procedure UnicodePointerToString_StuckLexerNoLeak_NotWrapped
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function PrecedingFn Returns Integer" to asCode[0]
            Move "    String sLeak"            to asCode[1]
            Move "    Address aLeak"           to asCode[2]
            Move "    Function_Return 0"       to asCode[3]
            Move "End_Procedure"               to asCode[4]
            Move "Function Foo Global Returns String" to asCode[5]
            Move "    Move aLeak to sLeak"     to asCode[6]
            Move "End_Function"                to asCode[7]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move aLeak to sLeak" asCode[6]
        End_Procedure

        // NEW (back-port): a Pointer/Address PARAMETER moved into a String is now
        // wrapped too - CollectParameters gathers signature params, not only body-
        // declared locals. Also exercises the stop-at-"Returns" boundary.
        {Published = True}
        Procedure UnicodePointerToString_PointerParam_Wrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Pointer pData Returns String" to asCode[0]
            Move "    String sResult"          to asCode[1]
            Move "    Move pData to sResult"   to asCode[2]
            Move "    Function_Return sResult" to asCode[3]
            Move "End_Function"                to asCode[4]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(pData)) to sResult" asCode[2]
        End_Procedure

        // NEW (back-port): an Address parameter passed ByRef qualifies too -
        // CollectParameters skips the ByRef/ByVal token to reach the name.
        {Published = True}
        Procedure UnicodePointerToString_AddressByRefParam_Wrapped
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo Address ByRef aData" to asCode[0]
            Move "    String sResult"          to asCode[1]
            Move "    Move aData to sResult"   to asCode[2]
            Move "End_Procedure"               to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(aData)) to sResult" asCode[2]
        End_Procedure

        // REGRESSION: an Object declared INSIDE the method body (legal, common in
        // legacy code - e.g. a crypto helper object created mid-function) must not
        // end the METHOD scope at its End_Object. The lexer used to blanket-clear
        // every scope flag there (_ClearRefactoringProperties), so a Move AFTER the
        // embedded object was classified outside-method and never wrapped
        // (found in the wild via an MD5/Base64 hash helper, 2026-07-05).
        {Published = True}
        Procedure UnicodePointerToString_EmbeddedObject_MoveAfterEndObject_Wrapped
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function StringToHash String sData Returns String" to asCode[0]
            Move "    Address pEncoded"        to asCode[1]
            Move "    String sHash"            to asCode[2]
            Move "    Object oHasher is a cObject" to asCode[3]
            Move "    End_Object"              to asCode[4]
            Move "    Move (Encode64(AddressOf(sHash), Length(sHash))) to pEncoded" to asCode[5]
            Move "    Move pEncoded to sHash"  to asCode[6]
            Move "    Function_Return sHash"   to asCode[7]
            Move "End_Function"                to asCode[8]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (PointerToString(pEncoded)) to sHash" asCode[6]
        End_Procedure

        // ---- The 4539 buffer-call extension (2026-07-23, LegacyApp mining) ----
        // "Move (Utf8ToOemBuffer(sLine)) to sLine" hides the pointer INSIDE the
        // source expression; the fix is the String-returning CharTranslate
        // sibling, not a PointerToString() wrap.

        // The library shape found in the wild: a local String converted in
        // place through the DF 19.1 runtime buffer idiom.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallSameVar_Renamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sLine"            to asCode[1]
            Move "    Move (Utf8ToOemBuffer(sLine)) to sLine" to asCode[2]
            Move "    Function_Return sLine"   to asCode[3]
            Move "End_Function"                to asCode[4]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (Utf8ToOem(sLine)) to sLine" asCode[2]
        End_Procedure

        // The String is a method PARAMETER (collected by CollectParameters),
        // single-letter name and all - the EncodeURL shape found in the wild.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallParameter_Renamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function EncodeURL Global String s String sEncoding Returns String" to asCode[0]
            Move "    Move (Utf8ToOemBuffer(s)) to s" to asCode[1]
            Move "    Function_Return s"       to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (Utf8ToOem(s)) to s" asCode[1]
        End_Procedure

        // Another sibling pair, distinct source and destination variables.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallOtherPair_Renamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sIn sOut"         to asCode[1]
            Move "    Move (OemToUtf8Buffer(sIn)) to sOut" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (OemToUtf8(sIn)) to sOut" asCode[2]
        End_Procedure

        // A space between the call name and its "(" is legal DataFlex and real
        // code writes it; only the NAME is renamed, the spacing survives.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallSpacedParen_Renamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sLine"            to asCode[1]
            Move "    Move (Utf8ToOemBuffer (sLine)) to sLine" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Move (Utf8ToOem (sLine)) to sLine" asCode[2]
        End_Procedure

        // A Pointer/Address ARGUMENT means the buffer API was used at the
        // pointer level - renaming to the String sibling would change the call
        // semantics. Untouched.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallPointerArg_NotRenamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    Address aBuf"            to asCode[1]
            Move "    String sOut"             to asCode[2]
            Move "    Move (Utf8ToOemBuffer(aBuf)) to sOut" to asCode[3]
            Move "End_Function"                to asCode[4]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move (Utf8ToOemBuffer(aBuf)) to sOut" asCode[3]
        End_Procedure

        // The two-argument AddressOf + length form is the pointer-level API
        // used deliberately - left for a hand migration even with a String
        // destination.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallTwoArgs_NotRenamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sIn sOut"         to asCode[1]
            Move "    Move (Utf8ToOemBuffer(AddressOf(sIn), CStringLength(sIn))) to sOut" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move (Utf8ToOemBuffer(AddressOf(sIn), CStringLength(sIn))) to sOut" asCode[2]
        End_Procedure

        // Already converted: the String sibling is not a buffer function, so a
        // second run leaves the line alone (idempotence).
        {Published = True}
        Procedure UnicodePointerToString_BufferCallAlreadyConverted_NotRenamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sLine"            to asCode[1]
            Move "    Move (Utf8ToOem(sLine)) to sLine" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move (Utf8ToOem(sLine)) to sLine" asCode[2]
        End_Procedure

        // An unknown single-argument call in the same Move shape is not ours
        // to touch, whatever its operand types.
        {Published = True}
        Procedure UnicodePointerToString_BufferCallUnknownFn_NotRenamed
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Function Foo Global Returns String" to asCode[0]
            Move "    String sIn sOut"         to asCode[1]
            Move "    Move (MyConvertBuffer(sIn)) to sOut" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get UnicodePointerToString of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move (MyConvertBuffer(sIn)) to sOut" asCode[2]
        End_Procedure

    End_Object
