//****************************************************************************
// $Module type: Test fixture
// $Module name: oGosubGotoReport-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the GosubGotoReport analysis cores (cRefactorFuncLib): the
//               _GosubLineLabel / _GosubCallTargets / _GosubReturnKind / _GotoTarget line parsers and
//               the whole-file _GosubAuditFile classifier. All pure functions - no engine/file state.
//               Identifiers are GENERIC by design (never customer source).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oGosubGotoReport is a cTestFixture
        Set psFunctionName to "GosubGotoReport"

        {Published = True}
        Procedure GosubGotoReport_LineLabel
            String sName

            Get _GosubLineLabel of ghoFuncLib "calc_total:" to sName
            Send Assert (sName = "calc_total")
            // a label may carry trailing code/comment on the same line
            Get _GosubLineLabel of ghoFuncLib "calc_done: Move 1 to iX" to sName
            Send Assert (sName = "calc_done")
            // a gosub CALL is not a label definition
            Get _GosubLineLabel of ghoFuncLib "gosub calc_total" to sName
            Send Assert (sName = "")
            // a label must be a plain identifier
            Get _GosubLineLabel of ghoFuncLib "12bad:" to sName
            Send Assert (sName = "")
        End_Procedure

        {Published = True}
        Procedure GosubGotoReport_CallTargets
            String[] asT
            Boolean bOn
            Integer iN

            Get _GosubCallTargets of ghoFuncLib "gosub calc_total" (&asT) (&bOn) to iN
            Send AssertIAreEqual 1 iN
            Send Assert (asT[0] = "calc_total")
            Send AssertFalse bOn
            // inline after a legacy If condition
            Get _GosubCallTargets of ghoFuncLib "IF iX EQ 1 gosub print_row" (&asT) (&bOn) to iN
            Send AssertIAreEqual 1 iN
            Send Assert (asT[1] = "print_row")
            // the computed ON..GOSUB dispatch lists EVERY target
            Get _GosubCallTargets of ghoFuncLib "ON iMode GOSUB calc_total print_row sum_up" (&asT) (&bOn) to iN
            Send AssertIAreEqual 3 iN
            Send Assert (bOn = True)
            Send Assert (asT[4] = "sum_up")
            // an identifier merely CONTAINING the keyword must not hit
            Get _GosubCallTargets of ghoFuncLib "Move iGosubCount to iX" (&asT) (&bOn) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        {Published = True}
        Procedure GosubGotoReport_ReturnKind
            Integer iKind
            Get _GosubReturnKind of ghoFuncLib "gosub_return" to iKind
            Send AssertIAreEqual 1 iKind
            Get _GosubReturnKind of ghoFuncLib "Gosub_Return Return" to iKind
            Send AssertIAreEqual 2 iKind
            Get _GosubReturnKind of ghoFuncLib "gosub_return other_place" to iKind
            Send AssertIAreEqual 3 iKind
            Get _GosubReturnKind of ghoFuncLib "Move 1 to iX" to iKind
            Send AssertIAreEqual 0 iKind
        End_Procedure

        {Published = True}
        Procedure GosubGotoReport_GotoTarget
            String sT
            Get _GotoTarget of ghoFuncLib "goto skip_it" to sT
            Send Assert (sT = "skip_it")
            Get _GotoTarget of ghoFuncLib "IF iX EQ 1 goto skip_it" to sT
            Send Assert (sT = "skip_it")
            Get _GotoTarget of ghoFuncLib "Move iGotoCount to iX" to sT
            Send Assert (sT = "")
        End_Procedure

        // Whole-file audit over a synthetic flat legacy module exercising every classification:
        // a self-contained subroutine (CANDIDATE), one poisoned by a label-arg Gosub_Return and a
        // boundary-crossing goto (MANUAL), an ON..GOSUB dispatch, a gosub to a label not in the
        // file, forward-skip / backward-loop gotos, and an orphan label.
        {Published = True}
        Procedure GosubGotoReport_AuditFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "start_here:"                             to asCode[0]
            Move "    gosub calc_total"                    to asCode[1]
            Move "    ON iMode GOSUB calc_total print_row" to asCode[2]
            Move "    IF iX EQ 1 goto skip_it"             to asCode[3]
            Move "    Move 1 to iY"                        to asCode[4]
            Move "skip_it:"                                to asCode[5]
            Move "    goto start_here"                     to asCode[6]
            Move "    goto inside_print"                   to asCode[7]
            Move "    gosub missing_sub"                   to asCode[8]
            Move "    abort"                               to asCode[9]
            Move "calc_total:"                             to asCode[10]
            Move "    IF iX EQ 2 goto calc_done"           to asCode[11]
            Move "    Move 2 to iY"                        to asCode[12]
            Move "calc_done:"                              to asCode[13]
            Move "    gosub_return"                        to asCode[14]
            Move "print_row:"                              to asCode[15]
            Move "    IF iZ EQ 3 gosub_return other_place" to asCode[16]
            Move "inside_print:"                           to asCode[17]
            Move "    gosub_return"                        to asCode[18]
            Move "dead_label:"                             to asCode[19]
            Move "    gosub_return"                        to asCode[20]
            Get _GosubAuditFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send Assert (iN > 0)
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            // the two subroutines, with their verdicts
            Send Assert (sAll contains "Subroutines (labels called via Gosub): 2")
            Send Assert (sAll contains "calc_total:")
            Send Assert (sAll contains "CANDIDATE")
            Send Assert (sAll contains "print_row:")
            Send Assert (sAll contains "MANUAL")
            Send Assert (sAll contains "Gosub_Return <label>")
            // the ON..GOSUB dispatch with its Case hint
            Send Assert (sAll contains "ON..GOSUB dispatch")
            // the gosub whose target is not in this file
            Send Assert (sAll contains "missing_sub")
            // goto classifications carry their rewrite hints
            Send Assert (sAll contains "forward skip - rewrite as an If/Else block")
            Send Assert (sAll contains "backward jump = a LOOP - rewrite as While / Repeat-Until")
            Send Assert (sAll contains "crosses subroutine 'print_row'")
            // the never-referenced label
            Send Assert (sAll contains "orphan label 'dead_label'")
        End_Procedure

        // A comment's and a report image's text are no code (2026-10-30): read raw, the commented-out label and
        // its goto were reported, and so was the image's "Total:" - as an orphan label.
        {Published = True}
        Procedure GosubGotoReport_CommentAndImageTextIsNoCode
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "/* The steps, in order:"    to asCode[0]
            Move "   first_step: read a row"  to asCode[1]
            Move "   goto first_step */"      to asCode[2]
            Move "    move 1 to iX"           to asCode[3]
            Move "    goto done_it"           to asCode[4]
            Move "    move 2 to iX"           to asCode[5]
            Move "done_it:"                   to asCode[6]
            Move "/Footer_Img"                to asCode[7]
            Move "Total: ______"              to asCode[8]
            Move "/*"                         to asCode[9]
            Get _GosubAuditFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 1 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Goto sites: 1")
            Send Assert (sAll contains "goto done_it")
            Send Assert (not(sAll contains "first_step")) "the comment's label and goto"
            Send Assert (not(Lowercase(sAll) contains "total")) "the image's text"
        End_Procedure

    End_Object
