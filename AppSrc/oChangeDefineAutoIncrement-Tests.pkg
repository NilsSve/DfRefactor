//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeDefineAutoIncrement-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-02
//
// Description : Unit tests for ChangeDefineAutoIncrement - the obsolete DD command
//                 Define_Auto_Increment <src> To <dest>  ->  Set Field_Auto_Increment Field <dest> File_Field <src>
//               The two field references SWAP (dest first) and take keywords (Field / File_Field); there is NO "to" in
//               the modern form. (4533 obsolete-command family; the warning reads "Obsolete command DEFINE_AUTO_INCREMENT".)
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeDefineAutoIncrement is a cTestFixture
        Set psFunctionName to "ChangeDefineAutoIncrement"

        // The real LegacyApp form (DOCS0010.DD:55): indented, extra spaces between the parts. The nose (indent)
        // is preserved; the rebuilt command is single-spaced; src + dest swap.
        {Published = True}
        Procedure ChangeDefineAutoIncrement_RealDD
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "        Define_Auto_Increment  ITEM0030.Doc_no  To DOCS0010.Doc_no" to sLine
            Move "        Set Field_Auto_Increment Field DOCS0010.Doc_no File_Field ITEM0030.Doc_no" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeDefineAutoIncrement of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Minimal single-space form, no indent.
        {Published = True}
        Procedure ChangeDefineAutoIncrement_Simple
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Define_Auto_Increment A.X To B.Y" to sLine
            Move "Set Field_Auto_Increment Field B.Y File_Field A.X" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeDefineAutoIncrement of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A trailing comment after the destination field is preserved verbatim.
        {Published = True}
        Procedure ChangeDefineAutoIncrement_TrailingComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Define_Auto_Increment A.X To B.Y  // note" to sLine
            Move "Set Field_Auto_Increment Field B.Y File_Field A.X  // note" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeDefineAutoIncrement of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A line without the command is left untouched and returns False.
        {Published = True}
        Procedure ChangeDefineAutoIncrement_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Send Add_Server_File ITEM0030.File_Number" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeDefineAutoIncrement of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Send Add_Server_File ITEM0030.File_Number" sLine
        End_Procedure

    End_Object
