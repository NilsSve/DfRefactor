//****************************************************************************
// $Module type: Test fixture
// $Module name: oCmdLineIniFile-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-03
//
// Description : Unit tests for the CmdLineIniFile refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCmdLineIniFile is a cTestFixture
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cCmdLineIniFile.pkg          // the command-line INI reader
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
        Set psFunctionName to "cCmdLineIniFile"

        // A standalone class, so the fixture just creates one - no ghoApplication, which
        // under the test runner is a plain cApplication and would answer nothing.
        Function Helper Returns Handle
            Handle ho
            Get Create (RefClass(cCmdLineIniFile)) to ho
            Function_Return ho
        End_Function

        // No parameter -> the bare name. This is the common case and must not gain a
        // trailing comma, which the reader would decode as an empty parameter.
        {Published = True}
        Procedure CmdIni_EncodeWithoutParameter
            Handle ho
            String sSpec
            Get Helper to ho
            Get EncodeFunctionSpec of ho "ChangeDfTimerTocTimer" "" to sSpec
            Send AssertSAreEqual "ChangeDfTimerTocTimer" sSpec
            // Whitespace around either half must not reach the file.
            Get EncodeFunctionSpec of ho "  ChangeDfTimerTocTimer  " "   " to sSpec
            Send AssertSAreEqual "ChangeDfTimerTocTimer" sSpec
            Send Destroy of ho
        End_Procedure

        {Published = True}
        Procedure CmdIni_EncodeWithParameter
            Handle ho
            String sSpec
            Get Helper to ho
            Get EncodeFunctionSpec of ho "SomeFunction" "eOption" to sSpec
            Send AssertSAreEqual "SomeFunction,eOption" sSpec
            Send Destroy of ho
        End_Procedure

        {Published = True}
        Procedure CmdIni_DecodeSplitsNameAndParameter
            Handle ho
            String sName sParam
            Get Helper to ho
            Get DecodeFunctionName      of ho "SomeFunction,eOption" to sName
            Get DecodeFunctionParameter of ho "SomeFunction,eOption" to sParam
            Send AssertSAreEqual "SomeFunction" sName
            Send AssertSAreEqual "eOption" sParam
            Send Destroy of ho
        End_Procedure

        // No comma: the whole string is the name and the parameter is empty - NOT the
        // name repeated, and not "" for the name.
        {Published = True}
        Procedure CmdIni_DecodeWithoutParameter
            Handle ho
            String sName sParam
            Get Helper to ho
            Get DecodeFunctionName      of ho "ChangeDfTimerTocTimer" to sName
            Get DecodeFunctionParameter of ho "ChangeDfTimerTocTimer" to sParam
            Send AssertSAreEqual "ChangeDfTimerTocTimer" sName
            Send AssertSAreEqual "" sParam
            Send Destroy of ho
        End_Procedure

        /* THE PROPERTY THAT MATTERS: only the FIRST comma is structural, so a parameter
           may contain commas of its own. An enum-list parameter like "eA,eB" is exactly
           the shape that would be silently truncated by a naive split, and truncation
           here means a headless run quietly using a different parameter. */
        {Published = True}
        Procedure CmdIni_ParameterMayContainCommas
            Handle ho
            String sSpec sName sParam
            Get Helper to ho
            Get EncodeFunctionSpec of ho "SomeFunction" "eA,eB,eC" to sSpec
            Send AssertSAreEqual "SomeFunction,eA,eB,eC" sSpec
            Get DecodeFunctionName      of ho sSpec to sName
            Get DecodeFunctionParameter of ho sSpec to sParam
            Send AssertSAreEqual "SomeFunction" sName
            Send AssertSAreEqual "eA,eB,eC" sParam
            Send Destroy of ho
        End_Procedure

        // Round trip, which is the whole point of a feed: what the exporter wrote is what
        // the reader gets back, for both shapes.
        {Published = True}
        Procedure CmdIni_RoundTrip
            Handle ho
            String sSpec sName sParam

            Get Helper to ho
            Get EncodeFunctionSpec of ho "FnA" "" to sSpec
            Get DecodeFunctionName of ho sSpec to sName
            Get DecodeFunctionParameter of ho sSpec to sParam
            Send AssertSAreEqual "FnA" sName
            Send AssertSAreEqual "" sParam
            Get EncodeFunctionSpec of ho "FnB" "eThing" to sSpec
            Get DecodeFunctionName of ho sSpec to sName
            Get DecodeFunctionParameter of ho sSpec to sParam
            Send AssertSAreEqual "FnB" sName
            Send AssertSAreEqual "eThing" sParam
            Send Destroy of ho
        End_Procedure

        /* The default INI path splices the workspace name in before the extension, so two
           workspaces exported side by side cannot overwrite each other's file. The
           extension is cut at the FIRST dot on purpose: "DFRefactor25.0.sws" is the real
           shape of these names and must yield "DFRefactor25", not "DFRefactor25.0". */
        {Published = True}
        Procedure CmdIni_DefaultPathSplicesWorkspaceName
            Handle ho
            String sPath
            Get Helper to ho
            Get DefaultIniFileName of ho "C:\Projects\DF20\DfRefactor\DFRefactor25.0.sws" "C:\Projects\DF20\DfRefactor\Programs" to sPath
            Send Assert (sPath contains "_DFRefactor25")
            Send Assert (not(sPath contains "25.0"))
            Send Assert (sPath contains "Programs\")
            Send Destroy of ho
        End_Procedure

        // A missing trailing separator on the folder must not glue the folder to the file.
        {Published = True}
        Procedure CmdIni_DefaultPathAddsTheSeparator
            Handle ho
            String sPath sPath2
            Get Helper to ho
            Get DefaultIniFileName of ho "C:\WS\Foo.sws" "C:\WS\Programs"  to sPath
            Get DefaultIniFileName of ho "C:\WS\Foo.sws" "C:\WS\Programs\" to sPath2
            Send AssertSAreEqual sPath sPath2
            Send Assert (sPath contains "Programs\")
            Send Destroy of ho
        End_Procedure

        // A space in the workspace name becomes an underscore - the path ends up on a
        // command line, where an unquoted space is two arguments.
        {Published = True}
        Procedure CmdIni_DefaultPathUnderscoresSpaces
            Handle ho
            String sPath
            Get Helper to ho
            Get DefaultIniFileName of ho "C:\WS\My Big Workspace.sws" "C:\WS\Programs" to sPath
            Send Assert (sPath contains "My_Big_Workspace")
            Send Assert (not(sPath contains "My Big"))
            Send Destroy of ho
        End_Procedure

        /* WHITESPACE AROUND THE NAME HALF IS TRIMMED. cFunctionsDataDictionary.SpecFunctionName
           delegates here, and it looks the name up with "Find eq ... by Index.2" - an untrimmed
           "Name " matches no record and the function is dropped from the run WITHOUT A WORD.
           A batch INI gets hand-edited, so the stray space is a real input, not a hypothetical. */
        {Published = True}
        Procedure CmdIni_DecodeNameTrimsAroundTheComma
            Handle ho
            String sName
            Get Helper to ho
            Get DecodeFunctionName of ho "  RemoveTrailingSpaces  " to sName
            Send AssertSAreEqual "RemoveTrailingSpaces" sName
            Get DecodeFunctionName of ho "EditorReIndent , 4" to sName
            Send AssertSAreEqual "EditorReIndent" sName
            Get DecodeFunctionName of ho " RefactorGridToCJGrid ,Grid, cCJGridColumn" to sName
            Send AssertSAreEqual "RefactorGridToCJGrid" sName
            Send Destroy of ho
        End_Procedure

        // A spec that is nothing but a comma, or blank, yields a blank NAME rather than something
        // that would be looked up. The caller skips blanks instead of reporting them as unknown.
        {Published = True}
        Procedure CmdIni_DecodeNameBlankStaysBlank
            Handle ho
            String sName
            Get Helper to ho
            Get DecodeFunctionName of ho "" to sName
            Send AssertSAreEqual "" sName
            Get DecodeFunctionName of ho "   " to sName
            Send AssertSAreEqual "" sName
            Get DecodeFunctionName of ho ",eSomething" to sName
            Send AssertSAreEqual "" sName
            Send Destroy of ho
        End_Procedure

        /* The class method is a one-line forward to the GLOBAL rfDefaultIniFileName, and the
           global is what both exporters actually call - the FT one must, because it runs inside
           the WebView2 pump where creating an object to reach a class method hangs the program
           (2026-08-22). Assert they agree, so the four tests above keep covering the SHIPPED
           path and not a parallel copy of it. */
        {Published = True}
        Procedure CmdIni_DefaultPathGlobalMatchesTheMethod
            Handle ho
            String sViaMethod sViaGlobal
            Get Helper to ho
            Get DefaultIniFileName of ho "C:\WS\My Big Workspace.sws" "C:\WS\Programs" to sViaMethod
            Move (rfDefaultIniFileName("C:\WS\My Big Workspace.sws", "C:\WS\Programs")) to sViaGlobal
            Send AssertSAreEqual sViaMethod sViaGlobal
            Send Destroy of ho
        End_Procedure

        // Fixture files live in the Windows TEMP folder, in a subfolder of their own (Nils 2026-10-05; in the
        // workspace's Data folder until then, where the folder stayed behind after every run). vGetTempPath is
        // a method of the Desktop, not a global function: called with no object it compiles and answers nothing.
        Function _IniTestRoot Returns String
            Function_Return (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_CmdIni\")
        End_Function

        /* REGRESSION, 2026-08-22. Clearing a numbered section must REMOVE its keys, not blank them.

           WipeExistingIniValues used to write "" over Folder Name1..1000. Under DataFlex 25 that
           left nothing behind - cIniFile was a wrapper over WritePrivateProfileStringW. DataFlex 26
           replaced it with an in-memory array where SetValue with "" STORES "key=" and every
           WriteString rewrites the whole file, so the exporter produced a 36 KB ini of dead keys
           and took minutes. The fix is DeleteSection; this pins the behaviour it relies on.

           Testing cIniFile rather than WipeExistingIniValues is deliberate: that Procedure lives on
           a dialog the test runner never instantiates, and the thing that actually broke was the
           platform contract underneath it. If a future DataFlex changes it again, this fails. */
        {Published = True}
        Procedure CmdIni_ClearingASectionRemovesItsKeys
            Handle  hoIni
            Boolean bOk
            Integer iCount i
            String  sRoot sFile
            String[] asLines

            Get _IniTestRoot to sRoot
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (sRoot + "ZWipe.ini") to sFile
            Move (rfDeleteFile(sFile)) to bOk          // a stale file would mask the result

            Get Create (RefClass(cIniFile)) to hoIni
            Set psFileName of hoIni to sFile
            Send WriteString of hoIni "Folder Section" "Folder Name1" "C:\WS\AppSrc"
            Send WriteString of hoIni "Folder Section" "Folder Name2" "C:\WS\DDSrc"
            Send WriteString of hoIni "Folder Section" "Folder Name3" "C:\WS\AppHtml"

            // What the exporter now does before it rewrites the section.
            Send DeleteSection of hoIni "Folder Section"
            Send WriteString of hoIni "Folder Section" "Folder Name1" "C:\WS\Only"
            Send Destroy of hoIni

            Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
            Move 0 to iCount
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (Pos("Folder Name", asLines[i]) > 0) ;
                    Increment iCount
            Loop
            // Exactly the one entry just written - the cleared ones are GONE, not blanked.
            Send Assert (iCount = 1) ("expected 1 Folder Name line, found" * String(iCount))
            For i from 0 to (SizeOfArray(asLines) - 1)
                Send Assert (Trim(asLines[i]) <> "Folder Name2=") "a cleared key was blanked, not removed"
                Send Assert (Trim(asLines[i]) <> "Folder Name3=") "a cleared key was blanked, not removed"
            Loop
            Move (rfDeleteFile(sFile)) to bOk
        End_Procedure

    End_Object
