// ScintillaReplaceFT.dg
//
// The FlexTron twin of ScintillaReplace.dg, the editor's Replace dialog: the same two combos, options
// and RequestDetails, on an FT panel, with Find Next, Replace, Replace All and Cancel as framework
// buttons (cFTWebButton, RDCFlexTron) on a grid host of 8 px columns.
//
// HOW DFRefactorFT GETS THIS ONE, as the Find, Go To Line and Drop Self twins:
// cRefactorEditorCommands.pkg Uses the dialog itself, and every program that edits code gets it
// through that package. DFRefactorFT.src Uses this file BEFORE it, this file defines
// C_OwnReplaceDialog, and the package then leaves ScintillaReplace.dg out. Both files define
// oReplaceDialog - the package reaches the dialog by that name - so the two must never both be in:
// used after the package, this file stops the build (below).
//
// LAID OUT as Find's twin: the controls as they were, and the buttons in a bar at the bottom right
// (the original stacked them at the right). A fixed size - a resizable FT panel gets a status bar
// under it - so the two combos run on to the bar's right edge, where the buttons stood. Find Next and
// Replace work on the editor while the dialog stays open; Replace All and Cancel close it.
//
// LEFT OUT: the original's "Preserve case" check box - nothing reads it, and it lies across "Start at
// first line" (rows 79 and 80) - and its "Replace in" group, Selection / Entire Buffer (Nils
// 2026-10-01: remove it). Nothing read the group's answer, and it started on Selection while Replace
// All always works on the whole file.
Use Windows.pkg
Use RefactorMessageQueue.pkg
Use ScintillaFindControls.pkg
Use cFTModalPanel.pkg
Use cFTCheckBoxCaption.pkg      // a check box's caption the FT colours reach
Use cFTGridHost.pkg             // the buttons' host - a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg  // cFTWebButton - Find Next, Replace, Replace All and Cancel

// cRefactorEditorCommands.pkg declares tDropSelfResponse. If it exists already, the package is in the
// program and has brought ScintillaReplace.dg with it - there would be two oReplaceDialog.
#IFDEF _STRUCT_tDropSelfResponse
#ERROR DFERR_PROGRAM "Use ScintillaReplaceFT.dg before the editor packages - ScintillaReplace.dg is in the program already."
#ENDIF

// Tells cRefactorEditorCommands.pkg to leave ScintillaReplace.dg out.
Define C_OwnReplaceDialog for 1

Object oReplaceDialog is a cFTModalPanel
    Set Label to "Find & Replace"
    Set Size to 122 310
    Set Location to 44 47
    Set Border_Style to Border_Dialog
    //Set Locate_Mode to POPUP_LOCATE -- locate mode isn't smart enough
    Property Boolean pbReplaceAll
    Property Boolean pbFindFirst
    Property Handle  phoInvokingObject

    /* THE TWO COMBOS refuse the dialog's dark colours, as cFTComboForm refuses them (Nils 2026-08-22):
       Windows paints a combo's drop-down list itself, dark but with black text. The combos stay light, and
       the texts they remember stay readable. Their labels are given the FT ink below (FTColorChildren). */
    Object oFindFm is a cFindComboForm
      Set Size to 13 245
      Set Location to 10 55
      Set Label to "&Find:"
      Set Label_Col_Offset to 2
      Set Label_Justification_Mode to JMode_Right
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below

      // The dialog's dark colours are refused - see the comment above the two combos.
      Procedure Set Color Integer iColor
      End_Procedure

      Procedure Set TextColor Integer iColor
      End_Procedure
    End_Object

    Object oReplaceFm is a cFindComboForm
      Set Size to 13 245
      Set Location to 26 55
      Set Label to "Re&place with:"
      Set Label_Col_Offset to 2
      Set Label_Justification_Mode to JMode_Right
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below

      // The dialog's dark colours are refused - see the comment above the two combos.
      Procedure Set Color Integer iColor
      End_Procedure

      Procedure Set TextColor Integer iColor
      End_Procedure
    End_Object

    /* THE FOUR OPTIONS: a check box, and its caption beside it (cFTCheckBoxCaption). A check box draws
       its own caption in the Windows theme's colour - dark on the dark ground - so the caption is a
       TextBox the panel's FT ink reaches. A click on a caption ticks its box; Alt+W, C, E and L still
       tick them (below). */
    Object oWordMatchCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 46 55
      Set Label to ""
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below
    End_Object

    Object oWordMatch_tb is a cFTCheckBoxCaption
      Set Location to 47 66
      Set Label to "Match whole word only"
      Set phoCheckBox to (oWordMatchCb(Self))
    End_Object

    Object oMatchCaseCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 57 55
      Set Label to ""
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below
    End_Object

    Object oMatchCase_tb is a cFTCheckBoxCaption
      Set Location to 58 66
      Set Label to "Match case"
      Set phoCheckBox to (oMatchCaseCb(Self))
    End_Object

    Object oRegExCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 68 55
      Set Label to ""
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below
    End_Object

    Object oRegEx_tb is a cFTCheckBoxCaption
      Set Location to 69 66
      Set Label to "Regular expression"
      Set phoCheckBox to (oRegExCb(Self))
    End_Object

    Object oDocumentStartCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 79 55
      Set Label to ""
      On_Key kEnter Send DoFindNext   // Enter finds the next one - see the buttons below
    End_Object

    Object oDocumentStart_tb is a cFTCheckBoxCaption
      Set Location to 80 66
      Set Label to "Start at first line"
      Set phoCheckBox to (oDocumentStartCb(Self))
    End_Object

    /* FIND NEXT / REPLACE / REPLACE ALL / CANCEL at the bottom right - framework buttons on a grid host of
       8 px columns, right-aligned with the two combos. Find Next keeps the default it had: Enter finds the
       next one (bound on the combos and the check boxes, not on the panel - a web button that has the
       focus takes its own Enter), and Find Next wears the main action's amber. Each runs in
       OnButtonClick, after the web click has returned (the library's click relay) - closing the panel
       cannot happen inside the click. The spans fit the captions with their glyphs. */
    Object oReplaceButtons is a cFTGridHost
        Set Location to 94 10
        Set Size to 20 295
        Set piColumnCount to 55         // column 0, then Find Next's 14, Replace's 13, Replace All's 15 and Cancel's 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oFindBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 14
            Set psCaption to "Find Next"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-search"
            Set psToolTip to "Find the next occurrence. Enter does the same."

            Procedure OnButtonClick
                Send DoFindNext of oReplaceDialog
            End_Procedure
        End_Object

        Object oReplaceBtn is a cFTWebButton
            Set piColumnIndex to 15
            Set piColumnSpan to 13
            Set psCaption to "Replace"
            Set psCSSClass to "ftbtn ftg-edit"
            Set psToolTip to "Replace the found text, then find the next occurrence."

            Procedure OnButtonClick
                Send DoReplaceNext of oReplaceDialog
            End_Procedure
        End_Object

        Object oReplaceAllBtn is a cFTWebButton
            Set piColumnIndex to 28
            Set piColumnSpan to 15
            Set psCaption to "Replace All"
            Set psCSSClass to "ftbtn ftg-selectall"
            Set psToolTip to "Replace every occurrence in the file."

            Procedure OnButtonClick
                Send DoReplaceAll of oReplaceDialog
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 43
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close without replacing any more."

            Procedure OnButtonClick
                Send DoCancel of oReplaceDialog
            End_Procedure
        End_Object
    End_Object

    // Find Next - the button, Enter or Alt+N: search on from the caret; the dialog stays open. The body is
    // the original Find Next button's.
    Procedure DoFindNext
        Handle  hoInvokingObject
        Integer iFlags
        String  sSearchText
        tFindReplaceOptions ReplaceOptions

        Get phoInvokingObject to hoInvokingObject
        If hoInvokingObject Begin
          Send SettingsToOptions (&ReplaceOptions)
          Get SetSearchOptions of hoInvokingObject ReplaceOptions to iFlags
          Get Value Of oFindFm To sSearchText
          Send AddSearchString of oFindFm sSearchText  // make sure the search value is saved in the array
          Set psSearchText of hoInvokingObject to sSearchText
          If (ReplaceOptions.bDocumentStart=True and pbFindFirst(Self)=false) Begin
            Set pbFindFirst to True
            Send FindFirst to hoInvokingObject
          End
          Else Begin
            Send FindNext to hoInvokingObject
          End
        End
    End_Procedure

    // Replace - the button or Alt+R: replace the found text, then find the next one; the dialog stays open.
    // The body is the original Replace button's.
    Procedure DoReplaceNext
        Handle hoInvokingObject
        String sSearchText
        String sReplaceWith
        Get phoInvokingObject to hoInvokingObject
        If hoInvokingObject Begin
          Get Value of oFindFm to sSearchText
          Get Value Of oReplaceFm To sReplaceWith
          Send AddSearchString of oReplaceFm sReplaceWith // save the replace string in the array for later use if wanted
          Set psSearchText of hoInvokingObject to sSearchText
          Send ReplaceText of hoInvokingObject sReplaceWith
          Send FindNext to hoInvokingObject
        End
    End_Procedure

    // Replace All - the button or Alt+A: close, and the editor replaces every occurrence.
    Procedure DoReplaceAll
        Set pbReplaceAll to True
        Send Close_Panel
    End_Procedure

    // Cancel - the button, Esc or the window's X: close. Replacements made with Replace stay made.
    Procedure DoCancel
        Send Close_Panel
    End_Procedure

    // The Alt keys first take their keystroke off the queue (DispatchHotkey), so Windows does not beep,
    // as the original's doFind / doReplace / doReplaceAll did. Never on a click: DispatchHotkey removes
    // the next message, whatever it is.
    Procedure KeyFindNext
        Send DispatchHotkey
        Send DoFindNext
    End_Procedure

    Procedure KeyReplace
        Send DispatchHotkey
        Send DoReplaceNext
    End_Procedure

    Procedure KeyReplaceAll
        Send DispatchHotkey
        Send DoReplaceAll
    End_Procedure

    On_Key Key_Alt+Key_F Send Activate  of oFindFm
    On_Key Key_Alt+Key_P Send Activate  of oReplaceFm
    On_Key Key_Alt+Key_W Send doToggle  of oWordMatchCb
    On_Key Key_Alt+Key_C Send doToggle  of oMatchCaseCb
    On_Key Key_Alt+Key_E Send doToggle  of oRegExCb
    On_Key Key_Alt+Key_L Send doToggle  of oDocumentStartCb
    On_Key Key_Alt+Key_N Send KeyFindNext
    On_Key Key_Alt+Key_R Send KeyReplace
    On_Key Key_Alt+Key_A Send KeyReplaceAll
    On_Key kCancel       Send DoCancel

    /* THE COMBOS' LABELS take their colour from their parent - this panel (Label_TextColor clNone) - and
       the panel's FTColorChildren gives the FT ink to the children, not to the panel itself: on the dark
       ground the labels would stay dark. So they get the ink here, each time the children get theirs. */
    Procedure FTColorChildren
        Forward Send FTColorChildren
        Set Label_TextColor of oFindFm    to (FTThemeInk())
        Set Label_TextColor of oReplaceFm to (FTThemeInk())
    End_Procedure

    Procedure SettingsToOptions tFindReplaceOptions ByRef Options
      Get Value           of oFindFm          to Options.sSearchText
      Get Value           of oReplaceFm       to Options.sReplaceText
      Get Checked_State   of oWordMatchCb     to Options.bWordMatch
      Get Checked_State   of oMatchCaseCb     to Options.bMatchCase
      Get Checked_State   of oRegExCb         to Options.bRegExp
      Get Checked_State   of oDocumentStartCb to Options.bDocumentStart
      Move False                              to Options.bMarkAll
    End_Procedure

    Procedure RequestDetails tFindReplaceOptions ByRef Options Handle hoInvokingObject
      Boolean bReplaceAll

      If (hoInvokingObject=0) Begin
          Procedure_Return
      End
      Set phoInvokingObject                   to hoInvokingObject
      //
      Set pbReplaceAll                        to False
      Set pbFindFirst                         to False
      Move False                              to Options.bReplaceAll
      Set SearchValue     of oFindFm          to Options.sSearchText
      Set Checked_State   of oWordMatchCb     to Options.bWordMatch
      Set Checked_State   of oMatchCaseCb     to Options.bMatchCase
      Set Checked_State   of oRegExCb         to Options.bRegExp
      Set Checked_State   of oDocumentStartCb to Options.bDocumentStart
      Send Popup
      Send SettingsToOptions (&Options)
      Get pbReplaceAll to bReplaceAll
      If (bReplaceAll) Begin
        Move True                             to Options.bReplaceAll
      End
    End_Procedure

End_Object
