    /* Black's palette on a teal ground. Lucas has been in the theme list for a while,
       but only as a NAME: the string it pointed at was a byte-for-byte copy of Black
       that nobody ever filled in, and because the save path refuses to store a scheme
       whose name is already a built-in, it could not be given colours through the
       dialog either. The colours below are the real ones, recovered from a saved
       scheme and now declared like every other built-in. */
    Procedure LoadBuiltInLucas
        Send BeginScheme CS_ThemeLucas
        Send DefineStyle eEC_Window           (RGB(25,110,130))  CI_NoColour        False False
        Send DefineStyle eEC_LeftMargin       (RGB(25,110,130))  CI_NoColour        False False
        Send DefineStyle eEC_Bookmark         CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_Text             (RGB(255,255,255)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Numbers          (RGB(255,185,255)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Keywords         (RGB(140,215,240)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Operators        (RGB(255,108,108)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_ScopeKeywords    (RGB(140,215,240)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Comments         (RGB(187,255,187)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Strings          (RGB(192,192,192)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_LineNumbers      (RGB(192,192,192)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_HighlightedLine  (RGB(105,105,105)) CI_NoColour        False False
        Send DefineStyle eEC_StringTyping     (RGB(90,90,90))    (RGB(255,215,215)) False False
        Send DefineStyle eEC_BraceHighlight   (RGB(0,0,0))       (RGB(200,225,255)) False False
        Send DefineStyle eEC_UnmatchedBrace   (RGB(255,255,0))   (RGB(255,0,0))     False False
        Send DefineStyle eEC_MetaTags         (RGB(202,255,255)) (RGB(25,110,130))  False False
        Send DefineStyle eEC_Selection        CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_PreProcessor     (RGB(255,190,120)) (RGB(25,110,130))  False False
    End_Procedure

    /* The DataFlex Studio 25 look, so the two editors match.
       Read from Studio's own Dark scheme (its Code-Editor settings) and converted: its
       colours are COLORREF values packed the same way DataFlex's RGB() packs them, and
       its "use the default" marker is 0xFFFFFFFF, which becomes CI_NoColour here.

       Six elements had no counterpart in Studio and were chosen rather than converted:
         ScopeKeywords  Studio's DataFlex lexer does not separate scope keywords from
                        keywords, so they share the keyword colour - faithful to Studio,
                        even though this editor could tell them apart.
         PreProcessor   likewise has no Studio entry of its own; keyword colour.
         StringTyping   an unterminated string; Studio has no such state. Uses the same
                        treatment as the other dark schemes so it still stands out.
         UnmatchedBrace Studio highlights braces with one colour and has no "no partner"
                        state. Yellow on red, as in the other schemes.
         Selection      not stored with the scheme in Studio (it takes the system
                        colour). The dark blue the other dark schemes use.
         HighlightedLine Studio has no current-line colour; its left-margin grey reads as
                        a subtle wash on this near-black ground. */
    /* PURE parser for DataFlex.lng's dark palette: one entry per tokenset that declares a
       darkforecolor, in file order. Kept apart from the file read so it is testable without an
       install, the same split the Use-line and built-in-function parsers use.

       ONLY the RGB(r,g,b) form is read. 24 of the 26 dark colours in DF 25 are written that way; the
       two that are not ("purple", "red") name tokensets this scheme has no element for, so a colour
       table would be dead weight bought at the price of guessing which "red" the Studio means. An
       unparseable value is simply absent, and absent means the caller keeps its own literal.

       The attributes are matched on the <tokenset ...> tag itself rather than by walking the XML: the
       file is machine-generated and one attribute per tag is all this needs. If that ever stops being
       true the parse returns fewer entries and every element falls back - it cannot return a WRONG
       colour, which is the failure mode worth designing against. */
    Function _LngDarkColoursFromLines String[] asLines Returns tLngTokenColour[]
        tLngTokenColour[] aOut
        tLngTokenColour C
        String sLine sName sVal sNums
        Integer i iMax iPos iEnd iR iG iB

        Move (SizeOfArray(asLines) - 1) to iMax
        For i from 0 to iMax
            Move asLines[i] to sLine
            Move (Pos("<tokenset ", sLine)) to iPos
            If (iPos > 0) Begin
                Move "" to sName
                Move "" to sVal
                // name="..."
                Move (Pos('name="', sLine)) to iPos
                If (iPos > 0) Begin
                    Move (Mid(sLine, (Length(sLine) - iPos - 5), (iPos + 6))) to sName
                    Move (Pos('"', sName)) to iEnd
                    If (iEnd > 1) ;
                        Move (Left(sName, (iEnd - 1))) to sName
                    Else ;
                        Move "" to sName
                End
                // darkforecolor="RGB(r,g,b)"
                Move (Pos('darkforecolor="RGB(', sLine)) to iPos
                If (iPos > 0 and sName <> "") Begin
                    // 19 = the length of 'darkforecolor="RGB(' - the value starts one PAST it, or the
                    // opening paren rides along and the first component parses as "(60".
                    Move (Mid(sLine, (Length(sLine) - iPos - 18), (iPos + 19))) to sVal
                    Move (Pos(")", sVal)) to iEnd
                    If (iEnd > 1) Begin
                        Move (Left(sVal, (iEnd - 1))) to sNums
                        Move 0 to iR
                        Move 0 to iG
                        Move 0 to iB
                        Move (Pos(",", sNums)) to iPos
                        If (iPos > 1) Begin
                            Move (Left(sNums, (iPos - 1))) to iR
                            Move (Mid(sNums, (Length(sNums) - iPos), (iPos + 1))) to sNums
                            Move (Pos(",", sNums)) to iPos
                            If (iPos > 1) Begin
                                Move (Left(sNums, (iPos - 1))) to iG
                                Move (Trim(Mid(sNums, (Length(sNums) - iPos), (iPos + 1)))) to iB
                                Move sName to C.sTokenSet
                                Move (RGB(iR, iG, iB)) to C.iDark
                                Move C to aOut[SizeOfArray(aOut)]
                            End
                        End
                    End
                End
            End
        Loop
        Function_Return aOut
    End_Function

    // <install root>\Lib\DataFlex.lng for the TARGET version - the Pkg folder the app already
    // resolves, walked up one and across, so the bin->root derivation lives in exactly one place.
    Function InstallLanguageFilePath Returns String
        String sPkg sRoot
        Integer iPos
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (Trim(sPkg) = "") ;
            Function_Return ""
        If (Right(sPkg, 1) = "\") ;
            Move (Left(sPkg, (Length(sPkg) - 1))) to sPkg
        Move (RightPos("\", sPkg)) to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (Left(sPkg, (iPos - 1))) to sRoot
        Function_Return (vFolderFormat(sRoot) + "Lib\DataFlex.lng")
    End_Function

    // The install's dark palette, parsed once per object. Empty when there is no install to read -
    // which every caller below treats as "keep the built-in literal".
    Function _LngDarkColours Returns tLngTokenColour[]
        tLngTokenColour[] aC
        String[] asLines
        String sFile
        Boolean bExists

        If (pbLngLoaded(Self) = True) ;
            Function_Return (paLngColours(Self))
        Set pbLngLoaded to True
        Get InstallLanguageFilePath to sFile
        If (sFile <> "") ;
            Get vFilePathExists sFile to bExists
        If (bExists = False) Begin
            Set paLngColours to aC
            Function_Return aC
        End
        Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
        Get _LngDarkColoursFromLines asLines to aC
        Set paLngColours to aC
        Function_Return aC
    End_Function

    /* One tokenset's dark colour, or iFallback when the install does not supply it.

       The fallback is not a formality: "Scope Keywords" declares NO darkforecolor in DF 25 (it
       inherits Keywords' colour in the Studio's own model), so that element reaches its literal on
       every machine. Passing the literal in at the call site keeps the built-in scheme readable as a
       complete scheme in its own right - it still says what every element is, and the install merely
       gets first refusal. */
    Function _LngDark String sTokenSet Integer iFallback Returns Integer
        tLngTokenColour[] aC
        Integer i iMax
        Get _LngDarkColours to aC
        Move (SizeOfArray(aC) - 1) to iMax
        For i from 0 to iMax
            If (Lowercase(aC[i].sTokenSet) = Lowercase(sTokenSet)) ;
                Function_Return aC[i].iDark
        Loop
        Function_Return iFallback
    End_Function

    /* Studio 25's own Dark scheme, taken FROM THE INSTALL where it can be and falling back to the
       transcribed literals otherwise (see _LngDark). The literals stay put deliberately: they are the
       documented scheme, they keep this readable, and they are what a machine with no install shows.

       Only the syntax colours come from the file. The ground, margin, selection, current-line and
       brace states are not in it - the Studio takes some from the system and has no concept of the
       rest - so those stay ours, which is also why they carry no tokenset name below. */
    Procedure LoadBuiltInDataFlex
        Send BeginScheme CS_ThemeDataFlex
        Send DefineStyle eEC_Window           (RGB(16,16,16))    CI_NoColour        False False
        Send DefineStyle eEC_LeftMargin       (RGB(45,45,45))    CI_NoColour        False False
        Send DefineStyle eEC_Bookmark         CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_Text             (_LngDark(Self, "Text", (RGB(255,255,240)))) (RGB(16,16,16))    False False
        Send DefineStyle eEC_Numbers          (_LngDark(Self, "Numbers", (RGB(255,255,128)))) (RGB(16,16,16))    False False
        Send DefineStyle eEC_Keywords         (_LngDark(Self, "Keywords", (RGB(55,212,255))))  (RGB(16,16,16))    False False
        Send DefineStyle eEC_Operators        (_LngDark(Self, "Operators", (RGB(255,255,128)))) (RGB(16,16,16))    False False
        Send DefineStyle eEC_ScopeKeywords    (_LngDark(Self, "Scope Keywords", (RGB(55,212,255))))  (RGB(16,16,16))    False False
        Send DefineStyle eEC_Comments         (_LngDark(Self, "Line Comments", (RGB(60,220,70))))   (RGB(16,16,16))    False False
        Send DefineStyle eEC_Strings          (_LngDark(Self, "Strings", (RGB(255,190,154)))) (RGB(16,16,16))    False False
        Send DefineStyle eEC_LineNumbers      (RGB(108,163,189)) (RGB(16,16,16))    False False
        Send DefineStyle eEC_HighlightedLine  (RGB(45,45,45))    CI_NoColour        False False
        Send DefineStyle eEC_StringTyping     (RGB(90,90,90))    (RGB(255,215,215)) False False
        Send DefineStyle eEC_BraceHighlight   (RGB(128,128,128)) (RGB(192,192,192)) False False
        Send DefineStyle eEC_UnmatchedBrace   (RGB(255,255,0))   (RGB(255,0,0))     False False
        Send DefineStyle eEC_MetaTags         (_LngDark(Self, "Meta Data Tags", (RGB(255,120,180)))) (RGB(16,16,16))    False False
        Send DefineStyle eEC_PreProcessor     (RGB(55,212,255))  (RGB(16,16,16))    False False
    End_Procedure

    // White on a cream page; meta tags are bold.
    Procedure LoadBuiltInSahara
        Send BeginScheme CS_ThemeSahara
        Send DefineStyle eEC_Window           (RGB(255,255,187)) CI_NoColour        False False
        Send DefineStyle eEC_LeftMargin       (RGB(220,225,240)) CI_NoColour        False False
        Send DefineStyle eEC_Bookmark         CI_NoColour        (RGB(255,255,187)) False False
        Send DefineStyle eEC_Text             (RGB(0,0,0))       (RGB(255,255,187)) False False
        Send DefineStyle eEC_Numbers          (RGB(255,0,255))   (RGB(255,255,187)) False False
        Send DefineStyle eEC_Keywords         (RGB(0,0,255))     (RGB(255,255,187)) False False
        Send DefineStyle eEC_Operators        (RGB(255,0,0))     (RGB(255,255,187)) False False
        Send DefineStyle eEC_ScopeKeywords    (RGB(0,0,255))     (RGB(255,255,187)) False False
        Send DefineStyle eEC_Comments         (RGB(0,128,0))     (RGB(255,255,187)) False False
        Send DefineStyle eEC_Strings          (RGB(255,0,128))   (RGB(255,255,187)) False False
        Send DefineStyle eEC_LineNumbers      (RGB(105,105,105)) (RGB(190,200,225)) False False
        Send DefineStyle eEC_HighlightedLine  (RGB(220,225,240)) CI_NoColour        False False
        Send DefineStyle eEC_StringTyping     (RGB(128,128,128)) (RGB(255,215,215)) False False
        Send DefineStyle eEC_BraceHighlight   (RGB(0,0,0))       (RGB(200,225,255)) False False
        Send DefineStyle eEC_UnmatchedBrace   (RGB(255,255,0))   (RGB(255,35,35))   False False
        Send DefineStyle eEC_MetaTags         (RGB(0,128,128))   (RGB(255,255,187)) True  False
        Send DefineStyle eEC_Selection        CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_PreProcessor     (RGB(215,107,0))   (RGB(255,255,187)) False False
    End_Procedure

End_Class
