    Procedure LoadBuiltInLime
        Send BeginScheme CS_ThemeLime
        Send DefineStyle eEC_Window           (RGB(49,60,83))    CI_NoColour        False False
        Send DefineStyle eEC_LeftMargin       (RGB(69,82,104))   CI_NoColour        False False
        Send DefineStyle eEC_Bookmark         CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_Text             (RGB(255,255,255)) (RGB(49,60,83))    False False
        Send DefineStyle eEC_Numbers          (RGB(255,138,21))  (RGB(49,60,83))    False False
        Send DefineStyle eEC_Keywords         (RGB(156,255,0))   (RGB(49,60,83))    False False
        Send DefineStyle eEC_Operators        (RGB(249,255,13))  (RGB(49,60,83))    False False
        Send DefineStyle eEC_ScopeKeywords    (RGB(156,255,0))   (RGB(49,60,83))    False False
        Send DefineStyle eEC_Comments         (RGB(255,98,255))  (RGB(49,60,83))    False False
        Send DefineStyle eEC_Strings          (RGB(180,180,180)) (RGB(49,60,83))    False False
        Send DefineStyle eEC_LineNumbers      (RGB(96,114,145))  (RGB(28,38,60))    False False
        Send DefineStyle eEC_HighlightedLine  (RGB(28,38,60))    CI_NoColour        False False
        Send DefineStyle eEC_StringTyping     (RGB(70,70,70))    (RGB(253,193,220)) False False
        /* Was RGB(255,26,26) on RGB(49,60,83) - a red brace on the page colour, i.e. a
           foreground change wearing a highlight's name. Now a lighter slate than the page,
           which washes visibly under the lime and yellow tokens without competing with
           them. See HighlightTintColor for why the background is the one that matters. */
        Send DefineStyle eEC_BraceHighlight   (RGB(200,225,255)) (RGB(120,145,190)) False False
        Send DefineStyle eEC_UnmatchedBrace   (RGB(255,255,0))   (RGB(255,35,35))   False False
        Send DefineStyle eEC_MetaTags         (RGB(0,240,240))   (RGB(49,60,83))    False False
        Send DefineStyle eEC_Selection        CI_NoColour        CI_NoColour        False False
        Send DefineStyle eEC_PreProcessor     (RGB(255,194,34))  (RGB(49,60,83))    False False
    End_Procedure

