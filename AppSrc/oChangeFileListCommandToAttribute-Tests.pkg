//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeFileListCommandToAttribute-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-15
//
// Description : Unit tests for the ChangeFileListCommandToAttribute refactor function - the
//               obsolete Get_FileList and Set_FileList commands to the DF_FILELIST_NAME attribute.
//
//               THE SHAPE TO WATCH is the missing keyword: the legacy commands take their argument
//               with no 'to' (Set_FileList sName), so the conversion inserts one along with the
//               attribute name. That is what FMAC's own macro body does, which is why this
//               converter needed no runtime probe. The declining cases are the two ways the tail
//               can be wrong - no argument at all, and a 'to' that says the line was never this
//               command - plus the usual comment / string / prefix / non-leading guards.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeFileListCommandToAttribute is a cTestFixture
        Set psFunctionName to "ChangeFileListCommandToAttribute"

        // Helper: tokenize + convert one line, hand back the result and whether it changed.
        Function ConvertLine String ByRef sLine Returns Boolean
            Boolean bChanged
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeFileListCommandToAttribute of ghoFuncLib (&sLine) "" to bChanged
            Function_Return bChanged
        End_Function

        // The Set form - the spelling a real legacy workspace uses - and its casings.
        { Published = True }
        Procedure FileList_SetConverts
            String sLine
            Boolean bChanged

            Move "        Set_FileList sFileList" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "        Set_Attribute DF_FILELIST_NAME to sFileList" sLine

            Move "    set_filelist sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Set_Attribute DF_FILELIST_NAME to sName" sLine

            Move "Set_FileList sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "Set_Attribute DF_FILELIST_NAME to sName" sLine
        End_Procedure

        // The Get form - same function, same attribute, the read side.
        { Published = True }
        Procedure FileList_GetConverts
            String sLine
            Boolean bChanged

            Move "    Get_FileList sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_FILELIST_NAME to sName" sLine

            Move "    get_filelist sCurrentList" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_FILELIST_NAME to sCurrentList" sLine
        End_Procedure

        // An expression argument and a string literal both carry across verbatim.
        { Published = True }
        Procedure FileList_ExpressionAndLiteralArguments
            String sLine
            Boolean bChanged

            Move "    Set_FileList (Trim(sPath))" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Set_Attribute DF_FILELIST_NAME to (Trim(sPath))" sLine

            Move '    Set_FileList "filelist.cfg"' to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Set_Attribute DF_FILELIST_NAME to "filelist.cfg"' sLine
        End_Procedure

        // A trailing comment rides along untouched - including one that itself says 'to'.
        { Published = True }
        Procedure FileList_TrailingCommentKept
            String sLine
            Boolean bChanged
            Move "    Set_FileList sName   // point the runtime to the other list" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Set_Attribute DF_FILELIST_NAME to sName   // point the runtime to the other list" sLine
        End_Procedure

        // Idempotent: a converted line leads with Get_/Set_Attribute and is never matched again.
        { Published = True }
        Procedure FileList_ConvertedLineIsLeftAlone
            String sLine
            Boolean bChanged

            Move "    Set_Attribute DF_FILELIST_NAME to sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Set_Attribute DF_FILELIST_NAME to sName" sLine

            Move "    Get_Attribute DF_FILELIST_NAME to sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Attribute DF_FILELIST_NAME to sName" sLine
        End_Procedure

        /* NO ARGUMENT - the emitted line would be an attribute access with nothing to read into,
           so the converter declines. The tail is read off the comment-cut line, which is what the
           second case proves: a trailing comment is not an argument. (The POSITIVE control for
           that guard is the trailing-comment test above, which converts because a real argument
           precedes the comment.) */
        { Published = True }
        Procedure FileList_NoArgumentIsDeclined
            String sLine
            Boolean bChanged

            Move "    Set_FileList" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Set_FileList" sLine

            Move "    Get_FileList   // reads the current list" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_FileList   // reads the current list" sLine
        End_Procedure

        /* A 'to' IN THE TAIL - the legacy commands take none (the macro declares one argument and
           no TO, so this line is Error 4345 as it stands), which means it was never this command.
           Leave it for a human rather than rewrite it into something that compiles. */
        { Published = True }
        Procedure FileList_ToTailIsDeclined
            String sLine
            Boolean bChanged
            Move "    Set_FileList to sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Set_FileList to sName" sLine
        End_Procedure

        // A longer identifier that merely STARTS with the keyword is not the command (whole token).
        { Published = True }
        Procedure FileList_PrefixIsNotTheCommand
            String sLine
            Boolean bChanged
            Move "    Set_FileListName sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Set_FileListName sName" sLine
        End_Procedure

        // Not at command position, a comment line and a string mention are all left alone.
        { Published = True }
        Procedure FileList_NonLeadingCommentAndStringAreLeftAlone
            String sLine
            Boolean bChanged

            Move "    Set Set_FileList of oWs to sName" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Set Set_FileList of oWs to sName" sLine

            Move "    // Set_FileList sName - the old way" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    // Set_FileList sName - the old way" sLine

            Move '    Move "Set_FileList sName" to sHelp' to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Move "Set_FileList sName" to sHelp' sLine
        End_Procedure

    End_Object
