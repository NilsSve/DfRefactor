//****************************************************************************
// $Module type: Test fixture
// $Module name: oRefactorBareGlobalsToGlobalVariable-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the RefactorBareGlobalsToGlobalVariable refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRefactorBareGlobalsToGlobalVariable is a cTestFixture
        Set psFunctionName to "RefactorBareGlobalsToGlobalVariable"

        // sFile with the lines of asLines.
        Procedure _WriteLines String sFile String[] asLines
            Integer iCh i iLast
            Move (rfOpenOutput(sFile)) to iCh
            If (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
                Move (SizeOfArray(asLines) - 1) to iLast
                For i from 0 to iLast
                    Writeln channel iCh asLines[i]
                Loop
                Send rfCloseOutput iCh
            End
        End_Procedure

        /* A NAME A MACRO READS KEEPS IT (2026-11-02). Macro code is never refactored: 'integer OG_Tmp#' became giOG_Tmp#
           under a #COMMAND body that went on reading OG_Tmp#, and every use of the macro failed. The declaration still
           becomes a Global_Variable, a name no macro reads is renamed as before, and the run notes say why.
           THROUGH THE ENGINE'S OWN CALL: RunWholeFileFunction hands the function sentinels for the macro lines, and the
           first version of this check passed a direct call and saw no macro in a real run. */
        { Published = True }
        Procedure RefactorBareGlobals_KeepsANameAMacroReads
            String[] asCode asNotes
            String sHash
            Integer iCount iFn iMacro iLost

            Move (Character(35)) to sHash
            Move ('integer OG_Tmp' + sHash)              to asCode[0]
            Move 'integer gone_Now'                      to asCode[1]
            Move (sHash + 'COMMAND MY_MACRO')            to asCode[2]
            Move ('  move self to og_tmp' + sHash)       to asCode[3]
            Move (sHash + 'ENDCOMMAND')                  to asCode[4]
            Move 'move 0 to gone_Now'                    to asCode[5]
            Move (RefFunc(RefactorBareGlobalsToGlobalVariable)) to iFn
            Get RunWholeFileFunction of ghoFuncLib iFn (&asCode) "" (&iMacro) (&iLost) to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 3 iMacro
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual ('Global_Variable integer OG_Tmp' + sHash) asCode[0]
            Send AssertSAreEqual 'Global_Variable integer giGone_Now'       asCode[1]
            Send AssertSAreEqual ('  move self to og_tmp' + sHash)          asCode[3]
            Send AssertSAreEqual 'move 0 to giGone_Now'                     asCode[5]
            Get pasRunNotes of ghoFuncLib to asNotes
            Send Assert (Pos("a macro in this file uses it", asNotes[SizeOfArray(asNotes) - 1]) > 0) asNotes[SizeOfArray(asNotes) - 1]
        End_Procedure

        // Called directly, as a unit test or another converter may, the macro lines are still in the file.
        { Published = True }
        Procedure RefactorBareGlobals_KeepsANameAMacroReads_DirectCall
            String[] asCode
            String sHash
            Integer iCount

            Move (Character(35)) to sHash
            Move ('integer OG_Tmp' + sHash)              to asCode[0]
            Move (sHash + 'COMMAND MY_MACRO')            to asCode[1]
            Move ('  move self to OG_Tmp' + sHash)       to asCode[2]
            Move (sHash + 'ENDCOMMAND')                  to asCode[3]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual ('Global_Variable integer OG_Tmp' + sHash) asCode[0]
        End_Procedure

        // A dotted name is a naming scheme of its own, and a file reading it could not be found: it keeps it.
        { Published = True }
        Procedure RefactorBareGlobals_KeepsADottedName
            String[] asCode
            String sHash
            Integer iCount

            Move (Character(35)) to sHash
            Move ('integer seq.object' + sHash) to asCode[0]
            Move ('move 0 to seq.object' + sHash) to asCode[1]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual ('Global_Variable integer seq.object' + sHash) asCode[0]
            Send AssertSAreEqual ('move 0 to seq.object' + sHash) asCode[1]
        End_Procedure

        // The real error-wall shape: a bare String global with the legacy @-suffix, plus its init
        // and read sites - declaration AND every reference get the gs-name the modernized shared
        // packages expect.
        { Published = True }
        Procedure RefactorBareGlobals_AtSuffixAndReferences
            String[] asCode
            Integer iCount
            Move 'Use DfAllEnt.pkg'                          to asCode[0]
            Move 'String P_auto_login@'                      to asCode[1]
            Move 'Move "" to P_auto_login@'                  to asCode[2]
            Move 'If ( P_auto_login@ <> "ON" ) Begin'        to asCode[3]
            Move 'End'                                       to asCode[4]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Global_Variable String gsP_auto_login@'    asCode[1]
            Send AssertSAreEqual 'Move "" to gsP_auto_login@'                asCode[2]
            Send AssertSAreEqual 'If ( gsP_auto_login@ <> "ON" ) Begin'      asCode[3]
        End_Procedure

        // Multi-name declaration + a trailing comment: one Global_Variable line, both names mapped,
        // the comment preserved.
        { Published = True }
        Procedure RefactorBareGlobals_MultiNameWithComment
            String[] asCode
            Integer iCount
            Move 'String P_auto_login@ arg001   // needed by the login package' to asCode[0]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Global_Variable String gsP_auto_login@ gsArg001   // needed by the login package' asCode[0]
        End_Procedure

        // The old SIZED form: the all-digit size tokens ride along unrenamed.
        { Published = True }
        Procedure RefactorBareGlobals_SizedDeclaration
            String[] asCode
            Integer iCount
            Move 'String arg1 1 arg2 1 arg3 1' to asCode[0]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Global_Variable String gsArg1 1 gsArg2 1 gsArg3 1' asCode[0]
        End_Procedure

        // A type-letter camel prefix is ABSORBED (sCmdString -> gsCmdString, never gssCmdString);
        // Integer maps to gi with the first letter uppercased.
        { Published = True }
        Procedure RefactorBareGlobals_PrefixAbsorptionAndInteger
            String[] asCode
            Integer iCount
            Move 'String sCmdString'      to asCode[0]
            Move 'Integer Radio_State'    to asCode[1]
            Move 'Move 0 to Radio_State'  to asCode[2]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual 'Global_Variable String gsCmdString'   asCode[0]
            Send AssertSAreEqual 'Global_Variable Integer giRadio_State' asCode[1]
            Send AssertSAreEqual 'Move 0 to giRadio_State'              asCode[2]
        End_Procedure

        // FILE SCOPE ONLY: a local inside a Procedure, a Struct member, and a declaration inside an
        // Object body all pass through untouched.
        { Published = True }
        Procedure RefactorBareGlobals_ScopedDeclarationsUntouched
            String[] asCode
            Integer iCount

            Move 'Procedure DoIt'            to asCode[0]
            Move '    String sLocal'         to asCode[1]
            Move 'End_Procedure'             to asCode[2]
            Move 'Struct tThing'             to asCode[3]
            Move '    String sMember'        to asCode[4]
            Move 'End_Struct'                to asCode[5]
            Move 'Object oPanel is a Panel'  to asCode[6]
            Move '    Procedure OnX'         to asCode[7]
            Move '        Integer iLocal'    to asCode[8]
            Move '    End_Procedure'         to asCode[9]
            Move 'End_Object'                to asCode[10]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '    String sLocal'      asCode[1]
            Send AssertSAreEqual '    String sMember'     asCode[4]
            Send AssertSAreEqual '        Integer iLocal' asCode[8]
        End_Procedure

        // Already-modern lines are not this function's business: an existing Global_Variable keeps
        // its name, and an already g-named bare declaration is wrapped WITHOUT double-prefixing.
        { Published = True }
        Procedure RefactorBareGlobals_ModernAndPrefixedUntouched
            String[] asCode
            Integer iCount
            Move 'Global_Variable String username@' to asCode[0]
            Move 'String gsAlready'                 to asCode[1]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Global_Variable String username@'  asCode[0]
            Send AssertSAreEqual 'Global_Variable String gsAlready'  asCode[1]
        End_Procedure

        // A BLOCK COMMENT'S TEXT IS NO CODE (2026-10-30, the before/after run): a comment line at file scope that
        // starts with "string" declared nothing, yet every word on it became a global renamed through the file -
        // "The" to "gsThe" in every comment. A declaration keeps its block comment; the code after a one-line
        // comment is code; an "Object" in a comment opens no scope, and a Procedure with one after it still does.
        { Published = True }
        Procedure RefactorBareGlobals_BlockCommentTextUntouched
            String[] asCode
            Integer iCount
            Move '/* The shelf, as the dialog reads it:'                to asCode[0]
            Move '   string and hand it over. The end. */'              to asCode[1]
            Move 'String arg1 /* the arg1 note */'                      to asCode[2]
            Move '/* arg1 */ Move 1 to arg1'                            to asCode[3]
            Move '/* The shelf holds no'                                to asCode[4]
            Move '   Object oShelf, only text. */'                      to asCode[5]
            Move 'Procedure Show /* one arg1 */'                        to asCode[6]
            Move '    String sLocal'                                    to asCode[7]
            Move '    Move arg1 to sLocal'                              to asCode[8]
            Move 'End_Procedure'                                        to asCode[9]
            Move 'Integer iTail'                                        to asCode[10]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual '/* The shelf, as the dialog reads it:'                asCode[0]
            Send AssertSAreEqual '   string and hand it over. The end. */'              asCode[1]
            Send AssertSAreEqual 'Global_Variable String gsArg1   /* the arg1 note */'  asCode[2]
            Send AssertSAreEqual '/* arg1 */ Move 1 to gsArg1'                          asCode[3]
            Send AssertSAreEqual 'Procedure Show /* one arg1 */'                        asCode[6]
            Send AssertSAreEqual '    String sLocal'                                    asCode[7]
            Send AssertSAreEqual '    Move gsArg1 to sLocal'                            asCode[8]
            Send AssertSAreEqual 'Global_Variable Integer giTail'                       asCode[10]
        End_Procedure

        // The rename is CODE-AWARE: the old name inside a string literal or a comment is never touched.
        { Published = True }
        Procedure RefactorBareGlobals_LiteralAndCommentSafe
            String[] asCode
            Integer iCount
            Move 'String arg1'                          to asCode[0]
            Move 'Showln "arg1 is empty"'               to asCode[1]
            Move 'Move 0 to arg1 // resets arg1 here'   to asCode[2]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Global_Variable String gsArg1'          asCode[0]
            Send AssertSAreEqual 'Showln "arg1 is empty"'                 asCode[1]
            Send AssertSAreEqual 'Move 0 to gsArg1 // resets arg1 here'   asCode[2]
        End_Procedure

        // A line that continues the one above it is no declaration (2026-10-31): the parameter lines of a
        // multi-line External_Function stay as they are, and a declaration after the statement still converts.
        { Published = True }
        Procedure RefactorBareGlobals_ContinuedLineIsNoDeclaration
            String[] asCode
            Integer iCount
            Move 'External_Function Win32_WNetGetUser "WNetGetUserA" MPR.dll ;' to asCode[0]
            Move '   Pointer lpName;'                                          to asCode[1]
            Move '   String  lpnLength;'                                       to asCode[2]
            Move '   Returns DWord'                                            to asCode[3]
            Move 'String sAfter'                                               to asCode[4]
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '   String  lpnLength;'           asCode[2]
            Send AssertSAreEqual '   Returns DWord'                asCode[3]
            Send AssertSAreEqual 'Global_Variable String gsAfter'  asCode[4]
        End_Procedure

        // A name another file of the run reads keeps it (2026-10-31: a shell's 'Integer sPer' became giSPer while
        // its view still read sPer), on files in the Windows TEMP folder: the declaration still becomes
        // Global_Variable, a run note names the reader, and the other name is renamed - a file that declares it
        // itself, or names it only in a comment and a string, is no reader.
        { Published = True }
        Procedure RefactorBareGlobals_KeepsANameAnotherFileReads
            tRefactorSettings Settings Saved
            String[] asCode asShell asView asOther asNote asNotes asNone
            String sRoot sNotes
            Integer iCount i
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_BareGlobals\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Send Assert bOk "the fixture folder"
            Move 'Integer sPer'                     to asShell[0]
            Move 'String sOther'                    to asShell[1]
            Move 'Move 0 to sPer'                   to asShell[2]
            Move 'Move "" to sOther'                to asShell[3]
            Move 'Object oView is a View'           to asView[0]
            Move '    Procedure Show'               to asView[1]
            Move '        Move 1 to sPer'           to asView[2]
            Move '    End_Procedure'                to asView[3]
            Move 'End_Object'                       to asView[4]
            Move 'String sOther'                    to asOther[0]
            Move 'Move "x" to sOther'               to asOther[1]
            Move '// sOther is set by the shell'    to asNote[0]
            Move 'Showln "sOther"'                  to asNote[1]
            Send _WriteLines (sRoot + "Shell.src") asShell
            Send _WriteLines (sRoot + "View.vw")   asView
            Send _WriteLines (sRoot + "Other.src") asOther
            Send _WriteLines (sRoot + "Note.vw")   asNote

            Get pRefactorSettings of ghoFuncLib to Saved
            Move Saved to Settings
            Move (ResizeArray(Settings.FileData.asFullFileNames, 0)) to Settings.FileData.asFullFileNames
            Move (sRoot + "Shell.src") to Settings.FileData.asFullFileNames[0]
            Move (sRoot + "View.vw")   to Settings.FileData.asFullFileNames[1]
            Move (sRoot + "Other.src") to Settings.FileData.asFullFileNames[2]
            Move (sRoot + "Note.vw")   to Settings.FileData.asFullFileNames[3]
            Set pRefactorSettings of ghoFuncLib to Settings
            Set pbNameReadersBuilt of ghoFuncLib to False
            Set pasRunNotes of ghoFuncLib to asNone

            Move asShell to asCode
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Get pasRunNotes of ghoFuncLib to asNotes
            Set pRefactorSettings of ghoFuncLib to Saved
            Set pbNameReadersBuilt of ghoFuncLib to False
            Move (rfRemoveFolderTree(sRoot)) to bOk

            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual 'Global_Variable Integer sPer'     asCode[0]
            Send AssertSAreEqual 'Global_Variable String gsOther'   asCode[1]
            Send AssertSAreEqual 'Move 0 to sPer'                   asCode[2]
            Send AssertSAreEqual 'Move "" to gsOther'               asCode[3]
            Move "" to sNotes
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sNotes + asNotes[i] + " | ") to sNotes
            Loop
            Send Assert (Pos("sPer keeps its name", sNotes) > 0 and Pos("View.vw", sNotes) > 0) ("the note names the view: " + sNotes)
            Send Assert (Pos("sOther", sNotes) = 0) ("no note for sOther: " + sNotes)
        End_Procedure


        // The shape of a Data Access report (2026-11-27): ';' straight after the DLL name, the parameter lines
        // not indented, a comment line above. None of it is a declaration - the run must change nothing.
        { Published = True }
        Procedure RefactorBareGlobals_ExternalFunctionOneParameterPerLine
            String[] asCode asBefore
            Integer iCount i
            Move '// VDF has 255 char limit on statements hence abc etc'   to asCode[0]
            Move 'External_Function CreateFont "CreateFontA" GDI32.dll;'   to asCode[1]
            Move 'Integer a;'                                              to asCode[2]
            Move 'Integer b;'                                              to asCode[3]
            Move 'Integer e;'                                              to asCode[4]
            Move 'DWord f;'                                                to asCode[5]
            Move 'Pointer n;'                                              to asCode[6]
            Move 'Returns Integer'                                         to asCode[7]
            Move asCode to asBefore
            Get RefactorBareGlobalsToGlobalVariable of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            For i from 0 to 7
                Send AssertSAreEqual asBefore[i] asCode[i]
            Loop
        End_Procedure

    End_Object
