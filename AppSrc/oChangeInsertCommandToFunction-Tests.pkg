    Object oChangeInsertCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeInsertCommandToFunction"

        {Published = True}
        Procedure ChangeInsertCommandToFunction_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move ' If sOne Eq "A" Insert "_" in sOne at 2' to sLine
            Move ' If sOne Eq "A" Move (Insert("_",sOne,2)) to sOne' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInsertCommandToFunction_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   Insert "   " in sVar at 2' to sLine
            Move '   Move (Insert("   ",sVar,2)) to sVar' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInsertCommandToFunction_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   Replace sChr In sTag with (uppercase(sChr))' to sLine
            Move '   Replace sChr In sTag with (uppercase(sChr))' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInsertCommandToFunction_4
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "INSERT 'chmod 777 ' IN WK_CHAIN_ARG AT 1" to sLine
            Move "Move (Insert('chmod 777 ',WK_CHAIN_ARG,1)) to WK_CHAIN_ARG" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // 'Send Insert <arg>' is a message dispatch to a control's Insert method, NOT the Insert command
        // (which requires 'in <collection>'). It must be left untouched, never mangled into
        // 'Send Move (Insert(...,,)) to' (LegacyApp XMLE0100.vw regression).
        {Published = True}
        Procedure ChangeInsertCommandToFunction_SendMessageKept
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Send Insert sText' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Send Insert sText' sLine
        End_Procedure

        // No 'At <pos>' clause -> the REQUIRED 1-based position defaults to 1, never an empty 3rd slot
        // ('Insert(v,a,)' is a syntax error) nor a 2-arg call (Nils 2026-07-06, 'insert " " in slimit').
        {Published = True}
        Procedure ChangeInsertCommandToFunction_NoPosition
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    insert " " in slimit' to sLine
            Move '    Move (Insert(" ",slimit,1)) to slimit' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The guarding condition carries its OWN 'In' (legacy 'x In "A|B"'): the command's clauses are
        // the ones AFTER the Insert token, never the first 'In' on the line. Before 2026-09-19 the
        // target became the string constant - 'Move (Insert("+","PARAMNT |HONGKONG",1)) to "PARAMNT
        // |HONGKONG"' (Nils, a 2005-era workspace). The condition is left for ChangeInToContains.
        {Published = True}
        Procedure ChangeInsertCommandToFunction_InClauseAfterTheCommandNotTheConditions
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        If transac.vendor_cd In  "PARAMNT |HONGKONG" Insert "+" In pItemBody.1 At 1 //c28r' to sLine
            Move '        If transac.vendor_cd In  "PARAMNT |HONGKONG" Move (Insert("+",pItemBody.1,1)) to pItemBody.1 //c28r' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ...and an 'In' BEFORE the command with none after it is not the command's: untouched.
        {Published = True}
        Procedure ChangeInsertCommandToFunction_InOnlyBeforeTheCommandIsNotItsClause
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If sKey In sSet Send Insert sText' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If sKey In sSet Send Insert sText' sLine
        End_Procedure

    End_Object
