    Send RegisterInternalCommand  CMD_CUT                         "Cut"                       "Cuts the selection and puts it on the clipboard"
    Send RegisterInternalCommand  CMD_COPY                        "Copy"                      "Copies the selection to the clipboard"
    Send RegisterInternalCommand  CMD_CHARTRANSPOSE               "CharTranspose"             "Swap characters around the insertion point"
    Send RegisterInternalCommand  CMD_CHARRIGHTEXTEND             "CharRightExtend"           "Extends the selection one character to the right"
    Send RegisterInternalCommand  CMD_CHARRIGHT                   "CharRight"                 "Moves the cursor one character to the right"
    Send RegisterInternalCommand  CMD_CHARLEFTEXTEND              "CharLeftExtend"            "Extends the selection one character to the left"
    Send RegisterInternalCommand  CMD_CHARLEFT                    "CharLeft"                  "Moves the cursor one character to the left"
    Send RegisterInternalCommand  CMD_BOOKMARKTOGGLE              "BookmarkToggle"            "Toggles a bookmark for the current line on and off"
    Send RegisterInternalCommand  CMD_BOOKMARKPREV                "BookmarkPrev"              "Moves to the line containing the previous bookmark"
    Send RegisterInternalCommand  CMD_BOOKMARKNEXT                "BookmarkNext"              "Moves to the line containing the next bookmark"
    Send RegisterInternalCommand  CMD_BOOKMARKCLEARALL            "BookmarkClearAll"          "Clears all bookmarks in the window"
    Send RegisterInternalCommand  CMD_BOOKMARKJUMPTOFIRST         "BookmarkJumpToFirst"       "Moves to the first line containing a bookmark"
    Send RegisterInternalCommand  CMD_BOOKMARKJUMPTOLAST          "BookmarkJumpToLast"        "Moves to the last line containing a bookmark"
    Send RegisterInternalCommand  CMD_APPENDNEXTCUT               "AppendNextCut"             "Appends the next cut text to end of clipboard"
    Send RegisterInternalCommand  CMD_INSERTCHAR                  "InsertChar"                "Inserts a character at the current location"
    Send RegisterInternalCommand  CMD_NEWLINE                     "NewLine"                   "Inserts a new-line character at the current location"
    Send RegisterInternalCommand  CMD_RECORDMACRO                 "RecordMacro"               "Begins/ends keystroke macro recording"
    Send RegisterInternalCommand  CMD_PLAYMACRO1                  "PlayMacro1"                "Plays keystroke macro 1"
    Send RegisterInternalCommand  CMD_PLAYMACRO2                  "PlayMacro2"                "Plays keystroke macro 2"
    Send RegisterInternalCommand  CMD_PLAYMACRO3                  "PlayMacro3"                "Plays keystroke macro 3"
    Send RegisterInternalCommand  CMD_PLAYMACRO4                  "PlayMacro4"                "Plays keystroke macro 4"
    Send RegisterInternalCommand  CMD_PLAYMACRO5                  "Playmacro5"                "Plays keystroke macro 5"
    Send RegisterInternalCommand  CMD_PLAYMACRO6                  "Playmacro6"                "Plays keystroke macro 6"
    Send RegisterInternalCommand  CMD_PLAYMACRO7                  "Playmacro7"                "Plays keystroke macro 7"
    Send RegisterInternalCommand  CMD_PLAYMACRO8                  "Playmacro8"                "Plays keystroke macro 8"
    Send RegisterInternalCommand  CMD_PLAYMACRO9                  "Playmacro9"                "Plays keystroke macro 9"
    Send RegisterInternalCommand  CMD_PLAYMACRO10                 "Playmacro10"               "Plays keystroke macro 10"
    Send RegisterInternalCommand  CMD_PROPERTIES                  "Properties"                "Displays the properties dialog"
    Send RegisterInternalCommand  CMD_BEGINUNDO                   "BeginUndo"                 "Starts an undo transaction"
    Send RegisterInternalCommand  CMD_ENDUNDO                     "EndUndo"                   "Ends an undo transaction"
    //Send RegisterInternalCommand  CMD_RESERVED3                   "" ""  // internal use only (1227)

    Send RegisterInternalCommand  CMD_TOGGLEREGEXP                "ToggleRegExp"              "Toggles regular expression searching on and off"
    Send RegisterInternalCommand  CMD_CLEARSELECTION              "ClearSelection"            "Empties the selection"
    Send RegisterInternalCommand  CMD_REGEXPON                    "RegExpOn"                  "Turns on regular expression searching"
    Send RegisterInternalCommand  CMD_REGEXPOFF                   "RegExpOff"                 "Turns off regular expression searching"
    Send RegisterInternalCommand  CMD_WHOLEWORDON                 "WholeWordOn"               "Turns on whole word searching"
    Send RegisterInternalCommand  CMD_WHOLEWORDOFF                "WholeWordOff"              "Turns off whole word searching"
    Send RegisterInternalCommand  CMD_PRESERVECASEON              "PreserveCaseOn"            "Turns on case preservation when replacing text"
    Send RegisterInternalCommand  CMD_PRESERVECASEOFF             "PreserveCaseOff"           "Turns off case preservation when replacing text"
    Send RegisterInternalCommand  CMD_CASESENSITIVEON             "CaseSensitiveOn"           "Turns on case sensitive searching"
    Send RegisterInternalCommand  CMD_CASESENSITIVEOFF            "CaseSensitiveOff"          "Turns off case sensitive searching"
    Send RegisterInternalCommand  CMD_WHITESPACEDISPLAYON         "WhiteSpaceDisplayOn"       "Turns on white space display"
    Send RegisterInternalCommand  CMD_WHITESPACEDISPLAYOFF        "WhiteSpaceDisplayOff"      "Turns off white space display"
    Send RegisterInternalCommand  CMD_OVERTYPEON                  "OvertypeOn"                "Turns on overtype mode"
    Send RegisterInternalCommand  CMD_OVERTYPEOFF                 "OvertypeOff"               "Turns off overtype mode"
    Send RegisterInternalCommand  CMD_CODELIST                    "CodeList"                  "Activates the code list control"
    Send RegisterInternalCommand  CMD_CODETIP                     "CodeTip"                   "Activates the code tip control"
    //Send RegisterInternalCommand  CMD_LAST                        "" ""
End_Procedure

// Registers commands for CodeMax so that these function can be accessed in macros and keyAssignments
// This does only the registration! Connecting these commands to the actual code needs to be
// done in the DefinePredefinedHotKeys of cEditorHotKey_Mixin
Procedure RegisterExtraCommands

    // File Menu. 1-9
    DeclareEditorCommand CMD_FileOpenFile               1 "FileOpenFile"            "Opens a file"
    DeclareEditorCommand CMD_FileSaveFile               2 "FileSaveFile"            "Saves the file"
    DeclareEditorCommand CMD_FileSaveFileAs             3 "FileSaveFileAs"          "Save file as..."
    DeclareEditorCommand CMD_FileSaveAll                4 "FileSaveAll"             "Saves all opened files"
    DeclareEditorCommand CMD_FileCloseFile              5 "FileCloseFile"           "Closes the file"
    DeclareEditorCommand CMD_FileCloseAllFiles          6 "FileCloseAllFiles"       "Closes all files"
    DeclareEditorCommand CMD_FileNewFile                7 "FileNewFile"             "Create a new file"

    // Options Menu 10-19
    DeclareEditorCommand CMD_FindInFiles                10 "FindInFiles"            "Search the text in multiple files"
    DeclareEditorCommand CMD_SelectWorkSpace            11 "SelectWorkSpace"       "Select another workspace to work in"

    // Build Menu 20-29
    DeclareEditorCommand CMD_BuildRun                   20 "BuildRun"                "Compiles and runs the main program (or current file if is '.SRC')"
    DeclareEditorCommand CMD_BuildRunCurrent            21 "BuildRunCurrent"         "Compiles and runs the current file"
    DeclareEditorCommand CMD_BuildCompileCurrent        22 "BuildCompile"            "Compiles the current file"
    DeclareEditorCommand CMD_BuildPreCompile            23 "BuildPrecompile"         "PreCompiles the current file"
    DeclareEditorCommand CMD_BuildExecute               24 "BuildExecute"            "Starts the main program (or current file if it is '.SRC') without compiling"
    DeclareEditorCommand CMD_BuildDebugRun              25 "BuildDebugRun"           "ReCompiles with debug info and starts the main program"
    DeclareEditorCommand CMD_BuildDebugRunCurrent       26 "BuildDebugRunCurrent"    "ReCompiles with debug info and starts the current program"

    // Window Menu. 40-49
    DeclareEditorCommand CMD_WindowSwitchToCodeView     40 "WindowSwitchToCodeView"   "Activates the codeview window"
    DeclareEditorCommand CMD_WindowSwitchToErrorView    41 "WindowSwitchToErrorView"  "Activates the error window"
    DeclareEditorCommand CMD_WindowSyncCodeView         42 "WindowSyncCodeView"       "Synchronizes the CodeView with cursorposition"
    DeclareEditorCommand CMD_WindowNextView             43 "WindowNextView"           "Activates the next view"
    DeclareEditorCommand CMD_WindowPreviousView         44 "WindowPreviousView"       "Activates the privious view"

    // Lists 50-59
    DeclareEditorCommand CMD_ListCreator                50 "ListCreator"              "Activates the Creator list"
    DeclareEditorCommand CMD_ListObjects                51 "ListObjects"              "Activates the Object List"
    DeclareEditorCommand CMD_ListVars                   52 "ListVariables"            "Activates the Variables List"
    DeclareEditorCommand CMD_ListKeys                   53 "ListKeys"                 "Activates the Keys List"
    DeclareEditorCommand CMD_ListProcedures             54 "ListProcedures"           "Activates the Procedures List (Overwriting)"
    DeclareEditorCommand CMD_ListFunctions              55 "ListFunctions"            "Activates the Functions List (Overwriting)"
    DeclareEditorCommand CMD_ListClasses                56 "ListClasses"              "Activates the Classes List"
    DeclareEditorCommand CMD_ListIDETags                57 "ListIDETags"              "Activates the List with IDE tags"


    // Mixed. 60-69
    DeclareEditorCommand CMD_ToggleComment              60 "ToggleComment"              "Toggled the current line comment"
    DeclareEditorCommand CMD_ToolsInsertHeaderGlobal    61 "ToolsInsertHeaderGlobal"    "Inserts a header into the current file (global)"
    DeclareEditorCommand CMD_ToolsInsertHeaderUser      62 "ToolsInsertHeaderUser"      "Inserts a header into the current file (userspecific)"
    DeclareEditorCommand CMD_OpenFileUnderCursor        63 "OpenFileUnderCursor"        "Tries to open the file under the current cursorposition"
    DeclareEditorCommand CMD_InsertRevisionMark         64 "InsertRevisionMark"         "Inserts a Revisionmark"
    DeclareEditorCommand CMD_InsertColor                65 "InsertColor"                "Inserts a RGB Color value"

    // Convertion 70-79
    DeclareEditorCommand CMD_ConvertOnItemToAddItem   70 "ConvertOnItemToAddItem"       "Converts On_Item block to send Add_Item and back"
    DeclareEditorCommand CMD_ConvertCStructToVDF      71 "ConvertCStructToVDF"          "Converts a C structure to VDF syntax"
    DeclareEditorCommand CMD_ConvertCDllCallToVDF     72 "ConvertCDllCallToVDF"         "Converts a C Dll call to VDF syntax"
    DeclareEditorCommand CMD_ConvertVDFTypeToHandler  73 "ConvertVDFTypeToHandler"      "Converts a VDF TYPE structure to a Handler class"

    DeclareEditorCommand CMD_MarkScopeBlock           74 "MarkScopeBlock"               "Marks the current Scope Begin/End block for the current Line"

    // v3.0 by SVN
    DeclareEditorCommand CMD_MOVELINEUP               75 "MoveLineUp"                   "Moves selected editor's code line up"
    DeclareEditorCommand CMD_MOVELINEDOWN             76 "MoveLineDown"                 "Moves selected editor's code line down"
    DeclareEditorCommand CMD_DUPLICATESELECTION       77 "DuplicateSelection"           "Duplicates selection or code line"

    // by WvA
    DeclareEditorCommand CMD_DEBUGPERFCOUNTERS        78 "Performance counters"         "Displays some statistics using performance counters (used for debugging purposes)"
    DeclareEditorCommand CMD_REFACTORDROPSELF         79 "Refactor Drop Self"           "Refactor option to clean up Self references that are not required in recent code"
    DeclareEditorCommand CMD_REFACTOROBJECTNEIGHBORHOOD 80 "Refactor Object Neighborhood" "Refactor option to clean up nested object references that are not required anymore due to object neighborhood logic"
    DeclareEditorCommand CMD_REFACTORREINDENT         81 "Refactor Re-Indent"           "Refactor option to remove all existing indentation in the current file and replace it with your preferred indentation settings"
    DeclareEditorCommand CMD_GOTOFIRSTINDENTMISMATCH  82 "GoTo First Indent Mismatch"   "Will try to locate the first line that mismatches the current indentation rules."
    DeclareEditorCommand CMD_REFACTORMETHODEXTRACT    83 "Method extract"               "Extract the selected lines of code for method extraction"

    /* Quick Marks (2026-09-10) - a STACK of places rather than a set of bookmarks: Push records
       where the caret is, Pop returns to the newest place recorded, in another file when that
       is where it was pushed. The stack is cQuickMarkStack, driven from cRefactorScintillaEditor;
       these are the two rebindable commands over it. Defaults Ctrl+Q / Ctrl+Shift+Q below. */
    DeclareEditorCommand CMD_QuickMarkPush            84 "QuickMarkPush"                "Pushes the current line onto the Quick Mark stack"
    DeclareEditorCommand CMD_QuickMarkPop             85 "QuickMarkPop"                 "Pops the newest Quick Mark and returns to it"
    // Go to definition (same day) - the Studio's Ctrl+Shift+G; pushes a Quick Mark before it jumps.
    DeclareEditorCommand CMD_GotoDefinition           86 "GotoDefinition"               "Jumps to where the word under the cursor is defined"
End_Procedure

Send RegisterAllInternalCommands
Send RegisterExtraCommands


Function SetEditorHotKeys Global String sHotKeys Returns Integer
    If (sHotKeys="") Begin
        Get DefaultDefinitions of oSciCommandHotKeys to sHotKeys
    End
    Set ShortCutKeyDefinitions of oSciCommandHotKeys to sHotKeys
    Function_Return 1
End_Function

// Not used in The Hammer
//Function CMResetDefaultHotKeys global  Returns Integer
//  send DevTest "CMResetDefaultHotKeys"
//  function_return 0
//End_Function
// CMGetHotKeysForCmd was here. Its entire body was "Send DevTest" - a debugging marker
// in cSciLexer.h for a function nobody implemented - and it returned 0 unconditionally.
// Nothing in DFRefactor called it. Carrying it home would have meant importing DevTest
// to keep a no-op alive.

//
// Is there a hotkey defined for the following command? If so then return
// the hotkey as a string
//
Function CommandHotKeyText Integer iCmd Returns String
    String sRet
    tSciCommandHotKey Command

    Move "" to sRet
    Get FindCommand of oSciCommandHotKeys iCmd to Command
    If (Command.iCmd>-1 and Command.iCmd=iCmd) Begin
        Get CommandHotKeyString of oSciCommandHotKeys Command to sRet
    End
    Function_Return sRet
End_Function


