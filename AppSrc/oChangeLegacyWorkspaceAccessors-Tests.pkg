// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeLegacyWorkspaceAccessors is a cTestFixture
        Set psFunctionName to "ChangeLegacyWorkspaceAccessors"

        // The dominant real-world shape (~160x in the study workspace): indent + the @-suffixed
        // legacy global destination both survive the rewrite.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_ProgramPath
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Get CurrentProgramPath of ghoWorkSpace to sokvagappsrc@' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Get psProgramPath of (phoWorkspace(ghoApplication)) to sokvagappsrc@' sLine
        End_Procedure

        // The second family member, and the mixed 'ghoWorkSpace' casing.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_DataPath
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentDataPath of ghoWorkSpace to sDataPath' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath' sLine
        End_Procedure

        // The legacy CurrentBitMapPath spelling maps case-insensitively to psBitmapPath.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_BitmapPath
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentBitMapPath of ghoWorkspace to sBmpPath' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Get psBitmapPath of (phoWorkspace(ghoApplication)) to sBmpPath' sLine
        End_Procedure

        // A trailing comment rides along.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_CommentPreserved
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentProgramPath of ghoWorkspace to sPath // where we run' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Get psProgramPath of (phoWorkspace(ghoApplication)) to sPath // where we run' sLine
        End_Procedure

        // An accessor with NO clean modern equivalent must pass through untouched.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_UnmappedUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentModuleName of ghoWorkspace to sMod' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Get CurrentModuleName of ghoWorkspace to sMod' sLine
        End_Procedure

        // Only ghoWorkspace reads convert - the same accessor on ANOTHER object is not ours.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_OtherObjectUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentProgramPath of oMyWorkspace to sPath' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Get CurrentProgramPath of oMyWorkspace to sPath' sLine
        End_Procedure

        // Only the Get command shape converts - an expression use bails untouched.
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_ExpressionUseUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move (CurrentProgramPath(ghoWorkspace)) to sPath' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Move (CurrentProgramPath(ghoWorkspace)) to sPath' sLine
        End_Procedure

        // A line going on over ';' stays as written, and the Deep Scan gives it no row either (DS 9253).
        {Published = True}
        Procedure ChangeLegacyWorkspaceAccessors_ContinuedLineUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get CurrentProgramPath of ghoWorkspace to ;' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyWorkspaceAccessors of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Get CurrentProgramPath of ghoWorkspace to ;' sLine
        End_Procedure

    End_Object
