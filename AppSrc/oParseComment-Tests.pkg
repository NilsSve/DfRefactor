//****************************************************************************
// $Module type: Test fixture
// $Module name: oParseComment-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-05
//
// Description : Unit tests for ParseComment (cRefactorFuncLib) - the { Description } meta-tag parser that
//               RegisterInterface feeds and the startup meta-sync consumes. Regression focus (2026-07-05):
//               { ParamHelp } may span several lines, and the OLD ParseHelpTopic swallowed EVERY remaining
//               line of the Description - a { SummaryText } placed after { ParamHelp } was never parsed, so
//               the startup sync saw a blank parsed summary and WIPED Functions.SummaryText on every launch
//               (12 parameterized functions showed an empty Summary Text in the Functions list).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oParseComment is a cTestFixture
        Set psFunctionName to "ParseComment"

        // The regression shape: a multi-line ParamHelp FOLLOWED by SummaryText - both must parse,
        // and the summary text must not leak into the param help.
        {Published = True}
        Procedure ParseComment_SummaryAfterMultiLineParamHelp
            String sCRLF sComment
            tFuncLib FuncLib

            Move (Character(13) + Character(10)) to sCRLF
            Move ("Converts grids." + sCRLF) to sComment
            Append sComment ("{ MethodType = eOtherFunctionAll }" + sCRLF)
            Append sComment ("{ EnumList = " + '"ANY"' + " }" + sCRLF)
            Append sComment ("{ InitialValue = Grid,cCJGrid }" + sCRLF)
            Append sComment ("{ ParamHelp = Three comma separated class names;" + sCRLF)
            Append sComment ("\nMyGrid - Workspace subclass of Grid,"                + sCRLF)
            Append sComment ("\nMycCJGrid - Workspace subclass of cCJGrid }"         + sCRLF)
            Append sComment ("{ SummaryText = Refactored: Grid -> cCJGrid }"    + sCRLF)
            Get ParseComment of ghoFuncLib sComment to FuncLib
            Send AssertSAreEqual "Refactored: Grid -> cCJGrid" (Trim(FuncLib.sSummary))
            Send Assert (FuncLib.FuncEnumList.sParamHelp contains "Three comma separated class names")
            Send Assert (FuncLib.FuncEnumList.sParamHelp contains "Workspace subclass of cCJGrid")
            Send AssertFalse (FuncLib.FuncEnumList.sParamHelp contains "Refactored:")
            Send AssertFalse (FuncLib.FuncEnumList.sParamHelp contains "}")
        End_Procedure

        // Single-line ParamHelp followed by SummaryText - both parse.
        {Published = True}
        Procedure ParseComment_SummaryAfterSingleLineParamHelp
            String sCRLF sComment
            tFuncLib FuncLib
            Move (Character(13) + Character(10)) to sCRLF
            Move ("Does things." + sCRLF) to sComment
            Append sComment ("{ MethodType = eStandardFunction }" + sCRLF)
            Append sComment ("{ ParamHelp = Valid values are listed }" + sCRLF)
            Append sComment ("{ SummaryText = Changed: a thing }" + sCRLF)
            Get ParseComment of ghoFuncLib sComment to FuncLib
            Send AssertSAreEqual "Changed: a thing" (Trim(FuncLib.sSummary))
            Send AssertSAreEqual "Valid values are listed" (Trim(FuncLib.FuncEnumList.sParamHelp))
        End_Procedure

        // The reverse order (SummaryText before ParamHelp) keeps working.
        {Published = True}
        Procedure ParseComment_SummaryBeforeParamHelp
            String sCRLF sComment
            tFuncLib FuncLib
            Move (Character(13) + Character(10)) to sCRLF
            Move ("Does things." + sCRLF) to sComment
            Append sComment ("{ MethodType = eStandardFunction }" + sCRLF)
            Append sComment ("{ SummaryText = Changed: a thing }" + sCRLF)
            Append sComment ("{ ParamHelp = Valid values are listed }" + sCRLF)
            Get ParseComment of ghoFuncLib sComment to FuncLib
            Send AssertSAreEqual "Changed: a thing" (Trim(FuncLib.sSummary))
            Send AssertSAreEqual "Valid values are listed" (Trim(FuncLib.FuncEnumList.sParamHelp))
        End_Procedure

        // A ParamHelp whose closing brace was FORGOTTEN in the source (the EditorReIndent shape,
        // 2026-07-05): the tag ends at the next tag's opening line instead of swallowing it, so
        // the following SummaryText still parses.
        {Published = True}
        Procedure ParseComment_UnclosedParamHelp_SummaryStillParses
            String sCRLF sComment
            tFuncLib FuncLib
            Move (Character(13) + Character(10)) to sCRLF
            Move ("Reindents the source code." + sCRLF) to sComment
            Append sComment ("{ MethodType = eEditorFunction }" + sCRLF)
            Append sComment ("{ ParamHelp = Select the indent size;" + sCRLF)
            Append sComment ("\nIt is the same value as the Editor Settings tab size." + sCRLF)
            Append sComment ("{ SummaryText = Reindented code }" + sCRLF)
            Get ParseComment of ghoFuncLib sComment to FuncLib
            Send AssertSAreEqual "Reindented code" (Trim(FuncLib.sSummary))
            Send Assert (FuncLib.FuncEnumList.sParamHelp contains "Select the indent size")
            Send AssertFalse (FuncLib.FuncEnumList.sParamHelp contains "Reindented")
        End_Procedure

        // No SummaryText at all: the parsed summary is blank and ParamHelp is intact.
        {Published = True}
        Procedure ParseComment_ParamHelpOnly
            String sCRLF sComment
            tFuncLib FuncLib
            Move (Character(13) + Character(10)) to sCRLF
            Move ("Does things." + sCRLF) to sComment
            Append sComment ("{ MethodType = eStandardFunction }" + sCRLF)
            Append sComment ("{ ParamHelp = Valid values are listed }" + sCRLF)
            Get ParseComment of ghoFuncLib sComment to FuncLib
            Send AssertSAreEqual "" (Trim(FuncLib.sSummary))
            Send AssertSAreEqual "Valid values are listed" (Trim(FuncLib.FuncEnumList.sParamHelp))
        End_Procedure

    End_Object
