//****************************************************************************
// $Module type: Test fixture
// $Module name: oModAnalyzer-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-08
//
// Description : Unit tests for cModAnalyzer.ClassifyMessage - the .err triage "brain" (Phase 1).
//               Pure lookup: a compiler error number (+ its text) -> a fix recipe (category,
//               human label, one-line hint, and the refactor function that addresses it).
//               Read-only; makes no source changes. String compares use boolean Assert (not
//               AssertSAreEqual) to match the rest of the Win64/Unicode fixtures.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
    Object oModAnalyzer is a cTestFixture
        Set psFunctionName to "ModAnalyzer"

        // Helper: create the analyzer, classify one error, return the recipe.
        Function MakeRecipe Integer iErrorNo String sErrorTxt Returns tModAnalyzer
            Handle ho
            tModAnalyzer Recipe
            tModAnalyzer[] aRecipes
            Get Create (RefClass(cModAnalyzer)) to ho
            // Classify against the in-memory defaults (the seed source) - keeps the
            // unit tests pure: no ModAnalyzer table / database access needed.
            Get BuildDefaultRecipes of ho to aRecipes
            Get ClassifyFromRecipes of ho iErrorNo sErrorTxt aRecipes to Recipe
            Send Destroy of ho
            Function_Return Recipe
        End_Function

        // Helper (2026-11-13): a grid / list converter's class-missing recipe, as its ModRecipe tag seeds it.
        Function GridConverterRecipe String sMatch String sFn Returns tModAnalyzer
            tModAnalyzer Recipe
            Move 4345        to Recipe.iMsgNumber
            Move sMatch      to Recipe.sMatchText
            Move sFn         to Recipe.sRefactorFn
            Move eModSuggest to Recipe.eCategory
            Move "Refactors legacy grid objects to a CodeJock grid class." to Recipe.sHint
            Function_Return Recipe
        End_Function

        // Helper (2026-11-13): the function names of every recipe the defaults match for one message.
        Function MatchedFunctions Integer iErrorNo String sErrorTxt Returns String
            Handle ho
            tModAnalyzer[] aRecipes aMatched
            String sOut
            Integer i
            Get Create (RefClass(cModAnalyzer)) to ho
            Get BuildDefaultRecipes of ho to aRecipes
            Get MatchingRecipesFromList of ho iErrorNo sErrorTxt (&aRecipes) to aMatched
            Send Destroy of ho
            Move "|" to sOut
            For i from 0 to (SizeOfArray(aMatched) - 1)
                Move (sOut + Trim(aMatched[i].sRefactorFn) + "|") to sOut
            Loop
            Function_Return sOut
        End_Function

        /* A CLASS WITH NO USE FOR ITS PACKAGE (2026-11-13): "Class cMyDbList is a DBList" in a package that never Used
           Dfsellst.pkg - DataFlex 26's DfAllEnt no longer brings it. Both messages offer MakeFileAutonomous, which adds
           the Use; the dbList converter's own recipe still matches beside it, and the SELECT variant of 4345 is not a
           class at all. */
        {Published = True}
        Procedure ModAnalyzer_ClassWithNoUseOffersMakeFileAutonomous
            String s
            Get MatchedFunctions 4345 "Type check error U_DBLIST, MUST BE DEFINED" to s
            Send Assert (Pos("|MakeFileAutonomous|", s) > 0) s
            Send Assert (Pos("|RefactorDbListTocDbCJGridPromptList|", s) > 0) s
            Get MatchedFunctions 4328 "Undefined symbol in argument U_CSOMECLASS" to s
            Send Assert (Pos("|MakeFileAutonomous|", s) > 0) s
            Get MatchedFunctions 4345 "Type check error SELECT, MUST BE DEFINED" to s
            Send Assert (Pos("|MakeFileAutonomous|", s) = 0) s
        End_Procedure

        /* ...AND THE LINE DECIDES FOR THE GRID CONVERTERS: their class-missing recipes are source-guarded now, so
           VerifyLegacyClassShape reaches them (it never ran for these until 2026-11-13); MakeFileAutonomous is
           dry-run per file. */
        {Published = True}
        Procedure ModAnalyzer_ClassMissingRowsAreGuarded
            Handle ho
            tModAnalyzer Recipe
            Boolean b
            Get Create (RefClass(cModAnalyzer)) to ho
            Move 4345 to Recipe.iMsgNumber
            Move "U_DBLIST" to Recipe.sMatchText
            Move "RefactorDbListTocDbCJGridPromptList" to Recipe.sRefactorFn
            Move eModSuggest to Recipe.eCategory
            Get RecipeNeedsSourceGuard of ho Recipe to b
            Send Assert b "the dbList converter's U_DBLIST row reads its line"
            Move "U_DBGRID" to Recipe.sMatchText
            Move "RefactorDbGridTocDbCJGrid" to Recipe.sRefactorFn
            Get RecipeNeedsSourceGuard of ho Recipe to b
            Send Assert b "the dbGrid converter's U_DBGRID row reads its line"
            Move "error u_" to Recipe.sMatchText
            Move "MakeFileAutonomous" to Recipe.sRefactorFn
            Move eModAutoFix to Recipe.eCategory
            Get RecipeNeedsSourceGuard of ho Recipe to b
            Send Assert b "MakeFileAutonomous is dry-run per file"
            Send Destroy of ho
        End_Procedure

        // AmbiguousFnNameFromText lives on cModAnalyzer, so reach it through an instance (like MakeRecipe).
        Function AmbigName String sText Returns String
            Handle ho
            String s
            Get Create (RefClass(cModAnalyzer)) to ho
            Get AmbiguousFnNameFromText of ho sText to s
            Send Destroy of ho
            Function_Return s
        End_Function

        Function BackName String sText Returns String
            Handle ho
            String s
            Get Create (RefClass(cModAnalyzer)) to ho
            Get BackportNameFromText of ho sText to s
            Send Destroy of ho
            Function_Return s
        End_Function

        // 4390 shape 1: "Global method GET <NAME> already defined" - note the SPACE after GET, unlike 4544.
        {Published = True}
        Procedure ModAnalyzer_BackportName_GlobalMethod
            String s
            Get BackName "Illegal method name definition Global method GET SPLIT already defined" to s
            Send AssertSAreEqual "SPLIT" s
        End_Procedure

        // 4390 shape 2: the name precedes "is already defined as an external_function".
        {Published = True}
        Procedure ModAnalyzer_BackportName_ExternalFunction
            String s
            Get BackName "Illegal method name definition WINAPI_INTERNETQUERYOPTION is already defined as an external_function" to s
            Send AssertSAreEqual "WINAPI_INTERNETQUERYOPTION" s
        End_Procedure

        // NEGATIVE: an unrelated message yields nothing rather than a bogus name.
        {Published = True}
        Procedure ModAnalyzer_BackportName_NoMatch
            String s
            Get BackName "Some other compiler message entirely" to s
            Send AssertSAreEqual "" s
        End_Procedure

        // 4539 Pointer->String: Auto-fix, routes to UnicodePointerToString.
        {Published = True}
        Procedure ModAnalyzer_4539_PointerToString_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4539 "Conversion from Pointer to String is not allowed, use PointerToString function" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "UnicodePointerToString")
        End_Procedure

        // 4539 String->Pointer: Auto-fix, routes to UnicodeStringToPointer.
        {Published = True}
        Procedure ModAnalyzer_4539_StringToPointer_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4539 "Conversion from String to Pointer is not allowed, use MemCopy function" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "UnicodeStringToPointer")
        End_Procedure

        // 4534 ToOEM/ToANSI: Auto-fix via UnicodeOemAnsiFunctions (the auto-rewritable OEM/ANSI calls).
        {Published = True}
        Procedure ModAnalyzer_4534_ToOem_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4534 "Obsolete use of ToOEM, use Utf8ToOem or AnsiToUtf8 instead." to Recipe
            Send Assert (Recipe.sRefactorFn = "UnicodeOemAnsiFunctions")
        End_Procedure

        /* 4534 IS "obsolete global", not "OEM/ANSI" - the generic hint must not describe one family.
           Nils 2026-07-29: "Get Parse_Path sDirectory to sPath" was told "Not Unicode-safe
           (OEM/ANSI) ... ToOEM/ToANSI auto-rewrite", advice about a problem that line does not have.
           PARSE_PATH and PARSE_DRIVE now carry their own text, and the generic says only what holds
           for every 4534. Both must stay Explain with NO function: ExtractFilePath is not a
           drop-in, so no converter may claim them. */
        {Published = True}
        Procedure ModAnalyzer_4534_ParsePathDrive_RoutesToPairConverter
            tModAnalyzer Recipe

            /* BOTH halves of the pair route to the ONE converter that collapses them. A
               hardcoded function-less Explain for these lived here for an hour and had to go:
               ClassifyFromRecipes keeps the FIRST specific match and the hardcoded recipes are
               seeded before the meta-tag ones, so it silently outranked the converter - which
               would then never be offered on the board or in a plan. The shadow rule does not
               save this case: it only promotes a function-BEARING generic, and the generic 4534
               has no function either. */
            Get MakeRecipe 4534 "Obsolete Global Function: PARSE_PATH" to Recipe
            Send AssertSAreEqual "ChangeParsePathPairToExtractFilePath" Recipe.sRefactorFn
            Send Assert (not(Recipe.sHint contains "ToOEM"))
            Get MakeRecipe 4534 "Obsolete Global Function: PARSE_DRIVE" to Recipe
            Send AssertSAreEqual "ChangeParsePathPairToExtractFilePath" Recipe.sRefactorFn
            Send Assert (not(Recipe.sHint contains "ToOEM"))
            // An unrecognised 4534 gets the neutral generic, never the OEM/ANSI paragraph.
            Get MakeRecipe 4534 "Obsolete Global Function: SOMETHING_ELSE" to Recipe
            Send Assert (not(Recipe.sHint contains "ToOEM"))
            Send Assert (Recipe.sHint contains "see the message")
        End_Procedure

        // 4534 other OEM/ANSI calls (e.g. File_Exist_Oem) are NOT auto-rewritable -> Explain, no fn.
        {Published = True}
        Procedure ModAnalyzer_4534_OtherOem_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4534 "Obsolete use of File_Exist_Oem, not unicode safe" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
        End_Procedure

        // 4536 Windows.pkg (or any desktop-only package) pulled into a WebApp: the compiler IGNORES it, so
        // this is a REMOVAL, not a class-replacement - the specific "will be ignored" recipe must beat the
        // generic "replace with a modern class" hint. (Nils 2026-07-12.)
        {Published = True}
        Procedure ModAnalyzer_4536_WebAppIgnored_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4536 "Obsolete Package WINDOWS.PKG - This package should not be used inside a WebApp. It will be ignored and should be removed" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "Remove its Use line")
            Send Assert (not(Recipe.sHint contains "cCJGrid"))
        End_Procedure

        // A "replace with a class" 4536 (e.g. Std_help.pkg -> cHtmlHelp.pkg) must NOT hit the "ignored/remove"
        // recipe: it falls through to the generic hint instead of the removal one.
        {Published = True}
        Procedure ModAnalyzer_4536_ReplacePackage_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4536 "Obsolete Package: Std_help.pkg. Use cHtmlHelp.pkg" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (not(Recipe.sHint contains "Remove its Use line"))
        End_Procedure

        // Raw compiler error 54 "existing class name" (undefined class) -> Explain, no fn (a real error, fix in
        // source; not a phantom refactor). LegacyApp cLegacyApp_dbGridExport_Mixin.pkg:55 RefClass(cCJReportSelectedRows).
        {Published = True}
        Procedure ModAnalyzer_54_UndefinedClass_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 54 "FELAKTIGT FORMAT I UTTRYCKET Argument must be an existing class name" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
        End_Procedure

        // ERROR-shaped routes (2026-07-10, the LegacyApp3 error wall): constructs whose packages are GONE
        // from modern DataFlex fail HARD instead of warning, so the recipes match the ERRORS. The
        // texts below are the real Swedish-compiler lines - the match-texts key on the
        // locale-independent symbol/command tokens, which is exactly what these tests prove.

        // 4313 include WORKSPC.PKG not found -> Review, RefactorWorkspaceTocApplication.
        {Published = True}
        Procedure ModAnalyzer_4313_Workspc_RoutesToWorkspaceConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4313 "Hittar ej fil att inkludera WORKSPC.PKG" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "RefactorWorkspaceTocApplication")
        End_Procedure

        /* 4306 on a CodeJock constant -> the Report->Grid converter (Nils 2026-08-30). The compiler
           never names the package here: an xtpReport* constant that no longer resolves comes back
           as a forward reference, "MSG_XTPREPORT...", and 4306 carried no recipe at all - so the
           converter that has always known how to rewrite the line was never offered and the build
           broke on it. The negative control is the same message number with an ordinary unresolved
           name, which must stay unrouted (4306 is generic - only the symbol makes it ours). */
        {Published = True}
        Procedure ModAnalyzer_4306_XtpReportConstant_RoutesToCodeJockConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4306 "Forward reference not resolved  MSG_XTPREPORTTHEMEVISUALSTUDIO2012LIGHT" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeCodeJockReportToGrid")
            Send Assert (Recipe.eCategory = eModAutoFix)
            Get MakeRecipe 4306 "Forward reference not resolved  MSG_DOSOMETHINGELSE" to Recipe
            Send Assert (Recipe.sRefactorFn = "")
        End_Procedure

        /* A FOLDED ROW SPEAKS FOR N FINDINGS, and anything counting rows understates by that
           factor. The read-only packages band said "2 warning(s)" over a package holding 7 - two
           rows, one of them folded x7 (Nils 2026-08-30). Malformed or absent suffix answers 1,
           never 0: a count of 0 would make a real finding vanish from a tally. */
        {Published = True}
        Procedure ModAnalyzer_OccurrencesFromLineCell_FoldedRowCountsItsMultiplier
            Handle ho
            Integer iN
            Get Create (RefClass(cModAnalyzer)) to ho
            Get OccurrencesFromLineCell of ho "256  (x7)" to iN
            Send AssertIAreEqual 7 iN
            Get OccurrencesFromLineCell of ho "1009 (x12)" to iN
            Send AssertIAreEqual 12 iN
            // No suffix, empty, and non-numeric all mean "this row is one finding".
            Get OccurrencesFromLineCell of ho "256" to iN
            Send AssertIAreEqual 1 iN
            Get OccurrencesFromLineCell of ho "" to iN
            Send AssertIAreEqual 1 iN
            Get OccurrencesFromLineCell of ho "256  (xmany)" to iN
            Send AssertIAreEqual 1 iN
            Get OccurrencesFromLineCell of ho "256  (x" to iN
            Send AssertIAreEqual 1 iN
            Send Destroy of ho
        End_Procedure

        /* A PLACE IS COUNTED ONCE (2026-09-11). The grid's fold asks whether a folded row already
           holds a message on a line before a Deep Scan hit counts as a new place - the compiler and
           the scan find the same construct, and counting both showed "(x6)" over three lines. The
           line is matched up to its TAB: 27 is held, 270 and 2 are not. */
        {Published = True}
        Procedure ModAnalyzer_OccurrencesHoldLine_MatchesTheWholeLineNumber
            Handle ho
            String[] asOcc asNone
            Boolean bHeld
            Get Create (RefClass(cModAnalyzer)) to ho
            Move ("27" + Character(9) + "W 4533" + Character(9) + "Obsolete command: GetAddress") to asOcc[0]
            Move ("63" + Character(9) + "W 4533" + Character(9) + "Obsolete command: GetAddress") to asOcc[1]
            Get OccurrencesHoldLine of ho asOcc 27 to bHeld
            Send Assert bHeld "line 27 is held"
            Get OccurrencesHoldLine of ho asOcc 63 to bHeld
            Send Assert bHeld "line 63 is held"
            Get OccurrencesHoldLine of ho asOcc 270 to bHeld
            Send AssertFalse bHeld "270 is not 27"
            Get OccurrencesHoldLine of ho asOcc 2 to bHeld
            Send AssertFalse bHeld "2 is not 27"
            Get OccurrencesHoldLine of ho asOcc 66 to bHeld
            Send AssertFalse bHeld "66 is not held"
            Get OccurrencesHoldLine of ho asNone 27 to bHeld
            Send AssertFalse bHeld "an empty row holds nothing"
            Send Destroy of ho
        End_Procedure

        // 4345 U_WORKSPACE undefined (the Workspace class itself) -> Review, same converter.
        {Published = True}
        Procedure ModAnalyzer_4345_UWorkspace_RoutesToWorkspaceConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "Felaktig typ U_WORKSPACE, MUST BE DEFINED" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "RefactorWorkspaceTocApplication")
        End_Procedure

        // 4345 U_WINREPORT undefined (WinPrint 1 gone from modern Dfallrpt) -> WinReport converter.
        // PROMOTED Suggest -> AutoFix 2026-07-11 after Nils's live verify ("all winprint errors are gone").
        {Published = True}
        Procedure ModAnalyzer_4345_UWinReport_RoutesToWinReportConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "Felaktig typ U_WINREPORT, MUST BE DEFINED" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "RefactorWinReportTocWinReport2")
        End_Procedure

        // 4328 WINPRINTID undefined (the WinPrint-1 global; WinPrint 2 re-provides it) -> same, AutoFix.
        {Published = True}
        Procedure ModAnalyzer_4328_WinPrintId_RoutesToWinReportConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4328 "Odefinierad symbol i argument WINPRINTID" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "RefactorWinReportTocWinReport2")
        End_Procedure

        // 4328 GHOWORKSPACE undefined (the retired Workspc.pkg global on a READ site) -> Review,
        // ChangeLegacyWorkspaceAccessors (the line-by-line path-read sweeper).
        {Published = True}
        Procedure ModAnalyzer_4328_GhoWorkspace_RoutesToAccessorSweeper
            tModAnalyzer Recipe
            Get MakeRecipe 4328 "Odefinierad symbol i argument GHOWORKSPACE" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "ChangeLegacyWorkspaceAccessors")
        End_Procedure

        // GRID-family ERROR routes (v54 - same warning-vs-error gap as WinPrint): a workspace where
        // dbGrid/dbList no longer resolve gets 4345/4328 U_DBGRID / U_DBLIST + 4298 BEGIN_ROW/END_ROW
        // instead of the 4537/4533 warnings the old recipes matched.
        {Published = True}
        Procedure ModAnalyzer_GridFamilyErrors_RouteToConverters
            tModAnalyzer Recipe

            Get MakeRecipe 4345 "Felaktig typ U_DBGRID, MUST BE DEFINED" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "RefactorDbGridTocDbCJGrid")
            Get MakeRecipe 4345 "Felaktig typ U_DBLIST, MUST BE DEFINED" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "RefactorDbListTocDbCJGridPromptList")
            Get MakeRecipe 4298 "Odefinerat kommando BEGIN_ROW" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn <> "")
            Get MakeRecipe 4298 "Odefinerat kommando END_ROW" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn <> "")
        End_Procedure

        // 4392 missing 'Returns' on a legacy Function declaration (v55) -> AddFunctionReturnsKeyword.
        // The error line IS the declaration line, so the recipe is generic (no match-text).
        // PROMOTED Suggest -> AutoFix 2026-07-11 after Nils's live verify ("4392 OK").
        {Published = True}
        Procedure ModAnalyzer_4392_MissingReturns_RoutesToAddReturns
            tModAnalyzer Recipe
            Get MakeRecipe 4392 "Felaktig funktionssyntax Missing keyword returns on function declaration" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "AddFunctionReturnsKeyword")
        End_Procedure

        // The '(operator) @' guidance hint: an UNDECLARED @-suffixed global split at the '@'. Must
        // BEAT the generic 52 'operator' hint (first-specific-wins - seed order) and point the user
        // at the globals function + the real fix site (the PROGRAM source).
        {Published = True}
        Procedure ModAnalyzer_52_AtSplit_GuidanceHint
            tModAnalyzer Recipe
            Get MakeRecipe 52 "Fel format i uttryck (operator) @" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "RefactorBareGlobalsToGlobalVariable")
            // ...while a PLAIN operator-52 still gets the generic malformed-expression hint.
            Get MakeRecipe 52 "FEL FORMAT I UTTRYCKET (OPERATOR)" to Recipe
            Send Assert (not(Recipe.sHint contains "RefactorBareGlobalsToGlobalVariable"))
        End_Procedure

        // The missing-.fd guidance hint: one setup problem, dozens of cascade errors - the hint
        // names the regenerate fix so the <TABLE>.<column> avalanche reads as ONE cause.
        {Published = True}
        Procedure ModAnalyzer_4313_MissingFd_GuidanceHint
            tModAnalyzer Recipe
            Get MakeRecipe 4313 "Hittar ej fil att inkludera PERIOD2.FD" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "filelist")
        End_Procedure

        /* THE FILE AN "INCLUDE FILE NOT FOUND" NAMES (2026-10-05): the last word, in the compiler's capitals
           and whatever its language, without a folder - and nothing for a table definition, which has its
           own recipe, or for a text that ends in no file name. */
        {Published = True}
        Procedure ModAnalyzer_MissingIncludeName_IsTheLastWord
            Handle ho
            String s
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MissingIncludeName of ho "Include file not found CREGEX.PKG" to s
            Send AssertSAreEqual "CREGEX.PKG" s
            Get MissingIncludeName of ho "Hittar ej fil att inkludera WORKSPC.PKG" to s
            Send AssertSAreEqual "WORKSPC.PKG" s
            Get MissingIncludeName of ho "Include file not found OTHERDEV\CREGEX\CREGEX.PKG" to s
            Send AssertSAreEqual "CREGEX.PKG" s
            Get MissingIncludeName of ho "Hittar ej fil att inkludera PERIOD2.FD" to s
            Send AssertSAreEqual "" s
            Get MissingIncludeName of ho "Include file not found" to s
            Send AssertSAreEqual "" s
            Send Destroy of ho
        End_Procedure

        // Of a library's workspace files, the one for the target version - by its dotted or its compact
        // spelling - and the last in name order when none names it.
        {Published = True}
        Procedure ModAnalyzer_PickSwsForVersion_TakesTheTargetOne
            Handle ho
            String[] asSws asDotted asNone
            String s
            Move "cRegex-Library-DF260.sws" to asSws[0]
            Move "cRegex-Library-DF191.sws" to asSws[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get PickSwsForVersion of ho asSws "26.0" to s
            Send AssertSAreEqual "cRegex-Library-DF260.sws" s
            Get PickSwsForVersion of ho asSws "19.1" to s
            Send AssertSAreEqual "cRegex-Library-DF191.sws" s
            Get PickSwsForVersion of ho asSws "25.0" to s
            Send AssertSAreEqual "cRegex-Library-DF260.sws" s
            // the dotted spelling of the version in the name
            Move "Lib 26.0.sws" to asDotted[0]
            Move "Lib 19.1.sws" to asDotted[1]
            Get PickSwsForVersion of ho asDotted "26.0" to s
            Send AssertSAreEqual "Lib 26.0.sws" s
            Get PickSwsForVersion of ho asDotted "19.1" to s
            Send AssertSAreEqual "Lib 19.1.sws" s
            Get PickSwsForVersion of ho asNone "26.0" to s
            Send AssertSAreEqual "" s
            Send Destroy of ho
        End_Procedure

        /* ONE LIBRARY ENTRY OF A WORKSPACE FILE, AS A PLACE TO LOOK (2026-10-05). The first version of the
           hint asked the library inventory, which reads no libraries from a JSON workspace file, so on a
           DataFlex 26 workspace it looked under the home only and found nothing. The entries are the JSON
           file's own now: a relative path in df-cli's forward slashes gives the library's root and the
           folder of its .sws; a .sws kept in a StudioLibrary folder gives the folder ABOVE it as the root;
           a registry package name gives nothing. */
        {Published = True}
        Procedure ModAnalyzer_MissingInclude_LibraryEntryBecomesARoot
            Handle ho hoInv
            String[] asRoots asRef

            Get Create (RefClass(cModAnalyzer)) to ho
            Get Create (RefClass(cLibraryInventory)) to hoInv
            Send _AddLibraryRootFor of ho hoInv "E:\Ws\" "../Lib/Lib-Library-DF260.sws" (&asRoots) (&asRef)
            Send AssertIAreEqual 1 (SizeOfArray(asRoots))
            Send AssertSAreEqual "E:\Lib\" (asRoots[0])
            Send AssertSAreEqual "e:\lib\" (asRef[0])
            Send _AddLibraryRootFor of ho hoInv "E:\Ws\" "Libraries/vwin32fh/StudioLibrary/vWin32fh-Library-DF26.0.sws" (&asRoots) (&asRef)
            Send AssertIAreEqual 2 (SizeOfArray(asRoots))
            Send AssertSAreEqual "E:\Ws\Libraries\vwin32fh\" (asRoots[1])
            Send AssertSAreEqual "e:\ws\libraries\vwin32fh\studiolibrary\" (asRef[1])
            Send _AddLibraryRootFor of ho hoInv "E:\Ws\" "DataFlex-dev/Web UI FlexTron#1.0.54" (&asRoots) (&asRef)
            Send _AddLibraryRootFor of ho hoInv "E:\Ws\" "" (&asRoots) (&asRef)
            Send AssertIAreEqual 2 (SizeOfArray(asRoots))
            Send AssertIAreEqual 2 (SizeOfArray(asRef))
            Send Destroy of hoInv
            Send Destroy of ho
        End_Procedure

        // Helper: one fixture file with one line in it, its folder made first.
        Procedure _MissIncFile String sFolder String sLeaf
            String[] asLine
            Boolean bOk
            Move (rfDirectoryCreateEx(sFolder, False)) to bOk
            Move "// fixture" to asLine[0]
            Get rfWriteEncodedFileFromStringArray (&asLine) (sFolder + sLeaf) C_NewLine False to bOk
            Send Assert bOk ("could not write fixture " + sFolder + sLeaf)
        End_Procedure

        /* THE HINT ON AN "INCLUDE FILE NOT FOUND" ROW (Nils 2026-10-05: "Yes, please add that hint"). A real
           tree in the Windows temp folder, shaped like the workspace that prompted it: a workspace, the one
           library it references, and a library nested inside that one with its workspace files in a
           StudioLibrary folder.
             cRegex.pkg   - in the nested library: the hint names its .sws for the target version, and says
                            the workspace does not reference it
             OffPath.pkg  - in the workspace, in a folder nothing lists: the hint says the folder is off the
                            source path, and names no library to add
             Retired.pkg  - only in a retired .OLD tree: no hint
             NoSuch.pkg   - nowhere: no hint
           and a row a converter owns, or another message number, comes back as it went in. */
        {Published = True}
        Procedure ModAnalyzer_MissingInclude_NamesTheLibraryToAdd
            Handle ho
            String sRoot
            String[] asRoots asRef
            tModAnalyzer Recipe Out

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_MissInc\") to sRoot
            Send _MissIncFile (sRoot + "Ws\") "Ws.sws"
            Send _MissIncFile (sRoot + "Ws\AppSrc\") "App.pkg"
            Send _MissIncFile (sRoot + "Ws\Extra\") "OffPath.pkg"
            Send _MissIncFile (sRoot + "Lib\") "Lib-Library-DF260.sws"
            Send _MissIncFile (sRoot + "Lib\AppSrc\") "LibFile.pkg"
            Send _MissIncFile (sRoot + "Lib\nested\cRegex\") "cRegex.pkg"
            Send _MissIncFile (sRoot + "Lib\nested\cRegex\StudioLibrary\") "cRegex-Library-DF191.sws"
            Send _MissIncFile (sRoot + "Lib\nested\cRegex\StudioLibrary\") "cRegex-Library-DF260.sws"
            Send _MissIncFile (sRoot + "Lib\Libraries\Gone.OLD\") "Retired.pkg"

            Move (sRoot + "Ws\")              to asRoots[0]
            Move (sRoot + "Lib\")             to asRoots[1]
            Move (Lowercase(sRoot + "Ws\"))   to asRef[0]
            Move (Lowercase(sRoot + "Lib\"))  to asRef[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Set pbMissIncSeeded      of ho to True
            Set pasMissIncRoots      of ho to asRoots
            Set pasMissIncRefFolders of ho to asRef
            Set psMissIncTarget      of ho to "26.0"

            Move eModExplain to Recipe.eCategory
            Move "what the compiler said" to Recipe.sHint
            Move "" to Recipe.sRefactorFn

            Get VerifyMissingInclude of ho Recipe 4313 "Include file not found CREGEX.PKG" to Out
            Send Assert (Out.sHint contains "cRegex.pkg was found in") Out.sHint
            Send Assert (Out.sHint contains "nested\cRegex,") Out.sHint
            Send Assert (Out.sHint contains "cRegex-Library-DF260.sws") Out.sHint
            Send Assert (Out.sHint contains "does not reference that library") Out.sHint
            Send Assert (not(Out.sHint contains "DF191")) Out.sHint
            Send Assert (Out.eCategory = eModExplain)

            Get VerifyMissingInclude of ho Recipe 4313 "Include file not found OFFPATH.PKG" to Out
            Send Assert (Out.sHint contains "OffPath.pkg was found in") Out.sHint
            Send Assert (Out.sHint contains "not on the source path") Out.sHint
            Send Assert (not(Out.sHint contains "does not reference")) Out.sHint

            Get VerifyMissingInclude of ho Recipe 4313 "Include file not found RETIRED.PKG" to Out
            Send AssertSAreEqual "what the compiler said" Out.sHint
            Get VerifyMissingInclude of ho Recipe 4313 "Include file not found NOSUCH.PKG" to Out
            Send AssertSAreEqual "what the compiler said" Out.sHint
            // another message number
            Get VerifyMissingInclude of ho Recipe 4345 "Type check error CREGEX.PKG" to Out
            Send AssertSAreEqual "what the compiler said" Out.sHint
            // a row a converter owns
            Move "RefactorWorkspaceTocApplication" to Recipe.sRefactorFn
            Get VerifyMissingInclude of ho Recipe 4313 "Include file not found CREGEX.PKG" to Out
            Send AssertSAreEqual "what the compiler said" Out.sHint
            Send Destroy of ho
        End_Procedure

        // 4298 undefined WinPrint-1 report command (one per DFWrite*/DFFont*/header/margin line) ->
        // same converter, AutoFix since 2026-07-11 - the class+Use swap re-provides the whole command set.
        {Published = True}
        Procedure ModAnalyzer_4298_DfWriteLn_RoutesToWinReportConverter
            tModAnalyzer Recipe
            Get MakeRecipe 4298 "Odefinerat kommando DFWRITELN" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "RefactorWinReportTocWinReport2")
            Get MakeRecipe 4298 "Odefinerat kommando DFBEGINHEADER" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorWinReportTocWinReport2")
            Get MakeRecipe 4298 "Odefinerat kommando DFFONTSIZE" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorWinReportTocWinReport2")
        End_Procedure

        // Raw compiler error 52 "(OPERATOR)" (malformed expression, e.g. '()' on a Get). Since
        // 2026-09-05 the message is OWNED by SplitCommandOutOfCondition (Auto-fix by shape), so the
        // Explain verdict for this line comes from VerifyAutoFix, not from the seed - and it must
        // carry the general advice, not the macro wording. LegacyApp UFUNC.INC:2457.
        {Published = True}
        Procedure ModAnalyzer_52_MalformedExpr_ExplainAfterShapeCheck
            Handle ho
            tModAnalyzer Recipe rLine
            Get MakeRecipe 52 "FEL FORMAT I UTTRYCKET (OPERATOR)" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "SplitCommandOutOfCondition" Recipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho Recipe "    Get fGetAccessRights() to bAccess" to rLine
            Send Assert (rLine.eCategory = eModExplain)
            Send AssertSAreEqual "" rLine.sRefactorFn
            Send Assert (rLine.sHint contains "Get Func() to var") rLine.sHint
            Send Destroy of ho
        End_Procedure

        /* A Deep Scan operator row on a line with ONE stray ')' keeps its auto-fix - ChangeLegacyOperators
           repairs the shape, so the dry-run changes the line (2026-09-05; four such rows had nothing to
           offer but "Ignore all"). Two strays are still hand work, and the verdict now NAMES the imbalance
           instead of "fix it by hand". */
        {Published = True}
        Procedure ModAnalyzer_DS_StrayParen_RepairedKeepsAutoFix_UnbalancedIsNamed
            Handle ho
            tModAnalyzer Recipe rLine
            Move 9035 to Recipe.iMsgNumber
            Move eModAutoFix to Recipe.eCategory
            Move "ChangeLegacyOperators" to Recipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho Recipe "    If Cust.Code eq sCode) ;" to rLine
            Send Assert (rLine.eCategory = eModAutoFix) "one stray converts: the row keeps its auto-fix"
            Send AssertSAreEqual "ChangeLegacyOperators" rLine.sRefactorFn
            Get VerifyAutoFix of ho Recipe "    If Cust.Code eq sCode)) ;" to rLine
            Send Assert (rLine.eCategory = eModExplain) "two strays are hand work"
            Send AssertSAreEqual "" rLine.sRefactorFn
            Send Assert (rLine.sHint contains "parentheses do not balance") rLine.sHint
            Send Assert (rLine.sHint contains "0 opening against 2 closing") rLine.sHint
            Send Destroy of ho
        End_Procedure

        // A ';'-continued statement whose warning lands on the CONTINUATION line: GuardLineForStatement walks
        // back to the first line and JOINS, so the keyword is visible to the source-guard. LegacyApp
        // cOSVersionInfo.h: 'External_Function32 ... ;' on line N, the 4533 fires on line N+1's 'Pointer ...'.
        {Published = True}
        Procedure ModAnalyzer_GuardLineForStatement_JoinsContinuation
            Handle ho
            String[] asLines
            String sGuard
            Move 'External_Function32 GetVersionEx "GetVersionExA" KERNEL32.DLL ;' to asLines[0]
            Move '  Pointer lpVersionInformation Returns Integer' to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get GuardLineForStatement of ho (&asLines) 2 to sGuard
            Send Destroy of ho
            Send Assert (sGuard contains "External_Function32")
            Send Assert (sGuard contains "Pointer")
        End_Procedure

        // A NON-continuation line (the previous line does not end with ';') is returned unchanged - no join.
        {Published = True}
        Procedure ModAnalyzer_GuardLineForStatement_SingleLine
            Handle ho
            String[] asLines
            String sGuard
            Move 'Move iA to iB' to asLines[0]
            Move 'Sub x from y' to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get GuardLineForStatement of ho (&asLines) 2 to sGuard
            Send Destroy of ho
            Send Assert (sGuard = "Sub x from y")
        End_Procedure

        // ClassDeclaredOnLine: the 4345 duplicate-name row reads the class off the reported line (the message
        // prints only |CI<n>). First token only; tabs fold; a trailing-comment 'class' and an Object line are not.
        {Published = True}
        Procedure ModAnalyzer_ClassDeclaredOnLine
            Handle ho
            String sA sB sC sD sE

            Get Create (RefClass(cModAnalyzer)) to ho
            Get ClassDeclaredOnLine of ho "Class cRegEx is a cObject" to sA
            Get ClassDeclaredOnLine of ho (Character(9) + "Class" + Character(9) + "cMy  is a cRegEx") to sB
            Get ClassDeclaredOnLine of ho "Object oRx is a cRegEx" to sC
            Get ClassDeclaredOnLine of ho "    Move x to y // Class cFake is a" to sD
            Get ClassDeclaredOnLine of ho "Class" to sE
            Send Destroy of ho
            Send AssertSAreEqual "cRegEx" sA
            Send AssertSAreEqual "cMy"    sB
            Send AssertSAreEqual ""       sC
            Send AssertSAreEqual ""       sD
            Send AssertSAreEqual ""       sE
        End_Procedure

        // StatementStartLine: the compiler reports a ';'-continued statement at its LAST physical line (a 4390
        // on a multi-line External_Function lands on 'Returns'), and the 4390 site row must jump to the FIRST.
        // Lines 1-3 are one statement (1 and 2 end with ';'); line 4 stands alone. Nils 2026-09-02: WinServ
        // InternetOption.pkg 130 opened the editor on "    Returns Integer".
        {Published = True}
        Procedure ModAnalyzer_StatementStartLine_WalksBackOverContinuations
            Handle ho
            String[] asLines
            Integer iStart
            Move 'External_Function WinAPI_InternetSetOption "InternetSetOptionW" WinInet.dll ;' to asLines[0]
            Move '    Handle hInternet Integer dwOption ;' to asLines[1]
            Move '    Returns Integer' to asLines[2]
            Move 'Move iA to iB' to asLines[3]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get StatementStartLine of ho (&asLines) 3 to iStart
            Send Assert (iStart = 1)
            Get StatementStartLine of ho (&asLines) 2 to iStart
            Send Assert (iStart = 1)
            Get StatementStartLine of ho (&asLines) 1 to iStart
            Send Assert (iStart = 1)
            Get StatementStartLine of ho (&asLines) 4 to iStart
            Send Assert (iStart = 4)
            // Out of range comes back untouched - a file that would not read has 0 lines.
            Get StatementStartLine of ho (&asLines) 9 to iStart
            Send Assert (iStart = 9)
            Get StatementStartLine of ho (&asLines) 0 to iStart
            Send Assert (iStart = 0)
            Send Destroy of ho
        End_Procedure

        // EnclosingObjectClass: a Begin_Row warned line resolves to its enclosing Object declaration.
        {Published = True}
        Procedure ModAnalyzer_EnclosingObjectClass_Simple
            Handle ho
            String[] asLines
            String sClass sObjName
            Integer iObjLine
            Move '    Object oSl is a dbList0' to asLines[0]
            Move '        Begin_Row'           to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get EnclosingObjectClass of ho (&asLines) 2 (&sObjName) (&iObjLine) to sClass
            Send Destroy of ho
            Send AssertSAreEqual 'dbList0' sClass
            Send AssertSAreEqual 'oSl' sObjName
            Send AssertIAreEqual 1 iObjLine
        End_Procedure

        // EnclosingObjectClass: a CLOSED nested child object above the warned line is skipped
        // (depth counting) - the ENCLOSING object is returned, not the sibling.
        {Published = True}
        Procedure ModAnalyzer_EnclosingObjectClass_SkipsNested
            Handle ho
            String[] asLines
            String sClass sObjName
            Integer iObjLine
            Move 'Object oSel is a dbList0'     to asLines[0]
            Move '    Object oChild is a Form'  to asLines[1]
            Move '    End_Object'               to asLines[2]
            Move '    Begin_Row'                to asLines[3]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get EnclosingObjectClass of ho (&asLines) 4 (&sObjName) (&iObjLine) to sClass
            Send Destroy of ho
            Send AssertSAreEqual 'dbList0' sClass
            Send AssertSAreEqual 'oSel' sObjName
        End_Procedure

        // VerifyBeginRow on a SUBCLASS object (2026-10-03): the converter's EMPTY run leaves the object as it
        // is, so the row is Explain with no function, and the hint says how to go on - since 2026-10-04,
        // ConvertGridSubclassToCodeJock with the subclass named. Both kinds of name: one the old "ends in dblist" pattern missed
        // (dbList0, Nils' LegacyApp catch - it used to keep the converter with the parameter to set) and
        // one it took (MyDbGrid - the 794 rows that promised a conversion the run refuses).
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_SubclassStaysAsItIs
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move "RefactorDbListTocDbCJGridPromptList" to rRecipe.sRefactorFn
            Move 'Object oSl is a dbList0' to asLines[0]
            Move '    Begin_Row'           to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Assert (rOut.sRefactorFn = "")        "a dbList0 object's row carries no function"
            Send Assert (rOut.eCategory = eModExplain) "a dbList0 object's row is Explain"
            Send Assert (rOut.sHint contains "Run ConvertGridSubclassToCodeJock with the parameter 'dbList0'")
            Send Assert (rOut.sHint contains "ports dbList0 to cDbCJGridPromptList in place")
            Send Assert (rOut.sHint contains "oSl")
            Move "RefactorDbGridTocDbCJGrid" to rRecipe.sRefactorFn
            Move 'Object oGr is a MyDbGrid' to asLines[0]
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Send Assert (rOut.sRefactorFn = "")        "an MyDbGrid object's row carries no function"
            Send Assert (rOut.eCategory = eModExplain) "an MyDbGrid object's row is Explain"
            Send Assert (rOut.sHint contains "ConvertGridSubclassToCodeJock with the parameter 'MyDbGrid'")
        End_Procedure

        /* VerifyBeginRow with the last scan's VERDICT on the subclass (2026-10-04): a yes hands the row to
           ConvertGridSubclassToCodeJock, Auto-fix - the 1,383 Begin_Row rows of one workspace, every one in an
           object of its own subclass, were explanations that only named the converter. One asserted string. */
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_ConvertibleSubclassIsOffered
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines asPortNames asPortWhy asNone
            String sGot

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move "RefactorDbGridTocDbCJGrid" to rRecipe.sRefactorFn
            Move 'Object oGr is a MyDbGrid' to asLines[0]
            Move '    Begin_Row'            to asLines[1]
            Move "mydbgrid" to asPortNames[0]
            Move ""         to asPortWhy[0]
            Set pasLearnedPortNames of ghoFuncLib to asPortNames
            Set pasLearnedPortWhy   of ghoFuncLib to asPortWhy
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Set pasLearnedPortNames of ghoFuncLib to asNone
            Set pasLearnedPortWhy   of ghoFuncLib to asNone
            Move (rOut.sRefactorFn + "|" + If((rOut.eCategory = eModAutoFix), "AutoFix", "other") + "|" + If((rOut.sHint contains "ConvertGridSubclassToCodeJock converts the class in place and runs RefactorDbGridTocDbCJGrid on this object itself"), "hint", rOut.sHint)) to sGot
            Send AssertSAreEqual "ConvertGridSubclassToCodeJock|AutoFix|hint" sGot
        End_Procedure

        // ...and a no keeps the explanation, with the converter's reason and no function.
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_RefusedSubclassSaysWhy
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines asPortNames asPortWhy asNone
            String sGot

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move "RefactorDbGridTocDbCJGrid" to rRecipe.sRefactorFn
            Move 'Object oGr is a MyDbGrid' to asLines[0]
            Move '    Begin_Row'            to asLines[1]
            Move "mydbgrid"                  to asPortNames[0]
            Move "its body holds a row loop" to asPortWhy[0]
            Set pasLearnedPortNames of ghoFuncLib to asPortNames
            Set pasLearnedPortWhy   of ghoFuncLib to asPortWhy
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Set pasLearnedPortNames of ghoFuncLib to asNone
            Set pasLearnedPortWhy   of ghoFuncLib to asNone
            Move ("[" + rOut.sRefactorFn + "]|" + If((rOut.eCategory = eModExplain), "Explain", "other") + "|" + If((rOut.sHint contains "ConvertGridSubclassToCodeJock cannot convert it in place: its body holds a row loop. Port MyDbGrid by hand to a class based on cDbCJGrid"), "why", rOut.sHint)) to sGot
            Send AssertSAreEqual "[]|Explain|why" sGot
        End_Procedure

        // VerifyBeginRow: the WRONG-family converter (dbGrid converter on a dbList-family class) is
        // demoted, so the row never offers a converter whose class detection would no-op - and its hint
        // is left as it was: the grid takes a demoted recipe's hint as the row's only when a guard
        // rewrote it (2026-10-04), so a silent drop must not look like an explanation.
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_WrongFamilyDemoted
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move "RefactorDbGridTocDbCJGrid" to rRecipe.sRefactorFn
            Move "the converter's own text" to rRecipe.sHint
            Move 'Object oSl is a dbList0' to asLines[0]
            Move '    Begin_Row'           to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Send Assert (rOut.sRefactorFn = "")
            Send Assert (rOut.eCategory = eModExplain)
            Send AssertSAreEqual "the converter's own text" rOut.sHint
        End_Procedure

        // VerifyBeginRow on a class named for NEITHER family (2026-10-04): both converters reach the
        // subclass note, and whichever the grid shows must be right - so they write the SAME note, and it
        // names no family.
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_NeitherFamilyOneNote
            Handle ho
            tModAnalyzer rRecipe rGrid rList
            String[] asLines

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move 'Object oEn is a cMyEntry' to asLines[0]
            Move '    Begin_Row'            to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Move "RefactorDbGridTocDbCJGrid" to rRecipe.sRefactorFn
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rGrid
            Move "RefactorDbListTocDbCJGridPromptList" to rRecipe.sRefactorFn
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rList
            Send Destroy of ho
            Send Assert (rGrid.sRefactorFn = "" and rList.sRefactorFn = "") "neither converter is offered"
            Send Assert (rGrid.eCategory = eModExplain and rList.eCategory = eModExplain)
            Send AssertSAreEqual rGrid.sHint rList.sHint
            Send Assert (rGrid.sHint contains "is a workspace class")
            Send Assert (rGrid.sHint contains "Run ConvertGridSubclassToCodeJock with the parameter 'cMyEntry'")
            Send Assert (not(rGrid.sHint contains "RefactorDbGridTocDbCJGrid")) "the note names neither family's converter"
        End_Procedure

        // VerifyBeginRow: a base-class object (ends in 'dblist' - auto-detected by the converter) keeps
        // the function and the hint says run it (no parameter change needed).
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_BaseAutoDetected
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines

            Move 4533 to rRecipe.iMsgNumber
            Move "Begin_Row" to rRecipe.sMatchText
            Move eModSuggest to rRecipe.eCategory
            Move "RefactorDbListTocDbCJGridPromptList" to rRecipe.sRefactorFn
            Move 'Object oSl is a dbList' to asLines[0]
            Move '    Begin_Row'          to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Send Assert (rOut.sRefactorFn = "RefactorDbListTocDbCJGridPromptList")
            Send Assert (rOut.sHint contains "Select and run RefactorDbListTocDbCJGridPromptList")
        End_Procedure

        // VerifyBeginRow: a non-Begin_Row recipe passes through untouched (the gate).
        {Published = True}
        Procedure ModAnalyzer_VerifyBeginRow_NonBeginRowUntouched
            Handle ho
            tModAnalyzer rRecipe rOut
            String[] asLines

            Move 4533 to rRecipe.iMsgNumber
            Move "command: Sub" to rRecipe.sMatchText
            Move eModAutoFix to rRecipe.eCategory
            Move "ChangeSubToSubtract" to rRecipe.sRefactorFn
            Move "old hint" to rRecipe.sHint
            Move 'Object oSl is a dbList0' to asLines[0]
            Move '    Sub x from y'        to asLines[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyBeginRow of ho rRecipe (&asLines) 2 to rOut
            Send Destroy of ho
            Send Assert (rOut.sRefactorFn = "ChangeSubToSubtract")
            Send Assert (rOut.sHint = "old hint")
        End_Procedure

        // 4533 ArrayPut -> Suggest, routed to TypeToStructReport (the byte-buffer/Type -> Struct
        // migration). The function-bearing meta-tag recipe beats the scanned function-less
        // "Obsolete Command: ArrayPut" row (meta-tags are added before the appended scan).
        {Published = True}
        Procedure ModAnalyzer_4533_ArrayPut_Suggest
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete Command: ArrayPut" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "TypeToStructReport")
        End_Procedure

        // 4534 CVTtoBytes -> Suggest, routed to TypeToStructReport (a Struct assignment packs the
        // bytes). Specific match-text beats the generic 4534 Explain.
        {Published = True}
        Procedure ModAnalyzer_4534_CvtToBytes_Suggest
            tModAnalyzer Recipe
            Get MakeRecipe 4534 "Obsolete use of CVTtoBytes, not unicode safe" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn = "TypeToStructReport")
        End_Procedure

        // 4534 ToOEM/ToANSI inside a custom macro/command (e.g. File_Exist_OEM, whose body calls
        // ToOEM): the warning fires at the call site, but the token isn't on that line, so the
        // line-based fix can't act -> VerifyAutoFix demotes to Explain. A direct call stays Auto-fix.
        {Published = True}
        Procedure ModAnalyzer_4534_MacroExpansion_Demoted
            Handle ho
            tModAnalyzer Recipe rDirect rMacro
            Get MakeRecipe 4534 "Obsolete use of ToOEM, use Utf8ToOem or AnsiToUtf8 instead." to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho Recipe "Move (ToOEM(sName)) to sOem" to rDirect
            Send Assert (rDirect.eCategory = eModAutoFix)
            Send Assert (rDirect.sRefactorFn = "UnicodeOemAnsiFunctions")
            Get VerifyAutoFix of ho Recipe "File_Exist_OEM (Trim(Kund_dok.dok)) bFileExists" to rMacro
            Send Assert (rMacro.eCategory = eModExplain)
            Send Assert (rMacro.sRefactorFn = "")
            Send Destroy of ho
        End_Procedure

        /* Compile error 52 "(operator) <WORD>" is owned by SplitCommandOutOfCondition, Auto-fix BY
           SHAPE: VerifyAutoFix dry-runs it against the warned line. The wrapped-command line stays
           Auto-fix; a 52 of another shape ('Get Func() to var') goes back to Explain with the general
           advice, never the macro wording. The Swedish compiler text is what a Swedish-locale compiler produces - the
           match is on "(operator)", which the localisation keeps. (2026-09-05) */
        {Published = True}
        Procedure ModAnalyzer_52_WrappedCommand_AutoFixByShape
            Handle ho
            tModAnalyzer Recipe rShape rOther
            Get MakeRecipe 52 "Fel format i uttryck (operator) MYWRITEPOS" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "SplitCommandOutOfCondition" Recipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Send Assert (RecipeNeedsSourceGuard(ho, Recipe)) "the 52 repair must be source-guarded"
            Get VerifyAutoFix of ho Recipe '                If (Cust.Flag = "1" MyWritePos "*" 18.7 (FONT_DEFAULT))' to rShape
            Send Assert (rShape.eCategory = eModAutoFix)
            Send AssertSAreEqual "SplitCommandOutOfCondition" rShape.sRefactorFn
            Get VerifyAutoFix of ho Recipe '    Get Trim() to sX' to rOther
            Send Assert (rOther.eCategory = eModExplain)
            Send AssertSAreEqual "" rOther.sRefactorFn
            Send Assert (rOther.sHint contains "Get Func() to var") rOther.sHint
            Send Destroy of ho
        End_Procedure

        // 4538 "Obsolete command: Indicator. Use Boolean" -> ChangeIndicatorToBoolean owns it (the
        // global Indicator DECLARATION). Source-guarded like the other line-construct refactors: a
        // genuine "Indicator X" line stays Auto-fix; a 4538 that fires inside a macro expansion (whose
        // call-site line has no literal "Indicator") demotes to Explain.
        {Published = True}
        Procedure ModAnalyzer_4538_MacroExpansion_Demoted
            Handle ho
            tModAnalyzer Recipe rGenuine rMacro
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeIndicatorToBoolean")
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho Recipe "Indicator User" to rGenuine
            Send Assert (rGenuine.sRefactorFn = "ChangeIndicatorToBoolean")
            Get VerifyAutoFix of ho Recipe "Deferred_View Activate_oFoo For ;" to rMacro
            Send Assert (rMacro.eCategory = eModExplain)
            Send Assert (rMacro.sRefactorFn = "")
            Send Destroy of ho
        End_Procedure

        // A PINNED indicator (GROUP/ALL participant, or read by a 'use'd include) is left legacy by the
        // converters, so VerifyAutoFix DEMOTES its row to Explain - both the 'Indicator X' declaration and
        // a '[X]' usage. An identical NON-pinned line stays Auto-fix. (Nils 2026-07-09.)
        {Published = True}
        Procedure ModAnalyzer_4538_PinnedIndicator_Demoted
            Handle ho
            String[] asPinned asEmpty
            tModAnalyzer Recipe rDecl rUse rOther

            Move "GRP_FLAG" to asPinned[0]
            Set pasPinnedIndicators of ghoFuncLib to asPinned
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get Create (RefClass(cModAnalyzer)) to ho
            // pinned declaration -> Explain
            Get VerifyAutoFix of ho Recipe "Indicator grp_flag" to rDecl
            Send Assert (rDecl.eCategory = eModExplain)
            Send Assert (rDecl.sRefactorFn = "")
            // pinned usage -> Explain (ChangeLegacyIndicators recipe)
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "If [grp_flag] Begin" to rUse
            Send Assert (rUse.eCategory = eModExplain)
            // a DIFFERENT indicator (not pinned) is untouched by the pin demote
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicator ready_flag" to rOther
            Send Assert (rOther.sRefactorFn = "ChangeIndicatorToBoolean")
            Send Destroy of ho
            Set pasPinnedIndicators of ghoFuncLib to asEmpty
        End_Procedure

        /* The demotion hint has to name the reason that ACTUALLY fired, and the file (Nils 2026-07-30).

           It used to state both reasons as an either/or, leading with the GROUP/ALL one - and that is
           the rare case, "a handful of times" in his experience. So nearly every real row opened with
           the wrong explanation. He reported 'Indicate not_hist_sch true' as a misidentification; the
           verdict was right and only the wording was wrong - the name was pinned because a shared .MAC
           included by 19 programs reads it, and no group Indicate existed anywhere in that file.

           Three cases, because the fallback matters as much as the two real ones: the pinned set can be
           Set directly (the test above does exactly that, and so does the engine's per-file hand-off),
           and a hint that cannot look its reason up must say so honestly rather than pick one. */
        {Published = True}
        Procedure ModAnalyzer_PinnedIndicatorHintNamesReasonAndFile
            Handle ho
            String[] asPinned asReasons asEmpty
            String sWhyProbe
            tModAnalyzer Recipe rInc rGrp rGrpNoLn rBare

            Move "SHARED_FLAG" to asPinned[0]
            Move "GRP_FLAG"    to asPinned[1]
            Move "USE|shared.mac" to asReasons[0]
            Move "GROUP|845"      to asReasons[1]
            Set pasPinnedIndicators of ghoFuncLib to asPinned
            Set pasPinnedReasons    of ghoFuncLib to asReasons
            Get Create (RefClass(cModAnalyzer)) to ho

            // (1) read by an include -> names the indicator AND the file, and does NOT mention GROUP/ALL.
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate shared_flag True" to rInc
            Send Assert (rInc.eCategory = eModExplain)
            Send Assert (Pos("shared.mac", rInc.sHint) > 0)
            Send Assert (Pos("SHARED_FLAG", rInc.sHint) > 0)
            Send Assert (Pos("GROUP/ALL", rInc.sHint) = 0)

            /* (2) GROUP/ALL participant -> says so, CITES THE LINE, and does NOT blame an include.
                   The citation is the part Nils needed: he reported this verdict as false because the
                   group line sat 199 lines below the flagged one in a wide report file, so there was
                   nothing in the row to check it against. */
            // The reason must survive VerifyAutoFix's own ClearFuncLibProperties call - it is read
            // back mid-verify, after the tokenize.
            Get _PinnedIndicatorReason of ghoFuncLib "GRP_FLAG" to sWhyProbe
            Send AssertSAreEqual "GROUP|845" sWhyProbe
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate grp_flag True" to rGrp
            Send Assert (rGrp.eCategory = eModExplain)
            Send Assert (Pos("GROUP/ALL", rGrp.sHint) > 0) ("CASE2-groupall " + rGrp.sHint)
            Send Assert (Pos("line 845", rGrp.sHint) > 0) ("CASE2-line " + rGrp.sHint)
            Send Assert (Pos("include", rGrp.sHint) = 0) ("CASE2-include " + rGrp.sHint)

            /* (2b) an OLD reason with no line number still reads correctly - just without the citation.
                    The absence probe is " at line " with BOTH spaces: bare "at line" is a substring of
                    "th-at line" in the hint's own "would leave that line referring to...", so the
                    loose form matches the very sentence it is meant to rule out. */
            Move "GROUP|" to asReasons[1]
            Set pasPinnedReasons of ghoFuncLib to asReasons
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate grp_flag True" to rGrpNoLn
            Send Assert (Pos("GROUP/ALL", rGrpNoLn.sHint) > 0) ("CASE2B-groupall " + rGrpNoLn.sHint)
            Send Assert (Pos(" at line ", rGrpNoLn.sHint) = 0) ("CASE2B-noline " + rGrpNoLn.sHint)

            /* (2c) the three reasons that had no wording (2026-09-13): an odd name, a #COMMAND body, a raw
                    directive - each names its own cause and its line, and none blames a group or an include. */
            Move "ODDNAME|3"    to asReasons[0]
            Move "MACRO|7"      to asReasons[1]
            Set pasPinnedReasons of ghoFuncLib to asReasons
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate shared_flag True" to rBare
            Send Assert (Pos("spells a name", rBare.sHint) > 0) ("CASE2C-odd " + rBare.sHint)
            Send Assert (Pos("(line 3)", rBare.sHint) > 0) ("CASE2C-oddline " + rBare.sHint)
            Send Assert (Pos("GROUP/ALL", rBare.sHint) = 0) ("CASE2C-oddgroup " + rBare.sHint)
            Get VerifyAutoFix of ho Recipe "Indicate grp_flag True" to rBare
            Send Assert (Pos("#COMMAND body", rBare.sHint) > 0) ("CASE2C-macro " + rBare.sHint)
            Send Assert (Pos("line 7", rBare.sHint) > 0) ("CASE2C-macroline " + rBare.sHint)
            Send Assert (Pos("include", rBare.sHint) = 0) ("CASE2C-macroinclude " + rBare.sHint)

            // (3) no reason recorded -> the honest either/or, not a guess.
            Set pasPinnedReasons of ghoFuncLib to asEmpty
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate shared_flag True" to rBare
            Send Assert (rBare.eCategory = eModExplain)
            Send Assert (Pos("GROUP/ALL", rBare.sHint) > 0)
            Send Assert (Pos("include", rBare.sHint) > 0)

            Send Destroy of ho
            Set pasPinnedIndicators of ghoFuncLib to asEmpty
            Set pasPinnedReasons    of ghoFuncLib to asEmpty
        End_Procedure

        /* A message from a LIBRARY file loses its refactor function and drops to Explain.

           The compiler follows the program's include chain into vwin32fh, DUF and the rest, so their
           files raise messages like any other and some of those match a recipe. Offering the fix
           would edit code maintained upstream, which the next library update overwrites - the one
           thing the library work has been consistent about.

           NOT suppression: the row survives with its count and says whose code it is. Pinned here
           because a regression would be invisible - the fix would simply be offered again, and only
           show up as a forked library weeks later.

           The roots are seeded directly rather than computed, and the memo key is DERIVED from
           whatever ghoApplication currently reports - so the test behaves the same whether or not a
           workspace happens to be loaded when the suite runs. */
        {Published = True}
        Procedure ModAnalyzer_LibraryFileMessageLosesItsRecipe
            Handle ho
            String[] asRoots asNames asEmpty
            tModAnalyzer Recipe rLib rOwn rNoFn

            Move "c:\ws\libraries\vwin32fh\"  to asRoots[0]
            Move "vwin32fh"                    to asNames[0]
            Get Create (RefClass(cModAnalyzer)) to ho
            Set pasLibRoots   of ho to asRoots
            Set pasLibNames   of ho to asNames
            /* A '*' key pins the seeded roots: RefreshLibraryRoots returns without recomputing.

               The first version set "" and relied on that matching the key the memo would derive
               from ghoApplication - which held only while no workspace was loaded, and failed
               otherwise: the memo recomputed, the seeded roots vanished, and the test failed for a
               reason having nothing to do with what it checks. A test must not depend on ambient
               application state. */
            Set psLibRootsKey of ho to "*seeded*"

            // A file INSIDE the library: recipe stripped, category demoted, library named.
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get VerifyLibraryOwned of ho Recipe "C:\WS\Libraries\vWin32fh\vwin32fh.pkg" to rLib
            Send AssertSAreEqual "" rLib.sRefactorFn
            Send Assert (rLib.eCategory = eModExplain)
            Send Assert (Pos("vwin32fh", rLib.sHint) > 0) rLib.sHint

            // The workspace's OWN code is untouched - same recipe, same message.
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get VerifyLibraryOwned of ho Recipe "C:\WS\AppSrc\Order.vw" to rOwn
            Send AssertSAreEqual "ChangeIndicatorToBoolean" rOwn.sRefactorFn

            // A neighbour whose name merely starts the same is not the library.
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get VerifyLibraryOwned of ho Recipe "C:\WS\Libraries\vWin32fhExtra\x.pkg" to rOwn
            Send AssertSAreEqual "ChangeIndicatorToBoolean" rOwn.sRefactorFn

            // A library row that never had a fix keeps whatever hint it had - nothing to strip.
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Move "" to Recipe.sRefactorFn
            Move "an existing explanation" to Recipe.sHint
            Get VerifyLibraryOwned of ho Recipe "C:\WS\Libraries\vWin32fh\vwin32fh.pkg" to rNoFn
            Send AssertSAreEqual "an existing explanation" rNoFn.sHint

            Send Destroy of ho
        End_Procedure

        /* A row on MACRO CODE is never offered as a fix (Nils 2026-09-07: "no macro code should ever
           be refactored") - its function is cleared and it reads Explain, whatever category it had.

           Macro code is what the engine leaves as written: a #COMMAND body, a #DATA block and a
           compiler-directive line. The plan builder adds a function on sRefactorFn <> "" alone, with
           no category test, so a row that still names its converter joins the plan whatever it is
           labelled. Until 2026-10-04 only Auto-fix rows were cleared, and a REVIEW row on a #COMMAND
           body ran a function that changed nothing ("0 lines Renamed") - pinned below. */
        {Published = True}
        Procedure ModAnalyzer_MacroCodeRowIsNeverOffered
            Handle ho
            String[] asLines
            String sWasFn
            tModAnalyzer Recipe rIn rOut rAfter rReview rBang rData rPast

            /* The '#' and '!' tokens are CONCATENATED, never written as literals: both are macro
               syntax to the compiler, even inside a string (see the scanner's macro-body fixture). */
            Move ("#" + "COMMAND MYWRITEPOS R")                       to asLines[0]
            Move "   Write channel gi$Ch (ToAnsi(Trim(gs$Label)))"    to asLines[1]
            Move ("#" + "ENDCOMMAND")                                 to asLines[2]
            Move "Move (ToAnsi(sX)) to sY"                            to asLines[3]
            Move ("!" + "A [not gbShown] $1C4 sLabel")                to asLines[4]
            Move ("#" + "DATA")                                       to asLines[5]
            Move "   ToAnsi"                                          to asLines[6]
            Move ("#" + "ENDDATA")                                    to asLines[7]
            Move "Move (ToAnsi(sZ)) to sY"                            to asLines[8]
            Get Create (RefClass(cModAnalyzer)) to ho

            // Line 2 (1-based) sits inside the macro body -> no function, Explain, the converter named.
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move eModAutoFix to Recipe.eCategory
            Move (Trim(Recipe.sRefactorFn)) to sWasFn      // whatever converter this recipe carries
            Send Assert (sWasFn <> "") "fixture recipe carries no converter - nothing to test"
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 2 to rIn
            Send Assert (rIn.eCategory = eModExplain) "macro-body row is still offered as a fix"
            Send AssertSAreEqual "" rIn.sRefactorFn
            Send Assert (Pos(sWasFn, rIn.sHint) > 0) ("the hint must still name the converter: " + rIn.sHint)
            Send Assert (rIn.sHint contains "never changes macro code") ("the hint must say why: " + rIn.sHint)

            // ...and a REVIEW row there too: the plan would run its function for nothing (2026-10-04).
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move eModSuggest to Recipe.eCategory
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 2 to rReview
            Send Assert (rReview.eCategory = eModExplain) "a Review row on macro code is still offered"
            Send AssertSAreEqual "" rReview.sRefactorFn

            // Line 4 is AFTER #ENDCOMMAND - ordinary code, keeps Auto-fix and its converter.
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move eModAutoFix to Recipe.eCategory
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 4 to rAfter
            Send Assert (rAfter.eCategory = eModAutoFix) "a line outside the macro lost its Auto-fix"
            Send AssertSAreEqual sWasFn rAfter.sRefactorFn

            // A compiler-directive line and a #DATA block are macro code too - the engine's own list.
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move eModAutoFix to Recipe.eCategory
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 5 to rBang
            Send AssertSAreEqual "" rBang.sRefactorFn
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 7 to rData
            Send AssertSAreEqual "" rData.sRefactorFn
            // ...and the line after #ENDDATA is ordinary code again.
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 9 to rPast
            Send AssertSAreEqual sWasFn rPast.sRefactorFn

            // A row with no function has nothing to withdraw: untouched, hint and all.
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move ""          to Recipe.sRefactorFn
            Move eModExplain to Recipe.eCategory
            Move "as it was" to Recipe.sHint
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 2 to rOut
            Send AssertSAreEqual "as it was" rOut.sHint
            Send Destroy of ho
        End_Procedure

        // A #COMMAND line in a multi-line string's text opens no macro block (2026-10-29): a row on the code after
        // that string keeps its converter, as the engine converts that line.
        {Published = True}
        Procedure ModAnalyzer_CodeAfterAStringHoldingACommandIsOffered
            Handle ho
            String[] asLines
            String sWasFn
            tModAnalyzer Recipe rAfter
            Move '    Move """'                                to asLines[0]
            Move ("        #" + "COMMAND MYWRITEPOS R")        to asLines[1]
            Move '        """ to sText'                        to asLines[2]
            Move "Move (ToAnsi(sX)) to sY"                     to asLines[3]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MakeRecipe 4534 "Obsolete use of ToANSI" to Recipe
            Move eModAutoFix to Recipe.eCategory
            Move (Trim(Recipe.sRefactorFn)) to sWasFn
            Get VerifyMacroBodyLine of ho Recipe (&asLines) 4 to rAfter
            Send Assert (rAfter.eCategory = eModAutoFix) "the line after the string lost its Auto-fix"
            Send AssertSAreEqual sWasFn rAfter.sRefactorFn
            Send Destroy of ho
        End_Procedure

        /* The grid/list converters rewrite an OBJECT declaration and nothing else, so a compiler
           message landing on a SUBCLASS or an AUGMENTATION of the retired class must not offer
           them (Nils 2026-08-30, E 4345 U_DBLIST on "Class cMyDbList is a DBList").

           The two POSITIVE CONTROLS are the point of this fixture, not padding: the shapes that
           genuinely DO convert - a plain object declaration, and a Begin_Row inside one - must
           come through untouched. A demotion keyed on "the line does not start with Object" would
           pass the first two assertions here and silently kill every Begin_Row row in the app. */
        {Published = True}
        Procedure VerifyLegacyClassShape_SubclassLosesTheConverter
            Handle ho
            tModAnalyzer Recipe rSub rAug rObj rRow
            String[] asLines
            String sWasFn

            Move "Class cMyDbList is a DBList"        to asLines[0]
            Move "Procedure Clear_All for DBGrid"     to asLines[1]
            Move "Object oList is a dbList"           to asLines[2]
            Move "    Begin_Row"                      to asLines[3]
            Get Create (RefClass(cModAnalyzer)) to ho

            // 1. The subclass declaration - the reported case. The converter's OWN recipe, built here: since
            //    2026-11-13 the first recipe this message matches is MakeFileAutonomous's (4345 | error u_),
            //    which adds the missing Use and is no grid converter.
            Get GridConverterRecipe "U_DBLIST" "RefactorDbListTocDbCJGridPromptList" to Recipe
            Move (Trim(Recipe.sRefactorFn)) to sWasFn
            Send Assert (sWasFn <> "") "fixture recipe carries no converter - nothing to test"
            Get VerifyLegacyClassShape of ho Recipe (&asLines) 1 to rSub
            Send AssertSAreEqual "" rSub.sRefactorFn
            Send Assert (rSub.eCategory = eModExplain) "a subclass row is still offered a converter"
            // The converter stays NAMED in the hint - plain instances elsewhere still convert.
            Send Assert (Pos(sWasFn, rSub.sHint) > 0) ("the hint must still name the converter: " + rSub.sHint)

            // 2. The augmentation shape, same reasoning ("Procedure X for DBGrid").
            Get GridConverterRecipe "U_DBGRID" "RefactorDbGridTocDbCJGrid" to Recipe
            Get VerifyLegacyClassShape of ho Recipe (&asLines) 2 to rAug
            Send AssertSAreEqual "" rAug.sRefactorFn

            // 3. POSITIVE CONTROL - a plain object declaration KEEPS its converter.
            Get GridConverterRecipe "U_DBLIST" "RefactorDbListTocDbCJGridPromptList" to Recipe
            Get VerifyLegacyClassShape of ho Recipe (&asLines) 3 to rObj
            Send AssertSAreEqual sWasFn (Trim(rObj.sRefactorFn))

            // 4. POSITIVE CONTROL - a Begin_Row inside an object KEEPS its converter. This is the
            //    line the converter's own enrichment (VerifyBeginRow) resolves to its object.
            //    Asserted UNCONDITIONALLY: wrapping it in "if this recipe has a converter" would let
            //    the control skip in silence the day the recipe changes, which is the one outcome a
            //    positive control must never have.
            Get MakeRecipe 4533 "Begin_Row" to Recipe
            Move (Trim(Recipe.sRefactorFn)) to sWasFn
            Send Assert (sWasFn <> "") "the Begin_Row recipe carries no converter - this control proves nothing"
            Get VerifyLegacyClassShape of ho Recipe (&asLines) 4 to rRow
            Send AssertSAreEqual sWasFn (Trim(rRow.sRefactorFn))
            Send Destroy of ho
        End_Procedure

        // The shared source-guard predicate that keeps the triage GRID and the refactor PLAN in
        // lock-step (the divergence Nils found: UnicodeOemAnsiFunctions in the Plan but not the
        // grid). Both call RecipeNeedsSourceGuard, so a "use of X" auto-fix, the legacy-indicator
        // review, and the Unicode 4539 pair (Pointer<->String, a macro-expansion no-op guard) are
        // guarded in BOTH; a class-swap auto-fix (e.g. Edit->cTextEdit) always applies at its
        // declaration line, so it is guarded in NEITHER. (Nils 2026-06-12 / 2026-07-08.)
        {Published = True}
        Procedure ModAnalyzer_RecipeNeedsSourceGuard_Predicate
            Handle ho
            tModAnalyzer rOem rLegacy rPtrStr rSwap rClass
            Boolean bOem bLegacy bPtrStr bSwap bClass

            Get Create (RefClass(cModAnalyzer)) to ho
            Get MakeRecipe 4534 "Obsolete use of ToOEM, use Utf8ToOem or AnsiToUtf8 instead." to rOem
            Get RecipeNeedsSourceGuard of ho rOem to bOem
            Send Assert bOem
            // 4538 "Use Move command" variant -> ChangeLegacyIndicators (the [Found]/Indicate USAGE review).
            // Must use a real match-text variant: the old "Obsolete indicators" text matched NO recipe after
            // 4538 became match-text-routed (v26), so it resolved to no function and the guard read False.
            Get MakeRecipe 4538 "Obsolete command: Indicate. Use Move command" to rLegacy
            Get RecipeNeedsSourceGuard of ho rLegacy to bLegacy
            Send Assert bLegacy
            // 4539 Pointer->String -> UnicodePointerToString: NOW guarded (2026-07-08). The converter only
            // rewrites a bare 'Move <ptr> to <str>'; a 4539 from a #COMMAND expansion (e.g. Local_Buffer) reports
            // at the invocation line the converter can't touch, so the whole-file dry-run must demote it.
            Get MakeRecipe 4539 "Conversion from Pointer to String is not allowed, use PointerToString function" to rPtrStr
            Get RecipeNeedsSourceGuard of ho rPtrStr to bPtrStr
            Send Assert bPtrStr
            // A recipe with NO match text cannot be classified into a guarded family -> not guarded.
            Move eModAutoFix              to rSwap.eCategory
            Move "RefactorEditTocTextEdit" to rSwap.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rSwap to bSwap
            Send AssertFalse bSwap
            // But a real "class: X" recipe IS guarded now (2026-07-26). It used to be unguarded on the
            // reasoning that a class swap always applies at its declaration line - which is untrue when
            // the converter DECLINES the object and writes a skip-marker instead (ChangeDfTimerTocTimer
            // on a Timer_Message-dispatch object). The declaration is unchanged, so the compiler keeps
            // warning; reading the line is what lets VerifySkipMarker see the marker and demote.
            Move eModAutoFix               to rClass.eCategory
            Move "ChangeDfTimerTocTimer"   to rClass.sRefactorFn
            Move "class: DFTIMER"          to rClass.sMatchText
            Get RecipeNeedsSourceGuard of ho rClass to bClass
            Send Assert bClass
            Send Destroy of ho
        End_Procedure

        /* A REVIEW row misattributed to a macro invocation must demote too. The guard used to be
           auto-fix-only, so this whole family slipped through: LegacyApp's Deferred_View macro
           carries 'Gosub Create_!1' in its body, the compiler attributes the expanded 4533 to each
           INVOCATION site, and every deferred view in the workspace became a Review row pointing at
           'Object <name> is a cTrDbView' - a line with no Gosub on it (Nils 2026-07-26). */
        {Published = True}
        Procedure ModAnalyzer_SuggestCommandRow_MacroExpansionDemotes
            Handle ho
            tModAnalyzer Recipe
            Get Create (RefClass(cModAnalyzer)) to ho
            Move eModSuggest        to Recipe.eCategory
            Move "command: Gosub"   to Recipe.sMatchText
            Move "GosubGotoReport"  to Recipe.sRefactorFn
            // The real invocation line: no "gosub" anywhere on it.
            Get VerifyAutoFix of ho Recipe "    Object SnabbProspekt is a cTrDbView" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send AssertSAreEqual "" (Trim(Recipe.sRefactorFn))
            Send Destroy of ho
        End_Procedure

        // ... and a REVIEW row whose command IS on the line is left alone.
        {Published = True}
        Procedure ModAnalyzer_SuggestCommandRow_OnLineKept
            Handle ho
            tModAnalyzer Recipe
            Get Create (RefClass(cModAnalyzer)) to ho
            Move eModSuggest        to Recipe.eCategory
            Move "command: Gosub"   to Recipe.sMatchText
            Move "GosubGotoReport"  to Recipe.sRefactorFn
            Get VerifyAutoFix of ho Recipe "        Gosub Create_Something" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send AssertSAreEqual "GosubGotoReport" (Trim(Recipe.sRefactorFn))
            Send Destroy of ho
        End_Procedure

        // The predicate must ask for the source line for a REVIEW "command: X" row, or the guard above
        // never runs (it was gated on eModAutoFix).
        {Published = True}
        Procedure ModAnalyzer_SuggestCommandRow_IsSourceGuarded
            Handle ho
            tModAnalyzer Recipe
            Boolean bGuard
            Get Create (RefClass(cModAnalyzer)) to ho
            Move eModSuggest       to Recipe.eCategory
            Move "command: Gosub"  to Recipe.sMatchText
            Move "GosubGotoReport" to Recipe.sRefactorFn
            Get RecipeNeedsSourceGuard of ho Recipe to bGuard
            Send Assert bGuard
            Send Destroy of ho
        End_Procedure

        /* A converter's own skip-marker must stop the analyzer re-offering the line. The compiler
           keeps warning (the class IS still obsolete), so the row has to survive - as Review,
           carrying the converter's own words - but it must never be Auto-fix again, or the plan
           re-runs a converter that only declines and the row returns on every Check for ever.
           (Nils 2026-07-26: "keeps nagging about ChangeDfTimerTocTimer, although a comment has
           already been placed above the timer object".) */
        {Published = True}
        Procedure ModAnalyzer_VerifySkipMarker_AboveLineDemotes
            Handle ho
            tModAnalyzer Recipe
            String[] asLines

            Get Create (RefClass(cModAnalyzer)) to ho
            Move '        //TODO dfTimer->cTimer (skipped): Uses the Timer_Message/Timer_object dispatch - rewrite OnTimer by hand.' to asLines[0]
            Move '        Object oCounter is a DFTimer' to asLines[1]
            Move eModAutoFix             to Recipe.eCategory
            Move "ChangeDfTimerTocTimer" to Recipe.sRefactorFn
            // iLine is 1-based: line 2 is the object declaration, the marker sits above it.
            Get VerifySkipMarker of ho Recipe (&asLines) 2 to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send AssertSAreEqual "" (Trim(Recipe.sRefactorFn))
            // The hint quotes the converter's own reason rather than inventing one.
            Send Assert (Recipe.sHint contains "Timer_Message")
            Send Destroy of ho
        End_Procedure

        // The popup converter's own marker is re-asked (2026-09-13): above an object the converter takes
        // by now the recipe keeps its offer; above one it still refuses the demotion stands, quoting it.
        {Published = True}
        Procedure ModAnalyzer_VerifySkipMarker_StalePopupMarkerKeepsTheOffer
            Handle ho
            tModAnalyzer Recipe Out
            String[] asLines

            Get Create (RefClass(cModAnalyzer)) to ho
            Move '    //  TODO (DFRefactor): ChangeFloatingPopupMenuToCodeJock left oPop as written - line 3 is not part of the popup grammar. Clear that and run it again, or port the object to cCJContextMenu by hand.' to asLines[0]
            Move '    Object oPop is a FloatingPopupMenu'          to asLines[1]
            Move '        Send Add_Item Msg_Foo "Foo"'             to asLines[2]
            Move '    End_Object'                                  to asLines[3]
            Move eModAutoFix                        to Recipe.eCategory
            Move "ChangeFloatingPopupMenuToCodeJock" to Recipe.sRefactorFn
            Get VerifySkipMarker of ho Recipe (&asLines) 2 to Out
            Send Assert (Out.eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeFloatingPopupMenuToCodeJock" (Trim(Out.sRefactorFn))
            // still refused: the marker holds and the row reads Explain with the reason
            Move '        Procedure OnSomething'                   to asLines[3]
            Move '        End_Procedure'                           to asLines[4]
            Move '    End_Object'                                  to asLines[5]
            Get VerifySkipMarker of ho Recipe (&asLines) 2 to Out
            Send Assert (Out.eCategory = eModExplain)
            Send AssertSAreEqual "" (Trim(Out.sRefactorFn))
            Send Assert (Out.sHint contains "popup grammar")
            Send Destroy of ho
        End_Procedure

        // No marker: the row is left exactly as the recipe classified it.
        {Published = True}
        Procedure ModAnalyzer_VerifySkipMarker_NoMarkerUntouched
            Handle ho
            tModAnalyzer Recipe
            String[] asLines
            Get Create (RefClass(cModAnalyzer)) to ho
            Move '        // an ordinary comment about the timer' to asLines[0]
            Move '        Object oCounter is a DFTimer'           to asLines[1]
            Move eModAutoFix             to Recipe.eCategory
            Move "ChangeDfTimerTocTimer" to Recipe.sRefactorFn
            Get VerifySkipMarker of ho Recipe (&asLines) 2 to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeDfTimerTocTimer" (Trim(Recipe.sRefactorFn))
            Send Destroy of ho
        End_Procedure

        // TRAILING placement (marker on the warned line itself) - the other shape cDeepScanner reads.
        {Published = True}
        Procedure ModAnalyzer_VerifySkipMarker_TrailingMarkerDemotes
            Handle ho
            tModAnalyzer Recipe
            String[] asLines
            Get Create (RefClass(cModAnalyzer)) to ho
            Move '    Move lpBuf to sText // TODO (DFRefactor): NOT converted - strmark' to asLines[0]
            Move eModAutoFix              to Recipe.eCategory
            Move "UnicodePointerToString" to Recipe.sRefactorFn
            Get VerifySkipMarker of ho Recipe (&asLines) 1 to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send AssertSAreEqual "" (Trim(Recipe.sRefactorFn))
            Send Destroy of ho
        End_Procedure

        // Regression (2026-06-19): ChangeSquareBracketsIndicators must be source-guarded too - it shares
        // the [bracket]/Indicate domain with ChangeLegacyIndicators. It was missing from
        // RecipeNeedsSourceGuard, so a 4538 on a NON-bracket line - the legacy "Obsolete command:
        // Indicator. Use Boolean" type declaration, which neither function fixes - slipped it into the
        // refactor PLAN (MatchingRecipesFromList, unguarded) while the GRID demoted it, so the two
        // disagreed. Both must guard identically.
        {Published = True}
        Procedure ModAnalyzer_SquareBracketsIndicators_SourceGuarded
            Handle ho
            tModAnalyzer rRecipe rChecked
            Boolean bGuard

            Get Create (RefClass(cModAnalyzer)) to ho
            Move 4538 to rRecipe.iMsgNumber
            Move eModSuggest to rRecipe.eCategory
            Move "ChangeSquareBracketsIndicators" to rRecipe.sRefactorFn
            // (a) it needs source-guarding
            Get RecipeNeedsSourceGuard of ho rRecipe to bGuard
            Send Assert bGuard
            // (b) the "Indicator" type-declaration line (no "[" / no "indicate") demotes it to Explain
            Get VerifyAutoFix of ho rRecipe "Property Indicator gbFlag" to rChecked
            Send Assert (rChecked.eCategory = eModExplain)
            Send Assert (rChecked.sRefactorFn = "")
            // (c) a real bracket line keeps it actionable
            Get VerifyAutoFix of ho rRecipe "If [Found] Begin" to rChecked
            Send Assert (rChecked.sRefactorFn = "ChangeSquareBracketsIndicators")
            Send Destroy of ho
        End_Procedure

        // 4544 (ambiguous return type used in expression) now routes to ChangeObjectFunctionCallToGet (Auto-fix):
        // the DF26 object-method-in-expression call it rewrites (Move (fcount(Self, x)) to v -> Get fcount x to v)
        // is the dominant 4544 cause. A 4544 it can't touch (a bare Get_ accessor / COM property) is demoted back to
        // Explain by the whole-file source-guard (VerifyAutoFixWholeFile) - that needs the runtime FunctionsA
        // MethodType table, so it's verified in-app, NOT in the pure DFUnit runner (same as the property removers).
        // Here we assert the CLASSIFICATION stage.
        {Published = True}
        Procedure ModAnalyzer_4544_RoutesToObjFuncCallToGet
            tModAnalyzer Recipe
            Get MakeRecipe 4544 "Function GET_FCOUNT with ambiguous return type used in expression" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeObjectFunctionCallToGet" Recipe.sRefactorFn
        End_Procedure

        // 4345 reserved name (iEntry/iExit/iValidate): no refactor fn -> Explain (manual rename). The
        // text has no "SELECT, MUST BE DEFINED", so it must NOT match the SELECT variant below. Falls to
        // the broadened empty-match generic (still Explain, function-less).
        {Published = True}
        Procedure ModAnalyzer_4345_ReservedName_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "iExit should not be defined" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
        End_Procedure

        // 4345 "#$, ARGUMENT REQUIRED" (the dominant LegacyApp variant, e.g. GetBuff ... tRECT.left): the
        // text-routed variant must win over the generic and give a cause-pointing hint (a knock-on from a
        // Type member / undefined symbol on the line) - NOT the reserved-FMAC-name hint. Function-less -> Explain.
        {Published = True}
        Procedure ModAnalyzer_4345_ArgumentRequired_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "Type check error argument required" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Lowercase(Recipe.sHint) contains "knock-on")
        End_Procedure

        // 4345 "|SI.., INVALID LITERAL": text-routed to the cascade hint (broken-expression fall-out), not
        // the reserved-name hint. Function-less -> Explain.
        {Published = True}
        Procedure ModAnalyzer_4345_InvalidLiteral_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "Type check error invalid literal" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Lowercase(Recipe.sHint) contains "compiler-internal literal")
        End_Procedure

        // 4544 CLASSIFICATION is text-agnostic (no match-text distinguishes an object-method call from a bare
        // GET_COMSIZE/GET_COMID COM accessor), so a COM-accessor 4544 ALSO classifies to ChangeObjectFunctionCallToGet.
        // The two are separated at RUNTIME by the whole-file source-guard: the pass rewrites the object-method call
        // but leaves the COM accessor unchanged, so VerifyAutoFixWholeFile demotes the COM row back to Explain
        // (in-app only - needs FunctionsA). Here we assert the shared classification.
        {Published = True}
        Procedure ModAnalyzer_4544_ComAccessor_ClassifiesToObjFuncCallToGet
            tModAnalyzer Recipe
            Get MakeRecipe 4544 "Ambiguous function in expression Function GET_COMID with ambiguous return type used in expression" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeObjectFunctionCallToGet" Recipe.sRefactorFn
        End_Procedure

        // ...and the MULTI-match path the GRID uses (MatchingRecipesFromList) returns the SAME function-backed
        // recipe (it is not function-less, so _DemoteFunctionlessToExplain leaves it alone).
        {Published = True}
        Procedure ModAnalyzer_4544_MultiMatch_ObjFuncCallToGet
            tModAnalyzer[] aMatched
            Get MakeMatches 4544 "Ambiguous function in expression Function GET_COMSIZE with ambiguous return type used in expression" to aMatched
            Send AssertIAreEqual 1 (SizeOfArray(aMatched))
            Send Assert (aMatched[0].eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeObjectFunctionCallToGet" aMatched[0].sRefactorFn
        End_Procedure

        // 4533 | command: Local -> RemoveLocalKeyWord (it DOES warn "Obsolete command: Local"; recipe wired v36).
        {Published = True}
        Procedure ModAnalyzer_4533_Local_RemoveLocalKeyWord
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete command: Local. Local is not needed" to Recipe
            Send Assert (Recipe.sRefactorFn = "RemoveLocalKeyWord")
        End_Procedure

        // 4533 | command: System -> ChangeSystemToAbort.
        {Published = True}
        Procedure ModAnalyzer_4533_System_Abort
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete command: System. Use Abort command" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeSystemToAbort")
        End_Procedure

        // 4533 | command: External_Function32 -> ChangeExternalFunction32ToExternalFunction.
        {Published = True}
        Procedure ModAnalyzer_4533_ExternalFunction32
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete command: External_Function32. Use External_Function" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeExternalFunction32ToExternalFunction")
        End_Procedure

        // 4533 | DEFINE_AUTO_INCREMENT -> ChangeDefineAutoIncrement. The warning reads "Obsolete command
        // DEFINE_AUTO_INCREMENT" with NO colon, so the recipe matches the bare command name (not "command: X").
        {Published = True}
        Procedure ModAnalyzer_4533_DefineAutoIncrement
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete command DEFINE_AUTO_INCREMENT. Use Set Field_Auto_Increment" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeDefineAutoIncrement")
        End_Procedure

        // 4535 / 4538 "indicators in If statements": legacy `if [indicator]` (e.g. `if [gibDebugMode];`,
        // `If Not [Found] Begin`) fires this variant under BOTH message numbers. It had no matching recipe and
        // fell through to Unknown, even though the bracket converters fix `if [X]`. Both converters now claim it;
        // the multi-match plan path (MatchingRecipesFromList) must return BOTH for either message number.
        {Published = True}
        Procedure ModAnalyzer_4535_IndicatorsInIf
            tModAnalyzer[] aMatch
            Boolean bSquare bLegacy
            Get MakeMatches 4535 "Obsolete Technique Do not use indicators in If statements, use expression if (var)" to aMatch
            Get MatchesContainFn aMatch "ChangeSquareBracketsIndicators" to bSquare
            Get MatchesContainFn aMatch "ChangeLegacyIndicators" to bLegacy
            Send Assert bSquare
            Send Assert bLegacy
        End_Procedure

        {Published = True}
        Procedure ModAnalyzer_4538_IndicatorsInIf
            tModAnalyzer[] aMatch
            Boolean bSquare bLegacy
            Get MakeMatches 4538 "Obsolete Indicator Use Do not use indicators in If statements, use expression if (var)" to aMatch
            Get MatchesContainFn aMatch "ChangeSquareBracketsIndicators" to bSquare
            Get MatchesContainFn aMatch "ChangeLegacyIndicators" to bLegacy
            Send Assert bSquare
            Send Assert bLegacy
        End_Procedure

        // 4535/4538 "indicators in If statements" is now AUTO-FIX. VerifyAutoFix's dry-run KEEPS a line the
        // converter actually changes as Auto-fix, and DEMOTES one it can't touch to Explain. Split into three so a
        // failure names the exact shape. Each builds the same eModAutoFix ChangeLegacyIndicators recipe.

        // Plain 'If [X]' - the converter changes it -> stays Auto-fix.
        {Published = True}
        Procedure ModAnalyzer_IndicatorsInIf_PlainAutoFix
            Handle ho
            tModAnalyzer rRecipe rOut
            Move 4538 to rRecipe.iMsgNumber
            Move eModAutoFix to rRecipe.eCategory
            Move "indicators in If statements" to rRecipe.sMatchText
            Move "ChangeLegacyIndicators" to rRecipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho rRecipe "    If [FINDERR] Begin" to rOut
            Send Destroy of ho
            Send Assert (rOut.eCategory = eModAutoFix)
        End_Procedure

        // 'If Not [X]' - now handled (normalize to [~X]) -> stays Auto-fix.
        {Published = True}
        Procedure ModAnalyzer_IndicatorsInIf_NotAutoFix
            Handle ho
            tModAnalyzer rRecipe rOut
            Move 4538 to rRecipe.iMsgNumber
            Move eModAutoFix to rRecipe.eCategory
            Move "indicators in If statements" to rRecipe.sMatchText
            Move "ChangeLegacyIndicators" to rRecipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho rRecipe "    If Not [Found] Begin" to rOut
            Send Destroy of ho
            Send Assert (rOut.eCategory = eModAutoFix)
        End_Procedure

        // An 'ind gbFlag True' line IS the construct (Ind is Indicate's obsolete spelling), so Guard B
        // keeps the row: neither demoted to Explain nor given the macro-expansion hint - which is what
        // put five such lines under "macro Ind - not yours to change" (Nils 2026-09-20). Suggest, as the
        // DS 9033 rule ships, and the AutoFix twin too.
        {Published = True}
        Procedure ModAnalyzer_IndCommandLineIsNotAMacroExpansion
            Handle ho
            tModAnalyzer rRecipe rOut
            Move 9033 to rRecipe.iMsgNumber
            Move eModSuggest to rRecipe.eCategory
            Move "ind" to rRecipe.sMatchText
            Move "ChangeLegacyIndicators" to rRecipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho rRecipe "    ind gbScrollFlag True" to rOut
            Send Assert (rOut.eCategory = eModSuggest)
            Send Assert (not(rOut.sHint contains CS_ModMacroExpansionHint))
            Move eModAutoFix to rRecipe.eCategory
            Get VerifyAutoFix of ho rRecipe "    ind gbScrollFlag True" to rOut
            Send Destroy of ho
            Send Assert (rOut.eCategory = eModAutoFix)
        End_Procedure

        // 'If [SELECT]' - a non-refactorable indicator the converter skips -> demoted to Explain.
        {Published = True}
        Procedure ModAnalyzer_IndicatorsInIf_SelectExplain
            Handle ho
            tModAnalyzer rRecipe rOut
            Move 4538 to rRecipe.iMsgNumber
            Move eModAutoFix to rRecipe.eCategory
            Move "indicators in If statements" to rRecipe.sMatchText
            Move "ChangeLegacyIndicators" to rRecipe.sRefactorFn
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho rRecipe "    If [SELECT] Begin" to rOut
            Send Destroy of ho
            Send Assert (rOut.eCategory = eModExplain)
        End_Procedure

        // Regression (LegacyApp 2026-07-02, crash 4381 Illegal Datatype Conversion): a "command:" recipe can
        // route to a WHOLE-FILE (eOtherFunction) function - ChangeBeginEndConstraint (4533 | command:
        // Begin_Constraint). VerifyAutoFix's Guard D line-probes "command:" rows, so AutoFixChangesLine must
        // NOT dispatch a single String into that function's String[] ByRef parameter. It now checks the method
        // type (FunctionsA-free, via pFuncLibArray) and keeps such a recipe Auto-fix instead of crashing.
        {Published = True}
        Procedure ModAnalyzer_4533_BeginConstraint_WholeFileNoCrash
            Handle ho
            tModAnalyzer Recipe rVerified
            Get MakeRecipe 4533 "Obsolete command: Begin_Constraint" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeBeginEndConstraint")
            Send Assert (Recipe.eCategory = eModAutoFix)
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyAutoFix of ho Recipe "        Begin_Constraints" to rVerified
            Send Assert (rVerified.eCategory = eModAutoFix)
            Send Assert (rVerified.sRefactorFn = "ChangeBeginEndConstraint")
            Send Destroy of ho
        End_Procedure

        // 4345 bare predefined SELECT (no OldFMACCommands.pkg): Auto-fix, routes to DefineSelectMacro.
        // The function-bearing specific (4345 | SELECT, MUST BE DEFINED) beats the function-less generic.
        {Published = True}
        Procedure ModAnalyzer_4345_Select_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4345 "Type check error SELECT, MUST BE DEFINED" to Recipe
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "DefineSelectMacro")
        End_Procedure

        // 4345 SELECT also enters the refactoring PLAN: MatchingRecipesFromList (the multi-match plan
        // path) returns the DefineSelectMacro recipe for the SELECT variant, and NOT for the
        // reserved-name variant. (MakeMatches / MatchesContainFn are defined below; message dispatch is
        // runtime so definition order does not matter.)
        {Published = True}
        Procedure ModAnalyzer_4345_Select_InPlan
            tModAnalyzer[] aSelect aReserved
            Boolean bSelectHasFn bReservedHasFn
            Get MakeMatches 4345 "Type check error SELECT, MUST BE DEFINED" to aSelect
            Get MatchesContainFn aSelect "DefineSelectMacro" to bSelectHasFn
            Send Assert (bSelectHasFn = True)
            Get MakeMatches 4345 "iExit should not be defined" to aReserved
            Get MatchesContainFn aReserved "DefineSelectMacro" to bReservedHasFn
            Send Assert (bReservedHasFn = False)
        End_Procedure

        // 4379 wrong argument count: Explain (needs human judgement).
        {Published = True}
        Procedure ModAnalyzer_4379_ArgCount_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4379 "Wrong number of arguments" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
        End_Procedure

        // 4537 obsolete class LIST is function-backed (RefactorListToCJGrid, 2026-06-27): the
        // hardcoded Explain-only recipe was removed so the meta-tag recipe is the only specific
        // 4537|LIST recipe. Category is Auto-fix since 2026-10-03, like its Grid / DbGrid / DbList
        // siblings: the tag says AutoFix outright, because RefactorListToCJGrid carries an {EnumList}
        // (the class-name parameter) and _AddMetaTagRecipes would default it to Review - which it was
        // until the grid conversions were made Auto-fix. (Also the regression guard for the shadow
        // bug: a hardcoded function-less specific added before the meta-tag recipes would silently
        // win and demote this back to Explain.)
        {Published = True}
        Procedure ModAnalyzer_4537_List_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: LIST" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorListToCJGrid")   // function-backed (meta-tag loaded)
            Send Assert (Recipe.eCategory = eModAutoFix) "the List 4537 recipe is Auto-fix"
            Send Assert (Recipe.sHint contains "cCJGrid")
        End_Procedure

        // Unrecognized error number: Unknown category, blank fn, non-blank hint.
        {Published = True}
        Procedure ModAnalyzer_Unknown_Default
            tModAnalyzer Recipe
            Get MakeRecipe 9999 "Some unrecognized error" to Recipe
            Send Assert (Recipe.eCategory = eModUnknown)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint <> "")
        End_Procedure

        // The category label is derived from the category value.
        {Published = True}
        Procedure ModAnalyzer_CategoryText_AutoFix
            tModAnalyzer Recipe
            Get MakeRecipe 4539 "Conversion from Pointer to String is not allowed" to Recipe
            Send Assert (Recipe.sCategoryText = "Auto-fix")
        End_Procedure

        // Helper: create the analyzer, return ALL recipes that match one message - the
        // multi-match counterpart to ClassifyFromRecipes' single-return, used by the refactor
        // plan so one warning can pull in more than one class-specific refactor.
        Function MakeMatches Integer iErrorNo String sErrorTxt Returns tModAnalyzer[]
            Handle ho
            tModAnalyzer[] aRecipes aMatched
            Get Create (RefClass(cModAnalyzer)) to ho
            Get BuildDefaultRecipes of ho to aRecipes
            Get MatchingRecipesFromList of ho iErrorNo sErrorTxt (&aRecipes) to aMatched
            Send Destroy of ho
            Function_Return aMatched
        End_Function

        /* ObjExprCallNameInLine - the 4379 row reads the method name off the LINE, because the message
           names no symbol (2026-08-19). Nils's nine identical Split(Self, ...) lines are the case. */
        Function ObjName String sLine Returns String
            Handle ho
            String sName
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ObjExprCallNameInLine of ho sLine to sName
            Send Destroy of ho
            Function_Return sName
        End_Function

        {Published = True}
        Procedure ObjExprCall_ReadsTheMethodName
            Send AssertSAreEqual "Split" (ObjName(Self, 'Move (Split(Self, "T", sTimestamp)) to saComponents'))
            Send AssertSAreEqual "Split" (ObjName(Self, 'Move (Split(Self,":-:",saData[i])) to saValues'))
            // Case is preserved as spelled - the parameter is handed to a case-insensitive matcher.
            Send AssertSAreEqual "FormatValue" (ObjName(Self, "Move (FormatValue(Self, sRaw)) to sOut"))
            // No argument beyond Self is still the shape.
            Send AssertSAreEqual "RowCount" (ObjName(Self, "Move (RowCount(Self)) to iN"))
        End_Procedure

        {Published = True}
        Procedure ObjExprCall_RejectsWhatIsNotThatShape
            // No (Self at all.
            Send AssertSAreEqual "" (ObjName(Self, "Move (Trim(sX)) to sY"))
            // A receiver that is not Self - not this shape, and not ours to rewrite.
            Send AssertSAreEqual "" (ObjName(Self, "Move (Value(oGrid, 3)) to sV"))
            // "(selfish" is a different word.
            Send AssertSAreEqual "" (ObjName(Self, "Move (Foo(selfish, 1)) to x"))
            // A keyword in front of "(Self" is not a call of that keyword.
            Send AssertSAreEqual "" (ObjName(Self, "If (Self = oOther) Begin"))
            Send AssertSAreEqual "" (ObjName(Self, "Move (Self) to hSelf"))
            // Inside a string literal there is no call (the line is read code-only).
            Send AssertSAreEqual "" (ObjName(Self, 'Move "Split(Self, x)" to sDoc'))
        End_Procedure

        /* ObjExprHandleCallInLine - the handle-receiver twin of the Self reader (2026-08-29):
           Name(ghoDialog, args). The row it feeds DIAGNOSES and offers nothing automatic - a
           real 19.1 workspace called a 2-parameter method with 4 arguments for years (19.1 let
           extra expression arguments pass unchecked) and the arguments fit the near-miss
           sibling; a blind Get rewrite would just have moved the breakage. */
        Function HandleCallName String sLine String ByRef sRecv Returns String
            Handle ho
            String sName
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ObjExprHandleCallInLine of ho sLine (&sRecv) to sName
            Send Destroy of ho
            Function_Return sName
        End_Function

        {Published = True}
        Procedure ObjExprHandleCall_ReadsNameAndReceiver
            String sRecv
            Send AssertSAreEqual "PickFolder" (HandleCallName(Self, 'Move (PickFolder(ghoFolderDialog, "t", "", False, True)) to sF', (&sRecv)))
            Send AssertSAreEqual "ghoFolderDialog" sRecv
            Send AssertSAreEqual "FormatRow" (HandleCallName(Self, "Move (FormatRow(hoGrid, 3)) to sV", (&sRecv)))
            Send AssertSAreEqual "hoGrid" sRecv
            Send AssertSAreEqual "RowCount" (HandleCallName(Self, "Move (RowCount(phoServer)) to iN", (&sRecv)))
            Send AssertSAreEqual "phoServer" sRecv
        End_Procedure

        {Published = True}
        Procedure ObjExprHandleCall_RejectsWhatIsNotThatShape
            String sRecv
            // Self is the OTHER reader's shape, not this one.
            Send AssertSAreEqual "" (HandleCallName(Self, "Move (Split(Self, sX)) to saY", (&sRecv)))
            // A data argument is not a receiver.
            Send AssertSAreEqual "" (HandleCallName(Self, "Move (Trim(sData)) to sY", (&sRecv)))
            // o* stays excluded: item-access of a form, the classic counter-example.
            Send AssertSAreEqual "" (HandleCallName(Self, "Move (Value(oGrid, 3)) to sV", (&sRecv)))
            // "hours" starts with ho and is data - the boundary must not be prefix-only fooled...
            // it IS prefix-matched by convention, so this documents the accepted trade: the row
            // only DIAGNOSES (never rewrites), and the 4379 context means the line is already broken.
            // A keyword in front of the paren is not a call of that keyword.
            Send AssertSAreEqual "" (HandleCallName(Self, "If (ghoEngine = 0) Begin", (&sRecv)))
            // Inside a string literal there is no call.
            Send AssertSAreEqual "" (HandleCallName(Self, 'Move "PickFolder(ghoX, 1)" to sDoc', (&sRecv)))
        End_Procedure

        Function JoinedFrom String[] asLines Integer iStart Returns String
            Handle ho
            String sJoined
            String[] asLocal
            Get Create (RefClass(cModAnalyzer)) to ho
            Move asLines to asLocal
            Get JoinContinuedFrom of ho (&asLocal) iStart to sJoined
            Send Destroy of ho
            Function_Return sJoined
        End_Function

        {Published = True}
        Procedure ObjExprHandleCall_JoinsContinuationsAndCountsArgs
            Handle ho
            String sJoined
            String[] asLines
            Integer iArgs
            // The real shape that taught us this: the call split over a ';' continuation,
            // with a trailing comment on the first physical line.
            Move 'Move (PickFolder(ghoFolderDialog, ;   // choose target' to asLines[0]
            Move '"Select the folder.","",False,True)) to sFolder'        to asLines[1]
            Move (JoinedFrom(Self, asLines, 0)) to sJoined
            Send Assert (Pos("PickFolder(ghoFolderDialog,", sJoined) > 0) "the two physical lines must join into one logical line"
            Send Assert (Pos(";", sJoined) = 0) "the continuation semicolon must not survive the join"
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ObjExprCallArgCount of ho sJoined "PickFolder" to iArgs
            Send Destroy of ho
            Send Assert (iArgs = 4) ("4 arguments follow the receiver, counted " + String(iArgs))
        End_Procedure

        {Published = True}
        Procedure ObjExprHandleCall_ArgCountEdges
            Handle ho
            Integer iArgs
            Get Create (RefClass(cModAnalyzer)) to ho
            // Receiver only - zero arguments follow it.
            Get ObjExprCallArgCount of ho "Move (RowCount(phoServer)) to iN" "RowCount" to iArgs
            Send Assert (iArgs = 0) ("receiver-only call counts 0, counted " + String(iArgs))
            // Nested calls and quoted commas must not inflate the count.
            Get ObjExprCallArgCount of ho 'Move (FormatRow(hoGrid, Trim(sA), "a,b", 3)) to sV' "FormatRow" to iArgs
            Send Assert (iArgs = 3) ("top-level split must count 3, counted " + String(iArgs))
            // No such call on the line -> -1, and a longer name must not read as the short one.
            Get ObjExprCallArgCount of ho "Move (MyPickFolder(hoX, 1)) to sV" "PickFolder" to iArgs
            Send Assert (iArgs = -1) ("boundary: MyPickFolder is not PickFolder, counted " + String(iArgs))
            Send Destroy of ho
        End_Procedure

        /* MacroExpansionCause - the analyzer only knows the construct is NOT on the reported line.
           Naming one cause for all of them ("inside macro expansions") was wrong for most of Nils's
           533 rows: they are object declarations, where the construct is in the class. 2026-08-19. */
        Function CauseOf String sLine String ByRef sName Returns Integer
            Handle ho
            Integer iCause
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MacroExpansionCause of ho sLine (&sName) to iCause
            Send Destroy of ho
            Function_Return iCause
        End_Function

        {Published = True}
        Procedure MacroCause_ObjectDeclarationNamesTheClass
            String sName
            Send AssertIAreEqual eMacroCauseClass (CauseOf(Self, "        Object SnabbProspekt is a cTrDbView", &sName))
            Send AssertSAreEqual "cTrDbView" sName
            Send AssertIAreEqual eMacroCauseClass (CauseOf(Self, "Object Kundhistorik is a dbView", &sName))
            Send AssertSAreEqual "dbView" sName
        End_Procedure

        {Published = True}
        Procedure MacroCause_CommandLineNamesTheMacro
            String sName
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, '    Set_Foreign_profile_String sKey sSubKey "UseAutoSave" to 1', &sName))
            Send AssertSAreEqual "Set_Foreign_profile_String" sName
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, 'Set_Registry_Root to HKEY_CURRENT_USER "SOFTWARE"', &sName))
            Send AssertSAreEqual "Set_Registry_Root" sName
        End_Procedure

        // An ordinary statement is NOT a macro invocation - Unknown, so the row shows the line instead.
        {Published = True}
        Procedure MacroCause_OrdinaryStatementIsUnknown
            String sName
            Send AssertIAreEqual eMacroCauseUnknown (CauseOf(Self, "        Move (Trim(sX)) to sY", &sName))
            Send AssertSAreEqual "" sName
            Send AssertIAreEqual eMacroCauseUnknown (CauseOf(Self, "        If (bX) Begin", &sName))
            Send AssertIAreEqual eMacroCauseUnknown (CauseOf(Self, "", &sName))
            // A comment carries no code.
            Send AssertIAreEqual eMacroCauseUnknown (CauseOf(Self, "        // Object X is a dbView", &sName))
        End_Procedure

        /* THE MACRO-ORIGIN FOLD (2026-09-09). A construct inside a command body is warned about at
           EVERY expansion, so the analyzer grid folds those rows per (file, macro) instead of per
           line. These two pure functions are what the folded row is built from: where the command
           is declared, and what the row then says. */
        Function MacroLines Returns String[]
            String[] asLines
            Move "// a legacy source file"                       to asLines[0]
            Move "integer giThing"                               to asLines[1]
            Move (Character(35) + "COMMAND PANEL.DEFINE_ROW")   to asLines[2]
            Move "  string gl_code"                              to asLines[3]
            Move (Character(35) + "ENDCOMMAND")                   to asLines[4]
            Move "  PANEL.DEFINE_ROW _nop"                     to asLines[5]
            Move (Character(35) + "Command forward_send$Item1") to asLines[6]
            Move (Character(35) + "ENDCOMMAND")                   to asLines[7]
            Function_Return asLines
        End_Function

        Function DefLineOf String[] asLines String sName Returns Integer
            Handle ho
            Integer iLine
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MacroDefinitionLine of ho (&asLines) sName to iLine
            Send Destroy of ho
            Function_Return iLine
        End_Function

        Function HintOf String sName Integer iDefLine Returns String
            Handle ho
            String sHint
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MacroOriginHint of ho sName iDefLine to sHint
            Send Destroy of ho
            Function_Return sHint
        End_Function

        // The declaration's line is 1-BASED (the grid's Line column is), and the name is matched
        // case-insensitively on BOTH sides - the directive is written in either case in the wild.
        {Published = True}
        Procedure MacroDef_FindsTheDeclarationLine
            String[] asLines
            Move (MacroLines(Self)) to asLines
            Send AssertIAreEqual 3 (DefLineOf(Self, asLines, "PANEL.DEFINE_ROW"))
            Send AssertIAreEqual 3 (DefLineOf(Self, asLines, "panel.define_row"))
            // Declared with the directive in mixed case, asked for in upper.
            Send AssertIAreEqual 7 (DefLineOf(Self, asLines, "FORWARD_SEND$ITEM1"))
        End_Procedure

        /* A CALL SITE IS NOT A DECLARATION. Line 6 invokes PANEL.DEFINE_ROW and must never be
           mistaken for its definition - that is the whole distinction the folded row rests on. */
        {Published = True}
        Procedure MacroDef_CallSiteAndUnknownNameAreNotDeclarations
            String[] asLines asEmpty
            Move (MacroLines(Self)) to asLines
            Send AssertIAreEqual 0 (DefLineOf(Self, asLines, "ENDCOMMAND"))
            Send AssertIAreEqual 0 (DefLineOf(Self, asLines, "NOT_DEFINED_HERE"))
            Send AssertIAreEqual 0 (DefLineOf(Self, asLines, ""))
            // A file with no lines at all answers 0 rather than faulting on the empty array.
            Send AssertIAreEqual 0 (DefLineOf(Self, asEmpty, "PANEL.DEFINE_ROW"))
        End_Procedure

        // The hint LEADS with the command (the grid's hint column is what the eye lands on) and
        // ENDS with the shared constant, which is how the findings board recognises the family.
        {Published = True}
        Procedure MacroOriginHint_NamesTheCommandAndItsLine
            String sHint
            Move (HintOf(Self, "PANEL.DEFINE_ROW", 358)) to sHint
            Send AssertSAreEqual "PANEL.DEFINE_ROW" (Left(sHint, 16))
            Send Assert (sHint contains "in this file at line 358") "the definition line is named"
            Send Assert (sHint contains "CALL SITES") "the row says the lines behind it are uses"
            Send Assert (sHint contains CS_ModMacroExpansionHint) "the family stays recognisable"
            Send AssertSAreEqual CS_ModMacroExpansionHint ;
                (Right(sHint, Length(CS_ModMacroExpansionHint)))
        End_Procedure

        /* NOT FOUND IS A REAL ANSWER. MacroDefinitionLine only reads the INVOKING file, so a command
           declared in another file answers 0 - and the row then says how to find it rather than
           naming a line that is not the declaration. */
        {Published = True}
        Procedure MacroOriginHint_SaysHowToFindADeclarationElsewhere
            String sHint
            Move (HintOf(Self, "MAKE_PANEL_ROW", 0)) to sHint
            Send AssertSAreEqual "MAKE_PANEL_ROW" (Left(sHint, 14))
            Send Assert (sHint contains "defined elsewhere") "it does not claim a line it never found"
            Send Assert (sHint contains (Character(35) + "COMMAND MAKE_PANEL_ROW")) "it says what to search for"
            Send Assert (not(sHint contains "in this file at line")) "no line is claimed"
            Send Assert (sHint contains CS_ModMacroExpansionHint) "the family stays recognisable"
        End_Procedure

        // No name means nothing was established - fall back to the shared sentence exactly, so a row
        // the fold did not name reads as it always did.
        {Published = True}
        Procedure MacroOriginHint_BlankNameFallsBackToTheSharedHint
            Send AssertSAreEqual CS_ModMacroExpansionHint (HintOf(Self, "", 0))
            Send AssertSAreEqual CS_ModMacroExpansionHint (HintOf(Self, "   ", 42))
        End_Procedure

        /* THE FOLD'S INPUT CONTRACT. Only a line MacroExpansionCause calls eMacroCauseMacro folds,
           so which invocation shapes it recognises decides how much of the family collapses. These
           are the shapes a legacy workspace actually presents: a dotted name, an UPPERCASE one, one
           carrying a '$', and a bare macro word with no arguments at all.

           THE LAST ASSERTION RECORDS A KNOWN GAP, it does not bless it: an invocation behind an
           inline 'If <cond>' guard reads as an ordinary statement (the first word is 'if') and stays
           Unknown, so those lines keep one row each instead of folding. Teaching the cause to look
           past a leading guard would change attribution for the findings board too, so it is a
           decision of its own rather than a side effect of the fold. */
        {Published = True}
        Procedure MacroCause_TheShapesTheFoldRecognises
            String sName
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, '    PANEL.DEFINE_ROW _first "<one>"', &sName))
            Send AssertSAreEqual "PANEL.DEFINE_ROW" sName
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, "        MAKE_PANEL_ROW 12", &sName))
            Send AssertSAreEqual "MAKE_PANEL_ROW" sName
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, "    forward_send$Item1 AddThing", &sName))
            Send AssertSAreEqual "forward_send$Item1" sName
            // No arguments at all - the whole line is the command.
            Send AssertIAreEqual eMacroCauseMacro (CauseOf(Self, "  END_PANEL_ROW_GROUP", &sName))
            Send AssertSAreEqual "END_PANEL_ROW_GROUP" sName
            // KNOWN GAP: an inline-If guard hides the invocation behind a statement keyword.
            Send AssertIAreEqual eMacroCauseUnknown (CauseOf(Self, "    if hClient MAKE_PANEL_ROW PARENT hClient", &sName))
        End_Procedure

        Function ObsCmdOf String sMsgTxt Returns String
            Handle ho
            String sCmd
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ObsoleteCommandInMessage of ho sMsgTxt to sCmd
            Send Destroy of ho
            Function_Return sCmd
        End_Function

        /* The compiler's real message shapes. The name is taken LOWERCASED, because the caller tests
           it against a lowercased source line - and the compiler's own casing of the command varies. */
        {Published = True}
        Procedure ObsCmd_ReadsTheCommandOutOfTheMessage
            Send AssertSAreEqual "item_list" (ObsCmdOf(Self, "Obsolete Command Obsolete command: Item_List"))
            Send AssertSAreEqual "end_item_list" (ObsCmdOf(Self, "Obsolete Command Obsolete command: End_Item_List"))
            Send AssertSAreEqual "gosub" (ObsCmdOf(Self, "Obsolete Command Obsolete command: Gosub"))
        End_Procedure

        /* ADVICE AFTER THE NAME IS NOT PART OF THE NAME. Several of these messages carry a sentence
           telling you what to use instead; only the command itself is the thing to look for on the
           reported line, so everything from the first '.' is dropped. */
        {Published = True}
        Procedure ObsCmd_StopsAtTheAdviceThatFollows
            Send AssertSAreEqual "return" ;
                (ObsCmdOf(Self, "Obsolete Command Obsolete command: Return. If a gosub, use Gosub_Return"))
            Send AssertSAreEqual "get_date_attribute" ;
                (ObsCmdOf(Self, "Obsolete Command Obsolete command: Get_Date_Attribute. Use Get_Attribute DF_DATE_FORMAT"))
        End_Procedure

        // Any other message family answers "" - the caller then leaves the row exactly as it was.
        {Published = True}
        Procedure ObsCmd_OtherMessageFamiliesAnswerNothing
            Send AssertSAreEqual "" (ObsCmdOf(Self, "Obsolete Class Obsolete class: BASICTOOLBAR"))
            Send AssertSAreEqual "" (ObsCmdOf(Self, "Obsolete Technique Use of Private or Public keyword in property command is obsolete"))
            Send AssertSAreEqual "" (ObsCmdOf(Self, ""))
        End_Procedure

        // Helper: True if any matched recipe routes to the named refactor function.
        Function MatchesContainFn tModAnalyzer[] aMatched String sFn Returns Boolean
            Integer i iCount
            Move (SizeOfArray(aMatched)) to iCount
            For i from 0 to (iCount - 1)
                If (aMatched[i].sRefactorFn = sFn) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // 4537 obsolete-class warnings carry the ACTUAL declared class name - "DBGRID" for a dbGrid,
        // "DBLIST" for a dbList. The compiler does NOT collapse both to a shared "DBGRID" widget, so
        // each routes to its OWN class-specific refactor. (Regression 2026-06-19: the dbList recipe
        // was mistakenly keyed on "class: DBGRID", so every dbList object - which warns as
        // "Obsolete class: DBLIST" - fell through to the generic 4537 Explain.)
        {Published = True}
        Procedure ModAnalyzer_4537_DbGrid_Family
            tModAnalyzer[] aGrid aList
            Boolean bGridIsGrid bGridIsList bListIsList bListIsGrid
            Get MakeMatches 4537 "Obsolete class: DBGRID" to aGrid
            Get MatchesContainFn aGrid "RefactorDbGridTocDbCJGrid"           to bGridIsGrid
            Get MatchesContainFn aGrid "RefactorDbListTocDbCJGridPromptList" to bGridIsList
            Send Assert (bGridIsGrid = True)
            Send Assert (bGridIsList = False)
            Get MakeMatches 4537 "Obsolete class: DBLIST" to aList
            Get MatchesContainFn aList "RefactorDbListTocDbCJGridPromptList" to bListIsList
            Get MatchesContainFn aList "RefactorDbGridTocDbCJGrid"           to bListIsGrid
            Send Assert (bListIsList = True)
            Send Assert (bListIsGrid = False)
        End_Procedure

        // 4533 Begin_Row routing - the 2026-06-18 "no function, the 4537 class anchor carries the
        // action" decision was REVISED 2026-07-03 (Nils' dbList0 catch): the 4537 anchor only fires
        // when the object's class name IS the obsolete class ("Object x is a DBGRID"); a SUBCLASS
        // ("Object oSl is a dbList0", class defined in a library) gets NO workspace-anchored 4537,
        // so its Begin_Row lines are the ONLY signal - and they were invisible as function-less
        // Explain. Begin_Row now routes to BOTH grid converters (Suggest); VerifyBeginRow keeps the
        // right family + names the enclosing object, and the per-(file,function) row merge still
        // gives ONE actionable row per file (the 4537 + 4533 messages fold together), so the
        // 2026-06-18 noise concern stays solved.
        {Published = True}
        Procedure ModAnalyzer_4533_BeginRow_RoutesToConverters
            tModAnalyzer Recipe
            tModAnalyzer[] aList
            Boolean bHasGrid bHasList
            Get MakeRecipe 4533 "Obsolete command: Begin_Row" to Recipe
            Send Assert (Recipe.eCategory = eModSuggest)
            Send Assert (Recipe.sRefactorFn <> "")
            // The multi-match (plan path) pulls in BOTH converters - VerifyBeginRow later demotes
            // the wrong-family one per row from the enclosing object's class.
            Get MakeMatches 4533 "Obsolete Command: Begin_Row is obsolete. Use cCJGrid or cCJDbGrid instead of dbList or dbGrid" to aList
            Get MatchesContainFn aList "RefactorDbGridTocDbCJGrid" to bHasGrid
            Get MatchesContainFn aList "RefactorDbListTocDbCJGridPromptList" to bHasList
            Send Assert (bHasGrid = True)
            Send Assert (bHasList = True)
        End_Procedure

        // Regression (2026-06-11): a function-less SPECIFIC hint (the install-catalog
        // scan seeds one Explain row per obsolete command) must not SHADOW a
        // function-bearing GENERIC recipe out of the plan - TypeToStructReport
        // (generic 4532 | Suggest) never appeared in Auto Select because the scanned
        // specific always won the precedence.
        {Published = True}
        Procedure ModAnalyzer_4532_GenericFnNotShadowed
            Handle ho
            tModAnalyzer[] aRecipes aMatched
            Boolean bFound
            Get Create (RefClass(cModAnalyzer)) to ho
            // The scanned, function-less specific hint...
            Get AddRecipe of ho aRecipes 4532 True "Obsolete command (not unicode safe): Type." "" eModExplain "scanned hint" to aRecipes
            // ...and the function-bearing generic that must survive the precedence.
            Get AddRecipe of ho aRecipes 4532 True "" "TypeToStructReport" eModSuggest "report" to aRecipes
            Get MatchingRecipesFromList of ho 4532 "Obsolete Type Command Obsolete command (not unicode safe): Type. Use Struct/End_Struct" (&aRecipes) to aMatched
            Send Destroy of ho
            Get MatchesContainFn aMatched "TypeToStructReport" to bFound
            Send Assert (bFound = True)
        End_Procedure

        // Same shadow, the GRID (single-result) path: ClassifyFromRecipes must also classify the
        // Type-family 4532 as TypeToStructReport / Review, NOT the function-less Explain specific -
        // so the triage grid agrees with what Auto Select runs (Nils 2026-06-11).
        {Published = True}
        Procedure ModAnalyzer_4532_ClassifyNotShadowed
            Handle ho
            tModAnalyzer[] aRecipes
            tModAnalyzer Recipe
            Get Create (RefClass(cModAnalyzer)) to ho
            Get AddRecipe of ho aRecipes 4532 True "Obsolete command (not unicode safe): Type." "" eModExplain "scanned hint" to aRecipes
            Get AddRecipe of ho aRecipes 4532 True "" "TypeToStructReport" eModSuggest "report" to aRecipes
            Get ClassifyFromRecipes of ho 4532 "Obsolete Type Command Obsolete command (not unicode safe): Type. Use Struct/End_Struct" aRecipes to Recipe
            Send Destroy of ho
            Send Assert (Recipe.sRefactorFn = "TypeToStructReport")
            Send Assert (Recipe.eCategory = eModSuggest)
        End_Procedure

        // 4535 wears two faces under one code, so the match-text must route them apart.
        // Private/Public keyword -> the property-keyword removers, NOT the file-extension recipe.
        {Published = True}
        Procedure ModAnalyzer_4535_PropertyKeyword
            tModAnalyzer[] aMatched
            Boolean bPriv bPub bFileExt
            Get MakeMatches 4535 "Use of Private or Public keyword in property command is obsolete" to aMatched
            Get MatchesContainFn aMatched "RemovePropertyPrivate" to bPriv
            Get MatchesContainFn aMatched "RemovePropertyPublic" to bPub
            Get MatchesContainFn aMatched "AddUseFileExtension" to bFileExt
            Send Assert (bPriv = True)
            Send Assert (bPub = True)
            Send Assert (bFileExt = False)
        End_Procedure

        // 4535 filename form -> AddUseFileExtension, NOT the property-keyword removers.
        {Published = True}
        Procedure ModAnalyzer_4535_FileExtension
            tModAnalyzer[] aMatched
            Boolean bFileExt bProp
            Get MakeMatches 4535 "Filenames in use command should contain a file extension (e.g., .pkg)" to aMatched
            Get MatchesContainFn aMatched "AddUseFileExtension" to bFileExt
            Get MatchesContainFn aMatched "RemovePropertyPrivate" to bProp
            Send Assert (bFileExt = True)
            Send Assert (bProp = False)
        End_Procedure

        // 4537 Obsolete Class: GRID -> the non-data-aware grid refactor.
        {Published = True}
        Procedure ModAnalyzer_4537_Grid_Class
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete class: GRID" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorGridToCJGrid")
            Send Assert (Recipe.eCategory = eModAutoFix) "the Grid 4537 recipe is Auto-fix"
        End_Procedure

        // 4537 Obsolete Class: DBGRID -> the data-aware grid refactor (must NOT collide with GRID).
        {Published = True}
        Procedure ModAnalyzer_4537_DbGrid_Class
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete class: DBGRID" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorDbGridTocDbCJGrid")
            // ...and Auto-fix, like every grid conversion (2026-10-03): an EMPTY run converts the plain class only.
            Send Assert (Recipe.eCategory = eModAutoFix) "the dbGrid 4537 recipe is Auto-fix"
            Get MakeRecipe 4537 "Obsolete class: DBLIST" to Recipe
            Send Assert (Recipe.sRefactorFn = "RefactorDbListTocDbCJGridPromptList")
            Send Assert (Recipe.eCategory = eModAutoFix) "the dbList 4537 recipe is Auto-fix"
        End_Procedure

        // 4537 Obsolete Class: DFTimer -> the dfTimer-to-cTimer refactor ({ ModRecipe = 4537 | class: DFTIMER }).
        {Published = True}
        Procedure ModAnalyzer_4537_DfTimer_Class
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete class: DFTimer" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeDfTimerTocTimer")
        End_Procedure

        // 4533 REGISTRY command family (v45): 18 commands share the text stem "Obsolete Registry
        // command", so ONE Explain recipe carries the guided cRegistry/cIniFile migration hint for
        // every member. Two members tested to prove the stem match (.prn-verified texts).
        {Published = True}
        Procedure ModAnalyzer_4533_RegistryFamily_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete Command Obsolete Registry command (not unicode safe): SET_REGISTRY_ROOT. Use cRegistry class" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "cRegistry")
            Get MakeRecipe 4533 "Obsolete Command Obsolete Registry command (not unicode safe): REG_OPEN_KEY. Use cRegistry class" to Recipe
            Send Assert (Recipe.sHint contains "cRegistry")
        End_Procedure

        // 4533 Gosub + its paired Return (v45): extract-to-Procedure guidance (semantic, never a swap;
        // the guided Gosub report is the planned follow-up). Texts .prn-verified 2026-07-04.
        {Published = True}
        Procedure ModAnalyzer_4533_Gosub_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4533 "Obsolete Command Obsolete command: Gosub" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "Procedure")
            Get MakeRecipe 4533 "Obsolete Command Obsolete command: Return. If a gosub, use Gosub_Return" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sHint contains "Gosub_Return")
        End_Procedure

        // 4537 classes with NO converter (v45, LIST-template Explain-only): each gets an honest
        // per-class hand-migrate hint instead of the bare "replace with the modern equivalent".
        {Published = True}
        Procedure ModAnalyzer_4537_NoConverterClasses_Explain
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: ERRORSYSTEM" to Recipe
            Send Assert (Recipe.eCategory = eModExplain)
            Send Assert (Recipe.sRefactorFn = "")
            Send Assert (Recipe.sHint contains "Error_Report")
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: HELPSYSTEM" to Recipe
            Send Assert (Recipe.sHint contains "cHtmlHelp")
            // DBFLOATINGPOPUPMENU left this list on 2026-09-13: ChangeFloatingPopupMenuToCodeJock
            // carries it (and FLOATINGPOPUPMENU) as { ModRecipe } tags - the test below.
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: CMAPIHANDLER" to Recipe
            Send Assert (Recipe.sHint contains "MAPI")
        End_Procedure

        // 4537 FLOATINGPOPUPMENU / DBFLOATINGPOPUPMENU (2026-09-13): both route to the popup converter -
        // Auto-fix since the live runs the same day - so the hardcoded db Explain is gone.
        {Published = True}
        Procedure ModAnalyzer_4537_FloatingPopupMenu_Converter
            tModAnalyzer Recipe
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: FLOATINGPOPUPMENU" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeFloatingPopupMenuToCodeJock")
            Send Assert (Recipe.eCategory = eModAutoFix)
            Get MakeRecipe 4537 "Obsolete Class Obsolete class: DBFLOATINGPOPUPMENU" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeFloatingPopupMenuToCodeJock")
            Send Assert (Recipe.eCategory = eModAutoFix)
        End_Procedure

        // 4531 Obsolete String command: Character -> the Character command-to-function refactor.
        {Published = True}
        Procedure ModAnalyzer_4531_Character_Command
            tModAnalyzer Recipe
            Get MakeRecipe 4531 "Obsolete String command: Character. Use Character() Function" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeCharacterCommandToFunction")
        End_Procedure

        // 4531 Obsolete String command: Pad -> the Pad command-to-function refactor.
        {Published = True}
        Procedure ModAnalyzer_4531_Pad_Command
            tModAnalyzer Recipe
            Get MakeRecipe 4531 "Obsolete String command: Pad. Use Pad() Function" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangePadCommandToFunction")
        End_Procedure

        // The package scanner parses #COMMAND ... WarningEx ... OBSOLETE_<suffix> "<msg>" defs into
        // Explain recipes (number from the constant suffix; hint = the message with its replacement).
        {Published = True}
        Procedure ModAnalyzer_Scan_ParsesObsoleteDefs
            String[] asLines
            tModAnalyzer[] aRec

            Move '#COMMAND BEGIN_CONSTRAINTS' to asLines[0]
            Move '    WarningEx GENERAL DFERR_COMP_WARNING_OBSOLETE_CMD "Obsolete command: Begin_Constraint. Use OnConstrain"' to asLines[1]
            Move '    Procedure Constrain' to asLines[2]
            Move '#ENDCOMMAND' to asLines[3]
            Move '#COMMAND TYPE' to asLines[4]
            Move '    WarningEx GENERAL DFERR_COMP_WARNING_OBSOLETE_TYPE_CMD "Obsolete command (not unicode safe): Type. Use Struct/End_Struct"' to asLines[5]
            Move '#ENDCOMMAND' to asLines[6]
            Move '// a plain comment - not a warning definition' to asLines[7]
            // The extractor was relocated to cRefactorFuncLib (the shared install-Pkg walk); call it
            // on ghoFuncLib (no throwaway cModAnalyzer instance needed - it is pure).
            Get _ObsoleteRecipesFromLines of ghoFuncLib asLines to aRec
            Send Assert (SizeOfArray(aRec) = 2)
            Send Assert (aRec[0].iMsgNumber = 4533)
            Send Assert (aRec[0].eCategory = eModExplain)
            Send Assert (aRec[0].sHint contains "OnConstrain")
            Send Assert (aRec[1].iMsgNumber = 4532)
            Send Assert (aRec[1].sHint contains "Struct")
        End_Procedure

        // Ignore-list membership (the analyzer's dismiss feature): case-insensitive on the file path
        // (Windows), exact on the message token as the grid renders it.
        {Published = True}
        Procedure ModAnalyzer_IsIgnored_MatchesFileAndMsg
            Handle ho
            tModIgnore[] aIgnored
            Boolean bHit bMissFile bMissMsg bCaseInsensitive

            Move "Pkg\crystalreportsas.pkg" to aIgnored[0].sFile
            Move "W 4532"                    to aIgnored[0].sMsg
            Get Create (RefClass(cModAnalyzer)) to ho
            Get IsIgnored of ho "Pkg\crystalreportsas.pkg" "W 4532" aIgnored to bHit
            Get IsIgnored of ho "Pkg\other.pkg"            "W 4532" aIgnored to bMissFile
            Get IsIgnored of ho "Pkg\crystalreportsas.pkg" "W 4531" aIgnored to bMissMsg
            Get IsIgnored of ho "PKG\CrystalReportsAS.PKG" "W 4532" aIgnored to bCaseInsensitive
            Send Destroy of ho
            Send Assert bHit
            Send AssertFalse bMissFile
            Send AssertFalse bMissMsg
            Send Assert bCaseInsensitive
        End_Procedure

        // DropIgnoredMessages removes exactly the (file, W/E token) rows in the ignore-list and keeps the
        // rest - the grid pre-filter that retires a dismissed row from BOTH the grid and the refactor plan.
        // Proves the (x2) aggregate is fully dropped, and that W 4532 does NOT match a same-number E 4532.
        {Published = True}
        Procedure ModAnalyzer_DropIgnoredMessages_FiltersByKey
            Handle ho
            tCompileError[] aMsgs aKept
            tModIgnore[] aIgnored

            Move "rep.pkg"   to aMsgs[0].sFileName
            Move 4532         to aMsgs[0].iErrorNo
            Move False        to aMsgs[0].bError       // W 4532 - ignored
            Move "rep.pkg"   to aMsgs[1].sFileName
            Move 4532         to aMsgs[1].iErrorNo
            Move False        to aMsgs[1].bError       // W 4532 - ignored (the second of the "(x2)")
            Move "other.pkg" to aMsgs[2].sFileName
            Move 4531         to aMsgs[2].iErrorNo
            Move False        to aMsgs[2].bError       // W 4531 - kept (different file + message)
            Move "rep.pkg"   to aMsgs[3].sFileName
            Move 4532         to aMsgs[3].iErrorNo
            Move True         to aMsgs[3].bError       // E 4532 - kept (an error, not the ignored "W 4532")
            Move "rep.pkg" to aIgnored[0].sFile
            Move "W 4532"   to aIgnored[0].sMsg
            Get Create (RefClass(cModAnalyzer)) to ho
            Get DropIgnoredMessages of ho aMsgs aIgnored to aKept
            Send Destroy of ho
            Send Assert (SizeOfArray(aKept) = 2)
            Send Assert (aKept[0].sFileName = "other.pkg")
            Send Assert (aKept[0].iErrorNo = 4531)
            Send Assert (aKept[1].sFileName = "rep.pkg")
            Send Assert (aKept[1].bError = True)
        End_Procedure

        // DropIgnoredMessages is a no-op with an empty ignore-list - every message survives.
        {Published = True}
        Procedure ModAnalyzer_DropIgnoredMessages_EmptyListNoOp
            Handle ho
            tCompileError[] aMsgs aKept
            tModIgnore[] aIgnoredEmpty
            Move "a.pkg" to aMsgs[0].sFileName
            Move 4532     to aMsgs[0].iErrorNo
            Move False    to aMsgs[0].bError
            Move "b.pkg" to aMsgs[1].sFileName
            Move 4531     to aMsgs[1].iErrorNo
            Move True     to aMsgs[1].bError
            Get Create (RefClass(cModAnalyzer)) to ho
            Get DropIgnoredMessages of ho aMsgs aIgnoredEmpty to aKept
            Send Destroy of ho
            Send Assert (SizeOfArray(aKept) = 2)
        End_Procedure

        // DropCOMProxyMessages drops rows whose file is a Studio COM proxy wrapper (the canonical
        // _IsDataFlexCOMProxyClassesFile keys on the "DataFlex COM proxy classes generated from" first line),
        // and keeps everything else - including a fileless link error and a (missing) real file, which are
        // never proxies and must not trip the helper's missing-file error. A temp file stands in for a proxy.
        {Published = True}
        Procedure ModAnalyzer_DropCOMProxyMessages
            Handle ho                     
            Integer iRetval
            tCompileError[] aIn aOut
            String sProxyFile sDataPath

            // ABSOLUTE path in the workspace Data folder. A relative name resolves via the DataFlex SOURCE
            // search path (for a .pkg), NOT the cwd Direct_Output writes to, so vFilePathExists misses it and
            // the proxy is never detected (the v1 test bug). phoWorkspace off ghoApplication - the built-in
            // fixtures may read (see RecipeJsonPath).
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath) + "dfr_test_com_proxy_wrapper.pkg") to sProxyFile
            Direct_Output sProxyFile
            Writeln ("// " + CS_DFCOMProxyClasses + " C:\Somewhere\Some.ocx")
            Writeln "Class cFooProxy is a cComAutomationObject"
            Close_Output
            // [0] proxy -> dropped; [1] fileless link error -> kept; [2] missing real file -> kept.
            Move sProxyFile             to aIn[0].sFileName
            Move 4328                   to aIn[0].iErrorNo
            Move ""                     to aIn[1].sFileName
            Move 9001                   to aIn[1].iErrorNo
            Move "C:\NoSuchDir\real.vw" to aIn[2].sFileName
            Move 9002                   to aIn[2].iErrorNo
            Get Create (RefClass(cModAnalyzer)) to ho
            Get DropCOMProxyMessages of ho aIn to aOut
            Send Destroy of ho
            Get vDeleteFile sProxyFile to iRetval
            // The proxy row is gone; the two non-proxy rows survive, in order.
            Send AssertIAreEqual 2 (SizeOfArray(aOut))
            Send AssertIAreEqual 9001 aOut[0].iErrorNo
            Send AssertIAreEqual 9002 aOut[1].iErrorNo
        End_Procedure

        // SplitMsgList: a MERGED Msg# cell (", "-joined) yields each "W/E <n>" token separately. This is the
        // fix for a dead "Ignore Row(s)" on a function-backed / multi-message row - the tokens must be stored
        // ONE per ignore entry, because DropIgnoredMessages keys per single message.
        {Published = True}
        Procedure ModAnalyzer_SplitMsgList_MergedRow
            Handle ho
            String[] asTok
            Get Create (RefClass(cModAnalyzer)) to ho
            Get SplitMsgList of ho "W 4532, W 4533, W 4534" to asTok
            Send Destroy of ho
            Send AssertIAreEqual 3 (SizeOfArray(asTok))
            Send Assert (asTok[0] = "W 4532")
            Send Assert (asTok[1] = "W 4533")
            Send Assert (asTok[2] = "W 4534")
        End_Procedure

        // SplitMsgList: a single-message cell yields exactly one token (the common case, unchanged).
        {Published = True}
        Procedure ModAnalyzer_SplitMsgList_SingleRow
            Handle ho
            String[] asTok
            Get Create (RefClass(cModAnalyzer)) to ho
            Get SplitMsgList of ho "E 4345" to asTok
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(asTok))
            Send Assert (asTok[0] = "E 4345")
        End_Procedure

        // End-to-end: ignoring a MERGED row (split into per-message entries, as IgnoreSelectedRow now does)
        // must retire ALL its messages from DropIgnoredMessages, while a sibling message on the same file
        // survives. This is the "Ignore Row(s) did nothing" bug: the whole "W 4532, W 4533, W 4534" list was
        // stored as one key, which never matched the per-message drop key, so the row came straight back
        // (Nils, LegacyApp cMapiHandler 315).
        {Published = True}
        Procedure ModAnalyzer_SplitMsgList_MergedRowRoundTrips
            Handle ho
            Integer i iTok
            String[] asTok
            tModIgnore[] aIgnored
            tCompileError[] aMsgs aKept

            Get Create (RefClass(cModAnalyzer)) to ho
            // Simulate IgnoreSelectedRow: split the merged cell, store one ignore entry per token.
            Get SplitMsgList of ho "W 4532, W 4533, W 4534" to asTok
            Move (SizeOfArray(asTok) - 1) to iTok
            For i from 0 to iTok
                Move "cmapihandler.pkg" to aIgnored[i].sFile
                Move asTok[i]           to aIgnored[i].sMsg
            Loop
            // The three merged warnings on that file (all dropped) + a 4535 on the same file (kept).
            Move "cmapihandler.pkg" to aMsgs[0].sFileName
            Move 4532 to aMsgs[0].iErrorNo
            Move False to aMsgs[0].bError
            Move "cmapihandler.pkg" to aMsgs[1].sFileName
            Move 4533 to aMsgs[1].iErrorNo
            Move False to aMsgs[1].bError
            Move "cmapihandler.pkg" to aMsgs[2].sFileName
            Move 4534 to aMsgs[2].iErrorNo
            Move False to aMsgs[2].bError
            Move "cmapihandler.pkg" to aMsgs[3].sFileName
            Move 4535 to aMsgs[3].iErrorNo
            Move False to aMsgs[3].bError
            Get DropIgnoredMessages of ho aMsgs aIgnored to aKept
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(aKept))
            Send AssertIAreEqual 4535 aKept[0].iErrorNo
        End_Procedure

        // IsRowIgnored: a MERGED saved-plan row ("W 4532, W 4533, W 4534") is dismissed only when EVERY one
        // of its tokens is in the ignore list. This is the saved-plan ("View last plan") twin of the grid's
        // per-message drop: a raw IsIgnored on the joined cell never matched, so the dismissed cMapiHandler
        // row leaked into the saved view while the live grid hid it (Nils, LegacyApp cMapiHandler 315).
        {Published = True}
        Procedure ModAnalyzer_IsRowIgnored_MergedRow
            Handle ho
            tModIgnore[] aIgnored
            Boolean bAll bPartial bSingle bCase bMissFile

            // Ignore list holds the three SPLIT tokens (as IgnoreSelectedRow stores them), plus a single.
            Move "inc\cmapihandler.pkg" to aIgnored[0].sFile
            Move "W 4532"                to aIgnored[0].sMsg
            Move "inc\cmapihandler.pkg" to aIgnored[1].sFile
            Move "W 4533"                to aIgnored[1].sMsg
            Move "inc\cmapihandler.pkg" to aIgnored[2].sFile
            Move "W 4534"                to aIgnored[2].sMsg
            Get Create (RefClass(cModAnalyzer)) to ho
            // (a) all three tokens ignored -> the merged row is dismissed.
            Get IsRowIgnored of ho "inc\cmapihandler.pkg" "W 4532, W 4533, W 4534" aIgnored to bAll
            // (b) one token NOT ignored (W 4599) -> the row still has a live message, so NOT dismissed.
            Get IsRowIgnored of ho "inc\cmapihandler.pkg" "W 4532, W 4599" aIgnored to bPartial
            // (c) a single-token row that IS ignored -> dismissed (the common case still works).
            Get IsRowIgnored of ho "inc\cmapihandler.pkg" "W 4533" aIgnored to bSingle
            // (d) case-insensitive on the file path (Windows).
            Get IsRowIgnored of ho "INC\CMapiHandler.PKG" "W 4532, W 4533, W 4534" aIgnored to bCase
            // (e) different file -> not dismissed.
            Get IsRowIgnored of ho "inc\other.pkg" "W 4532, W 4533, W 4534" aIgnored to bMissFile
            Send Destroy of ho
            Send Assert bAll
            Send AssertFalse bPartial
            Send Assert bSingle
            Send Assert bCase
            Send AssertFalse bMissFile
        End_Procedure

        // VerifyAutoFix now DRY-RUNS the command-family function (via ghoFuncLib.AutoFixChangesLine): a no-"to"
        // Pos ("POS x IN y", the [Found] side-effect form) is NOT convertible, so ChangePosCommandToFunction
        // leaves it unchanged -> demote to Explain, even though "pos" is on the line (the keyword guard alone
        // kept it Auto-fix, which is why Run Plan never cleared it). (Nils, LegacyApp OVRV0410.PKG:199.)
        {Published = True}
        Procedure ModAnalyzer_VerifyAutoFix_NoToPosDemoted
            Handle ho
            tModAnalyzer rRecipe rChecked
            Get Create (RefClass(cModAnalyzer)) to ho
            Move 4531                         to rRecipe.iMsgNumber
            Move eModAutoFix                  to rRecipe.eCategory
            Move "command: Pos"               to rRecipe.sMatchText
            Move "ChangePosCommandToFunction" to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe 'POS " " IN strSOKTEXT' to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModExplain)
            Send Assert (rChecked.sRefactorFn = "")
        End_Procedure

        // ...but a Pos WITH a destination ("Pos x in y to z") IS convertible -> the dry-run changes it, so it
        // stays Auto-fix. Proves the demote is precise, not a blanket "Pos -> Explain".
        {Published = True}
        Procedure ModAnalyzer_VerifyAutoFix_PosWithToKept
            Handle ho
            tModAnalyzer rRecipe rChecked
            Get Create (RefClass(cModAnalyzer)) to ho
            Move 4531                         to rRecipe.iMsgNumber
            Move eModAutoFix                  to rRecipe.eCategory
            Move "command: Pos"               to rRecipe.sMatchText
            Move "ChangePosCommandToFunction" to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe 'Pos " " in sText to iPos' to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModAutoFix)
            Send Assert (rChecked.sRefactorFn = "ChangePosCommandToFunction")
        End_Procedure

        // The dry-run tracks Bucket 1's in-place fix: "uppercase sVar" (no "to") now CHANGES, so it correctly
        // STAYS Auto-fix - the demote follows the function, it is not a blanket "no-to -> demote" heuristic.
        {Published = True}
        Procedure ModAnalyzer_VerifyAutoFix_InPlaceUppercaseKept
            Handle ho
            tModAnalyzer rRecipe rChecked
            Get Create (RefClass(cModAnalyzer)) to ho
            Move 4531                               to rRecipe.iMsgNumber
            Move eModAutoFix                        to rRecipe.eCategory
            Move "command: Uppercase"               to rRecipe.sMatchText
            Move "ChangeUppercaseCommandToFunction" to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe "uppercase sVar" to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModAutoFix)
            Send Assert (rChecked.sRefactorFn = "ChangeUppercaseCommandToFunction")
        End_Procedure

        // The WHOLE-FILE auto-fixes (RemovePropertyPrivate/Public, and the Unicode 4539 pair
        // UnicodePointerToString/UnicodeStringToPointer) must be source-guarded so the caller reads the whole
        // file and can dry-run + demote a no-op (a guarded property, or a 4539 fired from a #COMMAND expansion
        // like Local_Buffer that the converter can't touch). (Nils 2026-07-08.)
        {Published = True}
        Procedure ModAnalyzer_RecipeNeedsSourceGuard_WholeFile
            Handle ho
            tModAnalyzer rPriv rPub rOther rS2P
            Boolean bPriv bPub bOther bS2P

            Get Create (RefClass(cModAnalyzer)) to ho
            Move eModAutoFix             to rPriv.eCategory
            Move "RemovePropertyPrivate" to rPriv.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rPriv to bPriv
            Move eModAutoFix            to rPub.eCategory
            Move "RemovePropertyPublic" to rPub.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rPub to bPub
            Move eModAutoFix              to rOther.eCategory
            Move "UnicodePointerToString" to rOther.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rOther to bOther
            Move eModAutoFix              to rS2P.eCategory
            Move "UnicodeStringToPointer" to rS2P.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rS2P to bS2P
            Send Destroy of ho
            Send Assert bPriv
            Send Assert bPub
            Send Assert bOther
            Send Assert bS2P
        End_Procedure

        // VerifyAutoFixWholeFile is a no-op (early return) for a non-auto-fix or function-less recipe - it
        // never touches Review/Explain rows or a recipe with no function, and does NOT reach the funclib probe
        // in those cases. (The actual whole-file dry-run demote is verified in-app - it needs the runtime
        // FunctionsA MethodType table, which the pure DFUnit runner does not populate.)
        {Published = True}
        Procedure ModAnalyzer_VerifyAutoFixWholeFile_Fallbacks
            Handle ho
            tModAnalyzer rReview rNoFn rChecked
            String[] asLines

            Move "property integer x private 0" to asLines[0]
            Get Create (RefClass(cModAnalyzer)) to ho
            Move eModSuggest           to rReview.eCategory
            Move "RefactorGridToCJGrid" to rReview.sRefactorFn
            Get VerifyAutoFixWholeFile of ho rReview (&asLines) "" to rChecked
            Send Assert (rChecked.eCategory = eModSuggest)
            Send Assert (rChecked.sRefactorFn = "RefactorGridToCJGrid")
            Move eModAutoFix to rNoFn.eCategory
            Move ""          to rNoFn.sRefactorFn
            Get VerifyAutoFixWholeFile of ho rNoFn (&asLines) "" to rChecked
            Send Assert (rChecked.eCategory = eModAutoFix)
            Send Destroy of ho
        End_Procedure

        // Deep Scan AUTO-FIX rows (pseudo msg numbers 9001+, blank match-text) must be source-guarded
        // so VerifyAutoFix can dry-run the mapped converter against the real hit line - the rule's
        // category is the catalog's STATIC default, not a per-line guarantee. DS Review rows and a
        // function-less DS row need no guard (nothing to dry-run). (Nils 2026-07-16, honesty pass.)
        {Published = True}
        Procedure ModAnalyzer_DeepScan_RecipeNeedsSourceGuard
            Handle ho
            tModAnalyzer rAuto rReview rNoFn
            Boolean bAuto bReview bNoFn

            Get Create (RefClass(cModAnalyzer)) to ho
            Move CI_DeepScanFirstDSNumber to rAuto.iMsgNumber
            Move eModAutoFix              to rAuto.eCategory
            Move "ChangeTrimCommandToFunction" to rAuto.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rAuto to bAuto
            Move (CI_DeepScanFirstDSNumber + 41) to rReview.iMsgNumber
            Move eModSuggest              to rReview.eCategory
            Move "GosubGotoReport"        to rReview.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rReview to bReview
            Move (CI_DeepScanFirstDSNumber + 60) to rNoFn.iMsgNumber
            Move eModAutoFix              to rNoFn.eCategory
            Move ""                       to rNoFn.sRefactorFn
            Get RecipeNeedsSourceGuard of ho rNoFn to bNoFn
            Send Destroy of ho
            Send Assert bAuto
            Send AssertFalse bReview
            Send AssertFalse bNoFn
        End_Procedure

        // A Deep Scan Auto-fix row whose converter DECLINES the hit line's exact shape demotes to
        // Explain: the eDSCommandPos "pos" rule flags 'POS x IN y' (first-token match), but the
        // no-'to' form is the [Found] side-effect the converter correctly refuses - the old static
        // Auto-fix promised a fix the plan run never made (the "same rows survive" complaint). The
        // demote hint must point at the convergent loop (re-scan after the run).
        {Published = True}
        Procedure ModAnalyzer_DeepScan_VerifyAutoFix_RefusedLineDemoted
            Handle ho
            tModAnalyzer rRecipe rChecked
            Get Create (RefClass(cModAnalyzer)) to ho
            Move (CI_DeepScanFirstDSNumber + 7)  to rRecipe.iMsgNumber
            Move eModAutoFix                     to rRecipe.eCategory
            Move ""                              to rRecipe.sMatchText
            Move "ChangePosCommandToFunction"    to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe 'POS " " IN strSOKTEXT' to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModExplain)
            Send Assert (rChecked.sRefactorFn = "")
            Send Assert (rChecked.sHint contains "re-scan")
        End_Procedure

        // ...and the convertible form STAYS Auto-fix: the dry-run changes 'Pos x in y to z', so the
        // demote is precise (follows the converter), not a blanket "DS -> Explain".
        {Published = True}
        Procedure ModAnalyzer_DeepScan_VerifyAutoFix_ConvertibleLineKept
            Handle ho
            tModAnalyzer rRecipe rChecked
            Get Create (RefClass(cModAnalyzer)) to ho
            Move (CI_DeepScanFirstDSNumber + 7)  to rRecipe.iMsgNumber
            Move eModAutoFix                     to rRecipe.eCategory
            Move ""                              to rRecipe.sMatchText
            Move "ChangePosCommandToFunction"    to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe 'Pos " " in sText to iPos' to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModAutoFix)
            Send Assert (rChecked.sRefactorFn = "ChangePosCommandToFunction")
        End_Procedure

        // The STAGED-conversion shape: the eDSIfNot rule flags 'If Not sName eq "X"', but the If-Not
        // converter bails on a multi-term unparenthesized condition (ChangeLegacyOperators must fix
        // the eq first - the operators-first house rule; next pass's re-scan then converts the If
        // Not). The dry-run demotes it THIS pass, and the hint's "re-scan after the plan run" is
        // exactly the honest instruction. A plain 'If Not Found ...' still converts -> stays
        // Auto-fix.
        {Published = True}
        Procedure ModAnalyzer_DeepScan_VerifyAutoFix_IfNotStagedDemoted
            Handle ho
            tModAnalyzer rRecipe rStaged rPlain

            Get Create (RefClass(cModAnalyzer)) to ho
            Move (CI_DeepScanFirstDSNumber + 37) to rRecipe.iMsgNumber
            Move eModAutoFix                     to rRecipe.eCategory
            Move ""                              to rRecipe.sMatchText
            Move "ChangeIfNotCommandToExpression" to rRecipe.sRefactorFn
            Get VerifyAutoFix of ho rRecipe 'If Not sName eq "X" Begin' to rStaged
            Get VerifyAutoFix of ho rRecipe "If Not Found Procedure_Return" to rPlain
            Send Destroy of ho
            Send Assert (rStaged.eCategory = eModExplain)
            Send Assert (rStaged.sRefactorFn = "")
            Send Assert (rPlain.eCategory = eModAutoFix)
            Send Assert (rPlain.sRefactorFn = "ChangeIfNotCommandToExpression")
        End_Procedure

        // The saved-plan builder honours the per-workspace Ignore list (passed in by the caller's
        // ReadIgnored): the saved JSON deliberately keeps ALL rows and the saved-VIEW grid
        // re-filters at load, so the plan must too - an ignored DS row's function must NOT come
        // back ticked in Run Plan after a restart (Nils's WinServ lap, 2026-07-17). Grid == plan.
        {Published = True}
        Procedure ModAnalyzer_PlanFromSavedRows_IgnoredRowDropped
            String[] asNoExtraKeys
            Handle ho
            tSavedPlanRow[] aRows
            tModRefactorPlan Plan
            tModIgnore[] aIgnored

            Get Create (RefClass(cModAnalyzer)) to ho
            Move "c:\test\gbe.dg" to aIgnored[0].sFile
            Move "DS 9002"        to aIgnored[0].sMsg
            Move eModAutoFix                        to aRows[0].eCategory
            Move "DS 9002"                          to aRows[0].sMsg
            Move "c:\test\gbe.dg"                   to aRows[0].sFile
            Move "ChangeCharacterCommandToFunction" to aRows[0].sFn
            Move eModAutoFix                        to aRows[1].eCategory
            Move "DS 9011"                          to aRows[1].sMsg
            Move "c:\test\other.vw"                 to aRows[1].sFile
            Move "ChangeTrimCommandToFunction"      to aRows[1].sFn
            Get PlanFromSavedRows of ho aRows aIgnored asNoExtraKeys to Plan
            Send Destroy of ho
            Send Assert (SizeOfArray(Plan.asFunctions) = 1)
            Send AssertSAreEqual "ChangeTrimCommandToFunction" Plan.asFunctions[0]
            Send Assert (SearchArray("c:\test\gbe.dg", Plan.asFiles) = -1)
        End_Procedure

        // VerifyAutoFixWholeFile never touches a Deep Scan row: DS honesty is owned by VerifyAutoFix's
        // per-line dry-run, and the DS whole-file class converters (ChangeDfTimerTocTimer et al) must
        // not pay a heavy full-conversion probe per (file, function) - their Object-declaration shape
        // was already verified by the scanner's eDSClassDecl rule.
        {Published = True}
        Procedure ModAnalyzer_DeepScan_VerifyAutoFixWholeFile_Skipped
            Handle ho
            tModAnalyzer rRecipe rChecked
            String[] asLines
            Move "Object oClock is a DfTimer" to asLines[0]
            Get Create (RefClass(cModAnalyzer)) to ho
            Move (CI_DeepScanFirstDSNumber + 43) to rRecipe.iMsgNumber
            Move eModAutoFix                     to rRecipe.eCategory
            Move ""                              to rRecipe.sMatchText
            Move "ChangeDfTimerTocTimer"         to rRecipe.sRefactorFn
            Get VerifyAutoFixWholeFile of ho rRecipe (&asLines) "" to rChecked
            Send Destroy of ho
            Send Assert (rChecked.eCategory = eModAutoFix)
            Send Assert (rChecked.sRefactorFn = "ChangeDfTimerTocTimer")
        End_Procedure


        // AmbiguousFnNameFromText: the compiler NAMES the ambiguous message in its 4544 text, which is what
        // lets ChangeAmbiguousCallToGet be driven from the diagnostics instead of a workspace harvest.
        {Published = True}
        Procedure ModAnalyzer_AmbiguousFnName_FromRealText
            String s
            Get AmbigName "Ambiguous function in expression Function GET_VALUE with ambiguous return type used in expression" to s
            Send AssertSAreEqual "VALUE" s
        End_Procedure

        // A property reads the same way (GET_PBSILENT -> PBSILENT).
        {Published = True}
        Procedure ModAnalyzer_AmbiguousFnName_Property
            String s
            Get AmbigName "Ambiguous function in expression Function GET_PBSILENT with ambiguous return type used in expression" to s
            Send AssertSAreEqual "PBSILENT" s
        End_Procedure

        // NEGATIVE: a text with no GET_ token yields nothing rather than a bogus name.
        {Published = True}
        Procedure ModAnalyzer_AmbiguousFnName_NoMatch
            String s
            Get AmbigName "Some other compiler message entirely" to s
            Send AssertSAreEqual "" s
        End_Procedure


        // The ignore list is pre-normalised ONCE into sorted key sets, because re-normalising both sides
        // of every comparison cost 16,922 ms of a 72-second Analyze: 40,087 messages against 552 ignore
        // rows is 22 million comparisons, each allocating four or five strings (measured 2026-07-22).
        {Published = True}
        Procedure ModAnalyzer_IgnoreKeysAreNormalisedAndSorted
            Handle ho
            tModIgnore[] aIgnored
            String[] asKeys asFiles

            Get Create (RefClass(cModAnalyzer)) to ho
            Move "Zeta.pkg"          to aIgnored[0].sFile
            Move "W 4532"            to aIgnored[0].sMsg
            Move "  Alpha.PKG  "     to aIgnored[1].sFile
            Move "  E 4544 "         to aIgnored[1].sMsg
            Move "Alpha.pkg"         to aIgnored[2].sFile
            Move "W 4531"            to aIgnored[2].sMsg
            Get IgnoreKeysFromList of ho (&aIgnored) to asKeys
            Send Assert (SizeOfArray(asKeys) = 3)
            // lowercased, trimmed, "<file>|<msg>", and in sorted order
            Send AssertSAreEqual "alpha.pkg|E 4544" asKeys[0]
            Send AssertSAreEqual "alpha.pkg|W 4531" asKeys[1]
            Send AssertSAreEqual "zeta.pkg|W 4532"  asKeys[2]
            // the distinct FILES - the gate that settles almost every message without building a key
            Get IgnoreFilesFromList of ho (&aIgnored) to asFiles
            Send Assert (SizeOfArray(asFiles) = 2)
            Send AssertSAreEqual "alpha.pkg" asFiles[0]
            Send AssertSAreEqual "zeta.pkg"  asFiles[1]
            Send Destroy of ho
        End_Procedure

        // BinarySearchArray needs a SORTED array; if the sort and the search ever disagreed, a dismissed
        // row would quietly reappear. This pins the lookup the hot loop actually performs.
        {Published = True}
        Procedure ModAnalyzer_IgnoreKeyLookupFindsHitsAndMisses
            Handle ho
            tModIgnore[] aIgnored
            String[] asKeys
            Integer i

            Get Create (RefClass(cModAnalyzer)) to ho
            For i from 0 to 19
                Move ("file" + String(i) + ".pkg") to aIgnored[i].sFile
                Move ("W 45" + String(30 + i))     to aIgnored[i].sMsg
            Loop
            Get IgnoreKeysFromList of ho (&aIgnored) to asKeys
            Send Assert (SizeOfArray(asKeys) = 20)
            For i from 0 to 19
                Send Assert (BinarySearchArray(("file" + String(i) + ".pkg|W 45" + String(30 + i)), asKeys) <> -1)
            Loop
            Send Assert (BinarySearchArray("file3.pkg|W 9999", asKeys) = -1)
            Send Assert (BinarySearchArray("nosuch.pkg|W 4530", asKeys) = -1)
            Send Destroy of ho
        End_Procedure

        /* SEVERITY IS LEARNED FROM THE COMPILER, not from the recipe table's own guess.

           bIsWarning had two sources and neither was authoritative: BuildDefaultRecipes classifies
           by hand, and the install-Pkg harvest hardcodes True for everything it finds - so an
           ERROR-numbered message picked up from Pkg source claimed to be a warning. The install
           ships no message-severity catalogue to read instead, so the compiler's own "WARNING:" /
           "ERROR:" prefix is the only authority - and it is already parsed into tCompileError.bError.

           The pure half is tested here; the storing half writes to the ModAnalyzer table, which this
           fixture deliberately never touches. */
        {Published = True}
        Procedure ModAnalyzer_LearnsSeverityFromTheCompilersOwnVerdict
            Handle ho
            tCompileError[] aMsgs
            tModAnalyzer[] aR aOut
            Integer iChanged

            Get Create (RefClass(cModAnalyzer)) to ho

            // Two recipes, both claiming "warning" - the harvest's blanket assumption.
            Get AddRecipe of ho aR 4539 True "" "" eModExplain "hint" to aR
            Get AddRecipe of ho aR 4533 True "" "" eModExplain "hint" to aR

            // What the compiler actually said: 4539 is an ERROR, 4533 a warning.
            Move False to aMsgs[0].bDeepScan
            Move 4539   to aMsgs[0].iErrorNo
            Move True   to aMsgs[0].bError
            Move False to aMsgs[1].bDeepScan
            Move 4533   to aMsgs[1].iErrorNo
            Move False  to aMsgs[1].bError

            Get _LearnedSeverities of ho (&aMsgs) (&aR) (&iChanged) to aOut
            Send AssertIAreEqual 1 iChanged                       // only 4539 disagreed
            Send Assert (aOut[0].bIsWarning = False) "4539 must be learned as an ERROR"
            Send Assert (aOut[1].bIsWarning = True)  "4533 was already right and must stay a warning"

            // Idempotent: a second pass over the same evidence changes nothing.
            Move aOut to aR
            Get _LearnedSeverities of ho (&aMsgs) (&aR) (&iChanged) to aOut
            Send AssertIAreEqual 0 iChanged
            Send Destroy of ho
        End_Procedure

        /* DEEP SCAN ROWS MUST NOT TEACH. Their iErrorNo is a DS pseudo-number (9001+) and their
           bError is whatever the synthetic row carried - not a compiler verdict. Letting one write
           here would teach the table nonsense about a number the compiler never issues, and the DS
           numbers overlap nothing today only by luck of the range. */
        {Published = True}
        Procedure ModAnalyzer_DeepScanRowsNeverTeachSeverity
            Handle ho
            tCompileError[] aMsgs
            tModAnalyzer[] aR aOut
            Integer iChanged
            Get Create (RefClass(cModAnalyzer)) to ho
            Get AddRecipe of ho aR 9059 True "" "" eModExplain "hint" to aR
            Move True  to aMsgs[0].bDeepScan      // a scan row claiming to be an error
            Move 9059  to aMsgs[0].iErrorNo
            Move True  to aMsgs[0].bError
            Get _LearnedSeverities of ho (&aMsgs) (&aR) (&iChanged) to aOut
            Send AssertIAreEqual 0 iChanged
            Send Assert (aOut[0].bIsWarning = True) "a Deep Scan row must not change a recipe severity"
            Send Destroy of ho
        End_Procedure

        // ---- PlanFromMessages, end to end (2026-08-16) ---------------------------------------------
        // The plan builder itself had no direct test: messages in -> distinct functions + distinct files
        // out, scoped to the workspace root, library files stripped, Explain rows contributing nothing.
        // The analyzer is SEEDED with the in-memory defaults and marked loaded, so EnsureRecipesLoaded
        // never touches the ModAnalyzer table or the recipe JSON (the fixture stays pure, like MakeRecipe).
        // The runner's cApplication has no psTargetDfVersion and answers "" - the loaded version is set to
        // match, or the seed would be reloaded from the database on the first call.
        Function _SeededPlanAnalyzer Returns Handle
            Handle ho
            tModAnalyzer[] aRecipes
            Get Create (RefClass(cModAnalyzer)) to ho
            Get BuildDefaultRecipes of ho to aRecipes
            Set paRecipes         of ho to aRecipes
            Set pbRecipesLoaded   of ho to True
            Set psLoadedDfVersion of ho to ""
            // Pin the library / selected-folder roots too (empty), so VerifyLibraryOwned inside the
            // plan build never asks ghoApplication for anything - the fixture stays self-contained.
            Set psLibRootsKey     of ho to "*seeded*"
            Function_Return ho
        End_Function

        // A 4392 "Missing keyword returns" message: Auto-fix -> AddFunctionReturnsKeyword, and one of the
        // recipes that needs NO source guard, so a file that does not exist on disk is fine to plan against.
        Function _PlanMsg String sFile Integer iLine Returns tCompileError
            tCompileError E
            Move True                                              to E.bError
            Move 4392                                              to E.iErrorNo
            Move iLine                                             to E.iLine
            Move sFile                                             to E.sFileName
            Move "Missing keyword returns on function declaration" to E.sErrorTxt
            Function_Return E
        End_Function

        // Three messages, one function, two files: the function is listed ONCE with its hint alongside
        // (parallel arrays), each file ONCE - however many of its lines warned.
        {Published = True}
        Procedure ModAnalyzer_PlanFromMessages_DistinctFunctionsAndFiles
            Handle ho
            tCompileError[] aMsgs
            tModRefactorPlan Plan

            Get _PlanMsg "C:\WS\AppSrc\Order.vw"    10 to aMsgs[0]
            Get _PlanMsg "C:\WS\AppSrc\Order.vw"    20 to aMsgs[1]
            Get _PlanMsg "C:\WS\AppSrc\Customer.vw"  5 to aMsgs[2]
            Get _SeededPlanAnalyzer to ho
            Get PlanFromMessages of ho aMsgs "C:\WS\" to Plan
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctions))
            Send AssertSAreEqual "AddFunctionReturnsKeyword" Plan.asFunctions[0]
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctionHints))
            Send Assert ((Trim(Plan.asFunctionHints[0])) <> "")
            Send AssertIAreEqual 2 (SizeOfArray(Plan.asFiles))
            Send Assert (SearchArray("C:\WS\AppSrc\Order.vw",    Plan.asFiles) <> -1)
            Send Assert (SearchArray("C:\WS\AppSrc\Customer.vw", Plan.asFiles) <> -1)
        End_Procedure

        // The scope root keeps the plan inside the workspace: a message from the DataFlex install's Pkg
        // folder is dropped under a root, and kept when the root is "" (no filter).
        {Published = True}
        Procedure ModAnalyzer_PlanFromMessages_ScopeRootFiltersFiles
            Handle ho
            tCompileError[] aMsgs
            tModRefactorPlan PlanScoped PlanAll
            Get _PlanMsg "C:\Program Files\DataFlex 25.0\Pkg\Some.pkg" 3 to aMsgs[0]
            Get _PlanMsg "C:\WS\AppSrc\Order.vw"                     10 to aMsgs[1]
            Get _SeededPlanAnalyzer to ho
            Get PlanFromMessages of ho aMsgs "C:\WS\" to PlanScoped
            Get PlanFromMessages of ho aMsgs ""       to PlanAll
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(PlanScoped.asFiles))
            Send AssertSAreEqual "C:\WS\AppSrc\Order.vw" PlanScoped.asFiles[0]
            Send AssertIAreEqual 2 (SizeOfArray(PlanAll.asFiles))
        End_Procedure

        // An Explain-only message (4379, wrong argument count) maps to no function: neither the function
        // list nor the file list grows - a file with nothing actionable must not be processed by the engine.
        {Published = True}
        Procedure ModAnalyzer_PlanFromMessages_ExplainRowsAddNothing
            Handle ho
            tCompileError[] aMsgs
            tModRefactorPlan Plan
            Move True                        to aMsgs[0].bError
            Move 4379                        to aMsgs[0].iErrorNo
            Move 7                           to aMsgs[0].iLine
            Move "C:\WS\AppSrc\Order.vw"     to aMsgs[0].sFileName
            Move "Wrong number of arguments" to aMsgs[0].sErrorTxt
            Get _SeededPlanAnalyzer to ho
            Get PlanFromMessages of ho aMsgs "C:\WS\" to Plan
            Send Destroy of ho
            Send AssertIAreEqual 0 (SizeOfArray(Plan.asFunctions))
            Send AssertIAreEqual 0 (SizeOfArray(Plan.asFiles))
        End_Procedure

        // A message from a LIBRARY file loses its function (the library is replaced, not edited), so the
        // library file never enters the plan - the workspace's own file with the same message does.
        {Published = True}
        Procedure ModAnalyzer_PlanFromMessages_LibraryFileAddsNothing
            Handle ho
            String[] asRoots asNames
            tCompileError[] aMsgs
            tModRefactorPlan Plan

            Move "c:\ws\libraries\vwin32fh\" to asRoots[0]
            Move "vwin32fh"                   to asNames[0]
            Get _PlanMsg "C:\WS\Libraries\vWin32fh\vwin32fh.pkg" 4 to aMsgs[0]
            Get _PlanMsg "C:\WS\AppSrc\Order.vw"               10 to aMsgs[1]
            Get _SeededPlanAnalyzer to ho
            Set pasLibRoots   of ho to asRoots
            Set pasLibNames   of ho to asNames
            Set psLibRootsKey of ho to "*seeded*"     // pinned - never recomputed off ghoApplication
            Get PlanFromMessages of ho aMsgs "C:\WS\" to Plan
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctions))
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFiles))
            Send AssertSAreEqual "C:\WS\AppSrc\Order.vw" Plan.asFiles[0]
        End_Procedure

        // No messages at all: an empty plan, no fault.
        {Published = True}
        Procedure ModAnalyzer_PlanFromMessages_EmptyInput
            Handle ho
            tCompileError[] aNone
            tModRefactorPlan Plan
            Get _SeededPlanAnalyzer to ho
            Get PlanFromMessages of ho aNone "C:\WS\" to Plan
            Send Destroy of ho
            Send AssertIAreEqual 0 (SizeOfArray(Plan.asFunctions))
            Send AssertIAreEqual 0 (SizeOfArray(Plan.asFiles))
        End_Procedure

        // ---- the plan's indicator companion -------------------------------------------------------
        // AddNeededIndicatorCompanions has two early exits that never touch the funclib or the disk:
        // the companion is already in the plan, or no indicator converter touched any file. Both leave
        // the plan exactly as it was.
        {Published = True}
        Procedure ModAnalyzer_AddNeededIndicatorCompanions_EarlyExitsLeavePlanAlone
            Handle ho
            tModRefactorPlan PlanA PlanB
            String[] asFiles asKeys asNone

            Get Create (RefClass(cModAnalyzer)) to ho
            // (a) already there
            Move "DeclareRefactoredIndicators" to PlanA.asFunctions[0]
            Move "declares them"               to PlanA.asFunctionHints[0]
            Move "c:\ws\appsrc\a.vw"           to asFiles[0]
            Move "c:\ws\appsrc\a.vw|12"        to asKeys[0]
            Send AddNeededIndicatorCompanions of ho (&PlanA) asFiles asKeys
            Send AssertIAreEqual 1 (SizeOfArray(PlanA.asFunctions))
            Send AssertIAreEqual 1 (SizeOfArray(PlanA.asFunctionHints))
            // (b) an indicator converter in the plan but NO file it touched
            Move "ChangeIndicatorToBoolean" to PlanB.asFunctions[0]
            Move "booleans"                 to PlanB.asFunctionHints[0]
            Send AddNeededIndicatorCompanions of ho (&PlanB) asNone asNone
            Send AssertIAreEqual 1 (SizeOfArray(PlanB.asFunctions))
            Send AssertSAreEqual "ChangeIndicatorToBoolean" PlanB.asFunctions[0]
            Send Destroy of ho
        End_Procedure

        // ---- LibraryOwningFile ---------------------------------------------------------------------
        // The library a file belongs to, off SEEDED roots: inside (any casing) names the library, a
        // sibling folder that merely starts the same does not, the workspace's own code and an empty
        // path answer "".
        {Published = True}
        Procedure ModAnalyzer_LibraryOwningFile_SeededRoots
            Handle ho
            String[] asRoots asNames
            String sIn sSibling sOwn sBlank

            Move "c:\ws\libraries\vwin32fh\" to asRoots[0]
            Move "vwin32fh"                   to asNames[0]
            Move "c:\ws\libraries\duf\"       to asRoots[1]
            Move "DUF"                        to asNames[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Set pasLibRoots   of ho to asRoots
            Set pasLibNames   of ho to asNames
            Set psLibRootsKey of ho to "*seeded*"
            Get LibraryOwningFile of ho "C:\WS\Libraries\VWIN32FH\vwin32fh.pkg" to sIn
            Get LibraryOwningFile of ho "C:\WS\Libraries\vwin32fh2\other.pkg"  to sSibling
            Get LibraryOwningFile of ho "C:\WS\AppSrc\Order.vw"                to sOwn
            Get LibraryOwningFile of ho ""                                     to sBlank
            Send Destroy of ho
            Send AssertSAreEqual "vwin32fh" sIn
            Send AssertSAreEqual ""         sSibling
            Send AssertSAreEqual ""         sOwn
            Send AssertSAreEqual ""         sBlank
        End_Procedure

        // ---- CategoryText --------------------------------------------------------------------------
        // The four labels: one per category, "Unknown" for anything else (the grid never shows a number).
        {Published = True}
        Procedure ModAnalyzer_CategoryText_AllLabels
            Handle ho
            String sAuto sReview sExplain sOther
            Get Create (RefClass(cModAnalyzer)) to ho
            Get CategoryText of ho eModAutoFix to sAuto
            Get CategoryText of ho eModSuggest to sReview
            Get CategoryText of ho eModExplain to sExplain
            Get CategoryText of ho 12345       to sOther
            Send Destroy of ho
            Send AssertSAreEqual "Auto-fix" sAuto
            Send AssertSAreEqual "Review"   sReview
            Send AssertSAreEqual "Explain"  sExplain
            Send AssertSAreEqual "Unknown"  sOther
        End_Procedure

        // ---- ExpandFloodFilesIntoPlan (2026-08-16) -----------------------------------------------
        // A collapsed scan rule is ONE grid row with ONE file, and the plan is built from the rows -
        // so its file list is folded in separately. Three verdicts: a flood whose row is in the plan
        // adds every file once; a DISMISSED flood adds nothing; a flood whose function the plan does
        // not carry (its row was not actionable) adds nothing.
        {Published = True}
        Procedure ModAnalyzer_ExpandFloodFiles_AddsEveryFileOnce
            Handle ho
            tModRefactorPlan Plan
            tSavedPlanFlood[] aFloods
            tModIgnore[] aNoIgnores

            // what PlanFromSavedRows made of the summary row: its function + its ONE file
            Move "ChangeLegacyOperators"  to Plan.asFunctions[0]
            Move "legacy operators"       to Plan.asFunctionHints[0]
            Move "c:\ws\appsrc\a.vw"      to Plan.asFiles[0]
            Move 9035                     to aFloods[0].iDSNumber
            Move "EQ comparison"          to aFloods[0].sSymbol
            Move "ChangeLegacyOperators"  to aFloods[0].sFn
            Move "c:\ws\appsrc\a.vw"      to aFloods[0].sFirstFile
            Move "c:\ws\appsrc\a.vw"      to aFloods[0].asFiles[0]
            Move "c:\ws\appsrc\b.vw"      to aFloods[0].asFiles[1]
            Move "c:\ws\appsrc\c.pkg"     to aFloods[0].asFiles[2]
            Get Create (RefClass(cModAnalyzer)) to ho
            Send ExpandFloodFilesIntoPlan of ho aFloods aNoIgnores (&Plan)
            Send Destroy of ho
            Send AssertIAreEqual 3 (SizeOfArray(Plan.asFiles))
            Send Assert (SearchArray("c:\ws\appsrc\b.vw",  Plan.asFiles) <> -1)
            Send Assert (SearchArray("c:\ws\appsrc\c.pkg", Plan.asFiles) <> -1)
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctions))    // no function added, none duplicated
        End_Procedure

        {Published = True}
        Procedure ModAnalyzer_ExpandFloodFiles_DismissedFloodAddsNothing
            Handle ho
            tModRefactorPlan Plan
            tSavedPlanFlood[] aFloods
            tModIgnore[] aIgnored

            Move "ChangeLegacyOperators"  to Plan.asFunctions[0]
            Move "legacy operators"       to Plan.asFunctionHints[0]
            Move "c:\ws\appsrc\other.vw"  to Plan.asFiles[0]      // some OTHER row put the function in
            Move 9035                     to aFloods[0].iDSNumber
            Move "ChangeLegacyOperators"  to aFloods[0].sFn
            Move "c:\ws\appsrc\a.vw"      to aFloods[0].sFirstFile
            Move "c:\ws\appsrc\a.vw"      to aFloods[0].asFiles[0]
            Move "c:\ws\appsrc\b.vw"      to aFloods[0].asFiles[1]
            Move "c:\ws\appsrc\a.vw"      to aIgnored[0].sFile     // the summary row was dismissed
            Move "DS 9035"                to aIgnored[0].sMsg
            Get Create (RefClass(cModAnalyzer)) to ho
            Send ExpandFloodFilesIntoPlan of ho aFloods aIgnored (&Plan)
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFiles))
            Send AssertSAreEqual "c:\ws\appsrc\other.vw" Plan.asFiles[0]
        End_Procedure

        {Published = True}
        Procedure ModAnalyzer_ExpandFloodFiles_FunctionNotInPlanAddsNothing
            Handle ho
            tModRefactorPlan Plan
            tSavedPlanFlood[] aFloods aNone
            tModIgnore[] aNoIgnores

            Move "AddFunctionReturnsKeyword" to Plan.asFunctions[0]
            Move "returns"                   to Plan.asFunctionHints[0]
            Move "c:\ws\appsrc\x.vw"         to Plan.asFiles[0]
            Move 9040                        to aFloods[0].iDSNumber
            Move "ChangeInToContains"        to aFloods[0].sFn     // its row was not actionable - not in the plan
            Move "c:\ws\appsrc\a.vw"         to aFloods[0].sFirstFile
            Move "c:\ws\appsrc\a.vw"         to aFloods[0].asFiles[0]
            Move "c:\ws\appsrc\b.vw"         to aFloods[0].asFiles[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            Send ExpandFloodFilesIntoPlan of ho aFloods aNoIgnores (&Plan)
            Send ExpandFloodFilesIntoPlan of ho aNone   aNoIgnores (&Plan)   // and no floods at all
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFiles))
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctions))
        End_Procedure

        // ---- TallyScanFloods (2026-08-16) --------------------------------------------------------
        // The scan-rule flood tally, lifted out of the FT grid so it can be proven here. A DS message
        // in the shape the scanner emits (HitsToMessages): bDeepScan True, iErrorNo = the DS number,
        // sErrorTxt = the rule symbol.
        Function _DsMsg Integer iDS String sSymbol String sFile Integer iLine Returns tCompileError
            tCompileError E
            Move True    to E.bDeepScan
            Move False   to E.bError
            Move iDS     to E.iErrorNo
            Move sSymbol to E.sErrorTxt
            Move sFile   to E.sFileName
            Move iLine   to E.iLine
            Function_Return E
        End_Function

        // A rule at the threshold, file-grouped with a REVISIT of an earlier file: one tally with the
        // right count, DISTINCT file count and list (first-seen order, no double count on the revisit),
        // and the FIRST finding as the summary row's file/line. A second rule under the threshold is
        // not returned; a compiler message with the same number is never counted.
        {Published = True}
        Procedure ModAnalyzer_TallyScanFloods_DistinctFilesAndFirstFinding
            Handle ho
            tCompileError[] aMsgs
            tDSFloodTally[] aTally

            Get _DsMsg 9035 "EQ comparison" "c:\ws\a.vw"  10 to aMsgs[0]
            Get _DsMsg 9035 "EQ comparison" "c:\ws\a.vw"  22 to aMsgs[1]
            Get _DsMsg 9035 "EQ comparison" "c:\ws\b.vw"   5 to aMsgs[2]
            Get _DsMsg 9036 "NE comparison" "c:\ws\b.vw"   6 to aMsgs[3]   // another rule, under threshold
            Get _DsMsg 9035 "EQ comparison" "c:\ws\c.pkg" 40 to aMsgs[4]
            Get _DsMsg 9035 "EQ comparison" "c:\ws\a.vw"  99 to aMsgs[5]   // revisit of a.vw
            Move True                  to aMsgs[6].bError                   // a COMPILER row with the same number
            Move 9035                  to aMsgs[6].iErrorNo
            Move "c:\ws\d.vw"          to aMsgs[6].sFileName
            Move "not a scan finding"  to aMsgs[6].sErrorTxt
            Get Create (RefClass(cModAnalyzer)) to ho
            Get TallyScanFloods of ho (&aMsgs) 5 to aTally
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(aTally))
            Send AssertIAreEqual 9035 aTally[0].iDSNumber
            Send AssertIAreEqual 5    aTally[0].iCount
            Send AssertIAreEqual 3    aTally[0].iFiles
            Send AssertIAreEqual 3    (SizeOfArray(aTally[0].asFiles))
            Send AssertSAreEqual "c:\ws\a.vw"  aTally[0].asFiles[0]
            Send AssertSAreEqual "c:\ws\b.vw"  aTally[0].asFiles[1]
            Send AssertSAreEqual "c:\ws\c.pkg" aTally[0].asFiles[2]
            Send AssertSAreEqual "c:\ws\a.vw"  aTally[0].sFirstFile
            Send AssertIAreEqual 10            aTally[0].iFirstLine
            Send AssertSAreEqual "EQ comparison" aTally[0].sSymbol
        End_Procedure

        // Two rules both over the threshold come back as two tallies with separate file lists; a rule
        // exactly ONE short of the threshold does not. Empty input is an empty answer.
        {Published = True}
        Procedure ModAnalyzer_TallyScanFloods_ThresholdIsInclusive
            Handle ho
            tCompileError[] aMsgs aNone
            tDSFloodTally[] aTally aEmpty

            Get _DsMsg 9035 "EQ comparison" "c:\ws\a.vw" 1 to aMsgs[0]
            Get _DsMsg 9035 "EQ comparison" "c:\ws\b.vw" 1 to aMsgs[1]
            Get _DsMsg 9036 "NE comparison" "c:\ws\a.vw" 2 to aMsgs[2]
            Get _DsMsg 9036 "NE comparison" "c:\ws\a.vw" 3 to aMsgs[3]
            Get _DsMsg 9037 "GT comparison" "c:\ws\a.vw" 4 to aMsgs[4]     // one short (1 < 2)
            Get Create (RefClass(cModAnalyzer)) to ho
            Get TallyScanFloods of ho (&aMsgs) 2 to aTally
            Get TallyScanFloods of ho (&aNone) 2 to aEmpty
            Send Destroy of ho
            Send AssertIAreEqual 2 (SizeOfArray(aTally))
            Send AssertIAreEqual 9035 aTally[0].iDSNumber
            Send AssertIAreEqual 2    aTally[0].iFiles
            Send AssertIAreEqual 9036 aTally[1].iDSNumber
            Send AssertIAreEqual 1    aTally[1].iFiles
            Send AssertIAreEqual 1    (SizeOfArray(aTally[1].asFiles))
            Send AssertIAreEqual 0 (SizeOfArray(aEmpty))
        End_Procedure

        /* HITS THAT LOST THE CONVERTER FLOOD APART (2026-10-03). A rule's hit carries the scan's own verdict;
           where that verdict dropped the rule's function (an Explain verdict with no function - an object
           of the workspace's own grid subclass), the hit is keyed under the NEGATIVE number, so it cannot
           fold into the summary row that carries the converter. Each group meets the threshold on its own;
           the negative one keeps its first hit's hint for its row. A hit with no verdict keeps the number. */
        {Published = True}
        Procedure ModAnalyzer_TallyScanFloods_LostConverterFloodsApart
            Handle ho
            tCompileError[] aMsgs
            tDSFloodTally[] aTally
            Integer i iPos iNeg

            For i from 0 to 2
                Get _DsMsg 9190 "dbGrid class" ("c:\ws\s" + String(i) + ".vw") 10 to aMsgs[i]
                Move eModExplain to aMsgs[i].eScanCategory
                Move ""          to aMsgs[i].sScanFn
                Move ("Matched through the workspace subclass MyDbGrid " + String(i)) to aMsgs[i].sScanHint
            Loop
            Get _DsMsg 9190 "dbGrid class" "c:\ws\p0.vw" 20 to aMsgs[3]
            Move eModSuggest                 to aMsgs[3].eScanCategory
            Move "RefactorDbGridTocDbCJGrid" to aMsgs[3].sScanFn
            Get _DsMsg 9190 "dbGrid class" "c:\ws\p1.vw" 21 to aMsgs[4]   // no verdict at all
            Get Create (RefClass(cModAnalyzer)) to ho
            Get TallyScanFloods of ho (&aMsgs) 2 to aTally
            Send Destroy of ho
            Send AssertIAreEqual 2 (SizeOfArray(aTally))
            Move -1 to iPos
            Move -1 to iNeg
            For i from 0 to (SizeOfArray(aTally) - 1)
                If (aTally[i].iDSNumber = 9190) ;
                    Move i to iPos
                If (aTally[i].iDSNumber = -9190) ;
                    Move i to iNeg
            Loop
            Send Assert (iPos >= 0) "the hits that keep the converter flood under the rule's number"
            Send Assert (iNeg >= 0) "the hits that lost it flood under the negative number"
            If (iPos >= 0 and iNeg >= 0) Begin
                Send AssertIAreEqual 2 aTally[iPos].iCount
                Send AssertIAreEqual 3 aTally[iNeg].iCount
                Send AssertSAreEqual "Matched through the workspace subclass MyDbGrid 0" aTally[iNeg].sFirstHint
            End
        End_Procedure

        // DSFloodKey on its own: Explain with no function negates; Explain WITH a function, another verdict,
        // or no verdict at all keeps the number.
        {Published = True}
        Procedure ModAnalyzer_DSFloodKey_OnlyALostConverterNegates
            Handle ho
            tCompileError E
            Integer iKey

            Get _DsMsg 9198 "dbGrid subclass" "c:\ws\a.pkg" 1 to E
            Get Create (RefClass(cModAnalyzer)) to ho
            Get DSFloodKey of ho E to iKey
            Send AssertIAreEqual 9198 iKey
            Move eModExplain to E.eScanCategory
            Get DSFloodKey of ho E to iKey
            Send AssertIAreEqual (0 - 9198) iKey
            Move "SomeConverter" to E.sScanFn
            Get DSFloodKey of ho E to iKey
            Send AssertIAreEqual 9198 iKey
            Move eModAutoFix to E.eScanCategory
            Move ""          to E.sScanFn
            Get DSFloodKey of ho E to iKey
            Send Destroy of ho
            Send AssertIAreEqual 9198 iKey
        End_Procedure

        // END TO END: a tally's files, packaged as tSavedPlanFlood the way the grid's FloodsForPlan
        // does, expand a plan built from the ONE summary row to every file the rule fired in - the
        // WinServ "x of 909" case, in miniature.
        {Published = True}
        Procedure ModAnalyzer_TallyThenExpand_PlanReachesEveryFile
            Handle ho
            tCompileError[] aMsgs
            tDSFloodTally[] aTally
            tSavedPlanFlood[] aFloods
            tModIgnore[] aNoIgnores
            tModRefactorPlan Plan
            Integer i

            For i from 0 to 5
                Get _DsMsg 9035 "EQ comparison" ("c:\ws\f" + String(i) + ".vw") (i + 1) to aMsgs[i]
            Loop
            Get Create (RefClass(cModAnalyzer)) to ho
            Get TallyScanFloods of ho (&aMsgs) 3 to aTally
            Send AssertIAreEqual 1 (SizeOfArray(aTally))
            // what the summary row gave PlanFromSavedRows: the function + the FIRST file only
            Move "ChangeLegacyOperators"  to Plan.asFunctions[0]
            Move "legacy operators"       to Plan.asFunctionHints[0]
            Move aTally[0].sFirstFile     to Plan.asFiles[0]
            // FloodsForPlan's packaging
            Move aTally[0].iDSNumber      to aFloods[0].iDSNumber
            Move aTally[0].sSymbol        to aFloods[0].sSymbol
            Move "ChangeLegacyOperators"  to aFloods[0].sFn
            Move aTally[0].sFirstFile     to aFloods[0].sFirstFile
            Move aTally[0].asFiles        to aFloods[0].asFiles
            Send ExpandFloodFilesIntoPlan of ho aFloods aNoIgnores (&Plan)
            Send Destroy of ho
            Send AssertIAreEqual 6 (SizeOfArray(Plan.asFiles))
            Send AssertIAreEqual 1 (SizeOfArray(Plan.asFunctions))
        End_Procedure

        // ---- a SELECTED library is the user's to change (2026-08-16) ------------------------------
        // Nils's rule, stated twice today: "All folders that are selected should be able to be changed
        // ... It doesn't matter if the files are part of a library or not - it never has." WinServ's
        // own WebAppSrc library - selected - had its 13 E 4539 auto-fixes stripped to Explain by
        // VerifyLibraryOwned. Now: a library file under a SELECTED folder keeps its recipe; a library
        // the user did not select (the git-cached vwin32fh) still loses it.
        {Published = True}
        Procedure ModAnalyzer_SelectedLibraryKeepsItsRecipe
            Handle ho
            String[] asRoots asNames asSelected
            tModAnalyzer Recipe rSel rUnsel

            Move "c:\ws\libraries\vwin32fh\" to asRoots[0]
            Move "vwin32fh"                   to asNames[0]
            Move "e:\webappsrc\"              to asRoots[1]
            Move "WebAppSrc"                  to asNames[1]
            Move "e:\webappsrc\appsrc\"       to asSelected[0]     // the user ticked this folder
            Get Create (RefClass(cModAnalyzer)) to ho
            Set pasLibRoots      of ho to asRoots
            Set pasLibNames      of ho to asNames
            Set pasSelectedRoots of ho to asSelected
            Set psLibRootsKey    of ho to "*seeded*"
            Get MakeRecipe 4539 "Conversion from Pointer to String is not allowed, use PointerToString function" to Recipe
            Get VerifyLibraryOwned of ho Recipe "E:\WebAppSrc\AppSrc\wslibrary.pkg" to rSel
            Get VerifyLibraryOwned of ho Recipe "C:\WS\Libraries\vWin32fh\vwin32fh.pkg" to rUnsel
            Send Destroy of ho
            Send AssertSAreEqual "UnicodePointerToString" rSel.sRefactorFn
            Send Assert (rSel.eCategory = eModAutoFix)
            Send AssertSAreEqual "" rUnsel.sRefactorFn
            Send Assert (rUnsel.eCategory = eModExplain)
        End_Procedure

        // ---- the 4546 call-site rename helpers (2026-08-16) ------------------------------------
        // The compiler does not name the message called function-style, so the board reads the line.
        {Published = True}
        Procedure ModAnalyzer_CallNameCandidates_ReadsTheCallOffTheLine
            Handle ho
            String[] asBuiltins asOut

            Move "Trim"   to asBuiltins[0]
            Move "String" to asBuiltins[1]
            Get Create (RefClass(cModAnalyzer)) to ho
            // the WinServ line: the SQL text's own "CONVERT(" / "GETDATE(" are inside a literal
            Get CallNameCandidates of ho '    Move (SQLExecute("SELECT CONVERT(NVARCHAR(23), GETDATE(), 126)")) to sDateTime' asBuiltins to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "SQLExecute" asOut[0]
            // a built-in wrapping it is not a candidate; a space before the paren still counts
            Get CallNameCandidates of ho "Move (Trim(MyWrapper (sQ))) to s" asBuiltins to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "MyWrapper" asOut[0]
            // reserved words and plain variables never qualify
            Get CallNameCandidates of ho "If (iCount > 0) Move iCount to iX" asBuiltins to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Destroy of ho
        End_Procedure

        {Published = True}
        Procedure ModAnalyzer_NearMissDeclaredIn_FindsTheWrapper
            Handle ho
            String[] asLines
            String sHit sMiss
            Move "Use sql.pkg"                                            to asLines[0]
            Move "Function SQLExecuteX Global String sSQL Returns String" to asLines[1]
            Move "    Function_Return sSQL"                               to asLines[2]
            Move "End_Function"                                           to asLines[3]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get NearMissDeclaredIn of ho (&asLines) "sqlexecute" to sHit      // any casing in
            Get NearMissDeclaredIn of ho (&asLines) "Nothing"    to sMiss
            Send Destroy of ho
            Send AssertSAreEqual "SQLExecuteX" sHit                           // spelled as declared
            Send AssertSAreEqual "" sMiss
        End_Procedure

        /* DeclaredParamCountIn - the fact that separates the two causes of a 4379 (Nils 2026-09-04,
           a view). The board told him DataFlex 26 owned the name fheadvalue; it is his
           own method, declared in the same object above the call, and what was actually wrong was
           the count. Anything the helper cannot be sure of comes back -1, because the row says
           NOTHING unless it knows: a Get rewrite does not fix a count (probe-compiled under DF26,
           "Get f 1 2 to n" against a one-parameter f compiles clean), so a wrong claim here would
           silence the error and drop an argument. */
        {Published = True}
        Procedure ModAnalyzer_DeclaredParamCountIn_CountsAndLocates
            Handle ho
            String[] asLines
            Integer iCount iLine

            Move "Object oPlan is a dbView"                                to asLines[0]
            Move "    Function fPOrder Number nono String sflag Returns String" to asLines[1]
            Move "    End_Function"                                        to asLines[2]
            Move "    Function fHeadValue Number nono Returns Number"     to asLines[3]
            Move "    End_Function"                                        to asLines[4]
            Move "    Function RowCount Returns Integer"                   to asLines[5]
            Move "    End_Function"                                        to asLines[6]
            Move "End_Object"                                              to asLines[7]

            Get Create (RefClass(cModAnalyzer)) to ho
            // The workspace's own line: one declared parameter, found on the line that declares it.
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "fheadvalue" (&iLine) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 4 iLine                                  // 1-based
            // The sibling it was written to match, declared with two.
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "fPOrder" (&iLine) to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 2 iLine
            // A parameterless function is 0, not "unknown" - the two must never be confused.
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "RowCount" (&iLine) to iCount
            Send AssertIAreEqual 0 iCount
            // Not declared here at all: no claim, and no line to point at.
            Move 7 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "Split" (&iLine) to iCount
            Send AssertIAreEqual -1 iCount
            Send AssertIAreEqual 0 iLine
            Send Destroy of ho
        End_Procedure

        // The cases where -1 is the ONLY honest answer: a Global function (there the expression
        // form's first argument IS a parameter, so the arithmetic differs), and two declarations
        // of one name that disagree. ByRef is a modifier, not a word of its own.
        {Published = True}
        Procedure ModAnalyzer_DeclaredParamCountIn_RefusesWhatItCannotKnow
            Handle ho
            String[] asGlobal asTwo asRef
            Integer iCount iLine

            Move "Function SQLExecute Global String sSQL Returns String" to asGlobal[0]
            Move "End_Function"                                          to asGlobal[1]

            Move "Function Split String sSep String sText Returns String[]" to asTwo[0]
            Move "End_Function"                                             to asTwo[1]
            Move "Function Split String sSep Returns String[]"              to asTwo[2]
            Move "End_Function"                                             to asTwo[3]

            Move "Function Fill String[] ByRef asRows Integer iMax Returns Integer" to asRef[0]
            Move "End_Function"                                                     to asRef[1]

            Get Create (RefClass(cModAnalyzer)) to ho
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asGlobal) "SQLExecute" (&iLine) to iCount
            Send AssertIAreEqual -1 iCount
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asTwo) "Split" (&iLine) to iCount
            Send AssertIAreEqual -1 iCount
            // The positive control for the pair walk: ByRef must not read as a parameter.
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asRef) "Fill" (&iLine) to iCount
            Send AssertIAreEqual 2 iCount
            Send Destroy of ho
        End_Procedure

        /* A COMMENTED-OUT DECLARATION IS NOT A DECLARATION. "//Function x" already fails the word
           test, but a DF23 block comment does not - and the count would then be stated at the user
           as fact. Both forms sit beside the live declaration here, with a DIFFERENT count, so a
           scanner that reads either one returns -1 (two declarations disagreeing) instead of 1 and
           this fails. The live declaration is the positive control. */
        {Published = True}
        Procedure ModAnalyzer_DeclaredParamCountIn_SkipsCommentedDeclarations
            Handle ho
            String[] asLines
            Integer iCount iLine

            // The block comment OPENS on its own line, so the declaration inside it starts a line
            // with the word Function - the only form that reaches the name test at all, and so the
            // only fixture that is a control rather than a coincidence.
            Move "//Function fHeadValue Number a String b Returns Number" to asLines[0]
            Move "/* an older version, kept for reference:"                to asLines[1]
            Move "Function fHeadValue Number a String b Returns Number"   to asLines[2]
            Move "    Function_Return 0"                                   to asLines[3]
            Move "End_Function"                                            to asLines[4]
            Move "*/"                                                      to asLines[5]
            Move "Function fHeadValue Number nono Returns Number"         to asLines[6]
            Move "    Function_Return 0"                                   to asLines[7]
            Move "End_Function"                                            to asLines[8]

            Get Create (RefClass(cModAnalyzer)) to ho
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "fheadvalue" (&iLine) to iCount
            Send Destroy of ho
            // Read the commented one too and the two counts disagree, which returns -1, not 1.
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 7 iLine                   // 1-based: the live declaration
        End_Procedure

        /* The two halves the board holds against each other, on the real shape: the declaration
           says one, the call passes two, and the difference is what makes the row state the count
           instead of offering the Get rewrite. The workspace's line is nested in an Entry_Item, which is
           also why the rewrite would have done nothing there even if it had been right. */
        {Published = True}
        Procedure ModAnalyzer_ObjExprCall_CountAgainstDeclaration
            Handle ho
            String[] asLines
            Integer iDeclared iPassed iLine

            Move "        Function fHeadValue Number nono Returns Number"          to asLines[0]
            Move "            Function_Return 0"                                    to asLines[1]
            Move "        End_Function"                                             to asLines[2]
            Move "            Entry_Item (fheadvalue(Self, plandetail.ref, plandetail.porder))" to asLines[3]

            Get Create (RefClass(cModAnalyzer)) to ho
            Move 0 to iLine
            Get DeclaredParamCountIn of ho (&asLines) "fheadvalue" (&iLine) to iDeclared
            Get ObjExprCallArgCount of ho asLines[3] "fheadvalue" to iPassed
            Send Destroy of ho
            Send AssertIAreEqual 1 iDeclared
            Send AssertIAreEqual 2 iPassed                    // after Self
            Send Assert (iDeclared <> iPassed) "the counts must disagree - this is the 4379"
        End_Procedure

        // ---- FunctionReturnsTextIn (2026-09-04, a workspace's same-named function) ----------------------------
        // The align offer retyped a text-returning fCount to Integer. These pin down what the
        // body reader must see - and, just as much, what it must NOT claim.

        // The workspace's body, verbatim: a String local assigned literals and returned.
        { Published = True }
        Procedure ModAnalyzer_FunctionReturnsTextIn_StringLocal
            String[] asLines
            String sEv
            Handle hoAn
            Move "        Function fCount String skod Returns String" to asLines[0]
            Move "            String sdescr"                         to asLines[1]
            Move '            If (skod < "1") ;'                      to asLines[2]
            Move '                Move "Fixed amount"       to sdescr'   to asLines[3]
            Move "            Function_Return sdescr"                 to asLines[4]
            Move "        End_Function"                               to asLines[5]
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Get FunctionReturnsTextIn of hoAn (&asLines) 1 to sEv
            Send Destroy of hoAn
            Send AssertSAreEqual "Function_Return sdescr, a String local" sEv
        End_Procedure

        // A quoted literal returned directly, with a trailing comment stripped off the evidence.
        { Published = True }
        Procedure ModAnalyzer_FunctionReturnsTextIn_QuotedLiteral
            String[] asLines
            String sEv
            Handle hoAn
            Move "Function Label Integer iKind Returns String"   to asLines[0]
            Move '    Function_Return "Manual amount" // note'   to asLines[1]
            Move "End_Function"                                  to asLines[2]
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Get FunctionReturnsTextIn of hoAn (&asLines) 1 to sEv
            Send Destroy of hoAn
            Send AssertSAreEqual 'Function_Return "Manual amount"' sEv
        End_Procedure

        // POSITIVE CONTROLS for the refusal: a numeric body, and a literal that merely spells a
        // number, are NOT text - retyping those to Integer is the align the flow already offers.
        { Published = True }
        Procedure ModAnalyzer_FunctionReturnsTextIn_NumericBody_Empty
            String[] asLines
            String sEv
            Handle hoAn
            Move "Function fCount Number nrecnum Returns Integer" to asLines[0]
            Move "    Integer iCount"                              to asLines[1]
            Move "    String sUnused"                              to asLines[2]
            Move "    Move (iCount + 1) to iCount"                 to asLines[3]
            Move "    Function_Return iCount"                      to asLines[4]
            Move "End_Function"                                    to asLines[5]
            Move "Function Twelve Returns String"                  to asLines[6]
            Move '    Function_Return "12"'                        to asLines[7]
            Move "End_Function"                                    to asLines[8]
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Get FunctionReturnsTextIn of hoAn (&asLines) 1 to sEv
            Send AssertSAreEqual "" sEv
            Get FunctionReturnsTextIn of hoAn (&asLines) 7 to sEv
            Send Destroy of hoAn
            Send AssertSAreEqual "" sEv
        End_Procedure

        // EITHER ENDER closes the body: a function closed with End_Procedure must not run on into
        // the next function and report ITS text as this one's.
        { Published = True }
        Procedure ModAnalyzer_FunctionReturnsTextIn_EitherEnderBounds
            String[] asLines
            String sEv
            Handle hoAn
            Move "Function Count Returns Integer"      to asLines[0]
            Move "    Function_Return 3"               to asLines[1]
            Move "End_Procedure"                       to asLines[2]
            Move "Function Label Returns String"       to asLines[3]
            Move '    Function_Return "text"'          to asLines[4]
            Move "End_Function"                        to asLines[5]
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Get FunctionReturnsTextIn of hoAn (&asLines) 1 to sEv
            Send AssertSAreEqual "" sEv
            Get FunctionReturnsTextIn of hoAn (&asLines) 4 to sEv
            Send Destroy of hoAn
            Send AssertSAreEqual 'Function_Return "text"' sEv
        End_Procedure

        // Not a Function line (a Property has no body), and a return hidden in comments - "" both.
        { Published = True }
        Procedure ModAnalyzer_FunctionReturnsTextIn_NotAFunctionOrCommented_Empty
            String[] asLines
            String sEv
            Handle hoAn
            Move '    Property String psTitle "x"'        to asLines[0]
            Move "Function Label Returns String"          to asLines[1]
            Move '    // Function_Return "old"'           to asLines[2]
            Move "    /*"                                  to asLines[3]
            Move '    Function_Return "older"'            to asLines[4]
            Move "    */"                                  to asLines[5]
            Move "    Function_Return 0"                  to asLines[6]
            Move "End_Function"                           to asLines[7]
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Get FunctionReturnsTextIn of hoAn (&asLines) 1 to sEv
            Send AssertSAreEqual "" sEv
            Get FunctionReturnsTextIn of hoAn (&asLines) 2 to sEv
            Send Destroy of hoAn
            Send AssertSAreEqual "" sEv
        End_Procedure

        // ---- FilesForFunctions (2026-08-16) ---------------------------------------------------------
        // The run opens only the files the TICKED functions have actionable rows in - not the union of
        // every row's file (Nils: "31 changed out of 784"). Explain rows, dismissed rows and files whose
        // only rows name unticked functions stay out; a ", "-joined Fn cell counts if ANY name is ticked;
        // a ticked flood's files come in, an unticked flood's do not.
        {Published = True}
        Procedure ModAnalyzer_FilesForFunctions_OnlyTheTickedFunctionsFiles
            Handle ho
            tSavedPlanRow[] aRows
            tSavedPlanFlood[] aFloods
            tModIgnore[] aIgnored
            String[] asFns asOut

            // a.vw: auto-fix ChangeGetAddress            -> in (ticked)
            Move eModAutoFix to aRows[0].eCategory
            Move "DS 9014" to aRows[0].sMsg
            Move "c:\ws\a.vw" to aRows[0].sFile
            Move "ChangeGetAddress" to aRows[0].sFn
            // b.vw: review ChangeSquareBracketsIndicators -> out (not ticked)
            Move eModSuggest to aRows[1].eCategory
            Move "W 4538" to aRows[1].sMsg
            Move "c:\ws\b.vw" to aRows[1].sFile
            Move "ChangeSquareBracketsIndicators" to aRows[1].sFn
            // c.vw: merged Fn cell, one of them ticked      -> in
            Move eModSuggest to aRows[2].eCategory
            Move "W 4533" to aRows[2].sMsg
            Move "c:\ws\c.vw" to aRows[2].sFile
            Move "RefactorDbGridTocDbCJGrid, ChangeGetAddress" to aRows[2].sFn
            // d.vw: ticked function but DISMISSED           -> out
            Move eModAutoFix to aRows[3].eCategory
            Move "DS 9014" to aRows[3].sMsg
            Move "c:\ws\d.vw" to aRows[3].sFile
            Move "ChangeGetAddress" to aRows[3].sFn
            Move "c:\ws\d.vw" to aIgnored[0].sFile
            Move "DS 9014"    to aIgnored[0].sMsg
            // e.vw: Explain, no function                    -> out
            Move eModExplain to aRows[4].eCategory
            Move "W 4536" to aRows[4].sMsg
            Move "c:\ws\e.vw" to aRows[4].sFile
            Move "" to aRows[4].sFn
            // floods: one ticked (files f1,f2), one not (g1)
            Move 9035 to aFloods[0].iDSNumber
            Move "ChangeGetAddress" to aFloods[0].sFn
            Move "c:\ws\f1.vw" to aFloods[0].sFirstFile
            Move "c:\ws\f1.vw" to aFloods[0].asFiles[0]
            Move "c:\ws\f2.vw" to aFloods[0].asFiles[1]
            Move 9036 to aFloods[1].iDSNumber
            Move "ChangeLegacyIndicators" to aFloods[1].sFn
            Move "c:\ws\g1.vw" to aFloods[1].sFirstFile
            Move "c:\ws\g1.vw" to aFloods[1].asFiles[0]
            Move "ChangeGetAddress" to asFns[0]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get FilesForFunctions of ho (&aRows) (&aFloods) aIgnored asFns to asOut
            Send Destroy of ho
            Send AssertIAreEqual 4 (SizeOfArray(asOut))
            Send Assert (SearchArray("c:\ws\a.vw",  asOut) <> -1)
            Send Assert (SearchArray("c:\ws\c.vw",  asOut) <> -1)
            Send Assert (SearchArray("c:\ws\f1.vw", asOut) <> -1)
            Send Assert (SearchArray("c:\ws\f2.vw", asOut) <> -1)
            Send Assert (SearchArray("c:\ws\b.vw",  asOut) = -1)
            Send Assert (SearchArray("c:\ws\d.vw",  asOut) = -1)
            Send Assert (SearchArray("c:\ws\e.vw",  asOut) = -1)
            Send Assert (SearchArray("c:\ws\g1.vw", asOut) = -1)
        End_Procedure

        // The 4544 name comes off the compiler's own phrase, never off a FILE PATH that happens to carry
        // "_get_" - the display text puts the path before the message (2026-08-16, WinServ:
        // "PBSILENT, customer_data.dg" was listed as two ambiguous names).
        {Published = True}
        Procedure ModAnalyzer_AmbiguousFnName_IgnoresGetInTheFilePath
            String s
            Get AmbigName "Error 4544:   E:\WinServ\AppSrc\Machines_get_data.dg   (ln 765) Ambiguous function in expression Function GET_PBSILENT with ambiguous return type used in expression" to s
            Send AssertSAreEqual "PBSILENT" s
        End_Procedure

        /* THE PLAN'S PROVENANCE STAMP (2026-08-17): "" for a file that is not there; a value for one
           that is; a DIFFERENT value once the file has been rewritten with other content (its size
           changes - the write time may or may not, inside one second). ReadSavedPlan compares this
           against tSavedPlan.sSourcePrnStamp so a recreated workspace at the same path cannot inherit
           the previous copy's Check. The read/write pair itself needs ghoApplication's Data folder and
           is not exercised here; the comparator's three answers are. */
        {Published = True}
        Procedure ModAnalyzer_SourcePrnStamp_AbsentBlank_PresentStamped_RewrittenDiffers
            Handle ho
            String sDir sFile s1 s2 sGone
            String[] asA asB
            Boolean bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDir
            Move (vFolderFormat(sDir) + "ZPrnStampProbe.prn") to sFile
            Get Create (RefClass(cModAnalyzer)) to ho
            If (vFilePathExists(sFile)) ;
                Move (rfDeleteFile(sFile)) to bOk
            Get SourcePrnStamp of ho sFile to sGone
            Send AssertSAreEqual "" sGone
            Move "one line" to asA[0]
            Get rfWriteEncodedFileFromStringArray (&asA) sFile C_NewLine False to bOk
            Send Assert bOk "could not write the probe file"
            Get SourcePrnStamp of ho sFile to s1
            Send Assert (s1 <> "") "a present file must yield a stamp"
            Send Assert (Pos("|", s1) > 0) ("stamp must carry time|size: " + s1)
            Move "one line" to asB[0]
            Move "and a second, so the size differs" to asB[1]
            Get rfWriteEncodedFileFromStringArray (&asB) sFile C_NewLine False to bOk
            Get SourcePrnStamp of ho sFile to s2
            Send Assert (s2 <> s1) ("a rewritten file must stamp differently: " + s1 + " vs " + s2)
            Move (rfDeleteFile(sFile)) to bOk
            Send Destroy of ho
        End_Procedure

        /* THE 4536 USE-SITE MATCHER (2026-08-29): the board re-points an install package's
           self-deprecation ("MapiDllCalls.pkg is obsolete", reported at the package's own line 1)
           at the workspace's own Use line - the one place the user can act. The matcher must find
           the real Use whatever its case or extension spelling, and never a commented-out ghost:
           a commented Use is exactly what the fix leaves behind, and pointing at it would
           resurrect finished work. */
        {Published = True}
        Procedure ModAnalyzer_UseLineForPackage_FindsRealUse_SkipsComments
            Handle ho
            String[] asLines asPlain
            Integer iLine

            Get Create (RefClass(cModAnalyzer)) to ho
            Move '// Use MapiDllCalls.pkg   (retired long ago)'     to asLines[0]
            Move '/*'                                               to asLines[1]
            Move 'Use MapiDllCalls.pkg inside a block comment'      to asLines[2]
            Move '*/'                                               to asLines[3]
            Move 'Use Windows.pkg'                                  to asLines[4]
            Move '    use MAPIDLLCALLS   // no extension, odd case' to asLines[5]
            Get UseLineForPackage of ho (&asLines) "MapiDllCalls.Pkg" to iLine
            Send AssertIAreEqual 6 iLine
            Get UseLineForPackage of ho (&asLines) "cJsonObject.pkg" to iLine
            Send AssertIAreEqual 0 iLine
            // The plain shape, extension and all - the overwhelmingly common spelling.
            Move 'Use Batchdd.pkg'      to asPlain[0]
            Move 'Use MapiDllCalls.pkg' to asPlain[1]
            Get UseLineForPackage of ho (&asPlain) "MapiDllCalls.pkg" to iLine
            Send AssertIAreEqual 2 iLine
            Send Destroy of ho
        End_Procedure

        /* Every real Use in a file head, in order, as the base names UseLineForPackage matches on
           (2026-09-02): the board's Use-site index asks this once per file instead of running
           UseLineForPackage once per 4536 package per file. Same comment rules, Trim takes a tab
           indent off too (so a tab-indented block comment hides its Use), "Used_..." is not a Use, and a bare
           "Use" names nothing. The second half
           is the agreement: for every FIRST Use it lists, UseLineForPackage answers the same line -
           the index only ever keeps the first, and that is what the per-package sweep returned. */
        {Published = True}
        Procedure ModAnalyzer_UseLinesInHead_ListsRealUsesInOrder_AgreesWithUseLineForPackage
            Handle ho
            String[] asLines asLeafs
            Integer[] aiLines
            Integer i iLine

            Get Create (RefClass(cModAnalyzer)) to ho
            Move '// Use MapiDllCalls.pkg   (retired long ago)'          to asLines[0]
            Move '/*'                                                    to asLines[1]
            Move 'Use MapiDllCalls.pkg inside a block comment'           to asLines[2]
            Move '*/'                                                    to asLines[3]
            Move 'Use Windows.pkg'                                       to asLines[4]
            Move '    use MAPIDLLCALLS   // no extension, odd case'      to asLines[5]
            Move 'Use RefactorConstants.h.pkg'                           to asLines[6]
            Move 'Used_Before Yes'                                       to asLines[7]
            Move 'Use'                                                   to asLines[8]
            Move (Character(9) + 'Use' + Character(9) + 'Batchdd.pkg')  to asLines[9]
            Move 'Use Windows.pkg'                                       to asLines[10]
            Move (Character(9) + '/*')                                  to asLines[11]
            Move (Character(9) + 'Use Ghost.pkg   // tab-indented block') to asLines[12]
            Move (Character(9) + '*/')                                  to asLines[13]
            Move 'Use Last.pkg'                                          to asLines[14]
            Send UseLinesInHead of ho (&asLines) (&asLeafs) (&aiLines)
            Send AssertIAreEqual 6 (SizeOfArray(asLeafs))
            Send AssertIAreEqual 6 (SizeOfArray(aiLines))
            Send AssertSAreEqual "windows"             asLeafs[0]
            Send AssertSAreEqual "mapidllcalls"        asLeafs[1]
            Send AssertSAreEqual "refactorconstants.h" asLeafs[2]
            Send AssertSAreEqual "batchdd"             asLeafs[3]
            Send AssertSAreEqual "windows"             asLeafs[4]
            Send AssertIAreEqual 5  aiLines[0]
            Send AssertIAreEqual 6  aiLines[1]
            Send AssertIAreEqual 7  aiLines[2]
            Send AssertIAreEqual 10 aiLines[3]
            Send AssertIAreEqual 11 aiLines[4]
            Send AssertSAreEqual "last" asLeafs[5]
            Send AssertIAreEqual 15 aiLines[5]
            // Entries 0..3 are each the FIRST Use of their name; entry 4 repeats Windows.pkg, and
            // UseLineForPackage must answer entry 0's line for it, not entry 4's.
            For i from 0 to 3
                Get UseLineForPackage of ho (&asLines) (asLeafs[i] + ".pkg") to iLine
                Send AssertIAreEqual aiLines[i] iLine
            Loop
            Get UseLineForPackage of ho (&asLines) (asLeafs[4] + ".pkg") to iLine
            Send AssertIAreEqual aiLines[0] iLine
            Get UseLineForPackage of ho (&asLines) (asLeafs[5] + ".pkg") to iLine
            Send AssertIAreEqual aiLines[5] iLine
            // The tab-indented block comment hides its Use from both readers.
            Get UseLineForPackage of ho (&asLines) "Ghost.pkg" to iLine
            Send AssertIAreEqual 0 iLine
            // A second file through the same arrays starts clean.
            Move (ResizeArray(asLines, 0)) to asLines
            Move 'Object oMain is a Panel' to asLines[0]
            Send UseLinesInHead of ho (&asLines) (&asLeafs) (&aiLines)
            Send AssertIAreEqual 0 (SizeOfArray(asLeafs))
            Send AssertIAreEqual 0 (SizeOfArray(aiLines))
            Send Destroy of ho
        End_Procedure

        /* The pool-package DISPLAY name (2026-08-29): the read-only packages band aggregates its
           findings per package, so the two df-cli pool folder shapes must reduce to the name the
           user recognises - and a dash that is part of the name must survive the commit-tail
           strip ("Library-VDFQuery20" keeps its dash; "-5b1a694" goes). */
        {Published = True}
        Procedure ModAnalyzer_PoolPackageDisplayName_Shapes
            Handle ho
            String s

            Get Create (RefClass(cModAnalyzer)) to ho
            Get PoolPackageDisplayName of ho "E:\ws\DfPkg\NilsSve_Library-VDFQuery20-5b1a694\AppSrc\VdfQuery.pkg" to s
            Send AssertSAreEqual "Library-VDFQuery20" s
            Get PoolPackageDisplayName of ho "C:\ProgramData\DataFlex\Packages\Cache\DataAccess_Reporting-1.2.0\AppSrc\r.pkg" to s
            Send AssertSAreEqual "Reporting" s
            // A dashed tail that is neither a commit hash nor a version IS the name - kept.
            Get PoolPackageDisplayName of ho "E:\ws\DfPkg\Owner_My-Tools\AppSrc\a.pkg" to s
            Send AssertSAreEqual "My-Tools" s
            // Not a pool path at all.
            Get PoolPackageDisplayName of ho "E:\ws\AppSrc\a.pkg" to s
            Send AssertSAreEqual "" s
            Send Destroy of ho
        End_Procedure

        /* The include pin's reason now says WHY the include cannot convert with the run (2026-09-14), so
           the hint can say what would let it - one sentence per kind, and the no-context form keeps the
           old advice. And a row whose name an include reads that DOES convert with the run stays as the
           recipe says, with that include named on it. */
        {Published = True}
        Procedure ModAnalyzer_IncludePinHintSaysWhyItCannotLift
            Handle ho
            String[] asPinned asReasons asEmpty
            tModAnalyzer Recipe rOut

            Move "A_FLAG" to asPinned[0]
            Move "B_FLAG" to asPinned[1]
            Move "C_FLAG" to asPinned[2]
            Move "D_FLAG" to asPinned[3]
            Move "E_FLAG" to asPinned[4]
            Move "F_FLAG" to asPinned[5]
            Move "USE|shared.mac|MACRO"                  to asReasons[0]
            Move "USE|shared.mac|USER|other.src"         to asReasons[1]
            Move "USE|shared.mac|HOLDS|other.src|C_FLAG" to asReasons[2]
            Move "USE|shared.mac|VIA|second.mac"         to asReasons[3]
            Move "USE|shared.mac"                        to asReasons[4]
            Move "USE|shared.mac|EXPR|F_FLAG"            to asReasons[5]
            Set pasPinnedIndicators of ghoFuncLib to asPinned
            Set pasPinnedReasons    of ghoFuncLib to asReasons
            Get Create (RefClass(cModAnalyzer)) to ho
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicate a_flag True" to rOut
            Send Assert (rOut.eCategory = eModExplain)
            Send Assert (Pos("shared.mac", rOut.sHint) > 0)
            Send Assert (Pos("macro code", rOut.sHint) > 0)
            Send Assert (Pos("same run", rOut.sHint) = 0)
            Get VerifyAutoFix of ho Recipe "Indicate b_flag True" to rOut
            Send Assert (Pos("other.src", rOut.sHint) > 0)
            Send Assert (Pos("not in this run", rOut.sHint) > 0)
            Get VerifyAutoFix of ho Recipe "Indicate c_flag True" to rOut
            Send Assert (Pos("other.src", rOut.sHint) > 0)
            Send Assert (Pos("keeps C_FLAG legacy", rOut.sHint) > 0)
            Get VerifyAutoFix of ho Recipe "Indicate d_flag True" to rOut
            Send Assert (Pos("second.mac", rOut.sHint) > 0)
            Send Assert (Pos("go together", rOut.sHint) > 0)
            // no run context: the old advice, unchanged
            Get VerifyAutoFix of ho Recipe "Indicate e_flag True" to rOut
            Send Assert (Pos("same run", rOut.sHint) > 0)
            Get VerifyAutoFix of ho Recipe "Indicate f_flag True" to rOut
            Send Assert (Pos("reads F_FLAG as a plain Boolean expression", rOut.sHint) > 0)
            Send Destroy of ho
            Set pasPinnedIndicators of ghoFuncLib to asEmpty
            Set pasPinnedReasons    of ghoFuncLib to asEmpty
        End_Procedure

        {Published = True}
        Procedure ModAnalyzer_LiftedIncludeHintSaysItConvertsWithTheRun
            Handle ho
            String[] asNames asLeafs asEmpty
            tModAnalyzer Recipe rDecl rUse rOther

            Move "OPEN_FLAG"  to asNames[0]
            Move "shared.mac" to asLeafs[0]
            Set pasLiftedNames    of ghoFuncLib to asNames
            Set pasLiftedNameIncs of ghoFuncLib to asLeafs
            Get Create (RefClass(cModAnalyzer)) to ho
            // the declaration converts, and the row says where the include's read goes
            Get MakeRecipe 4538 "Obsolete command: Indicator. Use Boolean" to Recipe
            Get VerifyAutoFix of ho Recipe "Indicator open_flag" to rDecl
            Send Assert (rDecl.sRefactorFn = "ChangeIndicatorToBoolean")
            Send Assert (Pos("shared.mac", rDecl.sHint) > 0)
            Send Assert (Pos("converts with the run", rDecl.sHint) > 0)
            // a use of the name too
            Get MakeRecipe 4538 "indicators in If statements" to Recipe
            Get VerifyAutoFix of ho Recipe "If [open_flag] Begin" to rUse
            Send Assert (Pos("shared.mac", rUse.sHint) > 0)
            // another name: untouched
            Get VerifyAutoFix of ho Recipe "If [ready_flag] Begin" to rOther
            Send Assert (Pos("shared.mac", rOther.sHint) = 0)
            Send Destroy of ho
            Set pasLiftedNames    of ghoFuncLib to asEmpty
            Set pasLiftedNameIncs of ghoFuncLib to asEmpty
        End_Procedure

        /* RECIPE MATCH TEXTS (Nils 2026-09-14). '4328 | DATETIME' fired on "Undefined symbol in argument
           DWHIGHDATETIME" - a bare Type member on an 'Add 10 to ...' line - because a match text is a
           substring; the row promised the cast rewrite and the run found nothing. A plain text STAYS a
           substring (the stem families depend on it: DFWRITE covers DFWRITELN, XTPREPORT sits inside
           MSG_XTPREPORT...); a text written 'symbol: X' hits X only as a whole symbol, bounded by
           non-symbol characters ('$', '@' and '#' count as symbol characters, so a fragment after a
           '$' is not a word either). */
        {Published = True}
        Procedure ModAnalyzer_MatchText_SymbolFormHitsWholeSymbolsOnly
            Handle ho
            Boolean b

            Get Create (RefClass(cModAnalyzer)) to ho
            // the symbol form
            Get MatchTextHits of ho "undefined symbol in argument dwhighdatetime" "symbol: datetime" to b
            Send AssertFalse b
            Get MatchTextHits of ho "undefined symbol in argument datetime" "symbol: datetime" to b
            Send Assert b
            Get MatchTextHits of ho "type check error u_dbgrid, must be defined" "symbol: u_dbgrid" to b
            Send Assert b
            Get MatchTextHits of ho "undefined symbol in argument is$done" "symbol: done" to b
            Send AssertFalse b
            Get MatchTextHits of ho "undefined symbol in argument ubigint" "symbol: bigint" to b
            Send AssertFalse b
            // the plain form is a substring, stems included
            Get MatchTextHits of ho "undefined symbol in argument dwhighdatetime" "datetime" to b
            Send Assert b
            Get MatchTextHits of ho "command not found dfwriteln" "dfwrite" to b
            Send Assert b
            Get MatchTextHits of ho "forward reference not resolved  msg_xtpreportthemevisualstudio2012light" "xtpreport" to b
            Send Assert b
            Get MatchTextHits of ho "invalid syntax (operator) @ here" "(operator) @" to b
            Send Assert b
            Get MatchTextHits of ho "use of toansi in a pointer context" "use of toansi" to b
            Send Assert b
            Send Destroy of ho
        End_Procedure

        // ...so the substring row falls to the generic 4328 Explain, and the real cast still routes.
        {Published = True}
        Procedure ModAnalyzer_4328_SubstringSymbolIsNotACast
            tModAnalyzer rMember rCast

            Get MakeRecipe 4328 "Undefined symbol in argument DWHIGHDATETIME" to rMember
            Send Assert (rMember.sRefactorFn = "")
            Send Assert (rMember.eCategory = eModExplain)
            Send Assert (Pos("Type member", rMember.sHint) > 0)
            Get MakeRecipe 4328 "Undefined symbol in argument DATETIME" to rCast
            Send Assert (rCast.sRefactorFn = "ChangeLegacyTypeCast")
        End_Procedure

        // Guard F: a cast row keeps its fix only when the type's SOURCE name is CALLED on the line.
        {Published = True}
        Procedure ModAnalyzer_LegacyTypeCast_SourceGuarded
            Handle ho
            tModAnalyzer Recipe rOut

            Get Create (RefClass(cModAnalyzer)) to ho
            Get MakeRecipe 4328 "Undefined symbol in argument DATETIME" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeLegacyTypeCast")
            // a bare name like the type, no call: a plain undefined symbol, with the generic wording
            Get VerifyAutoFix of ho Recipe "Add 10 to DateTime" to rOut
            Send Assert (rOut.eCategory = eModExplain)
            Send Assert (rOut.sRefactorFn = "")
            Send Assert (Pos("Type member", rOut.sHint) > 0)
            // the cast itself stays, with or without a space before the parenthesis
            Get VerifyAutoFix of ho Recipe "Move (DateTime(sStamp)) to dtWhen" to rOut
            Send Assert (rOut.sRefactorFn = "ChangeLegacyTypeCast")
            Get VerifyAutoFix of ho Recipe "Move (DateTime (sStamp)) to dtWhen" to rOut
            Send Assert (rOut.sRefactorFn = "ChangeLegacyTypeCast")
            // LONGPTR is what the compiler says for Handle( - the SOURCE name is what must be on the line
            Get MakeRecipe 4328 "Undefined symbol in argument LONGPTR" to Recipe
            Send Assert (Recipe.sRefactorFn = "ChangeLegacyTypeCast")
            Get VerifyAutoFix of ho Recipe "Send exportGrid (Handle(Self))" to rOut
            Send Assert (rOut.sRefactorFn = "ChangeLegacyTypeCast")
            Get VerifyAutoFix of ho Recipe "Move hoLongPtr to hoX" to rOut
            Send Assert (rOut.sRefactorFn = "")
            Send Destroy of ho
        End_Procedure

        /* THE DEEP SCAN ROWS ARE DERIVED, NEVER STORED (v152, Nils 2026-09-15: 'left without a
           refactoring suggestion'). The rules catalog said Auto-fix / ChangeGetDateFormatToAttribute
           for DS 9086 and the scan cache agreed, but the recipes JSON - hand-stamped to the current
           version - still carried the rule's OLD row (Review / LegacyDbApiReport), and that row won.
           Two guards: the writer's set never contains a DS row, and the refresh replaces whatever DS
           rows the winning set carries with the live catalog's. Both are pure array functions here -
           no table, no file. */
        { Published = True }
        Procedure ModAnalyzer_DeepScanRowsLeaveThePersistedSet
            Handle ho
            tModAnalyzer[] aIn aOut
            Get Create (RefClass(cModAnalyzer)) to ho
            Get AddRecipe of ho aIn 4533 True "command: Get_Date_Format" "ChangeGetDateFormatToAttribute" eModAutoFix "compiler row" to aIn
            Get AddRecipe of ho aIn 9086 True "" "LegacyDbApiReport" eModSuggest "a frozen DS row" to aIn
            Get AddRecipe of ho aIn 4306 False "XTPREPORT" "" eModExplain "install row" to aIn
            Get _WithoutDeepScanRecipes of ho aIn to aOut
            Send Destroy of ho
            Send AssertIAreEqual 2 (SizeOfArray(aOut))
            Send AssertIAreEqual 4533 aOut[0].iMsgNumber
            Send AssertIAreEqual 4306 aOut[1].iMsgNumber
        End_Procedure

        { Published = True }
        Procedure ModAnalyzer_StaleDeepScanRowIsReplacedByTheLiveRule
            Handle ho
            tModAnalyzer[] aIn aOut
            tModAnalyzer Recipe
            Integer i iLast iFrozen iLive
            Get Create (RefClass(cModAnalyzer)) to ho
            Get AddRecipe of ho aIn 4533 True "command: Get_Date_Format" "ChangeGetDateFormatToAttribute" eModAutoFix "compiler row" to aIn
            Get AddRecipe of ho aIn 9086 True "" "LegacyDbApiReport" eModSuggest "Use Get_Attribute DF_DATE_FORMAT." to aIn
            Get _WithLiveDeepScanRecipes of ho aIn to aOut
            // The frozen row is gone, the live rule's row is there exactly once, the compiler row stays first.
            Move 0 to iFrozen
            Move 0 to iLive
            Move (SizeOfArray(aOut) - 1) to iLast
            For i from 0 to iLast
                If (aOut[i].iMsgNumber = 9086) Begin
                    If (aOut[i].sRefactorFn = "LegacyDbApiReport") ;
                        Increment iFrozen
                    If (aOut[i].sRefactorFn = "ChangeGetDateFormatToAttribute" and aOut[i].eCategory = eModAutoFix) ;
                        Increment iLive
                End
            Loop
            Send AssertIAreEqual 0 iFrozen
            Send AssertIAreEqual 1 iLive
            Send AssertIAreEqual 4533 aOut[0].iMsgNumber
            // And the classifier now answers from the live row.
            Get ClassifyFromRecipes of ho 9086 "DS 9086" aOut to Recipe
            Send Destroy of ho
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeGetDateFormatToAttribute" Recipe.sRefactorFn
        End_Procedure

        /* THE SUBCLASS-KEPT PACKAGE (2026-10-04): the board moves a W 4536 row to the hand band when its
           Use line sits in a file whose own class is built on a class the obsolete package declares
           ("Use Dftable.pkg" in MyDbGrid.pkg, for "Class MyDbGrid is a dbGrid"). First the line reader:
           name and super from a declaration in any spelling, nothing from anything else. One assertion
           over every case, so a failure prints them all. */
        {Published = True}
        Procedure ModAnalyzer_ClassAndSuperOnLine_ReadsNameAndSuper
            Handle ho
            String[] asIn
            String sGot sName sSuper
            Integer i

            Get Create (RefClass(cModAnalyzer)) to ho
            Move "Class MyDbGrid is a dbGrid"                                      to asIn[-1]
            Move (Character(9) + "Class  PrintDialog Is A cObject  // the dialog") to asIn[-1]
            Move "class X is an Y;"                                                to asIn[-1]
            Move "Class Z is a dbList// glued comment"                             to asIn[-1]
            Move "Object oGrid is a dbGrid"                                        to asIn[-1]
            Move "Class"                                                           to asIn[-1]
            Move "Class Q is dbGrid"                                               to asIn[-1]
            Move "Class R is a //"                                                 to asIn[-1]
            Move "" to sGot
            For i from 0 to (SizeOfArray(asIn) - 1)
                Get ClassAndSuperOnLine of ho asIn[i] (&sSuper) to sName
                Move (sGot + sName + ":" + sSuper + ";") to sGot
            Loop
            Send Destroy of ho
            Send AssertSAreEqual "MyDbGrid:dbGrid;PrintDialog:cObject;X:Y;Z:dbList;:;:;:;:;" sGot
        End_Procedure

        /* ...then the file pair: the Use-site file declares a class on one the package declares. A class
           left in a block comment or after // does not count (the ghost comes FIRST, so a reader that
           kept it would answer Ghost), a class built on something else does not count, and a package
           that is not there answers False. */
        {Published = True}
        Procedure ModAnalyzer_PackageKeptBySubclass_FindsTheSubclass_SkipsComments
            Handle ho
            String sDir sPkg sUse sOther sGone sGot sClass sSuper
            String[] asPkg asUse asOther
            Integer iLine
            Boolean bOk bKept

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDir
            Move (vFolderFormat(sDir) + "ZKeptPkgProbe.pkg")   to sPkg
            Move (vFolderFormat(sDir) + "ZKeptUseProbe.pkg")   to sUse
            Move (vFolderFormat(sDir) + "ZKeptOtherProbe.pkg") to sOther
            Move (vFolderFormat(sDir) + "ZKeptGoneProbe.pkg")  to sGone
            Move "// The obsolete package"     to asPkg[-1]
            Move "Class dbGrid_ is a DataList" to asPkg[-1]
            Move "End_Class"                   to asPkg[-1]
            Move "Class dbGrid is a dbGrid_"   to asPkg[-1]
            Move "End_Class"                   to asPkg[-1]
            Move "Use ZKeptPkgProbe.pkg"       to asUse[-1]
            Move "/*"                          to asUse[-1]
            Move "Class Ghost is a dbGrid"     to asUse[-1]
            Move "*/"                          to asUse[-1]
            Move "// Class Ghost2 is a dbGrid" to asUse[-1]
            Move "Class MyDbGrid is a dbGrid"  to asUse[-1]
            Move "End_Class"                   to asUse[-1]
            Move "Use ZKeptPkgProbe.pkg"       to asOther[-1]
            Move "Class MyThing is a cObject"  to asOther[-1]
            Move "End_Class"                   to asOther[-1]
            Get rfWriteEncodedFileFromStringArray (&asPkg) sPkg C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asUse) sUse C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asOther) sOther C_NewLine False to bOk
            If (vFilePathExists(sGone)) ;
                Move (rfDeleteFile(sGone)) to bOk

            Get Create (RefClass(cModAnalyzer)) to ho
            Get PackageKeptBySubclass of ho sPkg sUse (&sClass) (&sSuper) (&iLine) to bKept
            Move ((If(bKept, "T", "F")) + ":" + sClass + ":" + sSuper + ":" + String(iLine)) to sGot
            Get PackageKeptBySubclass of ho sPkg sOther (&sClass) (&sSuper) (&iLine) to bKept
            Move (sGot + "|" + (If(bKept, "T", "F")) + ":" + sClass + ":" + sSuper + ":" + String(iLine)) to sGot
            Get PackageKeptBySubclass of ho sGone sUse (&sClass) (&sSuper) (&iLine) to bKept
            Move (sGot + "|" + (If(bKept, "T", "F")) + ":" + sClass + ":" + sSuper + ":" + String(iLine)) to sGot
            Send Destroy of ho
            Move (rfDeleteFile(sPkg))   to bOk
            Move (rfDeleteFile(sUse))   to bOk
            Move (rfDeleteFile(sOther)) to bOk
            Send AssertSAreEqual "T:MyDbGrid:dbGrid:6|F:::0|F:::0" sGot
        End_Procedure

        /* ...and the fold (2026-10-04): a row ON the subclass's class line - the Deep Scan's subclass row -
           means the board lists the subclass already, and the package row folds into it. The file compares
           case-folded; another line, another file or line 0 is no row. One assertion over every case. */
        {Published = True}
        Procedure ModAnalyzer_SavedPlanHasRowAt_FileAndLine
            Handle ho
            tSavedPlanRow[] aRows
            String sGot
            Boolean b

            Move "E:\Ws\AppSrc\MyGrid.pkg" to aRows[0].sFile
            Move 10                          to aRows[0].iLine
            Move "DS 9198"                   to aRows[0].sMsg
            Move "E:\Ws\AppSrc\Other.pkg"  to aRows[1].sFile
            Move 6                           to aRows[1].iLine
            Get Create (RefClass(cModAnalyzer)) to ho
            Get SavedPlanHasRowAt of ho (&aRows) "e:\ws\appsrc\MYGRID.PKG" 10 to b
            Move (If(b, "T", "F")) to sGot
            Get SavedPlanHasRowAt of ho (&aRows) "E:\Ws\AppSrc\MyGrid.pkg" 6 to b
            Move (sGot + If(b, "T", "F")) to sGot
            Get SavedPlanHasRowAt of ho (&aRows) "E:\Ws\AppSrc\Other.pkg" 6 to b
            Move (sGot + If(b, "T", "F")) to sGot
            Get SavedPlanHasRowAt of ho (&aRows) "E:\Ws\AppSrc\MyGrid.pkg" 0 to b
            Move (sGot + If(b, "T", "F")) to sGot
            Send Destroy of ho
            Send AssertSAreEqual "TFTF" sGot
        End_Procedure

        // ...and the hint, word for word for the grid family Nils met it on (2026-10-04).
        {Published = True}
        Procedure ModAnalyzer_SubclassKeptPackageHint_DbGridNamesTheConverter
            Handle ho
            String s

            Get Create (RefClass(cModAnalyzer)) to ho
            Get SubclassKeptPackageHint of ho "Dftable.pkg" "MyDbGrid.pkg" "MyDbGrid" "dbGrid" to s
            Send Destroy of ho
            Send AssertSAreEqual "MyDbGrid.pkg needs Dftable.pkg because MyDbGrid is a dbGrid. The Use goes when MyDbGrid is ported to cDbCJGrid. ConvertGridSubclassToCodeJock does that with the parameter 'MyDbGrid': it converts the class and every object of it, or says in its run notes why it cannot." s
        End_Procedure

        // The other two grid families name the converter with their own target; a List subclass and any
        // other class are ported by hand, and their hint never names the converter.
        {Published = True}
        Procedure ModAnalyzer_SubclassKeptPackageHint_EachFamilyItsWayOn
            Handle ho
            String s sGot

            Get Create (RefClass(cModAnalyzer)) to ho
            Get SubclassKeptPackageHint of ho "Dfsellst.pkg" "MyDbList.pkg" "MyDbList" "dbList" to s
            Move ("dbList:" + (If((Pos("ported to cDbCJGridPromptList.", s) > 0 and Pos("ConvertGridSubclassToCodeJock", s) > 0), "converter", s)) + ";") to sGot
            Get SubclassKeptPackageHint of ho "SomeGrid.pkg" "MyGrid.pkg" "MyGrid" "Grid" to s
            Move (sGot + "Grid:" + (If((Pos("ported to cCJGrid.", s) > 0 and Pos("ConvertGridSubclassToCodeJock", s) > 0), "converter", s)) + ";") to sGot
            Get SubclassKeptPackageHint of ho "SomeList.pkg" "MyList.pkg" "MyList" "List" to s
            Move (sGot + "List:" + (If((Pos("No converter ports a List subclass yet.", s) > 0 and Pos("ConvertGridSubclassToCodeJock", s) = 0), "byhand", s)) + ";") to sGot
            Get SubclassKeptPackageHint of ho "Prnt_dlg.pkg" "MyPrintDialog.pkg" "MyPrintDialog" "PrintDialog" to s
            Move (sGot + "PrintDialog:" + (If((Pos("ported by hand to a class that is not obsolete.", s) > 0 and Pos("ConvertGridSubclassToCodeJock", s) = 0), "byhand", s)) + ";") to sGot
            Send Destroy of ho
            Send AssertSAreEqual "dbList:converter;Grid:converter;List:byhand;PrintDialog:byhand;" sGot
        End_Procedure

    End_Object
