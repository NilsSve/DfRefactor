Use cFTModalPanel.pkg
Use cFTCJSelectionGrid.pkg
Use RefactorConstants.h.pkg      // the CS_Glyph* / CS_Ico* icon names
Use cRDCGridToolTip.pkg          // cRDCToolTipColumn - the hint column, whose tooltip wraps (RDCToolsLib)
Use cDeepScanner.pkg
Use cFTGridHost.pkg              // FT: the button bars - hosts on a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg   // FT: cFTWebButton - the bars' buttons
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

// Per-rule enable UI for the Analyze Source catalog (Nils 2026-07-11). ELEVEN rules ship
// DISABLED - too noisy to scan by default. All eleven share one shape: a bare eDSAnywhere
// token match with eModExplain and NO converter, i.e. the noisiest thing the scanner can do.
// They split two ways, and the help topic "Analyze Source" states the same split - keep them
// in step: (a) the EIGHT ordinary-English-word symbols (Required / Retain / Status / Group /
// Fill / Points / Suppress / Thousands), which would match far too much perfectly good code;
// (b) FindErr / LastErr / Windowindex, legitimate in code not yet migrated - reporting every
// occurrence buries the findings that matter (FindErr was retired 2026-07-29 after 425 hits on
// WinServ, all carrying the identical advice). The seed in cDeepScanner.BuildDefaultDeepScanRules
// is the ONLY truth for this count - re-derive it there before quoting a number here again. This dialog is where the user
// turns them on (or a normally-scanned rule off) per DFRefactor install; the toggles persist in
// DFRefactor's own Data\DeepScanRules.json (cDeepScanner.LoadDeepScanRules / WriteDeepScanRules),
// which every scan + recipe consumer loads through. FT anatomy: dark panel, two bars of framework
// buttons on the library's grid host (select strip top-right, Help/Save/Cancel bottom-right).
Object oDeepScanRules_dg is a cFTModalPanel
    Set Label to "Analyze Source - Rule Selection"
    Set Size to 242 658
    Set Location to 2 2
    Set piMinSize to 210 600
    Set Icon to "DeepScanGear1.ico"

    // The rules captured in the Save button's OnClick (inside the web click, a grid-safe context), so
    // DoSave - run after the click - never re-queries the grid: a by-handle grid query from a timer
    // faults err 98 (the wall BackupFilesFT/oRefactorPlanDialogFT document).
    Property tDeepScanRule[] paCapturedRules

    Object oHint_tb is a TextBox
        Set Size to 10 85
        Set Location to 17 25
        Set Label to "Right click grid for options"
    End_Object

    Object oRules_grd is a cFTCJSelectionGrid
        // The band sits 10 below the panel top and ends at 30; the grid starts 10 below THAT, so the
        // space above the select bar and the space under it are the same (Nils 2026-08-25 - the
        // first attempt, a 5-unit gap, was too small). The panel grew by 10 to pay for it, so the
        // grid keeps its full 168 and no rows were traded away for the whitespace.
        Set Size to 168 630
        Set Location to 40 14
        Set psNoItemsText to "No analyze rules loaded..."
        Set pbShowFooter to True

        Object oCJGridColumnRowIndicator is a cCJGridColumnRowIndicator
            Set piWidth to 25
            Set pbResizable to False
        End_Object

        Object oSymbol_col is a cCJGridColumn
            Set phoData_Col to Self
            Set piWidth to 230
            Set psCaption to "Obsolete symbol"
            Set psToolTip to "The legacy command / function / symbol the rule matches"
            Set pbEditable to False
        End_Object

        Object oCategory_col is a cCJGridColumn
            Set piWidth to 90
            Set psCaption to "Action"
            Set psToolTip to "Auto-fix = a converter runs it; Review = a converter/report addresses it; Explain = manual"
            Set pbEditable to False
        End_Object

        // cRefactorToolTipColumn: the hint is a sentence, so its tooltip is wrapped.
        Object oHint_col is a cRDCToolTipColumn
            Set piWidth to 360
            Set psCaption to "Modern replacement"
            Set psToolTip to "What to use instead"
            Set pbEditable to False

        End_Object

        // The rule's stable DS number, parked in a hidden column so CaptureRuleToggles can pair
        // each grid row back to its rule by identity (the seed order is display-sorted-proof).
        Object oDSNumber_col is a cCJGridColumn
            Set piWidth to 0
            Set pbVisible to False
            Set pbEditable to False
        End_Object

        // Custom comparison function for the display sort below: alphabetical by the Obsolete
        // symbol, case-insensitive. Returns (GT)/(LT)/(EQ) like the other SortArray comparators.
        Function CompareRuleSymbols tDeepScanRule Rule1 tDeepScanRule Rule2 Returns Integer
            Move (Lowercase(Rule1.sSymbol)) to Rule1.sSymbol
            Move (Lowercase(Rule2.sSymbol)) to Rule2.sSymbol
            If (Rule1.sSymbol > Rule2.sSymbol) ;
                Function_Return (GT)
            If (Rule1.sSymbol < Rule2.sSymbol) ;
                Function_Return (LT)
            Function_Return (EQ)
        End_Function

        // Fill the grid rows from a rule array (shared by LoadData and LoadDefaults).
        Procedure FillFromRules tDeepScanRule[] aRules
            Handle hoDataSource
            tDataSourceRow[] TheData TheDataEmpty
            Integer iSize iRow iSymCol iCatCol iHintCol iNumCol iChkCol

            Move (SizeOfArray(aRules)) to iSize
            If (iSize = 0) ;
                Procedure_Return
            // Display-only sort: alphabetical by Obsolete symbol (case-insensitive), ascending -
            // so each class/subclass pair (dfTimer, dbGrid, Grid, dbList, List) sits adjacent.
            // Identity stays keyed on iDSNumber (the hidden col) in CaptureRuleToggles, so this
            // reorders the VIEW only: the append-only seed order, the DeepScanRules.json toggles
            // and the ignore-list keys are all untouched.
            Move (SortArray(aRules, Self, (RefFunc(CompareRuleSymbols)))) to aRules
            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move TheDataEmpty to TheData
            Get piColumnId of (phoData_Col(Self))     to iSymCol
            Get piColumnId of oCategory_col           to iCatCol
            Get piColumnId of oHint_col               to iHintCol
            Get piColumnId of oDSNumber_col           to iNumCol
            Get piColumnId of (phoCheckbox_Col(Self)) to iChkCol
            Decrement iSize
            Move 0 to iRow
            For iRow from 0 to iSize
                Move aRules[iRow].sSymbol                     to TheData[iRow].sValue[iSymCol]
                Move (DSCategoryText(Self, aRules[iRow].eCategory)) to TheData[iRow].sValue[iCatCol]
                Move aRules[iRow].sHint                       to TheData[iRow].sValue[iHintCol]
                Move (String(aRules[iRow].iDSNumber))         to TheData[iRow].sValue[iNumCol]
                Move aRules[iRow].bEnabled                    to TheData[iRow].sValue[iChkCol]
            Loop
            Send ReInitializeData TheData False
            Send MoveToFirstRow
            // Seed the footers ("Selected: x of y" + "# x") NOW - the class only refreshes them
            // on toggles/clicks, so without this the footer is blank on open and after Defaults.
            Send DoSetCheckboxFooterText
        End_Procedure

        // Fill from the persisted rules (LoadDeepScanRules reseeds + merges toggles when stale).
        Procedure LoadData
            Handle ho
            tDeepScanRule[] aRules
            String sPath
            If (not(IsComObjectCreated(Self))) ;
                Procedure_Return
            Get Create (RefClass(cDeepScanner)) to ho
            Get DeepScanRulesJsonPath of ho to sPath
            Get LoadDeepScanRules of ho sPath to aRules
            Send Destroy of ho
            Send FillFromRules aRules
        End_Procedure

        // Re-tick the grid to the SHIPPED defaults (the built-in seed, ignoring the saved JSON):
        // the eleven noisy rules stay off, everything else on. NOT persisted until Save -
        // Cancel still leaves the saved selection untouched (the "how do I get the defaults back
        // after Select All?" answer, Nils 2026-07-11).
        Procedure LoadDefaults
            Handle ho
            tDeepScanRule[] aRules
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send Destroy of ho
            Send FillFromRules aRules
        End_Procedure

        // Category label for the grid - the cDeepScanner method needs an instance, so mirror it here.
        Function DSCategoryText Integer eCategory Returns String
            If (eCategory = eModAutoFix) ;
                Function_Return "Auto-fix"
            If (eCategory = eModSuggest) ;
                Function_Return "Review"
            Function_Return "Explain"
        End_Function

        // Read the grid's checkbox states onto the loaded rules (paired by DS number) and return
        // them. Called from the web Save OnClick - a GRID-SAFE context - so the deferred DoSave
        // never has to touch the grid (err 98 from a deferred cTimer).
        Function CaptureRuleToggles Returns tDeepScanRule[]
            Handle ho hoDataSource
            tDeepScanRule[] aRules
            tDataSourceRow[] TheData
            Integer iSize iRow j iNumCol iChkCol iNum
            String sPath
            Boolean bChecked

            Get Create (RefClass(cDeepScanner)) to ho
            Get DeepScanRulesJsonPath of ho to sPath
            Get LoadDeepScanRules of ho sPath to aRules
            Send Destroy of ho
            Get piColumnId of oDSNumber_col           to iNumCol
            Get piColumnId of (phoCheckbox_Col(Self)) to iChkCol
            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move (SizeOfArray(TheData) - 1) to iSize
            For iRow from 0 to iSize
                Move 0 to iNum
                Move TheData[iRow].sValue[iNumCol] to iNum
                Move TheData[iRow].sValue[iChkCol] to bChecked
                For j from 0 to (SizeOfArray(aRules) - 1)
                    If (aRules[j].iDSNumber = iNum) ;
                        Move bChecked to aRules[j].bEnabled
                Loop
            Loop
            Function_Return aRules
        End_Function

        On_Key Key_Space Send ToggleCurrentItem
    End_Object

    /* THE SELECT STRIP (top-right, above the grid): Select All / None / Invert + Defaults, framework buttons on
       a grid host of 8 px columns (cFTGridHost, RDCFlexTron). Defaults re-ticks the SHIPPED selection (the "how
       do I undo a Select All?" road back, Nils 2026-07-11) - like the other three it only changes the GRID;
       Save persists. Each Sends to the grid in its OnClick, inside the web click, as the chips did. Column 0
       takes the rest of the width; the spans fit the captions (Select All ~91 px, Select None ~107, Invert
       ~73, Defaults ~86, measured 2026-09-30). */
    Object oWebSelectBar is a cFTGridHost
        Set Location to 10 304
        Set Size to 20 340
        Set peAnchors to anTopRight
        Set piColumnCount to 53         // column 0, then 13 + 15 + 11 + 13
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oSelectAllBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 13
            Set psCaption to "Select All"
            Set psCSSClass to "ftbtn ftg-selectall"
            Set psToolTip to "Tick every rule."

            Procedure OnClick
                Send SelectAll of oRules_grd
                Forward Send OnClick
            End_Procedure
        End_Object

        Object oSelectNoneBtn is a cFTWebButton
            Set piColumnIndex to 14
            Set piColumnSpan to 15
            Set psCaption to "Select None"
            Set psCSSClass to "ftbtn ftg-selectnone"
            Set psToolTip to "Untick every rule."

            Procedure OnClick
                Send SelectNone of oRules_grd
                Forward Send OnClick
            End_Procedure
        End_Object

        Object oInvertBtn is a cFTWebButton
            Set piColumnIndex to 29
            Set piColumnSpan to 11
            Set psCaption to "Invert"
            Set psCSSClass to "ftbtn ftg-invert"
            Set psToolTip to "Invert every tick."

            Procedure OnClick
                Send SelectInvert of oRules_grd
                Forward Send OnClick
            End_Procedure
        End_Object

        Object oDefaultsBtn is a cFTWebButton
            Set piColumnIndex to 40
            Set piColumnSpan to 13
            Set psCaption to "Defaults"
            Set psCSSClass to "ftbtn ftg-refresh"
            Set psToolTip to "Re-tick the shipped selection: eleven rules off - the eight ordinary-English-word symbols (Required, Retain, Status, Group, Fill, Points, Suppress, Thousands), which would match far too much perfectly good code, plus FindErr, LastErr and Windowindex, which are legitimate in code not yet migrated - everything else on. Nothing is saved until you click Save."

            Procedure OnClick
                Send LoadDefaults of oRules_grd
                Forward Send OnClick
            End_Procedure
        End_Object
    End_Object

    Object oInfo_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 10 380
        Set Location to 215 14
        Set Label to "Analyze Source searches the source for the obsolete symbols ticked above."
        Set peAnchors to anBottomLeft
        Set Justification_Mode to JMode_Left
    End_Object

    Object oInfo2_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 10 380
        Set Location to 228 14
        Set Label to "Eleven noisy rules (Required, Status, Group, FindErr, ...) ship unticked - Defaults restores that."
        Set peAnchors to anBottomLeft
        Set Justification_Mode to JMode_Left
    End_Object

    /* THE BOTTOM BAR: Help / Save / Cancel, framework buttons on a grid host of 8 px columns, as in
       ShowOtherLogFilesFT.dg. A button's work runs in OnButtonClick, after the web click has returned (the
       library's click relay), so the save's info box and Close_Panel can run there - no timer of this
       dialog's own. Save captures the grid's ticks in its OnClick first, inside the click. The spans fit
       the captions (Help ~68 px and Save ~68 at the 78 px minimum, Cancel ~78, measured 2026-09-30). */
    Object oWebBottomBar is a cFTGridHost
        Set Location to 212 414
        Set Size to 20 230
        Set peAnchors to anBottomRight
        Set piColumnCount to 35         // column 0, then 11 + 11 + 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oHelpBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Help"
            Set psCSSClass to "ftbtn ftg-help"
            Set psToolTip to "Open the online DataFlex reference that explains all these obsolete symbols."

            Procedure OnButtonClick
                Send DoHelp of (oDeepScanRules_dg(Self))
            End_Procedure
        End_Object

        Object oSaveBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 11
            Set psCaption to "Save"
            Set psCSSClass to "ftbtn ftg-check"
            Set psToolTip to "Save the rule selection. The next source analyze uses it."

            // The grid's ticks, captured here inside the click (see paCapturedRules); OnButtonClick saves them.
            Procedure OnClick
                tDeepScanRule[] aRules
                Get CaptureRuleToggles of oRules_grd to aRules
                Set paCapturedRules of (oDeepScanRules_dg(Self)) to aRules
                Forward Send OnClick
            End_Procedure

            Procedure OnButtonClick
                Send DoSave of (oDeepScanRules_dg(Self))
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 23
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close without saving changes."

            Procedure OnButtonClick
                Send DoClose of (oDeepScanRules_dg(Self))
            End_Procedure
        End_Object
    End_Object

    // The Save action, run from the Save button's OnButtonClick, after the web click. Uses the rules
    // captured in its OnClick (paCapturedRules); it never re-queries the grid here.
    Procedure DoSave
        Handle ho
        tDeepScanRule[] aRules
        Integer i iOn
        String sPath

        Get paCapturedRules to aRules
        If (SizeOfArray(aRules) = 0) ;
            Procedure_Return
        Get Create (RefClass(cDeepScanner)) to ho
        Get DeepScanRulesJsonPath of ho to sPath
        Send WriteDeepScanRules of ho aRules sPath
        Send Destroy of ho
        Move 0 to iOn
        For i from 0 to (SizeOfArray(aRules) - 1)
            If (aRules[i].bEnabled = True) ;
                Increment iOn
        Loop
        Send FTInfoBox ("Analyze rules saved." * String(iOn) * "rule(s) enabled. The next source analyze uses them.")
        Send Close_Panel
    End_Procedure

    // The Cancel/Close action, from the Cancel button's OnButtonClick and from Alt+C - both run inside
    // the modal's own message pump, so Close_Panel cleanly ends the modal loop.
    Procedure DoClose
        Send Close_Panel
    End_Procedure

    // The Help action: open the online DataFlex reference that explains every obsolete symbol these
    // rules match, in the user's default browser. 'Background' = fire-and-forget (no wait); the
    // dialog stays open. Reached from the Help button's OnButtonClick and from Alt+H.
    Procedure DoHelp
        Runprogram Shell Background "https://docs.dataflex.dev/LanguageReference/Obsolete_Commands_Functions_and_Other_Symbols/"
    End_Procedure

    // Alt+S saves from a NATIVE key context: the grid query is safe here (no WebView2 pump
    // involved), so capture + save run directly.
    Procedure DoSaveFromKey
        tDeepScanRule[] aRules
        Get CaptureRuleToggles of oRules_grd to aRules
        Set paCapturedRules to aRules
        Send DoSave
    End_Procedure

    On_Key Key_Alt+Key_A  Send SelectAll    of oRules_grd
    On_Key Key_Ctrl+Key_A Send SelectAll    of oRules_grd
    On_Key Key_Alt+Key_N  Send SelectNone   of oRules_grd
    On_Key Key_Ctrl+Key_N Send SelectNone   of oRules_grd
    On_Key Key_Alt+Key_I  Send SelectInvert of oRules_grd
    On_Key Key_Ctrl+Key_I Send SelectInvert of oRules_grd
    On_Key Key_Alt+Key_S  Send DoSaveFromKey
    On_Key Key_Alt+Key_C  Send DoClose
    On_Key Key_Alt+Key_H  Send DoHelp
End_Object

Procedure ActivateDeepScanRulesDialog
    Handle ho
    Move (oDeepScanRules_dg(Self)) to ho
    Send Popup of ho
End_Procedure
