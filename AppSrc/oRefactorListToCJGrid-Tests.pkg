//****************************************************************************
// $Module type: Test fixture
// $Module name: oRefactorListToCJGrid-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-27
//
// Description : Unit tests for cListToCJGrid.pkg (non-data-aware List -> cCJGrid subclass).
//               Included by oUnit_Tests.pkg inside the oRefactorFuncLib_Tests fixture object.
//
//               Test groups:
//                 oListIsListDeclaration - IsGridDeclaration (pattern + exact-match; dbList excluded)
//                 oListTransformSource   - TransformSource end-to-end (rename, Select_Mode, column,
//                                          Item_List -> LoadData, On_Item rows, message TODO)
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cListToCJGrid.pkg

Object oRefactorListToCJGrid is a cTestFixture
    Set psFunctionName to "RefactorListToCJGrid"

    Object oListIsListDeclaration is a cTestFixture
        Set psFunctionName to "IsGridDeclaration (cListToCJGrid)"

        Object oWorker is a cListToCJGrid
        End_Object

        // Reset class-name state so exact-match tests don't leak into later runs.
        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        {Published = True}
        { Description = "Bare 'List' class is detected by pattern" }
        Procedure List_Detected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object olist1 is a list" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "cList class is NOT detected by default (use explicit sParameter to target it)" }
        Procedure cList_NotDetectedByDefault
            Boolean bResult
            Get IsGridDeclaration of oWorker "object olist1 is a clist" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "dbList class is NOT detected (belongs to cDbListTocDbCJGridPromptList)" }
        Procedure DbList_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object olist1 is a dblist" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "cMyDbList class is NOT detected (ends in dblist)" }
        Procedure cMyDbList_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object olist1 is a cmydblist" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "Non-list class is not detected" }
        Procedure NonList_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object oform1 is a cdbform" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "Exact-match mode: specified class is detected" }
        Procedure ExactMatch_Detected
            Boolean bResult
            Get ParseAndSetParameter of oWorker "cMyList,cCJGrid" to bResult
            Get IsGridDeclaration of oWorker "object omylist is a cmylist" to bResult
            Send Assert bResult
        End_Procedure

    End_Object

    Object oListTransformSource is a cTestFixture
        Set psFunctionName to "TransformSource (cListToCJGrid)"

        Object oWorker is a cListToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // Helper: loads asInput into worker, runs TransformSource, returns the list count.
        Function RunTransform String[] asInput Returns Integer
            Integer iLists
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iLists
            Function_Return iLists
        End_Function

        Function GetOutput Returns String[]
            String[] asResult
            Get pasSource of oWorker to asResult
            Function_Return asResult
        End_Function

        // True when any output line contains sNeedle (case-insensitive).
        Function OutputContains String[] asOutput String sNeedle Returns Boolean
            Integer iIdx iSize
            String  sLow
            Move (Lowercase(sNeedle)) to sLow
            Move (SizeOfArray(asOutput) - 1) to iSize
            For iIdx from 0 to iSize
                If (Lowercase(asOutput[iIdx]) contains sLow) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // Builds the canonical List input used by several tests.
        Procedure FillSampleList String[] ByRef asInput
            Move "Object oList1 is a List"                  to asInput[0]
            Move "    Set Size to 80 50"                    to asInput[1]
            Move "    Set Select_Mode to Multi_Select"      to asInput[2]
            Move "    Item_List"                            to asInput[3]
            Move '        On_Item "Oil Filter" send None'   to asInput[4]
            Move '        On_Item "Spark Plugs" send None'  to asInput[5]
            Move "    End_Item_List"                        to asInput[6]
            Move "End_Object"                               to asInput[7]
        End_Procedure

        {Published = True}
        { Description = "List class name is replaced with cCJGrid" }
        Procedure ClassNameReplaced
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertIAreEqual 1 iLists
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
        End_Procedure

        {Published = True}
        { Description = "dbList object is NOT converted by cListToCJGrid" }
        Procedure DbList_NotConverted
            String[] asInput asOutput
            Integer  iLists
            Move "Object oList1 is a dbList" to asInput[0]
            Move "End_Object"                to asInput[1]
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertIAreEqual 0 iLists
            Send Assert (Lowercase(asOutput[0]) contains "is a dblist")
        End_Procedure

        {Published = True}
        { Description = "Set Select_Mode Multi_Select is translated to pbMultipleSelection" }
        Procedure SelectMode_Translated
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "pbMultipleSelection"))
        End_Procedure

        {Published = True}
        { Description = "A single cCJGridColumn (oCol1) is generated and the header hidden" }
        Procedure SingleColumn_Generated
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "Object oCol1 is a cCJGridColumn"))
            Send Assert (OutputContains(Self, asOutput, "Set pbShowHeader to False"))
        End_Procedure

        {Published = True}
        { Description = "Item_List items become rows in a generated LoadData procedure" }
        Procedure ItemList_BecomesLoadData
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "Procedure LoadData"))
            Send Assert (OutputContains(Self, asOutput, 'Move "Oil Filter" to TheData[iRow].sValue[iCol1]'))
            Send Assert (OutputContains(Self, asOutput, 'Move "Spark Plugs" to TheData[iRow].sValue[iCol1]'))
            Send Assert (OutputContains(Self, asOutput, "Send InitializeData TheDataEmpty"))
        End_Procedure

        {Published = True}
        { Description = "The Item_List / On_Item / End_Item_List keywords are consumed (not left in output)" }
        Procedure ItemListKeywords_Removed
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertFalse (OutputContains(Self, asOutput, "On_Item"))
            Send AssertFalse (OutputContains(Self, asOutput, "End_Item_List"))
        End_Procedure

        {Published = True}
        { Description = "A non-None On_Item message emits an OnRowChange TODO" }
        Procedure NonNoneMessage_EmitsTodo
            String[] asInput asOutput
            Integer  iLists
            Move "Object oList1 is a List"                       to asInput[0]
            Move "    Item_List"                                 to asInput[1]
            Move '        On_Item "Pick me" send DoSelectItem'   to asInput[2]
            Move "    End_Item_List"                             to asInput[3]
            Move "End_Object"                                    to asInput[4]
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "OnRowChange"))
        End_Procedure

        {Published = True}
        { Description = "Set Size (an unrelated property) is preserved unchanged" }
        Procedure UnrelatedProperty_Preserved
            String[] asInput asOutput
            Integer  iLists
            Send FillSampleList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "Set Size to 80 50"))
        End_Procedure

        // ---- Programmatic (Send Add_Item) fill - the common real-world List shape ----
        // Models the SkinEnumeration.vw oSkinsList: a custom event procedure (OnChange) with a
        // bare Send, plus a fill method (AddSkinsToList) that calls Send Add_Item in a loop.

        Procedure FillProgrammaticList String[] ByRef asInput
            Move "Object oSkinsList is a List"                                  to asInput[0]
            Move "    Set Size to 131 217"                                      to asInput[1]
            Move ""                                                             to asInput[2]
            Move "    Procedure OnChange"                                       to asInput[3]
            Move "        Send ApplyCurrentSkin"                                to asInput[4]
            Move "    End_Procedure"                                            to asInput[5]
            Move ""                                                             to asInput[6]
            Move "    Procedure AddSkinsToList tSkinInformation[] Skins"        to asInput[7]
            Move "        Integer iSkinsCount iArrayItem"                       to asInput[8]
            Move "        Move (SizeOfArray(Skins)) to iSkinsCount"             to asInput[9]
            Move "        Set Dynamic_Update_State to False"                    to asInput[10]
            Move "        Send Delete_Data"                                     to asInput[11]
            Move '        Send Add_Item msg_None "None"'                        to asInput[12]
            Move "        For iArrayItem from 0 to (iSkinsCount-1)"             to asInput[13]
            Move "            Send Add_Item msg_None (Skins[iArrayItem].sName)" to asInput[14]
            Move "        Loop"                                                 to asInput[15]
            Move "        If (Item_count(Self)) Begin"                          to asInput[16]
            Move "            Set Current_item to 0"                            to asInput[17]
            Move "        End"                                                  to asInput[18]
            Move "        Set Dynamic_Update_State to True"                     to asInput[19]
            Move "    End_Procedure"                                            to asInput[20]
            Move "End_Object"                                                   to asInput[21]
        End_Procedure

        {Published = True}
        { Description = "Programmatic Add_Item fill method KEEPS its name (NOT renamed to LoadData)" }
        Procedure ProgrammaticFill_KeepsFillMethodName
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertIAreEqual 1 iLists
            Send Assert (OutputContains(Self, asOutput, "Procedure AddSkinsToList"))
            Send AssertFalse (OutputContains(Self, asOutput, "Procedure LoadData"))
        End_Procedure

        {Published = True}
        { Description = "Send Add_Item becomes a TheData row assignment" }
        Procedure ProgrammaticFill_AddItemBecomesRow
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, 'Move "None" to TheData[iRow].sValue[iCol1]'))
            Send Assert (OutputContains(Self, asOutput, "Send ReInitializeData TheData False"))
        End_Procedure

        {Published = True}
        { Description = "A single-column oCol1 is generated for a programmatically-filled List" }
        Procedure ProgrammaticFill_SingleColumn
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "Object oCol1 is a cCJGridColumn"))
        End_Procedure

        {Published = True}
        { Description = "No Activating stub for an in-place-converted fill (the external caller drives it)" }
        Procedure ProgrammaticFill_NoActivatingStub
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertFalse (OutputContains(Self, asOutput, "Procedure Activating"))
            Send AssertFalse (OutputContains(Self, asOutput, "Send LoadData"))
        End_Procedure

        {Published = True}
        { Description = "A custom event procedure (OnChange) is preserved, not stripped" }
        Procedure CustomProcedure_Preserved
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send Assert (OutputContains(Self, asOutput, "Procedure OnChange"))
        End_Procedure

        {Published = True}
        { Description = "A bare Send inside a custom event procedure is preserved, not commented out" }
        Procedure BareSendInCustomProc_Preserved
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            // Present...
            Send Assert (OutputContains(Self, asOutput, "Send ApplyCurrentSkin"))
            // ...and NOT commented out by the inherited grid-body bare-Send rule.
            Send AssertFalse (OutputContains(Self, asOutput, "// Send ApplyCurrentSkin"))
        End_Procedure

        {Published = True}
        { Description = "The fill method keeps its FULL signature (name + parameters) so external callers still resolve" }
        Procedure ProgrammaticFill_KeepsSignature
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            // The original 'Procedure AddSkinsToList tSkinInformation[] Skins' declaration is intact -
            // not renamed to LoadData, parameter not stripped.
            Send Assert (OutputContains(Self, asOutput, "Procedure AddSkinsToList tSkinInformation[] Skins"))
        End_Procedure

        {Published = True}
        { Description = "The redundant If(Item_count) Set Current_item cursor guard is dropped" }
        Procedure ProgrammaticFill_DropsCurrentItemGuard
            String[] asInput asOutput
            Integer  iLists
            Send FillProgrammaticList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            // Current_item only appeared in the dropped guard, so it must be gone...
            Send AssertFalse (OutputContains(Self, asOutput, "Set Current_item"))
            // ...replaced by a one-line note explaining why.
            Send Assert (OutputContains(Self, asOutput, "Dropped redundant"))
        End_Procedure

        // The exact stock SkinEnumeration.vw oSkinsList, nested inside a dbView (4-space indent) -
        // a regression guard that a List nested in a parent object keeps all its procedures and
        // converts its Send Add_Item fill method to a populated LoadData.
        Procedure FillRealNestedSkinsList String[] ByRef asInput
            Move "Object oSkinEnumeration is a dbView"                              to asInput[0]
            Move "    Object oSkinsList is a List"                                  to asInput[1]
            Move "        Set Size to 131 217"                                      to asInput[2]
            Move "        Set Location to 23 5"                                     to asInput[3]
            Move "        Set peAnchors to anAll"                                   to asInput[4]
            Move "        Property Boolean pbNoChange False"                        to asInput[5]
            Move "        Procedure OnChange"                                       to asInput[6]
            Move "            Integer iCurrent"                                     to asInput[7]
            Move "            tSkinInformation[] Skins"                             to asInput[8]
            Move "            Get pSkins to Skins"                                  to asInput[9]
            Move "            If (focus(Self) and item_count(Self)) Begin"          to asInput[10]
            Move "                Send ApplyCurrentSkin"                            to asInput[11]
            Move "            End"                                                  to asInput[12]
            Move "        End_Procedure"                                           to asInput[13]
            Move "        Procedure Mouse_Down Integer iWindowNumber Integer iPosition" to asInput[14]
            Move "            Set pbNoChange to True"                               to asInput[15]
            Move "            Forward Send Mouse_Down iWindowNumber iPosition"      to asInput[16]
            Move "        End_Procedure"                                           to asInput[17]
            Move "        Procedure Mouse_Up Integer iWindowNumber Integer iPosition" to asInput[18]
            Move "            Forward Send Mouse_up iWindowNumber iPosition"        to asInput[19]
            Move "            Send ApplyCurrentSkin"                                to asInput[20]
            Move "        End_Procedure"                                           to asInput[21]
            Move "        Procedure AddSkinsToList tSkinInformation[] Skins"        to asInput[22]
            Move "            Integer iSkinsCount iArrayItem"                       to asInput[23]
            Move "            Move (SizeOfArray(Skins)) to iSkinsCount"             to asInput[24]
            Move "            Set Dynamic_Update_State to False"                    to asInput[25]
            Move "            Send Delete_Data"                                     to asInput[26]
            Move '            Send Add_Item msg_None "None"'                        to asInput[27]
            Move "            For iArrayItem from 0 to (iSkinsCount-1)"             to asInput[28]
            Move "                Send Add_Item msg_None (Skins[iArrayItem].sName)" to asInput[29]
            Move "            Loop"                                                 to asInput[30]
            Move "            If (Item_count(Self)) Begin"                          to asInput[31]
            Move "                Set Current_item to 0"                            to asInput[32]
            Move "            End"                                                  to asInput[33]
            Move "            Set Dynamic_Update_State to True"                     to asInput[34]
            Move "        End_Procedure"                                           to asInput[35]
            Move "    End_Object"                                                  to asInput[36]
            Move "End_Object"                                                      to asInput[37]
        End_Procedure

        {Published = True}
        { Description = "Stock nested oSkinsList: all 3 event procedures survive and the fill method is body-converted in place" }
        Procedure RealNestedSkinsList_FullConversion
            String[] asInput asOutput
            Integer  iLists

            Send FillRealNestedSkinsList (&asInput)
            Get RunTransform asInput to iLists
            Get GetOutput            to asOutput
            Send AssertIAreEqual 1 iLists
            // Event procedures preserved
            Send Assert (OutputContains(Self, asOutput, "Procedure OnChange"))
            Send Assert (OutputContains(Self, asOutput, "Procedure Mouse_Down"))
            Send Assert (OutputContains(Self, asOutput, "Procedure Mouse_Up"))
            Send Assert (OutputContains(Self, asOutput, "Send ApplyCurrentSkin"))
            // Fill method keeps its signature, body converted to TheData rows (not renamed to LoadData)
            Send Assert (OutputContains(Self, asOutput, "Procedure AddSkinsToList tSkinInformation[] Skins"))
            Send Assert (OutputContains(Self, asOutput, 'Move "None" to TheData[iRow].sValue[iCol1]'))
            // No empty stub and no Activating stub
            Send AssertFalse (OutputContains(Self, asOutput, "Populate this grid with data"))
            Send AssertFalse (OutputContains(Self, asOutput, "Procedure Activating"))
        End_Procedure

    End_Object

End_Object
