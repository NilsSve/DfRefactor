//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeCmdlineCommandToFunction-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for ChangeCmdlineCommandToFunction - the sequential 'Cmdline <var>' command ->
//               'Move (NextCmdLineArgument()) to <var>' plus the ONE generated compat block at the top of
//               the file (Use cCommandLine.pkg + counter + the global function, #IFDEF-guarded).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeCmdlineCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeCmdlineCommandToFunction"

        // The classic shell shape: a read-until-empty loop. Both reads convert; the compat block
        // lands ONCE at the top of the file; line count grows by exactly the 18 injected lines.
        { Published = True }
        Procedure ChangeCmdline_LoopShapeConverts
            String[] asCode
            Integer iCount iBefore

            Move 'Use DfAllEnt.pkg'                     to asCode[0]
            Move '    Cmdline sArg'                     to asCode[1]
            Move '    While sArg ne ""'                 to asCode[2]
            Move '        Showln sArg'                  to asCode[3]
            Move '        Cmdline sArg'                 to asCode[4]
            Move '    Loop'                             to asCode[5]
            Move (SizeOfArray(asCode)) to iBefore
            Get ChangeCmdlineCommandToFunction of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual (iBefore + 18) (SizeOfArray(asCode))
            // The block sits at the top; the converted lines follow 18 lines further down.
            Send Assert (asCode[3]  contains "get_NextCmdLineArgument")
            Send AssertSAreEqual 'Use cCommandLine.pkg'                        asCode[5]
            Send AssertSAreEqual '    Move (NextCmdLineArgument()) to sArg'    asCode[19]
            Send AssertSAreEqual '        Move (NextCmdLineArgument()) to sArg' asCode[22]
        End_Procedure

        // Idempotent: a second run converts nothing and injects nothing.
        { Published = True }
        Procedure ChangeCmdline_SecondRunIsNoOp
            String[] asCode
            Integer iCount iAfterFirst
            Move 'Cmdline sArg' to asCode[0]
            Get ChangeCmdlineCommandToFunction of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Move (SizeOfArray(asCode)) to iAfterFirst
            Get ChangeCmdlineCommandToFunction of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual iAfterFirst (SizeOfArray(asCode))
        End_Procedure

        // A trailing comment on the converted line survives.
        { Published = True }
        Procedure ChangeCmdline_EndCommentPreserved
            String[] asCode
            Integer iCount
            Move '    Cmdline sFirst // company selector' to asCode[0]
            Get ChangeCmdlineCommandToFunction of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move (NextCmdLineArgument()) to sFirst   // company selector' asCode[18]
        End_Procedure

        // Not the command: 'cmdline' mid-line, in a comment, or with a second argument (the
        // rare length form) - all left untouched, no injection.
        { Published = True }
        Procedure ChangeCmdline_NonCommandShapesUntouched
            String[] asCode
            Integer iCount
            Move 'Move Cmdline to sX'          to asCode[0]
            Move '// Cmdline sArg reads args'  to asCode[1]
            Move 'Cmdline sArg 10'             to asCode[2]
            Get ChangeCmdlineCommandToFunction of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Send AssertSAreEqual 'Move Cmdline to sX' asCode[0]
            Send AssertSAreEqual 'Cmdline sArg 10'    asCode[2]
        End_Procedure

    End_Object
