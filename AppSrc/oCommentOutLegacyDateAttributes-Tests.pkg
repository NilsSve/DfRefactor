//****************************************************************************
// $Module type: Test fixture
// $Module name: oCommentOutLegacyDateAttributes-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-14 (as oCommentOutSysdate4State-Tests; renamed 2026-09-18 with the function)
//
// Description : Unit tests for the CommentOutLegacyDateAttributes refactor function - the Y2K date
//               triplet the old Studio wrote into every new program. VdfBase.pkg sets all three
//               itself (True / True / 30), so a line is commented out only when it repeats that:
//               DF_SYSDATE_4_STATE in any shape (a no-op), DF_DATE_4_STATE only 'to True',
//               DF_EPOCH_VALUE only 'to 30'. An override or a Get of the two live ones stays.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCommentOutLegacyDateAttributes is a cTestFixture
        Set psFunctionName to "CommentOutLegacyDateAttributes"

        // Runs the function on one line the way the engine does (tokenize first); returns the verdict.
        Function _Run String ByRef sLine Returns Boolean
            Boolean bChanged
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutLegacyDateAttributes of ghoFuncLib (&sLine) to bChanged
            Function_Return bChanged
        End_Function

        // DF_SYSDATE_4_STATE is a no-op in any shape: a Set with an 'of' clause is commented out with the
        // note. The symbol is an ARGUMENT (not a leading command), so it is matched anywhere on the line.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_SysdateSetIsCommentedOut
            String sLine
            Boolean bChanged
            Move 'Set_Attribute DF_SYSDATE_4_STATE of MyFile.File_Number to True' to sLine
            Get _Run (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '// Set_Attribute DF_SYSDATE_4_STATE of MyFile.File_Number to True // no longer needed - VdfBase.pkg sets this' sLine
        End_Procedure

        // ...and so is a Get of it - the value read is meaningless.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_SysdateGetIsCommentedOut
            String sLine
            Boolean bChanged
            Move '    Get_Attribute DF_SYSDATE_4_STATE to bState' to sLine
            Get _Run (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    // Get_Attribute DF_SYSDATE_4_STATE to bState // no longer needed - VdfBase.pkg sets this' sLine
        End_Procedure

        // DF_DATE_4_STATE 'to True' repeats VdfBase.pkg - redundant, commented out (case-blind keyword).
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_Date4StateTrueIsCommentedOut
            String sLine
            Boolean bChanged
            Move '    Set_Attribute DF_DATE_4_STATE To TRUE' to sLine
            Get _Run (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    // Set_Attribute DF_DATE_4_STATE To TRUE // no longer needed - VdfBase.pkg sets this' sLine
        End_Procedure

        // The old Studio template's own line: 'to False' is an OVERRIDE of VdfBase's True. Commenting it
        // out would widen every date-to-string year to 4 digits - the line stays.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_Date4StateFalseStays
            String sLine
            Boolean bChanged
            Move '    Set_Attribute DF_DATE_4_STATE To False' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Set_Attribute DF_DATE_4_STATE To False' sLine
        End_Procedure

        // DF_EPOCH_VALUE 'to 30' repeats VdfBase.pkg - redundant, commented out.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_Epoch30IsCommentedOut
            String sLine
            Boolean bChanged
            Move '    Set_Attribute DF_EPOCH_VALUE To 30' to sLine
            Get _Run (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    // Set_Attribute DF_EPOCH_VALUE To 30 // no longer needed - VdfBase.pkg sets this' sLine
        End_Procedure

        // Any other epoch changes how a 2-digit year is read - the line stays.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_EpochOtherStays
            String sLine
            Boolean bChanged
            Move '    Set_Attribute DF_EPOCH_VALUE to 50' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Set_Attribute DF_EPOCH_VALUE to 50' sLine
        End_Procedure

        // A Get of a LIVE attribute reads a real value - the line stays, whatever the target is called.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_GetOfLiveAttributeStays
            String sLine
            Boolean bChanged
            Move '    Get_Attribute DF_EPOCH_VALUE to iEpoch' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Get_Attribute DF_EPOCH_VALUE to iEpoch' sLine
            Move '    Get_Attribute DF_DATE_4_STATE to bFour' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Get_Attribute DF_DATE_4_STATE to bFour' sLine
        End_Procedure

        // A variable or an expression in the value slot is not judged - the line stays.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_VariableValueStays
            String sLine
            Boolean bChanged
            Move '    Set_Attribute DF_DATE_4_STATE to bWide' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Move '    Set_Attribute DF_EPOCH_VALUE to (iBase + 30)' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // THE OLD STUDIO TEMPLATE, as it was written into every new program (Nils 2026-09-18): the first
        // and the third line go, the middle one is the override and stays. One assertion per line.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_OldStudioTriplet
            String s1 s2 s3
            Boolean b1 b2 b3
            Move 'Set_Attribute DF_SYSDATE_4_STATE To True' to s1
            Move 'Set_Attribute DF_DATE_4_STATE To False'   to s2
            Move 'Set_Attribute DF_EPOCH_VALUE To 30'       to s3
            Get _Run (&s1) to b1
            Get _Run (&s2) to b2
            Get _Run (&s3) to b3
            Send Assert b1
            Send AssertFalse b2
            Send Assert b3
            Send AssertSAreEqual '// Set_Attribute DF_SYSDATE_4_STATE To True // no longer needed - VdfBase.pkg sets this' s1
            Send AssertSAreEqual 'Set_Attribute DF_DATE_4_STATE To False' s2
            Send AssertSAreEqual '// Set_Attribute DF_EPOCH_VALUE To 30 // no longer needed - VdfBase.pkg sets this' s3
        End_Procedure

        // Idempotent: an already-commented line is left alone (never stacks "// //").
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_NoChange_AlreadyCommented
            String sLine
            Boolean bChanged
            Move '// Set_Attribute DF_SYSDATE_4_STATE of MyFile.File_Number to True' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '// Set_Attribute DF_SYSDATE_4_STATE of MyFile.File_Number to True' sLine
        End_Procedure

        // A line without any of the three symbols is untouched.
        {Published = True}
        Procedure CommentOutLegacyDateAttributes_NoChange_Unrelated
            String sLine
            Boolean bChanged
            Move 'Move (CurrentDateTime()) to dToday' to sLine
            Get _Run (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Move (CurrentDateTime()) to dToday' sLine
        End_Procedure

    End_Object
