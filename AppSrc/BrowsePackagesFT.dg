Use cFTModalPanel.pkg         // FT: the dark modal, same base as every FT dialog
Use RefactorConstants.h.pkg
Use FTAllWebControlClasses.pkg   // cFTWebHtmlBox, and cFTWebButton - the band's Close
Use cFTLocalWebControlHost.pkg     // the header's and the list's hosts
Use cFTGridHost.pkg              // the band's host - a grid of 8 px columns (RDCFlexTron)
Use FTMarkupBuilders.pkg         // the HTML vocabulary - OpenHtml, IconLabel, the builders

/*  BROWSE PACKAGES - a picker. A pinned note, a scrolling list of rows, one Close button, and
    the row that was clicked comes back to the caller. Nothing else, ever.

    WHY ITS OWN DIALOG (Nils 2026-08-16: "go over all the dialogs and check that they aren't used
    for more than one thing - at least not with multiple different buttons"). The audit left the
    shared confirm dialog serving exactly two shapes: the rename prompts (an input field, Rename
    now / Not now) and this list (click-rows, Close). Two shapes, two button sets, one object -
    the last residual of the rule that cost three broken-layout rounds on 08-15. So the list moves
    here, and ConfirmDialogFT becomes purely the input prompt: one shape, one button pair (on
    2026-09-29 it gave way to RDCFlexTron's FTInputBox).

    Same geometry as MessageBoxFT and AddPackageFT - the one shape that has held all week: a
    pinned header host, a scrolling body host, a button band as its own host, all placed from
    the panel's MEASURED size on every show and every drag (the base grows the panel after the
    children bind, so a bottom anchor recorded at construction lands 8 units high forever).

    THE CONTRACT: the caller supplies header html, the row html (each row's clickable element
    carrying data-ServerOnClick="pick|<key>"), and a footer note; ShowPicker returns the key of
    the row clicked, or "" for Close / Esc. The caller does whatever the key means - here,
    InstallChosenPackage - so this dialog knows nothing about df-cli.  */

Object oBrowsePackages_dg is a cFTModalPanel
    Set Label to "Browse packages"
    Set Size to 258 480
    Set piMinSize to 258 480
    Set Location to 2 2
    Set Icon to "DFRefactor.ico"

    Property String psPicked ""
    Property String psHeaderHtml ""
    Property String psRowsHtml ""
    Property String psFooterNote ""

    /* HEADER - the pinned note(s) above the list. Position:fixed;inset:0 inside its own host,
       the one geometry the framework's DOM nesting cannot disturb. */
    Object oBpHead is a cFTLocalWebControlHost
        Set Location to 4 4
        Set Size to 40 472
        Set peAnchors to anTopLeftRight

        Function HeadPage String sHtml Returns String
            String s
            Move (CS_PaletteCssLink + CssLink("browsepackages")) to s
            Move (s + (DivOpen("bph")) + sHtml + CS_DivEnd) to s
            Function_Return s
        End_Function

        Object oBpHead_hb is a cFTWebHtmlBox
            Set piColumnSpan to 1

            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse. A hand-written sample in the shape the caller builds (the Libraries
            // dialog's Browse packages button): this box has no runtime seed of its own - Activating fills
            // it - so the Designer showed an empty host. The runtime expression sits in End_Construct_Object below.
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/browsepackages.css">
            <div class="bph">
                <p style="color:var(--dfr-ink, #eceae1);font-size:12.5px;">df-cli downloads and installs the package, then records it in this workspace. DFRefactor does not fetch anything itself.</p>
                <p style="color:var(--dfr-ink, #eceae1);font-size:12.5px;">2 packages that are already in this workspace are not listed.</p></div>
            """

            // RUNTIME content - the page frame with nothing in it, which Activating replaces; here rather
            // than in the object body, so the Designer keeps the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (HeadPage(Self, ""))
            End_Procedure
        End_Object
    End_Object

    /* BODY - the list, scrolling. Every row's clickable element carries pick|<key>. */
    Object oBpBody is a cFTLocalWebControlHost
        Set Location to 46 4
        Set Size to 170 472
        Set peAnchors to anTopLeftRight

        Function BodyPage String sRows Returns String
            String s
            Move (CS_PaletteCssLink + CssLink("browsepackages")) to s
            Move (s + (DivOpen("bpb")) + sRows + CS_DivEnd) to s
            Function_Return s
        End_Function

        Object oBpBody_hb is a cFTWebHtmlBox
            Set piColumnSpan to 1
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse. A hand-written sample in the shape the caller builds (the Libraries
            // dialog's Browse packages button): this box has no runtime seed of its own - Activating fills
            // it - so the Designer showed an empty host. The runtime expression sits in End_Construct_Object below.
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/browsepackages.css">
            <div class="bpb">
                <div class="bpcard">
                    <div class="bpct">
                        <div class="bpn">DataFlex_dev_Web_UI</div>
                        <div class="bpd">The DataFlex web framework: the JavaScript engine, the web controls and their styling.</div>
                        <div class="bpm"><span title="Publisher"><span class="bpgl">&#128100;&#65038;</span>DataFlex_dev</span><span title="Version"><span
                            class="bpgl">&#10697;</span>1.0.52</span></div></div><span class="act" data-ServerOnClick="pick|DataFlex_dev_Web_UI#1.0.52" title="Install DataFlex_dev_Web_UI 1.0.52 into this workspace.">Install</span></div>
                <div class="bpcard">
                    <div class="bpct">
                        <div class="bpn">DataFlex_dev_Web_UI_FlexTron</div>
                        <div class="bpd">FlexTron: the web controls hosted inside a Windows application, WebView2 and the local host classes.</div>
                        <div class="bpm"><span title="Publisher"><span class="bpgl">&#128100;&#65038;</span>DataFlex_dev</span><span title="Version"><span
                            class="bpgl">&#10697;</span>1.0.52</span></div></div><span class="act" data-ServerOnClick="pick|DataFlex_dev_Web_UI_FlexTron#1.0.52"
                            title="Install DataFlex_dev_Web_UI_FlexTron 1.0.52 into this workspace.">Install</span></div>
                <div class="bpcard">
                    <div class="bpct">
                        <div class="bpn">Library-DFUnit</div>
                        <div class="bpd">Unit testing framework for DataFlex: fixtures, assertions, and a runner for the Studio and the command line.</div>
                        <div class="bpm"><span title="Publisher"><span class="bpgl">&#128100;&#65038;</span>NilsSve</span><span title="Version"><span
                            class="bpgl">&#10697;</span>2.1.0</span></div></div><span class="act" data-ServerOnClick="pick|Library-DFUnit#2.1.0" title="Install Library-DFUnit 2.1.0 into this workspace.">Install</span></div></div>
            """

            // RUNTIME content - the page frame with nothing in it, which Activating replaces; here rather
            // than in the object body, so the Designer keeps the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (BodyPage(Self, ""))
            End_Procedure

            // A row click: record the key and close. The work runs here, after the web click has returned (the
            // library's click relay) - ending the panel from inside the click faults 4410, every FT dialog's rule.
            Procedure OnHtmlClick String sId String sParam
                If (Left(sId, 5) = "pick|") Begin
                    Set psPicked of (oBrowsePackages_dg(Self)) to (Mid(sId, (Length(sId) - 5), 6))
                    Send Close_Panel of (oBrowsePackages_dg(Self))
                End
            End_Procedure
        End_Object
    End_Object

    /* BAND - the footer note on the left and Close on the right, on a grid host of 8 px columns since 2026-09-30.
       The note is markup (oBpBand_hb) in column 0, which takes the rest of the width; the one caller passes none,
       and then it is an empty bar. Close is a framework button (cFTWebButton, RDCFlexTron) - NEUTRAL, not the
       green .act (Nils 2026-08-21): every row carries a green Install, so a green Close would blend into a column
       of them, and Close is the one thing here that installs nothing. It runs in OnButtonClick, after the web
       click has returned (the library's click relay), where ending the panel is safe - as a row's OnHtmlClick
       does. Row 0 is 4 px of air, so the button row sits centred in the 30-unit band, where
       the chip sat. Its own host, placed from the measured panel by PlaceHosts. */
    Object oBpBand is a cFTGridHost
        Set Location to 218 4
        Set Size to 30 472
        Set peAnchors to anLeftRight
        Set piColumnCount to 12         // column 0 - the note - then Close's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width
        Set psRowHeights to "0/4px"     // air above the button row

        Function BandPage String sNote Returns String
            String s
            Move (CssLink("browsepackages")) to s
            Move (s + (DivOpen("bpnotebar"))) to s
            If (Trim(sNote) <> "") ;
                Move (s + (DivOpen("note")) + sNote + CS_DivEnd) to s
            Move (s + CS_DivEnd) to s
            Function_Return s
        End_Function

        Object oBpBand_hb is a cFTWebHtmlBox
            Set piRowIndex to 1
            Set piColumnSpan to 1
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse. It is the string the runtime seeds - the note bar without a note, which is
            // what the one caller shows; the runtime expression sits in End_Construct_Object below.
            Set psHtml to """
            <link rel="stylesheet" href="CssStyle/browsepackages.css">
            <div class="bpnotebar"></div>
            """

            // RUNTIME content - here rather than in the object body, so the Designer keeps the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (BandPage(Self, ""))
            End_Procedure
        End_Object

        Object oBpCloseBtn is a cFTWebButton
            Set piRowIndex to 1
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"

            Procedure OnButtonClick
                Set psPicked of oBrowsePackages_dg to ""
                Send Close_Panel of oBrowsePackages_dg
            End_Procedure
        End_Object
    End_Object

    // Geometry from the measured panel: header fixed-height on top, band above the status-bar
    // clearance, body filling between. Called on Activating and on every drag.
    Procedure PlaceHosts
        Integer iSize iH iW iBandTop iHeadH

        Get Size to iSize
        Move (Hi(iSize)) to iH
        Move (Low(iSize)) to iW
        Move 40 to iHeadH
        Move (iH - CI_ModalStatusBarUnits - 12 - 30) to iBandTop
        If (iBandTop < (iHeadH + 40)) ;
            Move (iHeadH + 40) to iBandTop
        Set Size     of (oBpHead(Self)) to iHeadH (iW - 8)
        Set Location of (oBpBody(Self)) to (iHeadH + 6) 4
        Set Size     of (oBpBody(Self)) to (iBandTop - iHeadH - 6) (iW - 8)
        Set Location of (oBpBand(Self)) to iBandTop 4
        Set Size     of (oBpBand(Self)) to 30 (iW - 8)
    End_Procedure

    Procedure OnResize
        Forward Send OnResize
        Send PlaceHosts
    End_Procedure

    // Every box on every activation: UpdateHtml keeps the markup for a page that mounts again and pushes
    // it to one that is already alive.
    Procedure Activating
        String sHead sBody sBand

        Forward Send Activating
        Send PlaceHosts
        Get HeadPage of (oBpHead(Self)) (psHeaderHtml(Self)) to sHead
        Send UpdateHtml of (oBpHead_hb(oBpHead(Self))) sHead
        Get BodyPage of (oBpBody(Self)) (psRowsHtml(Self)) to sBody
        Send UpdateHtml of (oBpBody_hb(oBpBody(Self))) sBody
        Get BandPage of (oBpBand(Self)) (psFooterNote(Self)) to sBand
        Send UpdateHtml of (oBpBand_hb(oBpBand(Self))) sBand
    End_Procedure

    // Esc = Close, nothing picked.
    Procedure Cancel
        Set psPicked to ""
        Forward Send Cancel
    End_Procedure

    /* THE one call. Returns the key of the row clicked (whatever followed "pick|"), or "" for
       Close / Esc. The caller owns the rows' meaning. */
    Function ShowPicker String sTitle String sHeaderHtml String sRowsHtml String sFooterNote Returns String
        If (sTitle = "") ;
            Move "Browse" to sTitle
        Set Label to sTitle
        Set psHeaderHtml to sHeaderHtml
        Set psRowsHtml   to sRowsHtml
        Set psFooterNote to sFooterNote
        Set psPicked     to ""
        Send Popup
        Function_Return (psPicked(Self))
    End_Function
End_Object

Move (oBrowsePackages_dg(Self)) to ghoBrowsePackages
