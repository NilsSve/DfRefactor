//****************************************************************************
// $Module name: WorkspaceCopyRecord.pkg
// Description : The pure half of the workspace copy record.
//****************************************************************************
/* THE WORKSPACE COPY RECORD (Nils 2026-10-07: "It doesn't make much sense to copy a copy, does it? ...
   it can be confusing to see the suggestion to copy when it already has been done").

   cRefactorApplication.RecordWorkspaceCopy remembers each copy the migration copy makes, in DFRefactor's
   own settings beside the Recent list - never in the copy itself, where a marker file would turn up in
   the customer's source control. A record is "<the other side's .sws>|<yyyy-mm-dd>": the copy's record
   names its original, the original's names its latest copy. These read and write that string, and are
   GLOBALS so the test runner - whose application object is a plain cApplication - can reach them. */

// A record: the .sws on the other side of the copy, and the day the copy was made (yyyy-mm-dd).
Function WorkspaceCopyRecord Global String sSws String sIsoDate Returns String
    Function_Return (Trim(sSws) + "|" + Trim(sIsoDate))
End_Function

// The .sws half of a record - "" for an empty record.
Function WorkspaceCopyRecordPath Global String sRecord Returns String
    Integer iPos
    Move (Pos("|", sRecord)) to iPos
    If (iPos = 0) ;
        Function_Return (Trim(sRecord))
    Function_Return (Trim(Left(sRecord, (iPos - 1))))
End_Function

// The day half of a record as a person writes it - "7 October 2026" - or "" when the record carries no
// day, or one that is not a yyyy-mm-dd date: the Start Center then leaves the date out rather than
// printing a broken one.
Function WorkspaceCopyRecordDateText Global String sRecord Returns String
    String sIso sCh
    String[] asMonths
    Integer iPos i iYear iMonth iDay

    Move (Pos("|", sRecord)) to iPos
    If (iPos = 0) ;
        Function_Return ""
    Move (Trim(Mid(sRecord, Length(sRecord), (iPos + 1)))) to sIso
    If (Length(sIso) <> 10) ;
        Function_Return ""
    For i from 1 to 10
        Move (Mid(sIso, 1, i)) to sCh
        If (i = 5 or i = 8) Begin
            If (sCh <> "-") ;
                Function_Return ""
        End
        Else If (Pos(sCh, "0123456789") = 0) ;
            Function_Return ""
    Loop
    Move (Left(sIso, 4))   to iYear
    Move (Mid(sIso, 2, 6)) to iMonth
    Move (Mid(sIso, 2, 9)) to iDay
    If (iMonth < 1 or iMonth > 12 or iDay < 1 or iDay > 31) ;
        Function_Return ""
    Move (StrSplitToArray("January,February,March,April,May,June,July,August,September,October,November,December", ",")) to asMonths
    Function_Return (String(iDay) + " " + asMonths[iMonth - 1] + " " + String(iYear))
End_Function
