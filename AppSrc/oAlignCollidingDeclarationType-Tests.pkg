//****************************************************************************
// $Module type: Test fixture
// $Module name: oAlignCollidingDeclarationType-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-22
//
// Description : Unit tests for the AlignCollidingDeclarationType refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oAlignCollidingDeclarationType is a cTestFixture
        Set psFunctionName to "AlignCollidingDeclarationType"

        // THE pbSilent CASE (Nils 2026-07-22). Two packages declare it Boolean, one declares it String,
        // 151 errors follow. Nothing outside the workspace uses the name, so a rename would carry the
        // same disagreement to the new name - the majority type is what the odd one has to become.
        { Published = True }
        Procedure Align_MajorityTypeWins
            String[] asLines
            tNameDecl[] aDecls
            String sMajor
            Move "Property Boolean pbSilent False" to asLines[0]
            Move "Property String pbSilent False"  to asLines[1]
            Move "Property Boolean pbSilent False" to asLines[2]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _MajorityReturnType of ghoFuncLib aDecls to sMajor
            Send AssertSAreEqual "Boolean" sMajor
        End_Procedure

        // An even split has no odd one out. Picking a side would be a coin toss, so it declines to.
        { Published = True }
        Procedure Align_EvenSplitHasNoMajority
            String[] asLines
            tNameDecl[] aDecls
            String sMajor
            Move "Property Boolean pbSilent False" to asLines[0]
            Move "Property String pbSilent False"  to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _MajorityReturnType of ghoFuncLib aDecls to sMajor
            Send AssertSAreEqual "" sMajor
        End_Procedure

        // A single consistent type IS the majority - nothing to align, and the caller sees no odd rows.
        { Published = True }
        Procedure Align_ConsistentTypeIsItsOwnMajority
            String[] asLines
            tNameDecl[] aDecls
            String sMajor
            Move "Property Integer piWidth 0" to asLines[0]
            Move "Property Integer piWidth 5" to asLines[1]
            Get _NameDeclsFromLines of ghoFuncLib asLines "test.pkg" to aDecls
            Get _MajorityReturnType of ghoFuncLib aDecls to sMajor
            Send AssertSAreEqual "Integer" sMajor
        End_Procedure

        // THE WHOLE POINT: the odd declaration is corrected, the ones that already agree are not touched
        // (so the count reports real edits), and NO CALL SITE is rewritten. Touching a call site here
        // would be a bug - the name is not changing, only the type it was declared with.
        { Published = True }
        Procedure Align_RewritesOddDeclarationOnlyNeverCallSites
            String[] asCode
            Integer iChanged

            Move "    Property Boolean pbSilent False"  to asCode[0]
            Move "    Property String  pbSilent False"  to asCode[1]
            Move "    Set pbSilent to True"             to asCode[2]
            Move "    If (pbSilent(Self)) Begin"        to asCode[3]
            Move "    Get pbSilent of oX to bTmp"       to asCode[4]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asCode) "pbSilent" "Boolean" to iChanged
            Send Assert (iChanged = 1)
            Send AssertSAreEqual "    Property Boolean pbSilent False" asCode[0]
            Send AssertSAreEqual "    Property Boolean  pbSilent False" asCode[1]
            Send AssertSAreEqual "    Set pbSilent to True"             asCode[2]
            Send AssertSAreEqual "    If (pbSilent(Self)) Begin"        asCode[3]
            Send AssertSAreEqual "    Get pbSilent of oX to bTmp"       asCode[4]
        End_Procedure

        // A Function declaration carries its type after Returns, not before the name.
        { Published = True }
        Procedure Align_RewritesFunctionReturnsType
            String[] asCode
            Integer iChanged
            Move "    Function Value String sKey Returns Number"  to asCode[0]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asCode) "Value" "Variant" to iChanged
            Send Assert (iChanged = 1)
            Send AssertSAreEqual "    Function Value String sKey Returns Variant" asCode[0]
        End_Procedure

        // A parameter of the same type name must not be mistaken for the return type: only the token
        // after the LAST Returns is rewritten.
        { Published = True }
        Procedure Align_LeavesParameterTypesAlone
            String[] asCode
            Integer iChanged
            Move "    Function Value Number nKey Returns Number" to asCode[0]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asCode) "Value" "Variant" to iChanged
            Send Assert (iChanged = 1)
            Send AssertSAreEqual "    Function Value Number nKey Returns Variant" asCode[0]
        End_Procedure

        // Nothing to do when every declaration already agrees - an idempotent second run changes nothing.
        { Published = True }
        Procedure Align_AlreadyAlignedIsANoOp
            String[] asCode
            Integer iChanged
            Move "    Property Boolean pbSilent False" to asCode[0]
            Get _AlignDeclTypeInLines of ghoFuncLib (&asCode) "pbSilent" "Boolean" to iChanged
            Send Assert (iChanged = 0)
        End_Procedure

        // The gap that made the rename run silently do nothing: a PROPERTY is a declaration of the name
        // too, and _ClassesDeclaringName only knew about Function / Procedure / Procedure Set.
        { Published = True }
        Procedure Align_ClassesDeclaringNameSeesAProperty
            String[] asLines asOwners
            Move "Class cMailMan is a cComChilkatMailMan"   to asLines[0]
            Move "    Procedure Construct_Object"           to asLines[1]
            Move "        Property String pbSilent False"   to asLines[2]
            Move "    End_Procedure"                        to asLines[3]
            Move "End_Class"                                to asLines[4]
            Get _ClassesDeclaringName of ghoFuncLib asLines "pbSilent" to asOwners
            Send Assert (SizeOfArray(asOwners) = 1)
            Send AssertSAreEqual "cMailMan" asOwners[0]
        End_Procedure

    End_Object
