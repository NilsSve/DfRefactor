// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeOemFileCommands is a cTestFixture
        Set psFunctionName to "ChangeOemFileCommands"

        // File_Exist_Oem -> File_Exist, arguments untouched.
        { Published = True }
        Procedure ChangeOemFileCommands_FileExist
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'File_Exist_Oem sArtPath bExist' to sLine
            Move 'File_Exist sArtPath bExist' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The install spells it EraseFile; this source spells it Erasefile. The COMMAND's own
        // casing is normalised - it is the name being replaced - and the arguments' is not.
        { Published = True }
        Procedure ChangeOemFileCommands_NormalisesCommandCasing
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Erasefile_Oem (Trim(MOD_DOC.doc))' to sLine
            Move 'EraseFile (Trim(MOD_DOC.doc))' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A "to" clause is an argument like any other - CopyFile_Oem keeps both sides.
        { Published = True }
        Procedure ChangeOemFileCommands_CopyFileKeepsToClause
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'CopyFile_Oem sArtPath to (sTemp + sFileName)' to sLine
            Move 'CopyFile sArtPath to (sTemp + sFileName)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Indentation and a preceding If (the "nose") survive - the real WinServ line.
        { Published = True }
        Procedure ChangeOemFileCommands_KeepsIndentAndNose
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bRemove and bExist) EraseFile_OEM sFrom' to sLine
            Move '    If (bRemove and bExist) EraseFile sFrom' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Direct_Input_Oem, the fourth of the family found in a live workspace.
        { Published = True }
        Procedure ChangeOemFileCommands_DirectInput
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Direct_Input_Oem infil' to sLine
            Move 'Direct_Input infil' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // IDEMPOTENT: an already-converted line is not touched and reports no change, so a
        // second pass over a converted workspace is a no-op rather than a rewrite.
        { Published = True }
        Procedure ChangeOemFileCommands_AlreadyConvertedIsUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'File_Exist sArtPath bExist' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual 'File_Exist sArtPath bExist' sLine
        End_Procedure

        // The name inside a STRING is text, not a command. Without this the converter would
        // edit the messages and log lines that merely mention it.
        { Published = True }
        Procedure ChangeOemFileCommands_StringLiteralIsNotACommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move "File_Exist_Oem failed" to sMsg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'Move "File_Exist_Oem failed" to sMsg' sLine
        End_Procedure

        // A longer identifier merely CONTAINING the name is a different token. The POSITIVE
        // CONTROL is in the tests above: the same command bare does convert, so a pass here
        // is the boundary working rather than the converter having stopped.
        { Published = True }
        Procedure ChangeOemFileCommands_LongerIdentifierIsNotTheCommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move iFile_Exist_OemCount to iTotal' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeOemFileCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual 'Move iFile_Exist_OemCount to iTotal' sLine
        End_Procedure

    End_Object
