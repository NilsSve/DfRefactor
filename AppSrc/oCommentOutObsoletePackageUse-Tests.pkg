//****************************************************************************
// $Module type: Test fixture
// $Module name: oCommentOutObsoletePackageUse-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for CommentOutObsoletePackageUse - comments out 'Use <pkg>' for obsolete packages the
//               compiler flags 4536 as removable (their content is in FMAC / the runtime), e.g. Case.mac.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCommentOutObsoletePackageUse is a cTestFixture
        Set psFunctionName to "CommentOutObsoletePackageUse"

        {Published = True}
        Procedure CommentOutObsoletePackageUse_CaseMac
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "Use Case.mac" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (Left(sLine, 3) = "// ")
            Send Assert (sLine contains "Use Case.mac")
            Send Assert (sLine contains "4536")
        End_Procedure

        // Case-insensitive keyword + package basename.
        {Published = True}
        Procedure CommentOutObsoletePackageUse_CaseInsensitive
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "use case.MAC" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (Left(sLine, 3) = "// ")
        End_Procedure

        // Indentation is preserved (the '// ' goes AFTER the leading whitespace).
        {Published = True}
        Procedure CommentOutObsoletePackageUse_IndentPreserved
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "    Use dfbase.pkg" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    // Use dfbase.pkg   // 4536: obsolete package, safe to remove" sLine
        End_Procedure

        // A path-qualified Use still matches by basename.
        {Published = True}
        Procedure CommentOutObsoletePackageUse_PathQualified
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "Use MyLib\case.mac" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (Left(sLine, 3) = "// ")
        End_Procedure

        // A NON-removable package (needs a code change, not a removal) is left alone.
        {Published = True}
        Procedure CommentOutObsoletePackageUse_NonRemovableUntouched
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "Use cWinReport2.pkg" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Use cWinReport2.pkg" sLine
        End_Procedure

        // Idempotent: an already-commented line is not touched (no double-comment).
        {Published = True}
        Procedure CommentOutObsoletePackageUse_AlreadyCommented
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "// Use Case.mac" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "// Use Case.mac" sLine
        End_Procedure

        // A non-Use line is left alone.
        {Published = True}
        Procedure CommentOutObsoletePackageUse_NonUseUntouched
            String sLine
            Boolean bChanged
            tTokenizer TD
            Move "Move 1 to iCase" to sLine
            Get Tokenizer of ghoFuncLib sLine to TD
            Get CommentOutObsoletePackageUse of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move 1 to iCase" sLine
        End_Procedure

    End_Object
