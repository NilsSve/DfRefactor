//****************************************************************************
// $Module type: Test fixture
// $Module name: oUnicodeWin64ReportExternalFunction-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-02
//
// Description : Unit tests for the External_Function audit DETECTION CORE (_AuditApiDeclaration +
//               _SuggestPointerType in cRefactorUtilities) - the heart of UnicodeWin64ReportExternalFunction.
//               Each test passes ONE logical declaration string and checks the findings. The file-scan
//               + log-writing orchestration (cExternalFunctionAudit) is integration-tested in the app,
//               like the other Report* functions. Findings are "<type> <name> -> <suggested>" lines.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oUnicodeWin64ReportExternalFunction is a cTestFixture
        Set psFunctionName to "UnicodeWin64ReportExternalFunction"

        // Integer hWnd -> Handle (Hungarian h + uppercase).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_HandleParam_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer hWnd Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Integer hWnd -> Handle" asFindings[0]
        End_Procedure

        // Integer lParam -> Longptr.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_LongptrParam_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer lParam Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Integer lParam -> Longptr" asFindings[0]
        End_Procedure

        // Integer lpBuffer -> Pointer (lp* prefix).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_PointerParam_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer lpBuffer Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Integer lpBuffer -> Pointer" asFindings[0]
        End_Procedure

        // Integer cbSize -> ULongptr (size_t-ish).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_ULongptrParam_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer cbSize Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Integer cbSize -> ULongptr" asFindings[0]
        End_Procedure

        // String param in an ANSI ("...A") wrapper -> WString (Unicode A->W).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiStringParam_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "GetFooA" user32.dll String lpName Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "String lpName -> WString" asFindings[0]
        End_Procedure

        // An Integer param with no pointer-sized name signal is left alone.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_CleanIntParam_NotFlagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer nIndex Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // Idempotent: an already-correct Handle param (not Integer/DWord) is not flagged.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AlreadyCorrect_NotFlagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Handle hWnd Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // ByRef/ByVal between type and name is skipped (still flags Integer hWnd).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_ByRef_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "Foo" user32.dll Integer ByRef hWnd Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Integer hWnd -> Handle" asFindings[0]
        End_Procedure

        // Combined: an ANSI Create* wrapper flags BOTH the String param (->WString) and the
        // Integer return (->Handle).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_CreateAnsi_Flagged
            String[] asFindings
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AuditApiDeclaration of ghoFuncLib 'External_Function Foo "CreateFileA" kernel32.dll String lpFileName Returns Integer' (&asFindings) to iCount
            Send Assert (iCount = 2)
            Send AssertSAreEqual "String lpFileName -> WString" asFindings[0]
            Send AssertSAreEqual "Returns Integer -> Handle" asFindings[1]
        End_Procedure

        // ---- _AnsiExternalName: the pass-2 (call sites) collection core. ----

        // An ANSI ("...A") declaration returns the DataFlex-side name; entry + dll come back ByRef.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiName_AnsiDecl_ReturnsName
            String sName sEntry sDll
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiExternalName of ghoFuncLib 'External_Function RFGetFoo "GetFooA" user32.dll String lpName Returns Integer' (&sEntry) (&sDll) to sName
            Send AssertSAreEqual "RFGetFoo" sName
            Send AssertSAreEqual "GetFooA" sEntry
            Send AssertSAreEqual "user32.dll" sDll
        End_Procedure

        // A wide ("...W") declaration is not an A->W migration candidate: empty name back.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiName_WideDecl_ReturnsEmpty
            String sName sEntry sDll
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiExternalName of ghoFuncLib 'External_Function RFGetFoo "GetFooW" user32.dll WString lpName Returns Integer' (&sEntry) (&sDll) to sName
            Send AssertSAreEqual "" sName
        End_Procedure

        // External_Procedure declarations are collected too.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiName_ExternalProcedure_ReturnsName
            String sName sEntry sDll
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiExternalName of ghoFuncLib 'External_Procedure RFSetFoo "SetFooA" kernel32.dll String lpName' (&sEntry) (&sDll) to sName
            Send AssertSAreEqual "RFSetFoo" sName
            Send AssertSAreEqual "SetFooA" sEntry
        End_Procedure

        // A non-declaration line (an ordinary call) yields "".
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiName_CallLine_ReturnsEmpty
            String sName sEntry sDll
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiExternalName of ghoFuncLib 'Move (RFGetFoo(sName)) to iRet' (&sEntry) (&sDll) to sName
            Send AssertSAreEqual "" sName
        End_Procedure

        // ---- _AnsiCallSitePos: boundary-aware call detection (inputs pre-lowercased). ----

        // A direct expression call is found.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiCallSite_DirectCall_Found
            Integer iPos
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiCallSitePos of ghoFuncLib 'move (rfgetfoo(sname)) to iret' 'rfgetfoo' to iPos
            Send Assert (iPos > 0)
        End_Procedure

        // DataFlex's optional-space call form "name (arg)" is found too.
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiCallSite_SpaceForm_Found
            Integer iPos
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiCallSitePos of ghoFuncLib 'move (rfgetfoo (sname)) to iret' 'rfgetfoo' to iPos
            Send Assert (iPos > 0)
        End_Procedure

        // The name inside a LONGER identifier must not match (right boundary).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiCallSite_LongerIdentifier_NotFound
            Integer iPos
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiCallSitePos of ghoFuncLib 'move (rfgetfoobar(sname)) to iret' 'rfgetfoo' to iPos
            Send Assert (iPos = 0)
        End_Procedure

        // The name as a SUFFIX of a longer identifier must not match (left boundary).
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiCallSite_SuffixIdentifier_NotFound
            Integer iPos
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiCallSitePos of ghoFuncLib 'move (myrfgetfoo(sname)) to iret' 'rfgetfoo' to iPos
            Send Assert (iPos = 0)
        End_Procedure

        // The declaration line itself is no call site (the name is followed by the quoted
        // entry point, never a "(").
        {Published = True}
        Procedure UnicodeWin64ReportExternalFunction_AnsiCallSite_DeclarationLine_NotFound
            Integer iPos
            Send ClearFuncLibProperties of ghoFuncLib
            Get _AnsiCallSitePos of ghoFuncLib 'external_function rfgetfoo "getfooa" user32.dll string lpname returns integer' 'rfgetfoo' to iPos
            Send Assert (iPos = 0)
        End_Procedure

    End_Object
