//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeParsePathPairToExtractFilePath-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-29
//
// Description : Unit tests for ChangeParsePathPairToExtractFilePath - the whole-file
//               (eOtherFunction) refactor that collapses the legacy three-part path split
//                   Get Parse_Path  <spec> to <sPath>
//                   Get Parse_Drive <spec> to <sDrive>
//                   ... (sDrive + sPath) ...
//               into
//                   Get ExtractFilePath <spec> to <sPath>
//                   ... sPath ...
//
//               It DELETES a line, so most of these tests are the ones that must NOT fire.
//               Each checks the returned count AND the resulting array length - a collapse that
//               failed to remove the Parse_Drive line would otherwise pass on the count alone.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeParsePathPairToExtractFilePath is a cTestFixture
        Set psFunctionName to "ChangeParsePathPairToExtractFilePath"

        // The shape from cExecuteFileFloater.Pkg, joined with "+".
        {Published = True}
        Procedure ParsePathPair_PlusJoin_Collapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                     to asCode[0]
            Move "    String sDirectory sPath sDrive"                to asCode[1]
            Move "    Get Parse_Path sDirectory to sPath"            to asCode[2]
            Move "    Get Parse_Drive sDirectory to sDrive"          to asCode[3]
            Move "    Move (sDrive + sPath) to sDirectory"           to asCode[4]
            Move "End_Procedure"                                     to asCode[5]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get ExtractFilePath sDirectory to sPath" asCode[2]
            Send AssertSAreEqual "    Move sPath to sDirectory"                asCode[3]
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // The shape from FAEmail.VW / CompFiLi.VW / SENDMSG.DG, joined with "-" inside a
        // larger statement rather than a bare Move.
        {Published = True}
        Procedure ParsePathPair_MinusJoinInExpression_Collapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                          to asCode[0]
            Move "    String sFilename sPath sDrive"                      to asCode[1]
            Move "    Get Parse_Path sFilename    to sPath"               to asCode[2]
            Move "    Get Parse_Drive sFilename   to sDrive"              to asCode[3]
            Move "    Set Value of (oform4(Self)) to (sDrive - sPath)"    to asCode[4]
            Move "End_Procedure"                                          to asCode[5]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get ExtractFilePath sFilename to sPath"       asCode[2]
            Send AssertSAreEqual "    Set Value of (oform4(Self)) to sPath"          asCode[3]
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // The OhDocAm.VW / ArtHRegx.VW shape: both results assigned and never read again.
        // Nothing to rejoin, so the pair still collapses.
        {Published = True}
        Procedure ParsePathPair_ResultsNeverUsed_Collapsed
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                     to asCode[0]
            Move "    String sFilename sPath sDrive"                 to asCode[1]
            Move "    Get Parse_Path sFilename to sPath"             to asCode[2]
            Move "    Get Parse_Drive sFilename to sDrive"           to asCode[3]
            Move "    Send DoSomethingElse"                          to asCode[4]
            Move "End_Procedure"                                     to asCode[5]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get ExtractFilePath sFilename to sPath" asCode[2]
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // GUARD: the drive is used somewhere this cannot rewrite, so the whole pair is
        // abandoned - and the file must come back completely untouched, not half-done.
        {Published = True}
        Procedure ParsePathPair_DriveUsedSeparately_Untouched
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                     to asCode[0]
            Move "    String sFilename sPath sDrive"                 to asCode[1]
            Move "    Get Parse_Path sFilename to sPath"             to asCode[2]
            Move "    Get Parse_Drive sFilename to sDrive"           to asCode[3]
            Move "    Set Value of (oDriveForm(Self)) to sDrive"     to asCode[4]
            Move "End_Procedure"                                     to asCode[5]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Get Parse_Path sFilename to sPath"          asCode[2]
            Send AssertSAreEqual "    Get Parse_Drive sFilename to sDrive"        asCode[3]
            Send AssertSAreEqual "    Set Value of (oDriveForm(Self)) to sDrive"  asCode[4]
            Send Assert ((SizeOfArray(asCode)) = 6)
        End_Procedure

        // GUARD: the two calls parse DIFFERENT variables, so they are not a pair.
        {Published = True}
        Procedure ParsePathPair_DifferentSpecs_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                     to asCode[0]
            Move "    String sOne sTwo sPath sDrive"                 to asCode[1]
            Move "    Get Parse_Path sOne to sPath"                  to asCode[2]
            Move "    Get Parse_Drive sTwo to sDrive"                to asCode[3]
            Move "End_Procedure"                                     to asCode[4]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        // GUARD: a trailing comment on the Parse_Drive line would be DELETED with it.
        {Published = True}
        Procedure ParsePathPair_CommentOnDeletedLine_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                          to asCode[0]
            Move "    String sFilename sPath sDrive"                      to asCode[1]
            Move "    Get Parse_Path sFilename to sPath"                  to asCode[2]
            Move "    Get Parse_Drive sFilename to sDrive  // keep me"    to asCode[3]
            Move "End_Procedure"                                          to asCode[4]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        /* A comment on the Parse_Path line SURVIVES - that line is renamed, not deleted, so
           refusing it would cost a conversion for nothing. CompFiLi.VW carries exactly this
           ("//ver15"), so without this the real workspace would have one site left behind. */
        {Published = True}
        Procedure ParsePathPair_CommentOnRenamedLine_Kept
            String[] asCode
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                                          to asCode[0]
            Move "    String sFilename sPath sDrive"                      to asCode[1]
            Move "    Get Parse_Path sFilename to sPath          //ver15" to asCode[2]
            Move "    Get Parse_Drive sFilename to sDrive"                to asCode[3]
            Move "End_Procedure"                                          to asCode[4]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send Assert (asCode[2] contains "ExtractFilePath")
            Send Assert (asCode[2] contains "//ver15")
            Send Assert ((SizeOfArray(asCode)) = 4)
        End_Procedure

        // A lone Parse_Path with no Parse_Drive after it is not a pair.
        {Published = True}
        Procedure ParsePathPair_LoneParsePath_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Procedure Foo"                             to asCode[0]
            Move "    String sFilename sPath"                to asCode[1]
            Move "    Get Parse_Path sFilename to sPath"     to asCode[2]
            Move "    Send Something"                        to asCode[3]
            Move "End_Procedure"                             to asCode[4]
            Get ChangeParsePathPairToExtractFilePath of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert ((SizeOfArray(asCode)) = 5)
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
