Use cFTModalPanel.pkg
Use Cursor.pkg
Use vWin32fh.pkg
Use cFTCJSelectionGrid.pkg
Use cRDCButtonDPI.pkg
Use RefactorConstants.h.pkg
Use cFTGridHost.pkg              // FT: the button bar - one host on a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg   // FT: cFTWebButton - the bar's buttons
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette
//Use cUnusedSourceFiles.pkg

Object oOtherLogFiles_dg is a cFTModalPanel
    Set Label to "Log Files for Function Type: eOther/Report_Function(All)"
    Set Size to 209 513
    Set Location to 2 2
    Set piMinSize to 209 366
    Set Icon to "OtherLogFiles.ico"

    Property String[] pasOtherLogFiles
    // The selected log-file path, read in View's own OnClick - inside the web click, a grid-safe context;
    // DoViewLog, run after the click, reads it - a by-handle grid GET from a timer faults err 98.
    Property String psCapLogFile

    Object oTextBox1 is a TextBox
        Set Size to 9 86
        Set Location to 3 25
        Set Label to "Right click grid for options"
    End_Object

    Object oOtherLogFiles_grd is a cFTCJSelectionGrid
        Set Size to 164 485
        Set Location to 14 14
        Set pbAllowEdit to False
        Set pbAutoAppend to False
        Set pbAutoSave to False
        Set pbEditOnClick to False
        Set pbEditOnTyping to False

        Object oSourceFile_col is a cCJGridColumn
            // This must be here:
            Set phoData_Col to Self
            Set piWidth to 809
            Set psCaption to "Full Path and File Name"
        End_Object

        Procedure LoadData
            Handle hoDataSource
            tDataSourceRow[] TheData TheDataEmpty
            String[] asOtherLogFiles
            Integer iSize iRow iCount iDataCol iCheckBoxCol

            If (not(IsComObjectCreated(Self))) Begin
                Procedure_Return
            End

            Get pasOtherLogFiles to asOtherLogFiles
            Move (SizeOfArray(asOtherLogFiles)) to iSize
            If (iSize = 0) Begin
                Procedure_Return
            End

            Move 0 to iCount
            Decrement iSize
            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move TheDataEmpty to TheData
            Get piColumnId of oSourceFile_col         to iDataCol
            Get piColumnId of (phoCheckbox_Col(Self)) to iCheckBoxCol

            Move 0 to iRow
            For iCount from 0 to iSize                  
                Move asOtherLogFiles[iCount] to TheData[iRow].sValue[iDataCol]
                Move False  to TheData[iRow].sValue[iCheckBoxCol]
                Increment iRow
            Loop

            If (iRow <> 0) Begin
                Send ReInitializeData TheData False
                Send MoveToFirstRow
            End
            Else Begin
                Send InitializeData TheDataEmpty
            End
            Move (iSize + 1) to iCount
            Set psFooterText of oSourceFile_col  to ("No of Log Files:" * String(iCount))
        End_Procedure

        Procedure OpenLogFile
            String sLogFile
            Get SelectedRowValue of oSourceFile_col to sLogFile
            If (sLogFile <> "") Begin
                Send ActivateEngineLogFile sLogFile
            End
        End_Procedure
        
        Procedure OnComRowDblClick Variant llRow Variant llItem
            Forward Send OnComRowDblClick llRow llItem
            Send OpenLogFile
        End_Procedure
        
        On_Key kEnter Send OpenLogFile    
    End_Object

    /* THE BUTTON BAR: one grid host of 8 px columns and two framework buttons (cFTWebButton, RDCFlexTron). A
       button's work runs in OnButtonClick, after the web click has returned (the library's click relay), so a
       panel can open or close there - no timer of this dialog's own. View reads the grid's selected row in its
       OnClick first, inside the click: a grid read from a timer faults err 98 (BackupFilesFT). Column 0 takes
       the rest of the width, so the buttons keep to the right edge; each span fits its caption (View Log File
       ~113 px, Close ~71 px, measured 2026-09-30). Until then this bar was HTML chips (BarButtonHtml) with a
       click-id OnClick and a 1 ms defer timer - the pilot of the FT bars on the library's classes. */
    Object oWebBottomBar is a cFTGridHost
        Set Location to 182 254
        Set Size to 20 249
        Set peAnchors to anBottomRight
        Set piColumnCount to 28         // column 0, then View's 16 and Close's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oViewBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 16
            Set psCaption to "View Log File"
            Set psCSSClass to "ftbtn ftg-check"
            Set psToolTip to "Open the selected log file in a dialog."

            // The selected row, read here inside the click (see above); OnButtonClick opens it after.
            Procedure OnClick
                String sVal
                Get SelectedRowValue of oSourceFile_col to sVal
                Set psCapLogFile of (oOtherLogFiles_dg(Self)) to sVal
                Forward Send OnClick
            End_Procedure

            Procedure OnButtonClick
                Send DoViewLog of (oOtherLogFiles_dg(Self))
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piColumnIndex to 17
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close this dialog."

            Procedure OnButtonClick
                Send DoClose of (oOtherLogFiles_dg(Self))
            End_Procedure
        End_Object
    End_Object

    // The View action (was oOK_Btn.OnClick -> grid OpenLogFile), run from the View button's OnButtonClick,
    // after the web click. Uses the row value captured in its OnClick (psCapLogFile) - never re-queries the grid.
    Procedure DoViewLog
        String sLogFile
        Get psCapLogFile to sLogFile
        If (sLogFile <> "") Begin
            Send ActivateEngineLogFile sLogFile
        End
    End_Procedure

    // The Close action (was oCancel_Btn.OnClick), from the Close button's OnButtonClick and from Alt+C. Both
    // run inside the modal's own message pump, so Close_Panel cleanly ends the modal loop.
    Procedure DoClose
        Send Close_Panel
    End_Procedure

    On_Key Key_Alt+Key_A  Send SelectAll    of oOtherLogFiles_grd
    On_Key Key_Ctrl+Key_A Send SelectAll    of oOtherLogFiles_grd
    On_Key Key_Alt+Key_N  Send SelectNone   of oOtherLogFiles_grd
    On_Key Key_Ctrl+Key_N Send SelectNone   of oOtherLogFiles_grd
    On_Key Key_Alt+Key_I  Send SelectInvert of oOtherLogFiles_grd
    On_Key Key_Ctrl+Key_I Send SelectInvert of oOtherLogFiles_grd
    On_Key Key_Alt+Key_C  Send DoClose      // was KeyAction of oCancel_Btn (now the web Close button)
End_Object

Procedure ShowOtherLogFilesDialog String[] asOtherLogFiles
    Handle ho
    Move (oOtherLogFiles_dg(Self)) to ho
    Set pasOtherLogFiles of ho to asOtherLogFiles
    Send Popup of ho
End_Procedure
