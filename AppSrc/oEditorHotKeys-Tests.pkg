//****************************************************************************
// $Module type: Test fixture
// $Module name: oEditorHotKeys-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-28
//
// Description : Characterization for the editor's hotkey engine, ahead of bringing it home from
//               SciControlLib (cSciCommandHotKeySupport.pkg, 1,219 lines).
//
//               WHY A NET. This code owns the user's saved keyboard bindings. psEditorHotKeys is a
//               single string in ScintillaEdit.json holding every assignment as
//
//                   <cmd|dfkey|vk|vk...>
//
//               with a ":" introducing a second binding for the same command. Command IDs are the
//               CodeMax numbers (CMD_FIRST + n) and are DATA, not just constants - the same trap that
//               nearly bit yesterday, when a guessed CMD_FIRST of 42000 would have silently repointed
//               every shortcut a user had ever set. A port that round-trips a different string, or
//               maps a shortcut to a different DataFlex key code, breaks people's muscle memory with
//               nothing failing loudly.
//
//               So these tests pin the two things a replacement has to reproduce exactly:
//
//                 * the SERIALIZED FORM  - what lands in psEditorHotKeys, character for character
//                 * the KEY MAPPING      - tShortCut -> the DataFlex On_Key code the bindings dispatch on
//
//               They run against the LIVE oSciCommandHotKeys, because that is the object the program
//               and the settings dialog both drive. Each test snapshots ShortCutKeyDefinitions on the
//               way in and puts it back on the way out, so a run leaves the user's real bindings
//               exactly as it found them - nothing is ever sent to disk (no SaveIni here).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cRefactorEditorSettings.pkg    // already loaded by the runner .src; brings the
                                   // hotkey support with it

Object oEditorHotKeys is a cTestFixture
    Set psFunctionName to "EditorHotKeys"

    // Snapshot / restore, so these tests cannot cost the user their bindings.
    Function SaveBindings Returns String
        Function_Return (ShortCutKeyDefinitions(oSciCommandHotKeys))
    End_Function

    Procedure RestoreBindings String sSaved
        Set ShortCutKeyDefinitions of oSciCommandHotKeys to sSaved
    End_Procedure

    // Build a shortcut the way the settings dialog does: a DataFlex key code plus the
    // Windows virtual keys that produced it.
    Function MakeShortCut Integer iDfKey Integer[] VKcodes Returns tShortCut
        tShortCut ShortCut
        Move iDfKey   to ShortCut.iDFKey
        Move VKcodes  to ShortCut.VKcode
        Function_Return ShortCut
    End_Function

    /* THE SERIALIZED FORM. Assign one known shortcut to one known command and pin the
       exact text. This is the string that goes into psEditorHotKeys, so its shape is a
       compatibility contract with every settings file already out there - not an
       implementation detail a rewrite may tidy. */
    {Published = True}
    Procedure EditorHotKeys_SerializedFormIsExact
        Integer[] Keys
        String sSaved sDefs
        tShortCut ShortCut

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        // Ctrl+Shift+F3 on Find Next: DataFlex 5138-style code plus its three VKs.
        Move VK_CONTROL to Keys[0]
        Move VK_SHIFT   to Keys[1]
        Move VK_F3      to Keys[2]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut

        Get ShortCutKeyDefinitions of oSciCommandHotKeys to sDefs
        Send AssertSAreEqual ("<" + String(CMD_FINDNEXT) + "|5138|" + String(VK_CONTROL) ;
                              + "|" + String(VK_SHIFT) + "|" + String(VK_F3) + ">") sDefs

        Send RestoreBindings sSaved
    End_Procedure

    // ...and it must survive the round trip it was designed for: what the settings file
    // holds, read back, produces the same file.
    {Published = True}
    Procedure EditorHotKeys_DefinitionsRoundTrip
        Integer[] Keys
        String sSaved sFirst sSecond
        tShortCut ShortCut

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        Move VK_CONTROL to Keys[0]
        Move VK_F3      to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut
        Move VK_CONTROL to Keys[0]
        Move VK_G       to Keys[1]
        Get MakeShortCut 5127 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_GOTOLINE ShortCut

        Get ShortCutKeyDefinitions of oSciCommandHotKeys to sFirst
        Set ShortCutKeyDefinitions of oSciCommandHotKeys to sFirst
        Get ShortCutKeyDefinitions of oSciCommandHotKeys to sSecond
        Send AssertSAreEqual sFirst sSecond

        Send RestoreBindings sSaved
    End_Procedure

    // Assigning and removing are what the Keyboard page does. A removed binding leaves
    // the command present but unbound - not deleted from the list.
    {Published = True}
    Procedure EditorHotKeys_AssignAndRemove
        Boolean bHas
        Integer[] Keys
        String sSaved
        tShortCut ShortCut
        tSciCommandHotKey Command

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        Get FindCommand of oSciCommandHotKeys CMD_FINDNEXT to Command
        Send AssertIAreEqual CMD_FINDNEXT Command.iCmd
        Get CommandHasHotKey of oSciCommandHotKeys Command to bHas
        Send AssertFalse bHas

        Move VK_CONTROL to Keys[0]
        Move VK_F3      to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut
        Get FindCommand of oSciCommandHotKeys CMD_FINDNEXT to Command
        Get CommandHasHotKey of oSciCommandHotKeys Command to bHas
        Send Assert bHas

        Send RemoveShortCutFromCmd of oSciCommandHotKeys CMD_FINDNEXT
        Get FindCommand of oSciCommandHotKeys CMD_FINDNEXT to Command
        // The command survives, unbound.
        Send AssertIAreEqual CMD_FINDNEXT Command.iCmd
        Get CommandHasHotKey of oSciCommandHotKeys Command to bHas
        Send AssertFalse bHas

        Send RestoreBindings sSaved
    End_Procedure

    /* THE KEY MAPPING. DataFlexOnKey turns a stored shortcut into the code an On_Key
       binding dispatches on, and its arithmetic is the least obvious thing in the file:
       a base offset of 32, a different offset for one narrow range, and a modifier
       calculation that DELIBERATELY collapses back to zero when only one modifier is
       held. Pinned by example rather than by re-deriving the formula - if a rewrite
       changes any of these numbers, real shortcuts stop firing. */
    {Published = True}
    Procedure EditorHotKeys_DataFlexOnKeyMapping
        Integer iKey
        Integer[] Keys
        tShortCut ShortCut

        // A plain function key: iDFKey inside the 605..3142 band, less the 32 offset.
        Move VK_F3 to Keys[0]
        Get MakeShortCut 1082 Keys to ShortCut
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iKey
        Send AssertIAreEqual 1050 iKey

        // ONE modifier: the offset collapses to zero, so the code passes through.
        Move VK_CONTROL to Keys[0]
        Move VK_F3      to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iKey
        Send AssertIAreEqual 5138 iKey

        // TWO modifiers: the |CI$EF8 correction applies.
        Move VK_CONTROL to Keys[0]
        Move VK_SHIFT   to Keys[1]
        Move VK_F3      to Keys[2]
        Get MakeShortCut 5138 Keys to ShortCut
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iKey
        Send AssertIAreEqual (5138 - 3832) iKey
    End_Procedure

    // What the context menu shows next to a command. Empty for an unbound command -
    // the menu builder relies on that to decide whether to append anything at all.
    {Published = True}
    Procedure EditorHotKeys_CommandToHotKeyStringIsEmptyWhenUnbound
        Integer[] Keys
        String sSaved sText
        tShortCut ShortCut

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        Get CommandHotKeyText CMD_FINDNEXT to sText
        Send AssertSAreEqual "" sText

        Move VK_CONTROL to Keys[0]
        Move VK_F3      to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut
        Get CommandHotKeyText CMD_FINDNEXT to sText
        Send Assert (sText <> "")
        Send Assert (Uppercase(sText) contains "F3")

        Send RestoreBindings sSaved
    End_Procedure

    /* HotKeyHasAlt drives onPreHotKey, which swallows the keystroke before it reaches
       the text window. Only Alt combinations need that.

       NOTE THE RemoveShortCutFromCmd BETWEEN THE TWO ASSIGNMENTS, and do not drop it.
       AssignShortCutToCmd refuses a key that is already bound and says so in a modal
       Info box - "Already assigned to FindNext. You have to remove it there first."
       Both shortcuts here carry the same iDFKey, which is what the collision check
       compares, so assigning the second on top of the first pops that dialog. In the
       headless runner that is a modal box nobody can click; it appeared on Nils's screen
       2026-07-28. A characterization test must not drive a UI-coupled API into its
       error path.

       That the check lives this deep is itself worth carrying to the port: the engine
       announces a conflict by putting a dialog on screen, rather than returning a result
       and letting the caller decide. Worth separating when it comes home. */
    {Published = True}
    Procedure EditorHotKeys_HotKeyHasAlt
        Boolean bAlt
        Integer[] Keys
        String sSaved
        tShortCut ShortCut

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        Move VK_CONTROL to Keys[0]
        Move VK_F3      to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut
        Get HotKeyHasAlt of oSciCommandHotKeys CMD_FINDNEXT to bAlt
        Send AssertFalse bAlt

        Send RemoveShortCutFromCmd of oSciCommandHotKeys CMD_FINDNEXT
        Move VK_MENU to Keys[0]
        Move VK_F3   to Keys[1]
        Get MakeShortCut 5138 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_FINDNEXT ShortCut
        Get HotKeyHasAlt of oSciCommandHotKeys CMD_FINDNEXT to bAlt
        Send Assert bAlt

        Send RestoreBindings sSaved
    End_Procedure

    /* THE QUICK MARK DEFAULTS decode to the keys the editor claims by hand. Push and Pop are
       bound twice on purpose - through this table, and as literal On_Key lines in the editor's
       Construct_Object for the settings files saved before the commands existed - and the two
       must name the SAME key, or the menu advertises one shortcut while another one works. The
       stored code for a Ctrl+letter is 32 above the On_Key code (it carries the lowercase
       character and DataFlexOnKey takes that off), which is exactly the arithmetic a hand-typed
       default gets wrong - so the assertion is against the compiler's own constants, not
       against the numbers as typed. */
    {Published = True}
    Procedure EditorHotKeys_QuickMarkDefaultsDecodeToTheEditorsKeys
        String sSaved
        Integer iOnKey iKeys
        tShortCut ShortCut
        tSciCommandHotKey Command

        Get SaveBindings to sSaved
        Set ShortCutKeyDefinitions of oSciCommandHotKeys to (DefaultDefinitions(oSciCommandHotKeys))

        Get FindCommand of oSciCommandHotKeys CMD_QuickMarkPush to Command
        Send AssertIAreEqual CMD_QuickMarkPush Command.iCmd
        Move Command.HotKey to ShortCut
        Move (SizeOfArray(ShortCut.VKcode)) to iKeys
        Send AssertIAreEqual 2 iKeys
        Send AssertIAreEqual VK_CONTROL ShortCut.VKcode[0]
        Send AssertIAreEqual VK_Q       ShortCut.VKcode[1]
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iOnKey
        Send AssertIAreEqual (Key_Ctrl+Key_Q) iOnKey

        Get FindCommand of oSciCommandHotKeys CMD_QuickMarkPop to Command
        Send AssertIAreEqual CMD_QuickMarkPop Command.iCmd
        Move Command.HotKey to ShortCut
        Move (SizeOfArray(ShortCut.VKcode)) to iKeys
        Send AssertIAreEqual 3 iKeys
        Send AssertIAreEqual VK_SHIFT   ShortCut.VKcode[0]
        Send AssertIAreEqual VK_CONTROL ShortCut.VKcode[1]
        Send AssertIAreEqual VK_Q       ShortCut.VKcode[2]
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iOnKey
        Send AssertIAreEqual (Key_Ctrl+Key_Shift+Key_Q) iOnKey

        Send RestoreBindings sSaved
    End_Procedure

    // Go to definition's default is Ctrl+Shift+G, and it too is claimed by hand in the editor.
    {Published = True}
    Procedure EditorHotKeys_GotoDefinitionDefaultDecodesToTheEditorsKey
        String sSaved
        Integer iOnKey iKeys
        tShortCut ShortCut
        tSciCommandHotKey Command

        Get SaveBindings to sSaved
        Set ShortCutKeyDefinitions of oSciCommandHotKeys to (DefaultDefinitions(oSciCommandHotKeys))
        Get FindCommand of oSciCommandHotKeys CMD_GotoDefinition to Command
        Send AssertIAreEqual CMD_GotoDefinition Command.iCmd
        Move Command.HotKey to ShortCut
        Move (SizeOfArray(ShortCut.VKcode)) to iKeys
        Send AssertIAreEqual 3 iKeys
        Send AssertIAreEqual VK_SHIFT   ShortCut.VKcode[0]
        Send AssertIAreEqual VK_CONTROL ShortCut.VKcode[1]
        Send AssertIAreEqual VK_G       ShortCut.VKcode[2]
        Get DataFlexOnKey of oSciCommandHotKeys ShortCut to iOnKey
        Send AssertIAreEqual (Key_Ctrl+Key_Shift+Key_G) iOnKey
        Send RestoreBindings sSaved
    End_Procedure

    /* THE KEY-EVENT LOOKUP behind the editor's Key override: a binding answers to its own iDFKey -
       the value the Keyboard page captured - from either slot, and a code nobody bound answers -1. */
    {Published = True}
    Procedure EditorHotKeys_CommandForDfKeyAnswersEitherBindingsCode
        Integer[] Keys
        Integer iCmd
        String sSaved
        tShortCut ShortCut

        Get SaveBindings to sSaved
        Send ClearAllShortCutKeyDefinitions of oSciCommandHotKeys

        Move VK_SHIFT   to Keys[0]
        Move VK_CONTROL to Keys[1]
        Move VK_Q       to Keys[2]
        Get MakeShortCut (Key_Ctrl+Key_Shift+Key_Q) Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_QuickMarkPop ShortCut
        // A second binding on the same command lands in the second slot (AssignShortCutToCmd).
        Move (ResizeArray(Keys, 0)) to Keys
        Move VK_CONTROL to Keys[0]
        Move VK_F12     to Keys[1]
        Get MakeShortCut 4711 Keys to ShortCut
        Send AssignShortCutToCmd of oSciCommandHotKeys CMD_QuickMarkPop ShortCut

        Get CommandForDfKey of oSciCommandHotKeys (Key_Ctrl+Key_Shift+Key_Q) to iCmd
        Send AssertIAreEqual CMD_QuickMarkPop iCmd
        Get CommandForDfKey of oSciCommandHotKeys 4711 to iCmd
        Send AssertIAreEqual CMD_QuickMarkPop iCmd
        Get CommandForDfKey of oSciCommandHotKeys (Key_Ctrl+Key_Shift+Key_G) to iCmd
        Send AssertIAreEqual -1 iCmd
        Get CommandForDfKey of oSciCommandHotKeys 0 to iCmd
        Send AssertIAreEqual -1 iCmd

        Send RestoreBindings sSaved
    End_Procedure

End_Object
