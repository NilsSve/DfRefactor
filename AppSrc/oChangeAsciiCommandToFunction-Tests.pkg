    Object oChangeAsciiCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeAsciiCommandToFunction"

        // ASCII <arg> TO <dest> -> Move (Ascii(<arg>)) to <dest>. LegacyApp REDR0600.rv 'ASCII strINTERVALL_F TO nNUM_VAR'.
        { Published = True }
        Procedure ChangeAsciiCommandToFunction_BasicConvert
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    ASCII strINTERVALL_F TO nNUM_VAR' to sLine
            Move '    Move (Ascii(strINTERVALL_F)) to nNUM_VAR' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeAsciiCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation is preserved.
        { Published = True }
        Procedure ChangeAsciiCommandToFunction_PreservesIndent
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        ASCII sChar TO iVal' to sLine
            Move '        Move (Ascii(sChar)) to iVal' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeAsciiCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // An already-modern 'Move (Ascii(...))' (or any non-command use) is left untouched (needs 'ASCII <a> to <d>').
        { Published = True }
        Procedure ChangeAsciiCommandToFunction_NotACommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move (Ascii(sChar)) to iVal' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeAsciiCommandToFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
        End_Procedure

    End_Object
