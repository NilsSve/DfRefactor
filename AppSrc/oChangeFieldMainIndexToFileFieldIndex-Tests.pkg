    Object oChangeFieldMainIndexToFileFieldIndex is a cTestFixture
        Set psFunctionName to "ChangeFieldMainIndexToFileFieldIndex"

        Function _Convert String sLine Returns String
            Boolean bChanged
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeFieldMainIndexToFileFieldIndex of ghoFuncLib (&sLine) "" to bChanged
            Function_Return sLine
        End_Function

        // A Get and an expression call.
        {Published = True}
        Procedure ChangeFieldMainIndexToFileFieldIndex_Calls
            String sLine
            Get _Convert "    Get Field_Main_Index of iServer iFile iField to iOrder" to sLine
            Send AssertSAreEqual "    Get File_Field_Index of iServer iFile iField to iOrder" sLine
            Get _Convert "Move (File# > 0 And Field_Main_Index(Srvr,File#,Field#)>-1) To HasIndex" to sLine
            Send AssertSAreEqual "Move (File# > 0 And File_Field_Index(Srvr,File#,Field#)>-1) To HasIndex" sLine
        End_Procedure

        // An augmentation, the Forward Get inside one, a Register_Function line and a string stay.
        {Published = True}
        Procedure ChangeFieldMainIndexToFileFieldIndex_LeavesTheRest
            String[] asLines
            String sLine
            Integer i
            Boolean bAny
            Move "Function Field_Main_Index Integer iFile Integer iField Returns Integer"         to asLines[0]
            Move "    Forward Get Field_Main_Index iFile iField to iIndex"                        to asLines[1]
            Move "Register_Function Field_Main_Index Integer iFile Integer iField Returns Integer" to asLines[2]
            Move 'Move "Field_Main_Index" to sName'                                               to asLines[3]
            Move False to bAny
            For i from 0 to (SizeOfArray(asLines) - 1)
                Get _Convert asLines[i] to sLine
                If (sLine <> asLines[i]) ;
                    Move True to bAny
            Loop
            Send AssertFalse bAny
        End_Procedure

    End_Object
