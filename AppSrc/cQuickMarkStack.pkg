//****************************************************************************
// $Module type: Class Package
// $Module name: cQuickMarkStack
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-10
//
// Description : The Quick Mark stack behind the editor's Push / Pop Quick Mark commands: the
//               places a user has pushed, handed back newest first. Pure data - the editor
//               owns the Scintilla side (the margin glyph, the line tracking, the jump).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use VdfBase.pkg

/*  A Quick Mark is a PLACE, not a line number. sFile and iLine say where it was pushed; iHandle
    is the Scintilla marker that has been tracking that place through edits since - insert
    thirty lines above a mark and the marker moves with the text, so the mark still points at
    the line the user meant. A handle is only meaningful in the buffer it was added to, which
    is what iGen records: the editor bumps its document generation whenever the buffer is
    replaced (a file loaded, closed or rewritten), and a handle from an older generation is
    dead - the editor then falls back to iLine, the last line the handle reported. */
Struct tQuickMark
    String  sFile     // full path of the file the mark was pushed in
    Integer iLine     // 0-based line, as last known
    Integer iCol      // caret column when pushed - restored on pop
    Integer iHandle   // Scintilla marker handle; live only while iGen is the editor's current generation
    Integer iGen      // the document generation iHandle was added in
End_Struct

/*  cQuickMarkStack - a stack of tQuickMark, the bottom at index 0, the top at Count - 1.

    A STANDALONE CLASS, and PURE, so the console suite can create it and pin the rules without
    an editor control (UnitTests has no Scintilla under -c - the skip oScintillaEditor-
    Tests is built around). The editor keeps the entries' lines fresh through SetLine and their
    handles through SetHandle; this class decides only what a stack decides - order, emptiness,
    and whether a push records anything new. */
Class cQuickMarkStack is a cObject

    Procedure Construct_Object
        Forward Send Construct_Object
        Property tQuickMark[] paMarks
    End_Procedure

    Function Count Returns Integer
        tQuickMark[] aMarks
        Get paMarks to aMarks
        Function_Return (SizeOfArray(aMarks))
    End_Function

    /* Pushes QM and returns True - unless QM is the place already on top (same file, same line),
       which returns False and records nothing. Two presses of Ctrl+Q on one line would otherwise
       take two pops to leave, and the second pop would look as if it had done nothing. The same
       line in ANOTHER file is a different place and pushes. File names compare without case:
       Windows hides it, and the two spellings reach here from different sources. */
    Function PushMark tQuickMark QM Returns Boolean
        tQuickMark[] aMarks
        Integer iTop

        Get paMarks to aMarks
        Move (SizeOfArray(aMarks) - 1) to iTop
        If (iTop >= 0) Begin
            If (Lowercase(aMarks[iTop].sFile) = Lowercase(QM.sFile) and aMarks[iTop].iLine = QM.iLine) ;
                Function_Return False
        End
        Move QM to aMarks[iTop + 1]
        Set paMarks to aMarks
        Function_Return True
    End_Function

    // Removes the top into QM. False, and QM untouched, when the stack is empty.
    Function PopMark tQuickMark ByRef QM Returns Boolean
        tQuickMark[] aMarks
        Integer iTop

        Get paMarks to aMarks
        Move (SizeOfArray(aMarks) - 1) to iTop
        If (iTop < 0) ;
            Function_Return False
        Move aMarks[iTop] to QM
        Move (ResizeArray(aMarks, iTop)) to aMarks
        Set paMarks to aMarks
        Function_Return True
    End_Function

    // Reads the top into QM without removing it. False, and QM untouched, when empty.
    Function TopMark tQuickMark ByRef QM Returns Boolean
        tQuickMark[] aMarks
        Integer iTop

        Get paMarks to aMarks
        Move (SizeOfArray(aMarks) - 1) to iTop
        If (iTop < 0) ;
            Function_Return False
        Move aMarks[iTop] to QM
        Function_Return True
    End_Function

    // The entry at iIndex (0 = bottom). An empty tQuickMark when out of range.
    Function MarkAt Integer iIndex Returns tQuickMark
        tQuickMark[] aMarks
        tQuickMark QM

        Get paMarks to aMarks
        If (iIndex >= 0 and iIndex < SizeOfArray(aMarks)) ;
            Move aMarks[iIndex] to QM
        Function_Return QM
    End_Function

    // The editor's two write-backs: the line a live handle has just reported, and the handle a
    // freshly loaded buffer gave the mark. An out-of-range index is ignored.
    Procedure SetLine Integer iIndex Integer iLine
        tQuickMark[] aMarks

        Get paMarks to aMarks
        If (iIndex >= 0 and iIndex < SizeOfArray(aMarks)) Begin
            Move iLine to aMarks[iIndex].iLine
            Set paMarks to aMarks
        End
    End_Procedure

    Procedure SetHandle Integer iIndex Integer iHandle Integer iGen
        tQuickMark[] aMarks

        Get paMarks to aMarks
        If (iIndex >= 0 and iIndex < SizeOfArray(aMarks)) Begin
            Move iHandle to aMarks[iIndex].iHandle
            Move iGen    to aMarks[iIndex].iGen
            Set paMarks to aMarks
        End
    End_Procedure

    Procedure Clear
        tQuickMark[] aEmpty
        Set paMarks to aEmpty
    End_Procedure

End_Class
