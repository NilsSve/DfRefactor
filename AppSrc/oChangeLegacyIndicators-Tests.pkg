            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        {Published = True}
        // Regression (precision): a non-SELECT indicator on a line that merely mentions Select
        // as an assignment target must still refactor by default - the guard keys off the real
        // indicator ([Found]), not the incidental "to Select".
        Procedure ChangeLegacyIndicators_58
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Found] Move iA to Select' to sLine
            Move '   If (Found) Move (iA) to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression: a plain "If [indicator] <rest>" with no Indicate command must keep the rest of
        // the line. The old reconstruction collapsed "If [Found] Begin" into just "If".
        Procedure ChangeLegacyIndicators_59
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If [Found] Begin' to sLine
            Move '            If (Found) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression twin: the negated form, and the trailing scope keyword + end comment survive.
        Procedure ChangeLegacyIndicators_60
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If [~Found] Begin' to sLine
            Move '            If (Not(Found)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression: an end comment after the indicator + scope keyword is preserved.
        Procedure ChangeLegacyIndicators_61
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If [FindErr] Begin // do something' to sLine
            Move '    If (FindErr) Begin // do something' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression: a LEADING bracket + If + "Indicate ... as ..." 3-way compound is composed into an
        // explicit guarded block (it used to be mangled into "If Indicate (Found) to Found"). Both guards
        // are AND-combined with the condition parenthesised; the Move goes inside Begin/End; ne/eq are left
        // for the operator refactor. Contrast tests 38 (bracket+If), 37 (If+Indicate), 6 (If-cond bracket).
        Procedure ChangeLegacyIndicators_62
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        [Found] If sCustCode ne "" Indicate Found as Billto.Cust_Code eq sCustCode' to sLine
            Move ('        If (Found and (sCustCode ne "")) Begin' + C_NewLine + ;
                  '            Move (Billto.Cust_Code eq sCustCode) to Found' + C_NewLine + ;
                  '        End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression: a space right after "[" (e.g. "[ Found] Begin") - the tokenizer now merges a lone "["
        // into the next token, so the leading bracket is detected and refactored like "[Found] Begin".
        Procedure ChangeLegacyIndicators_63
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[ Found] Begin' to sLine
            Move 'If (Found) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Regression: the If-condition is an ALREADY-parenthesised expression "(sCust<>"")". The overstrike
        // line masks it, so the compose reads cond/target/expr from asLineTokens (restored) and must NOT
        // double-wrap the parens. Was half-done: "If (Found and ((sCust<>"") Indicate Found as ...))".
        Procedure ChangeLegacyIndicators_64
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Found] If (sCust<>"") Indicate Found as Invhead.Cust_Code eq sCust' to sLine
            Move ('If (Found and (sCust<>"")) Begin' + C_NewLine + ;
                  '    Move (Invhead.Cust_Code eq sCust) to Found' + C_NewLine + ;
                  'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // HARDENING (modes 2-3, 2026-06-30): the documented LegacyApp mangling cases. Every TESTED [bracket]Indicate
        // form has an "as"; the no-"as" form ([cond] Indicate X <value>) is untested and _ChangeLegacyIndicators_Sub
        // reuses the BRACKET indicator as the Move source -> "If (FINDERR) Move (FINDERR)", dropping the target.
        // Expected = the correct one-line guarded form (matches tests 8/10/34's style). These pin the bug down.
        {Published = True}
        // [cond] Indicate X <value>  (NO "as")  ->  If (cond) Move (<value>) to gbX
        Procedure ChangeLegacyIndicators_65
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[FINDERR] Indicate HITTAT FALSE' to sLine
            Move 'If (FINDERR) Move (FALSE) to gbHITTAT' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // [ind] Move <value> to <ind>  (indicator is ALSO the move target)  ->  If (ind) Move (<value>) to <ind>
        Procedure ChangeLegacyIndicators_66
