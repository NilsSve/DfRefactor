            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // [cond] Indicate X <value>  with distinct names + True value.
        Procedure ChangeLegacyIndicators_67
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Found] Indicate Done True' to sLine
            Move 'If (Found) Move (True) to gbDone' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
