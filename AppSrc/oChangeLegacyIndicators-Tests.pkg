            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        /* ALPHA REPORT (2026-08-28): test 67's shape as it appears in the wild - all lowercase,
           indented, multiple spaces between guard and command, and a trailing // comment. The
           comment is the untested part: the guard+Indicate composition rebuilds the line, and a
           tail comment must land AFTER the Move target, never inside the value expression. */
        {Published = True}
        Procedure ChangeLegacyIndicators_GuardedIndicateWithTrailingComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  [finderr]   indicate leeg True  // als database leeg altijd doorgaan' to sLine
            Move '  If (finderr) Move (True) to gbleeg // als database leeg altijd doorgaan' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // Same defect class, other scopes: the name inside a STRING LITERAL stays prose...
        {Published = True}
        Procedure ChangeLegacyIndicators_RenameSkipsStringLiterals
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[leeg] Move "leeg" to sStatus' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "(gbleeg)")
            Send Assert (sLine contains ('"' + "leeg" + '"'))
            Send Assert (not(sLine contains ('"' + "gbleeg" + '"')))
        End_Procedure

        // ...and a File.Field spelled like the indicator is a COLUMN, never the global.
        {Published = True}
        Procedure ChangeLegacyIndicators_RenameSkipsFileFieldReferences
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[leeg] Move klant.leeg to iX' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "(gbleeg)")
            Send Assert (sLine contains "klant.leeg")
            Send Assert (not(sLine contains "klant.gbleeg"))
        End_Procedure

        // HARDENING (mode-4 root, 2026-06-30): a [bracket] If <unparenthesised cond> <Move ... to ...> compound -
        // '[Found] If EDIT0030.owner eq sAnsvarig Move 0 to gbiOK' (LegacyApp list0040/0042.vw) - dropped BOTH
        // conditions, emitting a conditionless 'If Move (0) to gbiOK' that the compiler closes with a generated
        // |EI/|EZ label (4330). The safety net reverts a conditionless 'If' to the original, so the line is LEFT
        // UNCHANGED (a harmless [...] warning), never the broken If. Contrast test 38's parenthesised
        // 'If (gbP_END and (...)) Error 107', which still converts cleanly.
        {Published = True}
        Procedure ChangeLegacyIndicators_68
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Found] If EDIT0030.owner eq sAnsvarig Move 0 to gbiOK' to sLine
            Move '[Found] If EDIT0030.owner eq sAnsvarig Move 0 to gbiOK' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // UFUNC err-52 root (2026-06-30 -> fixed 2026-07-02): a [bracket] whose ']' is immediately followed by a
        // ';' line-continuation - '[FINDERR];   Begin' (LegacyApp UFUNC.INC) - swallowed the ';' into the indicator
        // expression, emitting the broken 'If (FINDERR;)'. Now _UnswallowSemicolon moves the introduced ';)' out
        // to ');' -> a VALID 'If (FINDERR); Begin', so it CONVERTS (was skipped / left unchanged before).
        {Published = True}
        Procedure ChangeLegacyIndicators_69
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [FINDERR];   Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "If (FINDERR)")
            Send Assert (not(sLine contains ";)"))
        End_Procedure

        // mode-5 COMPOSE (2026-06-30): a [bracket] If <cond> Indicate <X> <value> (NO 'as') compound -
        // '[Found] If A eq B Indicate HITTAT FALSE' (LegacyApp ITEM0010/REDB0360) - used to be SKIPPED, leaving
        // 'Indicate HITTAT' to clash with HITTAT's Boolean declaration (4345 MUST BE AN INDICATOR). Now composed
        // into the SAME guarded block as the with-'as' form: If ((ind) and (cond)) Begin / Move (val) to gbX / End.
        {Published = True}
        Procedure ChangeLegacyIndicators_70
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Found] If A eq B Indicate HITTAT FALSE' to sLine
            Move ('If (Found and (A eq B)) Begin' + C_NewLine + ;
                  '    Move (FALSE) to gbHITTAT' + C_NewLine + ;
                  'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // files.nui ROOT (2026-06-30): a NEGATED bracket conditional-exec on a command WITH args -
        // '[~seqeof] increment rval#' (LegacyApp VDFQuery files.nui) - dropped the 'rval#' arg, emitting
        // 'If (Not(seqeof)) increment' (#$ ARGUMENT REQUIRED -> control-block cascade). The tilde [~X] is one
        // token (vs [Not X] = two), so the old iItem arithmetic over-shot the arg loop; now the args survive.
        {Published = True}
        Procedure ChangeLegacyIndicators_71
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[~seqeof] increment rval#' to sLine
            Move 'If (Not(seqeof)) increment rval#' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // A leading 'Ifnot [indicator] begin' (2026-06-30) is NOT a recognised If command (bHasIfCommand keys off
        // 'If', not 'Ifnot'), so it once fell into the Case rebuild that drops the trailing part - 'ifnot (seqeof)',
        // the 'begin' lost, orphaning the matching 'end' (4348/4326 + a bogus '~' cascade). It goes through the
        // surgical in-place swap, and since 2026-09-07 the swapped 'ifnot (X)' is finished as 'If (Not(X))' right
        // here: the IfNot converter runs BEFORE this one in the per-line order and bails on a bracket operand, so
        // leaving 'ifnot (X)' behind cost the user a second plan run.
        {Published = True}
        Procedure ChangeLegacyIndicators_72
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot [seqeof] begin' to sLine
            Move 'If (Not(seqeof)) begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // '[~seqeof] loop' (a conditional loop-BACK; LegacyApp files.nui) must become the post-test 'Until (seqeof)'
        // - the [~] double-negative collapses - NOT a bare 'loop' that drops the exit test and spins forever.
        {Published = True}
        Procedure ChangeLegacyIndicators_73
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[~seqeof] loop' to sLine
            Move 'Until (seqeof)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // 'Until not [Found]' - the legacy 'not' OUTSIDE the bracket - is ambiguous to the tokenizer (it grabs
        // the bare 'not' and drops [Found], mangling to a dangling 'Until (not)' -> bogus 'Undefined symbol ~').
        // Skip it, leaving the obsolete-indicator warning untouched (LegacyApp TIME0760/ovrv0510 report loops).
        {Published = True}
        Procedure ChangeLegacyIndicators_74
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Until not [Found]' to sLine
            Move 'Until not [Found]' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // 'If not [X]' (the word 'not' OUTSIDE the bracket) is now normalized to '[~X]' and handled EXACTLY like
        // 'If [~X]' (test 60) -> 'If (Not(gbX))'. (Nils 2026-07-02: 'if not [X]' should behave like 'if [X]'.)
        {Published = True}
        Procedure ChangeLegacyIndicators_75
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If not [MyBoolean] Begin' to sLine
            Move '    If (Not(gbMyBoolean)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // 'If not [X]' with deeper indentation + a trailing end comment: both survive the normalize + swap.
        {Published = True}
        Procedure ChangeLegacyIndicators_76
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        If not [Found] Begin // guard' to sLine
            Move '        If (Not(Found)) Begin // guard' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // Conservative gate: 'not [X]' OUTSIDE an If (here a bare While) is NOT normalized yet - only the
        // verified If path is handled; While / Until 'not [X]' keep the old safe skip (see test 74).
        {Published = True}
        Procedure ChangeLegacyIndicators_77
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    While not [Found]' to sLine
            Move '    While not [Found]' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        // [FINDERR]; ALONE (']' + ';' line-continuation, Begin on the NEXT line - the exact LegacyApp UFUNC.INC:434
        // shape): _UnswallowSemicolon moves the swallowed ';' out -> a valid 'If (FINDERR);', so it CONVERTS (was
        // demoted to Explain in the analyzer because the line-by-line dry-run no-op'd). (Nils 2026-07-02.)
        {Published = True}
        Procedure ChangeLegacyIndicators_78
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [FINDERR];' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "If (FINDERR)")
            Send Assert (not(sLine contains ";)"))
        End_Procedure

        // BASELINE: 'if [X] Begin' (lowercase if, NO semicolon) converts via the in-place swap. If THIS fails, the
        // leading-'if' swap itself is broken (not the ';'); if it passes but 80 fails, the ';' handling is at fault.
        {Published = True}
        Procedure ChangeLegacyIndicators_79
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    if [gibDebugMode] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "(gibDebugMode)")
        End_Procedure

        // Reported (LegacyApp GFUNC.INC:352): 'if [X];' (']' + ';' line-continuation, Begin on the NEXT line) should
        // convert to 'if (gibDebugMode);' - the ';'-strip + recurse + re-append path. Must lose the bracket.
        {Published = True}
        Procedure ChangeLegacyIndicators_80
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    if [gibDebugMode];' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "(gibDebugMode)")
            Send Assert (not(sLine contains "[gibDebugMode]"))
            Send Assert (not(sLine contains ";)"))
        End_Procedure

        // LegacyApp INVC0183.rv:759 - 'If' followed by TWO spaces then '[FINDERR]'. The analyzer demoted this to
        // Explain (dry-run no-op) even though it's a literal indicator line, so the extra space may break the
        // in-place swap's bracket parse. Must convert exactly like the single-space form (test 61). (81)
        {Published = True}
        Procedure ChangeLegacyIndicators_81
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If  [FINDERR] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "(FINDERR)")
            Send Assert (not(sLine contains "[FINDERR]"))
        End_Procedure

        // ISOLATION for 81: DOUBLE space after 'If', NO indent. If THIS fails, the double space alone is the break.
        {Published = True}
        Procedure ChangeLegacyIndicators_82
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If  [FINDERR] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "(FINDERR)")
        End_Procedure

        // ISOLATION for 81: large indent, SINGLE space. If THIS fails (but 82 passes), the indent is the break.
        {Published = True}
        Procedure ChangeLegacyIndicators_83
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If [FINDERR] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "(FINDERR)")
        End_Procedure

        // Regression (LegacyApp 2026-07-05): legacy SPACED array indexing ('asNames [iCount ]') is
        // NOT an indicator group - see ChangeSquareBracketsIndicators' twin test. The line must be
        // left untouched by the deep transform too.
        {Published = True}
        Procedure ChangeLegacyIndicators_SpacedArrayIndexUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                Move asNames [iCount ] to sTerm ' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '                Move asNames [iCount ] to sTerm ' sLine
        End_Procedure

        // Regression (Nils 2026-07-08, found in a legacy customer workspace - identifiers
        // generalized): an If with a PARENTHESISED condition followed by an INLINE Indicate.
        // The expression extractor swallows the whole tail after 'If' into one
        // pseudo-expression token, so bHasIndicateCommand reads False and the line used to
        // fall out of ChangeLegacyIndicators unconverted - then the file-level gb-rename broke
        // it ('Indicate gbMORE_ROWS ...' = 4345). The composed one-liner converts the legacy
        // operator and gb-renames BOTH the condition read and the Move target (same name).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (MORE_ROWS) indicate MORE_ROWS as Orders.Due_Date LE dCutOff' to sLine
            Move 'If (gbMORE_ROWS) Move (Orders.Due_Date <= dCutOff) to gbMORE_ROWS' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Same shape with a BUILT-IN target: Found is already the modern boolean - no gb rename.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_BuiltIn
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (iX > 0) Indicate Found as Customer.Number eq iCust' to sLine
            Move 'If (iX > 0) Move (Customer.Number = iCust) to Found' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Same shape, no-'as' value form. Since 2026-07-09 PM the WHOLE no-bracket If+Indicate
        // family routes through the composer (the Case rebuild garbled its NOT/'&'-window
        // variants), so the value is parenthesised like every composed Move.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateNoAs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bReady) Indicate HITTAT FALSE' to sLine
            Move 'If (bReady) Move (FALSE) to gbHITTAT' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A LEGACY (unparenthesised) string-literal condition + inline no-'as' Indicate, with a
        // TAB-indented line (verified against a real customer workspace 2026-07-09, identifiers
        // generalized). Composed since 2026-07-09 PM: the condition gets parenthesised WITH its
        // legacy operator converted (the ops run on the masked slice, so the literal is safe),
        // the value moved, the target gb-renamed, and the TAB indent survives.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfLegacyCondIndicateNoAs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move (Character(9) + ' IF Orders.Status EQ "F" indicate next_step TRUE') to sLine
            Move (Character(9) + ' If (Orders.Status = "F") Move (TRUE) to gbnext_step') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (Nils 2026-07-09, identifiers generalized): legacy 'IF NOT <cond> <stmt>' -
        // the negation lives in the COMMAND, and the BooleanIndicator parse captured the bare
        // 'not' as the whole condition: 'IF NOT tmp_state IN "0156789" INDICATE sta_flag FALSE'
        // was garbled to 'IF (NOT) Move FALSE to gbsta_flag'. The composer strips the NOT and
        // wraps the rest as Not(...).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotCondIndicateNoAs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'IF NOT bDone INDICATE ready FALSE' to sLine
            Move 'If (Not(bDone)) Move (FALSE) to gbready' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Nils 2026-07-13: this line USED to be left untouched (the composer bailed on IN, deferring to
        // ChangeInToContains, which - being warning-less - a warning-selected fix plan never runs). The
        // composer now converts a lone IN itself, IN being compile-invalid in an expression:
        // 'A IN B' -> '(B Contains A)' (operands swapped). So the line auto-fixes on its own. A MATCH
        // condition, or an IN with a multi-token operand, still bails (the composer only handles lone IN).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotInCondConverts
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            Move 'IF NOT tmp_state IN "0156789" INDICATE sta_flag FALSE'          to sLine
            Move 'If (Not("0156789" contains tmp_state)) Move (FALSE) to gbsta_flag' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
            // A MATCH condition has no verified expression form -> still left untouched.
            Move 'IF NOT tmp_state MATCH "0156789" INDICATE sta_flag FALSE' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // The combined-run twin: after ChangeInToContains has rewritten the IN, the composer
        // converts the line fully - Not(...) reusing the Contains group's own parentheses.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotContainsCondIndicate
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'IF NOT ("0156789" Contains tmp_state) INDICATE sta_flag FALSE' to sLine
            Move 'If (Not("0156789" Contains tmp_state)) Move (FALSE) to gbsta_flag' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Indentation and the end comment must survive the composition.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_EndComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   If (extra) indicate extra as a EQ b // note' to sLine
            Move '   If (gbextra) Move (a = b) to gbextra // note' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A legacy operator word INSIDE a string literal is data, not an operator - the
        // conversion runs on the masked slice and restores the literal untouched.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_StringLiteral
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "If (bGo) Indicate HIT as sName eq 'a le b'" to sLine
            Move "If (bGo) Move (sName = 'a le b') to gbHIT" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (Nils 2026-07-09, found in a legacy customer workspace - identifiers
        // generalized): 'If (cond) Indicate X as <expr>' where an '&'-suffixed legacy WINDOW
        // operand (WindowIndex-relative addressing) keeps the Indicate token CLEAN - so the line
        // passed the top gate into the Case rebuild, which garbled it into
        // 'if (gbX) Move indicate to gbX'. Now routed through the same composer as the
        // token-less twin.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_AmpWindow
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'if (smaller) indicate smaller AS w_end& LE (day_end+1440)' to sLine
            Move 'If (gbsmaller) Move (w_end& <= (day_end+1440)) to gbsmaller' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The STATUS (buffer-status) form has no one-line Move equivalent - untouched, both
        // inline after an If-condition (the composer's guard) ...
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateStatusUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bA) Indicate ONHOLD status Custs' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If (bA) Indicate ONHOLD status Custs' sLine
        End_Procedure

        // ... and at line start (the token-path guard): the missing-'as' fallback used to take
        // the LAST token and emit 'Move (Custs) to (ONHOLD)' - assigning the file number.
        {Published = True}
        Procedure ChangeLegacyIndicators_IndicateStatusUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Indicate ONHOLD status Custs' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Indicate ONHOLD status Custs' sLine
        End_Procedure

        // SELECT stays legacy without the eModernizeSelect opt-in (no valid modern bare form) ...
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateSelectUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bGo) Indicate Select as WindowIndex eq FieldIndex' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If (bGo) Indicate Select as WindowIndex eq FieldIndex' sLine
        End_Procedure

        // ... and converts (bare, un-prefixed - SELECT is _IndicatorVarName pass-through) with it.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateSelectOptIn
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bGo) Indicate Select as WindowIndex eq FieldIndex' to sLine
            Move 'If (bGo) Move (WindowIndex = FieldIndex) to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (Nils 2026-08-17, WinServ GAF.dg + 30 sibling lines): a TABLE FIELD named
        // 'status' (Draft_a.STATUS, Custs.status, Jobb.status ...) on the 'as' side is NOT the
        // buffer-status form 'Indicate <ind> STATUS <file>'. The composer's guard matched the WORD
        // 'status' anywhere after Indicate ('.' is a token boundary), declined the line, and
        // ChangeLegacyOperators then mangled the still-legacy line into
        // 'If ((select) Indicate Select as DRAFT_A.STATUS = "A")' -> Error 52. The buffer-status
        // form has STATUS as the word RIGHT AFTER the target - only that shape is guarded now.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_StatusFieldIsNotBufferStatus
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '            If (select) Indicate Select as DRAFT_A.STATUS Eq "A"' to sLine
            Move '            If (select) Move (DRAFT_A.STATUS = "A") to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Same field-named-status twin with a NON-SELECT target (the default parameter, gb-prefixed)
        // and a Ge comparison (WinServ GLKO.dg 'KONTAKT.Status Ge From_Status').
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_StatusFieldNonSelect
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bGo) Indicate HIT as KONTAKT.Status Ge From_Status' to sLine
            Move '    If (bGo) Move (KONTAKT.Status >= From_Status) to gbHIT' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A field named 'group' is likewise not the GROUP (multi-indicator) form.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateAs_GroupFieldIsNotGroupForm
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If (bGo) Indicate HIT as Anst.Group eq 1' to sLine
            Move '    If (bGo) Move (Anst.Group = 1) to gbHIT' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The GROUP form behind a parenthesised If-condition converts with the condition in front
        // (2026-09-13; until then the word-after-target guard left every group line as it was).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondIndicateGroupConverts
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bA) Indicate NO_PROCESS GROUP All [not P_END not M_END]' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (bA) Move (not(gbP_END) and not(gbM_END)) to gbNO_PROCESS' sLine
        End_Procedure

        // The one-clause ANY form, indented, with a trailing comment - the shape a report view carries
        // (2026-09-13): an 'or' chain, the indentation and the comment kept, the gb names throughout.
        {Published = True}
        Procedure ChangeLegacyIndicators_GroupAnyIsAnOrChain
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                Indicate bad_stamp GROUP ANY [absent_stamp overtime_stamp minus_stamp]   //910207' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '                Move (gbabsent_stamp or gbovertime_stamp or gbminus_stamp) to gbbad_stamp  //910207' sLine
        End_Procedure

        // ALL with a built-in and a '~' member: Found stays bare, the tilde negates like 'not'.
        {Published = True}
        Procedure ChangeLegacyIndicators_GroupAllWithBuiltInAndTilde
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Indicate ready GROUP ALL [Found ~busy_flag]' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Move (Found and not(gbbusy_flag)) to gbready' sLine
        End_Procedure

        // A '$' name converts like any other - the write and a bracket read both take the gb name whole
        // (2026-09-13; the name used to be refused by _IndicatorVarName and pinned as odd).
        {Published = True}
        Procedure ChangeLegacyIndicators_DollarNameWriteAndRead
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Indicate is$done false' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Move (false) to gbis$done' sLine
            Move '[is$done] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (gbis$done) Begin' sLine
        End_Procedure

        // A bracket in front of the group line is a shape the composer does not take: unchanged, and
        // the pin computation keeps that line's names legacy (oPinnedIndicators-Tests).
        {Published = True}
        Procedure ChangeLegacyIndicators_GroupBehindBracketStays
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Found] Indicate ready GROUP ANY [flag_a flag_b]' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '[Found] Indicate ready GROUP ANY [flag_a flag_b]' sLine
        End_Procedure

        // asList without every entry equal to sWord (case-insensitive, trimmed).
        Function WithoutWord String sWord String[] asList Returns String[]
            String[] asResult
            Integer i iLast
            Move (SizeOfArray(asList) - 1) to iLast
            For i from 0 to iLast
                If (Lowercase(Trim(asList[i])) <> Lowercase(sWord)) ;
                    Move asList[i] to asResult[SizeOfArray(asResult)]
            Loop
            Function_Return asResult
        End_Function

        /* THE APP'S CATALOGUE, emulated. _IsListedWord answers from four arrays that the app seeds from the
           target install's DataFlex.lng - a modern catalogue that lists no obsolete word: no Indicate, and no
           Ifnot. This runner seeds from the editor settings, which list both, so a fixture that trusts the
           default seed cannot see what the app does with an 'ifnot' line. Strip one word from all four arrays,
           hand the originals back through the ByRef locals, and RestoreKeywords puts them back. */
        Procedure StripKeywordEverywhere String sWord String[] ByRef asKeys String[] ByRef asCmds String[] ByRef asScopeS String[] ByRef asScopeE
            String[] asStrip
            Get pasKeyWords   of ghoFuncLib to asKeys
            Get pasCommands   of ghoFuncLib to asCmds
            Get pasScopeStart of ghoFuncLib to asScopeS
            Get pasScopeEnd   of ghoFuncLib to asScopeE
            Get WithoutWord sWord asKeys   to asStrip
            Set pasKeyWords   of ghoFuncLib to asStrip
            Get WithoutWord sWord asCmds   to asStrip
            Set pasCommands   of ghoFuncLib to asStrip
            Get WithoutWord sWord asScopeS to asStrip
            Set pasScopeStart of ghoFuncLib to asStrip
            Get WithoutWord sWord asScopeE to asStrip
            Set pasScopeEnd   of ghoFuncLib to asStrip
        End_Procedure

        Procedure RestoreKeywords String[] asKeys String[] asCmds String[] asScopeS String[] asScopeE
            Set pasKeyWords   of ghoFuncLib to asKeys
            Set pasCommands   of ghoFuncLib to asCmds
            Set pasScopeStart of ghoFuncLib to asScopeS
            Set pasScopeEnd   of ghoFuncLib to asScopeE
        End_Procedure

        /* THE LINE AS THE APP PARSES IT (2026-09-07). With no 'ifnot' in the catalogue the boolean parse took
           the command word itself as the FIRST boolean and the bracket as the SECOND, and the expression
           builder - nothing to emit for a bracket-less first, ' and ' before the second - produced
           'ifnot ( and seqeof) begin': Error 52 + 4328 in a file the compiler had accepted. The parser now
           refuses the flow words that open an indicator group whatever the catalogue holds. */
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotBracket_AppCatalogue_Parse
            String sLine
            String[] asKeys asCmds asScopeS asScopeE
            tTokenizer TokenizerData
            Send StripKeywordEverywhere "ifnot" (&asKeys) (&asCmds) (&asScopeS) (&asScopeE)
            Move '  ifnot [seqeof] begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send RestoreKeywords asKeys asCmds asScopeS asScopeE
            Send AssertSAreEqual 'seqeof' (TokenizerData.BooleanIndicator.FirstBoolean.sCode)
            Send Assert (TokenizerData.BooleanIndicator.FirstBoolean.bHasBracket = True)
            Send AssertSAreEqual '' (TokenizerData.BooleanIndicator.SecondBoolean.sCode)
        End_Procedure

        // The same line through the converter under the app's catalogue: the finished modern form, not the mangle.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotBracket_AppCatalogue_Converts
            String sLine
            String[] asKeys asCmds asScopeS asScopeE
            Boolean bChanged
            tTokenizer TokenizerData
            Send StripKeywordEverywhere "ifnot" (&asKeys) (&asCmds) (&asScopeS) (&asScopeE)
            Move '  ifnot [seqeof] begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send RestoreKeywords asKeys asCmds asScopeS asScopeE
            Send Assert bChanged
            Send AssertSAreEqual '  If (Not(seqeof)) begin' sLine
        End_Procedure

        // '[~X]' under a leading ifnot: the swap yields '(Not(gbX))' and the double negation collapses to
        // 'If (gbX)' - the way '[~X] loop' already becomes 'Until (X)' (test 73).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotTildeBracket_Collapses
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    ifnot [~myflag] begin' to sLine
            Move '    If (gbmyflag) begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // An inline statement after the condition rides along untouched.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotBracket_InlineStatement
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  ifnot [seqeof] move 1 to iCount' to sLine
            Move '  If (Not(seqeof)) move 1 to iCount' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // An end comment survives: the rewrite touches 'ifnot (X)' and carries the rest of the line verbatim.
        {Published = True}
        Procedure ChangeLegacyIndicators_IfNotBracket_KeepsEndComment
            String sLine sHead
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  ifnot [seqeof] begin  // nothing to read' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Move '  If (Not(seqeof)) begin' to sHead
            Send AssertSAreEqual sHead (Left(sLine, Length(sHead)))
            Send AssertSAreEqual '// nothing to read' (Right(RTrim(sLine), 18))
        End_Procedure

        // A CONTINUED Indicate (Nils 2026-09-17, a 2005-era file): the 'as' expression runs on to the NEXT
        // physical line, and the Move form needs 'to <target>' at the END of the statement - which a
        // line-by-line function cannot reach in one go. It used to emit 'If (found) Move (((Invoice.Item = xit)
        // and ); to found': the ';' unswallowed into the middle of the line, the continuation left dangling.
        // Now the statement converts in two halves, the target carried from the opening line to the closing one,
        // exactly as the engine feeds the lines. (First declined outright the same day; Nils: "now the line isn't
        // refactored at all".)
        {Published = True}
        Procedure ChangeLegacyIndicators_ContinuedIndicateTwoLines
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                    [ found] indicate found as ((Invoice.Item eq xit) and ;' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '                    If (found) Move (((Invoice.Item eq xit) and ;' sLine
            Move '                                (Invoice.Colour eq xco) and (Invoice.Kind eq xki))' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '                                (Invoice.Colour eq xco) and (Invoice.Kind eq xki))) to found' sLine
            // The statement is closed: the next ordinary line must NOT inherit the target.
            Move '    Move 1 to iCount' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Move 1 to iCount' sLine
        End_Procedure

        // Three physical lines: the middle one still ends with ';' and passes through untouched; the last
        // one closes. A user indicator takes the gb name on BOTH halves, a negated bracket its Not(), and
        // an end comment on the closing line stays behind the 'to'.
        {Published = True}
        Procedure ChangeLegacyIndicators_ContinuedIndicateThreeLines
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [~hittat] Indicate hittat as (Invoice.Item eq xit) and ;' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    If (Not(gbhittat)) Move ((Invoice.Item eq xit) and ;' sLine
            Move '        (Invoice.Colour eq xco) and ;' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '        (Invoice.Colour eq xco) and ;' sLine
            Move '        (Invoice.Kind eq xki) // last part' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '        (Invoice.Kind eq xki)) to gbhittat // last part' sLine
        End_Procedure

        // A shape the opener refuses stays verbatim - and leaves NOTHING in flight for the next line.
        {Published = True}
        Procedure ChangeLegacyIndicators_ContinuedGroupLineStays
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Indicate hittat GROUP ANY [a b] ;' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
            Move '        Move 2 to iOther' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // POSITIVE CONTROL for the test above: the same statement on ONE line converts, 'to found' last.
        {Published = True}
        Procedure ChangeLegacyIndicators_ContinuedIndicateJoinedConverts
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [found] indicate found as ((Invoice.Item eq xit) and (Invoice.Colour eq xco))' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "If (found) Move (")
            Send Assert (sLine contains "((Invoice.Item eq xit) and (Invoice.Colour eq xco))")
            Send AssertSAreEqual ") to found" (Right(RTrim(sLine), 10))
            Send Assert (not(sLine contains ";"))
        End_Procedure

        // THE ENGINE'S OWN LINE PIPELINE, mirrored (cRefactorEngine GetTheWorkDone / eStandardFunctions):
        // tokenize, the unpublished space-inserter, then the plan's line functions in dispatch order -
        // re-tokenizing after every change, exactly as the engine does. The two-pair test below needs it:
        // a converter that carries state from one line to the next can only be trusted under the same
        // sequence of tokenize calls the engine makes.
        Procedure _EngineLine String ByRef sLineIn
            Boolean bChanged
            String sBefore sLine
            // A LOCAL, not the ByRef parameter: forwarding a parameter by reference through a deeper
            // ByRef chain loses the callee's write (feedback_byref_argument_must_be_a_local).
            Move sLineIn to sLine
            Send InitializeTokenizer of ghoFuncLib sLine
            Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
            If (bChanged = True) ;
                Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get ChangeCalcToMoveStatement of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get ChangeInToContains of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get ChangeSysdate of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sBefore
            Get RemoveLocalKeyWord of ghoFuncLib (&sLine) "" to bChanged
            If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
            Move sLine to sLineIn
        End_Procedure

        // TWO continued pairs in one file, fed through the engine's pipeline (Nils 2026-09-17, the live
        // lap on a 2005-era file): the FIRST pair converted and the second - fourteen lines further down,
        // inside an 'if ... begin' block - was left entirely legacy, together with the '[~found]' line
        // after it, while its twin after the first pair converted. Every line asserted.
        {Published = True}
        Procedure ChangeLegacyIndicators_TwoContinuedPairsInOneFile
            String[] asCode
            String sLine
            Boolean[] abMacro
            Integer i
            Move '               move xit to Invoice.item'                                              to asCode[0]
            Move '               find gt Invoice by index.3'                                           to asCode[1]
            Move '               [ found] indicate found as ((Invoice.item eq xit) and ;'              to asCode[2]
            Move '                        (Invoice.colour eq xco) and (Invoice.kind eq xki))'          to asCode[3]
            Move '               [~found] move 0 to rec#'                                              to asCode[4]
            Move ''                                                                                    to asCode[5]
            Move '               // maybe allow change of code'                                        to asCode[6]
            Move '               set item_option item av#   to noenter rec#     // allow change'       to asCode[7]
            Move ''                                                                                    to asCode[8]
            Move '               if rec# eq 0 begin'                                                   to asCode[9]
            Move '                    move 1 to rec#'                                                  to asCode[10]
            Move '                    clear Detail'                                                    to asCode[11]
            Move '                    move xit to Detail.item'                                         to asCode[12]
            Move '                    find gt Invoice by index.3'                                      to asCode[13]
            Move '                    [ found] indicate found as ((Detail.item eq xit) and ;'          to asCode[14]
            Move '                                (Detail.colour eq xco) and (Detail.kind eq xki))'    to asCode[15]
            Move '                    [~found] move 0 to rec#'                                         to asCode[16]
            Move '                end'                                                                 to asCode[17]
            // None of it is macro code - the engine's guard must hand every line to the functions.
            Get MacroCodeFlags of ghoFuncLib (&asCode) to abMacro
            For i from 0 to 17
                Send AssertFalse abMacro[i]
            Loop
            Send ClearFuncLibProperties of ghoFuncLib
            For i from 0 to 17
                Move asCode[i] to sLine
                Send _EngineLine (&sLine)
                Move sLine to asCode[i]
            Loop
            Send AssertSAreEqual '               If (found) Move (((Invoice.item = xit) and ;'                     asCode[2]
            Send AssertSAreEqual '                        (Invoice.colour = xco) and (Invoice.kind = xki))) to found' asCode[3]
            Send Assert (asCode[4] contains 'If (Not(found))')
            Send AssertSAreEqual '               if (rec# = 0) begin'                                              asCode[9]
            Send AssertSAreEqual '                    If (found) Move (((Detail.item = xit) and ;'                 asCode[14]
            Send AssertSAreEqual '                                (Detail.colour = xco) and (Detail.kind = xki))) to found' asCode[15]
            Send Assert (asCode[16] contains 'If (Not(found))')
        End_Procedure

        // 'Ind' is Indicate's obsolete spelling (dafmac.pkg expands it to Indicate): the three shapes a
        // character-mode workspace carried (Nils 2026-09-20) convert exactly as their Indicate twins,
        // indentation and end comment kept. Case-blind on the command word.
        {Published = True}
        Procedure ChangeLegacyIndicators_IndIsIndicate_TrueForm
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    ind gbScrollFlag True' to sLine
            Move '    Move (True) to gbScrollFlag' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_IndIsIndicate_AsExpression
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    IND gbScrollFlag as (Transac.Inv_No = oReceiptNo)' to sLine
            Move '    Move (Transac.Inv_No = oReceiptNo) to gbScrollFlag' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_IndIsIndicate_FoundFalseWithComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    ind Found False //reset' to sLine
            Move '    Move (False) to Found //reset' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A word that merely STARTS with ind is not the command.
        {Published = True}
        Procedure ChangeLegacyIndicators_IndPrefixedWordIsNotTheCommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Index_Def gbScrollFlag True' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Index_Def gbScrollFlag True' sLine
        End_Procedure

        // Converts the ind line and its Indicate twin and asserts they come out the same - and changed.
        Procedure _AssertIndAsTwin String sInd String sTwin
            String sLine sTwinLine
            Boolean bChanged bTwin
            tTokenizer TokenizerData
            Move sTwin to sTwinLine
            Get Tokenizer of ghoFuncLib sTwinLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sTwinLine) "" to bTwin
            Move sInd to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sTwinLine sLine
            Send Assert bTwin
            Send Assert bChanged
        End_Procedure

        /* 'Ind' after a LEADING bracket group is still the command (GitHub 2026-10-06, a DataFlex 3.2
           program): '[ found] ind found as <a> eq <b>' came out of a run as 'as (<a> = <b>) to' inside an
           If block - only a line that STARTED with ind was read as Indicate. Each shape below converts
           exactly as its Indicate twin. */
        {Published = True}
        Procedure ChangeLegacyIndicators_BracketIndIsIndicate
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [ found] ind found as Invoice.Id eq code#' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual '    If (found) Move (Invoice.Id eq code#) to found' sLine
            Send Assert bChanged
            Send _AssertIndAsTwin '    [ found] ind found as Invoice.Id eq code#' '    [ found] indicate found as Invoice.Id eq code#'
        End_Procedure

        // The no-'as' form behind a negated bracket.
        {Published = True}
        Procedure ChangeLegacyIndicators_NegatedBracketIndNoAs
            Send _AssertIndAsTwin '[~found] ind ready False' '[~found] Indicate ready False'
        End_Procedure

        // After an If condition - here one that READS a variable named ind: the word is the command only
        // where Indicate's own grammar follows it (a name, then As / True / False / Group / Status).
        {Published = True}
        Procedure ChangeLegacyIndicators_IfCondInd
            Send _AssertIndAsTwin '    If iCount gt ind ind ready True' '    If iCount gt ind Indicate ready True'
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_IfParenCondIndAs
            Send _AssertIndAsTwin 'If (iCount > 1) ind ready as Invoice.Qty gt 0' 'If (iCount > 1) Indicate ready as Invoice.Qty gt 0'
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_BracketIfCondIndAs
            Send _AssertIndAsTwin '[found] If iCount ne 0 ind ready as Invoice.Qty gt 0' '[found] If iCount ne 0 Indicate ready as Invoice.Qty gt 0'
        End_Procedure

        // A variable NAMED ind is not the command: the bracket converts as it always has (the bracket path
        // parenthesises a Move operand), and no Indicate appears.
        {Published = True}
        Procedure ChangeLegacyIndicators_IndVariableIsNotTheCommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[found] Move ind to iCount' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual 'If (found) Move (ind) to iCount' sLine
            Move 'If ind gt 0 Move 1 to iCount' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If ind gt 0 Move 1 to iCount' sLine
        End_Procedure

        // The reported line through the engine's pipeline: the operator converter finishes the expression.
        {Published = True}
        Procedure ChangeLegacyIndicators_BracketIndThroughThePipeline
            String sLine
            Send ClearFuncLibProperties of ghoFuncLib
            Move '[ found] ind found as Invoice.Id eq code#' to sLine
            Send _EngineLine (&sLine)
            Send AssertSAreEqual 'If (found) Move (Invoice.Id = code#) to found' sLine
        End_Procedure

        // An ind line the Indicate conversion declines (the STATUS form has no Move) stays as written, and
        // the functions after it read the line as written - not the Indicate copy tried on the way.
        {Published = True}
        Procedure ChangeLegacyIndicators_DeclinedIndLeavesTheLine
            String sLine
            Send ClearFuncLibProperties of ghoFuncLib
            Move 'If iCount eq 1 ind ready status Invoice' to sLine
            Send _EngineLine (&sLine)
            Send AssertFalse (Lowercase(sLine) contains "indicate")
            Send Assert (sLine contains "ind ready status Invoice")
        End_Procedure

        // Converts the Else line and the statement alone, and asserts the Else line comes out as the
        // statement did, with 'Else ' in front - and that both changed.
        Procedure _AssertElseAsAlone String sElseIn String sAloneIn
            String sLine sAlone sIndent
            Boolean bChanged bAlone
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move sAloneIn to sAlone
            Get Tokenizer of ghoFuncLib sAlone to TokenizerData
            Move TokenizerData.sIndentation to sIndent
            Get ChangeLegacyIndicators of ghoFuncLib (&sAlone) "" to bAlone
            Send ClearFuncLibProperties of ghoFuncLib
            Move sElseIn to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual (sIndent + "Else " + LTrim(sAlone)) sLine
            Send Assert bAlone
            Send Assert bChanged
        End_Procedure

        /* AN ELSE IN FRONT (Nils 2026-10-06, "Yes, fix the Else case too"): the converter wrote its line from
           the start and kept nothing in front of the Indicate or the bracket - 'Else Indicate ready False'
           came out as 'Move (False) to gbready', the value set every time. The statement after the Else now
           converts as it would alone, and the Else stays in front. */
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseIndicateKeepsTheElse
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    Else Indicate ready False' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual '    Else Move (False) to gbready' sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_ElseIndicateAs
            Send _AssertElseAsAlone '    Else Indicate ready as Invoice.Qty gt 0' '    Indicate ready as Invoice.Qty gt 0'
        End_Procedure

        // A bracket behind the Else: the old output had lost the Else, the condition and the target.
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseBracketIndicate
            Send _AssertElseAsAlone 'Else [found] Indicate ready True' '[found] Indicate ready True'
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_ElseBracketCommand
            Send _AssertElseAsAlone 'Else [found] Move 1 to iCount' '[found] Move 1 to iCount'
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_ElseBracketBegin
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move '        Else [~found] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual '        Else If (Not(found)) Begin' sLine
            Send Assert bChanged
        End_Procedure

        // 'Else If': the copy's If stands first on its line, where the If paths read it.
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseIfIndicate
            Send _AssertElseAsAlone 'Else If iCount eq 1 Indicate ready True' 'If iCount eq 1 Indicate ready True'
            Send _AssertElseAsAlone 'Else If [found] Indicate ready True' 'If [found] Indicate ready True'
        End_Procedure

        // Ind behind an Else is the command too (_IndCommandWordPos), and the Else keeps its spelling.
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseInd
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    else ind ready False' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual '    else Move (False) to gbready' sLine
            Send Assert bChanged
        End_Procedure

        // A GROUP statement behind an Else stays as written: the pin scan asks _GroupIndicateToMove about the
        // line as written, which refuses the Else, so the group's names stay indicators everywhere else.
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseGroupLeftAsWritten
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move 'Else Indicate ready group any [flag_a flag_b]' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Else Indicate ready group any [flag_a flag_b]' sLine
        End_Procedure

        // A ';'-continued Indicate behind an Else, and one spelled ind behind a bracket, through the engine's
        // pipeline: each pair comes out as its plain twin's - with the Else in front of the opening line.
        {Published = True}
        Procedure ChangeLegacyIndicators_ElseAndIndContinuedPairs
            String sA1 sA2 sB1 sB2
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    Indicate found as ((Invoice.Item eq xit) and ;' to sA1
            Move '        (Invoice.Colour eq xco))'                  to sA2
            Send _EngineLine (&sA1)
            Send _EngineLine (&sA2)
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    Else Indicate found as ((Invoice.Item eq xit) and ;' to sB1
            Move '        (Invoice.Colour eq xco))'                       to sB2
            Send _EngineLine (&sB1)
            Send _EngineLine (&sB2)
            Send AssertSAreEqual ('    Else ' + LTrim(sA1)) sB1
            Send AssertSAreEqual sA2 sB2
            Send Assert (sA2 contains ") to found")
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    [ found] indicate found as ((Invoice.Item eq xit) and ;' to sA1
            Move '        (Invoice.Colour eq xco))'                           to sA2
            Send _EngineLine (&sA1)
            Send _EngineLine (&sA2)
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    [ found] ind found as ((Invoice.Item eq xit) and ;' to sB1
            Move '        (Invoice.Colour eq xco))'                      to sB2
            Send _EngineLine (&sB1)
            Send _EngineLine (&sB2)
            Send AssertSAreEqual sA1 sB1
            Send AssertSAreEqual sA2 sB2
            Send Assert (sA2 contains ") to found")
            Send ClearFuncLibProperties of ghoFuncLib
        End_Procedure

    End_Object
