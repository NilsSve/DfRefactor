    Object oChangeLegacyIndicators is a cTestFixture
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
        Set psFunctionName to "ChangeLegacyIndicators"

        // A conditional Indicate whose guard uses the legacy IN operator (Nils 2026-07-13). IN is
        // compile-invalid inside a parenthesised expression, so the composer converts it the way
        // ChangeInToContains would - 'A IN B' -> '(B Contains A)' (operands swapped). Was left
        // unchanged (Review/Explain); now converts, so it can auto-fix.
        {Published = True}
        Procedure ChangeLegacyIndicators_ConditionalIndicateWithIn
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    IF NOT w_at_ordinarie& IN "FBX" indicate hel_lunch_franvaro false'            to sLine
            Move '    If (Not("FBX" contains w_at_ordinarie&)) Move (false) to gbhel_lunch_franvaro' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* A COMMAND WITH A "TO" BEHIND A BRACKET AND AN IF (2026-10-31): the 'to' was written twice - '... Field T.Qty
           to to nQty', error 4393. */
        {Published = True}
        Procedure ChangeLegacyIndicators_BracketIfCommandWithToWritesToOnce
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [~Flag] If T.Num eq 0 Set Field_Changed_Value Field T.Qty to nQty' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send Assert (Pos(" to to ", Lowercase(sLine)) = 0) ("'to' written twice: " + sLine)
            Send Assert (Pos("Field T.Qty to nQty", sLine) > 0) sLine
        End_Procedure

        /* TWO LEADING BRACKETS, THEN INDICATE (2026-10-31): the second bracket was read as the Indicate's target -
           'If (Found) Move (T.Kind eq "C") to Not(gbCredit)', error 4345. Both guard the Indicate now. */
        {Published = True}
        Procedure ChangeLegacyIndicators_TwoBracketsThenIndicate
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    [Found] [~Credit] Indicate Found as T.Kind eq "C" // credit only' to sLine
            Move '    If (Found and Not(gbCredit)) Move (T.Kind eq "C") to Found // credit only' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* TWO BRACKETS WITH NO SPACE BETWEEN THEM (2026-11-01): '[~Same][Found] Loop' was read as ONE indicator,
           'Until (gbSameFound)' - a name nothing declares, five compile errors in one workspace. Read as the two it
           is: an Indicate, a Begin and a Loop each keep both booleans - and a Loop of two spaced brackets, which kept
           only the first, too. '[A B] Begin' had no space before B: 'If (A andB) Begin'. */
        {Published = True}
        Procedure ChangeLegacyIndicators_TwoBracketsWithNoSpace
            String[] asIn asExpected
            String sLine
            Boolean bChanged
            Integer i
            tTokenizer TokenizerData
            Move '    [~Same][Found] Indicate Found as V.X eq P.Y'                  to asIn[0]
            Move '    If (Not(gbSame) and Found) Move (V.X eq P.Y) to Found'         to asExpected[0]
            Move '    [FindErr][~Credit] Begin'                                      to asIn[1]
            Move '    If (FindErr and (Not(gbCredit))) Begin'                        to asExpected[1]
            Move '    [~Same][Found] Loop'                                           to asIn[2]
            Move '    Until (Not(Not(gbSame) and Found))'                            to asExpected[2]
            Move '    [Ready][Found] Loop'                                           to asIn[3]
            Move '    Until (Not(gbReady and Found))'                                to asExpected[3]
            Move '    [Found] [~Ok] Loop'                                            to asIn[4]
            Move '    Until (Not(Found and (Not(gbOk))))'                            to asExpected[4]
            Move '    [Ready Found] Begin'                                           to asIn[5]
            Move '    If (gbReady and Found) Begin'                                  to asExpected[5]
            For i from 0 to (SizeOfArray(asIn) - 1)
                Move asIn[i] to sLine
                Get Tokenizer of ghoFuncLib sLine to TokenizerData
                Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
                Send AssertSAreEqual asExpected[i] sLine
            Loop
        End_Procedure

        /* TWO BOOLEANS BEFORE A STATEMENT WITH ARGUMENTS ARE THE SIBLING'S (2026-11-01): '[A B] Clear Inv' came out as
           'If (A and B) Clear' here - the arguments lost - and '[A] [B] Move 1 to n' as 'If (A) Move (B) to n'.
           ChangeSquareBracketsIndicators converts them whole; this leaves them as written. */
        {Published = True}
        Procedure ChangeLegacyIndicators_TwoBooleansBeforeArgumentsAreLeft
            String[] asIn
            String sLine
            Boolean bChanged
            Integer i
            tTokenizer TokenizerData
            Move '    [Ready] [~Found] Clear Inv'        to asIn[0]
            Move '    [Ready ~Found] Get Foo to iX'      to asIn[1]
            Move '    [Ready][~Found] Move 1 to iCount'  to asIn[2]
            For i from 0 to (SizeOfArray(asIn) - 1)
                Move asIn[i] to sLine
                Get Tokenizer of ghoFuncLib sLine to TokenizerData
                Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
                Send AssertFalse bChanged
                Send AssertSAreEqual asIn[i] sLine
            Loop
        End_Procedure

        /* A LOOP'S EXIT TEST NEGATES THE WHOLE CONDITION (2026-11-01): 'Not(A) and Not(B)' is no negation of one thing,
           and '(A) or (B)' no single group - they were taken apart as if they were, '(A) and Not(B)'. */
        {Published = True}
        Procedure NegateLoopBackCondition_ReadsItsParentheses
            String sOut
            Get _NegateLoopBackCondition of ghoFuncLib "(Not(A) and Not(B))" to sOut
            Send AssertSAreEqual "(Not(Not(A) and Not(B)))" sOut
            Get _NegateLoopBackCondition of ghoFuncLib "(A) or (B)" to sOut
            Send AssertSAreEqual "(Not((A) or (B)))" sOut
            Get _NegateLoopBackCondition of ghoFuncLib "(Not(seqeof))" to sOut
            Send AssertSAreEqual "(seqeof)" sOut
            Get _NegateLoopBackCondition of ghoFuncLib "(bRunning)" to sOut
            Send AssertSAreEqual "(Not(bRunning))" sOut
        End_Procedure

        /* CHAINED IFS BEHIND A BRACKET (2026-10-31): '[Ready] If iA ne 0 If iA ne iB Indicate Ready False' put the
           second If inside the guard - '(gbReady and (iA <> 0 If iA <> iB))', error 52. Each If is its own
           condition now. */
        {Published = True}
        Procedure ChangeLegacyIndicators_BracketThenChainedIfs
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '[Ready] If iA ne 0 If iA ne iB Indicate Ready False' to sLine
            Move ('If (gbReady and (iA ne 0) and (iA ne iB)) Begin' + C_NewLine + '    Move (False) to gbReady' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Indicate Found as True' to sLine
            Move 'Move (True) to Found' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Indicate [Found] as True' to sLine
            Move 'Move (True) to Found' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeLegacyIndicators_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Select] Indicate Select as WindowIndex Eq FieldIndex' to sLine
            Move '   If (Select) Move (WindowIndex Eq FieldIndex) to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-07-24, the LegacyApp replay's 30 post-plan errors): the legacy Indicate
        // command IGNORED junk after its arguments, so a typo'd trailing ")" was legal source -
        // 'Indicate Select as (Uppercase(A)) Eq (Uppercase(B)))' - and the converter carried it
        // into the Move expression, where it is fatal. The excess trailing ")" is trimmed.
        {Published = True}
        Procedure ChangeLegacyIndicators_TrailingExcessParenTrimmed
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Select] Indicate Select as (Uppercase(sAdr1)) Eq (Uppercase(sAdr2)))' to sLine
            Move '   If (Select) Move ((Uppercase(sAdr1)) Eq (Uppercase(sAdr2))) to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The guided PLAN runs one scoped engine pass PER RECIPE ROW, in GRID order - so
        // ChangeLegacyOperators can run in an EARLIER pass than ChangeLegacyIndicators. Its
        // imbalance path (the typo'd trailing excess paren unbalances the line) modernises the
        // Eq IN PLACE, and a modern '=' no longer triggers the extractor's legacy-operator
        // fabrication - the after-as content then reaches the multi-token store as the bare
        // '(A) = (B)', which the old contains-parens wrap check read as already wrapped:
        // 'If (Select) Move (A) = (B) to Select', two expressions split by '=' (LegacyApp
        // GruppLeveransOrder replay, Nils 2026-07-24). _IsSingleParenGroup now decides the wrap.
        {Published = True}
        Procedure ChangeLegacyIndicators_OperatorsRowFirstStillWrapped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Select] Indicate Select as (Uppercase(ORDERHD.SHIPSTREET)) Eq (Uppercase(PURCH.ADDRSS2)))' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Move '   [Select] Indicate Select as (Uppercase(ORDERHD.SHIPSTREET)) = (Uppercase(PURCH.ADDRSS2)))' to sExpected
            Send AssertSAreEqual sExpected sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Move '   If (Select) Move ((Uppercase(ORDERHD.SHIPSTREET)) = (Uppercase(PURCH.ADDRSS2))) to Select' to sExpected
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The REAL engine pipeline runs ChangeLegacyIndicators and ChangeLegacyOperators on the SAME
        // line in sequence (alphabetical execution order), and the live defect only showed with
        // TABLE.FIELD operands (LegacyApp address-compare block, 2026-07-24, identifiers generalized):
        // the composed 'Move ((A) Eq (B)) to Select' lost its OUTER parens somewhere in the chain,
        // leaving the illegal 'Move (A) = (B) to Select' - two expressions separated by '='. Each
        // stage's full output is asserted so the failing stage is named by the failure itself.
        {Published = True}
        Procedure ChangeLegacyIndicators_ThenOperators_BracketTableFields
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Select] Indicate Select as (Uppercase(ORDHDR.SHIPADDR)) Eq (Uppercase(PORDER.ADDR1)))' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) eModernizeSelect to bChanged
            Move '   If (Select) Move ((Uppercase(ORDHDR.SHIPADDR)) Eq (Uppercase(PORDER.ADDR1))) to Select' to sExpected
            Send AssertSAreEqual sExpected sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyOperators of ghoFuncLib (&sLine) to bChanged
            Move '   If (Select) Move ((Uppercase(ORDHDR.SHIPADDR)) = (Uppercase(PORDER.ADDR1))) to Select' to sExpected
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The helper itself: excess trailing closers trimmed; balanced and opens-heavy inputs
        // returned unchanged (those are not the trailing-junk shape and stay visible to the compiler).
        {Published = True}
        Procedure ChangeLegacyIndicators_TrimExcessParensHelper
            String sOut
            Get _TrimTrailingExcessParens of ghoFuncLib "(A) Eq (B)))" "(A) Eq (B)))" to sOut
            Send AssertSAreEqual "(A) Eq (B)" sOut
            Get _TrimTrailingExcessParens of ghoFuncLib "(A) Eq (B)" "(A) Eq (B)" to sOut
            Send AssertSAreEqual "(A) Eq (B)" sOut
            Get _TrimTrailingExcessParens of ghoFuncLib "((A) Eq (B)" "((A) Eq (B)" to sOut
            Send AssertSAreEqual "((A) Eq (B)" sOut
        End_Procedure

        // Regression (2026-06-10): the UI parameter combo stores the enum NAME
        // ("eModernizeSelect") in Functions.Parameter and the engine passes it verbatim.
        // The old bare Move of that name into the Integer enum left the gate at
        // eLeaveSelect, so the opt-in never worked from the UI - only in tests, which
        // pass the numeric constant. _ParameterIsEnum accepts both forms; this is the
        // NAME-string twin of test _3.
        {Published = True}
        Procedure ChangeLegacyIndicators_SelectByParameterName
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '   [Select] Indicate Select as WindowIndex Eq FieldIndex' to sLine
            Move '   If (Select) Move (WindowIndex Eq FieldIndex) to Select' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "eModernizeSelect" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

