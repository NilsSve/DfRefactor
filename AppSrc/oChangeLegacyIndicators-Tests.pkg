        {Published = True}
        // Regression test: trailing ')' from outer scope must not cause placeholder leak.
        // Bug: last line of compound If "((iSdagnr Eq 4) and (MASK1.SERVICEDAG4 eq iServicedag))) Begin"
        // was becoming "||||...||||) Begin" because SearchArray couldn't find the placeholder with trailing ')'.
        Procedure ChangeLegacyIndicators_55
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    ((iSdagnr Eq 4) and (MASK1.SERVICEDAG4 eq iServicedag))) Begin' to sLine
            Move '    ((iSdagnr Eq 4) and (MASK1.SERVICEDAG4 eq iServicedag))) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        // Regression: with the default eLeaveSelect, SELECT (an old-FMAC #Replace macro with
        // no valid modern bare form) is left untouched - the line keeps its [...] warning.
        Procedure ChangeLegacyIndicators_56
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[SELECT] INDICATE SELECT as 'APINV,APCDT' IN BATCH.TRAN" to sLine
            Move "[SELECT] INDICATE SELECT as 'APINV,APCDT' IN BATCH.TRAN" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        {Published = True}
        // Regression: a bare "Indicate Select as ..." is also left unchanged by default.
        Procedure ChangeLegacyIndicators_57
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Indicate Select as Windowindex Eq Fieldindex // Comment" to sLine
            Move "    Indicate Select as Windowindex Eq Fieldindex // Comment" to sExpected
