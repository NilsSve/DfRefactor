// Modernization-Analyzer AREA - was the standalone oModAnalyzer_dg dock; now a Container3d #Include'd INSIDE
// OutputDockFT.dg's merged bottom dock (its tab strip switches between this and the compiler area), so this
// object is constructed as a CHILD of the dock. The Use line below keeps this file self-contained; it is a
// harmless no-op because OutputDockFT.dg Use's cCJGrid.pkg at file scope BEFORE this #Include (Use is once-
// only). Register_Procedure can NOT live here (not once-only), so it stays in OutputDockFT.dg.
Use cCJGrid.pkg
Use cFTDockArea.pkg             // the area root: Container3d with the Designer's top-level tag
Use cRDCGridToolTip.pkg          // cRDCToolTipGrid / cRDCToolTipColumn - the tooltip settings (RDCToolsLib)
Use cFTDockPanelGrid.pkg         // the grid inside the dock - one look for the three tabs, on RDCToolsLib's cRDCCJToolPanelGrid
Use cRDCGridClipboard.pkg        // RDCCopyGridRows - the grid's rows onto the clipboard (RDCToolsLib)
Use cCJCommandBars.pkg
Use cCompilerOutputContextMenu.pkg 
Use FTMarkupBuilders.pkg         // the HTML vocabulary - OpenHtml, IconLabel, the builders
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
Use CompileErrorParser.pkg       // IsCompilerMessageFile - a row needs a file, and a folder is not one

Object oAnalyzerArea is a cFTDockArea
    Set Size to 47 400
    Set Location to 0 0
    Set Color to (FTViewBg())
    Set Border_Style to Border_None
    Set peAnchors to anAll
    Move Self to ghoModAnalyzerDock

    Procedure End_Construct_Object
        Handle ho
        Forward Send End_Construct_Object
        Get Create (RefClass(cCompileOutputCJCommandBarSystem)) to ho
        Set Name of ho to "oCompileOutputCJCommandBarSystem"
        Set phoToolPanelContextMenu to ho
    End_Procedure
    
    // The .err file to analyse. Set by ActivateModAnalyzer before the panel is shown.
    Property String psErrorFile ""

    /* The .prn a RESTORED plan was parsed from - the same provenance the plan records, kept so the
       board can still reach the compiled set in a session where no Check has run (2026-08-19).

       Why it exists: psErrorFile above is only ever set by ActivateModAnalyzer, i.e. by a Check. Open
       a workspace on a restored plan and it is "", so CompiledScopeFiles finds no .prn and hands back
       an empty list - and every test that needs EVIDENCE from the compiled source silently loses its
       evidence. Nils saw the shape of it exactly: reopening WinServ without a Check put four rows
       back into Needs hand migration (1 cTrView, 2 dbMultiView, 246 cTrReportView, 246
       cTrDbView = 495). Those 495 are the classes silenced by looking up their PARENT in the
       compiled source; the 38 still silenced (dbView, ReportView, View) are the ones matched by name
       alone, which needs no scope. The split between them is the fingerprint of a lost scope.

       Same family as the collision-signal restore directly below: a restore rebuilds the rows but
       not the state DERIVED from them, and each piece of derived state has to be restored by name. */
    Property String psPlanSourcePrn ""

    Object oModAnalyzer_grd is a cFTDockPanelGrid
        Set Size to 60 394     // identical geometry to CompilerOutputFT's grid (same area, Location, Size, anchors) so the right edge / scrollbar doesn't shift on tab switch
        Set piMinSize to 54 100
        Set Location to 2 4   // full height: the analyze summary chip bar now lives in the Test Compile bar, not here
        Set psNoItemsText to CS_AnalyzerNoItems
        Set psLayoutSection to "oModAnalyzer_grd"
        Set phoContextMenu to (phoToolPanelContextMenu(Self))
        Set peAnchors to anAll

//        Set phoModAnalyzer_grd of ghoApplication to Self
        
        // Header-click column sorting (the grid sorts its OWN static data source on click -
        // see cCJGrid.HeaderReorder -> SortGridByColumn). pbHeaderTogglesDirection lets a
        // second click on the same header flip asc/desc; the shaded column + sort triangle
        // show which column drives the order. The first ("#") column restores the original
        // load order - see oRowNum_Col / DisplayFiltered.
        Set pbHeaderReorders to True
        Set pbHeaderTogglesDirection to True
        Set pbShadeSortColumn to True
        // (peDrawSortTriangleStyle defaults to xtpGridDrawSortTriangleAlways - the
        //  ascending/descending triangle on the sorted header is already shown.)

        // When False (default) the grid hides the informational Explain/Unknown rows, keeping the
        // focus on the actionable Auto-fix/Review work. Ctrl+I (ToggleInformational) flips it.
        Property Boolean pbShowInformational False

        // DEEP-SCAN mode: when True, LoadData consumes the injected paDeepScanMessages (the
        // source-driven scanner's synthetic rows, tokened "DS <n>") instead of reading the compile
        // output, and SKIPS the compile-cycle persistence (dashboard analyze snapshot, saved-plan
        // JSON, RefreshAnalyze broadcast) - a source scan must never masquerade as a compile+analyze
        // in the burn-down history. Everything else (classify via the DS recipes, chips, ignore,
        // fold, Auto Select via paScopedMessages) runs the normal pipeline unchanged. Set by
        // ActivateModAnalyzerDeepScan (OutputDockFT.dg); cleared by a real Analyze / saved view.
        Property Boolean pbDeepScanView False
        Property tCompileError[] paDeepScanMessages

        // THE GUIDED MERGE (phase 2 of the convergence, Nils 2026-07-25): Deep Scan results the
        // guided Check parked here for the NEXT compile-lane analyze to fold into its own build.
        // Scan hits are already analyzer currency (tCompileError[], "DS <n>" numbers disjoint from
        // the compiler's), so LoadData simply appends them before scoping/classify/build - ONE
        // board, one plan, both lanes; the DS-mode (pbDeepScanView) load never merges them (it IS
        // scan data). Persists across analyzes until the next guided Check re-scans - the same
        // staleness contract as the .prn itself. Set by CheckWorkspaceFT's Check; a workspace
        // switch leaves it: FilterToWorkspaceFiles scopes foreign paths out, and the first Check
        // on the new workspace replaces it. The trigger for this merge: 'Object oX is a cTrGrid'
        // is invisible to the compiler, and the scan's "Grid subclass" row never reached the
        // guided board because the scan lane simply never ran there.
        Property tCompileError[] paPendingScanMessages

        // SAVED-PLAN mode: when True, Initialize loads the frozen plan JSON (LoadSavedPlan) instead of
        // parsing the .prn (LoadData). Set True by the dock's ShowSavedPlan, cleared by a live Analyze
        // (ActivateModAnalyzer). The grid is read-only either way, so nothing else needs to branch on it.
        Property Boolean pbSavedView False
        // True once the grid holds analyzed / saved-plan data (set in DisplayFiltered). A plain tab-switch to the
        // Analyzer (OnUpdate) then RE-DISPLAYS the cached grid instead of re-parsing the .prn - switching tabs was
        // silently re-running the whole ~24s analyze. A fresh Analyze / View-last-plan reloads via the Analyze
        // button / ShowSavedPlan, which drive LoadData / LoadSavedPlan directly. (Nils tab-switch 2026-07-02.)
        Property Boolean pbAnalyzeDataReady False
        /* RE-ENTRANCY LATCH for LoadData (2026-08-15 21:30). A Check on the fresh WinServ copy
           built "row 2400 of 36632" over a 463-diagnostic listing plus a 1,784-finding Deep Scan:
           36,632 = 463 + 20 x ~1,808 - the pending scan slice appended TWENTY times, because
           LoadData was entered twenty times, each nested in the last. The path: LoadData ->
           DisplayFiltered -> (compile-bar sync / dashboard push activate the dock) -> the dock's
           ShowTab/Activate handlers test pbAnalyzeDataReady, find it FALSE (it is set only at
           the END of DisplayFiltered) -> Send Initialize -> LoadData again. Each nesting appended
           paPendingScanMessages onto the persistent build state (pBuildTheData) once more.
           A load in progress is not a load to start; the nested caller gets nothing and the
           outer load finishes and paints. */
        Property Boolean pbLoadDataRunning False
        /* SCAN-RULE FLOOD (2026-08-15, the 36,632-row Check). The Deep Scan the Check runs first
           parked 37,479 findings on WinServ - 22,628 of them three legacy-operator rules (EQ / NE /
           GT, DS 9035-9037) - and the analyzer faithfully built one row-visit per finding at ~50
           ms each: thirty minutes, for rows the grid then folds per (file|function) anyway. The
           compiler lane solved this exact shape on 07-20 (a 4544/4390 flood >= 100 collapses
           into ONE summary row); the scan lane merged into Check on 07-25 and never got it. It
           was invisible on small workspaces and 80x the compiler's own count on this one.

           Same design, generic over DS numbers: a rule that fires >= CI_DSFloodThreshold times in
           a run is COLLAPSED - its findings are counted and skipped in the row loop, and one
           summary row per rule says how many, in how many files, and which converter fixes them
           all at once. Rules under the threshold keep every row and the unfold list, unchanged.
           Filled by _CountScanFloods before the build; read by the row loop and the summary. */
        Property Integer[] paiDSFloodNo
        Property Integer[] paiDSFloodCount
        Property Integer[] paiDSFloodFiles
        Property String[]  pasDSFloodFirstFile
        Property Integer[] paiDSFloodFirstLine
        Property String[]  pasDSFloodSymbol
        Property String[]  pasDSFloodFirstHint   // the first finding's own hint, per flood (a negative key's row says it)
        Property String[]  pasDSFloodFn          // the summary row's converter, per flood (set by the row build)
        /* EVERY distinct file each flood fired in, index-parallel with paiDSFloodNo (2026-08-16). The
           summary row is one row with one sFile, and the plan is built from the rows - so without
           this a rule with 22,000 findings advanced by ONE FILE per Check (Nils, WinServ). Packaged by
           FloodsForPlan into tSavedPlanFlood[] for both plan paths and the saved-plan JSON. */
        Property String[][] pasDSFloodFileLists
        // Which mode the currently-DISPLAYED data is (pbSavedView at the last DisplayFiltered). OnUpdate compares
        // it to the CURRENT pbSavedView: a plain tab-switch (same mode) re-displays the cache; a mode CHANGE
        // (e.g. ShowSavedPlan flipping to saved view over an analyze) forces a fresh Initialize -> LoadSavedPlan.
        Property Boolean pbLoadedSavedView False
        // Which WORKSPACE (psSWSFile) the cached build describes - stamped at BUILD time by LoadData /
        // LoadSavedPlan. The tab-switch re-display shortcut must match on THIS too, not only ready+mode:
        // without it, switching workspaces and clicking "View last plan" re-displayed the PREVIOUS
        // workspace's cached rows forever - ready and saved-mode both matched, so the reload never ran
        // (Nils 2026-07-05). Compared in OutputDockFT's OnUpdate AND ReassertAnalyzerView - keep the
        // two predicates identical.
        Property String psAnalyzeDataWS ""

        // Cache of the last full (unfiltered) analyze build, so Ctrl+I (ToggleInformational) can
        // re-apply the show/hide instantly - no re-parse of the .prn. Set by LoadData, read by
        // DisplayFiltered. paieCatFull[i] is row i's resolved category.
        // pTheDataFull now holds the FULL triage INCLUDING dismissed (Ignore) rows - the ignore filter is
        // applied at VIEW time (pabIgnoredFull[i] = row i is dismissed), so the frozen saved plan (written
        // from pTheDataFull) stays complete and Clear Ignored can always restore. DisplayFiltered hides the
        // pabIgnoredFull rows; the refactor PLAN reads paScopedMessages (already ignore-filtered).
        Property tDataSourceRow[] pTheDataFull
        Property Integer[] paieCatFull
        Property Boolean[] pabIgnoredFull

        // UNFOLD support (Nils 2026-07-09): pasRowOccFull[i] = the individual occurrences the
        // merged (file|function) row i absorbed - one "line<TAB>msg#<TAB>message text" string
        // each - so the row can be unfolded into per-occurrence CHILD rows without re-analyzing.
        // Parallel to pTheDataFull, rebuilt by LoadData (a saved plan carries no occurrences, so
        // unfold is unavailable there). pabExpandedFull[i] = row i is currently unfolded - a
        // view-time state like the ignore filter, applied by DisplayFiltered and reset on every
        // fresh analyze. Child rows are recognised by CELLS, sort-proof: a blank "#" (RowNum)
        // cell = child; a Line cell carrying the " (xN)" suffix = foldable master; a child finds
        // its master row by the (File, Refactor function) pair it inherits.
        Property String[][] pasRowOccFull
        Property Boolean[]  pabExpandedFull

        // Structured summary counts for the analyze chip bar (rendered in the Test Compile bar) - set by
        // LoadData / LoadSavedPlan, turned into HTML by SummaryHtml in DisplayFiltered. Auto-fix + Review are
        // per-build totals; explain = full rows - auto - review. pbSumSaved switches to saved-plan wording
        // (no warning/error chips; a "last run <date>" tail instead).
        Property Integer piSumAuto
        Property Integer piSumSuggest
        Property Integer piSumWarn
        Property Integer piSumErr
        /* THE SCAN LANE, COUNTED SEPARATELY (Nils 2026-09-09: "the compiler now shows 718 warnings
           - that is a huge increase"; the compiler had in fact said 484, and 234 Deep Scan findings
           were being added to the same chip). The Guided Merge folds pending scan results into the
           compile lane on purpose - classify, ignore, fold and plan should treat both uniformly -
           but the SUMMARY must not call a scan finding a compiler warning. piSumWarn is now the
           compiler's warnings alone and this is the scan's findings; the chip bar shows both.

           Everything PERSISTED still gets the combined figure (the snapshot globals, the registry
           snapshot, the burn-down history and the saved plan's header), so a workspace's history
           stays one continuous series and a saved plan still reports what the run found. In a pure
           Deep Scan run piSumWarn is 0 and the sum is the finding count, which is exactly the
           contract those call sites already documented. */
        Property Integer piSumScan
        Property Integer piSumFiltered
        Property Integer piSumIgnored
        // Count of ambiguous-function (4544) + already-defined (4390) errors in the analyzed output -
        // the NAME-COLLISION signature. A cluster of these traces to a few conflicting/backported
        // declarations that NO auto-fix can clear (see FunctionReturnMismatchReport), and they flood the compile
        // (one bad Value declaration -> hundreds of 4544s). TestCompileFT.MaybeSuggestNameCollision reads
        // this to nudge the user toward the report before they waste plan cycles on the call sites.
        Property Integer piSumCollisionErr
        // The same signal split by MESSAGE, because the two halves now end differently and the guided
        // findings list shows them as separate rows (Nils 2026-07-20):
        //   piSumReturnTypeErr (4544, ambiguous return type) - REPORT only. The fix is renaming or
        //     type-aligning the conflicting declarations, which needs human judgement.
        //   piSumBackportErr   (4390, global already defined) - MECHANICALLY FIXABLE now, by
        //     GuardRedundantGlobalFunctions (wraps the home-brewed global in an #IF (!@ <= ver) guard).
        // piSumCollisionErr stays the COMBINED total so MaybeSuggestNameCollision's threshold is unchanged.
        Property Integer piSumReturnTypeErr
        Property Integer piSumBackportErr
        // The DISTINCT ambiguous message names behind the 4544 errors, lifted from the compiler texts
        // (GET_VALUE -> VALUE). Drives ChangeAmbiguousCallToGet without any declaration harvest.
        Property String[] pasAmbiguousFnNames
        // The distinct FILES those 4544s were reported in. A call-site converter must run where the
        // CALLS are, not where the declarations live - so a row action can verify the scope actually
        // covers them and say so, instead of running a pointless pass over the wrong folders.
        Property String[] pasAmbiguousFiles
        // Per-NAME error tallies. The findings list shows one row PER COLLIDING NAME instead of a bare
        // total, because the cause is a handful of declarations and a total of 220 hides that entirely.
        // Parallel arrays to pasAmbiguousFnNames / pasBackportNames. (Nils 2026-07-21.)
        Property Integer[] paiAmbiguousCounts
        // Parallel to pasAmbiguousFnNames (2026-09-20): how many of the name's 4544s sit in a file
        // this workspace can write (IsCompilerNamedFileWritable), and the leaf of the first file it
        // was reported in that it cannot ("" when every site is writable, or none carried a file).
        // A name reported ONLY inside DataFlex's own packages has no call the rewrite can reach; its
        // row and its offer say so instead of ending at "none of the files can be written".
        Property Integer[] paiAmbiguousOwnSites
        Property String[]  pasAmbiguousForeignFile
        // ...and the FIRST reported site of each name - file and line - so its row can open the
        // editor there (Nils 2026-09-20: the name row was "missing a link that can be clicked so the
        // file can be shown in the editor"). "" / 0 when no message for the name carried a file.
        Property String[]  pasAmbiguousFirstFile
        Property Integer[] paiAmbiguousFirstLine
        Property String[]  pasBackportNames
        // Parallel to pasBackportNames: True when the 4390 text says "already defined as an
        // external_function" - the guided findings row then words the fix as delete/guard the
        // duplicate declaration instead of rename (both sides bind the same Windows API).
        Property Boolean[] pabBackportExternal
        Property Integer[] paiBackportCounts
        // The files those 4390s were reported in. The error sits AT the offending declaration, so this
        // is exactly the set the guard converter needs - it can run over 2 files instead of 2000.
        Property String[]  pasBackportFiles
        // Can the guard converter actually DO anything for each name? It only works when DataFlex
        // declares the name as a global function in its Pkg folder; a name owned by the runtime, by a
        // class method or by an External_Function still clashes but must be RENAMED instead. Deciding
        // it here - with the converter's own test - lets the findings list stop offering a button that
        // cannot help (Nils 2026-07-21, after pressing it on four names that all reported nothing).
        Property Boolean[] pabBackportGuardable
        /* WHERE each colliding name is DECLARED (2026-08-16), index-parallel with pasBackportNames:
           the 4390 fires AT the declaration, so a message's file + line IS a declaration site.
           Kept per name, de-duplicated on (file, line) - an include compiled twice reports the same
           line twice. The findings board turns these into one clickable sub-row per site that opens
           the editor there (Nils: "was clickable to load the offending file into the editor so it
           could be renamed/commented out ... This was once handled much better and simpler"). */
        Property String[][]  pasBackportSiteFiles
        Property Integer[][] paiBackportSiteLines
        // Count of IN-SCOPE Explain rows - obsolete commands/packages/patterns in the user's own code
        // that have no auto-fix (a hand migration, listed by the Legacy* reports). Excludes the System
        // (read-only) install-file rows (those are iFiltered). This is the "manual work remaining"
        // signal the campaign-exit handoff reads so "exhausted" stops implying "done" (Nils 2026-07-20).
        Property Integer piSumExplain
        // Diagnostics the analyzer DROPPED entirely (not merely hidden): COM-proxy-file warnings +
        // file-less link/manifest diagnostics. Unlike System (read-only)/Explain rows they never appear
        // even with Toggle Explain, so without a visible count the grid looks emptier than the Compiler
        // Output tab for no apparent reason (a real source of "did I ignore these?" confusion). SummaryHtml
        // renders it as a muted "N excluded" chip so the discrepancy explains itself.
        Property Integer piSumExcluded
        // Count of rows actually SHOWN after the view filter (DisplayFiltered's iKeep) - 0 = the visible grid is
        // empty (rows may exist but all hidden as System/Explain/Ignored). Drives the empty-state placeholder
        // and the Test Compile bar's Ignore Row(s) chip (nothing to select when 0). piSumAuto + piSumSuggest
        // gate Run Modernization Plan the same way (an all-informational grid builds no plan).
        Property Integer piSumVisible
        Property Boolean pbSumSaved
        // FT: set True by IgnoreSelectedRow / ClearIgnored so LoadData refreshes the grid QUIETLY -
        // skipping the docking-flash pump + the RefreshAnalyze broadcast. The re-entrant PumpMsgQueue,
        // fired from the WebView2-deferred button timer, was closing the Compiler Output + Analyzer
        // docks. Reset to False right after the refresh.
        Property Boolean pbQuietRefresh False
        /* Arms DisplayBeat - DisplayFiltered's OWN latch, deliberately separate from every other
           guard here. DisplayFiltered is shared: LoadData calls it at the end of an analyze, but so
           do Ctrl+I (ToggleInformational), the saved-plan loader and the Ignore/Clear refilter, and
           those must keep their old behaviour exactly - a re-entrant pump from the WebView2-deferred
           button timer is what tore the Compiler Output + Analyzer docks down. So ONLY the LoadData
           call site arms this, around its own Send DisplayFiltered, and the beat is inert everywhere
           else. (pbQuietRefresh cannot do this job: it is False for Ctrl+I too.) */
        Property Boolean pbDisplayPumpOk False
        Property String  psSumSavedDate

        // The parsed + workspace-scoped compiler messages from the last analyze. The grid is the
        // SINGLE parser: StartAutoSelect (the refactor plan) reads THIS instead of re-reading and
        // re-filtering the .prn a second time. Set by LoadData; read via
        // (oModAnalyzer_grd(ghoModAnalyzerDock)); StartAutoSelect falls back to a fresh parse if
        // it is ever empty.
        Property tCompileError[] paScopedMessages
        // The PRE-ignore-drop scoped set (cached by LoadData): RefilterIgnored re-derives paScopedMessages
        // from THIS when the ignore list changes (Ignore Row / Clear Ignored) - no .prn re-parse.
        Property tCompileError[] paScopedMessagesFull
        // One-entry memo for IsFileInRefactorScope's attribute lookup: compiler messages arrive
        // grouped by file, so the same file is asked about many times in a row.
        Property String psScopeMemoFile ""
        Property String psScopeMemoWhy  ""

        // Original load-order column. Click its header to restore the order the grid loaded
        // in (the sortable peers below have no natural "original order" to click back to).
        // peDataType Mask_Numeric_Window so it sorts 1,2,..,10,11 numerically, not as text.
        // DisplayFiltered writes a contiguous 1..N here over the rows actually shown.
        Object oRowNum_Col is a cCJGridColumn
            Set piWidth to 34
            Set psCaption to "#"
            Set psToolTip to "Original order - click this header to restore it after sorting another column"
            Set peDataType to Mask_Numeric_Window
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        Object oCategory_Col is a cCJGridColumn
            Set piWidth to 70
            Set psCaption to "Fix"
            Set psToolTip to "How it's handled - Auto-fix: applied cleanly. Review: applied, but check the result. Explain: no auto-fix, do it by hand. Unknown: not mapped yet."
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        Object oErrNo_Col is a cCJGridColumn
            Set piWidth to 56
            Set psCaption to "Msg#"
            Set psToolTip to "W = Warning, E = Error"
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        Object oFile_Col is a cCJGridColumn
            Set piWidth to 260
            Set psCaption to "File"
            Set psToolTip to "Source line (double-click the row to open it in the editor)"
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        Object oLine_Col is a cCJGridColumn
            Set piWidth to 50
            Set psCaption to "Line"
            Set psToolTip to "First warned line. (xN) = the message fires on N lines of this file - they are FOLDED into this one row because the refactor function fixes the whole file in one run."
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        // cRefactorToolTipColumn: the hint is a sentence, so its tooltip is wrapped.
        Object oHint_Col is a cRDCToolTipColumn
            Set piWidth to 380
            Set psCaption to "Suggested fix"
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False

        End_Object

        Object oFn_Col is a cCJGridColumn
            Set piWidth to 160
            Set psCaption to "Refactor function"
            Set psToolTip to "The DFRefactor function that addresses this error (if any)"
            Set pbEditable to False
            Set pbAllowDrag to False
            Set pbAllowRemove to False
        End_Object

        Procedure Delete_Data
            tDataSourceRow[] TheData
            If (not(IsComObjectCreated(Self))) Begin
                Procedure_Return
            End
            Send InitializeData TheData
        End_Procedure

        // FULL reset out of the DEEP SCAN view (Nils 2026-07-11: clicking the dashboard's
        // Compile/Analyze step must return the whole surface to the compile-modernize context -
        // clearing only the mode flag left the stale scan rows + counts driving the bar's
        // you-are-here at "Run Fix Plan"): drop the rows, counts and caches so the bar reads
        // "start with a compile" again. GUARDED: a no-op unless the grid actually holds a scan
        // view - a legit compile-analyze is never nuked. A real Analyze afterwards rebuilds
        // everything from compile output as usual.
        Procedure ClearScanView
            If (pbDeepScanView(Self) = False) ;
                Procedure_Return
            Send ResetAnalyzerData
        End_Procedure

        /* The same wipe with NO guard, for when the grid's contents stop being about the thing on
           screen at all - today that means A WORKSPACE CHANGE (Nils 2026-07-29: "after a workspace
           change the FINDINGS section needs to be reset").

           The findings board builds itself from THIS grid, and nothing emptied it when the user
           picked a different .sws - so workspace A's rows were still here to be rendered, under
           workspace B's name, beside B's own hidden-count (the ignore list IS per-workspace, so the
           two halves of the board came from different projects). Exactly this morning's failure one
           turn on: not a missing verdict, but a verdict belonging to something else.

           pbSavedView and paPendingScanMessages go too, and they are the easy ones to miss:
           saved-view mode would leave the next restore thinking it was already showing a plan, and
           parked scan results would be folded into the NEXT workspace's analyze. */
        Procedure ResetAnalyzerData
            tDataSourceRow[] TheDataEmpty
            tCompileError[] aEmptyMsgs

            // One multi-dimensional array PER LINE - the compiler refuses a shared declaration
            // (4391 "Multi dimensional array variables must be defined one per line").
            String[][] asEmptyOcc
            String[][] asEmptyJag
            Integer[][] aiEmptyJag
            Integer[] aiEmpty
            Boolean[] abEmpty
            String[] asEmpty
            Set pbDeepScanView to False
            Set pbSavedView to False
            Set pbAnalyzeDataReady to False
            Set piSumAuto to 0
            Set piSumSuggest to 0
            Set piSumWarn to 0
            Set piSumErr to 0
            Set piSumCollisionErr to 0
            Set piSumReturnTypeErr to 0
            Set piSumBackportErr   to 0
            Set piSumExplain to 0
            Set piSumFiltered to 0
            Set piSumIgnored to 0
            Set piSumExcluded to 0
            Set piSumVisible to 0
            Set pTheDataFull to TheDataEmpty
            Set paieCatFull to aiEmpty
            Set pabIgnoredFull to abEmpty
            Set pasRowOccFull to asEmptyOcc
            Set pabExpandedFull to abEmpty
            Set paScopedMessages to aEmptyMsgs
            Set paScopedMessagesFull to aEmptyMsgs
            Set paDeepScanMessages to aEmptyMsgs
            Set paPendingScanMessages to aEmptyMsgs
            /* THE COLLISION AND FLOOD SIGNALS GO WITH THE ROWS (Nils 2026-08-31: Clear board
               "deleted the file but the dashboard list still shows Breaks the build").

               The counts above were reset and these arrays were not - and the board does not
               render that band from the counts. _AmbiguousNameRowsHtml / _BackportNameRowsHtml
               walk the NAME arrays directly (one row per colliding name is the whole point of
               them), so a wipe that cleared piSumReturnTypeErr / piSumBackportErr and left
               pasAmbiguousFnNames / pasBackportNames standing produced a Breaks-the-build band
               over an empty grid, reporting zero errors as a list of names.
               Every one of these is published BY a build (RebuildCollisionSignal,
               _CountScanFloods, the row loop) and READ by the board, so every one has to die
               with the build that made it. See [[feedback_data_and_its_loaded_latch_reset_together]].
               If you add a property to that set, clear it here in the same commit. */
            Set pasAmbiguousFnNames  to asEmpty
            Set pasAmbiguousFiles    to asEmpty
            Set paiAmbiguousCounts   to aiEmpty
            Set paiAmbiguousOwnSites to aiEmpty
            Set pasAmbiguousForeignFile to asEmpty
            Set pasAmbiguousFirstFile to asEmpty
            Set paiAmbiguousFirstLine to aiEmpty
            Set pasBackportNames     to asEmpty
            Set pasBackportFiles     to asEmpty
            Set paiBackportCounts    to aiEmpty
            Set pabBackportExternal  to abEmpty
            Set pabBackportGuardable to abEmpty
            Set pasBackportSiteFiles to asEmptyJag
            Set paiBackportSiteLines to aiEmptyJag
            Set paiDSFloodNo         to aiEmpty
            Set paiDSFloodCount      to aiEmpty
            Set paiDSFloodFiles      to aiEmpty
            Set pasDSFloodFirstFile  to asEmpty
            Set paiDSFloodFirstLine  to aiEmpty
            Set pasDSFloodSymbol     to asEmpty
            Set pasDSFloodFirstHint  to asEmpty
            Set pasDSFloodFn         to asEmpty
            Set pasDSFloodFileLists  to asEmptyJag
            Set psNoItemsText to CS_AnalyzerNoItems
            /* Delete_Data is the only line here that reaches COM. ClearScanView could never arrive
               with a cold grid (its pbDeepScanView guard returns first), but the workspace-change
               caller can - the user may switch .sws before the dock has ever been realized. The
               properties above are plain DataFlex and always safe to clear; an unrealized grid has
               no visual rows to delete in the first place. */
            If (IsComObjectCreated(Self) = True) ;
                Send Delete_Data
        End_Procedure

        /* ---- The per-message ROW BUILDER (milestone 3a, 2026-07-23) ----

           The row loop's body, extracted verbatim from LoadData so it can be fed a SLICE of messages
           at a time. LoadData feeds it the whole set in one call (behaviour and cost identical - the
           state lives in locals for the duration of a call); the streaming path (milestone 3b) will
           feed it incrementally from the compile's poll timer, one slice per tick, which is why every
           piece of loop-carried state below is a property: batched ONE Get at slice entry and ONE Set
           at slice exit, never per message (a per-message property round-trip deep-copies the growing
           arrays - the jagged-cache lesson). Messages arrive FILE-GROUPED, so per-file state (the
           merge window, the guard cache, the actionable set) carries across slice boundaries exactly
           as it carried across loop iterations.

           pbBuildPumpEnabled: LoadData sets True (the builder keeps the classic pump cadence: per new
           file + every 15 messages); a streaming caller sets False - it already runs ON the pump. */
        Property tDataSourceRow[] pBuildTheData
        Property Integer[]  paiBuildCat
        Property Integer[]  paiBuildCount
        Property String[]   pasBuildKeys
        Property String[][] pasBuildRowOcc
        Property Integer    piBuildItems
        Property String     psBuildWinFile
        Property String[]   pasBuildWinKeys
        Property Integer[]  paiBuildWinRows
        /* THE COMPILER'S GENERIC TWIN FOLDS INTO THE FIXABLE ROW (2026-08-16). One source line can draw
           two diagnostics with the same number: the SPECIFIC text a converter maps ("Conversion from
           Pointer to String is not allowed, use PointerToString function") and, right after it, the
           GENERIC one ("Illegal datatype conversion (would lead to a runtime error if not corrected)").
           Rows key by kind - a mapped message folds into file|fn|<function>, a function-less one gets
           its own file|line row - so the twin surfaced as a second, unfixable Explain row for a line
           already in the plan (Nils, WinServCrypt.pkg 193: "why is this line not listed as Auto-fix").
           Per file, the (line|msg) keys a mapped row was emitted for, with that row's index: a
           function-less recipe for the same key joins that row's occurrences instead of becoming a
           row. Reset with the file window; persisted across streamed slices like the window arrays. */
        Property String[]   pasBuildFnLineKeys
        Property Integer[]  paiBuildFnLineRows
        Property String[]   pasBuildActionable
        Property String     psBuildGuardFile
        Property String[]   pasBuildGuardLines
        // What the last plans ran without changing a file (cPlanNoOps): read once per build in
        // _ResetRowBuildState, for VerifyPlanNoOp - the same step the plan applies.
        Property String[]   pasNoOpFiles
        Property String[]   pasNoOpStamps
        Property String[]   pasNoOpFns
        Property Boolean    pbBuildPinnedDone
        Property String     psBuildLastPumpFile
        Property Integer    piBuildPump
        Property Integer    piBuildWarn
        Property Integer    piBuildErr
        // The SCAN lane's own tally - see piSumScan for why it is not counted with the warnings.
        Property Integer    piBuildScan
        Property Boolean    pbBuildFlood
        Property String     psBuildFirstCollFile
        Property Integer    piBuildFirstCollLine
        Property Boolean    pbBuildPumpEnabled
        Property Integer    piBuildStartTick

        /* One beat of the analyze elapsed counter, for the phases that are NOT the row-build loop.
           The loop carries its own beat (per new file + every 15 messages) - but a STREAM-ADOPTED
           analyze never enters it: the rows were built tick-by-tick DURING the compile, so with
           iPend = 0 neither branch of the build/adopt block calls _BuildRowsForSlice at all. The
           four prep-boundary beats above all fire within milliseconds of iStartTick, so the bar
           painted "Analyzing data... (0s)" once and then sat frozen through the sum passes, the
           grid load and the dashboard rebuild (Nils 2026-08-10, measured).
           Gated exactly like those prep beats: never on a quiet refresh, which must NOT pump - it
           tears the Compiler Output + Analyzer docks down. */
        /* NAMED (2026-08-15 evening): a first Check on the fresh WinServ copy sat in "Analyzing
           data... (Ns)" for 10+ minutes at 98% of one core with a 463-diagnostic listing - a
           spin, not work - and the bar could not say WHICH stage, because every beat printed
           the same words. Each beat now names its stage, so a spin points at itself. */
        Procedure AnalyzeBeat Integer iStartTick String sStage
            Handle hoStatusBar

            // The quiet-refresh guard is LOAD-BEARING: re-entering the pump from a quiet in-place
            // refresh tore down the Compiler Output + Analyzer docks (see LoadData's note).
            /* THE TEXT IS UNCONDITIONAL, THE PUMP IS GUARDED (2026-08-15 21:10). A 495 s Check
               showed ONLY the initial "Analyzing data..." and never one stage beat - every beat
               was gated on pbQuietRefresh as a whole, so a quiet run built its rows in silence
               and a spinning run could not be told from a slow one. Writing a status string is
               safe anywhere; it is the PUMP that re-entered from a quiet in-place refresh and
               tore down the docks (LoadData's note). The guard stays exactly where it is
               load-bearing and nowhere else. */
            Get Statusbar_Id of (phoMainPanel(ghoApplication)) to hoStatusBar
            If (hoStatusBar = 0) ;
                Procedure_Return
            Set StatusText of hoStatusBar to ("Analyzing data - " + sStage + " (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
            If (pbQuietRefresh(Self) = False) ;
                Send PumpMsgQueue of Desktop
        End_Procedure

        /* The same beat, for the phases INSIDE DisplayFiltered - the view-row build and the grid
           paint. That stretch is the tail of an analyze and can be tens of seconds on a large
           triage; it used to run under one static "loading grid" note with no pump, so the wait
           cursor stopped animating there (Nils 2026-08-31). Elapsed comes from piBuildStartTick,
           which LoadData publishes unconditionally at the top of the run, so the seconds shown
           here continue the SAME clock as every other beat rather than restarting.
           Gated on pbDisplayPumpOk - see that property for why it is its own latch. The
           text/pump split is AnalyzeBeat's (writing the bar is safe anywhere; pumping is not). */
        Procedure DisplayBeat String sStage
            If (pbDisplayPumpOk(Self) = False) ;
                Procedure_Return
            Send AnalyzeBeat (piBuildStartTick(Self)) sStage
        End_Procedure

        Procedure _ResetRowBuildState
            tDataSourceRow[] aEmptyRows
            Integer[] aiEmpty
            String[] asEmpty
            Handle hoNoOps

            String[][] asEmptyOcc
            Set pBuildTheData       to aEmptyRows
            Set paiBuildCat         to aiEmpty
            Set paiBuildCount       to aiEmpty
            Set pasBuildKeys        to asEmpty
            Set pasBuildRowOcc      to asEmptyOcc
            Set piBuildItems        to 0
            Set psBuildWinFile      to ""
            Set pasBuildWinKeys     to asEmpty
            Set paiBuildWinRows     to aiEmpty
            Set pasBuildFnLineKeys  to asEmpty
            Set paiBuildFnLineRows  to aiEmpty
            Set pasBuildActionable  to asEmpty
            Set psBuildGuardFile    to ""
            Set pasBuildGuardLines  to asEmpty
            Set pbBuildPinnedDone   to False
            Set psBuildLastPumpFile to ""
            Set piBuildPump         to 0
            Set piBuildWarn         to 0
            Set piBuildErr          to 0
            Set piBuildScan         to 0
            Set pbBuildFlood        to False
            Set psBuildFirstCollFile to ""
            Set piBuildFirstCollLine to 0
            // What the last plans ran without changing a file (cPlanNoOps), once per build.
            Set pasNoOpFiles  to asEmpty
            Set pasNoOpStamps to asEmpty
            Set pasNoOpFns    to asEmpty
            Get Create (RefClass(cPlanNoOps)) to hoNoOps
            If (hoNoOps <> 0) Begin
                Send LoadRecord of hoNoOps
                Set pasNoOpFiles  to (pasRecFiles(hoNoOps))
                Set pasNoOpStamps to (pasRecStamps(hoNoOps))
                Set pasNoOpFns    to (pasRecFns(hoNoOps))
                Send Destroy of hoNoOps
            End
            // The include lift's run set, the analyzer's optimistic form (see pasRunFiles, cBaseFuncLib):
            // the plan sets the same, the engine sets the exact selection. Per build, so the memos start
            // clean for every slice this build feeds - the streamed ones included.
            If (ghoFuncLib <> 0) ;
                Send _SetRunFilesAll of ghoFuncLib
        End_Procedure

        Procedure _BuildRowsForSlice tCompileError[] ByRef aMsgs Integer iFrom Integer iTo Handle ho tModAnalyzer[] ByRef aRecipesAll
            tDataSourceRow[] TheData
            tModAnalyzer Recipe
            tModAnalyzer[] aMatched aRowRecipes
            String[] asKey asWinKey asActionableKey asGuardLines asPinned asEmptyPin asEmptyStr asFnLineKey

            String[][] asRowOcc
            Integer[] aiCount aiWinRow aieCat asEmptyInt aiDSFloodNo aiFnLineRow
            String sFile sLn sMsgTok sFn sKey sExisting sGuardFn sSrcLine sWinFile sGuardFile sLastPumpFile sFirstCollFile sTwinKey
            String sMacroName sMacroHint
            Integer iCount iItem iWarn iErr iPump iGuardLn iWin iRow iMatch iRows j k iStartTick iFirstCollLine
            Integer iMacroKind iMacroDef iSrcIdx iScan iFloodKey
            String sObsCmd
            Boolean bMacroRow bNewPlace bHeld
            Integer iCategory_Col iErrNo_Col iFile_Col iLine_Col iHint_Col iFn_Col
            Boolean bSkipMsg bNeedsGuard bPinnedDone bFlood bPump bRowInScope
            String[] asScopeRootsB
            String sScopeWhyB
            Handle hoStatusBar
            tModAnalyzer Explained
            Boolean bHadFn bExplained
            String sHintIn
            String[] asNoOpFiles asNoOpStamps asNoOpFnsAll asNoOpFns
            String sNoOpFile
            // ---- state in: one Get each, locals for the whole slice ----
            // Scope roots ONCE for the whole slice - the per-file answer below is memoed inside
            // IsFileInRefactorScope, so asking it per row costs a string compare after the first.
            Get GetWorkspaceScopeRoots to asScopeRootsB
            Get pasNoOpFiles  to asNoOpFiles
            Get pasNoOpStamps to asNoOpStamps
            Get pasNoOpFns    to asNoOpFnsAll
            Move (Character(1)) to sNoOpFile
            Get pBuildTheData       to TheData
            Get paiBuildCat         to aieCat
            Get paiBuildCount       to aiCount
            Get pasBuildKeys        to asKey
            Get pasBuildRowOcc      to asRowOcc
            Get piBuildItems        to iItem
            Get psBuildWinFile      to sWinFile
            Get pasBuildWinKeys     to asWinKey
            Get paiBuildWinRows     to aiWinRow
            Get pasBuildFnLineKeys  to asFnLineKey
            Get paiBuildFnLineRows  to aiFnLineRow
            Get pasBuildActionable  to asActionableKey
            Get psBuildGuardFile    to sGuardFile
            Get pasBuildGuardLines  to asGuardLines
            Get pbBuildPinnedDone   to bPinnedDone
            Get psBuildLastPumpFile to sLastPumpFile
            Get piBuildPump         to iPump
            Get piBuildWarn         to iWarn
            Get piBuildErr          to iErr
            Get piBuildScan         to iScan
            Get pbBuildFlood        to bFlood
            Get psBuildFirstCollFile to sFirstCollFile
            Get piBuildFirstCollLine to iFirstCollLine
            Get pbBuildPumpEnabled  to bPump
            Get piBuildStartTick    to iStartTick
            Get paiDSFloodNo        to aiDSFloodNo
            Get piColumnId of oCategory_Col to iCategory_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oLine_Col     to iLine_Col
            Get piColumnId of oHint_Col     to iHint_Col
            Get piColumnId of oFn_Col       to iFn_Col
            // Fetched UNCONDITIONALLY: the status text is written on every path now, only the
            // pump is gated on bPump. Gating the handle on bPump made a quiet run mute.
            Get Statusbar_Id of (phoMainPanel(ghoApplication)) to hoStatusBar
            /* ...but only WHILE AN ANALYZE RUNS (2026-10-03). The Test Compile dock drives this builder
               too, on the COMPILE tick (StreamAnalyzeTick), in batches of up to 200 listing lines - and
               there the bar is the compile's: "Compiling <program>... (m:ss)", then "Finalizing compiler
               listing...". Written from here it read "Analyzing data - row 191 of 200 (816400s)": a row
               inside one batch, and seconds counted from a start the analyze had not taken yet - the
               machine's uptime on the first Check after a restart (Nils 2026-10-03). */
            If (pbLoadDataRunning(Self) = False) ;
                Move 0 to hoStatusBar
            For iCount from iFrom to iTo
                Move aMsgs[iCount].sFileName       to sFile
                If (sFile <> sNoOpFile) Begin
                    Move sFile to sNoOpFile
                    Get PlanNoOpFunctionsIn (&asNoOpFiles) (&asNoOpStamps) (&asNoOpFnsAll) sFile to asNoOpFns
                End
                Move (String(aMsgs[iCount].iLine)) to sLn
                // Reset the per-file windows (merge dedup + guard-skip) when the file changes. Messages arrive
                // file-grouped (the single-slot source-read cache never thrashed, proving contiguity), so a
                // per-file key window resolves every merge / actionable-confirm in O(keys-in-file) instead of a
                // global O(rows) SearchArray on each of the ~26000 emitted recipes.
                If (sFile <> sWinFile) Begin
                    Move asEmptyStr to asWinKey
                    Move asEmptyInt to aiWinRow
                    Move asEmptyStr to asActionableKey
                    Move asEmptyStr to asFnLineKey
                    Move asEmptyInt to aiFnLineRow
                    Move sFile to sWinFile
                End
                // Keep the marquee animating during the (now heavier) per-row source-guard + whole-file dry-run:
                // pump on each NEW file - a natural progress beat that also covers a workspace with few messages
                // but heavy whole-file probes. Non-quiet only (a quiet Ignore/Clear refresh must NOT re-enter the
                // pump - it tears the Compiler Output + Analyzer docks down; see the top-of-parse note).
                // Text on every file change regardless of bPump; the PUMP only when bPump (a quiet
                // refresh must not re-enter it - see the top-of-parse note). Same split as AnalyzeBeat.
                If (sFile <> sLastPumpFile) Begin
                    If (hoStatusBar <> 0) ;
                        Set StatusText of hoStatusBar to ("Analyzing data - row " + String(iCount + 1) + " of " + String(iTo + 1) + " (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                    If (bPump = True) ;
                        Send PumpMsgQueue of Desktop
                    Move sFile to sLastPumpFile
                    Move 0 to iPump
                End
                // Warning/error tally is PER MESSAGE (once), independent of how many functions it maps to.
                // A Deep Scan row wears its own "DS <n>" token (n = the rule's stable pseudo number,
                // also its recipe + ignore key) and counts into its OWN tally, NOT with the compiler's
                // warnings - it is a source-scan finding and the compiler never said it (see piSumScan).
                If (aMsgs[iCount].bDeepScan) Begin
                    Move ("DS " + String(aMsgs[iCount].iErrorNo)) to sMsgTok
                    Increment iScan
                End
                Else If (aMsgs[iCount].bError) Begin
                    Move ("E " + String(aMsgs[iCount].iErrorNo)) to sMsgTok
                    Increment iErr
                End
                Else Begin
                    Move ("W " + String(aMsgs[iCount].iErrorNo)) to sMsgTok
                    Increment iWarn
                End
                // COLLISION-FLOOD BAIL: on a flood, skip the (expensive) classify + emit for the collision
                // messages - they collapse into one summary row (emitted after the loop). Remember the first
                // one's file/line so that summary row points somewhere real. Still tallied above, so piSumWarn
                // / piSumErr stay complete.
                Move False to bSkipMsg
                // A FLOODING SCAN RULE'S finding is tallied (above) and skipped here - one summary
                // row per rule is emitted after the loop. Same move as the collision flood below.
                If (aMsgs[iCount].bDeepScan = True and SizeOfArray(aiDSFloodNo) > 0) Begin
                    // By the same key the tally used (cModAnalyzer.DSFloodKey): a hit whose own verdict
                    // dropped the converter belongs to the rule's NEGATIVE flood, not to its own.
                    Get DSFloodKey of ho aMsgs[iCount] to iFloodKey
                    If (SearchArray(iFloodKey, aiDSFloodNo) <> -1) ;
                        Move True to bSkipMsg
                End
                If (bFlood = True and (aMsgs[iCount].iErrorNo = 4544 or aMsgs[iCount].iErrorNo = 4390)) Begin
                    Move True to bSkipMsg
                    If (sFirstCollFile = "") Begin
                        Move aMsgs[iCount].sFileName to sFirstCollFile
                        Move aMsgs[iCount].iLine     to iFirstCollLine
                    End
                End
                If (bSkipMsg = False) Begin
                // One message can map to MORE THAN ONE refactor (e.g. a 4533 "command: Begin_Row" is emitted
                // by both a dbGrid and a dbList). Match EVERY recipe, source-guard each, and collect every one
                // that still carries a refactor function - the SAME set PlanFromMessages builds. Classifying
                // with ONE recipe (ClassifyMessage) here is what let the grid + its saved plan come back short
                // of a fresh run (the saved plan dropped a multi-match message's second function).
                Get MatchingRecipesFromList of ho aMsgs[iCount].iErrorNo aMsgs[iCount].sErrorTxt (&aRecipesAll) to aMatched
                Move (SizeOfArray(aMatched)) to iMatch
                Move 0 to iRows
                Move False to bExplained
                For j from 0 to (iMatch - 1)
                    Move aMatched[j] to Recipe
                    Move (Trim(Recipe.sRefactorFn) <> "") to bHadFn
                    Move Recipe.sHint to sHintIn
                    // A LIBRARY file's message never carries a refactor function - the library is
                    // replaced, not edited. Applied here, before the guard machinery, so it covers
                    // every message and a stripped recipe skips the expensive guard below. The PLAN
                    // applies the same call at the same point - keep the two in lock-step.
                    Get VerifyLibraryOwned of ho Recipe aMsgs[iCount].sFileName to Recipe
                    // The Deep Scan's own verdict for THIS hit outranks its rule's defaults - a
                    // subclass object no converter acts on, a #COMMAND body (VerifyScanVerdict).
                    // The PLAN applies the same call at the same point - keep the two in lock-step.
                    Get VerifyScanVerdict of ho Recipe aMsgs[iCount] to Recipe
                    // A function the last plan ran on this file without changing it (cPlanNoOps).
                    // The PLAN applies the same call at the same point - keep the two in lock-step.
                    Get VerifyPlanNoOp of ho Recipe (&asNoOpFns) to Recipe
                    // Source-guard against the real source line: a refactor only applies if its obsolete
                    // construct is ON that line (not inside a macro/command expansion - File_Exist_OEM's body
                    // calls ToOEM, Deferred_View's has [Found ~Found]); else VerifyAutoFix demotes it to
                    // Explain. Read lazily, cache the last file, never demote on a failed read - the SAME
                    // guard PlanFromMessages applies, so grid + Auto Select agree on the source-guard.
                    Get RecipeNeedsSourceGuard of ho Recipe to bNeedsGuard
                    /* THE GUARDS RUN ON A COLLISION FLOOD TOO (2026-08-16). This used to read
                       "and bFlood = False": on a flood the "whole triage is provisional", so the
                       per-line source-guard + dry-run were skipped and every row kept its recipe's
                       DEFAULT category. But the collision messages themselves are skipped BEFORE this
                       point on a flood (the bail above), so the skip only ever disabled the guards for
                       every OTHER row - and WinServ has 169 E 4544s standing. Result: a plan of 67
                       Auto-fix rows that changed 0 files, twice. GetAddress rows never dry-ran (the
                       converter cannot convert them under the DF26 catalogue - fixed separately, but
                       the guard would have said so), two dfTimer objects carrying the converter's own
                       //TODO (skipped) marker were re-offered, and File_Exist_Oem's ToOem-in-a-macro
                       row was never demoted. Every one of those is exactly what these guards exist to
                       catch. The flood still collapses the collision rows and still marks the summary;
                       it no longer blinds the rest of the board. */
                    If (bNeedsGuard = True) Begin
                        // Skip the (expensive) per-line source-guard + dry-run once THIS file has already
                        // confirmed the function actionable via an earlier warned line. The refactor runs
                        // file-wide and the row merges to its most-actionable category, so one confirmation
                        // settles all of a file's same-function warnings - a file's 50 Mid dry-runs collapse to
                        // 1. Messages arrive file-grouped, so the "already confirmed?" set is kept PER FILE
                        // (reset below when the file changes): a tiny list of functions-in-this-file, searched
                        // in O(functions-in-file), NOT a global O(rows) SearchArray over 2000+ keys on every one
                        // of ~26000 messages (that global scan was ~half the per-message cost). A (file,function)
                        // that has NOT confirmed keeps probing until one line does - or every line demotes and
                        // the row is informational. The category is unchanged (merge takes the max); a line the
                        // function itself no-ops but that shares a (file,function) with an actionable one folds
                        // into the row rather than a standalone review row until the fix runs (the standalone-
                        // no-op case the demote guards stays surfaced). Safe on a non-contiguous file - it just
                        // re-guards, same result. (Nils LegacyApp perf 2026-07-02.)
                        Move (Lowercase(Trim(Recipe.sRefactorFn))) to sGuardFn
                        If (aMsgs[iCount].sFileName <> sGuardFile) Begin
                            Move (rfReadEncodedFileAsStringArray(aMsgs[iCount].sFileName)) to asGuardLines
                            Move aMsgs[iCount].sFileName to sGuardFile
                            // LAZY pinned compute (Nils 2026-07-17: the eager per-guarded-file compute
                            // was ~940ms/file - 100 of a 110s WinServ plan build; the grid paid the
                            // same in Analyze). On a file change just EMPTY the set (a stale previous-
                            // file set must never leak into a verify); the compute runs below on the
                            // FIRST indicator-fn recipe guarded for this file - never otherwise. The
                            // plan does the SAME (PlanFromMessages) so grid == plan verdicts hold.
                            Move False to bPinnedDone
                            Set pasPinnedIndicators of ghoFuncLib to asEmptyPin
                            // Reasons go with the names (see the same clear in cModAnalyzer).
                            Set pasPinnedReasons of ghoFuncLib to asEmptyPin
                        End
                        /* EVERY row, not just the first of a (file, function): a line inside a
                           #COMMAND body is never Auto-fix. Inside the skip below it demoted only
                           the FIRST row of a file, and rows merge to their MOST actionable
                           category - so that lone demotion was discarded and the row still read
                           Auto-fix. The file read is hoisted for the same reason, and costs
                           nothing: asActionableKey resets whenever the file changes, so the first
                           guarded row of a file reads it either way. */
                        Get VerifyMacroBodyLine of ho Recipe (&asGuardLines) aMsgs[iCount].iLine to Recipe
                        /* EVERY row too, and for the same reason: a Class/Procedure line is never
                           fixable by the object converters, and once ONE row of this (file,
                           function) pair is confirmed actionable the skip below stops looking -
                           so a demotion applied only inside it would be discarded for exactly the
                           rows that need it. The PLAN applies the same call; keep them in step. */
                        Get VerifyLegacyClassShape of ho Recipe (&asGuardLines) aMsgs[iCount].iLine to Recipe
                        If (SearchArray(sGuardFn, asActionableKey) = -1) Begin
                            If (bPinnedDone = False and _IsIndicatorConverterName(ho, Recipe.sRefactorFn)) Begin
                                Get _ComputePinnedIndicators of ghoFuncLib (&asGuardLines) sGuardFile to asPinned
                                Set pasPinnedIndicators of ghoFuncLib to asPinned
                                Move True to bPinnedDone
                            End
                            Move aMsgs[iCount].iLine to iGuardLn
                            If (iGuardLn >= 1 and iGuardLn <= SizeOfArray(asGuardLines)) Begin
                                // Walk back over ';'-continuations so a multi-line declaration's keyword is seen.
                                Get GuardLineForStatement of ho (&asGuardLines) iGuardLn to sSrcLine
                                Get VerifyAutoFix of ho Recipe sSrcLine to Recipe
                                // A converter's own skip-marker outranks the recipe: demote to Explain so
                                // a refusal it already wrote into the source is not re-offered as a fix.
                                // The PLAN applies the same call right here - keep the two in lock-step.
                                Get VerifySkipMarker of ho Recipe (&asGuardLines) iGuardLn to Recipe
                                // Begin_Row rows: resolve the enclosing object so the row picks the RIGHT grid/list
                                // converter and the hint names the object + the subclass parameter (e.g. dbList0).
                                // The SAME enrichment the plan applies (PlanFromMessages) - keep in lock-step.
                                Get VerifyBeginRow of ho Recipe (&asGuardLines) iGuardLn to Recipe
                            End
                            // Whole-file auto-fixes (RemovePropertyPrivate/Public): demote to Explain if the real
                            // function, run on the WHOLE file, would change nothing (a guarded property). No-op for
                            // line-by-line / non-whole-file recipes. Reuses the file lines read above; skipped on a
                            // failed/empty read so we never demote on a read error (see the guard note above).
                            If (SizeOfArray(asGuardLines) > 0) ;
                                Get VerifyAutoFixWholeFile of ho Recipe (&asGuardLines) sGuardFile to Recipe
                            // Remember a confirmed-actionable function for THIS file so its remaining warnings skip.
                            /* ...BUT ONLY WHEN THE GUARDS LEFT THE FUNCTION AS IT WAS (2026-10-05). VerifyBeginRow
                               hands a Begin_Row inside an object of the workspace's own grid subclass to another
                               function, ConvertGridSubclassToCodeJock - an answer about that OBJECT, not about the
                               file. Remembered here under the recipe's own name, the first grid's answer let every
                               later Begin_Row of the file skip the guards and keep the raw recipe: on one
                               workspace 198 Review rows offered the plain converter for objects it leaves as they
                               are - the second and later grids of 198 files - beside the Auto-fix row of the
                               first. A replaced function is not remembered, so each grid is asked on its own and
                               the rows merge under the function that will convert them. */
                            If (Trim(Recipe.sRefactorFn) <> "" and Lowercase(Trim(Recipe.sRefactorFn)) = sGuardFn) ;
                                Move sGuardFn to asActionableKey[-1]
                        End
                    End
                    // The first converter a guard took away and said why - see the information row below.
                    If (bExplained = False and bHadFn = True and Trim(Recipe.sRefactorFn) = "" and Recipe.sHint <> sHintIn) Begin
                        Move Recipe to Explained
                        Move True to bExplained
                    End
                    If (Trim(Recipe.sRefactorFn) <> "") Begin
                        Move Recipe to aRowRecipes[iRows]
                        Increment iRows
                    End
                Loop
                /* No applicable refactor (nothing matched, or every match was function-less / demoted to
                   Explain) -> ONE informational row; ClassifyMessage covers the nothing-matched case.

                   THE ROW SAYS WHY (2026-10-04). It took the LAST recipe of the loop, and a message usually
                   matches the install catalog's function-less Explain as well - which only repeats the
                   compiler. On one workspace all 1,383 Begin_Row rows read "Begin_Row is obsolete. Use
                   cCJGrid ..." where VerifyBeginRow had written "'MyDbList' is your own subclass ... port it
                   first". So the row takes the FIRST recipe that had a converter and lost it to a guard that
                   wrote why: its hint changed on the way through. A converter dropped without a word - the
                   wrong grid family - does not count, and the last recipe stays the fallback. */
                If (iRows = 0) Begin
                    If (iMatch = 0) ;
                        Get ClassifyMessage of ho aMsgs[iCount].iErrorNo aMsgs[iCount].sErrorTxt to Recipe
                    If (bExplained = True) ;
                        Move Explained to Recipe
                    Move Recipe to aRowRecipes[0]
                    Move 1 to iRows
                End
                /* A MISSING INCLUDE THAT SITS IN A LIBRARY THE WORKSPACE DOES NOT REFERENCE (Nils 2026-10-05):
                   the one row gets the hint that says where the file is and which library to add
                   (cModAnalyzer.VerifyMissingInclude). A row a converter owns comes back as it went in. */
                If (aMsgs[iCount].iErrorNo = 4313 and iRows = 1) Begin
                    Move aRowRecipes[0] to Recipe
                    Get VerifyMissingInclude of ho Recipe 4313 aMsgs[iCount].sErrorTxt to Recipe
                    Move Recipe to aRowRecipes[0]
                End
                // Emit / merge each collected recipe. A refactor-mapped message collapses to ONE row per
                // (file, function) - the refactor runs file-wide, so a file's 50 indicators (or a dbGrid's
                // many Begin_Rows) become a single row + an occurrence count; a function-less message stays
                // one row per source line. Later messages on the same key merge in (most-actionable category
                // wins, the Msg# list grows).
                For k from 0 to (iRows - 1)
                    Move aRowRecipes[k]             to Recipe
                    Move (Trim(Recipe.sRefactorFn)) to sFn
                    /* A READ-ONLY FILE KEYS WITHOUT THE FUNCTION, so several candidate converters for
                       one message collapse to ONE row instead of N identical ones.

                       The row key is normally per (file, function), which is right: two converters are
                       two different offers. But a file outside the refactor scope has its function
                       STRIPPED further down, when the row is re-badged "System (read-only)" - and once
                       that has happened the rows are byte-identical, differing only in a column nobody
                       can see any more. W 4534 "use of ToANSI" matches two converters
                       (UnicodeOemAnsiFunctions and ChangeOemFileCommands), so a read-only file with
                       seven of them showed FOURTEEN indistinguishable rows (Nils 2026-08-29).

                       Keyed here rather than compacted afterwards: by the time the badge is applied the
                       row has nine parallel arrays riding on its index, and dropping one of those means
                       compacting all nine in lockstep or silently mis-aiming every row action. Merging
                       is a supported operation on this key already - most-actionable category wins and
                       the Msg# list grows - so the merge path is the one that was already tested. */
                    Move True to bRowInScope
                    If (SizeOfArray(asScopeRootsB) > 0) ;
                        Get IsFileInRefactorScope sFile asScopeRootsB (&sScopeWhyB) to bRowInScope
                    If (sFn <> "" and bRowInScope = True) ;
                        Move (Lowercase(sFile) + "|fn|" + Lowercase(sFn)) to sKey
                    Else ;
                        Move (Lowercase(sFile) + "|" + sLn)               to sKey
                    /* THE MACRO-ORIGIN FOLD (2026-09-09). A construct inside a #COMMAND body is reported by
                       the compiler at EVERY EXPANSION of that command, so VerifyAutoFix demotes it to
                       Explain (it is not on the line) - and a function-less row keys per LINE, which makes
                       one macro body into one row per call site. On a legacy workspace that is the single
                       largest source of rows: 484 warnings over one workspace were 383 expansions of just
                       SIX macros, one of them alone accounting for 310 of them across 31 call sites. The
                       figure quoted in CS_ModMacroExpansionHint's own note - 579 rows across 542 files -
                       is the same shape.

                       Keying per (file, MACRO) folds them the way a refactor-mapped row already folds per
                       (file, function), and for the same reason: one row per thing the user could act on.
                       The existing merge does the rest - the count rides in the Line column as '(xN)' (see
                       the post-loop pass in LoadData) and the Msg# list grows.

                       PER FILE, not globally, so the row's File column stays truthful and its double-click
                       still lands somewhere real - a macro called from three files gives three rows, each
                       naming the same definition, which also shows the spread.

                       Gated on the hint being exactly CS_ModMacroExpansionHint: that is the ONE demote that
                       means 'the construct is not on this line', so the fold can never swallow a row
                       demoted for another reason (a skip marker, a library file, a failed dry-run). The
                       source line is re-read from asGuardLines rather than trusting sSrcLine, which holds
                       whatever the last GUARDED recipe looked at and can be a previous message's line. */
                    Move "" to sMacroName
                    If (sFn = "" and sGuardFile = aMsgs[iCount].sFileName) Begin
                        Move (aMsgs[iCount].iLine - 1) to iSrcIdx
                        If (iSrcIdx >= 0 and iSrcIdx < SizeOfArray(asGuardLines)) Begin
                            /* TWO WAYS TO KNOW THE CONSTRUCT IS NOT ON THIS LINE, because two kinds of row
                               arrive here. A row VerifyAutoFix demoted says so in its hint - it ran Guard D
                               and found the keyword absent. But a message that matched only a GENERIC
                               Explain recipe was never guarded at all (VerifyAutoFix returns before the
                               guards for a row that was never Auto-fix or Review), and those are real
                               expansions too: 20 Item_List rows from ONE command body stayed one row per
                               call site in the first cut of this fold. For them, run the same test here -
                               the obsolete command named in the MESSAGE against the line's own text. */
                            Move False to bMacroRow
                            If (Recipe.sHint = CS_ModMacroExpansionHint) ;
                                Move True to bMacroRow
                            Else Begin
                                Get ObsoleteCommandInMessage of ho aMsgs[iCount].sErrorTxt to sObsCmd
                                If (sObsCmd <> "") ;
                                    Move (Pos(sObsCmd, Lowercase(asGuardLines[iSrcIdx])) = 0) to bMacroRow
                            End
                            If (bMacroRow = True) Begin
                                Get MacroExpansionCause of ho asGuardLines[iSrcIdx] (&sMacroName) to iMacroKind
                                // Only a MACRO invocation folds. eMacroCauseClass ('Object X is a Y') is a real
                                // per-object row - the user acts on each object - and Unknown names nothing.
                                If (iMacroKind <> eMacroCauseMacro) ;
                                    Move "" to sMacroName
                            End
                        End
                    End
                    If (sMacroName <> "") ;
                        Move (Lowercase(sFile) + "|macro|" + Lowercase(sMacroName)) to sKey
                    // The generic twin of a mapped message on this very (line, msg#) joins the mapped
                    // row instead of becoming its own function-less row - see pasBuildFnLineKeys.
                    Move (sLn + "|" + sMsgTok) to sTwinKey
                    Move -1 to iRow
                    If (sFn = "") Begin
                        Move (SearchArray(sTwinKey, asFnLineKey)) to iWin
                        If (iWin <> -1) ;
                            Move aiFnLineRow[iWin] to iRow
                    End
                    If (iRow <> -1) Begin
                        // folded: fall through to the merge branch below with iRow set
                    End
                    Else Begin
                    Move (SearchArray(sKey, asWinKey)) to iWin
                    If (iWin <> -1) Begin
                        Move aiWinRow[iWin] to iRow                     // fast path: this file's window
                    End
                    Else Begin
                        // Window miss: fall back to the GLOBAL key list so a file that reappears in a LATER .prn
                        // block (non-contiguous), or under a different-case path, still merges into its existing
                        // row instead of a duplicate. Misses are only new keys + rare reappearances, so the O(rows)
                        // global scan runs ~2882 times, not 26000 - still far cheaper than the old per-message scan.
                        Move (SearchArray(sKey, asKey)) to iRow
                        If (iRow <> -1) Begin
                            Move sKey to asWinKey[-1]
                            Move iRow to aiWinRow[-1]
                        End
                    End
                    End   // not a folded twin
                    // A mapped row remembers its (line, msg#) so a later generic twin can find it.
                    If (sFn <> "" and SearchArray(sTwinKey, asFnLineKey) = -1) Begin
                        Move sTwinKey to asFnLineKey[-1]
                        Move (If(iRow = -1, iItem, iRow)) to aiFnLineRow[-1]
                    End
                    If (iRow = -1) Begin
                        Move iItem                        to iRow
                        Move sKey                         to asKey[iRow]
                        Move sKey                         to asWinKey[-1]
                        Move iRow                         to aiWinRow[-1]
                        Move 1                            to aiCount[iRow]
                        Move Recipe.eCategory             to aieCat[iRow]
                        Move Recipe.sCategoryText         to TheData[iRow].sValue[iCategory_Col]
                        Move sMsgTok                      to TheData[iRow].sValue[iErrNo_Col]
                        Move sFile                        to TheData[iRow].sValue[iFile_Col]
                        Move aMsgs[iCount].iLine to TheData[iRow].sValue[iLine_Col]
                        // A folded macro row says WHICH command and where its body is; the definition is
                        // looked for in the lines already read for the source guard, so it costs nothing.
                        If (sMacroName <> "") Begin
                            Get MacroDefinitionLine of ho (&asGuardLines) sMacroName to iMacroDef
                            Get MacroOriginHint of ho sMacroName iMacroDef to sMacroHint
                            Move sMacroHint               to TheData[iRow].sValue[iHint_Col]
                        End
                        Else ;
                            Move Recipe.sHint             to TheData[iRow].sValue[iHint_Col]
                        Move sFn                          to TheData[iRow].sValue[iFn_Col]
                        Increment iItem
                    End
                    Else Begin
                        /* A PLACE IS COUNTED ONCE (Nils 2026-09-11: "27 (x6)" over three GetAddress
                           lines). The Deep Scan lane is appended AFTER the compiler lane and often
                           finds the same construct - W 4533 and DS 9014 both name lines 27, 63 and
                           66 - so counting messages doubled every such row. A scan hit on a line this
                           row already holds is still folded in - its Msg# joins the list and the
                           unfold view lists it - but it is not a new place. Compiler messages count
                           as before: two on one line are two messages the compiler really gave, and
                           the collision totals below read these counts. */
                        Move True to bNewPlace
                        If (aMsgs[iCount].bDeepScan = True and SizeOfArray(asRowOcc) > iRow) Begin
                            Get OccurrencesHoldLine of ho asRowOcc[iRow] aMsgs[iCount].iLine to bHeld
                            Move (not(bHeld)) to bNewPlace
                        End
                        If (bNewPlace = True) ;
                            Increment aiCount[iRow]
                        If (Recipe.eCategory > aieCat[iRow]) Begin
                            Move Recipe.eCategory     to aieCat[iRow]
                            Move Recipe.sCategoryText to TheData[iRow].sValue[iCategory_Col]
                            Move Recipe.sHint         to TheData[iRow].sValue[iHint_Col]
                        End
                        Move TheData[iRow].sValue[iErrNo_Col] to sExisting
                        If (not(sExisting contains sMsgTok)) ;
                            Move (sExisting + ", " + sMsgTok) to TheData[iRow].sValue[iErrNo_Col]
                    End
                    // UNFOLD store: remember THIS message as one of the row's absorbed occurrences
                    // ("line<TAB>msg#<TAB>text") - a local jagged array, Set ONCE after the loop (a
                    // per-message Get/Set of the property would deep-copy it 26k times).
                    Move (String(aMsgs[iCount].iLine) + Character(9) + sMsgTok + Character(9) + aMsgs[iCount].sErrorTxt) to asRowOcc[iRow][-1]
                Loop
                End   // If (bSkipMsg = False) - collision messages on a flood fall straight through to the pump
                // Also pump every ~15 messages so one large file's many messages still animate the bar (the
                // file-change pump above covers cross-file progress). ~10x tighter than the old 150, now that
                // each message runs the source-guard + whole-file dry-run demote (8ec0efd) - a much heavier
                // per-message cost that left 150 freezing the bar for long stretches. pbAnalyzing on the Test
                // Compile panel blocks re-entry; non-quiet only (see the file-change pump note above).
                Increment iPump
                /* THIS was the beat Nils saw tick for 495 s (2026-08-15): the every-15-rows pump
                   still printed the OLD "Analyzing data... (Ns)" and, firing far more often than
                   the per-file line, overwrote "row N of M" before it could be read. Same text
                   as the per-file beat now, so the row fraction is what stays on the bar. */
                If (iPump >= 15) Begin
                    If (hoStatusBar <> 0) ;
                        Set StatusText of hoStatusBar to ("Analyzing data - row " + String(iCount + 1) + " of " + String(iTo + 1) + " (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                    If (bPump = True) ;
                        Send PumpMsgQueue of Desktop
                    Move 0 to iPump
                End
            Loop
            // ---- state out: one Set each ----
            Set pBuildTheData       to TheData
            Set paiBuildCat         to aieCat
            Set paiBuildCount       to aiCount
            Set pasBuildKeys        to asKey
            Set pasBuildRowOcc      to asRowOcc
            Set piBuildItems        to iItem
            Set psBuildWinFile      to sWinFile
            Set pasBuildWinKeys     to asWinKey
            Set paiBuildWinRows     to aiWinRow
            Set pasBuildFnLineKeys  to asFnLineKey
            Set paiBuildFnLineRows  to aiFnLineRow
            Set pasBuildActionable  to asActionableKey
            Set psBuildGuardFile    to sGuardFile
            Set pasBuildGuardLines  to asGuardLines
            Set pbBuildPinnedDone   to bPinnedDone
            Set psBuildLastPumpFile to sLastPumpFile
            Set piBuildPump         to iPump
            Set piBuildWarn         to iWarn
            Set piBuildErr          to iErr
            Set piBuildScan         to iScan
            Set psBuildFirstCollFile to sFirstCollFile
            Set piBuildFirstCollLine to iFirstCollLine
        End_Procedure

        // Read the .err, classify every error via cModAnalyzer, and fill the grid.
        // The summary lives in the analyze chip bar in the Test Compile bar (not a grid row), so the
        // grid is pure data and can be header-click sorted; DisplayFiltered builds + pushes it.
        /* THE NAME-COLLISION SIGNAL (4544 ambiguous return type + 4390 already-defined), derived
           from a parsed compiler message set.

           EXTRACTED FROM LoadData so a RESTORED plan can have it too (Nils 2026-08-15: "Restarted
           and no Guard them buttons. A new time-costly Check is needed. This also used to work").

           The guided findings rows read pasBackportNames / pabBackportGuardable and friends off this
           grid. They were written in exactly one place - the live analyze - so a restored plan
           rebuilt its ROWS and none of this, and the 4390 row came back with its button suppressed.
           The only way to get it back was a full Check, which recompiles the workspace to regenerate
           a .prn that is still sitting on disk.

           Nothing here needs the compiler. It is a pass over messages that have already been parsed,
           so LoadSavedPlan can call it with a re-read of the plan's own sSourcePrn and pay the parse
           without paying the compile.

           iAmb / iBack come back ByRef because the caller words its collapsed flood row and its
           piSum* totals from the two counts separately - 4544 stays report-only (renaming and
           type-aligning are human judgement) while 4390 is mechanically fixable, and a merged total
           would lose that distinction. */
        /* Tally the Deep Scan rules that FLOOD this run - see paiDSFloodNo. The tally itself is
           cModAnalyzer.TallyScanFloods (pure, unit-tested - lifted out of here 2026-08-16 after its
           two live-run defects); this maps the result onto the parallel property arrays. Built into
           LOCAL arrays, then each property set ONCE, whole (an indexed "Set pArray[i] to" is not a
           form this runtime accepts on an array property - 4381 on the first live run). Everything
           is empty when nothing floods, and the row loop treats every message as ordinary. */
        Procedure _CountScanFloods tCompileError[] ByRef aMsgs
            tDSFloodTally[] aTally
            Integer[] aiOutNo aiOutCnt aiOutFiles aiOutLine
            String[]  asOutFirst asOutSym asOutHint

            String[][] asOutLists
            Handle ho
            Integer i iMax
            Get Create (RefClass(cModAnalyzer)) to ho
            Get TallyScanFloods of ho (&aMsgs) CI_DSFloodThreshold to aTally
            Send Destroy of ho
            Move (SizeOfArray(aTally) - 1) to iMax
            For i from 0 to iMax
                Move aTally[i].iDSNumber  to aiOutNo[i]
                Move aTally[i].iCount     to aiOutCnt[i]
                Move aTally[i].iFiles     to aiOutFiles[i]
                Move aTally[i].sFirstFile to asOutFirst[i]
                Move aTally[i].iFirstLine to aiOutLine[i]
                Move aTally[i].sSymbol    to asOutSym[i]
                Move aTally[i].sFirstHint to asOutHint[i]
                Move aTally[i].asFiles    to asOutLists[i]
            Loop
            Set paiDSFloodNo        to aiOutNo
            Set paiDSFloodCount     to aiOutCnt
            Set paiDSFloodFiles     to aiOutFiles
            Set pasDSFloodFirstFile to asOutFirst
            Set paiDSFloodFirstLine to aiOutLine
            Set pasDSFloodSymbol    to asOutSym
            Set pasDSFloodFirstHint to asOutHint
            Set pasDSFloodFileLists to asOutLists
        End_Procedure

        /* The collapsed scan rules, packaged for the PLAN and the saved-plan JSON (2026-08-16): one
           tSavedPlanFlood per flood - its number, symbol, the converter its summary row names, the
           row's own file (its ignore key) and EVERY distinct file it fired in. Consumed by
           cModAnalyzer.ExpandFloodFilesIntoPlan on both plan paths. Empty when nothing flooded. */
        Function FloodsForPlan Returns tSavedPlanFlood[]
            tSavedPlanFlood[] aFloods
            Integer[]  aiNo
            String[]   asSym asFn asFirst

            String[][] asLists
            Integer i iMax
            Get paiDSFloodNo        to aiNo
            Get pasDSFloodSymbol    to asSym
            Get pasDSFloodFn        to asFn
            Get pasDSFloodFirstFile to asFirst
            Get pasDSFloodFileLists to asLists
            Move (SizeOfArray(aiNo) - 1) to iMax
            For i from 0 to iMax
                // The DS number itself - a negative key's flood names no converter, so the plan never
                // reads its number (ExpandFloodFilesIntoPlan / FilesForFunctions skip an empty sFn).
                Move aiNo[i]    to aFloods[i].iDSNumber
                If (aiNo[i] < 0) ;
                    Move (0 - aiNo[i]) to aFloods[i].iDSNumber
                Move asSym[i]   to aFloods[i].sSymbol
                If (i < SizeOfArray(asFn)) ;
                    Move asFn[i] to aFloods[i].sFn
                Move asFirst[i] to aFloods[i].sFirstFile
                If (i < SizeOfArray(asLists)) ;
                    Move asLists[i] to aFloods[i].asFiles
            Loop
            Function_Return aFloods
        End_Function

        Procedure RebuildCollisionSignal Handle hoAn tCompileError[] ByRef aMsgs Integer ByRef iAmb Integer ByRef iBack
            String[]  asAmbNames asAmbFiles asBackNames asBackFiles asNativeCat asEmptyStr

            String[][]  asSiteFiles
            Integer[][] aiSiteLines
            Integer[] aiAmbCounts aiBackCounts asEmptyInt aiAmbOwn aiAmbFirst
            Boolean[] abBackExt abGuardable abEmptyBool abAmbFileOwn
            String[]  asSiteLines asAmbForeign asAmbFirst
            String  sAmbName sBackName sSiteFile
            Integer iCount iSize iNameIx iSite iSiteMax iSiteLine iFileIx
            Boolean bSiteSeen bOwn

            Move (SizeOfArray(aMsgs) - 1) to iSize
            Move "" to sSiteFile
            Move 0 to iAmb
            Move 0 to iBack
            Move asEmptyStr to asAmbNames
            Move asEmptyStr to asAmbFiles
            Move asEmptyStr to asBackNames
            Move asEmptyStr to asBackFiles
            Move asEmptyInt to aiAmbCounts
            Move asEmptyInt to aiBackCounts
            Move abEmptyBool to abBackExt
            For iCount from 0 to iSize
                If (aMsgs[iCount].iErrorNo = 4544) Begin
                    Increment iAmb
                    /* WHOSE FILE IS THE SITE IN - answered once per distinct file (it costs a file-system
                       call) and carried onto the name. A name whose every site is inside DataFlex's own
                       packages has no call the rewrite can reach; the board says so on its row and in
                       its offer instead of ending at "none of the files can be written" (a 2005-era
                       character-mode workspace, 2026-09-20: five names, every site in Winkern.pkg,
                       Winuser.pkg or RegistryAPI.pkg - those packages failing to compile in that
                       program). A site with no file is counted as OURS: no evidence is no verdict. */
                    Move True to bOwn
                    If (aMsgs[iCount].sFileName <> "") Begin
                        Move (SearchArray(aMsgs[iCount].sFileName, asAmbFiles, Desktop, RefFunc(DFSTRICMP))) to iFileIx
                        If (iFileIx = -1) Begin
                            Move (SizeOfArray(asAmbFiles)) to iFileIx
                            Move aMsgs[iCount].sFileName to asAmbFiles[iFileIx]
                            Get IsCompilerNamedFileWritable of ghoApplication aMsgs[iCount].sFileName to bOwn
                            Move bOwn to abAmbFileOwn[iFileIx]
                        End
                        Move abAmbFileOwn[iFileIx] to bOwn
                    End
                    // The compiler NAMES the ambiguous message ("Function GET_VALUE with ambiguous return
                    // type"), so the hoist converter can be driven straight from the diagnostics - no
                    // workspace-wide declaration harvest, no cached state. Distinct names only.
                    Get AmbiguousFnNameFromText of hoAn aMsgs[iCount].sText to sAmbName
                    If (sAmbName <> "") Begin
                        Move (SearchArray(sAmbName, asAmbNames, Desktop, RefFunc(DFSTRICMP))) to iNameIx
                        If (iNameIx = -1) Begin
                            Move (SizeOfArray(asAmbNames)) to iNameIx
                            Move sAmbName to asAmbNames[iNameIx]
                            Move 0        to aiAmbCounts[iNameIx]
                            Move 0        to aiAmbOwn[iNameIx]
                            Move ""       to asAmbForeign[iNameIx]
                            Move ""       to asAmbFirst[iNameIx]
                            Move 0        to aiAmbFirst[iNameIx]
                        End
                        Move (aiAmbCounts[iNameIx] + 1) to aiAmbCounts[iNameIx]
                        // The first site WITH a file is the row's jump target.
                        If (asAmbFirst[iNameIx] = "" and aMsgs[iCount].sFileName <> "") Begin
                            Move aMsgs[iCount].sFileName to asAmbFirst[iNameIx]
                            Move aMsgs[iCount].iLine     to aiAmbFirst[iNameIx]
                        End
                        If (bOwn = True) Begin
                            Move (aiAmbOwn[iNameIx] + 1) to aiAmbOwn[iNameIx]
                        End
                        Else Begin
                            If (asAmbForeign[iNameIx] = "") ;
                                Move (ExtractFileName(aMsgs[iCount].sFileName)) to asAmbForeign[iNameIx]
                        End
                    End
                End
                If (aMsgs[iCount].iErrorNo = 4390) Begin
                    Increment iBack
                    Get BackportNameFromText of hoAn aMsgs[iCount].sText to sBackName
                    If (sBackName <> "") Begin
                        Move (SearchArray(sBackName, asBackNames, Desktop, RefFunc(DFSTRICMP))) to iNameIx
                        If (iNameIx = -1) Begin
                            Move (SizeOfArray(asBackNames)) to iNameIx
                            Move sBackName to asBackNames[iNameIx]
                            Move 0         to aiBackCounts[iNameIx]
                            Move False     to abBackExt[iNameIx]
                            // create the jagged slots BEFORE anything reads them (a read of a missing
                            // outer element is err 4509)
                            Move asEmptyStr to asSiteFiles[iNameIx]
                            Move asEmptyInt to aiSiteLines[iNameIx]
                        End
                        Move (aiBackCounts[iNameIx] + 1) to aiBackCounts[iNameIx]
                        // The declaration SITE - de-duplicated on (file, line). The compiler reports a
                        // ';'-continued declaration at its LAST physical line, so walk back to the
                        // statement's FIRST line: the row's jump then opens the editor on the
                        // External_Function keyword, not on its 'Returns' tail (Nils 2026-09-02: WinServ
                        // InternetOption.pkg 130 = "    Returns Integer"). One read per run of same-file
                        // messages; a file that will not read keeps the raw number.
                        If (aMsgs[iCount].sFileName <> "" and aMsgs[iCount].iLine > 0) Begin
                            If (aMsgs[iCount].sFileName <> sSiteFile) Begin
                                Move (rfReadEncodedFileAsStringArray(aMsgs[iCount].sFileName)) to asSiteLines
                                Move aMsgs[iCount].sFileName to sSiteFile
                            End
                            Get StatementStartLine of hoAn (&asSiteLines) aMsgs[iCount].iLine to iSiteLine
                            Move False to bSiteSeen
                            Move (SizeOfArray(asSiteFiles[iNameIx]) - 1) to iSiteMax
                            For iSite from 0 to iSiteMax
                                If (bSiteSeen = False and aiSiteLines[iNameIx][iSite] = iSiteLine) Begin
                                    If (Lowercase(asSiteFiles[iNameIx][iSite]) = Lowercase(aMsgs[iCount].sFileName)) ;
                                        Move True to bSiteSeen
                                End
                            Loop
                            If (bSiteSeen = False) Begin
                                Move aMsgs[iCount].sFileName to asSiteFiles[iNameIx][-1]
                                Move iSiteLine               to aiSiteLines[iNameIx][-1]
                            End
                        End
                        // Flavor: "...is already defined as an external_function" - both sides then
                        // declare the same Windows API, and the guided row words its fix differently
                        // (delete/guard the duplicate, not rename).
                        If (Pos("as an external_function", Lowercase(aMsgs[iCount].sText)) > 0) ;
                            Move True to abBackExt[iNameIx]
                    End
                    If (aMsgs[iCount].sFileName <> "") Begin
                        If (SearchArray(aMsgs[iCount].sFileName, asBackFiles, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                            Move aMsgs[iCount].sFileName to asBackFiles[-1]
                    End
                End
            Loop
            Set pasAmbiguousFnNames to asAmbNames
            Set pasAmbiguousFiles   to asAmbFiles
            Set paiAmbiguousCounts  to aiAmbCounts
            Set paiAmbiguousOwnSites to aiAmbOwn
            Set pasAmbiguousForeignFile to asAmbForeign
            Set pasAmbiguousFirstFile to asAmbFirst
            Set paiAmbiguousFirstLine to aiAmbFirst
            Set pasBackportNames    to asBackNames
            Set paiBackportCounts   to aiBackCounts
            Set pasBackportFiles    to asBackFiles
            Set pabBackportExternal to abBackExt
            Set pasBackportSiteFiles to asSiteFiles
            Set paiBackportSiteLines to aiSiteLines
            // One catalogue read per analyze (not per name, not per file) - negligible next to the parse.
            Move abEmptyBool to abGuardable
            If (SizeOfArray(asBackNames) > 0) Begin
                Get InstallGlobalFuncNames of ghoFuncLib to asNativeCat
                For iCount from 0 to (SizeOfArray(asBackNames) - 1)
                    Move (SearchArray(asBackNames[iCount], asNativeCat, Desktop, RefFunc(DFSTRICMP)) <> -1) to abGuardable[iCount]
                Loop
            End
            Set pabBackportGuardable to abGuardable
        End_Procedure
        Procedure LoadData
            String sFileName sPrnFile
            String sFile sLn sKey sMsgTok sFn sExisting sGuardFile sSrcLine sLastPumpFile sGuardFn sWinFile
            String sFirstCollFile sScopeWhy
            Integer iSize iCount iItem iAuto iSuggest iWarn iErr iRow iPump iGuardLn iFiltered iIgnored iWin iLearned
            Integer iExProxy iExFile iCollErr iExplainAll iFloodCount iFirstCollLine iFlood4544 iFlood4390
            Integer iRetTypeErr iBackportErr iScan
            Integer iCategory_Col iErrNo_Col iFile_Col iLine_Col iHint_Col iFn_Col
            Integer iMatch iRows j k iStartTick
            Boolean bPrnCacheHit bStreamAdopt
            Integer iExProxyStream iExFileStream
            Boolean bExists bNeedsGuard bInScope bRowIgnored bPinnedDone bFlood bSkipMsg
            tCompileError[] asCompileError asScoped aPendingScan
            Integer iScanStart iPend
            tModIgnore[] aIgnored
            tModAnalyzer Recipe
            tModAnalyzer[] aMatched aRowRecipes aRecipesAll
            Integer[] aiDSFloodNo aiDSFloodCount aiDSFloodFiles aiDSFloodFirstLine
            String[] asDSFloodFirstFile asDSFloodSymbol asDSFloodFn asDSFloodFirstHint
            Integer iDSFlood iDSFloodMax iDSNo
            String sFloodHint
            Handle ho hoDataSource hoPlan hoStatusBar hoTestCompile
            tDataSourceRow[] TheData TheDataEmpty
            tSavedPlan SavedPlan
            String[] asWinKey asKey asGuardLines asScopeRoots asActionableKey asPinned asEmptyPin
            Integer[] aieCat aiCount aiWinRow
            Boolean[] abIgnored abExpandedNone

            String[][] asRowOcc


            // Latch - see pbLoadDataRunning. A nested entry returns at once; the outer load owns
            // the build and the paint. Released on EVERY exit path below (search "pbLoadDataRunning to False").
            If (pbLoadDataRunning(Self) = True) ;
                Procedure_Return
            Set pbLoadDataRunning to True

            If (not(IsComObjectCreated(Self))) Begin
                Set pbLoadDataRunning to False
                Procedure_Return
            End

            Move (GetTickCount()) to iStartTick   // for the live elapsed-time status + the final "Ready."
            /* PUBLISHED FOR EVERY PATH, here at the start (Nils 2026-08-15: "Analyzing data
               (2216508s) and counting"). The builder's slice loop reads piBuildStartTick for its
               own elapsed display, and this used to be set only inside the CLASSIC branch below
               - so on the STREAMED path (a first Check whose .prn the Test Compile dock tailed
               live and the grid adopts) it stayed at its construction-time 0, and
               GetTickCount() - 0 is the machine's uptime: 2,216,508 s is 25.6 days. Setting
               it once, unconditionally, where the tick is taken means no path can miss it.
               ...AND FOR A QUIET REFRESH TOO (2026-10-03). The tick was still taken inside the
               non-quiet block below, so an Ignore Row / Clear Ignored refresh ran with iStartTick 0,
               and every stage beat - whose text is written on every path - showed the uptime again. */
            Set piBuildStartTick to iStartTick

            // On the FIRST Analyze, Send Activate (in ActivateModAnalyzer) creates + docks this
            // panel for the first time, and that initial docking flashes the outgoing Compiler
            // Output dock's pixels over the editor - the deferred repaint doesn't clear until the
            // next pump (later clicks just re-show an already-docked panel, so they never ghost).
            // Pump here, right after the docking and before the heavy parse below, so the editor
            // repaints cleanly on the first click too. Also surface a status-bar note for the
            // (synchronous) parse below - it can take a while on a big workspace - mirroring the
            // "Loading Refactoring Plan..." note on Auto Select. Set BEFORE this pump so the single
            // flush paints both the dock repaint and the text before the parse loop blocks the
            // message loop; cleared just before the procedure returns.
            // Skipped on a quiet in-place refresh (Ignore Row / Clear Ignored): the docks are already up,
            // and this re-entrant PumpMsgQueue - reached from the WebView2-deferred button timer - was what
            // tore down the Compiler Output + Analyzer docks.
            If (pbQuietRefresh(Self) = False) Begin
                Send Cursor_Wait of Cursor_Control
                Get Statusbar_Id of (phoMainPanel(ghoApplication)) to hoStatusBar
                Set StatusText of hoStatusBar to "Analyzing data - reading listing..."
                // Swap the empty-grid caption to "Working..." for the (synchronous) parse below, so an empty
                // grid reads as in-progress rather than "No warnings or errors to analyse". Set BEFORE this
                // pump so the single flush paints it; restored to the real caption just before DisplayFiltered.
                Set psNoItemsText to CS_WorkingText
                Send InitializeData TheDataEmpty   // clear stale rows now so the grid reads "Working..." during the (re)parse
                Send PumpMsgQueue of Desktop
            End

            If (pbDeepScanView(Self) = True) Begin
                // DEEP-SCAN mode: the messages were injected by ActivateModAnalyzerDeepScan -
                // no compile output exists (that is the point). The DS recipes classify them below.
                Get paDeepScanMessages to asCompileError
                Move "" to sPrnFile
            End
            Else Begin
                Get psErrorFile to sFileName
                // Prefer the .prn listing beside the .err: it carries the WARNINGS (the
                // modernization goldmine) that the .err omits. Fall back to the .err if no
                // .prn is present. ReadCompilerMessages filters to the diagnostic lines.
                Move (Left(sFileName, Length(sFileName) - 4) + ".prn") to sPrnFile
                Get vFilePathExists sPrnFile to bExists
                If (bExists = False) ;
                    Move sFileName to sPrnFile
                // Fast path: the Test Compile dock tails the .prn WHILE the compiler runs and caches the
                // filtered diagnostic lines (CachedPrnMessages validates its stamp against the on-disk
                // file). A hit skips this analyze's biggest single cost - reading + line-filtering the
                // whole multi-MB listing; any mismatch falls back to the full read. Null-guarded: the
                // handle only exists once the Modernize dock has been shown (where compiles run from).
                Get phoTestCompileFT of ghoApplication to hoTestCompile
                // STREAMED FAST PATH (milestone 3b): the compile's poll timer already fed these
                // diagnostics through parse + proxy-drop + with-file + the row builder. On adopt the
                // grid's pBuild* properties hold the finished rows and asCompileError is the filtered
                // set - the classic reads and filters below are skipped, not re-done.
                If (hoTestCompile <> 0) ;
                    Get StreamedMessagesFor of hoTestCompile sPrnFile (&asCompileError) (&iExProxyStream) (&iExFileStream) to bStreamAdopt
                If (bStreamAdopt = True) ;
                    Move True to bPrnCacheHit
                Else Begin
                    If (hoTestCompile <> 0) ;
                        Get CachedPrnMessages of hoTestCompile sPrnFile to asCompileError
                    Move (SizeOfArray(asCompileError) > 0) to bPrnCacheHit
                    If (bPrnCacheHit = False) ;
                        Get ReadCompilerMessages sPrnFile to asCompileError
                End
            End
            // GUIDED MERGE: fold the pending Deep Scan results into this compile-lane analysis -
            // appended BEFORE scoping, so classify / ignore / fold / plan treat both lanes
            // uniformly (the DS 9xxx recipe numbers are disjoint from the compiler's). iScanStart
            // marks where the scan slice begins for the streamed-adopt build below.
            Move (SizeOfArray(asCompileError)) to iScanStart
            Move 0 to iPend
            If (pbDeepScanView(Self) = False) Begin
                Get paPendingScanMessages to aPendingScan
                Move (SizeOfArray(aPendingScan)) to iPend
                For iCount from 0 to (iPend - 1)
                    Move aPendingScan[iCount] to asCompileError[-1]
                Loop
            End
            // Ignore (dismiss) is a VIEW filter, not a drop-at-parse: the grid build below keeps EVERY message
            // (so pTheDataFull + the saved-plan JSON hold the FULL triage and Clear Ignored can always
            // restore), and the dismissed rows are hidden at display time (pabIgnoredFull / DisplayFiltered).
            // Only the refactor PLAN's message set (paScopedMessages) drops them - a dismissed report-only
            // recipe (TypeToStructReport / W 4532) must not enter Auto Select. ho is created here so it can
            // read the ignore list now; it lives for the whole parse and is destroyed after it. iIgnored (the
            // dismissed-ROW count for the chip) is tallied over the built rows below.
            Get Create (RefClass(cModAnalyzer)) to ho
            Send AnalyzeBeat iStartTick "listing read"
            Get ReadIgnored of ho to aIgnored
            // Keep the elapsed counter moving through the (multi-second on a big workspace) PRE-loop prep -
            // the parse + the O(n) filters below run before the main loop's own pump, so on a 40k-diagnostic
            // workspace the counter sat frozen for ~20s. Pump at each prep boundary. Non-quiet only (a quiet
            // Ignore/Clear refresh must NOT pump - it tears the docks down; hoStatusBar is only set then too).
            If (pbQuietRefresh(Self) = False) Begin
                Set StatusText of hoStatusBar to ("Analyzing data - ignore list read (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                Send PumpMsgQueue of Desktop
            End
            // Studio COM proxy wrappers (.ocx etc.) are never refactored - drop their diagnostics from BOTH
            // the grid AND the scoped plan set (asScoped derives from asCompileError just below), so they
            // never show in the triage view or enter Auto Select. Count how many vanished for the "excluded" chip.
            If (bStreamAdopt = False) Begin
                Move (SizeOfArray(asCompileError)) to iExProxy
                Get DropCOMProxyMessages of ho (&asCompileError) to asCompileError
                Move (iExProxy - SizeOfArray(asCompileError)) to iExProxy
            End
            Else ;
                Move iExProxyStream to iExProxy   // the streamer already dropped + counted them
            If (pbQuietRefresh(Self) = False) Begin
                Set StatusText of hoStatusBar to ("Analyzing data - COM proxies dropped (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                Send PumpMsgQueue of Desktop
            End
            // The GRID shows ALL diagnostics. Rows whose file is OUTSIDE the workspace source tree
            // (DataFlex install packages, external includes) are re-badged "System (read-only)" after
            // the build loop below - shown so the grid matches the compiler, but hidden by default and
            // never refactored. The refactor PLAN / Auto Select get only the in-scope subset (asScoped):
            // they must never touch files outside the workspace. iFiltered = how many are out-of-scope.
            Get FilterToWorkspaceFiles (&asCompileError) (&iFiltered) to asScoped
            // Cache the PRE-drop scoped set so RefilterIgnored (Ignore Row / Clear Ignored) can re-derive
            // the plan's message set from memory when the ignore list changes - no .prn re-parse.
            Set paScopedMessagesFull to asScoped
            // The PLAN excludes dismissed messages (the grid keeps them, hidden at view time). Drop them from
            // the scoped set ONLY, so Auto Select never runs a dismissed row.
            Get DropIgnoredMessages of ho (&asScoped) (&aIgnored) to asScoped
            Set paScopedMessages to asScoped
            If (pbQuietRefresh(Self) = False) Begin
                Set StatusText of hoStatusBar to ("Analyzing data - scoped (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                Send PumpMsgQueue of Desktop
            End
            // The GRID skips file-less diagnostics (link / manifest errors - no source file or line to
            // show or refactor; they are surfaced on the compile result line, not here). Rows that NAME
            // a file are kept - in-workspace AND out-of-workspace system files (badged read-only below).
            // Count how many file-less rows vanished for the "excluded" chip.
            If (bStreamAdopt = False) Begin
                Move (SizeOfArray(asCompileError)) to iExFile
                Get MessagesWithAFile (&asCompileError) to asCompileError
                Move (iExFile - SizeOfArray(asCompileError)) to iExFile
            End
            Else ;
                Move iExFileStream to iExFile
            Move (SizeOfArray(asCompileError)) to iSize
            If (pbQuietRefresh(Self) = False) Begin
                Set StatusText of hoStatusBar to ("Analyzing data - files resolved (" + String((GetTickCount() - iStartTick) / 1000) + "s)")
                Send PumpMsgQueue of Desktop
            End

            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move TheDataEmpty to TheData

            Get piColumnId of oCategory_Col to iCategory_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oLine_Col     to iLine_Col
            Get piColumnId of oHint_Col     to iHint_Col
            Get piColumnId of oFn_Col       to iFn_Col

            Move 0 to iAuto
            Move 0 to iSuggest
            Move 0 to iWarn
            Move 0 to iErr
            Move 0 to iItem                 // data rows start at 0 (summary is pinned above the grid now)
            Move 0 to iPump
            Decrement iSize
            // Multi-match needs the full recipe table (MatchingRecipesFromList takes it explicitly; ClassifyMessage
            // fetched it internally). EnsureRecipesLoaded first so paRecipes is current for the target version.
            Send AnalyzeBeat iStartTick "loading recipes"
            Send EnsureRecipesLoaded of ho
            /* Let the table learn W-vs-E from what the compiler actually said, BEFORE the recipes are
               read for this build - so a correction shows in the same analyze that discovered it
               rather than the next one. The compiler's own line prefix is the only authority for
               severity (no install file carries it), and it is already parsed into
               tCompileError.bError; the recipe flag was hand-set and, for anything harvested from
               install Pkg source, hardcoded to "warning". Costs one pass over the messages and a DB
               write only when something genuinely disagreed. (Nils 2026-08-02.) */
            Send AnalyzeBeat iStartTick "recipes loaded"
            Get LearnSeveritiesFromMessages of ho (&asCompileError) to iLearned
            Get paRecipes of ho to aRecipesAll
            // Two O(messages) passes follow (the collision pre-count + the scan-flood tally) with the
            // recipe table now in hand, and then the row build. Beat here so the severity learn and
            // those passes are accounted for instead of merging into the silence before the row counter.
            Send AnalyzeBeat iStartTick "severities learned"
            // COLLISION-FLOOD BAIL (Nils 2026-07-20): count the name-collision errors (4544 ambiguous return
            // type + 4390 global-method-already-defined) up front. A couple of bad/backported declarations
            // manufacture hundreds-to-thousands of these (see piSumCollisionErr); they have NO auto-fix and
            // their ambiguous return types CASCADE, distorting every OTHER diagnostic - the user must run
            // the declaration report + recompile FIRST. So above a flood level there is no value in the (expensive)
            // per-message classify + source-guard on findings that change afterward: we skip that work for the
            // collisions (they collapse into ONE summary row after the loop) and skip the source-guard on the
            // rest (provisional categories). A multi-minute analyze becomes seconds; the re-analyze on the
            // fixed, clean output runs the full detailed pass. Threshold 100 = a genuine flood (tunable) - the
            // report NUDGE still fires at its own 10, this only trades detail for speed when collisions dominate.
            // Counted SEPARATELY (Nils 2026-07-20): the two halves now end differently - 4544 return-type
            // mismatches stay report-only (renaming/type-aligning is human judgement), while 4390 backported
            // globals are mechanically fixable by GuardRedundantGlobalFunctions. The guided findings list
            // therefore shows them as two rows with their own counts, and in a FLOOD these are the only
            // surviving numbers (the collapsed summary row below carries one merged errNo cell, so deriving
            // a per-message count from the rows afterwards would lose the 4390 half entirely).
            // The collision signal, shared with LoadSavedPlan - see RebuildCollisionSignal.
            Send RebuildCollisionSignal ho (&asCompileError) (&iFlood4544) (&iFlood4390)
            // The scan-rule floods, same moment, same reason - see paiDSFloodNo.
            Send _CountScanFloods (&asCompileError)
            Send AnalyzeBeat iStartTick "collisions counted"
            Move (iFlood4544 + iFlood4390) to iFloodCount
            Move (iFloodCount >= 100) to bFlood
            // ---- the row build, via the extracted slice builder (milestone 3a): ONE slice covering
            // every message, so behaviour and cost match the old inline loop exactly - and the same
            // builder can be fed per-tick during a compile (milestone 3b). State batched in properties.
            // Adopting streamed rows requires the same NON-flood build the streamer performed; a flood
            // discovered here (the streamer's own threshold is approximate) forces the classic rebuild.
            If (bStreamAdopt = True and bFlood = True) ;
                Move False to bStreamAdopt
            /* RE-ARM THE BUILDER'S OWN BEAT BEFORE EITHER BRANCH (Nils 2026-08-10, measured).
               pbBuildPumpEnabled is FALSE right now whenever rows were streamed during the compile -
               TestCompileFT.dg:2465 sets it so deliberately, because a slice running ON the compile
               tick must not pump. But that flag is a property, and it survives into THIS analyze,
               where we are no longer on the tick. Line ~1080 below restores it in the classic branch
               only, so an ADOPTING analyze (and the iPend scan-merge slice it feeds through the same
               builder) ran the whole row build with its per-file / per-15-message beat switched off.
               Instrumented run: 18.2s between "ANALYZE START" and the first beat, the status bar
               stuck on the prep boundary's "(0s)" for all of it, then three beats at "(18s)" as the
               phase ended. Setting it here covers both branches; the classic branch re-states it
               harmlessly a few lines down, next to the flood flag it belongs with. */
            Set pbBuildPumpEnabled to (not(pbQuietRefresh(Self)))
            If (bStreamAdopt = False) Begin
                // Classic build clobbers the builder state - tell the streamer its rows are gone.
                If (hoTestCompile <> 0) ;
                    Send InvalidateStreamedRows of hoTestCompile "classic rebuild"
                Send _ResetRowBuildState
                Set pbBuildFlood       to bFlood
                Set pbBuildPumpEnabled to (not(pbQuietRefresh(Self)))
                // (piBuildStartTick was published unconditionally at the start of the run - see there.)
                Send _BuildRowsForSlice (&asCompileError) 0 iSize ho (&aRecipesAll)
            End
            Else If (iPend > 0) Begin
                // Streamed adopt covers the COMPILER rows only - feed the merged scan messages as
                // ONE MORE slice into the same (incremental by design) builder state, so DS rows
                // land in the same build and fold with compiler rows per (file|function). Then
                // invalidate the streamed rows: the slice was appended INTO the streamer's state,
                // and a second no-recompile analyze re-adopting it would append the scan slice
                // AGAIN - the classic rebuild path is the clean re-entry.
                Send _BuildRowsForSlice (&asCompileError) iScanStart iSize ho (&aRecipesAll)
                If (hoTestCompile <> 0) ;
                    Send InvalidateStreamedRows of hoTestCompile "scan merge adopted"
            End
            Send AnalyzeBeat iStartTick "rows built"
            Get pBuildTheData        to TheData
            Get paiBuildCat          to aieCat
            Get paiBuildCount        to aiCount
            Get pasBuildKeys         to asKey
            Get pasBuildRowOcc       to asRowOcc
            Get piBuildItems         to iItem
            Get piBuildWarn          to iWarn
            Get piBuildErr           to iErr
            Get piBuildScan          to iScan
            Get psBuildFirstCollFile to sFirstCollFile
            Get piBuildFirstCollLine to iFirstCollLine


            // COLLISION-FLOOD BAIL: the skipped collision messages collapse into ONE summary row here. It is a
            // Breaks-the-build blocker that routes to the report; its "E 4544" token makes the sum pass below
            // credit its aiCount to piSumCollisionErr (so MaybeSuggestNameCollision still fires), and it points
            // at the first collision so a double-click lands somewhere real. Emitted BEFORE the row-flag / sum
            // passes so it is counted and displayed. Only when the flood actually triggered.
            If (bFlood = True and iFloodCount > 0) Begin
                Move iItem                    to iRow
                Move "__collflood__"          to asKey[iRow]
                Move iFloodCount              to aiCount[iRow]
                // Category set EXPLICITLY (do NOT inherit ClassifyMessage's): since 2026-07-07 message 4544 is
                // function-backed (ChangeObjectFunctionCallToGet), so classifying it returns AUTO-FIX - but a
                // name-collision FLOOD has no usable auto-fix (you must run the report). eModSuggest / "Review"
                // keeps the row VISIBLE in the grid (Explain is hidden by default) without a false green
                // Auto-fix pill or inflating piSumAuto; in the guided findings list its E 4544 error token
                // already lands it in Breaks-the-build.
                Move eModSuggest              to aieCat[iRow]
                Get CategoryText of ho eModSuggest to sMsgTok
                Move sMsgTok                  to TheData[iRow].sValue[iCategory_Col]
                Move "E 4544"                 to TheData[iRow].sValue[iErrNo_Col]
                Move sFirstCollFile           to TheData[iRow].sValue[iFile_Col]
                Move (String(iFirstCollLine)) to TheData[iRow].sValue[iLine_Col]
                Move ("Name collisions (" + String(iFloodCount) + ") - " + String(iFlood4544) + " ambiguous return type (4544: caused by a few DECLARATIONS, not by the calls flagged here - the return-type mismatch report names them) + " + String(iFlood4390) + " already defined (4390, fixable: version-guard the globals DataFlex now ships). Fix these, then recompile.") to TheData[iRow].sValue[iHint_Col]
                Move ""                       to TheData[iRow].sValue[iFn_Col]
                Move (String(iFirstCollLine) + Character(9) + "E 4544" + Character(9) + "name-collision flood - see the function return-type mismatch report") to asRowOcc[iRow][0]
                Increment iItem
            End

            /* ONE SUMMARY ROW PER FLOODING SCAN RULE - the scan-lane twin of the collision row above
               (2026-08-15). Where that row can only point at a report, this one carries the rule's
               own converter, because a scan rule that fires 22,000 times is precisely the case a
               whole-workspace run of ChangeLegacyOperators exists for - so the row stays AUTO-FIX,
               with the count and the file spread in the hint, and its function in the Fn column.
               ClassifyMessage on the DS number gives the recipe (category, hint, fn) as it would
               for a single finding; only the wording is widened to say "N in M files". */
            Get paiDSFloodNo        to aiDSFloodNo
            Get paiDSFloodCount     to aiDSFloodCount
            Get paiDSFloodFiles     to aiDSFloodFiles
            Get pasDSFloodFirstFile to asDSFloodFirstFile
            Get paiDSFloodFirstLine to aiDSFloodFirstLine
            Get pasDSFloodSymbol    to asDSFloodSymbol
            Get pasDSFloodFirstHint to asDSFloodFirstHint
            Move (SizeOfArray(aiDSFloodNo) - 1) to iDSFloodMax
            For iDSFlood from 0 to iDSFloodMax
                // The key is the DS number, negated for a flood of hits that lost the converter.
                Move aiDSFloodNo[iDSFlood] to iDSNo
                If (iDSNo < 0) ;
                    Move (0 - iDSNo) to iDSNo
                Get ClassifyMessage of ho iDSNo asDSFloodSymbol[iDSFlood] to Recipe
                Move (asDSFloodSymbol[iDSFlood] + " - " + String(aiDSFloodCount[iDSFlood]) + " occurrences in " + String(aiDSFloodFiles[iDSFlood]) + " file" + (If(aiDSFloodFiles[iDSFlood] = 1, "", "s")) + ". " + Recipe.sHint + " Too many to list one by one - the fix runs across the whole selection in one pass.") to sFloodHint
                /* A FLOOD OF HITS THAT LOST THE RULE'S CONVERTER (a negative key - cModAnalyzer.DSFloodKey,
                   2026-10-03) is an Explain row: the scan's own verdict on each of those hits dropped the
                   function, so the row the rule builds - "the fix runs across the whole selection" -
                   promised a run that would change none of them (one workspace's 2,114 objects of its own
                   grid and list subclasses). It says so, and carries the first hit's own reason. */
                If (aiDSFloodNo[iDSFlood] < 0 and Trim(Recipe.sRefactorFn) <> "") Begin
                    Move (asDSFloodSymbol[iDSFlood] + " - " + String(aiDSFloodCount[iDSFlood]) + " occurrences in " + String(aiDSFloodFiles[iDSFlood]) + " file" + (If(aiDSFloodFiles[iDSFlood] = 1, "", "s")) + " that " + Trim(Recipe.sRefactorFn) + " leaves as they are. The first of them: " + asDSFloodFirstHint[iDSFlood]) to sFloodHint
                    Move "" to Recipe.sRefactorFn
                    Move eModExplain to Recipe.eCategory
                    Get CategoryText of ho eModExplain to Recipe.sCategoryText
                End
                Move Recipe.sRefactorFn to asDSFloodFn[iDSFlood]      // -> pasDSFloodFn (FloodsForPlan)
                Move iItem                            to iRow
                Move ("__dsflood__" + String(aiDSFloodNo[iDSFlood])) to asKey[iRow]
                Move aiDSFloodCount[iDSFlood]         to aiCount[iRow]
                Move Recipe.eCategory                 to aieCat[iRow]
                Move Recipe.sCategoryText             to TheData[iRow].sValue[iCategory_Col]
                Move ("DS " + String(iDSNo))          to TheData[iRow].sValue[iErrNo_Col]
                Move asDSFloodFirstFile[iDSFlood]     to TheData[iRow].sValue[iFile_Col]
                Move (String(aiDSFloodFirstLine[iDSFlood]) + " (x" + String(aiDSFloodCount[iDSFlood]) + ")") to TheData[iRow].sValue[iLine_Col]
                Move sFloodHint                       to TheData[iRow].sValue[iHint_Col]
                Move Recipe.sRefactorFn               to TheData[iRow].sValue[iFn_Col]
                Move (String(aiDSFloodFirstLine[iDSFlood]) + Character(9) + "DS " + String(iDSNo) + Character(9) + asDSFloodSymbol[iDSFlood] + " - first of " + String(aiDSFloodCount[iDSFlood])) to asRowOcc[iRow][0]
                Increment iItem
            Loop
            Set pasDSFloodFn to asDSFloodFn     // whole-array Set (an indexed Set on an array property is a 4381)

            // Flag which built rows are DISMISSED (Ignore) - a row is dismissed when EVERY one of its Msg#
            // tokens is in the ignore list (IsRowIgnored handles the merged ", "-joined cell). Kept as a
            // per-row flag so DisplayFiltered hides them at VIEW time while pTheDataFull + the saved-plan JSON
            // still hold them (Clear Ignored restores by clearing the list + re-filtering - no re-parse). Done
            // BEFORE ho is destroyed. iIgnored = the dismissed-ROW count for the "N ignored" chip.
            Move 0 to iIgnored
            For iRow from 0 to (iItem - 1)
                Get IsRowIgnored of ho TheData[iRow].sValue[iFile_Col] TheData[iRow].sValue[iErrNo_Col] aIgnored to bRowIgnored
                Move bRowIgnored to abIgnored[iRow]
                If (bRowIgnored = True) ;
                    Increment iIgnored
            Loop
            /* THE POST-BUILD PASSES GET THEIR OWN BEATS (Nils 2026-08-31). Between "rows built" and
               "loading grid" sit three O(rows) passes - this one, the refactor-scope re-badge (which
               asks the DISK for a write-protected attribute per row) and the category tally. They ran
               with no beat at all, so on a big workspace the bar froze on "rows built" and the wait
               cursor stopped animating: exactly the stretch that reads as a hang. */
            Send AnalyzeBeat iStartTick "ignore list applied"

            Send Destroy of ho

            // Re-badge rows whose file is OUTSIDE the workspace source tree (DataFlex install
            // packages, external includes) as "System (read-only)": the grid SHOWS them (so it matches
            // the compiler's picture), but they are tagged eModExplain - hidden by default (DisplayFiltered),
            // never counted as Auto/Review, and carry no refactor function. The plan never touches them
            // (paScopedMessages above is the in-scope subset). Skip when no workspace home is known. A
            // DISMISSED out-of-scope row is re-badged TOO (so the cached build stays complete and a later
            // Clear Ignored / RefilterIgnored restores it with its System badge) - it is only excluded from
            // the iFiltered COUNT (the chip math runs over non-dismissed rows).
            Get GetWorkspaceScopeRoots to asScopeRoots
            Move 0 to iFiltered             // recount iFiltered as SYSTEM ROWS shown (was the dropped-MESSAGE count)
            // ... and rows whose file is WRITE-PROTECTED get the same badge (IsFileInRefactorScope):
            // a file that cannot be changed is a system file, whatever folder it sits in - Nils
            // 2026-08-18, after a DfPkg package file (read-only, but under the workspace home) drew a
            // W 4534 auto-fix row and a plan run that failed silently. sScopeWhy is the hint that
            // says which of the two it was.
            Set psScopeMemoFile to ""     // a fresh load re-asks the disk (an attribute may have been cleared)
            If (SizeOfArray(asScopeRoots) > 0) Begin
                For iRow from 0 to (iItem - 1)
                    Get IsFileInRefactorScope TheData[iRow].sValue[iFile_Col] asScopeRoots (&sScopeWhy) to bInScope
                    If (bInScope = False) Begin
                        Move eModExplain          to aieCat[iRow]
                        Move "System (read-only)" to TheData[iRow].sValue[iCategory_Col]
                        Move ""                   to TheData[iRow].sValue[iFn_Col]
                        Move sScopeWhy            to TheData[iRow].sValue[iHint_Col]
                        If (abIgnored[iRow] = False) ;
                            Increment iFiltered
                    End
                Loop
            End
            Send AnalyzeBeat iStartTick "scope checked"

            // Tally LINES by their resolved (most-actionable) category for the summary - DISMISSED rows are
            // excluded (they are hidden and counted separately as "N ignored").
            Move 0 to iAuto
            Move 0 to iSuggest
            Move 0 to iCollErr
            Move 0 to iRetTypeErr
            Move 0 to iBackportErr
            Move 0 to iExplainAll
            For iRow from 0 to (iItem - 1)
                If (abIgnored[iRow] = False) Begin
                    If (aieCat[iRow] = eModAutoFix) ;
                        Increment iAuto
                    If (aieCat[iRow] = eModSuggest) ;
                        Increment iSuggest
                    If (aieCat[iRow] = eModExplain) ;
                        Increment iExplainAll     // in-scope + System both count here; System subtracted below
                    // Name-collision errors (4544 ambiguous-return, 4390 already-defined) - by their
                    // OCCURRENCE count (aiCount), so the nudge can report the true flood size. The errNo
                    // cell can hold a merged list ("4544, 4536"), so match with contains.
                    If (TheData[iRow].sValue[iErrNo_Col] contains "4544" or TheData[iRow].sValue[iErrNo_Col] contains "4390") ;
                        Move (iCollErr + aiCount[iRow]) to iCollErr
                    // ... and the two halves SEPARATELY: the guided findings list shows them as distinct
                    // rows because they end differently - 4544 opens a report, 4390 runs a converter.
                    If (TheData[iRow].sValue[iErrNo_Col] contains "4544") ;
                        Move (iRetTypeErr + aiCount[iRow]) to iRetTypeErr
                    If (TheData[iRow].sValue[iErrNo_Col] contains "4390") ;
                        Move (iBackportErr + aiCount[iRow]) to iBackportErr
                End
                // Per-(file,function) rows: show the occurrence count beside the first line.
                If (aiCount[iRow] > 1) ;
                    Move (TheData[iRow].sValue[iLine_Col] + "  (x" + String(aiCount[iRow]) + ")") to TheData[iRow].sValue[iLine_Col]
            Loop
            Send AnalyzeBeat iStartTick "counts tallied"

            // Stash the structured counts for the web chip bar (SummaryHtml builds it in DisplayFiltered):
            // auto-fixable + to-review rows, the underlying warning/error message tally, and how many
            // messages were filtered out as outside-the-workspace (e.g. 4536 "obsolete package" warnings
            // pinned to the DataFlex install's own Pkg files) - so an emptied grid still explains itself
            // rather than looking like "compiler: 4 warnings" vs "analyzer: 0". (The old "Tip: more
            // refactorings exist..." reminder is dropped from the bar; it lives in the Select Functions view.)
            Set piSumAuto          to iAuto
            Set piSumSuggest       to iSuggest
            Set piSumWarn          to iWarn
            Set piSumErr           to iErr
            Set piSumScan          to iScan
            // The two per-file suspects inside the loop, accumulated with the sub-ms timer
            // (GetTickCount cannot see one iteration).
            Set piSumCollisionErr  to iCollErr
            // In a FLOOD the collision rows were collapsed into ONE summary row with a single errNo cell, so
            // the row-derived tallies above cannot separate the halves (everything would land on 4544 and the
            // fixable 4390 count would read as zero - hiding the one thing the user CAN act on). The
            // pre-count counted them apart precisely for this case.
            If (bFlood = True) Begin
                Move iFlood4544 to iRetTypeErr
                Move iFlood4390 to iBackportErr
            End
            Set piSumReturnTypeErr to iRetTypeErr
            Set piSumBackportErr   to iBackportErr
            // In-scope Explain = all Explain rows minus the System (read-only) install-file rows (iFiltered,
            // themselves re-badged Explain). Clamp at 0 defensively.
            Set piSumExplain       to (iExplainAll - iFiltered)
            If ((iExplainAll - iFiltered) < 0) ;
                Set piSumExplain to 0
            Set piSumFiltered      to iFiltered
            Set piSumIgnored   to iIgnored
            Set piSumExcluded  to (iExProxy + iExFile)   // COM-proxy + file-less drops (invisible even with Ctrl+I)
            Set pbSumSaved     to False
            Set psSumSavedDate to ""

            // Cache the full (unfiltered) build so Ctrl+I re-filters instantly - no re-parse of the
            // .prn, re-classify, or source-guard reads. DisplayFiltered applies the show/hide,
            // numbers the visible rows in the # column, renders the summary bar, and paints.
            Set pTheDataFull  to TheData
            Set paieCatFull   to aieCat
            Set pabIgnoredFull to abIgnored
            Set pasRowOccFull to asRowOcc
            Set pabExpandedFull to abExpandedNone      // every fresh analyze starts fully folded
            Set psAnalyzeDataWS to (psSWSFile(ghoApplication))   // the workspace this build describes (cache key)
            // FT: snapshot this analyze outcome into the FT-only globals so the dashboard's "Last analyze"
            // tile can show it on return (see DFRefactorFT.src / DashboardFT.vw RefreshAnalyze).
            // COMPILE-CYCLE ONLY (snapshot globals, registry snapshot, dashboard broadcast): a Deep Scan
            // is NOT a compile+analyze lap and must never pollute the compile counts. (The saved-plan JSON
            // is NO LONGER skipped for a scan - see the shared-plan write below the If - and since
            // 2026-07-16 the burn-down HISTORY records scans too, in the Else as its own series.)
            If (pbDeepScanView(Self) = False) Begin
            Move iAuto    to ghiLastAnalyzeAuto
            Move iSuggest to ghiLastAnalyzeSuggest
            // COMBINED where it is PERSISTED - see piSumScan. The history is one series per workspace;
            // splitting the number here would put a step in every existing burn-down.
            Move (iWarn + iScan) to ghiLastAnalyzeWarn
            Move iErr     to ghiLastAnalyzeErr
            Move 1        to ghiLastAnalyzeDone
            // Persist the outcome per-workspace (registry) so the dashboard shows it after a restart, and
            // record today's date + which workspace these counts describe (RefreshAnalyze uses the latter to
            // detect when the in-memory counts are stale for the loaded workspace - see DashboardFT.vw).
            Send WriteAnalyzeSnapshot of ghoApplication iWarn iErr iAuto iSuggest iScan
            Get TodayIsoDateTime of ghoApplication to ghsLastAnalyzeDate   // date + time for the tile's "last run"
            Get psSWSFile    of ghoApplication to ghsLastAnalyzeWS
            // FT: keep the tile's PROGRAM name in lock-step with the counts above. WriteAnalyzeSnapshot tags the
            // registry snapshot with the last-compiled program (CS_LastCompileKeyPrefix), but the in-memory
            // ghsLastAnalyzeProgram is otherwise only re-seeded on a WORKSPACE change (RefreshAnalyze ->
            // RestoreAnalyzeSnapshot, gated on sCurrentWS <> ghsLastAnalyzeWS). Analyzing a DIFFERENT program in
            // the SAME workspace refreshed the counts here but left the program name stale, so the Modernize tile
            // read e.g. "Nothing to modernize in SALES.src" after another program had been analyzed. Sync it from
            // the same registry key WriteAnalyzeSnapshot used. Nils 2026-07-07.
            Get ReadString of ghoApplication CS_Settings (CS_LastCompileKeyPrefix + ghsLastAnalyzeWS) "" to ghsLastAnalyzeProgram
            End   // pbDeepScanView=False: end of the COMPILE-CYCLE-ONLY persistence block
            Else Begin
                // DEEP-SCAN cycle burn-down (Nils 2026-07-16): a scan is a tracked lap of its OWN loop -
                // append it to the SAME per-workspace history under the reserved "Deep Scan" series label.
                // Same-label rows form their own series (the Progress tile's delta/cycle logic and the
                // History modal's trend match rows by sProgram), so the scan -> Run Fix Plan -> re-scan
                // cycle burns down like a compile cycle while the registry compile snapshot and the
                // ghiLastAnalyze* globals above stay compile-only. iWarn = finding count, iErr = 0 in
                // scan mode (same values the SavedPlan header gets below); the append de-dupes vs the
                // last entry, so an unchanged re-scan adds no flat row. Deliberately NOT routed through
                // WriteAnalyzeSnapshot - that would also stamp the compile registry slots.
                Send AppendModProgressEntry of ghoApplication iWarn iErr iAuto iSuggest CS_ModProgressDeepScanLabel iScan
            End
            // FT: freeze the FULL triage to the SHARED per-workspace JSON (Data\LastPlan-<wskey>.json) for BOTH a
            // compile+analyze AND a Deep Scan (Nils 2026-07-15: a scan is a plan too - "View/Run last plan" must
            // resume either; the plan file is shared, latest writer wins). bDeepScan stamps provenance; iWarn/iErr/
            // iAuto/iSuggest are this run's headline stats (for a scan iWarn = finding count, iErr = 0). pTheDataFull
            // holds the full triage INCLUDING dismissed rows (the ignore filter is view-time), so writing it never
            // loses a dismissed row - Clear Ignored in saved view restores via LoadSavedPlan's per-row IsRowIgnored.
            // sPrnFile is the file actually parsed for a compile (.prn beside the .err, or the .err); "" for a scan.
            Move (iWarn + iScan) to SavedPlan.iWarn
            Move iErr     to SavedPlan.iErr
            Move iAuto    to SavedPlan.iAuto
            Move iSuggest to SavedPlan.iSuggest
            Move sPrnFile to SavedPlan.sSourcePrn
            Move (pbDeepScanView(Self)) to SavedPlan.bDeepScan
            Get psSWSFile         of ghoApplication to SavedPlan.sWorkspace
            Get psTargetDfVersion of ghoApplication to SavedPlan.sDfVersion
            Get TodayIsoDate      of ghoApplication to SavedPlan.sDate
            // The write below serialises EVERY row through cJsonObject and pretty-prints it - on a big
            // triage that is seconds of solid, uninterruptible work, and it sits between the last build
            // beat and the grid load. Named on both sides so it cannot pass for a stall.
            Send AnalyzeBeat iStartTick "saving plan"
            Get BuildSavedPlanRows to SavedPlan.aRows
            Get FloodsForPlan      to SavedPlan.aFloods   // the collapsed rules' file lists ride with the plan
            Get Create (RefClass(cModAnalyzer)) to hoPlan
            Send WriteSavedPlan of hoPlan SavedPlan
            Send Destroy of hoPlan
            Send AnalyzeBeat iStartTick "plan saved"
            // Mirror the just-written plan into the in-memory "last plan" globals the dashboard's shared
            // "View/Run last plan" link + guided "Run Plan" button gate on (kept apart from ghiLastAnalyze*, the
            // compile stat readout, so a scan's plan resumes without touching the compile counts). Restored from
            // this file's header on the next workspace load (DashboardFT.RestoreAnalyzeSnapshot).
            Move iAuto    to ghiLastPlanAuto
            Move iSuggest to ghiLastPlanSuggest
            Move (pbDeepScanView(Self)) to ghiLastPlanIsDeepScan
            Get TodayIsoDate of ghoApplication to ghsLastPlanDate
            // Restore the empty-grid caption (swapped to "Working..." at the top for the parse) so an analyze
            // that genuinely finds nothing shows the real message. Idempotent on a quiet refresh (never swapped).
            Set psNoItemsText to CS_AnalyzerNoItems
            Send AnalyzeBeat iStartTick "loading grid"
            // Arm the view-build beat for THIS call only (see pbDisplayPumpOk), so DisplayFiltered's
            // own long phases report themselves and no other caller of it changes behaviour.
            Set pbDisplayPumpOk to True
            Send DisplayFiltered
            Set pbDisplayPumpOk to False
            Send AnalyzeBeat iStartTick "refreshing dashboard"
            // FT: push the fresh outcome to the dashboard's Last-analyze tile NOW. Activating alone is
            // unreliable here - Test Compile / ModAnalyzer are docks, so the dashboard view may never
            // re-activate. Broadcast resolves RefreshAnalyze by name at runtime (crossing the Use-order
            // boundary); only oDashboard_vw handles it - a no-op on every other view. (Skipped in
            // DEEP-SCAN mode - the dashboard tiles describe the compile cycle, not a source scan.)
            If (pbQuietRefresh(Self) = False and pbDeepScanView(Self) = False) ;
                Broadcast Send RefreshAnalyze of (Client_Id(phoMainPanel(ghoApplication)))
            // Done: clear the wait cursor + status note (both skipped on a quiet refresh - never set
            // there). Plain user-facing elapsed only - no phase/diagnostic statistics (Nils 2026-07-03);
            // the cache/full-read trace lives on internally in psPrnTailNote of the Test Compile dock.
            If (pbQuietRefresh(Self) = False) Begin
                Send Cursor_Ready of Cursor_Control
                Set StatusText of hoStatusBar to ("Ready. Analyzed in " + String((GetTickCount() - iStartTick) / 1000) + "s.")
                // Pump for the same reason the compile ticker now does: the guided Check renders its
                // findings board straight after this returns, so without a forced repaint the verdict
                // is written to a pane that has no chance to paint until all of that is over.
                Send PumpMsgQueue of Desktop
            End
            Set pbLoadDataRunning to False
        End_Procedure

        // Freeze the cached FULL triage (pTheDataFull + paieCatFull - ALL categories; the viewer
        // re-applies the informational hide) into named-field rows for the saved-plan JSON. Named
        // fields decouple the file from the grid's runtime column ids. iLine is the leading integer
        // parsed off the (possibly "12  (x3)"-suffixed) line display, for the viewer's jump-to-source.
        Function BuildSavedPlanRows Returns tSavedPlanRow[]
            tSavedPlanRow[] aRows
            tDataSourceRow[] TheDataFull
            Integer[] aieCat
            Integer iCategory_Col iErrNo_Col iFile_Col iLine_Col iHint_Col iFn_Col
            Integer iRow iSize iSp
            String sLineDisp

            Get pTheDataFull to TheDataFull
            Get paieCatFull  to aieCat
            Get piColumnId of oCategory_Col to iCategory_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oLine_Col     to iLine_Col
            Get piColumnId of oHint_Col     to iHint_Col
            Get piColumnId of oFn_Col       to iFn_Col
            Move (SizeOfArray(TheDataFull) - 1) to iSize
            For iRow from 0 to iSize
                Move aieCat[iRow]                            to aRows[iRow].eCategory
                Move TheDataFull[iRow].sValue[iCategory_Col] to aRows[iRow].sCategory
                Move TheDataFull[iRow].sValue[iErrNo_Col]    to aRows[iRow].sMsg
                Move TheDataFull[iRow].sValue[iFile_Col]     to aRows[iRow].sFile
                Move TheDataFull[iRow].sValue[iHint_Col]     to aRows[iRow].sHint
                Move TheDataFull[iRow].sValue[iFn_Col]       to aRows[iRow].sFn
                Move TheDataFull[iRow].sValue[iLine_Col]     to sLineDisp
                Move sLineDisp                               to aRows[iRow].sLineDisplay
                // numeric first-occurrence line: the leading integer before any "  (xN)" suffix
                Move (Trim(sLineDisp)) to sLineDisp
                Move (Pos(" ", sLineDisp)) to iSp
                If (iSp > 0) ;
                    Move (Trim(Left(sLineDisp, iSp - 1))) to sLineDisp
                Move sLineDisp to aRows[iRow].iLine
            Loop
            Function_Return aRows
        End_Function

        // BuildSavedPlanRows minus the DISMISSED rows (pabIgnoredFull - the same flag DisplayFiltered
        // hides by). The full builder deliberately keeps them (the frozen saved-plan JSON re-applies
        // ignores at load, and PlanFromSavedRows re-filters anyway), but a VIEW built from the full set
        // resurrects rows the grid itself hides: the guided findings list showed 95 dismissed rows as
        // "Auto-fixable" while Run-the-plan correctly built an empty plan from them - a dead-end button
        // on rows the user dismissed months ago (Nils 2026-07-25, pass-4 replay). Indexes align 1:1
        // with pTheDataFull, the array both builders walk.
        Function BuildSavedPlanRowsVisible Returns tSavedPlanRow[]
            tSavedPlanRow[] aRows aVisible
            Boolean[] abIgnored
            Integer iRow iSize iOut

            Get BuildSavedPlanRows to aRows
            Get pabIgnoredFull to abIgnored
            Move (SizeOfArray(aRows) - 1) to iSize
            Move 0 to iOut
            For iRow from 0 to iSize
                If ((SizeOfArray(abIgnored) <= iRow) or (abIgnored[iRow] = False)) Begin
                    Move aRows[iRow] to aVisible[iOut]
                    Increment iOut
                End
            Loop
            Function_Return aVisible
        End_Function

        // SAVED-PLAN mode loader: re-load the last saved plan (Data\LastPlan-<wskey>.json) into the
        // grid instead of parsing a .prn. The inverse of BuildSavedPlanRows - maps the named saved
        // rows back onto the grid columns + paieCatFull, pins a "saved plan" summary, then paints via
        // the SAME DisplayFiltered, so the informational hide, jump-to-source and Ctrl+I all work
        // unchanged. A missing / stale file leaves the grid empty (ShowSavedPlan guards before we get here).
        Procedure LoadSavedPlan
            Handle ho
            Boolean bOK bIg bPrnThere
            tCompileError[] aPrnMsgs
            Integer iAmbRestored iBackRestored
            tSavedPlan ThePlan
            tDataSourceRow[] TheData TheDataEmpty
            tModIgnore[] aIgnored
            Integer[] aieCat
            Boolean[] abIgnoredNone

            String[][] asRowOccNone
            Integer iCategory_Col iErrNo_Col iFile_Col iLine_Col iHint_Col iFn_Col
            Integer iRow iSize iOut iAutoKept iSuggestKept iIgnoredCount iFilteredNow
            String sFile sMsg sScopeWhy
            String[] asScopeRoots
            Boolean bInScope
            /* The IsComObjectCreated guard that used to sit HERE now wraps only DisplayFiltered at
               the end. Everything in between is plain property work - and piColumnId is assigned by
               RegisterColumn at OBJECT construction (cCJGridColumn.pkg:172), not COM realization, so
               the column ids are valid on a cold grid too. This is what lets the trail restore a
               saved Check into the board WITHOUT realizing (and so showing) the dock: the top-guard
               version silently no-opped on a cold grid (the 07e54a4 lesson), and the ShowSavedPlan
               workaround dragged the whole dock into view as a side effect of picking a workspace
               (Nils 2026-07-29) - and, docked first, it stacked ABOVE the Test Compile bar for the
               rest of the session. The dock's own realization still lands the COM rows: Initialize
               sees pbSavedView and calls back in here, and by then the guard below passes. */
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ReadSavedPlan of ho (&ThePlan) to bOK
            Get ReadIgnored   of ho to aIgnored
            Get piColumnId of oCategory_Col to iCategory_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oLine_Col     to iLine_Col
            Get piColumnId of oHint_Col     to iHint_Col
            Get piColumnId of oFn_Col       to iFn_Col
            Move (SizeOfArray(ThePlan.aRows) - 1) to iSize
            Move 0 to iOut
            Move 0 to iAutoKept
            Move 0 to iSuggestKept
            Move 0 to iIgnoredCount
            For iRow from 0 to iSize
                // Honour the per-workspace Ignore list here too: a dismissed row stays hidden when the frozen
                // plan is re-viewed, and Ignore Row / Clear Ignored work in saved view by simply re-loading.
                // IsRowIgnored (not IsIgnored) so a MERGED row - sMsg "W 4532, W 4533, W 4534" - is matched
                // against the per-message ignore keys; a raw IsIgnored on the joined cell missed it, so the
                // dismissed cMapiHandler row leaked into "View last plan" while the live grid hid it.
                Move ThePlan.aRows[iRow].sFile to sFile
                Move ThePlan.aRows[iRow].sMsg  to sMsg
                Get IsRowIgnored of ho sFile sMsg (&aIgnored) to bIg
                If (bIg = True) Begin
                    Increment iIgnoredCount
                End
                Else Begin
                    Move ThePlan.aRows[iRow].eCategory    to aieCat[iOut]
                    Move ThePlan.aRows[iRow].sCategory    to TheData[iOut].sValue[iCategory_Col]
                    Move ThePlan.aRows[iRow].sMsg         to TheData[iOut].sValue[iErrNo_Col]
                    Move ThePlan.aRows[iRow].sFile        to TheData[iOut].sValue[iFile_Col]
                    Move ThePlan.aRows[iRow].sLineDisplay to TheData[iOut].sValue[iLine_Col]
                    Move ThePlan.aRows[iRow].sHint        to TheData[iOut].sValue[iHint_Col]
                    Move ThePlan.aRows[iRow].sFn          to TheData[iOut].sValue[iFn_Col]
                    If (ThePlan.aRows[iRow].eCategory = eModAutoFix) ;
                        Increment iAutoKept
                    If (ThePlan.aRows[iRow].eCategory = eModSuggest) ;
                        Increment iSuggestKept
                    Increment iOut
                End
            Loop
            /* THE SYSTEM (READ-ONLY) ROWS, RECOUNTED - not carried over from the plan (2026-08-19).

               piSumFiltered was flatly 0 here while the live path published a real number, so the
               board could not say how many findings it had set aside for sitting in files DFRefactor
               will not write - DataFlex's own install, a DfPkg checkout, a locked VCS copy. On Nils's
               WinServ that is 9 rows (Dftable.pkg, Dfwinrpt.pkg, cCryptographer.pkg and friends), and
               without them the header's states did not add up to the Check's own row count.

               RECOMPUTED rather than trusted from the plan, even though the plan stored the badge the
               live pass wrote. The read-only ATTRIBUTE can be cleared between the Check and this
               restore, and a file that is writable now is in scope now - trusting a frozen badge
               would keep telling the user a file is untouchable after they had fixed exactly that.
               The same predicate, the same memo, and the same re-badge as LoadData, so a restored
               view and a live one cannot disagree about what is a system file.

               Dismissed rows need no test here: unlike the live pass, they never entered TheData. */
            Move 0 to iFilteredNow
            Get GetWorkspaceScopeRoots to asScopeRoots
            Set psScopeMemoFile to ""      // re-ask the disk; an attribute may have been cleared since
            If (SizeOfArray(asScopeRoots) > 0) Begin
                For iRow from 0 to (iOut - 1)
                    Get IsFileInRefactorScope TheData[iRow].sValue[iFile_Col] asScopeRoots (&sScopeWhy) to bInScope
                    If (bInScope = False) Begin
                        Move eModExplain          to aieCat[iRow]
                        Move "System (read-only)" to TheData[iRow].sValue[iCategory_Col]
                        Move ""                   to TheData[iRow].sValue[iFn_Col]
                        Move sScopeWhy            to TheData[iRow].sValue[iHint_Col]
                        Increment iFilteredNow
                    End
                Loop
            End
            /* THE COLLISION SIGNAL, RECOVERED FROM THE PLAN'S OWN .prn (2026-08-15).

               tSavedPlan has carried sSourcePrn since it was written - the .prn / .err this plan was
               parsed from - and nothing has ever read it back. It is read here.

               The row set below is the frozen plan and stays frozen; this restores only the derived
               name arrays the guided findings list needs to offer its row actions, which the live
               analyze sets and a restore did not. Where the .prn is gone - moved, cleaned, or a Deep
               Scan plan that never had one - the counts stay 0 and the rows render exactly as before,
               which is the behaviour this replaces rather than a new failure mode.

               Cost is the parse alone. A Check is compile + parse, and only the parse was missing. */
            Move 0 to iAmbRestored
            Move 0 to iBackRestored
            If (ThePlan.bDeepScan = False and Trim(ThePlan.sSourcePrn) <> "") Begin
                Get vFilePathExists ThePlan.sSourcePrn to bPrnThere
                If (bPrnThere = True) Begin
                    Get ReadCompilerMessages ThePlan.sSourcePrn to aPrnMsgs
                    Send RebuildCollisionSignal ho (&aPrnMsgs) (&iAmbRestored) (&iBackRestored)
                    /* Publish the provenance too, not just the parse. The plan has already been
                       accepted by the stamp check, so this .prn is the one these very rows were read
                       from - which is exactly what the compiled-scope lookup needs. */
                    Set psPlanSourcePrn of ghoModAnalyzerDock to (Trim(ThePlan.sSourcePrn))
                End
            End
            Send Destroy of ho
            // Saved-plan counts for the web chip bar, recomputed over the rows actually KEPT (after the ignore
            // filter) so the breakdown + "N ignored" match what is shown.
            Set piSumAuto         to iAutoKept
            Set piSumSuggest      to iSuggestKept
            Set piSumWarn         to 0
            Set piSumErr          to 0
            // These three are no longer flatly 0: they carry whatever the re-parse above recovered,
            // and stay 0 when there was no .prn to read.
            Set piSumCollisionErr  to (iAmbRestored + iBackRestored)
            Set piSumReturnTypeErr to iAmbRestored
            Set piSumBackportErr   to iBackRestored
            Set piSumExplain      to 0
            Set piSumFiltered     to iFilteredNow
            Set piSumIgnored   to iIgnoredCount
            Set piSumExcluded  to 0    // the saved plan never held the COM-proxy / file-less drops
            Set pbSumSaved     to True
            Set psSumSavedDate to ThePlan.sDate
            Set pTheDataFull  to TheData
            Set paieCatFull   to aieCat
            Set psAnalyzeDataWS to (psSWSFile(ghoApplication))   // the workspace this build describes (cache key)
            // Saved view already EXCLUDED the dismissed rows above (the IsRowIgnored skip), so pTheDataFull is
            // the non-dismissed set - clear the view-time flag array (empty = nothing to hide) so DisplayFiltered
            // shows exactly these rows. Clearing the ignore list + re-loading brings the dismissed rows back.
            Set pabIgnoredFull to abIgnoredNone
            // A saved plan stores only the merged rows - no per-occurrence detail - so the unfold
            // toggle has nothing to open here (CurrentRowFoldable reads these as not-foldable).
            Set pasRowOccFull   to asRowOccNone
            Set pabExpandedFull to abIgnoredNone
            // The COM half. On a cold grid the paint (and the ready-flag bookkeeping inside it) waits
            // for the dock's own realization; the properties above are already the whole truth, and
            // pbAnalyzeDataReady deliberately stays False so ReassertAnalyzerView re-initializes
            // rather than trusting a cache the visual grid has never held (the 2026-07-05 lesson).
            If (IsComObjectCreated(Self)) ;
                Send DisplayFiltered
        End_Procedure

        // Placeholder text for an EMPTY analyze grid - tells the user WHY it is empty instead of leaving
        // blankness that reads as "broken". iShownTotal = the non-dismissed rows that EXIST (0 = nothing parsed).
        // Reconciles against the Compiler Output warning tally: the classic "compiler full of warnings, grid
        // empty" case is warnings that live entirely in files OUTSIDE the workspace (DataFlex install packages,
        // COM proxies) - the analyzer correctly has nothing to act on, and now says so.
        Function EmptyGridReason Integer iShownTotal Returns String
            Integer iCompilerWarn

            // Deep Scan view: an empty grid means the scan is EXHAUSTED - and that must NOT read
            // as "workspace fully modern" (Nils 2026-07-11: scan clean, then the first compile
            // rained obsolete-class warnings and it looked like a scanner glitch). Hand the user
            // over to the compile loop, the other tine of the bar's "or" fork - the compiler
            // checks what a source scan cannot.
            If (pbDeepScanView(Self) = True) ;
                Function_Return "Analyze Source is exhausted - no obsolete symbols left in the analyzed folders. (A campaign typically takes a few passes: earlier fixes unlock later ones, so it re-runs until nothing convertible remains.) Next: Compile + Analyze (steps 1-2 on the bar) - the compiler verifies what a source analyze cannot (missing function Returns, type issues, ...), and Run Plan handles those rows the same way."
            Move 0 to iCompilerWarn
            If (ghoCompilerOutputDock <> 0) ;
                Get piCompileWarnings of ghoCompilerOutputDock to iCompilerWarn
            If (iCompilerWarn > iShownTotal) ;
                Function_Return ("No refactorable warnings in the workspace. The compiler reported " + String(iCompilerWarn) + " warning(s), but none map to code you can refactor here - they are in system / out-of-scope files (e.g. DataFlex install packages, COM proxies). See the Compiler Output tab for the full list.")
            If (iShownTotal > 0) ;
                Function_Return ("No auto-fixable or review warnings. " + String(iShownTotal) + " informational / read-only row(s) are hidden - press Toggle Explain (Ctrl+I) to see them.")
            Function_Return "No warnings or errors to analyse."
        End_Function

        // Apply the informational show/hide to the cached full build, number the visible rows
        // in the "#" column, render the summary chip bar, then paint. Called by LoadData
        // (after a fresh parse) and by Ctrl+I (ToggleInformational) - the latter re-filters the
        // cache with NO re-parse, so the toggle is instant. Keeps the Auto-fix/Review rows when
        // informational is hidden; shows everything otherwise. (Re-filtering resets any active
        // header sort to the load order - expected, since the row set changed - but the HIGHLIGHTED
        // row survives: captured by identity below and re-selected after the repaint.)
        Procedure DisplayFiltered
            Integer iRow iKeep iHidden iCount iRowNum_Col iFull
            Integer iSel iSelFull iSelNew iErrNo_Col iFile_Col iLine_Col
            Integer iOut iOcc iOccMax iTab iNum iCategory_Col iHint_Col iFn_Col iBeat
            tDataSourceRow[] TheData TheDataFull TheDataEmpty TheDataFiltered TheDataOld
            Integer[] aieCat
            Boolean[] abIgnored abExpanded abChild
            Boolean bSelWasChild bExp
            String sHtml sSelFile sSelMsg sSelLine sSelFn sReason

            String[][] asRowOcc
            String sOcc sOccLine sOccMsg sOccTxt
            Handle hoTCBar hoDS
            If (not(IsComObjectCreated(Self))) ;
                Procedure_Return
            Get pTheDataFull  to TheDataFull
            Get paieCatFull   to aieCat
            Get pabIgnoredFull to abIgnored
            Get pasRowOccFull  to asRowOcc
            Get pabExpandedFull to abExpanded
            Move (SizeOfArray(TheDataFull)) to iCount
            // The tab-switch re-display cache is READY only when the full build actually HOLDS ROWS
            // (2026-07-05): the cold-show race can run this with an EMPTY pTheDataFull (the dock's
            // first Initialize -> LoadData/LoadSavedPlan has not landed yet), and claiming ready then
            // CEMENTED the empty grid - every later tab switch saw bReady=True and re-displayed the
            // empty cache instead of re-initializing ("View last plan" opened an empty Analyzer).
            // Not-ready + the empty paint below = the next activation / the dashboard's 150ms
            // re-assert retries the REAL load instead.
            Set pbAnalyzeDataReady to (iCount > 0)          // the grid has data to re-display on a tab-switch
            Set pbLoadedSavedView to (pbSavedView(Self))    // ...and which mode it is, so OnUpdate reloads on a mode change
            // Keep the Test Compile bar's Run Fix Plan gate in sync - every count change (analyze,
            // Ignore/Clear refilter, saved view) funnels through this repaint (Nils 2026-07-04). The
            // SyncWebButtonStates itself is deferred to AFTER piSumVisible is set below, so the chips see
            // this build's counts, not the previous one. (The triage chips - Toggle Explain / Ignore /
            // Clear Ignored - re-render with the summary push itself since their 2026-07-10 move there:
            // PushSummaryHtml -> the bar's SetAnalyzeSummaryHtml appends them with fresh gates.)
            Get phoTestCompileFT of ghoApplication to hoTCBar
            Get piColumnId of oRowNum_Col   to iRowNum_Col
            Get piColumnId of oCategory_Col to iCategory_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oLine_Col     to iLine_Col
            Get piColumnId of oHint_Col     to iHint_Col
            Get piColumnId of oFn_Col       to iFn_Col
            // PRESERVE THE HIGHLIGHT (Nils 2026-07-05): capture the selected row's IDENTITY - its file +
            // message + line cells - before the rebuild, and re-select it after InitializeData below, so
            // a Ctrl+I / Ignore / Clear Ignored refilter no longer dumps the highlight back to row one.
            // Identity, NOT the row index: the refilter changes the row set, and an active header sort
            // makes indexes meaningless anyway (the rebuild resets any sort to load order - see the
            // header note). The cells are read from the LIVE data source, which IS the sorted view.
            Move -1 to iSelFull
            Move -1 to iSelNew
            Move False to bSelWasChild
            Get phoDataSource to hoDS
            Get SelectedRow of hoDS to iSel
            Get DataSource of hoDS to TheDataOld
            If (iSel >= 0 and iSel < SizeOfArray(TheDataOld)) Begin
                Move TheDataOld[iSel].sValue[iFile_Col]  to sSelFile
                Move TheDataOld[iSel].sValue[iErrNo_Col] to sSelMsg
                Move TheDataOld[iSel].sValue[iLine_Col]  to sSelLine
                // An unfolded CHILD row (blank "#" cell) may not survive the rebuild (a fold, an
                // ignore, a sort reset) - retarget the capture to its MASTER, identified by the
                // (File, Refactor function) pair the child inherits (Nils 2026-07-09).
                If (TheDataOld[iSel].sValue[iRowNum_Col] = "") Begin
                    Move True to bSelWasChild
                    Move TheDataOld[iSel].sValue[iFn_Col] to sSelFn
                End
            End
            If (iCount = 0) Begin
                Get SummaryHtml 0 to sHtml
                Send PushSummaryHtml sHtml
                Set piSumVisible to 0
                Get EmptyGridReason 0 to sReason
                Set psNoItemsText to sReason
                If (hoTCBar <> 0) ;
                    Send SyncWebButtonStates of hoTCBar
                Send InitializeData TheDataEmpty
                Procedure_Return
            End
            // Locate the captured identity in the FULL build - its load-order position drives both the
            // exact re-select and the nearest-survivor fallback in the keep-loop below. A captured
            // CHILD resolves to its MASTER row via the (File, Function) key instead.
            If (sSelFile <> "") Begin
                For iRow from 0 to (iCount - 1)
                    If (bSelWasChild = True) Begin
                        If (sSelFn <> "" and TheDataFull[iRow].sValue[iFile_Col] = sSelFile and TheDataFull[iRow].sValue[iFn_Col] = sSelFn) Begin
                            Move iRow to iSelFull
                            Move (iCount - 1) to iRow   // canonical DF loop-exit
                        End
                    End
                    Else If (TheDataFull[iRow].sValue[iFile_Col] = sSelFile and TheDataFull[iRow].sValue[iErrNo_Col] = sSelMsg and TheDataFull[iRow].sValue[iLine_Col] = sSelLine) Begin
                        Move iRow to iSelFull
                        Move (iCount - 1) to iRow   // canonical DF loop-exit
                    End
                Loop
            End

            // Build the rows to SHOW. Two hides: (1) DISMISSED (Ignore) rows are NEVER shown - pabIgnoredFull
            // flags them (live analyze marks the real ones; the saved-plan loader leaves it empty because it
            // already excluded them). (2) informational (Explain/Unknown) rows are hidden unless Ctrl+I toggled
            // them on. iFull is the NON-dismissed row total - the "rows" count + the auto/review/explain
            // breakdown in the chip (dismissed rows show as a separate "N ignored" chip, not in the breakdown).
            // The SizeOfArray guard keeps a stale/empty flag array from faulting - a missing flag = not dismissed.
            Move 0 to iFull
            Move 0 to iKeep
            Move 0 to iOut
            Move 0 to iBeat
            Move TheDataEmpty to TheDataFiltered
            For iRow from 0 to (iCount - 1)
                // One beat per 2000 rows - a struct-array copy per row, plus a child row per absorbed
                // occurrence on an unfolded master, so a large build spends real time here. Inert
                // outside LoadData's own call (see pbDisplayPumpOk).
                Increment iBeat
                If (iBeat >= 2000) Begin
                    Send DisplayBeat ("building the view - row " + String(iRow + 1) + " of " + String(iCount))
                    Move 0 to iBeat
                End
                If (SizeOfArray(abIgnored) > iRow and abIgnored[iRow] = True) Begin
                    // dismissed -> hidden, and not part of the chip breakdown
                End
                Else Begin
                    Increment iFull
                    If (pbShowInformational(Self) = True or aieCat[iRow] = eModAutoFix or aieCat[iRow] = eModSuggest) Begin
                        Move TheDataFull[iRow] to TheDataFiltered[iOut]
                        Move False to abChild[iOut]
                        // Restore target: the captured row itself - or, when it is no longer shown (an
                        // informational row after toggling Explain off, or the row just dismissed with
                        // Ignore), the FIRST survivor after it, keeping the highlight in the neighbourhood.
                        If (iSelNew = -1 and iSelFull >= 0 and iRow >= iSelFull) ;
                            Move iOut to iSelNew
                        Increment iOut
                        Increment iKeep
                        // UNFOLDED master (Nils 2026-07-09): materialise one CHILD row per absorbed
                        // occurrence right below it. The blank "#" cell marks a child (sort-proof);
                        // File + Line drive the existing double-click jump; the inherited Refactor
                        // function cell lets a child resolve its master for the re-fold.
                        Move False to bExp
                        If (SizeOfArray(abExpanded) > iRow) ;
                            Move abExpanded[iRow] to bExp
                        If (bExp = True and SizeOfArray(asRowOcc) > iRow) Begin
                            Move (SizeOfArray(asRowOcc[iRow]) - 1) to iOccMax
                            For iOcc from 0 to iOccMax
                                Move asRowOcc[iRow][iOcc] to sOcc
                                Move (Pos(Character(9), sOcc)) to iTab
                                Move (Trim(Left(sOcc, iTab - 1))) to sOccLine
                                Move (Mid(sOcc, Length(sOcc), iTab + 1)) to sOcc
                                Move (Pos(Character(9), sOcc)) to iTab
                                Move (Left(sOcc, iTab - 1)) to sOccMsg
                                Move (Mid(sOcc, Length(sOcc), iTab + 1)) to sOccTxt
                                Move ""       to TheDataFiltered[iOut].sValue[iRowNum_Col]
                                Move ""       to TheDataFiltered[iOut].sValue[iCategory_Col]
                                Move sOccMsg  to TheDataFiltered[iOut].sValue[iErrNo_Col]
                                Move TheDataFull[iRow].sValue[iFile_Col] to TheDataFiltered[iOut].sValue[iFile_Col]
                                Move sOccLine to TheDataFiltered[iOut].sValue[iLine_Col]
                                Move sOccTxt  to TheDataFiltered[iOut].sValue[iHint_Col]
                                Move TheDataFull[iRow].sValue[iFn_Col]   to TheDataFiltered[iOut].sValue[iFn_Col]
                                Move True to abChild[iOut]
                                Increment iOut
                            Loop
                        End
                    End
                End
            Loop
            Move (iFull - iKeep) to iHidden
            Move TheDataFiltered to TheData
            // Visible-row count drives the empty-state placeholder + the Ignore / Run Plan chip enablement.
            Set piSumVisible to iKeep
            If (iKeep = 0) Begin
                Get EmptyGridReason iFull to sReason
                Set psNoItemsText to sReason
            End

            // Number the VISIBLE MASTER rows 1..K in this (original load) order, so clicking the
            // "#" header restores it after the user has sorted by another column. Re-numbered on
            // every Ctrl+I so the column is always a clean 1..K over what's shown. CHILD rows keep
            // their blank "#" - it is both the visual cue and the sort-proof child marker (an
            // active header sort scatters children away from their master until the next rebuild;
            // clicking "#" regroups them).
            Move (SizeOfArray(TheData) - 1) to iCount
            Move 0 to iNum
            For iRow from 0 to iCount
                If (SizeOfArray(abChild) > iRow and abChild[iRow] = True) Begin
                    // child: keep the blank "#"
                End
                Else Begin
                    Increment iNum
                    Move (String(iNum)) to TheData[iRow].sValue[iRowNum_Col]
                End
            Loop

            // Render the summary chip bar (in the Test Compile bar): iFull = the NON-dismissed row total, whose
            // auto-fix / review / explain breakdown sums to it; the warning/error tally + "N ignored" are
            // separate groups. Built from the stable per-build counts, so it does not jump on a Ctrl+I.
            Get SummaryHtml iFull to sHtml
            Send PushSummaryHtml sHtml
            // The paint is ONE uninterruptible call over every visible row - the last long silence of
            // an analyze, and the one the beat cannot subdivide. Name it before handing over.
            Send DisplayBeat ("painting " + String(SizeOfArray(TheData)) + " row(s) into the grid")
            Send InitializeData TheData
            // Put the highlight back (see the capture above): the row itself when still visible, the
            // nearest following survivor when not, else the last row. MoveToRow also scrolls it into
            // view - the same post-InitializeData move CompilerOutputFT's error jump uses. A no-op
            // when nothing was captured (first fill) or nothing survived the filter.
            If (iSelNew = -1 and iSelFull >= 0 and iKeep > 0) ;
                Move (iKeep - 1) to iSelNew
            If (iSelNew >= 0) ;
                Send MoveToRow iSelNew
            // Now that piSumVisible + the counts are current, re-render the Test Compile bar chips (the
            // Run Fix Plan gate; the triage chips rode the PushSummaryHtml above) - deferred from the top
            // of this procedure.
            If (hoTCBar <> 0) ;
                Send SyncWebButtonStates of hoTCBar
        End_Procedure

        // Build the dark ONE-LINE "chip bar" HTML for the analyze summary - rendered in the Test Compile bar
        // (over the result text) while the Analyzer is shown. iTotalRows is the FULL build's row count; the
        // breakdown auto-fix / review / explain sums to it (explain = the informational rows the Toggle
        // Explain button hides). The warning/error message tally is a separate group. Reads the per-build
        // counts (piSum*). pbSumSaved switches to saved-plan wording (no warning/error chips); a muted inline
        // tail carries the saved-plan "last run" stamp or the filtered-out (outside-workspace) message count.
        Function SummaryHtml Integer iTotalRows Returns String
            String sH sTail sTailTip
            Integer iAuto iSuggest iExplain iWarn iErr iFiltered iIgnored iExcluded iScan
            Boolean bSaved

            Get piSumAuto     to iAuto
            Get piSumSuggest  to iSuggest
            Get piSumWarn     to iWarn
            Get piSumErr      to iErr
            Get piSumScan     to iScan
            Get piSumFiltered to iFiltered
            Get piSumIgnored  to iIgnored
            Get piSumExcluded to iExcluded
            Get pbSumSaved    to bSaved
            // iFiltered now counts the SYSTEM (read-only) rows (LoadData's re-badge pass) - they are
            // eModExplain too, so subtract them here to keep the "explain" chip to in-workspace rows.
            Move (iTotalRows - iAuto - iSuggest - iFiltered) to iExplain
            Move (CS_PaletteCssLink + CssLink("modanalyzer") + CS_PillsCssLink) to sH
            // Every chip carries a title="..." tooltip - that is where the full prose the old text object
            // showed now lives (the meanings of each category, the Toggle Explain hint, the filtered note,
            // and the standing "more refactorings exist" tip). Keep the tooltip text ASCII + double-quote
            // free (it sits inside a double-quoted HTML attribute).
            Move (sH + (DivOpen("sbar"))) to sH
            Move (sH + (SpanOpenTip("lbl", "Findings the analyzer mapped from the compiler messages. Tip: more refactorings exist that the compiler never warns about - browse the Select Functions view.")) + String(iTotalRows) + (' rows' + CS_SpanEnd)) to sH
            Move (sH + SepHtml()) to sH
            Move (sH + (SpanOpenTip("pill ok", "Auto-fix - a refactoring function applies the fix cleanly.")) + String(iAuto) + (' auto-fix' + CS_SpanEnd)) to sH
            Move (sH + (SpanOpenTip("pill review", "Review - a fix is applied, but check the result afterwards.")) + String(iSuggest) + (' review' + CS_SpanEnd)) to sH
            Move (sH + (SpanOpenTip("pill mute", "Explain / Unknown - no auto-fix; handle by hand. Hidden by default - use Toggle Explain (Ctrl+I) to show.")) + String(iExplain) + (' explain' + CS_SpanEnd)) to sH
            // Dismissed-row count (Ignore) - shown in BOTH live + saved view. Muted; Clear Ignored brings them back.
            If (iIgnored > 0) ;
                Move (sH + (SpanOpenTip("pill mute", "Rows you dismissed with Ignore - suppressed on every analyze for this workspace (grid and refactor plan). Use Clear Ignored to bring them all back.")) + String(iIgnored) + (' ignored' + CS_SpanEnd)) to sH
            // Excluded-diagnostic count: COM-proxy + file-less rows the analyzer DROPPED (not hidden - they never
            // show, even with Toggle Explain). Naming the number here stops the grid looking wrongly empty vs the
            // Compiler Output tab. Live view only (a saved plan never carried these).
            If (iExcluded > 0) ;
                Move (sH + (SpanOpenTip("pill mute", "Compiler diagnostics the analyzer removed because there is nothing to refactor: warnings in Studio COM-proxy wrapper files (auto-generated) and file-less link/manifest errors (no source line). These are NOT hidden rows - Toggle Explain will not show them; they remain visible in the Compiler Output tab, which is why its count can be higher than the analyzer grid.")) + String(iExcluded) + (' excluded' + CS_SpanEnd)) to sH
            // System (read-only) rows: in the grid but from files OUTSIDE the workspace, hidden by default
            // (Toggle Explain reveals them). Promoted from a muted tail to a proper chip (Nils 2026-07-07) so
            // it reads consistently with the other informational counts. Live view only (piSumFiltered = 0 in saved).
            If (iFiltered > 0) ;
                Move (sH + (SpanOpenTip("pill mute", "Rows in files OUTSIDE the workspace (e.g. the DataFlex install packages) - not refactorable here. Shown read-only and hidden by default; use Toggle Explain (Ctrl+I) to see them.")) + String(iFiltered) + (' system (read-only)' + CS_SpanEnd)) to sH
            If (bSaved = False) Begin
                Move (sH + SepHtml()) to sH
                Move (sH + (SpanOpenTip("pill warn", "Compiler warnings the analyzer can triage - what the COMPILER reported, and nothing else. Warnings in Studio COM-proxy files and file-less diagnostics are excluded (nothing there to refactor), so this can be slightly lower than the Compiler chip which counts the full listing. Deep Scan findings are counted on their own chip, not here.")) + String(iWarn) + (' warnings' + CS_SpanEnd)) to sH
                // The SCAN lane gets its own chip rather than swelling the warning count - see piSumScan.
                If (iScan > 0) ;
                    Move (sH + (SpanOpenTip("pill review", "Deep Scan findings merged into this analysis - obsolete code found by SCANNING THE SOURCE, which the compiler never warns about. They are triaged, dismissed and planned exactly like compiler rows, and wear a DS number instead of a W/E one. Counted separately because the compiler did not report them.")) + String(iScan) + (' scan findings' + CS_SpanEnd)) to sH
                Move (sH + (SpanOpenTip("pill err", "Errors tied to a source line - what the grid can show and refactor. File-less link/manifest errors and Studio COM-proxy diagnostics are not shown here (they are reported on the compile result line instead), so this count can be lower than the compiler total.")) + String(iErr) + (' errors' + CS_SpanEnd)) to sH
            End
            Move "" to sTail
            Move "" to sTailTip
            If (bSaved = True) Begin
                Move "saved plan" to sTail
                If (psSumSavedDate(Self) <> "") ;
                    Move (sTail + " - last run " + psSumSavedDate(Self)) to sTail
                Move "The last saved modernization plan for this workspace (read-only)." to sTailTip
            End
            If (sTail <> "") Begin
                Move (sH + (SpanOpen("sep")) + CS_MidDot + CS_SpanEnd) to sH
                Move (sH + (SpanOpenTip("tail", sTailTip)) + sTail + CS_SpanEnd) to sH
            End
            Move (sH + CS_DivEnd) to sH
            Function_Return sH
        End_Function

        // Push the freshly-built summary HTML to the Test Compile bar's chip strip (it overlays the result
        // text while the Analyzer is shown). Cross-dock: the bar lives in oTestCompile_dg, reached via the app
        // handle; the bar's own SetAnalyzeSummaryHtml guards realization. A no-op when the bar isn't up.
        // bWithTriage True: the analyzer's band is the one that carries the bar's Toggle Explain /
        // Ignore / Clear Ignored chips (the compiler-totals band passes False - they act on THIS grid).
        Procedure PushSummaryHtml String sHtml
            Handle hoBar
            Get phoTestCompileFT of ghoApplication to hoBar
            If (hoBar <> 0) ;
                Send SetAnalyzeSummaryHtml of hoBar sHtml True
        End_Procedure

        /* Every warned line of every INDICATOR-CONVERTER row, as "<pathLc>|<line>" keys for the
           companion oracle (_ScopeNeedsIndicatorCompanion). A merged (file|function) row shows one
           line, but pasRowOccFull holds the folded occurrences - each one a warned indicator-use
           line the oracle must test, or a name whose only qualifying use sits on a folded line is
           missed and the companion under-offers (and an under-offered companion means converters
           leave an indicator undeclared in CUSTOMER output). Read by StartAutoSelect's live
           plan-from-rows path. */
        Function IndicatorOccurrenceLineKeys Returns String[]
            String[] asKeys asOcc

            String[][] asRowOcc
            tDataSourceRow[] TheDataFull
            String sFns sFn sFileLc sOccEntry sLineDisp
            Integer iRow iSize j iPos iFile_Col iFn_Col iLine_Col iSp
            Handle ho
            Boolean bIndicator
            Get pTheDataFull  to TheDataFull
            Get pasRowOccFull to asRowOcc
            Get piColumnId of oFile_Col to iFile_Col
            Get piColumnId of oFn_Col   to iFn_Col
            Get piColumnId of oLine_Col to iLine_Col
            Get Create (RefClass(cModAnalyzer)) to ho
            Move (SizeOfArray(TheDataFull) - 1) to iSize
            For iRow from 0 to iSize
                Move (Trim(TheDataFull[iRow].sValue[iFn_Col])) to sFns
                Move False to bIndicator
                While (sFns <> "")
                    Move (Pos(", ", sFns)) to iPos
                    If (iPos > 0) Begin
                        Move (Trim(Left(sFns, iPos - 1)))                  to sFn
                        Move (Trim(Mid(sFns, (Length(sFns)), (iPos + 2)))) to sFns
                    End
                    Else Begin
                        Move sFns to sFn
                        Move ""   to sFns
                    End
                    If (_IsIndicatorConverterName(ho, sFn)) ;
                        Move True to bIndicator
                Loop
                If (bIndicator = True and Trim(TheDataFull[iRow].sValue[iFile_Col]) <> "") Begin
                    Move (Lowercase(Trim(TheDataFull[iRow].sValue[iFile_Col]))) to sFileLc
                    // The row's own (first) line - the Line cell may carry a "  (xN)" fold suffix.
                    Move (Trim(TheDataFull[iRow].sValue[iLine_Col])) to sLineDisp
                    Move (Pos(" ", sLineDisp)) to iSp
                    If (iSp > 0) ;
                        Move (Trim(Left(sLineDisp, iSp))) to sLineDisp
                    If (sLineDisp <> "") ;
                        Move (sFileLc + "|" + sLineDisp) to asKeys[-1]
                    // ...plus every folded occurrence ("line<TAB>msg<TAB>text").
                    Move asRowOcc[iRow] to asOcc
                    For j from 0 to (SizeOfArray(asOcc) - 1)
                        Move asOcc[j] to sOccEntry
                        Move (Pos(Character(9), sOccEntry)) to iPos
                        If (iPos > 1) ;
                            Move (sFileLc + "|" + Trim(Left(sOccEntry, iPos - 1))) to asKeys[-1]
                    Loop
                End
            Loop
            Send Destroy of ho
            Function_Return asKeys
        End_Function

        // Returns only the diagnostics that name a source file. File-less ones (link / manifest
        // errors, and any message the parser couldn't tie to a file) have no source line to show or
        // refactor, so the analyzer grid skips them (the compile result line reports link failures).
        // Without this they would render as a phantom "file: blank, line: 0" row - and, since a blank
        // path isn't under the workspace roots, get mis-badged "System (read-only)".
        //  ByRef on the incoming array: a by-value struct-array parameter deep-copies at the CALL
        //  boundary, and this one is handed 40,000 tCompileError structs on a big workspace. Measured
        //  2026-07-22 - the four filters over that array cost ~20s of a 72s Analyze between them.
        //  Standing rule from Nils: arrays and struct arrays are passed ByRef by default.
        //  A FOLDER IS NO FILE EITHER (2026-10-05): the last line of a listing a crashed compiler left
        //  behind ended in "OF FILE: <folder>\", and the row it made carried that folder into a plan.
        //  IsCompilerMessageFile (CompileErrorParser.pkg) answers for both.
        Function MessagesWithAFile tCompileError[] ByRef aMessages Returns tCompileError[]
            tCompileError[] aKept
            Integer i iAll iKeep
            Boolean bIsFile
            Move (SizeOfArray(aMessages) - 1) to iAll
            Move 0 to iKeep
            For i from 0 to iAll
                Get IsCompilerMessageFile aMessages[i].sFileName to bIsFile
                If (bIsFile = True) Begin
                    Move aMessages[i] to aKept[iKeep]
                    Increment iKeep
                End
            Loop
            Function_Return aKept
        End_Function

        // The workspace source roots: the home folder + the workspace's library source roots
        // (psHomeTarget + GetWorkspaceLibrarySourceFolders), each normalized with a trailing
        // separator (vFolderFormat) for safe prefix matching. Empty when no workspace home is
        // known (callers then treat every file as in-scope - can't scope safely). Shared by
        // FilterToWorkspaceFiles (the refactor-plan scope) and LoadData (which badges rows whose
        // file is NOT under these roots "System (read-only)" instead of dropping them).
        Function GetWorkspaceScopeRoots Returns String[]
            String[] asRoots asLibRoots asSelected
            String sHome sSWS
            Integer i iLib
            Handle hoAn

            Get psHomeTarget of ghoApplication to sHome
            If (sHome = "") ;
                Function_Return asRoots
            Move (vFolderFormat(sHome)) to asRoots[0]
            /* THE SELECTED FOLDERS ARE IN SCOPE - THAT IS THE RULE (Nils 2026-08-16, twice today: "All
               folders that are selected should be able to be changed ... together with the file
               filter. It doesn't matter if the files are part of a library or not - it never has").
               On WinServ the home + library-walk roots below missed E:\WebAppSrc (its DF26-style INI
               child libraries keep their paths behind ConfigFile=), so 98 rows in his OWN selected
               library - 13 of them E 4539 auto-fixes - were badged "System (read-only)", the plan got
               nothing, and the board said "0 of 74 ... the compiler is clean" over 78 errors. */
            Get pasSelectedFolders of ghoApplication to asSelected   // the LIVE full-path cache; "SelectedFolders" is a Register_Function stub with no body (err 98 on the first live run)
            Move (SizeOfArray(asSelected) - 1) to iLib
            For i from 0 to iLib
                If (Trim(asSelected[i]) <> "") ;
                    Move (vFolderFormat(Trim(asSelected[i]))) to asRoots[-1]
            Loop
            // The workspace's LIBRARY ROOTS, from the same inventory the Libraries dialog and
            // VerifyLibraryOwned use (cLibraryInventory via RefreshLibraryRoots - proven on this very
            // workspace today), not only the .sws-chain walk below, which cannot see a DF26 INI
            // library whose paths sit behind ConfigFile=. Both are kept: a union can only widen scope
            // toward what the user selected, never past the DataFlex install (which neither lists).
            Get Create (RefClass(cModAnalyzer)) to hoAn
            Send RefreshLibraryRoots of hoAn
            Get pasLibRoots of hoAn to asLibRoots
            Send Destroy of hoAn
            Move (SizeOfArray(asLibRoots) - 1) to iLib
            For i from 0 to iLib
                Move (vFolderFormat(asLibRoots[i])) to asRoots[-1]
            Loop
            Get psSWSFile of ghoApplication to sSWS
            Get GetWorkspaceLibrarySourceFolders of ghoApplication sSWS to asLibRoots
            Move (SizeOfArray(asLibRoots) - 1) to iLib
            For i from 0 to iLib
                Move (vFolderFormat(asLibRoots[i])) to asRoots[-1]
            Loop
            Function_Return asRoots
        End_Function

        // Keep only diagnostics whose file is inside the workspace source tree (GetWorkspaceScopeRoots).
        // This scopes the set handed to the refactor PLAN / Auto Select - they must never touch files
        // outside the workspace (the DataFlex install Pkg, other external includes). The GRID itself now
        // SHOWS the out-of-scope rows, badged "System (read-only)" (LoadData's re-badge pass); only the
        // plan drops them. If no workspace home is known, the list is left untouched (can't scope safely).
        // iDropped (ByRef) receives the number of out-of-scope messages, which the analyze summary uses.
        Function FilterToWorkspaceFiles tCompileError[] ByRef aMessages Integer ByRef iDropped Returns tCompileError[]
            tCompileError[] aKept
            String[] asRoots
            String sWhyNot
            Integer i iAll iKeep
            Boolean bInScope

            Move 0 to iDropped
            Get GetWorkspaceScopeRoots to asRoots
            If (SizeOfArray(asRoots) = 0) ;
                Function_Return aMessages
            Move (SizeOfArray(aMessages) - 1) to iAll
            Move 0 to iKeep
            For i from 0 to iAll
                Get IsFileInRefactorScope aMessages[i].sFileName asRoots (&sWhyNot) to bInScope
                If (bInScope = True) Begin
                    Move aMessages[i] to aKept[iKeep]
                    Increment iKeep
                End
                Else ;
                    Increment iDropped
            Loop
            Function_Return aKept
        End_Function

        /* IN SCOPE = under the workspace roots AND writable. A file that carries the READ-ONLY
           attribute is a SYSTEM file - Nils 2026-08-18: "if the files are write protected, I think
           they should be handled just like the other DataFlex system files under Program Files" -
           and "no point really to offer an auto-fix for a file that can't be changed". What that
           catches: DataFlex 26's DfPkg package checkouts (which sit UNDER the workspace home, so
           the roots test alone kept them in scope: E:\WinServ\DfPkg\...\vWin32fh.pkg got a W 4534
           auto-fix row, the plan ran, and the write failed silently), the DataFlex system package cache,
           and VCS working copies that mark non-checked-out files read-only.

           sWhyNot carries the hint for the System (read-only) badge - "" when in scope. Same
           predicate for the grid's badge pass (LoadData) and the plan's scope
           (FilterToWorkspaceFiles), so what is hidden by default is exactly what the plan leaves
           alone. One GetFileAttributesW per DISTINCT file (the memo). */
        Function IsFileInRefactorScope String sFile String[] asRoots String ByRef sWhyNot Returns Boolean
            Boolean bUnder
            String  sNote

            Move "" to sWhyNot
            Get IsFileUnderRoots sFile asRoots to bUnder
            /* THE FILE THE USER PICKED IS IN SCOPE (2026-09-17). Single-file mode's file need not sit
               under the workspace roots at all - a legacy file dropped beside a workspace is exactly
               what that door is for - and the rows it has here were asked for by name (the Analyze
               this file pill). Under the roots or not, it still has to be writable: the attribute
               test below stands, a read-only pick is a system file whatever mode we are in. */
            If (bUnder = False and pbWorkspaceMode(ghoApplication) = False) ;
                Move (Lowercase(sFile) = Lowercase(psCurrentSourceFileName(ghoApplication))) to bUnder
            If (bUnder = False) Begin
                Move "Read-only system / install file - not refactored here." to sWhyNot
                Function_Return False
            End
            If (sFile = psScopeMemoFile(Self)) Begin
                Move (psScopeMemoWhy(Self)) to sWhyNot
                Function_Return (sWhyNot = "")
            End
            If (rfIsFileReadOnly(sFile) = True) Begin
                Move "Write-protected (READ-ONLY attribute) - a system / package file, not refactored here." to sWhyNot
                Move (rfPackageManagedPathNote(sFile)) to sNote
                If (sNote <> "") ;
                    Move (sWhyNot + " " + sNote) to sWhyNot
            End
            Set psScopeMemoFile to sFile
            Set psScopeMemoWhy  to sWhyNot
            Function_Return (sWhyNot = "")
        End_Function

        // True if sFile sits under any of the folder roots (case-insensitive prefix). The
        // roots are pre-normalized with a trailing separator (vFolderFormat) so this won't
        // mistake "...\Foo" for a sibling "...\FooBar".
        Function IsFileUnderRoots String sFile String[] asRoots Returns Boolean
            Integer iRoot iRoots
            String sLowFile sLowRoot
            Move (Lowercase(Trim(sFile))) to sLowFile
            Move (SizeOfArray(asRoots) - 1) to iRoots
            For iRoot from 0 to iRoots
                Move (Lowercase(Trim(asRoots[iRoot]))) to sLowRoot
                If ((sLowRoot <> "") and (Left(sLowFile, Length(sLowRoot)) = sLowRoot)) Begin
                    Function_Return True
                End
            Loop
            Function_Return False
        End_Function

        // Open the selected error's source file at its line. Mirrors CompilerOutputFT.dg's
        // jump: psProduct picks the path (TestBench's editor already holds the code; in
        // DFRefactor we open the file first). A blank-file row (shouldn't occur now the summary
        // is out of the grid) just no-ops the jump.
        Procedure DisplayCurrentSourceLine
            Integer iLine_Col iFile_Col iLine iItem iPos
            String sFileName sProduct sLineCell
            Handle hoDataSource hoEditor
            tDataSourceRow[] TheData

            Get piColumnId of oLine_Col to iLine_Col
            Get piColumnId of oFile_Col to iFile_Col
            Get phoDataSource to hoDataSource
            Get SelectedRow of hoDataSource to iItem
            Get DataSource of hoDataSource to TheData
            Move TheData[iItem].sValue[iFile_Col] to sFileName
            // The Line cell may carry a per-file occurrence count, e.g. "156  (x2)" - keep only the
            // leading number so the Move to the Integer iLine does not choke on the "(x2)" suffix
            // ("Bad format in expression"). A plain per-line row ("893") has no suffix and passes through.
            Move TheData[iItem].sValue[iLine_Col] to sLineCell
            Move (Pos("(x", sLineCell)) to iPos
            If (iPos > 0) ;
                Move (Trim(Left(sLineCell, iPos - 1))) to sLineCell
            Move sLineCell to iLine
            If (sFileName = "") Begin
                Procedure_Return
            End

            Get psProduct of ghoApplication to sProduct
            If (sProduct = "Test Bench") Begin
                If (iLine <> -1) Begin
                    Decrement iLine
                    Send JumpToSourceLine of (Client_Id(phoMainPanel(ghoApplication))) iLine
                    Send Activate of (phoEditorRefactored(ghoApplication))
                End
            End
            Else Begin
                Get phoEditor of ghoApplication to hoEditor
                If (hoEditor <> 0 and sFileName <> "" and iLine > 0) Begin
                    // Activate the VIEW via its registered activation message (declared in
                    // OutputDockFT.dg): a bare object Activate moves the DataFlex focus tree
                    // WITHOUT switching CodeJock's TabWorkspace page (Nils 2026-07-23).
                    Send Activate_oEditorView_vw of (Client_Id(ghoCommandBars))
                    Send LoadFile of hoEditor sFileName
                    Send JumpToSourceLine of hoEditor (iLine - 1)
                End
            End
        End_Procedure

        // Re-apply the ignore filter to the CACHED build - the "clear the list + re-filter, no re-parse"
        // path the pTheDataFull cache was built for. Recomputes the per-row dismissed flags and the chip
        // tallies from the in-memory arrays, re-derives the plan's message set from the cached pre-drop
        // scoped set (paScopedMessagesFull), refreshes the dashboard snapshot, and re-displays. Replaces
        // the QUIET full LoadData that Ignore Row / Clear Ignored ran before - a whole .prn re-parse +
        // re-classify + per-row source-guard dry-runs, with ALL feedback suppressed by the quiet flag, so
        // it read as a long silent freeze (Nils 2026-07-03). In-memory only -> effectively instant, and no
        // PumpMsgQueue anywhere near the WebView2-deferred timer (the dock-tear-down the quiet flag guards).
        // Safe no-op when nothing is cached (no analyze this session) - the caller falls back to LoadData.
        Procedure RefilterIgnored
            Handle ho
            Integer iRow iCount iAuto iSuggest iFiltered iIgnored iFile_Col iErrNo_Col iCategory_Col
            Boolean bRowIgnored
            tDataSourceRow[] TheData
            Integer[] aieCat
            Boolean[] abIgnored
            tModIgnore[] aIgnored
            tCompileError[] asScoped

            Get pTheDataFull to TheData
            Move (SizeOfArray(TheData)) to iCount
            If (iCount = 0) ;
                Procedure_Return
            Get piColumnId of oFile_Col     to iFile_Col
            Get piColumnId of oErrNo_Col    to iErrNo_Col
            Get piColumnId of oCategory_Col to iCategory_Col
            Get paieCatFull to aieCat
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ReadIgnored of ho to aIgnored
            // Per-row dismissed flags + the chip tallies - mirrors LoadData's flag + tally passes (the
            // System rows are counted by their re-badged Category cell; LoadData badges dismissed rows
            // too, so a restored row carries the right badge).
            Move 0 to iAuto
            Move 0 to iSuggest
            Move 0 to iFiltered
            Move 0 to iIgnored
            For iRow from 0 to (iCount - 1)
                Get IsRowIgnored of ho TheData[iRow].sValue[iFile_Col] TheData[iRow].sValue[iErrNo_Col] aIgnored to bRowIgnored
                Move bRowIgnored to abIgnored[iRow]
                If (bRowIgnored = True) Begin
                    Increment iIgnored
                End
                Else Begin
                    If (aieCat[iRow] = eModAutoFix) ;
                        Increment iAuto
                    If (aieCat[iRow] = eModSuggest) ;
                        Increment iSuggest
                    If (TheData[iRow].sValue[iCategory_Col] = "System (read-only)") ;
                        Increment iFiltered
                End
            Loop
            // The refactor PLAN's message set: re-derive from the cached pre-drop scoped set with the
            // CURRENT ignore list, so Auto Select / Refactor Plan and the grid stay in lock-step.
            Get paScopedMessagesFull to asScoped
            Get DropIgnoredMessages of ho (&asScoped) (&aIgnored) to asScoped
            Set paScopedMessages to asScoped
            Send Destroy of ho
            Set pabIgnoredFull to abIgnored
            Set piSumAuto     to iAuto
            Set piSumSuggest  to iSuggest
            Set piSumFiltered to iFiltered
            Set piSumIgnored  to iIgnored
            // Keep the dashboard's Last-analyze tile + registry snapshot honest (warn/err are the raw
            // compiler tallies - an ignore-filter change does not affect them).
            Move iAuto    to ghiLastAnalyzeAuto
            Move iSuggest to ghiLastAnalyzeSuggest
            Send WriteAnalyzeSnapshot of ghoApplication (piSumWarn(Self)) (piSumErr(Self)) iAuto iSuggest (piSumScan(Self))
            // Keep the SHARED "last plan" actionable counts in lock-step too, so the "View/Run last plan" link +
            // guided "Run Plan" gate reflect an Ignore/Clear immediately (they gate on ghiLastPlan*, not the
            // compile snapshot). Provenance + date are unchanged by an ignore-filter, so only the counts move.
            Move iAuto    to ghiLastPlanAuto
            Move iSuggest to ghiLastPlanSuggest
            Send DisplayFiltered
        End_Procedure

        // Dismiss the highlighted row with Ignore: add its (file, message) to the per-workspace ignore-list
        // and reload, so it - and every occurrence it stands for - drops from the grid AND the refactor plan,
        // and stays gone on each future analyze. A report-only row (e.g. TypeToStructReport / W 4532) cannot
        // be "fixed", so this is how the user retires it; Clear Ignored brings everything back. The (file,
        // message) is read straight off the selected row's cells - the same key DropIgnoredMessages rebuilds
        // per message - so a single-message row round-trips exactly. No-op with no row selected, a blank key,
        // an already-ignored row, or in saved-plan view (a frozen plan has no live list to write).
        Procedure IgnoreSelectedRow
            Integer iFile_Col iErrNo_Col iItem iN iSel i iAnchor j iTok iSavedTop iNewTop
            String sFile sMsg sTok
            String[] asMsgTok
            Handle hoDataSource ho
            tDataSourceRow[] TheData
            tModIgnore[] aIgnored
            Boolean bExists bAdded bSavedNoFocus
            Integer[] aiRows

            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Get piColumnId of oFile_Col  to iFile_Col
            Get piColumnId of oErrNo_Col to iErrNo_Col
            // Ignore EVERY selected row (the user can multi-select), falling back to the focused row.
            Get GetIndexesForSelectedRows to aiRows
            If (SizeOfArray(aiRows) = 0) Begin
                Get SelectedRow of hoDataSource to iItem
                If (iItem >= 0) ;
                    Move iItem to aiRows[0]
            End
            If (SizeOfArray(aiRows) = 0) ;
                Procedure_Return
            // Many selected rows + a re-parse refresh can take a moment - show the busy cursor meanwhile.
            // (Placed AFTER the no-row early return, and the only Procedure_Return is above, so Cursor_Ready
            //  at the end is always reached.)
            Send Cursor_Wait of Cursor_Control
            Get Create (RefClass(cModAnalyzer)) to ho
            Get ReadIgnored of ho to aIgnored
            Move False to bAdded
            Move (SizeOfArray(aiRows) - 1) to iSel
            For i from 0 to iSel
                Move aiRows[i] to iItem
                // Track the topmost ignored row so the grid can re-anchor there after the reload.
                If ((i = 0) or (iItem < iAnchor)) ;
                    Move iItem to iAnchor
                Move TheData[iItem].sValue[iFile_Col]  to sFile
                Move TheData[iItem].sValue[iErrNo_Col] to sMsg
                If ((Trim(sFile) <> "") and (Trim(sMsg) <> "")) Begin
                    // The Msg# cell can be a ", "-joined LIST for a MERGED row (function-backed, or several
                    // messages on one file+line) - e.g. "W 4532, W 4533, W 4534". Ignore EACH token, because
                    // DropIgnoredMessages keys per single message; storing the whole list as one key never
                    // round-trips, so ignoring such a row did nothing (Nils, LegacyApp cMapiHandler).
                    Get SplitMsgList of ho sMsg to asMsgTok
                    Move (SizeOfArray(asMsgTok) - 1) to iTok
                    For j from 0 to iTok
                        Move asMsgTok[j] to sTok
                        Get IsIgnored of ho sFile sTok (&aIgnored) to bExists
                        If (bExists = False) Begin
                            Move (SizeOfArray(aIgnored)) to iN
                            Move sFile to aIgnored[iN].sFile
                            Move sTok  to aIgnored[iN].sMsg
                            Move True to bAdded
                        End
                    Loop
                End
            Loop
            If (bAdded = True) ;
                Send WriteIgnored of ho aIgnored
            Send Destroy of ho
            // Capture the scroll position (top visible row) BEFORE the reload. LoadData / LoadSavedPlan
            // rebuild the data source and CodeJock resets ComTopRowIndex to 0 - THAT is what snapped the
            // grid back to the top and lost the user's place. (Nils: keep the grid where it was after Ignore.)
            Get ComTopRowIndex to iSavedTop
            // Refresh: saved view re-loads the frozen plan (with the ignore filter applied); live view
            // RE-FILTERS the cached build in memory (RefilterIgnored) - instant, no .prn re-parse. (Was a
            // quiet full LoadData: a whole re-analyze per Ignore click, silent under the quiet flag.)
            If (pbSavedView(Self)) Begin
                Send LoadSavedPlan
            End
            Else Begin
                Send RefilterIgnored
            End
            // Stay where the user was: land the selection on the row just above the topmost row we ignored,
            // then RESTORE the scroll offset. The rows ABOVE the ignored one did not move, so the same top
            // row is still valid; only the ignored rows (at/below iAnchor) went away. Both values are clamped
            // to the now-shorter data source. pbNoFocusChangeCheck suppresses focus-change churn while we
            // reposition, and setting ComTopRowIndex AFTER MoveToRow lets the scroll win (mirrors the
            // library's SynchronizeGridtoSelectedRow).
            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move (SizeOfArray(TheData)) to iN
            If (iN > 0) Begin
                Move (iAnchor - 1) to iItem
                If (iItem < 0) ;
                    Move 0 to iItem
                If (iItem > iN - 1) ;
                    Move (iN - 1) to iItem
                Move iSavedTop to iNewTop
                If (iNewTop < 0) ;
                    Move 0 to iNewTop
                If (iNewTop > iN - 1) ;
                    Move (iN - 1) to iNewTop
                Get pbNoFocusChangeCheck to bSavedNoFocus
                Set pbNoFocusChangeCheck to True
                Send MoveToRow iItem
                Set ComTopRowIndex to iNewTop
                Set pbNoFocusChangeCheck to bSavedNoFocus
            End
            Send Cursor_Ready of Cursor_Control
        End_Procedure

        // Clear the entire per-workspace ignore-list (restore every dismissed row) and refresh. Paired with
        // the "N ignored" summary chip + the Clear Ignored toolbar button. Live view with a cached build:
        // an in-memory RefilterIgnored - instant (was a full quiet re-analyze: .prn re-parse + re-classify +
        // source-guards, in total silence - Nils 2026-07-03). Wait cursor + a status-bar elapsed note cover
        // whichever path runs; the LoadData fallback (nothing cached this session) stays quiet internally
        // (the pump would tear the docks down from the WebView2-deferred timer) but is now at least
        // announced and timed.
        Procedure ClearIgnored
            Handle ho hoStatusBar
            Integer iTick iRestored
            tModIgnore[] aEmpty

            Send Cursor_Wait of Cursor_Control
            Move (GetTickCount()) to iTick
            Get piSumIgnored to iRestored    // the rows about to come back - for the final status note
            Get Statusbar_Id of (phoMainPanel(ghoApplication)) to hoStatusBar
            Set StatusText of hoStatusBar to "Restoring ignored rows..."
            Get Create (RefClass(cModAnalyzer)) to ho
            Send WriteIgnored of ho aEmpty
            Send Destroy of ho
            // Restore: saved view re-loads the frozen plan; live view re-parses (both with an empty list),
            // Saved view re-loads the frozen plan (JSON read - fast); live view re-filters the cached
            // build in memory; nothing cached (no analyze this session) falls back to the quiet re-parse.
            If (pbSavedView(Self)) Begin
                Send LoadSavedPlan
            End
            Else If (SizeOfArray(pTheDataFull(Self)) > 0) Begin
                Send RefilterIgnored
            End
            Else Begin
                Set pbQuietRefresh to True
                Send LoadData
                Set pbQuietRefresh to False
            End
            Send Cursor_Ready of Cursor_Control
            Set StatusText of hoStatusBar to ("Ready. Restored " + String(iRestored) + " ignored row(s) in " + String((GetTickCount() - iTick) / 1000) + "s.")
        End_Procedure

        Procedure Initialize
            If (pbSavedView(Self)) ;
                Send LoadSavedPlan
            Else ;
                Send LoadData
        End_Procedure

        // --- Unfold / fold occurrences (Nils 2026-07-09) ---------------------------------------
        // Decode the selected VIEW row sort-proof from its CELLS: iMaster receives the row's
        // pTheDataFull index (its own for a master row, the owning master's for an unfolded
        // child), bIsChild says which it was. A child is recognised by its blank "#" cell and
        // resolves its master via the (File, Refactor function) pair it inherits - the very key
        // the (file|function) row merge was built on. Returns False when the selection maps to
        // no full row (empty grid, or a saved view whose identity moved).
        Function _SelectedRowMaster Integer ByRef iMaster Boolean ByRef bIsChild Returns Boolean
            Integer iSel iRow iCount iRowNum_Col iErrNo_Col iFile_Col iLine_Col iFn_Col
            String sFile sMsg sLine sFn
            Handle hoDS
            tDataSourceRow[] TheDataOld TheDataFull

            Move -1 to iMaster
            Move False to bIsChild
            Get phoDataSource to hoDS
            Get SelectedRow of hoDS to iSel
            Get DataSource of hoDS to TheDataOld
            If (iSel < 0 or iSel >= SizeOfArray(TheDataOld)) ;
                Function_Return False
            Get piColumnId of oRowNum_Col to iRowNum_Col
            Get piColumnId of oErrNo_Col  to iErrNo_Col
            Get piColumnId of oFile_Col   to iFile_Col
            Get piColumnId of oLine_Col   to iLine_Col
            Get piColumnId of oFn_Col     to iFn_Col
            Move TheDataOld[iSel].sValue[iFile_Col]  to sFile
            Move TheDataOld[iSel].sValue[iErrNo_Col] to sMsg
            Move TheDataOld[iSel].sValue[iLine_Col]  to sLine
            Move TheDataOld[iSel].sValue[iFn_Col]    to sFn
            Move (TheDataOld[iSel].sValue[iRowNum_Col] = "") to bIsChild
            Get pTheDataFull to TheDataFull
            Move (SizeOfArray(TheDataFull) -1) to iCount
            For iRow from 0 to iCount
                If (bIsChild = True) Begin
                    If (sFn <> "" and TheDataFull[iRow].sValue[iFile_Col] = sFile and TheDataFull[iRow].sValue[iFn_Col] = sFn) Begin
                        Move iRow to iMaster
                        Move iCount to iRow   // canonical DF loop-exit
                    End
                End
                Else If (TheDataFull[iRow].sValue[iFile_Col] = sFile and TheDataFull[iRow].sValue[iErrNo_Col] = sMsg and TheDataFull[iRow].sValue[iLine_Col] = sLine) Begin
                    Move iRow to iMaster
                    Move iCount to iRow       // canonical DF loop-exit
                End
            Loop
            Function_Return (iMaster >= 0)
        End_Function

        // True when the Unfold/Fold toggle applies to the selected row: it holds more than one
        // absorbed occurrence (a folded "line (xN)" master), or it IS an unfolded child (the
        // toggle then folds the family back). Always False in a saved view (no occurrence store).
        Function CurrentRowFoldable Returns Boolean
            Integer iMaster
            Boolean bIsChild bOK
            String[][] asRowOcc
            Get _SelectedRowMaster (&iMaster) (&bIsChild) to bOK
            If (bOK = False) ;
                Function_Return False
            Get pasRowOccFull to asRowOcc
            If (SizeOfArray(asRowOcc) <= iMaster) ;
                Function_Return False
            Function_Return (SizeOfArray(asRowOcc[iMaster]) > 1)
        End_Function

        // Unfold / fold the selected row's absorbed occurrences - reached from BOTH gestures
        // (double-click on a folded master, and the context menu's "Unfold / Fold occurrences";
        // Nils 2026-07-09). The rebuild is the same in-memory DisplayFiltered pass the ignore
        // filter uses - instant, no re-analyze - and its child-aware capture re-selects the
        // master row afterwards.
        Procedure ToggleFoldOccurrences
            Integer iMaster
            Boolean bIsChild bOK bExp
            Boolean[] abExpanded

            String[][] asRowOcc
            Get _SelectedRowMaster (&iMaster) (&bIsChild) to bOK
            If (bOK = False) ;
                Procedure_Return
            Get pasRowOccFull to asRowOcc
            If (SizeOfArray(asRowOcc) <= iMaster) ;
                Procedure_Return
            If (SizeOfArray(asRowOcc[iMaster]) < 2) ;
                Procedure_Return                        // nothing folded behind this row
            Get pabExpandedFull to abExpanded
            Move False to bExp
            If (SizeOfArray(abExpanded) > iMaster) ;
                Move abExpanded[iMaster] to bExp
            Move (not(bExp)) to abExpanded[iMaster]
            Set pabExpandedFull to abExpanded
            Send DisplayFiltered
        End_Procedure

        // Double-click: a folded MASTER (>1 occurrences) unfolds (and an unfolded one folds back);
        // a child row and a plain single-occurrence row jump to source as before (Nils 2026-07-09).
        Procedure OnComRowDblClick Variant llRow Variant llItem
            Integer iMaster
            Boolean bIsChild bOK bFoldable
            Get _SelectedRowMaster (&iMaster) (&bIsChild) to bOK
            If (bOK = True and bIsChild = False) Begin
                Get CurrentRowFoldable to bFoldable
                If (bFoldable = True) Begin
                    Send ToggleFoldOccurrences
                    Procedure_Return
                End
            End
            Send DisplayCurrentSourceLine
        End_Procedure

        // Right-click context menu - the shared dock menu (cRefactorCJToolPanel), same one CompilerOutputFT.dg uses.
        // Just before the dock's shared menu pops for this grid (cRDCCJToolPanelGrid claims it - on focus, and
        // again at right-click time, since the two grids share one merged dock (OutputDockFT) and one
        // context-menu slot): the Unfold/Fold item applies only to a row that holds folded occurrences (or
        // one of its unfolded children) - grey it out otherwise (Nils 2026-07-09).
        Procedure OnToolPanelMenuPopup Handle hoMenu
            Boolean bFoldable
            Handle hoItem
            Get CurrentRowFoldable to bFoldable
            Get phoFoldOccItem of hoMenu to hoItem
            If (hoItem <> 0) ;
                Set pbEnabled of hoItem to bFoldable
        End_Procedure

        // The selected rows - the current row when none is selected - onto the clipboard, one line each, the
        // columns tab-separated (RDCCopyGridRows, RDCToolsLib). Ctrl+C and the context menu send it.
        Procedure Copy
            Handle[] ahoColumns
            Integer iRows

            Move (oCategory_Col(Self)) to ahoColumns[-1]
            Move (oErrNo_Col(Self)) to ahoColumns[-1]
            Move (oFile_Col(Self)) to ahoColumns[-1]
            Move (oLine_Col(Self)) to ahoColumns[-1]
            Move (oHint_Col(Self)) to ahoColumns[-1]
            Move (oFn_Col(Self)) to ahoColumns[-1]
            Get RDCCopyGridRows Self ahoColumns to iRows
            If (iRows > 0) ;
                Set StatusText of (Statusbar_Id(Self)) to (String(iRows) * "row(s) copied to Windows clipboard.")
        End_Procedure

        // "Copy ln number to Clipboard": just the Line cell (mirrors CompilerOutputFT.dg).
        Procedure CopyErrorLineNo
            Integer iLn iItem
            Boolean bOk
            Handle hoDataSource
            tDataSourceRow[] TheData
            String sData

            Get piColumnId of oLine_Col to iLn
            Get phoDataSource to hoDataSource
            Get SelectedRow of hoDataSource to iItem
            If (iItem < 0) ;
                Procedure_Return
            Get DataSource of hoDataSource to TheData
            Move (TheData[iItem].sValue[iLn]) to sData
            If (sData = "" or sData = "0") ;
                Procedure_Return
            Get rfSetClipboardText sData to bOk
            If (bOk = False) ;
                Procedure_Return
            Set StatusText of (Statusbar_Id(Self)) to "Line number copied to Windows clipboard."
        End_Procedure

        // Ctrl+A selects every row, so the whole list can be copied in one go.
        // Toogles between marking all and if all rows are selected,
        // all rows are deselected.
        Procedure SelectAllRows
            Integer iCount iSelected
            Handle hoDataSource
    
            Get phoDataSource to hoDataSource
            Get RowCount of hoDataSource to iCount
            Get GetSelectedRowsCount to iSelected
            If (iCount <> iSelected) Begin
                Send SetSelectedRowsAll True
            End
            Else Begin
                Send SetSelectedRowsAll False
            End
        End_Procedure

        // Toggle the informational (Explain/Unknown) rows on/off and rebuild the grid. Re-runs
        // LoadData (re-parses the .prn) - fine for typical builds; if it drags on a very large
        // .prn we can cache the parsed messages and re-filter without re-reading.
        Procedure ToggleInformational
            Set pbShowInformational to (not(pbShowInformational(Self)))
            Send Cursor_Wait of Cursor_Control
            Send DisplayFiltered
            Send Cursor_Ready of Cursor_Control
        End_Procedure

        On_Key kEnter Send DisplayCurrentSourceLine
        On_Key Key_Ctrl+Key_C Send Copy
        On_Key Key_Ctrl+Key_A Send SelectAllRows
        On_Key Key_Ctrl+Key_I Send ToggleInformational
    End_Object

    // The analyze summary CHIP BAR no longer lives here - it is rendered in the Test Compile bar, over the
    // (stale-when-analyzing) "Failed: ..." result text, and swapped in when the Analyzer tab is shown. The
    // grid (above) builds the HTML in SummaryHtml and pushes it across via PushSummaryHtml ->
    // phoTestCompileFT.SetAnalyzeSummaryHtml; OutputDockFT.ShowTab drives the show/hide swap.

    // (OnCreateToolPanel / OnUpdate / Close_Panel live on the merged panel oOutputDock_dg now; this is a
    // Container3d area.)

    // Open this panel in SAVED-PLAN mode: re-load the last saved plan into the read-only grid (no .prn
    // parse). Armed off the dashboard's Modernize tile via the deferral timer (activating a dock from the
    // web pump is unsafe - same reason ShowTestCompilePanel defers). If there's no saved plan for this
    // workspace yet, say so and don't open an empty dock. Mirrors the visibility dance in ActivateModAnalyzer.
    Procedure ShowSavedPlan
        Handle ho
        Boolean bOK
        String sStaleWhy
        tSavedPlan ThePlan

        Get Create (RefClass(cModAnalyzer)) to ho
        Get ReadSavedPlan of ho (&ThePlan) to bOK
        Get psSavedPlanStaleWhy of ho to sStaleWhy
        Send Destroy of ho
        If (bOK = False) Begin
            // Two kinds of no (2026-08-17): never analyzed, or a plan whose compile output no longer
            // matches this workspace - ReadSavedPlan names which; say that rather than "none yet".
            If (sStaleWhy <> "") ;
                Send FTInfoBox sStaleWhy "Last plan is out of date"
            Else ;
                Send FTInfoBox "No saved plan for this workspace yet - run a Modernize / Analyze first."
            Procedure_Return
        End
        Set pbSavedView of oModAnalyzer_grd to True
        Set pbDeepScanView of oModAnalyzer_grd to False   // a saved view supersedes any standing scan mode
        Send ShowTab of ghoOutputDock eTabAnalyzer
    End_Procedure

End_Object

