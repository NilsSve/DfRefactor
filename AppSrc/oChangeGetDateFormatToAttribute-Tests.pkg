//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeGetDateFormatToAttribute-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-15
//
// Description : Unit tests for the ChangeGetDateFormatToAttribute refactor function - the
//               obsolete Get_Date_Format command to Get_Attribute DF_DATE_FORMAT.
//
//               The four converting shapes are the four spellings measured in a real legacy
//               workspace (26 sites across 10 files): the command is lowercase, mixed case or
//               capitalised, the 'to' is lowercase or capitalised, and the variable is dtype /
//               date_type / dt / iFormat. Every one goes through here verbatim.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeGetDateFormatToAttribute is a cTestFixture
        Set psFunctionName to "ChangeGetDateFormatToAttribute"

        // Helper: tokenize + convert one line, hand back the result and whether it changed.
        Function ConvertLine String ByRef sLine Returns Boolean
            Boolean bChanged
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeGetDateFormatToAttribute of ghoFuncLib (&sLine) "" to bChanged
            Function_Return bChanged
        End_Function

        // The measured shapes, verbatim - each must convert, keeping its indentation and target.
        { Published = True }
        Procedure GetDateFormat_MeasuredShapesConvert
            String sLine
            Boolean bChanged

            Move "    get_date_format to dtype" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT to dtype" sLine

            Move "    get_date_format to date_type" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT to date_type" sLine

            Move "    get_date_format to dt" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT to dt" sLine

            Move "    Get_Date_Format To iFormat" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT To iFormat" sLine
        End_Procedure

        // Bare, no indentation.
        { Published = True }
        Procedure GetDateFormat_Bare
            String sLine
            Boolean bChanged
            Move "Get_Date_Format to iFmt" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "Get_Attribute DF_DATE_FORMAT to iFmt" sLine
        End_Procedure

        // A trailing comment rides along untouched - including one that itself says 'to'.
        { Published = True }
        Procedure GetDateFormat_TrailingCommentKept
            String sLine
            Boolean bChanged
            Move "    get_date_format to dtype   // 0 = USA, 2 = military; used to pick the format" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT to dtype   // 0 = USA, 2 = military; used to pick the format" sLine
        End_Procedure

        // Idempotent: the converted line leads with Get_Attribute and is never matched again.
        { Published = True }
        Procedure GetDateFormat_ConvertedLineIsLeftAlone
            String sLine
            Boolean bChanged
            Move "    Get_Attribute DF_DATE_FORMAT to dtype" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Attribute DF_DATE_FORMAT to dtype" sLine
        End_Procedure

        // A longer identifier that merely STARTS with the keyword is not the command (whole token).
        { Published = True }
        Procedure GetDateFormat_PrefixIsNotTheCommand
            String sLine
            Boolean bChanged
            Move "    Get_Date_Format_Text to sFmt" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Date_Format_Text to sFmt" sLine
        End_Procedure

        // Not at command position: a Get of a method that happens to carry the name is left alone.
        { Published = True }
        Procedure GetDateFormat_NonLeadingIsLeftAlone
            String sLine
            Boolean bChanged
            Move "    Get Get_Date_Format of oDates to iFmt" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get Get_Date_Format of oDates to iFmt" sLine
        End_Procedure

        // A comment line and a string mention are not the command.
        { Published = True }
        Procedure GetDateFormat_CommentAndStringAreLeftAlone
            String sLine
            Boolean bChanged
            Move "    // get_date_format to dtype - the old way" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    // get_date_format to dtype - the old way" sLine

            Move '    Move "get_date_format to dtype" to sHelp' to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Move "get_date_format to dtype" to sHelp' sLine
        End_Procedure

        /* NO 'to' TAIL - not a shape the compiler accepts, so the converter declines rather than
           moving the error to a different line. The 'to' is looked for on the MASKED line, so one
           inside a trailing comment does not count (the POSITIVE control for that guard: the
           trailing-comment test above converts because the real 'to' is there too). */
        { Published = True }
        Procedure GetDateFormat_NoTargetIsDeclined
            String sLine
            Boolean bChanged
            Move "    Get_Date_Format" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Date_Format" sLine

            Move "    Get_Date_Format   // used to read the format" to sLine
            Get ConvertLine (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "    Get_Date_Format   // used to read the format" sLine
        End_Procedure

    End_Object
