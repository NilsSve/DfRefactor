//****************************************************************************
// $Module type: Test fixture
// $Module name: oModProgressCounts-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-15
//
// Description : Unit tests for ModProgressCounts.pkg - the rules for reading a modernization
//               progress entry's counts.
//
//               WHY THEY EXIST: one field used to carry two different things, the compiler's
//               warnings and the source scanner's findings. After an Analyze Source over a
//               workspace that compiled clean, the dashboard tile read "796 warnings", of which
//               not one was a warning. The counts are two fields now, and these fixtures pin the
//               three rules that came with the split: what each number is CALLED, how a row
//               written before the split is read, and the guarantee that makes the split safe -
//               an old row and its back-filled self have the SAME total, so no existing burn-down
//               gets a step in it.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oModProgressCounts is a cTestFixture
        Set psFunctionName to "ModProgressCounts"

        // ---------------------------------------------------------------- the naming rule

        // The reserved source-scan series counts FINDINGS - what the scanner saw in the source and
        // the compiler never reports. This is the case that was being mislabelled.
        { Published = True }
        Procedure ModProgressCounts_ScanSeriesSaysFindings
            String sNoun
            Move (ModProgressCountNoun(CS_ModProgressDeepScanLabel)) to sNoun
            Send AssertSAreEqual "findings" sNoun
        End_Procedure

        // A compile lap is stored under the PROGRAM name, and its count really is the compiler's.
        { Published = True }
        Procedure ModProgressCounts_ProgramSeriesSaysWarnings
            String sNoun
            Move (ModProgressCountNoun("hrapp.src")) to sNoun
            Send AssertSAreEqual "warnings" sNoun
            Move (ModProgressCountNoun("")) to sNoun     // a row older than the series field
            Send AssertSAreEqual "warnings" sNoun
        End_Procedure

        /* THE POSITIVE CONTROL for the naming rule: the two laps must not answer the same way. If a
           future edit collapsed this to one word, every test above could still pass while the
           surfaces went back to calling a scan finding a warning. */
        { Published = True }
        Procedure ModProgressCounts_TheTwoLapsAreNamedDifferently
            String sScan sCompile
            Move (ModProgressCountNoun(CS_ModProgressDeepScanLabel)) to sScan
            Move (ModProgressCountNoun("hrapp.src")) to sCompile
            Send Assert (sScan <> sCompile)
        End_Procedure

        // ---------------------------------------------------------------- reading an older row

        /* THE ROW THAT STARTED THIS. Written before the split, so its 796 findings sit in iWarn
           with iScan empty - and a scan lap has no compiler warnings by construction, so the whole
           number is recoverable and moves across. */
        { Published = True }
        Procedure ModProgressCounts_OldScanRowMovesItsCountToFindings
            tModProgressEntry E Out
            Move CS_ModProgressDeepScanLabel to E.sProgram
            Move 796 to E.iWarn
            Move 0   to E.iScan
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual 0   Out.iWarn
            Send AssertIAreEqual 796 Out.iScan
        End_Procedure

        // A row written since the split is already right, and running the rule over it changes nothing.
        { Published = True }
        Procedure ModProgressCounts_NewScanRowIsLeftAlone
            tModProgressEntry E Out
            Move CS_ModProgressDeepScanLabel to E.sProgram
            Move 0   to E.iWarn
            Move 640 to E.iScan
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual 0   Out.iWarn
            Send AssertIAreEqual 640 Out.iScan
        End_Procedure

        /* A COMPILE row is never touched. An old one cannot be split after the fact - if pending
           findings were merged into that analysis they are already inside iWarn with nothing to
           separate them by - and a new one is already correct. Either way the rule must keep its
           hands off, or it would move a compile lap's real warnings into the findings column. */
        { Published = True }
        Procedure ModProgressCounts_CompileRowIsNeverTouched
            tModProgressEntry E Out
            Move "hrapp.src" to E.sProgram
            Move 484 to E.iWarn
            Move 0   to E.iScan
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual 484 Out.iWarn
            Send AssertIAreEqual 0   Out.iScan

            Move 12 to E.iScan          // a compile lap that had findings merged into it
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual 484 Out.iWarn
            Send AssertIAreEqual 12  Out.iScan
        End_Procedure

        // ---------------------------------------------------------------- the burn-down magnitude

        /* THE GUARANTEE THAT MAKES THE SPLIT SAFE: the total is what the single field used to hold,
           so the trend line and the sparkline read the same before and after. Asserted as the
           IDENTITY it is - back-filling a row must never change its total - because that is the
           property every existing burn-down depends on, not the particular numbers here. */
        { Published = True }
        Procedure ModProgressCounts_BackFillPreservesTheTotal
            tModProgressEntry E Out
            Move CS_ModProgressDeepScanLabel to E.sProgram
            Move 796 to E.iWarn
            Move 0   to E.iScan
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual (ModProgressTotalCount(E)) (ModProgressTotalCount(Out))
            Send AssertIAreEqual 796 (ModProgressTotalCount(Out))

            Move "hrapp.src" to E.sProgram
            Move 484 to E.iWarn
            Move 12  to E.iScan
            Move (ModProgressBackFilledEntry(E)) to Out
            Send AssertIAreEqual (ModProgressTotalCount(E)) (ModProgressTotalCount(Out))
            Send AssertIAreEqual 496 (ModProgressTotalCount(Out))
        End_Procedure

    End_Object
