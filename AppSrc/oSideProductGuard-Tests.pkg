//****************************************************************************
// $Module type: Test fixture
// $Module name: oSideProductGuard-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-08
//
// Description : Unit tests for the side-product look-ahead guard: a command-to-function converter
//               must not drop Found / strmark / strlen while the code below it still reads one.
//               The look-ahead reaches a line function through pasLinePassSource +
//               piLinePassIndex + pbLinePassSideProducts, which the engine sets per file and per
//               line; these tests set them exactly as the engine does. An EMPTY look-ahead must
//               always mean "convert" - that is what keeps every other fixture, the test bench and
//               the analyzer's single-line dry run behaving as before.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oSideProductGuard is a cTestFixture
        Set psFunctionName to "ChangeReplaceCommandToFunction"

        // The real shape that broke a workspace's date parser: the Replace command, the strmark
        // read, and the Found test. The line must stay legacy and say why.
        { Published = True }
        Procedure SideProductGuard_ReplaceWithFoundAndStrMarkBelow_Declines
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  move strmark to iPos1'            to asCode[1]
            Move '  if [found] begin'                  to asCode[2]
            Move '  end'                               to asCode[3]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "NOT converted -")
            Send Assert (sLine contains "Found and strmark")
            Send Assert (sLine contains "the Replace() function")
            Send Assert (Left(sLine, 33) = '  replace sSep in sValue with "$"')
        End_Procedure

        // THE ORDER THE ENGINE ACTUALLY USES. LineByLineFunctions sends ClearFuncLibProperties at
        // its own top, after the per-file work in GetTheWorkDone. Anything the look-ahead needs has
        // to survive that clear, or the guard is a silent no-op in every real run while every test
        // that skips the clear stays green.
        { Published = True }
        Procedure SideProductGuard_LookAheadSurvivesClearFuncLibProperties
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  move strmark to iPos1'            to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Send ClearFuncLibProperties of ghoFuncLib
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "NOT converted -")
        End_Procedure

        // POSITIVE CONTROL. The same file with nothing below that reads a side product converts
        // exactly as it always did.
        { Published = True }
        Procedure SideProductGuard_NoReaderBelow_StillConverts
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  move sValue to sOther'           to asCode[1]
            Move '  end'                               to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '  Move (Replace(sSep, sValue, "$")) to sValue' sLine
        End_Procedure

        // A multi-line string's text is not code (2026-10-29): 'if [found]' and 'strmark' there are no reads, and
        // text that reads 'End_Procedure' ends no method - the look-ahead skips it as the macro-code guard does.
        { Published = True }
        Procedure SideProductGuard_StringTextIsNoRead
            String[] asCode asEmpty
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  Move """'                         to asCode[1]
            Move '      if [found] begin'             to asCode[2]
            Move '      End_Procedure'                to asCode[3]
            Move '      """ to sText'                 to asCode[4]
            Move '  Move @"move strmark to iPos1'     to asCode[5]
            Move '      End" to sText'                to asCode[6]
            Move '  move sValue to sOther'            to asCode[7]
            Move '  end'                              to asCode[8]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual '  Move (Replace(sSep, sValue, "$")) to sValue' sLine
            // ...and a real read after the strings still keeps the line as it is
            Move '  if [found] begin' to asCode[7]
            Set pasLinePassSource of ghoFuncLib to asCode
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "NOT converted -")
            Set pasLinePassSource of ghoFuncLib to asEmpty
            Set pbLinePassSideProducts of ghoFuncLib to False
        End_Procedure

        // NO LOOK-AHEAD AT ALL is the state of every other fixture, the test bench and the
        // analyzer's single-line probe: the converter must behave exactly as it did before.
        { Published = True }
        Procedure SideProductGuard_EmptyLookAhead_ConvertsAsBefore
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '  Move (Replace(sSep, sValue, "$")) to sValue' sLine
        End_Procedure

        // OFF BY ONE. The reader on the IMMEDIATELY next line is the canonical shape; a walk that
        // starts at iLine + 2 would pass a wider test and fail this one.
        { Published = True }
        Procedure SideProductGuard_ReaderOnTheVeryNextLine_Declines
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Pos sSep in sValue to iAt' to asCode[0]
            Move '  Move strlen to iRest'      to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "NOT converted -")
            Send Assert (sLine contains "the Pos() function")
        End_Procedure

        // A Find between the command and the read sets Found again, so the read no longer belongs
        // to the command and the line is free to convert.
        { Published = True }
        Procedure SideProductGuard_FoundResetByAFindBetween_Converts
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  Find gt Order by Index.1'       to asCode[1]
            Move '  If (Found) Move 1 to iHit'         to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '  Move (Replace(sSep, sValue, "$")) to sValue' sLine
        End_Procedure

        // The walk stops at the end of the method: a read in the NEXT method is not this command's.
        { Published = True }
        Procedure SideProductGuard_ReaderInTheNextMethod_Converts
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Pos sSep in sValue to iAt' to asCode[0]
            Move 'End_Procedure'               to asCode[1]
            Move 'Procedure Other'             to asCode[2]
            Move '  Move strmark to iAt'       to asCode[3]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangePosCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '  Move (Pos(sSep,sValue)) to iAt' sLine
        End_Procedure

        // Left leaves its COUNT in strmark, and Left() does not.
        { Published = True }
        Procedure SideProductGuard_LeftWithStrMarkReadBelow_Declines
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Left sName to sShort 5'   to asCode[0]
            Move '  Move strmark to iTaken'   to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLeftCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "NOT converted -")
            Send Assert (sLine contains "still reads strmark")
            Send Assert (sLine contains "the Left() function")
        End_Procedure

        // Right leaves its count in strlen - and a strmark read below is NOT its business.
        { Published = True }
        Procedure SideProductGuard_RightWatchesStrLenOnly
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Right sName to sTail 5'   to asCode[0]
            Move '  Move strmark to iTaken'   to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeRightCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
        End_Procedure

        // Mid leaves BOTH, so both are named when both are read.
        { Published = True }
        Procedure SideProductGuard_MidNamesBothProducts
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Mid sName to sPart 4 2'  to asCode[0]
            Move '  Move strmark to iStart'  to asCode[1]
            Move '  Move strlen to iLen'     to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeMidCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "strmark and strlen")
            Send Assert (sLine contains "the Mid() function")
        End_Procedure

        // The Insert command leaves the insert POSITION in strmark.
        { Published = True }
        Procedure SideProductGuard_InsertWithStrMarkReadBelow_Declines
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Insert "," in sList at 3'  to asCode[0]
            Move '  Move strmark to iWhere'    to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInsertCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (sLine contains "NOT converted -")
            Send Assert (sLine contains "the Insert() function")
        End_Procedure

        // A command that leaves NO side product never consults the look-ahead, however much the
        // code below reads.
        { Published = True }
        Procedure SideProductGuard_LengthCommandIgnoresTheLookAhead
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  Length sName to iLen'   to asCode[0]
            Move '  Move strmark to iAt'    to asCode[1]
            Move '  If (Found) Move 1 to i' to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLengthCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
        End_Procedure

        // IDEMPOTENT. A second run over an already-marked line adds nothing and reports no change,
        // so the file stays byte-identical.
        { Published = True }
        Procedure SideProductGuard_MarkerNotDuplicatedOnRerun
            String[] asCode
            String sLine sFirst
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  move strmark to iPos1'            to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Move sLine to sFirst
            Move sLine to asCode[0]
            Set pasLinePassSource of ghoFuncLib to asCode
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sFirst sLine
        End_Procedure

        // SELF-HEALING. Once the read is gone the marker is untrue, so it comes off and the line
        // converts on that very pass - otherwise it would silence the row for ever.
        { Published = True }
        Procedure SideProductGuard_StaleMarkerRemovedAndLineConverts
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"   // TODO (DFRefactor): NOT converted - the code below still reads Found - the Replace() function leaves it untouched. Found has no converter. Then delete this comment.' to asCode[0]
            Move '  move sValue to sOther' to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
            Send AssertSAreEqual '  Move (Replace(sSep, sValue, "$")) to sValue' sLine
        End_Procedure

        // A trailing ';' continues the statement onto the next line, so no comment may follow it.
        // The line is declined in silence rather than broken.
        { Published = True }
        Procedure SideProductGuard_SemicolonContinuation_DeclinesWithoutAMarker
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  If (bGo) replace sSep in sValue with "$" ;' to asCode[0]
            Move '      move strmark to iPos1'                   to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  If (bGo) replace sSep in sValue with "$" ;' sLine
        End_Procedure

        // Another converter's refusal already stands on the line: do not convert over it, and do
        // not stack a second marker beside it.
        { Published = True }
        Procedure SideProductGuard_ForeignMarkerLeftAlone
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"   // TODO (DFRefactor): NOT converted - something else said so.' to asCode[0]
            Move '  move sValue to sOther' to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  replace sSep in sValue with "$"   // TODO (DFRefactor): NOT converted - something else said so.' sLine
        End_Procedure

        // A side-product name inside a DF23 block comment is not a read.
        { Published = True }
        Procedure SideProductGuard_ReadInsideABlockComment_DoesNotCount
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  /* the old code read strmark and'  to asCode[1]
            Move '     tested [found] here */'         to asCode[2]
            Move '  move sValue to sOther'           to asCode[3]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
        End_Procedure

        // MACRO CODE IS NEVER REFACTORED, and it is not run-time code either: a strmark inside a
        // #COMMAND body belongs to whatever expands it.
        { Published = True }
        Procedure SideProductGuard_ReadInsideAMacroBody_DoesNotCount
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '#COMMAND TAKE_IT'                    to asCode[1]
            Move '    Move strmark to iAt'             to asCode[2]
            Move '#ENDCOMMAND'                         to asCode[3]
            Move '  move sValue to sOther'           to asCode[4]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
        End_Procedure

        // A dotted '.Found' is a struct or object member, not the runtime indicator; and bFound is
        // a different identifier altogether.
        { Published = True }
        Procedure SideProductGuard_DottedFoundAndLongerNamesAreNotTheIndicator
            String[] asCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  Move Hit.Found to bWas'            to asCode[1]
            Move '  If (bFound) Move 1 to iHit'        to asCode[2]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertFalse (sLine contains "NOT converted -")
        End_Procedure

        // The run note says what happened and how to get the good ordering, because the summary
        // line counts a marked line as touched.
        { Published = True }
        Procedure SideProductGuard_RunNoteExplainsTheRefusal
            String[] asCode
            String sLine sNotes
            Boolean bChanged
            tTokenizer TokenizerData

            Move '  replace sSep in sValue with "$"' to asCode[0]
            Move '  move strmark to iPos1'            to asCode[1]
            Set pasLinePassSource of ghoFuncLib to asCode
            Set pbLinePassSideProducts of ghoFuncLib to True
            Set piLinePassIndex of ghoFuncLib to 0
            Move asCode[0] to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Get RunNotesText of ghoFuncLib "ChangeReplaceCommandToFunction" "  " to sNotes
            Send Assert (sNotes contains "left exactly as they are")
            Send Assert (sNotes contains "ChangeStrMarkToExpression")
        End_Procedure

        // The strmark / strlen converters call _SideProductRefreshMarks after they rewrite reads:
        // the marker above a read they lifted is no longer true and has to go, or Deep Scan and the
        // analyzer stay quiet about a command line that is ready to convert.
        { Published = True }
        Procedure SideProductGuard_RefreshMarksTakesAStaleMarkerOff
            String[] asCode
            Integer iChanged

            Move 'Procedure Split'                                                                                                                                                                                                     to asCode[0]
            Move '  replace sSep in sValue with "$"   // TODO (DFRefactor): NOT converted - the code below still reads strmark - the Replace() function leaves it untouched. Then delete this comment.' to asCode[1]
            Move '  move sValue to sOther'                                                                                                                                                             to asCode[2]
            Move 'End_Procedure'                                                                                                                                                                         to asCode[3]
            Get _SideProductRefreshMarks of ghoFuncLib (&asCode) to iChanged
            Send AssertIAreEqual 1 iChanged
            Send AssertSAreEqual '  replace sSep in sValue with "$"' asCode[1]
        End_Procedure

        // ... and re-states it when only part of the reason has gone away.
        { Published = True }
        Procedure SideProductGuard_RefreshMarksRestatesAShrunkenReason
            String[] asCode
            Integer iChanged

            Move 'Procedure Split'                                                                                                                                                                                                                to asCode[0]
            Move '  replace sSep in sValue with "$"   // TODO (DFRefactor): NOT converted - the code below still reads Found and strmark - the Replace() function leaves them untouched. Then delete this comment.' to asCode[1]
            Move '  if [found] begin'                                                                                                                                                                               to asCode[2]
            Move '  end'                                                                                                                                                                                            to asCode[3]
            Move 'End_Procedure'                                                                                                                                                                                    to asCode[4]
            Get _SideProductRefreshMarks of ghoFuncLib (&asCode) to iChanged
            Send AssertIAreEqual 1 iChanged
            Send Assert (asCode[1] contains "still reads Found -")
            Send AssertFalse (asCode[1] contains "Found and strmark")
        End_Procedure

        // ONE ASSERTION PER ENTRY: the name-to-command map is what the engine's per-run gate and
        // the analyzer's whole-file probe both key on, so a converter missing from it silently
        // loses its look-ahead.
        { Published = True }
        Procedure SideProductGuard_CommandOfFunctionCoversEveryGuardedConverter
            String sCmd

            Get _SideProductCommandOfFunction of ghoFuncLib "ChangePosCommandToFunction" to sCmd
            Send AssertSAreEqual "pos" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeReplaceCommandToFunction" to sCmd
            Send AssertSAreEqual "replace" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeLeftCommandToFunction" to sCmd
            Send AssertSAreEqual "left" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeRightCommandToFunction" to sCmd
            Send AssertSAreEqual "right" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeMidCommandToFunction" to sCmd
            Send AssertSAreEqual "mid" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangePadCommandToFunction" to sCmd
            Send AssertSAreEqual "pad" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeInsertCommandToFunction" to sCmd
            Send AssertSAreEqual "insert" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeLengthCommandToFunction" to sCmd
            Send AssertSAreEqual "" sCmd
            Get _SideProductCommandOfFunction of ghoFuncLib "ChangeTrimCommandToFunction" to sCmd
            Send AssertSAreEqual "" sCmd
        End_Procedure

        // The measured table, as the guard states it.
        { Published = True }
        Procedure SideProductGuard_SideProductsOfMatchTheMeasuredTable
            String sProducts

            Get _SideProductsOf of ghoFuncLib "pos" to sProducts
            Send AssertSAreEqual "found|strmark|strlen" sProducts
            Get _SideProductsOf of ghoFuncLib "replace" to sProducts
            Send AssertSAreEqual "found|strmark|strlen" sProducts
            Get _SideProductsOf of ghoFuncLib "mid" to sProducts
            Send AssertSAreEqual "strmark|strlen" sProducts
            Get _SideProductsOf of ghoFuncLib "left" to sProducts
            Send AssertSAreEqual "strmark" sProducts
            Get _SideProductsOf of ghoFuncLib "pad" to sProducts
            Send AssertSAreEqual "strmark" sProducts
            Get _SideProductsOf of ghoFuncLib "insert" to sProducts
            Send AssertSAreEqual "strmark" sProducts
            Get _SideProductsOf of ghoFuncLib "right" to sProducts
            Send AssertSAreEqual "strlen" sProducts
            Get _SideProductsOf of ghoFuncLib "uppercase" to sProducts
            Send AssertSAreEqual "" sProducts
        End_Procedure

    End_Object
