//****************************************************************************
// $Module type: Test fixture
// $Module name: oPlanNoOps-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-11-12
//
// Description : Unit tests for cPlanNoOps - the files a refactoring plan ran on and left as they
//               were - and for cModAnalyzer.VerifyPlanNoOp, which keeps the next plan from
//               offering those functions for those files again.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oPlanNoOps_Tests is a cTestFixture
        Set psFunctionName to "PlanNoOps"

        // Helper: the scratch folder, with its separator.
        Function ScratchFolder Returns String
            Function_Return (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_PlanNoOps" + CS_DirSeparator)
        End_Function

        // Helper: a scratch file holding one line; its full path.
        Function ScratchFile String sName String sText Returns String
            String[] asLines
            String sFile
            Boolean bOk

            Move (rfDirectoryCreateEx(ScratchFolder(Self), False)) to bOk
            Move (ScratchFolder(Self) + sName) to sFile
            Move sText to asLines[0]
            Get rfWriteEncodedFileFromStringArray (&asLines) sFile C_NewLine False to bOk
            Send Assert bOk ("could not write " + sFile)
            Function_Return sFile
        End_Function

        /* THE RECORD AFTER A RUN: an old row stays while its file is unchanged and goes once the file has
           changed; a file the run left gets the run's functions, lowercased, and an old row for a file the
           run left again gets them joined to its own. A file the run changed gets nothing. */
        { Published = True }
        Procedure PlanNoOps_MergedRecordKeepsWhatDidNotChange
            Handle ho
            tPlanNoOp[] aOld aNew
            String[] asOldNow asFiles asBefore asAfter asFns

            Move "e:\ws\appsrc\kept.pkg" to aOld[0].sFile
            Move "S1"                    to aOld[0].sStamp
            Move "fnold"                 to aOld[0].asFns[0]
            Move "e:\ws\appsrc\gone.pkg" to aOld[1].sFile
            Move "S2"                    to aOld[1].sStamp
            Move "fnold"                 to aOld[1].asFns[0]
            Move "S1"  to asOldNow[0]                 // unchanged since: stays
            Move "S2b" to asOldNow[1]                 // changed since: goes
            Move "E:\Ws\AppSrc\Same.pkg"   to asFiles[0]
            Move "E:\Ws\AppSrc\Edited.pkg" to asFiles[1]
            Move "E:\Ws\AppSrc\Kept.pkg"   to asFiles[2]
            Move "A"  to asBefore[0]
            Move "A"  to asAfter[0]                   // the run left it
            Move "B"  to asBefore[1]
            Move "B2" to asAfter[1]                   // the run changed it
            Move "S1" to asBefore[2]
            Move "S1" to asAfter[2]                   // left again
            Move "RefactorDbGridTocDbCJGrid"    to asFns[0]
            Move "ChangeDFCreateMenuToCodeJock" to asFns[1]
            Get Create (RefClass(cPlanNoOps)) to ho
            Get MergedRecord of ho aOld asOldNow asFiles asBefore asAfter asFns to aNew
            Send Destroy of ho
            Send AssertIAreEqual 2 (SizeOfArray(aNew))
            If (SizeOfArray(aNew) = 2) Begin
                Send AssertSAreEqual "e:\ws\appsrc\kept.pkg" aNew[0].sFile
                Send AssertSAreEqual "fnold|refactordbgridtocdbcjgrid|changedfcreatemenutocodejock" (StrJoinFromArray(aNew[0].asFns, "|"))
                Send AssertSAreEqual "e:\ws\appsrc\same.pkg" aNew[1].sFile
                Send AssertSAreEqual "A" aNew[1].sStamp
                Send AssertSAreEqual "refactordbgridtocdbcjgrid|changedfcreatemenutocodejock" (StrJoinFromArray(aNew[1].asFns, "|"))
            End
        End_Procedure

        /* ON A REAL DISK, through the record file: a run that leaves one file and rewrites the other. The
           left file names the run's function; the rewritten one names none; and once the left file is
           edited by hand, its record no longer holds. */
        { Published = True }
        Procedure PlanNoOps_RecordRunAndLookUp
            Handle ho
            String[] asFiles asBefore asFns asRecFiles asRecStamps asRecFns asNoOp
            String sLeft sEdited
            Boolean bOk

            Move (rfRemoveFolderTree(ScratchFolder(Self))) to bOk
            Move (ScratchFile(Self, "Left.pkg", "Procedure Left")) to sLeft
            Move (ScratchFile(Self, "Edited.pkg", "Procedure Edited")) to sEdited
            Move sLeft   to asFiles[0]
            Move sEdited to asFiles[1]
            Move "RefactorDbGridTocDbCJGrid" to asFns[0]
            Get Create (RefClass(cPlanNoOps)) to ho
            Set psJsonFile of ho to (ScratchFolder(Self) + "PlanNoOps.json")
            Get StampsOf of ho asFiles to asBefore
            // the "run" rewrites one of the two, with other content
            Move (ScratchFile(Self, "Edited.pkg", "Procedure Edited  // and longer")) to sEdited
            Send RecordRun of ho asFiles asBefore asFns
            Send LoadRecord of ho
            Get pasRecFiles  of ho to asRecFiles
            Get pasRecStamps of ho to asRecStamps
            Get pasRecFns    of ho to asRecFns
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(asRecFiles))
            Get PlanNoOpFunctionsIn (&asRecFiles) (&asRecStamps) (&asRecFns) sLeft to asNoOp
            Send AssertSAreEqual "refactordbgridtocdbcjgrid" (StrJoinFromArray(asNoOp, "|"))
            Get PlanNoOpFunctionsIn (&asRecFiles) (&asRecStamps) (&asRecFns) sEdited to asNoOp
            Send AssertIAreEqual 0 (SizeOfArray(asNoOp))
            // edited by hand: offered again
            Move (ScratchFile(Self, "Left.pkg", "Procedure Left  // edited by hand")) to sLeft
            Get PlanNoOpFunctionsIn (&asRecFiles) (&asRecStamps) (&asRecFns) sLeft to asNoOp
            Send AssertIAreEqual 0 (SizeOfArray(asNoOp))
            Move (rfRemoveFolderTree(ScratchFolder(Self))) to bOk
        End_Procedure

        /* THE ROW: a function recorded for the row's file loses it and drops to Explain with the reason, in
           any category; with nothing recorded the row is as it was. */
        { Published = True }
        Procedure PlanNoOps_VerifyPlanNoOpDemotesTheRow
            Handle ho
            tModAnalyzer Recipe Out
            String[] asNoOp asNone

            Move "RefactorDbGridTocDbCJGrid"       to Recipe.sRefactorFn
            Move eModSuggest                       to Recipe.eCategory
            Move "Refactors legacy DbGrid objects" to Recipe.sHint
            Move "refactordbgridtocdbcjgrid"       to asNoOp[0]
            Get Create (RefClass(cModAnalyzer)) to ho
            Get VerifyPlanNoOp of ho Recipe (&asNoOp) to Out
            Send AssertSAreEqual "" Out.sRefactorFn
            Send AssertIAreEqual eModExplain Out.eCategory
            Send Assert (Pos("did not change", Out.sHint) > 0) "the hint says why"
            Get VerifyPlanNoOp of ho Recipe (&asNone) to Out
            Send AssertSAreEqual "RefactorDbGridTocDbCJGrid" Out.sRefactorFn
            Send AssertIAreEqual eModSuggest Out.eCategory
            Send Destroy of ho
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

    End_Object
