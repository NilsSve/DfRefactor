//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeCodeJockReportToGrid-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-04
//
// Description : Unit tests for the ChangeCodeJockReportToGrid refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeCodeJockReportToGrid is a cTestFixture
        Set psFunctionName to "ChangeCodeJockReportToGrid"

        // The Use line - the only part that HARD-breaks, because cCJReportControl.pkg does not
        // exist in DF23+ (only OldcCJReportControl.pkg does).
        { Published = True }
        Procedure CJReportToGrid_UseLine
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use cCJReportControl.pkg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Use cCJGridControl.pkg' sLine
        End_Procedure

        // A subclass keeps ITS name; only the base class is rewritten.
        { Published = True }
        Procedure CJReportToGrid_OnlyTheBaseClassChanges
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Class cMyReportGrid is a cCJReportControl' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Class cMyReportGrid is a cCJGridControl' sLine
        End_Procedure

        { Published = True }
        Procedure CJReportToGrid_ConstantsConvert
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set piTheme to xtpReportThemeNone' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Set piTheme to xtpGridThemeNone' sLine
        End_Procedure

        /* EXCEPTION 1, and the one that would otherwise compile and be WRONG. cCJReportColumn maps
           to cCJGridColumnXTP, not cCJGridColumn - the latter exists in cCJGridColumn.pkg as a
           SUBCLASS of cCJGridColumnXTP, so the obvious substitution binds silently to a different
           class. DataFlex's own declaration says why: "renamed because there already is a
           cCJGridColumn in cCJGridColumn.pkg". */
        { Published = True }
        Procedure CJReportToGrid_ColumnGetsTheXTPName
            String sName
            Get CodeJockGridNameFor of ghoFuncLib "cCJReportColumn" to sName
            Send AssertSAreEqual "cCJGridColumnXTP" sName
            // and the neighbours around it still take the plain rule
            Get CodeJockGridNameFor of ghoFuncLib "cCJReportColumns" to sName
            Send AssertSAreEqual "cCJGridColumns" sName
            Get CodeJockGridNameFor of ghoFuncLib "cCJReportColumnOrder" to sName
            Send AssertSAreEqual "cCJGridColumnOrder" sName
        End_Procedure

        /* EXCEPTION 2: the word appears TWICE and BOTH change. Replacing only the leading one
           yields xtpGridElementRectReportArea, which does not exist. Its siblings, whose second
           word is not "Report", must NOT get a second substitution. */
        { Published = True }
        Procedure CJReportToGrid_ElementRectAreaBothWords
            String sName
            Get CodeJockGridNameFor of ghoFuncLib "xtpReportElementRectReportArea" to sName
            Send AssertSAreEqual "xtpGridElementRectGridArea" sName
            Get CodeJockGridNameFor of ghoFuncLib "xtpReportElementRectHeaderArea" to sName
            Send AssertSAreEqual "xtpGridElementRectHeaderArea" sName
        End_Procedure

        /* THE NEGATIVE THAT MATTERS MOST. ComReport* are DataFlex/Crystal Reports COM properties -
           unchanged from 20.1 to 26.0, with no ComGrid* counterpart anywhere. Renaming one would
           turn working code into a call on a property that does not exist. Same for DataFlex's own
           report classes and for ordinary application identifiers that happen to contain the word. */
        { Published = True }
        Procedure CJReportToGrid_NonCodeJockReportNamesUntouched
            String sName

            Get CodeJockGridNameFor of ghoFuncLib "ComReportTitle" to sName
            Send AssertSAreEqual "" sName
            Get CodeJockGridNameFor of ghoFuncLib "ComReportSource" to sName
            Send AssertSAreEqual "" sName
            Get CodeJockGridNameFor of ghoFuncLib "cBasicReport" to sName
            Send AssertSAreEqual "" sName
            Get CodeJockGridNameFor of ghoFuncLib "cWinReport2" to sName
            Send AssertSAreEqual "" sName
            Get CodeJockGridNameFor of ghoFuncLib "psReportName" to sName
            Send AssertSAreEqual "" sName
            Get CodeJockGridNameFor of ghoFuncLib "CrystalReport" to sName
            Send AssertSAreEqual "" sName
        End_Procedure

        // A whole line of them: the CodeJock name converts, the Crystal Reports property does not.
        { Published = True }
        Procedure CJReportToGrid_MixedLineConvertsOnlyCodeJock
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set ComReportTitle of hoRpt to xtpReportThemeNone' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Set ComReportTitle of hoRpt to xtpGridThemeNone' sLine
        End_Procedure

        // The interface (cCJI...) and dispatch (cCJ_D...) families take the same rule.
        { Published = True }
        Procedure CJReportToGrid_InterfaceAndDispatchFamilies
            String sName
            Get CodeJockGridNameFor of ghoFuncLib "cCJIReportRecordItem" to sName
            Send AssertSAreEqual "cCJIGridRecordItem" sName
            Get CodeJockGridNameFor of ghoFuncLib "cCJ_DReportControlEvents" to sName
            Send AssertSAreEqual "cCJ_DGridControlEvents" sName
            Get CodeJockGridNameFor of ghoFuncLib "XTPReportBorderStyle" to sName
            Send AssertSAreEqual "XTPGridBorderStyle" sName
        End_Procedure

        // Nothing to do on an ordinary line - and no false claim of a change.
        { Published = True }
        Procedure CJReportToGrid_UnrelatedLineUnchanged
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set psTitle to "Report"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual '    Set psTitle to "Report"' sLine
        End_Procedure

        /* OldcCJReportControl.pkg must survive BOTH as live code and commented out.

           It exists in DF23+ and still defines every old name, so a workspace that Uses it
           compiles (with the 4536 obsolete warning). Rewriting it would break a file that was
           deliberately pointed at the compatibility package. It is safe by construction - the
           prefix test needs the token to START with cCJReport, and this one starts with "Old". */
        { Published = True }
        Procedure CJReportToGrid_OldCompatibilityPackageUntouched
            String sLine sName
            Boolean bChanged
            tTokenizer TokenizerData
            Get CodeJockGridNameFor of ghoFuncLib "OldcCJReportControl" to sName
            Send AssertSAreEqual "" sName
            Move 'Use OldcCJReportControl.pkg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual 'Use OldcCJReportControl.pkg' sLine
        End_Procedure

        // A COMMENTED Use line is invisible to the converter - the tokenizer strips comments, so
        // there are no code tokens to match. Commenting a line out neither converts nor restores it.
        { Published = True }
        Procedure CJReportToGrid_CommentedUseLineUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '//    Use cCJReportControl.pkg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual '//    Use cCJReportControl.pkg' sLine
        End_Procedure

        // IDEMPOTENT: a second run over already-converted source changes nothing, because no
        // cCJGrid* name starts with cCJReport.
        { Published = True }
        Procedure CJReportToGrid_SecondRunIsANoOp
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Object oGrid is a cCJGridControl' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeCodeJockReportToGrid of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual '    Object oGrid is a cCJGridControl' sLine
        End_Procedure

    End_Object
