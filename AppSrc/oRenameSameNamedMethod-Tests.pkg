//****************************************************************************
// $Module type: Test fixture
// $Module name: oRenameSameNamedMethod-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-04
//
// Description : Unit tests for RenameSameNamedMethod - the 4544 fix for two UNRELATED methods
//               sharing a name (LegacyApp FCOUNT: a text-returning fCount beside two count-returning
//               ones). The renamer is RenameCollidingGlobalFunction's, with the keyword-less
//               Function declaration allowed for the duration of the run.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Object oRenameSameNamedMethod is a cTestFixture
    Set psFunctionName to "RenameSameNamedMethod"

    Procedure TearDown
        Send _InitializeFuncLib of ghoFuncLib
    End_Procedure

    // The LegacyApp file, in miniature: the object-level declaration AND its expression call rename,
    // everything else stays.
    {Published = True}
    Procedure RenameSameNamed_UnitShape_DeclarationAndCall
        String[] asCode
        Integer iCount
        Move "    Object oSelList is a MyDbList"                       to asCode[0]
        Move "        Function fCount String skod Returns String"      to asCode[1]
        Move "            Function_Return sdescr"                      to asCode[2]
        Move "        End_Function"                                    to asCode[3]
        Move "        Begin_Row"                                       to asCode[4]
        Move "            Entry_Item Unit.Amount"                      to asCode[5]
        Move "            Entry_Item (fCount(Self, unit.fnk))"        to asCode[6]
        Move "        End_Row"                                         to asCode[7]
        Move "    End_Object"                                          to asCode[8]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "fCount|fCountText" to iCount
        Send Assert (iCount = 2)
        Send AssertSAreEqual "        Function fCountText String skod Returns String" asCode[1]
        Send AssertSAreEqual "            Entry_Item Unit.Amount"                     asCode[5]
        Send AssertSAreEqual "            Entry_Item (fCountText(Self, unit.fnk))"   asCode[6]
    End_Procedure

    // Of-less Get renames; the OF-form is another object's method and never does.
    {Published = True}
    Procedure RenameSameNamed_OflessGetRenamed_OfFormUntouched
        String[] asCode
        Integer iCount
        Move "Function fCount String skod Returns String"   to asCode[0]
        Move "End_Function"                                 to asCode[1]
        Move "    Get fCount sKod to sText"                 to asCode[2]
        Move "    Get fCount of oOther sKod to sText"       to asCode[3]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "fCount|fCountText" to iCount
        Send Assert (iCount = 2)
        Send AssertSAreEqual "    Get fCountText sKod to sText"           asCode[2]
        Send AssertSAreEqual "    Get fCount of oOther sKod to sText"     asCode[3]
    End_Procedure

    // OldName alone appends Text; a literal or comment never renames; a longer name is not the name.
    {Published = True}
    Procedure RenameSameNamed_DefaultSuffix_MaskedAndBounded
        String[] asCode
        Integer iCount
        Move "Function fCount String skod Returns String"          to asCode[0]
        Move '    Move "fCount(Self, x)" to sText // fCount'        to asCode[1]
        Move "    Move (fCountOld(Self, x)) to sText"               to asCode[2]
        Move "End_Function"                                        to asCode[3]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "fCount" to iCount
        Send Assert (iCount = 1)
        Send AssertSAreEqual "Function fCountText String skod Returns String"     asCode[0]
        Send AssertSAreEqual '    Move "fCount(Self, x)" to sText // fCount'      asCode[1]
        Send AssertSAreEqual "    Move (fCountOld(Self, x)) to sText"             asCode[2]
    End_Procedure

    // The one-shot is DOWN again afterwards: the global renamer still refuses a method declaration.
    {Published = True}
    Procedure RenameSameNamed_OneShotCleared_GlobalRenamerStillRefusesMethods
        String[] asCode asCode2
        Integer iCount
        Boolean bFlag
        Move "Function fCount String skod Returns String" to asCode[0]
        Move "End_Function"                               to asCode[1]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "fCount|fCountText" to iCount
        Send Assert (iCount = 1)
        Get pbRenameMethodDecl of ghoFuncLib to bFlag
        Send AssertFalse bFlag
        Move "Function Split String sText Returns String" to asCode2[0]
        Move "End_Function"                               to asCode2[1]
        Get RenameCollidingGlobalFunction of ghoFuncLib (&asCode2) "Split" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual "Function Split String sText Returns String" asCode2[0]
    End_Procedure

    // Blank parameter: nothing changes, nothing is guessed.
    {Published = True}
    Procedure RenameSameNamed_BlankParameter_DoesNothing
        String[] asCode
        Integer iCount
        Move "Function fCount String skod Returns String" to asCode[0]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "" to iCount
        Send Assert (iCount = 0)
        Send AssertSAreEqual "Function fCount String skod Returns String" asCode[0]
    End_Procedure

    // The per-run tally the board's outcome dialog reports.
    {Published = True}
    Procedure RenameSameNamed_PerRunTally
        String[] asCode
        Integer iCount iTally
        Send _InitializeFuncLib of ghoFuncLib
        Move "Function fCount String skod Returns String" to asCode[0]
        Move "    Move (fCount(Self, x)) to s"            to asCode[1]
        Move "End_Function"                               to asCode[2]
        Get RenameSameNamedMethod of ghoFuncLib (&asCode) "fCount|fCountText" to iCount
        Get piRenamedMethodCount of ghoFuncLib to iTally
        Send Assert (iTally = 2)
    End_Procedure
End_Object
