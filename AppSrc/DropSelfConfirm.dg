// DropSelfConfirm.dg
//
// The Drop Self confirmation - "replace 'oBar(Self)' with 'oBar'?" - asked once per
// candidate, with two options the user can carry to the next one.
//
// WHAT IT REPLACES. This one question was reaching into SciControlLib for
// Tools\MessageBox2.dg: 1,133 lines, which in turn pulled Monitor.pkg (155),
// dtFunc.pkg (81) and MessageBoxLanguage.pkg (43). Fourteen hundred lines of a
// general-purpose message-box framework - multi-monitor placement, per-section fonts,
// mini-icons, timeouts, translated button labels, a struct-driven button table - for a
// Yes/No/Cancel with two checkboxes.
//
// None of that generality was used. DFRefactor asked for exactly one shape, so that
// shape is what this file is.
//
// THE RETURN VALUE is unchanged, because the caller decodes it bit by bit and the
// engine's Drop Self loop is built around it: MBR_Yes / MBR_No / MBR_Cancel (DataFlex's
// own, from msgbox.pkg) OR-ed with CI_DropSelfPadded and CI_DropSelfRemember. Those two
// bits kept their original values from MessageBox2's MBR_CHECKED / MBR_CHECKED2 so that
// nothing downstream had to change or be re-tested.

Use Windows.pkg
Use dfLine.pkg
Use cFTModalPanel.pkg
Use cFTCheckBoxCaption.pkg      // a check box's caption the FT colours reach

// The two checkbox bits, at their original values. MessageBox2 called them MBR_CHECKED
// and MBR_CHECKED2 - generic names for a generic dialog. Here they can say what they
// mean, because there is only one dialog and only these two options.
#IFNDEF CI_DropSelfPadded
Define CI_DropSelfPadded   for |CI$01000000    // was MBR_CHECKED
Define CI_DropSelfRemember for |CI$02000000    // was MBR_CHECKED2
#ENDIF

Object oDropSelfConfirm_dg is a cFTModalPanel
    Set Size to 108 268
    Set Label to "Change into suggestion?"
    Set Locate_Mode to CENTER_ON_PARENT

    // What the caller gets back, assembled on the way out. A property rather than a
    // return value because a ModalPanel's buttons cannot return one - Popup does.
    Property Integer piAnswer 0

    Object oQuestion_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 26 250
        Set Location to 8 9
        Set Label to ""
    End_Object

    /* THE TWO OPTIONS: a check box, and its caption beside it (cFTCheckBoxCaption). The panel gives its children
       the FT colours, and a check box's own caption stays in the Windows theme's colour - unreadable on the dark
       ground, as CmdLineIniFileExporterFT's were. A click on a caption ticks its box. */
    Object oPadded_cb is a CheckBox
        Set Size to 10 10
        Set Location to 42 11
        Set Label to ""
    End_Object

    Object oPadded_tb is a cFTCheckBoxCaption
        Set Location to 43 22
        Set Label to "Keep same width padded with spaces"
        Set phoCheckBox to (oPadded_cb(Self))
    End_Object

    Object oRemember_cb is a CheckBox
        Set Size to 10 10
        Set Location to 56 11
        Set Label to ""
    End_Object

    Object oRemember_tb is a cFTCheckBoxCaption
        Set Location to 57 22
        Set Label to "Remember the choice for this object"
        Set phoCheckBox to (oRemember_cb(Self))
    End_Object

    Object oLine is a LineControl
        Set Size to 2 252
        Set Location to 72 8
    End_Object

    /* Yes / No / Cancel, in Studio's order and with No as the default - the same
       MB_DEFBUTTON2 the old call passed. Defaulting to No matters: this dialog can be
       asked many times in one run, and a held-down Enter should not rewrite a file. */
    Object oYes_bn is a Button
        Set Label to "&Yes"
        Set Location to 82 106
        Procedure OnClick
            Send Answer MBR_Yes
        End_Procedure
    End_Object

    Object oNo_bn is a Button
        Set Label to "&No"
        Set Location to 82 160
        Set Default_State to True
        Procedure OnClick
            Send Answer MBR_No
        End_Procedure
    End_Object

    Object oCancel_bn is a Button
        Set Label to "Cancel"
        Set Location to 82 214
        Procedure OnClick
            Send Answer MBR_Cancel
        End_Procedure
    End_Object

    // Fold the two checkbox states into the answer and close. One place builds the
    // return value, so the three buttons cannot disagree about its shape.
    Procedure Answer Integer iButton
        Integer iRetVal
        Move iButton to iRetVal
        If (Checked_State(oPadded_cb(Self))) ;
            Move (iRetVal ior CI_DropSelfPadded) to iRetVal
        If (Checked_State(oRemember_cb(Self))) ;
            Move (iRetVal ior CI_DropSelfRemember) to iRetVal
        Set piAnswer to iRetVal
        Send Close_Panel
    End_Procedure

    // The title-bar icon, set the way ScintillaFind / Replace / Goto set theirs - on
    // Page rather than in the object body, because the panel needs its window before an
    // icon can be attached to it.
    Procedure Page Integer iPageObject
        Forward Send Page iPageObject
        Set Icon to "Default.ico"
    End_Procedure

    // Escape means Cancel, not "No" - stopping the run is a different decision from
    // declining this one line. Its own parameterless procedure because On_Key cannot
    // carry an argument.
    Procedure AnswerCancel
        Send Answer MBR_Cancel
    End_Procedure

    On_Key kCancel Send AnswerCancel

    /* The entry point. Fills the dialog, shows it, and hands back the encoded answer.
       Written as a function so the call site reads as one question and one answer
       rather than a set-up, a popup and a read. */
    Function Ask String sQuestion Boolean bPadded Boolean bRemember Returns Integer
        Set Label         of oQuestion_tb to sQuestion
        Set Checked_State of oPadded_cb   to bPadded
        Set Checked_State of oRemember_cb to bRemember
        Set piAnswer to MBR_Cancel      // closed by the window frame = Cancel
        Send Popup
        Function_Return (piAnswer(Self))
    End_Function

End_Object
