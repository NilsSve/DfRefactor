//****************************************************************************
// $Module type: Test fixture
// $Module name: oRefactorWinReportTocWinReport2-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the RefactorWinReportTocWinReport2 refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRefactorWinReportTocWinReport2 is a cTestFixture
        Set psFunctionName to "RefactorWinReportTocWinReport2"

        // The classic WinPrint-1 shape: 'Object ... is a WinReport' -> cWinReport2, the report body
        // (Set psReportFile, forwarded events) passes through untouched.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_BasicObject
            String[] asCode
            Integer iCount
            Move '    Object oCustomer_WinPrint is a WinReport' to asCode[0]
            Move '        Set Report_Caption to "Customers"'    to asCode[1]
            Move '        Function Report_Data Returns Integer' to asCode[2]
            Move '        End_Function'                         to asCode[3]
            Move '    End_Object'                               to asCode[4]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Object oCustomer_WinPrint is a cWinReport2' asCode[0]
            Send AssertSAreEqual '        Set Report_Caption to "Customers"' asCode[1]
            Send AssertSAreEqual '    End_Object' asCode[4]
        End_Procedure

        // A user SUBCLASS definition ('Class cMyReport is a WinReport') has its BASE modernised; the
        // subclass name itself is never touched.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_SubclassBase
            String[] asCode
            Integer iCount
            Move 'Class cMyReport is a WinReport'         to asCode[0]
            Move '    Procedure Construct_Object'         to asCode[1]
            Move '        Forward Send Construct_Object'  to asCode[2]
            Move '    End_Procedure'                      to asCode[3]
            Move 'End_Class'                              to asCode[4]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cWinReport2.pkg' asCode[0]
            Send AssertSAreEqual 'Class cMyReport is a cWinReport2' asCode[1]
        End_Procedure

        /* A REAL PACKAGE WITH NO Use AT ALL, as Myreport.pkg is: it took WinReport from whoever Used it first. A class needs
           its base where it stands, so the Use goes in, below the header comment and above the class. An OBJECT in such a
           file stays a fragment: that test is RefactorWinReportTocWinReport2_Idempotent. */
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_AClassWithNoUseGetsItsBase
            String[] asCode
            Integer iCount
            Move '// A tabstop enhancement of the report class'  to asCode[0]
            Move ''                                              to asCode[1]
            Move 'Class Myreport is a WinReport'                 to asCode[2]
            Move 'End_Class'                                     to asCode[3]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '// A tabstop enhancement of the report class' asCode[0]
            Send AssertSAreEqual 'Use cWinReport2.pkg' asCode[2]
            Send AssertSAreEqual 'Class Myreport is a cWinReport2' asCode[3]
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            // And once is enough.
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // Its old Use is swapped, not added to.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_AClassWithTheOldUseSwapsIt
            String[] asCode
            Integer iCount
            Move 'Use Dfwinrpt.pkg'               to asCode[0]
            Move 'Class Myreport is a WinReport'  to asCode[1]
            Move 'End_Class'                      to asCode[2]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cWinReport2.pkg' asCode[0]
            Send AssertSAreEqual 'Class Myreport is a cWinReport2' asCode[1]
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
        End_Procedure

        // The explicit parameter converts objects of a SUBCLASS ('cMyReport,cWinReport2').
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_SubclassObjectsViaParam
            String[] asCode
            Integer iCount
            Move '    Object oRpt is a cMyReport'  to asCode[0]
            Move '    End_Object'                  to asCode[1]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "cMyReport,cWinReport2" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Object oRpt is a cWinReport2' asCode[0]
        End_Procedure

        // Whole-token: an already-modern cWinReport2 object is untouched, and an object NAME containing
        // 'WinReport' (oWinReportView) is never swapped - only the class after 'is a'.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_WholeTokenOnly
            String[] asCode
            Integer iCount
            Move 'Object oWinReportView is a cWinReport2' to asCode[0]
            Move 'End_Object'                             to asCode[1]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oWinReportView is a cWinReport2' asCode[0]
        End_Procedure

        // The REAL WinPrint-1 error-wall shape (generalized from a live workspace 2026-07-10): the
        // .rv relied on the OLD Dfallrpt.pkg to pull WinPrint 1 in (no Use Dfwinrpt anywhere), so on
        // a modern target the class + every DFWrite*/WinPrintId line is a hard error. The fix is
        // exactly this converter: class swap + 'Use cWinReport2.pkg' appended after the leading Use
        // block - the report body (DFSetMetrics to WinPrintId, DFBeginHeader, DFWriteLn) passes
        // through verbatim, because WinPrint 2 re-provides all of it.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_RealErrorWallShape
            String[] asCode
            Integer iCount

            Move 'Use MyFuncs.pkg'                                             to asCode[0]
            Move 'Use DFAllRpt.pkg'                                            to asCode[1]
            Move 'Use CUSTOMER.DD'                                             to asCode[2]
            Move 'Object oRptCustomer is a WinReport'                          to asCode[3]
            Move '    Send DFSetMetrics to WinPrintId "CM" // Must Set Before Forward!' to asCode[4]
            Move '    DFBeginHeader 0'                                         to asCode[5]
            Move '    DFWriteLn "Header" FONT_DEFAULT 10'                      to asCode[6]
            Move '    DFEndHeader'                                             to asCode[7]
            Move 'End_Object'                                                  to asCode[8]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use CUSTOMER.DD'                    asCode[2]
            Send AssertSAreEqual 'Use cWinReport2.pkg'                asCode[3]
            Send AssertSAreEqual 'Object oRptCustomer is a cWinReport2' asCode[4]
            Send AssertSAreEqual '    Send DFSetMetrics to WinPrintId "CM" // Must Set Before Forward!' asCode[5]
            Send AssertSAreEqual '    DFBeginHeader 0'                asCode[6]
            Send AssertSAreEqual 'End_Object'                         asCode[9]
        End_Procedure

        // Real conversion in a file that has a leading Use block but no report package: 'Use cWinReport2.pkg'
        // is APPENDED right after the leading Use block (never a lone Use elsewhere).
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_AppendsUsePackage
            String[] asCode
            Integer iCount
            Move 'Use Windows.pkg'                to asCode[0]
            Move 'Object oRpt is a WinReport'     to asCode[1]
            Move 'End_Object'                     to asCode[2]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use Windows.pkg'                asCode[0]
            Send AssertSAreEqual 'Use cWinReport2.pkg'            asCode[1]
            Send AssertSAreEqual 'Object oRpt is a cWinReport2'   asCode[2]
        End_Procedure

        // The class swap must ALSO retire the obsolete 'Use Dfwinrpt.pkg' (warning 4536) in favour of the
        // new report package: WinReport lives in the obsolete Dfwinrpt.pkg, cWinReport2 in its own
        // cWinReport2.pkg (verified against the DF26 Pkg). Same _EnsureUsePackage the Edit converter uses.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_SwapsUsePackage
            String[] asCode
            Integer iCount
            Move 'Use Dfwinrpt.pkg'                to asCode[0]
            Move 'Object oRpt is a WinReport'      to asCode[1]
            Move 'End_Object'                      to asCode[2]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cWinReport2.pkg'           asCode[0]
            Send AssertSAreEqual 'Object oRpt is a cWinReport2'  asCode[1]
        End_Procedure

        // When BOTH the obsolete package and the target are already Used, the obsolete 'Use Dfwinrpt.pkg'
        // is dropped (the target already covers the class).
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_DropsUsePackageWhenTargetPresent
            String[] asCode
            Integer iCount
            Move 'Use Dfwinrpt.pkg'                to asCode[0]
            Move 'Use cWinReport2.pkg'             to asCode[1]
            Move 'Object oRpt is a WinReport'      to asCode[2]
            Move 'End_Object'                      to asCode[3]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Use cWinReport2.pkg'           asCode[0]
            Send AssertSAreEqual 'Object oRpt is a cWinReport2'  asCode[1]
        End_Procedure

        // Idempotent: a converted declaration no longer matches on re-run, and with no leading Use block the
        // first pass never sprouts a lone 'Use cWinReport2.pkg'.
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_Idempotent
            String[] asCode
            Integer iCount
            Move 'Object oRpt is a WinReport'   to asCode[0]
            Move 'End_Object'                   to asCode[1]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Object oRpt is a cWinReport2' asCode[0]
            Send AssertIAreEqual 2 (SizeOfArray(asCode))
            // Second run: nothing left to convert, array unchanged.
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oRpt is a cWinReport2' asCode[0]
        End_Procedure

        // Either article: a vowel-initial subclass arrives naturally as 'is an' ('Object oRep is
        // an Myreport' - the WinServ 'is an edit' lesson, 2026-07-17). Converts via the
        // class-names parameter; the article normalises to 'is a' (targets are consonant-initial).
        { Published = True }
        Procedure RefactorWinReportTocWinReport2_IsAnArticle
            String[] asCode
            Integer iCount
            Move '    Object oRep is an Myreport' to asCode[0]
            Move '    End_Object'                 to asCode[1]
            Get RefactorWinReportTocWinReport2 of ghoFuncLib (&asCode) "Myreport,cWinReport2" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Object oRep is a cWinReport2' asCode[0]
        End_Procedure

    End_Object
