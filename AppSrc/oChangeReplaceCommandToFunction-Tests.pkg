//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeReplaceCommandToFunction-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-29
//
// Description : Unit tests for ChangeReplaceCommandToFunction - the legacy Replace COMMAND
//               (first occurrence, in place) to the Replace() function. Born on a real 19.1
//               workspace line, 'if (sSep = ".") replace "," in sQty with "."', which DS 9041
//               had routed at ChangeInToContains via the command's own 'in' keyword.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeReplaceCommandToFunction is a cTestFixture
        Set psFunctionName to "ChangeReplaceCommandToFunction"

        { Published = True }
        Procedure ReplaceCommand_BasicConvert
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Replace "," in sQty with "."' to sLine
            Move 'Move (Replace(",", sQty, ".")) to sQty' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The line that started this: a one-line If guard rides along untouched.
        { Published = True }
        Procedure ReplaceCommand_IfPrefixRidesAlong
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        if (sSep = ".") replace "," in sQty with "."' to sLine
            Move '        if (sSep = ".") Move (Replace(",", sQty, ".")) to sQty' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        { Published = True }
        Procedure ReplaceCommand_TrailingCommentSurvives
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Replace "a" in sX with "b"   // decimal separator' to sLine
            Move 'Move (Replace("a", sX, "b")) to sX   // decimal separator' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // An array element is a legal in-place target and must survive on BOTH sides.
        { Published = True }
        Procedure ReplaceCommand_ArrayElementTarget
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Replace "," in saVals[i] with "."' to sLine
            Move 'Move (Replace(",", saVals[i], ".")) to saVals[i]' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Positive controls for restraint: the MODERN forms are never touched.
        { Published = True }
        Procedure ReplaceCommand_ModernFunctionsUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move (Replace(",", sQty, ".")) to sQty' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Move 'Move (Replaces(",", sQty, ".")) to sQty' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // Inside a string literal there is no command; and prose in a comment is not code.
        { Published = True }
        Procedure ReplaceCommand_LiteralAndCommentUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move "replace , in x with y" to sDoc' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Move '// replace "," in sQty with "."' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // THE SECOND STEP OF THE DOUBLE-IN LINE (2026-09-13): once ChangeInToContains has turned the
        // legacy condition into '(temp contains ",")', the ')' is there and this converter finishes
        // the line - upper-case IN / WITH included.
        { Published = True }
        Procedure ReplaceCommand_ConvertedConditionPrefixRidesAlong
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                    If (temp contains ",") Replace "," IN temp WITH "."' to sLine
            Move '                    If (temp contains ",") Move (Replace(",", temp, ".")) to temp' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ...and BEFORE that step the command sits behind a legacy condition, not a ')': not command
        // position, so this converter leaves it - the In converter goes first, by design.
        { Published = True }
        Procedure ReplaceCommand_LegacyConditionPrefixIsNotCommandPosition
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                    If "," IN temp Replace "," IN temp WITH "."' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReplaceCommandToFunction of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

    End_Object
