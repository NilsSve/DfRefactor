//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeObjectFunctionCallToGet-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the ChangeObjectFunctionCallToGet refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeObjectFunctionCallToGet is a cTestFixture
        Set psFunctionName to "ChangeObjectFunctionCallToGet"

        // Clean whole-'Move' shape with a simple argument: the in-file method FormatValue (no Global) is
        // rewritten to the Get command; the leading indent is preserved, the declaration lines are untouched.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FixesSimpleArg
            String[] asCode
            Integer iCount
            Move 'Function FormatValue String sRaw Returns String'  to asCode[0]
            Move '    Function_Return sRaw'                         to asCode[1]
            Move 'End_Function'                                     to asCode[2]
            Move '        Move (FormatValue(Self, sRaw)) to sOut'   to asCode[3]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 4)
            Send AssertSAreEqual 'Function FormatValue String sRaw Returns String' asCode[0]
            Send AssertSAreEqual '        Get FormatValue sRaw to sOut'            asCode[3]
        End_Procedure

        // A Move into an indicator stays as it is (2026-10-31): 'Get Row_Count to Found' is error 4345, an
        // indicator takes no Get - no rewrite and no //TODO line; the same call into a variable still converts.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_NoGetIntoAnIndicator
            String[] asCode
            Integer iCount
            Move 'Function Row_Count Returns Integer'   to asCode[0]
            Move 'End_Function'                         to asCode[1]
            Move '    Move (Row_Count(Self)) to Found'  to asCode[2]
            Move '    Move (Row_Count(Self)) to iRows'  to asCode[3]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 4) "no //TODO line for the indicator"
            Send AssertSAreEqual '    Move (Row_Count(Self)) to Found' asCode[2]
            Send AssertSAreEqual '    Get Row_Count to iRows'          asCode[3]
        End_Procedure

        // No-argument method call: (RowCount(Self)) -> Get RowCount to iN.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FixesNoArg
            String[] asCode
            Integer iCount
            Move 'Function RowCount Returns Integer'    to asCode[0]
            Move 'End_Function'                         to asCode[1]
            Move '    Move (RowCount(Self)) to iN'      to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Get RowCount to iN' asCode[2]
        End_Procedure

        // Several simple args keep their order, comma-separated -> space-separated.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FixesMultipleSimpleArgs
            String[] asCode
            Integer iCount
            Move 'Function Combine Returns String'          to asCode[0]
            Move 'End_Function'                             to asCode[1]
            Move '    Move (Combine(Self, iA, sB)) to sR'   to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Get Combine iA sB to sR' asCode[2]
        End_Procedure

        // A GLOBAL function (declared with Global) whose first argument is Self is LEFT ALONE, while a
        // sibling local method IS rewritten - the Global keyword is the discriminator.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_LeavesGlobalCall
            String[] asCode
            Integer iCount
            Move 'Function DoThing Global Integer hoObj Returns Integer' to asCode[0]
            Move 'End_Function'                                         to asCode[1]
            Move 'Function LocalCalc Returns Integer'                   to asCode[2]
            Move 'End_Function'                                         to asCode[3]
            Move '    Move (DoThing(Self)) to iA'                       to asCode[4]
            Move '    Move (LocalCalc(Self)) to iB'                     to asCode[5]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Move (DoThing(Self)) to iA' asCode[4]
            Send AssertSAreEqual '    Get LocalCalc to iB'        asCode[5]
        End_Procedure

        // A call NESTED in a larger expression is not the clean 'Move (..) to' shape -> flagged (a //TODO
        // above), line left verbatim, nothing counted.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FlagsNested
            String[] asCode
            Integer iCount
            Move 'Function IsReady Returns Boolean'          to asCode[0]
            Move 'End_Function'                              to asCode[1]
            Move '    If ((IsReady(Self)) = True) Begin'     to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 4)
            Send Assert (Pos("//TODO DF26 (Get form)", asCode[2]) > 0)
            Send AssertSAreEqual '    If ((IsReady(Self)) = True) Begin' asCode[3]
        End_Procedure

        // A complex (nested-call) argument is not safe to space-flatten -> flagged, not rewritten.
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FlagsComplexArg
            String[] asCode
            Integer iCount
            Move 'Function Calc Returns Integer'               to asCode[0]
            Move 'End_Function'                                to asCode[1]
            Move '    Move (Calc(Self, Foo(iX))) to iR'        to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send Assert (Pos("//TODO DF26 (Get form)", asCode[2]) > 0)
            Send AssertSAreEqual '    Move (Calc(Self, Foo(iX))) to iR' asCode[3]
        End_Procedure

        // IDEMPOTENCY: re-running over a flagged line drops the stale //TODO and re-emits one - exactly one
        // survives, so the flags never stack (the trap ChangeDfTimerTocTimer hit).
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FlagNotStacked
            String[] asCode
            Integer iCount1 iCount2 i iTodos

            Move 'Function IsReady Returns Boolean'          to asCode[0]
            Move 'End_Function'                              to asCode[1]
            Move '    If ((IsReady(Self)) = True) Begin'     to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount1
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount2
            Send Assert (iCount1 = 0)
            Send Assert (iCount2 = 0)
            Move 0 to iTodos
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Pos("//TODO DF26 (Get form)", asCode[i]) > 0) ;
                    Increment iTodos
            Loop
            Send Assert (iTodos = 1)
        End_Procedure

        // A quoted-string argument is a simple Get argument (bare, even with a space inside the quotes).
        { Published = True }
        Procedure ChangeObjectFunctionCallToGet_FixesStringArg
            String[] asCode
            Integer iCount
            Move 'Function Lookup Returns Integer'                  to asCode[0]
            Move 'End_Function'                                     to asCode[1]
            Move '    Move (Lookup(Self, "New York")) to iId'       to asCode[2]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Get Lookup "New York" to iId' asCode[2]
        End_Procedure

        /* THE PER-LINE FAST GATE STAYS (2026-08-16). The 08-15 fix made this converter 18x faster
           by skipping _ObjExprCallToGet on every line without "(self" - 97% of a real file. The
           other tests prove the REWRITES; none proves the gate is still there, and a future edit
           could drop it with every behaviour test still green, until the next 30-minute analyze.
           This pins the gate's observable effect: a file with NO "(self" anywhere but many lines
           that would otherwise be tokenised comes back untouched, and a file whose ONLY "(self"
           line is a real call still gets exactly that one rewritten. */
        {Published = True}
        Procedure OFC_PerLineGate_OnlySelfLinesAreVisited
            String[] asCode
            Integer iChanged i

            Send ClearFuncLibProperties of ghoFuncLib
            // A local (non-Global) function so the call below is a candidate.
            Move "Function MyVal Returns Integer"      to asCode[0]
            Move "    Function_Return 1"                to asCode[1]
            Move "End_Function"                         to asCode[2]
            // 200 lines with parentheses and a local-function NAME but no "(self" - the very
            // shape _ObjExprCallToGet would otherwise be asked about, and the gate must skip.
            // (Careful: "Value(Self)" would NOT do - it contains "(Self". These do not.)
            For i from 3 to 202
                Move ("    Move (MyVal(hoOther) + " + String(i) + ") to iX") to asCode[i]
            Loop
            // ...and ONE genuine object-function-in-expression call.
            Move "    If (MyVal(Self) > 0) Begin" to asCode[203]
            Move "    End"                         to asCode[204]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iChanged
            // The 200 gate-excluded lines come through byte-identical, wherever they landed after
            // the one rewrite above them shifted nothing (the real call is BELOW them).
            Send AssertSAreEqual "    Move (MyVal(hoOther) + 100) to iX" asCode[100]
            Send AssertSAreEqual "    Move (MyVal(hoOther) + 202) to iX" asCode[202]
            // The one real call was seen and acted on (rewritten or flagged - either is "acted on").
            Send Assert (asCode[203] <> "    If (MyVal(Self) > 0) Begin" or SizeOfArray(asCode) > 205) ;
                "the single (self line was not visited"
        End_Procedure

    End_Object
