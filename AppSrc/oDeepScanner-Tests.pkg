//****************************************************************************
// $Module type: Test fixture
// $Module name: oDeepScanner-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for cDeepScanner - the source-driven obsolete-symbol scanner. The
//               detection rules are CONTEXT-AWARE (that is the whole point: a naive text search
//               drowns in false positives), so every rule kind is tested both ways: the legacy
//               form HITS, the modern look-alike does NOT.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
    Object oDeepScanner is a cTestFixture
        Set psFunctionName to "DeepScanObsoleteSymbols"

        // A scratch path for the rules-persistence tests (never the real DeepScanRules.json).
        // The DFUnit runner is built on cApplication, so the workspace path comes off phoWorkspace.
        Function psUnitTestScratchDeepScanPath Returns String
            String sDataPath
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Function_Return (sDataPath + "_DeepScanRulesTest.tmp")
        End_Function

        // Helper: scan a snippet against the default catalog.
        Function ScanSnippet String[] asCode Returns tDeepScanHit[]
            Handle ho
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Send Destroy of ho
            Function_Return aHits
        End_Function

        // Helper: only the hits routed to ONE refactor function (a snippet line can trip
        // other rules too - e.g. an eq-comparison in a guard line is a legit second hit).
        Function _HitsForFn tDeepScanHit[] aHits String sFn Returns tDeepScanHit[]
            tDeepScanHit[] aOut
            Integer i
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sRefactorFn = sFn) ;
                    Move aHits[i] to aOut[SizeOfArray(aOut)]
            Loop
            Function_Return aOut
        End_Function

        /* A RETIRED rule stays retired. Retiring is bEnabled False in the seed (never a delete -
           iDSNumber is an identity), but LoadDeepScanRules merges the user's saved toggles over the
           fresh seed, and every existing file has the rule ENABLED from before it was retired. That
           merge used to copy it back, so a retirement only ever reached a fresh install: DS 9034
           (FindErr) was retired 2026-07-29 and returned on Nils's very next run, still 425 rows.

           Pins the rule for whatever is retired at the time: nothing the seed ships disabled may be
           enabled by an old file. */
        { Published = True }
        Procedure DeepScan_SeedDisabledRuleIsNotReEnabledByOldFile
            Handle ho
            tDeepScanRule[] aSeed
            Integer i iLast iDisabled

            Move 0 to iDisabled
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aSeed
            Send Destroy of ho
            Move (SizeOfArray(aSeed) - 1) to iLast
            For i from 0 to iLast
                If (aSeed[i].bEnabled = False) ;
                    Increment iDisabled
            Loop
            // At least one rule is retired today (DS 9034 FindErr). If this ever reaches 0 the
            // guard below stops proving anything - re-point it at whatever is retired then.
            Send Assert (iDisabled > 0) "No seed-disabled rule to test the retire path with"
        End_Procedure

        /* The #REPLACE rule flags only the CONSTANT-like use - the one 'Define name for value'
           can actually express.

           It used to match every #REPLACE line and lead with the Define rewrite. Nils's live
           counter-example settles why that is wrong: '#REPLACE End_Procedure End_Procedure_Profiler'
           substitutes a LANGUAGE KEYWORD, and Define creates a named constant - it cannot redefine
           End_Procedure. Replacing a keyword is definitionally a macro, so _IsKeyWord decides it
           exactly. This pins BOTH directions: the constant form still hits, the keyword form does
           not (which is the assertion that fails without the guard). */
        { Published = True }
        Procedure DeepScan_ReplaceFlagsConstantsNotKeywordMacros
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '#REPLACE MAX_ROWS 500'                        to asCode[0]  // constant -> hit
            Move '    #Replace CompanyName "RDC Tools"'         to asCode[1]  // indented, literal -> hit
            Move '#Replace End_Procedure End_Procedure_Profiler' to asCode[2]  // KEYWORD -> macro, clean
            Move '#REPLACE Send Send_Traced'                    to asCode[3]  // KEYWORD -> macro, clean
            Move '#REPLACE'                                     to asCode[4]  // nothing named -> clean
            Move 'Move iX to Replace'                           to asCode[5]  // not command position -> clean
            /* THE VALUE HAS TO LOOK LIKE A CONSTANT TOO. Nils found this exact line still flagged
               (MeterFunctions.pkg): SELECT is in no keyword list, so the NAME guard passed it, but
               '|!C' is a macro token - Define cannot express it. Guarding the name alone was never
               enough. The two below are the shapes that proved it. */
            Move '    #Replace SELECT |!C'                      to asCode[6]  // macro token value -> clean (INDENTED, as in the real file)
            Move '#REPLACE OldName NewName'                     to asCode[7]  // identifier value -> clean
            /* AND NOT THE LEGACY SHELL'S WORKSPACE-NAME MACRO (Nils 2026-07-30). This passes every
               guard above - no keyword, a quoted literal - and was flagged on 174 .src files in one
               DF18 workspace. Define is the wrong fix: the token feeds 'Set WorkspaceName to
               CURRENT$WORKSPACE' in a Workspace shell that RefactorWorkspaceTocApplication removes,
               commenting this line out with it. The Workspace-shell rule carries the file instead. */
            Move '#REPLACE CURRENT$WORKSPACE   "MyApp"'          to asCode[8]  // legacy shell macro -> clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "#REPLACE directive" to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
            // Auto-fix since rules v61 (Nils 2026-09-11) - measured on a real workspace, the converter
            // cleared every hit it was run over; the shapes it cannot take carry its TODO marker.
            Send Assert (aHits[0].eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeReplaceDirectiveToDefine" aHits[0].sRefactorFn
        End_Procedure

        /* v56 (2026-09-08): the value test admits a NEGATIVE number - measured convertible, and
           there are 25 of them in the DataFlex install alone. A PARENTHESISED value is deliberately
           NOT admitted although it looks like a constant: a Define resolves its value at its own
           line while the directive stays lazy text, so '(A ior B)' is error 4328 wherever A and B
           come later, and one file cannot tell. The clean lines below are the ones that still must
           NOT hit, so widening the test by one shape cannot quietly widen it further. */
        { Published = True }
        Procedure DeepScan_ReplaceTakesNegativeConstantsButNotExpressions
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '#REPLACE PE_ALLLINES -1'                             to asCode[0]  // negative -> hit
            Move '#Replace TB_GROUP (TBSTYLE_GROUP ior TBSTYLE_CHECK)' to asCode[1]  // eager Define -> clean
            Move '#REPLACE OLE_Handle Integer'                         to asCode[2]  // identifier value -> clean
            Move '#REPLACE CW_DEFAULT16 |CI$8000'                      to asCode[3]  // macro fragment -> clean
            Move '#REPLACE JustADash -'                                to asCode[4]  // a bare minus is no number -> clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "#REPLACE directive" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
        End_Procedure

        /* ToANSI / ToOEM get a SCAN-lane surface, because the compiler lane cannot locate them.

           4534 is reported wherever a command that calls ToANSI is USED, not where the call is
           written. A workspace command whose body calls it therefore raises a warning on every call
           site and none on the package containing the call - and VerifyAutoFix then correctly
           demotes all of those, since the construct genuinely is not on those lines. The file worth
           editing ends up invisible (Nils 2026-07-31: "there are several ToAnsi calls made in that
           command ... Shouldn't that file be flagged one way or the other?").

           THE ASSERTION THAT MATTERS is the negative one: Utf8ToAnsi and Utf8ToOem CONTAIN the
           tokens as substrings, so without whole-word matching this pair would flag every line that
           has already been modernised - turning the fix itself into a permanent false positive. */
        {Published = True}
        Procedure DeepScan_AnsiOemFlaggedButNotTheirModernReplacements
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move "Move (ToANSI(sName)) to sOut"        to asCode[0]   // legacy -> hit
            Move "    Move (ToOEM(sPath)) to sOem"     to asCode[1]   // legacy -> hit
            Move "Move (Utf8ToAnsi(sName)) to sOut"    to asCode[2]   // ALREADY modern -> clean
            Move "Move (Utf8ToOem(sPath)) to sOem"     to asCode[3]   // ALREADY modern -> clean
            Move "// ToANSI in a comment is not code"  to asCode[4]   // clean
            Move 'Move "ToANSI" to sLabel'             to asCode[5]   // string literal -> clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "ToANSI function" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Get _HitsForSymbol aAll "ToOEM function" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
        End_Procedure

        /* ToANSI / ToOEM stay live INSIDE a #COMMAND body; everything else still skips it.

           A macro body is skipped whole because its lines are command-shaped and carry '!' argument
           tokens no converter can rewrite - flagging them produced auto-fix rows a plan run could
           never clear. But that reasoning is about COMMAND SYNTAX, and does not extend to a rule
           matching a FUNCTION NAME whose fix is a pure rename: ToANSI(x) -> Utf8ToAnsi(x) is safe
           wherever it sits, '!1' included, because the rename carries the argument through.

           Without the exception a workspace's own output commands hide their conversion calls from
           BOTH lanes: the compiler reports 4534 at the command's call sites and never in its body,
           and the scan skipped the body (Nils 2026-07-31).

           The SECOND half of this test is the one that must not rot - a command-syntax rule inside
           the same body still has to stay quiet, or the exception has quietly become a repeal. */
        {Published = True}
        Procedure DeepScan_MacroBodyKeepsAnsiOemButStillSkipsCommandRules
            String[] asCode
            tDeepScanHit[] aAll aHits

            /* The '#' and '!' tokens are CONCATENATED, never written as literals. Both are macro
               syntax to the DataFlex compiler and it acts on them even inside a string: a bare
               "!1" here fails the build with 4337 "Too many lines", pointing at this fixture. */
            Move ("#" + "COMMAND MYWRITEPOS R")                    to asCode[0]
            Move "   Write channel gi$Ch (ToAnsi(Trim(gs$AmLabel)))" to asCode[1]  // plain arg -> hit
            Move ("   Writeln channel gi$Ch (ToAnsi(Trim(" + "!" + "1)))") to asCode[2]  // '!1' -> still a hit
            Move "   Indicator gbSomething"                          to asCode[3]  // command syntax -> quiet
            Move ("#" + "ENDCOMMAND")                                to asCode[4]
            Move "Move (ToAnsi(sX)) to sY"                           to asCode[5]  // outside -> hit
            Get ScanSnippet asCode to aAll

            Get _HitsForSymbol aAll "ToANSI function" to aHits
            Send AssertIAreEqual 3 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2) "the plain-argument call inside the macro was missed"
            Send Assert (aHits[1].iLine = 3) "the '!1' call inside the macro was missed"
            Send Assert (aHits[2].iLine = 6)

            /* REPORTED, NEVER OFFERED, INSIDE THE MACRO BODY (2026-10-04). The engine leaves every
               macro line as written (Nils 2026-09-07), so a row that still named the converter put it
               in a plan that changed nothing - "0 lines Renamed". Both calls in the body are Explain
               with no function, and the hint says why. The line OUTSIDE the macro keeps its Auto-fix
               and its converter: this is about where the line sits, not a downgrade of the rule. */
            Send Assert (aHits[0].eCategory = eModExplain) "a macro-body hit is still offered as a fix"
            Send Assert (aHits[1].eCategory = eModExplain) "a macro-body hit is still offered as a fix"
            Send AssertSAreEqual "" aHits[0].sRefactorFn
            Send AssertSAreEqual "" aHits[1].sRefactorFn
            Send Assert (aHits[0].sHint contains "never changes macro code") ("the hint must say why: " + aHits[0].sHint)
            Send Assert (aHits[2].eCategory = eModAutoFix) "the hit outside the macro lost its Auto-fix"
            Send AssertSAreEqual "UnicodeOemAnsiFunctions" aHits[2].sRefactorFn

            // The macro skip still holds for everything else: no Indicator row from inside the body.
            Get _HitsForSymbol aAll "Indicator command" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        /* THE LEGACY PROGRAM SHELL gets a scan-lane surface (Nils 2026-07-30). Until now the catalog
           said nothing about 'Object x is a Workspace': its only recipes are ERROR-shaped (4313/4345/
           4328), which need the file to have been compiled by a modern compiler, so a folder scan of
           an un-migrated workspace saw nothing at all - 201 shells, silent.

           Pins the shape the converter acts on and the two look-alikes it must not claim: the SUBCLASS
           (re-basing one breaks every instance built on its legacy API - the converter refuses, so a
           scan row promising a fix would be the defect that split eDSClassDecl from eDSClassSubclass
           in the first place), and the already-modern cApplication object. */
        { Published = True }
        Procedure DeepScan_WorkspaceShellFlaggedForConverter
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move 'Use Workspc.pkg'                              to asCode[0]
            Move 'Object ProgramWorkspace is a Workspace'       to asCode[1]  // the shell -> hit
            Move '    Set WorkspaceName to CURRENT$WORKSPACE'   to asCode[2]
            Move 'End_Object'                                   to asCode[3]
            Move 'Class MyWorkspace is a Workspace'             to asCode[4]  // SUBCLASS -> never converted
            Move 'End_Class'                                    to asCode[5]
            Move 'Object oApplication is a cApplication'        to asCode[6]  // already modern -> clean
            Move 'End_Object'                                   to asCode[7]
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "Workspace program shell" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Send AssertSAreEqual "RefactorWorkspaceTocApplication" aHits[0].sRefactorFn
            // Suggest, not AutoFix: the converter needs its .ws parameter set for THIS workspace and
            // scaffolds a whole modern shell - both are things to read before trusting.
            Send Assert (aHits[0].eCategory = eModSuggest)
        End_Procedure

        /* DS 9262 (WindowIndex) RETIRED 2026-07-29 - it flagged a name the runtime still uses.
           Nils reported "Move Self to Windowindex" in Plan2.vw; DF 26's own packages carry the
           same shape (Winuser.pkg: "Move (InitCommonControls()) to WindowIndex") and use it as a
           loop counter besides. It is the throwaway sink for an unwanted return value, not
           character-mode window addressing.

           The lines below are lifted from the DataFlex install and from Nils's file, so if anyone
           re-enables the rule without narrowing it, this says exactly which real code it breaks. */
        { Published = True }
        Procedure DeepScan_WindowIndexNotFlagged
            String[] asCode
            tDeepScanHit[] aAll aHits
            Move '        Move Self to Windowindex'                     to asCode[0]  // Nils, Plan2.vw
            Move '    Move (InitCommonControls()) to WindowIndex'       to asCode[1]  // DF26 Winuser.pkg:558
            Move '    For WindowIndex from 0 to (DF_SEQ_CHANNEL_MAX-1)' to asCode[2]  // DF26 seq_chnl.pkg:38
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "Windowindex variable" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        // 'Use <name>' without a file extension = warning 4535 found source-side (Nils's
        // paytype.DD Use lines slipped an exhausted scan cycle 2026-07-11). Flags ONLY where
        // AddUseFileExtension would act (grid/plan parity): a bare unquoted dotless name - and never
        // 'Use UI', the character-mode base the converter leaves as it is (2026-09-23).
        { Published = True }
        Procedure DeepScan_UseWithoutExtensionFlagged
            String[] asCode
            tDeepScanHit[] aHits

            Move 'Use paytype'                          to asCode[0]  // bare -> hit
            Move '    Use anst // parent DD'            to asCode[1]  // indented + comment -> hit
            Move 'Use paytype.dd'                       to asCode[2]  // has extension -> clean
            Move 'Use Windows.pkg'                      to asCode[3]  // has extension -> clean
            Move 'Use "Legacy Path\Some.dg"'            to asCode[4]  // quoted path -> clean (converter skips too)
            Move 'Use'                                  to asCode[5]  // no filename -> clean
            Move 'Move iUse to use'                     to asCode[6]  // 'use' not in command position -> clean
            Move 'Use UI'                               to asCode[7]  // the character-mode base -> clean
            Move 'use ui // screen base'                to asCode[8]  // any case, with a comment -> clean
            Move 'Use UiHelpers'                        to asCode[9]  // only STARTS with UI -> hit
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "AddUseFileExtension" to aHits
            Send AssertIAreEqual 3 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
            Send Assert (aHits[2].iLine = 10)
            Send Assert (aHits[0].sSymbol = "Use without file extension")
            Send Assert (aHits[0].eCategory = eModAutoFix)
        End_Procedure

        // A menu FILE no program pulls in loses the menu converter's hits; one a program uses live
        // keeps them; a commented Use is not a use; a .pkg keeps its hits - how they are classed is the
        // A menu file in Pkg\, its program in Prog\: dropped as dead by the menu file's folder alone, kept once the
        // scanner knows the scan's files (cFTDeepScanDriver sets pasMenuMapFiles).
        Procedure _CheckMenuFileInAnotherFolder tDeepScanRule[] ByRef aRules tDeepScanHit[] aHits
            Handle ho
            String[] asProg asFiles
            String sRoot sProg sMn
            tDeepScanHit[] aOld aNew
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_DsMenuFolders\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Prog\"), False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Pkg\"), False)) to bOk
            Move (sRoot + "Prog\_DsAfApp_.src") to sProg
            Move (sRoot + "Pkg\_DsAfMenu_.mn")  to sMn
            Move "Object Main is a Panel"                  to asProg[0]
            Move "    Use _DsAfMenu_.mn //  Menu package."  to asProg[1]
            Move "End_Object"                              to asProg[2]
            Get rfWriteEncodedFileFromStringArray (&asProg) sProg C_NewLine False to bOk
            Get Create (RefClass(cDeepScanner)) to ho
            Get _DropDeadMenuFileHits of ho sMn aHits (&aRules) to aOld
            Send Destroy of ho
            Get Create (RefClass(cDeepScanner)) to ho
            Move sProg to asFiles[0]
            Move sMn   to asFiles[1]
            Set pasMenuMapFiles of ho to asFiles
            Get _DropDeadMenuFileHits of ho sMn aHits (&aRules) to aNew
            Send Destroy of ho
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Send AssertIAreEqual 0 (SizeOfArray(aOld))
            Send AssertIAreEqual (SizeOfArray(aHits)) (SizeOfArray(aNew))
        End_Procedure

        // next test's business (2026-09-04).
        {Published = True}
        Procedure DeepScan_DeadMenuFileLosesMenuConverterHits
            Handle ho
            String[] asMenu asProg asOther
            String sDataPath sDead sLive sProg sOther
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits aOut
            Integer iVoid iBefore
            Boolean bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath    // psDataPath has no trailing separator
            Move (sDataPath + "_CJDead_.mn")  to sDead
            Move (sDataPath + "_CJLive_.mn")  to sLive
            Move (sDataPath + "_CJProgL_.src") to sProg
            Move (sDataPath + "_CJProgD_.src") to sOther
            Move "Object Main is a Panel"             to asProg[0]
            Move "Use _CJLive_.mn //  Menu package."  to asProg[1]
            Move "End_Object"                         to asProg[2]
            Move "Object Main is a Panel"             to asOther[0]
            Move "//  Use _CJDead_.mn //  Menu package."   to asOther[1]
            Move "End_Object"                         to asOther[2]
            Get rfWriteEncodedFileFromStringArray (&asProg)  sProg  C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asOther) sOther C_NewLine False to bOk
            Move "DFCreate_Menu Main_Menu" to asMenu[0]
            Move "End_Menu"                to asMenu[1]
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asMenu) (&aRules) to aHits
            Move (SizeOfArray(aHits)) to iBefore
            Send Assert (iBefore > 0)
            Get _DropDeadMenuFileHits of ho sDead aHits (&aRules) to aOut
            Send AssertIAreEqual 0 (SizeOfArray(aOut))
            // A program in ANOTHER folder keeps a menu file live (2026-11-01): the scan's files name the folders.
            Send _CheckMenuFileInAnotherFolder (&aRules) aHits
            Get _DropDeadMenuFileHits of ho sLive aHits (&aRules) to aOut
            Send AssertIAreEqual iBefore (SizeOfArray(aOut))
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJPlain_.pkg") aHits (&aRules) to aOut
            Send AssertIAreEqual iBefore (SizeOfArray(aOut))
            // an .inc pulldown is judged through the menu file that #includes it: the live
            // menu file's .inc keeps its hits, the dead one's loses them (a fresh scanner, so the
            // folder map is rebuilt with the two menu files on disk)
            Send Destroy of ho
            Move "DFCreate_Menu Main_Menu"     to asMenu[0]
            Move "#include _CJLiveHelp_.inc"   to asMenu[1]
            Move "End_Menu"                    to asMenu[2]
            Get rfWriteEncodedFileFromStringArray (&asMenu) sLive C_NewLine False to bOk
            Move "#include _CJDeadHelp_.inc"   to asMenu[1]
            Get rfWriteEncodedFileFromStringArray (&asMenu) sDead C_NewLine False to bOk
            Get Create (RefClass(cDeepScanner)) to ho
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJLiveHelp_.inc") aHits (&aRules) to aOut
            Send AssertIAreEqual iBefore (SizeOfArray(aOut))
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJDeadHelp_.inc") aHits (&aRules) to aOut
            Send AssertIAreEqual 0 (SizeOfArray(aOut))
            Send Destroy of ho
            Move (rfDeleteFile(sProg))  to iVoid
            Move (rfDeleteFile(sOther)) to iVoid
            Move (rfDeleteFile(sLive))  to iVoid
            Move (rfDeleteFile(sDead))  to iVoid
        End_Procedure

        // A legacy menu in a .pkg is judged like the other fragments (2026-09-11): #included by a menu
        // file a program uses -> kept for the converter; #included only by a menu file nothing uses ->
        // dropped; named by no menu at all -> KEPT, but Explain with no function: a program may Use it,
        // which the converter never follows, so the scan cannot call it dead - and a plan run on it
        // would change nothing. A program keeps its hits whatever pulls it in.
        {Published = True}
        Procedure DeepScan_MenuInPackage_JudgedByTheMenuThatReachesIt
            Handle ho
            String[] asMenu asProg asLiveMn asDeadMn
            String sDataPath sProg sLiveMn sDeadMn
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits aLive aDead aLoose aProgram
            Integer iVoid iBefore i iExplain iNoFn
            Boolean bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath    // psDataPath has no trailing separator
            Move (sDataPath + "_CJPkgProg_.src") to sProg
            Move (sDataPath + "_CJPkgLive_.mn")  to sLiveMn
            Move (sDataPath + "_CJPkgDead_.mn")  to sDeadMn
            Move "Object Main is a Panel"               to asProg[0]
            Move "Use _CJPkgLive_.mn //  Menu package." to asProg[1]
            Move "End_Object"                           to asProg[2]
            Move "DFCreate_Menu Main_Menu"              to asLiveMn[0]
            Move "#include _CJLivePull_.pkg"            to asLiveMn[1]
            Move "End_Menu"                             to asLiveMn[2]
            Move "DFCreate_Menu Main_Menu"              to asDeadMn[0]
            Move "#include _CJDeadPull_.pkg"            to asDeadMn[1]
            Move "End_Menu"                             to asDeadMn[2]
            Get rfWriteEncodedFileFromStringArray (&asProg)   sProg   C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asLiveMn) sLiveMn C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asDeadMn) sDeadMn C_NewLine False to bOk
            // the hits a pulldown kept in a .pkg yields - the menu converter's only
            Move 'DFCreate_Menu "&Help" Help_Menu'      to asMenu[0]
            Move 'On_Item "&About" Send Activate_About' to asMenu[1]
            Move "End_Pull_Down"                        to asMenu[2]
            Move "End_Menu"                             to asMenu[3]
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asMenu) (&aRules) to aHits
            Get _HitsForFn aHits "ChangeDFCreateMenuToCodeJock" to aHits
            Move (SizeOfArray(aHits)) to iBefore
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJLivePull_.pkg") aHits (&aRules) to aLive
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJDeadPull_.pkg") aHits (&aRules) to aDead
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJLoose_.pkg")    aHits (&aRules) to aLoose
            Get _DropDeadMenuFileHits of ho (sDataPath + "_CJLoose_.src")    aHits (&aRules) to aProgram
            Send Destroy of ho
            Move (rfDeleteFile(sProg))   to iVoid
            Move (rfDeleteFile(sLiveMn)) to iVoid
            Move (rfDeleteFile(sDeadMn)) to iVoid
            Send Assert (iBefore > 0)
            // reached through a menu file a program uses: kept for the converter, untouched
            Send AssertIAreEqual iBefore (SizeOfArray(aLive))
            If (SizeOfArray(aLive) > 0) ;
                Send AssertSAreEqual "ChangeDFCreateMenuToCodeJock" aLive[0].sRefactorFn
            // #included only by a menu file nothing uses: dead, the menu converter's hits go
            Send AssertIAreEqual 0 (SizeOfArray(aDead))
            // named by no menu at all: kept, every one Explain with no function, and the hint says why
            Send AssertIAreEqual iBefore (SizeOfArray(aLoose))
            Move 0 to iExplain
            Move 0 to iNoFn
            For i from 0 to (SizeOfArray(aLoose) - 1)
                If (aLoose[i].eCategory = eModExplain) ;
                    Increment iExplain
                If (aLoose[i].sRefactorFn = "") ;
                    Increment iNoFn
            Loop
            Send AssertIAreEqual iBefore iExplain
            Send AssertIAreEqual iBefore iNoFn
            If (SizeOfArray(aLoose) > 0) ;
                Send Assert (aLoose[0].sHint contains "UnusedSourceFiles")
            // a program keeps its hits, whatever pulls it in
            Send AssertIAreEqual iBefore (SizeOfArray(aProgram))
            If (SizeOfArray(aProgram) > 0) ;
                Send AssertSAreEqual "ChangeDFCreateMenuToCodeJock" aProgram[0].sRefactorFn
        End_Procedure

        // ---- The workspace's own subclasses (2026-09-04, LegacyApp MyDbGrid) --------------------------
        // Learned: MyDbGrid is a dbGrid, MyDbGrid2 is a MyDbGrid (two levels), cMyList is a List;
        // cOther is a cCJGrid - modern, learned nowhere. Then "Object ... is a <X>" lines: the two
        // dbGrid descendants and the List one flag under their family's rule, the modern classes
        // do not, and the exact "is a dbGrid" still does. The hit says which subclass it came
        // through, and that the converter leaves such an object as it is under an EMPTY parameter:
        // an Explain row with no function (2026-10-03); the plain dbGrid keeps its converter.
        {Published = True}
        Procedure DeepScan_LearnedSubclass_ObjectsFlaggedThroughIt
            Handle ho
            String[] asClass asCode asNames asRoots
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            Integer i iDbGrid iList iN
            Boolean bA bB bC bD bE bM bNoteA bLeftA bExplainA

            Move "Class MyDbGrid is a dbGrid"        to asClass[0]
            Move "    Procedure Foo"                 to asClass[1]
            Move "End_Class"                         to asClass[2]
            Move "Class MyDbGrid2 is a MyDbGrid"     to asClass[3]
            Move "Class cMyList is a List"           to asClass[4]
            Move "Class cOther is a cCJGrid"         to asClass[5]
            Move "// Class cCommented is a dbGrid"   to asClass[6]
            Move "Class MyWorkspace is a Workspace"  to asClass[7]   // the shell rule takes no subclass
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Get pasSubclassNames of ho to asNames
            Get pasSubclassRoots of ho to asRoots
            Send AssertIAreEqual 3 (SizeOfArray(asNames))
            Send Assert (SearchArray("myworkspace", asNames) = -1)
            Send Assert (SearchArray("mydbgrid2", asNames) <> -1)
            Move (SearchArray("mydbgrid2", asNames)) to iN
            Send AssertSAreEqual "dbgrid" asRoots[iN]
            Move (SearchArray("cmylist", asNames)) to iN
            Send AssertSAreEqual "list" asRoots[iN]
            Send Assert (SearchArray("cother", asNames) = -1)
            Send Assert (SearchArray("ccommented", asNames) = -1)
            Move "Object oA is a MyDbGrid"           to asCode[0]
            Move "Object oB is a MyDbGrid2"          to asCode[1]
            Move "Object oC is a cDbCJGrid"          to asCode[2]
            Move "Object oD is a cOther"             to asCode[3]
            Move "Object oE is a dbGrid"             to asCode[4]
            Move "Object oM is a cMyList"            to asCode[5]
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sSymbol = "dbGrid class") Begin
                    If (aHits[i].iLine = 1) Move True to bA
                    If (aHits[i].iLine = 2) Move True to bB
                    If (aHits[i].iLine = 3) Move True to bC
                    If (aHits[i].iLine = 4) Move True to bD
                    If (aHits[i].iLine = 5 and aHits[i].sRefactorFn = "RefactorDbGridTocDbCJGrid" and aHits[i].eCategory = eModAutoFix) Move True to bE
                    If (aHits[i].iLine = 1 and aHits[i].sHint contains "Matched through the workspace subclass MyDbGrid of dbgrid") ;
                        Move True to bNoteA
                    If (aHits[i].iLine = 1 and aHits[i].sHint contains "RefactorDbGridTocDbCJGrid leaves these objects as they are when its parameter is EMPTY") ;
                        Move True to bLeftA
                    If (aHits[i].iLine = 1 and aHits[i].sRefactorFn = "" and aHits[i].eCategory = eModExplain) ;
                        Move True to bExplainA
                End
                If (aHits[i].sSymbol = "List class" and aHits[i].iLine = 6) ;
                    Move True to bM
            Loop
            Send Assert bA
            Send Assert bB
            Send AssertFalse bC
            Send AssertFalse bD
            Send Assert bE        "the plain dbGrid keeps its converter, as Auto-fix"
            Send Assert bM
            Send Assert bNoteA
            Send Assert bLeftA    "the note says the converter leaves the object"
            Send Assert bExplainA "a subclass object's row is Explain, with no function"
            Send Destroy of ho
        End_Procedure

        /* A subclass hint may promise that its objects are LISTED only for a family the scan
           actually learns. DS 9229/9230 were seeded (rules v66) by copying the older subclass
           wording, but floatingpopupmenu was never added to _SubclassLearningToken - so the hint
           told the reader to expect object rows the scan never produces (Nils 2026-09-16, asking
           why a 'Class X is a FloatingPopupMenu' line gets no Run refactor plan button). An
           AutoFix promise the plan run cannot keep is what split eDSClassDecl from
           eDSClassSubclass; a hint promising a LISTING that never comes is the same defect one
           step further out. One assertion PER RULE, naming the token, so the next rule that
           copies the wording without extending _SubclassLearningToken fails by name. */
        {Published = True}
        Procedure DeepScan_SubclassHintClaimsAListingOnlyWhenTheTokenIsLearned
            Handle ho
            tDeepScanRule[] aRules
            Integer i iLast iLearned iUnlearned
            Boolean bClaims bLearned

            Move 0 to iLearned
            Move 0 to iUnlearned
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Move (SizeOfArray(aRules) - 1) to iLast
            For i from 0 to iLast
                If (aRules[i].eDSKind = eDSClassSubclass) Begin
                    Move (Pos("are listed as", aRules[i].sHint) > 0) to bClaims
                    Get _SubclassLearningToken of ho aRules[i].sToken to bLearned
                    Send Assert (bClaims = bLearned) ("The '" + aRules[i].sToken + "' subclass hint disagrees with whether the scan learns that token")
                    If (bLearned) Begin
                        Increment iLearned
                    End
                    Else Begin
                        Increment iUnlearned
                    End
                End
            Loop
            Send Destroy of ho
            // Both counters, or the loop could pass by examining nothing.
            Send Assert (iLearned > 0)   "No LEARNED subclass rule was examined"
            Send Assert (iUnlearned > 0) "No UNLEARNED subclass rule was examined"
        End_Procedure

        /* THE GRID SUBCLASSES ARE OFFERED (2026-10-04). An object of a subclass the subclass converter takes
           is listed ONCE, under that converter's own rule, Auto-fix - not under the family rule as well. The
           verdict is set by hand here; JudgeGridSubclasses has its own test. Every hit goes into the asserted
           string, so a second row for the object would show. */
        {Published = True}
        Procedure DeepScan_GridSubclass_ConvertibleObjectIsOfferedOnce
            Handle ho
            String[] asClass asCode asPortNames asPortWhy
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            String sGot
            Integer i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Move "Class MyGrid is a dbGrid" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Move "mygrid" to asPortNames[0]
            Move ""       to asPortWhy[0]
            Set pasPortNames of ho to asPortNames
            Set pasPortWhy   of ho to asPortWhy
            Move "Object oT is a MyGrid" to asCode[0]
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Send Destroy of ho
            Move "" to sGot
            For i from 0 to (SizeOfArray(aHits) - 1)
                Move (sGot + aHits[i].sSymbol + "|" + If((aHits[i].eCategory = eModAutoFix), "AutoFix", "other") + "|" + aHits[i].sRefactorFn + ";") to sGot
            Loop
            Send AssertSAreEqual "dbGrid subclass object|AutoFix|ConvertGridSubclassToCodeJock;" sGot
        End_Procedure

        // ...and an object of a subclass the converter CANNOT take stays under the family rule, an explanation
        // with no function, and its hint carries the converter's own reason.
        {Published = True}
        Procedure DeepScan_GridSubclass_RefusedObjectSaysWhy
            Handle ho
            String[] asClass asCode asPortNames asPortWhy
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            String sGot
            Integer i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Move "Class MyGrid is a dbGrid" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Move "mygrid"                     to asPortNames[0]
            Move "its body holds a row loop"  to asPortWhy[0]
            Set pasPortNames of ho to asPortNames
            Set pasPortWhy   of ho to asPortWhy
            Move "Object oT is a MyGrid" to asCode[0]
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Send Destroy of ho
            Move "" to sGot
            For i from 0 to (SizeOfArray(aHits) - 1)
                Move (sGot + aHits[i].sSymbol + "|" + If((aHits[i].eCategory = eModExplain), "Explain", "other") + "|" + aHits[i].sRefactorFn + "|" + If((aHits[i].sHint contains "ConvertGridSubclassToCodeJock cannot convert MyGrid in place: its body holds a row loop."), "why", aHits[i].sHint) + ";") to sGot
            Loop
            Send AssertSAreEqual "dbGrid class|Explain||why;" sGot
        End_Procedure

        // The CLASS line the same way: offered where the converter takes the class, an explanation with the
        // reason where it does not. Both scans in one asserted string.
        {Published = True}
        Procedure DeepScan_GridSubclass_ClassRowFollowsTheVerdict
            Handle ho
            String[] asClass asPortNames asPortWhy
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            String sGot
            Integer i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Move "Class MyGrid is a dbGrid" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Move "mygrid" to asPortNames[0]
            Move ""       to asPortWhy[0]
            Set pasPortNames of ho to asPortNames
            Set pasPortWhy   of ho to asPortWhy
            Get ScanLines of ho (&asClass) (&aRules) to aHits
            Move "" to sGot
            For i from 0 to (SizeOfArray(aHits) - 1)
                Move (sGot + aHits[i].sSymbol + "|" + If((aHits[i].eCategory = eModAutoFix), "AutoFix", "other") + "|" + aHits[i].sRefactorFn + ";") to sGot
            Loop
            Move "another class is built on it" to asPortWhy[0]
            Set pasPortWhy of ho to asPortWhy
            Get ScanLines of ho (&asClass) (&aRules) to aHits
            Send Destroy of ho
            For i from 0 to (SizeOfArray(aHits) - 1)
                Move (sGot + aHits[i].sSymbol + "|" + If((aHits[i].eCategory = eModExplain), "Explain", "other") + "|" + aHits[i].sRefactorFn + "|" + If((aHits[i].sHint contains "ConvertGridSubclassToCodeJock cannot convert it in place: another class is built on it. Port it by hand to a class based on cDbCJGrid"), "why", aHits[i].sHint) + ";") to sGot
            Loop
            Send AssertSAreEqual "dbGrid subclass|AutoFix|ConvertGridSubclassToCodeJock;dbGrid subclass|Explain||why;" sGot
        End_Procedure

        // The verdicts ride the cache fingerprint and come back out of it: yes, no with its reason (the
        // string's own separators taken out of it), and a fingerprint from before the verdicts yields nothing.
        {Published = True}
        Procedure DeepScan_PortVerdictFingerprint_RoundTrip
            Handle ho
            String[] asPortNames asPortWhy asNames asWhy asOldNames asOldWhy
            String sFp sGot
            Integer i

            Get Create (RefClass(cDeepScanner)) to ho
            Move "mygrid"   to asPortNames[0]
            Move ""         to asPortWhy[0]
            Move "mylist"   to asPortNames[1]
            Move "'Send A; Send B' in its class body | odd" to asPortWhy[1]
            Set pasPortNames of ho to asPortNames
            Set pasPortWhy   of ho to asPortWhy
            Get PortVerdictFingerprint of ho to sFp
            Send PortVerdictsInFingerprint of ho ("84~" + sFp + "|mygrid=dbgrid;mylist=dblist;|{json}") (&asNames) (&asWhy)
            Send PortVerdictsInFingerprint of ho "83|mygrid=dbgrid;|{json}" (&asOldNames) (&asOldWhy)
            Send Destroy of ho
            Move (sFp + " -> ") to sGot
            For i from 0 to (SizeOfArray(asNames) - 1)
                Move (sGot + asNames[i] + ":[" + asWhy[i] + "]") to sGot
            Loop
            Move (sGot + " old:" + String(SizeOfArray(asOldNames))) to sGot
            Send AssertSAreEqual "mygrid=+;mylist=-'Send A, Send B' in its class body / odd; -> mygrid:[]mylist:['Send A, Send B' in its class body / odd] old:0" sGot
        End_Procedure

        /* JudgeGridSubclasses asks the CONVERTER, with the class files a scan learns from: a class it ports
           converts; a class with a member it does not carry does not, and says which; a class built on
           another class of the workspace is not asked at all. Three files in the Data folder, removed again. */
        {Published = True}
        Procedure DeepScan_JudgeGridSubclasses_AsksTheConverter
            Handle ho
            String sDir sA sB sC sGot sWhy
            String[] asA asB asC asFiles
            tDeepScanRule[] aRules
            Boolean bOk bKnown

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDir
            Move (vFolderFormat(sDir) + "ZJudgeA.pkg") to sA
            Move (vFolderFormat(sDir) + "ZJudgeB.pkg") to sB
            Move (vFolderFormat(sDir) + "ZJudgeC.pkg") to sC
            Move "Class ZJudgePlain is a dbGrid"       to asA[SizeOfArray(asA)]
            Move "    Procedure Construct_Object"      to asA[SizeOfArray(asA)]
            Move "        Forward Send Construct_Object" to asA[SizeOfArray(asA)]
            Move "    End_Procedure"                   to asA[SizeOfArray(asA)]
            Move "End_Class"                           to asA[SizeOfArray(asA)]
            Move "Class ZJudgeRich is a Grid"          to asB[SizeOfArray(asB)]
            Move "    Procedure DoDeleteRow Integer iRow" to asB[SizeOfArray(asB)]
            Move "    End_Procedure"                   to asB[SizeOfArray(asB)]
            Move "End_Class"                           to asB[SizeOfArray(asB)]
            Move "Class ZJudgeChild is a ZJudgeRich"   to asC[SizeOfArray(asC)]
            Move "End_Class"                           to asC[SizeOfArray(asC)]
            Get rfWriteEncodedFileFromStringArray (&asA) sA C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asB) sB C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asC) sC C_NewLine False to bOk
            Move sA to asFiles[0]
            Move sB to asFiles[1]
            Move sC to asFiles[2]

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send LearnWorkspaceSubclasses of ho (&asFiles) (&aRules)
            Get GridSubclassWhy of ho "zjudgeplain" (&bKnown) to sWhy
            Move ("plain:" + If(bKnown, "known", "unknown") + ":[" + sWhy + "]") to sGot
            Get GridSubclassWhy of ho "zjudgerich" (&bKnown) to sWhy
            Move (sGot + " rich:" + If(bKnown, "known", "unknown") + ":" + If((sWhy contains "DoDeleteRow"), "names the member", sWhy)) to sGot
            Get GridSubclassWhy of ho "zjudgechild" (&bKnown) to sWhy
            Move (sGot + " child:" + If(bKnown, "known", "unknown") + ":" + If((sWhy contains "it is built on ZJudgeRich"), "built on", sWhy)) to sGot
            Send Destroy of ho
            Move (rfDeleteFile(sA)) to bOk
            Move (rfDeleteFile(sB)) to bOk
            Move (rfDeleteFile(sC)) to bOk
            Send AssertSAreEqual "plain:known:[] rich:known:names the member child:known:built on" sGot
        End_Procedure

        // POSITIVE CONTROL: a scanner that learned nothing matches exactly as before - the literal
        // token only - so "is a MyDbGrid" stays silent there.
        {Published = True}
        Procedure DeepScan_NothingLearned_LiteralMatchOnly
            Handle ho
            String[] asCode
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            Integer i
            Boolean bSub bExact

            Move "Object oA is a MyDbGrid" to asCode[0]
            Move "Object oE is a dbGrid"   to asCode[1]
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sRefactorFn = "RefactorDbGridTocDbCJGrid" and aHits[i].iLine = 1) ;
                    Move True to bSub
                If (aHits[i].sRefactorFn = "RefactorDbGridTocDbCJGrid" and aHits[i].iLine = 2) ;
                    Move True to bExact
            Loop
            Send AssertFalse bSub
            Send Assert bExact
            Send Destroy of ho
        End_Procedure

        // A subclass that does NOT end in the legacy name is matched through the learned set all the same,
        // and its row says what to do: the converter leaves its objects as they are under an EMPTY
        // parameter (2026-10-03), so the note names ConvertGridSubclassToCodeJock with the class (2026-10-04).
        // The learned set moves the cache fingerprint.
        {Published = True}
        Procedure DeepScan_LearnedSubclass_ParameterAdviceAndFingerprint
            Handle ho
            String[] asClass asCode
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            tDeepScanCache Cache
            tDeepScanFileCacheEntry Entry
            String sBefore sAfter
            Integer i
            Boolean bParam

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get SubclassFingerprint of ho to sBefore
            Move "Class cCustomerTable is a dbGrid" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Get SubclassFingerprint of ho to sAfter
            Send AssertSAreEqual "" sBefore
            Send AssertSAreEqual "ccustomertable=dbgrid;" sAfter
            Move "Object oT is a cCustomerTable" to asCode[0]
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sRefactorFn = "" and aHits[i].eCategory = eModExplain and aHits[i].sHint contains "Run ConvertGridSubclassToCodeJock with the parameter 'cCustomerTable'" and aHits[i].sHint contains "ports cCustomerTable to cDbCJGrid in place") ;
                    Move True to bParam
            Loop
            Send Assert bParam
            // an Edit-family subclass: the converter swaps ONE named class, so the note sends the
            // user to the subclass's own file - and the row carries NO function (a plan run on this
            // file would change nothing), demoted to Explain
            Move "Class MyEdit is a Edit" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Move "Object oE is a MyEdit" to asCode[0]
            Move False to bParam
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sRefactorFn = "" and aHits[i].eCategory = eModExplain and aHits[i].sHint contains "Run RefactorEditTocTextEdit with its default parameter on the file that declares MyEdit") ;
                    Move True to bParam
            Loop
            Send Assert bParam
            // a primed cache from a scanner that learned nothing is flushed by one that has
            Move "x" to Cache.sRulesFingerprint
            Move "c:\x.pkg" to Cache.asPathsLow[0]
            Move Entry to Cache.aEntries[0]
            Send ValidateScanCache of ho (&aRules) (&Cache)
            Send AssertIAreEqual 0 (SizeOfArray(Cache.aEntries))
            Send Assert (Pos("ccustomertable=dbgrid;", Cache.sRulesFingerprint) > 0)
            Send Destroy of ho
        End_Procedure

        /* THE LEARNED PAIRS READ BACK OUT OF A CACHE FINGERPRINT (2026-09-05): what the converters get after
           a restart, when no scan has run this session. Only the text between the first two "|" is read -
           the rules JSON after them may hold "|" of its own - and a scanner's own fingerprint round-trips. */
        {Published = True}
        Procedure DeepScan_SubclassPairsInFingerprint
            Handle ho
            String[] asNames asRoots asClass
            tDeepScanRule[] aRules
            String sFp
            Get Create (RefClass(cDeepScanner)) to ho
            Move '52|mygrid=grid;cmydbgrid=dbgrid;myedit=edit;|{"a":"x|y","b":1}' to sFp
            Send SubclassPairsInFingerprint of ho sFp (&asNames) (&asRoots)
            Send AssertIAreEqual 3 (SizeOfArray(asNames))
            Send AssertIAreEqual 3 (SizeOfArray(asRoots))
            Send AssertSAreEqual "mygrid"    asNames[0]
            Send AssertSAreEqual "grid"      asRoots[0]
            Send AssertSAreEqual "cmydbgrid" asNames[1]
            Send AssertSAreEqual "dbgrid"    asRoots[1]
            Send AssertSAreEqual "myedit"    asNames[2]
            Send AssertSAreEqual "edit"      asRoots[2]
            // nothing between the bars, or no bars at all: nothing
            Send SubclassPairsInFingerprint of ho "52||{}" (&asNames) (&asRoots)
            Send AssertIAreEqual 0 (SizeOfArray(asNames))
            Send SubclassPairsInFingerprint of ho "" (&asNames) (&asRoots)
            Send AssertIAreEqual 0 (SizeOfArray(asNames))
            // round trip: a scanner that learned one pair writes a fingerprint this reads back
            Get BuildDefaultDeepScanRules of ho to aRules
            Move "Class cCustomerTable is a dbGrid" to asClass[0]
            Send LearnSubclassPairsFromLines of ho (&asClass)
            Send ResolveLearnedSubclasses of ho (&aRules)
            Get SubclassFingerprint of ho to sFp
            Send SubclassPairsInFingerprint of ho ("52|" + sFp + "|{}") (&asNames) (&asRoots)
            Send AssertIAreEqual 1 (SizeOfArray(asNames))
            Send AssertSAreEqual "ccustomertable" asNames[0]
            Send AssertSAreEqual "dbgrid"         asRoots[0]
            Send Destroy of ho
        End_Procedure

        /* A Language_XXX.inc IS the substitution mechanism (2026-08-09). Its #REPLACE entries are
           how DataFlex compiles a localised app, so converting them to Defines would break the file
           - and since every line matches, the rule would bury it in findings. Ordinary source keeps
           the advice. */
        { Published = True }
        Procedure DeepScan_LanguageFileReplaceHitsDropped
            Handle ho
            String[] asCode
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits

            Move '#REPLACE C_MsgOk "OK"'      to asCode[0]
            Move '#REPLACE C_MsgCancel "Avbryt"' to asCode[1]
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            // Same lines, judged by FILENAME alone.
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Get _DropLanguageFileConstHits of ho "C:\App\AppSrc\Language_SV.inc" aHits (&aRules) to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Get _DropLanguageFileConstHits of ho "C:\App\AppSrc\MyConstants.inc" aHits (&aRules) to aHits
            Send Assert (SizeOfArray(aHits) > 0)
            // A file that merely STARTS with "language" is ordinary source - the underscore form is
            // the documented DataFlex shape and the only one suppressed.
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Get _DropLanguageFileConstHits of ho "C:\App\AppSrc\LanguageRules.inc" aHits (&aRules) to aHits
            Send Assert (SizeOfArray(aHits) > 0)
            Send Destroy of ho
        End_Procedure

        /* v25 - Crystal Reports, matched as a package FAMILY. The names below are the real ones from
           the DF18/DF19 trees, which is the whole argument for eDSUseContains: three of them share
           no common prefix, so a whole-word rule per package would have to be rewritten every time
           somebody wraps Crystal under a new name. */
        { Published = True }
        Procedure DeepScan_CrystalPackageFamilyFlagged
            String[] asCode
            tDeepScanHit[] aHits

            Move 'Use CrystalReport.pkg'              to asCode[0]  // hit
            Move 'Use cCrystal.pkg'                   to asCode[1]  // hit - different prefix
            Move '    Use rcCrystalReport.pkg'        to asCode[2]  // hit - indented, third shape
            Move 'Use crystalrep2.pkg'                to asCode[3]  // hit - digit suffix
            Move 'Use Windows.pkg'                    to asCode[4]  // clean
            Move 'Use cDbCJGrid.pkg'                  to asCode[5]  // clean
            Move 'Move iCrystal to crystal'           to asCode[6]  // clean - not a Use line
            Get ScanSnippet asCode to aHits
            Get _HitsForSymbol aHits "Crystal Reports package" to aHits
            Send AssertIAreEqual 4 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[3].iLine = 4)
            // EXPLAIN, with no refactor function - there is no transformation that moves a report
            // definition to another product, so the rule must never offer one.
            Send Assert (aHits[0].eCategory = eModExplain)
            Send AssertSAreEqual "" aHits[0].sRefactorFn
        End_Procedure

        // A quoted Use path is skipped, for the same reason eDSUseNoExt skips one: a string literal
        // arrives MASKED at the matcher, so its own text cannot be trusted.
        { Published = True }
        Procedure DeepScan_CrystalQuotedUsePathSkipped
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Use "Some Path\CrystalReport.pkg"' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForSymbol aHits "Crystal Reports package" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        // v3/v4 class rules: the compiler's 4537 "Obsolete class" family found source-side. The
        // DECLARATION anchor ('is a <Class>' at word 5) is the point - common-word class names
        // (List, Grid, Edit) flag ONLY there, never as mentions. And the OBJECT form routes to a
        // converter while the SUBCLASS-definition form is Explain-only - the converters refuse
        // class definitions (Nils's 12-file LegacyApp3 residue 2026-07-11: the scan promised Auto-fix
        // on 'Class cDynamicDbList is a dbList' rows the plan run could not touch).
        { Published = True }
        Procedure DeepScan_ObsoleteClassDeclFlagged
            String[] asCode
            tDeepScanHit[] aAll aHits
            Integer i

            Move 'Object oSelList is a dbList'      to asCode[0]  // OBJECT form -> converter route
            Move '    Class cMyGrid is a Grid'      to asCode[1]  // SUBCLASS form -> Explain rule
            Move 'Object oName_frm is a dbForm'     to asCode[2]  // no rule for dbForm -> clean
            Move 'Move oList to hoGrid'             to asCode[3]  // mention, not a declaration -> clean
            Move '// Object oOld is a dbList'       to asCode[4]  // comment -> clean
            Move 'Object oNew is a cDbCJGrid'       to asCode[5]  // already modern -> clean
            Move 'Class cToolTipTmr is a DFTimer'   to asCode[6]  // SUBCLASS form (LegacyApp3 Tooltip.pkg shape)
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "RefactorDbListTocDbCJGridPromptList" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].eCategory = eModAutoFix)
            // The Grid SUBCLASS line: never the converter rule...
            Get _HitsForFn aAll "RefactorGridToCJGrid" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
            // ...but the Explain subclass rules instead, with no function to run.
            Move 0 to i
            Get _HitsForSymbol aAll "Grid subclass" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Send Assert (aHits[0].eCategory = eModExplain)
            Send Assert (aHits[0].sRefactorFn = "")
            Get _HitsForSymbol aAll "DfTimer subclass" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 7)
        End_Procedure

        // A DFRefactor skip-marker = a converter already saw the line and refused with written
        // guidance. TWO placements, both must silence the scan: an own comment line ABOVE (the
        // dfTimer form) and a TRAILING same-line comment (the strmark TODO + the pinned-
        // indicator NOTE). Re-flagging those lines every scan as Auto-fix promises a fix that
        // never comes (Nils 2026-07-11/12).
        { Published = True }
        Procedure DeepScan_SkipTodoSuppressesHits
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '//TODO dfTimer->cTimer (skipped): Uses the Timer_Message/Timer_object dispatch - rewrite OnTimer by hand.' to asCode[0]
            Move 'Object oTimer is a DFTimer'          to asCode[1]  // marker ABOVE -> suppressed
            Move 'Object oOther is a DFTimer'          to asCode[2]  // clean -> still flagged
            Move 'Left P$NR to P$NR   // TODO (DFRefactor): NOT converted - the count argument is missing.' to asCode[3]  // TRAILING marker (the real strmark shape) -> suppressed
            Move 'Indicator gbUser   // NOTE (DFRefactor): kept as Indicator on purpose - read by legacy code.' to asCode[4]  // TRAILING NOTE (poisoned indicator) -> suppressed
            Move '// an ordinary comment'              to asCode[5]
            Move 'Left sName to sPart 3'               to asCode[6]  // plain comment above -> still flagged
            Move 'Indicator gbOther'                   to asCode[7]  // clean declaration -> still flagged
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeDfTimerTocTimer" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 3)
            Get _HitsForFn aAll "ChangeLeftCommandToFunction" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 7)
            Get _HitsForFn aAll "ChangeLegacyIndicators" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 8)
        End_Procedure

        // Helper: only the hits carrying one rule symbol (for fn-less Explain rules).
        Function _HitsForSymbol tDeepScanHit[] aHits String sSymbol Returns tDeepScanHit[]
            tDeepScanHit[] aOut
            Integer i
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sSymbol = sSymbol) ;
                    Move aHits[i] to aOut[SizeOfArray(aOut)]
            Loop
            Function_Return aOut
        End_Function

        // Command position vs function form: 'Left' as a COMMAND is legacy and routes to
        // the converter; the same name as a FUNCTION is modern and must never be flagged.
        { Published = True }
        Procedure DeepScan_CommandFormHitsFunctionFormClean
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Left sName to sPart 3'            to asCode[0]
            Move 'Move (Left(sName, 3)) to sPart'   to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].sRefactorFn = "ChangeLeftCommandToFunction")
            Send Assert (aHits[0].eCategory = eModAutoFix)
        End_Procedure

        // Trim is BOTH a legacy command ('Trim <src> to <dst>', fixable) AND a modern function ('Trim(x)' /
        // 'Trim (x)'). Only the COMMAND form (a whole-word 'to' on the line) is flagged; a Trim(...) call in
        // an expression - e.g. the ';'-continuation 'Trim (Comp.Namn) + ...)' where '(' opened on the line
        // above (LegacyApp2 Avbrott.src) - has NO 'to' and is a FALSE positive (ChangeTrimCommandToFunction
        // no-ops), so the Deep Scan must NOT flag it (grid == fix).
        { Published = True }
        Procedure DeepScan_TrimCommandHitsExpressionFormClean
            String[] asCode
            tDeepScanHit[] aHits aTrim
            Move 'Trim sName to sDst'                          to asCode[0]
            Move '    Move (Trim(sName)) to sDst'              to asCode[1]
            Move '        Trim (Comp.Namn) + "]" + "  Sys")'   to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeTrimCommandToFunction" to aTrim
            Send AssertIAreEqual 1 (SizeOfArray(aTrim))
            Send Assert (aTrim[0].iLine = 1)
        End_Procedure

        /* THE CodeJock RENAME MUST BE FINDABLE FROM A CONSTANT ALONE (Nils 2026-08-30). The rule
           that owned this migration keyed on the PACKAGE name, so a file already sitting on the
           modern base class, whose only residue was an old xtpReport* constant, matched nothing -
           and that is the shape that broke a test workspace's build.

           It also pins the PREFIX kind: eDSAnywhere is whole-word, so its boundary check ends the
           token and "xtpreport" would not see xtpReportThemeVisualStudio2012Light at all.

           Two negative controls, one for each way the rule could over-reach: the MODERN name it
           converts TO, and DataFlex's own ComReport* property family - a different vendor with no
           xtp prefix, which a match on the word "report" would have renamed out of existence. */
        { Published = True }
        Procedure DeepScan_XtpReportConstantFlaggedModernAndComReportClean
            String[] asCode
            tDeepScanHit[] aHits aCJ
            Move '        Set peVisualTheme to xtpReportThemeVisualStudio2012Light' to asCode[0]
            Move '        Set peVisualTheme to xtpGridThemeVisualStudio2012Light'   to asCode[1]
            Move '        Set ComReportTitle of hoRpt to sTitle'                    to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeCodeJockReportToGrid" to aCJ
            Send AssertIAreEqual 1 (SizeOfArray(aCJ))
            Send Assert (aCJ[0].iLine = 1)
            Send Assert (aCJ[0].eCategory = eModAutoFix)
        End_Procedure

        // Comments and string literals never match - the scan sees the CODE only.
        { Published = True }
        Procedure DeepScan_CommentAndLiteralNeverMatch
            String[] asCode
            tDeepScanHit[] aHits
            Move '// Chain used to launch the next program here'  to asCode[0]
            Move 'Showln "Chain reaction warning text"'           to asCode[1]
            Move '    Move 1 to iX // do not Gosub anymore'       to asCode[2]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        // Comparison modes only flag on command-syntax CONDITION lines: 'If x EQ y' is
        // legacy, but 'Find EQ' is still supported and a modern '=' line has no token.
        { Published = True }
        Procedure DeepScan_ConditionLineOperatorsOnly
            String[] asCode
            tDeepScanHit[] aHits
            Move 'If iCount eq 10 Begin'            to asCode[0]
            Move 'Find eq Customer by Index.1'      to asCode[1]
            Move 'If (iCount = 10) Begin'           to asCode[2]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].sRefactorFn = "ChangeLegacyOperators")
        End_Procedure

        // The two-word legacy negation hits; the modern parenthesized form does not.
        { Published = True }
        Procedure DeepScan_IfNotTwoWordFormOnly
            String[] asCode
            tDeepScanHit[] aHits
            Move 'If Not (Found) Begin'             to asCode[0]
            Move 'If (Not(Found)) Begin'            to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sRefactorFn = "ChangeIfNotCommandToExpression")
        End_Procedure

        // 'If Not Status <file> stmt' is a legacy file-test COMMAND, not a Boolean: the converter
        // declines it and the line compiles clean on DataFlex 26, so the rule does not fire on it
        // (Nils 2026-09-20) - in either the If or the Else If form. Found still hits beside it.
        { Published = True }
        Procedure DeepScan_IfNotStatusFileCommandIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits
            Move 'If not Status RcptWrk Function_Return "Cancelled" //signal result'  to asCode[0]
            Move 'Else If not Status RcptWrk Function_Return "Cancelled"'            to asCode[1]
            Move 'If not Found Function_Return "Cancelled"'                          to asCode[2]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send AssertIAreEqual 3 aHits[0].iLine
        End_Procedure

        // 'On <expr> Gosub' is the dispatch form (-> Case); 'On Error Gosub' belongs to
        // the On Error rule alone - exactly one hit each, with the right symbol.
        { Published = True }
        Procedure DeepScan_OnDispatchAndOnError
            String[] asCode
            tDeepScanHit[] aHits
            Move 'On iSelection Gosub DoOne DoTwo DoThree' to asCode[0]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sSymbol = "On..Gosub/Goto")
            Move 'On Error Gosub ErrorTrap' to asCode[0]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sSymbol = "On Error")
        End_Procedure

        // A plain Gosub in command position routes to the Gosub report.
        { Published = True }
        Procedure DeepScan_GosubCommandRoutesToReport
            String[] asCode
            tDeepScanHit[] aHits
            Move '    Gosub Init_Everything' to asCode[0]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sRefactorFn = "GosubGotoReport")
        End_Procedure

        // eDSAnywhere: a predefined variable is flagged wherever it appears in code -
        // but not as part of a longer identifier (boundary-aware).
        { Published = True }
        Procedure DeepScan_AnywherePredefinedVariable
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Move Strmark to iPos'             to asCode[0]
            Move 'Move iStrmarkTotal to iX'         to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].sSymbol = "Strmark variable")
        End_Procedure

        // The two predefined-variable rules carry their converters (2026-09-08): a read of strmark /
        // strlen is a Review row that runs ChangeStrMarkToExpression / ChangeStrLenToExpression -
        // the function forms never set them, so a converted string command leaves such a read stale.
        { Published = True }
        Procedure DeepScan_StrMarkStrLenRulesCarryTheirConverter
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iMark iLen

            Move 'Move strmark to iPos' to asCode[0]
            Move 'Move strlen to iLen'  to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Move -1 to iMark
            Move -1 to iLen
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].sSymbol = "Strmark variable") ;
                    Move i to iMark
                If (aHits[i].sSymbol = "Strlen variable") ;
                    Move i to iLen
            Loop
            Send Assert (iMark >= 0)
            Send Assert (iLen >= 0)
            Send AssertSAreEqual "ChangeStrMarkToExpression" aHits[iMark].sRefactorFn
            // strmark is Auto-fix since rules v61 (Nils 2026-09-11, measured: its converter cleared every
            // hit on a real workspace); strlen stays Review until a workspace gives it hits to measure.
            Send Assert (aHits[iMark].eCategory = eModAutoFix)
            Send AssertSAreEqual "ChangeStrLenToExpression" aHits[iLen].sRefactorFn
            Send Assert (aHits[iLen].eCategory = eModSuggest)
        End_Procedure

        // Common-word rules (Required, Status, Group...) ship DISABLED - present in the
        // catalog, silent in a scan.
        { Published = True }
        Procedure DeepScan_DisabledCommonWordSilent
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Entry_Item Customer.Name Required' to asCode[0]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        // The SQL command family carries the docs' class.method replacement in the hint.
        { Published = True }
        Procedure DeepScan_SqlFamilyHintNamesClass
            String[] asCode
            tDeepScanHit[] aHits
            Move 'SQLConnect to sDriverName'        to asCode[0]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sHint contains "cSQLHandleManager")
        End_Procedure

        // Line numbers are 1-based and multiple files' worth of lines report correctly.
        { Published = True }
        Procedure DeepScan_LineNumbersAreOneBased
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Move 1 to iX'                     to asCode[0]
            Move 'Chain "NEXTPROG"'                 to asCode[1]
            Move 'Move 2 to iX'                     to asCode[2]
            Move 'Cmdline sArg'                     to asCode[3]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Send Assert (aHits[1].iLine = 4)
            Send Assert (aHits[1].sHint contains "cCommandLine")
        End_Procedure

        // DS numbers are STABLE by seed position (9001, 9002, ... - the seed is append-only):
        // the recipe key + ignore-list key. A hit carries its rule's number, and HitsToMessages
        // turns it into a synthetic warning row marked bDeepScan.
        { Published = True }
        Procedure DeepScan_StableNumbersAndMessages
            Handle ho
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits
            tCompileError[] aMsgs
            String[] asCode

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send Assert (aRules[0].iDSNumber = 9001)
            Send Assert (aRules[5].iDSNumber = 9006)
            Move 'Trim sName to sName' to asCode[0]
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iDSNumber >= 9001)
            Get HitsToMessages of ho aHits "C:\Src\Sample.pkg" to aMsgs
            Send Destroy of ho
            Send AssertIAreEqual 1 (SizeOfArray(aMsgs))
            Send Assert (aMsgs[0].bDeepScan = True)
            Send Assert (aMsgs[0].bError = False)
            Send Assert (aMsgs[0].iErrorNo = aHits[0].iDSNumber)
            Send Assert (aMsgs[0].iLine = 1)
            Send Assert (aMsgs[0].sFileName = "C:\Src\Sample.pkg")
        End_Procedure

        // The catalog rules DOUBLE as analyzer recipes: classifying a rule's DS number through
        // the recipes _AddDeepScanRecipes builds routes to the same function and category the
        // rule carries - the grid and the fix plan can never disagree with the scan. The recipe
        // builder is called DIRECTLY (not via BuildDefaultRecipes) so the mechanism stays tested
        // while the CB_DeepScanEnabled Alpha gate keeps it out of the seeded table.
        { Published = True }
        Procedure DeepScan_MessagesClassifyThroughRecipes
            Handle hoScan hoMod
            tDeepScanRule[] aRules
            tModAnalyzer[] aRecipes
            tModAnalyzer Recipe
            Integer i iTrimNo

            Get Create (RefClass(cDeepScanner)) to hoScan
            Get BuildDefaultDeepScanRules of hoScan to aRules
            Send Destroy of hoScan
            Move 0 to iTrimNo
            For i from 0 to (SizeOfArray(aRules) - 1)
                If (aRules[i].sToken = "trim") ;
                    Move aRules[i].iDSNumber to iTrimNo
            Loop
            Send Assert (iTrimNo >= 9001)
            Get Create (RefClass(cModAnalyzer)) to hoMod
            Get _AddDeepScanRecipes of hoMod aRecipes to aRecipes
            Get ClassifyFromRecipes of hoMod iTrimNo "Trim command" aRecipes to Recipe
            Send Destroy of hoMod
            Send Assert (Recipe.eCategory = eModAutoFix)
            Send Assert (Recipe.sRefactorFn = "ChangeTrimCommandToFunction")
        End_Procedure

        // Condition-op false-positive harvest (Nils 2026-07-11): 'else <command>' is that
        // command's own syntax (only 'else if' continues a condition); a table.column named
        // like an operator (Daysched.In) is ONE word and never matches; everything after a
        // find/constrained_find/constrain keyword is still-supported command syntax.
        { Published = True }
        Procedure DeepScan_ConditionOpsFindConstrainImmune
            String[] asCode
            tDeepScanHit[] aHits
            Move 'else find gt anst by index.2'                     to asCode[0]
            Move 'else constrain arbk.arb_indat eq "1839-01-01"'    to asCode[1]
            Move 'If (found) Function_Return Daysched.In'             to asCode[2]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        // ... while the legacy condition op BEFORE the find keyword still flags, and an
        // else-IF condition remains a condition.
        { Published = True }
        Procedure DeepScan_ConditionOpBeforeFindStillFlags
            String[] asCode
            tDeepScanHit[] aHits
            Move 'If iSortorder eq 0 Constrained_Find ge Arbk by index.1' to asCode[0]
            Move 'else if iCount gt 10 Begin'                             to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].sSymbol = "EQ comparison")
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].sSymbol = "GT comparison")
            Send Assert (aHits[1].iLine = 2)
        End_Procedure

        // A message SEND ends the condition too (Nils 2026-07-15): in 'if lhDDO send request_read to lhDDO GT
        // file# ord#' the GT is the Request_Read find MODE, not a comparison - the condition-op walk STOPS at
        // 'send' (mirrors ChangeLegacyOperators, which leaves the same line untouched). A real GT condition
        // still flags.
        { Published = True }
        Procedure DeepScan_SendRequestReadFindModeNoHit
            String[] asCode
            tDeepScanHit[] aHits
            Move 'if lhDDO send request_read to lhDDO GT file# ord#' to asCode[0]  // GT = find mode -> NO hit
            Move 'If iA gt iB Begin'                                to asCode[1]  // control: real GT condition -> hit
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].sSymbol = "GT comparison")
            Send Assert (aHits[0].iLine = 2)
        End_Procedure

        // LEGACY PAGE / report-image content is skipped (Nils 2026-07-15): between a '/PageName' open and a
        // '/*' close the lines are literal report text, so their words (GT / LE ...) are NOT operators. Real
        // code before AND after the page still scans - the '/*' close re-opens scanning.
        { Published = True }
        Procedure DeepScan_LegacyPageContentSkipped
            String[] asCode
            tDeepScanHit[] aHits
            Move 'If iA gt iB Begin'   to asCode[0]  // real code BEFORE the page -> hit (line 1)
            Move '/DFScript.Sample1'   to asCode[1]  // page opens ('/' + a letter)
            Move 'If x gt y'           to asCode[2]  // page content -> NOT scanned
            Move 'while a le b'        to asCode[3]  // page content -> NOT scanned
            Move '/*'                  to asCode[4]  // page closes
            Move 'If iC lt iD Begin'   to asCode[5]  // real code AFTER the page -> hit (line 6)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 6)
        End_Procedure

        // MACRO-COMMAND bodies (hash-COMMAND .. hash-ENDCOMMAND) are skipped whole - their lines
        // look like legacy commands (that is what a macro emits) but carry !-argument tokens no
        // converter can rewrite. Real code after the end directive scans normally again.
        // NOTE the Character() assembly: a LITERAL hash-COMMAND token - even inside a string
        // constant - opens a real macro definition to FMAC, which then swallows the rest of the
        // file as macro body (error 4337 "Too many lines" + a compiler crash). Same dodge as the
        // |!C SELECT-macro emission.
        { Published = True }
        Procedure DeepScan_MacroCommandBodySkipped
            String[] asCode
            String sHash sBang
            tDeepScanHit[] aHits

            Move (Character(35)) to sHash
            Move (Character(33)) to sBang
            Move (sHash + "COMMAND MYINSERT")                                    to asCode[0]
            Move ("    Insert " + sBang + "1 in " + sBang + "2 at " + sBang + "3") to asCode[1]
            Move ("    Left " + sBang + "1 to " + sBang + "2 " + sBang + "3")    to asCode[2]
            Move (sHash + "ENDCOMMAND")                                          to asCode[3]
            Move 'Insert sA in sB at 3'                                          to asCode[4]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 5)
            Send Assert (aHits[0].sRefactorFn = "ChangeInsertCommandToFunction")
        End_Procedure

        // GUARD B (Nils 2026-07-15): a procedure/function that INVOKES a ! macro command is legacy
        // character-mode code end to end - the WHOLE message is skipped, not just the ! lines, so the
        // indicator / repeat / loop / flaggable lines interleaved with it never produce hits. A NORMAL
        // message with the same flaggable line still scans. (The ! is Character(33) - a literal ! macro
        // token, even in a string constant, opens a real FMAC macro and crashes the compiler; same dodge
        // as DeepScan_MacroCommandBodySkipped.)
        { Published = True }
        Procedure DeepScan_MacroInvokingMessageSkipped
            String[] asCode
            String sBang
            tDeepScanHit[] aHits

            Move (Character(33)) to sBang
            Move 'procedure output_image_wrap integer img'    to asCode[0]
            Move ('    ' + sBang + 'A [] $20A img')            to asCode[1]  // ! macro invocation
            Move '    Insert sA in sB at 3'                   to asCode[2]  // WOULD hit - but the message is skipped
            Move 'end_procedure'                              to asCode[3]
            Move 'procedure do_it'                            to asCode[4]  // NO ! macro -> scans normally
            Move '    Insert sA in sB at 3'                   to asCode[5]  // hit (line 6)
            Move 'end_procedure'                              to asCode[6]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 6)
            Send Assert (aHits[0].sRefactorFn = "ChangeInsertCommandToFunction")
        End_Procedure

        /* GUARD A (Nils 2026-07-15): a region the author muted for the COMPILER is muted for Deep Scan -
           a warning-like report - too. Hits before and after still fire; the indented Suspend proves the
           word-1 detection ignores leading whitespace.

           THIS TEST PINS THE LEGACY SPELLING AND ONE WORD THAT IS NOT DATAFLEX. 'CompilerWarnings Resume'
           raises Error 4345, "Type check error RESUME, INVALID LITERAL", so it can never reach the scanner
           from a file that compiles - it stays tolerated only because Deep Scan also reads files that are
           never built. The pair the language really has is Off / On, in the two tests below. Suspend
           itself is one-way in the compiler and dies with the file that issued it. */
        { Published = True }
        Procedure DeepScan_CompilerWarningsSuspendSkipped
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Insert sA in sB at 3'          to asCode[0]  // before Suspend -> hit (line 1)
            Move '    CompilerWarnings Suspend'   to asCode[1]
            Move 'Insert sC in sD at 4'          to asCode[2]  // suspended -> clean
            Move 'CompilerWarnings Resume'       to asCode[3]
            Move 'Insert sE in sF at 5'          to asCode[4]  // after Resume -> hit (line 5)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 5)
        End_Procedure

        /* THE FORM THE LANGUAGE ACTUALLY USES - and the one GUARD A did not recognise until 2026-09-09.
           The DF26 install writes 'CompilerWarnings Off' / 'On' 27 times each against four bare Suspends,
           so a workspace following the vendor's own idiom had every muted region scanned in full: quiet
           in the compile lane, loud in the scan lane, for the same line. */
        { Published = True }
        Procedure DeepScan_CompilerWarningsOffOnRegionSkipped
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Insert sA in sB at 3'    to asCode[0]  // before Off -> hit (line 1)
            Move '  CompilerWarnings Off'  to asCode[1]
            Move 'Insert sC in sD at 4'    to asCode[2]  // muted -> clean
            Move 'CompilerWarnings On'     to asCode[3]
            Move 'Insert sE in sF at 5'    to asCode[4]  // after On -> hit (line 5)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 5)
        End_Procedure

        /* AN UNPAIRED Off RUNS TO THE END OF THE FILE. In the compiler it runs FURTHER than that -
           measured: unlike Suspend, an Off does not die with the file that issued it, it silences
           everything compiled after it. The scan reads a file on its own and has no Use graph to carry
           that across, so it latches to this file's end and no further. The residue is the scan reporting
           a line the compiler is quiet about downstream, which is the safe direction for a report. */
        { Published = True }
        Procedure DeepScan_CompilerWarningsOffWithoutOnRunsToEndOfFile
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Insert sA in sB at 3'  to asCode[0]  // before Off -> hit (line 1)
            Move 'CompilerWarnings Off'  to asCode[1]
            Move 'Insert sC in sD at 4'  to asCode[2]  // muted
            Move 'Insert sE in sF at 5'  to asCode[3]  // still muted - there is no On anywhere
            Get ScanSnippet asCode to aHits
            // TWO hits, and the second is the point: lines 3 and 4 are muted, and the Off itself is now
            // the DS 9226 finding, because nothing closes it.
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
            Send AssertIAreEqual 9226 aHits[1].iDSNumber
        End_Procedure

        /* THE LATCH IS READ INSIDE A #COMMAND BODY TOO. The compiler honours the directive wherever it
           stands - an Off/On pair inside a macro body mutes every expansion of that macro - and an
           unpaired one keeps running past #ENDCOMMAND. GUARD A used to sit BELOW the macro-body branch,
           so a CompilerWarnings line in a body was consumed as an ordinary line and the region never
           latched. Second half is the POSITIVE CONTROL: the same snippet without the Off does hit. */
        { Published = True }
        Procedure DeepScan_CompilerWarningsOffInsideAMacroBodyStillLatches
            String[] asCode asCtl
            tDeepScanHit[] aHits aCtlHits
            Move '#COMMAND MAKE_A_THING'    to asCode[0]
            Move '  CompilerWarnings Off'   to asCode[1]
            Move '#ENDCOMMAND'              to asCode[2]
            Move 'Insert sA in sB at 3'     to asCode[3]  // muted by the Off inside the body
            Get ScanSnippet asCode to aHits
            // The Insert at line 4 is gone, which is the latch working past #ENDCOMMAND. What remains is
            // DS 9226 on the Off itself - an unpaired one inside a macro body is if anything worse.
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Send AssertIAreEqual 9226 aHits[0].iDSNumber
            Move '#COMMAND MAKE_A_THING'    to asCtl[0]
            Move '  Move 1 to iCount'       to asCtl[1]
            Move '#ENDCOMMAND'              to asCtl[2]
            Move 'Insert sA in sB at 3'     to asCtl[3]  // nothing muted it -> hit (line 4)
            Get ScanSnippet asCtl to aCtlHits
            Send AssertIAreEqual 1 (SizeOfArray(aCtlHits))
            Send Assert (aCtlHits[0].iLine = 4)
        End_Procedure

        /* DS 9226. The one suppression mistake that fails SILENTLY and travels: measured against DF26,
           'CompilerWarnings Off' does not end with the file that issued it the way 'Suspend' does, so an
           Off that is never closed mutes every file compiled after it - a library carries that into its
           consumers' builds. Neither lane could otherwise say so: the compiler cannot warn about warnings
           it was told not to emit. Explain-only, because where the region was meant to end is the
           author's decision. */
        { Published = True }
        Procedure DeepScan_UnpairedCompilerWarningsOffFlagged
            String[] asCode
            tDeepScanHit[] aHits
            Move 'CompilerWarnings Off' to asCode[0]
            Move 'Move 1 to iCount'     to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send AssertIAreEqual 9226 aHits[0].iDSNumber
            Send AssertIAreEqual eModExplain aHits[0].eCategory
            Send AssertSAreEqual "" aHits[0].sRefactorFn
        End_Procedure

        // A CLOSED pair is the correct form and says nothing - the region ends where the author meant it to.
        { Published = True }
        Procedure DeepScan_PairedCompilerWarningsOffIsClean
            String[] asCode
            tDeepScanHit[] aHits
            Move 'CompilerWarnings Off' to asCode[0]
            Move 'Move 1 to iCount'     to asCode[1]
            Move 'CompilerWarnings On'  to asCode[2]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        /* AND A BARE 'Suspend' IS NOT THIS FINDING. It has no counterpart in the language at all, and it
           does not need one: it dies with the file that issued it, so it cannot reach anything downstream.
           Flagging it would be telling the author to add a word DataFlex does not have. */
        { Published = True }
        Procedure DeepScan_BareCompilerWarningsSuspendIsNotAnUnpairedOff
            String[] asCode
            tDeepScanHit[] aHits
            Move 'CompilerWarnings Suspend' to asCode[0]
            Move 'Move 1 to iCount'         to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        /* AN 'On' THAT IS ONLY PROSE CLOSES NOTHING. The look-ahead reads the comment-stripped array for
           exactly this: a commented-out directive, and one inside a block comment, both leave the region
           open in the compiler, and a false negative here is the dangerous direction - it would tell the
           reader the region is closed when the build is still muted. */
        { Published = True }
        Procedure DeepScan_UnpairedOffIsNotClosedByACommentedOn
            String[] asCode asBlk
            tDeepScanHit[] aHits aBlkHits
            Move 'CompilerWarnings Off'    to asCode[0]
            Move '// CompilerWarnings On'  to asCode[1]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Move 'CompilerWarnings Off'   to asBlk[0]
            Move '/*'                     to asBlk[1]
            Move 'CompilerWarnings On'    to asBlk[2]
            Move '*/'                     to asBlk[3]
            Get ScanSnippet asBlk to aBlkHits
            Send AssertIAreEqual 1 (SizeOfArray(aBlkHits))
            Send Assert (aBlkHits[0].iLine = 1)
        End_Procedure
        // An IGNORED Deep Scan row must stay out of the PLAN set too: DropIgnoredMessages builds
        // the same "DS <n>" token the grid cell (and so the ignore list) carries - it used to
        // build "W <n>" for every non-error and the ignored scan row entered Auto Select anyway.
        { Published = True }
        Procedure DeepScan_IgnoredRowStaysOutOfPlan
            Handle hoMod
            tCompileError[] aMsgs aKept
            tModIgnore[] aIgnored

            Move False           to aMsgs[0].bError
            Move True            to aMsgs[0].bDeepScan
            Move 9010            to aMsgs[0].iErrorNo
            Move 748             to aMsgs[0].iLine
            Move "C:\Src\A.vw"   to aMsgs[0].sFileName
            Move "C:\Src\A.vw"   to aIgnored[0].sFile
            Move "DS 9010"       to aIgnored[0].sMsg
            Get Create (RefClass(cModAnalyzer)) to hoMod
            Get DropIgnoredMessages of hoMod aMsgs aIgnored to aKept
            Send Destroy of hoMod
            Send AssertIAreEqual 0 (SizeOfArray(aKept))
        End_Procedure

        // Rules persistence round-trip (the per-rule enable UI's backing store): write a rule set
        // with one toggle flipped, read it back at the CURRENT seed version -> the file is trusted
        // verbatim (no reseed), so the flipped bEnabled survives. Uses a scratch path, never the
        // real Data\DeepScanRules.json.
        { Published = True }
        Procedure DeepScan_RulesPersistRoundTrip
            Handle ho
            tDeepScanRule[] aRules aBack
            String sPath sTok
            Integer i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            // Flip the FIRST rule's Enabled to the opposite of its seed value.
            Move (not(aRules[0].bEnabled)) to aRules[0].bEnabled
            Get psUnitTestScratchDeepScanPath to sPath
            Send WriteDeepScanRules of ho aRules sPath
            Get LoadDeepScanRules of ho sPath to aBack
            Send Destroy of ho
            Send AssertIAreEqual (SizeOfArray(aRules)) (SizeOfArray(aBack))
            Send Assert (aBack[0].bEnabled = aRules[0].bEnabled)
            Send Assert (aBack[0].iDSNumber = aRules[0].iDSNumber)
            Move (rfDeleteFile(sPath)) to i
        End_Procedure

        // Enabled-toggle MERGE across a reseed: an OLD file (version 0, only a couple of rows with
        // a user toggle) is loaded -> the fresh seed comes back FULL, with the user's toggle
        // carried over by DS number, and the file is rewritten at the current version.
        { Published = True }
        Procedure DeepScan_RulesToggleSurvivesReseed
            Handle ho
            tDeepScanRule[] aSeed aStale aBack
            String sPath
            Integer iTrimNo i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aSeed
            // Find the trim rule's DS number and build a STALE 1-row file that DISABLES it.
            Move 0 to iTrimNo
            For i from 0 to (SizeOfArray(aSeed) - 1)
                If (aSeed[i].sToken = "trim") ;
                    Move aSeed[i].iDSNumber to iTrimNo
            Loop
            Move aSeed[0] to aStale[0]
            Move iTrimNo to aStale[0].iDSNumber
            Move False   to aStale[0].bEnabled
            Get psUnitTestScratchDeepScanPath to sPath
            // Write it as a version-0 (stale) file so Load reseeds + merges.
            Send WriteStaleDeepScanRules of ho aStale sPath
            Get LoadDeepScanRules of ho sPath to aBack
            Send Destroy of ho
            // Full seed came back...
            Send AssertIAreEqual (SizeOfArray(aSeed)) (SizeOfArray(aBack))
            // ...and the trim rule is now DISABLED (the user's stale toggle merged in).
            For i from 0 to (SizeOfArray(aBack) - 1)
                If (aBack[i].iDSNumber = iTrimNo) ;
                    Send Assert (aBack[i].bEnabled = False)
            Loop
            Move (rfDeleteFile(sPath)) to i
        End_Procedure

        // Catalog sanity: well over 100 rules seeded; a spot-checked route is intact.
        { Published = True }
        Procedure DeepScan_CatalogSpotCheck
            Handle ho
            tDeepScanRule[] aRules
            Integer i iSize
            Boolean bFound

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send Destroy of ho
            Move (SizeOfArray(aRules)) to iSize
            Send Assert (iSize > 120)
            Move False to bFound
            For i from 0 to (iSize - 1)
                If (aRules[i].sToken = "trim" and aRules[i].sRefactorFn = "ChangeTrimCommandToFunction" and aRules[i].eCategory = eModAutoFix and aRules[i].bEnabled = True) ;
                    Move True to bFound
            Loop
            Send Assert (bFound = True)
        End_Procedure

        // v14: the legacy Get_File_Exists GET-CALL routes to its converter; the modern File_Exist
        // command, the expression-form call (which the converter deliberately refuses - not
        // line-local) and a commented line all stay quiet.
        { Published = True }
        Procedure DeepScan_GetFileExistsRouted
            String[] asCode
            tDeepScanHit[] aHits

            Move 'Get Get_File_Exists sFile to iRet'    to asCode[0]  // Get-call -> hit
            Move '    Get Get_file_exists sDir to bOk'  to asCode[1]  // indented + mixed case -> hit
            Move 'File_Exist sFile bOk'                 to asCode[2]  // modern command -> clean
            Move 'Move (Get_File_Exists(sF)) to iRet'   to asCode[3]  // expression form -> clean
            Move '// Get Get_File_Exists sFile to iRet' to asCode[4]  // comment -> clean
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeGetFileExistsToFileExist" to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
            Send Assert (aHits[0].eCategory = eModAutoFix)
        End_Procedure

        // ---- Incremental scan cache (ValidateScanCache / ScanFileCached) ----------------

        // A scratch SOURCE file for the cache tests (never a real workspace file).
        Function psUnitTestScratchSourcePath Returns String
            String sDataPath
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Function_Return (sDataPath + "_DeepScanCacheTest.tmp")
        End_Function

        // Helper: (over)write the scratch source file. Plain 7-bit lines through a raw
        // output channel, so rfReadEncodedFileAsStringArray's encoding sniff never matters.
        Procedure _WriteScratchSource String sPath String[] asLines
            Integer iCh i
            String sLine
            Get rfOpenOutput sPath to iCh
            If (iCh < 0) ;
                Procedure_Return
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move asLines[i] to sLine
                Writeln channel iCh sLine
            Loop
            Send rfCloseOutput iCh
        End_Procedure

        // The cache serves an UNCHANGED file from its entry (no re-read), and a rewrite
        // invalidates it. The rewrite also changes the SIZE on purpose: two writes can land
        // in the same mtime tick, and the size belt is what makes the test deterministic.
        { Published = True }
        Procedure DeepScan_CacheReusesUnchangedFileAndSeesEdits
            Handle ho
            String sPath
            String[] asLines asLines2
            tDeepScanRule[] aRules
            tDeepScanCache Cache
            tDeepScanHit[] aHits
            Boolean bFromCache bVoid

            Get psUnitTestScratchSourcePath to sPath
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Send ValidateScanCache of ho (&aRules) (&Cache)
            Move 'Use paytype' to asLines[0]
            Send _WriteScratchSource sPath asLines
            // First scan: a real read+scan (miss) that finds the bare-Use hit.
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = False)
            Get _HitsForFn aHits "AddUseFileExtension" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            // Unchanged file -> served from the cache, identical hits.
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = True)
            Get _HitsForFn aHits "AddUseFileExtension" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            // "Fix" the file (extension added; padding line changes the size) -> the entry
            // is stale, the file re-scans, and the finding is gone.
            Move 'Use paytype.dd'                             to asLines2[0]
            Move '// padding so the rewrite changes the size' to asLines2[1]
            Send _WriteScratchSource sPath asLines2
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = False)
            Get _HitsForFn aHits "AddUseFileExtension" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
            // Upsert stayed IN PLACE: still exactly one entry, arrays parallel.
            Send AssertIAreEqual 1 (SizeOfArray(Cache.aEntries))
            Send AssertIAreEqual 1 (SizeOfArray(Cache.asPathsLow))
            Send Destroy of ho
            Move (rfDeleteFile(sPath)) to bVoid
        End_Procedure

        // ANY rules change flushes the whole cache (a toggle changes what ScanLines would
        // return for UNCHANGED files, so per-file freshness cannot save the entries);
        // re-validating with the SAME rules keeps them.
        { Published = True }
        Procedure DeepScan_CacheFlushedWhenRulesChange
            Handle ho
            String sPath
            String[] asLines
            tDeepScanRule[] aRules
            tDeepScanCache Cache
            tDeepScanHit[] aHits
            Boolean bFromCache bVoid

            Get psUnitTestScratchSourcePath to sPath
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Move 'Use paytype' to asLines[0]
            Send _WriteScratchSource sPath asLines
            Send ValidateScanCache of ho (&aRules) (&Cache)
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = False)
            // Same rules re-validated -> the entry survives and serves.
            Send ValidateScanCache of ho (&aRules) (&Cache)
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = True)
            // A toggle -> full flush -> the unchanged file re-scans.
            Move (not(aRules[0].bEnabled)) to aRules[0].bEnabled
            Send ValidateScanCache of ho (&aRules) (&Cache)
            Send AssertIAreEqual 0 (SizeOfArray(Cache.aEntries))
            Send AssertIAreEqual 0 (SizeOfArray(Cache.asPathsLow))
            Get ScanFileCached of ho sPath (&aRules) (&Cache) (&bFromCache) to aHits
            Send Assert (bFromCache = False)
            Send Destroy of ho
            Move (rfDeleteFile(sPath)) to bVoid
        End_Procedure


        /* v23 - symbols DELETED from the install, where the compiler lane goes quiet or unhelpful.

           THE NEGATIVE ASSERTIONS ARE THE POINT. Every one of these tokens has a modern look-alike
           that must NOT flag: cIniFile's own ReadString method is the recommended replacement for
           GetPrivateProfileString and appears on lines that mention neither, while the Windows API
           names GetPrivateProfileStringW / ...A are DIFFERENT WORDS and stay clean on whole-word
           matching - a substring match would flag every External_Function declaration that already
           does the right thing, including the one inside DFRefactor's own cIniFile usage. */
        {Published = True}
        Procedure DeepScan_WithdrawnSymbolsFlagged
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move "Move (ConvertToClient(typeNumber, iX)) to sOut"   to asCode[0]   // DF26 withdrawal -> hit
            Move "Move (ConvertFromClient(eType, sVal)) to sOut"    to asCode[1]   // DF26 withdrawal -> hit
            Move "Get GetPrivateProfileString sSec sKey to sVal"    to asCode[2]   // DF26 withdrawal -> hit
            Move "Get ReadString of hoIni sSec sKey to sVal"        to asCode[3]   // the REPLACEMENT -> clean
            Move "// ConvertToClient is gone in DF26"               to asCode[4]   // comment -> clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "ConvertToClient function" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].eCategory = eModExplain)
            Get _HitsForSymbol aAll "ConvertFromClient function" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Get _HitsForSymbol aAll "GetPrivateProfileString" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 3)
        End_Procedure

        /* The Flexcom family. Three SEPARATE rules rather than one "flexcom" token, because
           whole-word matching is what keeps these honest: "flexcom" does not match "FlexcomWA",
           so a single rule would leave the WA package silently uncovered - the exact silence
           these rules exist to end. */
        {Published = True}
        Procedure DeepScan_FlexcomFamilyEachCoveredSeparately
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move "Use Flexcom.pkg"    to asCode[0]
            Move "Use FlexcomWA.pkg"  to asCode[1]
            Move "Use Fole_api.pkg"   to asCode[2]
            Move "Use cCJGrid.pkg"    to asCode[3]   // unrelated -> clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "Flexcom.pkg" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Get _HitsForSymbol aAll "FlexcomWA.pkg" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Get _HitsForSymbol aAll "Fole_api.pkg" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 3)
        End_Procedure

        // ---- DF 23 block comments (2026-08-16, found while writing this fixture's new tests) --------
        // _CodeOnlyLine is per-line and knows '//' and quotes only. The scanner blanks '/* ... */' lines
        // itself, on the lexer's own line-level contract, so a legacy command inside a block comment is
        // never promised as an Auto-fix that the converter - whose lexer skips those lines - then refuses.

        // The body of a multi-line block comment never matches; the code after '*/' still does.
        { Published = True }
        Procedure DeepScan_BlockCommentBodyNeverMatches
            String[] asCode
            tDeepScanHit[] aHits
            Move '/* The old way was:'          to asCode[0]
            Move '    Insert sA in sB at 3'     to asCode[1]   // inside the block - clean
            Move '   and it worked. */'         to asCode[2]   // the closing line is a comment line too
            Move 'Insert sC in sD at 4'         to asCode[3]   // real code - hit (line 4)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 4)
            Send Assert (aHits[0].sRefactorFn = "ChangeInsertCommandToFunction")
        End_Procedure

        // A one-line '/* ... */' opens AND closes: nothing sticks to the lines below (WinServ's IDE
        // marker - the case that once made every converter below it skip). And a trailing '/* note */'
        // on a code line makes that WHOLE line a comment line to the lexer, so the scan gives the same
        // verdict rather than promising a fix the converter will skip.
        { Published = True }
        Procedure DeepScan_OneLineBlockCommentDoesNotStick
            String[] asCode
            tDeepScanHit[] aHits
            Move '/* Do NOT REMOVE THIS LINE: IDE GENERATED CODE WILL GO HERE */' to asCode[0]
            Move 'Insert sA in sB at 3'                     to asCode[1]   // hit (line 2)
            Move 'Insert sC in sD at 4 /* legacy, keep */'  to asCode[2]   // a comment line to the lexer - clean
            Move 'Insert sE in sF at 5'                     to asCode[3]   // hit (line 4)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
            Send Assert (aHits[1].iLine = 4)
        End_Procedure

        // A '/*' inside a string literal opens nothing (the lexer's own regression: an HTTP "*/*"
        // accept header once put every line below it into a comment).
        { Published = True }
        Procedure DeepScan_BlockCommentStartInsideLiteralIgnored
            String[] asCode
            tDeepScanHit[] aHits
            Move 'Set psAcceptTypes of hoHttp to "*/*"' to asCode[0]
            Move 'Insert sA in sB at 3'                 to asCode[1]   // hit (line 2)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 2)
        End_Procedure

        // A legacy report image ends with '/*' - an IMAGE end, not a block-comment start. The image body
        // stays skipped, and the code after the '/*' is still scanned (image state is tracked before the
        // block-comment test, or this '/*' would blank the rest of the file).
        { Published = True }
        Procedure DeepScan_ImageEndSlashStarIsNotABlockComment
            String[] asCode
            tDeepScanHit[] aHits
            Move '/PageTop'                  to asCode[0]
            Move 'Insert sX in sY at 1'      to asCode[1]   // image TEXT - never a hit
            Move '/*'                        to asCode[2]   // image END
            Move 'Insert sA in sB at 3'      to asCode[3]   // hit (line 4)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 4)
        End_Procedure

        // GUARD B reads the CACHED code-only lines, so a '!' inside a block comment is not a macro
        // invocation: the procedure is scanned normally instead of being skipped whole.
        { Published = True }
        Procedure DeepScan_BangInsideBlockCommentIsNotAMacroCall
            String[] asCode
            String sBang
            tDeepScanHit[] aHits
            Move (Character(33)) to sBang
            Move 'procedure do_it'                             to asCode[0]
            Move ('/* was: ' + sBang + 'A [] $20A img */')      to asCode[1]   // a '!' in a comment
            Move '    Insert sA in sB at 3'                    to asCode[2]   // hit (line 3)
            Move 'end_procedure'                                to asCode[3]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 3)
        End_Procedure

        // ---- shapes the guards do not mention -----------------------------------------------------

        // Empty input and an empty catalog are both answered with no hits and no fault.
        { Published = True }
        Procedure DeepScan_EmptyInputAndEmptyCatalog
            Handle ho
            String[] asNone asCode
            tDeepScanRule[] aNoRules aRules
            tDeepScanHit[] aHits
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asNone) (&aRules) to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
            Move 'Insert sA in sB at 3' to asCode[0]
            Get ScanLines of ho (&asCode) (&aNoRules) to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
            Send Destroy of ho
        End_Procedure

        // Command-position matching is case-insensitive and indentation-blind - including a TAB indent,
        // which the DF 18 sources use throughout.
        { Published = True }
        Procedure DeepScan_CommandMatchIsCaseAndIndentBlind
            String[] asCode
            tDeepScanHit[] aHits
            Move 'INSERT sA IN sB AT 3'                          to asCode[0]   // hit (line 1)
            Move ((Character(9)) + 'insert sC in sD at 4')      to asCode[1]   // TAB-indented - hit (line 2)
            Move 'Move sInsert to sX'                            to asCode[2]   // not in command position - clean
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeInsertCommandToFunction" to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
        End_Procedure

        // While and Until are condition lines like If - their legacy comparison operators flag; the
        // Repeat that opens the loop has no operator and stays clean.
        { Published = True }
        Procedure DeepScan_WhileAndUntilAreConditionLines
            String[] asCode
            tDeepScanHit[] aHits

            Move 'While iX lt iMax'      to asCode[0]   // hit (line 1)
            Move '    Increment iX'      to asCode[1]
            Move 'Loop'                  to asCode[2]
            Move 'Repeat'                to asCode[3]
            Move '    Increment iX'      to asCode[4]
            Move 'Until iX ge iMax'      to asCode[5]   // hit (line 6)
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeLegacyOperators" to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 6)
        End_Procedure

        // A LEGACY CONDITIONAL PREFIX in front of an Indicate (Nils 2026-09-17, a 2005-era file): the
        // bracket-Indicate form the converter rewrites raised NO row - '[found]' was word 1, so neither the
        // Indicate rule (command position) nor the comparison rules (condition lines) saw the line, and once
        // the file's other rows were spent the plan was empty. Both rules fire now, bracketed or not, and the
        // continuation line of a split statement is still no condition line of its own.
        { Published = True }
        Procedure DeepScan_BracketIndicateIsCommandAndConditionLine
            String[] asCode
            tDeepScanHit[] aAll aInd aEq

            Move '    [ found] indicate found as ((Invoice.item eq xit) and ;' to asCode[0]   // Indicate + EQ (line 1)
            Move '                (Invoice.colour eq xco))'                      to asCode[1]   // continuation - no row
            Move '    [~found] Indicate hittat as Invoice.kind ne "X"'            to asCode[2]   // Indicate + NE (line 3)
            Move '    Indicate found as (Invoice.item eq xit)'                    to asCode[3]   // plain command position (line 4)
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeLegacyIndicators"         to aInd
            Get _HitsForFn aAll "ChangeLegacyOperators"          to aEq
            Send AssertIAreEqual 3 (SizeOfArray(aInd))
            Send Assert (aInd[0].iLine = 1)
            Send Assert (aInd[1].iLine = 3)
            Send Assert (aInd[2].iLine = 4)
            Send AssertIAreEqual 3 (SizeOfArray(aEq))
            Send Assert (aEq[0].iLine = 1)
            Send Assert (aEq[1].iLine = 3)
            Send Assert (aEq[2].iLine = 4)
        End_Procedure

        // ...and Ind, Indicate's obsolete spelling, behind a bracket (rules v89, GitHub 2026-10-06 - a DataFlex
        // 3.2 program): '[ found] ind found as ...' raised no row while a bare 'ind ...' raised the Ind command
        // row. Both do now, and a variable named ind behind a bracket is no command.
        { Published = True }
        Procedure DeepScan_BracketIndIsCommandPosition
            String[] asCode
            tDeepScanHit[] aAll aInd

            Move '    [ found] ind found as Invoice.Id eq code#' to asCode[0]   // Ind behind a bracket (line 1)
            Move '    ind ready True'                           to asCode[1]   // plain command position (line 2)
            Move '    [found] Move ind to iCount'               to asCode[2]   // a variable named ind - no row
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeLegacyIndicators" to aInd
            Send AssertIAreEqual 2 (SizeOfArray(aInd))
            Send Assert (aInd[0].iLine = 1)
            Send Assert (aInd[1].iLine = 2)
        End_Procedure

        // ...and an Else in front of an Indicate, an Ind or a bracket (rules v90, Nils 2026-10-06): 'Else
        // Indicate X False' raised no row. The statement after the Else is read as it would be alone now -
        // the condition rule sees the 'as' side behind '[found]' too - and an 'Else Begin' raises nothing.
        { Published = True }
        Procedure DeepScan_ElseIndicateIsCommandPosition
            String[] asCode
            tDeepScanHit[] aAll aInd aOps

            Move '    Else Indicate ready False'                       to asCode[0]   // Indicate (line 1)
            Move '    else ind ready True'                             to asCode[1]   // Ind (line 2)
            Move '    Else [found] Indicate ready as Invoice.Qty gt 0' to asCode[2]   // Indicate + GT (line 3)
            Move '    Else Begin'                                      to asCode[3]   // nothing
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeLegacyIndicators" to aInd
            Get _HitsForFn aAll "ChangeLegacyOperators"  to aOps
            Send AssertIAreEqual 3 (SizeOfArray(aInd))
            Send Assert (aInd[0].iLine = 1)
            Send Assert (aInd[1].iLine = 2)
            Send Assert (aInd[2].iLine = 3)
            Send AssertIAreEqual 1 (SizeOfArray(aOps))
            Send Assert (aOps[0].iLine = 3)
        End_Procedure

        // THE Y2K TRIPLET (rules v75, Nils 2026-09-18): the old Studio wrote three Set_Attribute lines
        // into every new program and only DF_SYSDATE_4_STATE was catalogued. All three raise a row
        // routed to CommentOutLegacyDateAttributes now - the override shape too ('to False'), because
        // the SCAN lists the line and the analyzer's dry-run is what decides Auto-fix against Explain.
        // One assertion per line, so a rule that goes missing fails by its line.
        { Published = True }
        Procedure DeepScan_LegacyDateTripletEveryLineRaisesARow
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '    Set_Attribute DF_SYSDATE_4_STATE To True'  to asCode[0]
            Move '    Set_Attribute DF_DATE_4_STATE To False'    to asCode[1]
            Move '    Set_Attribute DF_EPOCH_VALUE To 30'        to asCode[2]
            Move '    Move (CurrentDateTime()) to dToday'        to asCode[3]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "CommentOutLegacyDateAttributes" to aHits
            Send AssertIAreEqual 3 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[1].iLine = 2)
            Send Assert (aHits[2].iLine = 3)
            Send AssertSAreEqual "DF_SYSDATE_4_STATE" aHits[0].sSymbol
            Send AssertSAreEqual "DF_DATE_4_STATE"    aHits[1].sSymbol
            Send AssertSAreEqual "DF_EPOCH_VALUE"     aHits[2].sSymbol
        End_Procedure

        // Two different rules on ONE line yield two hits, both carrying that line number - and the hit
        // records the rule's identity (symbol, DS number, function) verbatim.
        { Published = True }
        Procedure DeepScan_TwoRulesOnOneLineGiveTwoHits
            String[] asCode
            tDeepScanHit[] aAll aEq aIn

            Move 'If sName in sList eq 1 Begin' to asCode[0]   // IN and EQ on the same condition line
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeInToContains"    to aIn
            Get _HitsForFn aAll "ChangeLegacyOperators" to aEq
            Send AssertIAreEqual 1 (SizeOfArray(aIn))
            Send AssertIAreEqual 1 (SizeOfArray(aEq))
            Send Assert (aIn[0].iLine = 1)
            Send Assert (aEq[0].iLine = 1)
            Send AssertSAreEqual "IN comparison" aIn[0].sSymbol
            Send AssertSAreEqual "EQ comparison" aEq[0].sSymbol
            Send Assert (aIn[0].iDSNumber >= CI_DeepScanFirstDSNumber)
            Send Assert (aEq[0].iDSNumber >= CI_DeepScanFirstDSNumber)
            Send Assert (aIn[0].iDSNumber <> aEq[0].iDSNumber)
        End_Procedure

        // DSCategoryText: the three labels the grid shows for a hit, and "Explain" for anything else.
        { Published = True }
        Procedure DeepScan_CategoryTextLabels
            Handle ho
            String sAuto sReview sExplain sOther
            Get Create (RefClass(cDeepScanner)) to ho
            Get DSCategoryText of ho eModAutoFix to sAuto
            Get DSCategoryText of ho eModSuggest to sReview
            Get DSCategoryText of ho eModExplain to sExplain
            Get DSCategoryText of ho 999         to sOther
            Send Destroy of ho
            Send AssertSAreEqual "Auto-fix" sAuto
            Send AssertSAreEqual "Review"   sReview
            Send AssertSAreEqual "Explain"  sExplain
            Send AssertSAreEqual "Explain"  sOther
        End_Procedure

        // A rules file that is missing, or is not JSON at all, reads as the EMPTY struct - never a fault,
        // never a half-filled catalog (LoadDeepScanRules then reseeds from the defaults).
        { Published = True }
        Procedure DeepScan_UnreadableRulesFileIsEmpty
            Handle ho
            Integer iVoid iCh
            String sPath
            tDeepScanRulesFile RulesFile

            Get psUnitTestScratchDeepScanPath to sPath
            Move (rfDeleteFile(sPath)) to iVoid
            Get Create (RefClass(cDeepScanner)) to ho
            Get _ReadDeepScanRulesFile of ho sPath to RulesFile          // missing
            Send AssertIAreEqual 0 (SizeOfArray(RulesFile.aRules))
            Send AssertIAreEqual 0 RulesFile.iVersion
            Get rfOpenOutput sPath to iCh
            Send Assert (iCh >= 0)
            Write channel iCh "this is not json {"
            Send rfCloseOutput iCh
            Get _ReadDeepScanRulesFile of ho sPath to RulesFile          // garbage
            Send AssertIAreEqual 0 (SizeOfArray(RulesFile.aRules))
            Send AssertIAreEqual 0 RulesFile.iVersion
            Send Destroy of ho
            Move (rfDeleteFile(sPath)) to iVoid
        End_Procedure


        /* ---- DS 9218, the Overloaded method rule (v28) -----------------------------------------
           The one rule here that fires on something PERFECTLY LEGAL. An overloaded name compiles
           and runs; DataFlex resolves it by parameter count, so its variants may legally return
           different types and it can never raise 4544 (measured on DF26, 2026-08-23). It is a
           Suggest because the DataFlex documentation calls the technique obsolete, not because
           anything is wrong - so the look-alike half of these tests matters more than usual: a
           false positive here would send someone chasing a defect that does not exist.

           The word also appears throughout DFRefactor's own source, in identifiers, comments and
           string literals, which makes this workspace its own worst case. */

        // The legacy form HITS, and routes to the report that lists the sets.
        { Published = True }
        Procedure DeepScan_OverloadedMethodHits
            String[] asCode
            tDeepScanHit[] aHits
            Move "    Function Foo Overloaded String sVal Returns String" to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "FunctionReturnMismatchReport" to aHits
            Send Assert (SizeOfArray(aHits) = 1)
            Send Assert (aHits[0].iDSNumber = 9218)
        End_Procedure

        // A Procedure carries the token too - overloading is not a Function-only technique.
        { Published = True }
        Procedure DeepScan_OverloadedProcedureHits
            String[] asCode
            tDeepScanHit[] aHits
            Move "    Procedure Foo Overloaded String sVal" to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "FunctionReturnMismatchReport" to aHits
            Send Assert (SizeOfArray(aHits) = 1)
        End_Procedure

        // LOOK-ALIKE: an identifier that merely CONTAINS the word is not a hit. bOverloaded is a
        // real field on tNameDecl and _NameIsOverloadedInLines a real function, both added by the
        // same work as this rule - so a bare substring search would flag its own source.
        { Published = True }
        Procedure DeepScan_OverloadedInsideIdentifierIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits
            Move "        Boolean bOverloaded"                                to asCode[0]
            Move "        Move bOverloaded to aOut[k].bOverloaded"            to asCode[1]
            Move "        Get _NameIsOverloadedInLines asLines sName to bOvl" to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "FunctionReturnMismatchReport" to aHits
            Send Assert (SizeOfArray(aHits) = 0)
        End_Procedure

        // LOOK-ALIKE: the word in a COMMENT or a STRING LITERAL is not code.
        { Published = True }
        Procedure DeepScan_OverloadedInCommentOrLiteralIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits
            Move "        // this method is overloaded on purpose"        to asCode[0]
            Move ("        If (Lowercase(asWords[iW]) = " + Character(34) + "overloaded" + Character(34) + ") ;") to asCode[1]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "FunctionReturnMismatchReport" to aHits
            Send Assert (SizeOfArray(aHits) = 0)
        End_Procedure

        /* DS 9219 - the x64 declaration bug the compiler never reports. GetObjectA is catalogued
           and its third parameter is an LPVOID, so an Integer there is the truncating-pointer bug.
           The rule asks the converter's own decision function, so a hit is by construction a line
           ConvertWinAPIDeclarationTypes would change. */
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_LegacyDeclarationHits
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Integer pv Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 9219 aMine[0].iDSNumber
            Send AssertIAreEqual 1 aMine[0].iLine
        End_Procedure

        /* DS 9219 REACHES A BARE ENTRY POINT THROUGH A MEASURED ALIAS ROW (2026-09-12). shell32
           exports ShellExecuteEx at ShellExecuteExA's address, the catalogue carries that row under
           the bare key, and the declaration below types the SHELLEXECUTEINFO pointer as an Integer -
           the truncating-pointer bug on x64. Legacy code writes the bare spelling, so this is the
           shape the rule has to reach. */
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_BareAliasIsReached
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function ZZExecInfo "ShellExecuteEx" Shell32.dll Integer pExecInfo Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 9219 aMine[0].iDSNumber
        End_Procedure

        /* ...AND STAYS SILENT ON A BARE NAME THAT BINDS THE WIDE TWIN. kernel32's bare ReplaceFile
           resolves to ReplaceFileW, so no alias row was measured for it and the lookup finds
           nothing. It used to answer with ReplaceFileA and judge a wide binding by ANSI types.
           Silence is the honest verdict here: retyping this declaration means deciding to move the
           call to wide marshalling, which is not this converter's decision to make. */
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_WideBoundBareNameIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function ZZReplace "ReplaceFile" kernel32.dll String lpReplaced String lpReplacement String lpBackup Integer dwFlags Integer lpExclude Integer lpReserved Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 0 (SizeOfArray(aMine))
        End_Procedure

        // THE MODERN LOOK-ALIKE MUST NOT HIT: the same declaration already correctly typed. Without
        // this the rule would flag every catalogued declaration, correct ones included, and the
        // grid would be telling people to fix what is already right.
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_CorrectDeclarationIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function GetObject "GetObjectA" gdi32.dll Handle h Integer c Pointer pv Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 0 (SizeOfArray(aMine))
        End_Procedure

        /* THE CONTINUATION CASE, which is why this kind reads past its own line. The types of a
           real declaration usually sit on ";"-continued lines - Winuser.pkg writes every one that
           way - so a first-line-only rule would miss most of them. */
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_JoinsContinuedDeclaration
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function GetObject "GetObjectA" gdi32.dll ;' to asCode[0]
            Move '    Handle h Integer c Integer pv ;'                  to asCode[1]
            Move '    Returns Integer'                                  to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            // Reported against the line the declaration STARTS on, which is where a reader looks.
            Send AssertIAreEqual 1 aMine[0].iLine
        End_Procedure

        // An API the catalogue does not cover is not a hit. 687 of the 1,310 seen in the wild are
        // uncatalogued, and flagging those would bury the ones this can actually fix.
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_UncataloguedApiIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function NoSuchApi "NoSuchEntryPoint" nosuch.dll Integer x Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 0 (SizeOfArray(aMine))
        End_Procedure

        // The four whose entry point changes by bitness are not this rule's business - they need
        // both arms guarded, which this converter refuses and therefore must not advertise.
        {Published = True}
        Procedure DeepScan_ApiDeclTypes_BitnessFamilyIsNotAHit
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function GetWindowLongPtr "GetWindowLongW" User32.dll Handle hWnd Integer offset Returns Integer' to asCode[0]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ConvertWinAPIDeclarationTypes" to aMine
            Send AssertIAreEqual 0 (SizeOfArray(aMine))
        End_Procedure

        /* THE FLEXCOM BLOCKER (2026-08-27). The 2007 form hits; the modern FlexCOM20 look-alike
           does not - the token's dot is the whole distinction, and it is the same one the
           engine's halt relies on. */
        {Published = True}
        Procedure DeepScan_FlexComUseHits
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'Use FlexCOM.pkg' to asCode[0]
            Get ScanSnippet asCode to aHits
            Move False to bFound
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9220) ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        Procedure DeepScan_FlexCom20DoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast iHits9220
            /* Both forms in ONE snippet, so this carries its own positive control: the 2007
               form on line 2 MUST hit, which a scan returning nothing cannot fake. The old
               form scanned FlexCOM20 alone and asserted inside the loop, so it passed with
               zero assertions - and would have passed just as quietly if ScanSnippet had
               stopped matching anything at all. */
            Move 'Use FlexCOM20.pkg' to asCode[0]
            Move 'Use FlexCOM.pkg'   to asCode[1]
            Get ScanSnippet asCode to aHits
            Move 0 to iHits9220
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9220) Begin
                    Increment iHits9220
                    // the dot is the whole distinction - line 2, never line 1
                    Send AssertIAreEqual 2 aHits[i].iLine
                End
            Loop
            Send AssertIAreEqual 1 iHits9220
        End_Procedure

        /* THE HALT'S OWN DETECTOR, narrow on purpose - a false positive blocks a whole workspace.
           A comment or a string literal mentioning FlexCOM.pkg is not a dependency, and
           FlexCOM20 is not FlexCOM. */
        {Published = True}
        Procedure FlexComHalt_DetectorIsNarrow
            String[] asCode
            Integer iAt
            Move '// generated 2007'          to asCode[0]
            Move 'Use FlexCOM.pkg'            to asCode[1]
            Get LineUsingRetiredFlexCom of ghoFuncLib (&asCode) to iAt
            Send AssertIAreEqual 2 iAt
            // case-insensitive and tab-tolerant, like the compiler
            Move (Character(9) + 'USE FLEXCOM.PKG') to asCode[1]
            Get LineUsingRetiredFlexCom of ghoFuncLib (&asCode) to iAt
            Send AssertIAreEqual 2 iAt
            // the three shapes that must NOT halt a workspace
            Move '// Use FlexCOM.pkg'                 to asCode[1]
            Get LineUsingRetiredFlexCom of ghoFuncLib (&asCode) to iAt
            Send AssertIAreEqual 0 iAt
            Move 'Move "Use FlexCOM.pkg" to sHelp'    to asCode[1]
            Get LineUsingRetiredFlexCom of ghoFuncLib (&asCode) to iAt
            Send AssertIAreEqual 0 iAt
            Move 'Use FlexCOM20.pkg'                  to asCode[1]
            Get LineUsingRetiredFlexCom of ghoFuncLib (&asCode) to iAt
            Send AssertIAreEqual 0 iAt
        End_Procedure

        /* DS 9221 - the ANSI declaration whose wide twin the catalogue holds (2026-08-28). The
           rule that finally surfaces GuardAnsiExternalFunctionWithWide: it had no recipe and no
           scan rule, so the agreed A-to-W pair was reachable only from the manual picker. */
        /* FULL ARITY, deliberately (2026-08-31). This fixture used to declare ONE parameter for
           a six-parameter API - a shape the converter now refuses, because pairing it emitted a
           1-argument ANSI arm beside a 6-argument wide one under the same name. The rule asks the
           converter whether it could act, so the fixture has to be a declaration it CAN act on. */
        {Published = True}
        Procedure DeepScan_AnsiWithWideTwinHits
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[0]
            Move '    Handle hWnd ;'            to asCode[1]
            Move '    String lpOperation ;'     to asCode[2]
            Move '    String lpFile ;'          to asCode[3]
            Move '    String lpParameters ;'    to asCode[4]
            Move '    String lpDirectory ;'     to asCode[5]
            Move '    Integer nShowCmd ;'       to asCode[6]
            Move '    Returns Handle'           to asCode[7]
            Get ScanSnippet asCode to aHits
            Move False to bFound
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        // A W entry is already wide - nothing to offer. And an A entry with NO catalogued twin
        // has nothing to build the arm from, which is a skip, not a hit.
        {Published = True}
        Procedure DeepScan_WideOrTwinlessDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'External_Function efShellExecute "ShellExecuteW" shell32.dll Handle hWnd Returns Handle' to asCode[0]
            Move 'External_Function NoTwin "NoSuchApiA" nosuch.dll Integer x Returns Integer'              to asCode[1]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        // Already guarded - by the converter's own #IF, or inside IS$WIN64 - means already
        // managed: flagging it would report the very pair the fix emits.
        {Published = True}
        Procedure DeepScan_GuardedAnsiDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move (Character(35) + 'IF (' + Character(33) + '@ < 260)')            to asCode[0]
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[1]
            Move '    Returns Handle'                                             to asCode[2]
            Move (Character(35) + 'ELSE')                                         to asCode[3]
            Move 'External_Function efShellExecute "ShellExecuteW" shell32.dll ;' to asCode[4]
            Move '    Returns Handle'                                             to asCode[5]
            Move (Character(35) + 'ENDIF')                                        to asCode[6]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        /* DS 9224 - the legacy Type buffer that has a shipped Struct. The rule exists because the
           ZeroType/Put/GetBuff rules all route to a REPORT, so a workspace's byte-buffer clusters
           came back offering nothing but Ignore (Nils 2026-08-31). It must fire exactly where
           ChangeLegacyTypeToWinStruct would act - the third time today that a row and its run had
           to be made one decision rather than two. */
        /* DS 9224 verifies against the TARGET install, and the runner has none - so without this
           the rule refuses everything and the two negative tests below would pass over a rule that
           never fires at all. Point the catalogue at a fixture, exactly as the Tier-2 unit tests do.
           See psWinStructPkgOverride. */
        Procedure DS9224_Catalog
            String sPath
            Integer iCh
            // In the Windows TEMP folder since 2026-10-05, not in the workspace's Data folder as before (Nils:
            // "I saw them in the Data folder and thought they had landed in the wrong folder"). The file stays
            // on disk after the run - the catalogue reads it when it is first asked - and Data is the folder
            // a deploy zip is made from. vFolderFormat gives the separator whatever the API hands back.
            // vGetTempPath is a method of the Desktop, not a global function: called with no object it
            // compiles and answers nothing.
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_tWinStructsScan.pkg") to sPath
            Get rfOpenOutput sPath to iCh
            If (iCh < 0) ;
                Procedure_Return
            Writeln channel iCh "Struct tWinPOINT"
            Writeln channel iCh "    Integer x"
            Writeln channel iCh "    Integer y"
            Writeln channel iCh "End_Struct"
            Send rfCloseOutput iCh
            Set psWinStructPkgOverride   of ghoFuncLib to sPath
            Set pbWinStructCatalogLoaded of ghoFuncLib to False
        End_Procedure

        {Published = True}
        Procedure DeepScan_TypeBufferWithShippedStructHits
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Send DS9224_Catalog
            Move 'Procedure DoIt'                          to asCode[0]
            Move '    String sPt'                          to asCode[1]
            Move '    Integer iY'                          to asCode[2]
            Move '    ZeroType tPOINT to sPt'              to asCode[3]
            Move '    GetBuff from sPt At tPOINT.y to iY'  to asCode[4]
            Move 'End_Procedure'                            to asCode[5]
            Get ScanSnippet asCode to aHits
            Move False to bFound
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9224) ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        // A Type with no shipped Struct is the report's business, not this rule's.
        {Published = True}
        Procedure DeepScan_TypeBufferWithoutTwinDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'Procedure DoIt'                              to asCode[0]
            Move '    String sBuf'                             to asCode[1]
            Move '    Integer iY'                              to asCode[2]
            Move '    ZeroType tRegKeyInfo to sBuf'            to asCode[3]
            Move '    GetBuff from sBuf At tRegKeyInfo.x to iY' to asCode[4]
            Move 'End_Procedure'                                to asCode[5]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9224) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        /* ...and neither is a cluster the converter would REFUSE. A buffer used outside the
           accessors blocks the rewrite, so offering it here would be a Run button that can only
           report back "0 lines". */
        {Published = True}
        Procedure DeepScan_UnconvertibleTypeBufferDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Send DS9224_Catalog
            Move 'Procedure DoIt'                          to asCode[0]
            Move '    String sPt'                          to asCode[1]
            Move '    Integer iY'                          to asCode[2]
            Move '    ZeroType tPOINT to sPt'              to asCode[3]
            Move '    Move (Length(sPt)) to iY'            to asCode[4]
            Move 'End_Procedure'                            to asCode[5]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9224) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        /* A ROW THE RUN CANNOT ACT ON IS NOT A FINDING (Nils 2026-08-31: "we can't have that
           Run the refactoring plan button sit there for ever. There is simply no point of having
           it if it cannot do anything"). A catalogued W twin is necessary and not sufficient -
           the rule now asks GuardAnsiExternalFunctionWithWide's own refusal, so the two shapes
           it declines never reach the board:
             - Pointer where the twin marshals text (the AddressOf convention). This is the DUF
               cDbUpdateUserCount.h.pkg declaration that started it, comments and all.
             - a parameter list that does not line up with the twin. */
        /* THE PAIR THE CONVERTER ACTUALLY WRITES - banner included. DeepScan_GuardedAnsiDoesNotHit
           below omits the banner, and that is the whole difference: _InsideConditionalArm scores a
           bannered gate 2 ("ours, still enterable") precisely so the RETYPER can keep working
           inside the A arm, which means this rule sees the arm as flaggable. If it hits, every
           successful A/W pairing leaves a permanent row with a Run button that can only refuse. */
        {Published = True}
        Procedure DeepScan_OwnEmittedPairDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move (Character(35) + "IFNDEF get_efShellExecute")                                                          to asCode[0]
            Move '// [DFRefactor] ANSI and wide side by side - the compiler picks (DataFlex 26 and later is Unicode).' to asCode[1]
            Move '// Same DataFlex name on both arms, so no call site changes. A buffer handed to the wide'            to asCode[2]
            Move '// entry is WString, not String - check the ones that pass raw memory.'                             to asCode[3]
            Move (Character(35) + "IF (" + Character(33) + "@ < 260)")                                                  to asCode[4]
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[5]
            Move '    Handle hWnd ;'            to asCode[6]
            Move '    String lpOperation ;'     to asCode[7]
            Move '    String lpFile ;'          to asCode[8]
            Move '    String lpParameters ;'    to asCode[9]
            Move '    String lpDirectory ;'     to asCode[10]
            Move '    Integer nShowCmd ;'       to asCode[11]
            Move '    Returns Handle'           to asCode[12]
            Move (Character(35) + "ELSE")        to asCode[13]
            Move 'External_Function efShellExecute "ShellExecuteW" shell32.dll ;' to asCode[14]
            Move '    Handle hWnd ;'            to asCode[15]
            Move '    WString lpOperation ;'    to asCode[16]
            Move '    WString lpFile ;'         to asCode[17]
            Move '    WString lpParameters ;'   to asCode[18]
            Move '    WString lpDirectory ;'    to asCode[19]
            Move '    Integer nShowCmd ;'       to asCode[20]
            Move '    Returns Handle'           to asCode[21]
            Move (Character(35) + "ENDIF")       to asCode[22]
            Move (Character(35) + "ENDIF")       to asCode[23]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        {Published = True}
        Procedure DeepScan_UnpairableAnsiDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'External_Function Win32_CreateFile "CreateFileA" KERNEL32.DLL ;' to asCode[0]
            Move '    Pointer lpFileName ;              // file name'              to asCode[1]
            Move '    DWord dwDesiredAccess ;           // access mode'            to asCode[2]
            Move '    DWord dwShareMode ;               // share mode'             to asCode[3]
            Move '    Pointer lpSecurityAttributes ;    // SD'                     to asCode[4]
            Move '    DWord dwCreationDisposition ;     // how to create'          to asCode[5]
            Move '    DWord dwFlagsAndAttributes ;      // file attributes'        to asCode[6]
            Move '    Handle hTemplateFile ;            // handle to template file' to asCode[7]
            Move '    Returns Handle'                                              to asCode[8]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure

        // The other refusal: fewer local parameters than the twin. Pairing it would emit two arms
        // that take different argument counts under one name.
        {Published = True}
        Procedure DeepScan_ArityMismatchAnsiDoesNotHit
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[0]
            Move '    Handle hWnd ;'                                              to asCode[1]
            Move '    Returns Handle'                                             to asCode[2]
            Get ScanSnippet asCode to aHits
            Move (SizeOfArray(aHits) - 1) to iLast
            Move False to bFound
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9221) ;
                    Move True to bFound
            Loop
            // ONE assertion, outside the loop: with no hits at all the old form
            // ran the loop body zero times and passed having checked nothing.
            Send AssertFalse bFound
        End_Procedure


        /* The Replace COMMAND owns its own 'in' (2026-08-29). 'if (cond) replace "," in sQty
           with "."' is the legacy Replace command behind a one-line If; DS 9041 routed it at
           ChangeInToContains, whose dry-run no-op parked six auto-fixable lines in "needs hand
           migration". The 9041 matcher now declines the shape, the Replace-command rule claims
           it, and a REAL 'in' comparison still lands on 9041 (the positive control). */
        { Published = True }
        Procedure DeepScan_ReplaceCommandRoutesToItsOwnRule
            String[] asCode
            tDeepScanHit[] aAll
            Integer i iLast iReplace iInContains

            Move 'Procedure Test' to asCode[0]
            Move '    if (sSep = ".") replace "," in sQty with "."' to asCode[1]
            Move '    If "abc" in sValue Begin' to asCode[2]
            Move '    End' to asCode[3]
            Move 'End_Procedure' to asCode[4]
            Get ScanSnippet asCode to aAll
            Move 0 to iReplace
            Move 0 to iInContains
            Move (SizeOfArray(aAll) - 1) to iLast
            For i from 0 to iLast
                If (aAll[i].sRefactorFn = "ChangeReplaceCommandToFunction") ;
                    Increment iReplace
                If (aAll[i].sRefactorFn = "ChangeInToContains") Begin
                    Increment iInContains
                    Send AssertIAreEqual 3 aAll[i].iLine
                End
            Loop
            Send AssertIAreEqual 1 iReplace
            Send AssertIAreEqual 1 iInContains
        End_Procedure

        /* Declarations inside conditional VARIANT arms are author-managed (2026-08-29):
           cFilesystem gates whole ANSI/wide batches with #IF (!@ < 200) ... #ELSE ... #ENDIF,
           and both API rules must stay silent there. The #IFNDEF declare-once guard is a
           wrapper, not a variant - a declaration inside it still qualifies (the control). */
        { Published = True }
        Procedure DeepScan_ApiRulesHandsOffInsideVariantArms
            String[] asCode asClean
            tDeepScanHit[] aAll
            Integer i iLast iApi

            Move (Character(35) + 'IF (' + Character(33) + '@ < 200)') to asCode[0]
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" kernel32.dll String f Pointer p Returns Integer' to asCode[1]
            Move (Character(35) + 'ELSE') to asCode[2]
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeW" kernel32.dll String f Pointer p Returns Integer' to asCode[3]
            Move (Character(35) + 'ENDIF') to asCode[4]
            Get ScanSnippet asCode to aAll
            Move 0 to iApi
            Move (SizeOfArray(aAll) - 1) to iLast
            For i from 0 to iLast
                If (aAll[i].sRefactorFn = "GuardAnsiExternalFunctionWithWide" or aAll[i].sRefactorFn = "ConvertWinAPIDeclarationTypes") ;
                    Increment iApi
            Loop
            Send AssertIAreEqual 0 iApi

            Move (Character(35) + 'IFNDEF get_MyGetCompressedFileSize') to asClean[0]
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" kernel32.dll String f Pointer p Returns Integer' to asClean[1]
            Move (Character(35) + 'ENDIF') to asClean[2]
            Get ScanSnippet asClean to aAll
            Move 0 to iApi
            Move (SizeOfArray(aAll) - 1) to iLast
            For i from 0 to iLast
                If (aAll[i].sRefactorFn = "GuardAnsiExternalFunctionWithWide") ;
                    Increment iApi
            Loop
            Send Assert (iApi > 0) "the IFNDEF declare-once guard must stay flaggable - it is a wrapper, not a variant"
        End_Procedure

        /* DS 9225 (v43) - the Win32 Type buffer ChangeExternalFunctionCallers converts.

           The rule exists because that converter shipped on 2026-08-30 and NO rule ever offered
           it: every ZeroType/Put/GetBuff rule routes to a report, so a workspace whose buffers it
           converts perfectly saw "run the report" and Ignore, and nothing else. It reports only
           the lines the run actually removes - it establishes that by running the converter on a
           copy of the file - so the row and the Run cannot disagree.

           These need the real SDK catalogue, since that is what decides whether the converter
           acts, and self-skip without it the way the editor fixtures do in console mode. */
        /* Loads the SDK catalogue AND seeds the install's nested structs.

           Both are needed. The catalogue decides whether the converter recognises the Type at all;
           tWinStructs.pkg decides whether a nested member (MSG's "POINT pt") can be pointed at the
           vendor's declaration or refuses the whole Type. psTargetPkgFolder is blank under the test
           runner - it has no compiler configured - so the real file cannot be read here and
           tWinPoint has to be seeded, exactly as oWin32TypeToStruct's SeedWinStructs does. Without
           it this fixture would assert that a convertible buffer raises no row, which is true in
           the harness and false in the app. */
        Function CatalogueIsLoadable Returns Boolean
            String[] asLines
            String sBody
            Move "Struct tWinPoint"  to asLines[0]
            Move "    Integer x"     to asLines[1]
            Move "    Integer y"     to asLines[2]
            Move "End_Struct"        to asLines[3]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get WinAPIStructBody of ghoFuncLib "MSG" to sBody
            Function_Return (sBody <> "")
        End_Function

        // The reported case: tPrMsg is MSG by member shape, the converter takes it, so the board
        // offers the converter instead of only the report.
        {Published = True}
        Procedure DeepScan_ConvertibleWin32BufferHits
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast
            Boolean bFound
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'Type tPrMsg'                                                to asCode[0]
            Move '    Field tPrMsg.hwnd     as Handle'                        to asCode[1]
            Move '    Field tPrMsg.message  as Integer'                       to asCode[2]
            Move '    Field tPrMsg.wParam   as Integer'                       to asCode[3]
            Move '    Field tPrMsg.lParam   as Integer'                       to asCode[4]
            Move '    Field tPrMsg.Time     as DWord'                         to asCode[5]
            Move '    Field tPrMsg.pt       as Pointer'                       to asCode[6]
            Move 'End_Type'                                                   to asCode[7]
            Move 'Function ProcessMessage Returns Boolean'                    to asCode[8]
            Move '    Pointer lpMsg'                                          to asCode[9]
            Move '    Integer iPendingMessage'                                to asCode[10]
            Move '    String sMsg'                                            to asCode[11]
            Move '    ZeroType tPrMsg to sMsg'                                to asCode[12]
            Move '    Move (AddressOf(sMsg)) to lpMsg'                        to asCode[13]
            Move '    GetBuff from sMsg At tPrMsg.message to iPendingMessage' to asCode[14]
            Move 'End_Function'                                               to asCode[15]
            Get ScanSnippet asCode to aHits
            Move False to bFound
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9225) ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        /* A ROW THE RUN CAN NOW ACT ON. This asserted the OPPOSITE until 2026-09-01: a Type the
           catalogue matches by neither name nor member shape raised no 9225, because offering the
           converter would put a Run button on a line it would decline.

           That held only while the catalogue was a PRECONDITION, and it no longer is. With no SDK
           entry the converter now builds the Struct from the author's OWN member types, which
           preserves the byte layout exactly - see _LegacyStructBodyFromType. So the Run button is
           honoured, and withholding the row is precisely what hid vsWin32ids.pkg: a file whose only
           offer was Ignore until Nils pushed back on it.

           What the fallback does NOT do is correct a member already wrong for 64-bit. The rule's
           tooltip says so outright. That is a reason to word the offer honestly, not to withhold it. */
        {Published = True}
        Procedure DeepScan_UncatalogedWin32BufferNowHits
            String[] asCode
            tDeepScanHit[] aHits
            Boolean bFound
            Integer i iLast
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'Type tNotAnApiStructAtAll'                                to asCode[0]
            Move '    Field tNotAnApiStructAtAll.alpha as Integer'          to asCode[1]
            Move '    Field tNotAnApiStructAtAll.beta  as Integer'          to asCode[2]
            Move '    Field tNotAnApiStructAtAll.gamma as Integer'          to asCode[3]
            Move '    Field tNotAnApiStructAtAll.delta as Integer'          to asCode[4]
            Move 'End_Type'                                                 to asCode[5]
            Move 'Procedure DoIt'                                           to asCode[6]
            Move '    Integer iY'                                           to asCode[7]
            Move '    String sBuf'                                          to asCode[8]
            Move '    ZeroType tNotAnApiStructAtAll to sBuf'                to asCode[9]
            Move '    GetBuff from sBuf At tNotAnApiStructAtAll.alpha to iY' to asCode[10]
            Move 'End_Procedure'                                            to asCode[11]
            Get ScanSnippet asCode to aHits
            Move False to bFound
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9225) ;
                    Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        /* A CLUSTER THE CONVERTER REFUSES, for a reason other than the catalogue, is never an
           AutoFix. A buffer used outside the accessors blocks the whole Type, so the ZeroType line
           survives the run - which is exactly the signal this rule reads.

           Until 2026-09-13 that meant NO row at all, and this test pinned the absence. Now the
           refusal is itself the finding: one Explain row on the ZeroType line, carrying the run's
           own reason, with no function - so there is still no Run button over a line the run would
           decline, and the reader learns what blocked it (see
           DeepScan_DeclinedWin32BufferRaisesOneExplainRowWithTheReason for the full shape). */
        {Published = True}
        Procedure DeepScan_RefusedWin32BufferIsExplainNeverAutoFix
            String[] asCode
            tDeepScanHit[] aHits
            Integer i iLast iMine
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'Type tPrMsg'                                          to asCode[0]
            Move '    Field tPrMsg.hwnd     as Handle'                  to asCode[1]
            Move '    Field tPrMsg.message  as Integer'                 to asCode[2]
            Move '    Field tPrMsg.wParam   as Integer'                 to asCode[3]
            Move '    Field tPrMsg.lParam   as Integer'                 to asCode[4]
            Move '    Field tPrMsg.Time     as DWord'                   to asCode[5]
            Move '    Field tPrMsg.pt       as Pointer'                 to asCode[6]
            Move 'End_Type'                                             to asCode[7]
            Move 'Procedure DoIt'                                       to asCode[8]
            Move '    Integer iY'                                       to asCode[9]
            Move '    String sMsg'                                      to asCode[10]
            Move '    ZeroType tPrMsg to sMsg'                          to asCode[11]
            // a use the converter does not rewrite - it refuses the whole Type over this
            Move '    Move (Length(sMsg)) to iY'                        to asCode[12]
            Move 'End_Procedure'                                        to asCode[13]
            Get ScanSnippet asCode to aHits
            Move 0 to iMine
            Move (SizeOfArray(aHits) - 1) to iLast
            For i from 0 to iLast
                If (aHits[i].iDSNumber = 9225) Begin
                    Increment iMine
                    Send Assert (aHits[i].eCategory = eModExplain)
                    Send AssertSAreEqual "" (aHits[i].sRefactorFn)
                    Send Assert (Pos("Length(sMsg)", aHits[i].sHint) > 0)
                End
            Loop
            Send AssertIAreEqual 1 iMine
        End_Procedure

        /* THE PRE-GATE DECIDES WHETHER A FILE GETS A RUN ROW AT ALL. Before a rule's real test
           runs, a cheap first-word check filters the line - and both AutoFix buffer rules tested
           for "zerotype" alone. A Type buffer zeroed by hand and reached through Put has no such
           line anywhere, so neither rule ever examined the file. The only row it could raise was
           the report-only Put row, whose sole affordance is Ignore.

           Nils asked why the Put did not sound the alarm. It did - the Put rule fires every time
           - but it leads to a report, and the bell that leads to a converter was one this file
           could never ring (2026-09-01). */
        { Published = True }
        Procedure DeepScan_TypeBufferWithoutAZeroTypeLineIsStillExamined
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move "Type __vsdwSize"                                            to asCode[0]
            Move "    Field dwSize as DWord"                                  to asCode[1]
            Move "End_Type"                                                   to asCode[2]
            Move "Function GetIt Returns Integer"                             to asCode[3]
            Move "    String lsSize"                                          to asCode[4]
            Move "    Pointer lpSize"                                         to asCode[5]
            Move "    Move (Repeat(Character(0), __vsdwSize_SIZE)) to lsSize" to asCode[6]
            Move "    Put 16 To lsSize At dwSize"                             to asCode[7]
            Move "    Move (AddressOf(lsSize)) to lpSize"                     to asCode[8]
            Move "End_Function"                                               to asCode[9]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            /* NOT a row COUNT. Folds and multi-match make the number meaningless as an
               assertion; what this pins is that the file is examined at all, which before the
               pre-gate widened it was not - zero rows, no matter how convertible it was. */
            Send Assert (SizeOfArray(aMine) > 0)
        End_Procedure

        /* ONE ROW PER CLUSTER, not one per accessor line.

           The pre-gate used to key on ZeroType alone, and that gave a cluster exactly one
           candidate line for free. Widening it to Put/GetBuff/FillType - so a buffer with no
           ZeroType is seen at all - hands every accessor in the cluster to the matcher, and
           each of them vanishes when the cluster converts. Without the ownership test in
           _RuleMatchesLine that is four rows for one fix.

           Three accessors on one buffer here; the ZeroType is first, so it owns the row. */
        { Published = True }
        Procedure DeepScan_OneRowPerBufferNotOnePerAccessorLine
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move "Type vtBrowseInfo"                                          to asCode[0]
            Move "    Field vtBrowseInfo.hWndOwner      as Handle"            to asCode[1]
            Move "    Field vtBrowseInfo.pIDLRoot       as Pointer"           to asCode[2]
            Move "    Field vtBrowseInfo.pszDisplayName as Pointer"           to asCode[3]
            Move "    Field vtBrowseInfo.lpszTitle      as Pointer"           to asCode[4]
            Move "    Field vtBrowseInfo.ulFlags        as dWord"             to asCode[5]
            Move "    Field vtBrowseInfo.lpfnCallback   as Pointer"           to asCode[6]
            Move "    Field vtBrowseInfo.lParam         as dWord"             to asCode[7]
            Move "    Field vtBrowseInfo.iImage         as dWord"             to asCode[8]
            Move "End_Type"                                                   to asCode[9]
            Move "Function vSHBrowseForFolder Returns String"                 to asCode[10]
            Move "    String sBrowseInfo sTitle"                              to asCode[11]
            Move "    Pointer lpsBrowseInfo"                                  to asCode[12]
            Move "    ZeroType vtBrowseInfo To sBrowseInfo"                   to asCode[13]
            Move "    Put lpsTitle To sBrowseInfo At vtBrowseInfo.lpszTitle"  to asCode[14]
            Move "    Put 0 To sBrowseInfo At vtBrowseInfo.ulFlags"           to asCode[15]
            Move "    GetAddress Of sBrowseInfo To lpsBrowseInfo"             to asCode[16]
            Move "End_Function"                                               to asCode[17]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            // three accessor lines, ONE fix, one row
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
        End_Procedure

        /* A TYPE THE RUN DECLINES GETS ONE EXPLAIN ROW WITH THE RUN'S REASON (2026-09-13). Until
           now a declined cluster raised nothing under DS 9225 - the row exists only where the
           converter acts - so the file's only offer was the report rules, whose one affordance is
           Ignore. The converter had written down exactly why it declined; the board never showed
           it. Now the first accessor of the declined Type carries that note, as Explain: no Run
           button over a line the run would refuse, and the reader learns what to change. */
        { Published = True }
        Procedure DeepScan_DeclinedWin32BufferRaisesOneExplainRowWithTheReason
            String[] asCode
            tDeepScanHit[] aHits aMine
            Integer i
            Move "Type tThing"                          to asCode[0]
            Move "    Field tThing.iA as DWord"         to asCode[1]
            Move "    Field tThing.iB as DWord"         to asCode[2]
            Move "    Field tThing.iC as DWord"         to asCode[3]
            Move "    Field tThing.iD as DWord"         to asCode[4]
            Move "End_Type"                             to asCode[5]
            Move "Function F Returns Integer"           to asCode[6]
            Move "    String sB sJunk"                  to asCode[7]
            Move "    ZeroType tThing To sB"            to asCode[8]
            Move "    Put 1 To sB At tThing.iA"         to asCode[9]
            Move "    Move (CString(sB)) to sJunk"      to asCode[10]
            Move "End_Function"                         to asCode[11]
            Get ScanSnippet asCode to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].iDSNumber = 9225) ;
                    Move aHits[i] to aMine[SizeOfArray(aMine)]
            Loop
            // one row, on the first accessor, Explain, no function, the run's own reason
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 9 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModExplain)
            Send AssertSAreEqual "" (aMine[0].sRefactorFn)
            Send Assert (Pos("line 11", aMine[0].sHint) > 0)
            Send Assert (Pos("CString(sB)", aMine[0].sHint) > 0)
            // the row names the Type, as the run note does (2026-10-06)
            Send Assert (Pos("Type tThing left as written", aMine[0].sHint) > 0) aMine[0].sHint
        End_Procedure

        /* THE MEMBER-COUNT REFUSAL, AS THE READER SEES IT. "The legacy block declares 11 members where
           the SDK struct has 12 - it flattened a nested struct or renamed members, so position cannot
           be trusted" is what the row said until Nils met it on a real workspace (2026-10-06). It now
           names the Type and the Windows struct it was taken for, gives both counts, and says what has
           to agree and what to do. Needs the real catalogue, since the match by name is what starts it. */
        { Published = True }
        Procedure DeepScan_DeclinedWin32BufferMemberCountRowNamesTypeAndStruct
            String[] asCode
            tDeepScanHit[] aHits aMine
            Integer i
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'Type tMSG'                          to asCode[0]
            Move '    Field tMSG.hwnd    as Handle'   to asCode[1]
            Move '    Field tMSG.message as Integer'  to asCode[2]
            Move '    Field tMSG.wParam  as Integer'  to asCode[3]
            Move 'End_Type'                           to asCode[4]
            Move 'Function F Returns Integer'         to asCode[5]
            Move '    String sMsg'                    to asCode[6]
            Move '    ZeroType tMSG To sMsg'          to asCode[7]
            Move '    Put 1 To sMsg At tMSG.hwnd'     to asCode[8]
            Move 'End_Function'                       to asCode[9]
            Get ScanSnippet asCode to aHits
            For i from 0 to (SizeOfArray(aHits) - 1)
                If (aHits[i].iDSNumber = 9225) ;
                    Move aHits[i] to aMine[SizeOfArray(aMine)]
            Loop
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send Assert (aMine[0].eCategory = eModExplain)
            Send AssertSAreEqual "" (aMine[0].sRefactorFn)
            Send Assert (Pos("ChangeExternalFunctionCallers does not convert this buffer", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("Type tMSG left as written", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("lists 3 members", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("named after, MSG, has", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("same members in the same order", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("Fix that and run Check again, or replace the Type with a Struct by hand.", aMine[0].sHint) > 0) aMine[0].sHint
            Send Assert (Pos("cannot be trusted", aMine[0].sHint) = 0) aMine[0].sHint
        End_Procedure

        /* THE SHAPE THAT STOPPED A REAL CLUSTER ONE LINE SHORT - a buffer handed straight to the
           API - is now a hit, AutoFix, because the converter takes it (the argument becomes
           AddressOf). The Size_of_Field on the Type rides along; without its rewrite the run
           would emit a file that does not compile, which is why the two landed together. */
        { Published = True }
        Procedure DeepScan_BufferHandedStraightToTheApiNowHits
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move 'External_Function Win32_NotifyIcon "Shell_NotifyIconA" Shell32.dll ;' to asCode[0]
            Move '    DWord dwMessage Pointer lpData Returns Integer'                  to asCode[1]
            Move 'Type tNotify'                                                        to asCode[2]
            Move '    Field tNotify.iSize   as DWord'                                  to asCode[3]
            Move '    Field tNotify.hOwner  as Handle'                                 to asCode[4]
            Move '    Field tNotify.iIdent  as Integer'                                to asCode[5]
            Move '    Field tNotify.sTip    as Char 64'                                to asCode[6]
            Move 'End_Type'                                                            to asCode[7]
            Move 'Function ShowIt Returns Integer'                                     to asCode[8]
            Move '    String sNotify'                                                  to asCode[9]
            Move '    DWord iSize'                                                     to asCode[10]
            Move '    Integer iRet'                                                    to asCode[11]
            Move '    FillType tNotify With 0 to sNotify'                              to asCode[12]
            Move '    Put 1 to sNotify At tNotify.iIdent'                              to asCode[13]
            Move '    Size_of_Field tNotify.iSize to iSize'                            to asCode[14]
            Move '    Put iSize to sNotify At tNotify.iSize'                           to asCode[15]
            Move '    Move (Win32_NotifyIcon(0, sNotify)) to iRet'                     to asCode[16]
            Move '    Function_Return iRet'                                            to asCode[17]
            Move 'End_Function'                                                        to asCode[18]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 13 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModAutoFix)
        End_Procedure

        /* A TYPE A CALL PROVES IS AN AUTO-FIX, ONE ROW (2026-11-04). Eleven of MENUITEMINFOA's twelve members
           handed to InsertMenuItemA: this was an Explain row with no way forward. The split Put's first line
           names no buffer, and must not raise a second row. */
        { Published = True }
        Procedure DeepScan_ProvenShortTypeIsOneAutoFixRow
            String[] asCode
            tDeepScanHit[] aHits aMine
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'External_Function InsertMenuItem "InsertMenuItemA" user32.dll handle hMenu integer iItem integer iFlag pointer pStr returns integer' to asCode[0]
            Move "Type tagMENUITEMINFO"                                        to asCode[1]
            Move "    field tagMENUITEMINFO.cbSize        As Integer"          to asCode[2]
            Move "    field tagMENUITEMINFO.fMask         As Integer"          to asCode[3]
            Move "    field tagMENUITEMINFO.fType         As Integer"          to asCode[4]
            Move "    field tagMENUITEMINFO.fState        As Integer"          to asCode[5]
            Move "    field tagMENUITEMINFO.wID           As Integer"          to asCode[6]
            Move "    field tagMENUITEMINFO.hSubMenu      As Handle"           to asCode[7]
            Move "    field tagMENUITEMINFO.hbmpChecked   As Handle"           to asCode[8]
            Move "    field tagMENUITEMINFO.hbmpUnchecked As Handle"           to asCode[9]
            Move "    field tagMENUITEMINFO.dwItemData    As DWORD"            to asCode[10]
            Move "    field tagMENUITEMINFO.dwTypeData    As Pointer"          to asCode[11]
            Move "    field tagMENUITEMINFO.cch           As Integer"          to asCode[12]
            Move "End_Type"                                                    to asCode[13]
            Move "Function AddItem Handle hMenu Integer iC Returns Integer"    to asCode[14]
            Move "    String sInfo"                                            to asCode[15]
            Move "    Pointer pInfo"                                           to asCode[16]
            Move "    Integer iRet"                                            to asCode[17]
            Move "    Zerotype tagMENUITEMINFO to sInfo"                       to asCode[18]
            Move "    Put tagMENUITEMINFO_SIZE to sInfo at tagMENUITEMINFO.cbSize" to asCode[19]
            Move "    Put (MIIM_STATE+MIIM_ID) ;"                              to asCode[20]
            Move "        to sInfo at tagMENUITEMINFO.fMask"                   to asCode[21]
            Move "    Move (AddressOf(sInfo)) to pInfo"                        to asCode[22]
            Move "    Move (InsertMenuItem(hMenu,iC,True,pInfo)) to iRet"      to asCode[23]
            Move "    Function_Return iRet"                                    to asCode[24]
            Move "End_Function"                                                to asCode[25]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 19 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModAutoFix)
        End_Procedure

        /* A BUFFER CROSSING METHODS IS AN AUTO-FIX, ONE ROW (2026-11-04): a tray icon package's Type, filled in a
           Function that returns it, with a second variable carrying it to the API. */
        { Published = True }
        Procedure DeepScan_BufferAcrossMethodsIsOneAutoFixRow
            String[] asCode
            tDeepScanHit[] aHits aMine
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move 'External_Function Shell_NotifyIcon "Shell_NotifyIcon" SHELL32.DLL integer iMsg pointer pStuct returns integer' to asCode[0]
            Move "Type SYSTRAY_NOTIFY"                                         to asCode[1]
            Move "    field SYSTRAY_NOTIFY.cbSize As dWord"                    to asCode[2]
            Move "    field SYSTRAY_NOTIFY.hwnd As HANDLE"                     to asCode[3]
            Move "    field SYSTRAY_NOTIFY.uId As dWord"                       to asCode[4]
            Move "    field SYSTRAY_NOTIFY.uFlags As dWord"                    to asCode[5]
            Move "    field SYSTRAY_NOTIFY.uCallBackMessage As dWord"          to asCode[6]
            Move "    field SYSTRAY_NOTIFY.hIcon As HANDLE"                    to asCode[7]
            Move "    field SYSTRAY_NOTIFY.szTip As Char 64"                   to asCode[8]
            Move "End_Type"                                                    to asCode[9]
            Move "Function CreateStruct returns string"                        to asCode[10]
            Move "    string sStruct"                                          to asCode[11]
            Move "    Zerotype SYSTRAY_Notify to sStruct"                      to asCode[12]
            Move "    Put SYSTRAY_NOTIFY_SIZE to sStruct at SYSTRAY_Notify.cbSize" to asCode[13]
            Move "    Function_Return sStruct"                                 to asCode[14]
            Move "End_Function"                                                to asCode[15]
            Move "Function AddIcon Returns Integer"                            to asCode[16]
            Move "    string  sSystray_Notify"                                 to asCode[17]
            Move "    pointer pSystray_Notify"                                 to asCode[18]
            Move "    integer iRet iID"                                        to asCode[19]
            Move "    get CreateStruct of iID to sSystray_Notify"              to asCode[20]
            Move "    Move (AddressOf(sSystray_Notify)) to pSystray_Notify"    to asCode[21]
            Move "    Move (Shell_NotifyIcon(0, pSystray_Notify)) to iRet"     to asCode[22]
            Move "    Function_Return iRet"                                    to asCode[23]
            Move "End_Function"                                                to asCode[24]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 13 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModAutoFix)
        End_Procedure

        /* A TYPE THAT WRITES OUT WHAT WINDOWS NESTS IS AN AUTO-FIX, ONE ROW (2026-11-04): it was an Explain row
           whose count made it look like a struct nobody could convert. */
        { Published = True }
        Procedure DeepScan_FlattenedTypeIsOneAutoFixRow
            String[] asCode
            tDeepScanHit[] aHits aMine
            If (CatalogueIsLoadable(Self) = False) ;
                Procedure_Return
            Move "Type tMSG"                                                   to asCode[0]
            Move "    Field tMSG.hwnd    as Handle"                            to asCode[1]
            Move "    Field tMSG.message as Integer"                           to asCode[2]
            Move "    Field tMSG.wParam  as Integer"                           to asCode[3]
            Move "    Field tMSG.lParam  as Integer"                           to asCode[4]
            Move "    Field tMSG.Time    as DWord"                             to asCode[5]
            Move "    Field tMSG.ptX     as DWord"                             to asCode[6]
            Move "    Field tMSG.ptY     as DWord"                             to asCode[7]
            Move "End_Type"                                                    to asCode[8]
            Move "Function F Returns Integer"                                  to asCode[9]
            Move "    String sMsg"                                             to asCode[10]
            Move "    Integer iY"                                              to asCode[11]
            Move "    ZeroType tMSG To sMsg"                                   to asCode[12]
            Move "    GetBuff From sMsg At tMSG.ptY To iY"                     to asCode[13]
            Move "    Function_Return iY"                                      to asCode[14]
            Move "End_Function"                                                to asCode[15]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 13 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModAutoFix)
        End_Procedure

        /* A ONE-FIELD TYPE BUFFER IS A HIT (2026-09-13): the converter takes it - the buffer becomes
           the scalar - so the row offers the Run, where before its only offer was the report. */
        { Published = True }
        Procedure DeepScan_OneFieldTypeBufferNowHits
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move "Procedure DoInit"                                    to asCode[0]
            Move "    Integer iCookie"                                 to asCode[1]
            Move "    String sBuffer"                                  to asCode[2]
            Move "    Pointer pBuffer"                                 to asCode[3]
            Move "    ZeroType tDword to sBuffer"                      to asCode[4]
            Move "    Move (AddressOf(sBuffer)) to pBuffer"            to asCode[5]
            Move "    GetBuff From sBuffer At tDword.DWord to iCookie" to asCode[6]
            Move "End_Procedure"                                       to asCode[7]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send AssertIAreEqual 1 (SizeOfArray(aMine))
            Send AssertIAreEqual 5 (aMine[0].iLine)
            Send Assert (aMine[0].eCategory = eModAutoFix)
        End_Procedure

        /* THE DOUBLE-IN LINE, one row per step (2026-09-13). The legacy line raises the IN rule and
           only that - the Replace command behind a legacy condition is not at command position, so
           its rule stays quiet until the condition is parenthesised; then the Replace rule raises
           and the IN rule is done. Two Checks, two Runs, each row honest about what its Run does. */
        { Published = True }
        Procedure DeepScan_DoubleInLineRaisesTheInRuleThenTheReplaceRule
            String[] asCode
            tDeepScanHit[] aHits aIn aRep
            Move "Procedure P"                                                            to asCode[0]
            Move "    String temp"                                                        to asCode[1]
            Move '    If "," IN temp Replace "," IN temp WITH "."'                        to asCode[2]
            Move "End_Procedure"                                                          to asCode[3]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeInToContains"             to aIn
            Get _HitsForFn aHits "ChangeReplaceCommandToFunction" to aRep
            Send AssertIAreEqual 1 (SizeOfArray(aIn))
            Send AssertIAreEqual 0 (SizeOfArray(aRep))
            Move '    If (temp contains ",") Replace "," IN temp WITH "."'                to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeInToContains"             to aIn
            Get _HitsForFn aHits "ChangeReplaceCommandToFunction" to aRep
            Send AssertIAreEqual 0 (SizeOfArray(aIn))
            Send AssertIAreEqual 1 (SizeOfArray(aRep))
        End_Procedure

        /* THE PRE-GATE ADMITS THE TEXT ACCESSORS (2026-09-13). A buffer zeroed by hand and reached
           only through Put_String has no ZeroType / Put / GetBuff line, so before this the file was
           never examined by the buffer rules at all - the same blindness the v47 widening cured for
           Put and GetBuff, one command further on. */
        { Published = True }
        Procedure DeepScan_PutStringLineIsExaminedByTheBufferRules
            String[] asCode
            tDeepScanHit[] aHits aMine
            Move "Type tTray"                                                   to asCode[0]
            Move "    Field tTray.iSize as DWord"                               to asCode[1]
            Move "    Field tTray.iFlags as DWord"                              to asCode[2]
            Move "    Field tTray.szTip as Char 64"                             to asCode[3]
            Move "End_Type"                                                     to asCode[4]
            Move "Procedure DoIt"                                               to asCode[5]
            Move "    String sBuf sTip"                                         to asCode[6]
            Move "    Pointer pBuf"                                             to asCode[7]
            Move "    Move (Repeat(Character(0), tTray_SIZE)) to sBuf"          to asCode[8]
            Move "    Put_String sTip to sBuf At tTray.szTip"                   to asCode[9]
            Move "    Move (AddressOf(sBuf)) to pBuf"                           to asCode[10]
            Move "End_Procedure"                                                to asCode[11]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeExternalFunctionCallers" to aMine
            Send Assert (SizeOfArray(aMine) > 0)
        End_Procedure

        // ---- 2026-09-07: the edit subclass rows carry their converter ----------------------------
        // 'Class <sub> is a Edit / dbEdit' is where the conversion happens (the base line; the objects follow),
        // so the row must bring THAT file into the plan with the converter - Suggest, like the object rows.
        // Until now it was an Explain, and a plan over the objects' files reported 0 converted.
        { Published = True }
        Procedure DeepScan_EditSubclassRulesCarryTheirConverter
            String[] asCode
            tDeepScanHit[] aHits aEdit aDbEdit
            Move "Class MyEdit is an Edit startmac MY_START_MACRO" to asCode[0]
            Move "End_Class"                                     to asCode[1]
            Move "Class MyDbEdit is a dbEdit"                     to asCode[2]
            Move "End_Class"                                     to asCode[3]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "RefactorEditTocTextEdit"     to aEdit
            Get _HitsForFn aHits "RefactorDbEditTocDbTextEdit" to aDbEdit
            Send AssertIAreEqual 1 (SizeOfArray(aEdit))
            Send AssertIAreEqual 1 (SizeOfArray(aDbEdit))
            Send AssertSAreEqual "Edit subclass"   (aEdit[0].sSymbol)
            Send AssertSAreEqual "dbEdit subclass" (aDbEdit[0].sSymbol)
            Send Assert (aEdit[0].eCategory = eModSuggest)
            Send Assert (aDbEdit[0].eCategory = eModSuggest)
        End_Procedure

        // 2026-11-05: the WinReport subclass row caught up with them (DS 9204): it was an Explain saying to run the converter.
        { Published = True }
        Procedure DeepScan_WinReportSubclassRuleCarriesItsConverter
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move "Class Myreport is a WinReport" to asCode[0]
            Move "End_Class"                     to asCode[1]
            Get ScanSnippet asCode to aHits
            Get _HitsForSymbol aHits "WinReport subclass" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].eCategory = eModSuggest and aFn[0].sRefactorFn = "RefactorWinReportTocWinReport2") "the row brings the file into the plan"
        End_Procedure

        // ---- 2026-09-07: a declined grid's skip-marker silences its row --------------------------------
        // The grid converter now writes '// TODO (DFRefactor): NOT converted - <reason>' above an object it
        // declines. The scan already honours a DFRefactor marker above a declaration; this pins that the
        // converter's form is one it recognises, so the same 16 rows stop returning after every Check.
        { Published = True }
        Procedure DeepScan_GridDeclineMarkerSilencesTheRow
            String[] asMarked asPlain
            tDeepScanHit[] aHits aGrid
            Move "// TODO (DFRefactor): NOT converted - no column definitions in the object. Left as written" to asMarked[0]
            Move "Object oGrd is a Grid"                                                                   to asMarked[1]
            Move '    Send Columns_Add "Code" 30'                                                          to asMarked[2]
            Move "End_Object"                                                                              to asMarked[3]
            Get ScanSnippet asMarked to aHits
            Get _HitsForFn aHits "RefactorGridToCJGrid" to aGrid
            Send AssertIAreEqual 0 (SizeOfArray(aGrid))
            // control: the same object without the marker is flagged
            Move "Object oGrd is a Grid"                                                                   to asPlain[0]
            Move '    Send Columns_Add "Code" 30'                                                          to asPlain[1]
            Move "End_Object"                                                                              to asPlain[2]
            Get ScanSnippet asPlain to aHits
            Get _HitsForFn aHits "RefactorGridToCJGrid" to aGrid
            Send AssertIAreEqual 1 (SizeOfArray(aGrid))
        End_Procedure

        /* THE GRID CONVERSIONS ARE AUTO-FIX (Nils 2026-10-03: "The grids has always had auto-fix status").
           An object of each PLAIN legacy grid class is an Auto-fix row with its converter - an EMPTY run
           converts exactly these, and leaves an object of the workspace's own subclass as it is (that
           row is Explain; see DeepScan_LearnedSubclass_ObjectsFlaggedThroughIt). Until v81 only dbList was. */
        { Published = True }
        Procedure DeepScan_PlainGridClassesAreAutoFix
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move "Object oA is a dbGrid" to asCode[0]
            Move "End_Object"            to asCode[1]
            Move "Object oB is a Grid"   to asCode[2]
            Move "End_Object"            to asCode[3]
            Move "Object oC is a dbList" to asCode[4]
            Move "End_Object"            to asCode[5]
            Move "Object oD is a List"   to asCode[6]
            Move "End_Object"            to asCode[7]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "RefactorDbGridTocDbCJGrid" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].eCategory = eModAutoFix) "dbGrid is Auto-fix"
            Get _HitsForFn aAll "RefactorGridToCJGrid" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].eCategory = eModAutoFix) "Grid is Auto-fix"
            Get _HitsForFn aAll "RefactorDbListTocDbCJGridPromptList" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].eCategory = eModAutoFix) "dbList is Auto-fix"
            Get _HitsForFn aAll "RefactorListToCJGrid" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].eCategory = eModAutoFix) "List is Auto-fix"
        End_Procedure

        /* THE SCAN'S VERDICT TRAVELS WITH THE MESSAGE (2026-09-11). The analyzer classifies a Deep
           Scan hit by its DS number, and the recipe for that number is the RULE's - so the per-line
           verdict the scan formed had to reach it some other way. A subclass object that no converter
           acts on arrives as Explain, with no function and the scan's own hint. */
        {Published = True}
        Procedure DeepScan_HitsToMessagesCarriesTheScansVerdict
            Handle hoScan
            tDeepScanHit[] aHits
            tCompileError[] aMsgs

            Move 12                           to aHits[0].iLine
            Move "DfTimer class"              to aHits[0].sSymbol
            Move eModExplain                  to aHits[0].eCategory
            Move ""                           to aHits[0].sRefactorFn
            Move "Port the subclass by hand." to aHits[0].sHint
            Move 9189                         to aHits[0].iDSNumber
            Get Create (RefClass(cDeepScanner)) to hoScan
            Get HitsToMessages of hoScan aHits "E:\Ws\AppSrc\Timers.pkg" to aMsgs
            Send Destroy of hoScan
            Send AssertIAreEqual 1 (SizeOfArray(aMsgs))
            If (SizeOfArray(aMsgs) = 1) Begin
                Send Assert aMsgs[0].bDeepScan "a scan hit becomes a DS message"
                Send AssertIAreEqual 9189 aMsgs[0].iErrorNo
                Send AssertIAreEqual eModExplain aMsgs[0].eScanCategory
                Send AssertSAreEqual "" aMsgs[0].sScanFn
                Send AssertSAreEqual "Port the subclass by hand." aMsgs[0].sScanHint
            End
        End_Procedure

        /* THE VERDICT OUTRANKS THE RULE, AND ONLY EVER LOWERS. What put "2 changes" on the board
           for a run that changed 0 lines: the rule's recipe said Auto-fix with ChangeDfTimerTocTimer,
           the scan had said Explain with none. A compiler message, and a scan message without a
           verdict, keep their recipe exactly; a Review verdict caps the row at Review and keeps its
           function; an Explain recipe is never raised. */
        {Published = True}
        Procedure DeepScan_VerifyScanVerdictOutranksTheRule
            Handle ho
            tModAnalyzer Recipe Out
            tCompileError Msg

            Get Create (RefClass(cModAnalyzer)) to ho
            Move "ChangeDfTimerTocTimer" to Recipe.sRefactorFn
            Move eModAutoFix             to Recipe.eCategory
            Move "Use the cTimer class." to Recipe.sHint

            // A COMPILER message: untouched, whatever it carries.
            Move False       to Msg.bDeepScan
            Move eModExplain to Msg.eScanCategory
            Get VerifyScanVerdict of ho Recipe Msg to Out
            Send AssertSAreEqual "ChangeDfTimerTocTimer" Out.sRefactorFn
            Send AssertIAreEqual eModAutoFix Out.eCategory

            // A scan message carrying NO verdict: untouched.
            Move True to Msg.bDeepScan
            Move 0    to Msg.eScanCategory
            Get VerifyScanVerdict of ho Recipe Msg to Out
            Send AssertSAreEqual "ChangeDfTimerTocTimer" Out.sRefactorFn
            Send AssertIAreEqual eModAutoFix Out.eCategory

            // The subclass object: no function, Explain, the scan's own words.
            Move eModExplain                  to Msg.eScanCategory
            Move ""                           to Msg.sScanFn
            Move "Port the subclass by hand." to Msg.sScanHint
            Get VerifyScanVerdict of ho Recipe Msg to Out
            Send AssertSAreEqual "" Out.sRefactorFn
            Send AssertIAreEqual eModExplain Out.eCategory
            Send AssertSAreEqual "Port the subclass by hand." Out.sHint

            // A Review verdict that keeps its function: capped at Review, the function kept.
            Move eModSuggest              to Msg.eScanCategory
            Move "ChangeDfTimerTocTimer"  to Msg.sScanFn
            Move "Offered for review."    to Msg.sScanHint
            Get VerifyScanVerdict of ho Recipe Msg to Out
            Send AssertSAreEqual "ChangeDfTimerTocTimer" Out.sRefactorFn
            Send AssertIAreEqual eModSuggest Out.eCategory

            // Never RAISED: an Explain recipe stays Explain whatever the scan said.
            Move eModExplain to Recipe.eCategory
            Move eModAutoFix to Msg.eScanCategory
            Get VerifyScanVerdict of ho Recipe Msg to Out
            Send AssertIAreEqual eModExplain Out.eCategory
            Send Destroy of ho
        End_Procedure

        // v66: the legacy right-click menu. The OBJECT form of both classes routes to the converter -
        // at Auto-fix since v68, after the live runs - the modern class and a mere mention are clean,
        // and the SUBCLASS form is the Explain row with no function - the whole family's split (v63).
        // (Since v87 a subclass that CONVERTS is offered its own converter - the next test. The bare
        // class line here has no End_Class, so the converter's verdict is no and the row explains.)
        { Published = True }
        Procedure DeepScan_FloatingPopupMenuRowsRouteToTheConverter
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '    Object oPop is a FloatingPopupMenu'        to asCode[0]
            Move '    Object oDbPop is a dbFloatingPopupMenu'    to asCode[1]
            Move '    Object oCtx is a cCJContextMenu'           to asCode[2]
            Move 'Class cTreePop is a FloatingPopupMenu'         to asCode[3]
            Move '    Set Floating_Menu_Object to (oPop(Self))'  to asCode[4]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeFloatingPopupMenuToCodeJock" to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 2) Begin
                Send Assert (aHits[0].iLine = 1)
                Send Assert (aHits[1].iLine = 2)
                Send Assert (aHits[0].eCategory = eModAutoFix)
                Send Assert (aHits[1].eCategory = eModAutoFix)
                Send Assert (aHits[0].sSymbol = "FloatingPopupMenu class")
                Send Assert (aHits[1].sSymbol = "dbFloatingPopupMenu class")
            End
            Get _HitsForSymbol aAll "FloatingPopupMenu subclass" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) Begin
                Send Assert (aHits[0].iLine = 4)
                Send Assert (aHits[0].eCategory = eModExplain)
                Send Assert (aHits[0].sRefactorFn = "")
            End
            Get _HitsForSymbol aAll "dbFloatingPopupMenu subclass" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        /* v87 (2026-10-05): the SUBCLASS row offers ConvertPopupMenuSubclassToCodeJock - for review, so
           never ticked by itself - when a dry run of the class says it converts, and is an explanation
           carrying the converter's reason when it does not. Asked per class at scan time, so the row
           never promises a run that would leave the class as it is. */
        { Published = True }
        Procedure DeepScan_PopupSubclassOffersItsConverterOnlyWhereItConverts
            String[] asCode
            tDeepScanHit[] aAll aHits
            String sGot sWhy

            Move 'Class cTreePop is a FloatingPopupMenu'     to asCode[0]
            Move '    Procedure Construct_Object'            to asCode[1]
            Move '        Forward Send Construct_Object'     to asCode[2]
            Move '    End_Procedure'                         to asCode[3]
            Move 'End_Class'                                 to asCode[4]
            Move 'Class cBusyPop is a FloatingPopupMenu'     to asCode[5]
            Move '    Procedure OnInitMenu'                  to asCode[6]
            Move '    End_Procedure'                         to asCode[7]
            Move 'End_Class'                                 to asCode[8]
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "FloatingPopupMenu subclass" to aHits
            Move ("hits " + String(SizeOfArray(aHits))) to sGot
            If (SizeOfArray(aHits) = 2) Begin
                Move "no reason in the hint" to sWhy
                If (Pos("cannot convert it: line 7 is a hand-written procedure (OnInitMenu)", aHits[1].sHint) > 0) ;
                    Move "reason in the hint" to sWhy
                Move ("line " + String(aHits[0].iLine) + " cat " + String(aHits[0].eCategory) + " [" + aHits[0].sRefactorFn + "] / line " + String(aHits[1].iLine) + " cat " + String(aHits[1].eCategory) + " [" + aHits[1].sRefactorFn + "] " + sWhy) to sGot
            End
            Send AssertSAreEqual ("line 1 cat " + String(eModSuggest) + " [ConvertPopupMenuSubclassToCodeJock] / line 6 cat " + String(eModExplain) + " [] reason in the hint") sGot
        End_Procedure

        // The popup converter's own refusal marker is re-asked: above an object the converter takes by
        // now, the row comes back (the first live run's marker had silenced it for good); above one it
        // still refuses, the scan stays quiet as for any other marker.
        { Published = True }
        Procedure DeepScan_StalePopupMarkerReoffersWhenTheConverterTakesIt
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '    //  TODO (DFRefactor): ChangeFloatingPopupMenuToCodeJock left oPop as written - line 3 is not part of the popup grammar. Clear that and run it again, or port the object to cCJContextMenu by hand.' to asCode[0]
            Move '    Object oPop is a FloatingPopupMenu'          to asCode[1]
            Move '        Send Add_Item Msg_Foo "Foo"'             to asCode[2]
            Move '    End_Object'                                  to asCode[3]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeFloatingPopupMenuToCodeJock" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].iLine = 2)
            // ...and the marker over an object it STILL refuses keeps the scan quiet.
            Move '        Procedure OnSomething'                   to asCode[3]
            Move '        End_Procedure'                           to asCode[4]
            Move '    End_Object'                                  to asCode[5]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "ChangeFloatingPopupMenuToCodeJock" to aHits
            Send AssertIAreEqual 0 (SizeOfArray(aHits))
        End_Procedure

        /* v69 (2026-09-15): the Get_date_format rule carries its converter, Auto-fix. The command
           still compiles on DF26 under the obsolete-command warning, so the scan lane is the one
           that finds it in a file the build never reached; the compiler lane has the matching
           { ModRecipe = 4533 | command: Get_Date_Format }. The two mentions that must NOT hit:
           the modern form (its own output - idempotence at the catalogue level) and a comment. */
        { Published = True }
        Procedure DeepScan_GetDateFormatRuleCarriesItsConverter
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move "    get_date_format to dtype"                      to asCode[0]
            Move "    Get_Attribute DF_DATE_FORMAT to iFormat"       to asCode[1]   // the converted form: clean
            Move "    // get_date_format to dtype - old way"          to asCode[2]   // a comment: clean
            Get ScanSnippet asCode to aAll
            Get _HitsForSymbol aAll "Get_date_format" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            Send Assert (aHits[0].iLine = 1)
            Send Assert (aHits[0].eCategory = eModAutoFix) "the rule must be Auto-fix - the swap is value-exact"
            Send AssertSAreEqual "ChangeGetDateFormatToAttribute" aHits[0].sRefactorFn
        End_Procedure

        /* v79 (2026-10-03): THE RESIDENT IMAGE OPTION (DS 9233). The rule reads an image's NAME line,
           which the scan blanks for every other rule, so the tests go both ways: every name line of
           a run of images hits ('/CustHdr' .. '/CustBody' .. '/Footer', the DataFlex 26 help's own
           BasicReport sample), and the image TEXT - the word Resident included - stays silent. */
        { Published = True }
        Procedure DeepScan_ResidentImageOptionEveryNameLineHits
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '/CustHdr Resident'                           to asCode[0]   // hit (line 1)
            Move 'Customer Name Listing           Page:___.'  to asCode[1]   // image text
            Move '/CustBody Resident'                          to asCode[2]   // hit (line 3) - the next image
            Move '_____. ______________________________'      to asCode[3]   // image text
            Move '/Footer RESIDENT'                            to asCode[4]   // hit (line 5) - any case
            Move 'Resident since: __/__/__'                    to asCode[5]   // image TEXT - never a hit
            Move '/*'                                          to asCode[6]   // the images end
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "RemoveResidentImageOption" to aHits
            Send AssertIAreEqual 3 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 3) Begin
                Send Assert (aHits[0].iLine = 1) "the first image's name line"
                Send Assert (aHits[1].iLine = 3) "the second image's name line, inside the run"
                Send Assert (aHits[2].iLine = 5) "the third image's name line, upper case"
                Send Assert (aHits[0].iDSNumber = 9233) "the rule's DS number"
                Send Assert (aHits[0].eCategory = eModAutoFix) "the rule must be Auto-fix - the word never changed what an image prints"
                Send AssertSAreEqual "Resident image option" aHits[0].sSymbol
            End
        End_Procedure

        // The look-alikes that must NOT hit: an image CALLED Resident, a name that only starts with it,
        // a longer word, the word in a '//' comment after the name, an image name line that was
        // commented out, and the word in ordinary code. The positive control is the last line.
        { Published = True }
        Procedure DeepScan_ResidentImageOptionLookAlikesStaySilent
            String[] asCode
            tDeepScanHit[] aAll aHits

            Move '/Resident'                             to asCode[0]    // the NAME - no option
            Move '/*'                                    to asCode[1]
            Move '/ResidentList'                         to asCode[2]    // a name that starts with it
            Move '/*'                                    to asCode[3]
            Move '/Body Residential'                     to asCode[4]    // a longer word
            Move '/*'                                    to asCode[5]
            Move '/Body // resident image'               to asCode[6]    // a comment after the name
            Move '/*'                                    to asCode[7]
            Move '// /Body Resident'                     to asCode[8]    // a commented-out name line
            Move 'Move "Resident" to sKind'              to asCode[9]    // code
            Move '/Header Resident'                      to asCode[10]   // hit (line 11) - the control
            Move '/*'                                    to asCode[11]
            Get ScanSnippet asCode to aAll
            Get _HitsForFn aAll "RemoveResidentImageOption" to aHits
            Send AssertIAreEqual 1 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 1) ;
                Send Assert (aHits[0].iLine = 11) "only the control line"
        End_Procedure

        // An image is still an image after this rule: the image's TEXT never reaches the other rules
        // (the code-shaped words in it stay silent), and real code after the '/*' still scans.
        { Published = True }
        Procedure DeepScan_ResidentImageTextStillSkipped
            String[] asCode
            tDeepScanHit[] aHits

            Move '/Body Resident'             to asCode[0]   // DS 9233 (line 1)
            Move 'Insert sX in sY at 1'       to asCode[1]   // image TEXT - never a hit
            Move '/*'                         to asCode[2]
            Move 'Insert sA in sB at 3'       to asCode[3]   // code - hit (line 4)
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 2 (SizeOfArray(aHits))
            If (SizeOfArray(aHits) = 2) Begin
                Send Assert (aHits[0].iLine = 1) "the name line"
                Send AssertSAreEqual "RemoveResidentImageOption" aHits[0].sRefactorFn
                Send Assert (aHits[1].iLine = 4) "the code after the image"
            End
        End_Procedure

        // The obsolete Incr, Decr and Sub commands (rules v91): each routed to its converter in command
        // position; the modern Increment, Decrement and Subtract are never flagged.
        { Published = True }
        Procedure DeepScan_IncrDecrSubCommandsHitModernFormsClean
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'incr iInt'                to asCode[0]
            Move 'Decr iInt'                to asCode[1]
            Move 'Sub 5 to iInt'            to asCode[2]
            Move 'Increment iInt'           to asCode[3]
            Move 'Decrement iInt'           to asCode[4]
            Move 'Subtract 5 from iInt'     to asCode[5]
            Get ScanSnippet asCode to aHits
            Send AssertIAreEqual 3 (SizeOfArray(aHits))
            Get _HitsForFn aHits "ChangeIncrToIncrement" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 1 and aFn[0].eCategory = eModAutoFix) "Incr"
            Get _HitsForFn aHits "ChangeDecrToDecrement" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 2) "Decr"
            Get _HitsForFn aHits "ChangeSubToSubtract" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 3) "Sub"
        End_Procedure

        // The pointer/string Moves of 4539 (rules v92): rows exactly where the converter would rewrite -
        // both types known from the method's declarations; a String-to-String Move and an already wrapped
        // PointerToString() are left alone.
        { Published = True }
        Procedure DeepScan_PointerStringMovesListWhatTheConverterRewrites
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Procedure TestPointers'                    to asCode[0]
            Move '    String sResult s'                      to asCode[1]
            Move '    Address aResult'                       to asCode[2]
            Move '    Pointer aStr'                          to asCode[3]
            Move '    Move aResult to sResult'               to asCode[4]
            Move '    Move s to aStr'                        to asCode[5]
            Move '    Move sResult to s'                     to asCode[6]
            Move '    Move (PointerToString(aResult)) to s'  to asCode[7]
            Move 'End_Procedure'                             to asCode[8]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "UnicodePointerToString" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 5 and aFn[0].eCategory = eModAutoFix) "Pointer to String"
            Get _HitsForFn aHits "UnicodeStringToPointer" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 6) "String to Pointer"
        End_Procedure

        // DFTrue and DFFalse (rules v93): whole words in code, routed to ChangeDfTrueDfFalse; a name that
        // only contains one, a string literal and a comment are never flagged.
        { Published = True }
        Procedure DeepScan_DfTrueDfFalseHitWholeWordsInCode
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Move DFTrue to bOk'               to asCode[0]
            Move 'Function_Return (bA = dffalse)'   to asCode[1]
            Move 'Move bDfTrueSet to bOk'           to asCode[2]
            Move 'Move "DFTrue" to sText'           to asCode[3]
            Move '// Move DFFalse to bOk'           to asCode[4]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeDfTrueDfFalse" to aFn
            Send AssertIAreEqual 2 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 2) Begin
                Send Assert (aFn[0].iLine = 1 and aFn[0].eCategory = eModAutoFix and aFn[0].sSymbol = "DFTrue") "DFTrue"
                Send Assert (aFn[1].iLine = 2 and aFn[1].sSymbol = "DFFalse") "DFFalse"
            End
        End_Procedure

        // The Error command with a literal number (rules v93): a number DataFlex names is the rename rule's
        // row (Auto-fix, and the row says the name), one it does not name is the Explain rule's; a number in
        // a message text, Error_Report and a named error are never rows. A fixed catalogue: no install needed.
        { Published = True }
        Procedure DeepScan_ErrorNumbersSplitNamedFromNotNamed
            String[] asCode
            tDeepScanHit[] aHits aFn
            tErrorName[] aNames aNone
            Move 25                    to aNames[0].iNumber
            Move "DFERR_REC_NOT_FOUND" to aNames[0].sName
            Move 4401                  to aNames[1].iNumber
            Move "DFERR_OPERATOR"      to aNames[1].sName
            Move 4402                  to aNames[2].iNumber
            Move "DFERR_PROGRAM"       to aNames[2].sName
            Set paErrorNames of ghoFuncLib to aNames
            Set pbErrorNamesLoaded of ghoFuncLib to True
            Move 'Error 25'                         to asCode[0]
            Move 'If (iErr > 0) Error 300 "Wrong"'  to asCode[1]
            Move 'Move "Error 25" to sText'         to asCode[2]
            Move 'Send Error_Report 25'             to asCode[3]
            Move 'Error DFERR_REC_NOT_FOUND'        to asCode[4]
            Move 'Error 300'                        to asCode[5]
            Get ScanSnippet asCode to aHits
            Set paErrorNames of ghoFuncLib to aNone
            Set pbErrorNamesLoaded of ghoFuncLib to False
            Get _HitsForFn aHits "ChangeErrorNumberToName" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 1 and aFn[0].eCategory = eModAutoFix and (aFn[0].sHint contains "DFERR_REC_NOT_FOUND")) "named"
            // Its own text: the generic rule. No text of its own: the Explain rule, and its row says that.
            Get _HitsForFn aHits "ChangeErrorNumberToGenericError" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 2 and aFn[0].eCategory = eModAutoFix and (aFn[0].sHint contains "DFERR_OPERATOR")) "its own text"
            Get _HitsForSymbol aHits "Error number (not named)" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 6 and aFn[0].eCategory = eModExplain and (aFn[0].sHint contains "no text of its own")) "not named"
        End_Procedure

        // The (Self) object-reference rule (rules v93) is Auto-fix and on since v98 (the 2026-10-24 live run); its
        // rows are exactly the lines RemoveSelfFromObjectReferences changes - an object the file declares, never
        // a property call.
        { Published = True }
        Procedure DeepScan_SelfObjectRefRuleListsTheConvertersLines
            Handle ho
            String[] asCode
            tDeepScanRule[] aRules
            tDeepScanHit[] aHits aFn
            Move 'Object oCustomer_DD is a cObject'      to asCode[0]
            Move 'End_Object'                            to asCode[1]
            Move 'Set Server to (oCustomer_DD(Self))'    to asCode[2]
            Move 'Move (piCount(Self)) to iCount'        to asCode[3]
            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aRules
            Get ScanLines of ho (&asCode) (&aRules) to aHits
            Send Destroy of ho
            Get _HitsForFn aHits "RemoveSelfFromObjectReferences" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 3 and aFn[0].eCategory = eModAutoFix) "the Set Server line"
        End_Procedure

        // A saved rules file from before v98 holds the (Self) rule as OFF - the default it shipped with, not a
        // choice - so a reseed lets the seed's ON stand; another rule's OFF in the same file is still the
        // user's and survives (rules v98, 2026-10-30).
        { Published = True }
        Procedure DeepScan_SelfObjectRefRuleComesOnOverAnOldDefault
            Handle ho
            tDeepScanRule[] aSeed aOld aBack
            String sPath
            Integer iSelfNo iTrimNo i

            Get Create (RefClass(cDeepScanner)) to ho
            Get BuildDefaultDeepScanRules of ho to aSeed
            Move 0 to iSelfNo
            Move 0 to iTrimNo
            For i from 0 to (SizeOfArray(aSeed) - 1)
                If (aSeed[i].sRefactorFn = "RemoveSelfFromObjectReferences") ;
                    Move aSeed[i].iDSNumber to iSelfNo
                If (aSeed[i].sToken = "trim") ;
                    Move aSeed[i].iDSNumber to iTrimNo
            Loop
            Send AssertIAreEqual 9246 iSelfNo
            Move aSeed to aOld
            For i from 0 to (SizeOfArray(aOld) - 1)
                If (aOld[i].iDSNumber = iSelfNo or aOld[i].iDSNumber = iTrimNo) ;
                    Move False to aOld[i].bEnabled
            Loop
            Get psUnitTestScratchDeepScanPath to sPath
            Send WriteDeepScanRulesAtVersion of ho aOld sPath 97
            Get LoadDeepScanRules of ho sPath to aBack
            Send Destroy of ho
            For i from 0 to (SizeOfArray(aBack) - 1)
                If (aBack[i].iDSNumber = iSelfNo) ;
                    Send Assert (aBack[i].bEnabled = True) "the (Self) rule: the old default gives way"
                If (aBack[i].iDSNumber = iTrimNo) ;
                    Send Assert (aBack[i].bEnabled = False) "another rule: the user's OFF stays"
            Loop
            Move (rfDeleteFile(sPath)) to i
        End_Procedure

        // The obsolete 'for' targets (rules v94): DFDesktop is one rule, Desktop and BaseClass the other; the
        // modern cObject and the Desktop keyword are never rows.
        { Published = True }
        Procedure DeepScan_ObsoleteMethodTargetsSplitDFDesktopFromDesktop
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Procedure Notify_Exit For DFDesktop'          to asCode[0]
            Move 'Function Confirm for Desktop Returns Integer'  to asCode[1]
            Move 'Procedure Set psName for BaseClass String s'  to asCode[2]
            Move 'Procedure OnStart for cObject'                to asCode[3]
            Move 'Procedure OnStop Desktop'                     to asCode[4]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeObsoleteMethodTarget" to aFn
            Send AssertIAreEqual 3 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 3) Begin
                Send Assert (aFn[0].iLine = 1 and aFn[0].sSymbol = "for DFDesktop method" and aFn[0].eCategory = eModAutoFix) "DFDesktop"
                Send Assert (aFn[1].iLine = 2 and aFn[1].sSymbol = "for Desktop / for BaseClass method") "Desktop"
                Send Assert (aFn[2].iLine = 3 and aFn[2].sSymbol = "for Desktop / for BaseClass method") "BaseClass"
            End
        End_Procedure

        // The old class names (rules v94): 'is a', a method header's 'for', U_ - the row says the new name;
        // a current class, a string and the method rule's 'for Desktop' are never this rule's rows.
        { Published = True }
        Procedure DeepScan_ObsoleteClassNamesNameTheCurrentClass
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Class cMyControl is a DFControl'      to asCode[0]
            Move 'Object oImages is a cImageList'       to asCode[1]
            Move 'Get Create U_ImageList to hoImages'   to asCode[2]
            Move 'Procedure Paint for dfPanel'          to asCode[3]
            Move 'Procedure Close for Desktop'          to asCode[4]
            Move 'Move "is a Message" to sText'         to asCode[5]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeObsoleteClassNames" to aFn
            Send AssertIAreEqual 3 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 3) Begin
                Send Assert (aFn[0].iLine = 1 and (aFn[0].sHint contains "DfBaseControl")) "is a DFControl"
                Send Assert (aFn[1].iLine = 3 and (aFn[1].sHint contains "DfBaseImageList")) "U_ImageList"
                Send Assert (aFn[2].iLine = 4 and (aFn[2].sHint contains "DfBasePanel")) "for dfPanel"
            End
        End_Procedure

        // The old-class-name pre-check (rules v95): 'is' then two spaces, or a tab, before the article is a row too.
        { Published = True }
        Procedure DeepScan_ObsoleteClassNamesAnySpacingAfterIs
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Class cMyList is  a DFList'                            to asCode[0]
            Move ('Object oImages is' + Character(9) + 'an ImageList')  to asCode[1]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeObsoleteClassNames" to aFn
            Send AssertIAreEqual 2 (SizeOfArray(aFn))
        End_Procedure

        // A DF 23 multi-line string's body is text (rules v96): an old class name, DFTrue and a '/api' line in it
        // raise no row and open no report image, a comment ending in triple quotes opens no string, and the code
        // after them still raises its row.
        { Published = True }
        Procedure DeepScan_MultiLineStringBodyIsText
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move '    Set psHtml to """'            to asCode[0]
            Move '        Object oX is a DFPanel'   to asCode[1]
            Move '        Move DFTrue to bA'        to asCode[2]
            Move '        /api/v1'                  to asCode[3]
            Move '        """'                      to asCode[4]
            Move 'Define C_X for 1   // with """'   to asCode[5]
            Move 'Class cMyControl is a DFControl'  to asCode[6]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeObsoleteClassNames" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 7) "the Class line after the string and the comment"
            Get _HitsForFn aHits "ChangeDfTrueDfFalse" to aFn
            Send AssertIAreEqual 0 (SizeOfArray(aFn))
        End_Procedure

        // An @-string's text is text too (2026-10-29): it ends at its first closing quote, and the code after the
        // strings still raises its row - a #COMMAND line in a string's text opens no macro body either.
        { Published = True }
        Procedure DeepScan_AtStringBodyIsText
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move '    Set psHtml to @"Object oA is a DFPanel'  to asCode[0]
            Move '        Object oX is a DFPanel'              to asCode[1]
            Move '        Move DFTrue to bA'                   to asCode[2]
            Move '        End" to sHtml'                       to asCode[3]
            Move '    Set psText to """'                       to asCode[4]
            Move '        #COMMAND NOT_A_MACRO'                to asCode[5]
            Move '        """'                                 to asCode[6]
            Move 'Class cMyControl is a DFControl'             to asCode[7]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeObsoleteClassNames" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 8) "the Class line after the strings"
            Get _HitsForFn aHits "ChangeDfTrueDfFalse" to aFn
            Send AssertIAreEqual 0 (SizeOfArray(aFn))
        End_Procedure

        // Field_Main_Index (rules v94): a call is the Review rule's row, an augmentation the Explain rule's, and
        // the 'Forward Get' inside an augmentation is neither.
        { Published = True }
        Procedure DeepScan_FieldMainIndexSplitsCallsFromAugmentations
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Get Field_Main_Index of hoDD iFile iField to iIndex'                   to asCode[0]
            Move 'Function Field_Main_Index Integer iFile Integer iField Returns Integer'  to asCode[1]
            Move '    Forward Get Field_Main_Index iFile iField to iIndex'                to asCode[2]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeFieldMainIndexToFileFieldIndex" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 1 and aFn[0].eCategory = eModSuggest) "the call"
            Get _HitsForSymbol aHits "Field_Main_Index augmentation" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) ;
                Send Assert (aFn[0].iLine = 2 and aFn[0].eCategory = eModExplain) "the augmentation"
        End_Procedure

        // Reads of the retired ghoWorkspace global (rules v106): a path name is the Review rule's row, any other name
        // the Explain rule's. Another object, an expression, a line going on over ';', a comment and the modern read
        // are neither.
        { Published = True }
        Procedure DeepScan_LegacyWorkspaceReadSplitsPathNamesFromTheRest
            String[] asCode
            tDeepScanHit[] aHits aFn
            Move 'Get CurrentProgramPath of ghoWorkspace to sPath'              to asCode[0]
            Move '    get currentdatapath OF ghoWorkSpace to sDataPath@ // why' to asCode[1]
            Move 'Get Module_Name of ghoWorkSpace to sProgram'                  to asCode[2]
            Move 'Get CurrentProgramPath of oMyWorkspace to sPath'              to asCode[3]
            Move 'Move (CurrentProgramPath(ghoWorkspace)) to sPath'             to asCode[4]
            Move 'If ghoWorkSpace Begin'                                        to asCode[5]
            Move 'Move Self to ghoWorkSpace'                                    to asCode[6]
            Move '// Get CurrentProgramPath of ghoWorkspace to sPath'           to asCode[7]
            Move 'Get psProgramPath of (phoWorkspace(ghoApplication)) to sPath' to asCode[8]
            Move 'Get CurrentProgramPath of ghoWorkspace to ;'                  to asCode[9]
            Move '    sPath'                                                    to asCode[10]
            Get ScanSnippet asCode to aHits
            Get _HitsForFn aHits "ChangeLegacyWorkspaceAccessors" to aFn
            Send AssertIAreEqual 2 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 2) Begin
                Send Assert (aFn[0].iLine = 1 and aFn[0].eCategory = eModSuggest) "the program path"
                Send Assert (aFn[1].iLine = 2 and aFn[1].eCategory = eModSuggest) "the data path, in any case"
                Send Assert (Pos("psDataPath", aFn[1].sHint) > 0) "the row says the new name"
            End
            Get _HitsForSymbol aHits "ghoWorkspace read with no new name" to aFn
            Send AssertIAreEqual 1 (SizeOfArray(aFn))
            If (SizeOfArray(aFn) = 1) Begin
                Send Assert (aFn[0].iLine = 3 and aFn[0].eCategory = eModExplain) "Module_Name"
                Send Assert (Pos("Module_Name", aFn[0].sHint) > 0) "the row names it"
            End
        End_Procedure

    End_Object

