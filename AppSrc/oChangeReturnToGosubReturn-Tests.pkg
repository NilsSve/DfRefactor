//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeReturnToGosubReturn-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-09
//
// Description : Unit tests for the ChangeReturnToGosubReturn refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeReturnToGosubReturn is a cTestFixture
        Set psFunctionName to "ChangeReturnToGosubReturn"

        // return -> Gosub_Return. The bare line is the shape a gosub subroutine ends with.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_BasicSwap
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Gosub_Return' sLine
        End_Procedure

        // Indentation is kept, and the source may be written in any case.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_PreservesIndentAndReadsAnyCase
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    RETURN' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Gosub_Return' sLine
        End_Procedure

        // Whatever follows the command on the line - an end comment - is kept.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_KeepsTheEndComment
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  return // end of the subroutine' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '  Gosub_Return // end of the subroutine' sLine
        End_Procedure

        // An already-modern line is not swapped again (its first word is gosub_return).
        { Published = True }
        Procedure ChangeReturnToGosubReturn_AlreadyModern
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  Gosub_Return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  Gosub_Return' sLine
        End_Procedure

        /* THE ARGUMENT FORM. "Gosub_Return Return" pops past a nested gosub - the second word is an
           ARGUMENT, and swapping it would write "Gosub_Return Gosub_Return". The first-word gate is
           what refuses it, which is the point of having one. */
        { Published = True }
        Procedure ChangeReturnToGosubReturn_ReturnAsAnArgument
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  Gosub_Return Return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  Gosub_Return Return' sLine
        End_Procedure

        // The modern method returns are different first words and are never touched.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_ProcedureAndFunctionReturn
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Function_Return sName' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Function_Return sName' sLine
            Move '    Procedure_Return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Procedure_Return' sLine
        End_Procedure

        /* A NAME MAY START WITH THE WORD. "$" and "." are not identifier characters, so the word
           ends there as far as a boundary-aware search is concerned - but the line is a label, not
           the command. The gate reads the character AFTER the word for exactly this. */
        { Published = True }
        Procedure ChangeReturnToGosubReturn_ALegacyNameStartingWithTheWord
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  return$flag:' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  return$flag:' sLine
            Move '  return.done:' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  return.done:' sLine
        End_Procedure

        // A name that ENDS in the word, later on the line, is not the command either.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_ANameLaterOnTheLine
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  Send Add_Message cfg.key.return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  Send Add_Message cfg.key.return' sLine
            Move '  Move p$return.max to iTop' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  Move p$return.max to iTop' sLine
        End_Procedure

        /* THE DOCUMENTED GAP, recorded rather than left to be discovered: an inline guard puts a
           different word first, so the line keeps its warning and stays a hand edit. Admitting it
           means relaxing the first-word gate, which is what refuses the two tests above. */
        { Published = True }
        Procedure ChangeReturnToGosubReturn_InlineGuardIsRefused
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  If (bDone) return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  If (bDone) return' sLine
            Move '  [ bDone] return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  [ bDone] return' sLine
        End_Procedure

        // Prose is not code: a commented-out line and a mention inside a string literal both stand.
        { Published = True }
        Procedure ChangeReturnToGosubReturn_CommentAndStringAreNotCode
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  // return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  // return' sLine
            Move '  Showln "return"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeReturnToGosubReturn of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '  Showln "return"' sLine
        End_Procedure

    End_Object
