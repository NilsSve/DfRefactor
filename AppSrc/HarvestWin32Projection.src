//****************************************************************************
// $Module type: Program
// $Module name: HarvestWin32Projection
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-28
//
// Description : SERVICE PROGRAM - maintainer tool, not shipped to end users.
//
//               The DataFlex port of Tools\HarvestWin32Projection.py: reads a local clone of
//               Win32_DataFlex_Projection (Frank Cheng, MIT - generated from Microsoft's
//               win32metadata) and merges "DF|"-flavoured rows into this workspace's
//               Data\WinAPICatalog.json and Data\WinAPIStructCatalog.json. The rules - corpus
//               intersection, Pointer->Handle on handle comments, bare-Pointer-return = void ->
//               Integer, struct closure, identity-keyed idempotent merge, provenance stamp -
//               live in cWin32ProjectionHarvester.pkg, where the unit tests reach them.
//
//               Deliberately light: no funclib chain, no UI beyond the summary box, so it
//               compiles and runs whatever state the main program is in.
//
// Usage : HarvestWin32Projection64.exe <clone-folder> [-all]
//         <clone-folder>  a local clone of github.com/frankchengproductions/Win32_DataFlex_Projection
//         -all            harvest every projection function and every named struct, instead of the
//                         corpus intersection and the structs it reaches
//         Reads AppSrc\WindowsAPI.json (the corpus scan) and writes the two Data\*.json
//         catalogues of THIS workspace. A run log goes to Data\HarvestWin32Projection.log.txt.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use DFAllEnt.pkg
Use RefactorConstants.h.pkg
Use vWin32fh.pkg                    // vFolderFormat
Use cEncodingHelpers.pkg            // rfFileSize - RefactorFileIO needs it defined first
Use RefactorFileIO.pkg              // rfOpenOutput / rfDirectoryExists
Use cWin32ProjectionHarvester.pkg   // the engine
Use VdfBase.pkg

Object oApplication is a cApplication
    Set psProduct to "DFRefactor Win32 Projection Harvest"
    Set psCompany to "RDC Tools International"

    Object oHarvester is a cWin32ProjectionHarvester
    End_Object

    // The whole job lives here rather than in a global procedure: Send needs an object
    // context, and a file-scope Procedure has none (see MetaTagCheck.src).
    Procedure HrvRun
        String sClone sArg sHome sData sReport sLog
        String sCorpus sFnJson sStructJson
        Integer iArgs iArg iCh
        Handle hoCmdLine
        Boolean bOK bAll

        Move "" to sClone
        Move False to bAll
        Get phoCommandLine of ghoApplication to hoCmdLine
        If (hoCmdLine <> 0) Begin
            Get CountOfArgs of hoCmdLine to iArgs
            For iArg from 1 to iArgs
                Move (Trim(Argument(hoCmdLine, iArg))) to sArg
                If (Lowercase(sArg) = "-all" or Lowercase(sArg) = "--all") Begin
                    Move True to bAll
                End
                Else Begin
                    If (sArg <> "") Begin
                        Move sArg to sClone
                    End
                    Else Begin
                        Move "C:\Projects\Win32_DataFlex_Projection" to sClone    
                    End
                End
            Loop
        End  
        If (iArgs = 0) Begin   
            Move True to bAll
            Move "C:\Projects\Win32_DataFlex_Projection" to sClone    
        End
            
        If (sClone = "") Begin
            Send Info_Box ("Usage: HarvestWin32Projection64.exe <clone-folder> [-all]" + C_NewLine + C_NewLine ;
                + "Point it at a local clone of" + C_NewLine ;
                + "github.com/frankchengproductions/Win32_DataFlex_Projection." + C_NewLine + C_NewLine ;
                + "It merges into this workspace's Data\WinAPICatalog.json and" + C_NewLine ;
                + "Data\WinAPIStructCatalog.json; -all skips the corpus intersection.") "Win32 Projection Harvest"
            Procedure_Return
        End

        Get psHome of (phoWorkspace(ghoApplication)) to sHome
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move (vFolderFormat(sHome) + "AppSrc\" + CS_WindowsAPICorpusJson) to sCorpus
        Move (vFolderFormat(sData) + CS_WinAPICatalogJson) to sFnJson
        Move (vFolderFormat(sData) + CS_WinAPIStructCatalogJson) to sStructJson
        
        Send Cursor_Wait of Cursor_Control
        Set pbHarvestAll of oHarvester to bAll
        Get HarvestClone of oHarvester sClone sCorpus sFnJson sStructJson (&sReport) to bOK
        Send Cursor_Ready of Cursor_Control

        // The log first - a summary box can be dismissed, the log is the record.
        Move (vFolderFormat(sData) + "HarvestWin32Projection.log.txt") to sLog
        Get rfOpenOutput sLog to iCh
        If (iCh >= 0) Begin
            Writeln channel iCh ("*** HarvestWin32Projection -- clone: " + sClone + (If(bAll, " (-all)", "")) + " ***")
            Writeln channel iCh sReport
            Send rfCloseOutput iCh
        End
        If (bOK = True) Begin
            Send Info_Box ("Harvest complete." + C_NewLine + C_NewLine + sReport + C_NewLine + C_NewLine ;
                + "Log: " + sLog) "Win32 Projection Harvest"
        End
        Else Begin
            Send Stop_Box ("Harvest did NOT complete:" + C_NewLine + C_NewLine + sReport) "Win32 Projection Harvest"
        End
    End_Procedure

End_Object

Send HrvRun of oApplication
