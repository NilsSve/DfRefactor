//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeLegacyTypeCast-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-19
//
// Description : The DF26 type-name cast (2026-08-19). Handle(x), Pointer(x), Boolean(x), DateTime(x) and UChar(x)
//               are not conversion functions in DataFlex 26 - each errors 4328 "Undefined symbol in argument", and
//               for two of them the message names an INTERNAL type name the source never contains (Handle reports
//               LONGPTR, Pointer reports ADDRESS). Integer / String / Number / Date ARE legal casts and must survive
//               untouched. Both halves were probe-compiled against the real DF26 compiler before the converter was
//               written; these tests pin the rewrite itself.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Object oChangeLegacyTypeCast is a cTestFixture
    Set psFunctionName to "ChangeLegacyTypeCast"

    Function Rewritten String sLine Returns String
        Integer iVoid
        Get _LegacyTypeCastInLine of ghoFuncLib (&sLine) to iVoid
        Function_Return sLine
    End_Function

    // The WinServ line, verbatim.
    {Published = True}
    Procedure TypeCast_HandleSelfInSendArgument
        Send AssertSAreEqual "        Send exportGridToExcel (Cast(Self, Handle))" ;
                             (Rewritten(Self, "        Send exportGridToExcel (Handle(Self))"))
    End_Procedure

    {Published = True}
    Procedure TypeCast_AllEighteenTypes
        // The original five (probed 2026-08-19).
        Send AssertSAreEqual "Move (Cast(Self, Handle)) to h"   (Rewritten(Self, "Move (Handle(Self)) to h"))
        Send AssertSAreEqual "Move (Cast(0, Pointer)) to p"     (Rewritten(Self, "Move (Pointer(0)) to p"))
        Send AssertSAreEqual "Move (Cast(1, Boolean)) to b"     (Rewritten(Self, "Move (Boolean(1)) to b"))
        Send AssertSAreEqual "Move (Cast(65, UChar)) to u"      (Rewritten(Self, "Move (UChar(65)) to u"))
        Send AssertSAreEqual "Move (Cast(sD, DateTime)) to dt"  (Rewritten(Self, "Move (DateTime(sD)) to dt"))
        // The thirteen the first pass missed (probed 2026-08-30). Each one was compiled in the call
        // form against the 26.0 toolchain and errors 4328 - see _LegacyTypeCastInLine for the method.
        Send AssertSAreEqual "Move (Cast(iX, Longptr)) to lp"   (Rewritten(Self, "Move (Longptr(iX)) to lp"))
        Send AssertSAreEqual "Move (Cast(iX, ULongptr)) to up"  (Rewritten(Self, "Move (ULongptr(iX)) to up"))
        Send AssertSAreEqual "Move (Cast(iX, Address)) to a"    (Rewritten(Self, "Move (Address(iX)) to a"))
        Send AssertSAreEqual "Move (Cast(iX, UInteger)) to ui"  (Rewritten(Self, "Move (UInteger(iX)) to ui"))
        Send AssertSAreEqual "Move (Cast(iX, DWord)) to dw"     (Rewritten(Self, "Move (DWord(iX)) to dw"))
        Send AssertSAreEqual "Move (Cast(iX, Word)) to w"       (Rewritten(Self, "Move (Word(iX)) to w"))
        Send AssertSAreEqual "Move (Cast(iX, Short)) to sh"     (Rewritten(Self, "Move (Short(iX)) to sh"))
        Send AssertSAreEqual "Move (Cast(iX, BigInt)) to bi"    (Rewritten(Self, "Move (BigInt(iX)) to bi"))
        Send AssertSAreEqual "Move (Cast(iX, Char)) to c"       (Rewritten(Self, "Move (Char(iX)) to c"))
        Send AssertSAreEqual "Move (Cast(iX, Byte)) to by"      (Rewritten(Self, "Move (Byte(iX)) to by"))
        Send AssertSAreEqual "Move (Cast(iX, RowId)) to ri"     (Rewritten(Self, "Move (RowId(iX)) to ri"))
        Send AssertSAreEqual "Move (Cast(iX, Variant)) to v"    (Rewritten(Self, "Move (Variant(iX)) to v"))
        Send AssertSAreEqual "Move (Cast(iX, TimeSpan)) to ts"  (Rewritten(Self, "Move (TimeSpan(iX)) to ts"))
    End_Procedure

    // The LEGAL casts are left exactly as they are - rewriting them would be a regression, not a fix.
    {Published = True}
    Procedure TypeCast_LegalCastsUntouched
        Send AssertSAreEqual "Move (Integer(sX)) to i" (Rewritten(Self, "Move (Integer(sX)) to i"))
        Send AssertSAreEqual "Move (String(42)) to s"  (Rewritten(Self, "Move (String(42)) to s"))
        Send AssertSAreEqual "Move (Number(sX)) to n"  (Rewritten(Self, "Move (Number(sX)) to n"))
        Send AssertSAreEqual "Move (Date(sX)) to d"    (Rewritten(Self, "Move (Date(sX)) to d"))
        // Real joined this list on 2026-08-30: it compiles in the call form, so widening the type
        // list must not have swept it up. The five legal casts are the guard against over-reach -
        // Integer is legal while UInteger is not, and Date is legal while DateTime is not, so the
        // boundary cannot be inferred from the names and has to be pinned by test.
        Send AssertSAreEqual "Move (Real(sX)) to r"    (Rewritten(Self, "Move (Real(sX)) to r"))
    End_Procedure

    // A DECLARATION is not a call: the type name is followed by an identifier, never by "(".
    {Published = True}
    Procedure TypeCast_DeclarationUntouched
        Send AssertSAreEqual "        Handle hMenu"        (Rewritten(Self, "        Handle hMenu"))
        Send AssertSAreEqual "        Boolean bOK bDone"   (Rewritten(Self, "        Boolean bOK bDone"))
        Send AssertSAreEqual "    Function Foo Handle hWnd Returns Boolean" ;
                             (Rewritten(Self, "    Function Foo Handle hWnd Returns Boolean"))
    End_Procedure

    // IDEMPOTENT: the converted form contains the type name, but not followed by "(".
    {Published = True}
    Procedure TypeCast_AlreadyConvertedUntouched
        Send AssertSAreEqual "Move (Cast(Self, Handle)) to h" (Rewritten(Self, "Move (Cast(Self, Handle)) to h"))
    End_Procedure

    // A nested argument keeps its own parens - the matching close is found, not the first one.
    {Published = True}
    Procedure TypeCast_NestedArgument
        Send AssertSAreEqual "Move (Cast(Value(oF, 3), Handle)) to h" ;
                             (Rewritten(Self, "Move (Handle(Value(oF, 3))) to h"))
    End_Procedure

    // TWO casts on one line: both go (the scan restarts after each rewrite).
    {Published = True}
    Procedure TypeCast_TwoOnOneLine
        Send AssertSAreEqual "Send Foo (Cast(Self, Handle)) (Cast(1, Boolean))" ;
                             (Rewritten(Self, "Send Foo (Handle(Self)) (Boolean(1))"))
    End_Procedure

    // Inside a STRING or a comment there is no code - the masked line hides both.
    {Published = True}
    Procedure TypeCast_StringAndCommentUntouched
        Send AssertSAreEqual ('Move "Handle(Self)" to s') (Rewritten(Self, ('Move "Handle(Self)" to s')))
        Send AssertSAreEqual "// Move (Handle(Self)) to h" (Rewritten(Self, "// Move (Handle(Self)) to h"))
    End_Procedure

    /* THE LINE THAT HUNG THE TEST RUNNER (2026-08-19). When one of the type names is the LAST token on
       the line, the scan for the "(" runs past the end - and in DataFlex a Mid() past the end returns ""
       while ("" = " ") is TRUE, so the space-skipping loop never terminated. Any of these three lines
       reproduces it; they take a fraction of a second when the loop is bounded and hang forever when it
       is not. */
    {Published = True}
    Procedure TypeCast_TypeNameAsTheLastTokenTerminates
        Send AssertSAreEqual "        Handle"      (Rewritten(Self, "        Handle"))
        Send AssertSAreEqual "Send Foo Handle"     (Rewritten(Self, "Send Foo Handle"))
        Send AssertSAreEqual "Move x to y // UChar" (Rewritten(Self, "Move x to y // UChar"))
    End_Procedure

    // The count is the number of rewrites, and 0 means "nothing here".
    {Published = True}
    Procedure TypeCast_CountIsTheRewriteCount
        String sLine
        Integer iN
        Move "Send Foo (Handle(Self)) (Boolean(1))" to sLine
        Get _LegacyTypeCastInLine of ghoFuncLib (&sLine) to iN
        Send AssertIAreEqual 2 iN
        Move "Move (Integer(sX)) to i" to sLine
        Get _LegacyTypeCastInLine of ghoFuncLib (&sLine) to iN
        Send AssertIAreEqual 0 iN
    End_Procedure

End_Object
