//****************************************************************************
// $Module type: Class
// $Module name: cFunctionParameterColumn
// $Author     : DFRefactor
//
// Description : The Parameter column of a functions grid - the Select Functions view's and the refactoring plan
//               dialog's, which each carried their own until 2026-10-09. An in-cell combo FILLED PER ROW from the
//               grid's hidden ParameterValidation column before the cell is entered: under DataFlex 26's CodeJock
//               24.3 the editor takes its constraint list when it starts, so a fill on entry is too late (Nils
//               2026-09-17 - the list showed only the current value and refused every pick). "ANY" means free
//               text. The tooltip says REQUIRED while a function that does nothing without a value has none
//               (Nils 2026-08-06 - four converters work on a name the compiler supplied, and a manual tick
//               reaches them empty), else the row's ParameterHelp, else the general note.
//
//               The object sets Entry_Item, piWidth and psToolTip, and names the grid's columns the class
//               reads - ParameterValidationColumn, ParameterHelpColumn, FunctionNameColumn - as hooks, since
//               those columns are defined after it in the file. The grid's OnRowChanged sends
//               ComboFillListForRow for the row the user has just moved to; OnEntry repeats it for the
//               focused row as a belt.
//****************************************************************************
Use cRDCDbCJGridColumn.pkg
Use RefactorConstants.h.pkg      // ghoFuncLib - FunctionRequiresParameter

Class cFunctionParameterColumn is a cRDCDbCJGridColumn

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psCaption to "Parameter"
        Set peHeaderAlignment to xtpAlignmentCenter
        Set pbComboButton to True
        // pbEditable *must* be set after the pbComboButton setting.
        Set pbComboEntryState to False
        Set pbEditable to True
    End_Procedure

    // THE GRID'S COLUMNS THIS ONE READS. The object answers with its own - (oName(Self)), after a Register_Object
    // for a column defined later in its file. 0 = none, and the part that needs it does nothing.
    Function ParameterValidationColumn Returns Handle   // the comma-separated values, or ANY
        Function_Return 0
    End_Function

    Function ParameterHelpColumn Returns Handle         // the row's own help text
        Function_Return 0
    End_Function

    Function FunctionNameColumn Returns Handle          // the function's name, for the REQUIRED check
        Function_Return 0
    End_Function

    /* THE LIST IS FILLED PER ROW, BEFORE THE CELL IS ENTERED. The combo button is toggled only when its state
       actually changes, so an editor is never rebuilt under the mouse. The values come from the hidden
       ParameterValidation column - never from the DD buffer, which need not be positioned yet. */
    Procedure ComboFillListForRow Integer iRow
        String sParameterList
        String[] asParameters
        Integer iSize iCount
        Boolean bButton bEntry
        Handle hoColumn

        If (iRow < 0) ;
            Procedure_Return
        Get ParameterValidationColumn to hoColumn
        If (hoColumn = 0) ;
            Procedure_Return
        Get RowValue of hoColumn iRow to sParameterList
        Move (Trim(sParameterList)) to sParameterList
        // "ANY" signals a free-text parameter: the user may type any value.
        If (Lowercase(sParameterList) = "any") Begin
            Move False to bButton
            Move True  to bEntry
        End
        Else If (sParameterList <> "") Begin
            Move True to bButton
            Move True to bEntry
        End
        Else Begin
            Move False to bButton
            Move False to bEntry
        End
        If (pbComboButton(Self) <> bButton) ;
            Set pbComboButton to bButton
        If (pbComboEntryState(Self) <> bEntry) ;
            Set pbComboEntryState to bEntry
        Send ComboDeleteData
        If (bButton = True) Begin
            Get StrSplitToArray sParameterList "," to asParameters
            Move (SizeOfArray(asParameters)) to iSize
            Decrement iSize
            For iCount from 0 to iSize
                Send ComboAddItem (Trim(asParameters[iCount])) iCount
            Loop
        End
    End_Procedure

    /* The base class sends this once at DD binding - before the grid's COM object exists (the row query faults
       4399 there) and before any row is current - so it is a no-op until the grid is realized; OnEntry below is
       the live caller. THE ROW COMES FROM THE DATA SOURCE, never from CodeJock's focused row (Nils 2026-09-17:
       the list showed the NEIGHBOURING row's values). The grid's focus-changing sequence is: data source's
       SelectedRow moved + OnRowChanged, THEN the column's Entry - and CodeJock's own focused row still points at
       the row being LEFT at that moment, so a fill keyed on it overwrote the right list with the previous row's. */
    Procedure ComboFillList
        Integer iRow
        Boolean bCreated
        Handle hoGrid hoDataSource

        Move (Parent(Self)) to hoGrid
        Get IsComObjectCreated of hoGrid to bCreated
        If (bCreated = False) ;
            Procedure_Return
        Get phoDataSource of hoGrid to hoDataSource
        If (hoDataSource = 0) ;
            Procedure_Return
        Get SelectedRow of hoDataSource to iRow
        Send ComboFillListForRow iRow
    End_Procedure

    Procedure OnEntry
        Send ComboFillList
    End_Procedure

    /* REQUIRED FIRST, then the row's help, then the note. A tooltip, not a colour: the column class is
       library-level, so there is no per-cell format hook; the load-bearing warning is the one in the run
       confirmation, which names these functions before anything starts (cRefactorEngine.StartWarning) - this is
       the cue at the place the value is typed. The Select Functions view carried the REQUIRED tooltip and the
       help tooltip as two definitions of this function on one object, of which only one could be in effect. */
    Function OnGetTooltip Integer iRow String sValue String sText Returns String
        String sName
        Boolean bNeeds
        Handle hoColumn

        Get FunctionNameColumn to hoColumn
        If (hoColumn <> 0 and ghoFuncLib <> 0) Begin
            Get RowValue of hoColumn iRow to sName
            Get FunctionRequiresParameter of ghoFuncLib sName to bNeeds
            If (bNeeds = True and Trim(sValue) = "") ;
                Function_Return ("REQUIRED - this function does nothing until you give it one." + C_NewLine + C_NewLine + "A guided Check fills it in from the compiler message; set it here to run it by hand.")
        End
        Get ParameterHelpColumn to hoColumn
        If (hoColumn <> 0) ;
            Get RowValue of hoColumn iRow to sText
        If (sText <> "") Begin
            Move (Replaces("\r\n", sText, C_NewLine)) to sText
            Move (Replaces("\n", sText, C_NewLine)) to sText
        End
        Else ;
            Move "For some functions an extra parameter is used. You can only select from existing values, unless the function's meta-data is { EnumList = 'ANY' }. Hover a value to see the valid choices." to sText
        Function_Return sText
    End_Function

End_Class
