// Created     : 2026-07-14
//
// Description : Unit tests for the LegacyDfPathReport scan core (_LegacyDfPathScanFile, cRefactorFuncLib): a pure
//               whole-file classifier - no engine/file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oLegacyDfPathReport is a cTestFixture
        Set psFunctionName to "LegacyDfPathReport"

        // The obsolete Set_dfpath command at command position is flagged (both the "to <paths>" form and
        // the bare clear form), with the cWorkspace-pathing note; a mention inside a string and the MODERN
        // "Set psDfPath ..." replacement are NOT flagged (their first word is "Set", not "set_dfpath").
        {Published = True}
        Procedure LegacyDfPathReport_ScanFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    Set_dfpath to sSearchPath"                                   to asCode[0]
            Move '    Set_dfpath ""'                                               to asCode[1]
            Move '    Move "set_dfpath" to sLabel'                                 to asCode[2]
            Move "    Set psDfPath of (phoWorkspace(ghoApplication)) to sNewPath"  to asCode[3]
            Get _LegacyDfPathScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 2 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "Line 2:")           // the bare clear form is flagged too
            Send Assert (sAll contains "cWorkspace")        // the pathing note
            Send Assert (sAll contains "psSystemDfPath")    // append-option hint
            // the masked-string line (3) and the MODERN Set psDfPath call (4) are NOT flagged
            Send Assert (not(sAll contains "Line 3:"))
            Send Assert (not(sAll contains "Line 4:"))
        End_Procedure

        // No Set_dfpath -> nothing; a modern "Set ps<X>Path of (phoWorkspace...)" is not mistaken for the
        // legacy command.
        {Published = True}
        Procedure LegacyDfPathReport_NoHits
            String[] asCode asReport
            Integer iN
            Move "    Move 1 to iX"                                                 to asCode[0]
            Move "    Set psDataPath of (phoWorkspace(ghoApplication)) to sDataDir" to asCode[1]
            Get _LegacyDfPathScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

    End_Object
