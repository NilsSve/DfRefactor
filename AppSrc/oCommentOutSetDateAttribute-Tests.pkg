// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCommentOutSetDateAttribute is a cTestFixture
        Set psFunctionName to "CommentOutSetDateAttribute"

        // Set_Date_Attribute sysdate4_State to X -> // Set_Date_Attribute sysdate4_State to X // no longer needed.
        // LegacyApp GVAR.INC:835 - 4533 "Obsolete command: Set_Date_Attribute. Use Set_Attribute DF_DATE_FORMAT".
        { Published = True }
        Procedure CommentOutSetDateAttribute_SysDate4State
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set_Date_Attribute sysdate4_State to (sUseEpoch="TRUE")' to sLine
            Move '    // Set_Date_Attribute sysdate4_State to (sUseEpoch="TRUE") // no longer needed' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutSetDateAttribute of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The Date4_State variant with aligned (multi-space) formatting - internal spacing is preserved.
        { Published = True }
        Procedure CommentOutSetDateAttribute_Date4State
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Set_Date_Attribute Date4_State    to (sUseEpoch="TRUE")' to sLine
            Move '    // Set_Date_Attribute Date4_State    to (sUseEpoch="TRUE") // no longer needed' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutSetDateAttribute of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The epoch_value variant.
        { Published = True }
        Procedure CommentOutSetDateAttribute_EpochValue
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        Set_Date_Attribute epoch_value    to (sEpoch)' to sLine
            Move '        // Set_Date_Attribute epoch_value    to (sEpoch) // no longer needed' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutSetDateAttribute of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A non-Set_Date_Attribute line is left untouched.
        { Published = True }
        Procedure CommentOutSetDateAttribute_NotACommand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Move (CurrentDateTime()) to dToday' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutSetDateAttribute of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
        End_Procedure

        // Idempotent: an already-commented Set_Date_Attribute line is not re-commented (no "// // ...").
        { Published = True }
        Procedure CommentOutSetDateAttribute_AlreadyCommented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    // Set_Date_Attribute sysdate4_State to (sUseEpoch="TRUE") // no longer needed' to sLine
            Move '    // Set_Date_Attribute sysdate4_State to (sUseEpoch="TRUE") // no longer needed' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutSetDateAttribute of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

    End_Object
