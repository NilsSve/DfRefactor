//****************************************************************************
// $Module type: Test fixture
// $Module name: oWin32ProjectionHarvester-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-28
//
// Description : Unit tests for cWin32ProjectionHarvester - the DataFlex port of the Python harvest tool
//               (Tools\HarvestWin32Projection.py). Fixtures are small in-memory line arrays; no test
//               touches the real catalogue files or needs a clone on disk. The port was proven against
//               the live clone before these were written: 18,300 parsed and 1,293 corpus-chosen, key for
//               key what the Python tool selects. Two porting scars these tests pin so they cannot heal
//               open: the sort-index separator must be a SPACE (a Chr(1) pack looked clever and lost 12
//               prefix-family names - GdipDrawCurve beside GdipDrawCurve2 - because DataFlex string
//               compares run through the collation table, not byte order), and the head parser must
//               reject non-word names (the clone's ordinal '#660').
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cWin32ProjectionHarvester.pkg

Object oWin32ProjectionHarvester_Tests is a cTestFixture
    Set psFunctionName to "cWin32ProjectionHarvester"

    Object oHrv is a cWin32ProjectionHarvester
    End_Object

    // The generated shape parses: head, commented and plain params, Returns - and a
    // procedure-shaped declaration (no Returns) is out of scope.
    {Published = True}
    Procedure Hrv_ParsesTheGeneratedFunctionShape
        tW32ProjFn[] aFns
        String[] asLines
        Move 'External_Function keybd_event "keybd_event" USER32.dll ;'       to asLines[0]
        Move (Character(9) + 'UChar bVk ;')                                   to asLines[1]
        Move (Character(9) + 'UInteger dwFlags ;' + Character(9) + '// KEYBD_EVENT_FLAGS') to asLines[2]
        Move (Character(9) + 'ULongPtr dwExtraInfo ;')                        to asLines[3]
        Move (Character(9) + 'Returns Pointer')                               to asLines[4]
        Move ''                                                               to asLines[5]
        Move 'External_Function NoReturns "NoReturns" X.dll ;'                to asLines[6]
        Move (Character(9) + 'UChar a ;')                                     to asLines[7]
        Move ''                                                               to asLines[8]
        Send ParseFunctionFile of oHrv (&asLines) (&aFns)
        Send AssertIAreEqual 1 (SizeOfArray(aFns))
        Send AssertSAreEqual "keybd_event" aFns[0].sName
        Send AssertSAreEqual "USER32.dll" aFns[0].sDll
        Send AssertIAreEqual 3 (SizeOfArray(aFns[0].asParamType))
        Send AssertSAreEqual "KEYBD_EVENT_FLAGS" aFns[0].asParamComment[1]
        Send AssertSAreEqual "Pointer" aFns[0].sRet
        Send AssertSAreEqual "" aFns[0].sRetComment
    End_Procedure

    // The ordinal-named declaration the clone really holds is rejected, as the original did -
    // because an ordinal has no name for a legacy declaration to match, NOT because it fails to
    // compile. DataFlex 26 accepts "#660" in both the declaration and the call (measured
    // 2026-08-30); the long-standing assumption that it could not was wrong.
    {Published = True}
    Procedure Hrv_OrdinalNameIsRejected
        tW32ProjFn[] aFns
        String[] asLines
        Move 'External_Function #660 "#660" SHELL32.dll ;' to asLines[0]
        Move (Character(9) + 'Returns Integer')            to asLines[1]
        Send ParseFunctionFile of oHrv (&asLines) (&aFns)
        Send AssertIAreEqual 0 (SizeOfArray(aFns))
    End_Procedure

    // The void rule, as it stands after upstream cec3389 (2026-08-30) made void EXPLICIT:
    // Void_Type rides through untouched, an explicit "// void" comment normalises to that same
    // spelling, and a bare uncommented Pointer is LEFT ALONE. That last one is the reversal - it
    // used to become Integer, on the observation that a bare row meant void, which held for all
    // 1,384 bare rows at head 7319adc and holds for none at cec3389 (zero bare rows remain; all
    // 1,427 pointer returns now carry their C type). A bare row reappearing would therefore be a
    // genuine pointer whose comment has not landed, and calling it Integer truncates on x64.
    // The handle rule: Pointer with an H-type comment becomes Handle - HRESULT is an integer,
    // and a lowercase comment is prose, not a C type.
    {Published = True}
    Procedure Hrv_NormalisationRules
        String sOut
        Get NormaliseReturn of oHrv "Void_Type" ""      to sOut
        Send AssertSAreEqual "Void_Type" sOut
        Get NormaliseReturn of oHrv "Pointer" ""        to sOut
        Send AssertSAreEqual "Pointer" sOut
        Get NormaliseReturn of oHrv "Pointer" "void"    to sOut
        Send AssertSAreEqual "Void_Type" sOut
        Get NormaliseReturn of oHrv "Pointer" "FARPROC" to sOut
        Send AssertSAreEqual "Pointer" sOut
        Get NormaliseType of oHrv "Pointer" "HWND"      to sOut
        Send AssertSAreEqual "Handle" sOut
        Get NormaliseType of oHrv "Pointer" "HRESULT"   to sOut
        Send AssertSAreEqual "Pointer" sOut
        Get NormaliseType of oHrv "Pointer" "hwnd"      to sOut
        Send AssertSAreEqual "Pointer" sOut
        Get NormaliseType of oHrv "Pointer" "HDC*"      to sOut
        Send AssertSAreEqual "Handle" sOut
    End_Procedure

    // A function row flattens to one line with the refs tail naming known structs.
    {Published = True}
    Procedure Hrv_FunctionRowShape
        tW32ProjFn Fn
        String[] asStLC
        String sRow
        Move "FindFirstFileW"  to Fn.sName
        Move "FindFirstFileW"  to Fn.sEntry
        Move "KERNEL32.dll"    to Fn.sDll
        Move "WString"         to Fn.asParamType[0]
        Move "lpFileName"      to Fn.asParamName[0]
        Move "PWSTR"           to Fn.asParamComment[0]
        Move "Pointer"         to Fn.asParamType[1]
        Move "lpFindFileData"  to Fn.asParamName[1]
        Move "WIN32_FIND_DATAW*" to Fn.asParamComment[1]
        Move "Pointer"         to Fn.sRet
        Move "HANDLE"          to Fn.sRetComment
        Move "win32_find_dataw" to asStLC[0]
        Get FunctionRow of oHrv Fn (&asStLC) to sRow
        Send AssertSAreEqual 'kernel32.dll|findfirstfilew|DF|External_Function FindFirstFileW "FindFirstFileW" KERNEL32.dll WString lpFileName Pointer lpFindFileData Returns Handle // ptrs: 2=WIN32_FIND_DATAW* // refs: WIN32_FIND_DATAW // args: 2=WIN32_FIND_DATAW' sRow
    End_Procedure

    /* "// ptrs:" keeps the C type behind each raw-memory parameter of an ...A / ...W entry, because that
       is the only place GetComputerNameA and GetComputerNameW differ: both declare "Pointer lpBuffer".
       A handle comment makes the parameter a Handle, not raw memory, and marshalled text (String /
       WString) is not raw memory either - neither belongs in the tail (2026-11-21). */
    {Published = True}
    Procedure Hrv_FunctionRowPtrsTailOnAnsiAndWideEntries
        tW32ProjFn Fn
        String[] asStLC
        String sRow
        Move "GetThingA"       to Fn.sName
        Move "GetThingA"       to Fn.sEntry
        Move "KERNEL32.dll"    to Fn.sDll
        Move "Pointer"         to Fn.asParamType[0]
        Move "hWnd"            to Fn.asParamName[0]
        Move "HWND"            to Fn.asParamComment[0]
        Move "Pointer"         to Fn.asParamType[1]
        Move "lpBuffer"        to Fn.asParamName[1]
        Move "PSTR"            to Fn.asParamComment[1]
        Move "String"          to Fn.asParamType[2]
        Move "lpName"          to Fn.asParamName[2]
        Move "PSTR"            to Fn.asParamComment[2]
        Move "Pointer"         to Fn.asParamType[3]
        Move "nSize"           to Fn.asParamName[3]
        Move "UInteger*"       to Fn.asParamComment[3]
        Move "Integer"         to Fn.sRet
        Move "BOOL"            to Fn.sRetComment
        Get FunctionRow of oHrv Fn (&asStLC) to sRow
        Send AssertSAreEqual 'kernel32.dll|getthinga|DF|External_Function GetThingA "GetThingA" KERNEL32.dll Handle hWnd Pointer lpBuffer String lpName Pointer nSize Returns Integer // ptrs: 2=PSTR 4=UInteger*' sRow

        // POSITIVE CONTROL: the same declaration under a name that is neither ...A nor ...W has no
        // twin to be compared with, so it carries no tail - the catalogue does not grow for nothing.
        Move "GetThing"        to Fn.sName
        Move "GetThing"        to Fn.sEntry
        Get FunctionRow of oHrv Fn (&asStLC) to sRow
        Send AssertIAreEqual 0 (Pos("// ptrs:", sRow))
    End_Procedure

    /* "// args:" says which parameter takes which struct, because refs cannot. Only a pointer to the struct
       itself counts: a pointer to a pointer is not somewhere a caller hands a buffer, a scalar pointer is
       not a struct, and a name with no star is the struct by value (2026-11-04). */
    {Published = True}
    Procedure Hrv_FunctionRowArgsPerParameter
        tW32ProjFn Fn
        String[] asStLC
        String sRow
        Move "InsertThing"     to Fn.sName
        Move "InsertThing"     to Fn.sEntry
        Move "USER32.dll"      to Fn.sDll
        Move "Pointer"         to Fn.asParamType[0]
        Move "lpOut"           to Fn.asParamName[0]
        Move "MENUITEMINFOA**" to Fn.asParamComment[0]
        Move "Pointer"         to Fn.asParamType[1]
        Move "lpId"            to Fn.asParamName[1]
        Move "UInteger*"       to Fn.asParamComment[1]
        Move "Integer"         to Fn.asParamType[2]
        Move "byValue"         to Fn.asParamName[2]
        Move "MENUITEMINFOA"   to Fn.asParamComment[2]
        Move "Pointer"         to Fn.asParamType[3]
        Move "lpmi"            to Fn.asParamName[3]
        Move "MENUITEMINFOA*"  to Fn.asParamComment[3]
        Move "Integer"         to Fn.sRet
        Move "BOOL"            to Fn.sRetComment
        Move "menuiteminfoa"   to asStLC[0]
        Get FunctionRow of oHrv Fn (&asStLC) to sRow
        Send AssertSAreEqual "// refs: MENUITEMINFOA // args: 4=MENUITEMINFOA" (Right(sRow, 47))
    End_Procedure

    // Struct parse: first declaration of a name wins, comment lines drop, members keep their
    // C-type tails and the handle rule applies to member types too.
    {Published = True}
    Procedure Hrv_StructParseFirstWins
        String[] asLines asNames asBodies
        Move 'Struct DEMO'                                        to asLines[0]
        Move (Character(9) + '// banner comment')                 to asLines[1]
        Move (Character(9) + 'Pointer hIcon ;' + Character(9) + '// HICON') to asLines[2]
        Move 'End_Struct'                                         to asLines[3]
        Move 'Struct DEMO'                                        to asLines[4]
        Move (Character(9) + 'Integer iOther')                    to asLines[5]
        Move 'End_Struct'                                         to asLines[6]
        Send ParseStructFile of oHrv (&asLines) (&asNames) (&asBodies)
        Send AssertIAreEqual 1 (SizeOfArray(asNames))
        Send AssertSAreEqual "DEMO" asNames[0]
        Send Assert (asBodies[0] contains "Handle hIcon")
        Send Assert (not(asBodies[0] contains "banner"))
    End_Procedure

    /* THE SEPARATOR SCAR: the lookup index must find a key that is a strict PREFIX of its
       neighbours. Packed with Chr(1) this lost GdipDrawCurve beside GdipDrawCurve2/3 - twelve
       real corpus functions - because DataFlex compares by collation, where a control character
       does not order below '2'. A space does, and can never occur inside dll|entry. */
    {Published = True}
    Procedure Hrv_IndexFindsPrefixFamilyBase
        tW32ProjFn[] aFns
        String[] asIdx
        Integer iHit
        Move "GdipDrawCurve"  to aFns[0].sName
        Move "GdipDrawCurve"  to aFns[0].sEntry
        Move "gdiplus.dll"    to aFns[0].sDll
        Move "GdipDrawCurve2" to aFns[1].sName
        Move "GdipDrawCurve2" to aFns[1].sEntry
        Move "gdiplus.dll"    to aFns[1].sDll
        Move "GdipDrawCurve3" to aFns[2].sName
        Move "GdipDrawCurve3" to aFns[2].sEntry
        Move "gdiplus.dll"    to aFns[2].sDll
        Send BuildFnIndex of oHrv (&aFns) (&asIdx)
        Get _FindProjFn of oHrv (&asIdx) "gdiplus.dll|gdipdrawcurve" to iHit
        Send AssertIAreEqual 0 iHit
        Get _FindProjFn of oHrv (&asIdx) "gdiplus.dll|gdipdrawcurve3" to iHit
        Send AssertIAreEqual 2 iHit
        Get _FindProjFn of oHrv (&asIdx) "gdiplus.dll|gdipdrawcurve9" to iHit
        Send AssertIAreEqual -1 iHit
    End_Procedure

    // What the projection made up is told from what Windows named, with or without a leading underscore.
    {Published = True}
    Procedure Hrv_GeneratedNamesAreToldFromWindowsOwn
        Send Assert (_IsGeneratedStructName(oHrv, "_Anonymous_e__Union_2975"))
        Send Assert (_IsGeneratedStructName(oHrv, "_Anonymous1_e__Struct_12"))
        Send Assert (_IsGeneratedStructName(oHrv, "_BitField_1843"))
        Send Assert (_IsGeneratedStructName(oHrv, "__DummyPinType__"))
        Send Assert (_IsGeneratedStructName(oHrv, "NMHDR") = False)
        Send Assert (_IsGeneratedStructName(oHrv, "_URB_HEADER") = False)
        Send Assert (_IsGeneratedStructName(oHrv, "__UPV") = False)
        Send Assert (_IsGeneratedStructName(oHrv, "_PACKAGE_INFO_REFERENCE") = False)
    End_Procedure

    // First declaration wins across files too, settled once, with the order kept.
    {Published = True}
    Procedure Hrv_KeepFirstStructsAcrossFiles
        String[] asNames asBodies
        Move "ZED"  to asNames[0]
        Move "z1"   to asBodies[0]
        Move "AMY"  to asNames[1]
        Move "a1"   to asBodies[1]
        Move "zed"  to asNames[2]
        Move "z2"   to asBodies[2]
        Move "ZED2" to asNames[3]
        Move "y1"   to asBodies[3]
        Send _KeepFirstStructs of oHrv (&asNames) (&asBodies)
        Send AssertIAreEqual 3 (SizeOfArray(asNames))
        Send AssertSAreEqual "ZED"  asNames[0]
        Send AssertSAreEqual "z1"   asBodies[0]
        Send AssertSAreEqual "AMY"  asNames[1]
        Send AssertSAreEqual "ZED2" asNames[2]
        Send AssertSAreEqual "y1"   asBodies[2]
    End_Procedure

    // Only what the catalogue does not hold, underscores in the key included.
    {Published = True}
    Procedure Hrv_RowsNotCarriedAddsOnly
        String[] asExisting asNew asOut
        Move "D3D12_X|DF|old"  to asExisting[0]
        Move "AB_C|DF|old"     to asExisting[1]
        Move "D3D12_X|DF|new"  to asNew[0]
        Move "ABC|DF|new"      to asNew[1]
        Move "AB_C|DF|new"     to asNew[2]
        Send _RowsNotCarried of oHrv (&asExisting) (&asNew) 1 (&asOut)
        Send AssertIAreEqual 1 (SizeOfArray(asOut))
        Send AssertSAreEqual "ABC|DF|new" asOut[0]
    End_Procedure

    Procedure _WriteFile String sPath String[] asLines
        Integer iCh i
        Get rfOpenOutput sPath to iCh
        If (iCh >= 0) Begin
            For i from 0 to (SizeOfArray(asLines) - 1)
                Writeln channel iCh asLines[i]
            Loop
            Send rfCloseOutput iCh
        End
    End_Procedure

    /* THE WHOLE RUN on a clone in a temp folder. A struct no function names arrives; a row already there stays as it
       was even when the clone says something else; a generated helper does not arrive; and the second run adds nothing. */
    {Published = True}
    Procedure Hrv_HarvestAllAddsEveryNamedStructAndChangesNoRow
        String[] asFn asSt asExisting asOut asNone
        String sRoot sClone sFnJson sStJson sReport
        Handle hoStore
        Boolean bOK

        Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_HarvestAll\") to sRoot
        Move (rfRemoveFolderTree(sRoot)) to bOK
        Move (sRoot + "clone\") to sClone
        Move (rfDirectoryCreateEx(sClone, False)) to bOK
        Send Assert bOK "the fixture folders"
        Move 'External_Function HrvTestFn "HrvTestFn" HRVTEST.dll ;'  to asFn[0]
        Move (Character(9) + 'Pointer p ;' + Character(9) + '// OLDROW*') to asFn[1]
        Move (Character(9) + 'Returns Integer')                       to asFn[2]
        Send _WriteFile (sClone + "Win32API-01.pkg") asFn
        Move "Struct OLDROW"                  to asSt[0]
        Move (Character(9) + "Integer after") to asSt[1]
        Move "End_Struct"                     to asSt[2]
        Move "Struct NEWROW"                  to asSt[3]
        Move (Character(9) + "Integer n")     to asSt[4]
        Move "End_Struct"                     to asSt[5]
        Move "Struct _Anonymous_e__Union_7"   to asSt[6]
        Move (Character(9) + "Integer x")     to asSt[7]
        Move "End_Struct"                     to asSt[8]
        Send _WriteFile (sClone + "Win32Struct-01.pkg") asSt
        Move (sRoot + "fn.json") to sFnJson
        Move (sRoot + "st.json") to sStJson
        Move "KEPT|{ DWORD a; }"                                                                to asExisting[0]
        Move ("OLDROW|DF|Struct OLDROW" + (Character(10)) + "Integer before" + (Character(10)) + "End_Struct") to asExisting[1]
        Get WriteCatalogWithMeta of oHrv sStJson (&asExisting) 0 0 "" to bOK
        Send Assert bOK "the catalogue that is there already"

        Set pbHarvestAll of oHrv to True
        Get HarvestClone of oHrv sClone "" sFnJson sStJson (&sReport) to bOK
        Send Assert bOK sReport
        Get Create (RefClass(cWinAPICatalogStore)) to hoStore
        Get LoadCatalog of hoStore sStJson to asOut
        Send AssertIAreEqual 3 (SizeOfArray(asOut))
        Send AssertSAreEqual "KEPT|{ DWORD a; }" asOut[0]
        Send Assert (Left(asOut[1], 7) = "NEWROW|") asOut[1]
        Send AssertSAreEqual asExisting[1] asOut[2]
        Send Assert (Pos("1 added", sReport) > 0 and Pos("1 generated left out", sReport) > 0) sReport

        Get HarvestClone of oHrv sClone "" sFnJson sStJson (&sReport) to bOK
        Set pbHarvestAll of oHrv to False
        Send Assert (Pos("0 added", sReport) > 0) sReport
        Move asNone to asOut
        Get LoadCatalog of hoStore sStJson to asOut
        Send Destroy of hoStore
        Send AssertIAreEqual 3 (SizeOfArray(asOut))
        Move (rfRemoveFolderTree(sRoot)) to bOK
    End_Procedure

    // Merge: a harvested identity replaces its row, unharvested rows survive, and the output is
    // KEY-sorted - the prefix-family pair proves it is the KEY that sorts, not the whole row
    // (a full-row compare would put getdc AFTER getdcex, because '|' outranks 'e').
    {Published = True}
    Procedure Hrv_MergeReplacesAndKeySorts
        String[] asExisting asNew asOut
        Integer iKept
        Move "user32.dll|getdcex|DF|old-ex" to asExisting[0]
        Move "user32.dll|getdc|DF|old"      to asExisting[1]
        Move "zzz.dll|keepme|DF|kept"       to asExisting[2]
        Move "user32.dll|getdc|DF|new"      to asNew[0]
        Move "user32.dll|getdcex|DF|new-ex" to asNew[1]
        Send MergeRows of oHrv (&asExisting) (&asNew) 2 (&asOut) (&iKept)
        Send AssertIAreEqual 1 iKept
        Send AssertIAreEqual 3 (SizeOfArray(asOut))
        Send AssertSAreEqual "user32.dll|getdc|DF|new"      asOut[0]
        Send AssertSAreEqual "user32.dll|getdcex|DF|new-ex" asOut[1]
        Send AssertSAreEqual "zzz.dll|keepme|DF|kept"       asOut[2]
    End_Procedure

    // The struct closure follows comment refs, then member types, to a fixed point.
    {Published = True}
    Procedure Hrv_StructClosureFollowsMembers
        tW32ProjFn[] aChosen
        String[] asNamesLC asAllNames asAllBodies asNeeded
        Move "F"                to aChosen[0].sName
        Move "F"                to aChosen[0].sEntry
        Move "x.dll"            to aChosen[0].sDll
        Move "Pointer"          to aChosen[0].asParamType[0]
        Move "p"                to aChosen[0].asParamName[0]
        Move "OUTER*"           to aChosen[0].asParamComment[0]
        Move "Integer"          to aChosen[0].sRet
        Move ""                 to aChosen[0].sRetComment
        Move "OUTER"            to asAllNames[0]
        Move ("INNER member1" + (Character(10)) + "Integer plain") to asAllBodies[0]
        Move "INNER"            to asAllNames[1]
        Move "Integer leaf"     to asAllBodies[1]
        Move "UNRELATED"        to asAllNames[2]
        Move "Integer x"        to asAllBodies[2]
        Move "inner"     to asNamesLC[0]
        Move "outer"     to asNamesLC[1]
        Move "unrelated" to asNamesLC[2]
        Send StructClosure of oHrv (&aChosen) (&asNamesLC) (&asAllNames) (&asAllBodies) (&asNeeded)
        Send AssertIAreEqual 2 (SizeOfArray(asNeeded))
        Send AssertSAreEqual "outer" asNeeded[0]
        Send AssertSAreEqual "inner" asNeeded[1]
    End_Procedure

    /* THE ALIAS PASS ASKS WINDOWS, and adds a row only where the answer is "this bare export IS the
       ...A entry". shell32 really does export Shell_NotifyIcon at Shell_NotifyIconA's address, so
       the row is added - carrying the A row's body, because that is the function being bound. */
    {Published = True}
    Procedure Hrv_BareAliasAddsTheMeasuredAnsiRow
        String[] asExisting asOut
        String sReport
        Move 'shell32.dll|shell_notifyicona|DF|External_Function Shell_NotifyIconA "Shell_NotifyIconA" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' to asExisting[0]
        Move 'shell32.dll|shell_notifyiconw|DF|External_Function Shell_NotifyIconW "Shell_NotifyIconW" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' to asExisting[1]
        Get BareAliasRows of oHrv (&asExisting) (&sReport) to asOut
        Send AssertIAreEqual 1 (SizeOfArray(asOut))
        Send AssertSAreEqual 'shell32.dll|shell_notifyicon|DF|External_Function Shell_NotifyIconA "Shell_NotifyIconA" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' asOut[0]
    End_Procedure

    /* ...and REFUSES the bare export that is the WIDE twin. kernel32 exports ReplaceFile at
       ReplaceFileW's address, so pasting the A row under the bare key would hand a wide binding an
       ANSI prototype - which is exactly what the spelling rule this replaces used to do. */
    {Published = True}
    Procedure Hrv_BareAliasRefusesTheWideTwin
        String[] asExisting asOut
        String sReport
        Move 'kernel32.dll|replacefilea|DF|External_Function ReplaceFileA "ReplaceFileA" KERNEL32.dll String lpReplacedFileName String lpReplacementFileName String lpBackupFileName UInteger dwReplaceFlags Pointer lpExclude Pointer lpReserved Returns Integer' to asExisting[0]
        Move 'kernel32.dll|replacefilew|DF|External_Function ReplaceFileW "ReplaceFileW" KERNEL32.dll WString lpReplacedFileName WString lpReplacementFileName WString lpBackupFileName UInteger dwReplaceFlags Pointer lpExclude Pointer lpReserved Returns Integer' to asExisting[1]
        Get BareAliasRows of oHrv (&asExisting) (&sReport) to asOut
        Send AssertIAreEqual 0 (SizeOfArray(asOut))
        Send Assert (Pos("WIDE twin", sReport) > 0)
    End_Procedure

    /* A bare name the dll does not export AT ALL is not a row either. A declaration naming one
       cannot bind - DataFlex raises Error 4355 at its first call - so there is nothing to type, and
       answering with the A prototype only made a dead declaration look serviceable. */
    {Published = True}
    Procedure Hrv_BareAliasSkipsWhatIsNotExported
        String[] asExisting asOut
        String sReport
        Move 'kernel32.dll|getprivateprofilestringa|DF|External_Function GetPrivateProfileStringA "GetPrivateProfileStringA" KERNEL32.dll String lpAppName String lpKeyName String lpDefault Pointer lpReturnedString UInteger nSize String lpFileName Returns UInteger' to asExisting[0]
        Move 'kernel32.dll|getprivateprofilestringw|DF|External_Function GetPrivateProfileStringW "GetPrivateProfileStringW" KERNEL32.dll WString lpAppName WString lpKeyName WString lpDefault Pointer lpReturnedString UInteger nSize WString lpFileName Returns UInteger' to asExisting[1]
        Get BareAliasRows of oHrv (&asExisting) (&sReport) to asOut
        Send AssertIAreEqual 0 (SizeOfArray(asOut))
    End_Procedure

    /* A bare row the catalogue ALREADY carries is left exactly as it is. The projection harvests
       157 of them and 27 carry types matching neither twin, so copying a twin over one would
       destroy harvested data - the pass must add, never overwrite. */
    {Published = True}
    Procedure Hrv_BareAliasLeavesAnExistingBareRowAlone
        String[] asExisting asOut
        String sReport
        Move 'shell32.dll|shell_notifyicon|DF|External_Function Shell_NotifyIcon "Shell_NotifyIcon" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' to asExisting[0]
        Move 'shell32.dll|shell_notifyicona|DF|External_Function Shell_NotifyIconA "Shell_NotifyIconA" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' to asExisting[1]
        Move 'shell32.dll|shell_notifyiconw|DF|External_Function Shell_NotifyIconW "Shell_NotifyIconW" SHELL32.dll UInteger dwMessage Pointer lpData Returns Integer' to asExisting[2]
        Get BareAliasRows of oHrv (&asExisting) (&sReport) to asOut
        Send AssertIAreEqual 0 (SizeOfArray(asOut))
        Send Assert (Pos("already carried", sReport) > 0)
    End_Procedure

End_Object
