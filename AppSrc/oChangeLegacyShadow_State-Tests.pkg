        {Published = True}
        Procedure ChangeLegacyShadow_State_9
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                Set Label to "Skapa loggfil vid avbokning, ÅÅÅÅMMDD-Order.txt"' to sLine
            Move '                Set Label to "Skapa loggfil vid avbokning, ÅÅÅÅMMDD-Order.txt"' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyIndicators of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure


        // A Get writes INTO its variable, so the variable cannot become (Not(var)) - that did not compile (a Data
        // Access report, 2026-11-27). The variable stays, and a second line turns the answer round.
        { Published = True }
        Procedure ChangeLegacyShadow_State_GetKeepsItsVariable
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                Get Shadow_State Item iItem to iShadowState' to sLine
            Move ('                Get Enabled_State Item iItem to iShadowState' + C_NewLine + '                Move (Not(iShadowState)) to iShadowState') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyShadow_State of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        { Published = True }
        Procedure ChangeLegacyShadow_State_GetOfObjectWithComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Get Shadow_State of hoTempGrid Item iItem to iShadowState  // the old state' to sLine
            Move ('    Get Enabled_State of hoTempGrid Item iItem to iShadowState  // the old state' + C_NewLine + '    Move (Not(iShadowState)) to iShadowState') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyShadow_State of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Not a plain variable after 'to': left exactly as it is rather than guessed at.
        { Published = True }
        Procedure ChangeLegacyShadow_State_GetIntoAnExpressionIsLeft
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Get Shadow_State Item iItem to (aStates[iItem])' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeLegacyShadow_State of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    Get Shadow_State Item iItem to (aStates[iItem])' sLine
        End_Procedure

    End_Object
