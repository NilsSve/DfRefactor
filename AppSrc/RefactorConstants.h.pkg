// Maps a function name (as it appears in psFunctionName of a cTestFixture
// object) to the per-function o<X>-Tests.pkg file that hosts the fixture.
// Built once per import so we can locate the correct destination file even
// when its name doesn't match the function name verbatim.
Struct tFixtureLocation
    String sFunctionName
    String sFileName
End_Struct

/* ---- Shared-library inventory (Nils 2026-07-31) --------------------------------------------
   A workspace's [Libraries] entries point at OTHER workspaces - vwin32fh, VDFQuery, SigCJ,
   DUF, RDCToolsLib, DFAbout... - which are maintained upstream and must never be refactored
   in place. A copy inside a workspace is downstream of a repo, so editing it forks the
   library: the next update either clobbers the edits or conflicts with them. That holds for
   Nils's OWN libraries too - RDCToolsLib is fixed in Library-RDCToolsLib and re-released, not
   in a customer's copy of it.

   The verdict is only meaningful against the TARGET DataFlex version (psTargetDfVersion), not
   the workspace's current one: upstream libraries carry only the two current majors, so for a
   workspace still on 19.1 "you are behind" would be a false alarm. The question this answers
   is "to move THIS workspace to DF <target>, what is the state of its libraries". */
Enum_List
    Define eLibUnknown        for 0   // not determined (no target version given, unreadable .sws)
    Define eLibMatchesTarget  for 1   // the referenced .sws already IS the target version
    Define eLibRetargetLocal  for 2   // a sibling .sws in the same folder matches the target
    Define eLibNoLocalBuild   for 3   // nothing local for the target - needs an upstream copy
    /* The entry points at a .sws that is NOT THERE. Not a verdict about a library at all - it is a
       fact about the workspace file, and it outranks every verdict above because nothing can be
       said about a library that could not be read.

       It exists because leaving such an entry out was a silent undercount: WorkspaceLibraryInventory
       keeps only entries it can resolve, so a workspace declaring six libraries with two missing
       reported four, and every count downstream - the tile, the report footer - agreed with each
       other and with nothing on disk. Only the ALL-missing case was ever noticed (2026-08-05).
       WorkspaceLibraryEntries returns these rows; WorkspaceLibraryInventory still filters them out
       for the callers that genuinely need a resolvable .sws. */
    Define eLibNotFound       for 4   // the referenced .sws does not exist
    /* A DF26 REGISTRY PACKAGE, which is not a .sws at all and cannot be judged like one. Its
       DataFlex compatibility is the df-min/df-max range in its own package block, not a
       [Properties] Version=, so answering "no 26.0 build here" about one would be a confident wrong
       answer about a thing we have not read. Stated as its own kind until that range is parsed. */
    Define eLibPackage        for 5   // a DataFlex system package - version pinned in the entry itself
    /* A package whose own df-min/df-max range does NOT cover the target. Its own claim about which
       DataFlex releases it supports, so this is a real verdict rather than an inference - which is
       exactly why eLibPackage stays for the case where the range cannot be read: a package that has
       not said is not the same as one that has said no. */
    Define eLibPackageMismatch for 6  // installed, but it does not support the target release
    /* THE FILE IS THERE BUT CANNOT BE READ AS A WORKSPACE FILE - git conflict markers, see
       eSwsConflict (2026-09-14). Like eLibNotFound a fact about a file rather than a verdict about
       a library: it outranks the version verdicts, counts as attention, and stops the chain walk
       from descending into it. bFound stays True - the file IS there - so "not there" wording never
       sends the reader looking for a folder that exists. */
    Define eLibUnreadable     for 7   // the referenced .sws exists but carries git conflict markers
End_Enum_List

/* WHERE A WORKSPACE STOPPED CARRYING ITS VERSION IN ITS FILENAME (Nils 2026-08-14).

   Up to DataFlex 25 the convention was to say the version in the name - "DFRefactor25.0.sws",
   "Acme-UMS_VDF_DF25.0.sws" - because nothing else in the workspace did. From DataFlex 26 the
   workspace states it itself ("df": 26.0 inside the JSON .sws) and libraries/packages are resolved
   by the package handler rather than by a versioned filename. A "_DF26.0" suffix would then restate
   what the file already says, and - worse - could come to CONTRADICT it, because the suffix is
   frozen at copy time while the "df" value is what the tooling actually reads.

   This repo is its own evidence: DFRefactor25.0.sws carries the version, DFRefactorFlexTron.sws
   does not.

   Compared against cLibraryInventory's _VersionKey, which is (major * 1000) + minor - locale-safe,
   because "26.0" parsed as a number is at the mercy of the OS decimal separator (see the note on
   tWorkspace.sDfVersion). 26000 is therefore _VersionKey("26.0"). */
Define CI_DfUnversionedSwsFrom for 26000   // _VersionKey("26.0") - at or above this, no _DF<ver> suffix

/* RUNNING A CONSOLE TOOL THAT MIGHT ASK A QUESTION (Nils 2026-08-14, from a real hang).

   "Make a workspace copy" froze: the copy finished, the status panel closed, and the cursor span
   for ever. df-cli had been handed a workspace it could not load and was sitting on

       Failed to load workspace. Would you like to attempt a repair? (y/n):

   - on a console that was HIDDEN, so nobody could answer it. Eight minutes in it had used 0.03s of
   CPU on one thread with no network: not working, waiting. RDCRunProgramWait waits with
   WaitForSingleObject(hProcess, -1), an INFINITE wait, so the app waited with it.

   RDCRunProgramBounded (cRDCAsyncProcess.pkg) is the bounded runner - and its deadline is the part that
   holds. CREATE_NO_WINDOW was believed to make a prompt fail instead of block; re-measured on
   2026-09-14 it does not: df-cli started with nothing redirected waits on that question until the
   deadline kills it. What makes the same failure exit at once is REDIRECTING ITS OUTPUT - the
   cmd.exe wrapper DfCliCaptureIn builds - so a tool that might ask runs through that, and the
   deadline catches anything that still stalls. Two negative sentinels rather than a bare Boolean,
   so the message a user reads can say WHICH happened. */
// CI_RDCRunToolFailedToStart / CI_RDCRunToolTimedOut - the bounded runner's answers - are the RDC Windows
// library's (cRDCAsyncProcess.pkg, 1.0.6).
Define CI_DfCliConvertTimeoutSecs for 120  // generous: a real convert of a large workspace is seconds
// A package install CLONES - minutes on a large repository, so far more generous than a convert.
Define CI_DfCliPackageTimeoutSecs for 600

// How deep a library chain is walked. Libraries declare libraries; 4 is what the Libraries report
// has always used, and the copy's pre-convert check uses the same number so the two surfaces cannot
// disagree about what the workspace "declares".
Define CI_LibraryTreeMaxDepth for 4
// How many package manifests one graph walk may expand before it stops. A package graph is a
// handful of entries; this exists only so two manifests that name each other cannot spin the
// walk for ever - see ExpandPackageGraph.
Define CI_PackageGraphMaxWalk for 64
// How many lines of a fetched README a package-details box will show. It is a message box,
// not a document viewer, and a README can run to hundreds of lines.
Define CI_DetailsMaxLines for 120

/* WHAT ONE ENTRY IN A DEPENDENCY LIST ACTUALLY IS (DF26).

   Under DataFlex 26 the JSON "dependencies" array is a UNION, and only one of its three shapes is a
   path. Verified 2026-08-12 against a real workspace:

       "DataFlex-dev/Web UI FlexTron#1.0.51"          <repo>/<Name>#<version>  - DataFlex system package
       "../WebAppSrc/StudioLibrary/WebAppSrc.sws"     a .sws PATH, as every INI [Libraries] entry is
       { "source": <git url>, "version": …, "sws": … } a git/file object

   Treating all three as paths is how a package-based workspace came to render every package as
   "not found - nothing is at that path". Every INI entry is eDepPath, so nothing about the classic
   case changes. */
/* One row of "df-cli package search" output. sName is the "<repo>/<Name>" pair WITHOUT a version -
   the install string is sName + "#" + sVersion, which is exactly the form a dependencies entry
   takes. The search is scoped by the workspace's own DataFlex version, so every hit is one this
   workspace can actually use. */
Struct tPackageHit
    String sName          // "DataFlex-dev/Web UI FlexTron"
    String sPublisher     // "DataFlex-dev"
    String sVersion       // "1.0.51" - the newest the registry offers for this workspace
    String sDescription
End_Struct

Enum_List
    Define eDepPath    for 0   // a .sws path - relative to the workspace home, or absolute
    Define eDepPackage for 1   // a DataFlex system package string, resolved from the global package cache
    Define eDepGit     for 2   // the object form: a git URL with a version and optional .sws
End_Enum_List

Struct tLibraryInfo
    String   sName            // display name (the library's folder, skipping generic containers)
    String   sFolder          // folder holding the referenced .sws
    String   sRefSwsFile      // the .sws this workspace's [Libraries] actually points at
    String   sRefVersion      // its own [Properties] Version= - NEVER parsed from the filename
    String[] asAvailVersions  // DataFlex versions offered by CONSUMABLE .sws files in sFolder
    String   sTargetSwsFile   // the consumable .sws matching the target version ("" = none)
    Integer  eStatus          // one of the eLib* values above
    String   sRawEntry        // the [Libraries] value AS WRITTEN - the only thing the .sws holds
    Boolean  bFound           // did sRefSwsFile resolve to a file on disk?
    /* THE CHAIN. A library declares libraries of its own, and its Version= describes ITSELF and
       nothing below it - which is how a workspace ends up compiling 19.1 library code into a DF26
       build with every visible row reading fine. Found on E:\WinServ 2026-08-12: one declared
       library, WebAppSrc-Library-DF250.sws, Version=25.0, all SEVEN of its own dependencies on
       DF191. The workspace's own dialog showed one row and said nothing.

       Filled by WorkspaceLibraryTree / LibraryEntriesTree only; the flat readers leave them 0/"".
       iDepth 0 = declared by the workspace itself, 1+ = declared by the library named in
       sDeclaredBy. The three iChain* fields describe a row's OWN children, so they are meaningful
       on any row that has them. */
    Integer  eKind            // one of the eDep* values - what this entry IS before it is resolved
    Integer  iDepth           // 0 = the workspace declares it; 1+ = a library above it does
    String   sDeclaredBy      // display name of the library declaring this row ("" at depth 0)
    /* The .sws FILE that declares this row - "" at depth 0, where the workspace declares it.

       The name above says WHO declares an entry; this says WHERE, which is what a caller needs to
       edit it. Removing a nested entry means rewriting the library .sws that lists it, and
       resolving that from the name afterwards is guesswork - two libraries can share a display
       name, and after the flat list is sorted the parent is no longer the row above. Stamped
       while the walker still knows it. */
    String   sDeclaredBySws
    // A PACKAGE's supported DataFlex range, read from its own cached df.sws. Empty for a library,
    // and empty for a package that is not installed - there is no file to read it from.
    String   sDfMin
    String   sDfMax
    Integer  iChainCount      // libraries THIS one declares
    Integer  iChainBehind     // ...of which this many declare a version older than this row's own
    String   sChainOldest     // the oldest version among them ("" = none readable)
End_Struct

/* One DIRECT dependency on a library: a workspace source file naming one of that library's packages
   in a Use statement. Direct only, deliberately (Nils 2026-08-01) - a file that Use's vwin32fh
   itself is the user's problem, while one that gets it through VDFQuery is VDFQuery's, and counting
   them together would both overstate the work and point at the wrong files. */
Struct tLibraryUsage
    String   sLibName         // the library depended on (tLibraryInfo.sName)
    String   sFile            // the consuming source file, full path
    Integer  iLine            // 1-based line carrying the Use
    String   sPackage         // the package named there, as written
End_Struct

/* A library .sws HEADER that has to be written for the target DataFlex version, because the library
   ships none.

   Sound for a VERSION-TRANSPARENT library, which is the common case: one codebase with compile-time
   conditionals, where the several .sws files are Studio workspace headers rather than code variants
   (vwin32fh's DF25.0 and DF26.0 headers point at the SAME config.ws, and upstream's own DF26 support
   was a commit titled "adding a df26 sws file"). Synthesising one is therefore exactly what the
   library author would have done.

   NOT sound for a library whose CODE differs per release - SigCJ is bound to a CodeJock version. The
   header will let the workspace open and the compiler will then say so, which is a better failure
   than a workspace that cannot be opened at all - but it IS a claim being made on the library's
   behalf, so every synthesised header is reported rather than made quietly. */
// One file the copy has to write. The whole list is computed up front so the copy can show real
// progress and be cancelled between files, rather than disappearing into one folder for a minute.
Struct tCopyPair
    String sSource
    String sDest
End_Struct

Struct tLibrarySwsToAdd
    String sLibName       // display name of the library
    String sTemplateFile  // full path of the .sws copied as the template (the referenced one)
    String sNewFile       // full path of the .sws to create
    String sVersion       // the version to write into its [Properties]
End_Struct

/* ---- Migration copy scope (cWorkspaceCopyPlan) --------------------------------------------------
   One candidate folder for the "copy this workspace to a new location" step of a DataFlex-version
   migration. The copy is what makes the migration a DERIVATION rather than an in-place mutation:
   the original keeps compiling and running while the copy is retargeted.

   WHY A ROW SET AND NOT A FOLDER TREE. Measured on a real 19.1 workspace 2026-08-05: the folders
   the workspace DECLARES total 978 MB / 3,199 files, while the home directory holds 6,540 MB /
   12,965 files. The extra 5.5 GB is historical debris - six dead "Data - *" / "DataNils" copies
   that a plain recursive walk cannot tell apart from the live Data folder. Only the workspace's own
   configuration knows which one is real, so the rows are built from THAT and the rest is offered
   separately, unticked. */
Enum_List
    Define eCopyConfig         for 0   // the .sws / .ws configuration files themselves
    Define eCopySource         for 1   // AppSrcPath, DdSrcPath, IdeSrcPath
    Define eCopyData           for 2   // DataPath - the database; the bulk of a real workspace
    Define eCopyOutput         for 3   // ProgramPath. NOT optional: it holds the .ws config itself
    Define eCopyResource       for 4   // BitmapPath, HelpPath, AppHtmlPath
    Define eCopyLibrary        for 5   // a folder reached from the .sws [Libraries] chain
    Define eCopyDeclaredOther  for 6   // a declared *Path key this build does not model
    Define eCopyUndeclared     for 7   // a folder under home that nothing references
    Define eCopyExcluded       for 8   // backup trees / VCS metadata - never copied
    Define eCopyStudio         for 9   // IdeSrcPath - Studio project files, NOT application source
    Define eCopyAdded          for 10  // added by hand in the dialog (Ins / Add Folder)
End_Enum_List

Struct tCopyItem
    String   sKey        // the .ws key that declared it ("AppSrcPath"); "" when not declared
    String   sName       // display name (the folder leaf, or the library name)
    String   sPath       // resolved absolute folder path
    Integer  eRole       // one of the eCopy* values above
    Boolean  bDeclared   // named by the workspace configuration (vs found on disk)
    Boolean  bExists     // a declared path may legitimately be ABSENT - a state, not an error
    Boolean  bIsLink     // junction/symlink: copying THROUGH it would duplicate and fork the target
    Boolean  bOutsideHome // declared, but resolves outside the workspace home - real, and common in
                          // older workspaces (AppSrcPath=C:\Program Files (x86)\... was found in the
                          // wild). Copied, but worth saying out loud, because such a path does NOT
                          // travel with a copy unless the new .ws is rewritten.
    Boolean  bSelected   // the default answer, which is what most users will accept unchanged
    Boolean  bMeasured   // False until MeasureCopyItem has run - sizes are off the render path
    Number   nBytes
    Integer  iFiles
End_Struct

// What one source line does to a legacy string-command variable (strmark / strlen), as read by
// ChangeStrMarkToExpression / ChangeStrLenToExpression (cRefactorFuncLib, _StrVarLineInfo).
Struct tStrVarLineInfo
    Boolean bSets          // the line leaves a NEW value in the variable (a producer, or a write to it)
    Boolean bOpaque        // that value is one no expression can state (Sysdate, File_Size, Page, Index_Def)
    Boolean bWrite         // '... to strmark' - the variable is the line's destination
    Boolean bReads         // the variable is read on the line (a whole-word token that is not the destination)
    Boolean bConsumes      // a count-less Left / Right / Mid / Pad: the command TAKES its count from the variable
    Boolean bModifies      // Increment / Decrement of the variable (read-modify-write)
    Boolean bReorderOnly   // the value exists only BEFORE the line runs (Replace changes the very string it searched)
    Boolean bHasPrefix     // something precedes the command keyword (a one-line If, an [indicator] guard)
    Boolean bFunctionForm  // a converted command - Move (Pos(..)) / Move (Replace(..)) - which never sets it at run time
    String  sCommand       // the producing command, lowercased ("pos", "replace", "left", ...)
    String  sExpr          // the expression the variable equals after the line, as source text ("" = unknown)
    String  sExprMasked    // the same with string literals masked (for the operand checks)
End_Struct

// The operands of one legacy string command, as _StrVarParseCommand / _StrVarFunctionForm read them.
Struct tStrVarOperands
    String sNeedle         // Pos / Replace / Insert: the searched or inserted text; Left / Right / Mid / Pad: the source string
    String sHay            // Pos: the searched string; Replace / Insert: the variable that is changed
    String sArg            // the count (Left / Right / Pad), the length (Mid), the position (Insert)
    String sArg2           // Mid: the start position
    String sNeedleMasked   // the same four with string literals masked
    String sHayMasked
    String sArgMasked
    String sArg2Masked
End_Struct

/* Folder names that are containers, not the library's identity: vwin32fh's .sws lives in
   "vwin32fh\StudioLibrary\", so the leaf folder would name every such library "StudioLibrary"
   (and did, in the 2026-07-30 survey - 293 references collapsed onto that one word). */
Define CS_LibGenericFolders         for "studiolibrary|library|libraries|studio"

/* Deep Scan rule TOKENS that stay live inside a '#COMMAND .. #ENDCOMMAND' body, where the scanner
   otherwise skips every line (see the macro latch in ScanLines).

   The blanket skip protects rules that match COMMAND SYNTAX: a macro body is full of command-shaped
   lines carrying '!' argument tokens, and offering to rewrite those produced auto-fix rows a plan
   run could never clear. That reasoning does not extend to a rule matching a FUNCTION NAME whose
   fix is a pure rename - ToANSI(x) -> Utf8ToAnsi(x) is safe wherever it appears, including on an
   argument like '!1', which the rename carries through untouched.

   It matters because a workspace's own output commands would otherwise hide their conversion calls
   from BOTH lanes at once: the compiler reports 4534 at the command's call sites and never in its
   body, and the scan skipped the body. Keep this list to rules whose match and whose rewrite are
   both independent of the surrounding statement syntax.

   REPORTED, NOT OFFERED (2026-10-04): since 2026-09-07 the engine never changes macro code (Nils: "no
   macro code should ever be refactored"), so these hits are Explain rows with no function - the
   rename is the user's to make by hand. They had been Review rows naming UnicodeOemAnsiFunctions,
   which a plan run then left untouched ("0 lines Renamed"). */
Define CS_DSMacroSafeTokens         for "toansi|tooem"

/* .sws ROLE markers. A library folder holds several .sws files per version with different
   jobs - Nils's own convention is "RDCToolsLibDev25.0.sws" (for developing the library) beside
   "RDCToolsLibLibrary25.0.sws" (for consuming it), and SigCJ ships Classes / Demo / Wrapper.
   Only the consumable one may be offered as a retarget destination: matching on version alone
   picks the right version and the wrong role. Exclusion, not a required "library" marker -
   DFAbout25.0.sws and DFUnit-25.0.sws carry no role word at all. */
Define CS_LibNonConsumableMarkers    for "dev|demo|sample|example|test|wrapper"

Define CS_FunctionLibraryFile       for "oRefactorFuncLib.pkg"
Define CS_UnitTestsFile             for "oUnit_Tests.pkg"
Define CS_UnitTestsTokenizerFunc    for "Tokenizer"
Define CS_ImportBackupFolder        for "ImportBackup"
Define CS_FunctionLibraryStart      for "Object oRefactorFuncLib is a cRefactorFuncLib"
Define CS_Comment1                  for '// NOTE: Do *not* add any code after this "End_Object"!'
Define CS_Comment2                  for '//       It will be removed by the Export/Import logic.'

/* THE BOARDS' DEFERRED-ACTION SELECTORS - which view/flow an armed timer should run.

   Lived inside DashboardFT.vw (the split cockpit board) until 2026-08-10, which was fine only
   while that board was the one place they were used. It never was: ManualDashboardFT.vw,
   TestCompileFT.dg, ModProgressHistoryFT.dg and DFRefactorFT.src all read them, so retiring the
   cockpit took eleven of them out from under the manual board and the build stopped. They belong
   here, with the rest of the shared constants.

   Guarded so the retired board can be Use'd again for a look without a duplicate-define. */
#IFNDEF CI_DashSingleFile
Enum_List
    Define CI_DashSingleFile      for 1   // Single file -> SelectSourceFile (file dialog -> load -> EditorView)
    Define CI_DashFunctions               // Manual / Cleanup -> function grid (SelectFunctions)
    Define CI_DashTestCompile             // Modernize -> Test Compile dock
    Define CI_DashSelectWorkspace         // Workspace banner -> pop the .sws Open dialog + load it
    Define CI_DashLoadRecent              // Recent-workspaces chip -> load the clicked recent .sws (no dialog)
    Define CI_DashRefreshTiles            // OnPostInitialize / dashboard re-entry -> repaint all live tiles (post-mount)
    Define CI_DashSelectFolders           // "Selected" card folders pill -> jump to the Select Folders view
    Define CI_DashSelectFunctions         // "Selected" card functions pill -> jump to the Select Functions view
    Define CI_DashCompilerSetup           // "Target DataFlex version" tile -> pop the Compiler Settings modal
    Define CI_DashLibraries               // "Target DataFlex version" tile, Libraries chip -> the library report
    Define CI_DashEditor                  // "Selected" card file pill (single-file mode) -> jump to the editor
    Define CI_DashRemoveRecent            // Recent chip's "x" -> remove that .sws from the saved recent list
    Define CI_DashViewPlan                // Modernize tile "View last plan" link -> re-open the saved plan read-only
    Define CI_DashStartRefactor           // Action row -> run the selected functions now (manual run; same as the Start Refactoring toolbar item)
    Define CI_DashReadLog                 // Action row -> open the run summary log file (Send ShowLogFile)
    Define CI_DashReadOtherLogs           // Action row -> open the eOther_Function logs list (Send ShowOtherLogFiles)
    Define CI_DashUndo                    // Action row -> open the Undo Refactoring (restore-from-backup) dialog
    Define CI_DashRunPlan                 // Action row -> Run Modernization Plan: open the saved plan in the Refactoring Plan dialog (review -> run)
    Define CI_DashCompare                 // Action row -> Compare before/after of the last run via the external file-compare tool (psFileCompareApp)
    Define CI_DashReassertPlanTab         // View-last-plan follow-up: re-assert the Analyzer tab once the merged dock's WebView2 tab strip is warm (cold-show race left "Output" lit)
    Define CI_DashViewProgress            // Progress tile / cycle-strip pill -> pop the Modernization Progress History modal (burn-down table + trend + Reset)
    Define CI_DashDeepScan                // Guided-strip Deep Scan chip -> scan the selected source folders for obsolete symbols (no compile) -> Analyzer tab
    Define CI_DashDeepScanRules           // The gear next to the Deep Scan chip -> the per-rule enable dialog (which symbols the scan searches for)
    Define CI_DashBrowseFunctions         // Function-library tile figure -> Select Functions in BROWSE mode (group-filtered, NO Run button)
End_Enum_List
#ENDIF
