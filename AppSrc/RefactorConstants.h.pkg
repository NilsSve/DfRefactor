// Enum for the piMultiLineStringType property, used for general Multi-Line string States
{ EnumList = "MLS_None, MLS_TripleQuote, MLS_AtQuote, MLS_SQLSingleQuote, MLS_SQLDoubleQuote, MLS_SQLTripleQuote" }
Enum_List
    Define MLS_None             // Default: No string in progress
    Define MLS_TripleQuote      // Multi-line string with """
    Define MLS_AtQuote          // String starting with @" and ending with "
    Define MLS_AtQuoteOpen      // String starting with @" and NOT ending with "
    Define MLS_SQLSingleQuote   // SQL-style string with single quotes
    Define MLS_SQLDoubleQuote   // SQL-style string with double quotes
    Define MLS_SQLTripleQuote   // SQL-style string with triple quotes
End_Enum_List

// What a line of a file is (tLineInfo.eKind): the file walk's answer, cRefactorLexer's ScanSourceFile - the
// one walk behind _CodeOnlyFileLines, KeptTextFlags, the macro-code guard and the Deep Scan's masking. Macro
// code is not a kind: eMacro says which, on top (MC_ below).
Enum_List
    Define LK_Code              // code
    Define LK_StringOpener      // opens a DF 23 multi-line string: its code stands before the opening quote(s)
    Define LK_StringText        // a multi-line string's text
    Define LK_StringCloser      // closes the string: its code stands after the closing quote(s)
    Define LK_Header            // a #HEADER region line, #HEADER and #ENDHEADER included
    Define LK_BlockComment      // a DF 23 /* */ block comment line
    Define LK_Image             // a legacy report image line
End_Enum_List

// What macro code a line is, for the same walk (tLineInfo.eMacro): none, a directive line ('!...'), or a line of
// a #COMMAND..#ENDCOMMAND or a #DATA..#ENDDATA block, both ends included. Macro code is never refactored.
Enum_List
    Define MC_None
    Define MC_Directive
    Define MC_CommandBlock
    Define MC_DataBlock
End_Enum_List

// One line, read once by the lexer's line scanner (cRefactorLexer's ScanSourceLine). Positions are those of the
// line; 0 means none.
Struct tLineScan
    // Where the string open at the line's start ends: its closing quote (the first of a """ closer's three).
    Integer iCloseAt
    // The string open at the line's end, and where its opening quote stands (the first of a """ opener's three).
    String  sOpenOut
    Integer iOpenAt
    // Where a "//" end comment starts, where a "/*" opens a block comment - outside every string, before any
    // "//" - and where the first "*/" stands that ends one. A block comment ends at its first "*/", quotes or not
    // (measured on DataFlex 26), so one open at the line's start (sOpenIn "/*") ends at the line's first "*/",
    // wherever it stands. A "*/" outside every string and comment counts too.
    Integer iCommentAt
    Integer iBlockStartAt
    Integer iBlockEndAt
    // A block comment is still open at the line's end.
    Boolean bBlockOpenOut
    // Only when asked for (bCode): the line's code - every string's content blanked with the quotes kept, the end
    // comment cut, a block comment blanked with its markers (one left open cut, as an end comment is), and on a
    // closing line the string's or the comment's text blank too - every position still that of the line.
    String  sCode
End_Struct

// One line of a file, as the lexer's file walk reads it (cRefactorLexer's ScanSourceFile).
Struct tLineInfo
    Integer eKind       // what the line is: LK_
    Integer eMacro      // what macro code it is: MC_
    String  sOpenIn     // the multi-line string open at the line's start ("" none, '"""', '"' or "'")
    String  sOpenOut    // and at its end
    Integer iCloseAt    // the line's tLineScan.iCloseAt: where the string open at its start ends
    Integer iOpenAt     // the line's tLineScan.iOpenAt: where the string open at its end opened
    Boolean bBlockOpenIn // a block comment is open at the line's start: the line is comment to its first "*/"
End_Struct

// The sentinels the whole-file functions see instead of the lines no function may change (cRefactorFuncLib's
// macro-code guard and MaskKeptText): macro code, and a multi-line string's text or a #HEADER line.
Define CS_MacroSentinel for "//@@DFRefactorMacroCode:"
Define CS_KeptTextSentinel for "//@@DFRefactorKeptText:"
// The token for the text on an @-string's opening or closing line, which holds code too (MaskKeptText): it
// stands in for the text only, so it holds no quote and no '//', and it ends in "@@" so that 1 is not 12.
Define CS_KeptPartSentinel for "@@DFRefactorKeptPart:"
// What every sentinel line starts with.
Define CS_SentinelStart for "//@@DFRefactor"

// What cRefactorFuncLib's MaskForTransform masked, for UnmaskAfterTransform to put back: the text lines and parts
// (MaskKeptText's asSaved / aiIndex) and the macro lines (MaskFlaggedLines'), each with its count.
Struct tWholeFileMask
    String[]  asText
    Integer[] aiText
    Integer   iText
    String[]  asMacro
    Integer[] aiMacro
    Integer   iMacro
End_Struct

// One name the code of a file uses, and that file (cRefactorFuncLib's _NameReaderIndex).
Struct tNameReader
    String  sWord       // UPPERCASE
    Integer iFile       // the file's index in the file list indexed
End_Struct

