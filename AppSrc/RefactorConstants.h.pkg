End_Struct

Struct tSarifPhysicalLocation
    tSarifArtifactLocation artifactLocation
    tSarifRegion           region
End_Struct

Struct tSarifLocation
    tSarifPhysicalLocation physicalLocation
End_Struct

Struct tSarifFingerprints
    String dfrefactorHitV1
End_Struct

Struct tSarifResult
    String             ruleId
    String             level
    tSarifText         message
    tSarifLocation[]   locations
    tSarifFingerprints partialFingerprints
    String             baselineState
End_Struct

Struct tSarifUriBase
    String uri
End_Struct

Struct tSarifUriBases
    tSarifUriBase SRCROOT
End_Struct

Struct tSarifRun
