Define CS_SplitByPreference         for "SplitByPreference"
Define CS_DataFlexVersionText       for "DataFlex Version:"
Define CS_SelectWorkspaceText       for "Select Workspace:"
Define CS_CurrentWorkspaceText      for "Current Workspace:"
Define CS_WorkspacesKey             for "Workspaces"
Define CS_WorkspacePaths            for "WorkspacePaths"
Define CS_ConfigFile                for "ConfigFile"
Define CS_WorkspaceRecentKey        for "Recent"
Define CS_AnalyzeSnapshotKey        for "AnalyzeSnapshot"   // registry section: per-workspace last-analyze counts (FT dashboard)
Define CS_WorkspaceCopyOfKey        for "WorkspaceCopyOf"   // registry section: a copy DFRefactor made -> its original + the day (RecordWorkspaceCopy)
Define CS_WorkspaceCopiedToKey      for "WorkspaceCopiedTo" // registry section: an original -> the latest copy DFRefactor made of it + the day
// Per-workspace "last compiled program" (CS_Settings section, value-name = prefix + .sws path). Set by the
// Test Compile program combo; read by WriteAnalyzeSnapshot to tag the snapshot with WHICH program it is for.
// Promoted here from TestCompile(FT).dg so cRefactorApplication can read it (was a local Define in both docks).
Define CS_LastCompileKeyPrefix      for "LastCompileProgram_"
Define CS_PropertiesKeyWord         for "Properties"
