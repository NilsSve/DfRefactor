    tSarifRun[] runs
End_Struct

Struct tKeptShadow
    String sPath        // full path of the copy the user keeps - the key
    String sLeaf        // its file name, for the dialogs
End_Struct

Struct tKeptShadowFile
    Integer iVersion
    tKeptShadow[] aRows
End_Struct

// Aren't modern DD classes named o<tablename>_DataDictionary ?
Enum_List
    Define eDDUnknown       for 0 // style unknown or not yet classified
    Define eDDOldStyle      for 1 // <tablename>_DD
    Define eDDStudioStyle   for 2 // o<tablename>_DD
    Define eDDNewStyle      for 3 // o<tablename>_dd
End_Enum_List

Define CS_DDOldStyle      for "<tablename>_DD"
Define CS_DDLegacyStyle   for "o<tablename>_DD"
Define CS_DDNewStyle      for "o<tablename>_dd"

Enum_List
   Define eEngineOK         for 0
   Define eEngineUserCancel for 1
   Define eEngineError      for 2
   Define eEngineSelError   for 3
   Define eEngineBackupErr  for 4
End_Enum_List

// Which UI action triggered an engine run - recorded on the engine (peRunOrigin) and shown as
// "Run source:" in the summary log, so a saved summary says WHAT kicked it off.
Enum_List
    Define eRunManual    for 0 // user-selected functions + files ("Start Refactoring")
    Define eRunPlan      for 1 // analyzer "Refactor Plan" from a COMPILE+ANALYZE cycle
    Define eRunBatch     for 2 // headless command-line (/bm) run
    Define eRunTestBench for 3 // the interactive Test Bench (LegacyCode.pkg)
    Define eRunDeepScan  for 4 // "Refactor Plan" whose rows came from a DEEP SCAN (not compile+analyze)
End_Enum_List

Enum_List
    Define eAllFunctions         for 0   // Only used for selecting certain groups of functions in the program.
    Define eStandardFunction     for 1   // One source line at a time will be passed for these functions.
    Define eRemoveFunction       for 2   // One source line at a time will be passed for these functions.
    Define eRemoveFunctionAll    for 8   // A source file as a string array will be passed.
    Define eEditorFunction       for 3   // A source file as a string array will be passed
    Define eReportFunction       for 4   // A source file as a string array. Makes no source changes.
    Define eReportFunctionAll    for 5   // Makes no source changes.
    Define eOtherFunction        for 6   // A source file as a string array will be passed.
    Define eOtherFunctionAll     for 7   // All selected files as a string array will be passed. 
End_Enum_List

Define CS_AllFunctions           for "No Constrains - Show All"
Define CS_StandardFunction       for "eStandardFunction - Line-by-line"
Define CS_RemoveFunction         for "eRemoveFunction - Line-by-line"
Define CS_RemoveFunctionAll      for "eRemoveFunctionAll - One File"
Define CS_EditorFunction         for "eEditorFunction - One File"
Define CS_ReportFunction         for "eReportFunction - One File"   // Makes no source changes.
Define CS_ReportFunctionAll      for "eReportFunctionAll - All Files"  // Makes no source changes.
Define CS_OtherFunction          for "eOtherFunction - One File"
Define CS_OtherFunctionAll       for "eOtherFunctionAll - All Files"

// { FnGroup } meta-tag VALUE enum + display strings (mirrors the eXxxFunction / CS_*Function pair above).
// eFnGroupOther MUST be 0: an untagged function never enters the eFnGroup parse case
// (cRefactorFuncLib.pkg ParseComment), so its Integer member stays at the DataFlex default 0.
// NOTE: this VALUE enum is distinct from the meta-tag-TYPE 'Define eFnGroup for 7' above.
Enum_List
    Define eFnGroupOther          for 0   // Unclassified / no { FnGroup } tag.
    Define eFnGroupModernization  for 1   // Brings legacy code up to current DataFlex.
    Define eFnGroupCleanup        for 2   // Tidies or removes.
    Define eFnGroupUnicode64      for 3   // 64-bit + Unicode migration readiness (reports + fixes). Tag text: Unicode64.
End_Enum_List

// "No FnGroup filter / all groups" sentinel (mirrors eAllFunctions for the Type filter). NOT a real group
// value - used by SelectFunctionsFT's FnGroup constraint + the dashboard's Manual tile (vs Cleanup).
Define eFnGroupAll for (-1)

/* WHICH BOARD THE USER IS WORKING ON (piLastBoardView, cRefactorApplication) - so a screen that is
   not a board can offer the way BACK to the right one (Nils 2026-08-07, the Editor crumb).

   Each board stamps this in its own Activate, which makes it a fact rather than a guess: the
   alternative signals all answer a different question. pbGuidedSurfaceUsed is sticky-once-guided
   and never names the Manual board; pbWorkspaceMode is about single-file vs workspace; and
   pbGuidedTidyUpRun is a one-shot about a particular run.

   Defaults to eBoardGuided - the trail is the startup destination and the board the Start Center's
   guided lane opens, so it is the right answer before any board has been entered. */
Define eBoardGuided  for 1   // oDashboard_vw  - the guided trail ("Dashboard (WIP)")
Define eBoardManual  for 2   // oManualDashboard_vw - the manual flow's board
Define eBoardCockpit for 3   // oDashboard_vw       - the original split board, on the way out

/* ...AND WHICH FULL-SCREEN SURFACE THE USER CAME FROM (piLastSurface, cRefactorApplication) - a
   SUPERSET of the eBoard values above, so one Case ladder reads both (Nils 2026-08-09, the Select
   Folders / Select Functions crumbs).

   WHY NOT piLastBoardView, which already exists and looks like the same question: it cannot tell
   "no board has been entered yet" from "the guided board is current", because eBoardGuided is its
   default. The Editor could live with that - it is only ever reached FROM a board. Select Folders
   is also reached from the START CENTER (opening or copying a workspace that ends up with no
   folders selected lands there), and on that route the crumb must go back to the Start Center, not
   to a trail the user never opened.

   Stamped by the four surfaces' own Activate, so it is a fact rather than a guess - and it is
   right by construction for the routes that have no board of their own: the toolbar's Select
   Folders / Select Functions items and the Test Compile dock's, because a DOCK is not a surface
   and never overwrites the stamp of the board behind it.

   Defaults to the Start Center: that is where a session begins, and it reproduces exactly what the
   two crumbs did before this existed. */
Define eSurfaceStartCenter for 0   // oStartCenter_vw - the pre-workspace screen

Define CS_FnGroupOther           for "Other"
Define CS_FnGroupModernization   for "Modernization"
// Display text for eFnGroupCleanup - renamed "Cleanup" -> "Tidy Up" (Nils 2026-07-16) so the
// function grid / filter wording matches the dashboard's Tidy Up tile. The TAG spelling stays
// { FnGroup = Cleanup } (every function header + old JSON exports keep working): FnGroupValue
// accepts BOTH this display string and the "Cleanup" tag alias - the Unicode64 pattern below.
Define CS_FnGroupCleanup         for "Tidy Up"
// Display text for eFnGroupUnicode64. The TAG spelling is { FnGroup = Unicode64 } (clean meta-tag
// text); FnGroupValue accepts BOTH this display string and the "Unicode64" tag alias.
Define CS_FnGroupUnicode64       for "x64 + Unicode"

// Indicator names the indicator-refactoring functions (ChangeLegacyIndicators /
// ChangeSquareBracketsIndicators) must NOT bare-ify - they have no valid modern bare form.
// SELECT is an old-FMAC #Replace macro (OldFMACCommands.pkg) not defined in modern builds;
// refactoring [SELECT] -> Select would turn a harmless warning into a compile error.
// Comma-separated, case-insensitive; extend as other old-FMAC macro indicators surface.
Define CS_NonRefactorableIndicators for "SELECT"

// SELECT-handling mode for ChangeLegacyIndicators / ChangeSquareBracketsIndicators (their
// sParameter). eLeaveSelect (default) respects CS_NonRefactorableIndicators - it leaves
// [SELECT] / Indicate Select untouched (safe; their bare form does not compile without
// OldFMACCommands.pkg). eModernizeSelect refactors them too - only pick it when
// OldFMACCommands.pkg is in the build, where bare Select compiles.
Enum_List
    Define eLeaveSelect
    Define eModernizeSelect
End_Enum_List

