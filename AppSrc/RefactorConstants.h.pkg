Define CS_E                         for (Character(126)) // Tilde
Define CS_S                         for (Character(32))  // Space
Define CS_ValidLeftCharacters       for ("()[];,&+-*<>= " + Character(9)) // Character 9=tab char //"()[];,.&+-*<>= "

/* C prototype -> External_Function (cRefactorUtilities.CDeclarationToDataFlex).

   The DLL is a PLACEHOLDER, and deliberately one that does NOT compile. A C prototype
   does not carry the exporting DLL, so the converter cannot know it; guessing kernel32
   would produce a declaration that compiles and then fails at run time, which is the one
   outcome worse than not compiling. This way the user cannot ship it by accident.

   The two lists are pipe-delimited and matched as "|word|", so a word is matched whole
   and a new entry is a one-word edit. Lower case - the caller lowercases before testing. */
Define CS_CDeclDllPlaceholder       for "<SET-THE-DLL>.dll"
Define CS_CDeclHandleTypes          for "|handle|hwnd|hdc|hmenu|hinstance|hmodule|hbitmap|hicon|hcursor|hbrush|hpen|hfont|hrgn|hkey|hglobal|hlocal|hfile|haccel|hgdiobj|hpalette|hthread|hprocess|"
/* NOTE what is NOT here: the bare IN / OUT / OPTIONAL macros of the old SDK headers.
   They are legal PARAMETER NAMES too ("int in, int out"), and eating a name silently
   turns the type into the name - a wrong declaration that still compiles. The SAL forms
   this actually meets today (_In_, _Out_opt_) are caught by the underscores-both-ends
   rule in _StripCNoise instead, which cannot collide with an identifier. */
Define CS_CDeclNoiseWords           for "|winapi|apientry|callback|winapiv|ntapi|stdcall|__stdcall|__cdecl|cdecl|__fastcall|__declspec|far|near|extern|struct|enum|union|class|"
Define CS_CommentSymbol             for ("//")
Define CS_ImageNameStart            for "/"
Define CS_ImageNameEnd              for "/*"
Define CS_DF23CommentStart          for "/*"
Define CS_DF23CommentEnd            for "*/"
Define CS_StudioToolsPathStart      for "Software\Data Access Worldwide\DataFlex Tools\"
Define CS_StudioToolsPathEnd        for "\Studio\Preferences\File Extensions"
