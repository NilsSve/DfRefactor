/* THE OLD STUDIO'S SOURCE MARKERS - the whole lines RemoveOldStudioMarkers (CleanupRefactorFunctions.inc) removes,
   as one "|"-fenced list: a line is tested with one Pos on "|" + line + "|", exact and case-sensitive, as the
   twenty-three Case branches it replaced were. The "//AB/ " line PREFIX is tested in the function itself. */
Define CS_OldStudioMarkerLines      for "|//AB-IgnoreStart|//AB-IgnoreEnd|//AB-StoreStart|//AB-StoreEnd|//AB-StoreTopStart|//AB-StoreTopEnd|//AB-PanelStoreTopStart|//AB-PanelStoreTopEnd|//AB-PanelStoreStart|//AB-PanelStoreEnd|//AB-ClientStoreTopStart|//AB-ClientStoreTopEnd|//AB-ClientStoreStart|//AB-ClientStoreEnd|//AB-DDOStart|//AB-DDOEnd|//AB-MenuPackage|//AB-End|//AB-ToolbarPackage|//AB-ViewStart|//AB-ViewEnd|//AB-StatusBarPackage|//IDE-FileType=ftApplication|"

// ---- Editor-settings JSON shape (cRefactorEditorSettings.pkg) --------------------------------
// A generic, lossless serialization of cIniProperties' tag store. One value's "\n"-joined
// sub-parts (the convention the language keyword lists use) become a REAL JSON array - that
// split is the whole readability win over the ini ("nearly impossible to decipher",
// Nils 2026-07-26). Nested structs rather than jagged String[][]s so DataTypeToJson stays on
// well-trodden ground.
Struct tRefEdSetValue
    String[] asParts        // the value, split on the LITERAL 2-char "\n" join; single-part = [value]
End_Struct

Struct tRefEdSetRow
    tRefEdSetValue[] aValues
End_Struct

Struct tRefEdSetTag
    String  sTag
    Boolean bMulti
    tRefEdSetRow[] aRows    // single tags: exactly one row
End_Struct

Struct tRefEdSetFile
    Integer iFormatVersion
    String  sNote
    tRefEdSetTag[] aTags
    String[] asUnusedLines  // forward-compat: lines/tags this build does not register survive verbatim
End_Struct
