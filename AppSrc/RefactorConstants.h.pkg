// *** Command Line interface ***
//     Paramaters can be passed on the command line in any order
// Help params:
Define CS_CmdLineHelp1              for "/h"               // Show command line parameters help
Define CS_CmdLineHelp2              for "/help"            // Show command line parameters help
Define CS_CmdLineHelp3              for "/?"               // Show command line parameters help
Define CS_CmdLineHelp4              for "?"                // Show command line parameters help
Define CS_CmdLineDebug              for "/debug"           // Show all passed Params and exit

// Workspace file:
Define CS_CmdLineSWSFile            for "/sws"             // Workspace *.sws file with full path

// Single file refactoring:
Define CS_CmdLineFileName1          for "/f"               // A single file name including full path to apply refactoring functions on.
Define CS_CmdLineFileName2          for "/file"            // A single file name including full path to apply refactoring functions on.

// Folders to include when searching files:
Define CS_CmdLineFolders1           for "/d"               // Folder names Comma separated (no spaces).
Define CS_CmdLineFolders2           for "/dirs"            // Folder names Comma separated (no spaces).
Define CS_CmdLineFolders3           for "/folders"         // Folder names Comma separated (no spaces).

// Batch mode: (Auto run a refactoring session and then exit)
Define CS_CmdLineBatch1             for "/b"               // Automatically and silently start & run a refactoring session.
Define CS_CmdLineBatch2             for "/batch"           // Automatically and silently start & run a refactoring session.

// Console file: If no path specified, it is assumed the file resides in the Home folder (of DFRefactor).
// Instead of using flags CS_CmdLineFileNameX and CS_CmdLineFoldersX, an ini-file can be used.
// This is particullary useful if used together in a build process.
// Note: Settings above will be ignored if a "CS_CmdIniFileName" file is specified on the command line.
/* THE documented batch switch, and it takes the ini-file: "/bm <ini>". These two lived in
   cRefactorApplication.pkg, referenced by NOTHING, while the parser accepted only /c -c
   --console - so the generated wrapper, CLAUDE.md and these constants all agreed with each
   other and none of them agreed with the code. Moved here, beside the switches they belong
   with, and wired into the parser (Nils 2026-08-03). */
Define CS_BatchModeShort            for "/bm"
Define CS_BatchModeLong             for "/batch_mode"
// Accepted but no longer advertised - superseded by /bm, kept so existing scripts still run.
Define CS_CmdConfigFile1            for "/c"
Define CS_CmdConfigFile2            for "-c" 
Define CS_CmdConfigFile3            for "--console"

// This is the default ini-file name, but it can be named anything.
Define CS_CmdIniFileName            for "DFRefactor.ini"     // exported as DFRefactor_<workspace>.ini
// *** End Command Line Interface ***

// *** "DFRefactorCmdLine.ini" Sections ***
Define CS_CmdIniSWSFileSection      for "SWS File Section"
Define CS_CmdIniSWSFile             for "SWS File Name"

/* [Help] - written FIRST so it lands at the top of a newly exported INI (Nils 2026-08-03:
   "I had to run the program with -h to read what param to use"). Nothing READS these keys;
   they exist so the file explains itself to whoever opens it next, which for a build INI is
   usually not the person who exported it.

   A section rather than ";" comment lines because cIniFile writes through the Windows
   WritePrivateProfileString API, which can only author Key=Value pairs - it physically
   cannot write a standalone comment. */
Define CS_CmdIniHelpSection         for "Help"
Define CS_CmdIniHelpSyntax          for "Syntax"
Define CS_CmdIniHelpSwitches        for "Switches"
Define CS_CmdIniHelpResult          for "Result"
Define CS_CmdIniHelpWrapper         for "Wrapper"
Define CS_CmdIniHelpCreatedBy       for "Created by"
Define CS_CmdIniHelpSwitchesText    for "/bm <ini file> runs it headless. A bare file name is resolved against the program's Programs folder; otherwise give a full path. Run the exe with /h for the full list."
Define CS_CmdIniHelpResultText      for "The run writes STATUS=SUCCESS or STATUS=FAILED to the file named in [Result Section], and exits with code 0 on success, 1 on failure."
Define CS_CmdIniHelpWrapperText     for "The _RUN.ps1 file written beside this INI on export runs the line above and reads the result file back."
Define CS_CmdIniHelpCreatedByText   for "This file was created with the DFRefactor program's Export dialog (main toolbar). Re-export to refresh it."

Define CS_CmdIniUserSection         for "User Name Section"
Define CS_CmdIniUserName            for "User Name"

Define CS_CmdIniSingleFileSection   for "Single File Section"   // Takes precedence over the .sws setting.
Define CS_CmdIniSingleFileName      for "Single File Name"      // The "Single File" key value (can only be one)
Define CS_CmdIniFoldersSection      for "Folder Section"        // A comma separated list with folders to scan (no spaces)
Define CS_CmdIniFolderName          for "Folder Name"           // A consequitive number must be added for each name e.g. "Folder Name1"
Define CS_CmdIniFileFilterSection   for "File Filter Section"   
Define CS_CmdIniFileFilters         for "File Filters"          // A comma separated list with file extensions. E.g. *.src,*.vw,*.dd
Define CS_CmdIniFunctionSection     for "Functions Section"     // Section for selection of refactoring functions to use.
Define CS_CmdInitFunction           for "Function Name"         // Similar to CS_CmdIniFolderName.
Define CS_CmdIniResultSection       for "Result Section"        // Optional: where a headless run writes its outcome (a robust complement to the process exit code).
Define CS_CmdIniResultFile          for "Result File Name"      // Full path. The build deletes it before the run, then reads STATUS=SUCCESS|FAILED after (missing file = the run crashed/hung).

// *** End "DFRefactorCmdLine.ini" Sections ***
//
Define CS_StudioTools               for "\Studio\Tools"
Define CS_RegWorkspace              for "<workspace>"
Define CS_RegFileName               for "<file>"
Define CS_SaveAll                   for "<saveall>"
Define CS_CommandLine               for "CommandLine"
Define CS_Command                   for "Command"
Define CS_Name                      for "Name"
Define CS_Separator                 for "Separator"

Define CPC_OpenFile                 for 1 // perfcounter on open file
Define CS_Settings                  for "Settings"
Define CS_GridFontSize              for "GridFontSize"
Define CS_GridTheme                 for "GridTheme"
Define CS_GridCaptionColor          for "GridCaptionColor"
Define CS_TabPosition               for "TabPosition"
// cRDCModalPanel's End_Construct_Object grows the panel by this many units to make room for
// the CodeJock status bar it builds there. A child anchored anAll stretches to the panel's
// bottom edge and swallows that strip, so such a child must be re-sized AFTER the forward.
Define CI_ModalStatusBarUnits       for 8

/* CS_PaletteCssLink, CS_PageFitCssLink and CS_PillsCssLink - the library's style sheets, as a fragment links them
   - are Library-RDCFlexTron's own (FTConstants.h.pkg) since DFRefactor's pin moved to 0.9.1 (2026-09-29); they were
   copied here until then. A fragment is its own document and does not inherit application.css, so it links them
   itself, CS_PaletteCssLink first. */
/* The two dashboard boards - step strip, cards, chips, findings list. Was 107 lines of DataFlex
   inside DashboardFT.vw building one <style> block; 108 rules, not one of them interpolated.
   Returned by TileCss AFTER CS_PaletteCssLink, so a tile rule still overrides a shared one exactly
   as the inline block did - link order is what preserves that. */
Define CS_TilesCssLink              for '<link rel="stylesheet" href="CssStyle/tiles.css">'
// The Libraries dialog and the Modernization progress panel. Same reasoning as the boards: the
// rules were static, so they are files now. Both linked AFTER CS_PaletteCssLink by their caller.
Define CS_LibrariesCssLink          for '<link rel="stylesheet" href="CssStyle/libraries.css">'
Define CS_ModProgressCssLink        for '<link rel="stylesheet" href="CssStyle/modprogress.css">'

/* THE FINDINGS RENDER CONTEXT.

   FindingsListHtml fills four bands - breaks-the-build, auto-fixable, needs-review, by-hand - and
   the 266-line block that builds one row touches nearly all of it. Passing that as parameters came
   to 31 (5 in, 26 by reference), which is not a signature anyone can read or get right.

   The member names are EXACTLY the local names they replace, so introducing this was a rename the
   compiler could check rather than a rewrite anyone had to review.

   The last two groups are the subtle part: those values are carried BETWEEN rows. asCallLines is
   the payload of the cache whose key is sCallFile - on a cache hit it is read without being
   written, so making it a per-row local would have silently emptied the cache. asBuiltins is the
   memoised native-function catalogue (re-fetching it per row was measured at 2.8 seconds once),
   asCallPairs and asObjNames dedupe across rows, and iCallReads is the read budget - reset it per
   row and the cap never trips. None of that would have failed a compile. */

/* What ONE program's LAST build left behind, read off its compile artifacts (cCompileMixin
   .ProjectBuildHealth). A Check compiles ONE program, so the board's verdict about "the compiler"
   used to be a statement about one project silently presented as one about the workspace (Nils
   2026-08-29: two E 4539 in a pool package of a program the Check never compiled, and
   "Nothing left to fix ... the compiler is clean"). This is the evidence the verdict now cites for
   the OTHER projects: their freshest .err (errors counted with the canonical parser), else their
   .prn (built, no errors recorded), else an .exe ALONE (CI_BuildHealthExeOnly - an exe says nothing
   about when or where it was built; Nils 2026-09-03: 20 WinServ programs whose only artifact was a
   32-bit exe from 2021 read as "all built clean on their last builds" in a DF26 migration that had
   never compiled one of them), else nothing (never built here - NOT the same as clean). */
Define CI_BuildHealthNeverBuilt for 0
Define CI_BuildHealthClean      for 1
Define CI_BuildHealthErrors     for 2
Define CI_BuildHealthExeOnly    for 3

/* How many failing projects the board's other-projects line NAMES before it starts counting.
   A .sws project list is a workspace's whole history - 134 entries on one legacy workspace - so a
   line that names every project it has something to say about is a wall of file names, not a
   finding (Nils 2026-08-30). Six is what fits one readable sentence; the remainder is counted in
   words of its own so the cap can never be mistaken for the whole list. */
Define CI_OtherProjHealthNameCap for 6

Struct tProjectBuildHealth
    String  sProgram        // the project source name as the .sws lists it ("SetupDataFolders.src")
    Integer eState          // CI_BuildHealth*
    Integer iErrors         // parsed error count when eState = CI_BuildHealthErrors
    String  sWhen           // write time of the artifact the state was read from ("" when never built)
    DateTime dtWhen         // the same write time as a DateTime - oldest/newest comparisons across projects
End_Struct

// How many halting files the board's FlexCOM halt banner offers a button for; the rest are counted,
// and the banner says where they are listed (DashboardFT.vw: _FlexComHaltHtml).
Define CI_FlexComHaltChips          for 6

Struct tFindingsCtx
    // True when the scan found a FlexCOM-era proxy (DS 9220): the engine will refuse every
    // write-run, so the board must lead with the HALT and not offer the plan.
    Boolean bFlexComHalt
    // True when the Review band's plan row stands above the bands (DashboardFT.vw: _AddPlanLeadRows). Every
    // band then starts closed (_AppendBands).
    Boolean bPlanOnTop
    // The files behind that halt, in row order, and the line in each that uses FlexCOM.pkg. The
    // banner names them, so nobody has to find their rows (DashboardFT.vw: _NoteFlexComHaltFile).
    String[]   asHaltFile
    Integer[]  aiHaltLine
    String     sBreak
    String     sAuto
    String     sReview
    String     sHand
    String     sBreakAct
    String     sAutoLead          // Auto-fixable rows that LEAD their band - the grid subclass rows (DashboardFT.vw: LeadsAutoBand)
    String     sPeekBreak
    String     sPeekAuto
    String     sPeekReview
    String     sPeekHand
    Integer    iBreak
    Integer    iAuto
    Integer    iReview
    Integer    iHand
    Integer    iReviewRun
    Integer    iReviewReport      // Review rows whose only function is a REPORT - work the tool can still do, but not a plan run
    /* The Check-done dialog's split (2026-09-04): it is built from THESE, the same counts the bands
       are built from, so it can never describe a board other than the one behind it. LegacyApp: the
       dialog said "for some, a report can list every place first" over a Review band holding ten
       obsolete-package rows and no report at all - the 69 report rows were hidden by Ignore, and
       the dialog had no number for hidden rows. */
    Integer    iReviewPkg         // Review rows that are obsolete-package rows re-pointed at a Use line (judge + dismiss)
    Integer    iHiddenReport      // DISMISSED rows whose function is a report the tool could still run
    Integer    iHiddenFn          // DISMISSED rows that carry any function at all (converter or report)
    String     sRow
    String[]   asRevFn
    String[]   asRevHint
    String[]   asRevRows
    Integer[]  aiRevCount
    String[]   asHandFn
    String[]   asHandHint
    String[]   asHandRows
    Integer[]  aiHandCount
    /* The hand band's PACKAGE groups (2026-10-04): an obsolete install package whose Use is there for
       the workspace's own subclass of one of its classes (cModAnalyzer.PackageKeptBySubclass). Keyed and
       dismissed per package file like asRevPkgKey below (kind U), never by message: "Ignore all" on a
       W 4536 message group would hide every obsolete package, the ones still to check included. */
    String[]   asHandPkgKey
    String[]   asHandPkgHint
    String[]   asHandPkgRows
    Integer[]  aiHandPkgCount
    /* The Review band's OTHER dismissal tally, keyed by the install PACKAGE's file name rather
       than by a refactor function. An obsolete-package row re-pointed at the user's own Use line
       carries no converter - deliberately, since obsolete does not mean unused - so the
       function-keyed tally skipped it and it had no dismissal at all: reviewed, understood, and
       back again every Check (Nils 2026-08-30). Keyed per package, not per message: the 4536
       family's other members may well have a real fix. */
    String[]   asRevPkgKey
    String[]   asRevPkgHint
    String[]   asRevPkgRows
    Integer[]  aiRevPkgCount
    String[]   asAutoFiles
    String[]   asReviewFiles
    Handle     hoCall
    String[]   asBuiltins
    String[]   asCallLines
    String     sCallFile
    Integer    iCallKind
    Integer    iCallReads
    String[]   asCallPairs
    String[]   asObjNames
    /* Legacy-grid context for the E 4379 rows (2026-09-04): the files the plan offers
       RefactorDbGridTocDbCJGrid for, and the workspace's own "Class X is a dbGrid" subclass names
       the scan flagged - both lowercased, both gathered once per render by _CollectLegacyGridFacts
       and read by _LegacyGridNote (DashboardFT). */
    String[]   asGridConvFiles
    String[]   asLegacyGridClasses
    String     sBadge
    String     sDot
    /* The OUTSIDE band (2026-08-29): findings in files DFRefactor will not write, previously only
       counted in a header chip. Pool-package rows (a DfPkg checkout / the df-cli package cache /
       a VCS read-only copy) are AGGREGATED per package below and listed read-only with fix-upstream
       framing - a pool package can hold ERRORS that break the very build the board just analyzed
       (the Base64Functions E 4539s, 2026-08-29), and a board that hides an error cannot be trusted by
       arithmetic alone. DataFlex-install rows stay set aside (Nils 2026-07-28: "no point at all to
       list system/native DataFlex packages") EXCEPT a 4536 package self-deprecation, which is
       re-pointed at the workspace's own Use line (the one place the user CAN act). */
    String     sOutside
    String     sPeekOutside
    Integer    iOutside          // rows LISTED in the band (one per package/file group)
    Integer    iOutsideErr       // grid rows with a compile ERROR inside those groups
    Integer    iSysListed        // grid System rows consumed into the band OR mapped to a Use line
    String[]   asOutKey          // group key: lowercased package folder, else the file path
    String[]   asOutName         // display name: package, else the file leaf
    String[]   asOutFile         // first flagged site - the row's jump target
    Integer[]  aiOutLine
    Integer[]  aiOutErr          // COMPILER error messages in the group (a folded row counts its "(xN)")
    Integer[]  aiOutWarn         // COMPILER warning messages in the group, same rule
    /* Deep Scan findings counted SEPARATELY, never added to the warnings (Nils 2026-08-30: "14?
       Have they been counted twice?" - they had been). The two lanes routinely describe the SAME
       source lines: the compiler's W 4534 and DS 9207 both fire on every ToANSI call, so one file
       with seven of them arrived as 7 + 7. A single total cannot be honest about that overlap, so
       the row states each lane and asserts no sum. */
    Integer[]  aiOutScan
    String[]   asOutSample       // first "leaf (ln) <msg>" of the group, for the row text
    /* The row names the FILE as well as the package, and counts MESSAGES rather than rows (Nils
       2026-08-30: "does not show the correct file ... AND the number of occasions is 7", against a
       row reading "VDFQuery20   2 warning(s)" over one file holding seven). asOutLeaf is the first
       offending file, asOutSeen the "|"-joined lowercase leaves so a second file is recognised,
       aiOutFiles how many distinct ones - one file gets NAMED, several get counted. */
    String[]   asOutLeaf
    String[]   asOutSeen
    Integer[]  aiOutFiles
    /* Findings already counted, as "<file>|<msg>|<line cell>". A message matching SEVERAL
       function-bearing recipes yields ONE GRID ROW PER CANDIDATE CONVERTER, each carrying the full
       occurrence count - and for a System row, whose function name is stripped, those rows are
       indistinguishable. 4534 "use of ToANSI" matches two (UnicodeOemAnsiFunctions and
       ChangeOemFileCommands), so seven findings arrived as two identical rows of seven and were
       counted as fourteen (Nils 2026-08-30: "Still counting double?"). Which converter MIGHT fix a
       line does not change how many findings there are. */
    String[]   asOutRowKey
    /* The macro/class CAUSE groups behind the "reported away from the construct" rows (2026-09-02,
       lifted out of FindingsListHtml's locals when the per-row attribution became its own
       procedure): one group per named cause, each keeping its first site so the row can link
       somewhere. Filled by _AttributeMacroCause per row, rendered by _CauseGroupRowsHtml after the
       loop. iMacro counts every such row; iCauseReads / iCauseCapped are the runaway guard and
       what it skipped - said, never relabelled. */
    String[]   asCauseKey
    String[]   asCauseName
    String[]   asCauseFile
    Integer[]  aiCauseKind
    Integer[]  aiCauseLine
    Integer[]  aiCauseCount
    Integer    iMacro
    Integer    iCauseReads
    Integer    iCauseCapped
    /* Per-render copies of the two view memos the row loop consults (2026-09-02): the compiled-copy
       index (_ShadowNoteForFile, every row) and the 4536 Use-site index (_UseSiteForPackage). Each
       is loaded from the view's properties ONCE per render, the first time a row asks, because a
       property Get copies the whole array - per row that was ~290k string copies on a 1993-row
       list. A new tFindingsCtx per render means a render after a recompile sees the new stamp. */
    Boolean    bShadowLoaded
    String[]   asShadowLeaf
    String[]   asShadowBuilt
    String     sShadowProgram
    Boolean    bUseLoaded
    String[]   asUseKey
    String[]   asUseVal
End_Struct

