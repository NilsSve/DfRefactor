Use VDFBase.pkg    // C_NewLine - the system CRLF; DFRefactor's own duplicates retired 2026-08-28
Use Windows.pkg
Use DFClient.pkg

#COMMAND CONSOLE_TYPEFACE _RDN
!A [] $156 !1
#ENDCOMMAND

#COMMAND CONSOLE_FONTSIZE _RD _RD
!A [] $157 !1 !2
#ENDCOMMAND

// Change the terminal fonts.
CONSOLE_TYPEFACE "Times New Roman"
CONSOLE_FONTSIZE 12 8

#IFNDEF ghoFuncLib
    Global_Variable Handle ghoFuncLib
    Move 0 to ghoFuncLib
#ENDIF

#IFNDEF ghoEngine
    Global_Variable Handle ghoEngine
    Move 0 to ghoEngine
#ENDIF

// Handle of the Compiler Output dock (oCompilerOutput_dg), set when it is shown.
#IFNDEF ghoCompilerOutputDock
    Global_Variable Handle ghoCompilerOutputDock
    Move 0 to ghoCompilerOutputDock
#ENDIF

// Monotonic compile "generation" - bumped by TestCompileFT.StartCompile on every compile. Stamped into the
// Compiler Output grid's view signature (psLoadedViewSig) so a RECOMPILE always yields a different signature
// than the pre-recompile capture: the highlight keeper then correctly SKIPS restoring the old selection (a
// stale warning) and lets the loader's own positioning stand (error-summary top / first error). Without it,
// two compiles of the same program share the file-path signature and a recompile looks like a tab-swap.
#IFNDEF ghiCompileGen
    Global_Variable Integer ghiCompileGen
    Move 0 to ghiCompileGen
#ENDIF

// True once a compile has left output (.prn/.err) to analyze; gates the dashboard guided tile's Analyze
// step the same way the Test Compile bar's bHaveOutput does (the dashboard can't see the bar's panel-local
// paths). Published from the bar's ActionButtonsHtml; RESET on every workspace change - a fresh workspace
// has nothing compiled yet, so only Compile should light. (Nils 2026-07-12.)
#IFNDEF ghbHaveCompileOutput
    Global_Variable Boolean ghbHaveCompileOutput
    Move False to ghbHaveCompileOutput
#ENDIF

// Handle of the Modernization Analyzer dock (oModAnalyzer_dg), set when it is shown.
// Lets the earlier-Used CompilerOutput.dg / TestCompileFT.dg hide it (one-at-a-time docks)
// without naming oModAnalyzer_dg directly, since that object is Used later.
#IFNDEF ghoModAnalyzerDock
    Global_Variable Handle ghoModAnalyzerDock
    Move 0 to ghoModAnalyzerDock
#ENDIF

// FT only: handle of the Manual Changes AREA (oManualArea, ManualChangesFT.dg) - the third bottom tab, a
// worklist of what the refactoring functions DECLINED to do. Deliberately separate from the Analyzer grid:
// "what did the compiler find?" and "what is left for me to do?" are different questions, and any converter
// can push a row here without knowing where the grid lives.
#IFNDEF ghoManualChangesDock
    Global_Variable Handle ghoManualChangesDock
    Move 0 to ghoManualChangesDock
#ENDIF

// FT only: handle of the merged bottom dock (oOutputDock_dg, OutputDockFT.dg) that hosts both the Compiler
// Output and Modernization Analyzer AREAS as bottom tabs. ghoCompilerOutputDock / ghoModAnalyzerDock point at
// the two areas inside it (property-sets + Refresh* still work); ghoOutputDock is the panel (Activate / ShowTab).
#IFNDEF ghoOutputDock
    Global_Variable Handle ghoOutputDock
    Move 0 to ghoOutputDock
#ENDIF

// Needs to be _before_ the cApplication object as we refer to it there.
// However, the package itself must be Used _after_ the ghoApplication object,
// as it contains references to the phoWorkspace property. (Kind of catch 22).
Global_Variable Handle ghoEditorProperties
Move 0 to ghoEditorProperties

#IFNDEF cx_Select_All
Enum_List
    Define cx_Select_All
    Define cx_Select_None
    Define cx_Select_Invert
End_Enum_List
#ENDIF

#IFNDEF _STRUCT_tFolderData
Struct tFolderData
    String sFolderName
    Boolean bSelected
End_Struct
#ENDIF

// Meta-data tag type. Used when parsing RegisterInterface message.
Enum_List
    Define eMethodType  for 0
    Define eSummaryText 
    Define eEnumList    
    Define eInitValue   
    Define eHelpTopic   
    Define ePrivate         // { Private = True } meta-tag; sets Functions.bPrivate
    Define eModRecipe       // { ModRecipe = "msg# | match-text | [category]" } - maps a compiler message to this function
    Define eFnGroup         // { FnGroup = Modernization | Cleanup } - groups the function in the Select Functions picker
    Define eNoDoc           // { NoDoc = True } - keep the function OUT of the generated help. It stays fully
                            //   available in the program; only the manual skips it. See bNoDoc below.
    Define eFnFamily        // { FnFamily = <name> } - functions doing the SAME job on different keywords are
                            //   rendered as ONE table in the generated help instead of a run of
                            //   near-identical sections. Free text; the generator groups by exact
                            //   match, so a typo shows up as a family of one in its log.
End_Enum_List

Struct tFuncEnumList
    String[] asEnumList         // String array with enumerations values
    String sInitialValue        // Default value for the enumeration list
    String sParamHelp           // Help text that is displayed when user sets param values.
End_Struct

Struct tFuncParam
    Boolean bByRef              // If parameter is called with a "ByRef"
    String sType                // Variable type.
    String sVarName             // Variable name.
End_Struct

Struct tFuncLib
    String sName                // Function Name
    tFuncParam[] FuncParamArray // Function parameter types and variable names.
    String sReturnType          // Function return type.
    Integer eFunctionType       // The type of function.
    String sSummary             // Summary text.
    String sHelp                // Function help text
    Boolean bFuncEnumList       // True if the FuncEnumList struct contains data.
    tFuncEnumList FuncEnumList
    Boolean bPrivate            // True when the function carries a { Private = True } meta-tag.
    String sFnFamily            // { FnFamily } value, or blank. Members of a family share one
                                // table in the generated function help. A family must not span
                                // MethodTypes - the tables are rendered per page.
    Boolean bNoDoc              // True when the function carries a { NoDoc = True } meta-tag: the
                                // generated function help skips it. Independent of bPrivate, but a
                                // private function is skipped too - it is not part of the shipped set.
    String[] asModRecipe        // Raw { ModRecipe } tag values (msg# | match-text | [category]); one per compiler message this function fixes.
    Integer eFunctionGroup      // { FnGroup } value: eFnGroupOther(0) / eFnGroupModernization(1) / eFnGroupCleanup(2) / eFnGroupUnicode64(3). Groups the Select Functions picker. Mirrors eFunctionType.
End_Struct

// One legacy "Type ... End_Type" definition captured from a (usually system) package - the type
// name plus its raw block lines - so the report can propose a modern Struct for a USED type.
Struct tTypeDef
    String sName
    String[] asBlock
End_Struct

// Cache file for the install-package Type catalogue (Phase A of TypeToStructReport). The system
// packages normally change only on a DataFlex version bump, but an in-place update (same version
// folder) can revise them too - so sPkgNewest stamps the newest *.pkg write time captured at scan
// time and the cache self-invalidates when a package is later found newer (see _PkgScanIsStale).
// Keyed by the target DF version in the filename (Data\DfVersion-TypeDefs-<ver>.json); iVersion is the cache
// FORMAT version - bump CI_TypeDefsCacheVersion to force a reseed if the extraction/format changes.
Struct tTypeDefCacheFile
    Integer iVersion
    String sPkgNewest       // Newest install *.pkg write time at scan time, "YYYYMMDDHHMMSS" (see _PkgTimeStamp); "" = unknown.
    tTypeDef[] aDefs
End_Struct

// Cache file shape for the install-package Global-function-name catalogue (see
// CS_GlobalFuncNamesCacheJson). Same iVersion + sPkgNewest watermark scheme as tTypeDefCacheFile.
Struct tGlobalFuncNamesCacheFile
    Integer iVersion
    String sPkgNewest
    String[] asNames
End_Struct

/* ONE BUILT-IN GLOBAL FUNCTION, read from the install's own Lib\GlobalFunctions.lst.

   These are the functions the COMPILER implements - Abs, Trim, Cast, Character, If, Eval, the whole
   DateGet / DateSet family - and they are declared in no .pkg source anywhere. That is why the
   Pkg-source walk behind tGlobalFuncNamesCacheFile above cannot see them: measured 2026-08-01, it
   finds 2 of the 85. Two catalogues, two different populations, and neither is a substitute for the
   other (see the 4390 "cannot see runtime globals" rule).

   Signature and return type come along for free because the .lst carries them:
       Abs: (Real rValue) [Real]
   They are kept as WRITTEN rather than parsed into parts - nothing consumes them yet, and inventing
   a parameter model before there is a reader would be guessing at the shape it needs. */
Struct tBuiltInFunc
    String sName          // the function name, as the install spells it
    String sParams        // the parameter list as written, e.g. "(Real rValue)" - "()" when none
    String sReturns       // the return type as written, e.g. "Real" - blank if the line omits it
End_Struct

/* The per-target-version cache of the above. iVersion is this file's SCHEMA; sSourceStamp is the
   .lst's own last-write + size, which is exact and cheap - unlike the Pkg walk's watermark, there is
   only ever one file to stamp. */
Struct tBuiltInFuncsCacheFile
    Integer iVersion
    String sSourceStamp
    tBuiltInFunc[] aFuncs
End_Struct

/* One NAMED ERROR NUMBER of the target DataFlex, read from <install>\Pkg\errornum.inc:
       #REPLACE DFERR_REC_NOT_FOUND                             25
   'Error 25' and 'Error DFERR_REC_NOT_FOUND' are the same error - the name is a #REPLACE of the number -
   so ChangeErrorNumberToName can rename one to the other and nothing an error handler sees changes.
   Every install from 18.1 to 27.0 names each number once (measured 2026-10-23: 380 names on 18.1, 392
   on 26.0), and later releases only ADD names - which is why the catalogue is per target version. */
Struct tErrorName
    Integer iNumber
    String sName
End_Struct

// The per-target-version cache of the above - the same iVersion + sSourceStamp scheme as
// tBuiltInFuncsCacheFile (one install file, stamped by last-write + size).
Struct tErrorNamesCacheFile
    Integer iVersion
    String sSourceStamp
    tErrorName[] aNames
End_Struct

/* THE LANGUAGE ITSELF, read from the target install's Lib\DataFlex.lng - the file the Studio lexes
   with, so this is what DataFlex says DataFlex is.

   asScopeStart / asScopeEnd are PARALLEL and unsorted: entry i of one closes with entry i of the
   other. That pairing is the reason to read this file at all. The funclib's own pasScopeStart /
   pasScopeEnd are sorted sets for fast lookup and CANNOT carry it - sorting either array destroys
   the correspondence - so the pairs live here and travel separately.

   The pairing is not one-to-one in either direction: Begin closes with End, Loop OR Until, so the
   same opener appears three times with three different partners. Any matcher has to allow a set of
   partners per opener, never a single lookup. */
Struct tDfLanguage
    String[] asKeywords
    String[] asOperators
    String[] asScopeStart
    String[] asScopeEnd
    String[] asMetaTags
End_Struct

Struct tDfLanguageCacheFile
    Integer iVersion
    String sSourceStamp
    tDfLanguage Language
End_Struct

// One byte-buffer usage CLUSTER for TypeToStructReport's Tier-1 auto-convert feasibility grading:
// within ONE scope (a procedure/function, or "(file)" for a file-scope buffer), ONE String buffer
// variable used AS one Type via the legacy accessors (ZeroType / Put / GetBuff / ...). An empty
// asBlockers = every use of this buffer is mechanically rewritable to a Struct local (the Tier-1
// subset a future converter could auto-apply); otherwise each blocker names the exact reason +
// line, so the developer knows why that cluster stays a hand-migrate. Built per file by
// _TypeClustersFromLines (cRefactorFuncLib).
Struct tTypeBufferCluster
    String sTypeName
    String sFile
    String sScope           // Procedure/function name the buffer lives in; "(file)" = file-scope buffer.
    String sBuffer
    Integer iFirstLine      // First accessor line binding the buffer to the Type (1-based).
    Integer iBindings       // Number of accessor lines in the cluster.
    String[] asBlockers     // Empty = AUTO-CONVERTIBLE.
    /* The EXACT lines the grading looked at - the String declaration and every accessor of this
       buffer - 1-BASED, like iFirstLine above. Returned so that a CONVERTER rewrites precisely
       what was graded: re-deriving the scope in a second walk is how the two would drift apart,
       and the grader has these numbers already (Nils 2026-08-31, Tier 2).
       iDeclLine is -1 when no declaration was found in scope - itself a blocker. */
    Integer   iDeclLine
    Integer[] aiAccLines
End_Struct

// One row of the FloatingPopupMenu -> cCJContextMenu emitter's model (_CJPopupBlockToContextMenu,
// cRefactorFuncLib): an ITEM with its caption, message, explicit target, tooltip and whether a
// separator precedes it; or a COMMENT / BLANK line carried where it stood. A separator is not a row -
// it flags the next item and takes a legacy item index, which iItemIx keeps for the Shadow_State
// translation of the Popup override.
Struct tCJPopupRow
    String  sKind       // ITEM | COMMENT | BLANK
    String  sCap        // the legacy caption, accelerator included
    String  sMsg        // the bare message (no Msg_ prefix)
    String  sTarget     // the 'to <target>' clause, or ""
    String  sTip        // Status_Help
    String  sRaw        // a COMMENT's text
    Boolean bGroup      // a separator precedes this item
    Integer iItemIx     // the legacy item index (0-based, separators count); -1 for a non-item
End_Struct

// --- .err analysis track: compiler-error triage (see cModAnalyzer.pkg) ---
// eCategory ranks how a parsed .err error can be handled. Phase 1 only classifies
// and explains (read-only); Suggest / AutoFix drive the later apply phases.
Enum_List
    Define eModUnknown      for 0  // No recipe yet - review manually.
    Define eModExplain             // Explain only; manual fix (needs judgement).
    Define eModSuggest             // A concrete fix can be suggested (Phase 2).
    Define eModAutoFix             // An existing refactor function already fixes it.
End_Enum_List

/* WHY a reported construct is not on the line the compiler pointed at (MacroExpansionCause). The
   analyzer used to call every one of these "inside macro expansions"; on WinServ most were object
   declarations, where the construct lives in the CLASS. Unknown is a real answer - the row then shows
   the line instead of naming a cause nobody established. (2026-08-19) */
Enum_List
    Define eMacroCauseUnknown for 0 // cannot tell from the line - show the line itself
    Define eMacroCauseClass         // "Object X is a <Class>" - the construct is in that class
    Define eMacroCauseMacro         // the line invokes a command/macro whose body carries it
End_Enum_List

Struct tModAnalyzer
    Integer iMsgNumber      // Compiler message number (e.g. 4538). 0 in a pure classify-result.
    Boolean bIsWarning      // True = compiler warning, False = error.
    String sMatchText       // Message substring that disambiguates this row (blank = any text for the number).
    Integer eCategory       // One of the eMod* values above.
    String sCategoryText    // Human-readable category label for the analysis grid.
    String sHint            // One-line "how to fix" guidance.
    String sRefactorFn      // Refactor function that addresses it ("" if none / Explain-only).
End_Struct

// --- Deep Scan track: source-driven obsolete-symbol scanner (see cDeepScanner.pkg) ---
// The compiler warns about only a fraction of the retired language surface - most obsolete
// commands/symbols either fail hard or compile SILENTLY (If Not, Chain, the Reg_* family...).
// Deep Scan finds them by scanning the SOURCE against a catalog seeded from the docs'
// "Obsolete Commands, Functions & Other Symbols" list. eDSKind picks the detection rule -
// context matters: Left/Mid/Pos/Trim are obsolete only as COMMANDS (the functions are modern),
// EQ/GE/IN only inside command-syntax comparisons, Not only in the two-word If form.
Enum_List
    Define eDSCommandPos    for 0   // Symbol opens the code line (1- or 2-word token).
    Define eDSAnywhere              // Whole-word match anywhere in the CODE (comments/literals never).
    Define eDSConditionLine         // Whole-word match, but only on an If/Else/While/Until line.
    Define eDSIfNot                 // The two-word legacy negation: 'If Not <operand>'.
    Define eDSOnDispatch            // 'On <expr> Gosub/Goto ...' (the On Error form is its own rule).
    Define eDSUseNoExt              // 'Use <name>' whose filename lacks a '.' extension (msg 4535).
    Define eDSClassDecl             // 'Object <n> is a <Class>' OBJECT declaration (msg 4537 family) -
                                    // the anchor makes common-word class names (List, Grid, Edit)
                                    // unambiguous, and the grid/timer converters can transform it.
    Define eDSClassSubclass         // 'Class <n> is a <Class>' SUBCLASS definition. A row here needs its own decision,
                                    // because rewriting a class definition can break every instance built on its
                                    // legacy API: an Explain with no converter, a Suggest where the class swap
                                    // is near pure (Edit, dbEdit, WinReport), an Auto-fix for the grid family.
    Define eDSReplaceConst          /* '#REPLACE <name> <value>' where <name> is NOT a DataFlex
                                       keyword - i.e. the CONSTANT-like use that 'Define name for
                                       value' can actually express.

                                       The rule used to match every #REPLACE line and assert the
                                       Define rewrite as its headline. Nils's counter-example
                                       (2026-07-28) settles it: '#REPLACE End_Procedure
                                       End_Procedure_Profiler' substitutes a LANGUAGE KEYWORD, and
                                       Define creates a named constant - it cannot redefine
                                       End_Procedure. Replacing a keyword is definitionally a macro,
                                       never a constant, so _IsKeyWord is an exact discriminator
                                       rather than a heuristic. */
    Define eDSUseContains           /* 'Use <name>' whose FILENAME contains the token - a whole
                                       PACKAGE FAMILY, matched where it enters the program.

                                       Added 2026-08-09 for Crystal Reports, which arrives under 14
                                       different package names across the DF18/DF19 trees
                                       (crystalreport.pkg, cCrystal.pkg, rcCrystalReport.pkg,
                                       cCrystalDbAutoConnect.pkg, crystalrep2.pkg, ...) in 339 Use
                                       lines. Enumerating them as 14 eDSAnywhere rules would be
                                       brittle in both directions: it misses the next wrapper
                                       somebody writes, and it says nothing when a name changes.

                                       The USE LINE is the right anchor rather than the call sites:
                                       retiring Crystal is a per-FILE decision about a dependency,
                                       so one finding where the dependency enters beats hundreds on
                                       every method that touches it. */
    /* External_Function whose parameter or return TYPES disagree with the Windows SDK - an
       Integer where the API takes a pointer, which on x64 compiles clean and truncates the
       address at run time.

       THE ONLY KIND THAT NEEDS MORE THAN ITS OWN LINE. A declaration is routinely spread over
       ";"-continued lines, and the types live on the continuations, so this one joins forward
       before it judges. Every other kind reads a single line and always will.

       It answers by asking ConvertWinAPIDeclarationTypes' OWN decision function, so the grid
       and the fix cannot disagree: if the rule reports it, the converter changes it. */
    Define eDSApiDeclTypes
    /* External_Function bound to an ANSI "...A" entry point whose WIDE twin the catalogue holds -
       the A-to-W migration GuardAnsiExternalFunctionWithWide performs (original kept for older
       releases, W declaration for the Unicode ones). Reads past its own line like eDSApiDeclTypes,
       and skips declarations already inside a version guard or IS$WIN64 region. */
    Define eDSAnsiApiWide
    Define eDSReplaceCommand        /* The legacy Replace COMMAND: 'Replace <find> In <var> With <new>'
                                       (first occurrence, in place) - optionally behind a one-line
                                       'If (...)' guard. Its own 'in' keyword baited the IN-comparison
                                       rule (DS 9041) into routing it at ChangeInToContains, which
                                       correctly no-ops - six auto-fixable lines parked in "needs hand
                                       migration" on a real 19.1 workspace (2026-08-29). Matched as:
                                       bounded 'replace' NOT followed by '(' (that is the modern
                                       Replace() function), with bounded 'in' and 'with' following.
                                       Routes to ChangeReplaceCommandToFunction. */
    Define eDSTokenPrefix           /* A whole token whose NAME BEGINS WITH the rule token - the
                                       vendor-NAMESPACE shape, where one prefix owns a family of
                                       symbols too large and too version-dependent to enumerate.

                                       eDSAnywhere cannot express it. It matches whole words, so
                                       the token "xtpreport" never sees
                                       xtpReportThemeVisualStudio2012Light - which is how the
                                       CodeJock rename went undetected in a source lane that
                                       already carried a rule for it (2026-08-30).

                                       The boundary is checked at the START of the token only
                                       (_FindKeywordPos with bWholeWord False), never at its end -
                                       that is the point. Use it ONLY for a token that is a vendor
                                       namespace: an ordinary word as a prefix would match every
                                       identifier that merely opens with it. */
    /* A legacy Type byte-buffer whose Type DataFlex has REPLACED with a shipped Struct, where
       the whole cluster verifiably converts. Reads past its own line - see _RuleMatchesLine. */
    Define eDSTypeToWinStruct
    /* A legacy Win32 Type byte-buffer that ChangeExternalFunctionCallers can actually convert -
       the whole cluster, verified by RUNNING the converter on a copy of the file and reporting
       only the lines it removed. See _RuleMatchesLine for why the run itself is the predicate
       here rather than a WhyNot function of its own.

       A cluster the run DECLINES raises one Explain row per Type, on its first accessor, with
       the run's own note as the hint - the reason is read back from the run, never re-derived
       (2026-09-13).

       (15 briefly held a Tier-3 "add a Struct beside a user-declared Type" kind on 2026-09-01,
       withdrawn unbuilt the same day when ChangeExternalFunctionCallers turned out to do that job
       already, and better - it emits the SDK's own layout, alignment members included. Nothing
       shipped with the old meaning.) */
    Define eDSWin32BufferConvertible
    Define eDSUnpairedWarningsOff      /* 'CompilerWarnings Off' with no 'CompilerWarnings On' after
                                         it in the same file. Reads past its own line, like the
                                         External_Function kinds - the line is only a finding because of
                                         what does NOT follow it. Measured against DF26: 'Suspend' is
                                         one-way but dies with the file that issued it, while 'Off' is a
                                         plain switch that does NOT, so an unclosed one silences every
                                         file compiled after this one - a library's consumers included. */
    Define eDSImageOption              /* a word after a legacy report image's NAME, on its name line
                                          ('/Body Resident' - DS 9233). The scan blanks every image line
                                          for the other kinds, because an image's words are its name and
                                          its text, never code; this kind alone reads the raw name line,
                                          swept by _SweepImageNameRules. */
    Define eDSSubclassObject           /* 'Object <n> is a <Class>' where <Class> is the workspace's own
                                          subclass of a legacy grid that ConvertGridSubclassToCodeJock
                                          converts in place (2026-10-04). The family's object rule
                                          (eDSClassDecl) steps back for such an object, so it is listed
                                          once - under the rule whose converter will convert it. */
    Define eDSPointerStringMove        /* 'Move <a> to <b>' between a Pointer/Address and a String -
                                          compile error 4539 (2026-10-20). Only the method's declarations
                                          tell a pointer from a string, so this kind is never matched per
                                          line: the rule's converter (UnicodePointerToString or
                                          UnicodeStringToPointer) runs once over a copy of the file, and
                                          each line it would rewrite is a row (cDeepScanner._PointerMoveHits). */
    Define eDSErrorNumber              /* The Error command with a literal number - 'Error 42', 'If (x) Error 300'
                                          (2026-10-23). The target DataFlex's errornum.inc decides: DS 9244 takes the
                                          numbers DataFlex names. Of the others DS 9252 takes the ones with their own
                                          text and DS 9245 keeps the rest (2026-11-05). Scan and fix share the decision
                                          functions (cRefactorFuncLib._ErrorCommandNumber, _MadeUpErrorWhyNot). */
    Define eDSSelfObjectRef            /* '(oName(Self))' where the file declares 'Object oName is a'
                                          (2026-10-23, DS 9246). Which names are objects is a fact about the
                                          whole file, so - like eDSPointerStringMove - this kind is never
                                          matched per line: RemoveSelfFromObjectReferences runs once over a
                                          copy of the file and each line it would change is a row
                                          (cDeepScanner._SelfObjectRefHits). */
    Define eDSObsoleteMethodTarget     /* 'Procedure Foo for DFDesktop / Desktop / BaseClass' (2026-10-23,
                                          DS 9247 / 9248). The rule's token says which: "dfdesktop" takes
                                          DFDesktop, "desktop" takes Desktop and BaseClass. One decision for
                                          scan and fix (cRefactorFuncLib._ObsoleteMethodTarget). */
    Define eDSObsoleteClassName        /* One of VdfBase.pkg's 27 old class names in a class position - 'is a',
                                          a method header's 'for', RefClass(), U_ (2026-10-23, DS 9249). One
                                          decision for scan and fix (cRefactorFuncLib._ObsoleteClassNameAt). */
    Define eDSFieldMainIndex           /* Field_Main_Index (2026-10-23): the rule with a converter takes the calls
                                          (DS 9250), the rule without one an augmentation (DS 9251). One decision
                                          for scan and fix (cRefactorFuncLib._FieldMainIndexUse). */
    Define eDSLegacyWorkspaceRead      /* 'Get <name> of ghoWorkspace to <dest>', the retired Workspc.pkg global (2026-11-05):
                                          a name with a modern property is DS 9253's row, any other name DS 9254's. One
                                          decision for scan and fix (cRefactorFuncLib._LegacyWorkspaceRead). */
End_Enum_List

// First Deep Scan pseudo message number (iDSNumber below). DS numbers live far above the real
// compiler-message range, so "iMsgNumber >= CI_DeepScanFirstDSNumber" identifies a Deep Scan
// recipe/row wherever only the recipe is at hand (the analyzer's source-guard machinery).
Define CI_DeepScanFirstDSNumber for 9001
// A Deep Scan RULE that fires this many times in one Check collapses into one summary row
// (ModAnalyzerFT _CountScanFloods) - the scan-lane twin of the compiler's 4544/4390 flood at 100.
Define CI_DSFloodThreshold          for 100

Struct tDeepScanRule
    String  sSymbol         // Display name (e.g. "Left command").
    String  sToken          // Match token(s), LOWERCASE (eDSCommandPos allows a two-word token).
    Integer eDSKind         // One of the eDS* detection kinds above.
    Integer eCategory       // Reuses the eMod* triage categories.
    String  sRefactorFn     // Refactor function that converts it ("" = hint-only).
    String  sHint           // One-line modern replacement (from the docs harvest).
    Boolean bEnabled        // False = shipped dormant (common-word tokens too noisy to scan by default).
    Integer iDSNumber       // STABLE pseudo message number (9001+, assigned by seed position in
                            // AddDSRule) - doubles as the recipe key so Deep Scan rows classify/plan
                            // like compiler messages, and as the ignore-list key. The seed is
                            // APPEND-ONLY: never insert/reorder rules, or standing ignores shift.
End_Struct

Struct tDeepScanHit
    Integer iLine           // 1-based source line of the finding.
    String  sSymbol
    Integer eCategory
    String  sRefactorFn
    String  sHint
    Integer iDSNumber       // The matching rule's stable pseudo message number.
End_Struct

// Deep Scan report filename (written to the backup folder, like the Gosub/Goto report).
Define CS_DeepScanReportLogFile for "DeepScanReport.log.txt"

// The editable Deep Scan rules JSON (DFRefactor's OWN Data folder - the catalog is global, not
// per-target-workspace). CI_DeepScanRulesVersion is the SEED version: bump it whenever the
// built-in catalog changes (new rules, re-routed functions) so existing files reseed - the
// user's per-rule Enabled toggles are MERGED ACROSS by iDSNumber (which is why the seed is
// append-only). The rules file is what the per-rule enable UI edits.
Define CS_DeepScanRulesJson     for "DeepScanRules.json"
/* The Windows API catalogues as EDITABLE JSON, in DFRefactor's OWN Data folder beside
   DeepScanRules.json - the same place, resolved the same way (pOrgWS, never the target).

   WHY EDITABLE AT ALL. The catalogue's problem is that it has to GROW: 56 API entries against the
   1,310 distinct entry points a scan of the workspaces found. Data entry that costs a recompile
   does not happen, so the compiled seed becomes the floor and the JSON is where entries are added.

   NOT keyed by target DataFlex version, unlike ModAnalyzerRecipes-<ver>.json. These hold SDK
   prototypes, which do not vary by DataFlex release; the question that DOES vary - "does this
   target already ship it?" - is answered live by the install scan. */
Define CS_WinAPICatalogJson       for "WinAPICatalog.json"
Define CS_WinAPIStructCatalogJson for "WinAPIStructCatalog.json"
// The corpus scan of every workspace's External_Function entry points (AppSrc, tracked) - the
// harvest tool's intersection source.
Define CS_WindowsAPICorpusJson    for "WindowsAPI.json"
Define CS_WinAPIBitnessSplitJson  for "WinAPIBitnessSplit.json"
/* Bump to reseed the JSON from the compiled seed. User-ADDED rows survive the reseed (that is the
   whole difference from DeepScanRules.json, which merges only a toggle); rows the seed itself
   ships are replaced by it, so a corrected prototype actually reaches an existing install. */
Define CI_WinAPICatalogVersion    for 1
/* Fewest members a legacy Type must declare before WinAPIStructNameByMemberShape will identify it
   by its member names alone, and before a short Type can become the whole struct its name found.
   Measured against the live catalogue (2026-11-04, 12,787 structs): below four the shapes are small
   and generic ({version, unionName1}, {id, value, valueSize}, {numEntries, table}); at four and above,
   4,792 of 5,491 shapes belong to one struct. Raising this trades reach for certainty; lowering it
   starts matching structs that merely happen to look alike. */
Define CI_WinAPIShapeMatchMinMembers for 4
Define CI_DeepScanRulesVersion  for 107   // v107: DS 9221 no longer offers an A/W pair whose raw-memory arguments differ in C type between the arms (GetComputerNameA PSTR vs ...W PWSTR) or that passes an address in an Integer where the wide twin marshals text - the catalogue now carries a "// ptrs:" tail (2026-11-21). v106: DS 9253 and 9254 join the seed: reads of the retired ghoWorkspace global, which only a compile brought out until now. v105: DS 9204, the WinReport subclass row, edited in place: it now carries RefactorWinReportTocWinReport2 as a Suggest, like the Edit and dbEdit subclass rows, and that function now gives a converted Class its Use even in a file with no Use at all (Nils 2026-11-05). v104: DS 9252 appended: an Error command with a made-up number and its own text is Auto-fix (ChangeErrorNumberToGenericError, Nils 2026-11-05), and DS 9245 keeps only what that declines, each row saying why. v103: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9225 runs the converter on a copy, and with a run file list every method a file defined looked called from another file, so a buffer crossing methods was refused in a real run and in a Check after one: the first live run of SYSTRAY_NOTIFY (Nils 2026-11-05). v102: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9225 runs the converter on a copy, and the struct catalogue now holds every struct the Windows metadata names, not only those an API prototype names: NMLISTVIEW, LVITEMA, LVHITTESTINFO, TVITEMA and the rest that travel through SendMessage. So tNM_LISTVIEW, tLV_ITEM and tLVHITTESTINFO take Windows' 64-bit layout instead of their own member types, and a C-flavoured row (NMSELCHANGE) nests the shipped structs instead of one Integer each (2026-11-04). v101: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9225 runs the converter on a copy, and the converter now follows a buffer across methods in one file (a Function returning it and the variables receiving it, an uncalled method's String parameter), and writes a tail member with no shipped struct as the bytes it takes up, so SYSTRAY_NOTIFY turns from an Explain row into an Auto-fix (Nils 2026-11-05). v100: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9225 runs the converter on a copy, and the converter now takes a Type that writes out what its Windows struct nests (tMSG's ptX and ptY for MSG's POINT pt, WIN32_FIND_DATA's FILETIMEs as six DWords) and a dotted Type the catalogue does not know (Field tLVHITTESTINFO.PT.x), so those Explain rows turn into Auto-fix (Nils 2026-11-04). v99: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9225 runs the converter on a copy, and the converter now starts from the calls: a buffer handed to an API parameter the catalogue says takes a struct (the new "// args:" tail) proves which struct the Type is, so a Type that lists only that struct's first members (tagMENUITEMINFO, 11 of MENUITEMINFOA's 12) turns from an Explain row into an Auto-fix; a command split over ";" lines no longer refuses its cluster (Nils 2026-11-04). v98: DS 9246 ((Self) in an object reference) PROMOTED in place to Auto-fix and switched ON (Nils 2026-10-30). It shipped OFF and as Review at v93 until a live run; the 2026-10-24 one on a workspace copy changed 10,960 references, every line as an independent model predicted, with the same compiler errors and warnings before and after. A saved file older than v98 holds the old OFF as a default, not a choice, so the toggle merge lets the seed's ON stand there (cDeepScanner._SeedSwitchedOnAfterFile). v97: no rule text changed - a MATCHER answer moved, so this is the cache flush. The scan's masking pass is the file walk every lane now reads (cRefactorLexer's ScanSourceFile): an @"... / @SQL"... / @'... / @SQL'... string over several lines is text up to its first closing quote, and the code after that quote is code (measured on DataFlex 26). The pass knew only """ strings, so 'Object oX is a DFPanel' or DFTrue in an @-string's text raised a row whose fix would change the string (2026-10-29). v96: no rule text changed - a MATCHER answer moved, so this is the cache flush. A DF 23 multi-line string's body and closing line are text to the scan's masking pass, and its opening line counts only up to the """ - the rule the tokenizer and the whole-file converters now share (_MultiLineStringOpens / _MultiLineStringCloses, measured on DataFlex 26), so 'Object oX is a DFPanel' or DFTrue inside a { Description = """ ... """ } block or a 'Set psHtml to """' string no longer raises a row whose fix would change the string (2026-10-24). v95: no rule text changed - a MATCHER answer moved, so this is the cache flush. The old-class-name rule's pre-check (DS 9249) looked for the text "is a", so 'is  a DFPanel' (two spaces) or a tab before the article raised no row while ChangeObsoleteClassNames fixed the line (Nils 2026-10-24). v94: five rules appended, phase 2 of the migration-chapter gaps (Nils 2026-10-23), the old names taken from DataFlex's own Pkg\VdfBase.pkg (27 '#Replace U_<old> U_<new>' lines, the same on 18.1, 19.1 and 26) and each rename measured exact by a probe on DataFlex 26. DS 9247 'for DFDesktop' -> the Desktop keyword and DS 9248 'for Desktop' / 'for BaseClass' -> 'for cObject' (Auto-fix: the new ChangeObsoleteMethodTarget, kind eDSObsoleteMethodTarget; the parameter Desktop writes the keyword instead). DS 9249 an old class name after 'is a', a method header's 'for', in RefClass() or as U_<old> (Auto-fix: the new ChangeObsoleteClassNames, kind eDSObsoleteClassName; the row names the new class). DS 9250 a Field_Main_Index call (Review: the new ChangeFieldMainIndexToFileFieldIndex) and DS 9251 an augmentation of it (Explain), kind eDSFieldMainIndex. v93: five rules appended for gaps found in the DataFlex docs' "Migrating Older Applications" chapter (Nils 2026-10-23). DS 9242 / 9243 DFTrue and DFFalse (Auto-fix: ChangeDfTrueDfFalse, made word-aware for them - it rewrote 'bDfTrueSet' and missed DFTrue inside an expression). DS 9244 an Error command with a number DataFlex names (Auto-fix: the new ChangeErrorNumberToName, names from the target's errornum.inc) and DS 9245 one it does not name (Explain), on the new kind eDSErrorNumber. DS 9246 (oName(Self)) -> (oName), Review and shipped OFF, on the new kind eDSSelfObjectRef: the new Tidy Up function RemoveSelfFromObjectReferences runs over a copy of the file and its changed lines are the rows. v92: two rules appended - the pointer/string Moves of compile error 4539 (Auto-fix: UnicodePointerToString, UnicodeStringToPointer), a new kind (eDSPointerStringMove) that lists the lines the converter itself would rewrite (Nils 2026-10-20, the Test Bench's Analyze). v91: three rules appended - the obsolete Incr, Decr and Sub commands in command position (Auto-fix: ChangeIncrToIncrement, ChangeDecrToDecrement, ChangeSubToSubtract). They had compiler recipes only, so a scan never listed them (Nils 2026-10-20, the Test Bench's Analyze). v90: no rule text changed - a MATCHER answer moved, so this is the cache flush. An Else in front of Indicate, Ind or a bracket no longer hides the line from the command-position and condition rules: 'Else Indicate X False' raised no row, and the converter had written it as 'Move (False) to gbX', the Else gone (Nils 2026-10-06, "fix the Else case too"). ChangeLegacyIndicators now converts the statement after an Else as it would convert it alone and puts the Else back in front. v89: no rule text changed - a MATCHER answer moved, so this is the cache flush. A '[bracket]' in front of Ind, Indicate's obsolete spelling, no longer hides the line from the Ind command rule (DS 9033) - what v74 did for Indicate. '[ found] ind found as <a> eq <b>' raised no row while a bare 'ind ...' did, and a run turned the line into 'If (found) ind found as (<a> eq <b>) to'; ChangeLegacyIndicators now takes Ind wherever a command stands (GitHub 2026-10-06, a DataFlex 3.2 program). v88: wording only - the hints of the 'ANSI External_Function (wide twin available)' and 'Win32 Type buffer (SDK struct available)' rules no longer say "your ANSI declaration" / "your Type" / "your own member names" (Nils 2026-10-05: user-facing text never calls the code the reader's - it is often a consultant on somebody else's codebase). No category, converter or match changed. v87: the FloatingPopupMenu SUBCLASS rule (DS 9229) offers ConvertPopupMenuSubclassToCodeJock, for review (Nils 2026-10-05: "Couldn't we provide a refactoring function for FloatingPopupMenu ...?" - the one popup row a workspace had left, an empty subclass filled through Add_Item at run time). The scan asks the converter about each such class and keeps the offer only where it converts; elsewhere the row is an explanation with the converter's reason. DS 9230 (dbFloatingPopupMenu subclass) is unchanged. v86: wording only - a class the workspace declares is a "workspace subclass" in every hint, never "your own subclass" (Nils 2026-10-05: "it is often consultants working with somebody else's codebase ... or subclasses written some 20 years ago"): the grid subclass rules (DS 9198-9200), the subclass-object rules (DS 9234-9236), the dbEdit / Edit subclass rules and the learned-subclass match note. No category, converter or match changed. v85: hint text only - the three grid subclass rules (DS 9198-9200) and the three subclass-object rules (DS 9234-9236) name the object converter ConvertGridSubclassToCodeJock runs itself (RefactorDbGridTocDbCJGrid / RefactorDbListTocDbCJGridPromptList / RefactorGridToCJGrid), because a plan listing that one function over every object file read as a mistake (Nils 2026-10-05). No category, converter or match changed. v84: THE GRID SUBCLASSES ARE OFFERED (Nils 2026-10-04: "Why on earth are all grid conversions degraded to hand migration???" - a workspace whose 2,110 grids are all objects of its own subclasses had every one of them in the hand band, because the converter for them, ConvertGridSubclassToCodeJock, was only named in hint text). Three APPENDED rules, DS 9234-9236 - dbGrid / Grid / dbList subclass object, Auto-fix through that converter, on the new kind eDSSubclassObject - and the three subclass (class line) rules DS 9198-9200 carry it too, edited in place. Both only where the converter says it will convert the class (the scan asks it once per learned subclass and Check - cDeepScanner.JudgeGridSubclasses - and the answers ride the cache fingerprint); a class it cannot convert keeps its Explain rows, which now say why. v83: no rule added - the dbGrid / Grid / dbList SUBCLASS hints edited in place, and the note an object matched through a learned subclass carries (_SubclassMatchNote), both name ConvertGridSubclassToCodeJock: it ports such a class IN PLACE and converts every object of it (Nils 2026-10-04, "build 1, 2, 3 and 4"). A List subclass keeps the by-hand advice. Without this bump a scanned file keeps its old note. v82: no rule text changed - a MATCHER answer moved, so this is the cache flush. A hit inside a #COMMAND body (the ToANSI / ToOEM calls, CS_DSMacroSafeTokens) is Explain with no function: it had been capped at Review with UnicodeOemAnsiFunctions still named, a rule from before the engine stopped changing macro code (2026-09-07), so a plan offered the function and the run changed nothing - "0 lines Renamed" (Nils 2026-10-04). Without this bump a scanned file keeps its old Review row. v81: the GRID CONVERSIONS ARE AUTO-FIX - DS 9190 (dbGrid class), DS 9191 (Grid class) and DS 9193 (List class) promoted Review -> Auto-fix in place, beside DS 9192 (dbList class), Auto-fix since v3 (Nils 2026-10-03). Since v80 an EMPTY run converts the plain class only and a subclass object's row is Explain, so what these rows run is a fixed transform. v80: no rule added - the four grid/list SUBCLASS rule hints rewritten in place, and a MATCHER answer moved: an object matched through a learned subclass of dbGrid / Grid / dbList / List is now Explain with no function, because the four converters leave such an object as it is under an EMPTY parameter (Nils 2026-10-03, "a subclass can't be blindly swapped for a CodeJock grid class without first have converted the cEntryGrid subclass"). A workspace's swap had lost what its subclasses add - grid anchoring, label translation, row methods the program called - in 2,126 objects. The hints and the note say to port the subclass first and then name both in the parameter. v79: one APPENDED rule, DS 9233 - the 'Resident' option on a legacy report image's name line ('/Body Resident'), Auto-fix via RemoveResidentImageOption - plus the eDSImageOption kind it matches on. The option only kept an image in memory in character mode; a DataFlex 26 report whose image still carries it crashes or prints useless output (Nils 2026-10-03), and the compiler says nothing about it, so the scan is the only lane that can offer the fix. The rule reads the image name line itself, which every other rule is kept away from. v78: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9188 (Use without file extension) no longer flags 'Use UI', the DataFlex character-mode base, which AddUseFileExtension now leaves as it is: DataFlex 26 has that base under no name, so the extension gained nothing, and the line should stay what the character-mode compiler was given (Nils 2026-09-23, "I don't think there ever was an UI.pkg" - a Check had turned 'use ui' into 'use ui.pkg'). Without this bump a scanned file kept its row, offering a fix the converter now refuses. v77: no rule text changed - a converter's ANSWER moved, so this is the cache flush. ChangeLegacyIndicators now takes 'Ind <indicator> [as] <condition>' - Indicate's obsolete spelling, which dafmac.pkg expands to Indicate - so DS 9033 (Ind command) rows convert instead of sitting under "macro Ind - not yours to change" (Nils 2026-09-20; the analyzer's indicator guard counts an 'ind' command line as carrying the construct in the same change). v76: no rule text changed - a MATCHER answer moved, so this is the cache flush. The If-Not rule (DS 9043) no longer fires when the word after Not is a legacy file-test COMMAND - 'If not Status <file> stmt' and the Else If form: Status takes a file argument and is not a Boolean, the converter declines it (2026-09-19), and the line compiles clean on DataFlex 26 (measured with a probe program; the workspace listing drew no error on it), so the row it raised - 'not auto-fixable in this exact shape, fix it by hand' - asked for a fix the line does not need. Without this bump the scanned files kept that row through a fresh Check, which is exactly how it was found (Nils 2026-09-20). v75: two APPENDED rules, DS 9231 DF_DATE_4_STATE and DS 9232 DF_EPOCH_VALUE, and the DF_SYSDATE_4_STATE rule re-pointed: CommentOutSysdate4State grew into the old Studio's Y2K triplet and became CommentOutLegacyDateAttributes. VdfBase.pkg has set all three since DataFlex 12 (True / True / 30), so a program's own line is redundant only when it repeats that - the converter comments out DF_SYSDATE_4_STATE in any shape (a no-op), DF_DATE_4_STATE only 'to True' and DF_EPOCH_VALUE only 'to 30', and leaves an override (the old template's own 'DF_DATE_4_STATE to False') or a Get verbatim for the dry-run to hand to Explain (Nils 2026-09-18). v74: no rule text changed - a MATCHER answer moved, so this is the cache flush. A '[bracket]'-prefixed Indicate ('[found] indicate found as (a eq b)') is now in command position for the Indicate rule, and an 'Indicate <x> as <condition>' line - bracketed or not - is a condition line for the comparison rules. Both had read '[found]' as word 1, so the bracket-Indicate form the converter rewrites raised NO row: a 2005-era file's two ';'-continued pairs were invisible, and once its other rows were spent the plan was empty (Nils 2026-09-17, "did not suggest any refactoring plan"). v73: no rule text changed - a MATCHER answer moved, so this is the cache flush. DS 9221 now declines an A/W pair whose two arms take DIFFERENT STRUCTURES. SHFileOperationA and SHFileOperationW both declare "Pointer lpFileOp", so the arity check and the pointer-vs-marshal check both pass and the row was offered as an Auto-fix - but the catalogue records one taking SHFILEOPSTRUCTA and the other SHFILEOPSTRUCTW. Swapping the entry point is one line; the structure the CALL SITE fills is not, and the converter cannot see those sites, so the emitted wide arm would receive an ANSI layout. It compiles; it is wrong only when it runs. Measured over Data/WinAPICatalog.json: 367 of 2,069 A/W pairs differ this way (365 the clean ...A -> ...W shape, 2 - tACMFORMATDETAILSW - differing without following the convention, which is why the test is "the refs differ" and not "the wide ref ends in W"), and the scan raised 15 live Auto-fix rows on exactly that shape across the E: test workspaces (SHFileOperationA x3, FindNextFileA x4, InsertMenuItemA x2, PrintDlgA x2, PageSetupDlgA x2, GetVersionExA, PrintDlgExA). The other 1,702 pairs are untouched: a row with no "// refs:" tail says nothing about the structures it takes, and refusing on silence would decline them all. The bare-export gate (ends-in-"a") stays shut - Shell_NotifyIcon would pair straight into this shape. v72: the two SUBCLASS hints (DS 9229/9230) stop promising a listing the scan does not produce. They opened "Objects of this subclass are listed as FloatingPopupMenu objects", but _SubclassLearningToken learns subclasses for dbgrid/grid/dblist/list/dbedit/edit/dftimer/winreport ONLY - floatingpopupmenu and dbfloatingpopupmenu are not among them, so such a subclass is never learned and its objects are never listed. Found on a workspace where the only instance is built dynamically, Get Create (RefClass(cTreeViewPopupMenu)), which no 'is a' detector could have seen either; the class there is an empty pass-through whose two overrides only Forward, yet the port is still a decision rather than a rename, because cCJContextMenu has no Add_Item and that workspace adds its items at run time (Nils 2026-09-16, asking why the Class line gets no Run refactor plan button). An AutoFix promise the plan run cannot keep is what the eDSClassDecl / eDSClassSubclass split was made to avoid; a hint that promises a LISTING the scan never makes is the same defect one step further out. No category, converter or match changed. v71: DS 9082 (Ifchange command) carries its own converter, ChangeIfchangeCommandToAttribute, and stays REVIEW (Nils 2026-09-15, 'yes, build the Ifchange converter as Review'). It had routed to the LegacyDbApiReport worksheet with no function since the catalog was seeded. Review because the rewrite is a 1-to-3 line expansion that declares a local in the user's method - nothing else in this family writes a declaration - and because it has never run against a real site: the command appears in no workspace to hand, and the bar for promoting a rule here has been a measured live run. The VALUES are measured, later the same day: FMAC settles that the command is not an attribute read at all (two dedicated opcodes, one per argument shape, answering through indicator 122 - which is why the compiler reports 4533 plus TWO 4538s on such a line), so a probe read both forms against one table's buffer after Clear, after Find, after a field write and after writing the original value back - 0/0, 0/0, 1/1, 1/1, equal on every row including the last, where the flag stays set because the buffer was written. So the rewrite preserves the condition; what is left to check is the declaration it adds, which is a human's job. v70: three rules carry their own converter and three hints were simply WRONG (Nils 2026-09-15, asking why obsolete Database-API symbols come with no auto-fixable suggestion). DS 9085 Get_Current_Lockcount -> ChangeGetCurrentLockcountToAttribute, Auto-fix: a probe on the DF26 x64 runtime read the count through the command and through DF_TRAN_COUNT with nothing held, inside one Lock, inside two and after unwinding - 0/0, 1/1, 2/2, 0/0 - and FMAC gives the command no WarningEx, so the scan is the ONLY lane it can ever be offered in. DS 9089 / 9090 Get_FileList / Set_FileList -> ChangeFileListCommandToAttribute, Auto-fix: FMAC expands both macros to the GET_/SET_ATTRIBUTE DF_FILELIST_NAME form, so the conversion is what the compiler already does; the legacy shape takes no 'to', which the converter inserts. The three corrected hints: DS 9084 Size_of_Field is a legacy Type MEMBER's byte size (Dll.pkg declares it and says 'Use Structs'), not a database field length, so it routes to TypeToStructReport instead of the DB worksheet; DS 9088 Get_Number_Format returns a format CODE where DF_DECIMAL_SEPARATOR returns the separator CHARACTER (measured, 1 against 44), so the old hint promised a swap the values do not support; and DS 9094 DF_FILE_PRIMARY_INDEX_TRIGGER is a Boolean whose replacement is a four-value enum - False is RIM_NONE, but True meant a trigger fills the column, which is RIM_EXTERNAL, not the 1 a rename would leave - so it stays Review and the hint now says why. v69: DS 9086 (Get_date_format) carries its own converter, ChangeGetDateFormatToAttribute, Auto-fix - it had routed to the LegacyDbApiReport worksheet as Suggest since v70 of the recipes. Auto-fix without a live run, deliberately: the rewrite is a leading-keyword swap, and a runtime probe on DF26 x64 read DF_DATE_FORMAT through both forms at each of its three values and got the same number every time (Nils 2026-09-15, asking for the converter). v68: DS 9227/9228 PROMOTED Review -> Auto-fix in place after Nils's live runs (2026-09-13, "Nice, that works well"); the subclass rows 9229/9230 stay Explain. v67: no rule text changed - a MATCHER answer moved. A line under ChangeFloatingPopupMenuToCodeJock's own refusal marker is no longer silenced on sight: the scan asks the converter again, and an object the converter takes by now raises its row (the first live run's marker had silenced the afternoon's converter, Nils 2026-09-13). v66: DS 9227-9230 - the legacy right-click menu. 'Object x is a FloatingPopupMenu' / 'dbFloatingPopupMenu' rows route to ChangeFloatingPopupMenuToCodeJock (Suggest, like the other class converters); the SUBCLASS forms are Explain rows, as the whole family is. v65: no rule text changed - DS 9225's ANSWER moved and its PRE-GATE widened. The Win32 buffer converter now rewrites Put_String and GetBuff_String, the two accessors for a Type's fixed text field, faithful to what they measurably do on DF26 x64: Put_String copies min(len, n) bytes and zero-fills the rest of the field, GetBuff_String hands back exactly n bytes with the nulls kept - so the emitted form is the MemCopy DataFlex's own Font_dlg.pkg uses, a byte-capped copy after a zero-fill from the buffer's never-written twin, and an n-byte read into a pre-sized String ('Move sText to B.m' compiles and faults at run time with 4381; PointerToString reads past a full member). A wide member (Short[n]) or a one-byte Char refuses with the reason. The pre-gate admits a line whose first word is put_string / getbuff_string, so a buffer reached only that way is examined at all (Nils 2026-09-13: 'the same should be true for all legacy Type def commands'). v64: no rule text changed - the ANSWER of DS 9225 moved again, so this is the cache flush. The converter it asks now takes a buffer bound to a ONE-FIELD Type - Dftypes.pkg's tDWORD and tHANDLE, one field each and no tWin twin, which PASS 2 had refused for ever as 'no modern struct' - by retyping the buffer to the field's scalar: ZeroType becomes Move 0, Put and GetBuff become plain Moves, AddressOf stays, no twin and no Use. The shape is an API asked for one number back through a byte buffer (Nils 2026-09-13, an HtmlHelp init procedure in a test workspace: 'those commands should never be used, that is the goal'). v63: no rule text changed - the ANSWER of DS 9225 moved, twice, so this is the cache flush. The converter it asks now takes a Type whose buffer is handed STRAIGHT to a declared API's Pointer parameter (the argument becomes AddressOf) and rewrites Size_of_Field on the Type to SizeOfType - the line that would otherwise have left the emitted file uncompilable - while Offset_of_Field refuses with the line; and a Type the run declines now raises ONE Explain row carrying the run's own reason, where before it raised nothing and the file's only offer was Ignore (Nils 2026-09-13, a 1999 systray experiment in a test workspace whose 16 report rows offered no way forward). v62: no rule text changed - this is the CACHE FLUSH for a catalogue fact. DS 9219 asks the converter, the converter asks the WinAPI catalogue, and the catalogue's answer for a BARE entry point is no longer a spelling rule (append "a", then "w") but a row measured against the dll: 128 bare exports that really are their ...A entry gained one, and the ones that are the WIDE twin (ReplaceFile, ILCreateFromPath, IsLFNDrive) or their own code (PlaySound, the tapi32 family) deliberately did not - those declarations now find nothing and are left alone instead of being judged by ANSI types. The scan cache fingerprints on this version plus the rules JSON and knows nothing about the catalogue, so without this bump every file already scanned keeps its old 9219 verdict for ever - the 2026-07-31 lesson (Nils 2026-09-12, asking why a bare External_Function got no auto-fix offer). v61: six rules PROMOTED Review -> Auto-fix in place (Nils 2026-09-11: 'what is suggested are genuinely Auto-fix functions'): Indicate command (DS 9032), #REPLACE directive (9059), Cmdline command (9060), Strmark variable (9160), External_Function 64-bit types (9219) and ANSI External_Function (wide twin available) (9221). Measured first on a real workspace, each converter run on an in-memory copy of every file it had hits in and the copy re-scanned: every hit cleared except 13 of 530 Indicate lines, which the line converter's own dry-run hands back to Explain. The whole-file converters get no such dry-run - VerifyAutoFix keeps them rather than guess - so each of those had to clear all of its hits, and did (the ANSI guard once given the version the app takes from the loaded workspace). NOT promoted: Indicator command (9031) - it matches a DECLARATION, which ChangeIndicatorToBoolean converts, not ChangeLegacyIndicators; Ind command (9033) - no hit to measure; Set_Date_Attribute (9030) - commenting out epoch_value changes how 2-digit years are read, and the three attributes come as a triplet in one file, so a plan run over any of them reaches the epoch line too. v60: one APPENDED rule, DS 9226 - an unpaired 'CompilerWarnings Off' - plus the eDSUnpairedWarningsOff kind it matches on. It is the one suppression mistake that fails silently and travels: Off does not end with its file the way Suspend does, so a missing 'On' mutes every file compiled afterwards, in this workspace and in anything that uses it as a package. Explain-only - where the muted region was meant to end is a human decision, and closing it at end-of-file would be a guess (2026-09-09). v59: a MATCHER change, so the bump is the cache flush, not a rule edit - Deep Scan's GUARD A now recognises 'CompilerWarnings Off' / 'On' as the muted region it always meant to honour. It had been written against 'CompilerWarnings Suspend' .. 'Resume', and Resume is not DataFlex at all (Error 4345), so the un-latch could never fire while the form the DF26 install actually uses - Off/On, 27 times each against four bare Suspends - was scanned in full. Measured the same day: Suspend is one-way and dies with the file that issued it; an unpaired Off does not, it silences everything compiled after it (2026-09-09). v58: the 'Gosub Return' rule carries its converter (ChangeReturnToGosubReturn, Auto-fix). Return is the DataFlex 1 spelling of Gosub_Return and the compiler's own message says so, so the swap is a rename rather than a change of behaviour - and it is what lets ConvertGosubToProcedure see a subroutine's exits at all, since that converter reads Gosub_Return and treats a block with none as falling through (2026-09-09). The rule keeps its command-position kind, which is also the converter's own gate, so the grid and the fix cannot drift apart; the 'Gosub command' rule still points at the report for the structural work. v57: the '#REPLACE directive' hint is cut from 600 characters to 108. The rule-selection grid shows the hint, and its tooltip wraps at 250 pixels, so 600 characters became a ~17-line tooltip that ran off the screen - and a NARROWER tooltip would only have made it taller. The full reasoning lives in the converter's { Description } and in the block comment above _ReplaceDirectiveValueKind, which is where it belongs (2026-09-08; the rule hints' median is 41 characters). v56: the '#REPLACE directive' rule carries its converter (ChangeReplaceDirectiveToDefine, Review) and its value test now takes a negative number, measured convertible: '#REPLACE name value' becomes 'Define name for value' with the value left in its own column, while the two shapes that only look convertible - inside an Enum_List, and an unquoted value with spaces - get a TODO marker with the reason (2026-09-08). v55: the strmark / strlen rules carry their converters (ChangeStrMarkToExpression / ChangeStrLenToExpression, Review): a read of a string command's side product becomes the expression the command left, a scratch use a local, and what cannot be derived gets a TODO marker with the reason - the function forms never set the two variables, so the command converters had been leaving such reads silently stale (2026-09-08). v54: the dbEdit / Edit SUBCLASS rules carry their converter (Suggest), so the plan runs it on the file that declares the subclass - the base line converts and the objects follow (2026-09-07; a plan over the objects' files had reported 0 converted). v53: an EMPTY grid-converter parameter now reaches the subclasses the scan learned, for all four families (the funclib hands the converters the learned set - Nils 2026-09-05, "a legacy grid should be handled the same way as a legacy dbgrid"); the subclass hints and the match note say so. v52 (same day): the Grid / List subclass hints and the match note say the truth - those two converters map an EMPTY parameter to the PLAIN class (cCJGrid ends in "grid", cDbCJGridPromptList in "list"), so a subclass must be named, one per run; dbGrid / dbList keep the wide EMPTY (any class whose name ends in the token). v51 (same day) had promised the wide EMPTY for all four; a plan run with empty fields converted 0 Grid subclass objects and showed it. v50: the object-declaration rules match the workspace's own subclasses of the legacy classes (a learned set, folded into the cache fingerprint) and the subclass rules' hints say the objects convert (a workspace 2026-09-04: 455 subclass grid objects in 243 uncompiled files were invisible to both lanes). v49: _TypeDeclaringMember now counts only BARE Field declarations. A qualified one declares tBeta.dwSize and leaves dwSize undeclared, so it can never be what a bare "At dwSize" names - counting it made the guard refuse a file that was never ambiguous, and refuse it silently, since an unbound buffer just leaves its Type looking unused. The matcher reaches this through the vanish check, so a cached file could hold a 9225 verdict the current code would not give; a code-only change cannot move the fingerprint on its own, which is the v48 lesson (2026-09-02).
// v47: no rule TEXT changed - the CACHE and the PRE-GATE are what moved. The two AutoFix buffer rules now admit a line whose first word is filltype/put/getbuff, not only zerotype, so a file that zeroes its buffer by hand is examined at all; and the converter behind them widened twice (a catalogue miss falls back to the author's own member types; the unprefixed "Field x"/"At x" form and the <Type>_SIZE symbol are now recognised). DS 9225 detects a convertible Win32 buffer by RUNNING the converter on a copy, so widening the converter (a catalogue miss now falls back to the author's own member types) changes that rule's ANSWER without changing its definition. The scan cache fingerprints on version + JSON(rules), so an unchanged rules blob means no flush and every previously-scanned file keeps its stale "nothing here" entry (Nils 2026-09-01).
// v46: DS 9226 REMOVED. A one-field Type is not a different KIND of thing to the reader - every legacy Type wants modernising, and the Type/Field/End_Type rules already say so through the report. The Explain row added a second row asserting it was special, whose only affordance was Ignore, which is the shape this board keeps retiring (Nils 2026-09-01). 9226 is free again.
                                         // v45: DS 9226 (removed at v46), and the MATCHER change that stays: _AccessorTypeBuffer strips a package qualifier ("Dates$SystemTime.iHour"), so clusters graded against an impossible Type name are graded against the real one.
                                         // v44: a MATCHER change, not a rule change - DS 9225 asks the converter, and the converter now refuses a Type whose nested member has no shipped tWin twin (it used to emit "POINT pt", which nothing declares). Fewer lines convert, so fewer rows fire, and a cache keyed on v43 would keep offering the ones that no longer do.
                                         // v43: DS 9225 - the legacy Win32 Type buffer ChangeExternalFunctionCallers can convert. That converter shipped 2026-08-30 with NO rule offering it, so a workspace whose buffers it converts perfectly saw only "run the report". The rule runs the converter on a copy of the file and reports the lines it removed, so a row cannot promise a Run that comes back "0 lines".
                                         // v42: the withdrawn Tier-3 pair (DS 9225/9226) removed again; never released.
                                         // v40/v41: DS 9225 (then 9225/9226) - the Tier-3 pair. Never released.
                                         // v39: DS 9224 - the legacy Type byte-buffer that DataFlex has replaced with a shipped tWin<X> Struct, routed to ChangeLegacyTypeToWinStruct. Fires only where the converter's own _WinStructClusterWhyNot says it would act, so the row cannot offer a Run the run refuses.
                                         // v36: the Replace-command rule (DS 9041 stops claiming its 'in'), and the API rules go hands-off inside conditional variant arms.
                                         // v25: one APPENDED rule - Crystal Reports, Explain-only (support dropped; the reports move to another product, so no refactor can carry them) - plus the new eDSUseContains kind it matches on
                                         // v15: #REPLACE rule narrowed to CONSTANT uses (keyword substitutions are macros)
                                         // v2: + "Use without file extension" (4535, Nils's paytype.DD miss)
                                         // v3: + the eight obsolete-class rules (4537 family source-side)
                                         // v4: class rules split Object-form (convertible) vs Class-form
                                         // v5: Sysdate + Sysdate4 both route to ChangeSysdate (-> CurrentDateTime()); Sysdate promoted Explain->AutoFix
                                         // v6: 9 dev-only/char-mode relics route to CommentOutObsoleteDevCommands (Explain->Suggest)
                                         // v7: 9 Database-API commands route to LegacyDbApiReport worksheet (Explain->Suggest)
                                         // v8: 16 Registry/profile/INI commands route to LegacyRegistryReport worksheet (Explain->Suggest)
                                         // v9: 25 Embedded SQL commands route to LegacySqlReport worksheet (Explain->Suggest)
                                         // v10: Chain->ChangeChainToRunprogram (AutoFix), DF_SYSDATE_4_STATE->CommentOutSysdate4State (AutoFix)
                                         // v11: Set_dfpath->LegacyDfPathReport worksheet (Explain->Suggest)
                                         // v12: Call->ChangeCallToSend (AutoFix); 11 field entry-options->LegacyFieldOptionsReport (Explain->Suggest)
                                         // v13: 4 DB-file constants/vars (Fieldindex/Filenumber/DF_FILE_PRIMARY_INDEX_TRIGGER/DF_FILE_TRANSLATE_OEM_TO_ANSI) folded into LegacyDbApiReport (Explain->Suggest)
                                         //     subclass definitions (Explain - converters refuse those)
                                         // v14: Get_File_Exists (Get-call form) -> ChangeGetFileExistsToFileExist (AutoFix)

// The rules-file payload: a seed-version stamp + the rows.
// One packed catalogue as persisted: the rows exactly as the seed packs them, plus the seed
// version that wrote them. Rows stay PACKED strings rather than a typed struct per catalogue -
// three catalogues share one loader that way, and the packing is already the in-memory shape.
Struct tWinAPICatalogFile
    Integer iVersion
    String[] asRows
End_Struct

Struct tDeepScanRulesFile
    Integer iVersion
    tDeepScanRule[] aRules
End_Struct

// Deep Scan per-file result cache (Nils 2026-07-16): the scan -> Run Fix Plan -> re-scan
// convergence loop used to re-read + re-scan EVERY file each pass, though between passes
// only the files the plan run (or a Studio edit) actually wrote can produce different
// hits - ScanLines is a pure per-file function of (file contents, rules). One entry per
// scanned file; an entry stays valid while the file's last-write time AND size are
// unchanged (nothing rewinds a live source's mtime - the only rfSetFileLastWriteTime
// caller touches BACKUP copies) under the SAME rules fingerprint. Owned by the dashboard
// view (DashboardFT.vw pDeepScanCache) and threaded ByRef through
// cDeepScanner.ValidateScanCache / ScanFileCached.
//
// PERSISTED since 2026-07-28 (Nils: "even if no changes was made to the source, it still
// runs a full scan each time" - the cache was session-lifetime, so every program start paid
// a cold scan of the whole workspace). See tDeepScanCacheFile below. NOTE the key is
// deliberately last-write + size, NOT a content hash: a hash would have to READ every file,
// which is the very cost the cache exists to avoid, while mtime + size come from the
// directory entry alone.
Struct tDeepScanFileCacheEntry
    String   sFileLow           // Lower-cased full path - the cache key.
    DateTime dtLastWrite        // rfFileDate at scan time.
    Integer  iFileSize          // rfFileSizeLive at scan time (belt for a same-ms rewrite).
    tDeepScanHit[] aHits        // The ScanLines result for that (file, rules) state.
End_Struct

// The whole cache: rules fingerprint + parallel path/entry arrays. asPathsLow mirrors
// aEntries[].sFileLow so the per-file lookup is ONE native SearchArray call over a plain
// String[], not an interpreted comparator loop over the struct array.
Struct tDeepScanCache
    String   sRulesFingerprint  // JSON of the rules array the entries were scanned under.
    String[] asPathsLow         // Parallel to aEntries.
    tDeepScanFileCacheEntry[] aEntries
End_Struct

/* The on-disk form, per workspace: Data\DeepScanCache-<wskey>.json, keyed by the same folded
   .sws path as LastPlan / ModProgress / Ignored (AnalyzeSnapshotKey). asPathsLow is NOT stored -
   it is a lookup index derived from aEntries on load, so persisting it would double the paths
   for nothing.

   THREE things invalidate it, and all three are cheap: a version mismatch (struct changed),
   a rules-fingerprint mismatch (ValidateScanCache already clears on this), and per file the
   existing last-write + size test. A file the cache has never seen simply scans normally.

   SIZE, measured on the WinServ workspace 2026-07-28 before building this: ~1,686 files and
   1,764 deep-scan hits, so roughly 270 KB of clean-file entries plus ~390 KB of hits - about
   0.7 MB, against a LastPlan for the same workspace already at 2.3 MB. Parsing that is far
   cheaper than re-reading and re-lexing 1,686 files.

   PRIVACY: the filename folds the .sws path, so it names the workspace - and those are customer
   workspaces. Gitignored with LastPlan* / ModProgress* / Ignored*. Never commit one. */
Struct tDeepScanCacheFile
    Integer  iVersion
    String   sRulesFingerprint
    /* THE SCOPE THIS CACHE WAS PRODUCED FROM - every folder handed to the scan, and the ones
       that yielded no source file. A cache records WHAT it holds; without the scope it cannot
       say what it does NOT hold, and a ticked folder contributing zero files was invisible
       until it was found by diffing this file against the compile scope by hand
       (Nils 2026-08-31, E:\WebAppSrc\AppSrc: 152 packages, 0 scanned). */
    String[] asScopeFolders
    String[] asEmptyFolders
    tDeepScanFileCacheEntry[] aEntries
End_Struct

// Bump when tDeepScanFileCacheEntry / tDeepScanHit / tDeepScanCacheFile change shape - a stale
// file is then dropped rather than misread into the wrong fields.
#IFNDEF CI_DeepScanCacheVersion
Define CI_DeepScanCacheVersion for 2   // v2: asScopeFolders / asEmptyFolders - the cache now records the scope it came from
Define CS_DeepScanCacheJson    for "DeepScanCache.json"
#ENDIF

/* The hint the analyzer gives a warning whose construct is NOT on the reported line - it sits inside
   a macro / #COMMAND expansion, and the compiler reports every USE of that macro. Shared so the
   findings board can recognise the family without matching prose (Nils 2026-07-28).

   WHY THEY ARE STATED ONCE AND NOT LISTED: "I actually think it is fine with legacy code there and
   we should just ignore them altogether. There are macro commands in the system PKG folder as well
   ... If somebody really wants to fix code in a macro command, they need to be super knowledgable
   about macro code, something most developers are not." On WinServ this family was 579 rows across
   542 files - every one of them pointing at a use site where nothing can be done, for a fix that
   lives in one definition and that almost nobody should attempt. */
#IFNDEF CS_ModMacroExpansionHint
Define CS_ModMacroExpansionHint for "Not fixable on this line - the obsolete construct is inside a macro/command. Fix it at the definition."
// The general advice for compile error 52 "(operator)" - the seed's own words until 2026-09-05, now
// what VerifyAutoFix says for a 52 that is not the wrapped-command shape SplitCommandOutOfCondition repairs.
Define CS_ModExpr52Hint for "Malformed expression the compiler cannot parse (operator) - often a stray operator or a '()' on a Get form ('Get Func() to var' should be 'Get Func to var'). Fix in source; not an automated refactor."
// The generic 4328 advice - the seed's own words, and since 2026-09-14 also what VerifyAutoFix says for a
// type-name-cast row whose line carries no such call (Guard F): a plain undefined symbol reads as one.
Define CS_Mod4328Hint for "Undefined symbol - a missing DB field/table, a legacy Type member accessed as a Struct (Type->Struct migration, e.g. tRect.left), a source typo, or a TYPE NAME used as a conversion function, which DF26 refuses: Handle(x), Pointer(x), Boolean(x), DateTime(x) and UChar(x) all become Cast(x, Type) - and there the message names the type's INTERNAL name (LONGPTR for Handle, ADDRESS for Pointer), so the symbol it complains about may appear nowhere in the source. Check the flagged LINE before hunting for a missing field."

#ENDIF

/* How many of those findings the board will open a file for, to read what actually caused them.
   A RUNAWAY GUARD, not a display limit - and it must stay far above any real workspace, because
   what it skips cannot be attributed and therefore cannot be silenced as DataFlex's own. It was
   200, which is below a single real case: Nils's WinServ raises 533, so 333 went unexamined and
   were then described as findings whose "cause could not be read off the line" - a statement
   nobody had checked. Whatever this bound skips is now counted and stated as unexamined instead.
   2026-08-19. */
#IFNDEF CI_ModCauseReadCap
Define CI_ModCauseReadCap for 20000
#ENDIF

// RELEASE GATE (Nils 2026-07-10): Deep Scan ships in ALPHA 4. This constant is the runtime MASTER SWITCH -
// every DS touchpoint (dashboard chip + gear, the chip belt, the Test Compile bar, the control's pbVisible,
// and the DS recipe seeding in cModAnalyzer) keys off it. Currently TRUE (Deep Scan visible for dev toward
// Alpha 4); it was flipped OFF for the Alpha 3 packaging on 2026-07-12 and flipped back ON afterwards.
// *** TO FREEZE Deep Scan OFF for a release build - TWO items (flip both back after packaging): ***
//   (1) this constant -> False (hides the chip/scan/recipe seeding; the code stays COMPILED in, just hidden);
//   (2) bump CI_ModAnalyzerRecipeVersion (cModAnalyzer.pkg) so every already-seeded recipe table reseeds
//       and the DS recipes (which ride BuildDefaultRecipes behind this gate) drop out.
// Do NOT re-publish DeepScanObsoleteSymbols: it stays { Published = False } PERMANENTLY by design -
// Deep Scan is a DEDICATED flow (dashboard button -> RunDeepScan -> cDeepScanner directly), NOT a
// manual-picker refactor function; a report-only entry in the function list just duplicates the button
// and confuses the user (Nils 2026-07-12). It carries no {ModRecipe}, so unpublishing has no effect
// on the recipe table.
Define CB_DeepScanEnabled for True

// The Test Compile bar's Analyze Source and Run Plan buttons, and its tail's pointer "run the fix plan from the
// guided dashboard" (TestCompileFT.dg). False since 2026-10-12 (Nils: "I don't think that we ever use the
// buttons ... we might want to use them later, but for now how about make them invisible?", then "Always hide
// the controls"). Nothing is removed: True brings the three back, and the tail back to the end of the strip.
// While it is False, an Analyze Source run outside a guided Check has no button on that bar to run its plan -
// so the Manual board's pill "Analyze this file for a fix plan" follows this switch too (cFTManualBoard.pkg).
Define CB_TestCompilePlanButtons for False

// Filename for the editable recipe JSON. Lives in DFRefactor's OWN Data folder - it's data,
// and global to DFRefactor (not per-target-workspace).  
// It is used as a base name for the file. In function RecipeJsonPath (cModAnalyzer.pkg),
// the TARGET DataFlex version is added after "ModAnalyzerRecipes", so that each DataFlex get
// its own unique json file.
Define CS_ModAnalyzerRecipesJson for "ModAnalyzerRecipes.json"

// Power script file automatically generated to the Programs folder when the
// ComdLineIniFileExporterFT dialog is used to export .ini data.
Define CS_Run_DFRefactor_ps1     for "Run-DFRefactor.ps1"

// Base name for the TypeToStructReport install-package Type catalogue cache (the target DF version
// is appended -> Data\DfVersion-TypeDefs-<ver>.json). CI_TypeDefsCacheVersion is the cache FORMAT version:
// bump it to invalidate every cached catalogue at once (e.g. if _TypeDefsFromLines changes).
// v2 added sPkgNewest (the install-package change watermark).
Define CS_TypeDefsCacheJson      for "DfVersion-TypeDefs.json"
Define CI_TypeDefsCacheVersion   for 2

// Base name for the install-package GLOBAL-FUNCTION-NAME catalogue cache (target DF version appended
// -> Data\DfVersion-GlobalFuncs-<ver>.json), the third product of the SHARED install-Pkg walk. It is the
// set of Global Function/Procedure names the target DataFlex SHIPS, so the guided findings list can flag a
// user "backport" global function whose name is now native (error 4390). Bump the FORMAT version to
// reseed if _GlobalFuncNamesFromLines changes. Same sPkgNewest watermark scheme as the Type cache.
// 2 = a global Set procedure goes by its two-word name, "Set <name>" (2026-11-02).
Define CS_GlobalFuncNamesCacheJson    for "DfVersion-GlobalFuncs.json"
Define CI_GlobalFuncNamesCacheVersion for 2

/* The compiler's own built-in globals, per target version: Data\DfVersion-BuiltIns-<ver>.json, read from
   <install>\Lib\GlobalFunctions.lst.

   PER VERSION even though the file has not changed in years - it is byte-identical from 20.1 to 25.0
   (measured 2026-08-01), so today every one of these files would hold the same 85 entries. Keyed by
   version anyway for two reasons: it costs nothing, matching what DfVersion-GlobalFuncs-<ver>.json already
   does; and DF 27 is the release where that stops being true. A runtime moving to a browser engine
   and to Mac/Linux is exactly the kind of shift that adds and retires built-ins, and a per-version
   file records that WITHOUT a code change - the wrong moment to discover a single shared catalogue
   is the moment two supported versions disagree.

   Bump CI_BuiltInFuncsCacheVersion when this STRUCT changes (a new field, a different parse), not
   when DataFlex ships - a new DataFlex version writes its own file. */
Define CS_BuiltInFuncsCacheJson       for "DfVersion-BuiltIns.json"
Define CI_BuiltInFuncsCacheVersion    for 1

// The install file the above is built from - always <install root>\Lib\<this>.
Define CS_InstallGlobalFunctionsLst   for "GlobalFunctions.lst"

/* The target version's NAMED ERROR NUMBERS: Data\DfVersion-ErrorNames-<ver>.json, read from
   <install>\Pkg\errornum.inc (2026-10-23, for the Deep Scan rules DS 9244 / 9245 and
   ChangeErrorNumberToName). Bump CI_ErrorNamesCacheVersion when tErrorNamesCacheFile or the parse
   changes - a new DataFlex version writes its own file. */
Define CS_ErrorNamesCacheJson         for "DfVersion-ErrorNames.json"
Define CI_ErrorNamesCacheVersion      for 1
Define CS_InstallErrorNumInc          for "errornum.inc"

// The Studio's own language definition, and the per-target-version catalogue built from it.
Define CS_InstallLanguageFile         for "DataFlex.lng"
Define CS_DfLanguageCacheJson         for "DfVersion-Language.json"
Define CI_DfLanguageCacheVersion      for 1

// Base name for the RAW install-package obsolete-warning scan cache (the target DF version is
// appended -> Data\DfVersion-ObsoleteScan-<ver>.json). This is the product of the SHARED install-Pkg walk
// (cRefactorFuncLib: WalkInstallPackages / InstallScanRecipes) that feeds BOTH the ModAnalyzer recipe
// scan and the TypeToStructReport Type catalogue in ONE pass. cModAnalyzer reads it back and merges
// it with its built-in defaults into the editable ModAnalyzerRecipes-<ver>.json. Split out from the
// recipe JSON so a recipe (defaults / meta-tag) version bump re-merges WITHOUT re-walking the
// packages. CI_ObsoleteScanVersion is the scan FORMAT version - bump it if _ObsoleteRecipesFromLines
// changes. v2 added sPkgNewest (the install-package change watermark). Reuses the tModRecipeFile
// wrapper struct (below).
Define CS_ObsoleteScanJson       for "DfVersion-ObsoleteScan.json"
Define CI_ObsoleteScanVersion    for 2

// The recipe set as it lives in that JSON: a version stamp + the rows. cModAnalyzer treats the
// JSON as the canonical source (falling back to BuildDefaultRecipes if absent); the higher of
// the JSON version / built-in CI_ModAnalyzerRecipeVersion wins and reseeds the ModAnalyzer table.
// Also wraps the raw DfVersion-ObsoleteScan-<ver>.json, where sPkgNewest stamps the newest install *.pkg
// write time at scan time (the change watermark; see _PkgTimeStamp). The editable recipe JSON
// leaves sPkgNewest blank - it is consulted only for the raw install-scan cache.
Struct tModRecipeFile
    Integer iVersion
    String sPkgNewest       // ObsoleteScan cache only: newest install *.pkg write time, "YYYYMMDDHHMMSS"; "" = unknown / not an install scan.
    tModAnalyzer[] aRecipes
End_Struct

// The actionable plan the Modernization Analyzer hands to the engine: the distinct
// refactor function NAMES to select + run, and the distinct workspace-source files to
// process. System/library files (e.g. the DataFlex install packages flagged by 4536)
// are filtered out during aggregation - never refactor files outside the workspace.
Struct tModRefactorPlan
    String[] asFunctions
    String[] asFunctionHints   // parallel to asFunctions: each function's hint (preview tooltip)
    String[] asFiles
End_Struct

// Per-workspace snapshot of the LAST Modernize/analyze run, cached in the per-EXE registry
// (cRefactorApplication WriteAnalyzeSnapshot / ReadAnalyzeSnapshot, keyed by the .sws path) so the FT
// dashboard's Last-analyze tile can show the prior counts when a workspace is re-opened in a later run.
// sDate (ISO yyyy-mm-dd) labels them "last run <date>" - the staleness cue. bFound = a snapshot existed.
Struct tAnalyzeSnapshot
    Integer iWarn       // compiler warning messages
    Integer iErr        // compiler error messages
    Integer iAuto       // auto-fixable rows
    Integer iSuggest    // rows to review
    String  sDate       // ISO yyyy-mm-dd the snapshot was taken
    String  sProgram    // the program (.src) these counts are for (the LAST analyzed in this workspace)
    Boolean bFound      // True = a stored snapshot was read back
End_Struct

// Workspace-wide roll-up across the per-program analyze snapshots (the FT dashboard's "N of M analyzed"
// line). iTotal = all programs in the .sws [Projects]; iAnalyzed = those with a stored snapshot; iWarnTotal
// = the sum of their warning counts. See cRefactorApplication.AnalyzeRollup.
Struct tAnalyzeRollup
    Integer iAnalyzed
    Integer iTotal
    Integer iWarnTotal
End_Struct

// ---- Modernization progress history (per-workspace burn-down) ----------------------------------
// A TIME SERIES of analyze snapshots (unlike tAnalyzeSnapshot's latest-only registry slot and the
// latest-only saved plan): one entry appended per analyze so the user can watch errors + warnings fall
// across Compile->Analyze->Run cycles. Appended by cRefactorApplication.AppendModProgressEntry - de-duped
// vs the last entry, so a re-analyze with unchanged counts adds no flat row. Persisted per-workspace as
// Data\ModProgress-<wskey>.json (ModProgressJsonPath, mirroring SavedPlanJsonPath). Reset clears the file.
// Bump CI_ModProgressVersion if tModProgressEntry / tModProgressFile change (a stale file is then dropped).
// DEEP SCAN rides the SAME history (Nils 2026-07-16): a scan lap appends under the reserved series
// label below (sProgram = "Deep Scan" - never a real .src name, so no collision). Same-label rows
// form their own burn-down series: the Progress tile's delta/cycle logic and the History modal's
// trend already match rows BY sProgram, so the scan -> Run Fix Plan -> re-scan loop burns down
// exactly like a compile cycle with no struct or version change. For a scan row iWarn = the finding
// count (scan rows tally as warnings everywhere in the analyzer UI) and iErr = 0.
Define CS_ModProgressJson    for "ModProgress.json"
Define CI_ModProgressVersion for 1
/* THE STORED KEY. Its VALUE IS ON DISK - it is the sProgram written into every scan lap in
   Data\ModProgress-<wskey>.json, and both the tile's delta/cycle logic and the History modal's
   trend match rows BY sProgram. Rename the literal and every workspace's recorded scan history
   splits into a "before" series and an "after" series that never join up again. So it stays
   "Deep Scan" for good, whatever the UI happens to call the feature this year - which is exactly
   why the DISPLAY text is a separate constant below (renamed to "Analyze Source" 2026-08-10). */
Define CS_ModProgressDeepScanLabel for "Deep Scan"
// What the user SEES for that series - the tile, the History modal's trend line, its Program
// column and the text export. Free to change; never compared against, never written to disk.
Define CS_ModProgressScanSeriesText for "Analyze Source"

Struct tModProgressEntry
    String  sDate        // ISO date + time the analyze ran
    String  sProgram     // the program (.src) these counts are for - or CS_ModProgressDeepScanLabel
    String  sDfVersion   // target DataFlex version at the time
    /* The PLATFORM the measured build targeted - "x64" / "x86", and "" for a Deep Scan row
       (a source scan is not platform-specific) and for every entry written before this field
       existed. Deliberately NOT guarded by a CI_ModProgressVersion bump: the reader discards
       the whole history on a version mismatch, and pbRequireAllMembers is False, so an older
       file simply parses with this empty and keeps its entries. 2026-08-20. */
    String  sPlatform
    /* TWO NUMBERS, SPLIT 2026-09-15 (Nils, after an Analyze Source over a workspace he had just
       compiled clean: "the stats for 'Warn' shows 796, which is simply not true ... 796 scan
       findings, but that is not the same as warnings"). One field used to carry both, so a scan
       lap's findings were reported as warnings, and a compile lap that had pending findings merged
       into it counted those as warnings too. The burn-down MAGNITUDE is the sum of the two, which
       is exactly what the single field held, so no existing trend or sparkline moves.

       Deliberately NOT guarded by a CI_ModProgressVersion bump, for the reason sPlatform gives
       above: pbRequireAllMembers is False, so an older file parses with iScan 0 and keeps every
       entry. ReadModProgress then back-fills what is recoverable - see ModProgressCounts.pkg,
       which owns that rule and the naming rule with it. */
    Integer iWarn        // compiler warning messages (a Deep Scan row: 0 - the compiler said nothing)
    Integer iScan        // source-scan findings, which the compiler never reports
    Integer iErr         // compiler error messages (a Deep Scan row: 0)
    Integer iAuto        // analyzer auto-fixable rows
    Integer iSuggest     // analyzer rows to review
End_Struct

/* THE COMPILED-SCOPE CACHE, ON DISK (2026-08-20). Opening WinServ cost 14.1s, of which 11.2s was
   rebuilding two things that only change when the program is recompiled: the scope file list
   (parsed out of a 71 MB .prn, 3.7s) and the class/macro definition index (1035 files read into
   733,386 String[] elements, 7.5s). Both were cached in properties, which die with the process -
   so every session paid it again, and the log showed the misses as "had=[]", an EMPTY property
   rather than a changed key. Keyed by the .prn's identity (path|size|write time), so a recompile
   invalidates it and nothing else does. */
Struct tScopeIndexFile
    Integer  iVersion
    String   sStamp        // "<prn path>|<size>|<write time>" this was built from
    String[] asScopeFiles  // the compiled set, from the .prn's Including-file lines
    String[] asIdxKey      // "c|<name>" / "m|<name>", lowercased
    String[] asIdxParent   // the class's parent, lowercased ("" for a macro)
    String[] asIdxSite     // "<file>|<line>"
End_Struct
#IFNDEF CI_ScopeIndexVersion
Define CI_ScopeIndexVersion for 1
Define CS_ScopeIndexJson    for "ScopeIndex.json"
#ENDIF

// The history file payload: a version stamp + the ordered entries (oldest first).
Struct tModProgressFile
    Integer iVersion
    tModProgressEntry[] aEntries
End_Struct

// ---- Saved "last refactoring plan" -------------------------------------------------------------
// The full Modernization-Analyzer triage from the LAST analyze, frozen so it can be VIEWED again
// later (the Modernize tile's "View last plan" link re-loads it into the read-only analyzer grid).
// Unlike the recipe / typedef caches (keyed by TARGET DF version, in DFRefactor's Data folder), this
// is per-WORKSPACE like the analyze snapshot - SavedPlanJsonPath (cModAnalyzer) keys the filename by
// the AnalyzeSnapshotKey fold of the .sws. Latest-only: each analyze overwrites it. Carries the same
// headline stats as tAnalyzeSnapshot so the file is a COMPLETE record (the registry snapshot stays as
// the dashboard's fast-read cue; both are written together from the same numbers so they can't drift).
// Bump CI_SavedPlanVersion if tSavedPlanRow / tSavedPlan change, so a stale file is detected + dropped.
Define CS_SavedPlanJson    for "LastPlan.json"
Define CI_SavedPlanVersion for 3   // v3: + tSavedPlan.aFloods (a collapsed scan rule's FILE LIST rides with the plan, 2026-08-16). v2: + tSavedPlan.bDeepScan (Deep Scan now writes the shared LastPlan too)

// One frozen analyzer row. Named fields (NOT the grid's column-id-indexed sValue[]) so the JSON is
// decoupled from the grid layout; the viewer maps these back onto its columns on load. iLine is the
// numeric first-occurrence line (jump-to-source); sLineDisplay is the "10  (x3)" string as shown.
Struct tSavedPlanRow
    Integer eCategory       // eMod* numeric - drives the informational hide + the row icon
    String  sCategory       // category display label ("Auto-fix" / "Review" / ...)
    String  sMsg            // message token(s): "W 4538" or "W 4538, E 4501"
    String  sFile
    Integer iLine           // numeric first-occurrence source line
    String  sLineDisplay    // line as shown, may carry the "(xN)" occurrence suffix
    String  sHint           // suggested-fix guidance
    String  sFn             // refactor function name(s), "" for explain / manual
End_Struct

/* A COLLAPSED scan rule, for the PLAN (2026-08-16). A rule that fires >= CI_DSFloodThreshold times
   in a Check is shown as ONE summary row (ModAnalyzerFT paiDSFlood*), and the plan is built FROM
   THE ROWS - so on the first live run the row's single sFile was all the plan got, and a rule with
   22,000 findings advanced by ONE FILE per Check (Nils, WinServ: "never shows more than 12 at a
   time ... the Refactoring plan should apply them to *all* files involved"). The row stays one row;
   THIS carries the files it stands for. Persisted with the plan so a restored plan reaches as far
   as a live one; ExpandFloodFilesIntoPlan (cModAnalyzer) folds it into tModRefactorPlan.asFiles.
   sFirstFile is the row's own file - the ignore key the row is dismissed under. */
Struct tSavedPlanFlood
    Integer  iDSNumber       // the rule's DS pseudo message number (9001+)
    String   sSymbol         // the rule's symbol, e.g. "EQ comparison"
    String   sFn             // the converter the summary row names ("" = nothing to run)
    String   sFirstFile      // the summary row's sFile (ignore key = sFirstFile + "DS <n>")
    String[] asFiles         // EVERY distinct file the rule fired in
End_Struct

/* One FLOODING scan rule as tallied over a run's messages (cModAnalyzer.TallyScanFloods, 2026-08-16):
   how often it fired, in how many distinct files, the first finding (the summary row's file/line),
   the rule's symbol, and EVERY distinct file - in first-seen order. Not persisted (tSavedPlanFlood
   is the plan-side shape); the analyzer grid maps this onto its paiDSFlood* properties. */
Struct tDSFloodTally
    Integer  iDSNumber      // the flood KEY: the DS number, NEGATED for the hits whose own verdict dropped the
                            // rule's converter (cModAnalyzer.DSFloodKey, 2026-10-03)
    Integer  iCount
    Integer  iFiles
    String   sFirstFile
    Integer  iFirstLine
    String   sSymbol
    String   sFirstHint     // the FIRST finding's own hint (its scan verdict) - what a negative flood's row says
    String[] asFiles
End_Struct

// The saved-plan file payload: a version stamp, the run context, the headline stats, and the rows.
Struct tSavedPlan
    Integer iVersion
    String  sDate           // ISO yyyy-mm-dd the analyze ran (mirrors tAnalyzeSnapshot.sDate)
    String  sWorkspace      // the .sws this plan was built for
    String  sDfVersion      // target DataFlex version at build time
    String  sSourcePrn      // the .prn / .err it was parsed from ("" for a Deep Scan - see bDeepScan)
    String  sSourcePrnStamp // PROVENANCE (2026-08-17): sSourcePrn's last-write time + size when the plan was
                            // written (cModAnalyzer.SourcePrnStamp). ReadSavedPlan refuses a compile plan whose
                            // .prn is gone, unstamped, or stamped differently - a recreated workspace at the SAME
                            // path inherits the old copy's LastPlan (the key is the path), and a copied .prn made
                            // the old Check read as this copy's. "" for a Deep Scan.
    Boolean bDeepScan       // True = a DEEP SCAN wrote this plan (not a compile+analyze). Same LastPlan file
                            // serves both, latest writer wins; provenance labels the dashboard foot + drives
                            // the ghiLastPlan* restore (compile stats stay on the registry snapshot).
    Integer iWarn           // headline stats (same four as tAnalyzeSnapshot; for a Deep Scan iWarn = finding count, iErr = 0)
    Integer iErr
    Integer iAuto
    Integer iSuggest
    tSavedPlanRow[] aRows
    tSavedPlanFlood[] aFloods   // v3: the collapsed scan rules' file lists (see tSavedPlanFlood)
End_Struct

// ---- Analyzer "ignore" list ------------------------------------------------------------------
// Rows the user dismissed with Ignore. A report-only recipe (e.g. TypeToStructReport for W 4532)
// makes NO source change, so its warning - and its grid row - return on every analyze pass; this
// lets the user retire one for good. Keyed by (file + message token) - exactly one grid row, so
// ignoring it suppresses all its occurrences (the "(xN)") and survives line shifts. Persisted
// per-workspace (cModAnalyzer IgnoredJsonPath -> Data\Ignored-<wskey>.json, mirroring the saved plan).
Define CS_IgnoredJson    for "Ignored.json"
Define CI_IgnoredVersion for 1

Struct tModIgnore
    String sFile        // full source path as the grid shows it
    String sMsg         // message token as shown, e.g. "W 4532"
End_Struct

// The ignore-list file payload: a version stamp + the rows.
Struct tModIgnoreFile
    Integer iVersion
    tModIgnore[] aRows
End_Struct

/* ONE WORKSPACE COPY STANDING IN FRONT OF A SHIPPED FILE - the rows behind the board's overriding-copies
   line, the report's PART 3 and the Rename dialog (cShadowedPackageFiles, RetireShadowsFT.dg). TWO kinds.
   From 2026-09-15 to 2026-10-05 the second was eShadowPool, EVERY copy of a file one of the workspace's own
   packages or libraries ships; Nils took it out again: "It is actually perfectly OK with duplicate
   filenames, as long as they are not a DataFlex system package." Since 2026-11-12 the second is much
   narrower (cShadowedPackageFiles.FailingPackageCopies): a copy THIS build compiled in place of the file of
   a package that has errors in the same build. A workspace's leftover LANGUAGE.PKG did that to VDFQuery20 -
   76 errors in the package's files, and nothing on the board pointed at the copy. */
Enum_List
    Define eShadowInstall for 0   // the file ships with DataFlex itself (the install's Pkg folder)
    Define eShadowFailingPackage  // a package checkout ships it, and that package has errors in this build
End_Enum_List

Struct tShadowCopy
    String  sLeaf      // the file name as the disk spells it
    String  sPath      // the workspace's own copy - the one a rename moves aside
    String  sShipped   // the file it stands in front of: the install's, or the package's
    String  sSource    // where sShipped lives, for a sentence: "DataFlex", or the package's name
    Integer eKind      // eShadowInstall or eShadowFailingPackage
    Integer iClass     // 0 = this build compiled sPath in place of sShipped; 1 = the build did not read sPath
    Boolean bSame      // sPath and sShipped hold the same bytes - the one case a rename loses nothing
    Boolean bAlways    // a NAMED file that must always be suggested for rename even though it DIFFERS
                       // (IsAlwaysRetireFile) - it starves the shipped file rather than forking it
    Boolean bTicked    // the dialog's answer: rename this one (starts as bSame or bAlways)
    Boolean bKept      // the user's recorded decision: keep this one - off the line, listed by the kept chip
    Integer iPackageErrors // eShadowFailingPackage: the errors this build reported in that package's files
    Boolean bAddsNothingUsed // DIFFERENT, but nothing in the workspace uses a name it adds - ticked like an
                             // identical copy (cShadowedPackageFiles.MarkCopiesThatAddNothingUsed, 2026-11-12)
End_Struct

/* THE COPIES THE USER DECIDED TO KEEP, so the line stops offering them.

   Nils 2026-09-15, after the per-file dialog: "one conundrum on what to do with files that were NOT
   ticked? I choosed one file to be unticked and that makes the 'Rename them...' button to stick,
   until all files have been renamed." An unticked copy still shadows the shipped file, so the line
   is right to keep naming it - but a copy the user has COMPARED and judged to be their fork needs a
   way to say so that the board respects. This record is that way, and it is EXPLICIT: written only
   by the dialog's "keep the rest" button, never inferred. (The exception list dropped earlier the
   same day was the inference - a copy found live again after a rename - and a Revert produces that
   shape too; nothing but a decision produces this one.) Reversible from the line's "N kept" chip.

   Keyed by full PATH, in DFRefactor's own Data folder as Data\KeptShadows-<wskey>.json - never in
   the target workspace, per the per-workspace-state rule; the .sws path is folded into the name
   like the analyzer's ignore list. */
Define CS_KeptShadowsJson    for "KeptShadows.json"
Define CI_KeptShadowsVersion for 1

/* THE FILES A REFACTORING PLAN RAN ON AND LEFT AS THEY WERE (2026-11-12), per workspace in
   Data\PlanNoOps-<wskey>.json - see cPlanNoOps.pkg. A row holds while its file keeps sStamp. */
Define CS_PlanNoOpsJson    for "PlanNoOps.json"
Define CI_PlanNoOpsVersion for 1
// The package ChangeExternalFunctionCallers writes into the workspace's AppSrc folder for a legacy Type that DataFlex's
// Dftypes.pkg declares and DataFlex ships no Struct for (DEVMODE, DEVNAMES): the Struct, copied member for member, that
// each converted file Uses (cRefactorFuncLib _DfTypesStructNameFor, 2026-11-13).
Define CS_DfTypesStructsPkg for "DfTypesStructs.pkg"

Struct tPlanNoOp
    String   sFile      // the file, lowercased
    String   sStamp     // its last-write time and size when the run left it (PlanNoOpFileStamp)
    String[] asFns      // the functions the plan ran on it, lowercased
End_Struct

Struct tPlanNoOpFile
    Integer     iVersion
    tPlanNoOp[] aRows
End_Struct

/* THE CI SCAN (2026-11-20): DFRefactorFT /scan <ini> runs Analyze Source read-only, writes its findings as JSON
   and SARIF, and compares their fingerprints with a baseline - cCIScan.pkg says how. /baseline accepts today's
   findings. [Scan Section] in the INI may name the three files; each defaults to the INI's own name with
   .findings.json, .findings.sarif or .baseline.json in place of .ini. */
Define CS_CmdLineScan              for "/scan"
Define CS_CmdLineScanBaseline      for "/baseline"
Define CS_CmdIniScanSection        for "Scan Section"
Define CS_CmdIniScanBaselineFile   for "Baseline File"
Define CS_CmdIniScanJsonFile       for "Json File"
Define CS_CmdIniScanSarifFile      for "Sarif File"
Define CI_CIScanVersion            for 1
// The exit codes: no new findings, new findings, the scan could not run.
Define CI_CIScanPass               for 0
Define CI_CIScanNewFindings        for 1
Define CI_CIScanError              for 2

/* THE TECHSTACK READINESS TOPICS (2026-11-20, cRefactorFuncLib._TechStackTopics holds their text). Positions in
   the report's parallel arrays, in report order; CI_TSTopicCount stays last. */
Enum_List
    Define CI_TSOpen for 0
    Define CI_TSRelate
    Define CI_TSServerFile
    Define CI_TSMakeFile
    Define CI_TSFileNumber
    Define CI_TSMainFile
    Define CI_TSValidate
    Define CI_TSFieldValidate
    Define CI_TSEntryItem
    Define CI_TSTableCommand
    Define CI_TSHttpTransfer
    Define CI_TSWindowsUI
    Define CI_TSComActiveX
    Define CI_TSSoap
    Define CI_TSExternalFunction
    Define CI_TSStringToBoolean
    Define CI_TSTopicCount
End_Enum_List

Struct tCIScanFinding
    String  sFingerprint    // cCIScan.Fingerprint: the rule, file, text and occurrence - never the line number
    String  sRule           // "DS9086"
    Integer iDSNumber
    String  sFile           // relative to the workspace's home folder, "/" between folders
    Integer iLine
    String  sSymbol
    String  sCategory       // Auto-fix, Review or Explain
    String  sRefactorFn     // the function that converts it, "" when none does
    String  sHint
    String  sText           // the line as cCIScan.NormalisedLine leaves it
    Integer iOccurrence     // 1, 2 ... among the findings of one rule with the same text in one file
    Boolean bNew            // the baseline does not hold it
End_Struct

Struct tCIScanReport
    Integer iVersion
    String  sWorkspace
    String  sCreated
    String  sBaselineFile
    Boolean bBaselineFound
    Integer iFilesScanned
    Integer iFindings
    Integer iNew
    Integer iGone           // in the baseline, and not found any more
    Integer iExitCode
    tCIScanFinding[] aFindings
End_Struct

Struct tCIScanBaselineRow
    String  sFingerprint
    String  sRule
    String  sFile
    Integer iLine           // where it was when the baseline was written - for a person; the match ignores it
    String  sSymbol
    String  sText
End_Struct

Struct tCIScanBaseline
    Integer iVersion
    String  sCreated
    String  sWorkspace
    tCIScanBaselineRow[] aFindings
End_Struct

/* SARIF 2.1.0, as much of it as the CI scan fills. The member names are SARIF's own keys: DataTypeToJson writes
   them as they are declared here, case and all. */
Struct tSarifText
    String text
End_Struct

Struct tSarifConfig
    String level
End_Struct

Struct tSarifRuleProps
    String category
    String refactorFunction
End_Struct

Struct tSarifRule
    String          id
    String          name
    tSarifText      shortDescription
    tSarifText      fullDescription
    tSarifConfig    defaultConfiguration
    tSarifRuleProps properties
End_Struct

Struct tSarifDriver
    String       name
    String       informationUri
    tSarifRule[] rules
End_Struct

Struct tSarifTool
    tSarifDriver driver
End_Struct

Struct tSarifArtifactLocation
