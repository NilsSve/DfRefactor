// One Function / Property / Register_Function declaration, harvested by FunctionReturnMismatchReport
// (cRefactorFuncLib._NameDeclsFromLines). DataFlex message names are workspace-global - every
// declaration REGISTERS a return type on the shared message id, and when two registrations
// disagree, every expression-style call of that name is ambiguous under DF 25/26's stricter
// expression typing (error 4544; DF 19.1 resolved it silently). sReturnType is "(untyped)" when
// the declaration carries no Returns clause - part of the same ambiguity class.
// _OverloadedState: how a NAME's declarations use the Overloaded token. Mixed is not a
// nuance - it is DataFlex error 4390 "this method was previously defined as non-overloaded",
// a build break in its own right, so it must not be folded in with either of the others.
Define CI_OverloadNone  for 0   // no declaration carries the token - a 4544 is possible
Define CI_OverloadAll   for 1   // every one does - the compiler resolves by parameter count
Define CI_OverloadMixed for 2   // some do, some do not - error 4390, not 4544

Struct tNameDecl
    String  sName        // as written at the declaration
    String  sKind        // "Function" / "Property" / "Register_Function"
    String  sReturnType  // Returns type (Function/Register_Function) or the Property type
    String  sFile        // declaring file (full path)
    Integer iLine        // 1-based line number
    Boolean bGlobal      // Global keyword, Register_Function, or declared at file level (depth 0)
    Boolean bOverloaded  // the Overloaded token. DataFlex overloads on PARAMETER COUNT, so an
                         // overloaded name can hold several return types legally - it cannot 4544.
    String  sCondPath    // the #IF / #ELSE arms enclosing the declaration, outermost first, as
                         // "<block>:<arm>/<block>:<arm>" ("" at file level). Two declarations of one
                         // name in sibling arms of one block are ONE declaration - only one arm ever
                         // compiles (2026-09-20; see _CollapseConditionalArms in cRefactorFuncLib).
End_Struct
// The character-mode inventory (2026-09-20): what a DataFlex 3.x / console-mode program carries
// that DataFlex 26 has no equivalent for, counted by CharacterModeInventoryReport. iFiles = files
// with at least one site.
Struct tCharModeInventory
    Integer iImages       // /name ... /* images (screen layouts; print images in a Windows program)
    Integer iScreenCmds   // screen / keyboard commands at command position (Page, Accept, Entry, Gotoxy ...)
    Integer iUiObjects    // objects of the character-mode UI classes (Entry_Form, Entry_List, Menu, Query ...)
    Integer iKeyprocs     // Keyproc handlers
    Integer iFiles
End_Struct
Define CS_CharModeInventoryLogFile  for "CharacterModeInventory.log.txt"
Define CI_CharModeReportCap         for 40      // sites listed per file before "... and N more"
Define CS_ShadowedPackagesLogFile   for "ShadowedPackageFiles.log.txt"
