Struct tWorkspace
    String sWorkspace
    String sWorkspaceFull
End_Struct

// Resolved (absolute) paths and runtime state for a DataFlex workspace.
// Used by cRefactorApplication to snapshot both:
//   pOrgWS    - DFRefactor's OWN workspace, captured once in
//               End_Construct_Object. Used by RestoreActiveFilelist /
//               UpdateDFOpenPath to put things back the way they were.
//   pTargetWS - the USER-SELECTED target workspace, refreshed by
//               UpdateDFOpenPath on every Set psSWSFile. All members are ""
//               when no target is selected (use that as the "no target"
//               sentinel).
//
// Mirrors the cWorkspace built-in path properties (psHome / psAppSrcPath /
// ...) but is a snapshot, so it remains stable even if a refactoring
// function temporarily repoints phoWorkspace.
//
// SINGLE PATH per field, by design. The DF 26+ .sws JSON spec lets AppSrc,
// AppHtml, Data, DdSrc, Bitmap, Programs and Help each be a list, and
// tSwsPaths preserves that (String[] members). tWorkspacePaths intentionally
// flattens each to the FIRST entry because every current consumer needs a
// single canonical directory:
//   - cExportImportFunctions, cFileNameForm: vFolderFormat(OrgWS.sAppSrc)
//     to build "<AppSrc>\<file>.json" — one folder, not a list.
//   - cRefactorApplication.ApplyTargetFilelist: Set psDataPath / psFileList
//     of phoWorkspace — those properties are scalars themselves.
// The multi-path semantic that does matter (Get_File_Path resolution across
// every AppSrc / DdSrc / AppHtml plus library deps) is handled separately by
// GetTargetWorkspaceSourcePaths -> DF_OPEN_PATH; that path never collapses.
// If a future caller genuinely needs the full list for some non-DF_OPEN_PATH
// reason, expose a String[] helper (e.g. TargetWorkspaceAppSrcPaths) rather
// than duplicating arrays into this snapshot.
//
// IMPORTANT: callers must READ from these struct fields but never write
// them directly. To change the target workspace, call Set psSWSFile on
// the application - that orchestrates the side effects (DF_OPEN_PATH,
// pasSelectedFolders cache, struct refresh).
//
// Use pTargetWS in code that should operate explicitly on the
// user-selected target workspace. Do NOT use it where "currently active
// workspace" is the right semantic (e.g. cCompileMixin's host - it now
// takes a tWorkspacePaths argument instead).
Struct tWorkspacePaths
    String sSWSFile      // Full path to the .sws file in the workspace Home folder
    String sWSFile       // Full path to the .ws config file in Programs\ (legacy
                         // folder-paths configuration). Equal to psWorkspaceWSFile
                         // of phoWorkspace at startup.
    String sHome         // psHome         (workspace home, e.g. "C:\Proj\")
    String sAppSrc       // psAppSrcPath   (first entry where the .sws permits multiple)
    String sAppHtml      // psAppHtmlPath  (first entry where the .sws permits multiple)
    String sBitmaps      // psBitmapPath   (first entry where the .sws permits multiple)
    String sData         // psDataPath     (first entry where the .sws permits multiple)
    String sDDSrc        // psDdSrcPath    (first entry where the .sws permits multiple)
    String sFileList     // psFileList     (full path incl. filelist.cfg name)
    String sFilelistName // DF_FILELIST_NAME attribute value (usually == sFileList)
    String sHelp         // psHelpPath     (first entry where the .sws permits multiple)
    String sPrograms     // psProgramPath  (first entry where the .sws permits multiple)
    String sOpenPath     // DF_OPEN_PATH value at capture time (composite for target;
                         // carries every AppSrc/DdSrc/AppHtml + library dep folder)
    String sDfVersion    // "df" value from a DF26+ JSON .sws (e.g. "26.0"). "" when
                         // the workspace is a legacy INI .sws or no target is
                         // selected. STRING (not Number) so the dot-encoded JSON
                         // value isn't fed through String->Number conversion,
                         // which is locale-sensitive (Swedish/German/etc. use
                         // "," and would mis-parse "26.0" — see
                         // feedback_dataflex_locale_decimal_separator). Compare
                         // via MajorVersionFromVersionString in cCompileMixin.pkg
                         // which yields a locale-neutral Integer.
End_Struct

// Structs for reading a DataFlex 26+ JSON-format .sws workspace file.
// Field shapes mirror the locked format documented at
// https://docs.dataflex.dev/Tools/DfCli/Workspace/. Paths the spec shows as
// string-or-array are stored as String arrays here; the parser promotes a
// scalar JSON string into a single-element array transparently.

// A dependency entry: either a simple path string or a git/cloud reference object.
Struct tSwsDependency
    Boolean bIsObject       // True = git/cloud object; False = simple path string
    String  sPath           // Simple path: cloud name, relative, or absolute
    String  sSource         // Git source URL (object only)
    String  sVersion        // Tag or branch name (object only)
    String  sSws            // Optional sub-path to .sws within the repository
End_Struct

// One override entry: pins or redirects a dependency. Per spec the value may
// be a plain version string or an object with several override properties.
Struct tSwsOverride
    String  sKey            // Dependency identifier being overridden (the JSON map key)
    Boolean bIsObject       // True = object value; False = simple version string
    String  sVersion        // Version (object form) or full value (string form)
    String  sSws            // Optional alternate sub-path to .sws
    Boolean bHtmlIncludes   // Override htmlIncludes flag
    Boolean bCacheCheck     // Override cacheCheck flag
    Boolean bInstallFiles   // Override installFiles flag
    String  sType           // e.g. "LOCAL"
End_Struct

// Workspace source and data path configuration. All multi-form paths are
// arrays here regardless of whether the JSON used a string or an array.
Struct tSwsPaths
    String   sConfigFile        // e.g. "Programs/Config.ws"
    String[] asAppHtml          // String or array: e.g. "AppHtml"
    String[] asIndexHtml        // String or array: index HTML / Flextron host
    String[] asAppSrc           // String or array: application source folder(s)
    String[] asData             // String or array: data folder(s)
    String[] asDdSrc            // String or array: data dictionary source folder(s)
    String   sFileList          // e.g. "Data/FileList.cfg"
    String   sConnectionIni     // e.g. "Data/connection.ini"
    String[] asBitmap           // String or array: e.g. ["Bitmaps"]
    String[] asPrograms         // String or array: e.g. ["Programs"]
    String   sIdeSrc            // e.g. "idesrc"
    String[] asHelp             // String or array: e.g. ["Help"]
End_Struct

// One build target. May appear as a plain string filename or an object with
// at minimum a name and an optional testProject flag.
Struct tSwsProject
    Boolean bIsObject           // True = object form; False = plain string
    String  sName               // Project source file name (e.g. "MyApp.src")
    Boolean bTestProject        // testProject flag (object only)
End_Struct

// A conditional compilation flag (name is case-insensitive).
Struct tSwsConditional
    String  sName           // e.g. "Is$WebApp"
    Boolean bValue          // Conditional value
End_Struct

// A preferred-class mapping shown in the Studio class browser. The JSON
// representation is a map: the key (sName) is the slot/class being preferred
// for; the object value carries the chosen class and its source file.
Struct tSwsPreferredClass
    String sName            // Map key (slot / display name, e.g. "Button")
    String sClass           // Class identifier (e.g. "cMyButton")
    String sFile            // Source file containing the class
End_Struct

// DataFlex Studio-specific workspace settings.
Struct tSwsStudio
    String               sWindowsTestProject      // "windowsTestProject" — project used for Windows UI testing
    tSwsConditional[]    aConditionals            // Conditional compilation flags
    Boolean              bTableEditorReadOnly     // Lock the table editor
    Integer              iDefaultFormSpacing      // "defaultFormSpacing" — default form spacing
    Boolean              bHideSystemClasses       // Hide system classes in the browser
    tSwsPreferredClass[] aPreferredClasses        // Preferred class mappings (parsed from a JSON map)
End_Struct

// An HTML include: either a plain module path string or an object with attributes.
Struct tSwsHtmlInclude
    Boolean bIsObject       // True = object notation; False = plain string (module)
    String  sFile           // Path to the include file
    String  sType           // type attribute (object notation, e.g. "mjs")
    Boolean bAsync          // async attribute (object notation only)
    String  sIntegrity      // integrity attribute (object notation, e.g. "sha384-...")
    String  sCrossorigin    // crossorigin attribute (object notation, e.g. "anonymous")
End_Struct

// One install entry: a glob/path string or an object with a "path" property.
Struct tSwsInstallItem
    Boolean bIsObject       // True = object form; False = plain string
    String  sPath           // The glob/path (may use ${Variables})
End_Struct

// Package/library distribution metadata.
Struct tSwsPackage
    String              sIcon           // Icon file path
    String              sLicense        // License identifier (e.g. "MIT")
    String              sLicenseFile    // Path to a license file
    String              sVersion        // Package version string ("1.2.3" or built from {major,minor,revision})
    // The DataFlex releases this package supports - its own claim, and the only sound basis for
    // judging a package against a target. Strings, not numbers: see the note in ReadSwsJsonFile.
    String              sDfMin          // "df-min", "" when the package does not say
    String              sDfMax          // "df-max", "" when the package does not say
    String[]            asIncludeFiles  // Glob patterns of files to include in the package
    String[]            asExcludeFiles  // Glob patterns of files to exclude from the package
    tSwsInstallItem[]   aInstall        // Files to install (string or object)
    tSwsHtmlInclude[]   aHtmlIncludes   // HTML include entries
End_Struct

/* Which on-disk shape a .sws has. An ENUM rather than a Boolean (Nils 2026-08-05): "bIsJson = False"
   reads as an assertion about JSON when what is meant is "it is INI", and a third format would have
   nowhere to go.

   The DF26 Studio converts a WORKSPACE .sws to JSON when migrating; LIBRARY .sws files stay INI
   (verified 2026-08-05: 1 JSON to 103 INI under DF26). Both formats are therefore live at once, and
   which one a file has is a property of the FILE, never of the DataFlex version. */
Enum_List
    Define eSwsIni   for 0
    Define eSwsJson  for 1
    /* THERE IS NO FILE - which is NOT "the old format", however convenient that was to return.
       SwsFormatOf answered eSwsIni for a missing or empty path, so the Libraries dialog dimmed
       Add Package / Browse Packages AND offered to "Convert to JSON now" a file that was not
       there (Nils 2026-08-30, on the Alpha 5 package). Same failure shape the pOwnSws guard was
       written for: absence reported as a value. Callers testing "<> eSwsJson" keep working -
       missing is correctly not-JSON - but anything that WORDS the answer must tell the two
       apart. */
    Define eSwsMissing for 2
    /* THE FILE IS THERE AND IS NEITHER: it carries git conflict markers ('<<<<<<< ' at the start of
       a line), an unfinished merge committed as it stood. df-cli reads such a library .sws, says
       "Config file is not in ini format", refuses the whole chain - and, started without its output
       redirected, waits until killed (measured 2026-09-14, on a real library repository whose five
       .sws files have all carried the markers since 2024). Its own answer, so the chain walk and the
       Libraries dialog can NAME the file instead of blaming "a reference that does not resolve". */
    Define eSwsConflict for 3
End_Enum_List

/* ---- RESOLVED AT RUNTIME, not read from the file ------------------------------------------
   Everything above describes the .sws's CONTENTS; these five describe where it sits and what
   its relative paths resolve to. They live here rather than in a second struct beside it,
   because a second struct modelling the same workspace is exactly how tWorkspacePaths came to
   exist - and how the multi-path arrays above ended up being discarded at [0] to fit it.

   Kept as one clearly-marked group so nobody mistakes them for fields the file declares:
   a .sws never states its own home, and asking it to would be circular. */
Struct tRuntimePaths
    String sSwsPath       // Full path of the .sws itself
    String sHome          // Workspace home (the folder the .sws sits in, or the .ws Home=)
    String sWsConfigFile  // Full path of the legacy .ws, "" for a JSON workspace that carries its paths inline
    String sFilelistName  // DF_FILELIST_NAME as resolved
    String sOpenPath      // DF_OPEN_PATH composite at capture time
End_Struct
    
/* Complete in-memory representation of a DataFlex .sws workspace file, either format.
  
   FORMAT + PARSE STATE, decided once at the boundary so nothing downstream sniffs the file.
   bParsed is not decoration: "read, and genuinely empty" and "never read" look identical in
   every other field, and confusing them is what made the Libraries tile report "declares no
   libraries" for a workspace that declared six. Test it before concluding anything from an
   empty list. */
Struct tSwsFile
    Integer          eSwsFormat                  // eSwsIni / eSwsJson
    Boolean          bParsed                     // False = never read, or unreadable
    String           sWorkspaceName              // "workspaceName" (defaults to filename if absent)
    String           sDfVersion                  // "df" — target DataFlex version, kept as String to dodge the locale decimal-separator trap (successful-parse sentinel: <> "")
    String           sDescription                // Short description (required for packages)
    Boolean          bNoUpdateHtml               // "no-update-html"
    Boolean          bNoHtmlIncludeVersioning    // "no-html-include-versioning"
    tSwsPaths        Paths                       // Source and data path configuration
    tSwsDependency[] aDependencies               // Workspace dependencies (libraries)
    tSwsOverride[]   aOverrides                  // Overrides (only root-workspace overrides take effect)
    tSwsProject[]    aProjects                   // Project entries (Program files)
    tSwsStudio       Studio                      // DataFlex Studio settings
    tSwsPackage      Package                     // Package/library distribution metadata
    tRuntimePaths    RuntimePaths                // Resolved at runtime - contrast Paths above, which is what the FILE declares
End_Struct

