    External_Function TestLvInitControls "InitCommonControls" comctl32.dll Returns Integer
    External_Function TestLvCreateWindow "CreateWindowExA" user32.dll UInteger dwExStyle String lpClassName String lpWindowName UInteger dwStyle Integer iX Integer iY Integer iWidth Integer iHeight Handle hParent Handle hMenu Handle hInstance Pointer lpParam Returns Handle
    External_Function TestLvDestroyWindow "DestroyWindow" user32.dll Handle hWnd Returns Integer
    External_Function TestLvSendMessage "SendMessageA" user32.dll Handle hWnd UInteger uMsg ULongPtr wParam LongPtr lParam Returns LongPtr
    External_Function TestCreatePopupMenu "CreatePopupMenu" user32.dll Returns Handle
    External_Function TestInsertMenuItem "InsertMenuItemA" user32.dll Handle hMenu UInteger iItem Integer fByPosition Pointer lpmi Returns Integer
    External_Function TestGetMenuItemInfo "GetMenuItemInfoA" user32.dll Handle hMenu UInteger iItem Integer fByPosition Pointer lpmii Returns Integer
    External_Function TestDestroyMenu "DestroyMenu" user32.dll Handle hMenu Returns Integer

    Object oWin32TypeToStruct is a cTestFixture
        Set psFunctionName to "ConvertWinAPITypeToStruct"

        // The real BROWSEINFOA entry, as the harvest stores it - two alignment fillers included.
        Function SdkBrowseInfo Returns String
            String sNl sOut
            Move (Character(10)) to sNl
            Move ("Struct BROWSEINFOA" + sNl ;
                + "Handle hwndOwner  // HWND" + sNl ;
                + "Pointer pidlRoot  // ITEMIDLIST*" + sNl ;
                + "Pointer pszDisplayName  // PSTR" + sNl ;
                + "Pointer lpszTitle  // PSTR" + sNl ;
                + "UInteger ulFlags" + sNl ;
                + "Integer iMissingAlignment1" + sNl ;
                + "Pointer lpfn  // BFFCALLBACK" + sNl ;
                + "LongPtr lParam  // LPARAM" + sNl ;
                + "Integer iImage" + sNl ;
                + "Integer iMissingAlignment2" + sNl ;
                + "End_Struct") to sOut
            Function_Return sOut
        End_Function

        // The legacy member names, in the order the 1990s block declares them.
        Procedure LegacyBrowseNames String[] ByRef asOut
            Move "hWndOwner"      to asOut[0]
            Move "pIDLRoot"       to asOut[1]
            Move "pszDisplayName" to asOut[2]
            Move "lpszTitle"      to asOut[3]
            Move "ulFlags"        to asOut[4]
            Move "lpfnCallback"   to asOut[5]
            Move "lParam"         to asOut[6]
            Move "iImage"         to asOut[7]
        End_Procedure

        /* THE CONVERSION THIS WHOLE THING EXISTS FOR. Eight legacy names, eight SDK members plus
           two fillers, and the two defects that made the legacy block wrong on x64 both disappear:
           lParam widens from the legacy dWord to LongPtr, and the interior padding the ABI requires
           appears between ulFlags and lpfnCallback. Nothing a call site can see changes - every
           member keeps the name it was written with. */
        {Published = True}
        Procedure Win32Struct_LegacyNamesCarrySdkTypes
            String[] asNames asBody
            String sWhy sAll
            Integer i
            Boolean bOK
            Send LegacyBrowseNames (&asNames)
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) (SdkBrowseInfo(Self)) (&asBody) (&sWhy) to bOK
            Send Assert bOK
            Send AssertSAreEqual "" sWhy
            // eight real members + the two fillers
            Send AssertIAreEqual 10 (SizeOfArray(asBody))
            Move "" to sAll
            For i from 0 to (SizeOfArray(asBody) - 1)
                Move (sAll + Trim(asBody[i]) + (Character(10))) to sAll
            Loop
            // the author's names survive, including the one the SDK spells differently (lpfn)
            Send Assert (Pos("Pointer lpfnCallback", sAll) > 0)
            Send Assert (Pos("Handle hWndOwner", sAll) > 0)
            // the x64 fix: LongPtr where the legacy block said dWord
            Send Assert (Pos("LongPtr lParam", sAll) > 0)
            // the padding the legacy block never had
            Send Assert (Pos("Integer iMissingAlignment1", sAll) > 0)
            Send Assert (Pos("Integer iMissingAlignment2", sAll) > 0)
            // the SDK's own member names must NOT leak in
            Send Assert (Pos("lpfn " + (Character(10)), sAll) = 0)
            Send Assert (Pos("Pointer pidlRoot", sAll) = 0)
        End_Procedure

        /* A FLATTENED BLOCK IS REFUSED, BY COUNT. The legacy WIN32_FIND_DATA inlines three nested
           FILETIMEs as six DWords, so it declares 13 members where the SDK has 10. Position is the
           only correspondence available here - the SDK's names are frequently not the author's - and
           a differing count disproves position outright. The reason carries BOTH numbers, because
           "could not convert" without them is the readout this app keeps retiring. */
        {Published = True}
        Procedure Win32Struct_FlattenedBlockRefusedWithBothCounts
            String[] asNames asBody
            String sWhy
            Integer i
            Boolean bOK
            For i from 0 to 12
                Move ("member" + String(i)) to asNames[i]
            Loop
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) (SdkBrowseInfo(Self)) (&asBody) (&sWhy) "BROWSEINFOA" to bOK
            Send Assert (bOK = False)
            Send Assert (Pos("13", sWhy) > 0)
            Send Assert (Pos("8", sWhy) > 0)
            // ...and names the Windows struct the Type was taken for, in words a reader of the Check
            // row can act on (Nils 2026-10-06: the old reason read as gibberish on a real row).
            Send Assert (Pos("lists 13 members", sWhy) > 0) sWhy
            Send Assert (Pos("named after, BROWSEINFOA, has 8", sWhy) > 0) sWhy
            Send Assert (Pos("same members in the same order", sWhy) > 0) sWhy
            Send Assert (Pos("cannot be trusted", sWhy) = 0) sWhy
            Send AssertIAreEqual 0 (SizeOfArray(asBody))
        End_Procedure

        // A caller with no struct name to give still gets a reason that reads whole.
        {Published = True}
        Procedure Win32Struct_CountMismatchReasonReadsWithoutAStructName
            String[] asNames asBody
            String sWhy
            Integer i
            Boolean bOK
            For i from 0 to 12
                Move ("member" + String(i)) to asNames[i]
            Loop
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) (SdkBrowseInfo(Self)) (&asBody) (&sWhy) "" to bOK
            Send Assert (bOK = False)
            Send Assert (Pos("named after has 8", sWhy) > 0) sWhy
        End_Procedure

        // No catalogue entry is a refusal with a reason, never a silent empty struct.
        {Published = True}
        Procedure Win32Struct_NoCatalogueEntryRefused
            String[] asNames asBody
            String sWhy
            Boolean bOK
            Send LegacyBrowseNames (&asNames)
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) "" (&asBody) (&sWhy) to bOK
            Send Assert (bOK = False)
            Send Assert (Trim(sWhy) <> "")
        End_Procedure

        // The filler predicate on its own - it decides both the count and what is emitted verbatim.
        {Published = True}
        Procedure Win32Struct_FillerLinesRecognised
            Send Assert (_IsAlignmentFillerLine(ghoFuncLib, "Integer iMissingAlignment1"))
            Send Assert (_IsAlignmentFillerLine(ghoFuncLib, "Short iMissingAlignment2"))
            Send Assert (_IsAlignmentFillerLine(ghoFuncLib, "Integer tNMCUSTOMDRAWMissingAlignment1")) "the padding a C row's emission computes"
            Send Assert (_IsAlignmentFillerLine(ghoFuncLib, "Pointer lpszTitle  // PSTR") = False)
            Send Assert (_IsAlignmentFillerLine(ghoFuncLib, "LongPtr lParam") = False)
        End_Procedure

        /* SEEDS THE INSTALL-STRUCT CACHE. psTargetPkgFolder is blank in the test runner - it has no
           compiler configured - so the real tWinStructs.pkg cannot be found here. The cache property
           is the seam: filling it tests the derivation, the member gate and the rewriting, which is
           all the logic there is. The install supplies the real file in the running app. */
        Procedure SeedWinStructs
            String[] asLines
            Move "Struct tWinWindowPlacement"  to asLines[0]
            Move "    UInteger length"         to asLines[1]
            Move "    UInteger flags"          to asLines[2]
            Move "    UInteger showCmd"        to asLines[3]
            Move "End_Struct"                  to asLines[4]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
        End_Procedure

        Function Rewrote String sLine String sType String sBuffer Returns String
            String sOut
            Boolean bOK
            Get _RewriteWin32BufferLine of ghoFuncLib sLine sType sBuffer "BrowseInfoEmpty" (&sOut) to bOK
            If (bOK = False) ;
                Function_Return ""
            Function_Return sOut
        End_Function

        /* THE FIVE SHAPES, on the real lines. Every input below is copied from a legacy workspace
           rather than invented, because the awkward ones are awkward in ways nobody makes up: the
           hWndOwner line carries a parenthesised call as its VALUE, which is what a naive split on
           " To " gets wrong. Indentation and any trailing comment survive - a converted line that
           loses either reads as a bigger change than it is. */
        {Published = True}
        Procedure Win32Rewrite_TheFiveShapes
            Send AssertSAreEqual "  Move BrowseInfoEmpty to sBrowseInfo" ;
                (Rewrote(Self, "  ZeroType vtBrowseInfo To sBrowseInfo", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "    Move lpsTitle to sBrowseInfo.lpszTitle" ;
                (Rewrote(Self, "    Put lpsTitle To sBrowseInfo At vtBrowseInfo.lpszTitle", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "  Move (AddressOf(sBrowseInfo)) to lpsBrowseInfo" ;
                (Rewrote(Self, "  GetAddress Of sBrowseInfo To lpsBrowseInfo", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "  Move BrowseInfoEmpty to sBrowseInfo" ;
                (Rewrote(Self, "  FillType vtBrowseInfo With 0 to sBrowseInfo", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "  Move sBrowseInfo.ulFlags to iFlags" ;
                (Rewrote(Self, "  GetBuff From sBrowseInfo At vtBrowseInfo.ulFlags To iFlags", "vtBrowseInfo", "sBrowseInfo"))
        End_Procedure

        // A PARENTHESISED VALUE. The real line from vWin32fh - the reason keywords are found at
        // paren depth zero instead of by splitting on spaces.
        {Published = True}
        Procedure Win32Rewrite_ParenthesisedValueSurvivesWhole
            Send AssertSAreEqual "  Move (window_handle(focus(desktop))) to sBrowseInfo.hWndOwner" ;
                (Rewrote(Self, "  Put (window_handle(focus(desktop))) To sBrowseInfo At vtBrowseInfo.hWndOwner", ;
                    "vtBrowseInfo", "sBrowseInfo"))
        End_Procedure

        // The author keeps their comment and their indent.
        {Published = True}
        Procedure Win32Rewrite_CommentAndIndentSurvive
            Send AssertSAreEqual "        Move vBIF_RETURNONLYFSDIRS to sBrowseInfo.ulFlags   // Torben" ;
                (Rewrote(Self, "        Put vBIF_RETURNONLYFSDIRS To sBrowseInfo At vtBrowseInfo.ulFlags   // Torben", ;
                    "vtBrowseInfo", "sBrowseInfo"))
        End_Procedure

        /* ANOTHER BUFFER, OR ANOTHER TYPE, IS NOT THIS CLUSTER. The rewriter is handed every line of
           the file, so refusing what it does not own is most of its job - a line naming a different
           buffer must come back untouched, or one cluster would corrupt another. */
        {Published = True}
        Procedure Win32Rewrite_ForeignBufferOrTypeRefused
            Send AssertSAreEqual "" ;
                (Rewrote(Self, "  Put x To sOtherBuffer At vtBrowseInfo.ulFlags", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "" ;
                (Rewrote(Self, "  Put x To sBrowseInfo At tOtherType.ulFlags", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "" ;
                (Rewrote(Self, "  ZeroType vtBrowseInfo To sSomethingElse", "vtBrowseInfo", "sBrowseInfo"))
        End_Procedure

        // Anything that is not one of the five shapes comes back untouched, including a comment that
        // merely mentions one of them.
        {Published = True}
        Procedure Win32Rewrite_UnrelatedLinesUntouched
            Send AssertSAreEqual "" (Rewrote(Self, "  Move sBrowseInfo to sCopy", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "" (Rewrote(Self, "  // ZeroType vtBrowseInfo To sBrowseInfo", "vtBrowseInfo", "sBrowseInfo"))
            Send AssertSAreEqual "" (Rewrote(Self, "", "vtBrowseInfo", "sBrowseInfo"))
        End_Procedure

        // The depth-aware finder on its own - a keyword inside parens is not the separator.
        {Published = True}
        Procedure Win32Rewrite_WordPosIgnoresNestedKeywords
            Send AssertIAreEqual 0 (_WordPosAtDepthZero(ghoFuncLib, "Put (a to b) x", "to", 1))
            Send Assert (_WordPosAtDepthZero(ghoFuncLib, "Put (a to b) To c", "to", 1) > 0)
            // whole word only: "Total" is not "To"
            Send AssertIAreEqual 0 (_WordPosAtDepthZero(ghoFuncLib, "Move Total x", "to", 1))
        End_Procedure

        /* END TO END, on the real vWin32fh cluster. The Type block, the buffer declaration and every
           accessor together - because the parts can each be right while the whole is not, and this is
           the first test where a wrong answer means a file that does not compile. */
        Procedure BrowseCluster String[] ByRef asCode
            Move "Type vtBrowseInfo"                                          to asCode[0]
            Move "  Field vtBrowseInfo.hWndOwner      as Handle"              to asCode[1]
            Move "  Field vtBrowseInfo.pIDLRoot       as Pointer"             to asCode[2]
            Move "  Field vtBrowseInfo.pszDisplayName as Pointer"             to asCode[3]
            Move "  Field vtBrowseInfo.lpszTitle      as Pointer"             to asCode[4]
            Move "  Field vtBrowseInfo.ulFlags        as dWord"               to asCode[5]
            Move "  Field vtBrowseInfo.lpfnCallback   as Pointer"             to asCode[6]
            Move "  Field vtBrowseInfo.lParam         as dWord"               to asCode[7]
            Move "  Field vtBrowseInfo.iImage         as dWord"               to asCode[8]
            Move "End_Type // vtBrowseInfo"                                   to asCode[9]
            Move ""                                                           to asCode[10]
            Move "Function vSHBrowseForFolder Returns String"                 to asCode[11]
            Move "  String sFolder sBrowseInfo sTitle"                        to asCode[12]
            Move "  Pointer lpsBrowseInfo"                                    to asCode[13]
            Move "  ZeroType vtBrowseInfo To sBrowseInfo"                     to asCode[14]
            Move "  Put lpsTitle To sBrowseInfo At vtBrowseInfo.lpszTitle"    to asCode[15]
            Move "  GetAddress Of sBrowseInfo To lpsBrowseInfo"               to asCode[16]
            Move "End_Function"                                               to asCode[17]
        End_Procedure

        {Published = True}
        Procedure Win32Convert_EndToEndBrowseInfo
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            // the Struct arrives, with the author names and the SDK types
            Send Assert (Pos("Struct vtBrowseInfo", sAll) > 0)
            Send Assert (Pos("LongPtr lParam", sAll) > 0)
            Send Assert (Pos("iMissingAlignment1", sAll) > 0)
            Send Assert (Pos("End_Struct", sAll) > 0)
            // the legacy Type block is commented out, not deleted
            Send Assert (Pos("// Type vtBrowseInfo", sAll) > 0)
            Send Assert (Pos("// End_Type", sAll) > 0)
            // the buffer becomes a struct variable, with its companion for zeroing
            Send Assert (Pos("vtBrowseInfo sBrowseInfo", sAll) > 0)
            Send Assert (Pos("vtBrowseInfo sBrowseInfoEmpty", sAll) > 0)
            // the accessors are struct access now
            Send Assert (Pos("Move sBrowseInfoEmpty to sBrowseInfo", sAll) > 0)
            Send Assert (Pos("Move lpsTitle to sBrowseInfo.lpszTitle", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(sBrowseInfo)) to lpsBrowseInfo", sAll) > 0)
            // and nothing byte-level survives
            Send Assert (Pos("ZeroType vtBrowseInfo To sBrowseInfo", sAll) = 0)
            Send Assert (Pos("Put lpsTitle To", sAll) = 0)
            Send Assert (Pos("GetAddress Of sBrowseInfo", sAll) = 0)
        End_Procedure

        /* TWO BUFFERS ON ONE DECLARATION LINE, one of each of two Types (2026-10-31, the real shape from a
           file-handling package): each lift started from the original line, so the second dropped the first -
           sftTime stayed a String while its accessors became struct access, and every program using the
           package stopped compiling. Both buffers leave the line now, and every Empty twin used is declared. */
        {Published = True}
        Procedure Win32Convert_TwoBuffersOnOneDeclarationLine
            String[] asCode asNotes
            String sAll sNl
            Integer iCount i
            Move "Type vFileTime"                                       to asCode[0]
            Move "  Field vFileTime.dwLowDateTime As Dword"             to asCode[1]
            Move "  Field vFileTime.dwHighDateTime As Dword"            to asCode[2]
            Move "End_Type // vFileTime"                                to asCode[3]
            Move "Type vSystemTime"                                     to asCode[4]
            Move "  Field vSystemTime.wYear As Word"                    to asCode[5]
            Move "  Field vSystemTime.wMonth As Word"                   to asCode[6]
            Move "  Field vSystemTime.wDayOfWeek As Word"               to asCode[7]
            Move "  Field vSystemTime.wDay As Word"                     to asCode[8]
            Move "  Field vSystemTime.wHour As Word"                    to asCode[9]
            Move "  Field vSystemTime.wMinute As Word"                  to asCode[10]
            Move "  Field vSystemTime.wSecond As Word"                  to asCode[11]
            Move "  Field vSystemTime.wMilliseconds As Word"            to asCode[12]
            Move "End_Type // vSystemTime"                              to asCode[13]
            Move "Function vConvertFileTime Global Dword dwLow Returns String" to asCode[14]
            Move "  String  sftTime sSystemTime sFormatted"             to asCode[15]
            Move "  Pointer lpsftTime lpsSystemTime"                    to asCode[16]
            Move "  ZeroType vFileTime  To sftTime"                     to asCode[17]
            Move "  Put dwLow  To sftTime At vFileTime.dwLowDateTime"   to asCode[18]
            Move "  GetAddress Of sftTime To lpsftTime"                 to asCode[19]
            Move "  ZeroType vSystemTime To sSystemTime"                to asCode[20]
            Move "  GetAddress Of sSystemTime To lpsSystemTime"         to asCode[21]
            Move "  Function_Return sFormatted"                         to asCode[22]
            Move "End_Function"                                         to asCode[23]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 2 iCount
            Move (Character(10)) to sNl
            Move sNl to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + sNl) to sAll
            Loop
            Send Assert (Pos((sNl + "String sFormatted" + sNl), sAll) > 0) "the rest of the declaration stays"
            Send Assert (Pos((sNl + "vFileTime sftTime" + sNl), sAll) > 0) "sftTime is a struct variable"
            Send Assert (Pos((sNl + "vFileTime sftTimeEmpty" + sNl), sAll) > 0) "its Empty twin is declared"
            Send Assert (Pos((sNl + "vSystemTime sSystemTime" + sNl), sAll) > 0) "sSystemTime is a struct variable"
            Send Assert (Pos((sNl + "vSystemTime sSystemTimeEmpty" + sNl), sAll) > 0) "its Empty twin is declared"
            Send Assert (Pos("Move sftTimeEmpty to sftTime", sAll) > 0)
            Send Assert (Pos("Move sSystemTimeEmpty to sSystemTime", sAll) > 0)
            Send Assert (Pos("String  sftTime", sAll) = 0 and Pos("String sftTime", sAll) = 0) "no String sftTime is left"
        End_Procedure

        Procedure _WriteLines String sFile String[] asLines
            Integer iCh i iLast
            Move (rfOpenOutput(sFile)) to iCh
            If (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
                Move (SizeOfArray(asLines) - 1) to iLast
                For i from 0 to iLast
                    Writeln channel iCh asLines[i]
                Loop
                Send rfCloseOutput iCh
            End
        End_Procedure

        Function _NotesText String[] asNotes Returns String
            String sAll
            Integer i
            Move "" to sAll
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sAll + asNotes[i] + " | ") to sAll
            Loop
            Function_Return sAll
        End_Function

        /* A TYPE ANOTHER FILE READS STAYS A TYPE (2026-11-01): a workspace's shared package had its vFileTime made a
           Struct while a library's file, outside the run, still read it byte by byte - and the program using that
           file stopped compiling. On files in the Windows TEMP folder: a file of the run that names the Type's size,
           or a file outside the run that reads a member offset, keeps the Type, with a note naming that file - in
           both Type converters. A file that declares the same Type itself, names it only in a comment and a
           string, or has the name of a run file - a shadowed copy, never compiled - is no reader, and the Type
           converts. */
        {Published = True}
        Procedure Win32Convert_TypeAnotherFileReadsStaysAType
            tRefactorSettings Settings Saved
            String[] asCode asNotes asCopy asNote asView asReader asFolders asPoint asShadow asNone
            String sRoot sNotes2 sNotes3 sNotes4 sFirst2 sFirst3
            Integer iCount1 iCount2 iCount3 iCount4
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_TypeReaders\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx(sRoot, False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Lib\"), False)) to bOk
            Send Assert bOk "the fixture folders"
            Send BrowseCluster (&asCode)
            Send _WriteLines (sRoot + "Browse.pkg") asCode
            Move "Type vtBrowseInfo"                              to asCopy[0]
            Move "  Field vtBrowseInfo.hWndOwner as Handle"       to asCopy[1]
            Move "End_Type"                                       to asCopy[2]
            Move "  ZeroType vtBrowseInfo To sBuf"                to asCopy[3]
            Move "// Put 1 to sBuf at vtBrowseInfo.ulFlags"       to asNote[0]
            Move 'Showln "vtBrowseInfo_SIZE"'                     to asNote[1]
            Move "Procedure ShowSize"                             to asView[0]
            Move "  Move vtBrowseInfo_SIZE to iLen"               to asView[1]
            Move "End_Procedure"                                  to asView[2]
            Move "Procedure ReadIt"                               to asReader[0]
            Move "  Put 1 to sBuf at vtBrowseInfo.ulFlags"        to asReader[1]
            Move "  Move POINT_SIZE to iLen"                      to asReader[2]
            Move "End_Procedure"                                  to asReader[3]
            Move "Type POINT"                                     to asPoint[0]
            Move "    Field POINT.x as dWord"                     to asPoint[1]
            Move "    Field POINT.y as dWord"                     to asPoint[2]
            Move "End_Type // POINT"                              to asPoint[3]
            Move "  Put 1 to sBuf at vtBrowseInfo.ulFlags"        to asShadow[0]
            Send _WriteLines (sRoot + "Lib\Copy.pkg") asCopy
            Send _WriteLines (sRoot + "Lib\Browse.pkg") asShadow
            Send _WriteLines (sRoot + "Lib\Note.nui") asNote
            Send _WriteLines (sRoot + "View.vw")      asView

            Get pRefactorSettings of ghoFuncLib to Saved
            Move Saved to Settings
            Move "*.pkg;*.vw;*.nui" to Settings.sFileFilter
            Move (ResizeArray(Settings.FileData.asFullFileNames, 0)) to Settings.FileData.asFullFileNames
            Move (sRoot + "Browse.pkg") to Settings.FileData.asFullFileNames[0]
            Set pRefactorSettings of ghoFuncLib to Settings
            Move (sRoot + "Lib\") to asFolders[0]
            Set pasOutsideReaderFolders of ghoFuncLib to asFolders

            // 1. The declaring copy, the comment-and-string file and the shadowed copy read nothing: it converts.
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (ResizeArray(asCode, 0)) to asCode
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount1

            // 2. A file of the run that names its size keeps it.
            Move (sRoot + "View.vw") to Settings.FileData.asFullFileNames[1]
            Set pRefactorSettings of ghoFuncLib to Settings
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (ResizeArray(asCode, 0)) to asCode
            Move (ResizeArray(asNotes, 0)) to asNotes
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount2
            Move asCode[0] to sFirst2
            Get _NotesText asNotes to sNotes2

            // 3. A file outside the run that reads a member offset keeps it.
            Move (ResizeArray(Settings.FileData.asFullFileNames, 1)) to Settings.FileData.asFullFileNames
            Set pRefactorSettings of ghoFuncLib to Settings
            Send _WriteLines (sRoot + "Lib\Reader.nui") asReader
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (ResizeArray(asCode, 0)) to asCode
            Move (ResizeArray(asNotes, 0)) to asNotes
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount3
            Move asCode[0] to sFirst3
            Get _NotesText asNotes to sNotes3

            // 4. ...and so does ConvertWinAPITypeToStruct's converter, for a POINT whose size it reads.
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Move (ResizeArray(asNotes, 0)) to asNotes
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asPoint) (&asNotes) to iCount4
            Get _NotesText asNotes to sNotes4

            Set pRefactorSettings of ghoFuncLib to Saved
            Set pasOutsideReaderFolders of ghoFuncLib to asNone
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (rfRemoveFolderTree(sRoot)) to bOk

            Send AssertIAreEqual 1 iCount1
            Send AssertIAreEqual 0 iCount2
            Send AssertSAreEqual "Type vtBrowseInfo" sFirst2
            Send Assert (Pos("vtBrowseInfo left as written - another file uses it too", sNotes2) > 0 and Pos("View.vw", sNotes2) > 0) ("the note names the view: " + sNotes2)
            Send AssertIAreEqual 0 iCount3
            Send AssertSAreEqual "Type vtBrowseInfo" sFirst3
            Send Assert (Pos("Reader.nui", sNotes3) > 0) ("the note names the file outside the run: " + sNotes3)
            Send AssertIAreEqual 0 iCount4
            Send Assert (Pos("POINT: left as written - another file uses it too", sNotes4) > 0 and Pos("Reader.nui", sNotes4) > 0) ("POINT: " + sNotes4)
        End_Procedure

        /* THE TYPE'S SIZE SYMBOL BECOMES SizeOfType (2026-10-31): a Type defines <Type>_SIZE and a Struct does not -
           a printer-dialog package's DEVNAMES became a Struct while 'Move (DEVNAMES_Size + ...)' stayed, and every
           program using it stopped compiling. In code it is rewritten; in a string or a comment it stays. */
        {Published = True}
        Procedure Win32Convert_TypeSizeSymbolBecomesSizeOfType
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            Move '  Move (vtBrowseInfo_Size + 1) to iLen // vtBrowseInfo_Size' to asCode[17]
            Move '  Showln "vtBrowseInfo_Size"'                                to asCode[18]
            Move "End_Function"                                                to asCode[19]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("Move (SizeOfType(vtBrowseInfo) + 1) to iLen // vtBrowseInfo_Size", sAll) > 0) "the size symbol in code"
            Send Assert (Pos('Showln "vtBrowseInfo_Size"', sAll) > 0) "the name in a string stays"
        End_Procedure

        /* THE REAL SHAPE BEHIND THE CALL-SITE PROOF (2026-11-04): a popup menu package's Type, written before
           Windows added the struct's last member, read byte by byte and handed to the API that takes the
           struct. One Put runs over two lines, as the package writes it. */
        Procedure MenuCluster String[] ByRef asCode
            Move 'External_Function InsertMenuItem "InsertMenuItemA" user32.dll handle hMenu integer iItem integer iFlag pointer pStr returns integer' to asCode[0]
            Move "Type tagMENUITEMINFO"                                        to asCode[1]
            Move "    field tagMENUITEMINFO.cbSize        As Integer"          to asCode[2]
            Move "    field tagMENUITEMINFO.fMask         As Integer"          to asCode[3]
            Move "    field tagMENUITEMINFO.fType         As Integer"          to asCode[4]
            Move "    field tagMENUITEMINFO.fState        As Integer"          to asCode[5]
            Move "    field tagMENUITEMINFO.wID           As Integer"          to asCode[6]
            Move "    field tagMENUITEMINFO.hSubMenu      As Handle"           to asCode[7]
            Move "    field tagMENUITEMINFO.hbmpChecked   As Handle"           to asCode[8]
            Move "    field tagMENUITEMINFO.hbmpUnchecked As Handle"           to asCode[9]
            Move "    field tagMENUITEMINFO.dwItemData    As DWORD"            to asCode[10]
            Move "    field tagMENUITEMINFO.dwTypeData    As Pointer"          to asCode[11]
            Move "    field tagMENUITEMINFO.cch           As Integer"          to asCode[12]
            Move "End_Type"                                                    to asCode[13]
            Move "Function AddItem Handle hMenu Integer iC Returns Integer"    to asCode[14]
            Move "    String sInfo sItem"                                      to asCode[15]
            Move "    Pointer pInfo"                                           to asCode[16]
            Move "    Integer iRet"                                            to asCode[17]
            Move "    Zerotype tagMENUITEMINFO to sInfo"                       to asCode[18]
            Move "    Put tagMENUITEMINFO_SIZE to sInfo at tagMENUITEMINFO.cbSize" to asCode[19]
            Move "    Put (MIIM_STATE+MIIM_ID) ; // the mask"                  to asCode[20]
            Move "        to sInfo at tagMENUITEMINFO.fMask"                   to asCode[21]
            Move "    Put hBmp to sInfo at tagMENUITEMINFO.hbmpUnChecked"      to asCode[22]
            Move "    Move (AddressOf(sInfo)) to pInfo"                        to asCode[23]
            Move "    Move (InsertMenuItem(hMenu,iC,True,pInfo)) to iRet"      to asCode[24]
            Move "    Function_Return iRet"                                    to asCode[25]
            Move "End_Function"                                                to asCode[26]
        End_Procedure

        Function AllLines String[] asLines Returns String
            String sAll
            Integer i
            Move "" to sAll
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move (sAll + asLines[i] + (Character(10))) to sAll
            Loop
            Function_Return sAll
        End_Function

        /* THE CALL PROVES THE STRUCT, so a Type that lists only its first members becomes all of it. Without
           this the member-count gate took it for a flattened struct and refused it. */
        {Published = True}
        Procedure Win32Proof_ShortTypeBecomesTheWholeStruct
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send MenuCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("Struct tagMENUITEMINFO", sAll) > 0) "the Struct keeps the Type's name"
            Send Assert (Pos("Handle hbmpItem", sAll) > 0) "the member the Type left out is there"
            Send Assert (Pos("iMissingAlignment2", sAll) > 0) "with the padding in front of it"
            Send Assert (Pos("ULongPtr dwItemData", sAll) > 0) "the SDK's type replaces the Type's DWord"
            Send Assert (Pos("Move (SizeOfType(tagMENUITEMINFO)) to sInfo.cbSize", sAll) > 0) "the size symbol"
            Send Assert (Pos("MENUITEMINFOA", sNotes) > 0 and Pos("hbmpItem", sNotes) > 0) sNotes
        End_Procedure

        /* WINDOWS TAKES WHAT THE CONVERTER EMITS. A green compile says nothing about a struct's layout, so this
           hands the emitted shape, at the size SizeOfType reports, to InsertMenuItemA and reads it back. The
           menu is never shown. */
        {Published = True}
        Procedure Win32Proof_WindowsAcceptsTheWholeMenuStruct
            tTestWholeMenuItemInfo MenuItem ReadBack
            Handle hMenu
            String sText
            Integer iRet
            Move (TestCreatePopupMenu()) to hMenu
            Send Assert (hMenu <> 0) "a popup menu"
            Move "Probe" to sText
            Move (SizeOfType(tTestWholeMenuItemInfo)) to MenuItem.cbSize
            Move 18 to MenuItem.fMask     // MIIM_ID + MIIM_TYPE
            Move 77 to MenuItem.wID
            Move (AddressOf(sText)) to MenuItem.dwTypeData
            Move (Length(sText)) to MenuItem.cch
            Move (TestInsertMenuItem(hMenu, 0, 1, AddressOf(MenuItem))) to iRet
            Send Assert (iRet <> 0) "InsertMenuItemA takes the full size"
            Move (SizeOfType(tTestWholeMenuItemInfo)) to ReadBack.cbSize
            Move 2 to ReadBack.fMask      // MIIM_ID
            Move (TestGetMenuItemInfo(hMenu, 0, 1, AddressOf(ReadBack))) to iRet
            Send Assert (iRet <> 0) "GetMenuItemInfoA reads it back"
            Send AssertIAreEqual 77 ReadBack.wID
            Move (TestDestroyMenu(hMenu)) to iRet
        End_Procedure

        // A Put over two lines is one statement, and neither line is left behind.
        {Published = True}
        Procedure Win32Proof_SplitPutIsOneStatement
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send MenuCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("Move (MIIM_STATE+MIIM_ID) to sInfo.fMask", sAll) > 0) sAll
            Send Assert (Pos("// the mask", sAll) > 0) "its comment stays"
            Send Assert (Pos("to sInfo at", sAll) = 0) "no piece of the old command is left"
        End_Procedure

        // The same Type with no call stays refused: nothing vouches for it.
        {Published = True}
        Procedure Win32Proof_ShortTypeWithNoCallStaysRefused
            String[] asCode asNotes
            String sNotes
            Integer iCount
            Send MenuCluster (&asCode)
            Move "    Move 0 to iRet" to asCode[24]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("lists 11 members", sNotes) > 0) sNotes
        End_Procedure

        // A pointer last loaded from ANOTHER variable proves nothing about this buffer.
        {Published = True}
        Procedure Win32Proof_PointerLoadedFromAnotherVariableIsNoProof
            String[] asCode asNotes
            Integer iCount
            Send MenuCluster (&asCode)
            Move "    Move (AddressOf(sItem)) to pInfo" to asCode[23]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        /* A LEGACY FIELD TYPE A STRUCT CANNOT DECLARE (2026-11-12): Word, Byte and Long - measured, each one Struct
           in a DataFlex 26 compile - get the same width under a name DataFlex 26 declares; everything else stays. */
        {Published = True}
        Procedure Win32Legacy_FieldTypeAsAStructDeclaresIt
            Send AssertSAreEqual "UShort"  (_LegacyFieldTypeToDataFlex(ghoFuncLib, "Word"))
            Send AssertSAreEqual "UShort"  (_LegacyFieldTypeToDataFlex(ghoFuncLib, "WORD"))
            Send AssertSAreEqual "UChar"   (_LegacyFieldTypeToDataFlex(ghoFuncLib, "byte"))
            Send AssertSAreEqual "Integer" (_LegacyFieldTypeToDataFlex(ghoFuncLib, "Long"))
            Send AssertSAreEqual "DWord"   (_LegacyFieldTypeToDataFlex(ghoFuncLib, "DWord"))
            Send AssertSAreEqual "Char"    (_LegacyFieldTypeToDataFlex(ghoFuncLib, "Char"))
            Send AssertSAreEqual "Pointer" (_LegacyFieldTypeToDataFlex(ghoFuncLib, "Pointer"))
        End_Procedure

        /* ...SO A TYPE CONVERTED ON ITS OWN MEMBER TYPES WRITES THEM (2026-11-12). The Crystal Reports package's
           "Field PEWindowOptions.StructSize as Word" became "Word StructSize" - 62 errors. The shape of the test
           below: a Type the catalogue cannot place, so it converts on its own member types. */
        {Published = True}
        Procedure Win32Legacy_OwnMemberTypesAreDeclarable
            String[] asCode asNotes
            String sAll
            Integer iCount
            Move 'External_Function grCreateThread "CreateThread" kernel32.dll Pointer lpAttr ULongPtr iStack Pointer pStart Pointer pParam Integer iFlags Pointer lpId Returns Handle' to asCode[0]
            Move "Type RegShorts"                                              to asCode[1]
            Move "    Field RegShorts.wValue as Word"                          to asCode[2]
            Move "    Field RegShorts.bFlag as Byte"                           to asCode[3]
            Move "    Field RegShorts.lCount as Long"                          to asCode[4]
            Move "End_Type"                                                    to asCode[5]
            Move "Function Go Integer iAddr Returns Handle"                    to asCode[6]
            Move "    String sThreadID"                                        to asCode[7]
            Move "    Pointer lpThreadID"                                      to asCode[8]
            Move "    Handle hT"                                               to asCode[9]
            Move "    ZeroType RegShorts To sThreadID"                         to asCode[10]
            Move "    GetAddress of sThreadID to lpThreadID"                   to asCode[11]
            Move "    Move (grCreateThread(0, 0, iAddr, 0, 0, lpThreadID)) To hT" to asCode[12]
            Move "    Function_Return hT"                                      to asCode[13]
            Move "End_Function"                                                to asCode[14]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("UShort wValue", sAll) > 0) sAll
            Send Assert (Pos("UChar bFlag", sAll) > 0) sAll
            Send Assert (Pos("Integer lCount", sAll) > 0) sAll
            Send Assert (Pos("    Word wValue", sAll) = 0) sAll
        End_Procedure

        /* THE REPAIR (ChangeStructMemberLegacyTypes): a Struct that already carries them. Only member lines inside a
           Struct, only the type word - the comment and spacing stay; a line outside a Struct and a commented-out
           Struct are left alone. Run through the engine's own call, which masks comments and macro code first. */
        {Published = True}
        Procedure Win32Legacy_RepairStructMembers
            String[] asCode
            Integer iCount iFn iMacro iLost
            Move "Struct PEWindowOptions"            to asCode[0]
            Move "    Word StructSize"               to asCode[1]
            Move "    word hasGroupTree  // a flag"  to asCode[2]
            Move "    Byte bX"                       to asCode[3]
            Move "    Long lY"                       to asCode[4]
            Move "    DWord dwZ"                     to asCode[5]
            Move "End_Struct"                        to asCode[6]
            Move "Word wOutside"                     to asCode[7]
            Move "// Struct tOld"                    to asCode[8]
            Move "//    Word wCommented"             to asCode[9]
            Send ClearFuncLibProperties of ghoFuncLib
            Move (RefFunc(ChangeStructMemberLegacyTypes)) to iFn
            Get RunWholeFileFunction of ghoFuncLib iFn (&asCode) "" (&iMacro) (&iLost) to iCount
            Send AssertIAreEqual 4 iCount
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual "    UShort StructSize"              asCode[1]
            Send AssertSAreEqual "    UShort hasGroupTree  // a flag" asCode[2]
            Send AssertSAreEqual "    UChar bX"                       asCode[3]
            Send AssertSAreEqual "    Integer lY"                     asCode[4]
            Send AssertSAreEqual "    DWord dwZ"                      asCode[5]
            Send AssertSAreEqual "Word wOutside"                      asCode[7]
            Send AssertSAreEqual "//    Word wCommented"              asCode[9]
        End_Procedure

        /* THE SAME STRUCT NAMED ON THE WRONG PARAMETER PROVES NOTHING. The buffer goes to CreateThread's last
           argument, the thread id; SECURITY_ATTRIBUTES belongs to its first. "// refs:" could not tell them
           apart, so this Type must keep its own member types (a real package's RegInteger). */
        {Published = True}
        Procedure Win32Proof_ArgumentOfAnotherParameterIsNoProof
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Move 'External_Function grCreateThread "CreateThread" kernel32.dll Pointer lpAttr ULongPtr iStack Pointer pStart Pointer pParam Integer iFlags Pointer lpId Returns Handle' to asCode[0]
            Move "Type RegInteger"                                             to asCode[1]
            Move "    Field RegInteger.iValue as DWord"                        to asCode[2]
            Move "End_Type"                                                    to asCode[3]
            Move "Function Go Integer iAddr Returns Handle"                    to asCode[4]
            Move "    String sThreadID"                                        to asCode[5]
            Move "    Pointer lpThreadID"                                      to asCode[6]
            Move "    Handle hT"                                               to asCode[7]
            Move "    ZeroType RegInteger To sThreadID"                        to asCode[8]
            Move "    GetAddress of sThreadID to lpThreadID"                   to asCode[9]
            Move "    Move (grCreateThread(0, 0, iAddr, 0, 0, lpThreadID)) To hT" to asCode[10]
            Move "    Function_Return hT"                                      to asCode[11]
            Move "End_Function"                                                to asCode[12]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("nLength", sAll) = 0) sAll
            Send Assert (Pos("ITS OWN member types", sNotes) > 0) sNotes
        End_Procedure

        /* A TYPE NO NAME REACHES: "TYPE_INITCCEX" derives to nothing and two members is under the shape
           match's limit, so until now it kept its author's types. The call names the struct. */
        {Published = True}
        Procedure Win32Proof_CallReachesATypeNoNameDoes
            String[] asCode asNotes
            String sNotes
            Integer iCount
            Move 'External_Function InitCommonControlsEx "InitCommonControlsEx" comctl32.dll Pointer lpInit Returns Integer' to asCode[0]
            Move "Type TYPE_INITCCEX"                                          to asCode[1]
            Move "    Field TYPE_INITCCEX.dwSize As DWord"                     to asCode[2]
            Move "    Field TYPE_INITCCEX.dwICC As DWord"                      to asCode[3]
            Move "End_Type"                                                    to asCode[4]
            Move "Function Init Returns Integer"                               to asCode[5]
            Move "    String sInit"                                            to asCode[6]
            Move "    Integer iRet"                                            to asCode[7]
            Move "    ZeroType TYPE_INITCCEX to sInit"                         to asCode[8]
            Move "    Put TYPE_INITCCEX_SIZE to sInit at TYPE_INITCCEX.dwSize" to asCode[9]
            Move "    Move (InitCommonControlsEx(AddressOf(sInit))) to iRet"   to asCode[10]
            Move "    Function_Return iRet"                                    to asCode[11]
            Move "End_Function"                                                to asCode[12]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("from the Windows struct INITCOMMONCONTROLSEX", sNotes) > 0) sNotes
            Send Assert (Pos("ITS OWN member types", sNotes) = 0) sNotes
        End_Procedure

        /* A BUFFER TOO SHORT FOR WHAT WINDOWS WRITES. Three of MSG's members, handed to PeekMessageA, which
           writes the whole struct: the proof is what lets this become the real size. */
        {Published = True}
        Procedure Win32Proof_TooShortBufferHandedToTheApiGrows
            String[] asCode asNotes asLines
            String sAll
            Integer iCount
            Move "Struct tWinPoint"  to asLines[0]
            Move "    Integer x"     to asLines[1]
            Move "    Integer y"     to asLines[2]
            Move "End_Struct"        to asLines[3]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
            Move 'External_Function Peek "PeekMessageA" user32.dll Pointer lpMsg Handle hWnd Integer a Integer b Integer c Returns Integer' to asCode[0]
            Move "Type tMSG"                                                   to asCode[1]
            Move "    Field tMSG.hwnd    as Handle"                            to asCode[2]
            Move "    Field tMSG.message as Integer"                           to asCode[3]
            Move "    Field tMSG.wParam  as Integer"                           to asCode[4]
            Move "End_Type"                                                    to asCode[5]
            Move "Function F Returns Integer"                                  to asCode[6]
            Move "    String sMsg"                                             to asCode[7]
            Move "    Integer iRet"                                            to asCode[8]
            Move "    ZeroType tMSG To sMsg"                                   to asCode[9]
            Move "    Move (Peek(AddressOf(sMsg), 0, 0, 0, 0)) to iRet"        to asCode[10]
            Move "    Function_Return iRet"                                    to asCode[11]
            Move "End_Function"                                                to asCode[12]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("lParam", sAll) > 0) sAll
        End_Procedure

        /* A TAIL MEMBER WITH NO SHIPPED STRUCT IS WRITTEN AS ITS BYTES. pnid lists NOTIFYICONDATA's first members and is
           handed to Shell_NotifyIcon, and the rest of that struct holds a GUID DataFlex ships no struct for. No code
           can name a member past what the Type lists, so all it has to get right is the room it takes. */
        {Published = True}
        Procedure Win32Proof_TwinlessTailMemberIsWrittenAsBytes
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Move 'External_Function Shell_NotifyIcon "Shell_NotifyIcon" Shell32.dll DWord dwMessage Pointer pData Returns Integer' to asCode[0]
            Move "Type pnid"                                                   to asCode[1]
            Move "    Field pnid.cbSize           as DWord"                    to asCode[2]
            Move "    Field pnid.hWnd             as Handle"                   to asCode[3]
            Move "    Field pnid.uID              as Integer"                  to asCode[4]
            Move "    Field pnid.uFlags           as Integer"                  to asCode[5]
            Move "    Field pnid.uCallbackMessage as Integer"                  to asCode[6]
            Move "    Field pnid.hIcon            as Handle"                   to asCode[7]
            Move "    Field pnid.szTip            as Char 64"                  to asCode[8]
            Move "End_Type"                                                    to asCode[9]
            Move "Function F Returns Integer"                                  to asCode[10]
            Move "    String sNotify"                                          to asCode[11]
            Move "    Integer iRet"                                            to asCode[12]
            Move "    ZeroType pnid to sNotify"                                to asCode[13]
            Move "    Put pnid_SIZE to sNotify at pnid.cbSize"                 to asCode[14]
            Move "    Move (Shell_NotifyIcon(0, AddressOf(sNotify))) to iRet"  to asCode[15]
            Move "    Function_Return iRet"                                    to asCode[16]
            Move "End_Function"                                                to asCode[17]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("UChar[16] guidItem", sAll) > 0) sAll
            Send Assert (Pos("Handle hBalloonIcon", sAll) > 0) sAll
            Send Assert (Pos("Integer iMissingAlignment1", sAll) > 0) "hWnd at offset 8, as 64-bit Windows has it"
            Send Assert (Pos("ITS OWN member types", sNotes) = 0) sNotes
            Send Assert (Pos("guidItem", sNotes) > 0) sNotes
        End_Procedure

        /* A PROOF CAN ONLY ADD. A member the Type DOES list has code naming it, so it cannot become bytes: this Type
           lists all of NOTIFYICONDATA, GUID included, and has to carry on converting on its own member types. Two
           names differ so that the shape lookup misses as well: with every name agreeing it finds the same struct. */
        {Published = True}
        Procedure Win32Proof_TwinlessMemberTheTypeListsChangesNothing
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Move 'External_Function Shell_NotifyIcon "Shell_NotifyIcon" Shell32.dll DWord dwMessage Pointer pData Returns Integer' to asCode[0]
            Move "Type tTray"                                                  to asCode[1]
            Move "    Field tTray.cbSize           as DWord"                   to asCode[2]
            Move "    Field tTray.hWnd             as Handle"                  to asCode[3]
            Move "    Field tTray.iIconId          as Integer"                 to asCode[4]
            Move "    Field tTray.uFlags           as Integer"                 to asCode[5]
            Move "    Field tTray.uCallbackMessage as Integer"                 to asCode[6]
            Move "    Field tTray.hIcon            as Handle"                  to asCode[7]
            Move "    Field tTray.szTip            as Char 128"                to asCode[8]
            Move "    Field tTray.iIconState       as DWord"                   to asCode[9]
            Move "    Field tTray.dwStateMask      as DWord"                   to asCode[10]
            Move "    Field tTray.szInfo           as Char 256"                to asCode[11]
            Move "    Field tTray.UnionName1       as Char 4"                  to asCode[12]
            Move "    Field tTray.szInfoTitle      as Char 64"                 to asCode[13]
            Move "    Field tTray.dwInfoFlags      as DWord"                   to asCode[14]
            Move "    Field tTray.guidItem         as Char 16"                 to asCode[15]
            Move "    Field tTray.hBalloonIcon     as Handle"                  to asCode[16]
            Move "End_Type"                                                    to asCode[17]
            Move "Function F Returns Integer"                                  to asCode[18]
            Move "    String sNotify"                                          to asCode[19]
            Move "    Integer iRet"                                            to asCode[20]
            Move "    ZeroType tTray to sNotify"                               to asCode[21]
            Move "    Put tTray_SIZE to sNotify at tTray.cbSize"               to asCode[22]
            Move "    Move (Shell_NotifyIcon(0, AddressOf(sNotify))) to iRet"  to asCode[23]
            Move "    Function_Return iRet"                                    to asCode[24]
            Move "End_Function"                                                to asCode[25]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("ITS OWN member types", sNotes) > 0) sNotes
        End_Procedure

        // A harvested struct's size is the sum of its lines; a name it does not hold has none.
        {Published = True}
        Procedure Win32Proof_CatalogueSizesAStruct
            Integer iBytes
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get _Win32CatalogStructBytes of ghoFuncLib "Guid" to iBytes
            Send AssertIAreEqual 16 iBytes
            Get _Win32CatalogStructBytes of ghoFuncLib "NOSUCHSTRUCT" to iBytes
            Send AssertIAreEqual 0 iBytes
        End_Procedure

        /* THE REAL SHAPE OF A BUFFER CROSSING METHODS (2026-11-04): a tray icon package fills the Type in a Function that
           returns the bytes as a String, and a second variable carries them to Shell_NotifyIcon. */
        Procedure TrayFlowCluster String[] ByRef asCode
            Move 'External_Function Shell_NotifyIcon "Shell_NotifyIcon" SHELL32.DLL integer iMsg pointer pStuct returns integer' to asCode[0]
            Move "Type SYSTRAY_NOTIFY"                                         to asCode[1]
            Move "    field SYSTRAY_NOTIFY.cbSize As dWord"                    to asCode[2]
            Move "    field SYSTRAY_NOTIFY.hwnd As HANDLE"                     to asCode[3]
            Move "    field SYSTRAY_NOTIFY.uId As dWord"                       to asCode[4]
            Move "    field SYSTRAY_NOTIFY.uFlags As dWord"                    to asCode[5]
            Move "    field SYSTRAY_NOTIFY.uCallBackMessage As dWord"          to asCode[6]
            Move "    field SYSTRAY_NOTIFY.hIcon As HANDLE"                    to asCode[7]
            Move "    field SYSTRAY_NOTIFY.szTip As Char 64"                   to asCode[8]
            Move "End_Type"                                                    to asCode[9]
            Move "Procedure FillFromStruct string sStruct"                     to asCode[10]
            Move "    integer iTmp"                                            to asCode[11]
            Move "    string  sTmp"                                            to asCode[12]
            Move "    GetBuff from sStruct at SYSTRAY_NOTIFY.uId to iTmp"      to asCode[13]
            Move "    GetBuff_String from sStruct at SYSTRAY_NOTIFY.szTip to sTmp" to asCode[14]
            Move "End_Procedure"                                               to asCode[15]
            Move "Function CreateStruct returns string"                        to asCode[16]
            Move "    string sStruct"                                          to asCode[17]
            Move "    Zerotype SYSTRAY_Notify to sStruct"                      to asCode[18]
            Move "    Put SYSTRAY_NOTIFY_SIZE to sStruct at SYSTRAY_Notify.cbSize" to asCode[19]
            Move "    Put_String sTip to sStruct at SYSTRAY_Notify.szTip"      to asCode[20]
            Move "    Function_Return sStruct"                                 to asCode[21]
            Move "End_Function"                                                to asCode[22]
            Move "Function AddIcon Returns Integer"                            to asCode[23]
            Move "    string  sSystray_Notify"                                 to asCode[24]
            Move "    pointer pSystray_Notify"                                 to asCode[25]
            Move "    integer iRet iID"                                        to asCode[26]
            Move "    get CreateStruct of iID to sSystray_Notify"              to asCode[27]
            Move "    Move (AddressOf(sSystray_Notify)) to pSystray_Notify"    to asCode[28]
            Move "    Move (Shell_NotifyIcon(0, pSystray_Notify)) to iRet"     to asCode[29]
            Move "    Function_Return iRet"                                    to asCode[30]
            Move "End_Function"                                                to asCode[31]
        End_Procedure

        // The Function returns the Struct, the caller's variable receives one, and the API call proves which.
        {Published = True}
        Procedure Win32Flow_ReturnedBufferBecomesTheStruct
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("Function CreateStruct returns SYSTRAY_NOTIFY", sAll) > 0) sAll
            Send Assert (Pos("Function_Return sStruct", sAll) > 0) "the return stands as written"
            Send Assert (Pos("get CreateStruct of iID to sSystray_Notify", sAll) > 0) "the call stands as written"
            Send Assert (Pos("SYSTRAY_NOTIFY sSystray_Notify", sAll) > 0) "the receiver is a Struct"
            Send Assert (Pos("Move (AddressOf(sSystray_Notify)) to pSystray_Notify", sAll) > 0) sAll
            Send Assert (Pos("UChar[16] guidItem", sAll) > 0) "the whole Windows struct, proved through the receiver"
            Send Assert (Pos("Integer iMissingAlignment1", sAll) > 0) "hwnd at offset 8"
            Send Assert (Pos("Move (SizeOfType(SYSTRAY_NOTIFY)) to sStruct.cbSize", sAll) > 0) sAll
            Send Assert (Pos("createstruct returns it", sNotes) > 0) sNotes
        End_Procedure

        // A parameter nothing passes to becomes the Struct, and brings the locals a declaration would.
        {Published = True}
        Procedure Win32Flow_UncalledParameterBecomesTheStruct
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("Procedure FillFromStruct SYSTRAY_NOTIFY sStruct", sAll) > 0) sAll
            Send Assert (Pos("Move sStruct.uId to iTmp", sAll) > 0) sAll
            Send Assert (Pos("Integer sStructVoid", sAll) > 0) "the text accessor's scratch"
        End_Procedure

        /* IN A REAL RUN, with a file list. The tests above have none, so the name readers answer nothing, and that hid
           the first live run's refusal: the file being converted was its own reader of every method it defines. A
           file that defines the same name for itself reads nothing either; one that only calls it does, in the run
           or outside it. */
        {Published = True}
        Procedure Win32Flow_InARunAFileIsNotItsOwnCaller
            tRefactorSettings Settings Saved
            String[] asCode asNotes asOther asCaller asFolders asNone
            String sRoot sNotes2 sNotes3 sAll
            Integer iCount1 iCount2 iCount3 iCount4
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_FlowReaders\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Lib\"), False)) to bOk
            Send Assert bOk "the fixture folders"
            Send TrayFlowCluster (&asCode)
            Send _WriteLines (sRoot + "Tray.pkg") asCode
            Move "Procedure FillFromStruct Integer iOwn"  to asOther[0]
            Move "    Move iOwn to iOwn"                  to asOther[1]
            Move "End_Procedure"                          to asOther[2]
            Send _WriteLines (sRoot + "Lib\OwnMethod.pkg") asOther
            Move "Procedure UseIt"                        to asCaller[0]
            Move "    Send FillFromStruct of oTray sData" to asCaller[1]
            Move "End_Procedure"                          to asCaller[2]

            Get pRefactorSettings of ghoFuncLib to Saved
            Move Saved to Settings
            Move "*.pkg" to Settings.sFileFilter
            Move (ResizeArray(Settings.FileData.asFullFileNames, 0)) to Settings.FileData.asFullFileNames
            Move (sRoot + "Tray.pkg") to Settings.FileData.asFullFileNames[0]
            Set pRefactorSettings of ghoFuncLib to Settings
            Move (sRoot + "Lib\") to asFolders[0]
            Set pasOutsideReaderFolders of ghoFuncLib to asFolders

            // 1. Its own methods, and another file's method of the same name: it converts.
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount1
            Get AllLines asCode to sAll

            // 2. A file of the run calling the Function keeps it as it was.
            Send _WriteLines (sRoot + "Caller.pkg") asCaller
            Move "    Get CreateStruct of oTray to sData" to asCaller[1]
            Send _WriteLines (sRoot + "Caller.pkg") asCaller
            Move (sRoot + "Caller.pkg") to Settings.FileData.asFullFileNames[1]
            Set pRefactorSettings of ghoFuncLib to Settings
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (ResizeArray(asCode, 0)) to asCode
            Move (ResizeArray(asNotes, 0)) to asNotes
            Send TrayFlowCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount2
            Get _NotesText asNotes to sNotes2

            // 3. So does a file outside the run calling the parameter's method.
            Move (ResizeArray(Settings.FileData.asFullFileNames, 0)) to Settings.FileData.asFullFileNames
            Move (sRoot + "Tray.pkg") to Settings.FileData.asFullFileNames[0]
            Set pRefactorSettings of ghoFuncLib to Settings
            Move "    Send FillFromStruct of oTray sData" to asCaller[1]
            Send _WriteLines (sRoot + "Lib\Caller.pkg") asCaller
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (ResizeArray(asCode, 0)) to asCode
            Move (ResizeArray(asNotes, 0)) to asNotes
            Send TrayFlowCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount3
            Get _NotesText asNotes to sNotes3

            Set pRefactorSettings of ghoFuncLib to Saved
            Set pasOutsideReaderFolders of ghoFuncLib to asNone
            Set pbNameReadersBuilt    of ghoFuncLib to False
            Set pbOutsideReadersBuilt of ghoFuncLib to False
            Move (rfRemoveFolderTree(sRoot)) to bOk

            Send AssertIAreEqual 1 iCount1
            Send Assert (Pos("Procedure FillFromStruct SYSTRAY_NOTIFY sStruct", sAll) > 0) sAll
            Send Assert (Pos("Function CreateStruct returns SYSTRAY_NOTIFY", sAll) > 0) sAll
            Send AssertIAreEqual 0 iCount2
            Send Assert (Pos("Function_Return sStruct", sNotes2) > 0) sNotes2
            Send AssertIAreEqual 0 iCount3
            Send Assert (Pos("Procedure FillFromStruct", sNotes3) > 0) sNotes3
        End_Procedure

        // A caller's argument would have to be followed backwards, so a called method stays refused.
        {Published = True}
        Procedure Win32Flow_AParameterSomethingPassesToStaysRefused
            String[] asCode asNotes
            String sNotes
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Move "    Send FillFromStruct sSystray_Notify" to asCode[28]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("FillFromStruct", sNotes) > 0) sNotes
        End_Procedure

        // A Function that also returns something else cannot return the Struct.
        {Published = True}
        Procedure Win32Flow_AnotherReturnValueStaysRefused
            String[] asCode asNotes
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Move '    Function_Return ""' to asCode[20]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // An expression call has no variable to retype, so the Function stays as it is.
        {Published = True}
        Procedure Win32Flow_AnExpressionCallStaysRefused
            String[] asCode asNotes
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Move "    Move (CreateStruct(Self)) to sSystray_Notify" to asCode[27]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // A receiver that reads the bytes as text cannot become a Struct.
        {Published = True}
        Procedure Win32Flow_AReceiverUsedAsTextStaysRefused
            String[] asCode asNotes
            Integer iCount
            Send TrayFlowCluster (&asCode)
            Move "    Move (Length(sSystray_Notify)) to iRet" to asCode[30]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // A proof cannot open what fits nothing: eight members against MSG's six, or seven written out.
        {Published = True}
        Procedure Win32Proof_TypeThatFitsNothingStaysRefusedEvenWithACall
            String[] asCode asNotes
            Integer iCount
            Send SeedNestedStructs
            Move 'External_Function Peek "PeekMessageA" user32.dll Pointer lpMsg Handle hWnd Integer a Integer b Integer c Returns Integer' to asCode[0]
            Move "Type tMSG"                                                   to asCode[1]
            Move "    Field tMSG.hwnd    as Handle"                            to asCode[2]
            Move "    Field tMSG.message as Integer"                           to asCode[3]
            Move "    Field tMSG.wParam  as Integer"                           to asCode[4]
            Move "    Field tMSG.lParam  as Integer"                           to asCode[5]
            Move "    Field tMSG.time    as Integer"                           to asCode[6]
            Move "    Field tMSG.x       as Integer"                           to asCode[7]
            Move "    Field tMSG.y       as Integer"                           to asCode[8]
            Move "    Field tMSG.extra   as Integer"                           to asCode[9]
            Move "End_Type"                                                    to asCode[10]
            Move "Function F Returns Integer"                                  to asCode[11]
            Move "    String sMsg"                                             to asCode[12]
            Move "    Integer iRet"                                            to asCode[13]
            Move "    ZeroType tMSG To sMsg"                                   to asCode[14]
            Move "    Move (Peek(AddressOf(sMsg), 0, 0, 0, 0)) to iRet"        to asCode[15]
            Move "    Function_Return iRet"                                    to asCode[16]
            Move "End_Function"                                                to asCode[17]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        /* FLATTENED TYPES (2026-11-04). The nested structs the catalogue's MSG and WIN32_FIND_DATA name, from the
           install's tWinStructs.pkg, which a test run does not read by itself. */
        Procedure SeedNestedStructs
            String[] asLines
            Move "Struct tWinPoint"                to asLines[0]
            Move "    Integer x"                   to asLines[1]
            Move "    Integer y"                   to asLines[2]
            Move "End_Struct"                      to asLines[3]
            Move "Struct tWinFileTime"             to asLines[4]
            Move "    UInteger dwLowDateTime"      to asLines[5]
            Move "    UInteger dwHighDateTime"     to asLines[6]
            Move "End_Struct"                      to asLines[7]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
        End_Procedure

        // tMSG as a real test workspace writes it: ptX and ptY where MSG has one POINT pt.
        Procedure FlatMsgCluster String[] ByRef asCode
            Move "Type tMSG"                                                   to asCode[0]
            Move "    Field tMSG.hwnd    as Handle"                            to asCode[1]
            Move "    Field tMSG.message as Integer"                           to asCode[2]
            Move "    Field tMSG.wParam  as Integer"                           to asCode[3]
            Move "    Field tMSG.lParam  as Integer"                           to asCode[4]
            Move "    Field tMSG.Time    as DWord"                             to asCode[5]
            Move "    Field tMSG.ptX     as DWord"                             to asCode[6]
            Move "    Field tMSG.ptY     as DWord"                             to asCode[7]
            Move "End_Type"                                                    to asCode[8]
            Move "Function F Returns Integer"                                  to asCode[9]
            Move "    String sMsg"                                             to asCode[10]
            Move "    Integer iY"                                              to asCode[11]
            Move "    ZeroType tMSG To sMsg"                                   to asCode[12]
            Move "    Put 5 To sMsg At tMSG.ptX"                               to asCode[13]
            Move "    GetBuff From sMsg At tMSG.ptY To iY"                     to asCode[14]
            Move "    Function_Return iY"                                      to asCode[15]
            Move "End_Function"                                                to asCode[16]
        End_Procedure

        // The Type lists MSG's leaves one by one: it takes MSG's layout, and the accessors follow into pt.
        {Published = True}
        Procedure Win32Flat_WrittenOutMembersTakeTheWindowsLayout
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send SeedNestedStructs
            Send FlatMsgCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("tWinPoint pt", sAll) > 0) sAll
            Send Assert (Pos("LongPtr lParam", sAll) > 0) "the SDK's types, not the Type's"
            Send Assert (Pos("Move 5 to sMsg.pt.x", sAll) > 0) sAll
            Send Assert (Pos("Move sMsg.pt.y to iY", sAll) > 0) sAll
            Send Assert (Pos("ptX is now pt.x", sNotes) > 0) sNotes
        End_Procedure

        // Written with dots under the struct's own names, it needs no renaming at all.
        {Published = True}
        Procedure Win32Flat_DottedPathsThatMatchKeepTheirSpelling
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedNestedStructs
            Send FlatMsgCluster (&asCode)
            Move "    Field tMSG.pt.x    as DWord"                             to asCode[6]
            Move "    Field tMSG.pt.y    as DWord"                             to asCode[7]
            Move "    Put 5 To sMsg At tMSG.pt.x"                              to asCode[13]
            Move "    GetBuff From sMsg At tMSG.pt.y To iY"                    to asCode[14]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("Move 5 to sMsg.pt.x", sAll) > 0) sAll
            Send Assert (Pos("pt_x", sAll) = 0) sAll
        End_Procedure

        // The same count with the wrong widths only looks alike: a Word cannot be POINT's 4-byte x.
        {Published = True}
        Procedure Win32Flat_AWidthThatDisagreesStaysRefused
            String[] asCode asNotes
            Integer iCount
            Send SeedNestedStructs
            Send FlatMsgCluster (&asCode)
            Move "    Field tMSG.ptX     as Word"                              to asCode[6]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // No shipped struct for what it nests: the name would not compile, so it stays as written.
        {Published = True}
        Procedure Win32Flat_NoShippedTwinStaysRefused
            String[] asCode asNotes asLines
            Integer iCount
            Move "Struct tWinSomethingElse"  to asLines[0]
            Move "    Integer x"             to asLines[1]
            Move "End_Struct"                to asLines[2]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
            Send FlatMsgCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        Procedure FlatFindDataBlock String[] ByRef asCode String sType
            Move ("Type " + sType)                                              to asCode[0]
            Move ("    Field " + sType + ".dwFileAttributes As DWord")          to asCode[1]
            Move ("    Field " + sType + ".ftCreationLowDateTime As DWord")     to asCode[2]
            Move ("    Field " + sType + ".ftCreationHighDateTime As DWord")    to asCode[3]
            Move ("    Field " + sType + ".ftLastAccessLowDateTime As DWord")   to asCode[4]
            Move ("    Field " + sType + ".ftLastAccessHighDateTime As DWord")  to asCode[5]
            Move ("    Field " + sType + ".ftLastWriteLowDateTime As DWord")    to asCode[6]
            Move ("    Field " + sType + ".ftLastWriteHighDateTime As DWord")   to asCode[7]
            Move ("    Field " + sType + ".nFileSizeHigh As DWord")             to asCode[8]
            Move ("    Field " + sType + ".nFileSizeLow As DWord")              to asCode[9]
            Move ("    Field " + sType + ".dwReserved0 As DWord")               to asCode[10]
            Move ("    Field " + sType + ".dwReserved1 As DWord")               to asCode[11]
            Move ("    Field " + sType + ".cFileName As Char vMax_Path")        to asCode[12]
            Move ("    Field " + sType + ".cAlternateFileName As Char 14")      to asCode[13]
            Move "End_Type"                                                     to asCode[14]
        End_Procedure

        // Names that differ from the struct's are paired by position; plain members keep theirs.
        {Published = True}
        Procedure Win32Flat_DifferentNamesPairByPosition
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedNestedStructs
            Send FlatFindDataBlock (&asCode) "vWin32_Find_Data"
            Move "Function F Returns Integer"                                  to asCode[15]
            Move "    String sData"                                            to asCode[16]
            Move "    Integer iLow"                                            to asCode[17]
            Move "    ZeroType vWin32_Find_Data To sData"                      to asCode[18]
            Move "    GetBuff From sData At vWin32_Find_Data.ftCreationLowDateTime To iLow" to asCode[19]
            Move "    GetBuff From sData At vWin32_Find_Data.nFileSizeLow To iLow" to asCode[20]
            Move "    Function_Return iLow"                                    to asCode[21]
            Move "End_Function"                                                to asCode[22]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("tWinFileTime ftCreationTime", sAll) > 0) sAll
            Send Assert (Pos("Move sData.ftCreationTime.dwLowDateTime to iLow", sAll) > 0) sAll
            Send Assert (Pos("Move sData.nFileSizeLow to iLow", sAll) > 0) sAll
        End_Procedure

        // A call can name the struct a flattened Type's own name never would.
        {Published = True}
        Procedure Win32Flat_ACallProvesAFlattenedType
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send SeedNestedStructs
            Send FlatFindDataBlock (&asCode) "rs_Find_Data"
            Move 'External_Function FindFirstFile "FindFirstFileA" kernel32.dll Pointer lpName Pointer lpData Returns Handle' to asCode[15]
            Move "Function F String sPath Returns Handle"                      to asCode[16]
            Move "    String sData"                                            to asCode[17]
            Move "    Handle hFind"                                            to asCode[18]
            Move "    ZeroType rs_Find_Data To sData"                          to asCode[19]
            Move "    Move (FindFirstFile(0, AddressOf(sData))) to hFind"      to asCode[20]
            Move "    Function_Return hFind"                                   to asCode[21]
            Move "End_Function"                                                to asCode[22]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("tWinFileTime ftCreationTime", sAll) > 0) sAll
            Send Assert (Pos("FindFirstFile", sNotes) > 0) sNotes
        End_Procedure

        // A union is one byte block in the catalogue: eleven members against ten leaves stays refused.
        {Published = True}
        Procedure Win32Flat_AWrittenOutUnionStaysRefused
            String[] asCode asNotes
            String sNotes
            Integer iCount
            Send SeedNestedStructs
            Move "Type SYSTEM_INFO"                                            to asCode[0]
            Move "    Field SYSTEM_INFO.wProcessorArchitecture As Word"        to asCode[1]
            Move "    Field SYSTEM_INFO.wReserved As Word"                     to asCode[2]
            Move "    Field SYSTEM_INFO.dwPageSize As DWord"                   to asCode[3]
            Move "    Field SYSTEM_INFO.lpMinimumApplicationAddress As Pointer" to asCode[4]
            Move "    Field SYSTEM_INFO.lpMaximumApplicationAddress As Pointer" to asCode[5]
            Move "    Field SYSTEM_INFO.dwActiveProcessorMask As DWord"        to asCode[6]
            Move "    Field SYSTEM_INFO.dwNumberOfProcessors As DWord"         to asCode[7]
            Move "    Field SYSTEM_INFO.dwProcessorType As DWord"              to asCode[8]
            Move "    Field SYSTEM_INFO.dwAllocationGranularity As DWord"      to asCode[9]
            Move "    Field SYSTEM_INFO.wProcessorLevel As Word"               to asCode[10]
            Move "    Field SYSTEM_INFO.wProcessorRevision As Word"            to asCode[11]
            Move "End_Type"                                                    to asCode[12]
            Move "Function F Returns Integer"                                  to asCode[13]
            Move "    String sInfo"                                            to asCode[14]
            Move "    Integer iOut"                                            to asCode[15]
            Move "    ZeroType SYSTEM_INFO To sInfo"                           to asCode[16]
            Move "    GetBuff From sInfo At SYSTEM_INFO.dwPageSize To iOut"    to asCode[17]
            Move "    Function_Return iOut"                                    to asCode[18]
            Move "End_Function"                                                to asCode[19]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("lists 11 members", sNotes) > 0) sNotes
        End_Procedure

        /* A DOTTED TYPE THE CATALOGUE DOES NOT KNOW keeps its own member types with the dots joined. The bytes do
           not move, because a Struct is packed under the same offset rule as a Type. This was tLVHITTESTINFO until
           the catalogue learnt that struct (Win32Msg_HitTestTypeBecomesTheWholeStruct). */
        {Published = True}
        Procedure Win32Flat_DottedTypeNoCatalogueKnowsJoinsItsNames
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Move "Type tMyHitSpot"                                             to asCode[0]
            Move "    Field tMyHitSpot.PT.x as DWord"                          to asCode[1]
            Move "    Field tMyHitSpot.PT.y as DWord"                          to asCode[2]
            Move "    Field tMyHitSpot.flags as DWord"                         to asCode[3]
            Move "    Field tMyHitSpot.iItem as DWord"                         to asCode[4]
            Move "End_Type"                                                    to asCode[5]
            Move "Function F Integer iX Returns Integer"                       to asCode[6]
            Move "    String sHit"                                             to asCode[7]
            Move "    Integer iItem"                                           to asCode[8]
            Move "    ZeroType tMyHitSpot To sHit"                             to asCode[9]
            Move "    Put iX To sHit At tMyHitSpot.PT.x"                       to asCode[10]
            Move "    GetBuff From sHit At tMyHitSpot.iItem To iItem"          to asCode[11]
            Move "    Function_Return iItem"                                   to asCode[12]
            Move "End_Function"                                                to asCode[13]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("DWord PT_x", sAll) > 0) sAll
            Send Assert (Pos("Move iX to sHit.PT_x", sAll) > 0) sAll
            Send Assert (Pos("Move sHit.iItem to iItem", sAll) > 0) sAll
            Send Assert (Pos("PT.x is now PT_x", sNotes) > 0) sNotes
            Send Assert (Pos("ITS OWN member types", sNotes) > 0) sNotes
        End_Procedure

        // A joined name another member already has stays refused, rather than declaring it twice.
        {Published = True}
        Procedure Win32Flat_JoinedNameThatIsTakenStaysRefused
            String[] asCode asNotes
            Integer iCount
            Move "Type tThing"                                                 to asCode[0]
            Move "    Field tThing.PT.x as DWord"                              to asCode[1]
            Move "    Field tThing.PT_x as DWord"                              to asCode[2]
            Move "End_Type"                                                    to asCode[3]
            Move "Function F Returns Integer"                                  to asCode[4]
            Move "    String sHit"                                             to asCode[5]
            Move "    ZeroType tThing To sHit"                                 to asCode[6]
            Move "    Function_Return 0"                                       to asCode[7]
            Move "End_Function"                                                to asCode[8]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
        End_Procedure

        // The SDK's name finds the install's struct, and so does the install's own name.
        {Published = True}
        Procedure Win32Flat_ShippedStructFoundUnderEitherName
            String sOut
            Send SeedNestedStructs
            Get _ShippedStructNameFor of ghoFuncLib "POINT" to sOut
            Send AssertSAreEqual "tWinPoint" sOut
            Get _ShippedStructNameFor of ghoFuncLib "tWinPoint" to sOut
            Send AssertSAreEqual "tWinPoint" sOut
            Get _ShippedStructNameFor of ghoFuncLib "NOSUCH" to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        // The operand changes; the value, the buffer, the comment and every other line do not.
        {Published = True}
        Procedure Win32Flat_RemapTouchesOnlyTheAtOperand
            String[] asStmt asMap
            Move "    Put ptX To sBuf At tMSG.ptX // keep"     to asStmt[0]
            Move "    GetBuff From sBuf At ptY To iY"          to asStmt[1]
            Move "    Move ptX to iOther"                      to asStmt[2]
            Move "ptX|pt.x"                                    to asMap[0]
            Move "ptY|pt.y"                                    to asMap[1]
            Send _RemapAtOperands of ghoFuncLib (&asStmt) "tMSG" (&asMap)
            Send AssertSAreEqual "    Put ptX To sBuf At tMSG.pt.x // keep" asStmt[0]
            Send AssertSAreEqual "    GetBuff From sBuf At pt.y To iY" asStmt[1]
            Send AssertSAreEqual "    Move ptX to iOther" asStmt[2]
        End_Procedure

        // The tail answers per argument, and the old reader of the row before it is not disturbed.
        {Published = True}
        Procedure Win32Proof_ArgsTailAnswersPerArgument
            String sRow sOut
            Move 'DF|External_Function X "X" U.dll Pointer a Pointer b Returns Integer // refs: AA BB // args: 1=AA 12=BB' to sRow
            Get _WinAPIArgStructOf of ghoFuncLib sRow 1 to sOut
            Send AssertSAreEqual "AA" sOut
            Get _WinAPIArgStructOf of ghoFuncLib sRow 12 to sOut
            Send AssertSAreEqual "BB" sOut
            Get _WinAPIArgStructOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "" sOut
            Get _WinAPIRefsOf of ghoFuncLib sRow to sOut
            Send AssertSAreEqual "AA BB" sOut
        End_Procedure

        // The shipped catalogue carries the tail - a bare alias row included, since pnid's API is one.
        {Published = True}
        Procedure Win32Proof_CatalogueNamesTheStructPerParameter
            String sRow sOut
            Get WinAPIPrototype of ghoFuncLib "user32.dll" "InsertMenuItemA" to sRow
            Get _WinAPIArgStructOf of ghoFuncLib sRow 4 to sOut
            Send AssertSAreEqual "MENUITEMINFOA" sOut
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "CreateThread" to sRow
            Get _WinAPIArgStructOf of ghoFuncLib sRow 1 to sOut
            Send AssertSAreEqual "SECURITY_ATTRIBUTES" sOut
            Get _WinAPIArgStructOf of ghoFuncLib sRow 6 to sOut
            Send AssertSAreEqual "" sOut
            Get WinAPIPrototype of ghoFuncLib "shell32.dll" "Shell_NotifyIcon" to sRow
            Get _WinAPIArgStructOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "NOTIFYICONDATAA" sOut
        End_Procedure

        // Outside parentheses the size stands alone and needs its own pair; inside it does not.
        {Published = True}
        Procedure Win32Proof_SizeSymbolAloneGetsItsOwnParentheses
            String sOut
            Get _ReplaceTypeSizeSymbol of ghoFuncLib "    Move T_SIZE to x" "T" to sOut
            Send AssertSAreEqual "    Move (SizeOfType(T)) to x" sOut
            Get _ReplaceTypeSizeSymbol of ghoFuncLib "    Move (T_SIZE + 1) to x" "T" to sOut
            Send AssertSAreEqual "    Move (SizeOfType(T) + 1) to x" sOut
        End_Procedure

        // Only the buffer commands are joined, and every index still means the same line.
        {Published = True}
        Procedure Win32Proof_JoinTouchesOnlyBufferCommands
            String[] asCode asOut
            Move "    Put (1+2) ;"          to asCode[0]
            Move "        to sBuf at T.m"   to asCode[1]
            Move "    Move (Foo(1, ;"       to asCode[2]
            Move "        2)) to iX"        to asCode[3]
            Get _JoinedBufferCommands of ghoFuncLib (&asCode) to asOut
            Send AssertIAreEqual 4 (SizeOfArray(asOut))
            Send AssertSAreEqual "    Put (1+2) to sBuf at T.m" asOut[0]
            Send AssertSAreEqual "" asOut[1]
            Send AssertSAreEqual "    Move (Foo(1, ;" asOut[2]
            Send AssertSAreEqual "        2)) to iX" asOut[3]
        End_Procedure

        /* A TYPE THE FILE READS BYTE BY BYTE STAYS A TYPE (2026-10-31): ConvertWinAPIDeclarationTypes turned a
           printer dialog's PRINTDLG into a Struct while 'GetBuff From s at PRINTDLG.hDevNames' stayed, and nothing
           that used the package compiled. A member offset, the _SIZE symbol and ZeroType each keep the Type, with a
           note; the same block with none of them, or with the name only in a comment, still converts. */
        {Published = True}
        Procedure Win32Types_ByteWiseUseKeepsTheType
            String[] asBlock asCode asNotes asUse
            String sNotes
            Integer iCount i j
            Move "Type POINT"                   to asBlock[0]
            Move "    Field POINT.x as dWord"   to asBlock[1]
            Move "    Field POINT.y as dWord"   to asBlock[2]
            Move "End_Type // POINT"            to asBlock[3]
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Move asBlock to asCode
            Move "    // GetBuff From sPt at POINT.y to iY"   to asCode[4]
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "    GetBuff From sPt at POINT.y to iY"  to asUse[0]
            Move "    Put 1 to sPt at POINT.x"            to asUse[1]
            Move "    Move POINT_SIZE to iLen"            to asUse[2]
            Move "    ZeroType POINT to sPt"              to asUse[3]
            For j from 0 to 3
                Move asBlock to asCode
                Move "Procedure ReadPoint"  to asCode[4]
                Move asUse[j]               to asCode[5]
                Move "End_Procedure"        to asCode[6]
                Move (ResizeArray(asNotes, 0)) to asNotes
                Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
                Send AssertIAreEqual 0 iCount
                Send AssertSAreEqual "Type POINT" asCode[0]
                Move "" to sNotes
                For i from 0 to (SizeOfArray(asNotes) - 1)
                    Move (sNotes + asNotes[i] + " | ") to sNotes
                Loop
                Send Assert (Pos("POINT: left as written - line 6", sNotes) > 0) (Trim(asUse[j]) + " - notes: " + sNotes)
            Loop
        End_Procedure

        /* ONE UNRECOGNISED USE REFUSES THE WHOLE CLUSTER, and leaves every other line untouched.
           Half a conversion would make a Struct and a byte buffer the same variable - which compiles
           for a while and then does not. The note names the line. */
        {Published = True}
        Procedure Win32Convert_OneForeignUseRefusesTheCluster
            String[] asCode asNotes asBefore
            Integer iCount i
            Boolean bSame
            Send BrowseCluster (&asCode)
            Move "  Move (CString(sBrowseInfo)) to sOther" to asCode[17]
            Move "End_Function"                           to asCode[18]
            Move asCode to asBefore
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual (SizeOfArray(asBefore)) (SizeOfArray(asCode))
            Move True to bSame
            For i from 0 to (SizeOfArray(asBefore) - 1)
                If (asBefore[i] <> asCode[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame
            Send Assert (SizeOfArray(asNotes) > 0)
        End_Procedure

        /* THE SIBLINGS STAY PUT. Real code declares its locals together, and on the first live run
           NOT ONE buffer in the workspace was declared on its own - "String sFolder sBrowseInfo
           sTitle" is the shape, so a converter that only handled "String sBrowseInfo" converted
           nothing at all. The buffer is lifted onto its own line and its neighbours keep their type,
           their order and their line. */
        {Published = True}
        Procedure Win32Convert_BufferLiftedOutOfASharedDeclaration
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            // the siblings survive together, without the buffer
            Send Assert (Pos("String sFolder sTitle", sAll) > 0)
            // and the buffer is a struct variable on its own line, with its companion
            Send Assert (Pos("vtBrowseInfo sBrowseInfo" + (Character(10)), sAll) > 0)
            Send Assert (Pos("vtBrowseInfo sBrowseInfoEmpty", sAll) > 0)
        End_Procedure

        /* A FAILING TYPE MUST NOT GUT A SUCCEEDING ONE. Two Types in one file, the second of them
           unconvertible - which is what the very first live run met, and what it did there was the
           worst outcome this converter can produce: it emitted the Struct for the GOOD Type,
           commented that Type block out, and then wiped the accessor rewrites belonging to it. The
           file was left declaring a Struct whose Type was gone while ZeroType and Put..At still
           stood on the name. It could not compile, and the run reported success.

           No single-Type fixture can produce that shape, which is exactly why it survived to a live
           workspace. Each Type now stages its decisions and merges them only on its own success. */
        {Published = True}
        Procedure Win32Convert_AFailingTypeLeavesTheGoodOneWhole
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            // a second, catalogued Type whose buffer is used in a way the converter refuses
            Move "Type vtSecurity_Attributes"                                  to asCode[18]
            Move "  Field vtSecurity_Attributes.nLength        as dWord"       to asCode[19]
            Move "  Field vtSecurity_Attributes.lpDescriptor   as Pointer"     to asCode[20]
            Move "  Field vtSecurity_Attributes.bInheritHandle as Integer"     to asCode[21]
            Move "End_Type"                                                   to asCode[22]
            Move "Function Other Returns Integer"                             to asCode[23]
            Move "  String sSec"                                              to asCode[24]
            Move "  ZeroType vtSecurity_Attributes To sSec"                   to asCode[25]
            Move "  Move (CString(sSec)) to sJunk"                            to asCode[26]
            Move "End_Function"                                               to asCode[27]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            // the GOOD Type converted, WHOLE - block and accessors together
            Send AssertIAreEqual 1 iCount
            Send Assert (Pos("Struct vtBrowseInfo", sAll) > 0)
            Send Assert (Pos("// Type vtBrowseInfo", sAll) > 0)
            Send Assert (Pos("Move sBrowseInfoEmpty to sBrowseInfo", sAll) > 0)
            Send Assert (Pos("Move lpsTitle to sBrowseInfo.lpszTitle", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(sBrowseInfo)) to lpsBrowseInfo", sAll) > 0)
            // NOTHING of the good Type left behind in byte-level form
            Send Assert (Pos("ZeroType vtBrowseInfo", sAll) = 0)
            Send Assert (Pos("Put lpsTitle To", sAll) = 0)
            // the BAD Type untouched in every respect, and said so
            Send Assert (Pos("Type vtSecurity_Attributes", sAll) > 0)
            Send Assert (Pos("// Type vtSecurity_Attributes", sAll) = 0)
            Send Assert (Pos("ZeroType vtSecurity_Attributes To sSec", sAll) > 0)
            Send Assert (SizeOfArray(asNotes) > 0)
        End_Procedure

        /* EVERY REFUSAL IN A FILE SURVIVES TO THE SUMMARY. Two Types, both refused, must yield TWO
           notes. They did not: the catalogue lookup resizes the notes array it is handed to zero -
           that parameter is its own output - so passing the run notes through it wiped everything
           recorded before the next Type was looked up. On the first live run two Types were declined
           in total silence, which is the one thing a refusal must never be. */
        {Published = True}
        Procedure Win32Convert_EveryRefusalKeepsItsNote
            String[] asCode asNotes
            Integer iCount
            // two catalogued Types, each with a buffer used in a way the converter refuses
            Move "Type vtBrowseInfo"                                       to asCode[0]
            Move "  Field vtBrowseInfo.hWndOwner      as Handle"           to asCode[1]
            Move "  Field vtBrowseInfo.pIDLRoot       as Pointer"          to asCode[2]
            Move "  Field vtBrowseInfo.pszDisplayName as Pointer"          to asCode[3]
            Move "  Field vtBrowseInfo.lpszTitle      as Pointer"          to asCode[4]
            Move "  Field vtBrowseInfo.ulFlags        as dWord"            to asCode[5]
            Move "  Field vtBrowseInfo.lpfnCallback   as Pointer"          to asCode[6]
            Move "  Field vtBrowseInfo.lParam         as dWord"            to asCode[7]
            Move "  Field vtBrowseInfo.iImage         as dWord"            to asCode[8]
            Move "End_Type"                                               to asCode[9]
            Move "Type vtSecurity_Attributes"                              to asCode[10]
            Move "  Field vtSecurity_Attributes.nLength        as dWord"   to asCode[11]
            Move "  Field vtSecurity_Attributes.lpDescriptor   as Pointer" to asCode[12]
            Move "  Field vtSecurity_Attributes.bInheritHandle as Integer" to asCode[13]
            Move "End_Type"                                               to asCode[14]
            Move "Function F Returns Integer"                              to asCode[15]
            Move "  String sB sSec"                                        to asCode[16]
            Move "  ZeroType vtBrowseInfo To sB"                           to asCode[17]
            Move "  Move (CString(sB)) to sJunk"                           to asCode[18]
            Move "  ZeroType vtSecurity_Attributes To sSec"                to asCode[19]
            Move "  Move (CString(sSec)) to sJunk"                         to asCode[20]
            Move "End_Function"                                           to asCode[21]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            // ONE note per refused Type - not just whichever was refused last
            Send AssertIAreEqual 2 (SizeOfArray(asNotes))
        End_Procedure

        /* A TYPE THIS FILE NEVER DECLARES, mapped onto the struct the INSTALL ships. Taken from a
           real workspace: tWindowPlacement lived in Dftypes.pkg, DataFlex marks that package
           obsolete, a modernised workspace stopped including it - and these three lines have been
           undefined-symbol errors in the build ever since. Nothing could reach them: there is no
           Type block to convert, so the pass that walks Type blocks never sees them.

           Nothing is emitted or commented out here; tWinWindowPlacement already exists in the
           install. Only the buffer declaration and the accessors move - and the legacy
           <Type>_size symbol, which a Struct does not provide, becomes SizeOfType exactly as the
           install own Dfadlg.pkg writes it. */
        {Published = True}
        Procedure Win32Convert_InstallStructWithLocalAccessors
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send SeedWinStructs
            Move "Procedure DoSave"                                                              to asCode[0]
            Move "        String sWindowPlacement"                                               to asCode[1]
            Move "        Pointer pWp"                                                           to asCode[2]
            Move "        ZeroType tWindowPlacement to sWindowPlacement"                         to asCode[3]
            Move "        Put tWindowPlacement_size to sWindowPlacement at tWindowPlacement.length" to asCode[4]
            Move "        GetAddress of sWindowPlacement to pWp"                                 to asCode[5]
            Move "End_Procedure"                                                                 to asCode[6]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            // the buffer takes the SHIPPED struct type, not a locally invented one
            Send Assert (Pos("tWinWindowPlacement sWindowPlacement", sAll) > 0)
            Send Assert (Pos("tWinWindowPlacement sWindowPlacementEmpty", sAll) > 0)
            // the accessors become struct access
            Send Assert (Pos("Move sWindowPlacementEmpty to sWindowPlacement", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(sWindowPlacement)) to pWp", sAll) > 0)
            // the legacy size symbol becomes the modern one
            Send Assert (Pos("SizeOfType(tWinWindowPlacement)", sAll) > 0)
            Send Assert (Pos("tWindowPlacement_size", sAll) = 0)
            // nothing byte-level survives, and NO struct was emitted - the install already has it
            Send Assert (Pos("ZeroType", sAll) = 0)
            Send Assert (Pos("Put ", sAll) = 0)
            Send Assert (Pos("Struct tWin", sAll) = 0)
        End_Procedure

        // A Type with no local block and NO shipped struct is refused, with a reason.
        {Published = True}
        Procedure Win32Convert_OrphanWithNoShippedStructRefused
            String[] asCode asNotes
            Integer iCount
            Send SeedWinStructs
            Move "Procedure P"                                            to asCode[0]
            Move "        String sBuf"                                    to asCode[1]
            Move "        ZeroType tNoSuchWindowsThing to sBuf"           to asCode[2]
            Move "End_Procedure"                                          to asCode[3]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (SizeOfArray(asNotes) > 0)
        End_Procedure

        /* COMMENTED-OUT LINES ARE NOT CODE. Both of these came back as refusals on the first
           workspace that had any: a commented Field line read as a malformed declaration, and a
           commented accessor read as an unrewritable use of the buffer. The cause was searching the
           MASKED line for "//" - _MaskStatementLine turns the "//" itself into "##", so it is never
           found there and every commented line looked live. */
        {Published = True}
        Procedure Win32Convert_CommentedLinesAreNotCode
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            // a commented-out Field inside the block, and a commented-out accessor after it
            Move "  //Field vtBrowseInfo.dmPanningWidth  as dWord"   to asCode[18]
            Move "  //Put lpsTitle To sBrowseInfo At vtBrowseInfo.x" to asCode[19]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            // neither line stops the conversion, and neither produces a refusal
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            // and they survive verbatim - a converter does not edit what is commented out
            Send Assert (Pos("//Field vtBrowseInfo.dmPanningWidth", sAll) > 0)
            Send Assert (Pos("//Put lpsTitle To sBrowseInfo At vtBrowseInfo.x", sAll) > 0)
        End_Procedure

        // A "//" INSIDE a string literal is not a comment - the stripper is quote-aware, and a
        // converter that truncated there would silently drop half a statement.
        {Published = True}
        Procedure Win32Convert_SlashesInsideAStringAreNotAComment
            String sIndent sCode sComment
            Send _SplitIndentCodeComment of ghoFuncLib ;
                ("    Move " + (Character(34)) + "http://x" + (Character(34)) + " to sUrl  // real") ;
                (&sIndent) (&sCode) (&sComment)
            Send Assert (Pos("http://x", sCode) > 0)
            Send AssertSAreEqual "  // real" sComment
        End_Procedure

        /* THROUGH THE PUBLISHED FUNCTION, not the core - because the bug this pins lived in the
           wrapper, where none of the other tests go.

           ChangeExternalFunctionCallers opens with a cheap raw gate so it can leave most files
           alone without reading them properly. That gate asked for "end_type" - and the second pass
           exists precisely for files with NO Type block, where the declaration lived in an obsolete
           install package and only the accessors remain. So it skipped exactly the population that
           pass was written for: a real file was reported neither converted nor refused, which is
           worse than either, and every core-level test passed throughout (2026-08-30). */
        {Published = True}
        Procedure Win32Convert_NoTypeBlockStillReachesTheConverter
            String[] asCode
            Integer iCount
            Send SeedWinStructs
            // not one End_Type anywhere - only accessors
            Move "Procedure DoSave"                                          to asCode[0]
            Move "        String sWp"                                        to asCode[1]
            Move "        Pointer pWp"                                       to asCode[2]
            Move "        ZeroType tWindowPlacement to sWp"                  to asCode[3]
            Move "        GetAddress of sWp to pWp"                          to asCode[4]
            Move "End_Procedure"                                             to asCode[5]
            Get ChangeExternalFunctionCallers of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
        End_Procedure

        /* THE TWO ERAS IN ONE PROCEDURE. Real legacy code does this - the file that prompted the
           test has ZeroType and Put..At on a buffer whose address is ALREADY taken the modern way,
           three lines apart. Calling that modern line "a use this converter does not rewrite"
           refused a cluster that was most of the way converted already. */
        {Published = True}
        Procedure Win32Convert_ModernLineAmongLegacyOnesIsAccepted
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send SeedWinStructs
            Move "Procedure DoSave"                                             to asCode[0]
            Move "        String sWp"                                           to asCode[1]
            Move "        Pointer aWp"                                          to asCode[2]
            Move "        ZeroType tWindowPlacement to sWp"                     to asCode[3]
            Move "        Move (AddressOf(sWp)) to aWp"                         to asCode[4]
            Move "End_Procedure"                                                to asCode[5]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            Send Assert (Pos("tWinWindowPlacement sWp", sAll) > 0)
            Send Assert (Pos("Move sWpEmpty to sWp", sAll) > 0)
            // the already-modern line is untouched, not rewritten and not refused
            Send Assert (Pos("Move (AddressOf(sWp)) to aWp", sAll) > 0)
        End_Procedure

        /* RUNNING IT TWICE CHANGES NOTHING. A converter that refuses its own output cannot be run
           over a workspace that is half done - which is every workspace after the first run. */
        {Published = True}
        Procedure Win32Convert_SecondRunIsANoOp
            String[] asCode asNotes asAfter
            Integer iFirst iSecond i
            Boolean bSame
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iFirst
            Send AssertIAreEqual 1 iFirst
            Move asCode to asAfter
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iSecond
            Send AssertIAreEqual 0 iSecond
            Send AssertIAreEqual (SizeOfArray(asAfter)) (SizeOfArray(asCode))
            Move True to bSame
            For i from 0 to (SizeOfArray(asAfter) - 1)
                If (asAfter[i] <> asCode[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame
        End_Procedure

        /* ONE BUFFER NAME, TWO PROCEDURES. The same local declared twice is two declarations of one
           name, and both have to become struct variables - lifting only the first leaves a Struct in
           one method and a String in the next, and the walk then meets that second declaration as an
           unrewritable use and refuses the whole cluster. That is what DEVNAMES did on a real
           workspace: "line 733 uses those bytes in a way this converter does not rewrite -
           String sDevNames sHeap", which is a DECLARATION, not a use. */
        {Published = True}
        Procedure Win32Convert_SameBufferDeclaredInTwoProcedures
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send SeedWinStructs
            Move "Procedure First"                                     to asCode[0]
            Move "        String sWp"                                  to asCode[1]
            Move "        ZeroType tWindowPlacement to sWp"            to asCode[2]
            Move "End_Procedure"                                       to asCode[3]
            Move "Procedure Second"                                    to asCode[4]
            Move "        String sWp sHeap"                            to asCode[5]
            Move "        Pointer p"                                   to asCode[6]
            Move "        GetAddress of sWp to p"                      to asCode[7]
            Move "End_Procedure"                                       to asCode[8]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + Trim(asCode[i]) + (Character(10))) to sAll
            Loop
            // BOTH declarations lifted - not one String declaration of the buffer left anywhere -
            // and the sibling that shared the second line kept its own type.
            Send Assert (Pos("tWinWindowPlacement sWp", sAll) > 0)
            Send Assert (Pos("String sWp", sAll) = 0)
            Send Assert (Pos("String sHeap", sAll) > 0)
        End_Procedure

        /* WIDTH IS LAYOUT. The shared C-type mapper widens everything narrower than Integer, on
           purpose and correctly, for External_Function PARAMETERS - Win32 promotes them to 32 bits
           on the stack regardless. For a struct MEMBER the width is the layout, and widening moves
           every member after it.

           DEVNAMES is four WORDs. Widened it became four Integers: sixteen bytes where Windows reads
           eight, wDefault at offset 12 instead of 6 - and the legacy Type block being converted had
           it RIGHT, declaring Word. The conversion made a correct file wrong, which is the one
           outcome this campaign exists to prevent. Found by reading a live run OUTPUT, not its
           summary, which said only "1 lines Converted ... Process completed OK". */
        {Published = True}
        Procedure Win32Width_StructMembersKeepTheirExactWidth
            Send AssertSAreEqual "UShort" (_CTypeToDataFlexExactWidth(ghoFuncLib, "WORD", 0))
            Send AssertSAreEqual "UShort" (_CTypeToDataFlexExactWidth(ghoFuncLib, "USHORT", 0))
            Send AssertSAreEqual "Short"  (_CTypeToDataFlexExactWidth(ghoFuncLib, "SHORT", 0))
            Send AssertSAreEqual "UChar"  (_CTypeToDataFlexExactWidth(ghoFuncLib, "BYTE", 0))
            Send AssertSAreEqual "Char"   (_CTypeToDataFlexExactWidth(ghoFuncLib, "CHAR", 0))
            // BOOL really IS a 32-bit int in Win32 - widening that one is correct, not a slip
            Send AssertSAreEqual "Integer" (_CTypeToDataFlexExactWidth(ghoFuncLib, "BOOL", 0))
            // a POINTER to any of them is pointer-sized, whatever it points at
            Send AssertSAreEqual "Pointer" (_CTypeToDataFlexExactWidth(ghoFuncLib, "WORD", 1))
        End_Procedure

        // The shared mapper is UNCHANGED - parameter declarations elsewhere still widen, which is
        // what they were built on and what the install itself does.
        {Published = True}
        Procedure Win32Width_ParameterMapperStillWidens
            Send AssertSAreEqual "Integer" (_CTypeToDataFlex(ghoFuncLib, "WORD", 0, False))
            Send AssertSAreEqual "Integer" (_CTypeToDataFlex(ghoFuncLib, "BYTE", 0, False))
        End_Procedure

        /* ---- THE SECOND WAY IN: finding the struct by its MEMBER NAMES ------------------------
           The catalogue is keyed on the SDK name, and the lookup gets there by stripping a house
           prefix (T, TAG, V, VT, _). That finds vtBrowseInfo -> BROWSEINFO and never finds a Type
           the developer named for their own code: ProcessMessages.pkg declares "Type tPrMsg" for
           the Win32 MSG struct (Nils 2026-09-01). These pin the fallback and, just as importantly,
           the two guards that stop it guessing. */

        // One catalogue row, in the stored "NAME|DF|Struct NAME<LF>member<LF>...<LF>End_Struct" form.
        Function CatRow String sName String[] asMemberLines Returns String
            String sRow
            Integer i iLast
            Move (sName + "|DF|Struct " + sName) to sRow
            Move (SizeOfArray(asMemberLines) - 1) to iLast
            For i from 0 to iLast
                Move (sRow + (Character(10)) + asMemberLines[i]) to sRow
            Loop
            Function_Return (sRow + (Character(10)) + "End_Struct")
        End_Function

        // The real MSG row, alignment members included - they are what a legacy Type cannot write.
        Function MsgRow Returns String
            String[] asM
            Move "Handle hwnd  // HWND"          to asM[0]
            Move "UInteger message"              to asM[1]
            Move "Integer iMissingAlignment1"    to asM[2]
            Move "ULongPtr wParam  // WPARAM"    to asM[3]
            Move "LongPtr lParam  // LPARAM"     to asM[4]
            Move "UInteger time"                 to asM[5]
            Move "POINT pt"                      to asM[6]
            Move "Integer iMissingAlignment2"    to asM[7]
            Function_Return (CatRow(Self, "MSG", asM))
        End_Function

        // tPrMsg's members, exactly as ProcessMessages.pkg declares them.
        Function PrMsgMembers Returns String[]
            String[] asN
            Move "hwnd"    to asN[0]
            Move "message" to asN[1]
            Move "wParam"  to asN[2]
            Move "lParam"  to asN[3]
            Move "Time"    to asN[4]
            Move "pt"      to asN[5]
            Function_Return asN
        End_Function

        // THE ALIGNMENT MEMBERS ARE NOT PART OF THE SHAPE. A legacy Type block has no way to write
        // padding, so counting the catalogue's fillers could never match one.
        {Published = True}
        Procedure Shape_MemberNamesSkipTheAlignmentFillers
            String[] asMembers
            Get _CatalogRowMemberNames of ghoFuncLib (MsgRow(Self)) to asMembers
            Send AssertIAreEqual 6 (SizeOfArray(asMembers))
            Send AssertSAreEqual "hwnd"    asMembers[0]
            Send AssertSAreEqual "message" asMembers[1]
            Send AssertSAreEqual "wParam"  asMembers[2]
            Send AssertSAreEqual "lParam"  asMembers[3]
            Send AssertSAreEqual "time"    asMembers[4]
            Send AssertSAreEqual "pt"      asMembers[5]
        End_Procedure

        // THE REPORTED CASE: tPrMsg finds MSG, which its name never could.
        {Published = True}
        Procedure Shape_PrMsgFindsMsgByItsMembers
            String[] asCat asSaved asOther
            String sHit
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            // A near miss sits beside it: same first member, different shape. It must not match,
            // and it exercises the cheap first-member pre-gate that lets the real rows through.
            Move "Handle hwnd"     to asOther[0]
            Move "Integer iLeft"   to asOther[1]
            Move "Integer iTop"    to asOther[2]
            Move "Integer iRight"  to asOther[3]
            Move (MsgRow(Self))                          to asCat[0]
            Move (CatRow(Self, "NEARMISS", asOther))     to asCat[1]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Get WinAPIStructNameByMemberShape of ghoFuncLib (PrMsgMembers(Self)) to sHit
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "MSG" sHit
        End_Procedure

        /* EXACTLY ONE, NEVER A BEST GUESS. Two structs with the same member names cannot be told
           apart, so both are refused - the catalogue really does contain such collisions
           ({version, unionName1} is shared by 18 structs), and picking one would be a coin toss
           that emits the wrong layout. */
        {Published = True}
        Procedure Shape_AmbiguousShapeIsRefused
            String[] asCat asSaved asTwin
            String sHit
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            // MSG's members again, under another name - CatRow takes member LINES, so each needs
            // its datatype. The types are irrelevant here; only the names decide a shape match.
            Move "Handle hwnd"      to asTwin[0]
            Move "UInteger message" to asTwin[1]
            Move "ULongPtr wParam"  to asTwin[2]
            Move "LongPtr lParam"   to asTwin[3]
            Move "UInteger time"    to asTwin[4]
            Move "POINT pt"         to asTwin[5]
            Move (MsgRow(Self))                     to asCat[0]
            Move (CatRow(Self, "TWIN", asTwin))     to asCat[1]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Get WinAPIStructNameByMemberShape of ghoFuncLib (PrMsgMembers(Self)) to sHit
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sHit
        End_Procedure

        /* THE FLOOR ON MEMBER COUNT. Every ambiguous shape in the live catalogue is small and
           generic, so a short list is refused whatever it matches - here it matches EXACTLY one
           row and is still refused, which is the point. */
        {Published = True}
        Procedure Shape_TooFewMembersIsRefused
            String[] asCat asSaved asShort asM
            String sHit
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move "Integer x"     to asM[0]
            Move "Integer y"     to asM[1]
            Move "Integer cx"    to asM[2]
            Move (CatRow(Self, "TRIPLE", asM)) to asCat[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Move "x"  to asShort[0]
            Move "y"  to asShort[1]
            Move "cx" to asShort[2]
            Send Assert (SizeOfArray(asShort) < CI_WinAPIShapeMatchMinMembers)
            Get WinAPIStructNameByMemberShape of ghoFuncLib asShort to sHit
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sHit
        End_Procedure

        // A shape nothing in the catalogue has is refused, not approximated.
        {Published = True}
        Procedure Shape_UnknownShapeIsRefused
            String[] asCat asSaved asWanted
            String sHit
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move (MsgRow(Self)) to asCat[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Move "alpha" to asWanted[0]
            Move "beta"  to asWanted[1]
            Move "gamma" to asWanted[2]
            Move "delta" to asWanted[3]
            Get WinAPIStructNameByMemberShape of ghoFuncLib asWanted to sHit
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sHit
        End_Procedure

        // ORDER IS PART OF THE IDENTITY. The same names in a different order are a different
        // layout, and matching them would emit members against the wrong offsets.
        {Published = True}
        Procedure Shape_WrongOrderIsRefused
            String[] asCat asSaved asSwapped
            String sHit
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move (MsgRow(Self)) to asCat[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Move "hwnd"    to asSwapped[0]
            Move "message" to asSwapped[1]
            Move "lParam"  to asSwapped[2]
            Move "wParam"  to asSwapped[3]
            Move "Time"    to asSwapped[4]
            Move "pt"      to asSwapped[5]
            Get WinAPIStructNameByMemberShape of ghoFuncLib asSwapped to sHit
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sHit
        End_Procedure

        // The emitted declaration keeps the DEVELOPER'S name, not the SDK's - every buffer
        // declaration in the file names the Type, and renaming it would strand all of them.
        {Published = True}
        Procedure Shape_EmittedStructKeepsTheLegacyName
            String sDecl
            Move (_ReheadStructDecl(ghoFuncLib, ("Struct MSG" + (Character(13)) + (Character(10)) + "Handle hwnd" + (Character(13)) + (Character(10)) + "End_Struct"), "tPrMsg")) to sDecl
            Send Assert (Pos("Struct tPrMsg", sDecl) = 1)
            Send Assert (Pos("Handle hwnd", sDecl) > 0)
            Send Assert (Pos("Struct MSG", sDecl) = 0)
        End_Procedure

        /* THE REPORTED CASE, END TO END, AGAINST THE REAL CATALOGUE (Nils 2026-09-01).

           Everything above seeds a catalogue of its own, which proves the matcher and proves
           nothing about whether MSG is really in the shipped one or whether the converter reaches
           the shape path at all. This runs the published function over WinServ's
           ProcessMessages.pkg - the file that started this - with whatever
           Data\WinAPIStructCatalog.json actually holds.

           It SELF-SKIPS when the catalogue is not loadable, the way the editor fixtures do in
           console mode: a harness without the JSON should report nothing rather than a failure
           about a file it cannot see. If it runs, it is the real thing. */
        {Published = True}
        Procedure Win32Convert_ProcessMessagesConvertsByMemberShape
            String[] asCode
            String sAll sBody
            Integer iCount i iLast

            Send SeedNestedWinStructs
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get WinAPIStructBody of ghoFuncLib "MSG" to sBody
            If (sBody = "") ;
                Procedure_Return          // no catalogue in this harness - nothing to assert

            Move 'Define PM_REMOVE   For 1'                                       to asCode[0]
            Move (Character(35) + 'IFNDEF tPrMsg')                                to asCode[1]
            Move 'Type tPrMsg'                                                    to asCode[2]
            Move '    Field tPrMsg.hwnd     as Handle'                            to asCode[3]
            Move '    Field tPrMsg.message  as Integer'                           to asCode[4]
            Move '    Field tPrMsg.wParam   as Integer'                           to asCode[5]
            Move '    Field tPrMsg.lParam   as Integer'                           to asCode[6]
            Move '    Field tPrMsg.Time     as DWord'                             to asCode[7]
            Move '    Field tPrMsg.pt       as Pointer'                           to asCode[8]
            Move 'End_Type'                                                       to asCode[9]
            Move (Character(35) + 'ENDIF')                                        to asCode[10]
            Move 'Function ProcessMessage Returns Boolean'                        to asCode[11]
            Move '    Pointer lpMsg'                                              to asCode[12]
            Move '    Integer iPendingMessage'                                    to asCode[13]
            Move '    String sMsg'                                                to asCode[14]
            Move '    ZeroType tPrMsg to sMsg'                                    to asCode[15]
            Move '    Move (AddressOf(sMsg)) to lpMsg'                            to asCode[16]
            Move '    GetBuff from sMsg At tPrMsg.message to iPendingMessage'     to asCode[17]
            Move 'End_Function'                                                   to asCode[18]

            Get ChangeExternalFunctionCallers of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount

            Move "" to sAll
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop

            // The Struct keeps the DEVELOPER'S name - every buffer declaration in the file names it.
            Send Assert (Pos("Struct tPrMsg", sAll) > 0)
            Send Assert (Pos("Struct MSG", sAll) = 0)
            /* AND IT CARRIES THE SDK'S TYPES, which is the whole reason this beats copying the
               legacy field types: wParam/lParam are pointer-width on x64 and the legacy block
               said Integer. This assertion is the 32-bytes-becomes-48 fix, stated as a test. */
            Send Assert (Pos("ULongPtr wParam", sAll) > 0)
            Send Assert (Pos("LongPtr lParam", sAll) > 0)
            /* AND THE NESTED MEMBER POINTS AT THE INSTALL'S STRUCT. The catalogue says "POINT pt",
               and nothing anywhere declares a Struct POINT - emitting that is a file that will not
               compile, and emitting our own would collide globally with the next converted file
               (Nils 2026-09-01). tWinPoint is the vendor's, and the same 8 bytes. */
            Send Assert (Pos("tWinPoint pt", sAll) > 0)
            // ...which means the file now depends on tWinStructs.pkg and has to say so.
            Send Assert (Pos("Use tWinStructs.pkg", sAll) > 0)
            // The legacy Type block is commented out, not deleted.
            Send Assert (Pos("// Type tPrMsg", sAll) > 0)
            // ...and the caller is rewritten: no byte-level accessors left, AddressOf untouched.
            Send Assert (Pos("ZeroType", sAll) = 0)
            Send Assert (Pos("GetBuff", sAll) = 0)
            Send Assert (Pos("sMsg.message", sAll) > 0)
            Send Assert (Pos("AddressOf(sMsg)", sAll) > 0)
        End_Procedure

        /* The install's nested structs, seeded the same way and for the same reason as
           SeedWinStructs above: psTargetPkgFolder is blank under the test runner, so the real
           tWinStructs.pkg cannot be read and _ShippedStructNameFor would find nothing - which
           would refuse every conversion with a nested member rather than map it. These three are
           what the tests below need; the running app reads the real file. */
        Procedure SeedNestedWinStructs
            String[] asLines
            Move "Struct tWinPoint"       to asLines[0]
            Move "    Integer x"          to asLines[1]
            Move "    Integer y"          to asLines[2]
            Move "End_Struct"             to asLines[3]
            Move "Struct tWinRect"        to asLines[4]
            Move "    Integer left"       to asLines[5]
            Move "    Integer top"        to asLines[6]
            Move "    Integer right"      to asLines[7]
            Move "    Integer bottom"     to asLines[8]
            Move "End_Struct"             to asLines[9]
            Move "Struct tWinTcItem"      to asLines[10]
            Move "    UInteger mask"      to asLines[11]
            Move "End_Struct"             to asLines[12]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
        End_Procedure

        /* ---- THE FILE MUST DECLARE WHAT THE CONVERSION MADE IT CONSUME ------------------------
           Both converters retype buffers to a tWin<X> the INSTALL declares. Neither emitted a Use
           for it, so apply_hide_tab_page.pkg - which has no Use line anywhere - came back naming
           tWinTcItem with nothing to resolve it (Nils 2026-09-01). */

        // A file with NO leading Use block at all still gets one. _EnsureUsePackage deliberately
        // refuses to sprout a lone Use, which is right for retiring a package and wrong here:
        // this dependency is what makes the file compile.
        {Published = True}
        Procedure Use_AddedToAFileWithNoUseBlockAtAll
            String[] asCode
            Move 'Procedure DoIt'            to asCode[0]
            Move '    tWinTcItem sTcItem'    to asCode[1]
            Move 'End_Procedure'             to asCode[2]
            Send _EnsureUseForNewDependency of ghoFuncLib (&asCode) "tWinStructs.pkg"
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertSAreEqual 'Use tWinStructs.pkg' asCode[0]
            Send AssertSAreEqual 'Procedure DoIt'      asCode[1]
        End_Procedure

        // With a leading Use block it joins the end of it, not the top of the file.
        {Published = True}
        Procedure Use_JoinsTheEndOfAnExistingUseBlock
            String[] asCode
            Move '// header comment'         to asCode[0]
            Move 'Use Windows.pkg'           to asCode[1]
            Move 'Use cTextEdit.pkg'         to asCode[2]
            Move ''                          to asCode[3]
            Move 'Procedure DoIt'            to asCode[4]
            Move 'End_Procedure'             to asCode[5]
            Send _EnsureUseForNewDependency of ghoFuncLib (&asCode) "tWinStructs.pkg"
            Send AssertSAreEqual 'Use cTextEdit.pkg'    asCode[2]
            Send AssertSAreEqual 'Use tWinStructs.pkg'  asCode[3]
            Send AssertSAreEqual 'Procedure DoIt'       asCode[5]
        End_Procedure

        // Already declared: nothing is added, however the line is cased or indented.
        {Published = True}
        Procedure Use_AlreadyPresentIsNotDuplicated
            String[] asCode
            Move '    use TWINSTRUCTS.PKG'   to asCode[0]
            Move 'Procedure DoIt'            to asCode[1]
            Move 'End_Procedure'             to asCode[2]
            Send _EnsureUseForNewDependency of ghoFuncLib (&asCode) "tWinStructs.pkg"
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
        End_Procedure

        // The word "Use" inside a block comment is prose, not a declaration - it must not be
        // mistaken for the leading Use block and have the new one appended after it.
        {Published = True}
        Procedure Use_ProseInsideABlockCommentIsNotAUseLine
            String[] asCode
            Move '/* This package does not'  to asCode[0]
            Move '   Use anything at all. */' to asCode[1]
            Move 'Procedure DoIt'            to asCode[2]
            Move 'End_Procedure'             to asCode[3]
            Send _EnsureUseForNewDependency of ghoFuncLib (&asCode) "tWinStructs.pkg"
            Send AssertSAreEqual 'Use tWinStructs.pkg' asCode[2]
            Send AssertSAreEqual 'Procedure DoIt'      asCode[3]
        End_Procedure

        // A nested member with no shipped twin refuses the whole Type rather than emitting a
        // declaration of its own - a "Struct POINT" in two converted files collides globally.
        {Published = True}
        Procedure Win32Struct_NestedTypeWithNoTwinIsRefused
            String[] asNames asBody
            String sWhy sSdk sNl
            Boolean bOK
            Move (Character(10)) to sNl
            Move ("Struct MADEUP" + sNl ;
                + "Integer x" + sNl ;
                + "NOSUCHSTRUCTANYWHERE y" + sNl ;
                + "End_Struct") to sSdk
            Move "iFirst"  to asNames[0]
            Move "iSecond" to asNames[1]
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) sSdk (&asBody) (&sWhy) to bOK
            Send Assert (bOK = False)
            // the reason has to NAME the member and the type, or it is unactionable
            Send Assert (Pos("iSecond", sWhy) > 0)
            Send Assert (Pos("NOSUCHSTRUCTANYWHERE", sWhy) > 0)
            Send AssertIAreEqual 0 (SizeOfArray(asBody))
        End_Procedure

        // ...while a nested member the install DOES ship is pointed at the vendor's declaration.
        {Published = True}
        Procedure Win32Struct_NestedTypeWithATwinIsMapped
            String[] asNames asBody
            String sWhy sSdk sNl sAll
            Integer i
            Boolean bOK
            Send SeedNestedWinStructs
            Move (Character(10)) to sNl
            Move ("Struct MADEUP" + sNl ;
                + "Integer x" + sNl ;
                + "POINT y" + sNl ;
                + "RECT z" + sNl ;
                + "End_Struct") to sSdk
            Move "iCount"  to asNames[0]
            Move "ptWhere" to asNames[1]
            Move "rcBox"   to asNames[2]
            Get _Win32StructBodyFromLegacy of ghoFuncLib (&asNames) sSdk (&asBody) (&sWhy) to bOK
            Send Assert bOK
            Move "" to sAll
            For i from 0 to (SizeOfArray(asBody) - 1)
                Move (sAll + Trim(asBody[i]) + (Character(10))) to sAll
            Loop
            Send Assert (Pos("tWinPoint ptWhere", sAll) > 0)
            Send Assert (Pos("tWinRect rcBox", sAll) > 0)
            // the author's names survive, and the scalar is untouched
            Send Assert (Pos("Integer iCount", sAll) > 0)
        End_Procedure

        /* ---- THE CATALOGUE MISS THAT IS NOT A REFUSAL ------------------------------------

           RegInteger is lifted from require.pkg: a DWord wearing a struct costume purely so it
           can be handed to CreateThread by address. No SDK struct is named for it and none ever
           will be, and until 2026-09-01 that alone abandoned the Type AND every consumer bound
           to it - the catalogue had been wired in as a precondition for converting rather than
           as the type-CORRECTION service it actually is. One member or eleven makes no
           difference to any of this, which is the point Nils made twice before it landed. */
        Procedure RegIntCluster String[] ByRef asCode
            Move "Type RegInteger"                                            to asCode[0]
            Move "  Field RegInteger.iValue as DWord"                         to asCode[1]
            Move "End_Type"                                                   to asCode[2]
            Move ""                                                           to asCode[3]
            Move "Function StartIt Returns Handle"                            to asCode[4]
            Move "  String sThreadID"                                         to asCode[5]
            Move "  Pointer lpThreadID"                                       to asCode[6]
            Move "  Handle hThread"                                           to asCode[7]
            Move "  ZeroType RegInteger To sThreadID"                         to asCode[8]
            Move "  GetAddress Of sThreadID To lpThreadID"                    to asCode[9]
            Move "  GetBuff From sThreadID At RegInteger.iValue To hThread"   to asCode[10]
            Move "End_Function"                                               to asCode[11]
        End_Procedure

        {Published = True}
        Procedure Fallback_UncataloguedTypeConvertsWithItsOwnTypes
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send RegIntCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            // the Struct arrives carrying the AUTHOR'S OWN type - there is none to borrow
            Send Assert (Pos("Struct RegInteger", sAll) > 0)
            Send Assert (Pos("DWord iValue", sAll) > 0)
            Send Assert (Pos("End_Struct", sAll) > 0)
            // the legacy block is commented out, never deleted
            Send Assert (Pos("// Type RegInteger", sAll) > 0)
            // and the consumer is rewritten - which is the whole reason to do any of this
            Send Assert (Pos("RegInteger sThreadID", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(sThreadID)) to lpThreadID", sAll) > 0)
            Send Assert (Pos("Move sThreadID.iValue to hThread", sAll) > 0)
            Send Assert (Pos("ZeroType", sAll) = 0)
            Send Assert (Pos("GetBuff", sAll) = 0)
        End_Procedure

        /* THE RUN NOTE HAS TO SAY WHAT WAS *NOT* DONE. A fallback conversion preserves the
           layout exactly, so every call site keeps working - but a member that was already
           four bytes short for x64 stays four bytes short, and a user who reads "converted"
           and assumes "corrected" has been misled by us rather than by the legacy code. */
        {Published = True}
        Procedure Fallback_SaysTheTypesWereNotCorrected
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send RegIntCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sAll + asNotes[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("ITS OWN member types", sAll) > 0)
            Send Assert (Pos("64-bit", sAll) > 0)
        End_Procedure

        /* THE FLOOD GUARD, and it is a POSITIVE control for the gate rather than a no-op test:
           _LegacyStructBodyFromType succeeds on ANY well-formed Type block, so without the
           bound-buffer test in front of it every ordinary record Type in a workspace would
           walk into the buffer check and come back out as "no buffer is bound to it in this
           file". Hundreds of notes, burying the handful that mean something. */
        {Published = True}
        Procedure Fallback_TypeWithNoBoundBufferStaysSilent
            String[] asCode asNotes asBefore
            Integer iCount i
            Boolean bSame
            Move "Type tMyOwnRecord"                      to asCode[0]
            Move "  Field tMyOwnRecord.iId   as Integer"  to asCode[1]
            Move "  Field tMyOwnRecord.sName as String"   to asCode[2]
            Move "End_Type"                               to asCode[3]
            Move ""                                       to asCode[4]
            Move "Procedure DoIt"                         to asCode[5]
            Move "End_Procedure"                          to asCode[6]
            Move asCode to asBefore
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
            Send AssertIAreEqual (SizeOfArray(asBefore)) (SizeOfArray(asCode))
            Move True to bSame
            For i from 0 to (SizeOfArray(asBefore) - 1)
                If (asBefore[i] <> asCode[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame
        End_Procedure

        /* NAMES SURVIVE VERBATIM. This is the whole difference between the fallback and the
           report's _TypeDefToStruct, which runs every member through _HungarianMember
           (message -> iMessage). A report may rename because nothing depends on it; a REWRITE
           may not, because every "X.member" still standing in the file has to keep resolving. */
        {Published = True}
        Procedure FallbackBody_KeepsNamesDimensionsAndComments
            String[] asCode asBody
            String sWhy sAll
            Boolean bOK
            Integer i
            Move "Type tThing"                            to asCode[0]
            Move "  // what this member is for"           to asCode[1]
            Move "  Field tThing.message as Integer"      to asCode[2]
            Move "  Field tThing.sBuf    as String 260"   to asCode[3]
            Move "End_Type"                               to asCode[4]
            Get _LegacyStructBodyFromType of ghoFuncLib (&asCode) 0 4 (&asBody) (&sWhy) to bOK
            Send Assert bOK
            Move "" to sAll
            For i from 0 to (SizeOfArray(asBody) - 1)
                Move (sAll + Trim(asBody[i]) + (Character(10))) to sAll
            Loop
            Send Assert (Pos("Integer message", sAll) > 0)
            Send Assert (Pos("iMessage", sAll) = 0)
            Send Assert (Pos("String[260] sBuf", sAll) > 0)
            Send Assert (Pos("what this member is for", sAll) > 0)
        End_Procedure

        // ALL OR NOTHING, like every other refusal here: half a struct handed to a caller that
        // trusts the member count is worse than no struct at all.
        {Published = True}
        Procedure FallbackBody_ANonFieldLineRefusesTheWholeBlock
            String[] asCode asBody
            String sWhy
            Boolean bOK
            Move "Type tThing"                       to asCode[0]
            Move "  Field tThing.iId as Integer"     to asCode[1]
            Move "  Move 1 to iSomething"            to asCode[2]
            Move "End_Type"                          to asCode[3]
            Get _LegacyStructBodyFromType of ghoFuncLib (&asCode) 0 3 (&asBody) (&sWhy) to bOK
            Send Assert (bOK = False)
            Send AssertIAreEqual 0 (SizeOfArray(asBody))
            Send Assert (Pos("not a Field declaration", sWhy) > 0)
        End_Procedure

        /* THE CATALOGUE STILL WINS WHERE IT KNOWS THE STRUCT - a guard against the fallback
           quietly taking over and preserving the very 64-bit errors the catalogue exists to
           fix. vtBrowseInfo resolves (BROWSEINFOA, via the A/W suffix scan in
           WinAPIStructBody), so its lParam must come back as the SDK's LongPtr and NOT as the
           legacy block's dWord. Win32Convert_EndToEndBrowseInfo covers the full rewrite; this
           pins the one line that would silently regress. */
        {Published = True}
        Procedure Fallback_DoesNotDisplaceTheCatalogue
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BrowseCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("LongPtr lParam", sAll) > 0)
            Send Assert (Pos("dWord lParam", sAll) = 0)
            Move "" to sAll
            For i from 0 to (SizeOfArray(asNotes) - 1)
                Move (sAll + asNotes[i] + (Character(10))) to sAll
            Loop
            // ...and it must NOT claim it used the author's own types
            Send Assert (Pos("ITS OWN member types", sAll) = 0)
        End_Procedure

        /* ---- THE UNPREFIXED FORM ----------------------------------------------------------

           DataFlex accepts "Field dwSize as DWord" and "Put 16 to lsSize At dwSize" exactly as
           it accepts the "<Type>."-qualified spellings, and the converter assumed the qualified
           one in three separate places. A file written the short way bound no buffer, so its
           Type looked unused and went by without a word - vsWin32ids.pkg, which Nils pointed at
           three times before the reason was found (2026-09-01). */
        Procedure BareFormCluster String[] ByRef asCode
            Move "Type __vsdwSize"                              to asCode[0]
            Move "    Field dwSize as DWord"                    to asCode[1]
            Move "End_Type"                                     to asCode[2]
            Move ""                                             to asCode[3]
            Move "Function GetIt Returns Integer"               to asCode[4]
            Move "    String lsSize"                            to asCode[5]
            Move "    Pointer lpSize"                           to asCode[6]
            Move "    ZeroType __vsdwSize To lsSize"            to asCode[7]
            Move "    Put 16 To lsSize At dwSize"               to asCode[8]
            Move "    Move (AddressOf(lsSize)) to lpSize"       to asCode[9]
            Move "End_Function"                                 to asCode[10]
        End_Procedure

        {Published = True}
        Procedure BareForm_UnprefixedFieldAndAtConvert
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send BareFormCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("Struct __vsdwSize", sAll) > 0)
            Send Assert (Pos("DWord dwSize", sAll) > 0)
            // the bare "At dwSize" is rewritten as member access on the struct variable
            Send Assert (Pos("Move 16 to lsSize.dwSize", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(lsSize)) to lpSize", sAll) > 0)
            Send Assert (Pos("ZeroType", sAll) = 0)
            Send Assert (Pos("At dwSize", sAll) = 0)
        End_Procedure

        /* A QUALIFIED TWIN IS NOT AN AMBIGUITY. Until 2026-09-02 this built two Types that BOTH
           declared "Field dwSize" bare and asserted the whole conversion was refused. DF26 will
           not compile that source at all - the second bare declaration is Error 4332, "Symbol
           already defined" - so the fixture pinned behaviour on input that cannot exist, and the
           test failed the moment the converter got good enough to convert it.

           The case that IS legal, and that this pins instead: one Type declares the member bare,
           another declares its own under a qualified name. Both compile, and a bare operand can
           only ever mean the bare declarer - so the cluster MUST convert. Counting the qualified
           twin made _TypeDeclaringMember answer "", the buffer never bound, and the Type was
           passed over without a word. A silent skip is the expensive kind. */
        {Published = True}
        Procedure BareForm_AQualifiedTwinDoesNotMakeItAmbiguous
            String[] asCode asNotes
            String sAll
            Integer iCount i

            Move "Type __vsdwSize"                              to asCode[0]
            Move "    Field dwSize as DWord"                    to asCode[1]
            Move "End_Type"                                     to asCode[2]
            Move "Type __vsdwOther"                             to asCode[3]
            Move "    Field __vsdwOther.dwSize as DWord"        to asCode[4]
            Move "End_Type"                                     to asCode[5]
            Move ""                                             to asCode[6]
            Move "Function GetIt Returns Integer"               to asCode[7]
            Move "    String lsSize"                            to asCode[8]
            Move "    ZeroType __vsdwSize To lsSize"            to asCode[9]
            Move "    Put 16 To lsSize At dwSize"               to asCode[10]
            Move "End_Function"                                 to asCode[11]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("Move 16 to lsSize.dwSize", sAll) > 0)
            // the twin belongs to another Type and no buffer binds to it - leave it alone
            Send Assert (Pos("Type __vsdwOther", sAll) > 0)
        End_Procedure

        // The shared operand reader, in all three cases it has to tell apart.
        {Published = True}
        Procedure BareForm_MemberFromAtOperandReadsBothForms
            String sOut
            Get _MemberFromAtOperand of ghoFuncLib "tThing.dwSize" "tThing" to sOut
            Send AssertSAreEqual "dwSize" sOut
            Get _MemberFromAtOperand of ghoFuncLib "dwSize" "tThing" to sOut
            Send AssertSAreEqual "dwSize" sOut
            // a prefix that names ANOTHER Type is still a refusal, not a bare name
            Get _MemberFromAtOperand of ghoFuncLib "tOther.dwSize" "tThing" to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* The ownership guard in isolation: one declarer answers, two answer nothing. DF26 will
           not compile two BARE declarations of one name (Error 4332), so the second half pins
           defensive behaviour on source that cannot exist - kept because this helper reads
           whatever it is handed. The case that DOES occur is the qualified twin, above. */
        {Published = True}
        Procedure BareForm_TypeDeclaringMemberNeedsExactlyOne
            String[] asCode
            String sOut
            Move "Type tOne"                     to asCode[0]
            Move "    Field dwSize as DWord"     to asCode[1]
            Move "End_Type"                      to asCode[2]
            Get _TypeDeclaringMember of ghoFuncLib (&asCode) "dwSize" to sOut
            Send AssertSAreEqual "tOne" sOut
            // a name nothing declares
            Get _TypeDeclaringMember of ghoFuncLib (&asCode) "cbSize" to sOut
            Send AssertSAreEqual "" sOut
            Move "Type tTwo"                     to asCode[3]
            Move "    Field dwSize as DWord"     to asCode[4]
            Move "End_Type"                      to asCode[5]
            Get _TypeDeclaringMember of ghoFuncLib (&asCode) "dwSize" to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* A QUALIFIED PREFIX IS STILL CHECKED. Relaxing the requirement must not relax the
           DISAGREEMENT: "Field tOther.x" inside "Type tThing" means the block was flattened or
           the line was pasted in, and converting it would move a member between structs. */
        {Published = True}
        Procedure BareForm_APrefixNamingAnotherTypeStillRefuses
            String[] asCode asNames
            String sWhy
            Boolean bOK
            Move "Type tThing"                       to asCode[0]
            Move "    Field tOther.dwSize as DWord"  to asCode[1]
            Move "End_Type"                          to asCode[2]
            Get _LegacyTypeMemberNames of ghoFuncLib (&asCode) 0 2 "tThing" (&asNames) (&sWhy) to bOK
            Send Assert (bOK = False)
            Send Assert (Pos("belongs to another Type", sWhy) > 0)
        End_Procedure

        /* ---- <Type>_SIZE NAMES ITS TYPE ---------------------------------------------------

           DataFlex generates "<Name>_SIZE" for every Type declaration - it is how legacy code
           asks for a Type's byte length - so "Move (Repeat(Character(0), X_SIZE)) to buf" is
           ZeroType written out by hand, and names its Type just as plainly. The converter only
           ever SUBSTITUTED that symbol once a Type was known, never read it to LEARN one, so a
           file that zeroed by hand bound no buffer at all and was passed over without a word.
           Nils supplied the missing fact - the suffix is a Type reference (2026-09-01). */
        Procedure HandZeroedCluster String[] ByRef asCode
            Move "Type __vsdwSize"                                          to asCode[0]
            Move "    Field dwSize as DWord"                                to asCode[1]
            Move "End_Type"                                                 to asCode[2]
            Move ""                                                         to asCode[3]
            Move "Function GetIt Returns Integer"                           to asCode[4]
            Move "    String lsSize"                                        to asCode[5]
            Move "    Pointer lpSize"                                       to asCode[6]
            Move "    Move (Repeat(Character(0), __vsdwSize_SIZE)) to lsSize" to asCode[7]
            Move "    Put 16 To lsSize At dwSize"                           to asCode[8]
            Move "    Move (AddressOf(lsSize)) to lpSize"                   to asCode[9]
            Move "End_Function"                                             to asCode[10]
        End_Procedure

        {Published = True}
        Procedure SizeSymbol_HandZeroedBufferConvertsLikeZeroType
            String[] asCode asNotes
            String sAll
            Integer iCount i
            Send HandZeroedCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sAll
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Send Assert (Pos("Struct __vsdwSize", sAll) > 0)
            // the hand-written zeroing becomes exactly what ZeroType becomes
            Send Assert (Pos("Move lsSizeEmpty to lsSize", sAll) > 0)
            Send Assert (Pos("Repeat(", sAll) = 0)
            Send Assert (Pos("_SIZE", sAll) = 0)
            // ...and the bare-form Put is rewritten alongside it
            Send Assert (Pos("Move 16 to lsSize.dwSize", sAll) > 0)
        End_Procedure

        /* NARROW ON PURPOSE. Only Character(0) is provably "a zeroed buffer of this Type's
           size". A space-fill or a literal length is not, and a converter that assumed would
           quietly change what the API receives - so those stay refusals. */
        {Published = True}
        Procedure SizeSymbol_OnlyACharacterZeroFillOfThisTypeCounts
            String sOut
            Get _ZeroFillBufferForType of ghoFuncLib ;
                "Move (Repeat(Character(0), tThing_SIZE)) to sBuf" "tThing" to sOut
            Send AssertSAreEqual "sBuf" sOut
            // a space-fill is not a zero-fill
            Get _ZeroFillBufferForType of ghoFuncLib ;
                "Move (Repeat(' ', tThing_SIZE)) to sBuf" "tThing" to sOut
            Send AssertSAreEqual "" sOut
            // a literal length does not name the Type
            Get _ZeroFillBufferForType of ghoFuncLib ;
                "Move (Repeat(Character(0), 16)) to sBuf" "tThing" to sOut
            Send AssertSAreEqual "" sOut
            // ...nor does ANOTHER Type's size symbol
            Get _ZeroFillBufferForType of ghoFuncLib ;
                "Move (Repeat(Character(0), tOther_SIZE)) to sBuf" "tThing" to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* ---- 2026-09-13: the two shapes that stopped a real cluster ONE LINE short --------------

           A legacy systray Type in a test workspace converted on every line but one: the buffer
           was handed STRAIGHT to the API - "Move (Shell_NotifyIcon(dwMessage, sBuf)) to iRet" -
           and the walk had no rewrite for a bare buffer in an argument list. Fixing only that
           exposed the second gap: "Size_of_Field <Type>.<member> to <var>" names the Type, not
           the buffer, so nothing graded it, and the emitted file did not compile. The two ship
           together because either alone leaves a file worse than untouched. */
        Procedure NotifyCluster String[] ByRef asCode
            Move 'External_Function Win32_NotifyIcon "Shell_NotifyIconA" Shell32.dll ;' to asCode[0]
            Move '    DWord dwMessage Pointer lpData Returns Integer'                  to asCode[1]
            Move 'Type tNotify'                                                        to asCode[2]
            Move '    Field tNotify.iSize   as DWord'                                  to asCode[3]
            Move '    Field tNotify.hOwner  as Handle'                                 to asCode[4]
            Move '    Field tNotify.iIdent  as Integer'                                to asCode[5]
            Move '    Field tNotify.sTip    as Char 64'                                to asCode[6]
            Move 'End_Type'                                                            to asCode[7]
            Move 'Function ShowIt Returns Integer'                                     to asCode[8]
            Move '    String sNotify'                                                  to asCode[9]
            Move '    DWord iSize'                                                     to asCode[10]
            Move '    Integer iRet'                                                    to asCode[11]
            Move '    FillType tNotify With 0 to sNotify'                              to asCode[12]
            Move '    Put 1 to sNotify At tNotify.iIdent'                              to asCode[13]
            Move '    Size_of_Field tNotify.iSize to iSize'                            to asCode[14]
            Move '    Put iSize to sNotify At tNotify.iSize'                           to asCode[15]
            Move '    Move (Win32_NotifyIcon(0, sNotify)) to iRet'                     to asCode[16]
            Move '    Function_Return iRet'                                            to asCode[17]
            Move 'End_Function'                                                        to asCode[18]
        End_Procedure

        Function JoinedLines String[] asCode Returns String
            String sAll
            Integer i
            For i from 0 to (SizeOfArray(asCode) - 1)
                Move (sAll + asCode[i] + (Character(10))) to sAll
            Loop
            Function_Return sAll
        End_Function

        /* The bare buffer in the API's Pointer position becomes its address, the other argument
           is untouched, and the rest of the cluster converts exactly as before. */
        {Published = True}
        Procedure Win32Convert_BufferHandedStraightToAPointerParameterGetsAddressOf
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send NotifyCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Move (Win32_NotifyIcon(0, AddressOf(sNotify))) to iRet", sAll) > 0)
            Send Assert (Pos("Struct tNotify", sAll) > 0)
            Send Assert (Pos("// Type tNotify", sAll) > 0)
            Send Assert (Pos("Move 1 to sNotify.iIdent", sAll) > 0)
            Send Assert (Pos("Put ", sAll) = 0)
        End_Procedure

        /* Size_of_Field on the Type becomes SizeOfType of the member's declared type - the type
           the STRUCT declares - and a dimensioned member is that many of its base type. */
        {Published = True}
        Procedure Win32Convert_SizeOfFieldBecomesSizeOfTypeOfTheMember
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send NotifyCluster (&asCode)
            Move '    Integer iRet iTipLen'                      to asCode[11]
            Move '    Size_of_Field tNotify.sTip to iTipLen'     to asCode[17]
            Move '    Function_Return iRet'                      to asCode[18]
            Move 'End_Function'                                  to asCode[19]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Move (SizeOfType(DWord)) to iSize", sAll) > 0)
            Send Assert (Pos("Move (64 * SizeOfType(Char)) to iTipLen", sAll) > 0)
            Send Assert (Pos("Size_of_Field", sAll) = 0)
        End_Procedure

        // Offset_of_Field has no Struct equivalent: the Type is refused, and the note names the line.
        {Published = True}
        Procedure Win32Convert_OffsetOfFieldRefusesTheType
            String[] asCode asNotes asBefore
            Integer iCount i
            Boolean bSame
            Send NotifyCluster (&asCode)
            Move '    Offset_of_Field tNotify.iIdent to iRet'    to asCode[17]
            Move '    Function_Return iRet'                      to asCode[18]
            Move 'End_Function'                                  to asCode[19]
            Move asCode to asBefore
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("Offset_of_Field", asNotes[0]) > 0)
            Send Assert (Pos("iIdent", asNotes[0]) > 0)
            Send Assert (Pos("line 18", asNotes[0]) > 0)
            Move True to bSame
            For i from 0 to (SizeOfArray(asBefore) - 1)
                If (asBefore[i] <> asCode[i]) ;
                    Move False to bSame
            Loop
            Send Assert bSame
        End_Procedure

        // A declared callee whose parameter is String wants TEXT there; a Struct is not text.
        {Published = True}
        Procedure Win32Convert_BufferHandedToAStringParameterRefuses
            String[] asCode asNotes
            Integer iCount
            Send NotifyCluster (&asCode)
            Move '    DWord dwMessage String lpData Returns Integer' to asCode[1]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("Win32_NotifyIcon", asNotes[0]) > 0)
            Send Assert (Pos("String", asNotes[0]) > 0)
            Send Assert (Pos("not a pointer", asNotes[0]) > 0)
        End_Procedure

        /* A callee this file does not declare gets no opinion - CString(sBuf) is also "a call with
           the buffer as an argument" - so the walk's ordinary refusal stands. */
        {Published = True}
        Procedure Win32Convert_BufferHandedToAnUndeclaredCallKeepsTheOrdinaryRefusal
            String[] asCode asNotes
            Integer iCount
            Send NotifyCluster (&asCode)
            Move '// declared in another package'  to asCode[0]
            Move ''                                to asCode[1]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("uses those bytes in a way this converter does not rewrite", asNotes[0]) > 0)
            Send Assert (Pos("line 17", asNotes[0]) > 0)
        End_Procedure

        /* Depth-aware and position-true: a buffer in the MIDDLE of three arguments, beside an
           AddressOf already written and a parenthesised expression, gets its AddressOf and the
           other two arguments come out byte-identical. The buffer also shares its declaration
           line here, so the lift is exercised on the way. */
        {Published = True}
        Procedure Win32Convert_ArgRewriteLeavesTheOtherArgumentsAlone
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send NotifyCluster (&asCode)
            Move 'External_Function Win32_Three "ThreeA" Some.dll Pointer p1 Pointer p2 Integer i3 Returns Integer' to asCode[0]
            Move ''                                                                    to asCode[1]
            Move '    String sNotify sOther'                                           to asCode[9]
            Move '    Move (Win32_Three(AddressOf(sOther), sNotify, (iSize + 1))) to iRet' to asCode[16]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Move (Win32_Three(AddressOf(sOther), AddressOf(sNotify), (iSize + 1))) to iRet", sAll) > 0)
            Send Assert (Pos("String sOther", sAll) > 0)
            Send Assert (Pos("tNotify sNotify", sAll) > 0)
        End_Procedure

        /* ---- 2026-09-13: a ONE-FIELD Type is a scalar wearing a buffer -----------------------------

           Dftypes.pkg still declares tDWORD and tHANDLE with one field each, and the code that uses
           them asks an API for one number back through a byte buffer. There is no tWin twin - a
           struct of one number is the number - so PASS 2 refused them for ever with "the install
           ships no modern struct for it". The modern form has no buffer: the local IS the DWord,
           and AddressOf(it) is what the API receives. */
        {Published = True}
        Procedure Scalar_OneFieldTypeBufferBecomesThePlainLocal
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedWinStructs
            Move 'Procedure DoInit'                                     to asCode[0]
            Move '    Handle hRet'                                      to asCode[1]
            Move '    Integer iCookie'                                  to asCode[2]
            Move '    String sBuffer'                                   to asCode[3]
            Move '    Pointer pBuffer'                                  to asCode[4]
            Move '    ZeroType tDword to sBuffer'                       to asCode[5]
            Move '    Move (AddressOf(sBuffer)) to pBuffer'             to asCode[6]
            Move '    Move (SomeInit(0, pBuffer)) to hRet'              to asCode[7]
            Move '    GetBuff From  sBuffer At tDword.DWord to iCookie' to asCode[8]
            Move 'End_Procedure'                                        to asCode[9]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("DWord sBuffer", sAll) > 0)
            Send Assert (Pos("Move 0 to sBuffer", sAll) > 0)
            Send Assert (Pos("Move (AddressOf(sBuffer)) to pBuffer", sAll) > 0)
            Send Assert (Pos("Move sBuffer to iCookie", sAll) > 0)
            // no twin, no Struct, no Use - a scalar needs none of them; nothing byte-level survives
            Send Assert (Pos("sBufferEmpty", sAll) = 0)
            Send Assert (Pos("Struct ", sAll) = 0)
            Send Assert (Pos("tWinStructs", sAll) = 0)
            Send Assert (Pos("ZeroType", sAll) = 0)
            Send Assert (Pos("GetBuff", sAll) = 0)
        End_Procedure

        // tHANDLE too, with the other accessors: Put is a Move INTO the local, and the legacy size
        // symbol in a value becomes SizeOfType of the scalar - the same mechanical rule as a struct.
        {Published = True}
        Procedure Scalar_HandleTypePutAndSizeSymbol
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedWinStructs
            Move 'Procedure DoIt'                                   to asCode[0]
            Move '    String sH'                                    to asCode[1]
            Move '    Handle hOut'                                  to asCode[2]
            Move '    ZeroType tHandle to sH'                       to asCode[3]
            Move '    Put tHandle_size to sH At tHandle.handle'     to asCode[4]
            Move '    GetBuff From sH At tHandle.handle to hOut'    to asCode[5]
            Move 'End_Procedure'                                    to asCode[6]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Handle sH", sAll) > 0)
            Send Assert (Pos("Move 0 to sH", sAll) > 0)
            Send Assert (Pos("Move (SizeOfType(Handle)) to sH", sAll) > 0)
            Send Assert (Pos("Move sH to hOut", sAll) > 0)
            Send Assert (Pos("tHandle_size", sAll) = 0)
        End_Procedure

        // A member the one-field Type does not have refuses the cluster, and the note names the line.
        {Published = True}
        Procedure Scalar_AnotherMemberRefusesWithTheReason
            String[] asCode asNotes
            Integer iCount
            Send SeedWinStructs
            Move 'Procedure DoIt'                                   to asCode[0]
            Move '    String sB'                                    to asCode[1]
            Move '    Integer iOut'                                 to asCode[2]
            Move '    ZeroType tDword to sB'                        to asCode[3]
            Move '    GetBuff From sB At tDword.other to iOut'      to asCode[4]
            Move 'End_Procedure'                                    to asCode[5]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("tDword.other", asNotes[0]) > 0)
            Send Assert (Pos("line 5", asNotes[0]) > 0)
        End_Procedure

        /* ---- 2026-09-13: the TEXT accessors, faithful to the measurement -------------------------

           Put_String copies min(len, n) bytes and zero-fills the rest of the field; GetBuff_String
           hands back exactly n bytes, nulls kept (PutStringProbe, DF26 x64). 'Move sText to B.m'
           compiles and faults at run time (4381); PointerToString reads past a full member. So the
           emitted form is DataFlex's own MemCopy idiom, shaped to those facts. */
        Procedure TrayCluster String[] ByRef asCode
            Move 'Type tTray'                                          to asCode[0]
            Move '    Field tTray.iSize  as DWord'                     to asCode[1]
            Move '    Field tTray.hOwner as Handle'                    to asCode[2]
            Move '    Field tTray.iFlags as DWord'                     to asCode[3]
            Move '    Field tTray.hIcon  as Handle'                    to asCode[4]
            Move '    Field tTray.szTip  as Char 64'                   to asCode[5]
            Move 'End_Type'                                            to asCode[6]
            Move 'Procedure DoIt'                                      to asCode[7]
            Move '    String sBuf sTip sOut'                           to asCode[8]
            Move '    Pointer pBuf'                                    to asCode[9]
            Move '    ZeroType tTray to sBuf'                          to asCode[10]
            Move '    Put_String sTip to sBuf At tTray.szTip'          to asCode[11]
            Move '    Move (AddressOf(sBuf)) to pBuf'                  to asCode[12]
            Move '    GetBuff_String From sBuf At tTray.szTip To sOut' to asCode[13]
            Move 'End_Procedure'                                       to asCode[14]
        End_Procedure

        {Published = True}
        Procedure Text_PutStringIsAZeroFillAndACappedMemCopy
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedWinStructs
            Send TrayCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            // the helpers, declared beside the buffer and named after it
            Send Assert (Pos("String sBufText", sAll) > 0)
            Send Assert (Pos("Integer sBufVoid", sAll) > 0)
            Send Assert (Pos("tTray sBufEmpty", sAll) > 0)
            // the three lines of a Put_String
            Send Assert (Pos("Move sTip to sBufText", sAll) > 0)
            Send Assert (Pos("Move (MemCopy(AddressOf(sBuf.szTip), AddressOf(sBufEmpty.szTip), 64)) to sBufVoid", sAll) > 0)
            Send Assert (Pos("Move (MemCopy(AddressOf(sBuf.szTip), AddressOf(sBufText), If(SizeOfString(sBufText) < 64, SizeOfString(sBufText), 64))) to sBufVoid", sAll) > 0)
            Send Assert (Pos("Put_String", sAll) = 0)
        End_Procedure

        {Published = True}
        Procedure Text_GetBuffStringIsAFixedWidthReadNullsKept
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedWinStructs
            Send TrayCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Move (Repeat(Character(0), 64)) to sOut", sAll) > 0)
            Send Assert (Pos("Move (MemCopy(AddressOf(sOut), AddressOf(sBuf.szTip), 64)) to sBufVoid", sAll) > 0)
            Send Assert (Pos("GetBuff_String", sAll) = 0)
            Send Assert (Pos("PointerToString", sAll) = 0)
        End_Procedure

        // A value that is an expression lands in the text local first; the rest is the same.
        {Published = True}
        Procedure Text_AnExpressionValueLandsInTheTextLocalFirst
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedWinStructs
            Send TrayCluster (&asCode)
            Move '    Put_String (Uppercase(sTip)) to sBuf At tTray.szTip' to asCode[11]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get JoinedLines asCode to sAll
            Send Assert (Pos("Move (Uppercase(sTip)) to sBufText", sAll) > 0)
            Send Assert (Pos("AddressOf(sBufText), If(SizeOfString(sBufText) < 64", sAll) > 0)
        End_Procedure

        // A lone Char is one byte, not a text block: refused, and the note says which member.
        {Published = True}
        Procedure Text_AOneByteCharMemberIsRefused
            String[] asCode asNotes
            Integer iCount
            Send SeedWinStructs
            Send TrayCluster (&asCode)
            Move '    Field tTray.szTip  as Char' to asCode[5]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("not a fixed text block", asNotes[0]) > 0)
            Send Assert (Pos("line 12", asNotes[0]) > 0)
        End_Procedure

        /* A WIDE member on the shipped struct refuses: the ANSI bytes the command wrote would not
           marshal into a Short[n], and copying them anyway is the struct-split hazard in miniature.
           The Type is undeclared here and maps onto a seeded install struct, so this is PASS 2 and
           the member type comes from tWinStructs, not from an emitted body. */
        {Published = True}
        Procedure Text_AWideShippedMemberIsRefused
            String[] asCode asNotes asLines
            Integer iCount
            Move 'Struct tWinTray'      to asLines[0]
            Move '    DWord iSize'      to asLines[1]
            Move '    Short[64] szTip'  to asLines[2]
            Move 'End_Struct'           to asLines[3]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
            Move 'Procedure P'                                          to asCode[0]
            Move '    String sBuf sOut'                                 to asCode[1]
            Move '    ZeroType tTray to sBuf'                           to asCode[2]
            Move '    GetBuff_String From sBuf At tTray.szTip To sOut'  to asCode[3]
            Move 'End_Procedure'                                        to asCode[4]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            Send Assert (Pos("WIDE", asNotes[0]) > 0)
            Send Assert (Pos("Short[64]", asNotes[0]) > 0)
        End_Procedure

        // ---- MESSAGE AND NOTIFICATION STRUCTS, which no API prototype names (2026-11-04) -------------------

        // The install's own spelling of what they nest, the double space and the guarded filler included.
        Procedure SeedMessageStructs
            String[] asLines asNames asMembers
            Move "Struct tWinPoint"                        to asLines[0]
            Move "    Integer x"                           to asLines[1]
            Move "    Integer y"                           to asLines[2]
            Move "End_Struct"                              to asLines[3]
            Move "Struct tWinNmHdr"                        to asLines[4]
            Move "    Handle hWndFrom"                     to asLines[5]
            Move "    Longptr idFrom"                      to asLines[6]
            Move "    DWord  code"                         to asLines[7]
            Move "#IFDEF IS$WIN64"                         to asLines[8]
            Move "    Integer tWinNmHdrMissingAlignment"   to asLines[9]
            Move "#ENDIF"                                  to asLines[10]
            Move "End_Struct"                              to asLines[11]
            Move "Struct tWinSystemTime"                   to asLines[12]
            Move "    Short wYear"                         to asLines[13]
            Move "    Short wMonth"                        to asLines[14]
            Move "    Short wDayOfWeek"                    to asLines[15]
            Move "    Short wDay"                          to asLines[16]
            Move "    Short wHour"                         to asLines[17]
            Move "    Short wMinute"                       to asLines[18]
            Move "    Short wSecond"                       to asLines[19]
            Move "    Short wMilliseconds"                 to asLines[20]
            Move "End_Struct"                              to asLines[21]
            Set pasWinStructsLines of ghoFuncLib to asLines
            Set pbWinStructsRead   of ghoFuncLib to True
            Move "POINT|tWinPoint"                         to asNames[0]
            Move "NMHDR|tWinNmHdr"                         to asNames[1]
            Move "SYSTEMTIME|tWinSystemTime"               to asNames[2]
            Move "RECT|tWinRect"                           to asNames[3]
            Set pasInstallStructNames of ghoFuncLib to asNames
            Move "TWINPOINT|Integer;Integer;"              to asMembers[0]
            Move "TWINNMHDR|Handle;Longptr;DWord;"         to asMembers[1]
            Move "TWINSYSTEMTIME|Short;Short;Short;Short;Short;Short;Short;Short;" to asMembers[2]
            Move "TWINRECT|Integer;Integer;Integer;Integer;" to asMembers[3]
            Set pasInstallStructMembers of ghoFuncLib to asMembers
            Set pbInstallStructNamesLoaded of ghoFuncLib to True
        End_Procedure

        // commctrl.h's old spellings reach the rows, from the catalogue as it ships.
        {Published = True}
        Procedure Win32Msg_OldSpellingsReachTheCatalogue
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Send AssertSAreEqual "NMLISTVIEW"    (WinAPIStructCatalogName(ghoFuncLib, "tNM_LISTVIEW"))
            Send AssertSAreEqual "LVITEMA"       (WinAPIStructCatalogName(ghoFuncLib, "tLV_ITEM"))
            Send AssertSAreEqual "LVHITTESTINFO" (WinAPIStructCatalogName(ghoFuncLib, "tLVHITTESTINFO"))
            Send AssertSAreEqual "TVITEMA"       (WinAPIStructCatalogName(ghoFuncLib, "TV_ITEM"))
            Send AssertSAreEqual "NMHDR"         (WinAPIStructCatalogName(ghoFuncLib, "NMHDR"))
            Send AssertSAreEqual ""              (WinAPIStructCatalogName(ghoFuncLib, "tNo_Such_Struct_Anywhere"))
        End_Procedure

        // The underscore comes out last: a row spelled with one wins, wherever it stands in the file.
        {Published = True}
        Procedure Win32Msg_ARowSpelledWithTheUnderscoreWins
            String[] asCat asSaved
            String sHit sAlso
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move "LVTHING|DF|Struct LVTHING"   to asCat[0]
            Move "LV_THING|DF|Struct LV_THING" to asCat[1]
            Move "LVOTHERW|DF|Struct LVOTHERW" to asCat[2]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Get WinAPIStructCatalogName of ghoFuncLib "tLV_THING" to sHit
            Get WinAPIStructCatalogName of ghoFuncLib "tLV_OTHER" to sAlso
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "LV_THING" sHit
            Send AssertSAreEqual "LVOTHERW" sAlso
        End_Procedure

        // tNM_LISTVIEW exactly as a real file declares it, with one of its real accessors.
        Procedure NotifyListViewCluster String[] ByRef asCode
            Move "TYPE tNM_LISTVIEW"                                 to asCode[0]
            Move "    Field tNM_LISTVIEW.NMHDR.hwndFrom As Handle"   to asCode[1]
            Move "    Field tNM_LISTVIEW.NMHDR.idFrom   As Integer"  to asCode[2]
            Move "    Field tNM_LISTVIEW.NMHDR.code     As Integer"  to asCode[3]
            Move "    Field tNM_LISTVIEW.iItem          as DWord"    to asCode[4]
            Move "    Field tNM_LISTVIEW.iSubItem       as DWord"    to asCode[5]
            Move "    Field tNM_LISTVIEW.uNewState      as DWord"    to asCode[6]
            Move "    Field tNM_LISTVIEW.uOldState      as DWord"    to asCode[7]
            Move "    Field tNM_LISTVIEW.uChanged       as DWord"    to asCode[8]
            Move "    Field tNM_LISTVIEW.POINT.X.Action as Dword"    to asCode[9]
            Move "    Field tNM_LISTVIEW.POINT.Y.Action as Dword"    to asCode[10]
            Move "    Field tNM_LISTVIEW.lParam         as Dword"    to asCode[11]
            Move "END_TYPE"                                          to asCode[12]
            Move "Function F Returns Integer"                        to asCode[13]
            Move "    String sNmLV"                                  to asCode[14]
            Move "    Integer iCode iX"                              to asCode[15]
            Move "    ZeroType tNM_LISTVIEW To sNmLV"                to asCode[16]
            Move "    GetBuff From sNmLV at tNM_LISTVIEW.NMHDR.code To iCode"      to asCode[17]
            Move "    GetBuff From sNmLV at tNM_LISTVIEW.POINT.X.Action To iX"     to asCode[18]
            Move "    Function_Return iCode"                         to asCode[19]
            Move "End_Function"                                      to asCode[20]
        End_Procedure

        /* THE DEFECT THIS WAS BUILT FOR. On its own member types NMHDR_code sat at offset 12; 64-bit Windows has it
           at 16, so iCode was wrong on x64 exactly as it was with the Type. "hdr.code" with nothing lost is also
           what a double space in the install's tWinNmHdr used to break: it came out as 'sNmLV.hdr.'. */
        {Published = True}
        Procedure Win32Msg_NotifyTypeTakesWindowsLayout
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send SeedMessageStructs
            Send NotifyListViewCluster (&asCode)
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("tWinNmHdr hdr", sAll) > 0) sAll
            Send Assert (Pos("tWinPoint ptAction", sAll) > 0) sAll
            Send Assert (Pos("LongPtr lParam", sAll) > 0) "the SDK's type, not the Type's DWord"
            Send Assert (Pos("iMissingAlignment1", sAll) > 0) "the padding in front of it"
            Send Assert (Pos("Move sNmLV.hdr.code to iCode", sAll) > 0) sAll
            Send Assert (Pos("Move sNmLV.ptAction.x to iX", sAll) > 0) sAll
            Send Assert (Pos("NMHDR_code", sAll) = 0) "not the joined name of the Type's own layout"
            Send Assert (Pos("NMLISTVIEW", sNotes) > 0) sNotes
        End_Procedure

        // Stops short of what Windows added later, and writes POINT with dots. It becomes the whole struct.
        {Published = True}
        Procedure Win32Msg_HitTestTypeBecomesTheWholeStruct
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send SeedMessageStructs
            Move "TYPE tLVHITTESTINFO"                        to asCode[0]
            Move "    Field tLVHITTESTINFO.PT.x     as Dword" to asCode[1]
            Move "    Field tLVHITTESTINFO.PT.y     as Dword" to asCode[2]
            Move "    Field tLVHITTESTINFO.flags    as Dword" to asCode[3]
            Move "    Field tLVHITTESTINFO.iItem    as DWord" to asCode[4]
            Move "    Field tLVHITTESTINFO.iSubItem as DWord" to asCode[5]
            Move "END_TYPE"                                   to asCode[6]
            Move "Procedure P Integer x"                      to asCode[7]
            Move "    String sLvhtst"                         to asCode[8]
            Move "    ZeroType tLVHITTESTINFO To sLvhtst"     to asCode[9]
            Move "    Put x To sLvhtst At tLVHITTESTINFO.PT.x" to asCode[10]
            Move "End_Procedure"                              to asCode[11]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("tWinPoint pt", sAll) > 0) sAll
            Send Assert (Pos("Integer iGroup", sAll) > 0) "the member the Type left out"
            Send Assert (Pos("Move x to sLvhtst.PT.x", sAll) > 0) sAll
            Send Assert (Pos("whole Windows struct LVHITTESTINFO", sNotes) > 0 and Pos("iGroup", sNotes) > 0) sNotes
        End_Procedure

        // The first 10 of LVITEMA's 15, and what makes it wrong on x64 as it stands: pszText and lParam.
        {Published = True}
        Procedure Win32Msg_ItemTypeBecomesTheWholeStruct
            String[] asCode asNotes
            String sAll sNotes
            Integer iCount
            Send SeedMessageStructs
            Move "TYPE tLV_ITEM"                          to asCode[0]
            Move "    Field tLV_ITEM.mask       as DWORD" to asCode[1]
            Move "    Field tLV_ITEM.iItem      as DWORD" to asCode[2]
            Move "    Field tLV_ITEM.iSubItem   as DWORD" to asCode[3]
            Move "    Field tLV_ITEM.state      as DWORD" to asCode[4]
            Move "    Field tLV_ITEM.stateMask  as DWORD" to asCode[5]
            Move "    Field tLV_ITEM.pszText    as POINTER" to asCode[6]
            Move "    Field tLV_ITEM.cchTextMax as DWORD" to asCode[7]
            Move "    Field tLV_ITEM.iImage     as DWORD" to asCode[8]
            Move "    Field tLV_ITEM.lParam     as DWORD" to asCode[9]
            Move "    Field tLV_ITEM.iIndent    as DWORD" to asCode[10]
            Move "END_TYPE"                               to asCode[11]
            Move "Procedure P Integer iData"              to asCode[12]
            Move "    String sLv"                         to asCode[13]
            Move "    ZeroType tLV_ITEM To sLv"           to asCode[14]
            Move "    Put iData To sLv at tLV_ITEM.lParam" to asCode[15]
            Move "End_Procedure"                          to asCode[16]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("Pointer pszText", sAll) > 0) sAll
            Send Assert (Pos("LongPtr lParam", sAll) > 0) sAll
            Send Assert (Pos("Integer iMissingAlignment1", sAll) > 0) "the padding in front of pszText"
            Send Assert (Pos("Integer iGroup", sAll) > 0) "the rest of the struct"
            Send Assert (Pos("Move iData to sLv.lParam", sAll) > 0) sAll
            Send Assert (Pos("whole Windows struct LVITEMA", sNotes) > 0) sNotes
        End_Procedure

        /* A NAME THAT IS A COINCIDENCE IS NOT A REFUSAL. The catalogue has rows called VAL, CAL and TINT, and before
           those rows existed a Type of that name converted on its own member types. Both ways of not fitting: the
           same count with nothing in common, and a short list whose names part from the struct's. */
        {Published = True}
        Procedure Win32Msg_ANameThatDoesNotFitConvertsOnItsOwnTypes
            String[] asCode asNotes asCat asSaved
            String sAll sNotes
            Integer iCount
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move ("WIDGET|DF|Struct WIDGET" + (Character(10)) + "Pointer alpha" + (Character(10)) + "Pointer beta" + (Character(10)) + "End_Struct") to asCat[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Move "Type tWidget"                     to asCode[0]
            Move "    Field tWidget.left  as DWord" to asCode[1]
            Move "    Field tWidget.right as DWord" to asCode[2]
            Move "End_Type"                         to asCode[3]
            Move "Procedure P"                      to asCode[4]
            Move "    String sW"                    to asCode[5]
            Move "    ZeroType tWidget To sW"       to asCode[6]
            Move "    Put 1 To sW At tWidget.left"  to asCode[7]
            Move "End_Procedure"                    to asCode[8]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Get AllLines asNotes to sNotes
            Send Assert (Pos("DWord left", sAll) > 0) sAll
            Send Assert (Pos("Pointer", sAll) = 0) "nothing of the struct it only shares a name with"
            Send Assert (Pos("its name points at the Windows struct WIDGET", sNotes) > 0) sNotes

            Send SeedMessageStructs
            Move (ResizeArray(asNotes, 0)) to asNotes
            Move (ResizeArray(asCode, 0)) to asCode
            Move "TYPE tLVCOLUMN"                     to asCode[0]
            Move "    Field tLVCOLUMN.mask  as DWORD" to asCode[1]
            Move "    Field tLVCOLUMN.fmt   as DWORD" to asCode[2]
            Move "    Field tLVCOLUMN.width as DWORD" to asCode[3]
            Move "    Field tLVCOLUMN.text  as POINTER" to asCode[4]
            Move "END_TYPE"                           to asCode[5]
            Move "Procedure P"                        to asCode[6]
            Move "    String sC"                      to asCode[7]
            Move "    Put 1 To sC At tLVCOLUMN.width" to asCode[8]
            Move "End_Procedure"                      to asCode[9]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asNotes to sNotes
            Send Assert (Pos("its name points at the Windows struct LVCOLUMNA", sNotes) > 0) sNotes
        End_Procedure

        // Found by its member names only, on a row whose union nothing can write: its own types, not a refusal.
        {Published = True}
        Procedure Win32Msg_AShapeThatCannotBeWrittenConvertsOnItsOwnTypes
            String[] asCode asNotes asCat asSaved
            String sAll
            Integer iCount
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Move ("ZORBLE|DF|Struct ZORBLE" + (Character(10)) + "Integer first" + (Character(10)) + "Integer second" + (Character(10)) + "Integer third" + (Character(10)) + "_Anonymous_e__Union_9 fourth" + (Character(10)) + "End_Struct") to asCat[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asCat
            Move "Type tUnrelatedName"                       to asCode[0]
            Move "    Field tUnrelatedName.first  as DWord"  to asCode[1]
            Move "    Field tUnrelatedName.second as DWord"  to asCode[2]
            Move "    Field tUnrelatedName.third  as DWord"  to asCode[3]
            Move "    Field tUnrelatedName.fourth as DWord"  to asCode[4]
            Move "End_Type"                                  to asCode[5]
            Move "Procedure P"                               to asCode[6]
            Move "    String sU"                             to asCode[7]
            Move "    ZeroType tUnrelatedName To sU"         to asCode[8]
            Move "    Put 1 To sU At tUnrelatedName.first"   to asCode[9]
            Move "End_Procedure"                             to asCode[10]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("DWord fourth", sAll) > 0) sAll
        End_Procedure

        // "Else ;" with a comment under it ended the Else, so every nested member of a C row became an Integer.
        {Published = True}
        Procedure Win32Msg_ACRowNestsTheShippedStructs
            String[] asNotes
            String sDecl
            Send SeedMessageStructs
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get WinAPIStructDataFlexDecl of ghoFuncLib "NMSELCHANGE" (&asNotes) to sDecl
            Send Assert (Pos("tWinNmHdr nmhdr", sDecl) > 0) sDecl
            Send Assert (Pos("tWinSystemTime stSelStart", sDecl) > 0) sDecl
            Get WinAPIStructDataFlexDecl of ghoFuncLib "NMCUSTOMDRAW" (&asNotes) to sDecl
            Send Assert (Pos("tWinNmHdr hdr", sDecl) > 0) sDecl
            Send Assert (Pos("tWinRect rc", sDecl) > 0) sDecl
            Send Assert (Pos("MissingAlignment", sDecl) > 0) "the padding it computes"
        End_Procedure

        // The real tNMSELCHANGE takes that row's layout, written out as it is, guarded padding and all.
        {Published = True}
        Procedure Win32Msg_SelChangeTakesTheHandAddedRow
            String[] asCode asNotes
            String sAll
            Integer iCount
            Send SeedMessageStructs
            Move "Type tNMSELCHANGE"                                    to asCode[0]
            Move "    Field tNMSELCHANGE.tNMHDR.hWndFrom as HANDLE"     to asCode[1]
            Move "    Field tNMSELCHANGE.tNMHDR.idFrom   as DWORD"      to asCode[2]
            Move "    Field tNMSELCHANGE.tNMHDR.code     as DWORD"      to asCode[3]
            Move "    Field tNMSELCHANGE.stSelStart.wYear as Short"     to asCode[4]
            Move "    Field tNMSELCHANGE.stSelStart.wMonth as Short"    to asCode[5]
            Move "    Field tNMSELCHANGE.stSelStart.wDayOfWeek as Short" to asCode[6]
            Move "    Field tNMSELCHANGE.stSelStart.wDay as Short"      to asCode[7]
            Move "    Field tNMSELCHANGE.stSelStart.wHour as Short"     to asCode[8]
            Move "    Field tNMSELCHANGE.stSelStart.wMinute as Short"   to asCode[9]
            Move "    Field tNMSELCHANGE.stSelStart.wSecond as Short"   to asCode[10]
            Move "    Field tNMSELCHANGE.stSelStart.wMilliseconds as Short" to asCode[11]
            Move "    Field tNMSELCHANGE.stSelEnd.wYear as Short"       to asCode[12]
            Move "    Field tNMSELCHANGE.stSelEnd.wMonth as Short"      to asCode[13]
            Move "    Field tNMSELCHANGE.stSelEnd.wDayOfWeek as Short"  to asCode[14]
            Move "    Field tNMSELCHANGE.stSelEnd.wDay as Short"        to asCode[15]
            Move "    Field tNMSELCHANGE.stSelEnd.wHour as Short"       to asCode[16]
            Move "    Field tNMSELCHANGE.stSelEnd.wMinute as Short"     to asCode[17]
            Move "    Field tNMSELCHANGE.stSelEnd.wSecond as Short"     to asCode[18]
            Move "    Field tNMSELCHANGE.stSelEnd.wMilliseconds as Short" to asCode[19]
            Move "End_Type"                                             to asCode[20]
            Move "Function F Returns Integer"                           to asCode[21]
            Move "    String sSC"                                       to asCode[22]
            Move "    Integer iCode"                                    to asCode[23]
            Move "    GetBuff From sSC at tNMSELCHANGE.tNMHDR.code To iCode" to asCode[24]
            Move "    Function_Return iCode"                            to asCode[25]
            Move "End_Function"                                         to asCode[26]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send AssertIAreEqual 1 iCount
            Get AllLines asCode to sAll
            Send Assert (Pos("tWinNmHdr nmhdr", sAll) > 0) sAll
            Send Assert (Pos("Move sSC.nmhdr.code to iCode", sAll) > 0) sAll
        End_Procedure

        // Who splits the install's struct lines decides whether "DWord  code" has a name at all.
        {Published = True}
        Procedure Win32Msg_ADoubleSpaceInTheInstallLosesNoMember
            String[] asMembers
            Boolean bFound
            Send SeedMessageStructs
            Get _ShippedStructMembers of ghoFuncLib "tWinNmHdr" (&asMembers) to bFound
            Send Assert bFound
            Send AssertSAreEqual "code" asMembers[2]
        End_Procedure

        /* WINDOWS READS WHAT THE CONVERTER EMITS. A green compile says nothing about a layout, so a real SysListView32
           takes the emitted LVCOLUMN, LVITEM and LVHITTESTINFO shapes and answers through them. It is never shown:
           WS_POPUP without WS_VISIBLE, and a list view lays its items out whether it is on screen or not.
           A value above 32 bits in lParam, the pszText pointer and the hit-test result would each read wrong on the
           legacy Type's layout, where pszText stood 4 bytes early and lParam was a DWord. */
        {Published = True}
        Procedure Win32Proof_WindowsReadsTheListViewStructs
            tTestLvItem Item ReadBack
            tTestLvColumn Column
            tTestLvHitTest Hit
            tWinRect Bounds
            Handle hLv
            String sColumn sItem sOut
            Pointer pOut
            LongPtr lpRet
            Integer iRet

            Move (TestLvInitControls()) to iRet
            // WS_POPUP + LVS_REPORT
            Move (TestLvCreateWindow(0, "SysListView32", "", (|CI$80000000 + 1), 0, 0, 400, 300, 0, 0, 0, 0)) to hLv
            Send Assert (hLv <> 0) "a list view"
            If (hLv = 0) ;
                Procedure_Return

            Move "Column" to sColumn
            Move 6 to Column.mask            // LVCF_TEXT + LVCF_WIDTH
            Move 120 to Column.cx
            Move (AddressOf(sColumn)) to Column.pszText
            Move (TestLvSendMessage(hLv, |CI$101B, 0, AddressOf(Column))) to lpRet   // LVM_INSERTCOLUMNA
            Send Assert (lpRet = 0) "Windows took the column"
            Move (TestLvSendMessage(hLv, |CI$101D, 0, 0)) to lpRet                   // LVM_GETCOLUMNWIDTH
            Send AssertIAreEqual 120 lpRet

            Move "Probe" to sItem
            Move 5 to Item.mask              // LVIF_TEXT + LVIF_PARAM
            Move (AddressOf(sItem)) to Item.pszText
            Move 1099511627853 to Item.lParam
            Move (TestLvSendMessage(hLv, |CI$1007, 0, AddressOf(Item))) to lpRet     // LVM_INSERTITEMA
            Send Assert (lpRet = 0) "Windows took the item"

            Move 4 to ReadBack.mask          // LVIF_PARAM
            Move (TestLvSendMessage(hLv, |CI$1005, 0, AddressOf(ReadBack))) to lpRet // LVM_GETITEMA
            Send Assert (lpRet <> 0) "Windows read the item back"
            Send Assert (ReadBack.lParam = 1099511627853) "a value above 32 bits comes back whole"

            Move (Repeat(Character(0), 64)) to sOut
            Move (AddressOf(sOut)) to pOut
            Move 0 to ReadBack.iSubItem
            Move pOut to ReadBack.pszText
            Move 64 to ReadBack.cchTextMax
            Move (TestLvSendMessage(hLv, |CI$102D, 0, AddressOf(ReadBack))) to lpRet // LVM_GETITEMTEXTA
            Send AssertIAreEqual 5 lpRet
            Send AssertSAreEqual "Probe" (CString(sOut))

            Move 0 to Bounds.left            // LVIR_BOUNDS
            Move (TestLvSendMessage(hLv, |CI$100E, 0, AddressOf(Bounds))) to lpRet   // LVM_GETITEMRECT
            Send Assert (lpRet <> 0) "the item has a rectangle"
            Move (Bounds.left + 5) to Hit.pt.x
            Move ((Bounds.top + Bounds.bottom) / 2) to Hit.pt.y
            Move -5 to Hit.iItem
            Move (TestLvSendMessage(hLv, |CI$1039, 0, AddressOf(Hit))) to lpRet      // LVM_SUBITEMHITTEST
            Send AssertIAreEqual 0 lpRet
            Send AssertIAreEqual 0 Hit.iItem
            Send Assert (Hit.flags <> 0) "the flags came back where the struct has them"
            Move 390 to Hit.pt.x
            Move 290 to Hit.pt.y
            Move (TestLvSendMessage(hLv, |CI$1039, 0, AddressOf(Hit))) to lpRet
            Send AssertIAreEqual -1 Hit.iItem

            Move (TestLvDestroyWindow(hLv)) to iRet
        End_Procedure

        /* The notification itself comes to a parent's window procedure, which a test cannot be. So this holds it to
           the install's own tWinNM_LISTVIEW, and to the numbers commctrl.h gives on x64. code at 16 is the point: on
           the Type's own member types it was at 12. */
        {Published = True}
        Procedure Win32Proof_NotifyStructHasWindowsOffsets
            tTestNmListView Nm
            Pointer pBase

            Move (AddressOf(Nm)) to pBase
            Send AssertIAreEqual (SizeOfType(tWinNM_LISTVIEW)) (SizeOfType(tTestNmListView))
            Send AssertIAreEqual 64 (SizeOfType(tTestNmListView))
            Send AssertIAreEqual 16 (AddressOf(Nm.hdr.code) - pBase)
            Send AssertIAreEqual 24 (AddressOf(Nm.iItem) - pBase)
            Send AssertIAreEqual 56 (AddressOf(Nm.lParam) - pBase)
        End_Procedure

        // Helper: DataFlex 26's Dftypes.pkg as far as DEVMODE needs it - its two size Defines and the Type, as shipped.
        Function DfTypesDevModeLines Returns String[]
            String[] asL
            Move "Define CCHDEVICENAME                            for 32" to asL[0]
            Move "Define CCHFORMNAME                              for 32" to asL[1]
            Move "Type DEVMODE" to asL[2]
            Move "    Field DEVMODE.dmDeviceName     as Char CCHDEVICENAME" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmSpecVersion    as Word" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmDriverVersion  as Word" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmSize           as Word" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmDriverExtra    as Word" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmFields         as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmOrientation    as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPaperSize      as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPaperLength    as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPaperWidth     as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmScale          as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmCopies         as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmDefaultSource  as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPrintQuality   as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmColor          as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmDuplex         as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmYResolution    as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmTTOption       as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmCollate        as Short" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmFormName       as Char CCHFORMNAME" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmLogPixels      as Word" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmBitsPerPel     as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPelsWidth      as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmPelsHeight     as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmNup            as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmICMMethod      as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmICMIntent      as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmMediaType      as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmDitherType     as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmReserved1      as DWord" to asL[SizeOfArray(asL)]
            Move "    Field DEVMODE.dmReserved2      as DWord" to asL[SizeOfArray(asL)]
            Move "    //Field DEVMODE.dmPanningWidth  as dWord" to asL[SizeOfArray(asL)]
            Move "    //Field DEVMODE.dmPanningHeight as dWord" to asL[SizeOfArray(asL)]
            Move "End_Type // DEVMODE" to asL[SizeOfArray(asL)]
            Function_Return asL
        End_Function

        /* DEVMODE, BYTE FOR BYTE (2026-11-13). DataFlex ships no Struct for it, so the converter copies Dftypes.pkg's
           Type: Word as UShort, Char CCHDEVICENAME as Char[32], every member where it was. The offsets are the ones
           DataFlex's own Prnt_dlg.pkg ReadDevMode reads (BytesToShort(sDevMode, 45), Mid(sDevMode, CCHFORMNAME, 71),
           BytesToDWord(sDevMode, 121) and 133 - one-based), and 144 bytes is DEVMODE_Size: the Struct is the Type,
           dmDisplayFrequency missing and all. */
        {Published = True}
        Procedure DfTypes_DevModeIsCopiedByteForByte
            tTestDevMode Dm
            String[] asDf asBody asBlock asWant asTok
            String sStruct sWhy
            Integer i
            Boolean bOK
            Pointer pBase

            Get DfTypesDevModeLines to asDf
            Get _DfTypesLiftedStruct of ghoFuncLib "DEVMODE" (&asDf) (&sStruct) (&asBody) (&asBlock) (&sWhy) to bOK
            Send Assert bOK sWhy
            Send AssertSAreEqual "tDevMode" sStruct
            Send AssertIAreEqual 33 (SizeOfArray(asBody))
            Move (StrSplitToArray("Char[32] dmDeviceName|UShort dmSpecVersion|UShort dmDriverVersion|UShort dmSize|UShort dmDriverExtra|DWord dmFields|Short dmOrientation|Short dmPaperSize|Short dmPaperLength|Short dmPaperWidth|Short dmScale|Short dmCopies|Short dmDefaultSource|Short dmPrintQuality|Short dmColor|Short dmDuplex|Short dmYResolution|Short dmTTOption|Short dmCollate|Char[32] dmFormName|UShort dmLogPixels|DWord dmBitsPerPel|DWord dmPelsWidth|DWord dmPelsHeight|DWord dmNup|DWord dmICMMethod|DWord dmICMIntent|DWord dmMediaType|DWord dmDitherType|DWord dmReserved1|DWord dmReserved2", "|")) to asWant
            For i from 0 to (SizeOfArray(asWant) - 1)
                Get _SplitSourceWords of ghoFuncLib asBody[i] to asTok
                Send AssertSAreEqual asWant[i] (asTok[0] + " " + asTok[1])
            Loop
            Send AssertSAreEqual "    Char[32] dmDeviceName  // CCHDEVICENAME" asBody[0]
            Send AssertSAreEqual "    Char[32] dmFormName  // CCHFORMNAME" asBody[19]
            Send AssertSAreEqual "Struct tDevMode" asBlock[1]
            Send AssertSAreEqual "End_Struct" asBlock[(SizeOfArray(asBlock) - 1)]

            Move (AddressOf(Dm)) to pBase
            Send AssertIAreEqual 144 (SizeOfType(tTestDevMode))
            Send AssertIAreEqual 44  (AddressOf(Dm.dmOrientation) - pBase)
            Send AssertIAreEqual 70  (AddressOf(Dm.dmFormName) - pBase)
            Send AssertIAreEqual 120 (AddressOf(Dm.dmICMMethod) - pBase)
            Send AssertIAreEqual 132 (AddressOf(Dm.dmDitherType) - pBase)
        End_Procedure

        /* ONLY THE LISTED TYPES, AND ONLY FIXED SIZES. PRINTDLG is not copied at all: it holds Handles, and a
           Dftypes.pkg Type has no alignment padding to copy, so it needs the SDK's layout. A listed Type with a Handle
           is refused with its member named, and one the lines do not declare says so. */
        {Published = True}
        Procedure DfTypes_OnlyListedFixedSizeTypesAreCopied
            String[] asDf asBody asBlock
            String sStruct sWhy
            Boolean bOK

            Get DfTypesDevModeLines to asDf
            Get _DfTypesLiftedStruct of ghoFuncLib "PRINTDLG" (&asDf) (&sStruct) (&asBody) (&asBlock) (&sWhy) to bOK
            Send Assert (bOK = False) "PRINTDLG is not on the list"
            Send AssertSAreEqual "" sWhy
            Get _DfTypesLiftedStruct of ghoFuncLib "DEVNAMES" (&asDf) (&sStruct) (&asBody) (&asBlock) (&sWhy) to bOK
            Send Assert (bOK = False) "DEVNAMES is not in these lines"
            Send Assert (Pos("does not declare", sWhy) > 0) sWhy
            Move "Type DEVNAMES"                          to asDf[SizeOfArray(asDf)]
            Move "    Field DEVNAMES.wDriverOffset as Word" to asDf[SizeOfArray(asDf)]
            Move "    Field DEVNAMES.hOwner as Handle"      to asDf[SizeOfArray(asDf)]
            Move "End_Type"                               to asDf[SizeOfArray(asDf)]
            Get _DfTypesLiftedStruct of ghoFuncLib "DEVNAMES" (&asDf) (&sStruct) (&asBody) (&asBlock) (&sWhy) to bOK
            Send Assert (bOK = False) "a Handle member is refused"
            Send Assert (Pos("hOwner is Handle", sWhy) > 0) sWhy
        End_Procedure

        /* THE PRINTER-DIALOG CODE, CONVERTED (2026-11-13) - the shape workspaces copied from Prnt_dlg.pkg. The buffer
           becomes a tDevMode, ZeroType goes, Put_String copies at most the member's 32 bytes, every DEVMODE_Size - in a
           Put and inside GlobalAlloc / CopyMemory - becomes SizeOfType(tDevMode), AddressOf stays, and the file Uses
           DfTypesStructs.pkg, above its code. */
        {Published = True}
        Procedure DfTypes_PrinterDialogCodeConverts
            String[] asDf asCode asNotes asLifted asNone
            String sAll
            Integer iCount

            Get DfTypesDevModeLines to asDf
            Set pasDfTypesLines of ghoFuncLib to asDf
            Set pbDfTypesRead   of ghoFuncLib to True
            Move "Function InitDevMode Returns Handle"                                      to asCode[0]
            Move "  Integer iVoid"                                                          to asCode[1]
            Move "  Pointer pHeap pDevMode"                                                 to asCode[2]
            Move "  String sDevMode"                                                        to asCode[3]
            Move "  Handle hHeap"                                                           to asCode[4]
            Move "  Move (GlobalAlloc(GMEM_MOVEABLE,DEVMODE_Size)) To hHeap"                to asCode[5]
            Move "  Move (GlobalLock(hHeap)) To pHeap"                                      to asCode[6]
            Move "  ZeroType DEVMODE To sDevMode"                                           to asCode[7]
            Move "  Put_String (DeviceName(oPrinter)) To sDevMode At DEVMODE.dmDeviceName" to asCode[8]
            Move "  Put DM_SPECVERSION_400        To sDevMode At DEVMODE.dmSpecVersion"     to asCode[9]
            Move "  Put DEVMODE_Size              To sDevMode At DEVMODE.dmSize"            to asCode[10]
            Move "  Put (Orientation(oPrinter))   to sDevMode at DEVMODE.dmOrientation"     to asCode[11]
            Move "  Put (ICMMethod(oPrinter))     to sDevMode at DEVMODE.dmICMMethod"       to asCode[12]
            Move "  Move (AddressOf(sDevMode)) to pDevMode"                                 to asCode[13]
            Move "  Move (CopyMemory(pHeap,pDevMode,DEVMODE_Size)) To iVoid"                to asCode[14]
            Move "  Function_Return hHeap"                                                  to asCode[15]
            Move "End_Function"                                                             to asCode[16]
            Get _ConvertWin32TypeBuffersInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Set pasDfTypesLines of ghoFuncLib to asNone
            Set pbDfTypesRead   of ghoFuncLib to False
            Get AllLines asCode to sAll
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual "Use DfTypesStructs.pkg" asCode[0]
            Send Assert (Pos("tDevMode sDevMode", sAll) > 0) sAll
            Send Assert (Pos("zerotype", Lowercase(sAll)) = 0) sAll
            Send Assert (Pos("devmode_size", Lowercase(sAll)) = 0) sAll
            Send Assert (Pos("Move (SizeOfType(tDevMode)) to sDevMode.dmSize", sAll) > 0) sAll
            Send Assert (Pos("GlobalAlloc(GMEM_MOVEABLE,SizeOfType(tDevMode))", sAll) > 0) sAll
            Send Assert (Pos("CopyMemory(pHeap,pDevMode,SizeOfType(tDevMode))", sAll) > 0) sAll
            Send Assert (Pos("Move (AddressOf(sDevMode)) to pDevMode", sAll) > 0) sAll
            Send Assert (Pos("AddressOf(sDevMode.dmDeviceName)", sAll) > 0) sAll
            Send Assert (Pos(", 32)", sAll) > 0) sAll
            Send Assert (Pos("Move (ICMMethod(oPrinter)) to sDevMode.dmICMMethod", sAll) > 0) sAll
            Get pasDfTypesLifted of ghoFuncLib to asLifted
            Send AssertIAreEqual 1 (SizeOfArray(asLifted))
            Send AssertSAreEqual "tDevMode" asLifted[0]
        End_Procedure

        /* THE PACKAGE: a header and the block for a new one, and every Struct once - a second file of the same program
           adds nothing, another Type adds its own block. */
        {Published = True}
        Procedure DfTypes_PackageDeclaresEachStructOnce
            String[] asOld asNew asNames asBlocks
            Integer iFirst

            Move "tDevMode" to asNames[0]
            Move ("// DEVMODE" + Character(10) + "Struct tDevMode" + Character(10) + "    UShort dmSize" + Character(10) + "End_Struct") to asBlocks[0]
            Get _DfTypesStructsMerged of ghoFuncLib (&asOld) (&asNames) (&asBlocks) to asNew
            Send Assert (Pos("DfTypesStructs.pkg", asNew[0]) > 0) asNew[0]
            Send AssertIAreEqual 10 (SizeOfArray(asNew))
            Send AssertSAreEqual "Struct tDevMode" asNew[7]
            Move (SizeOfArray(asNew)) to iFirst
            Get _DfTypesStructsMerged of ghoFuncLib (&asNew) (&asNames) (&asBlocks) to asNew
            Send AssertIAreEqual iFirst (SizeOfArray(asNew))
            Move "tDevNames" to asNames[1]
            Move ("Struct tDevNames" + Character(10) + "    UShort wDefault" + Character(10) + "End_Struct") to asBlocks[1]
            Get _DfTypesStructsMerged of ghoFuncLib (&asNew) (&asNames) (&asBlocks) to asNew
            Send AssertIAreEqual (iFirst + 4) (SizeOfArray(asNew))
            Send AssertSAreEqual "Struct tDevNames" asNew[iFirst + 1]
        End_Procedure

        /* THE PACKAGE ON DISK: written into the AppSrc folder (a scratch one here), left alone when it declares the
           Struct already, and never written by an analyzer probe. */
        {Published = True}
        Procedure DfTypes_WriterWritesThePackageOnce
            String[] asNames asBlocks asNotes asLines asNone
            String sFolder sFile
            Integer iLines
            Boolean bOK

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_DfTypes") to sFolder
            Move (rfRemoveFolderTree(sFolder)) to bOK
            Move (rfDirectoryCreateEx(sFolder, False)) to bOK
            Send Assert bOK "the scratch folder could not be made"
            Move (vFolderFormat(sFolder) + "DfTypesStructs.pkg") to sFile
            Set psDfTypesStructsFolder of ghoFuncLib to sFolder
            Move "tDevMode" to asNames[0]
            Move ("Struct tDevMode" + Character(10) + "    UShort dmSize" + Character(10) + "End_Struct") to asBlocks[0]
            Set pasDfTypesLifted       of ghoFuncLib to asNames
            Set pasDfTypesLiftedBlocks of ghoFuncLib to asBlocks

            Set pbWholeFileProbe of ghoFuncLib to True
            Get _WriteDfTypesStructs of ghoFuncLib (&asNotes) to bOK
            Set pbWholeFileProbe of ghoFuncLib to False
            Send Assert bOK "a probe is not a failure"
            Send Assert (vFilePathExists(sFile) = False) "a probe wrote the package"

            Get _WriteDfTypesStructs of ghoFuncLib (&asNotes) to bOK
            Send Assert bOK (StrJoinFromArray(asNotes, " | "))
            Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
            Move (SizeOfArray(asLines)) to iLines
            Send Assert (SearchArray("Struct tDevMode", asLines) <> -1) "the package declares the Struct"
            Send Assert (Pos("DfTypesStructs.pkg", asLines[0]) > 0) asLines[0]

            Get _WriteDfTypesStructs of ghoFuncLib (&asNotes) to bOK
            Send Assert bOK "already declared"
            Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
            Send AssertIAreEqual iLines (SizeOfArray(asLines))

            Set psDfTypesStructsFolder of ghoFuncLib to ""
            Set pasDfTypesLifted       of ghoFuncLib to asNone
            Set pasDfTypesLiftedBlocks of ghoFuncLib to asNone
            Move (rfRemoveFolderTree(sFolder)) to bOK
        End_Procedure

        /* A USE GOES ABOVE A LEADING CONDITIONAL (2026-11-13). The file opens by guarding a global in a conditional
           and has no Use at all; inside the guard the Use would compile only while that symbol is undefined. */
        {Published = True}
        Procedure DfTypes_UseGoesAboveALeadingConditional
            String[] asCode
            Move ((Character(35)) + "IFNDEF gbProbeFlag")  to asCode[0]
            Move "    Global_Variable Boolean gbProbeFlag"  to asCode[1]
            Move ((Character(35)) + "ENDIF")               to asCode[2]
            Move "Move False to gbProbeFlag"                to asCode[3]
            Send _EnsureUseForNewDependency of ghoFuncLib (&asCode) "DfTypesStructs.pkg"
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual "Use DfTypesStructs.pkg" asCode[0]
            Send AssertSAreEqual ((Character(35)) + "IFNDEF gbProbeFlag") asCode[1]
        End_Procedure

        /* "LOCAL STRING" DECLARES A BUFFER TOO (2026-11-13). A package's printer function declares its DEVMODE buffer with the
           legacy Local prefix, and the whole Type was refused over that one line. The siblings keep the prefix; the
           struct lines need none. */
        {Published = True}
        Procedure Win32Decl_LocalStringIsABufferDeclaration
            String sOut
            Boolean bIs
            Get _IsBufferDeclLine of ghoFuncLib "  Local String sDevMode" "sDevMode" to bIs
            Send Assert bIs "Local String declares the buffer"
            Get _IsBufferDeclLine of ghoFuncLib "  Local Integer iDevMode" "iDevMode" to bIs
            Send Assert (bIs = False) "an Integer is no buffer"
            Get _DeclLineWithBufferLifted of ghoFuncLib "  Local String sName sDevMode" "sDevMode" "tDevMode" True False to sOut
            Send AssertSAreEqual ("  Local String sName" + Character(10) + "  tDevMode sDevMode" + Character(10) + "  tDevMode sDevModeEmpty") sOut
            Get _DeclLineWithBufferLifted of ghoFuncLib "  Local String sDevMode" "sDevMode" "tDevMode" True False to sOut
            Send AssertSAreEqual ("  tDevMode sDevMode" + Character(10) + "  tDevMode sDevModeEmpty") sOut
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
