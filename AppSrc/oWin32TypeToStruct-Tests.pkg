//****************************************************************************
// $Module type: Test fixture
// $Module name: oWin32TypeToStruct-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-30
//
// Description : Unit tests for the member merge behind the legacy Win32 Type -> Struct
//               conversion: the author's member NAMES carrying the SDK's member TYPES.
//
//               Why that combination is the whole trick: every existing reference names a
//               member ("Put lpsTitle To sBrowseInfo At vtBrowseInfo.lpszTitle"), so keeping
//               the author's names means no call site has to change - while taking the SDK's
//               types is what fixes a layout that is silently wrong on x64.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    // The struct the converter emits for tagMENUITEMINFO, and the calls that put it in front of Windows. Every
    // gap in these is a 64-bit one (in front of a pointer), so it sits inside #IFDEF IS$WIN64, as emitted.
    Struct tTestWholeMenuItemInfo
        UInteger cbSize
        UInteger fMask
        UInteger fType
        UInteger fState
        UInteger wID
#IFDEF IS$WIN64
        Integer iMissingAlignment1
#ENDIF
        Handle hSubMenu
        Handle hbmpChecked
        Handle hbmpUnchecked
        ULongPtr dwItemData
        Pointer dwTypeData
        UInteger cch
#IFDEF IS$WIN64
        Integer iMissingAlignment2
#ENDIF
        Handle hbmpItem
    End_Struct
    // What ChangeExternalFunctionCallers writes into DfTypesStructs.pkg for DataFlex's DEVMODE - the body
    // DfTypes_DevModeIsCopiedByteForByte holds the converter to, member for member (2026-11-13).
    Struct tTestDevMode
        Char[32] dmDeviceName
        UShort dmSpecVersion
        UShort dmDriverVersion
        UShort dmSize
        UShort dmDriverExtra
        DWord dmFields
        Short dmOrientation
        Short dmPaperSize
        Short dmPaperLength
        Short dmPaperWidth
        Short dmScale
        Short dmCopies
        Short dmDefaultSource
        Short dmPrintQuality
        Short dmColor
        Short dmDuplex
        Short dmYResolution
        Short dmTTOption
        Short dmCollate
        Char[32] dmFormName
        UShort dmLogPixels
        DWord dmBitsPerPel
        DWord dmPelsWidth
        DWord dmPelsHeight
        DWord dmNup
        DWord dmICMMethod
        DWord dmICMIntent
        DWord dmMediaType
        DWord dmDitherType
        DWord dmReserved1
        DWord dmReserved2
    End_Struct
    // What the converter emits for a list view's message structs, and the calls that hand them to Windows.
    Struct tTestLvItem
        UInteger mask
