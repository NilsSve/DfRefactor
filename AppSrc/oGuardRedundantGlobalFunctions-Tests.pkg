//****************************************************************************
// $Module type: Test fixture
// $Module name: oGuardRedundantGlobalFunctions-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-21
//
// Description : Unit tests for _GuardGlobalsInLines - the PURE core of GuardRedundantGlobalFunctions (which was
//               UnicodeRetireRedundantConversions). It wraps a file's OWN top-level GLOBAL Function/Procedure
//               declarations whose names the target DataFlex now ships natively in an #IF (!@ <= ver) ... #ENDIF
//               guard, so the home-brewed copy compiles only on releases that lack the built-in (error 4390).
//
//               The PURE core is tested, not the published wrapper: the wrapper resolves the version from
//               pTargetWS (absent on the DFUnit runner's plain cApplication) and the name set from the target
//               install's catalogue (needs a package walk). Passing both in keeps these tests hermetic.
//
//               NOTE the expected guard text is Character()-built here for the SAME reason the converter builds it
//               that way: FMAC evaluates its directive/counter tokens before string-literal semantics exist, so a
//               literal "#IF (!@ ..." in this file would be consumed by the compile instead of being a string.
//
//               Emission order is 3 marker comments, the #IF, the VERBATIM block, then #ENDIF - so a declaration
//               at input index 0 lands at output index 4.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oGuardRedundantGlobalFunctions is a cTestFixture
        Set psFunctionName to "GuardRedundantGlobalFunctions"

        // The native-name catalogue a real run would read from the target install.
        Function GRGF_Natives Returns String[]
            String[] asNative
            Move "OemToUtf8"         to asNative[0]
            Move "Utf8ToOem"         to asNative[1]
            Move "MultiToWideBuffer" to asNative[2]
            Function_Return asNative
        End_Function

        // The guard line the converter should emit for 19.1.
        Function GRGF_ExpectedOpen Returns String
            Function_Return (Character(35) + "IF (" + Character(33) + "@ <= 191)")
        End_Function

        // A global whose name is now native gets guarded, and the declaration survives VERBATIM.
        {Published = True}
        Procedure GRGF_NativeGlobal_Guarded
            String[] asCode asNative
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function OemToUtf8 Global String sValue Returns String" to asCode[0]
            Move "    String sResult"          to asCode[1]
            Move "    Function_Return sResult" to asCode[2]
            Move "End_Function"                to asCode[3]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 1)
            /* THE BOUNDARY IS PER FUNCTION (2026-08-16): OemToUtf8 first ships in DataFlex 20.1
               (Data\DfVersion-GlobalFuncs-20.1.json), so the guard is "< 201" - keep the copy on
               every release BEFORE the native - whatever version the caller passed. The passed
               19.1 used to become "<= 191", which is right only by coincidence on a 19.1
               workspace and wrong the moment the workspace is converted first (WinServ, 08-15:
               "<= 260" on a DF26 compile kept the copy alive and the 4390 came straight back). */
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 201)") asCode[3]
            Send AssertSAreEqual "Function OemToUtf8 Global String sValue Returns String" asCode[4]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[8]
        End_Procedure

        /* A WRONG GUARD OF OUR OWN IS REPAIRED IN PLACE; a hand-written one is not touched
           (2026-08-16). The 08-15 run wrote "<= 260" above OEMToUTF8 with our marker; a re-run
           must rewrite that one #IF line to "< 201" and count it as a change. A #IF with no marker
           is somebody's deliberate guard and stays exactly as it is - counted as already-guarded. */
        {Published = True}
        Procedure GRGF_OwnWrongGuardRepaired_HandGuardKept
            String[] asCode asNative
            Integer iCount iAlready

            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            // OUR marker + the OLD directive
            Move "// [DFRefactor] 'OemToUtf8' is now a NATIVE DataFlex global (duplicate-global error 4390)." to asCode[0]
            Move "// Kept for DataFlex 26.0 and older; newer builds use the native one instead."          to asCode[1]
            Move "// VERIFY the built-in matches this implementation - it CAN differ."                     to asCode[2]
            Move (Character(35) + "IF (" + Character(33) + "@ <= 260)")                                  to asCode[3]
            Move "Function OemToUtf8 Global String sValue Returns String"                                 to asCode[4]
            Move "    Function_Return sValue"                                                             to asCode[5]
            Move "End_Function"                                                                           to asCode[6]
            Move (Character(35) + "ENDIF")                                                               to asCode[7]
            // a HAND-WRITTEN guard: no marker
            Move (Character(35) + "IF (" + Character(33) + "@ <= 260)")                                  to asCode[8]
            Move "Function Utf8ToOem Global String sValue Returns String"                                 to asCode[9]
            Move "    Function_Return sValue"                                                             to asCode[10]
            Move "End_Function"                                                                           to asCode[11]
            Move (Character(35) + "ENDIF")                                                               to asCode[12]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Get piAlreadyGuardedCount of ghoFuncLib to iAlready
            Send Assert (iCount = 1)   "exactly one change: our wrong guard repaired"
            Send Assert (iAlready = 1) "the hand-written guard counted as already guarded, untouched"
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 201)")  asCode[3]
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ <= 260)") asCode[8]
            Send Assert (SizeOfArray(asCode) = 13) "no lines added or removed by a repair"
        End_Procedure

        /* THE CATALOGUE LOOKUP ITSELF (2026-08-16). Everything about the per-function boundary
           rests on FirstNativeVersionFor answering from Data\DfVersion-GlobalFuncs-<ver>.json
           oldest-first. Three shapes: a name that entered in 20.1 (OemToUtf8 - the WinServ case),
           one that has been there since the oldest catalogue (Trim), and one in NO catalogue
           (SQLExecute - runtime-owned, the third 4390 that correctly gets no Guard button). If
           this ever answers "" for OemToUtf8, every guard silently falls back to the workspace
           boundary and the 08-15 regression is back with no other test noticing. */
        {Published = True}
        Procedure GRGF_FirstNativeVersion_Lookup
            String sVer
            Get FirstNativeVersionFor of ghoFuncLib "OemToUtf8" to sVer
            Send AssertSAreEqual "20.1" sVer
            // Case-insensitive, as every name compare in this tool is.
            Get FirstNativeVersionFor of ghoFuncLib "OEMTOUTF8" to sVer
            Send AssertSAreEqual "20.1" sVer
            Get FirstNativeVersionFor of ghoFuncLib "SQLExecute" to sVer
            Send AssertSAreEqual "" sVer
        End_Procedure

        /* A GLOBAL SET PROCEDURE'S NAME IS TWO WORDS (2026-11-02). "Procedure Set Profile_Dword Global ..." read as a
           global called "Set" put that word in every catalogue, and every workspace's own global Set procedure got a
           guard it never needed: gone from the compile, every Set of it failing with error 4306. */
        {Published = True}
        Procedure GRGF_GlobalSetProcedure_HarvestedUnderItsTwoWordName
            String[] asLines asNames
            Move "Procedure Set Profile_Dword Global String sKey DWord dwValue" to asLines[0]
            Move "End_Procedure"                                                to asLines[1]
            Move "Procedure Set NotAGlobal Integer iValue"                      to asLines[2]
            Move "Procedure PlainOne Global"                                    to asLines[3]
            Move "Function PlainTwo Global Returns Integer"                     to asLines[4]
            Get _GlobalFuncNamesFromLines of ghoFuncLib asLines to asNames
            Send AssertIAreEqual 3 (SizeOfArray(asNames))
            Send AssertSAreEqual "Set Profile_Dword" asNames[0]
            Send AssertSAreEqual "PlainOne"          asNames[1]
            Send AssertSAreEqual "PlainTwo"          asNames[2]
        End_Procedure

        // The tracked catalogues say the same: the word alone in none of them, the real names since the oldest.
        {Published = True}
        Procedure GRGF_Catalogues_HaveNoGlobalCalledSet
            String sVer
            Get FirstNativeVersionFor of ghoFuncLib "Set" to sVer
            Send AssertSAreEqual "" sVer
            Get FirstNativeVersionFor of ghoFuncLib "Set Profile_Dword" to sVer
            Send AssertSAreEqual "18.1" sVer
            Get FirstNativeVersionFor of ghoFuncLib "SET SEQ_CHANNEL_MODE" to sVer
            Send AssertSAreEqual "18.1" sVer
        End_Procedure

        // A workspace's own global Set procedure is nobody's duplicate - even by a catalogue that still has the word.
        {Published = True}
        Procedure GRGF_OwnGlobalSetProcedure_NotGuarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Set"               to asNative[0]
            Move "Set Profile_Dword" to asNative[1]
            Move "Procedure Set MyOwnValue Global String sValue" to asCode[0]
            Move "End_Procedure"                                 to asCode[1]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 2 (SizeOfArray(asCode))
            Send AssertSAreEqual "Procedure Set MyOwnValue Global String sValue" asCode[0]
        End_Procedure

        // ...and one that does share its name with a native one is a real duplicate, guarded under that name.
        {Published = True}
        Procedure GRGF_GlobalSetProcedureOfANativeName_Guarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Set Profile_Dword" to asNative[0]
            Move "Procedure Set Profile_Dword Global String sKey DWord dwValue" to asCode[0]
            Move "End_Procedure"                                                to asCode[1]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 1 iCount
            Send Assert (Pos("'Set Profile_Dword' is now a NATIVE", asCode[0]) > 0) asCode[0]
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 181)") asCode[3]
            Send AssertSAreEqual "Procedure Set Profile_Dword Global String sKey DWord dwValue" asCode[4]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[6]
        End_Procedure

        // Our guard text around a procedure, with the marker naming sMarkerName, at asCode[iAt] onward.
        Procedure GRGF_AddOurSetGuard String[] ByRef asCode String sMarkerName String sDecl
            Integer iAt
            Move (SizeOfArray(asCode)) to iAt
            Move ("// [DFRefactor] '" + sMarkerName + "' is now a NATIVE DataFlex global (duplicate-global error 4390).") to asCode[iAt]
            Move "// Kept for DataFlex releases before 18.1, where the native did not yet exist; 18.1 and newer use the native one instead." to asCode[iAt + 1]
            Move "// VERIFY the built-in matches this implementation - it CAN differ (code page, error handling, edge cases)." to asCode[iAt + 2]
            Move (Character(35) + "IF (" + Character(33) + "@ < 181)") to asCode[iAt + 3]
            Move sDecl                      to asCode[iAt + 4]
            Move "    Move sValue to gsOwn" to asCode[iAt + 5]
            Move "End_Procedure"            to asCode[iAt + 6]
            Move (Character(35) + "ENDIF")  to asCode[iAt + 7]
        End_Procedure

        /* THE GUARD A RUN WROTE AROUND A "GLOBAL CALLED Set" COMES BACK OUT, the block itself untouched, and says so in
           the run notes; the file then counts as changed, and a second run has nothing left to do. */
        {Published = True}
        Procedure GRGF_WrongSetGuard_Removed
            String[] asCode asNative asNotes
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "// above" to asCode[0]
            Send GRGF_AddOurSetGuard (&asCode) "Set" "Procedure Set MyOwnValue Global String sValue"
            Move "// below" to asCode[9]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual "// above"                                      asCode[0]
            Send AssertSAreEqual "Procedure Set MyOwnValue Global String sValue" asCode[1]
            Send AssertSAreEqual "    Move sValue to gsOwn"                      asCode[2]
            Send AssertSAreEqual "End_Procedure"                                 asCode[3]
            Send AssertSAreEqual "// below"                                      asCode[4]
            Get pasRunNotes of ghoFuncLib to asNotes
            Send Assert (Pos("Set MyOwnValue: removed", asNotes[SizeOfArray(asNotes) - 1]) > 0) asNotes[SizeOfArray(asNotes) - 1]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // The marker spells the word as the source did: "Procedure SET x GLOBAL" got 'SET'.
        {Published = True}
        Procedure GRGF_WrongSetGuard_RemovedWhateverTheCase
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Send GRGF_AddOurSetGuard (&asCode) "SET" "Procedure SET MyOwnValue GLOBAL String sValue"
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Send AssertSAreEqual "Procedure SET MyOwnValue GLOBAL String sValue" asCode[0]
        End_Procedure

        // A Set procedure of a native name loses the wrong guard and gets the right one, in the same run.
        {Published = True}
        Procedure GRGF_WrongSetGuardOfANativeName_GetsTheRightOne
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Set Profile_Dword" to asNative[0]
            Send GRGF_AddOurSetGuard (&asCode) "Set" "Procedure Set Profile_Dword Global String sValue"
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 8 (SizeOfArray(asCode))
            Send Assert (Pos("'Set Profile_Dword' is now a NATIVE", asCode[0]) > 0) asCode[0]
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 181)") asCode[3]
            Send AssertSAreEqual "Procedure Set Profile_Dword Global String sValue" asCode[4]
        End_Procedure

        /* WHAT IS NOT EXACTLY OUR WRONG GUARD STAYS: the right guard of a native name, one somebody has edited (a comment
           line gone), and a #IF with no marker. Nothing here comes out and nothing is added. */
        {Published = True}
        Procedure GRGF_OtherGuardsOfSetProcedures_Kept
            String[] asCode asNative asBefore
            Integer iCount i
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Set Profile_Dword" to asNative[0]
            // the right one, already there
            Send GRGF_AddOurSetGuard (&asCode) "Set Profile_Dword" "Procedure Set Profile_Dword Global String sValue"
            // edited: only one comment line left between the marker and the #IF
            Move "// [DFRefactor] 'Set' is now a NATIVE DataFlex global (duplicate-global error 4390)." to asCode[8]
            Move "// keep this one, see ticket"                                                         to asCode[9]
            Move (Character(35) + "IF (" + Character(33) + "@ < 181)")                                  to asCode[10]
            Move "Procedure Set EditedByHand Global String sValue"                                      to asCode[11]
            Move "End_Procedure"                                                                        to asCode[12]
            Move (Character(35) + "ENDIF")                                                              to asCode[13]
            // hand-written
            Move (Character(35) + "IF (" + Character(33) + "@ < 200)")                                  to asCode[14]
            Move "Procedure Set HandGuarded Global String sValue"                                       to asCode[15]
            Move "End_Procedure"                                                                        to asCode[16]
            Move (Character(35) + "ENDIF")                                                              to asCode[17]
            Move asCode to asBefore
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 260 "26.0" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 18 (SizeOfArray(asCode))
            For i from 0 to 17
                Send AssertSAreEqual asBefore[i] asCode[i]
            Loop
        End_Procedure

        /* A NAME IN NO CATALOGUE FALLS BACK TO THE WORKSPACE BOUNDARY - the only path where the
           passed version still matters. The natives list is what the caller says is native (the
           analyzer's guardable gate normally keeps a catalogue-less name out of it), so a name
           in the list but in no catalogue gets the old "<= passed" directive. */
        {Published = True}
        Procedure GRGF_NoCatalogue_FallsBackToWorkspaceBoundary
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "SomeNameNoCatalogueHas" to asNative[0]
            Move "Function SomeNameNoCatalogueHas Global Returns Integer" to asCode[0]
            Move "    Function_Return 1" to asCode[1]
            Move "End_Function"          to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 250 "25.0" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ <= 250)") asCode[3]
        End_Procedure
        // The version in the guard follows the FIRST NATIVE release for the name, not the number
        // passed in - the passed number is only the fallback for a name in no catalogue.
        {Published = True}
        Procedure GRGF_VersionFromParameter
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function Utf8ToOem Global String sValue Returns String" to asCode[0]
            Move "    Function_Return sValue" to asCode[1]
            Move "End_Function"               to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 250 "25.0" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 201)") asCode[3]
        End_Procedure

        // Two native globals in one file -> both guarded.
        {Published = True}
        Procedure GRGF_MultipleInFile_Guarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function OemToUtf8 Global String sValue Returns String" to asCode[0]
            Move "    Function_Return sValue" to asCode[1]
            Move "End_Function"               to asCode[2]
            Move "Function Utf8ToOem Global String sValue Returns String" to asCode[3]
            Move "    Function_Return sValue" to asCode[4]
            Move "End_Function"               to asCode[5]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 2)
        End_Procedure

        // A buffer-family global is matched by the catalogue like any other name.
        {Published = True}
        Procedure GRGF_BufferFunction_Guarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function MultiToWideBuffer Global DWord dw Pointer p Integer i Pointer pp Returns Integer" to asCode[0]
            Move "    Function_Return 0" to asCode[1]
            Move "End_Function"          to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 1)
        End_Procedure

        // NEGATIVE: a same-named METHOD inside a class is not global -> untouched.
        {Published = True}
        Procedure GRGF_MethodInClass_NotGuarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Class cFoo is a cObject" to asCode[0]
            Move "    Function OemToUtf8 String sValue Returns String" to asCode[1]
            Move "        Function_Return sValue" to asCode[2]
            Move "    End_Function"       to asCode[3]
            Move "End_Class"              to asCode[4]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Function OemToUtf8 String sValue Returns String" asCode[1]
        End_Procedure

        // NEGATIVE: a top-level function WITHOUT the Global keyword is not a backport -> untouched.
        // (The old converter keyed on depth 0 alone; across a whole catalogue that would be over-broad.)
        {Published = True}
        Procedure GRGF_TopLevelNotGlobal_NotGuarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function OemToUtf8 String sValue Returns String" to asCode[0]
            Move "    Function_Return sValue" to asCode[1]
            Move "End_Function"               to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Function OemToUtf8 String sValue Returns String" asCode[0]
        End_Procedure

        // NEGATIVE: a global the target does NOT ship natively is left alone.
        {Published = True}
        Procedure GRGF_UnrelatedGlobal_NotGuarded
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function MyHelper Global String s Returns String" to asCode[0]
            Move "    Function_Return s" to asCode[1]
            Move "End_Function"          to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Function MyHelper Global String s Returns String" asCode[0]
        End_Procedure

        // IDEMPOTENT: an already-guarded block is not wrapped a second time.
        {Published = True}
        Procedure GRGF_AlreadyGuarded_Noop
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move (GRGF_ExpectedOpen(Self)) to asCode[0]
            Move "Function OemToUtf8 Global String sValue Returns String" to asCode[1]
            Move "    Function_Return sValue" to asCode[2]
            Move "End_Function"               to asCode[3]
            Move (Character(35) + "ENDIF")    to asCode[4]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 191 "19.1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Function OemToUtf8 Global String sValue Returns String" asCode[1]
        End_Procedure

        // REFUSE rather than guess: no usable version -> nothing is written.
        {Published = True}
        Procedure GRGF_NoVersion_Refuses
            String[] asCode asNative
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get GRGF_Natives to asNative
            Move "Function OemToUtf8 Global String sValue Returns String" to asCode[0]
            Move "    Function_Return sValue" to asCode[1]
            Move "End_Function"               to asCode[2]
            Get _GuardGlobalsInLines of ghoFuncLib (&asCode) asNative 0 "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Function OemToUtf8 Global String sValue Returns String" asCode[0]
        End_Procedure

        // Version-string parsing: the forms real workspaces and users actually supply.
        {Published = True}
        Procedure GRGF_VersionStringParsing
            Integer i

            Get DfVersionToMacroNumber of ghoFuncLib "19.1" to i
            Send Assert (i = 191)
            Get DfVersionToMacroNumber of ghoFuncLib "25.0" to i
            Send Assert (i = 250)
            Get DfVersionToMacroNumber of ghoFuncLib "26" to i
            Send Assert (i = 260)
            Get DfVersionToMacroNumber of ghoFuncLib "191" to i
            Send Assert (i = 191)
            Get DfVersionToMacroNumber of ghoFuncLib "19,1" to i
            Send Assert (i = 191)
            Get DfVersionToMacroNumber of ghoFuncLib "" to i
            Send Assert (i = 0)
        End_Procedure

        // ---- _GuardExternalsInLines: the External_Function flavor (2026-07-23, the WinInet pair) ----
        // Same directive, same idempotence; the block is the declaration line plus its ";" chain.

        // A single-line External_Function in the name set gets the 3 markers + #IF + verbatim + #ENDIF.
        {Published = True}
        Procedure GuardExternals_SingleLine_Guarded
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast
            Move "WinAPI_InternetQueryOption" to asNames[0]
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Handle hInternet DWord dwOption Pointer lpBuffer Pointer lpdwBufferLength Returns Boolean' to asCode[0]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 6)
            Send AssertSAreEqual "// [DFRefactor]" (Left(asCode[0], 15))
            Send AssertSAreEqual (GRGF_ExpectedOpen(Self)) asCode[3]
            Send AssertSAreEqual 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Handle hInternet DWord dwOption Pointer lpBuffer Pointer lpdwBufferLength Returns Boolean' asCode[4]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[5]
        End_Procedure

        // A ";"-continued declaration (DataFlex's own Pkg style) is guarded as ONE block.
        {Published = True}
        Procedure GuardExternals_ContinuationChain_OneBlock
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Move "WinAPI_InternetSetOption" to asNames[0]
            Move 'External_Function WinAPI_InternetSetOption "InternetSetOptionW" WinInet.dll ;' to asCode[0]
            Move '    Handle hInternet ;'     to asCode[1]
            Move '    DWord dwOption ;'       to asCode[2]
            Move '    Returns Integer'        to asCode[3]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 9)
            Send AssertSAreEqual (GRGF_ExpectedOpen(Self)) asCode[3]
            Send AssertSAreEqual 'External_Function WinAPI_InternetSetOption "InternetSetOptionW" WinInet.dll ;' asCode[4]
            Send AssertSAreEqual '    Returns Integer' asCode[7]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[8]
        End_Procedure

        // Two adjacent single-line declarations (the InternetOption.pkg 110/111 shape) each get their
        // OWN guard - the first block's #ENDIF must not read as "already guarded" for the second.
        {Published = True}
        Procedure GuardExternals_AdjacentPair_BothGuarded
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Move "WinAPI_InternetQueryOption" to asNames[0]
            Move "WinAPI_InternetSetOption"   to asNames[1]
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Returns Boolean' to asCode[0]
            Move 'External_Function WinAPI_InternetSetOption "InternetSetOptionA" WinInet.Dll Returns Boolean'     to asCode[1]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 2)
            Send Assert (SizeOfArray(asCode) = 12)
            Send AssertSAreEqual (GRGF_ExpectedOpen(Self)) asCode[3]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[5]
            Send AssertSAreEqual (GRGF_ExpectedOpen(Self)) asCode[9]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[11]
        End_Procedure

        // A name outside the set is untouched - whatever it declares.
        {Published = True}
        Procedure GuardExternals_NameNotInSet_Untouched
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast
            Move "WinAPI_InternetQueryOption" to asNames[0]
            Move 'External_Function GetTickCount "GetTickCount" Kernel32.Dll Returns DWord' to asCode[0]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 1)
        End_Procedure

        // IDEMPOTENT: a declaration already preceded by an #IF - ours from a previous run, or the
        // user's own hand-written guard - is never double-wrapped.
        {Published = True}
        Procedure GuardExternals_AlreadyGuarded_Untouched
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast
            Move "WinAPI_InternetQueryOption" to asNames[0]
            Move (GRGF_ExpectedOpen(Self)) to asCode[0]
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Returns Boolean' to asCode[1]
            Move (Character(35) + "ENDIF") to asCode[2]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 3)
        End_Procedure

        /* ---- The Win32 API catalogue (WinAPICatalog.inc, 2026-08-09) ----
           The head of what DataFlex does NOT declare itself. These assert the SHAPE and the
           plumbing, not the SDK's content: a prototype is data copied verbatim from a header, and a
           test that restated it would just be the same typing twice. What is worth pinning is that
           the lookup matches on dll AND entry, tolerates the A/W suffix legacy code drops, and that
           what comes back survives the app's own declaration audit. */

        // The catalogue is loaded at keyword-init and covers the measured head plus the wide twins.
        {Published = True}
        Procedure WinAPICatalog_IsLoaded
            String[] asCat
            Get pasWinAPICatalog of ghoFuncLib to asCat
            Send Assert (SizeOfArray(asCat) >= 56)
        End_Procedure

        /* The wide twin is a DIFFERENT declaration, not a copy - which is the whole argument for
           carrying both. LPCSTR maps to String and LPCWSTR to WString, so CreateFileA and
           CreateFileW disagree on their first parameter even though the C prototypes are otherwise
           the same shape. A catalogue that stored only one would judge half the workspace against
           the wrong signature. */
        {Published = True}
        Procedure WinAPICatalog_WideTwinDiffersFromAnsi
            String sA sW
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "CreateFileA" to sA
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "CreateFileW" to sW
            Send Assert (sA <> "")
            Send Assert (sW <> "")
            Send Assert (Pos("String lpFileName",  sA) > 0)
            Send Assert (Pos("WString lpFileName", sW) > 0)
            Send Assert (sA <> sW)
        End_Procedure

        // A declaration already migrated to the wide entry point is COVERED - it used to fall
        // through to the name heuristics, i.e. the code that had been modernised got the worst
        // analysis.
        {Published = True}
        Procedure WinAPICatalog_WideDeclarationIsCovered
            String[] asFindings
            Integer iN
            Get _WinAPICatalogueFindings of ghoFuncLib 'External_Function CreateFile "CreateFileW" Kernel32.dll Integer lpFileName DWord dwDesiredAccess DWord dwShareMode Pointer lpSecurityAttributes DWord dwCreationDisposition DWord dwFlagsAndAttributes Handle hTemplateFile Returns Handle' (&asFindings) to iN
            Send Assert (iN >= 1)
            Send Assert (Pos("parameter 1", asFindings[0]) > 0)
            Send Assert (Pos("WString", asFindings[0]) > 0)
        End_Procedure

        // Exact dll + entry, and the A-suffix form legacy declarations commonly write without it.
        {Published = True}
        Procedure WinAPICatalog_LookupMatchesDllAndEntry
            String sProto
            // Since the 2026-08-28 harvest these are DF-flavoured rows: ready-made DataFlex with
            // normalised types, so the assertions pin the DataFlex text, not the old C prototype.
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "CloseHandle" to sProto
            Send Assert (Pos("CloseHandle", sProto) > 0)
            Send Assert (Pos("Handle hObject", sProto) > 0)
            Get WinAPIPrototype of ghoFuncLib "shell32.dll" "ShellExecuteEx" to sProto
            Send Assert (Pos("ShellExecuteExA", sProto) > 0)
        End_Procedure

        // The dll is part of the identity: the same entry point elsewhere is a different function.
        {Published = True}
        Procedure WinAPICatalog_WrongDllIsNotAMatch
            String sProto
            Get WinAPIPrototype of ghoFuncLib "user32.dll" "CloseHandle" to sProto
            Send AssertSAreEqual "" sProto
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "NoSuchApiAnywhere" to sProto
            Send AssertSAreEqual "" sProto
        End_Procedure

        /* The catalogue converts through the app's OWN converter, so a HANDLE parameter arrives as
           Handle and not as the Integer that legacy code so often declares - the x64 lie this whole
           catalogue exists to expose. */
        {Published = True}
        Procedure WinAPICatalog_ConvertsToDataFlexTypes
            String sDecl
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "CloseHandle" to sDecl
            Send Assert (Pos("External_Function", sDecl) > 0)
            Send Assert (Pos("Handle", sDecl) > 0)
            Send Assert (Pos("Integer hObject", sDecl) = 0)
        End_Procedure

        // ...and what it produces passes the app's own API-declaration audit - the same guard the
        // C-declaration converter is held to, so the two can never disagree about a type.
        {Published = True}
        Procedure WinAPICatalog_OutputSurvivesTheAudit
            String[] asFindings
            String sDecl
            Integer iFound
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "ReadFile" to sDecl
            Send Assert (sDecl <> "")
            Get _AuditApiDeclaration of ghoFuncLib sDecl (&asFindings) to iFound
            Send Assert (iFound = 0)
        End_Procedure

        /* The regression for the defect the catalogue's audit test exposed (2026-08-09): a parameter
           carrying a SECOND annotation with no trailing underscore - ReadFile's
           "__out_data_source(FILE) LPVOID lpBuffer" - left the annotation in the token stream and
           LPVOID came out Integer, while its lp* siblings came out Pointer. On x64 that is a
           4-vs-8-byte lie in a buffer parameter. */
        {Published = True}
        Procedure WinAPICatalog_DoubleAnnotatedPointerStaysAPointer
            String sDecl
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "ReadFile" to sDecl
            Send Assert (Pos("Pointer lpBuffer", sDecl) > 0)
            Send Assert (Pos("Integer lpBuffer", sDecl) = 0)
            // ...and the annotation itself never reaches the output as a parameter.
            Send Assert (Pos("out_data_source", sDecl) = 0)
        End_Procedure

        /* ---- The Win32 STRUCT catalogue (WinAPIStructCatalog.inc, 2026-08-09) ----
           Layouts, which a function signature cannot give: the API catalogue knows CreateProcessA
           takes an LPSTARTUPINFOA, only this knows what is inside one. Data layer only for now -
           the emitter waits on the alignment rule (see the IS$WIN64 note below). */

        {Published = True}
        Procedure WinAPIStructs_CatalogLoaded
            String[] asCat
            Get pasWinAPIStructCatalog of ghoFuncLib to asCat
            Send Assert (SizeOfArray(asCat) >= 34)
        End_Procedure

        /* ONE DECLARATION SERVES BOTH PLATFORMS - except for four (Nils, 2026-08-26).

           DataFlex sizes Pointer/Handle/LongPtr per build, so a correctly typed declaration is
           already right on x86 and x64 from one line. The four here are the exception the install
           itself guards: the exported ENTRY POINT changes, so no single line can say it. "" is
           therefore the common and correct answer, meaning "one declaration will do". */
        {Published = True}
        Procedure WinAPISplit_EntryPointFamilyNeedsBothArms
            String sRow
            Get WinAPIBitnessSplit of ghoFuncLib "GetWindowLongPtr" to sRow
            Send Assert (Pos("getwindowlongptr|", sRow) = 1)
            Send Assert (Pos("GetWindowLongPtrW", sRow) > 0)
            Send Assert (Pos("GetWindowLongW", sRow) > 0)
            Get WinAPIBitnessSplit of ghoFuncLib "SetClassLongPtr" to sRow
            Send Assert (Pos("SetClassLongPtrW", sRow) > 0)
            Send Assert (Pos("SetClassLongW", sRow) > 0)
        End_Procedure

        // Everything else answers "" - one declaration will do. This is the common case, and
        // reading "" as "not catalogued" rather than "no split needed" would be the misreading.
        {Published = True}
        Procedure WinAPISplit_OrdinaryApiNeedsOneDeclaration
            String sRow
            Get WinAPIBitnessSplit of ghoFuncLib "SHBrowseForFolder" to sRow
            Send AssertSAreEqual "" sRow
            Get WinAPIBitnessSplit of ghoFuncLib "CloseHandle" to sRow
            Send AssertSAreEqual "" sRow
        End_Procedure

        // All four seeded, and the x86 arm never carries the ...Ptr entry point - handing an x86
        // build GetWindowLongPtrW would be a link failure, which is the mistake this table exists
        // to prevent.
        {Published = True}
        Procedure WinAPISplit_X86ArmNeverUsesThePtrEntryPoint
            String[] asSplit asField
            String sRow sEntry64 sEntry32
            Integer i iLast
            Get pasWinAPIBitnessSplit of ghoFuncLib to asSplit
            Send AssertIAreEqual 4 (SizeOfArray(asSplit))
            Move (SizeOfArray(asSplit) - 1) to iLast
            For i from 0 to iLast
                Move asSplit[i] to sRow
                // dfname|dll|entry64|params64|entry32|params32 - field 5 is the x86 entry point.
                Move (StrSplitToArray(sRow, "|")) to asField
                Send AssertIAreEqual 6 (SizeOfArray(asField))
                Move asField[2] to sEntry64
                Move asField[4] to sEntry32
                // The x64 arm IS the ...Ptr export; the x86 arm must NOT be, or the link fails.
                Send Assert (Right(sEntry64, 4) = "PtrW")
                Send Assert (Right(sEntry32, 4) <> "PtrW")
            Loop
        End_Procedure

        /* THE CALL SITE IDENTIFIES THE STRUCT, which the name cannot (Nils, 2026-08-26). The same
           BROWSEINFO shape is written vtBrowseInfo 72 times and tAKEBrowseInfo twice, and no
           prefix rule reaches the second - but the prototype of the API it is passed to names it
           outright, so a Type handed to SHBrowseForFolder IS a BROWSEINFOW. Evidence, not a guess,
           and read from the two catalogues already in the app. */
        {Published = True}
        Procedure WinAPIStructs_ApiPrototypeNamesItsStruct
            String sName
            Get WinAPIStructForApi of ghoFuncLib "shell32.dll" "SHBrowseForFolderW" to sName
            Send AssertSAreEqual "BROWSEINFOW" sName
            Get WinAPIStructForApi of ghoFuncLib "shell32.dll" "SHFileOperationW" to sName
            Send AssertSAreEqual "SHFILEOPSTRUCTW" sName
        End_Procedure

        // The ANSI arm resolves to the ANSI struct - the two must not cross, or a 32-bit-era
        // declaration would be handed the wide layout.
        {Published = True}
        Procedure WinAPIStructs_AnsiApiGetsTheAnsiStruct
            String sName
            Get WinAPIStructForApi of ghoFuncLib "shell32.dll" "SHBrowseForFolderA" to sName
            Send AssertSAreEqual "BROWSEINFOA" sName
        End_Procedure

        // Most APIs take no struct at all, and saying so is the answer - not the first catalogued
        // name that happens to appear in the prototype text.
        {Published = True}
        Procedure WinAPIStructs_ApiWithNoStructAnswersEmpty
            String sName
            Get WinAPIStructForApi of ghoFuncLib "kernel32.dll" "CloseHandle" to sName
            Send AssertSAreEqual "" sName
            Get WinAPIStructForApi of ghoFuncLib "nosuch.dll" "NoSuchEntry" to sName
            Send AssertSAreEqual "" sName
        End_Procedure

        /* A HOUSE PREFIX MUST NOT HIDE A CATALOGUED SHAPE. Almost nobody writes the SDK name: a
           scan of C:\Projects found vtBrowseInfo 72 times, vtShFileOpStruct 71 and tMSG 27, every
           one of them a struct this catalogue already carries and none of them reachable, because
           the lookup only tried the name as written (2026-08-26).

           Being generous here is safe because the lookup is not the decision: the converter gates
           on member names in order afterwards and refuses anything that disagrees, so a wrong
           guess is rejected downstream rather than applied. */
        {Published = True}
        Procedure WinAPIStructs_LookupStripsAHousePrefix
            String sBody
            Get WinAPIStructBody of ghoFuncLib "vtBrowseInfo" to sBody
            Send Assert (Pos("hwndOwner", sBody) > 0)
            Get WinAPIStructBody of ghoFuncLib "vtShFileOpStruct" to sBody
            Send Assert (Pos("wFunc", sBody) > 0)
            Get WinAPIStructBody of ghoFuncLib "tMSG" to sBody
            Send Assert (Pos("wParam", sBody) > 0)
        End_Procedure

        // POSITIVE CONTROL for the above: the plain SDK name still resolves, so a pass there is
        // the prefix rule working rather than the lookup having become indiscriminate.
        {Published = True}
        Procedure WinAPIStructs_PlainNameStillResolves
            String sBody
            Get WinAPIStructBody of ghoFuncLib "SHFILEOPSTRUCTW" to sBody
            Send Assert (Pos("wFunc", sBody) > 0)
        End_Procedure

        // And stripping a prefix must not invent a match: a name the catalogue does not carry
        // still answers "", prefix or no prefix.
        {Published = True}
        Procedure WinAPIStructs_PrefixDoesNotInventAMatch
            String sBody
            Get WinAPIStructBody of ghoFuncLib "vtNoSuchStructHere" to sBody
            Send AssertSAreEqual "" sBody
            Get WinAPIStructBody of ghoFuncLib "vt" to sBody
            Send AssertSAreEqual "" sBody
        End_Procedure

        // Legacy code writes BROWSEINFO where the SDK typedef is BROWSEINFOA, so the lookup
        // tolerates the missing suffix - the same rule the API catalogue uses.
        {Published = True}
        Procedure WinAPIStructs_LookupToleratesMissingAnsiSuffix
            String sBody
            Get WinAPIStructBody of ghoFuncLib "BROWSEINFO" to sBody
            Send Assert (Pos("hwndOwner", sBody) > 0)
            Send Assert (Pos("iImage", sBody) > 0)
            Send Assert (Pos("lpszTitle", sBody) > 0)
            // Harvested rows CARRY inline C-type comments ("Handle hwndOwner  // HWND") - they
            // document the member and drive the Handle normalisation, so their presence is now
            // part of the contract where the old C rows promised their absence.
            Send Assert (Pos("DF|", sBody) = 1)
        End_Procedure

        /* THE NAME BEHIND A HOUSE-PREFIXED TYPE, for a refusal to quote. "The Type lists 11 members and
           the Windows struct it is named after, BROWSEINFOA, has 12" tells the reader which struct the
           Type was taken for, where "the SDK struct" told them nothing (Nils 2026-10-06). It is the
           same lookup as the body, so the two cannot name different rows. */
        {Published = True}
        Procedure WinAPIStructs_CatalogNameBehindAHousePrefix
            String[] asNotes
            String sName sDecl sSdk
            Send RefreshWinAPICatalogsFromJson of ghoFuncLib
            Get WinAPIStructCatalogName of ghoFuncLib "vtBrowseInfo" to sName
            Send Assert (Left(sName, 10) = "BROWSEINFO") sName
            Get WinAPIStructCatalogName of ghoFuncLib "vtNoSuchStructHere" to sName
            Send AssertSAreEqual "" sName
            // ...and the legacy-name lookup hands it back beside the declaration it re-heads
            Get WinAPIStructForLegacyName of ghoFuncLib "vtBrowseInfo" (&asNotes) (&sSdk) to sDecl
            Send Assert (Left(sDecl, 19) = "Struct vtBrowseInfo") sDecl
            Send Assert (Left(sSdk, 10) = "BROWSEINFO") sSdk
            Get WinAPIStructForLegacyName of ghoFuncLib "vtNoSuchStructHere" (&asNotes) (&sSdk) to sDecl
            Send AssertSAreEqual "" sDecl
            Send AssertSAreEqual "" sSdk
        End_Procedure

        /* WSADATA is the reason #if branches are resolved by TARGET rather than dropped: its
           _WIN64 and #else branches hold the SAME members in a DIFFERENT ORDER, so the wrong
           choice transposes the struct instead of shortening it. x64 order is iMaxSockets first. */
        {Published = True}
        Procedure WinAPIStructs_ConditionalBranchResolvedForX64
            String sBody
            Integer iSock iDesc
            Get WinAPIStructBody of ghoFuncLib "WSADATA" to sBody
            Send Assert (Pos("iMaxSockets", sBody) > 0)
            Send Assert (Pos("szDescription", sBody) > 0)
            Move (Pos("iMaxSockets", sBody))   to iSock
            Move (Pos("szDescription", sBody)) to iDesc
            Send Assert (iSock < iDesc)
        End_Procedure

        // A wide twin is carried separately - CHAR arrays become Char[N] and WCHAR arrays Short[N],
        // so the two are different DataFlex structs, exactly as DataFlex's own pair demonstrates.
        {Published = True}
        Procedure WinAPIStructs_WideTwinIsCarriedSeparately
            String sA sW
            Get WinAPIStructBody of ghoFuncLib "BROWSEINFOA" to sA
            Get WinAPIStructBody of ghoFuncLib "BROWSEINFOW" to sW
            Send Assert (sA <> "")
            Send Assert (sW <> "")
            Send Assert (sA <> sW)
            // The twins differ where the METADATA says they differ: the string members' C types.
            // (The DataFlex side is Pointer in both - the difference the emitted code needs to
            // show survives in the comments, which is one of the reasons they are kept.)
            Send Assert (Pos("// PSTR", sA) > 0)
            Send Assert (Pos("// PWSTR", sW) > 0)
        End_Procedure

        /* ---- ConvertWinAPITypeToStruct (2026-08-09) ----
           The declaration changes; the code around it must not have to. That is why the gate is the
           member NAMES: matching names mean every X.member reference and AddressOf() call still
           compiles, and only the TYPES are corrected - which is the point, since a legacy Word
           where the SDK says a pointer is the x64 bug. */

        // SECURITY_ATTRIBUTES: three flat members whose names the legacy block copied from the SDK.
        // Converts, keeps the LEGACY type name (so "vtSecurity_Attributes SA" still declares), and
        // corrects the types.
        {Published = True}
        Procedure WinAPITypeToStruct_ConvertsWhenNamesMatch
            String[] asCode asNotes
            Integer iCount

            Move 'Type vtSecurity_Attributes'                          to asCode[0]
            Move '  Field vtSecurity_Attributes.nLength As Integer'    to asCode[1]
            Move '  Field vtSecurity_Attributes.lpSecurityDescriptor As Integer' to asCode[2]
            Move '  Field vtSecurity_Attributes.bInheritHandle As Integer'       to asCode[3]
            Move 'End_Type'                                            to asCode[4]
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send Assert (iCount = 1)
            // The legacy NAME survives - renaming it would break every variable declaration.
            Send Assert (Pos("Struct vtSecurity_Attributes", asCode[2]) > 0)
            Send Assert (Pos("End_Struct", asCode[SizeOfArray(asCode) - 1]) > 0)
            // No Type/Field/End_Type left behind.
            Send Assert (Pos("End_Type", asCode[SizeOfArray(asCode) - 1]) = 0)
        End_Procedure

        /* THE REFUSAL THAT MATTERS. A legacy block that FLATTENED what the SDK nests has more
           members than the SDK struct, and converting would move every reference. It is left
           untouched, verbatim, and the reason is reported. */
        {Published = True}
        Procedure WinAPITypeToStruct_FlattenedBlockRefused
            String[] asCode asNotes
            Integer iCount

            Move 'Type vtSecurity_Attributes'                       to asCode[0]
            Move '  Field vtSecurity_Attributes.nLength As Integer' to asCode[1]
            Move '  Field vtSecurity_Attributes.lpLow As Integer'   to asCode[2]
            Move '  Field vtSecurity_Attributes.lpHigh As Integer'  to asCode[3]
            Move '  Field vtSecurity_Attributes.bInheritHandle As Integer' to asCode[4]
            Move 'End_Type'                                         to asCode[5]
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 6)
            Send AssertSAreEqual 'Type vtSecurity_Attributes' asCode[0]
            // ...and it SAYS why rather than silently converting nothing.
            Send Assert (SizeOfArray(asNotes) > 0)
            Send Assert (Pos("members declared", asNotes[0]) > 0)
        End_Procedure

        // A member the SDK calls something else is refused too, with the name that disagreed -
        // count matching is not sufficient.
        {Published = True}
        Procedure WinAPITypeToStruct_RenamedMemberRefused
            String[] asCode asNotes
            Integer iCount
            Move 'Type vtSecurity_Attributes'                         to asCode[0]
            Move '  Field vtSecurity_Attributes.nLength As Integer'   to asCode[1]
            Move '  Field vtSecurity_Attributes.lpSecurity As Integer' to asCode[2]
            Move '  Field vtSecurity_Attributes.bInheritHandle As Integer' to asCode[3]
            Move 'End_Type'                                           to asCode[4]
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asNotes) > 0)
            Send Assert (Pos("lpSecurity", asNotes[0]) > 0)
        End_Procedure

        // A Type the catalogue does not know is left alone entirely, and is not worth a note -
        // most Types in a workspace are the application's own.
        {Published = True}
        Procedure WinAPITypeToStruct_UnknownTypeUntouched
            String[] asCode asNotes
            Integer iCount
            Move 'Type tMyOwnAppRecord'          to asCode[0]
            Move '  Field tMyOwnAppRecord.iId As Integer' to asCode[1]
            Move 'End_Type'                      to asCode[2]
            Get _ConvertWinAPITypesInLines of ghoFuncLib (&asCode) (&asNotes) to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 3)
            Send AssertSAreEqual 'Type tMyOwnAppRecord' asCode[0]
        End_Procedure

        /* ---- Dead dependencies: families with no successor (2026-08-09) ----
           Not "obsolete", which DFRefactor converts, and not "absorbed", which it swaps. There is
           nothing to convert or swap - the file goes away - so nothing inside it is worth
           refactoring, and scanning it buries the findings that matter. */

        // The two families, under any of the names they wear in the wild.
        {Published = True}
        Procedure DeadDeps_KnownFamiliesAreRecognised
            String sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\CrystalReport.pkg" to sWhy
            Send Assert (Pos("Crystal", sWhy) > 0)
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\cCrystalDbAutoConnect.pkg" to sWhy
            Send Assert (sWhy <> "")
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\crystalrep2.pkg" to sWhy
            Send Assert (sWhy <> "")
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\WinQL32.pkg" to sWhy
            Send Assert (Pos("WinQL32", sWhy) > 0)
        End_Procedure

        // The REASON comes back, not a bare Boolean - whatever reports the skip has to be able to
        // say why without a second lookup.
        {Published = True}
        Procedure DeadDeps_ReasonTravelsWithTheMatch
            String sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\cCrystal.pkg" to sWhy
            Send Assert (Length(sWhy) > 20)
            Send Assert (Pos("no later version", sWhy) > 0)
        End_Procedure

        // Ordinary source keeps its findings. A skip is the stricter act, so it stays narrow.
        {Published = True}
        Procedure DeadDeps_OrdinarySourceUntouched
            String sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\cDbCJGrid.pkg" to sWhy
            Send AssertSAreEqual "" sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\AppSrc\OrderEntry.src" to sWhy
            Send AssertSAreEqual "" sWhy
        End_Procedure

        // SOURCE extensions only: the report files themselves are not source, and a .dat that
        // happens to contain the word is not what decides.
        {Published = True}
        Procedure DeadDeps_NonSourceExtensionsIgnored
            String sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\Reports\CrystalInvoice.rpt" to sWhy
            Send AssertSAreEqual "" sWhy
            Get _DeadDependencyFor of ghoFuncLib "C:\App\Data\crystal.dat" to sWhy
            Send AssertSAreEqual "" sWhy
        End_Procedure

        /* ---- ANSI + wide side by side under one version guard (2026-08-09) ---- */

        // The shape: same DataFlex NAME on both arms, ANSI verbatim, wide from the catalogue.
        // The wide arm is emitted in Pkg style - head + one parameter per continuation, with the
        // LOCAL parameter names - so the pair reads like the user's own code (Nils, 2026-08-28).
        {Published = True}
        Procedure AnsiWide_BothArmsSameDataFlexName
            String[] asCode
            Integer iCount

            /* GetTempPath was this fixture until 2026-11-21. Its buffer is raw memory, PSTR on the ANSI arm
               and PWSTR on the wide one, so DS 9221 no longer pairs it (AnsiWide_RawTextBufferPerArmIsRefused).
               GetCompressedFileSize is a pair that IS safe: the file name is marshalled text and the other
               argument is a UInteger* on both arms. */
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" Kernel32.dll String lpFileName Pointer lpFileSizeHigh Returns DWord' to asCode[0]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send Assert (iCount = 1)
            Send Assert (Pos((Character(35) + "IF"),    asCode[3]) > 0)
            Send Assert (Pos((Character(35) + "ELSE"),  asCode[5]) > 0)
            // ANSI arm untouched, wide arm carries the SAME DataFlex name and the W entry.
            Send AssertSAreEqual 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" Kernel32.dll String lpFileName Pointer lpFileSizeHigh Returns DWord' asCode[4]
            Send Assert (Pos("MyGetCompressedFileSize", asCode[6]) > 0)
            Send Assert (Pos("GetCompressedFileSizeW",  asCode[6]) > 0)
            Send Assert (Pos("Kernel32.dll",  asCode[6]) > 0)
            // ...and NOT the converter's non-compiling placeholder DLL.
            Send Assert (Pos("SET-THE-DLL", asCode[6]) = 0)
            // Multi-line wide arm: local names on the continuations, then Returns, then #ENDIF.
            Send Assert (Pos(" ;", asCode[6]) > 0)
            Send Assert (Pos("lpFileName"   , asCode[7]) > 0)
            Send Assert (Pos("lpFileSizeHigh",asCode[8]) > 0)
            Send Assert (Pos("Returns",       asCode[9]) > 0)
            Send Assert (Pos((Character(35) + "ENDIF"), asCode[10]) > 0)
        End_Procedure

        /* THE WIDE ARM KEEPS THE BLOCK'S OWN PARAMETER NAMES. WinServ's efShellExecute declares
           "DWord iShowCmd" where the SDK projection spells it "Integer nShowCmd" - the first live
           pair emitted the SDK spelling on a flat line, and Nils flagged both (2026-08-28). The
           TYPES must be the twin's (WString where the ANSI arm says String); the NAMES must be
           the user's. */
        {Published = True}
        Procedure AnsiWide_WideArmKeepsLocalNamesFromABlock
            String[] asCode
            String sElseArm
            Integer iCount i iElse
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[0]
            Move '    Handle hWnd ;'          to asCode[1]
            Move '    String lpOperation ;'   to asCode[2]
            Move '    String lpFile ;'        to asCode[3]
            Move '    String lpParameters ;'  to asCode[4]
            Move '    String lpDirectory ;'   to asCode[5]
            Move '    DWord  iShowCmd ;'      to asCode[6]
            Move '    Returns Handle'         to asCode[7]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iCount
            Send Assert (iCount = 1)
            // Everything from #ELSE on is the wide arm (plus the closing #ENDIF).
            Move 0 to iElse
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = (Character(35) + "ELSE")) ;
                    Move i to iElse
            Loop
            Send Assert (iElse > 0)
            Move "" to sElseArm
            For i from iElse to (SizeOfArray(asCode) - 1)
                Move (sElseArm + asCode[i] + (Character(10))) to sElseArm
            Loop
            Send Assert (Pos("ShellExecuteW", sElseArm) > 0)
            // The twin's types...
            Send Assert (Pos("WString lpOperation", sElseArm) > 0)
            // ...with the block's own names: iShowCmd survives, the SDK's nShowCmd never appears.
            Send Assert (Pos("iShowCmd", sElseArm) > 0)
            Send Assert (Pos("nShowCmd", sElseArm) = 0)
            // ...and the block's own TYPE where the class agrees: DWord stays DWord beside the
            // SDK's Integer - the arm differs only where wideness or pointer width demands it.
            Send Assert (Pos("DWord iShowCmd", sElseArm) > 0)
        End_Procedure

        /* THE COMPOSITION FIX (probe-verified gap, 2026-08-28): a declaration qualifying for
           BOTH WinAPI converters must reach the full version x bitness matrix WHICHEVER ran
           first. Convert-first used to nest the version gate inside the IS$WIN64 #ELSE arm and
           the x64+DF26 build silently kept calling the ANSI entry. Now the wide guard consumes
           the retyper's pair WHOLE: version gate outside, pair in its #IF arm, twin in #ELSE. */
        {Published = True}
        Procedure AnsiWide_ComposedPairGetsTheFullMatrix
            String[] asCode asNotes
            Integer iC1 iC2 i iOpen iIfdef iElse2 iWide iEndifs
            Move 'External_Function efShell "ShellExecuteA" shell32.dll Handle hw String a String b String c String d Integer n Returns Integer' to asCode[0]
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iC1
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iC2
            Send AssertIAreEqual 1 iC1
            Send AssertIAreEqual 1 iC2
            Move 0 to iEndifs
            Move -1 to iOpen
            Move -1 to iIfdef
            Move -1 to iWide
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = (Character(35) + "IF (" + Character(33) + "@ < 260)")) ;
                    Move i to iOpen
                If (Trim(asCode[i]) = (Character(35) + "IFDEF IS$WIN64")) ;
                    Move i to iIfdef
                If (asCode[i] contains "ShellExecuteW") ;
                    Move i to iWide
                If (Trim(asCode[i]) = (Character(35) + "ENDIF")) ;
                    Increment iEndifs
            Loop
            // version gate OUTSIDE, the IS$WIN64 pair inside its #IF arm, the twin after it,
            // and exactly two #ENDIFs - one per gate, no nesting inside the #ELSE arm.
            Send Assert (iOpen >= 0)
            Send Assert (iIfdef > iOpen)
            Send Assert (iWide > iIfdef)
            Send AssertIAreEqual 2 iEndifs
            // idempotent: a second pass changes nothing.
            Move (SizeOfArray(asCode)) to i
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iC2
            Send AssertIAreEqual 0 iC2
            Send AssertIAreEqual i (SizeOfArray(asCode))
        End_Procedure

        // The same matrix from the OTHER direction: the wide guard first, the retyper second.
        // (Plan runs are per-grid-row scoped passes - neither order can be relied on.)
        {Published = True}
        Procedure AnsiWide_ComposedPairMatrixInReverseOrder
            String[] asCode asNotes
            Integer iC1 iC2 i iOpen iIfdef iWide iEndifs
            Move 'External_Function efShell "ShellExecuteA" shell32.dll Handle hw String a String b String c String d Integer n Returns Integer' to asCode[0]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iC2
            Get _ConvertApiDeclTypesInLines of ghoFuncLib (&asCode) (&asNotes) to iC1
            Send AssertIAreEqual 1 iC2
            Send AssertIAreEqual 1 iC1
            Move 0 to iEndifs
            Move -1 to iOpen
            Move -1 to iIfdef
            Move -1 to iWide
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = (Character(35) + "IF (" + Character(33) + "@ < 260)")) ;
                    Move i to iOpen
                If (Trim(asCode[i]) = (Character(35) + "IFDEF IS$WIN64")) ;
                    Move i to iIfdef
                If (asCode[i] contains "ShellExecuteW") ;
                    Move i to iWide
                If (Trim(asCode[i]) = (Character(35) + "ENDIF")) ;
                    Increment iEndifs
            Loop
            Send Assert (iOpen >= 0)
            Send Assert (iIfdef > iOpen)
            Send Assert (iWide > iIfdef)
            Send AssertIAreEqual 2 iEndifs
        End_Procedure

        // A user's own IS$WIN64 region that is NOT the retyper's pair shape (different names,
        // extra code) is hands-off entirely - the old walk wrapped its #ELSE-arm declaration
        // where it stood.
        {Published = True}
        Procedure AnsiWide_ForeignWin64RegionIsHandsOff
            String[] asCode
            Integer iCount iBefore
            Move (Character(35) + "IFDEF IS$WIN64")                     to asCode[0]
            Move 'External_Function A64 "GetTempPathW" Kernel32.dll DWord n Pointer p Returns DWord' to asCode[1]
            Move (Character(35) + "ELSE")                               to asCode[2]
            Move 'External_Function A32 "GetTempPathA" Kernel32.dll DWord n Pointer p Returns DWord' to asCode[3]
            Move 'Move 1 to giSomething'                                to asCode[4]
            Move (Character(35) + "ENDIF")                              to asCode[5]
            Move (SizeOfArray(asCode)) to iBefore
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual iBefore (SizeOfArray(asCode))
        End_Procedure

        /* A POINTER-TYPED ANSI BINDING IS NEVER PAIRED (the vWin32fhA.h shape, Nils
           2026-08-28): its AddressOf call sites would feed raw addresses to the wide arm's
           WString marshalling - an address rendered as text, silently, at run time. Refused
           whole, and the run note says so. */
        {Published = True}
        Procedure AnsiWide_PointerBindingIsRefusedNotPaired
            String[] asCode
            String sNotes
            Integer iCount
            Move 'External_Function vWin32_ShellExecute "ShellExecuteA" shell32.dll Handle hWnd Pointer lpOperation Pointer lpFile Pointer lpParameters Pointer lpDirectory DWord iShowCmd Returns Handle' to asCode[0]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 1)
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "  " to sNotes
            Send Assert (sNotes contains "manual-conversion")
        End_Procedure

        /* THE FALLBACK IS NEVER A ONE-LINER. An inline comment inside the block defeats the
           local-name alignment, and the old fallback then emitted the whole twin on one flat
           line - wide enough to upset the compiler on a long signature (Nils 2026-08-28). Now
           the twin reflows against itself: SDK names, one parameter per continuation, and the
           LOCAL DataFlex name still on the head (the rebind happened before the reflow). */
        {Published = True}
        Procedure AnsiWide_FallbackReflowsInsteadOfOneFlatLine
            String[] asCode
            String sElseArm
            Integer iCount i iElse
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[0]
            Move '    Handle hWnd ;  // main window'  to asCode[1]
            Move '    String lpOperation ;'   to asCode[2]
            Move '    String lpFile ;'        to asCode[3]
            Move '    String lpParameters ;'  to asCode[4]
            Move '    String lpDirectory ;'   to asCode[5]
            Move '    DWord  iShowCmd ;'      to asCode[6]
            Move '    Returns Handle'         to asCode[7]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 260 "26.0" 0 "" "" to iCount
            Send Assert (iCount = 1)
            Move 0 to iElse
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = (Character(35) + "ELSE")) ;
                    Move i to iElse
            Loop
            Send Assert (iElse > 0)
            Move "" to sElseArm
            For i from iElse to (SizeOfArray(asCode) - 1)
                Move (sElseArm + asCode[i] + (Character(10))) to sElseArm
            Loop
            // Multi-line: the head ends in a continuation, and the local NAME survived the rebind.
            Send Assert (Pos('efShellExecute "ShellExecuteW" shell32.dll ;', sElseArm) > 0)
            Send Assert (Pos("WString lpOperation ;", sElseArm) > 0)
            // No line of the arm carries the whole declaration at once.
            For i from iElse to (SizeOfArray(asCode) - 1)
                Send Assert (not((asCode[i] contains "ShellExecuteW") and (asCode[i] contains "Returns")))
            Loop
        End_Procedure

        // No twin in the catalogue = left alone. Guessing one is what this must never do.
        {Published = True}
        Procedure AnsiWide_NoTwinLeavesItAlone
            String[] asCode
            Integer iCount
            Move 'External_Function Exotic "SomethingExoticA" Kernel32.dll Returns Integer' to asCode[0]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 1)
        End_Procedure

        /* SetClipboardData ends in a literal "a". A rule that stripped the last letter to find a
           twin would invent SetClipboardDatW; this looks the twin UP and finds nothing, so the
           declaration is untouched. */
        {Published = True}
        Procedure AnsiWide_TrailingLetterIsNotAnAnsiSuffix
            String[] asCode
            Integer iCount
            Move 'External_Function SetClipboardData "SetClipboardData" User32.dll DWord uFormat Handle hMem Returns Handle' to asCode[0]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 1)
        End_Procedure

        /* THE DECLARE-ONCE GUARD IS NOT A VERSION GUARD (Nils 2026-08-31, DUF's
           cDbUpdateUserCount.h.pkg). The idempotence rule was inherited verbatim from
           _GuardExternalsInLines as "any preceding #IF means hands off", which also swallows
           #IFNDEF <symbol> - the standard DataFlex declare-once idiom that wraps virtually every
           hand-written WinAPI header. The variant stack already decided that shape is convertible,
           so the two rules disagreed and the stricter one won silently: DS 9221 pointed at the
           declaration, the plan ran, and the log said "0 lines" with no note. */
        {Published = True}
        Procedure AnsiWide_InsideIfndefDeclareOnceGuardIsConverted
            String[] asCode
            Integer iCount i iOpen iWide
            Move (Character(35) + "IFNDEF get_MyGetCompressedFileSize") to asCode[0]
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" Kernel32.dll String lpFileName Pointer lpFileSizeHigh Returns DWord' to asCode[1]
            Move (Character(35) + "ENDIF") to asCode[2]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send AssertIAreEqual 1 iCount
            // The version gate nests INSIDE the declare-once gate; both survive.
            Move -1 to iOpen
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (Trim(asCode[i]) = (Character(35) + "IF (" + Character(33) + "@ < 220)")) ;
                    Move i to iOpen
            Loop
            Send Assert (iOpen > 0)
            Send AssertSAreEqual (Character(35) + "IFNDEF get_MyGetCompressedFileSize") asCode[0]
            Move 0 to iWide
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "GetCompressedFileSizeW") ;
                    Increment iWide
            Loop
            Send AssertIAreEqual 1 iWide
        End_Procedure

        /* THE REPORTED DECLARATION ITSELF, verbatim - and it is REFUSED, on purpose. Once the
           #IFNDEF no longer hides it (the test above), Win32_CreateFile reaches the
           Pointer-vs-marshal rule: it declares Pointer lpFileName where the catalogue twin
           marshals WString, i.e. the AddressOf convention, and pairing it mechanically would hand
           a raw address to WString marshalling - silently. That refusal is the 2026-08-28 decision
           and stands; what the bug cost was the NOTE. Pinned here so a later change cannot quietly
           turn the refusal back into silence, which is the only part Nils actually saw.
           The board offers this row from DS 9221, which keys on the entry point and the catalogue
           and cannot see the parameter shape - so the honest end of the run is a note, not a fix. */
        /* THE TRAILING COMMENTS WERE WALKING AROUND THE SAFETY CHECK (Nils 2026-08-31, the DUF
           header, verbatim). The block was flattened from the RAW lines, so "// file name" and
           friends were counted as parameters; the count then disagreed with the catalogue twin,
           and the Pointer-vs-marshal refusal - which only ran when the counts MATCHED - silently
           did not run. The pair was emitted: Pointer lpFileName on the ANSI arm, WString on the
           wide one, over call sites that pass an address. On a Unicode DataFlex that address
           would have been marshalled as text.
           The flattening now strips end comments, so the refusal actually gets to judge - and a
           count mismatch is itself a refusal rather than a fall-through. */
        /* A PAIR MUST NOT CHANGE THE CALL CONTRACT. Measured 2026-08-31: a local that declares
           fewer parameters than the catalogue twin used to be paired anyway - the ANSI arm took
           1 argument, the emitted wide arm took 6, both under the SAME DataFlex name. On a
           Unicode DataFlex every existing call site would then be wrong, against a converter
           whose whole promise is "no call site changes". A list that does not line up is a
           refusal, not a fall-through. */
        {Published = True}
        Procedure AnsiWide_ArityMismatchIsRefused
            String[] asCode asNone
            String sNotes
            Integer iCount i iWide
            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll ;' to asCode[0]
            Move '    Handle hWnd ;' to asCode[1]
            Move '    Returns Handle' to asCode[2]
            Set pasRunNotes of ghoFuncLib to asNone
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 3 (SizeOfArray(asCode))
            Move 0 to iWide
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "ShellExecuteW") ;
                    Increment iWide
            Loop
            Send AssertIAreEqual 0 iWide
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "" to sNotes
            Send Assert (sNotes contains "does not line up")
        End_Procedure

        {Published = True}
        Procedure AnsiWide_TrailingCommentsDoNotDefeatTheRefusal
            String[] asCode asNone
            String sNotes
            Integer iCount iSizeBefore i iWide
            Move (Character(35) + "IFNDEF get_Win32_CreateFile") to asCode[0]
            Move 'External_Function Win32_CreateFile "CreateFileA" KERNEL32.DLL ;' to asCode[1]
            Move '    Pointer lpFileName ;              // file name' to asCode[2]
            Move '    DWord dwDesiredAccess ;           // access mode' to asCode[3]
            Move '    DWord dwShareMode ;               // share mode' to asCode[4]
            Move '    Pointer lpSecurityAttributes ;    // SD' to asCode[5]
            Move '    DWord dwCreationDisposition ;     // how to create' to asCode[6]
            Move '    DWord dwFlagsAndAttributes ;      // file attributes' to asCode[7]
            Move '    Handle hTemplateFile ;            // handle to template file' to asCode[8]
            Move '    Returns Handle' to asCode[9]
            Move (Character(35) + "ENDIF") to asCode[10]
            Move (SizeOfArray(asCode)) to iSizeBefore
            Set pasRunNotes of ghoFuncLib to asNone
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual iSizeBefore (SizeOfArray(asCode))
            // No wide arm was written - THE assertion. A count of 0 alone would also hold if the
            // walk had simply skipped the block.
            Move 0 to iWide
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "CreateFileW") ;
                    Increment iWide
            Loop
            Send AssertIAreEqual 0 iWide
            // ...and the refusal names itself.
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "" to sNotes
            Send Assert (sNotes contains "Win32_CreateFile")
            Send Assert (sNotes contains "Pointer")
        End_Procedure

        {Published = True}
        Procedure AnsiWide_PointerForTextParamIsRefusedWithANote
            String[] asCode asNone
            String sNotes
            Integer iCount iSizeBefore
            Move (Character(35) + "IFNDEF get_Win32_CreateFile") to asCode[0]
            Move 'External_Function Win32_CreateFile "CreateFileA" KERNEL32.DLL ;' to asCode[1]
            Move '    Pointer lpFileName ;' to asCode[2]
            Move '    DWord dwDesiredAccess ;' to asCode[3]
            Move '    DWord dwShareMode ;' to asCode[4]
            Move '    Pointer lpSecurityAttributes ;' to asCode[5]
            Move '    DWord dwCreationDisposition ;' to asCode[6]
            Move '    DWord dwFlagsAndAttributes ;' to asCode[7]
            Move '    Handle hTemplateFile ;' to asCode[8]
            Move '    Returns Handle' to asCode[9]
            Move (Character(35) + "ENDIF") to asCode[10]
            Move (SizeOfArray(asCode)) to iSizeBefore
            Set pasRunNotes of ghoFuncLib to asNone
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            // Not guarded, nothing added or removed...
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual iSizeBefore (SizeOfArray(asCode))
            // ...and it SAYS SO. A silent 0 is what made this look like a broken converter.
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "" to sNotes
            Send Assert (sNotes contains "Win32_CreateFile")
            Send Assert (sNotes contains "Pointer")
        End_Procedure


        // Idempotent: an already-guarded declaration is never wrapped twice.
        {Published = True}
        Procedure AnsiWide_AlreadyGuardedUntouched
            String[] asCode
            Integer iCount
            Move (GRGF_ExpectedOpen(Self)) to asCode[0]
            Move 'External_Function MyGetTempPath "GetTempPathA" Kernel32.dll DWord n Pointer lp Returns DWord' to asCode[1]
            Move (Character(35) + "ENDIF") to asCode[2]
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 3)
        End_Procedure

        /* ---- The target install is asked FIRST: the Use-arm (Nils 2026-09-02) ----
           WinServ's InternetOption.pkg declared WinAPI_InternetSetOption ANSI; the campaign gave it a
           wide twin; DataFlex 26's own cHttpTransfer.pkg declares the same name and ANY second
           External_Function of a name is error 4390. So a name the target install declares gets
           'Use <package>' on the modern arm, gated on the TARGET's version, and never a twin. */

        // The install catalogue, INJECTED (the runner has no target Pkg folder - see
        // WinAPIStructs_NestedAlignmentIsRecursive). TearDown's _InitializeFuncLib clears all three.
        Procedure GRGF_SeedInstallExternals
            String[] asNames asPkgs
            Move "WINAPI_INTERNETSETOPTION" to asNames[0]
            Move "WINAPI_INTERNETSETOPTION|cHttpTransfer.pkg" to asPkgs[0]
            Set pasInstallExternalNames      of ghoFuncLib to asNames
            Set pasInstallExternalPkgs       of ghoFuncLib to asPkgs
            Set pbInstallExternalNamesLoaded of ghoFuncLib to True
        End_Procedure

        Function GRGF_AnsiSetOption Returns String
            Function_Return 'External_Function WinAPI_InternetSetOption "InternetSetOptionA" WinInet.dll Handle hInternet DWord dwOption Pointer lpBuffer DWord dwBufferLength Returns Boolean'
        End_Function

        // The install-declared name gets the Use-arm on the TARGET gate (260); an unrelated name in the
        // same file still gets its wide twin on the UNICODE gate (220). No W entry for the first anywhere.
        {Published = True}
        Procedure AnsiWide_InstallDeclaredNameGetsUseArmNotWideTwin
            String[] asCode
            String sNotes
            Integer iCount i
            Boolean bW

            Move (GRGF_AnsiSetOption(Self)) to asCode[0]
            Move 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" Kernel32.dll String lpFileName Pointer lpFileSizeHigh Returns DWord' to asCode[1]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 2)
            // 2-line banner, target gate, the declaration verbatim, #ELSE, Use, #ENDIF
            Send Assert (asCode[0] contains "[DFRefactor] DataFlex 26.0 declares WinAPI_InternetSetOption itself (cHttpTransfer.pkg)")
            Send Assert (asCode[1] contains "stays for older releases")
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") asCode[2]
            Send AssertSAreEqual (GRGF_AnsiSetOption(Self)) asCode[3]
            Send AssertSAreEqual (Character(35) + "ELSE") asCode[4]
            Send AssertSAreEqual "Use cHttpTransfer.pkg" asCode[5]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[6]
            // the unrelated name: the wide pair as before, on the Unicode boundary
            Send Assert (asCode[7] contains "ANSI and wide side by side")
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 220)") asCode[10]
            Move False to bW
            For i from 0 to (SizeOfArray(asCode) - 1)
                Send Assert (Pos("InternetSetOptionW", asCode[i]) = 0)
                If (Pos("GetCompressedFileSizeW", asCode[i]) > 0) ;
                    Move True to bW
            Loop
            Send Assert (bW = True)
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "" to sNotes
            Send Assert (sNotes contains "cHttpTransfer.pkg")
        End_Procedure

        // Idempotent: a second pass over the Use-arm changes nothing.
        {Published = True}
        Procedure AnsiWide_UseArmIsIdempotent
            String[] asCode
            Integer iCount iSize

            Move (GRGF_AnsiSetOption(Self)) to asCode[0]
            Move 'Move (WinAPI_InternetSetOption(hNet, 2, 0, 0)) to bOk' to asCode[1]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 1)
            Move (SizeOfArray(asCode)) to iSize
            Send Assert (iSize = 8)
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = iSize)
            Send AssertSAreEqual 'Move (WinAPI_InternetSetOption(hNet, 2, 0, 0)) to bOk' asCode[7]
        End_Procedure

        // No target version handed in (the pure core's older 3-argument callers): the Unicode boundary
        // bounds the Use-arm too, and the banner names that version.
        {Published = True}
        Procedure AnsiWide_UseArmFallsBackToTheUnicodeVersionWithoutATarget
            String[] asCode
            Integer iCount

            Move (GRGF_AnsiSetOption(Self)) to asCode[0]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 0 "" "" to iCount
            Send Assert (iCount = 1)
            Send Assert (asCode[0] contains "DataFlex 22.0 declares")
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 220)") asCode[2]
            Send AssertSAreEqual "Use cHttpTransfer.pkg" asCode[5]
        End_Procedure

        // The REPAIR: a wide pair this tool emitted earlier (its exact banner) for a name the install
        // declares is rewritten to the Use-arm - old banner gone, target gate, ANSI arm verbatim, no W
        // entry left, the code after it untouched - and a second pass is a no-op.
        {Published = True}
        Procedure AnsiWide_OwnWidePairIsRepairedToTheUseArm
            String[] asCode
            String sNotes
            Integer iCount i

            Send _EmitWideBanner of ghoFuncLib (&asCode) "" "22.0"
            Move (Character(35) + "IF (" + Character(33) + "@ < 220)") to asCode[3]
            Move (GRGF_AnsiSetOption(Self)) to asCode[4]
            Move (Character(35) + "ELSE") to asCode[5]
            Move 'External_Function WinAPI_InternetSetOption "InternetSetOptionW" WinInet.dll ;' to asCode[6]
            Move '    Handle hInternet DWord dwOption Pointer lpBuffer DWord dwBufferLength Returns Integer' to asCode[7]
            Move (Character(35) + "ENDIF") to asCode[8]
            Move 'Move (WinAPI_InternetSetOption(hNet, 2, 0, 0)) to bOk' to asCode[9]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 8)
            Send Assert (asCode[0] contains "declares WinAPI_InternetSetOption itself (cHttpTransfer.pkg)")
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") asCode[2]
            Send AssertSAreEqual (GRGF_AnsiSetOption(Self)) asCode[3]
            Send AssertSAreEqual (Character(35) + "ELSE") asCode[4]
            Send AssertSAreEqual "Use cHttpTransfer.pkg" asCode[5]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[6]
            Send AssertSAreEqual 'Move (WinAPI_InternetSetOption(hNet, 2, 0, 0)) to bOk' asCode[7]
            For i from 0 to 7
                Send Assert (Pos("InternetSetOptionW", asCode[i]) = 0)
                Send Assert (Pos("ANSI and wide side by side", asCode[i]) = 0)
            Loop
            Get RunNotesText of ghoFuncLib "GuardAnsiExternalFunctionWithWide" "" to sNotes
            Send Assert (sNotes contains "earlier wide arm replaced")
            // and again: nothing to do
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 8)
        End_Procedure

        // NEGATIVE CONTROL for the repair: the same pair for a name the install does NOT declare is
        // finished work and copied through untouched (the idempotence rule, unchanged).
        {Published = True}
        Procedure AnsiWide_OwnWidePairOfAnUndeclaredNameStays
            String[] asCode
            Integer iCount

            Send _EmitWideBanner of ghoFuncLib (&asCode) "" "22.0"
            Move (Character(35) + "IF (" + Character(33) + "@ < 220)") to asCode[3]
            Move 'External_Function MyGetTempPath "GetTempPathA" Kernel32.dll DWord n Pointer lp Returns DWord' to asCode[4]
            Move (Character(35) + "ELSE") to asCode[5]
            Move 'External_Function MyGetTempPath "GetTempPathW" Kernel32.dll DWord n Pointer lp Returns DWord' to asCode[6]
            Move (Character(35) + "ENDIF") to asCode[7]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 8)
            Send Assert (asCode[0] contains "ANSI and wide side by side")
            Send AssertSAreEqual 'External_Function MyGetTempPath "GetTempPathW" Kernel32.dll DWord n Pointer lp Returns DWord' asCode[6]
        End_Procedure

        // The composed shape: a retyper IS$WIN64 pair of an install-declared name rides the TARGET
        // gate WHOLE, with the Use-arm as its #ELSE - no wide twin.
        {Published = True}
        Procedure AnsiWide_ComposedPairOfInstallDeclaredNameGetsTheUseArm
            String[] asCode
            Integer iCount i

            Move (Character(35) + "IFDEF IS$WIN64") to asCode[0]
            Move (GRGF_AnsiSetOption(Self)) to asCode[1]
            Move (Character(35) + "ELSE") to asCode[2]
            Move (GRGF_AnsiSetOption(Self)) to asCode[3]
            Move (Character(35) + "ENDIF") to asCode[4]
            Send GRGF_SeedInstallExternals
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 11)
            Send Assert (asCode[0] contains "declares WinAPI_InternetSetOption itself (cHttpTransfer.pkg)")
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") asCode[2]
            Send AssertSAreEqual (Character(35) + "IFDEF IS$WIN64") asCode[3]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[7]
            Send AssertSAreEqual (Character(35) + "ELSE") asCode[8]
            Send AssertSAreEqual "Use cHttpTransfer.pkg" asCode[9]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[10]
            For i from 0 to 10
                Send Assert (Pos("InternetSetOptionW", asCode[i]) = 0)
            Loop
            // idempotent too
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "" to iCount
            Send Assert (iCount = 0)
            Send Assert (SizeOfArray(asCode) = 11)
        End_Procedure

        // The install walk's pkg view: the same "NAME|" packed lookup answers the leaf, "" for a stranger.
        {Published = True}
        Procedure AnsiWide_InstallPkgForIsThePackedLookup
            String[] asPkgs
            String sPkg

            Move "WINAPI_INTERNETSETOPTION|cHttpTransfer.pkg" to asPkgs[0]
            Move "GETTEMPPATH|Windows.pkg" to asPkgs[1]
            Get _InstallPkgFor of ghoFuncLib "WinAPI_InternetSetOption" asPkgs to sPkg
            Send AssertSAreEqual "cHttpTransfer.pkg" sPkg
            Get _InstallPkgFor of ghoFuncLib "GetTempPath" asPkgs to sPkg
            Send AssertSAreEqual "Windows.pkg" sPkg
            Get _InstallPkgFor of ghoFuncLib "GetTempPathW" asPkgs to sPkg
            Send AssertSAreEqual "" sPkg
        End_Procedure

        /* ---- The file itself may be the package (2026-09-03) ----
           A workspace copy of the DataFlex package that declares the name must NOT get
           'Use <itself>': the twin route serves. Any other file still gets the Use-arm; the leaf
           compares case-insensitively. The seed is local to these two: MyGetCompressedFileSize, which the
           twin tests above prove has a catalogue W twin, declared by an invented MyApi.pkg. */
        Procedure GRGF_SeedMyApiPkg
            String[] asNames asPkgs
            Move "MYGETCOMPRESSEDFILESIZE" to asNames[0]
            Move "MYGETCOMPRESSEDFILESIZE|MyApi.pkg" to asPkgs[0]
            Set pasInstallExternalNames      of ghoFuncLib to asNames
            Set pasInstallExternalPkgs       of ghoFuncLib to asPkgs
            Set pbInstallExternalNamesLoaded of ghoFuncLib to True
        End_Procedure

        Function GRGF_AnsiCompressedSize Returns String
            Function_Return 'External_Function MyGetCompressedFileSize "GetCompressedFileSizeA" Kernel32.dll String lpFileName Pointer lpFileSizeHigh Returns DWord'
        End_Function

        {Published = True}
        Procedure AnsiWide_SelfNamedFileTakesTheTwinNotAUseOfItself
            String[] asCode
            Integer iCount i
            Boolean bUse bTwin

            Move (GRGF_AnsiCompressedSize(Self)) to asCode[0]
            Send GRGF_SeedMyApiPkg
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "myapi.PKG" to iCount
            Send Assert (iCount = 1)
            Move False to bUse
            Move False to bTwin
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "Use MyApi.pkg") ;
                    Move True to bUse
                If (asCode[i] contains "GetCompressedFileSizeW") ;
                    Move True to bTwin
            Loop
            Send Assert (bUse = False)
            Send Assert (bTwin = True)
        End_Procedure

        // The positive control: the same seed from any OTHER file still writes the Use-arm, no twin.
        {Published = True}
        Procedure AnsiWide_OtherFileStillGetsTheUseArm
            String[] asCode
            Integer iCount i
            Boolean bUse bTwin

            Move (GRGF_AnsiCompressedSize(Self)) to asCode[0]
            Send GRGF_SeedMyApiPkg
            Get _GuardAnsiWideInLines of ghoFuncLib (&asCode) 220 "22.0" 260 "26.0" "Other.pkg" to iCount
            Send Assert (iCount = 1)
            Move False to bUse
            Move False to bTwin
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "Use MyApi.pkg") ;
                    Move True to bUse
                If (asCode[i] contains "GetCompressedFileSizeW") ;
                    Move True to bTwin
            Loop
            Send Assert (bUse = True)
            Send Assert (bTwin = False)
        End_Procedure

        /* ---- The struct emitter's ALIGNMENT rule (2026-08-09) ----
           Ground truth is DataFlex's own tWinStructs.pkg, which has been passed to Win32 in
           production: the rule was derived from it and reproduces 49 of its 57 structs exactly. */

        // COPYDATASTRUCT: ULONG_PTR(8) DWORD(4) PVOID(8). The pointer needs 8-alignment at offset
        // 12, so a 4-byte interior filler goes in - and it must be guarded, because on x86 every
        // one of those is 4 wide and the gap does not exist.
        {Published = True}
        Procedure WinAPIStructs_InteriorGapGetsAGuardedFiller
            String[] asNotes
            String sOut
            Get WinAPIStructDataFlexDecl of ghoFuncLib "COPYDATASTRUCT" (&asNotes) to sOut
            Send Assert (sOut <> "")
            // "t" on the TYPE - DataFlex's own convention, which all 59 of its Win32 structs use.
            Send Assert (Pos("Struct tCOPYDATASTRUCT", sOut) > 0)
            Send Assert (Pos("MissingAlignment", sOut) > 0)
            Send Assert (Pos("IFDEF IS$WIN64", sOut) > 0)
            Send Assert (Pos("ENDIF", sOut) > 0)
            // The filler belongs BEFORE the member it aligns, not at the end.
            Send Assert (Pos("MissingAlignment", sOut) < Pos("lpData", sOut))
        End_Procedure

        // SECURITY_ATTRIBUTES: DWORD(4) LPVOID(8) BOOL(4) - a gap before the pointer, and a tail
        // pad to the struct's own 8-byte alignment. Two fillers, numbered.
        {Published = True}
        Procedure WinAPIStructs_TailIsPaddedToStructAlignment
            String[] asNotes
            String sOut
            Get WinAPIStructDataFlexDecl of ghoFuncLib "SECURITY_ATTRIBUTES" (&asNotes) to sOut
            Send Assert (sOut <> "")
            Send Assert (Pos("MissingAlignment1", sOut) > 0)
            Send Assert (Pos("MissingAlignment2", sOut) > 0)
            Send Assert (Pos("End_Struct", sOut) > 0)
        End_Procedure

        /* The "t" goes on the type unless it is already there. Some SDK names begin with T of their
           own accord (TBBUTTON, TRUSTEEA, TVITEMA), and "tTBBUTTON" would be a prefix explaining a
           prefix - so the SDK spelling stands. */
        {Published = True}
        Procedure WinAPIStructs_TypePrefixNotDoubled
            String[] asNotes
            String sOut
            Get WinAPIStructDataFlexDecl of ghoFuncLib "TRUSTEEA" (&asNotes) to sOut
            If (sOut <> "") Begin
                Send Assert (Pos("Struct TRUSTEEA", sOut) > 0)
                Send Assert (Pos("Struct tTRUSTEEA", sOut) = 0)
            End
            // ...and a name that does not carry it, does get it.
            Get WinAPIStructDataFlexDecl of ghoFuncLib "SECURITY_ATTRIBUTES" (&asNotes) to sOut
            Send Assert (Pos("Struct tSECURITY_ATTRIBUTES", sOut) > 0)
        End_Procedure

        // A member whose size cannot be computed REFUSES the struct rather than guessing - the
        // whole point, since a wrong size moves every field after it without failing to compile.
        {Published = True}
        Procedure WinAPIStructs_UncomputableMemberRefuses
            String[] asNotes
            String sOut
            Get WinAPIStructDataFlexDecl of ghoFuncLib "NoSuchStructAnywhere" (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* The recursion that had to be right: a nested struct aligns to ITS widest member, not to
           8. tWinFileTime is two DWords - size 8, align 4 - and assuming 8 mispredicts every
           struct that nests one. */
        {Published = True}
        Procedure WinAPIStructs_NestedAlignmentIsRecursive
            String[] asMem
            String sSA

            // The members are INJECTED rather than walked off the install: the DFUnit runner is
            // built on cApplication and has no target Pkg folder, so a test that depended on the
            // walk would pass or fail by environment. TearDown's _InitializeFuncLib clears it.
            Move "TWINFILETIME|DWord;DWord;" to asMem[0]
            Move "TWINPOINT|Integer;Integer;" to asMem[1]
            Move "TWINBIG|Handle;DWord;"      to asMem[2]
            Set pasInstallStructMembers of ghoFuncLib to asMem
            // Two DWords: 8 bytes, aligned FOUR - not 8. This is the case that mispredicted
            // tWin32FindData when a nested struct was assumed to be 8-aligned.
            Get _DfTypeSizeAlign of ghoFuncLib "tWinFileTime" 0 to sSA
            Send AssertSAreEqual "8|4" sSA
            Get _DfTypeSizeAlign of ghoFuncLib "tWinPoint" 0 to sSA
            Send AssertSAreEqual "8|4" sSA
            // Handle(8) + DWord(4) = 12, but the struct aligns to 8, so its SIZE rounds to 16.
            Get _DfTypeSizeAlign of ghoFuncLib "tWinBig" 0 to sSA
            Send AssertSAreEqual "16|8" sSA
            // ...and a scalar still answers for itself.
            Get _DfTypeSizeAlign of ghoFuncLib "Handle" 0 to sSA
            Send AssertSAreEqual "8|8" sSA
            Get _DfTypeSizeAlign of ghoFuncLib "DWord" 0 to sSA
            Send AssertSAreEqual "4|4" sSA
        End_Procedure

        /* ---- Both targets (2026-11-06) ----
           DataFlex packs a struct in a 32-bit program as well, so a gap Windows has there must be written
           out there too. Every computed filler used to go inside #IFDEF IS$WIN64, on the belief that a
           32-bit program has no gaps: true in front of a pointer, false after a Char or a Short - and the
           harvested rows carried their 64-bit fillers with no guard at all. */

        // How many times sNeedle occurs in sHay. (Object-level methods are global: the name is this file's.)
        Function StructX86_CountOf String sNeedle String sHay Returns Integer
            Integer iCount iAt
            Move 0 to iCount
            Move (Pos(sNeedle, sHay)) to iAt
            While (iAt > 0)
                Increment iCount
                Move (Right(sHay, (Length(sHay) - iAt - Length(sNeedle) + 1))) to sHay
                Move (Pos(sNeedle, sHay)) to iAt
            Loop
            Function_Return iCount
        End_Function

        // The emission for one struct out of a catalogue of just these rows; the catalogue is put back.
        Function StructX86_Decl String[] asRows String sName String[] ByRef asNotes Returns String
            String[] asSaved
            String sOut
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Set pasWinAPIStructCatalog of ghoFuncLib to asRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIStructDataFlexDecl of ghoFuncLib sName (&asNotes) to sOut
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Function_Return sOut
        End_Function

        // Nils's own example (2026-11-06): a char, then a pointer. 7 bytes of gap on x64, 3 on x86 - one
        // name in an #IFDEF / #ELSE pair, in front of the pointer, and no tail: both end on the pointer.
        {Published = True}
        Procedure WinAPIStructs_CharBeforePointerPadsBothTargets
            String[] asRows asNotes
            String sOut sNl sPair
            Move "MYSTRUCT|{ char someChar; LPVOID lp; }" to asRows[0]
            Get StructX86_Decl asRows "MYSTRUCT" (&asNotes) to sOut
            Move ((Character(13)) + (Character(10))) to sNl
            Move ((Character(35)) + "IFDEF IS$WIN64" + sNl + "    UChar[7] tMYSTRUCTMissingAlignment1" + sNl + (Character(35)) + "ELSE" + sNl ;
                + "    UChar[3] tMYSTRUCTMissingAlignment1" + sNl + (Character(35)) + "ENDIF" + sNl + "    Pointer lp") to sPair
            Send Assert (Pos(sPair, sOut) > 0) sOut
            Send Assert (Pos("    Char someChar", sOut) > 0) sOut
            Send Assert (Pos("MissingAlignment2", sOut) = 0) "no tail filler: both targets end on the pointer"
        End_Procedure

        // A gap both targets have is ONE plain filler: a WORD before a DWORD is two bytes in either.
        {Published = True}
        Procedure WinAPIStructs_SameGapOnBothTargetsIsNotGuarded
            String[] asRows asNotes
            String sOut
            Move "WORDDWORD|{ WORD w; DWORD d; }" to asRows[0]
            Get StructX86_Decl asRows "WORDDWORD" (&asNotes) to sOut
            Send Assert (Pos("    Short tWORDDWORDMissingAlignment1", sOut) > 0) sOut
            Send Assert (Pos("IS$WIN64", sOut) = 0) sOut
        End_Procedure

        // An 8-byte number aligns to 8 in a 32-bit program too, so a DWORD before a ULONGLONG has the
        // same 4-byte gap on both - plain, not guarded.
        {Published = True}
        Procedure WinAPIStructs_EightByteNumberAlignsOnBothTargets
            String[] asRows asNotes
            String sOut
            Move "DWORDTHENLONG|{ DWORD a; ULONGLONG b; }" to asRows[0]
            Get StructX86_Decl asRows "DWORDTHENLONG" (&asNotes) to sOut
            Send Assert (Pos("    Integer tDWORDTHENLONGMissingAlignment1", sOut) > 0) sOut
            Send Assert (Pos("IS$WIN64", sOut) = 0) sOut
        End_Procedure

        // The sizes behind it, per target. A Boolean is the 1 byte DataFlex makes of it (measured).
        {Published = True}
        Procedure WinAPIStructs_SizeAlignPerTarget
            String[] asMem
            String sSA
            Move "TWINBIG|Handle;DWord;" to asMem[0]
            Set pasInstallStructMembers of ghoFuncLib to asMem
            Get _DfTypeSizeAlignFor of ghoFuncLib "Pointer" False 0 to sSA
            Send AssertSAreEqual "4|4" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "Pointer" True 0 to sSA
            Send AssertSAreEqual "8|8" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "LongPtr" False 0 to sSA
            Send AssertSAreEqual "4|4" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "BigInt" False 0 to sSA
            Send AssertSAreEqual "8|8" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "Boolean" True 0 to sSA
            Send AssertSAreEqual "1|1" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "Guid" False 0 to sSA
            Send AssertSAreEqual "16|4" sSA
            // Handle + DWord: 16 bytes aligned 8 in a 64-bit program, 8 aligned 4 in a 32-bit one
            Get _DfTypeSizeAlignFor of ghoFuncLib "tWinBig" True 0 to sSA
            Send AssertSAreEqual "16|8" sSA
            Get _DfTypeSizeAlignFor of ghoFuncLib "tWinBig" False 0 to sSA
            Send AssertSAreEqual "8|4" sSA
        End_Procedure

        /* A HARVESTED ROW, PROVEN. Its fillers are dropped, the real members laid out as Windows does
           reproduce the row's own 64-bit layout, so the same rule answers for 32-bit: both of
           SECURITY_ATTRIBUTES' gaps are 64-bit only. As harvested, a 32-bit program made it 20 bytes;
           Windows reads 12. */
        {Published = True}
        Procedure WinAPIDF_ProvenRowGetsGapsForBothTargets
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("SECURITY_ATTRIBUTES|DF|Struct SECURITY_ATTRIBUTES" + sLf + "UInteger nLength" + sLf + "Integer iMissingAlignment1" + sLf ;
                + "Pointer lpSecurityDescriptor" + sLf + "Integer bInheritHandle  // BOOL" + sLf + "Integer iMissingAlignment2" + sLf + "End_Struct") to asRows[0]
            Get StructX86_Decl asRows "SECURITY_ATTRIBUTES" (&asNotes) to sOut
            Send Assert (Pos("Struct tSECURITY_ATTRIBUTES", sOut) = 1) sOut
            Send Assert (Pos("64-bit layout", sOut) = 0) sOut
            Send Assert (Pos("ERROR", sOut) = 0) sOut
            Send Assert (Pos("    UInteger nLength" + sLf + (Character(35)) + "IFDEF IS$WIN64" + sLf + "    Integer iMissingAlignment1" + sLf ;
                + (Character(35)) + "ENDIF" + sLf + "    Pointer lpSecurityDescriptor", sOut) > 0) sOut
            Send Assert (Pos("    Integer bInheritHandle  // BOOL" + sLf + (Character(35)) + "IFDEF IS$WIN64" + sLf + "    Integer iMissingAlignment2" + sLf ;
                + (Character(35)) + "ENDIF" + sLf + "End_Struct", sOut) > 0) sOut
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
        End_Procedure

        /* shellapi.h (and commdlg.h) structs are byte-packed in a 32-bit program, so there SHFILEOPSTRUCT
           has no gap at all and is 30 bytes: both fillers are 64-bit only. The same members under a name
           outside that family DO have a 2-byte gap after fFlags on x86 - the control that shows the
           packing is what decides it. */
        {Published = True}
        Procedure WinAPIDF_ShellApiRowIsBytePackedOn32Bit
            String[] asRows asNotes
            String sOut sLf sBody sFlags
            Move (Character(10)) to sLf
            Move ("Handle hwnd  // HWND" + sLf + "UInteger wFunc" + sLf + "Integer iMissingAlignment1" + sLf + "Pointer pFrom  // PWSTR" + sLf ;
                + "Pointer pTo  // PWSTR" + sLf + "UShort fFlags" + sLf + "Short iMissingAlignment2" + sLf + "Integer fAnyOperationsAborted  // BOOL" + sLf ;
                + "Pointer hNameMappings" + sLf + "Pointer lpszProgressTitle  // PWSTR" + sLf + "End_Struct") to sBody
            Move ("SHFILEOPSTRUCTW|DF|Struct SHFILEOPSTRUCTW" + sLf + sBody) to asRows[0]
            Get StructX86_Decl asRows "SHFILEOPSTRUCTW" (&asNotes) to sOut
            Send AssertIAreEqual 2 (StructX86_CountOf(Self, (Character(35)) + "IFDEF IS$WIN64", sOut))
            Send Assert (Pos((Character(35)) + "ELSE", sOut) = 0) sOut
            Move ("    UShort fFlags" + sLf + (Character(35)) + "IFDEF IS$WIN64" + sLf + "    Short iMissingAlignment2" + sLf + (Character(35)) + "ENDIF" + sLf) to sFlags
            Send Assert (Pos(sFlags, sOut) > 0) sOut
            // the control: not a shellapi.h name, so 32-bit aligns it and the gap after fFlags is both targets'
            Move ("SHFILEOPLIKE|DF|Struct SHFILEOPLIKE" + sLf + sBody) to asRows[0]
            Get StructX86_Decl asRows "SHFILEOPLIKE" (&asNotes) to sOut
            Send Assert (Pos("    UShort fFlags" + sLf + "    Short iMissingAlignment2" + sLf + "    Integer fAnyOperationsAborted", sOut) > 0) sOut
        End_Procedure

        // A harvested row nests another by its SDK name; that one is laid out (and proven) per target too.
        {Published = True}
        Procedure WinAPIDF_NestedRowIsLaidOutPerTarget
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("POINTX|DF|Struct POINTX" + sLf + "Integer x" + sLf + "Integer y" + sLf + "End_Struct") to asRows[0]
            Move ("HOLDER|DF|Struct HOLDER" + sLf + "UChar c" + sLf + "UChar[3] cMissingAlignment1" + sLf + "POINTX pt" + sLf ;
                + "Integer iMissingAlignment2" + sLf + "Pointer p" + sLf + "End_Struct") to asRows[1]
            Get StructX86_Decl asRows "HOLDER" (&asNotes) to sOut
            // 3 bytes before the 4-aligned POINTX on both; 4 more before the pointer on 64-bit only
            Send Assert (Pos("    UChar c" + sLf + "    UChar[3] iMissingAlignment1" + sLf + "    POINTX pt" + sLf + (Character(35)) + "IFDEF IS$WIN64" + sLf ;
                + "    Integer iMissingAlignment2" + sLf + (Character(35)) + "ENDIF" + sLf + "    Pointer p", sOut) > 0) sOut
        End_Procedure

        /* NOT PROVEN, SO A 32-BIT COMPILE STOPS. An 8-byte union may hold a pointer, so its 32-bit size is
           not in a 64-bit catalogue: the row stays as it is, 64-bit, and an #ERROR inside #IFNDEF IS$WIN64
           says why - rather than a 32-bit program compiling a layout that moves every member after it. */
        {Published = True}
        Procedure WinAPIDF_UnionRowStopsA32BitCompile
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("UNIONHOLDER|DF|Struct UNIONHOLDER" + sLf + "UInteger cbSize" + sLf + "Integer iMissingAlignment1" + sLf + "Pointer hWnd" + sLf ;
                + "UChar[8] UnionName1" + sLf + "End_Struct") to asRows[0]
            Get StructX86_Decl asRows "UNIONHOLDER" (&asNotes) to sOut
            Send Assert (Pos("64-bit layout", sOut) > 0) sOut
            Send Assert (Pos((Character(35)) + "IFNDEF IS$WIN64" + sLf + (Character(35)) + "ERROR DFERR_PROGRAM " + '"' + "tUNIONHOLDER: only its 64-bit layout is known", sOut) > 0) sOut
            Send Assert (Pos("union", sOut) > 0) sOut
            // the row itself as it was
            Send Assert (Pos("Integer iMissingAlignment1" + sLf + "Pointer hWnd", sOut) > 0) sOut
            Send AssertIAreEqual 1 (SizeOfArray(asNotes))
            If (SizeOfArray(asNotes) = 1) ;
                Send Assert (Pos("64-bit layout only", asNotes[0]) > 0) asNotes[0]
        End_Procedure

        /* A union under 8 bytes cannot hold a pointer, so it is the same size on both targets. In a
           shellapi.h struct - a tray icon's NOTIFYICONDATA - a 32-bit program packs it to the byte, so
           where it lies needs no alignment at all: proven, one 64-bit gap. */
        {Published = True}
        Procedure WinAPIDF_SmallUnionInAShellApiRowIsProven
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("NOTIFYICONDATAW|DF|Struct NOTIFYICONDATAW" + sLf + "UInteger cbSize" + sLf + "Integer iMissingAlignment1" + sLf + "Handle hWnd  // HWND" + sLf ;
                + "UInteger uID" + sLf + "UChar[4] UnionName1" + sLf + "Handle hIcon  // HICON" + sLf + "End_Struct") to asRows[0]
            Get StructX86_Decl asRows "NOTIFYICONDATAW" (&asNotes) to sOut
            Send Assert (Pos("ERROR", sOut) = 0) sOut
            Send Assert (Pos("    UChar[4] UnionName1", sOut) > 0) sOut
            Send AssertIAreEqual 1 (StructX86_CountOf(Self, (Character(35)) + "IFDEF IS$WIN64", sOut))
            Send AssertIAreEqual 0 (SizeOfArray(asNotes))
        End_Procedure

        // ...but outside such a struct, a small union a 32-bit program puts off a 4-byte boundary has an
        // alignment nothing here knows: not proven. (64-bit: p, s, the union at 10, i at 12 - it proves.)
        {Published = True}
        Procedure WinAPIDF_SmallUnionOffAlignedOn32BitIsNotProven
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("UNIONOFF|DF|Struct UNIONOFF" + sLf + "Pointer p" + sLf + "UShort s" + sLf + "UChar[2] UnionName1" + sLf + "Integer i" + sLf + "End_Struct") to asRows[0]
            Get StructX86_Decl asRows "UNIONOFF" (&asNotes) to sOut
            Send Assert (Pos((Character(35)) + "ERROR DFERR_PROGRAM", sOut) > 0) sOut
            Send Assert (Pos("union whose alignment in a 32-bit program", sOut) > 0) sOut
        End_Procedure

        // TBBUTTON pads with bReserved[6] on 64-bit and [2] on 32-bit: its offsets prove nothing for x86.
        {Published = True}
        Procedure WinAPIDF_ArchVariantRowStopsA32BitCompile
            String[] asRows asNotes
            String sOut sLf
            Move (Character(10)) to sLf
            Move ("TBBUTTON|DF|Struct TBBUTTON" + sLf + "Integer iBitmap" + sLf + "Integer idCommand" + sLf + "UChar fsState" + sLf + "UChar fsStyle" + sLf ;
                + "UChar[6] bReserved" + sLf + "ULongPtr dwData" + sLf + "LongPtr iString" + sLf + "End_Struct") to asRows[0]
            Get StructX86_Decl asRows "TBBUTTON" (&asNotes) to sOut
            Send Assert (Pos((Character(35)) + "ERROR DFERR_PROGRAM", sOut) > 0) sOut
            Send Assert (Pos("other members", sOut) > 0) sOut
        End_Procedure

        /* The member written as its bytes: the declaration's directive lines are not members (a guarded
           filler used to count twice and move iFrom), and a 32-bit program gets its own byte count where
           a pointer inside makes it differ. */
        {Published = True}
        Procedure WinAPIStructs_OpaqueTailCountsMembersPerTarget
            String[] asRows asSaved
            String sDecl sOut sLf
            Move (Character(10)) to sLf
            Move ("OPQP|DF|Struct OPQP" + sLf + "Pointer p" + sLf + "Integer n" + sLf + "Integer iMissingAlignment1" + sLf + "End_Struct") to asRows[0]
            Move ("Struct tX" + sLf + "    Integer first" + sLf + (Character(35)) + "IFDEF IS$WIN64" + sLf + "    Integer iMissingAlignment1" + sLf ;
                + (Character(35)) + "ENDIF" + sLf + "    OPQP second" + sLf + "    OPQP third" + sLf + "End_Struct") to sDecl
            Get pasWinAPIStructCatalog of ghoFuncLib to asSaved
            Set pasWinAPIStructCatalog of ghoFuncLib to asRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get _Win32OpaqueTailMembers of ghoFuncLib sDecl 2 to sOut
            Set pasWinAPIStructCatalog of ghoFuncLib to asSaved
            // member 1 is before iFrom 2: untouched
            Send Assert (Pos("    OPQP second", sOut) > 0) sOut
            Send Assert (Pos("UChar[16] third  // OPQP", sOut) > 0) sOut
            Send Assert (Pos("UChar[8] third  // OPQP", sOut) > 0) sOut
            Send Assert (Pos((Character(35)) + "ELSE", sOut) > 0) sOut
        End_Procedure

        /* ---- Judging a declaration against the SDK instead of against its parameter names ---- */

        // The x64 lie the catalogue exists to expose, stated as a fact and not inferred from a name.
        {Published = True}
        Procedure WinAPICatalog_WrongHandleTypeIsFound
            String[] asFindings
            Integer iN
            Get _WinAPICatalogueFindings of ghoFuncLib 'External_Function CloseHandle "CloseHandle" Kernel32.dll Integer hObject Returns Integer' (&asFindings) to iN
            Send Assert (iN = 1)
            Send Assert (Pos("parameter 1", asFindings[0]) > 0)
            Send Assert (Pos("Integer", asFindings[0]) > 0)
            Send Assert (Pos("Handle", asFindings[0]) > 0)
        End_Procedure

        // A declaration that already agrees with the SDK is COVERED and clean - 0, not -1.
        {Published = True}
        Procedure WinAPICatalog_CorrectDeclarationHasNoFindings
            String[] asFindings
            Integer iN
            Get _WinAPICatalogueFindings of ghoFuncLib 'External_Function CloseHandle "CloseHandle" Kernel32.dll Handle hObject Returns Integer' (&asFindings) to iN
            Send Assert (iN = 0)
        End_Procedure

        // An API the catalogue does not carry returns -1, so the report falls back to the heuristics.
        {Published = True}
        Procedure WinAPICatalog_UncoveredApiSignalsFallback
            String[] asFindings
            Integer iN
            Get _WinAPICatalogueFindings of ghoFuncLib 'External_Function SomethingExotic "SomethingExotic" Kernel32.dll Integer x Returns Integer' (&asFindings) to iN
            Send Assert (iN = -1)
        End_Procedure

        // A parameter COUNT that disagrees stops the comparison rather than reporting noise from
        // every position after the first.
        {Published = True}
        Procedure WinAPICatalog_ParamCountMismatchRefuses
            String[] asFindings
            Integer iN
            Get _WinAPICatalogueFindings of ghoFuncLib 'External_Function CloseHandle "CloseHandle" Kernel32.dll Handle hObject Integer bExtra Returns Integer' (&asFindings) to iN
            Send Assert (iN = 1)
            Send Assert (Pos("parameters", asFindings[0]) > 0)
        End_Procedure

        // ByRef is a qualifier, not a type - the type after it is what gets compared.
        {Published = True}
        Procedure WinAPICatalog_ParamTypesSkipQualifiersAndNames
            String[] asTypes
            String sRet
            Get _ExternalFnParamTypes of ghoFuncLib 'External_Function Foo "Foo" Bar.dll Handle hWnd ByRef Pointer lpBuf Returns Integer' (&asTypes) to sRet
            Send Assert (SizeOfArray(asTypes) = 2)
            Send AssertSAreEqual "Handle" asTypes[0]
            Send AssertSAreEqual "Pointer" asTypes[1]
            Send AssertSAreEqual "Integer" sRet
        End_Procedure

        /* ---- The VERIFY note is CONDITIONAL (2026-08-09) ----
           Measured over the DF18/DF19 trees: 1,585 declarations bind exactly what DataFlex binds and
           226 do not, so a note on every block is wrong 7 times in 8. These three pin the three
           states: binding matches (silent), binding differs (names both entry points), binding
           unknown (still warns - the older behaviour, which the five tests above still assert by
           passing an empty set). */

        // Same dll AND same entry point as the install: nothing to verify, so no note - 5 lines, not 6.
        {Published = True}
        Procedure GuardExternals_BindingMatches_NoVerifyNote
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Move "WinAPI_InternetQueryOption" to asNames[0]
            Move "WINAPI_INTERNETQUERYOPTION|wininet.dll|internetqueryoptiona" to asBind[0]
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Returns Boolean' to asCode[0]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 5)
            Send AssertSAreEqual (GRGF_ExpectedOpen(Self)) asCode[2]
            Send AssertSAreEqual (Character(35) + "ENDIF") asCode[4]
            // The note is what must be absent - assert on the marker, not on the count alone.
            Send Assert (Pos("VERIFY", asCode[0]) = 0)
            Send Assert (Pos("VERIFY", asCode[1]) = 0)
        End_Procedure

        // ANSI here, wide in the install - the case the note exists for. It fires AND names both.
        {Published = True}
        Procedure GuardExternals_BindingDiffers_VerifyCitesBoth
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast
            Move "ShellExecute" to asNames[0]
            Move "SHELLEXECUTE|shell32.dll|shellexecutew" to asBind[0]
            Move 'External_Function ShellExecute "ShellExecuteA" Shell32.dll Returns Handle' to asCode[0]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 6)
            Send Assert (Pos("VERIFY", asCode[2]) > 0)
            // Both sides named: the evidence, not just the hazard.
            Send Assert (Pos("shellexecutea", asCode[2]) > 0)
            Send Assert (Pos("shellexecutew", asCode[2]) > 0)
        End_Procedure

        // Same entry point, DIFFERENT dll is still a difference worth naming.
        {Published = True}
        Procedure GuardExternals_BindingDiffersByDll_Verifies
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast
            Move "GetTickCount" to asNames[0]
            Move "GETTICKCOUNT|kernel32.dll|gettickcount" to asBind[0]
            Move 'External_Function GetTickCount "GetTickCount" Winmm.dll Returns DWord' to asCode[0]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send Assert (iCount = 1)
            Send Assert (SizeOfArray(asCode) = 6)
            Send Assert (Pos("VERIFY", asCode[2]) > 0)
        End_Procedure

        // The packed binding harvest: name uppercased, dll and entry lowercased, quotes stripped,
        // and a line that is not an External_Function contributes nothing.
        {Published = True}
        Procedure GuardExternals_BindingsFromLines_Harvest
            String[] asLines asBind
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Returns Boolean' to asLines[0]
            Move '    Move x to y'                                                                                 to asLines[1]
            Move 'External_Function ShellExecute "ShellExecuteW" Shell32.DLL Returns Handle'                        to asLines[2]
            Get _ExternalFnBindingsFromLines of ghoFuncLib asLines to asBind
            Send Assert (SizeOfArray(asBind) = 2)
            Send AssertSAreEqual "WINAPI_INTERNETQUERYOPTION|wininet.dll|internetqueryoptiona" asBind[0]
            Send AssertSAreEqual "SHELLEXECUTE|shell32.dll|shellexecutew" asBind[1]
        End_Procedure

        // The lookup is by NAME and returns the dll|entry tail; a miss returns empty, never a guess.
        {Published = True}
        Procedure GuardExternals_InstallBindingFor_Lookup
            String[] asBind
            String sFound
            Move "SHELLEXECUTE|shell32.dll|shellexecutew" to asBind[0]
            Move "GETTICKCOUNT|kernel32.dll|gettickcount" to asBind[1]
            Get _InstallBindingFor of ghoFuncLib "ShellExecute" asBind to sFound
            Send AssertSAreEqual "shell32.dll|shellexecutew" sFound
            Get _InstallBindingFor of ghoFuncLib "NotDeclaredAnywhere" asBind to sFound
            Send AssertSAreEqual "" sFound
        End_Procedure

        // The pure name harvest that feeds both the install catalogue walk and the per-file candidates.
        {Published = True}
        Procedure GuardExternals_NamesFromLines_Harvest
            String[] asLines asNames
            Move 'External_Function WinAPI_InternetQueryOption "InternetQueryOptionA" WinInet.Dll Returns Boolean' to asLines[0]
            Move '    Move x to y'                        to asLines[1]
            Move 'External_Function GetTickCount "GetTickCount" Kernel32.Dll Returns DWord' to asLines[2]
            Get _ExternalFnNamesFromLines of ghoFuncLib asLines to asNames
            Send Assert (SizeOfArray(asNames) = 2)
            Send AssertSAreEqual 'WinAPI_InternetQueryOption' asNames[0]
            Send AssertSAreEqual 'GetTickCount'               asNames[1]
        End_Procedure

        /* THE TARGET-DERIVED GUARD MUST EXCLUDE THE TARGET, which is the whole of the
           LegacyApp4 bug (2026-08-26). With no parameter the converter takes the version
           being COMPILED WITH - the release where DataFlex declares the API - so "<= 260" is true
           on the very build raising the 4390: the duplicate kept compiling and the guard reported
           success having cleared nothing. */
        {Published = True}
        Procedure GuardExternals_TargetDerivedExcludesTheTarget
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' to asCode[0]
            Move '    Pointer lppsd ;'                                           to asCode[1]
            Move '    Returns Integer'                                           to asCode[2]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 260 "26.0" True to iCount
            Send AssertIAreEqual 1 iCount
            // The guard writes explanatory comments above the directive, so find the #IF rather
            // than assume its index - the comment block has grown before and would again.
            Move "" to sFound
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                If (Left(Trim(asCode[i]), 3) = (Character(35) + "IF")) ;
                    Move (Trim(asCode[i])) to sFound
            Loop
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") sFound
        End_Procedure

        /* POSITIVE CONTROL for the pair: a version the USER named means "keep it for this release
           and older", so it stays inclusive - "< 191" would delete the declaration on the very
           19.1 build that has no native one. Same call, one flag apart. */
        {Published = True}
        Procedure GuardExternals_UserNamedVersionStaysInclusive
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' to asCode[0]
            Move '    Pointer lppsd ;'                                           to asCode[1]
            Move '    Returns Integer'                                           to asCode[2]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 191 "19.1" False to iCount
            Send AssertIAreEqual 1 iCount
            // The guard writes explanatory comments above the directive, so find the #IF rather
            // than assume its index - the comment block has grown before and would again.
            Move "" to sFound
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                If (Left(Trim(asCode[i]), 3) = (Character(35) + "IF")) ;
                    Move (Trim(asCode[i])) to sFound
            Loop
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ <= 191)") sFound
        End_Procedure

        /* A GUARD WE WROTE WRONG MUST BE REPAIRABLE. Before the comparison was fixed this wrote
           "<= 260" against a 26.0 target - true on the very build reporting the error - and the
           idempotence check then counted it as already-guarded, so no amount of re-running could
           ever clear it. Our own marker is what makes it ours to correct (LegacyApp4,
           2026-08-26). */
        {Published = True}
        Procedure GuardExternals_OurWrongGuardIsRepaired
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move "// [DFRefactor] 'PageSetupDlg' is declared by DataFlex itself now (duplicate External_Function, error 4390)." to asCode[0]
            Move "// Kept for DataFlex 26.0 and older; newer builds use DataFlex's own declaration."  to asCode[1]
            Move (Character(35) + "IF (" + Character(33) + "@ <= 260)")                              to asCode[2]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;'                     to asCode[3]
            Move '    Pointer lppsd ;'                                                               to asCode[4]
            Move '    Returns Integer'                                                               to asCode[5]
            Move (Character(35) + "ENDIF")                                                          to asCode[6]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 260 "26.0" True to iCount
            Send AssertIAreEqual 1 iCount   "the wrong directive counts as a change"
            Move "" to sFound
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                If (Left(Trim(asCode[i]), 3) = (Character(35) + "IF")) ;
                    Move (Trim(asCode[i])) to sFound
            Loop
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") sFound
            Send AssertIAreEqual 7 (SizeOfArray(asCode))  "repaired in place - no lines added"
        End_Procedure

        /* AND A HAND-WRITTEN GUARD IS NOT OURS TO TOUCH. Same shape, no [DFRefactor] marker: it is
           somebody's deliberate decision and stays exactly as written. Without this the repair
           would quietly rewrite guards it never authored. */
        {Published = True}
        Procedure GuardExternals_HandWrittenGuardIsLeftAlone
            String[] asCode asNames asBind
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move (Character(35) + "IF (" + Character(33) + "@ <= 260)")                          to asCode[0]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;'                 to asCode[1]
            Move '    Pointer lppsd ;'                                                           to asCode[2]
            Move '    Returns Integer'                                                           to asCode[3]
            Move (Character(35) + "ENDIF")                                                      to asCode[4]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 260 "26.0" True to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ <= 260)") asCode[0]
        End_Procedure

        /* NEVER GUARD WHAT THE FILE ITSELF CALLS - the 543-error lesson (LegacyApp4,
           2026-08-26). Prnt_dlg.pkg declared PageSetupDlg and called it a few hundred lines later;
           guarding the declaration out on the target left the call with nothing to bind to. The
           duplicate was real and the guard was written correctly; what nobody asked was whether
           the file could survive without the declaration. */
        {Published = True}
        Procedure GuardExternals_DeclarationThisFileCallsIsRefused
            String[] asCode asNames asBind asSkipped
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' to asCode[0]
            Move '    Pointer lppsd ;'                                           to asCode[1]
            Move '    Returns Integer'                                           to asCode[2]
            Move 'Function Cell Returns Integer'                                 to asCode[3]
            Move '    Move (PageSetupDlg(pPageSetupDlg)) To iResult'             to asCode[4]
            Move 'End_Function'                                                  to asCode[5]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 260 "26.0" True to iCount
            Send AssertIAreEqual 0 iCount   "refused - the file calls it"
            Send AssertSAreEqual 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' asCode[0]
            Send AssertIAreEqual 6 (SizeOfArray(asCode))  "nothing inserted"
            // ...and it says so, by name and line, rather than skipping silently.
            Get pasGuardSkippedCalled of ghoFuncLib to asSkipped
            Send AssertIAreEqual 1 (SizeOfArray(asSkipped))
            Send Assert (Pos("PageSetupDlg", asSkipped[0]) > 0)
            Send Assert (Pos("line 5", asSkipped[0]) > 0)
        End_Procedure

        /* POSITIVE CONTROL: the same declaration with no call in the file IS guarded. Without this
           a pass above could just mean the guard had stopped working. */
        {Published = True}
        Procedure GuardExternals_UncalledDeclarationStillGuarded
            String[] asCode asNames asBind
            String sFound
            Integer iCount i iLast

            Send ClearFuncLibProperties of ghoFuncLib
            Move "PageSetupDlg" to asNames[0]
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' to asCode[0]
            Move '    Pointer lppsd ;'                                           to asCode[1]
            Move '    Returns Integer'                                           to asCode[2]
            Move 'Function Cell Returns Integer'                                 to asCode[3]
            Move '    Move 0 To iResult'                                         to asCode[4]
            Move 'End_Function'                                                  to asCode[5]
            Get _GuardExternalsInLines of ghoFuncLib (&asCode) asNames asBind 260 "26.0" True to iCount
            Send AssertIAreEqual 1 iCount
            Move "" to sFound
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                If (Left(Trim(asCode[i]), 3) = (Character(35) + "IF")) ;
                    Move (Trim(asCode[i])) to sFound
            Loop
            Send AssertSAreEqual (Character(35) + "IF (" + Character(33) + "@ < 260)") sFound
        End_Procedure

        // The DECLARATION is not a call: its name is followed by a quoted entry point, never "(".
        // Without this the refusal would fire on every declaration and nothing would ever guard.
        {Published = True}
        Procedure GuardExternals_DeclarationItselfIsNotACall
            String[] asCode
            Integer iAt
            Move 'External_Function PageSetupDlg "PageSetupDlgA" COMDLG32.DLL ;' to asCode[0]
            Get _LineCallingFunction of ghoFuncLib asCode "PageSetupDlg" to iAt
            Send AssertIAreEqual 0 iAt
            Move '    Move (PageSetupDlg (pArg)) To iResult' to asCode[1]
            Get _LineCallingFunction of ghoFuncLib asCode "PageSetupDlg" to iAt
            Send AssertIAreEqual 2 iAt   "whitespace before the paren still reads as a call"
        End_Procedure

        /* THE STRUCT SPLIT - the hazard the other two refusals cannot see (2026-09-16).

           SHFileOperationA and SHFileOperationW both declare "Pointer lpFileOp". The arity lines
           up and neither arm mixes Pointer against marshalled text, so both existing checks pass
           and the pair was offered as an Auto-fix. The catalogue knows better: one takes
           SHFILEOPSTRUCTA, the other SHFILEOPSTRUCTW. The entry point can be swapped in one line;
           the structure the CALL SITE fills cannot, and the converter cannot see those sites.

           Measured over the catalogue: 367 of 2,069 A/W pairs differ this way. The test is that
           the refs DIFFER, not that the wide one ends in "W" - two pairs (tACMFORMATDETAILSW)
           differ without following the naming convention, and a lone W-named struct would be a
           false refusal. */
        {Published = True}
        Procedure AnsiWide_DifferentStructsPerArmIsRefused
            String sLocal sWide sCatA sCatW sWhy

            Move 'External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer' to sLocal
            Move 'External_Function SHFileOperationA "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer' to sWide
            Move 'DF|External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer // refs: SHFILEOPSTRUCTA' to sCatA
            Move 'DF|External_Function SHFileOperationW "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer // refs: SHFILEOPSTRUCTW' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send Assert (sWhy <> "") "an A/W pair taking different structures must be refused"
            Send Assert (Pos("SHFILEOPSTRUCTW", sWhy) > 0) "the reason must name the structure the wide arm takes"
            Send Assert (Pos("SHFILEOPSTRUCTA", sWhy) > 0) "and the one the local declaration takes"

            // POSITIVE CONTROL: the SAME declarations with matching refs must still pair, or the
            // check has refused the 1,702 pairs that are fine along with the 367 that are not.
            Move 'DF|External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer // refs: POINT' to sCatA
            Move 'DF|External_Function SHFileOperationW "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer // refs: POINT' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy

            /* SILENCE IS NOT EVIDENCE. A row with no "// refs:" tail says nothing about the
               structures it takes - most rows have none - so a missing tail on EITHER side must
               not refuse. This is the difference between declining 367 pairs and declining 2,069. */
            Move 'DF|External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer' to sCatA
            Move 'DF|External_Function SHFileOperationW "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer // refs: SHFILEOPSTRUCTW' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy
            Move 'DF|External_Function SHFileOperationW "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy
        End_Procedure

        /* The refs reader, and the two members of the pair that an API can carry. */
        {Published = True}
        Procedure AnsiWide_RefsTailIsReadWholeNotJustTheFirstName
            String sRow sRefs

            Move 'DF|External_Function BuildSecurityDescriptorA "BuildSecurityDescriptorA" ADVAPI32.dll Pointer pOwner Returns Integer // refs: TRUSTEE_A EXPLICIT_ACCESS_A' to sRow
            Get _WinAPIRefsOf of ghoFuncLib sRow to sRefs
            // WHOLE list: an API taking two structures is unsafe if EITHER differs, so a reader
            // that stopped at the first name (WinAPIStructForApi does) would miss half the cases.
            Send AssertSAreEqual "TRUSTEE_A EXPLICIT_ACCESS_A" sRefs
            Move 'DF|External_Function GetTickCount "GetTickCount" KERNEL32.dll Returns UInteger' to sRow
            Get _WinAPIRefsOf of ghoFuncLib sRow to sRefs
            Send AssertSAreEqual "" sRefs
        End_Procedure

        /* RAW MEMORY THAT IS NOT THE SAME MEMORY (2026-11-21) - the pair DS 9221 made on 2026-09-11.
           GetComputerNameA and GetComputerNameW both declare "Pointer lpBuffer Pointer nSize": same
           arity, no marshalled text to mix with, no structure, so all three older checks pass. The
           buffer is PSTR on one arm and PWSTR on the other, and only the "// ptrs:" tails say so. */
        {Published = True}
        Procedure AnsiWide_RawTextBufferPerArmIsRefused
            String sLocal sWide sCatA sCatW sWhy

            Move 'External_Function GetComputerName "GetComputerNameA" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer' to sLocal
            Move 'External_Function GetComputerName "GetComputerNameW" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer' to sWide
            Move 'DF|External_Function GetComputerNameA "GetComputerNameA" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer // ptrs: 1=PSTR 2=UInteger*' to sCatA
            Move 'DF|External_Function GetComputerNameW "GetComputerNameW" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer // ptrs: 1=PWSTR 2=UInteger*' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send Assert (sWhy <> "") "a text buffer that is PSTR on one arm and PWSTR on the other must be refused"
            Send Assert (Pos("argument 1", sWhy) > 0) "the reason must name the argument"
            Send Assert (Pos("reads as PWSTR", sWhy) > 0 and Pos("reads PSTR", sWhy) > 0) "and both C types, each with its arm"

            // POSITIVE CONTROL: the same rows with the same C type on both arms still pair - only a
            // DIFFERENCE refuses, or the 1,133 pairs that are fine would go with the 936.
            Move 'DF|External_Function GetComputerNameW "GetComputerNameW" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer // ptrs: 1=PSTR 2=UInteger*' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy

            // SILENCE IS NOT EVIDENCE: a row without the tail (a catalogue harvested before it existed)
            // says nothing, on either side.
            Move 'DF|External_Function GetComputerNameW "GetComputerNameW" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy
            Move 'DF|External_Function GetComputerNameA "GetComputerNameA" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer' to sCatA
            Move 'DF|External_Function GetComputerNameW "GetComputerNameW" KERNEL32.dll Pointer lpBuffer Pointer nSize Returns Integer // ptrs: 1=PWSTR 2=UInteger*' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy
        End_Procedure

        /* The AddressOf convention in 32-bit dress: an Integer argument where the wide twin marshals text.
           _ApiPtrVsMarshalMix only knows Pointer-class types, so "Integer lpFile" got through, and the wide
           arm would have handed the address to WString marshalling as if it were the text. */
        {Published = True}
        Procedure AnsiWide_IntegerAddressWhereTwinMarshalsTextIsRefused
            String sLocal sWide sCatA sCatW sWhy

            Move 'External_Function ShellExec "ShellExecuteA" SHELL32.dll Handle hwnd Integer lpOperation Integer lpFile Integer lpParameters Integer lpDirectory Integer nShowCmd Returns Handle' to sLocal
            Move 'External_Function ShellExec "ShellExecuteW" SHELL32.dll Handle hwnd WString lpOperation WString lpFile WString lpParameters WString lpDirectory Integer nShowCmd Returns Handle' to sWide
            Move 'DF|External_Function ShellExecuteA "ShellExecuteA" SHELL32.dll Handle hwnd String lpOperation String lpFile String lpParameters String lpDirectory Integer nShowCmd Returns Handle' to sCatA
            Move 'DF|External_Function ShellExecuteW "ShellExecuteW" SHELL32.dll Handle hwnd WString lpOperation WString lpFile WString lpParameters WString lpDirectory Integer nShowCmd Returns Handle' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send Assert (Pos("argument 2", sWhy) > 0) "the first Integer-for-text argument must be named"

            // POSITIVE CONTROL: String locals are marshalled on both arms and pair as before; the Integer
            // nShowCmd against the twin's Integer is a number on both sides and must not refuse.
            Move 'External_Function ShellExec "ShellExecuteA" SHELL32.dll Handle hwnd String lpOperation String lpFile String lpParameters String lpDirectory Integer nShowCmd Returns Handle' to sLocal
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send AssertSAreEqual "" sWhy
        End_Procedure

        /* The struct split keeps its own, more specific reason when a row carries both tails: SHFileOperation's
           structure pointer differs in "// refs:" AND in "// ptrs:", and the user should read about the
           structure, not about "argument 1". */
        {Published = True}
        Procedure AnsiWide_StructSplitReasonWinsOverTheRawMemoryOne
            String sLocal sWide sCatA sCatW sWhy

            Move 'External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer' to sLocal
            Move 'External_Function SHFileOperationA "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer' to sWide
            Move 'DF|External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Returns Integer // ptrs: 1=SHFILEOPSTRUCTA* // refs: SHFILEOPSTRUCTA // args: 1=SHFILEOPSTRUCTA' to sCatA
            Move 'DF|External_Function SHFileOperationW "SHFileOperationW" SHELL32.dll Pointer lpFileOp Returns Integer // ptrs: 1=SHFILEOPSTRUCTW* // refs: SHFILEOPSTRUCTW // args: 1=SHFILEOPSTRUCTW' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send Assert (Pos("structure its call sites fill", sWhy) > 0) "the struct split must be the reason given"
            Send Assert (Pos("argument 1", sWhy) = 0) "not the raw-memory one"
        End_Procedure

        /* The three tail readers each stop at the next tail. The args reader used to read to the end of
           the row, so a "1=PSTR" written after it would have answered "which struct does argument 1
           take?" with a C type. And the refs tail no longer comes first on an A/W row. */
        {Published = True}
        Procedure AnsiWide_TailReadersStopAtTheNextTail
            String sRow sOut

            Move 'DF|External_Function SHFileOperationA "SHFileOperationA" SHELL32.dll Pointer lpFileOp Pointer lpOther Returns Integer // ptrs: 1=SHFILEOPSTRUCTA* 2=PSTR // refs: SHFILEOPSTRUCTA // args: 1=SHFILEOPSTRUCTA' to sRow
            Get _WinAPIRefsOf of ghoFuncLib sRow to sOut
            Send AssertSAreEqual "SHFILEOPSTRUCTA" sOut
            Get _WinAPIArgStructOf of ghoFuncLib sRow 1 to sOut
            Send AssertSAreEqual "SHFILEOPSTRUCTA" sOut
            Get _WinAPIArgStructOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "" sOut
            Get _WinAPIPtrCTypeOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "PSTR" sOut
            Get _WinAPIPtrCTypeOf of ghoFuncLib sRow 3 to sOut
            Send AssertSAreEqual "" sOut

            // A tail in the other order - args first, then another - must not leak into args either.
            Move 'DF|External_Function X "XA" A.dll Pointer p Pointer q Returns Integer // args: 1=POINT // ptrs: 2=PSTR' to sRow
            Get _WinAPIArgStructOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "" sOut
            Get _WinAPIPtrCTypeOf of ghoFuncLib sRow 2 to sOut
            Send AssertSAreEqual "PSTR" sOut
        End_Procedure

        /* ORDER MATTERS: a declaration that fails an EARLIER check must report THAT reason, not
           the struct split. The arity mismatch is the more fundamental fact - the two arms cannot
           even be given the same arguments - and the run note the user reads should say so. */
        {Published = True}
        Procedure AnsiWide_EarlierRefusalsStillWinOverTheStructSplit
            String sLocal sWide sCatA sCatW sWhy

            Move 'External_Function efShellExecute "ShellExecuteA" shell32.dll Handle hWnd Returns Handle' to sLocal
            Move 'External_Function efShellExecute "ShellExecuteW" shell32.dll Handle hWnd String lpOperation Returns Handle' to sWide
            Move 'DF|External_Function ShellExecuteA "ShellExecuteA" shell32.dll Handle hWnd Returns Handle // refs: SHELLEXECUTEINFOA' to sCatA
            Move 'DF|External_Function ShellExecuteW "ShellExecuteW" shell32.dll Handle hWnd String lpOperation Returns Handle // refs: SHELLEXECUTEINFOW' to sCatW
            Get _AnsiWideRefusalReason of ghoFuncLib sLocal sWide sCatA sCatW to sWhy
            Send Assert (Pos("parameter list", sWhy) > 0) "the arity mismatch must be the reason given"
            Send Assert (Pos("SHELLEXECUTEINFOW", sWhy) = 0) "the struct split must not overwrite it"
        End_Procedure

        /* THE DF ROW FLAVOUR (2026-08-28) - rows harvested from the Win32_DataFlex_Projection
           (Frank Cheng, MIT; generated from Microsoft's win32metadata) carry a READY-MADE DataFlex
           declaration behind a "DF|" marker, so nothing is C-parsed and the STDAPI_ gap cannot
           apply. The trailing "// refs:" comment is for the struct-linkage scan and must be CUT
           from what the type extractor sees. */
        {Published = True}
        Procedure WinAPIDF_ReadyMadeDeclarationIsServedClean
            String[] asSaved asRows asTypes
            String sDecl sRet
            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Move 'kernel32.dll|deletefilew|DF|External_Function DeleteFileW "DeleteFileW" KERNEL32.dll WString lpFileName Returns Integer // refs: WIN32_FIND_DATAW' to asRows[0]
            Set pasWinAPICatalog of ghoFuncLib to asRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "DeleteFileW" to sDecl
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Send Assert (Pos('External_Function DeleteFileW', sDecl) = 1)
            Send Assert (Pos("//", sDecl) = 0)
            // ...and the extractor reads real types from it, not comment words.
            Get _ExternalFnParamTypes of ghoFuncLib sDecl (&asTypes) to sRet
            Send AssertIAreEqual 1 (SizeOfArray(asTypes))
            Send AssertSAreEqual "WString" asTypes[0]
            Send AssertSAreEqual "Integer" sRet
        End_Procedure

        // The refs tail is exactly FOR WinAPIStructForApi: the struct a call takes rides the row
        // as a comment, and the scan must still find it there.
        {Published = True}
        Procedure WinAPIDF_RefsTailLinksTheStruct
            String[] asSaved asRows asSSaved asSRows
            String sName
            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Get pasWinAPIStructCatalog of ghoFuncLib to asSSaved
            Move 'kernel32.dll|findfirstfilew|DF|External_Function FindFirstFileW "FindFirstFileW" KERNEL32.dll WString lpFileName Pointer lpFindFileData Returns Pointer // refs: WIN32_FIND_DATAW' to asRows[0]
            Move ('WIN32_FIND_DATAW|DF|Struct WIN32_FIND_DATAW' + (Character(10)) + 'UInteger dwFileAttributes' + (Character(10)) + 'End_Struct') to asSRows[0]
            Set pasWinAPICatalog of ghoFuncLib to asRows
            Set pasWinAPIStructCatalog of ghoFuncLib to asSRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIStructForApi of ghoFuncLib "kernel32.dll" "FindFirstFileW" to sName
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Set pasWinAPIStructCatalog of ghoFuncLib to asSSaved
            Send AssertSAreEqual "WIN32_FIND_DATAW" sName
        End_Procedure

        /* A DF STRUCT ROW THAT CANNOT BE PROVEN IS EMITTED AS IT IS - its alignment members included.
           This one's tail filler is more than its members need, so laying them out does not reproduce
           it (see WinAPIDF_ProvenRowGetsGapsForBothTargets for one that does). The t-prefix naming rule
           still applies (the C path's convention), and the provenance line says what the layout is:
           64-bit, by the projection's stated policy. */
        {Published = True}
        Procedure WinAPIDF_StructRowEmitsVerbatimWithTPrefix
            String[] asSSaved asSRows asMembers asNotes
            String sOut
            Get pasWinAPIStructCatalog of ghoFuncLib to asSSaved
            Move ('WIN32_FIND_DATAW|DF|Struct WIN32_FIND_DATAW' + (Character(10)) + (Character(9)) + 'UInteger dwFileAttributes' + (Character(10)) + (Character(9)) + 'UShort[260] cFileName' + (Character(10)) + (Character(9)) + 'Integer iMissingAlignment1' + (Character(10)) + 'End_Struct') to asSRows[0]
            Set pasWinAPIStructCatalog of ghoFuncLib to asSRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIStructDataFlexDecl of ghoFuncLib "WIN32_FIND_DATAW" (&asNotes) to sOut
            // member names still read through the DF marker - the converter's gate depends on it
            Get _StructMemberNames of ghoFuncLib ('DF|Struct X' + (Character(10)) + 'UInteger dwFileAttributes' + (Character(10)) + 'End_Struct') to asMembers
            Set pasWinAPIStructCatalog of ghoFuncLib to asSSaved
            Send Assert (Pos("Struct tWIN32_FIND_DATAW", sOut) = 1)
            Send Assert (Pos("64-bit layout", sOut) > 0)
            Send Assert (Pos("UShort[260] cFileName", sOut) > 0)
            Send Assert (Pos("iMissingAlignment1", sOut) > 0)
            Send AssertIAreEqual 1 (SizeOfArray(asMembers))
            Send AssertSAreEqual "dwFileAttributes" asMembers[0]
        End_Procedure

        // POSITIVE CONTROL: a legacy C-prototype row still takes the conversion path - the two
        // flavours coexist row by row, and the DF branch must not have captured everything.
        {Published = True}
        Procedure WinAPIDF_LegacyCRowStillConverts
            String[] asSaved asRows
            String sDecl
            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Move 'kernel32.dll|deletefilea|BOOL WINAPI DeleteFileA(LPCSTR lpFileName);' to asRows[0]
            Set pasWinAPICatalog of ghoFuncLib to asRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            Get WinAPIDataFlexDecl of ghoFuncLib "kernel32.dll" "DeleteFileA" to sDecl
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Send Assert (Pos('External_Function DeleteFileA', sDecl) > 0)
            Send Assert (Pos("Returns Integer", sDecl) > 0)
        End_Procedure

        /* THE BINARY SEARCH, edge-pinned (2026-08-28). A search that misses silently looks like
           "API not catalogued" - a refusal, not an error - so first row, last row, middles, a bare
           entry point with and without a row, and a genuine miss all get pinned against a multi-row
           fixture. Rows are deliberately given UNSORTED and sorted by the test the same way the load
           point sorts, so the invariant the search rests on is the one being exercised. */
        {Published = True}
        Procedure WinAPICatalog_BinarySearchEdges
            String[] asSaved asRows
            String sProto
            Get pasWinAPICatalog of ghoFuncLib to asSaved
            Move 'user32.dll|movewindow|DF|External_Function MoveWindow "MoveWindow" USER32.dll Handle hWnd Returns Integer' to asRows[0]
            Move 'advapi32.dll|regclosekey|DF|External_Function RegCloseKey "RegCloseKey" ADVAPI32.dll Handle hKey Returns Integer' to asRows[1]
            Move 'kernel32.dll|deletefilea|DF|External_Function DeleteFileA "DeleteFileA" KERNEL32.dll String lpFileName Returns Integer' to asRows[2]
            Move 'kernel32.dll|closehandle|DF|External_Function CloseHandle "CloseHandle" KERNEL32.dll Handle hObject Returns Integer' to asRows[3]
            // A MEASURED bare-alias row: kernel32 really does export lstrcpy at lstrcpyA's address.
            Move 'kernel32.dll|lstrcpy|DF|External_Function lstrcpyA "lstrcpyA" KERNEL32.dll Pointer lpString1 String lpString2 Returns Pointer' to asRows[4]
            Move (SortArray(asRows, Desktop, RefFunc(DFSTRICMP))) to asRows
            Set pasWinAPICatalog of ghoFuncLib to asRows
            Set pbWinAPICatalogsLoaded of ghoFuncLib to True
            // first, last, middle of the sorted order
            Get WinAPIPrototype of ghoFuncLib "advapi32.dll" "RegCloseKey" to sProto
            Send Assert (Pos("RegCloseKey", sProto) > 0)
            Get WinAPIPrototype of ghoFuncLib "user32.dll" "MoveWindow" to sProto
            Send Assert (Pos("MoveWindow", sProto) > 0)
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "CloseHandle" to sProto
            Send Assert (Pos("CloseHandle", sProto) > 0)
            // A BARE ENTRY POINT IS ANSWERED BY ITS ROW, and only by its row (2026-09-12).
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "lstrcpy" to sProto
            Send Assert (Pos("lstrcpyA", sProto) > 0)
            /* ...and one with no row answers "". This used to append "a" and hand back DeleteFileA,
               which was a guess in both directions: kernel32 exports no bare DeleteFile at all, so
               that declaration cannot bind (Error 4355 at the first call), and where a bare export
               does exist it is not always the A entry - kernel32's bare ReplaceFile is ReplaceFileW.
               The catalogue carries the measured rows now; the search no longer invents one. */
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "DeleteFile" to sProto
            Send AssertSAreEqual "" sProto
            // and a genuine miss is a clean ""
            Get WinAPIPrototype of ghoFuncLib "kernel32.dll" "NoSuchEntry" to sProto
            Set pasWinAPICatalog of ghoFuncLib to asSaved
            Send AssertSAreEqual "" sProto
        End_Procedure

    End_Object
