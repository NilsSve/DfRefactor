//****************************************************************************
// $Module type: Test fixture
// $Module name: oDeclareRefactoredIndicators-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-30
//
// Description : Unit tests for DeclareRefactoredIndicators - the eOtherFunction companion that declares (as
//               #IFNDEF-guarded Global_Variable Boolean, spliced at the file top) the legacy NAMED indicators that
//               ChangeLegacyIndicators / ChangeSquareBracketsIndicators rewrite to boolean-variable syntax but that
//               have no 'Indicator X' declaration of their own. It reads the PRE-conversion original from the engine
//               (pasOriginalSource), so each test seeds that handle and hands in the already-converted asCode.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oDeclareRefactoredIndicators is a cTestFixture
        Set psFunctionName to "DeclareRefactoredIndicators"

        {Published = True}
        // An undeclared named indicator that the converters rewrite gets a guarded Global_Variable Boolean,
        // spliced after the Use block (before the first code line).
        Procedure DeclareRefactoredIndicators_UndeclaredGetsDeclared
            Integer iResult iPos
            String[] asOrig asCode

            // ORIGINAL (pre-conversion): an undeclared indicator used both ways.
            Move "Use Windows.pkg"                  to asOrig[0]
            Move "Procedure DoIt"                   to asOrig[1]
            Move "    Indicate gibDebugMode True"   to asOrig[2]
            Move "    If [gibDebugMode] Begin"      to asOrig[3]
            Move "    End"                          to asOrig[4]
            Move "End_Procedure"                    to asOrig[5]
            // CONVERTED (what the engine hands DeclareRefactoredIndicators): now bare-variable syntax.
            Move "Use Windows.pkg"                  to asCode[0]
            Move "Procedure DoIt"                   to asCode[1]
            Move "    Move (True) to gibDebugMode"  to asCode[2]
            Move "    If (gibDebugMode) Begin"      to asCode[3]
            Move "    End"                          to asCode[4]
            Move "End_Procedure"                    to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Move (SearchArray("#IFNDEF gibDebugMode", asCode)) to iPos
            Send Assert (iPos >= 0)
            Send AssertSAreEqual "    Global_Variable Boolean gibDebugMode" asCode[iPos + 1]
            Send AssertSAreEqual "#ENDIF" asCode[iPos + 2]
            // after the Use line, before the first code line:
            Send Assert (iPos > (SearchArray("Use Windows.pkg", asCode)))
            Send Assert (iPos < (SearchArray("Procedure DoIt", asCode)))
        End_Procedure

        {Published = True}
        // A name that DOES have an 'Indicator X' declaration is ChangeIndicatorToBoolean's job - not re-declared.
        Procedure DeclareRefactoredIndicators_DeclaredNameSkipped
            Integer iResult
            String[] asOrig asCode

            Move "Indicator gibDebugMode"        to asOrig[0]
            Move "Procedure DoIt"                to asOrig[1]
            Move "    If [gibDebugMode] Begin"   to asOrig[2]
            Move "    End"                       to asOrig[3]
            Move "End_Procedure"                 to asOrig[4]
            Move "#IFNDEF gibDebugMode"                     to asCode[0]
            Move "    Global_Variable Boolean gibDebugMode" to asCode[1]
            Move "#ENDIF"                                   to asCode[2]
            Move "Procedure DoIt"                to asCode[3]
            Move "    If (gibDebugMode) Begin"   to asCode[4]
            Move "    End"                       to asCode[5]
            Move "End_Procedure"                 to asCode[6]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
        End_Procedure

        {Published = True}
        // Built-in indicators (Found / FindErr / Err) are never user variables - never declared.
        Procedure DeclareRefactoredIndicators_BuiltInsSkipped
            Integer iResult
            String[] asOrig asCode

            Move "Procedure DoIt"               to asOrig[0]
            Move "    Find Gt Customer by 1"    to asOrig[1]
            Move "    If [Found] Begin"         to asOrig[2]
            Move "        Indicate Err False"   to asOrig[3]
            Move "    End"                      to asOrig[4]
            Move "End_Procedure"                to asOrig[5]
            Move "Procedure DoIt"               to asCode[0]
            Move "    Find Gt Customer by 1"    to asCode[1]
            Move "    If (Found) Begin"         to asCode[2]
            Move "        Move (False) to Err"  to asCode[3]
            Move "    End"                      to asCode[4]
            Move "End_Procedure"                to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
        End_Procedure

        {Published = True}
        // SELECT is a #Replace FMAC macro owned by DefineSelectMacro - DeclareRefactoredIndicators leaves it alone.
        Procedure DeclareRefactoredIndicators_SelectSkipped
            Integer iResult
            String[] asOrig asCode
            Move "Procedure DoIt"               to asOrig[0]
            Move "    [Select] Move 1 to iX"    to asOrig[1]
            Move "End_Procedure"                to asOrig[2]
            Move "Procedure DoIt"               to asCode[0]
            Move "    If (Select) Move 1 to iX" to asCode[1]
            Move "End_Procedure"                to asCode[2]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
        End_Procedure

        {Published = True}
        // An indicator used ONLY in [brackets] (never set via Indicate) is still declared; repeated use -> one block.
        Procedure DeclareRefactoredIndicators_BracketOnlyAndDeduped
            Integer iResult iFirst
            String[] asOrig asCode

            Move "Procedure DoIt"            to asOrig[0]
            Move "    If [INDLOCK] Begin"    to asOrig[1]
            Move "    End"                   to asOrig[2]
            Move "    If [INDLOCK] Begin"    to asOrig[3]
            Move "    End"                   to asOrig[4]
            Move "End_Procedure"             to asOrig[5]
            Move "Procedure DoIt"            to asCode[0]
            Move "    If (gbINDLOCK) Begin"    to asCode[1]
            Move "    End"                   to asCode[2]
            Move "    If (gbINDLOCK) Begin"    to asCode[3]
            Move "    End"                   to asCode[4]
            Move "End_Procedure"             to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult   // one block despite two uses
            Move (SearchArray("#IFNDEF gbINDLOCK", asCode)) to iFirst
            Send Assert (iFirst >= 0)
        End_Procedure

        {Published = True}
        // With no stashed original (e.g. the converters weren't part of this run), the function makes no change.
        Procedure DeclareRefactoredIndicators_NoOriginalNoChange
            Integer iResult iSizeBefore
            String[] asOrig asCode
            Move "Procedure DoIt"  to asCode[0]
            Move "End_Procedure"   to asCode[1]
            Move (SizeOfArray(asCode)) to iSizeBefore
            Set pasOriginalSource of ghoEngine to asOrig   // empty
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult
            Send AssertIAreEqual iSizeBefore (SizeOfArray(asCode))
        End_Procedure

        {Published = True}
        // Array / property indexing (arr[i], a[i][j]) is NOT an indicator - only the standalone [X] is declared.
        Procedure DeclareRefactoredIndicators_ArrayIndexNotDeclared
            Integer iResult
            String[] asOrig asCode

            Move "Procedure DoIt"                      to asOrig[0]
            Move "    Move asGrid[iRow][iCol] to xVal" to asOrig[1]
            Move "    If [gibDebugMode] Begin"         to asOrig[2]
            Move "    End"                             to asOrig[3]
            Move "End_Procedure"                       to asOrig[4]
            Move "Procedure DoIt"                      to asCode[0]
            Move "    Move asGrid[iRow][iCol] to xVal" to asCode[1]
            Move "    If (gibDebugMode) Begin"         to asCode[2]
            Move "    End"                             to asCode[3]
            Move "End_Procedure"                       to asCode[4]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult   // only gibDebugMode, NOT iRow / iCol / asGrid / xVal
            Send Assert ((SearchArray("#IFNDEF gibDebugMode", asCode)) >= 0)
            Send Assert ((SearchArray("#IFNDEF iRow", asCode)) = -1)
            Send Assert ((SearchArray("#IFNDEF iCol", asCode)) = -1)
        End_Procedure

        {Published = True}
        // A digit-leading bracket group is an ITEM INDEX (old dfentry syntax) or a NUMBERED indicator -
        // never a NAMED indicator, so no 'Global_Variable Boolean 0' shim may be spliced (the LegacyApp
        // break, 2026-07-05: 'Set Form_Datatype [0] to Mask_Window' produced an uncompilable
        // '#IFNDEF 0' block). Same for a numbered 'Indicate 5'. The named use alongside them is
        // still declared.
        Procedure DeclareRefactoredIndicators_NumericBracketNotDeclared
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                          to asOrig[0]
            Move "Procedure DoIt"                           to asOrig[1]
            Move "    Set Form_Datatype [0] to Mask_Window" to asOrig[2]
            Move "    Indicate 5 True"                      to asOrig[3]
            Move "    If [gibDebugMode] Begin"              to asOrig[4]
            Move "    End"                                  to asOrig[5]
            Move "End_Procedure"                            to asOrig[6]
            Move "Use Windows.pkg"                          to asCode[0]
            Move "Procedure DoIt"                           to asCode[1]
            Move "    Set Form_Datatype [0] to Mask_Window" to asCode[2]
            Move "    Indicate 5 True"                      to asCode[3]
            Move "    If (gibDebugMode) Begin"              to asCode[4]
            Move "    End"                                  to asCode[5]
            Move "End_Procedure"                            to asCode[6]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult   // only gibDebugMode is declared
            Send Assert ((SearchArray("#IFNDEF gibDebugMode", asCode)) >= 0)
            Send Assert ((SearchArray("#IFNDEF 0", asCode)) = -1)
            Send Assert ((SearchArray("#IFNDEF 5", asCode)) = -1)
        End_Procedure

        // Regression (LegacyApp 2026-07-05): legacy SPACED array indexing - 'Move asNames [iCount ]
        // to sTerm' - is INDEXING, not an indicator use, even though the bracket body is an
        // identifier. The collector shimmed the INDEX VARIABLE as 'Global_Variable Boolean iCount',
        // which collides with every local named iCount. The named indicator alongside it is still
        // declared.
        {Published = True}
        Procedure DeclareRefactoredIndicators_SpacedArrayIndexNotDeclared
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                              to asOrig[0]
            Move "Procedure DoIt"                               to asOrig[1]
            Move "    Move asNames [iCount ] to sTerm"          to asOrig[2]
            Move "    If [gibDebugMode] Begin"                  to asOrig[3]
            Move "    End"                                      to asOrig[4]
            Move "End_Procedure"                                to asOrig[5]
            Move "Use Windows.pkg"                              to asCode[0]
            Move "Procedure DoIt"                               to asCode[1]
            Move "    Move asNames [iCount ] to sTerm"          to asCode[2]
            Move "    If (gibDebugMode) Begin"                  to asCode[3]
            Move "    End"                                      to asCode[4]
            Move "End_Procedure"                                to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult   // only gibDebugMode is declared
            Send Assert ((SearchArray("#IFNDEF gibDebugMode", asCode)) >= 0)
            Send Assert ((SearchArray("#IFNDEF iCount", asCode)) = -1)
        End_Procedure

        // Regression (found in the wild 2026-07-05): a bare expression READ of a converted indicator
        // ('If (not(Login_Successful)) Begin') is already-legal Boolean syntax that no converter
        // rewrites - after the gb rename of the declaration and write sites it referenced a name that
        // no longer existed. PASS 2b renames such reads to the gb-prefixed declared name; the already-
        // converted write site (gbLogin_Successful) is not double-prefixed.
        {Published = True}
        Procedure DeclareRefactoredIndicators_BareExpressionReadRenamed
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                                to asOrig[0]
            Move "Procedure DoLogin"                              to asOrig[1]
            Move "    Indicate Login_Successful as (iStatus = 1)" to asOrig[2]
            Move "    If (not(Login_Successful)) Begin"           to asOrig[3]
            Move "    End"                                        to asOrig[4]
            Move "End_Procedure"                                  to asOrig[5]
            Move "Use Windows.pkg"                                to asCode[0]
            Move "Procedure DoLogin"                              to asCode[1]
            Move "    Move (iStatus = 1) to gbLogin_Successful"   to asCode[2]
            Move "    If (not(Login_Successful)) Begin"           to asCode[3]
            Move "    End"                                        to asCode[4]
            Move "End_Procedure"                                  to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send Assert ((SearchArray("#IFNDEF gbLogin_Successful", asCode)) >= 0)
            Send Assert ((SearchArray("    If (not(gbLogin_Successful)) Begin", asCode)) >= 0)
            Send Assert ((SearchArray("    If (not(Login_Successful)) Begin", asCode)) = -1)
            // the converted write site is untouched (no gbgb double prefix):
            Send Assert ((SearchArray("    Move (iStatus = 1) to gbLogin_Successful", asCode)) >= 0)
        End_Procedure

        // The read-rename is MASKED: the name inside a string literal is content, not a reference.
        {Published = True}
        Procedure DeclareRefactoredIndicators_ReadInStringLiteralUntouched
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                              to asOrig[0]
            Move "Procedure DoIt"                               to asOrig[1]
            Move "    [Login_Successful] Move 1 to iX"          to asOrig[2]
            Move "End_Procedure"                                to asOrig[3]
            Move "Use Windows.pkg"                              to asCode[0]
            Move "Procedure DoIt"                               to asCode[1]
            Move '    Move "Login_Successful failed" to sMsg'   to asCode[2]
            Move "    If (Login_Successful) Begin"              to asCode[3]
            Move "    End"                                      to asCode[4]
            Move "End_Procedure"                                to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send Assert ((SearchArray('    Move "Login_Successful failed" to sMsg', asCode)) >= 0)
            Send Assert ((SearchArray("    If (gbLogin_Successful) Begin", asCode)) >= 0)
        End_Procedure

        // A method that declares a LOCAL of the same name (or takes it as a parameter) keeps its bare
        // reads: the local legitimately shadows there, exactly as it shadowed the pre-gb global.
        // Reads OUTSIDE that method are still renamed.
        {Published = True}
        Procedure DeclareRefactoredIndicators_LocalShadowNotRenamed
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                              to asOrig[0]
            Move "Procedure SetIt"                              to asOrig[1]
            Move "    Indicate Login_Successful as (iX = 1)"    to asOrig[2]
            Move "End_Procedure"                                to asOrig[3]
            Move "Use Windows.pkg"                              to asCode[0]
            Move "Procedure SetIt"                              to asCode[1]
            Move "    Move (iX = 1) to gbLogin_Successful"      to asCode[2]
            Move "End_Procedure"                                to asCode[3]
            Move "Function CheckIt Returns Boolean"             to asCode[4]
            Move "    Boolean Login_Successful"                 to asCode[5]
            Move "    Move (iY = 1) to Login_Successful"        to asCode[6]
            Move "    Function_Return Login_Successful"         to asCode[7]
            Move "End_Function"                                 to asCode[8]
            Move "Procedure UseIt"                              to asCode[9]
            Move "    If (Login_Successful) Begin"              to asCode[10]
            Move "    End"                                      to asCode[11]
            Move "End_Procedure"                                to asCode[12]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            // shadowed method: local declaration and both reads untouched
            Send Assert ((SearchArray("    Boolean Login_Successful", asCode)) >= 0)
            Send Assert ((SearchArray("    Move (iY = 1) to Login_Successful", asCode)) >= 0)
            Send Assert ((SearchArray("    Function_Return Login_Successful", asCode)) >= 0)
            // outside it: renamed
            Send Assert ((SearchArray("    If (gbLogin_Successful) Begin", asCode)) >= 0)
            Send Assert ((SearchArray("    If (Login_Successful) Begin", asCode)) = -1)
        End_Procedure

        // A '.'-qualified hit is a File.Field / struct-member reference, never the indicator global.
        {Published = True}
        Procedure DeclareRefactoredIndicators_DottedFieldUntouched
            Integer iResult
            String[] asOrig asCode

            Move "Use Windows.pkg"                              to asOrig[0]
            Move "Procedure DoIt"                               to asOrig[1]
            Move "    [Login_Successful] Move 1 to iX"          to asOrig[2]
            Move "End_Procedure"                                to asOrig[3]
            Move "Use Windows.pkg"                              to asCode[0]
            Move "Procedure DoIt"                               to asCode[1]
            Move "    Move Users.Login_Successful to bVal"      to asCode[2]
            Move "    If (Login_Successful) Begin"              to asCode[3]
            Move "    End"                                      to asCode[4]
            Move "End_Procedure"                                to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            Send Assert ((SearchArray("    Move Users.Login_Successful to bVal", asCode)) >= 0)
            Send Assert ((SearchArray("    If (gbLogin_Successful) Begin", asCode)) >= 0)
        End_Procedure

        // --- _UndeclaredNamedIndicatorsIn: the shared scan behind BOTH this refactor and the Auto-Select
        //     companion gate (cModAnalyzer + _ScopeHasUndeclaredNamedIndicator). An EMPTY result
        //     means the DeclareRefactoredIndicators companion is NOT needed, so the plan must not tick it.

        // The exact source that surfaced the false auto-selection (Nils 2026-07-06): the only indicators are
        // the built-in Err / Found, which carry their own declarations - nothing to shim, so no companion.
        {Published = True}
        Procedure UndeclaredNamedIndicators_BuiltInsOnly_None
            String[] asSource asNames
            Move "        Indicate Err False"                                                     to asSource[0]
            Move "        If (Found=True) indicate Found as (Tidpass.TidkortID = iTidkortID)"     to asSource[1]
            Send ClearFuncLibProperties of ghoFuncLib
            Get _UndeclaredNamedIndicatorsIn of ghoFuncLib (&asSource) to asNames
            Send AssertIAreEqual 0 (SizeOfArray(asNames))
        End_Procedure

        // A real, undeclared custom named indicator alongside a built-in IS surfaced (only the custom one).
        {Published = True}
        Procedure UndeclaredNamedIndicators_CustomName_Found
            String[] asSource asNames
            Move "    Indicate Err False"        to asSource[0]
            Move "    If [gibDebugMode] Begin"   to asSource[1]
            Move "    End"                       to asSource[2]
            Send ClearFuncLibProperties of ghoFuncLib
            Get _UndeclaredNamedIndicatorsIn of ghoFuncLib (&asSource) to asNames
            Send AssertIAreEqual 1 (SizeOfArray(asNames))
            Send AssertSAreEqual "gibDebugMode" asNames[0]
        End_Procedure

        // A name WITH an 'Indicator X' declaration in scope is ChangeIndicatorToBoolean's job, not this
        // companion's - so it is not returned (else the plan would tick a redundant DeclareRefactoredIndicators).
        {Published = True}
        Procedure UndeclaredNamedIndicators_DeclaredName_None
            String[] asSource asNames
            Move "Indicator gibDebugMode"        to asSource[0]
            Move "    If [gibDebugMode] Begin"   to asSource[1]
            Move "    End"                       to asSource[2]
            Send ClearFuncLibProperties of ghoFuncLib
            Get _UndeclaredNamedIndicatorsIn of ghoFuncLib (&asSource) to asNames
            Send AssertIAreEqual 0 (SizeOfArray(asNames))
        End_Procedure

        // Regression (vWin32fh.pkg line 254, Nils 2026-07-06): 'Indicate seqeof True' uses the DataFlex
        // runtime sequential-EOF indicator - a built-in like Found/Err that needs NO declaration. It must
        // NOT be flagged (else the plan wrongly ticks DeclareRefactoredIndicators, and a real run would
        // splice a bogus 'Global_Variable Boolean seqeof' clashing with the runtime indicator). seqeof was
        // in _IndicatorVarName's pass-through list but missing from the declaration-skip - now shared via
        // _IsBuiltInIndicatorName.
        {Published = True}
        Procedure UndeclaredNamedIndicators_SeqEof_None
            String[] asSource asNames
            Move "    Repeat"                        to asSource[0]
            Move "        Readln Channel iCh sTmp"   to asSource[1]
            Move "        Indicate seqeof True"      to asSource[2]
            Move "    Until (seqeof)"                to asSource[3]
            Send ClearFuncLibProperties of ghoFuncLib
            Get _UndeclaredNamedIndicatorsIn of ghoFuncLib (&asSource) to asNames
            Send AssertIAreEqual 0 (SizeOfArray(asNames))
        End_Procedure

        // --- _CollectIndicatorNames: the shared parse behind _UndeclaredNamedIndicatorsIn AND
        //     _ScopeHasSelectIndicator (which gates DefineSelectMacro). SELECT used as an indicator
        //     ([Select] / Indicate Select) must be COLLECTED (so DefineSelectMacro is pulled in only then);
        //     a Found/Err-only source must NOT surface it (Nils 2026-07-06 - the DefineSelectMacro no-op run).

        {Published = True}
        Procedure CollectIndicatorNames_SelectDetected
            String[] asSource asUsed asDeclared
            Move "    [Select] Move 1 to iX"       to asSource[0]
            Move "    Indicate Select as (iX = 1)" to asSource[1]
            Send ClearFuncLibProperties of ghoFuncLib
            Send _CollectIndicatorNames of ghoFuncLib (&asSource) (&asUsed) (&asDeclared)
            Send Assert ((SearchArray("Select", asUsed)) >= 0)
        End_Procedure

        {Published = True}
        Procedure CollectIndicatorNames_NoSelect_FoundErrOnly
            String[] asSource asUsed asDeclared
            Move "    Indicate Err False"                    to asSource[0]
            Move "    If (Found) Indicate Found as (iX = 1)" to asSource[1]
            Send ClearFuncLibProperties of ghoFuncLib
            Send _CollectIndicatorNames of ghoFuncLib (&asSource) (&asUsed) (&asDeclared)
            Send Assert ((SearchArray("Select", asUsed)) = -1)
            Send Assert ((SearchArray("select", asUsed)) = -1)
        End_Procedure

        // Regression (Nils 2026-07-09): bare READS of a DECLARED indicator must be renamed too.
        // ChangeIndicatorToBoolean renames the 'Indicator X' DECLARATION to gbX and the usage
        // converters rename the writes they rewrite - but a 'While (X)' style bare read was
        // renamed by NOBODY (PASS 2b only covered the SHIMMED names), leaving it pointing at a
        // name whose declaration had become gbX. Flat module (no Procedure scopes), like the
        // real legacy file.
        {Published = True}
        Procedure DeclareRefactoredIndicators_DeclaredIndicatorReadRenamed
            Integer iResult
            String[] asOrig asCode

            Move "indicator smaller"                     to asOrig[0]
            Move "start_here:"                           to asOrig[1]
            Move "    indicate smaller as iX LT 160"     to asOrig[2]
            Move "    While (smaller)"                   to asOrig[3]
            Move "        Move (iX + 5) to iX"           to asOrig[4]
            Move "    Loop"                              to asOrig[5]
            // CONVERTED: the declaration became the guarded Global (ChangeIndicatorToBoolean) and
            // the write became a Move (usage converter) - the bare read still says (smaller).
            Move "#IFNDEF gbsmaller"                     to asCode[0]
            Move "    Global_Variable Boolean gbsmaller" to asCode[1]
            Move "#ENDIF"                                to asCode[2]
            Move "start_here:"                           to asCode[3]
            Move "    Move (iX LT 160) to gbsmaller"     to asCode[4]
            Move "    While (smaller)"                   to asCode[5]
            Move "        Move (iX + 5) to iX"           to asCode[6]
            Move "    Loop"                              to asCode[7]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 0 iResult    // the name IS declared - nothing to shim ...
            // ... but the bare READ is renamed:
            Send Assert ((SearchArray("    While (gbsmaller)", asCode)) >= 0)
        End_Procedure

        // The 'indicator X' DECLARATION straggler itself (ChangeIndicatorToBoolean not selected in
        // the run) is renamed too - and must NOT be treated as a shadowing LOCAL declaration
        // (LocalVariableTypes.inc lists 'indicator', so bIsVariableDeclaration is True for it; unhandled, it
        // would shadow every read below it for the whole flat module).
        {Published = True}
        Procedure DeclareRefactoredIndicators_DeclaredStragglerRenamedNotShadowing
            Integer iResult
            String[] asOrig asCode

            Move "indicator smaller"                     to asOrig[0]
            Move "    indicate smaller as iX LT 160"     to asOrig[1]
            Move "    While (smaller)"                   to asOrig[2]
            Move "    Loop"                              to asOrig[3]
            Move "indicator smaller"                     to asCode[0]
            Move "    Move (iX LT 160) to gbsmaller"     to asCode[1]
            Move "    While (smaller)"                   to asCode[2]
            Move "    Loop"                              to asCode[3]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send Assert ((SearchArray("indicator gbsmaller", asCode)) >= 0)
            Send Assert ((SearchArray("    While (gbsmaller)", asCode)) >= 0)
        End_Procedure

        // The companion gate's raw declaration scan: an 'Indicator <renameable>' line qualifies a
        // file; an incidental 'Indicator_State' token or a built-in name does not.
        {Published = True}
        Procedure ScopeGate_RawHasIndicatorDeclaration
            String[] asSource asPinned
            Boolean bHas

            Move "indicator smaller" to asSource[0]
            Get _RawHasIndicatorDeclaration of ghoFuncLib (&asSource) asPinned to bHas
            Send Assert (bHas = True)
            Move "    Move Indicator_State to iX" to asSource[0]
            Get _RawHasIndicatorDeclaration of ghoFuncLib (&asSource) asPinned to bHas
            Send AssertFalse bHas
            Move "indicator found" to asSource[0]
            Get _RawHasIndicatorDeclaration of ghoFuncLib (&asSource) asPinned to bHas
            Send AssertFalse bHas
            // a PINNED declaration does not qualify (it stays legacy).
            Move "indicator smaller" to asSource[0]
            Move "SMALLER" to asPinned[0]
            Get _RawHasIndicatorDeclaration of ghoFuncLib (&asSource) asPinned to bHas
            Send AssertFalse bHas
        End_Procedure

        // Regression (Nils 2026-07-08): PASS 2b must spare an unconverted Indicate straggler even
        // when the Indicate sits INLINE after 'If (cond)' - the old guard only checked line START,
        // so the read-rename hit the Indicate TARGET too and left 'Indicate gbMORE_ROWS ...'
        // = a guaranteed 4345 compile error, strictly worse than the legacy-but-compiling line.
        // The whole line is spared (reads included): a raw legacy line must stay wholly raw.
        {Published = True}
        Procedure DeclareRefactoredIndicators_InlineIndicateStragglerUntouched
            Integer iResult iPos
            String[] asOrig asCode

            Move "Procedure DoIt"                                                        to asOrig[0]
            Move "    If [MORE_ROWS] Begin"                                              to asOrig[1]
            Move "    End"                                                               to asOrig[2]
            Move "    If (MORE_ROWS) Indicate MORE_ROWS as Orders.Due_Date LE dCutOff"   to asOrig[3]
            Move "End_Procedure"                                                         to asOrig[4]
            // Converted file: the bracket line was rewritten, but the inline-Indicate line was
            // NOT converted (a converter gap or a de-selected function) - it must survive as-is.
            Move "Procedure DoIt"                                                        to asCode[0]
            Move "    If (gbMORE_ROWS) Begin"                                            to asCode[1]
            Move "    End"                                                               to asCode[2]
            Move "    If (MORE_ROWS) Indicate MORE_ROWS as Orders.Due_Date LE dCutOff"   to asCode[3]
            Move "End_Procedure"                                                         to asCode[4]
            Set pasOriginalSource of ghoEngine to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iResult
            Send AssertIAreEqual 1 iResult
            // shim declared under the gb name ...
            Send Assert ((SearchArray("#IFNDEF gbMORE_ROWS", asCode)) >= 0)
            // ... and the straggler line is byte-identical (no rename anywhere on it).
            Move (SearchArray("    If (MORE_ROWS) Indicate MORE_ROWS as Orders.Due_Date LE dCutOff", asCode)) to iPos
            Send Assert (iPos >= 0)
        End_Procedure

    End_Object
