        Function_Return False
    End_Function

    /* A legacy grid method used as a CALL - "Send Refresh_Page (Current_Row(Self))".

       IsLegacyOnlyGridMethod and LegacyOnlyGridMethodHint were only ever consulted for
       DECLARATIONS, through ParseProcFuncName. A call site therefore sailed straight through and
       into the converted output, where it does not compile: Nils, 2026-08-04, found exactly that
       line surviving into refactored cDbCJGridPromptList code. The knowledge to handle it was
       already here - the hint table has said "RefreshDataFromDD (note: parameters differ)" all
       along - it was just never reached from the call-site path.

       Reuses those same two tables rather than starting a second list, so every entry already
       curated there is covered at call sites too, not only the one that was reported. */
    Function TryRewriteLegacyGridCall String sLine String sLower String[] ByRef asOutput Returns Boolean
        String  sMethod sHint sIndent
        Integer iPos
        Boolean bLegacyOnly

        If (Left(sLower, 5) <> "send ") ;
            Function_Return False
        Move (Trim(Mid(sLower, (Length(sLower) - 5), 6))) to sMethod
        Move (Pos(" ", sMethod)) to iPos
        If (iPos > 0) ;
            Move (Trim(Left(sMethod, (iPos - 1)))) to sMethod
        Move (Trim(Replaces("(", sMethod, ""))) to sMethod
        If (sMethod = "") ;
            Function_Return False

        Get IsLegacyOnlyGridMethod sMethod to bLegacyOnly
        If (bLegacyOnly = False) ;
            Function_Return False

        // Commented out, not deleted: the call and the advice sit together, which is what makes
        // the TODO actionable. Same choice as the declaration path.
        Get CommentOutLine sLine to sLine
        Move sLine to asOutput[SizeOfArray(asOutput)]
        Get LegacyOnlyGridMethodHint sMethod to sHint
        If (sHint <> "") Begin
            Get GetIndent sLine to sIndent
            Move (sIndent + "// TODO: closest cCJGrid equivalent is " + sHint) to asOutput[SizeOfArray(asOutput)]
        End
        Function_Return True
    End_Function

    // Returns a hint naming the closest cCJGrid equivalent of a legacy grid method,
    // or "" when no close equivalent exists.
    Function LegacyOnlyGridMethodHint String sMethodLower Returns String
        If (sMethodLower = "fill_list") Begin
            Function_Return "InitializeData (note: parameters and calling convention differ)"
        End
        If (sMethodLower = "refresh_page") Begin
            Function_Return "RefreshDataFromDD (note: parameters differ)"
        End
        If (sMethodLower = "row_changing") Begin
            Function_Return "OnRowChanging (same two-row signature, but it RETURNS BOOLEAN where Row_Changing returned Integer)"
        End
        If (sMethodLower = "column_combo_fill_list") Begin
            Function_Return "ComboFillList on the COLUMN object (the column index parameter goes away - each column fills itself)"
        End
        If (sMethodLower = "column_combo_description_value") Begin
            Function_Return "ComboDescriptionValue on the COLUMN object (same eMode/sDescVal/sDataVal, without the leading column index)"
        End
        If (sMethodLower = "request_new_index") Begin
            Function_Return "ChangeOrdering"
        End
        If (sMethodLower = "move_to_column") Begin
            Function_Return "MoveToColumnObject (note: takes a column object handle, not a column number)"
        End
        If (sMethodLower = "change_row_color") Begin
            Function_Return "OnSetRowColor on the grid object (note: per-row color logic moves into OnSetRowColor)"
        End
        If (sMethodLower = "item_change") Begin
            Function_Return "OnRowChange (note: Item_Change fires on every cell move; OnRowChange only fires when the row changes)"
        End
        Function_Return ""
    End_Function

    // Returns True when sTrimLower is a legacy grid property that needs translation
    // into a CJGrid equivalent rather than simple removal.
    Function IsTranslatableGridProperty String sTrimLower Returns Boolean
        If (Left(sTrimLower, 4) <> "set ") Begin
            Function_Return False
        End
        If (sTrimLower contains "peresizecolumn") Begin
            Function_Return True
        End
        If (sTrimLower contains "static_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "initial_column") Begin
            Function_Return True
        End
        If (sTrimLower contains "prompt_button_mode") Begin
            Function_Return True
        End
        If (sTrimLower contains "allow_top_add_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "allow_bottom_add_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "allow_insert_add_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "auto_save_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "auto_regenerate_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "no_create_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "no_delete_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "read_only_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "header_visible_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "resize_column_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "highlight_row_state") Begin
            Function_Return True
        End
        If (sTrimLower contains "gridline_mode") Begin
            Function_Return True
        End
        If (sTrimLower contains "currentrowcolor") Begin
            Function_Return True
        End
        If (sTrimLower contains "currentrowtextcolor") Begin
            Function_Return True
        End
        If (sTrimLower contains "currentcellcolor") Begin
            Function_Return True
        End
        If (sTrimLower contains "currentcelltextcolor") Begin
            Function_Return True
        End
        If (sTrimLower contains "highlight_row_color") Begin
            Function_Return True
        End
        If (sTrimLower contains "current_item_color") Begin
            Function_Return True
        End
        If (sTrimLower contains "select_mode") Begin
            Function_Return True
        End
        If (sTrimLower contains "highlight_state") Begin
            Function_Return True
        End
        Function_Return False
    End_Function

    // Translates a recognised legacy grid property line into its CJGrid equivalent(s).
    // Returns an array of replacement lines; an empty array means drop the line.
    Function TranslateGridProperty String sLine String sTrimLower Returns String[]
        String[]  asResult
        String    sIndent sValue sValLower sBoolVal sNegBool
        Boolean   bBoolValue

        Get GetIndent sLine to sIndent
        Get ParseValueAfterTo sLine to sValue
        Move (Lowercase(Trim(sValue))) to sValLower

        Move (sValLower = "true" or sValLower = "1") to bBoolValue
        Move (If(bBoolValue, "True", "False")) to sBoolVal
        Move (If(bBoolValue, "False", "True")) to sNegBool

        If (sTrimLower contains "peresizecolumn") Begin
            If (sValLower = "rcnone" or sValLower = "0") Begin
                Move (sIndent + "Set pbAllowColumnResize to False") to asResult[0]
            End
            Function_Return asResult
        End

        // Static_State -> pbStaticData. Same meaning: the list holds all its data at once and does
        // not re-read (cCJGrid: "if true, load all data at once and it is static").
        If (sTrimLower contains "static_state") Begin
            Move (sIndent + "Set pbStaticData to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        /* Initial_Column -> piInitialColumn. Verified same concept (the legacy declaration calls it
           the "dflt refresh col"), but THE DEFAULTS DIFFER - legacy 0, cCJGrid -1 - so the value is
           carried across verbatim rather than assumed, and a source line that merely restated the
           legacy default now says 0 explicitly instead of silently meaning something else. */
        If (sTrimLower contains "initial_column") Begin
            Move (sIndent + "Set piInitialColumn to " + Trim(sValue)) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "prompt_button_mode") Begin
            If (sValLower = "pb_prompton" or sValLower = "pb_promptauto") Begin
                Move (sIndent + "Set pbHeaderPrompts to True")  to asResult[0]
            End
            Else Begin
                Move (sIndent + "Set pbHeaderPrompts to False") to asResult[0]
            End
            Function_Return asResult
        End

        If (sTrimLower contains "allow_top_add_state") Begin
            Move (sIndent + "Set pbAllowAppendRow to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "allow_bottom_add_state") Begin
            Move (sIndent + "Set pbAllowAppendRow to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "allow_insert_add_state") Begin
            Move (sIndent + "Set pbAllowInsertRow to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "auto_save_state") Begin
            Move (sIndent + "Set pbAutoSave to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "auto_regenerate_state") Begin
            Move (sIndent + "Set pbAutoRegenerate to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "no_create_state") Begin
            Move (sIndent + "Set pbAllowAppendRow to " + sNegBool) to asResult[0]
            Move (sIndent + "Set pbAllowInsertRow to " + sNegBool) to asResult[1]
            Function_Return asResult
        End

        If (sTrimLower contains "no_delete_state") Begin
            Move (sIndent + "Set pbAllowDeleteRow to " + sNegBool) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "read_only_state") Begin
            Move (sIndent + "Set pbReadOnly to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "header_visible_state") Begin
            Move (sIndent + "Set pbShowHeader to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "resize_column_state") Begin
            Move (sIndent + "Set pbAllowColumnResize to " + sBoolVal) to asResult[0]
            Function_Return asResult
        End

        /* Highlight_Row_State: "the current row will be displayed in this object's CurrentRowColor" (the
           DataFlex help). A cCJGrid colours a row with piHighlightBackColor only when the row is SELECTED, and
           its rows cannot be selected by default (pbSelectionEnable False) - so the focus rectangle alone
           (pbShowRowFocus) converted 1,355 of one workspace's grids with their row colour set and never shown.
           Both, then (Nils 2026-10-04: "use pbSelectionEnable and keep pbShowRowFocus"). The dbList converter
           keeps the rectangle only: a prompt list selects its rows itself. */
        If (sTrimLower contains "highlight_row_state") Begin
            Move (sIndent + "Set pbShowRowFocus to " + sBoolVal)    to asResult[0]
            Move (sIndent + "Set pbSelectionEnable to " + sBoolVal) to asResult[1]
            Function_Return asResult
        End

        If (sTrimLower contains "gridline_mode") Begin
            /* THE FOUR VALUES gridline_mode TAKES, each written both ways the source can spell
               it - the DataFlex constant name and the bare ordinal. A Case puts the four side by
               side, which is how the mapping is checked: none/horz/vert/both against 0/1/2/3.
               No arm can match another and none is a default, so an unrecognised value falls
               through writing nothing - deliberately, as before. */
            Case Begin
                Case (sValLower = "grid_visible_none" or sValLower = "0")
                    Move (sIndent + "Set peHorizontalGridStyle to xtpGridNoLines") to asResult[0]
                    Move (sIndent + "Set peVerticalGridStyle   to xtpGridNoLines") to asResult[1]
                    Case Break
                Case (sValLower = "grid_visible_horz" or sValLower = "1")
                    Move (sIndent + "Set peHorizontalGridStyle to xtpGridSolid") to asResult[0]
                    Case Break
                Case (sValLower = "grid_visible_vert" or sValLower = "2")
                    Move (sIndent + "Set peVerticalGridStyle to xtpGridSolid") to asResult[0]
                    Case Break
                Case (sValLower = "grid_visible_both" or sValLower = "3")
                    Move (sIndent + "Set peHorizontalGridStyle to xtpGridSolid") to asResult[0]
                    Move (sIndent + "Set peVerticalGridStyle   to xtpGridSolid") to asResult[1]
                    Case Break
            Case End
            Function_Return asResult
        End

        If (sTrimLower contains "currentrowcolor") Begin
            Move (sIndent + "Set piHighlightBackColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "currentrowtextcolor") Begin
            Move (sIndent + "Set piHighlightForeColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "currentcellcolor") Begin
            Move (sIndent + "Set piFocusCellBackColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "currentcelltextcolor") Begin
            Move (sIndent + "Set piFocusCellForeColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        /* THE OLDER NAMES of CurrentRowColor and CurrentCellColor (2026-10-04). DataFlex 26 still has both
           pairs, and code written before the rename uses the old ones - Highlight_Row_Color in 1,465 of one
           workspace's grids, Current_Item_Color in 48 - so they reached the CodeJock grid untranslated. Same
           properties, same counterparts. */
        If (sTrimLower contains "highlight_row_color") Begin
            Move (sIndent + "Set piHighlightBackColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "current_item_color") Begin
            Move (sIndent + "Set piFocusCellBackColor to " + sValue) to asResult[0]
            Function_Return asResult
        End

        // Select_Mode as the Grid converter has always mapped it (cGridToCJGrid): only Multi_Select has a
        // counterpart, the rest is removed. Here for dbGrid, dbList and List; a Grid handles it first, itself.
        If (sTrimLower contains "select_mode") Begin
            If (sValLower contains "multi_select") ;
                Move (sIndent + "Set pbMultipleSelection to True") to asResult[0]
            Function_Return asResult
        End

        If (sTrimLower contains "highlight_state") Begin
            Move (sIndent + "// TODO: Highlight_State has no cCJGrid counterpart - pbShowRowFocus and piFocusCellBackColor set how the current row and cell show. Was: " + Trim(sLine)) to asResult[0]
            Function_Return asResult
        End

        Function_Return asResult  // Unrecognised translatable -- drop.
    End_Function

    /* The CodeJock lines for a legacy "Set Numeric_Mask [Item] N to <left> <right> [<template>]", or its twin
       Currency_Mask (bCurrency) - 2026-10-04. The column's own CreateNumericMask / CreateCurrencyMask take the
       same two digit counts and set the data type, the mask and the length from them (cCJGridColumn.pkg); a
       template after the pair builds the mask the way the legacy message did, through Number_Default_Mask.
       sOf is "" inside the column object, or " of <columnObject>" for a line written after the column
       objects; sWas is the legacy line, for the TODO a value that is not a pair leaves. Until this the dbGrid
       converter put the value itself into psMask ("Set psMask to 12 2", which is no mask) and the Grid
       converter left the legacy line in the CodeJock grid. */
    Function NumericMaskLines String sIndent String sValue String sOf Boolean bCurrency String sWas Returns String[]
        String[] asSplit asTok asOut
        String   sRest sCode
        Integer  i iCut iPos

        /* THE VALUE ENDS AT A COMMENT (2026-10-31). ParseValueAfterTo hands over everything after 'to', so 'Set
           Currency_Mask Item 6 to 10 2 // Amount' made the comment the template - 'Number_Default_Mask(10, 2, //
           Amount)', error 4346, in every view that commented its masks. The function library's line scanner
           says where the code ends, outside any string; the text is cut there, so a template string stays. */
        If (Pos("//", sValue) > 0) Begin
            Get _CodeOnlyLine of ghoFuncLib sValue to sCode
            Move (Length(sCode)) to iCut
            Move (Pos("//", Mid(sValue, Length(sValue), (iCut + 1)))) to iPos
            If (iPos > 0) ;
                Move (Left(sValue, (iCut + iPos - 1))) to sValue
        End
        Move (StrSplitToArray(Trim(sValue), " ")) to asSplit
        For i from 0 to (SizeOfArray(asSplit) - 1)
            If (asSplit[i] <> "") ;
                Move asSplit[i] to asTok[SizeOfArray(asTok)]
        Loop
        If (SizeOfArray(asTok) < 2) Begin
            Move (sIndent + "// TODO: " + If(bCurrency, "Currency_Mask", "Numeric_Mask") + " takes the digits left and right of the decimal separator - set this column's mask by hand (" + If(bCurrency, "CreateCurrencyMask", "CreateNumericMask") + "). Was: " + sWas) to asOut[SizeOfArray(asOut)]
            Function_Return asOut
        End
        Move (sIndent + "Send " + If(bCurrency, "CreateCurrencyMask", "CreateNumericMask") + sOf + " " + asTok[0] + " " + asTok[1]) to asOut[SizeOfArray(asOut)]
        If (SizeOfArray(asTok) > 2) Begin
            Move "" to sRest
            For i from 2 to (SizeOfArray(asTok) - 1)
                Move (sRest + If((sRest = ""), "", " ") + asTok[i]) to sRest
            Loop
            Move (sIndent + "Set psMask" + sOf + " to (Number_Default_Mask(" + asTok[0] + ", " + asTok[1] + ", " + sRest + "))") to asOut[SizeOfArray(asOut)]
        End
        Function_Return asOut
    End_Function

    // Collect the NAMES declared with a type keyword from a (trimmed lowercase) line - both a
    // method SIGNATURE ("procedure entry_display integer ifile integer itype") and a body var
    // declaration ("integer iitem icolor"). Once a type keyword has been seen, every following
    // token collects as a name until the next type keyword; an end-comment stops the walk.
    // Feeds the Entry_Display hoist guard: these names are METHOD LOCALS, illegal at object level.
    Procedure CollectTypedNames String sTrimLower String[] ByRef asNames
        String[] asWords
        String sWord sTypes
        Integer i iSize
        Boolean bTypeSeen

        Move " integer number string boolean date datetime handle variant real currency longptr ulongptr pointer uchar ushort uinteger bigint " to sTypes
        Move (StrSplitToArray(sTrimLower, " ")) to asWords
        Move (SizeOfArray(asWords) - 1) to iSize
        Move False to bTypeSeen
        For i from 0 to iSize
            Move (Trim(asWords[i])) to sWord
            If (Left(sWord, 2) = "//") ;
                Move iSize to i
            Else If (sWord <> "") Begin
                If (sTypes contains (" " + sWord + " ")) ;
                    Move True to bTypeSeen
                Else If (bTypeSeen = True) ;
                    Move sWord to asNames[SizeOfArray(asNames)]
            End
        Loop
    End_Procedure

    // True when the value part (after " to ") of a legacy grid-property Set references one of the
    // collected method locals (whole-word). Such a Set cannot be hoisted to object level - the
    // local does not exist there and the compiler reads it as an unresolved message
    // (iColor -> MSG_ICOLOR, error 4306; LegacyApp replay 2026-07-24).
    Function EntryDisplayLocalInValue String sTrimLower String[] asLocals Returns Boolean
        String sValue
        Integer i iSize iPos
        Move (Pos(" to ", sTrimLower)) to iPos
        If (iPos = 0) ;
            Function_Return False
        Move (Mid(sTrimLower, (Length(sTrimLower)), (iPos + 4))) to sValue
        Move (SizeOfArray(asLocals) - 1) to iSize
        For i from 0 to iSize
            If (_FindKeywordPos(ghoFuncLib, sValue, asLocals[i], True, 1) > 0) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // *** Parsing helpers ***

    // Replace the class name in sLine with the target grid class from psTargetGridClass.
    // Either article matches; the output keeps the line through the article's 'a' (original
    // casing preserved) - an "is an <Old>" therefore normalises to "is a <New>" (every target
    // class is consonant-initial).
    Function ReplaceGridClassName String sLine String sTrimLower Returns String
        Integer iIsA iArt
        String  sLeading sTargetClass

        Get IsAArticlePos (Lowercase(sLine)) (&iArt) to iIsA
        If (iIsA = 0) Begin
            Function_Return sLine
        End
        Move (Left(sLine, (iIsA + 4)) + " ") to sLeading
        Get psTargetGridClass to sTargetClass
        Function_Return (sLeading + sTargetClass)
    End_Function

    // Parse the item index N from a per-column Set line, handling both:
    //   "set <propname> item N to value"  (with  Item keyword)
    //   "set <propname> N to value"       (without Item keyword)
    // sPropName is the lowercase property name to locate in the line.
    // Returns -1 when the index cannot be parsed.
    // A source token -> a non-negative integer (used for BOTH a column index AND a form-width), but ONLY
    // when the token is all digits; otherwise -1 - the "skip" sentinel the grid callers already test
    // (index: If iItemIdx >= 0; width: If iWidth >= 0). Essential: a NON-numeric token - a variable or
    // constant index/width ("... item iCol to ..." or "... to C_Width") instead of a literal - would
    // otherwise FAULT Integer() (string -> numeric) in DF26 and abort the whole grid -> cDbCJGrid run.
    Function _DigitsToIntOrMinus1 String sToken Returns Integer
        Integer i iLen
        Move (Trim(sToken)) to sToken
        Move (Length(sToken)) to iLen
        If (iLen = 0) ;
            Function_Return -1
        For i from 1 to iLen
            If (Pos(Mid(sToken, 1, i), "0123456789") = 0) ;
                Function_Return -1
        Loop
        Function_Return (Integer(sToken))
    End_Function

    // Parse the item index N from a line like "set form_width   item N to ..."
    Function ParseItemIndex String sTrimLower Returns Integer
        Integer iItem iSpace
        String  sRest sToken

        Move (Pos(" item ", sTrimLower)) to iItem
        If (iItem = 0) Begin
            Function_Return -1
        End
        Move (Trim(Mid(sTrimLower, CI_EOL, (iItem + 6)))) to sRest
        Move (Pos(CS_S, sRest)) to iSpace
        If (iSpace > 0) Begin
            Move (Left(sRest, iSpace - 1)) to sToken
        End
        Else Begin
            Move sRest to sToken
        End
        Function_Return (_DigitsToIntOrMinus1(Self,sToken))
    End_Function

    // Extract the EMITTABLE psCaption value from "Set Header_Label [Item] N to <value>".
    // A quoted string literal is returned WITH its quotes (a trailing end comment after the closing
    // quote is dropped, via an explicit closing-quote search so "//" inside the label text is safe).
    // A non-quoted value - an expression like (fFindLabelText("X")), a variable, or a constant - comes
    // back VERBATIM. Callers emit `Set psCaption to <this>` AS-IS; they must NOT re-wrap it in quotes
    // (that turned the expression into the broken Set psCaption to "(fFindLabelText("X"))" - Nils 2026-07-07).
    Function ParseHeaderLabel String sOrigLine Returns String
        String  sVal
        Integer iPos
        Get ParseValueAfterTo sOrigLine to sVal
        If (Left(sVal, 1) = '"' and Length(sVal) >= 2) Begin
            // Closing-quote position (search from char 2); keep the whole "..." and drop any end comment.
            Move (Pos('"', Mid(sVal, CI_EOL, 2))) to iPos
            If (iPos > 0) ;
                Move (Left(sVal, iPos + 1)) to sVal
        End
        Function_Return sVal
    End_Function

    // Extract an integer column width from "Set Form_Width [Item] N to W".
    Function ParseFormWidth String sTrimLower Returns Integer
        String sVal
        Get ParseValueAfterTo sTrimLower to sVal
        Function_Return (_DigitsToIntOrMinus1(Self,sVal))
    End_Function

    Function ParseColumnItemIndex String sTrimLower String sPropName Returns Integer
        Integer iProp iAfter iSpace
        String  sRest

        // Try the "item N" form first.
        Move (Pos(" item ", sTrimLower)) to iProp
        If (iProp <> 0) Begin
            Move (Trim(Mid(sTrimLower, CI_EOL, (iProp + 6)))) to sRest
            Move (Pos(CS_S, sRest)) to iSpace
            If (iSpace > 0) Begin
                Function_Return (_DigitsToIntOrMinus1(Self,Left(sRest, iSpace - 1)))
            End
            Function_Return (_DigitsToIntOrMinus1(Self,Trim(sRest)))
        End

        // No "item" keyword: N sits directly after the property name.
        Move (Pos(sPropName, sTrimLower)) to iProp
        If (iProp = 0) Begin
            Function_Return -1
        End
        // Skip past the property name + one space; then read N from the rest.
        Move (iProp + Length(sPropName)) to iAfter
        Move (Trim(Mid(sTrimLower, CI_EOL, (iAfter + 1)))) to sRest
        // sRest = "N to value"
        Move (Pos(CS_S, sRest)) to iSpace
        If (iSpace > 0) Begin
            Function_Return (_DigitsToIntOrMinus1(Self,Left(sRest, iSpace - 1)))
        End
        Function_Return (_DigitsToIntOrMinus1(Self,Trim(sRest)))
    End_Function

    // Extract the raw value after " to " from a line (uses original casing).
    Function ParseValueAfterTo String sOrigLine Returns String
        Integer iTo
        String  sLower

        Move (Lowercase(sOrigLine)) to sLower
        Move (Pos(" to ", sLower)) to iTo
        If (iTo = 0) Begin
            Function_Return ""
        End
        Function_Return (Trim(Mid(sOrigLine, CI_EOL, (iTo + 4))))
    End_Function

    // Build an indentation string of one tab-size worth of spaces.
    Function MakeSingleIndent Returns String
        String  sIndent
        Integer iTabSize iCount

        Get piTabSize of ghoFuncLib to iTabSize
        Move "" to sIndent
        For iCount from 1 to iTabSize
            Append sIndent CS_S
        Loop
        Function_Return sIndent
    End_Function

    // *** Subclass hooks -- override in derived classes ***

    /* DECLINE HOOK - answered by the subclass BEFORE a grid object is touched. "" means convert it;
       anything else is the reason it must stay as written: TransformSource then passes the whole
       object through verbatim (not counted, no Use line added for it) and names it in the run notes
       through NoteDeclinedGrid. The base declines nothing. */
    Function GridDeclineReason String sGridIndent Integer iGridStartLine Returns String
        Function_Return ""
    End_Function

    /* The run note for a grid the subclass declined: "<file>: <object> left as <Class> - <reason>".
       The summary line counts converted objects only, so without this a grid that stayed legacy would
       read as an oversight instead of a decision. Keyed on the running function (psExecutionContext),
       as TransformFiles keys its summary unit; outside a run there is no function to note into. */
    Procedure NoteDeclinedGrid String sTrimLine String sReason
        String  sFn sFile sObj sClass
        Integer iPos

        Get psExecutionContext of ghoFuncLib to sFn
        If (Trim(sFn) = "") ;
            Procedure_Return
        Get psFileName to sFile
        Move (RightPos("\", sFile)) to iPos
        If (iPos > 0) ;
            Move (Mid(sFile, (Length(sFile) - iPos), (iPos + 1))) to sFile
        If (Trim(sFile) <> "") ;
            Move (Trim(sFile) + ": ") to sFile
        Get _NthWord of ghoFuncLib sTrimLine 2 to sObj
        Get LegacyClassOnLine sTrimLine to sClass
        If (sClass = "") ;
            Move "its class" to sClass
        Send AddRunNote of ghoFuncLib sFn (sFile + sObj + " left as " + sClass + " - " + sReason)
    End_Procedure

    /* THE MARKER IS THE OUTCOME (2026-09-07). A declined grid that carried only a run note came back on every
       Check as the same rows and was declined again by every plan run - three rounds of the same 16 rows on
       one workspace. The Deep Scan and the analyzer's verify step both honour a '// TODO (DFRefactor)' comment
       line directly above a declaration (cDeepScanner.ScanLines, cModAnalyzer.VerifySkipMarker), so the reason
       is written there as well - once: when the line above the object in the SOURCE already carries a
       DFRefactor marker, nothing is added, and a re-run stays byte-identical. */
    Procedure AppendDeclineMarker String[] ByRef asOutput String sGridIndent String sReason Integer iGridStartLine
        String[] asSource
        String sAbove

        If (iGridStartLine > 0) Begin
            Get pasSource to asSource
            Move (Lowercase(Trim(asSource[iGridStartLine - 1]))) to sAbove
            If (Left(sAbove, 2) = "//" and (sAbove contains "dfrefactor") and ((sAbove contains "todo") or (sAbove contains "note"))) ;
                Procedure_Return
        End
        Move (sGridIndent + "// TODO (DFRefactor): NOT converted - " + sReason) to asOutput[SizeOfArray(asOutput)]
        Set piDeclineMarkers to (piDeclineMarkers(Self) + 1)
    End_Procedure

    // Is the current file worth writing back? When something converted - or when a decline marker was
    // added: the marker is what keeps the next Check from offering the same grid again, and a file with
    // nothing converted was never written, so the same rows returned run after run (2026-09-07).
    Function FileNeedsWrite Integer iGridsConverted Returns Boolean
        Function_Return (iGridsConverted > 0 or piDeclineMarkers(Self) > 0)
    End_Function

    // Called when a grid declaration is detected and processed.
    // iGridStartLine is the zero-based index of the grid declaration line in pasSource.
    // Subclasses reset their per-grid state (column arrays etc.) here, and may use
    // iGridStartLine to perform their own forward pre-scan of the grid body.
    Procedure OnGridStarted String sGridIndent Integer iGridStartLine
    End_Procedure

    // True when the method body starting AFTER iFrom declares a local named sName (whole word,
    // on a type-keyword declaration line), up to its End_Procedure / End_Function.
    //
    // WHY (Nils 2026-07-26, LegacyApp): converting Mouse_Click emits
    // 'Procedure OnRowDoubleClick Integer iRow Integer iCol' - and if the ORIGINAL body already
    // declared its own local named iRow or iCol (this codebase writes 'Get Current_Col to iCol'
    // everywhere), the injected PARAMETER and that local collide:
    //     ERROR 4345 Type check error ICOL, SHOULD NOT BE DEFINED
    //     ERROR 4332 Symbol already defined  ICOL
    // Reproduced standalone against DF25 - a cCJGrid object whose OnRowDoubleClick body declares
    // 'Integer iCol' fails to compile with exactly that pair. The parameter names are OURS, so we
    // move them out of the way rather than renaming the customer's variable (see MouseParamNames).
    Function MethodBodyDeclaresLocal String[] ByRef asLines Integer iFrom String sName Returns Boolean
        String[] asNames asEmpty
        String   sLow sWant
        Integer  i iLast j

        Move (Lowercase(Trim(sName))) to sWant
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from (iFrom + 1) to iLast
            Move (Lowercase(Trim(asLines[i]))) to sLow
            If (Left(sLow, 13) = "end_procedure" or Left(sLow, 12) = "end_function") ;
                Function_Return False
            If (Left(sLow, 2) <> "//") Begin
                // CollectTypedNames yields the NAMES on a type-keyword declaration line and
                // nothing on an ordinary statement - so a mere USE of the name never matches.
                Move asEmpty to asNames
                Send CollectTypedNames sLow (&asNames)
                For j from 0 to (SizeOfArray(asNames) - 1)
                    If (asNames[j] = sWant) ;
                        Function_Return True
                Loop
            End
        Loop
        Function_Return False
    End_Function

    // The parameter names to give a converted Mouse_Click / Mouse_Down2. Normally iRow / iCol -
    // the names cCJGrid itself uses - but when the body already declares one of them as its own
    // local, that name is taken and we step aside (iGridRow / iGridCol). Returns both ByRef.
    Procedure MouseParamNames String[] ByRef asLines Integer iFrom String ByRef sRowName String ByRef sColName
        Boolean bRowTaken bColTaken
        Move "iRow" to sRowName
        Move "iCol" to sColName
        Get MethodBodyDeclaresLocal (&asLines) iFrom "iRow" to bRowTaken
        Get MethodBodyDeclaresLocal (&asLines) iFrom "iCol" to bColTaken
        If (bRowTaken = True or bColTaken = True) Begin
            // Rename BOTH together - a signature reading 'Integer iRow Integer iGridCol' would be
            // needlessly confusing, and the pair is always read as a pair.
            Move "iGridRow" to sRowName
            Move "iGridCol" to sColName
        End
    End_Procedure

    // Called for each source line at nesting level 1 (direct grid body content)
    // before the base class dispatches properties/methods.
    // Set bSkip True to consume the line; leave False to pass through to base processing.
    // asOutput may be written to (e.g. to flush buffered column objects).
    Procedure OnHandleGridLine String sLine String sTrimLine String sLower String[] ByRef asOutput String sGridIndent Boolean ByRef bSkip
    End_Procedure

    // Called just before the grid's own End_Object is emitted.
    // Subclasses flush any buffered column objects into asOutput here.
    Procedure OnBeforeGridEndObject String[] ByRef asOutput String sGridIndent
    End_Procedure

    // Called once at the end of TransformSource - AFTER every grid in the file converted -
    // with the complete output. Subclasses apply FILE-WIDE fix-ups here: e.g. renaming the
    // EXTERNAL callers of a data loader the conversion renamed to LoadData ('Send
    // FillArticleList of (oGrid(Self))' was left dangling - Sublager_clear_order 2026-07-25).
    Procedure OnAfterTransformSource String[] ByRef asOutput
    End_Procedure

    // Emits translatable grid properties collected from Entry_Display during
    // the grid pre-scan (see TransformSource grid detection section).
    // Idempotent: after the first call it is a no-op, so it is safe to call
    // from both AppendColumnObjects (primary - emits before first column object)
    // and from TransformSource before OnBeforeGridEndObject (safety net for grids
    // that produce no column sub-objects).
    Procedure FlushEntryDisplayExtracted String[] ByRef asOutput String sGridIndent
        String[]  asProps asEmpty
        String    sSingleIndent
        Integer   iTr iTrSize
        Boolean   bFlushed

        Get pbEntryDisplayFlushed to bFlushed
        If (bFlushed = True) Begin
            Procedure_Return
        End
        Set pbEntryDisplayFlushed to True

        Get pasEntryDisplayExtracted to asProps
        Set pasEntryDisplayExtracted to asEmpty

        If (SizeOfArray(asProps) = 0) Begin
            Procedure_Return
        End

        // Blank separator before the translated block (if needed).
        If (SizeOfArray(asOutput) > 0 and Trim(asOutput[SizeOfArray(asOutput) - 1]) <> "") Begin
            Move "" to asOutput[SizeOfArray(asOutput)]
        End

        Get MakeSingleIndent to sSingleIndent
        Move (sGridIndent + sSingleIndent + "// Translated from Entry_Display to grid level:") to asOutput[SizeOfArray(asOutput)]

        Move (SizeOfArray(asProps)) to iTrSize
        Decrement iTrSize
        For iTr from 0 to iTrSize
            Move asProps[iTr] to asOutput[SizeOfArray(asOutput)]
        Loop

        Move "" to asOutput[SizeOfArray(asOutput)]
    End_Procedure

    // *** Main transformation that operates on pasSource ***

    // Scans pasSource, transforms every matching grid object it finds, writes
    // the result back to pasSource.  Returns the number of grids transformed.
    /* A DataFlex declaration may be split over a ';' continuation:

           Object oCustomers ;
               is a Grid

       and every IsGridDeclaration override starts with Pos("object ", ...) = 1, so the half
       carrying the class name was never recognised and the object stayed a Grid. The compiler is
       not fooled - it reports 4537 "Obsolete class: GRID" against the CONTINUATION line, which
       does not look like a declaration, so the warning also reads as if it points nowhere useful
       (Nils 2026-08-10, after the converted file kept warning).

       Joining the two halves into one line before the main pass is what makes the rest of the
       machine work unchanged: every splice point, indent calculation and body scan downstream
       assumes a declaration is one line, and teaching all of them about a second line would be a
       far larger change than removing the second line.

       NARROW ON PURPOSE. A continuation is joined ONLY when the result is a declaration of the
       legacy class this converter is looking for - IsGridDeclaration decides, the same authority
       the main loop uses. A ';' continuation anywhere else in the file, including one that
       completes an Object declaration of some OTHER class, is left exactly as written: this is a
       refactoring tool, and reflowing lines it was not asked to touch is how a diff becomes
       unreviewable. The joined line keeps the first half's indentation and drops the ';'. */
    Procedure JoinContinuedGridDeclarations String[] ByRef asSource
        String[] asNew
        String   sLine sNext sHead sJoined sIndent
        Integer  iCount iSize iOut
        Boolean  bIsGrid

        Move (SizeOfArray(asSource) - 1) to iSize
        Move 0 to iOut
        Move 0 to iCount
        While (iCount <= iSize)
            Move asSource[iCount] to sLine
            Move False to bIsGrid
            /* Candidate: an "Object ..." line ENDING in ';', with a following line that opens with
               the article. The ';' must be the last character - a line carrying a trailing comment
               after it is left alone rather than joined, because the join would have to decide
               where that comment now belongs and there is no answer that is obviously right. Those
               stay unconverted, exactly as before; nothing regresses. */
            If (iCount < iSize) Begin
                Move (Trim(sLine)) to sHead
                If (Right(sHead, 1) = ";" and Pos("object ", Lowercase(sHead)) = 1) Begin
                    Move (Trim(asSource[iCount + 1])) to sNext
                    If (Pos("is a ", Lowercase(sNext)) = 1 or Pos("is an ", Lowercase(sNext)) = 1) Begin
                        // Drop the ';' and glue the halves with a single space.
                        Move (Trim(Left(sHead, (Length(sHead) - 1)))) to sHead
                        Get GetIndent sLine to sIndent
                        Move (sIndent + sHead + " " + sNext) to sJoined
                        Get IsGridDeclaration (Lowercase(Trim(sJoined))) to bIsGrid
                    End
                End
            End
            If (bIsGrid = True) Begin
                Move sJoined to asNew[iOut]
                Increment iOut
                Move (iCount + 2) to iCount    // both halves consumed
            End
            Else Begin
                Move sLine to asNew[iOut]
                Increment iOut
                Increment iCount
            End
        Loop
        Move asNew to asSource
    End_Procedure

    /* THE CONVERSION, WITH THE TEXT MASKED (2026-10-30): a block comment's, a report image's and a string's text and
       the macro code are masked away while the grids are converted and put back after (cRefactorFuncLib's
       MaskForTransform) - a commented-out grid is no grid, and its text is never refactored. Measured the day it
       came: each of the four converters converted a grid commented out or in a report image. A masked line the
       conversion removed is put back where it was, and the run notes name the file. */
    Function TransformSource Returns Integer
        String[] asSource
        tWholeFileMask Mask
        Integer iGrids iMacro iLost

        Get pasSource to asSource
        Get MaskForTransform of ghoFuncLib (&asSource) (&Mask) to iMacro
        Set pasSource to asSource
        Get _TransformMaskedSource to iGrids
        Get pasSource to asSource
        Get UnmaskAfterTransform of ghoFuncLib (&asSource) (&Mask) to iLost
        Set pasSource to asSource
        If (iLost > 0) ;
            Send AddRunNote of ghoFuncLib (psExecutionContext(ghoFuncLib)) (psFileName(Self) + ":" * String(iLost) * "line(s) of comment, image or string text or macro code the conversion had removed were put back where they were - check the file.")
        Function_Return iGrids
    End_Function

    Function _TransformMaskedSource Returns Integer
        String[] asSource asOutput asTranslated asEntryDisplayProps asEmpty
        String[] asScanLocals
        String  sLine sTrimLine sLower sGridIndent sValue sSingleIndent
        String  sMethodName sOldMethodName sNewMethodName sHint sLineIndent
        String  sScanLine sScanLower
        String  sOldClass sSubclassMarker
        String[] asOldClasses
        String  sMouseClickOldP1 sMouseClickOldP2 sMouseRowName sMouseColName
        String  sPropIndent sPropHint sDecline
        Integer iCount iSize iGridsChanged iGridInnerNest iTr iTrSize
        Integer iScan iScanSize iScanNest iProcDepth iPassThrough
        Boolean bInEntryDisplay bSkip bFound bOK bScanFound
        Boolean bInRenameProcedure bInLegacyOnlyMethod
        Boolean bScanInEntryDisplay bScanDone bScanLocalHit

        Get pasSource to asSource
        Send JoinContinuedGridDeclarations (&asSource)
        Move 0 to iGridsChanged
        Move 0 to iGridInnerNest
        Move 0 to iProcDepth
        Move 0 to iPassThrough
        Move False to bInEntryDisplay
        Move False to bInRenameProcedure
        Move False to bInLegacyOnlyMethod
        Move "" to sSubclassMarker
        Set piDeclineMarkers to 0

        Move (SizeOfArray(asSource)) to iSize
        Decrement iSize

        For iCount from 0 to iSize
            Move asSource[iCount] to sLine
            Move (Trim(sLine))          to sTrimLine
            Move (Lowercase(sTrimLine)) to sLower
            Move False to bSkip

            // A grid the subclass DECLINED (GridDeclineReason) passes through verbatim to its own
            // End_Object, nested objects included - not one line of it is rewritten or counted.
            If (iPassThrough > 0) Begin
                Get IsObjectDeclaration sLower to bFound
                If (bFound = True) Begin
                    Increment iPassThrough
                End
                Else If (Left(sLower, 10) = "end_object") Begin
                    Decrement iPassThrough
                End
                Move sLine to asOutput[SizeOfArray(asOutput)]
                Move True to bSkip
            End

            // NOT inside any grid
            If (bSkip = False and iGridInnerNest = 0) Begin
                // Track procedure/function nesting at this TOP scope, so a grid declared
                // inside a Procedure body (e.g. Construct_Object) is detected. Procedure
                // lines INSIDE a grid body never reach here (they run at iGridInnerNest >= 1),
                // so this counter reflects only the scope the grid itself sits in.
                If (Left(sLower, 10) = "procedure " or Left(sLower, 9) = "function ") Begin
                    Increment iProcDepth
                End
                Else If (Left(sLower, 13) = "end_procedure" or Left(sLower, 12) = "end_function") Begin
                    If (iProcDepth > 0) ;
                        Decrement iProcDepth
                End
                Get IsGridDeclaration sLower to bFound
                If (bFound = True) Begin
                    Move (Replace(sTrimLine, sLine, "")) to sGridIndent
                    // An object of the workspace's own subclass, under an EMPTY parameter, stays as it is
                    // (SubclassToLeave): passed through untouched and counted for the run note - no marker
                    // above it, and nothing written for it.
                    Get SubclassToLeave sTrimLine to sOldClass
                    If (sOldClass <> "") Begin
                        Send TallySubclassLeft sOldClass
                        Move 1 to iPassThrough
                        Move False to bFound
                    End
                    // The subclass may DECLINE this object (no column definitions it can read - see
                    // cGridToCJGrid.GridDeclineReason): it is named in the run notes and passed through
                    // untouched, so nothing below runs for it and it is not counted.
                    Else Begin
                        Get GridDeclineReason sGridIndent iCount to sDecline
                        If (sDecline <> "") Begin
                            Send NoteDeclinedGrid sTrimLine sDecline
                            // ...and the same reason as a skip-marker above the object, so the next Check stays
                            // quiet about it instead of offering the row again (see AppendDeclineMarker).
                            Send AppendDeclineMarker (&asOutput) sGridIndent sDecline iCount
                            Move 1 to iPassThrough
                            Move False to bFound
                        End
                    End
                End
                If (bFound = True) Begin
                    // A SUBCLASS object (learned from the scan, or named in the parameter) gets a TODO
                    // as its first body line naming the class it came from - what that class added is
                    // not inherited by the target - and the class is remembered for RetireConvertedSubclassUses.
                    Get LegacyClassOnLine sTrimLine to sOldClass
                    Move "" to sSubclassMarker
                    /* ...unless the class itself was ported IN PLACE (ConvertGridSubclassToCodeJock, 2026-10-04): the
                       parameter then names the same class twice ("X,X,XColumn"), the object keeps "is a X", and what
                       X adds came along with the class - so no TODO, and no Use of X's package to retire. */
                    If (sOldClass <> "" and Lowercase(sOldClass) <> psLegacyRootToken(Self) and Lowercase(sOldClass) <> Lowercase(psTargetGridClass(Self))) Begin
                        Get MakeSingleIndent to sSingleIndent
                        Get _NthWord of ghoFuncLib sTrimLine 2 to sValue
                        Get SubclassMarkerLine (sGridIndent + sSingleIndent) sValue sOldClass to sSubclassMarker
                        If (SearchArray(Lowercase(sOldClass), asOldClasses) = -1) ;
                            Move (Lowercase(sOldClass)) to asOldClasses[SizeOfArray(asOldClasses)]
                    End
                    Get ReplaceGridClassName sLine sLower to sLine
                    Move 1 to iGridInnerNest
                    Increment iGridsChanged
                    Move False to bInEntryDisplay
                    Move False to bInRenameProcedure
                    Move False to bInLegacyOnlyMethod
                    Send OnGridStarted sGridIndent iCount
                    // Snapshot the proc-depth for THIS grid (read at End_Object by the
                    // subclass to decide whether a generated procedure is safe to emit).
                    Set piProcDepthAtGrid to iProcDepth
                    // Pre-scan: search ahead through this grid's body for a Procedure
                    // Entry_Display block and collect any translatable grid-level Set
                    // properties (e.g. Set CurrentRowColor) within it.  Results are
                    // stored in pasEntryDisplayExtracted and flushed by
                    // FlushEntryDisplayExtracted before the first column sub-object
                    // (or at End_Object for grids with no columns).
                    Move asEmpty to asEntryDisplayProps
                    Set pbEntryDisplayFlushed to False
                    Move (iCount + 1) to iScan
                    Move (SizeOfArray(asSource) - 1) to iScanSize
                    Move 0 to iScanNest
                    Move False to bScanInEntryDisplay
                    Move False to bScanDone
                    If (iScan <= iScanSize) Begin
                        Repeat
                            Move asSource[iScan]             to sScanLine
                            Move (Lowercase(Trim(sScanLine))) to sScanLower
                            // Track object nesting so we stay within this grid's boundary.
                            Get IsObjectDeclaration sScanLower to bScanFound
                            If (bScanFound = True) Begin
                                Increment iScanNest
                            End
                            Else If (Left(sScanLower, 10) = "end_object") Begin
                                If (iScanNest = 0) Begin
                                    Move True to bScanDone  // reached grid End_Object
                                End
                                Else Begin
                                    Decrement iScanNest
                                End
                            End
                            // Only inspect direct grid body lines (nesting level 0).
                            If (bScanDone = False and iScanNest = 0) Begin
                                If (bScanInEntryDisplay = True) Begin
                                    If (Left(sScanLower, 13) = "end_procedure" or ;
                                        Left(sScanLower, 12) = "end_function") Begin
                                        Move False to bScanInEntryDisplay
                                    End
                                    Else Begin
                                        // Names declared inside the body are METHOD LOCALS too.
                                        Send CollectTypedNames sScanLower (&asScanLocals)
                                        Get IsTranslatableGridProperty sScanLower to bScanFound
                                        If (bScanFound = True) Begin
                                            Get EntryDisplayLocalInValue sScanLower asScanLocals to bScanLocalHit
                                            Get MakeSingleIndent to sSingleIndent
                                            If (bScanLocalHit = True) Begin
                                                // A method local has no object-level meaning; hoisting it
                                                // compiles as an unresolved message (error 4306). Decline
                                                // and leave a note pointing at the preserved original.
                                                Move (sGridIndent + sSingleIndent + "// NOT hoisted (value uses an Entry_Display local): " + Trim(sScanLine)) to asEntryDisplayProps[SizeOfArray(asEntryDisplayProps)]
                                                Move (sGridIndent + sSingleIndent + "// Per-row/per-cell colors need hand work - see the commented-out Entry_Display below for the original logic.") to asEntryDisplayProps[SizeOfArray(asEntryDisplayProps)]
                                            End
                                            Else Begin
                                                Get TranslateGridProperty sScanLine sScanLower to asTranslated
                                                Move (SizeOfArray(asTranslated)) to iTrSize
                                                Decrement iTrSize
                                                For iTr from 0 to iTrSize
                                                    Move (sGridIndent + sSingleIndent + Trim(asTranslated[iTr])) to asEntryDisplayProps[SizeOfArray(asEntryDisplayProps)]
                                                Loop
                                            End
                                        End
                                    End
                                End
                                Else Begin
                                    Get IsEntryDisplayProcedure sScanLower to bScanFound
                                    If (bScanFound = True) Begin
                                        Move True to bScanInEntryDisplay
                                        // The signature's parameter names are method locals as well.
                                        Move asEmpty to asScanLocals
                                        Send CollectTypedNames sScanLower (&asScanLocals)
                                    End
                                End
                            End
                            Increment iScan
                        Until (bScanDone = True or iScan > iScanSize)
                    End
                    Set pasEntryDisplayExtracted to asEntryDisplayProps
                End
                Move sLine to asOutput[SizeOfArray(asOutput)]
                // ...and, once, the subclass TODO right under a converted subclass object's header.
                If (sSubclassMarker <> "") Begin
                    Move sSubclassMarker to asOutput[SizeOfArray(asOutput)]
                    Move "" to sSubclassMarker
                End
                Move True to bSkip
            End

            // Entry_Display sub-state: comment out every line including End_Procedure.
            // Translatable properties were pre-scanned at grid detection time and
            // will be flushed by FlushEntryDisplayExtracted before column objects.
            If (bSkip = False and bInEntryDisplay = True) Begin
                If (Left(sLower, 13) = "end_procedure" or Left(sLower, 12) = "end_function") Begin
                    Move False to bInEntryDisplay
                End
                Get CommentOutLine sLine to sLine
                Move sLine to asOutput[SizeOfArray(asOutput)]
                Move True to bSkip
            End

            // Renamed procedure/function body: rename Forward Send/Get calls.
            // Mouse_Click -> OnRowDoubleClick also substitutes old parameter names.
            If (bSkip = False and bInRenameProcedure = True) Begin
                If (Left(sLower, 13) = "end_procedure" or Left(sLower, 12) = "end_function") Begin
                    Move False to bInRenameProcedure
                    Move sLine to asOutput[SizeOfArray(asOutput)]
                End
                Else If (sLower contains ("forward send " + sOldMethodName) or ;
                         sLower contains ("forward get "  + sOldMethodName)) Begin
                    If (sOldMethodName = "mouse_click" or sOldMethodName = "mouse_down2") Begin
                        // Replace the entire Forward Send/Get with the correct new signature,
                        // including the renamed iRow / iCol parameters.
                        Get GetIndent sLine to sLineIndent
                        Move (sLineIndent + "Forward Send " + sNewMethodName + CS_S + sMouseRowName + CS_S + sMouseColName) to sLine
                    End
                    Else Begin
                        Get ReplaceMethodName sLine sOldMethodName sNewMethodName to sLine
                    End
                    Move sLine to asOutput[SizeOfArray(asOutput)]
                End
                Else Begin
                    // For Mouse_Click / Mouse_Down2 bodies: replace old parameter names
                    // with iRow / iCol throughout the method body - WHOLE identifiers only
                    // (ReplaceParamName; a bare substring swap turned Jobbreg_MultiWindow
                    // into Jobbreg_MultiiRow - WinServ 2026-08-17).
                    If (sOldMethodName = "mouse_click" or sOldMethodName = "mouse_down2") Begin
                        If (sMouseClickOldP1 <> "") Begin
                            Get ReplaceParamName sLine sMouseClickOldP1 sMouseRowName to sLine
                        End
                        If (sMouseClickOldP2 <> "") Begin
                            Get ReplaceParamName sLine sMouseClickOldP2 sMouseColName to sLine
                        End
                    End
                    // A legacy grid-only property INSIDE the converted method body (e.g.
                    // Set Auto_Index_State / Set Seed_List_State) has no equivalent on the
                    // cCJGrid class and would not compile. Handle it EXACTLY as at grid level
                    // so the two paths never diverge: subclass translation (mapping or a TODO
                    // hint) FIRST - which is where the dbList-specific properties live - then a
                    // comment-out property, then DROP a pure legacy property, else emit the
                    // (param-substituted) line. (Nils: Auto_Index_State + Seed_List_State,
                    // 2026-07-05 - the base-only handling missed the subclass-translated ones.)
                    Get IsTranslatableGridProperty sLower to bOK
                    If (bOK = True) Begin
                        Get TranslateGridProperty sLine sLower to asTranslated
                        Move (SizeOfArray(asTranslated)) to iTrSize
                        Decrement iTrSize
                        For iTr from 0 to iTrSize
                            Move asTranslated[iTr] to asOutput[SizeOfArray(asOutput)]
                        Loop
                    End
                    Else Begin
                        Get IsCommentOutGridProperty sLower to bOK
                        If (bOK = True) Begin
                            Get GetIndent sLine to sPropIndent
                            Get CommentOutLine sLine to sLine
                            Move sLine to asOutput[SizeOfArray(asOutput)]
                            Get LegacyOnlyGridPropertyHint sLower to sPropHint
                            If (sPropHint <> "") ;
                                Move (sPropIndent + "// TODO: closest cCJGrid equivalent is " + sPropHint) to asOutput[SizeOfArray(asOutput)]
                        End
                        Else Begin
                            Get IsLegacyGridProperty sLower to bOK
                            If (bOK = False) ;
                                Move sLine to asOutput[SizeOfArray(asOutput)]
                        End
                    End
                End
                Move True to bSkip
            End

            // Legacy-only method body sub-state: comment out every line
            If (bSkip = False and bInLegacyOnlyMethod = True) Begin
                If (Left(sLower, 13) = "end_procedure" or Left(sLower, 12) = "end_function") Begin
                    Move False to bInLegacyOnlyMethod
                End
                Get CommentOutLine sLine to sLine
                Move sLine to asOutput[SizeOfArray(asOutput)]
                Move True to bSkip
            End

            // Subclass first crack at direct grid content (iGridInnerNest = 1 only)
            If (bSkip = False and iGridInnerNest = 1) Begin
                Send OnHandleGridLine sLine sTrimLine sLower (&asOutput) sGridIndent (&bSkip)
            End

            // End_Object -- applies at every nesting level inside the grid
            If (bSkip = False and Left(sLower, 10) = "end_object") Begin
                Decrement iGridInnerNest
                If (iGridInnerNest = 0) Begin
                    // Safety flush: emit Entry_Display extracted properties if they have
                    // not yet been flushed by AppendColumnObjects (i.e. no column objects).
                    Send FlushEntryDisplayExtracted (&asOutput) sGridIndent
                    Send OnBeforeGridEndObject (&asOutput) sGridIndent
                End
                Move sLine to asOutput[SizeOfArray(asOutput)]
                Move True to bSkip
            End

            // Nested objects (iGridInnerNest > 1): pass all content through
            If (bSkip = False and iGridInnerNest > 1) Begin
                Get IsObjectDeclaration sLower to bFound
                If (bFound = True) Begin
                    Increment iGridInnerNest
                End
                Move sLine to asOutput[SizeOfArray(asOutput)]
                Move True to bSkip
            End

            // Direct grid content: Define constants are PRESERVED (pass-through). They were REMOVED as
            // "column index constants no longer needed" until Nils' LegacyApp dbGrid0 run (2026-07-03): the
            // preserved procedures still REFERENCE them ('Set Item_Option Item (BI+list0041w_Amount)...'),
            // so deleting the Define broke 5 views with ~145 'Undefined symbol' errors (list0041 alone lost
            // 14 constants). A Define is free if unused - keep it, never delete user code silently.
            If (bSkip = False) Begin
                If (Left(sLower, 7) = "define ") Begin
                    Move sLine to asOutput[SizeOfArray(asOutput)]
                    Move True to bSkip
                End
            End

            // Direct grid content: Object / Procedure / Function / Property dispatch
            If (bSkip = False) Begin
                Get IsObjectDeclaration sLower to bOK
                If (bOK = True) Begin
                    // Nested Object starts; subclass already flushed pending columns in hook.
                    Increment iGridInnerNest
                    Move sLine to asOutput[SizeOfArray(asOutput)]
                    Move True to bSkip
                End
                Else Begin
                    Get ParseProcFuncName sLower to sMethodName
                    If (sMethodName <> "") Begin
                        // Ensure one blank line before any procedure/function block.
                        If (SizeOfArray(asOutput) > 0 and Trim(asOutput[SizeOfArray(asOutput) - 1]) <> "") Begin
                            Move "" to asOutput[SizeOfArray(asOutput)]
                        End
                        Get IsEntryDisplayProcedure sLower to bInEntryDisplay
                        If (bInEntryDisplay = True) Begin
                            // Translatable properties were pre-scanned at grid detection time.
                            // Primary flush path: AppendColumnObjects calls FlushEntryDisplayExtracted
                            // before the first column sub-object.
                            // Fallback path (no columns yet, e.g. grids without Begin_Row): flush
                            // here so translated properties appear just above the commented block.
                            // FlushEntryDisplayExtracted is idempotent; if already flushed this is a no-op.
                            Send FlushEntryDisplayExtracted (&asOutput) sGridIndent
                            Get CommentOutLine sLine to sLine
                            Move sLine to asOutput[SizeOfArray(asOutput)]
                            Move True to bSkip
                        End
                        Else Begin
                            Get RenameGridMethod sMethodName to sNewMethodName
                            If (sNewMethodName <> "") Begin
                                Move sMethodName to sOldMethodName
                                Get ReplaceMethodName sLine sOldMethodName sNewMethodName to sLine
                                Move sLine to asOutput[SizeOfArray(asOutput)]
                                Move True to bInRenameProcedure
                                Move True to bSkip
                            End
                            Else Begin
                                // Mouse_Click  -> OnRowDoubleClick
                                // Mouse_Down2  -> OnRowRightClick
                                // Both have the same legacy signature (Integer iWin Integer iPos)
                                // and the same conversion approach: replace the declaration,
                                // rewrite Forward Send, and substitute old param names in the body.
                                If (sMethodName = "mouse_click" or sMethodName = "mouse_down2") Begin
                                    Get GetIndent sLine to sLineIndent
                                    // Parse the two legacy parameter names so the body handler
                                    // can substitute them with iRow / iCol.
                                    Move "" to sMouseClickOldP1
                                    Move "" to sMouseClickOldP2
                                    // sLower = Lowercase(sTrimLine), so offsets from Pos() align
                                    // with sTrimLine (not sLine which carries leading indentation).
                                    Move (Pos("integer ", sLower)) to iScanNest
                                    If (iScanNest > 0) Begin
                                        Move (Trim(Mid(sTrimLine, CI_EOL, (iScanNest + 8)))) to sMouseClickOldP1
                                        Move (Pos(CS_S, sMouseClickOldP1)) to iTrSize
                                        If (iTrSize > 0) Move (Left(sMouseClickOldP1, iTrSize - 1)) to sMouseClickOldP1
                                        // Locate second "integer " that follows the first param name.
                                        Move (iScanNest + 8 + Length(sMouseClickOldP1)) to iScanNest
                                        Move (Pos("integer ", Mid(sLower, CI_EOL, (iScanNest + 1)))) to iTrSize
                                        If (iTrSize > 0) Begin
                                            Move (iScanNest + iTrSize + 8) to iScanNest
                                            Move (Trim(Mid(sTrimLine, CI_EOL, iScanNest))) to sMouseClickOldP2
                                            Move (Pos(CS_S, sMouseClickOldP2)) to iTrSize
                                            If (iTrSize > 0) Move (Left(sMouseClickOldP2, iTrSize - 1)) to sMouseClickOldP2
                                        End
                                    End
                                    // Parameter names: iRow / iCol unless the body already declares
                                    // one of them as its own local, in which case OUR names step
                                    // aside (see MouseParamNames - the collision is a hard compile
                                    // error, 4332/4345, Nils 2026-07-26).
                                    Send MouseParamNames (&asSource) iCount (&sMouseRowName) (&sMouseColName)
                                    // Choose new name and emit conversion comment + new declaration.
                                    If (sMethodName = "mouse_click") Begin
                                        Move "OnRowDoubleClick" to sNewMethodName
                                        Move (sLineIndent + "// Converted from Mouse_Click: " + sMouseRowName + " = row index, " + sMouseColName + " = column index.") to asOutput[SizeOfArray(asOutput)]
                                        Move (sLineIndent + "Procedure OnRowDoubleClick Integer " + sMouseRowName + " Integer " + sMouseColName) to asOutput[SizeOfArray(asOutput)]
                                    End
                                    Else Begin
                                        Move "OnRowRightClick" to sNewMethodName
                                        Move (sLineIndent + "// Converted from Mouse_Down2: " + sMouseRowName + " = row index, " + sMouseColName + " = column index.") to asOutput[SizeOfArray(asOutput)]
                                        Move (sLineIndent + "Procedure OnRowRightClick Integer " + sMouseRowName + " Integer " + sMouseColName) to asOutput[SizeOfArray(asOutput)]
                                    End
                                    Move sMethodName to sOldMethodName
                                    Move True to bInRenameProcedure
                                    Move True to bSkip
                                End
                                Else Begin
                                    Get IsLegacyOnlyGridMethod sMethodName to bOK
                                    If (bOK = True) Begin
                                        Get GetIndent sLine to sLineIndent
                                        Get LegacyOnlyGridMethodHint sMethodName to sHint
                                        If (sHint <> "") Begin
                                            Move (sLineIndent + "// TODO: Legacy grid method -- consider using " + sHint + ".") to asOutput[SizeOfArray(asOutput)]
                                        End
                                        Else Begin
                                            Move (sLineIndent + "// TODO: Legacy grid method -- no direct equivalent in cCJGrid.") to asOutput[SizeOfArray(asOutput)]
                                        End
                                        Get CommentOutLine sLine to sLine
                                        Move sLine to asOutput[SizeOfArray(asOutput)]
                                        Move True to bInLegacyOnlyMethod
                                        Move True to bSkip
                                    End
                                    // else: unknown override - falls through to emit unchanged.
                                End  // Else (not mouse_click)
                            End  // Else Begin (RenameGridMethod returned empty)
                        End
                    End
                    Else Begin
                        Get IsTranslatableGridProperty sLower to bOK
                        If (bOK = True) Begin
                            Get TranslateGridProperty sLine sLower to asTranslated
                            Move (SizeOfArray(asTranslated)) to iTrSize
                            Decrement iTrSize
                            For iTr from 0 to iTrSize
                                Move asTranslated[iTr] to asOutput[SizeOfArray(asOutput)]
                            Loop
                            Move True to bSkip
                        End
                        Else Begin
                            Get IsCommentOutGridProperty sLower to bOK
                            If (bOK = True) Begin
                                Get GetIndent sLine to sPropIndent
                                Get CommentOutLine sLine to sLine
                                Move sLine to asOutput[SizeOfArray(asOutput)]
                                Get LegacyOnlyGridPropertyHint sLower to sPropHint
                                If (sPropHint <> "") ;
                                    Move (sPropIndent + "// TODO: closest cCJGrid equivalent is " + sPropHint) to asOutput[SizeOfArray(asOutput)]
                                Move True to bSkip
                            End
                            Else Begin
                                Get IsLegacyGridProperty sLower to bSkip
                            End
                        End
                    End
                End
            End

            // Emit line if not consumed
            If (bSkip = False) Begin
                Move sLine to asOutput[SizeOfArray(asOutput)]
            End
        Loop

        // Ensure the converted file Uses the package that defines the new grid class
        // (adds it, or swaps out the dedicated legacy package). Only when something was
        // actually converted - an untouched file keeps its Use lines verbatim.
        If (iGridsChanged > 0) Begin
            Send FixUpUsePackage (&asOutput)
            Send RetireConvertedSubclassUses (&asOutput) asOldClasses
            Send OnAfterTransformSource (&asOutput)
        End

        Set pasSource to asOutput
        Function_Return iGridsChanged
    End_Function

    // *** Generic file-loop interface -- call from subclass public interface ***
    //
    // Validates sParameter, loops over asFiles, calls ReadFile / TransformSource /
    // WriteFile for each, accumulates counts.
    Function TransformFiles String[] asFiles String sParameter Returns Integer
        String  sFilePath sFn
        Integer iCount iSize iGrids iTotalGrids iTotalFiles
        Boolean bOK bCancel

        Get ParseAndSetParameter sParameter to bOK
        If (bOK = False) Begin
            Function_Return 0
        End
        // What this converter COUNTS is grid objects, not files - its summary line says so.
        Get psExecutionContext of ghoFuncLib to sFn
        If (sFn <> "") ;
            Send SetSummaryUnit of ghoFuncLib sFn "grid object(s)"

        Move 0 to iTotalGrids
        Move 0 to iTotalFiles
        Send _ClearSubclassesLeft
        Move (SizeOfArray(asFiles)) to iSize
        Set piMaximumTot of ghoStatusPanel to iSize

        If (iSize > 0) Begin
            Decrement iSize
            For iCount from 0 to iSize
                Move asFiles[iCount] to sFilePath
                Set Caption_Text of ghoStatusPanel to ("Grid conversion - File No:" * String(iCount + 1) * "of:" * String(iSize + 1))
                // Panel field conventions (see RefactorStatusPanel.pkg): the full path goes to the
                // multi-line TableName line; Message_Text stays the ENGINE's "Function: <name>"
                // (this used to overwrite it with the bare file name).
                Set Title_Text   of ghoStatusPanel to "Converting Grid objects in:"
                Set TableName_Text of ghoStatusPanel to sFilePath

                Send ReadFile sFilePath
                Get TransformSource to iGrids

                // Written when something converted - or when a decline marker was added (FileNeedsWrite).
                If (FileNeedsWrite(Self, iGrids) = True) Begin
                    If (pbReadOnly(ghoFuncLib) = False) Begin
                        Send WriteFile
                    End
                    Increment iTotalFiles
                    Add iGrids to iTotalGrids
                End

                Send DoAdvanceTot of ghoStatusPanel
                // Mid-run cancel (the Cancel button): a *All function gets ONE call for all
                // files, so the engine's per-file Cancel_Check cannot fire while we convert.
                // Poll the safe accessor (NEVER Cancel_Check - it consumes the signal) and
                // bail; the engine's outer Cancel_Check then runs the confirm pipeline once.
                // Files already converted stay converted, like any engine cancel.
                Get pbUserCancelRequested of ghoEngine to bCancel
                If (bCancel = True) ;
                    Move iSize to iCount
            Loop
        End

        // One note per subclass whose objects the run left as they are (SubclassToLeave).
        Send NoteSubclassesLeft
        Set Title_Text     of ghoStatusPanel to ""
        Set TableName_Text of ghoStatusPanel to ""
        Set piChangedFiles to iTotalFiles
        Set piChangedGrids to iTotalGrids
        Function_Return iTotalGrids
    End_Function

    // *** Trailing line-comment split (shared by every grid/list flavour) ***
    //
    // Both converters have to separate a source line's CODE from its trailing "// note"
    // before rebuilding the line, and for the same reason: whatever they append would
    // otherwise land INSIDE the comment. The db flavour hit it on an Entry_Item field spec
    // ("Table.Field // comment" read as a calculated expression); the non-db flavour hit it
    // on "Send Add_Item Msg_None sStatus  //Status", where the generated " to TheData[iRow]
    // .sValue[iCol1]" was appended AFTER the comment and so was commented out - leaving a
    // one-argument "Move sStatus" that the compiler rejects with "ARGUMENT REQUIRED"
    // (LegacyApp, Nils 2026-07-26). One copy here rather than one per flavour.
    //
    // First "//" wins (leftmost match). Note this differs from cBaseFuncLib._RemoveEndComment,
    // which uses RightPos (rightmost match). A "//" inside a string literal is a rare edge
    // case that the rest of the tool treats the same way.
    Function StripTrailingComment String sSpec Returns String
        Integer iPos
        Move (Pos(CS_CommentSymbol, sSpec)) to iPos
        If (iPos > 0) Begin
            Move (Left(sSpec, iPos - 1)) to sSpec
        End
        Function_Return (Trim(sSpec))
    End_Function

    // Companion to StripTrailingComment: returns the trailing line comment ("// ...",
    // trimmed), or "" when there is none. Kept aside so it can be re-attached to the
    // generated line without ever participating in classification, column-name derivation
    // or value parsing - the user's annotation survives the conversion.
    Function ExtractTrailingComment String sSpec Returns String
        Integer iPos
        Move (Pos(CS_CommentSymbol, sSpec)) to iPos
        If (iPos = 0) Begin
            Function_Return ""
        End
        Function_Return (Trim(Mid(sSpec, CI_EOL, iPos)))
    End_Function

End_Class
