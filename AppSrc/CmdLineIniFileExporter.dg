Use Windows.pkg
Use File_dlg.pkg
Use vWin32fh.pkg
Use cRefactorApplication.pkg
Use cIniFile.pkg
Use RDCRunProgram.pkg          // RDCRevealInExplorer - the post-export 'show me the files' offer
Use RefactorConstants.h.pkg
Use cRDCDbModalPanel.pkg
Use cRDCForm.pkg
Use cRDCCheckbox.pkg
Use cRDCButton.pkg
Use cRDCHeaderGroup.pkg
Use cCmdLineIniFile.pkg          // the command-line INI reader

Open SysFile
Open FolderSelHeaA
Open FolderSelDtlA

Object oCmdLineIniFileExporter is a cRDCDbModalPanel
    Set Label to "Export Refactor Settings to CmdLine Ini-File"
    Set Size to 290 404
    Set piMinSize to 89 211
    Set Location to 1 2  
    Set Icon to "Export.ico"

    Object oOpenDialog is a OpenDialog
        Set Filter_String to "Ini Files|*.ini|.sws Files|*.sws|All Files|*.*"
        Set MultiSelect_State to False

        Procedure OnStartup
            // DFRefactor's own home - cmd-line ini-file lives next to the exe.
            tWorkspacePaths OrgWS
            Get pOrgWS of ghoApplication to OrgWS
            Set Initial_Folder to OrgWS.sPrograms
        End_Procedure
    End_Object

    Object oInfo_grp is a cRDCHeaderGroup
        Set Location to 4 19
        Set Size to 50 368
        Set Label to "Info"
        Set psImage to "ActionAbout.ico"
        
        Object oInfo_tb is a TextBox
            Set Location to 17 48
            Set Size to 28 314
            Set Auto_Size_State to False
            Set Justification_Mode to JMode_Left
            Set Label to "Dialog to export refactoring settings to an ini-file name, that can be used on the command line for this program (DFRefactor) with the '/bm' flag. The shown ini-file here is the default one, but it can be any file-name with an .ini extension and must include the full path."
        End_Object
        
    End_Object

    Object oIniFile_grp is a cRDCHeaderGroup
        Set Location to 63 19
        Set Size to 50 368
        Set Label to "Select Ini-file"
        Set psImage to "ActionOpen.ico" 
        Set psNote to "Export file name."

        Object oIniFile_fm is a cRDCForm
            Set Location to 29 77
            Set Size to 12 223
            Set Label to "Ini-File Name:"
            Set peAnchors to anTopLeftRight
            Set psToolTip to "Ini-file to export data to."
            
            Procedure OnStartup
                tWorkspacePaths OrgWS TargetWS
                
                Get pOrgWS of ghoApplication to OrgWS
                Get pTargetWS of ghoApplication to TargetWS
                /* Name from the TARGET workspace, folder from pOrgWS - DFRefactor's OWN
                   Programs folder, the one /bm searches for a bare file name. Shares
                   rfDefaultIniFileName with the FT exporter rather than repeating the splicing. */
                Set Value to (rfDefaultIniFileName(TargetWS.sSWSFile, OrgWS.sPrograms))
            End_Procedure
        
        End_Object
        
        Object oSelect_btn is a cRDCButton
            Set Location to 29 306
            Set Label to "Select"
            Set Size to 12 50
            Set peAnchors to anTopRight
        
            Procedure OnClick
                Boolean bOpen
                String[] asFileNames
                String sFileName
                Get Show_Dialog of oOpenDialog to bOpen
                If (bOpen = True) Begin
                    Get Selected_Files of oOpenDialog to asFileNames
                    Move asFileNames[0] to sFileName
                    Set Value of oIniFile_fm to sFileName    
                End
            End_Procedure
        
        End_Object
        
    End_Object

    Object oExportDetails_grp is a cRDCHeaderGroup
        Set Location to 122 19
        Set Size to 143 368
        Set Label to "Selections"
        Set psImage to "SelectAll.ico"

        Object oSWSFile_fm is a cRDCForm
            Set Location to 17 84
            Set Size to 12 223
            Set Label to ",SWS File:"
            Set psToolTip to "To change the .sws file, use the 'Current Workspace' combo-button in the program's toolbar."
            Set pbEnabled to False
            Set peAnchors to anTopLeftRight 
            Procedure OnStartup
                String sSWSFile
                Get psSWSFile of ghoApplication to sSWSFile
                Set Value to sSWSFile
            End_Procedure
        End_Object
        
        Object oUserName_fm is a cRDCForm
            Set Location to 31 84
            Set Size to 12 76
            Set Label to "User Name:"
            Procedure OnStartup
                String sUserName
                String sText
    
                Get psUserName of ghoApplication to sUserName
                Set Value to sUserName
    
                Append sText "The 'User Name' is used by index.2 for the FolderSelHea table, "
                Append sText "to find the workspace Home folder. FolderSelDtl is the child table "
                Append sText "that holds the actual folder selections. So folder selections for "
                Append sText "a workspace can be different for each user. This value CAN be changed here."
                Set psToolTip of (oInfoUserName_tb(Self)) to sText
            End_Procedure
        End_Object
        
        Object oInfoUserName_tb is a TextBox
            Set Size to 10 10
            Set Location to 33 163
            Set Bitmap to "ActionAbout.bmp"
        End_Object
        
        Object oSelectedFolders_fm is a cRDCForm
            Set Location to 45 84
            Set Size to 12 76
            Set Label to "Selected Folders:"
            Set pbEnabled to False
            Set psToolTip to "The number of selected folders for the current workspace"
            Procedure OnStartup
                String[] asFolders
                Get pasSelectedFolders of ghoApplication to asFolders
                Set Value to (SizeOfArray(asFolders))
            End_Procedure
        End_Object
        
        Object oInfoSelectedFolders_tb is a TextBox
            Set Size to 10 10
            Set Location to 47 163
            Set Bitmap to "ActionAbout.bmp"
            Set psToolTip to (psToolTip(oSelectedFolders_fm(Self)))
        End_Object
        
        Object oSelectedFunctions_fm is a cRDCForm
            Set Location to 59 84
            Set Size to 12 76
            Set Label to "Selected Functions:"
            Set pbEnabled to False
            Set psToolTip to "The current number of selected refactoring functions."
            Procedure OnStartup
                Set Value to SysFile.SelectedFunctionTotal
            End_Procedure
        End_Object
        
        Object oInfoSelectedFunctions_tb is a TextBox
            Set Size to 10 10
            Set Location to 61 163
            Set Bitmap to "ActionAbout.bmp"
            Set psToolTip to (psToolTip(oSelectedFunctions_fm(Self)))
        End_Object
        
        Object oSWSFile_cb is a cRDCCheckbox
            Set Location to 87 84
            Set Size to 10 50
            Set Label to "Export .sws File Name (See tooltips for explanations)"
            Set Checked_State to True
            Set psToolTip to "If an .sws file is not present in the ini-file, the name of the .sws file *must* be specified on the command line with the /sws flag."
        End_Object
        
        Object oFolders_cb is a cRDCCheckbox
            Set Location to 100 84
            Set Size to 10 50
            Set Label to "Export Selection of Source Code Folders"
            Set Checked_State to True
            Set psToolTip to "If omitted, the current selections of folders made for that workspace, will be used."
        End_Object
        
        Object oFilters_cb is a cRDCCheckbox
            Set Location to 113 84
            Set Size to 10 50
            Set Label to "Export File Filter Selections"
            Set Checked_State to True
            Set psToolTip to "If omitted, the current program's 'File Filter' settings will be used."
        End_Object
        
        Object oFunctions_cb is a cRDCCheckbox
            Set Location to 126 84
            Set Size to 10 50
            Set Label to "Export Selection of Refactoring Functions"
            Set Checked_State to True
            Set psToolTip to "If omitted, the current selections of refactoring functions will be used."
        End_Object

        Object oInfoSWSFile_tb is a TextBox
            Set Size to 10 10
            Set Location to 19 310
            Set Bitmap to "ActionAbout.bmp"
            Set psToolTip to (psToolTip(oSWSFile_fm(Self)))
            Set peAnchors to anTopRight 
        End_Object
        
    End_Object

    Object oExport_btn is a cRDCButton
        Set Size to 14 57
        Set Label    to "Export Data"
        Set Location to 270 275
        Set peAnchors to anBottomRight
        Set psImage to "Export.ico" 
        Set psToolTip to "Export data to ini-file."
        
        Procedure OnClick
            Integer iRetval
            String sFileName sSWSFile sRetval sUserName sScriptName sIniLeaf sFolder sMsg sNL
            Boolean bExists bOK bSWSFile bFunctions bFolders bFilters
            
            Get Checked_State of oSWSFile_cb to bSWSFile
            If (bSWSFile = True) Begin
                Get Value of oSWSFile_fm to sSWSFile
                Get vFilePathExists sSWSFile to bExists
                If (bExists = False) Begin
                    Send Info_Box ("The .sws file:" * sSWSFile * "doesn't exist. Cannot continue with this selection.")
                    Procedure_Return
                End
            End

            Get Value of oIniFile_fm to sFileName 
            Get vFilePathExists sFileName to bExists
            If (bExists = True) Begin
                Get YesNo_Box "The file already exists, overwrite?" to iRetval
                If (iRetval = MBR_No) Begin
                    Procedure_Return
                End
            End
            Get Value of oUserName_fm to sUserName
            Get Checked_State of oFolders_cb to bFolders
            Get Checked_State of oFilters_cb to bFilters
            Get Checked_State of oFunctions_cb to bFunctions
            Send Cursor_Wait of Cursor_Control
            Get ExportToIniFile sFileName bSWSFile sSWSFile sUserName bFolders bFilters bFunctions to sRetval
            Send Cursor_Ready of Cursor_Control
            If (not(Lowercase(sRetval) contains "error")) Begin
                Get RunnerScriptName of ghoApplication sFileName to sScriptName
                Get ParseFileName   sFileName to sIniLeaf
                Get ParseFolderName sFileName to sFolder
                Move (Character(10)) to sNL
                Move ("Settings exported." + sNL + sNL) to sMsg
                Move (sMsg + "   " + sIniLeaf + sNL) to sMsg
                Move (sMsg + "   " + sScriptName + "   (ready-to-run, for headless / build use)" + sNL + sNL) to sMsg
                // "" for a bare file name (the path field is editable) - drop the line
                // rather than print a dangling "in ".
                If (Trim(sFolder) <> "") ;
                    Move (sMsg + "in " + sFolder + sNL + sNL) to sMsg
                Move (sMsg + "Show them in Explorer?") to sMsg
                // Native YesNo_Box, not the FT build's FTYesNoBox - that lives in the
                // FlexTron library, which this program does not compile in.
                Get YesNo_Box sMsg "Export complete" MB_DEFBUTTON1 to iRetval
                If (iRetval = MBR_Yes) ;
                    Send RDCRevealInExplorer sFileName
            End
            Else Begin
                Send Info_Box sRetval "Export failed!"
            End
        End_Procedure

    End_Object

    Object oClose_btn is a cRDCButton
        Set Size to 14 50
        Set Location to 270 336
        Set Label    to "&Close"
        Set psToolTip to "Close panel"
        Set peAnchors to anBottomRight

        Procedure OnClick
           Send Close_Panel
        End_Procedure

    End_Object

    /* Clear a numbered section before it is rewritten - Folder Name1.., Function Name1..

       DeleteSection, NOT a loop of WriteString(key, ""). That loop wrote 1000 empty keys per
       section and cost 1000 whole-file rewrites, because DataFlex 26 changed cIniFile out from
       under it (Nils found it 2026-08-22, on an export that appeared to hang):

         DF25 - a thin wrapper over Kernel32 WritePrivateProfileStringW. An empty value did not
                leave a key behind, and each call was one API call.
         DF26 - a pure DataFlex in-memory array. SetValue with "" STORES key= , and every
                WriteString calls WriteToFile, rewriting the entire file.

       So the same loop that was harmless under DF25 produced a 36 KB ini of dead keys under
       DF26 and took minutes. DeleteSection is one call, exists in both 25.0 and 26.0, and says
       what this always meant. Re-exporting over a polluted ini heals it: the section goes
       first, then the real entries are written. */
    Procedure WipeExistingIniValues Handle hoIni String sSection
        Send DeleteSection of hoIni sSection
    End_Procedure
    
    Function ExportToIniFile String sFileName Boolean bSWSFile String sSWSFile String sUserName Boolean bFolders Boolean bFilters Boolean bFunctions Returns String
        Boolean bOK bExists
        Handle hoIni hoSpec
        String sHomePath sFilters sResultPath sSpec sExeName sIniName sSingleFile
        Boolean bWorkspaceMode
        Integer iCount
        
        Move False to Err
        Get Create (RefClass(cIniFile)) to hoIni
        Get Create (RefClass(cCmdLineIniFile)) to hoSpec  
        Set psFileName of hoIni to sFileName
        // ONE name for this build's executable - the Help syntax line and the
        // Run-DFRefactor.ps1 wrapper at the end both use it, so they cannot disagree.
        Move "DFRefactorx64.exe" to sExeName

        /* [Help] FIRST, so a freshly exported INI opens with the line that runs it.
           Nothing reads these keys - they are here because whoever opens this file next is
           usually not the person who exported it, and the switch is not guessable (Nils had
           to run with -h to find it). The syntax line names THIS file, so it can be copied
           straight to a command prompt. Written after Set psFileName because cIniFile
           errors on any write before the file name is known. */
        Get ParseFileName sFileName to sIniName
        Send WriteString of hoIni CS_CmdIniHelpSection CS_CmdIniHelpSyntax   (sExeName * "/bm" * sIniName)
        Send WriteString of hoIni CS_CmdIniHelpSection CS_CmdIniHelpSwitches CS_CmdIniHelpSwitchesText
        Send WriteString of hoIni CS_CmdIniHelpSection CS_CmdIniHelpResult   CS_CmdIniHelpResultText
        Send WriteString of hoIni CS_CmdIniHelpSection CS_CmdIniHelpWrapper  CS_CmdIniHelpWrapperText
        Send WriteString of hoIni CS_CmdIniHelpSection CS_CmdIniHelpCreatedBy CS_CmdIniHelpCreatedByText

        If (bSWSFile = True) Begin
            Send WriteString of hoIni CS_CmdIniSWSFileSection CS_CmdIniSWSFile sSWSFile
        End

        /* [Single File Section] - written from the mode the program is actually in, with no
           checkbox of its own. "Export these settings" means exactly that: if the user is working
           on one file rather than a workspace, the INI should say so, and the reader gives that
           file precedence over the .sws.

           WRITTEN EVEN WHEN BLANK, on purpose. Re-exporting a workspace-mode session over an INI
           that once named a single file has to CLEAR it - otherwise the stale name silently wins
           over the .sws on the next headless run, which is the failure this section is supposed
           to prevent rather than cause. */
        Get pbWorkspaceMode of ghoApplication to bWorkspaceMode
        Move "" to sSingleFile
        If (bWorkspaceMode = False) ;
            Get psCurrentSourceFileName of ghoApplication to sSingleFile
        Send WriteString of hoIni CS_CmdIniSingleFileSection CS_CmdIniSingleFileName sSingleFile

        If (bFolders = True) Begin
            // Start by wiping any existing folder selections from the ini-file:
            Send WipeExistingIniValues hoIni CS_CmdIniFoldersSection
            
            If (sUserName = "") Begin
                Get psUserName of ghoApplication to sUserName
            End
            Send WriteString of hoIni CS_CmdIniUserSection CS_CmdIniUserName sUserName       
                
            Get psHomeTarget of ghoApplication to sHomePath 
            Clear FolderSelHeaA
            Move sUserName to FolderSelHeaA.UserName
            Move sHomePath to FolderSelHeaA.WorkspaceHomeFolder
            Find eq FolderSelHeaA by Index.2
            
            Constraint_Set (Self) Clear
            Constrained_Clear eq FolderSelDtlA by Index.3
            If (Found = False) Begin
                Function_Return ("Error. The FolderSelHeaA record could not be found for User name:" * String(sUserName) + "\and workspace Home path:" * String(sHomePath))
            End                   
            Constrain FolderSelDtlA.FolderSelHeaID eq FolderSelHeaA.ID
            Constrain FolderSelDtlA.bSelected eq 1
            Constrained_Find First FolderSelDtlA by Index.3
            Move 1 to iCount
            While (Found = True)
                Send WriteString of hoIni CS_CmdIniFoldersSection (CS_CmdIniFolderName + String(iCount)) (Trim(FolderSelDtlA.FolderName))
                Increment iCount  
                Constrained_Find Next
            Loop
        End 
        
        If (bFilters = True) Begin
            Move (Trim(SysFile.FileExtensionFilter)) to sFilters
            Send WriteString of hoIni CS_CmdIniFileFilterSection CS_CmdIniFileFilters sFilters
        End   
        
        If (bFunctions = True) Begin
            // Start by wiping any existing function selections from the ini-file:
            Send WipeExistingIniValues hoIni CS_CmdIniFunctionSection
            
            Move 1 to iCount
            Constraint_Set (Self +1) Clear
            Constrained_Clear eq FunctionsA by Index.3
            Constrain FunctionsA.Selected eq 1
            Constrained_Find First FunctionsA by Index.3
            While (Found = True)
                // ONE encoder for both halves of the feed - the reader decodes with the
                // same class, so the "Name,Parameter" rule cannot drift between them.
                Get EncodeFunctionSpec of hoSpec (Trim(FunctionsA.Function_Name)) (Trim(FunctionsA.Parameter)) to sSpec
                Send WriteString of hoIni CS_CmdIniFunctionSection (CS_CmdInitFunction + String(iCount)) sSpec
                Increment iCount  
                Constrained_Find Next
            Loop
        End

        // Default result file = "Result.txt" beside the INI, so an exported INI is build-ready (the run
        // records its outcome there and Run-DFRefactor.ps1 reads it back).
        Get BatchResultPathForIni of ghoApplication sFileName to sResultPath
        Send WriteString of hoIni CS_CmdIniResultSection CS_CmdIniResultFile sResultPath

        Send Destroy of hoIni
        Send Destroy of hoSpec

        // Drop a ready-to-run wrapper next to the INI, pre-filled to this INI, so the exported pair is build-ready.
        Send WriteRunnerScript of ghoApplication sFileName sResultPath sExeName
        Function_Return (Err = False)
    End_Function

    Procedure Popup
        Broadcast Recursive Send OnStartup
        Forward Send Popup
    End_Procedure

    On_Key Key_Alt+Key_C Send KeyAction of oClose_btn
End_Object
