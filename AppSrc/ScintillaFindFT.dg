// ScintillaFindFT.dg
//
// The FlexTron twin of ScintillaFind.dg, the editor's Find dialog: the same search combo, options,
// Direction group and RequestDetails, on an FT panel, with Find, Mark All and Cancel as framework
// buttons (cFTWebButton, RDCFlexTron) on a grid host of 8 px columns.
//
// HOW DFRefactorFT GETS THIS ONE, as DropSelfConfirmFT.dg and ScintillaGotoFT.dg:
// cRefactorEditorCommands.pkg Uses the dialog itself, and every program that edits code gets it
// through that package. DFRefactorFT.src Uses this file BEFORE it, this file defines
// C_OwnFindDialog, and the package then leaves ScintillaFind.dg out. Both files define oFindDialog -
// the package reaches the dialog by that name - so the two must never both be in: used after the
// package, this file stops the build (below).
//
// LAID OUT as Go To Line's twin: the controls as they were, and the buttons in a bar at the bottom
// right (the original stacked them at the right). A fixed size - a resizable FT panel gets a status
// bar under it. The Direction group is the original's, as a cFTRadioGroup, with each radio's caption
// beside it, as the check boxes have theirs. Nothing reads its answer yet (the editor searches
// forward, and F3 / Shift+F3 go either way) - left as it is for now (Nils 2026-09-30).
Use Windows.pkg
Use RefactorMessageQueue.pkg
Use ScintillaFindControls.pkg
Use cFTModalPanel.pkg
Use cFTCheckBoxCaption.pkg      // a check box's caption the FT colours reach
Use cFTRadioCaption.pkg         // a radio's caption the FT colours reach (RDCFlexTron 0.9.10)
Use cFTRadioGroup.pkg           // a radio group's caption the FT colours reach (RDCFlexTron 0.9.11)
Use cFTGridHost.pkg             // the buttons' host - a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg  // cFTWebButton - Find, Mark All and Cancel

// cRefactorEditorCommands.pkg declares tDropSelfResponse. If it exists already, the package is in the
// program and has brought ScintillaFind.dg with it - there would be two oFindDialog.
#IFDEF _STRUCT_tDropSelfResponse
#ERROR DFERR_PROGRAM "Use ScintillaFindFT.dg before the editor packages - ScintillaFind.dg is in the program already."
#ENDIF

// Tells cRefactorEditorCommands.pkg to leave ScintillaFind.dg out.
Define C_OwnFindDialog for 1

Object oFindDialog is a cFTModalPanel
    Set Size to 102 215
    Set Label to "Find"
    Set Location to 44 47
    Set Border_Style to Border_Dialog
    //Set Locate_Mode to POPUP_LOCATE -- locate mode isn't smart enough
    Property Boolean pbStartFind
    Property Boolean pbMarkAll

    Object oSearchFm is a cFindComboForm
      Set Size to 13 160
      Set Location to 10 45
      Set Label to "W&hat:"
      Set Label_Col_Offset to 2
      Set Label_Justification_Mode to JMode_Right
      On_Key kEnter Send DoFind       // Enter finds - see the buttons below

      /* The dialog's dark colours are refused, as cFTComboForm refuses them (Nils 2026-08-22): Windows
         paints a combo's drop-down list itself, dark but with black text. The combo stays light, and the
         searches it remembers stay readable. Its label is given the FT ink below (FTColorChildren). */
      Procedure Set Color Integer iColor
      End_Procedure

      Procedure Set TextColor Integer iColor
      End_Procedure
    End_Object

    /* THE FOUR OPTIONS: a check box, and its caption beside it (cFTCheckBoxCaption). A check box draws
       its own caption in the Windows theme's colour - dark on the dark ground - so the caption is a
       TextBox the panel's FT ink reaches. A click on a caption ticks its box; Alt+W, C, E and L still
       tick them (below). */
    Object oWordMatchCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 26 45
      Set Label to ""
      On_Key kEnter Send DoFind       // Enter finds - see the buttons below
    End_Object

    Object oWordMatch_tb is a cFTCheckBoxCaption
      Set Location to 27 56
      Set Label to "Match whole word only"
      Set phoCheckBox to (oWordMatchCb(Self))
    End_Object

    Object oMatchCaseCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 37 45
      Set Label to ""
      On_Key kEnter Send DoFind       // Enter finds - see the buttons below
    End_Object

    Object oMatchCase_tb is a cFTCheckBoxCaption
      Set Location to 38 56
      Set Label to "Match case"
      Set phoCheckBox to (oMatchCaseCb(Self))
    End_Object

    Object oRegExCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 48 45
      Set Label to ""
      On_Key kEnter Send DoFind       // Enter finds - see the buttons below
    End_Object

    Object oRegEx_tb is a cFTCheckBoxCaption
      Set Location to 49 56
      Set Label to "Regular expression"
      Set phoCheckBox to (oRegExCb(Self))
    End_Object

    Object oDocumentStartCb is a cFindCheckBox
      Set Size to 10 10
      Set Location to 59 45
      Set Label to ""
      On_Key kEnter Send DoFind       // Enter finds - see the buttons below
    End_Object

    Object oDocumentStart_tb is a cFTCheckBoxCaption
      Set Location to 60 56
      Set Label to "Start at first line"
      Set phoCheckBox to (oDocumentStartCb(Self))
    End_Object

    /* THE DIRECTION: each radio with its caption beside it (cFTRadioCaption), as the check boxes have
       theirs - a radio, too, draws its own caption in the Windows theme's colour. A click on a caption
       selects its radio. The group box draws its caption in that colour as well, so the group is a
       cFTRadioGroup: it shows its Label in a TextBox over the frame's top line. */
    Object oDirectionGrp is a cFTRadioGroup
      Set Size to 45 65
      Set Location to 24 140
      Set Label to "Direction"
        Set peAnchors to anTopLeftRight

      Object oUpRadio is a Radio
        Set Size to 10 10
        Set Location to 14 10
        Set Label to ""
      End_Object

      Object oUp_tb is a cFTRadioCaption
        Set Location to 15 21
        Set Label to "Up"
        Set phoRadio to (oUpRadio(Self))
      End_Object

      Object oDownRadio is a Radio
        Set Size to 10 10
        Set Location to 26 10
        Set Label to ""
      End_Object

      Object oDown_tb is a cFTRadioCaption
        Set Location to 27 21
        Set Label to "Down"
        Set phoRadio to (oDownRadio(Self))
      End_Object

      On_Key kEnter Send DoFind       // Enter on either radio finds - see the buttons below
    End_Object

    /* FIND / MARK ALL / CANCEL at the bottom right - framework buttons on a grid host of 8 px columns,
       right-aligned with the search combo. Find keeps the default it had: Enter finds (bound on the combo,
       the check boxes and the Direction group, not on the panel - a web button that has the focus takes
       its own Enter), and Find wears the main action's amber. Each runs in OnButtonClick, after the web
       click has returned (the library's click relay) - closing the panel cannot happen inside the click.
       The spans fit the captions: Find at the 78 px minimum, Mark All and Cancel with their glyphs. */
    Object oFindButtons is a cFTGridHost
        Set Location to 74 10
        Set Size to 20 200
        Set piColumnCount to 37         // column 0, then Find's 11, Mark All's 13 and Cancel's 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oFindBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Find"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-search"
            Set psToolTip to "Find the next occurrence. Enter does the same."

            Procedure OnButtonClick
                Send DoFind of oFindDialog
            End_Procedure
        End_Object

        Object oMarkAllBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 13
            Set psCaption to "Mark All"
            Set psCSSClass to "ftbtn ftg-selectall"
            Set psToolTip to "Mark every occurrence in the file."

            Procedure OnButtonClick
                Send DoMarkAll of oFindDialog
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 25
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close without searching."

            Procedure OnButtonClick
                Send DoCancel of oFindDialog
            End_Procedure
        End_Object
    End_Object

    // Find: remember the search text, and close to search.
    Procedure DoFind
        String sValue
        Get Value of oSearchFm to sValue          // if the user types or changes the search string we should
        Send AddSearchString of oSearchFm sValue  // store it in the array for next time.
        Set pbStartFind to True
        Send Close_Panel
    End_Procedure

    // Mark All: close to mark every occurrence.
    Procedure DoMarkAll
        Set pbStartFind to True
        Set pbMarkAll   to True
        Send Close_Panel
    End_Procedure

    // Cancel - the button, Esc or the window's X: close without searching.
    Procedure DoCancel
        Send Close_Panel
    End_Procedure

    On_Key Key_Alt+Key_H Send Activate  of oSearchFm
    On_Key Key_Alt+Key_W Send doToggle  of oWordMatchCb
    On_Key Key_Alt+Key_C Send doToggle  of oMatchCaseCb
    On_Key Key_Alt+Key_E Send doToggle  of oRegExCb
    On_Key Key_Alt+Key_L Send doToggle  of oDocumentStartCb
    //On_Key Key_Alt+Key_U Send Activate  of oUpRadio
    //On_Key Key_Alt+Key_D Send Activate  of oDownRadio
    On_Key Key_Alt+Key_F Send DoFind
    On_Key Key_Alt+Key_M Send DoMarkAll
    On_Key kCancel       Send DoCancel

    /* THE COMBO'S LABEL takes its colour from its parent - this panel (Label_TextColor clNone) - and the
       panel's FTColorChildren gives the FT ink to the children, not to the panel itself: on the dark
       ground the label would stay dark. So it gets the ink here, each time the children get theirs. */
    Procedure FTColorChildren
        Forward Send FTColorChildren
        Set Label_TextColor of oSearchFm to (FTThemeInk())
    End_Procedure

    Procedure SettingsToOptions tFindReplaceOptions ByRef Options
      Get Value         of oSearchFm        to Options.sSearchText
      Move ""                               To Options.sReplaceText
      Get Checked_State of oWordMatchCb     to Options.bWordMatch
      Get Checked_State of oMatchCaseCb     to Options.bMatchCase
      Get Checked_State of oRegExCb         to Options.bRegExp
      Get Checked_State of oDocumentStartCb to Options.bDocumentStart
      Get Current_Radio of oDirectionGrp    to Options.eFindOptions
      Get pbMarkAll                         to Options.bMarkAll
    End_Procedure

    Procedure RequestDetails tFindReplaceOptions ByRef Options
      Boolean bStartFind

      Set pbStartFind to False
      set pbMarkAll   to False
      Set SearchValue   of oSearchFm        to Options.sSearchText
      Set Checked_State of oWordMatchCb     to Options.bWordMatch
      Set Checked_State of oMatchCaseCb     to Options.bMatchCase
      Set Checked_State of oRegExCb         to Options.bRegExp
      Set Checked_State of oDocumentStartCb to Options.bDocumentStart
      Set Current_Radio of oDirectionGrp    to Options.eFindOptions
      Send Popup
      Send SettingsToOptions (&Options)
      Get pbStartFind to bStartFind
      If (bStartFind) Begin
        Move True to Options.bStartFind
      End
    End_Procedure

End_Object
