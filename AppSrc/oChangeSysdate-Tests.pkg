// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeSysdate is a cTestFixture
        Set psFunctionName to "ChangeSysdate"

        // Single-var Sysdate command -> Move (Date(CurrentDateTime())) to <var>.
        {Published = True}
        Procedure ChangeSysdate_Sysdate_SingleVar
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate dToday' to sLine
            Move 'Move (Date(CurrentDateTime())) to dToday' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Sysdate4 (the 4-digit form) converts to the SAME modern function.
        {Published = True}
        Procedure ChangeSysdate_Sysdate4_SingleVar
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate4 dToday' to sLine
            Move 'Move (Date(CurrentDateTime())) to dToday' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation (the nose) must be preserved.
        {Published = True}
        Procedure ChangeSysdate_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Sysdate dToday' to sLine
            Move '    Move (Date(CurrentDateTime())) to dToday' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A file.field receiver is one token and rides through intact.
        {Published = True}
        Procedure ChangeSysdate_FileFieldDest
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate Customer.Order_Date' to sLine
            Move 'Move (Date(CurrentDateTime())) to Customer.Order_Date' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A trailing end-comment survives the single-var conversion (it is not swallowed).
        {Published = True}
        Procedure ChangeSysdate_PreservesEndComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate dToday // set at startup' to sLine
            Move 'Move (Date(CurrentDateTime())) to dToday // set at startup' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* THE Date() WRAP IS UNCONDITIONAL, and these two exist to say why.

           A unit test cannot check the thing that actually goes wrong. The converter is
           line-by-line and never sees the receiver's DECLARATION, so the emitted text is identical
           whether the target is a Date, a DateTime or a String - which is exactly the reason the
           wrap has to be there. What the runtime does with it differs:

               Date     the assignment truncates anyway; the wrapper is redundant, harmless
               DateTime unwrapped would keep a time SysDate never set
               String   unwrapped would write "07/30/2026 14:23:45" where SysDate wrote the date

           So these pin the INVARIANT instead: the wrap does not depend on the receiver looking
           like a date. Without them, every expectation in this fixture uses a d-prefixed name and
           a reader could take the wrap for incidental - and the String case, the one that fails
           silently at runtime, is the one nobody would think to add later. */
        {Published = True}
        Procedure ChangeSysdate_StringLikeReceiver_StillWrapped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate sToday' to sLine
            Move 'Move (Date(CurrentDateTime())) to sToday' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Same invariant on the date+time block's FIRST line - the other place the date is
        // assigned, and the one added later, so it could drift apart from the single-var path.
        {Published = True}
        Procedure ChangeSysdate_DateTimeForm_FirstLineWrapped
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate sToday sHour' to sLine
            Move '//Sysdate sToday sHour' to sExpected
            Append sExpected (Character(13) + Character(10)) 'Move (Date(CurrentDateTime())) to sToday'
            Append sExpected (Character(13) + Character(10)) 'Move (DateGetHour(CurrentDateTime())) to sHour'
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* THE DATE+TIME FORM CONVERTS NOW (Nils 2026-07-30) - it used to get only a TODO comment.
           The legacy syntax fixes what each position means:

               SysDate {dtDate} [{iHour} [{iMinute} [{iSecond}]]]

           so two receivers or four, the mapping is known. The original is left commented above the
           block, which is also what makes the four separate clock reads inspectable. */
        {Published = True}
        Procedure ChangeSysdate_DateTimeForm_TwoArgs_Converted
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Sysdate dDate tTime' to sLine
            Move '//Sysdate dDate tTime' to sExpected
            Append sExpected (Character(13) + Character(10)) 'Move (Date(CurrentDateTime())) to dDate'
            Append sExpected (Character(13) + Character(10)) 'Move (DateGetHour(CurrentDateTime())) to tTime'
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // All four receivers - the full documented syntax, indented, so the block inherits the
        // original indentation on every emitted line.
        {Published = True}
        Procedure ChangeSysdate_DateTimeForm_FourArgs_Converted
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Sysdate sDate sHour sMin sSec' to sLine
            Move '//    Sysdate sDate sHour sMin sSec' to sExpected
            Append sExpected (Character(13) + Character(10)) '    Move (Date(CurrentDateTime())) to sDate'
            Append sExpected (Character(13) + Character(10)) '    Move (DateGetHour(CurrentDateTime())) to sHour'
            Append sExpected (Character(13) + Character(10)) '    Move (DateGetMinute(CurrentDateTime())) to sMin'
            Append sExpected (Character(13) + Character(10)) '    Move (DateGetSecond(CurrentDateTime())) to sSec'
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // SYSDATE4 with the date+time form converts too - the dead name disappears with the whole
        // line, so the old Sysdate4->Sysdate half-step is no longer needed on this path.
        {Published = True}
        Procedure ChangeSysdate_Sysdate4_DateTimeForm_Converted
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Sysdate4 datum tim min' to sLine
            Move '//    Sysdate4 datum tim min' to sExpected
            Append sExpected (Character(13) + Character(10)) '    Move (Date(CurrentDateTime())) to datum'
            Append sExpected (Character(13) + Character(10)) '    Move (DateGetHour(CurrentDateTime())) to tim'
            Append sExpected (Character(13) + Character(10)) '    Move (DateGetMinute(CurrentDateTime())) to min'
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // MORE than four arguments is not the documented syntax, so it keeps the old
        // leave-it-and-say-so behaviour rather than guessing what the extras mean. Idempotent.
        {Published = True}
        Procedure ChangeSysdate_MoreThanFourArgs_StillMarked
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            Move 'Sysdate a b c d e' to sLine
            Move 'Sysdate a b c d e // TODO (DFRefactor): Sysdate date+time form - convert by hand to CurrentDateTime()' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
            // Second pass - the marker guard fires, nothing changes.
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Comment line: bLineIsReady guard fires, line unchanged, return False.
        {Published = True}
        Procedure ChangeSysdate_NoChange_Comment
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '// Sysdate dToday' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '// Sysdate dToday' sLine
        End_Procedure

        // Variable declaration: bIsVariableDeclaration guard fires, line unchanged.
        {Published = True}
        Procedure ChangeSysdate_NoChange_VariableDecl
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Date Sysdate4' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeSysdate of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Date Sysdate4' sLine
        End_Procedure

    End_Object
