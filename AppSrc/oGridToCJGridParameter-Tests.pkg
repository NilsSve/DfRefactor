Use cListToCJGrid.pkg                  // the empty-parameter tests drive all four converters
Use cDbListTocDbCJGridPromptList.pkg
Use cClassPackageIndex.pkg             // ClassesInPackage, the converters' dead-Use question
    Object oGridToCJGridParameter is a cTestFixture
        Set psFunctionName to "cGridToCJGridBase.ParseAndSetParameter"

        // A fresh instance per test - ParseAndSetParameter SETS properties, so a shared one
        // would let an earlier case decide a later one's starting point.
        Function Helper Returns Handle
            Handle ho
            Get Create (RefClass(cGridToCJGridBase)) to ho
            Function_Return ho
        End_Function

        /* Empty parameter = "use the subclass defaults", NOT an error. psLegacyGridClass is
           deliberately blanked to switch the converter to pattern-based detection; the two
           target classes keep the constructor's values. */
        {Published = True}
        Procedure GridParam_EmptyKeepsDefaults
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert bOk
            Send AssertSAreEqual ""              (psLegacyGridClass(ho))
            Send AssertSAreEqual "cCJGrid"       (psTargetGridClass(ho))
            Send AssertSAreEqual "cCJGridColumn" (psTargetColumnClass(ho))
            Send Destroy of ho
        End_Procedure

        // Two parts: old + new grid. The column class is NOT touched, so it keeps the
        // subclass default rather than being blanked.
        {Published = True}
        Procedure GridParam_TwoPartsLeavesColumnAlone
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "Grid,cCJGrid" to bOk
            Send Assert bOk
            Send AssertSAreEqual "grid"          (psLegacyGridClass(ho))
            Send AssertSAreEqual "cCJGrid"       (psTargetGridClass(ho))
            Send AssertSAreEqual "cCJGridColumn" (psTargetColumnClass(ho))
            Send Destroy of ho
        End_Procedure

        /* AN EMPTY PARAMETER REACHES THE SUBCLASSES THE SCAN LEARNED (Nils 2026-09-05: "a legacy grid should
           be handled the same way as a legacy dbgrid, when no params are being specified"). The funclib's
           pair arrays stand in for the Deep Scan here. Grid / List: the plain class + the learned set, never
           the modern classes, never a mere name ending; dbGrid / dbList: their name pattern + the learned
           set (a subclass under another name). A NAMED parameter narrows the run to that class. */
        {Published = True}
        Procedure GridParam_EmptyParameterReachesTheScansSubclasses
            String[] asNames asRoots asNone
            Handle ho
            Boolean bOk
            Move "ceditgrid"  to asNames[0]
            Move "grid"       to asRoots[0]
            Move "cdatatable" to asNames[1]
            Move "dbgrid"     to asRoots[1]
            Move "mylist"     to asNames[2]
            Move "list"       to asRoots[2]
            Move "cpicktable" to asNames[3]
            Move "dblist"     to asRoots[3]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            // Grid
            Get Create of ghoFuncLib (RefClass(cGridToCJGrid)) to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert bOk
            Send Assert (IsGridDeclaration(ho, "object o is a grid"))                  "the plain class"
            Send Assert (IsGridDeclaration(ho, "object o is a ceditgrid"))             "a learned Grid subclass"
            Send Assert (IsGridDeclaration(ho, "object o is an ceditgrid"))            "either article"
            Send Assert (not(IsGridDeclaration(ho, "object o is a ccjgrid")))          "the modern class is never touched"
            Send Assert (not(IsGridDeclaration(ho, "object o is a othergrid")))        "a name ending in grid is not enough"
            Send Assert (not(IsGridDeclaration(ho, "object o is a cdatatable")))       "another family's subclass is not this converter's"
            Get ParseAndSetParameter of ho "Grid,cCJGrid,cCJGridColumn" to bOk
            Send Assert bOk
            Send Assert (IsGridDeclaration(ho, "object o is a grid"))                  "the named class"
            Send Assert (not(IsGridDeclaration(ho, "object o is a ceditgrid")))        "a named parameter narrows the run to that class"
            Send Destroy of ho
            // dbGrid: the name pattern AND the learned set
            Get Create of ghoFuncLib (RefClass(cDbGridTocDbCJGrid)) to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert bOk
            Send Assert (IsGridDeclaration(ho, "object o is a mydbgrid"))              "the name pattern still applies"
            Send Assert (IsGridDeclaration(ho, "object o is a cdatatable"))            "a learned dbGrid subclass under another name"
            Send Assert (not(IsGridDeclaration(ho, "object o is a ceditgrid")))        "a Grid subclass is not a dbGrid"
            Send Destroy of ho
            // List and dbList alike
            Get Create of ghoFuncLib (RefClass(cListToCJGrid)) to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert bOk
            Send Assert (IsGridDeclaration(ho, "object o is a list"))                  "the plain List"
            Send Assert (IsGridDeclaration(ho, "object o is a mylist"))                "a learned List subclass"
            Send Assert (not(IsGridDeclaration(ho, "object o is a cdbcjgridpromptlist"))) "modern output"
            Send Destroy of ho
            Get Create of ghoFuncLib (RefClass(cDbListTocDbCJGridPromptList)) to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert bOk
            Send Assert (IsGridDeclaration(ho, "object o is a mydblist"))              "the dbList name pattern"
            Send Assert (IsGridDeclaration(ho, "object o is a cpicktable"))            "a learned dbList subclass under another name"
            Send Destroy of ho
            // the funclib goes back to knowing nothing: the plain class only, as before
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
            Get Create of ghoFuncLib (RefClass(cGridToCJGrid)) to ho
            Get ParseAndSetParameter of ho "" to bOk
            Send Assert (IsGridDeclaration(ho, "object o is a grid"))                  "plain Grid without a scan"
            Send Assert (not(IsGridDeclaration(ho, "object o is a ceditgrid")))        "nothing learned, nothing more"
            Send Destroy of ho
        End_Procedure

        /* AN EMPTY PARAMETER LEAVES A SUBCLASS OBJECT AS IT IS, in all four converters (Nils 2026-10-03: "a
           subclass can't be blindly swapped for a CodeJock grid class without first have converted the
           cEntryGrid subclass"). Detection above still REACHES the subclass - so the run can name it - but
           the transform leaves it: one file per converter holds a plain object and a subclass object; the
           plain one converts, the subclass one comes back as written, and the run's tally names it. */
        Procedure _AssertEmptyRunLeavesSubclass Handle ho String sPlain String sSub String sTarget
            String[] asIn asOut asLeft
            Integer  iGrids
            Boolean  bOk

            Send _ClearSubclassesLeft of ho
            Get ParseAndSetParameter of ho "" to bOk
            Move ("Object oPlain is a " + sPlain) to asIn[0]
            Move "End_Object"                     to asIn[1]
            Move ("Object oSub is a " + sSub)     to asIn[2]
            Move "    Set Size to 10 20"          to asIn[3]
            Move "End_Object"                     to asIn[4]
            Set pasSource of ho to asIn
            Get TransformSource of ho to iGrids
            Get pasSource of ho to asOut
            Get pasSubclassLeftNames of ho to asLeft
            Send Assert (iGrids = 1) ("only the plain " + sPlain + " converts beside " + sSub)
            Send Assert (SearchArray(("Object oPlain is a " + sTarget), asOut) <> -1) ("the plain " + sPlain + " becomes a " + sTarget)
            Send Assert (SearchArray(("Object oSub is a " + sSub), asOut) <> -1) ("the " + sSub + " object keeps its class")
            Send Assert (SearchArray("    Set Size to 10 20", asOut) <> -1) ("the " + sSub + " object's body is as written")
            Send Assert (SearchArray(sSub, asLeft) <> -1) ("the run's tally names " + sSub)
        End_Procedure

        {Published = True}
        Procedure GridParam_EmptyParameterLeavesSubclassObjects
            String[] asNames asRoots asNone
            Handle ho

            Move "ceditgrid"  to asNames[0]
            Move "grid"       to asRoots[0]
            Move "cdatatable" to asNames[1]
            Move "dbgrid"     to asRoots[1]
            Move "mylist"     to asNames[2]
            Move "list"       to asRoots[2]
            Move "cpicktable" to asNames[3]
            Move "dblist"     to asRoots[3]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            // Grid: a learned subclass
            Get Create of ghoFuncLib (RefClass(cGridToCJGrid)) to ho
            Send _AssertEmptyRunLeavesSubclass ho "Grid" "cEditGrid" "cCJGrid"
            Send Destroy of ho
            // dbGrid: a name that ends in the token, and a learned subclass under another name
            Get Create of ghoFuncLib (RefClass(cDbGridTocDbCJGrid)) to ho
            Send _AssertEmptyRunLeavesSubclass ho "dbGrid" "cMyDbGrid" "cDbCJGrid"
            Send _AssertEmptyRunLeavesSubclass ho "dbGrid" "cDataTable" "cDbCJGrid"
            Send Destroy of ho
            // List: a learned subclass
            Get Create of ghoFuncLib (RefClass(cListToCJGrid)) to ho
            Send _AssertEmptyRunLeavesSubclass ho "List" "myList" "cCJGrid"
            Send Destroy of ho
            // dbList: a name that ends in the token, and a learned subclass under another name
            Get Create of ghoFuncLib (RefClass(cDbListTocDbCJGridPromptList)) to ho
            Send _AssertEmptyRunLeavesSubclass ho "dbList" "cMyDbList" "cDbCJGridPromptList"
            Send _AssertEmptyRunLeavesSubclass ho "dbList" "cPickTable" "cDbCJGridPromptList"
            Send Destroy of ho
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
        End_Procedure

        // A stand-in for the FT deep-scan driver: answers the funclib's question with a fixed pair list.
        Object oStubSubclassSource is a cObject
            Procedure LearnedSubclassPairs String[] ByRef asNames String[] ByRef asRoots
                Move "cstubgrid" to asNames[0]
                Move "grid"      to asRoots[0]
                Move "cstubedit" to asNames[1]
                Move "edit"      to asRoots[1]
            End_Procedure
        End_Object

        // The funclib asks its registered source (the deep-scan driver in the app), else its own arrays.
        {Published = True}
        Procedure FuncLib_LearnedSubclassesOf_AsksTheRegisteredSource
            String[] asOut
            Set phoSubclassSource of ghoFuncLib to (oStubSubclassSource(Self))
            Get LearnedSubclassesOf of ghoFuncLib "GRID" to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "cstubgrid" asOut[0]
            Get LearnedSubclassesOf of ghoFuncLib "edit" to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send AssertSAreEqual "cstubedit" asOut[0]
            Get LearnedSubclassesOf of ghoFuncLib "list" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Set phoSubclassSource of ghoFuncLib to 0
            Get LearnedSubclassesOf of ghoFuncLib "grid" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        // The summary's count word: declared once per function, replaced on a second call, "" when none,
        // gone after _InitializeFuncLib (a new run starts clean).
        {Published = True}
        Procedure FuncLib_SummaryUnit_DeclaredPerFunction
            String sUnit
            Send SetSummaryUnit of ghoFuncLib "RefactorGridToCJGrid" "grid object(s)"
            Send SetSummaryUnit of ghoFuncLib "RefactorGridToCJGrid" "grid object(s)"
            Send SetSummaryUnit of ghoFuncLib "RefactorEditTocTextEdit" "declaration(s)"
            Get SummaryUnit of ghoFuncLib "refactorgridtocjgrid" to sUnit
            Send AssertSAreEqual "grid object(s)" sUnit
            Get SummaryUnit of ghoFuncLib "RefactorEditTocTextEdit" to sUnit
            Send AssertSAreEqual "declaration(s)" sUnit
            Get SummaryUnit of ghoFuncLib "ChangeTrimCommandToFunction" to sUnit
            Send AssertSAreEqual "" sUnit
            Send SetSummaryUnit of ghoFuncLib "" "nothing"
            Get SummaryUnit of ghoFuncLib "" to sUnit
            Send AssertSAreEqual "" sUnit
            Send _InitializeFuncLib of ghoFuncLib
            Get SummaryUnit of ghoFuncLib "RefactorGridToCJGrid" to sUnit
            Send AssertSAreEqual "" sUnit
        End_Procedure

        // The class index answers the reverse question too: what one package file defines.
        {Published = True}
        Procedure ClassIndex_ClassesInPackage
            Handle ho
            String[] asKeys asOut
            Get Create (RefClass(cClassPackageIndex)) to ho
            Move "CEDITGRID|cEditGrid.pkg"       to asKeys[0]
            Move "CEDITGRIDHELPER|cEditGrid.pkg" to asKeys[1]
            Move "CBUSYGRID|cBusyGrid.pkg"       to asKeys[2]
            Move (SortArray(asKeys)) to asKeys
            Set pasClassKeys of ho to asKeys
            Get ClassesInPackage of ho "ceditgrid.PKG" to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            Send AssertSAreEqual "CEDITGRID"       asOut[0]
            Send AssertSAreEqual "CEDITGRIDHELPER" asOut[1]
            Get ClassesInPackage of ho "cBusyGrid.pkg" to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Get ClassesInPackage of ho "nothere.pkg" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Get ClassesInPackage of ho "" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Destroy of ho
        End_Procedure

        {Published = True}
        Procedure GridParam_ThreePartsSetsAll
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "dbGrid,cDbCJGrid,cDbCJGridColumn" to bOk
            Send Assert bOk
            Send AssertSAreEqual "dbgrid"          (psLegacyGridClass(ho))
            Send AssertSAreEqual "cDbCJGrid"       (psTargetGridClass(ho))
            Send AssertSAreEqual "cDbCJGridColumn" (psTargetColumnClass(ho))
            Send Destroy of ho
        End_Procedure

        /* THE LEGACY CLASS IS LOWERCASED, the target classes are NOT. The comparison against
           source code is case-insensitive, but the target names are EMITTED into source, so
           their casing has to survive exactly as typed. */
        {Published = True}
        Procedure GridParam_OldLowercasedTargetsVerbatim
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "DBGRID,cDbCJGrid,cDbCJGridColumn" to bOk
            Send Assert bOk
            Send AssertSAreEqual "dbgrid"    (psLegacyGridClass(ho))
            Send AssertSAreEqual "cDbCJGrid" (psTargetGridClass(ho))
            Send Destroy of ho
        End_Procedure

        /* Stray spaces around the parts are trimmed. This is Nils's REAL INI line, which read
           "RefactorGridToCJGrid,Grid,cCJGrid, cCJGridColumn" - a space after the second comma.
           Untrimmed it would emit "Object oFoo is a  cCJGridColumn" into his source. */
        {Published = True}
        Procedure GridParam_PartsAreTrimmed
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "  Grid , cCJGrid ,  cCJGridColumn  " to bOk
            Send Assert bOk
            Send AssertSAreEqual "grid"          (psLegacyGridClass(ho))
            Send AssertSAreEqual "cCJGrid"       (psTargetGridClass(ho))
            Send AssertSAreEqual "cCJGridColumn" (psTargetColumnClass(ho))
            Send Destroy of ho
        End_Procedure

        // One part is not enough to convert anything - refused.
        {Published = True}
        Procedure GridParam_OnePartRefused
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "Grid" to bOk
            Send Assert (bOk = False)
            Send Destroy of ho
        End_Procedure

        // Four parts means the user meant something this converter cannot do - refused
        // rather than silently ignoring the extra.
        {Published = True}
        Procedure GridParam_FourPartsRefused
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "Grid,cCJGrid,cCJGridColumn,Extra" to bOk
            Send Assert (bOk = False)
            Send Destroy of ho
        End_Procedure

        /* A part present but blank is refused too - the count check alone would pass these,
           and an empty old-class would match every object while an empty target would emit
           "is a" with nothing after it. */
        {Published = True}
        Procedure GridParam_BlankPartRefused
            Handle ho
            Boolean bOk

            Get Helper to ho
            Get ParseAndSetParameter of ho ",cCJGrid" to bOk
            Send Assert (bOk = False)
            Send Destroy of ho
            Get Helper to ho
            Get ParseAndSetParameter of ho "Grid," to bOk
            Send Assert (bOk = False)
            Send Destroy of ho
            Get Helper to ho
            Get ParseAndSetParameter of ho "   ,   " to bOk
            Send Assert (bOk = False)
            Send Destroy of ho
        End_Procedure

        /* A REFUSAL MUST NOT HALF-APPLY. The old class is assigned last, after both checks,
           so a rejected parameter leaves the object exactly as it was - otherwise a converter
           could run against a half-configured target. */
        {Published = True}
        Procedure GridParam_RefusalLeavesPropertiesUntouched
            Handle ho
            Boolean bOk
            Get Helper to ho
            Get ParseAndSetParameter of ho "Grid" to bOk
            Send Assert (bOk = False)
            Send AssertSAreEqual "DbGrid"        (psLegacyGridClass(ho))
            Send AssertSAreEqual "cCJGrid"       (psTargetGridClass(ho))
            Send AssertSAreEqual "cCJGridColumn" (psTargetColumnClass(ho))
            Send Destroy of ho
        End_Procedure

    End_Object
