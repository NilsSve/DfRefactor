    Object oChangeExternalFunction32ToExternalFunction is a cTestFixture
        Set psFunctionName to "ChangeExternalFunction32ToExternalFunction"

        // The obsolete keyword loses its '32'; the rest of the (;-continued) declaration is untouched.
        {Published = True}
        Procedure ChangeExternalFunction32ToExternalFunction_Declaration
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'External_Function32 HtmlShellExecute "ShellExecuteA" SHELL32.DLL ;' to sLine
            Move 'External_Function HtmlShellExecute "ShellExecuteA" SHELL32.DLL ;' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeExternalFunction32ToExternalFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure ChangeExternalFunction32ToExternalFunction_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    External_Function32 Foo" to sLine
            Move "    External_Function Foo" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeExternalFunction32ToExternalFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        // The already-modern 'External_Function' must NOT be touched (whole-token match, not a prefix).
        {Published = True}
        Procedure ChangeExternalFunction32ToExternalFunction_NoMatchModern
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "External_Function Foo" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeExternalFunction32ToExternalFunction of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "External_Function Foo" sLine
        End_Procedure

    End_Object
