//****************************************************************************
// $Module type: Test fixture
// $Module name: oCDeclarationToDataFlex-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-03
//
// Description : Unit tests for the CDeclarationToDataFlex refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCDeclarationToDataFlex is a cTestFixture
        Set psFunctionName to "CDeclarationToDataFlex"

        // The worked example: a plain Win32 prototype. Continuation form, quoted entry
        // point, placeholder DLL, one line of parameters.
        {Published = True}
        Procedure CDeclarationToDataFlex_SimplePrototype
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "BOOL WINAPI GetComputerNameW(LPWSTR lpBuffer, LPDWORD nSize);" (&asNotes) to sOut
            Send Assert (sOut contains 'External_Function GetComputerNameW "GetComputerNameW"')
            Send Assert (sOut contains CS_CDeclDllPlaceholder)
            Send Assert (sOut contains "Pointer lpBuffer")
            Send Assert (sOut contains "Pointer nSize")
            Send Assert (sOut contains "Returns Integer")
        End_Procedure

        /* THE CONTRACT THAT JUSTIFIES THE DESIGN: what this emits must satisfy the
           application's OWN 64-bit / Unicode audit. If the two tables ever drift, this
           fails - which is the whole reason the converter reuses _AuditApiDeclaration's
           rules instead of growing a second copy of them. */
        {Published = True}
        Procedure CDeclarationToDataFlex_OutputPassesTheApiAudit
            String sOut sFlat
            String[] asNotes asFindings
            Integer iFindings
            Get CDeclarationToDataFlex of ghoFuncLib "LRESULT WINAPI SendMessageW(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam);" (&asNotes) to sOut
            // The audit reads ONE logical declaration, continuations already joined.
            Move (Replaces((Character(13)), sOut, " ")) to sFlat
            Move (Replaces((Character(10)), sFlat, " ")) to sFlat
            Move (Replaces(";", sFlat, " ")) to sFlat
            Get _AuditApiDeclaration of ghoFuncLib sFlat (&asFindings) to iFindings
            Send AssertIAreEqual 0 iFindings
        End_Procedure

        // The x64 trap this exists for: the pointer-sized typedefs must NOT become Integer.
        {Published = True}
        Procedure CDeclarationToDataFlex_PointerSizedTypesSurvive64Bit
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "LRESULT WINAPI SendMessageW(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam);" (&asNotes) to sOut
            Send Assert (sOut contains "Handle hWnd")
            Send Assert (sOut contains "DWord Msg")
            Send Assert (sOut contains "Longptr wParam")
            Send Assert (sOut contains "Longptr lParam")
            Send Assert (sOut contains "Returns Longptr")
        End_Procedure

        // const decides input-vs-buffer: LPCWSTR is a string the caller supplies, LPWSTR a
        // buffer the API fills. Same underlying C type, different DataFlex declaration.
        {Published = True}
        Procedure CDeclarationToDataFlex_ConstStringIsInputBufferIsPointer
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "int WINAPI Both(LPCWSTR pszIn, LPWSTR pszOut);" (&asNotes) to sOut
            Send Assert (sOut contains "WString pszIn")
            Send Assert (sOut contains "Pointer pszOut")
        End_Procedure

        // A void return is an External_Procedure, not a discarded Returns Integer.
        {Published = True}
        Procedure CDeclarationToDataFlex_VoidReturnBecomesExternalProcedure
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "void WINAPI Sleep(DWORD dwMilliseconds);" (&asNotes) to sOut
            Send Assert (sOut contains "External_Procedure Sleep")
            Send Assert (not(sOut contains "Returns"))
        End_Procedure

        // Create*/Open* returning an int is really a handle - the audit's own rule, applied
        // at generation time so the output does not immediately fail that audit.
        {Published = True}
        Procedure CDeclarationToDataFlex_CreateReturnsHandle
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "HANDLE WINAPI CreateEventW(LPVOID lpAttr, BOOL bManual, BOOL bInitial, LPCWSTR lpName);" (&asNotes) to sOut
            Send Assert (sOut contains "Returns Handle")
        End_Procedure

        /* SAL annotations and their arguments are stripped TOGETHER. The parenthesised form
           is the one that bites: dropping only the _Out_writes_ token leaves "( cch )"
           behind, which the parameter-list scan then mistakes for the parameter list. */
        {Published = True}
        Procedure CDeclarationToDataFlex_SalAnnotationsStripped
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "BOOL WINAPI Foo(_In_ HWND hWnd, _Out_writes_(cch) LPWSTR pszBuf, _In_ int cch);" (&asNotes) to sOut
            Send Assert (sOut contains 'External_Function Foo "Foo"')
            Send Assert (sOut contains "Handle hWnd")
            Send Assert (sOut contains "Pointer pszBuf")
            Send Assert (sOut contains "Integer cch")
        End_Procedure

        // "(void)" is an EMPTY parameter list, not a parameter called void.
        {Published = True}
        Procedure CDeclarationToDataFlex_VoidParameterListIsEmpty
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "DWORD WINAPI GetTickCount(void);" (&asNotes) to sOut
            Send Assert (sOut contains "Returns DWord")
            Send Assert (not(sOut contains "void"))
        End_Procedure

        // A raw pointer of any other kind is just an address.
        {Published = True}
        Procedure CDeclarationToDataFlex_RawPointerIsPointer
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "BOOL WINAPI GetWindowRect(HWND hWnd, RECT *lpRect);" (&asNotes) to sOut
            Send Assert (sOut contains "Handle hWnd")
            Send Assert (sOut contains "Pointer lpRect")
        End_Procedure

        // 64-bit integer typedefs reach BigInt / UBigInt - both are types the DataFlex
        // install's own Pkg folder declares, which is where the emitted set came from.
        {Published = True}
        Procedure CDeclarationToDataFlex_SixtyFourBitIntegers
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "int WINAPI Big(__int64 iSigned, ULONGLONG uUnsigned);" (&asNotes) to sOut
            Send Assert (sOut contains "BigInt iSigned")
            Send Assert (sOut contains "UBigInt uUnsigned")
        End_Procedure

        // Assumptions are STATED, not silently taken: the DLL always, plus one line per
        // non-const pointer that had to be read as a caller-allocated buffer.
        {Published = True}
        Procedure CDeclarationToDataFlex_NotesNameTheAssumptions
            String sOut sJoined
            String[] asNotes
            Integer i iMax
            Get CDeclarationToDataFlex of ghoFuncLib "BOOL WINAPI GetComputerNameW(LPWSTR lpBuffer, LPDWORD nSize);" (&asNotes) to sOut
            Send Assert (SizeOfArray(asNotes) > 0)
            Move (SizeOfArray(asNotes) - 1) to iMax
            For i from 0 to iMax
                Move (sJoined + " " + asNotes[i]) to sJoined
            Loop
            Send Assert (sJoined contains "DLL")
            Send Assert (sJoined contains "lpBuffer")
        End_Procedure

        // Text that is not a prototype returns "" so the caller can refuse rather than
        // replace the user's selection with nonsense.
        {Published = True}
        Procedure CDeclarationToDataFlex_RejectsNonPrototypes
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "Move (Trim(sFoo)) to sBar" (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Get CDeclarationToDataFlex of ghoFuncLib "" (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Get CDeclarationToDataFlex of ghoFuncLib "just some prose" (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* NILS'S REAL PASTE, 2026-08-03 - the MSDN CreateWindowEx sample. This is a CALL,
           and the converter used to convert it anyway: it emitted "Integer Windows"" (the
           tail of the string literal L"Learn to Program Windows") as a parameter, and the
           // comments became parameters called param6..param9. A confident wrong answer,
           which is worse than no answer. It must refuse, and say why. */
        {Published = True}
        Procedure CDeclarationToDataFlex_RefusesACallSite
            String sOut sSample
            String[] asNotes

            Move ("HWND hwnd = CreateWindowEx(" + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    0,                              // Optional window styles.' + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    CLASS_NAME,                     // Window class' + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    L"Learn to Program Windows",    // Window text' + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    WS_OVERLAPPEDWINDOW,            // Window style' + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT, CW_USEDEFAULT,' + (Character(13)) + (Character(10))) to sSample
            Move (sSample + '    NULL, NULL, hInstance, NULL' + (Character(13)) + (Character(10)) + '    );') to sSample
            Get CDeclarationToDataFlex of ghoFuncLib sSample (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            // And it names the reason, so the status bar can tell the user what to do.
            Send Assert (SizeOfArray(asNotes) > 0)
        End_Procedure

        // Each call signal on its own - a declaration can contain none of them.
        {Published = True}
        Procedure CDeclarationToDataFlex_RefusesEachCallSignal
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib 'h = Foo(a, b);' (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Get CDeclarationToDataFlex of ghoFuncLib 'Foo(L"text", b);' (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Get CDeclarationToDataFlex of ghoFuncLib 'Foo(NULL, b);' (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Get CDeclarationToDataFlex of ghoFuncLib 'Foo(0, b);' (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* Comments are stripped, not tokenised. A prototype copied out of a header carries
           them freely, and both forms have to go - "//" ending at the line break is why
           they are removed BEFORE newlines are flattened to spaces. */
        {Published = True}
        Procedure CDeclarationToDataFlex_CommentsStripped
            String sOut sSample
            String[] asNotes
            Move ("BOOL WINAPI Foo(   // the entry point" + (Character(13)) + (Character(10))) to sSample
            Move (sSample + "    HWND hWnd,     /* the window */" + (Character(13)) + (Character(10))) to sSample
            Move (sSample + "    int cch        // a count" + (Character(13)) + (Character(10)) + "    );") to sSample
            Get CDeclarationToDataFlex of ghoFuncLib sSample (&asNotes) to sOut
            Send Assert (sOut contains 'External_Function Foo "Foo"')
            Send Assert (sOut contains "Handle hWnd")
            Send Assert (sOut contains "Integer cch")
            Send Assert (not(sOut contains "window"))
            Send Assert (not(sOut contains "count"))
        End_Procedure

        /* Nils's second real paste, 2026-08-03: C++/CLI. `String ^` is a .NET tracking
           handle and [MarshalAs(...)] a .NET marshalling attribute - neither can cross a C
           FFI, so there is nothing honest to emit. It used to produce "Pointer ^", taking
           the handle marker for a parameter name while the array-bracket rule mangled the
           attribute. Refuse, and say which. */
        {Published = True}
        Procedure CDeclarationToDataFlex_RefusesManagedCpp
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib 'extern "C" int puts([MarshalAs(UnmanagedType::LPWStr)] String ^);' (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
            Send Assert (SizeOfArray(asNotes) > 0)
        End_Procedure

        // A bracketed ATTRIBUTE is refused; a bracketed ARRAY BOUND is not - they are told
        // apart by their content, which is the whole reason char buf[16] still works.
        {Published = True}
        Procedure CDeclarationToDataFlex_ArrayBoundIsNotAnAttribute
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib "int WINAPI Foo(char buf[16], int cch);" (&asNotes) to sOut
            Send Assert (sOut contains "Pointer buf")
            Send Assert (sOut contains "Integer cch")
            Get CDeclarationToDataFlex of ghoFuncLib "int WINAPI Bar([SomeAttribute] int a);" (&asNotes) to sOut
            Send AssertSAreEqual "" sOut
        End_Procedure

        /* extern "C" IS legitimate and common, and must survive - the quoted linkage tag
           has to be dropped WITH the keyword or it lands in the return type. */
        {Published = True}
        Procedure CDeclarationToDataFlex_ExternCLinkageIsHandled
            String sOut
            String[] asNotes
            Get CDeclarationToDataFlex of ghoFuncLib 'extern "C" BOOL WINAPI Foo(HWND hWnd);' (&asNotes) to sOut
            Send Assert (sOut contains 'External_Function Foo "Foo"')
            Send Assert (sOut contains "Handle hWnd")
            Send Assert (sOut contains "Returns Integer")
            // The linkage tag must not have survived into the declaration. Single-quoted
            // literal: DataFlex has no doubled-quote escape.
            Send Assert (not(sOut contains 'C"'))
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

    End_Object
