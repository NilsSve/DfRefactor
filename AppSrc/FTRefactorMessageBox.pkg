Use RefactorConstants.h.pkg

/* The browse-packages picker (BrowsePackagesFT.dg). Declared HERE as well as there, both #IFNDEF-guarded,
   because this package is compiled EARLY while the dialog itself is a view-level object compiled much
   later. Whichever comes first declares it; the other skips. Same pattern RefactorStatusPanel.pkg uses
   for ghoStatusPanel. */
#IFNDEF ghoBrowsePackages
    Global_Variable Handle ghoBrowsePackages
    Move 0 to ghoBrowsePackages
#ENDIF

// Forward declaration: this package is compiled before BrowsePackagesFT.dg, so the message would
// otherwise be unknown where it is sent.
Register_Function ShowPicker String sTitle String sHeaderHtml String sRowsHtml String sFooterNote Returns String
