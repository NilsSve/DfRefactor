//****************************************************************************
// $Module type: Test fixture
// $Module name: oGridSubclassPorter-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-04
//
// Description : Unit tests for ConvertGridSubclassToCodeJock's engine (cGridSubclassPorter.pkg): a
//               workspace's own subclass of a legacy grid ported IN PLACE - its class line, its package's
//               Use line, its label and help hooks moved into a new column class - and the object
//               converter's in-place mode that converts the objects with it.
//
//               The class shapes are the ones a real workspace's subclasses have, under neutral names: a
//               dbGrid subclass that anchors itself and translates labels and help through a function, a
//               Grid subclass of the same kind, and a dbGrid subclass inside a larger package that looks
//               its labels up in a table.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oGridSubclassPorterTests is a cTestFixture
        Set psFunctionName to "ConvertGridSubclassToCodeJock"

        Object oPorter is a cGridSubclassPorter
        End_Object

        Object oDbGridWorker is a cDbGridTocDbCJGrid
        End_Object

        // The first index whose trimmed line is exactly sTrim; -1 when none is.
        Function IndexOf String[] asLines String sTrim Returns Integer
            Integer i
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (Trim(asLines[i]) = sTrim) ;
                    Function_Return i
            Loop
            Function_Return -1
        End_Function

        // How many lines contain sPart.
        Function CountContaining String[] asLines String sPart Returns Integer
            Integer i iCount
            Move 0 to iCount
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (asLines[i] contains sPart) ;
                    Increment iCount
            Loop
            Function_Return iCount
        End_Function

        // A dbGrid subclass that anchors itself and translates its labels and help through a function -
        // the shape a workspace's own grid subclass has.
        Function DbGridSubclassSource Returns String[]
            String[] asIn
            Move "//*** Class: MyDbGrid"                                    to asIn[-1]
            Move "Use Dftable.pkg"                                          to asIn[-1]
            Move "Use MyLabels.pkg"                                         to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "Class MyDbGrid is a dbGrid"                               to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "    // Construct_Object: Object constructor."             to asIn[-1]
            Move "    Procedure Construct_Object"                           to asIn[-1]
            Move "        Forward Send Construct_Object"                    to asIn[-1]
            Move "        Set peAnchors to anAll"                           to asIn[-1]
            Move "    End_Procedure"                                        to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "    Procedure Set Header_Label Integer iCol String sLabel" to asIn[-1]
            Move "        Get fTranslate sLabel to sLabel"                  to asIn[-1]
            Move "        Forward Set Header_Label iCol to sLabel"          to asIn[-1]
            Move "    End_Procedure"                                        to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "    Procedure Set Label String sLabel"                    to asIn[-1]
            Move "        Get fTranslate sLabel to sLabel"                  to asIn[-1]
            Move "        Forward Set Label to (Trim(sLabel))"              to asIn[-1]
            Move "    End_Procedure"                                        to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "    Function Status_Help Integer iItem Returns String"    to asIn[-1]
            Move "        String sLabel"                                    to asIn[-1]
            Move "        Integer Itm"                                      to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "        If (Num_Arguments = 0) Begin"                     to asIn[-1]
            Move "            Move 0 to Itm"                                to asIn[-1]
            Move "        End"                                              to asIn[-1]
            Move "        Else Begin"                                       to asIn[-1]
            Move "            Move iItem to Itm"                            to asIn[-1]
            Move "        End"                                              to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "        Forward Get Status_Help Itm to sLabel"            to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "        Get fTranslate sLabel to sLabel"                  to asIn[-1]
            Move "        Function_Return (Trim(sLabel))"                   to asIn[-1]
            Move "    End_Function"                                         to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "    Procedure Set Status_Help Integer iItem String sLabel" to asIn[-1]
            Move "        Get fTranslate sLabel to sLabel"                  to asIn[-1]
            Move "        Forward Set Status_Help Item iItem to (Trim(sLabel))" to asIn[-1]
            Move "    End_Procedure"                                        to asIn[-1]
            Move ""                                                         to asIn[-1]
            Move "End_Class"                                                to asIn[-1]
            Function_Return asIn
        End_Function

        // The class line, the Use line, Construct_Object kept; the hooks gone from the grid class.
        { Published = True }
        Procedure PortClass_DbGridSubclass_ClassAndUse
            String[] asOut
            Get PortClassSource of oPorter (DbGridSubclassSource(Self)) "MyDbGrid" to asOut
            Send AssertSAreEqual "" (psRefusal(oPorter))
            Send Assert (SizeOfArray(asOut) > 0) "the class is portable"
            Send AssertSAreEqual "Use cDbCJGrid.pkg" (Trim(asOut[1]))
            Send AssertSAreEqual "Use MyLabels.pkg"  (Trim(asOut[2]))
            Send Assert (IndexOf(Self, asOut, "Class MyDbGrid is a cDbCJGrid") > 0) "the class is a cDbCJGrid"
            Send Assert (IndexOf(Self, asOut, "Set peAnchors to anAll") > 0) "Construct_Object keeps its Set"
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Header_Label"))
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Procedure Set Label"))
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Dftable"))
            Send AssertIAreEqual 2 (CountContaining(Self, asOut, "End_Class"))
        End_Procedure

        /* The grid class's body after the port, line for line (the first live run, 2026-10-04): the
           members that left take the blank lines after them along, the note takes the first hook's
           place, and the class keeps the blank line it had above End_Class - not the four the run left. */
        { Published = True }
        Procedure PortClass_DbGridSubclass_NoBlankLinesPileUp
            String[] asOut
            String   sBody
            Integer  i
            Boolean  bDone

            Get PortClassSource of oPorter (DbGridSubclassSource(Self)) "MyDbGrid" to asOut
            // Every line after the class line, up to and including its End_Class.
            Move "" to sBody
            Move False to bDone
            For i from (IndexOf(Self, asOut, "Class MyDbGrid is a cDbCJGrid") + 1) to (SizeOfArray(asOut) - 1)
                If (bDone = False) Begin
                    Move (sBody + "[" + asOut[i] + "]") to sBody
                    Move (Trim(asOut[i]) = "End_Class") to bDone
                End
            Loop
            Send AssertSAreEqual "[][    // Construct_Object: Object constructor.][    Procedure Construct_Object][        Forward Send Construct_Object][        Set peAnchors to anAll][    End_Procedure][][    // The label and help hooks are in MyDbGridColumn, below: a CodeJock grid sets them per column.][][End_Class]" sBody
        End_Procedure

        /* SubclassVerdict - the question the run and the Check both ask (2026-10-04). A class that ports
           converts; a class another class is built on does not; a column class name that is taken does
           not; and a marker an earlier run left above the class is read back as the reason. One asserted
           string, each case labelled. */
        { Published = True }
        Procedure SubclassVerdict_FourAnswers
            String[] asLines asNames asSupers asFiles asMarked
            String   sGot sWhy
            Integer  i

            Get DbGridSubclassSource to asLines
            Get SubclassVerdict of oPorter (&asLines) "MyDbGrid" (&asNames) (&asSupers) (&asFiles) to sWhy
            Move ("plain:[" + sWhy + "]") to sGot
            Move "MyChild"      to asNames[0]
            Move "mydbgrid"     to asSupers[0]
            Move "MyChild.pkg"  to asFiles[0]
            Get SubclassVerdict of oPorter (&asLines) "MyDbGrid" (&asNames) (&asSupers) (&asFiles) to sWhy
            Move (sGot + " child:" + If((sWhy = "MyChild (MyChild.pkg) is built on it, and a class with subclasses of its own is not converted yet"), "ok", sWhy)) to sGot
            Move "MyDbGridColumn" to asNames[0]
            Move "cObject"        to asSupers[0]
            Move "Other.pkg"      to asFiles[0]
            Get SubclassVerdict of oPorter (&asLines) "MyDbGrid" (&asNames) (&asSupers) (&asFiles) to sWhy
            Move (sGot + " column:" + If((sWhy = "the class MyDbGridColumn already exists (Other.pkg), and the port would create a column class of that name"), "ok", sWhy)) to sGot
            Move (ResizeArray(asNames, 0))  to asNames
            Move (ResizeArray(asSupers, 0)) to asSupers
            Move (ResizeArray(asFiles, 0))  to asFiles
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (Trim(asLines[i]) = "Class MyDbGrid is a dbGrid") ;
                    Move "// TODO (DFRefactor): NOT converted - 2 object(s) of MyDbGrid set their own Label." to asMarked[SizeOfArray(asMarked)]
                Move asLines[i] to asMarked[SizeOfArray(asMarked)]
            Loop
            Get SubclassVerdict of oPorter (&asMarked) "MyDbGrid" (&asNames) (&asSupers) (&asFiles) to sWhy
            Move (sGot + " marker:" + If((sWhy = "an earlier run left it as it is, and the note it wrote above the class says why - 2 object(s) of MyDbGrid set their own Label."), "ok", sWhy)) to sGot
            Send AssertSAreEqual "plain:[] child:ok column:ok marker:ok" sGot
        End_Procedure

        /* THE EMPTY PARAMETER takes every grid subclass the run's files declare, each on its own: one that
           converts and one that does not, in one run - a read-only run, which stops after its dry run (the
           write goes through the object converter's own TransformFiles, an engine run's business). The
           count is the converted class's objects; the notes say what happened to each class. */
        { Published = True }
        Procedure ConvertSubclass_EmptyParameter_EachClassOnItsOwn
            String   sDir sClassA sClassB sView sNotes sGot
            String[] asA asB asV asFiles
            Integer  iDone
            Boolean  bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDir
            Move (vFolderFormat(sDir) + "ZPortA.pkg") to sClassA
            Move (vFolderFormat(sDir) + "ZPortB.pkg") to sClassB
            Move (vFolderFormat(sDir) + "ZPortV.vw")  to sView
            Get DbGridSubclassSource to asA
            Move "Class ZPortRich is a Grid"             to asB[SizeOfArray(asB)]
            Move "    Procedure DoDeleteRow Integer iRow" to asB[SizeOfArray(asB)]
            Move "    End_Procedure"                      to asB[SizeOfArray(asB)]
            Move "End_Class"                              to asB[SizeOfArray(asB)]
            Move "Object oOne is a MyDbGrid"              to asV[SizeOfArray(asV)]
            Move "    Begin_Row"                          to asV[SizeOfArray(asV)]
            Move "        Entry_Item Orders.Amount"       to asV[SizeOfArray(asV)]
            Move "    End_Row"                            to asV[SizeOfArray(asV)]
            Move "End_Object"                             to asV[SizeOfArray(asV)]
            Move "Object oTwo is a MyDbGrid"              to asV[SizeOfArray(asV)]
            Move "    Begin_Row"                          to asV[SizeOfArray(asV)]
            Move "        Entry_Item Orders.Qty"          to asV[SizeOfArray(asV)]
            Move "    End_Row"                            to asV[SizeOfArray(asV)]
            Move "End_Object"                             to asV[SizeOfArray(asV)]
            Move "Object oRich is a ZPortRich"            to asV[SizeOfArray(asV)]
            Move "End_Object"                             to asV[SizeOfArray(asV)]
            Get rfWriteEncodedFileFromStringArray (&asA) sClassA C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asB) sClassB C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asV) sView   C_NewLine False to bOk
            Move sClassA to asFiles[0]
            Move sClassB to asFiles[1]
            Move sView   to asFiles[2]

            Set pbReadOnly of ghoFuncLib to True
            Set psExecutionContext of ghoFuncLib to "ConvertGridSubclassToCodeJock"
            Get ConvertSubclass of oPorter asFiles "" to iDone
            Get RunNotesText of ghoFuncLib "ConvertGridSubclassToCodeJock" "" to sNotes
            Set psExecutionContext of ghoFuncLib to ""
            Set pbReadOnly of ghoFuncLib to False
            Move (rfDeleteFile(sClassA)) to bOk
            Move (rfDeleteFile(sClassB)) to bOk
            Move (rfDeleteFile(sView))   to bOk
            Move (String(iDone) + "|" + If((sNotes contains "MyDbGrid is a cDbCJGrid now"), "A converted", "A?") + "|" + If((sNotes contains "NOT CONVERTED - ZPortRich"), "B refused", "B?") + "|" + If((sNotes contains "DoDeleteRow"), "B says why", "B why?")) to sGot
            Send AssertSAreEqual "2|A converted|B refused|B says why" (sGot + If((sGot = "2|A converted|B refused|B says why"), "", (" NOTES: " + sNotes)))
        End_Procedure

        // An object that sets its own Label refuses its class - and a NAMED class that is not declared says so.
        { Published = True }
        Procedure ConvertSubclass_LabelObjectRefusesItsClass
            String   sDir sClassA sView sNotes sGot
            String[] asA asV asFiles
            Integer  iDone iNone
            Boolean  bOk

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDir
            Move (vFolderFormat(sDir) + "ZPortA.pkg") to sClassA
            Move (vFolderFormat(sDir) + "ZPortV.vw")  to sView
            Get DbGridSubclassSource to asA
            Move "Object oOne is a MyDbGrid"              to asV[SizeOfArray(asV)]
            Move '    Set Label to "Orders"'              to asV[SizeOfArray(asV)]
            Move "    Begin_Row"                          to asV[SizeOfArray(asV)]
            Move "        Entry_Item Orders.Amount"       to asV[SizeOfArray(asV)]
            Move "    End_Row"                            to asV[SizeOfArray(asV)]
            Move "End_Object"                             to asV[SizeOfArray(asV)]
            Get rfWriteEncodedFileFromStringArray (&asA) sClassA C_NewLine False to bOk
            Get rfWriteEncodedFileFromStringArray (&asV) sView   C_NewLine False to bOk
            Move sClassA to asFiles[0]
            Move sView   to asFiles[1]

            Set pbReadOnly of ghoFuncLib to True
            Set psExecutionContext of ghoFuncLib to "ConvertGridSubclassToCodeJock"
            Get ConvertSubclass of oPorter asFiles "" to iDone
            Get ConvertSubclass of oPorter asFiles "NoSuchClass" to iNone
            Get RunNotesText of ghoFuncLib "ConvertGridSubclassToCodeJock" "" to sNotes
            Set psExecutionContext of ghoFuncLib to ""
            Set pbReadOnly of ghoFuncLib to False
            Move (rfDeleteFile(sClassA)) to bOk
            Move (rfDeleteFile(sView))   to bOk
            Move (String(iDone) + "|" + String(iNone) + "|" + If((sNotes contains "1 object(s) of MyDbGrid set their own Label"), "label", "label?") + "|" + If((sNotes contains "Class NoSuchClass is not declared in the selected files"), "not declared", "declared?")) to sGot
            Send AssertSAreEqual "0|0|label|not declared" (sGot + If((sGot = "0|0|label|not declared"), "", (" NOTES: " + sNotes)))
        End_Procedure

        // The hooks, in the new column class, with only the message names changed.
        { Published = True }
        Procedure PortClass_DbGridSubclass_ColumnClass
            String[] asOut
            Integer  iCol
            Get PortClassSource of oPorter (DbGridSubclassSource(Self)) "MyDbGrid" to asOut
            Send AssertSAreEqual "MyDbGridColumn" (psColumnClass(oPorter))
            Move (IndexOf(Self, asOut, "Class MyDbGridColumn is a cDbCJGridColumn")) to iCol
            Send Assert (iCol > (IndexOf(Self, asOut, "Class MyDbGrid is a cDbCJGrid"))) "the column class follows the grid class"
            Send Assert (IndexOf(Self, asOut, "Procedure Set psCaption String sLabel") > iCol)
            Send Assert (IndexOf(Self, asOut, "Forward Set psCaption to sLabel") > iCol)
            Send Assert (IndexOf(Self, asOut, "Function Status_Help Returns String") > iCol)
            Send Assert (IndexOf(Self, asOut, "Forward Get Status_Help to sLabel") > iCol)
            Send Assert (IndexOf(Self, asOut, "Procedure Set Status_Help String sLabel") > iCol)
            Send Assert (IndexOf(Self, asOut, "Forward Set Status_Help to (Trim(sLabel))") > iCol)
            Send AssertIAreEqual 3 (CountContaining(Self, asOut, "Get fTranslate sLabel to sLabel"))
            // the "which item" selection is gone: a column IS the item
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Itm"))
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "iItem"))
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Num_Arguments"))
        End_Procedure

        // A Grid subclass: Windows.pkg stays (it is not the grid's own package), cCJGrid.pkg joins it.
        { Published = True }
        Procedure PortClass_GridSubclass_WindowsStays
            String[] asIn asOut
            Move "Use Windows.pkg"                                         to asIn[-1]
            Move "Use MyLabels.pkg"                                        to asIn[-1]
            Move ""                                                        to asIn[-1]
            Move "Class MyGrid is a Grid"                                  to asIn[-1]
            Move "    Procedure Set Header_Label Integer iCol String sLabel" to asIn[-1]
            Move "        Get fTranslate sLabel to sLabel"                 to asIn[-1]
            Move "        Forward Set Header_Label iCol to sLabel"         to asIn[-1]
            Move "    End_Procedure"                                       to asIn[-1]
            Move "End_Class"                                               to asIn[-1]
            Get PortClassSource of oPorter asIn "MyGrid" to asOut
            Send AssertSAreEqual "" (psRefusal(oPorter))
            Send AssertSAreEqual "Use Windows.pkg"  (Trim(asOut[0]))
            Send AssertSAreEqual "Use MyLabels.pkg" (Trim(asOut[1]))
            Send AssertSAreEqual "Use cCJGrid.pkg"  (Trim(asOut[2]))
            Send Assert (IndexOf(Self, asOut, "Class MyGrid is a cCJGrid") > 0)
            Send Assert (IndexOf(Self, asOut, "Class MyGridColumn is a cCJGridColumn") > 0)
            Send Assert (IndexOf(Self, asOut, "Forward Set psCaption to sLabel") > 0)
        End_Procedure

        // A dbGrid subclass inside a larger package, looking its labels up in a table, with an Item# parameter.
        // The rest of the file - another class included - stays exactly as it was; cDbCJGrid.pkg is Used after
        // the file's last Use above the class.
        { Published = True }
        Procedure PortClass_LookupHookInALargerFile
            String[] asIn asOut
            String   sItem
            Move ("Item" + Character(35)) to sItem
            Move "Use cApplication.pkg"                                        to asIn[-1]
            Move ""                                                            to asIn[-1]
            Move "Function fSomething Returns Integer"                         to asIn[-1]
            Move "    Function_Return 1"                                       to asIn[-1]
            Move "End_Function"                                                to asIn[-1]
            Move ""                                                            to asIn[-1]
            Move "Class MyLookupGrid is a dbGrid"                              to asIn[-1]
            Move ("    Procedure Set Header_Label Integer " + sItem + " String lbl") to asIn[-1]
            Move "        String sLbl"                                         to asIn[-1]
            Move ("        Forward Set Header_Label Item " + sItem + " to lbl") to asIn[-1]
            Move ""                                                            to asIn[-1]
            Move ("        Get Header_Label Item " + sItem + " to sLbl")      to asIn[-1]
            Move ""                                                            to asIn[-1]
            Move "        Clear LABELTXT"                                      to asIn[-1]
            Move "        Get fLanguageCode to LABELTXT.LANG"                  to asIn[-1]
            Move "        Move sLbl         to LABELTXT.ID"                    to asIn[-1]
            Move "        Find Eq LABELTXT by Index.1"                         to asIn[-1]
            Move "        If (Found) ;"                                        to asIn[-1]
            Move ("            Forward Set Header_Label Item " + sItem + " to (Trim(LABELTXT.LABEL))") to asIn[-1]
            Move "    End_Procedure"                                           to asIn[-1]
            Move "End_Class"                                                   to asIn[-1]
            Move ""                                                            to asIn[-1]
            Move "Class MyOtherGrid is a Grid"                                 to asIn[-1]
            Move "    Procedure Set Header_Label Integer iCol String sLabel"   to asIn[-1]
            Move "        Forward Set Header_Label iCol to sLabel"             to asIn[-1]
            Move "    End_Procedure"                                           to asIn[-1]
            Move "End_Class"                                                   to asIn[-1]
            Get PortClassSource of oPorter asIn "MyLookupGrid" to asOut
            Send AssertSAreEqual "" (psRefusal(oPorter))
            Send AssertSAreEqual "Use cApplication.pkg" (Trim(asOut[0]))
            Send AssertSAreEqual "Use cDbCJGrid.pkg"    (Trim(asOut[1]))
            Send Assert (IndexOf(Self, asOut, "Class MyLookupGrid is a cDbCJGrid") > 0)
            Send Assert (IndexOf(Self, asOut, "Forward Set psCaption to lbl") > 0)
            Send Assert (IndexOf(Self, asOut, "Get psCaption to sLbl") > 0)
            Send Assert (IndexOf(Self, asOut, "Forward Set psCaption to (Trim(LABELTXT.LABEL))") > 0)
            Send Assert (IndexOf(Self, asOut, "Find Eq LABELTXT by Index.1") > 0) "the lookup is carried over"
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, sItem))
            // the other class is untouched
            Send Assert (IndexOf(Self, asOut, "Class MyOtherGrid is a Grid") > 0)
            Send Assert (IndexOf(Self, asOut, "Forward Set Header_Label iCol to sLabel") > 0)
        End_Procedure

        // A member with no CodeJock counterpart refuses the class - and the refusal names it.
        { Published = True }
        Procedure PortClass_UnknownMember_Refused
            String[] asIn asOut
            Move "Use Dftable.pkg"                                        to asIn[-1]
            Move "Class MyRowGrid is a dbGrid"                            to asIn[-1]
            Move "    Procedure OnRowChanged Integer iOld Integer iNew"   to asIn[-1]
            Move "        Send DoSomething"                               to asIn[-1]
            Move "    End_Procedure"                                      to asIn[-1]
            Move "End_Class"                                              to asIn[-1]
            Get PortClassSource of oPorter asIn "MyRowGrid" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (psRefusal(oPorter) contains "OnRowChanged") ("the refusal names the member: " + psRefusal(oPorter))
        End_Procedure

        /* EVERY REASON IS COUNTED (2026-11-01): a class that overrode a dozen dbList internals was reported for its first
           line only, a child object in Construct_Object. The run note counts the others and names the first of them;
           psRefusal - what the Check shows - is the first reason as before, and Construct_Object counts once. */
        { Published = True }
        Procedure PortClass_EveryReasonIsCounted
            String[] asIn asOut asWhy
            String sSummary
            Move "Use Dfsellst.pkg"                                to asIn[-1]
            Move "Class MyPickList is a dbList"                    to asIn[-1]
            Move "    Procedure Construct_Object"                  to asIn[-1]
            Move "        Forward Send Construct_Object"           to asIn[-1]
            Move "        Object oCache is an Array"               to asIn[-1]
            Move "        End_Object"                              to asIn[-1]
            Move "    End_Procedure"                               to asIn[-1]
            Move "    Procedure Request_Lookup Integer iItem"      to asIn[-1]
            Move "        Forward Send Request_Lookup iItem"       to asIn[-1]
            Move "    End_Procedure"                               to asIn[-1]
            Move "    Procedure Restore_Defaults"                  to asIn[-1]
            Move "        Forward Send Restore_Defaults"           to asIn[-1]
            Move "    End_Procedure"                               to asIn[-1]
            Move "End_Class"                                       to asIn[-1]
            Get PortClassSource of oPorter asIn "MyPickList" to asOut
            Get pasRefusals of oPorter to asWhy
            Get _RefusalSummary of oPorter to sSummary
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send AssertIAreEqual 3 (SizeOfArray(asWhy))
            Send Assert (psRefusal(oPorter) contains "Object oCache is an Array") ("the first reason: " + psRefusal(oPorter))
            Send Assert (sSummary contains "2 more reason(s)" and sSummary contains "Request_Lookup" and sSummary contains "Restore_Defaults") ("the summary: " + sSummary)
        End_Procedure

        // A label hook that uses the column number for more than the label refuses the class.
        { Published = True }
        Procedure PortClass_ColumnNumberUsed_Refused
            String[] asIn asOut
            Move "Class MyWideGrid is a dbGrid"                               to asIn[-1]
            Move "    Procedure Set Header_Label Integer iCol String sLabel"  to asIn[-1]
            Move "        If (iCol = 0) Move (Uppercase(sLabel)) to sLabel"   to asIn[-1]
            Move "        Forward Set Header_Label iCol to sLabel"            to asIn[-1]
            Move "    End_Procedure"                                          to asIn[-1]
            Move "End_Class"                                                  to asIn[-1]
            Get PortClassSource of oPorter asIn "MyWideGrid" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (psRefusal(oPorter) contains "column number") ("the refusal says why: " + psRefusal(oPorter))
        End_Procedure

        // A List subclass is not ported yet; a class that is not a grid at all is not ported.
        { Published = True }
        Procedure PortClass_ListAndOther_Refused
            String[] asIn asOut
            Move "Class MyList is a List" to asIn[0]
            Move "End_Class"              to asIn[1]
            Get PortClassSource of oPorter asIn "MyList" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (psRefusal(oPorter) contains "List subclass")
            Move "Class MyForm is a dbForm" to asIn[0]
            Get PortClassSource of oPorter asIn "MyForm" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (psRefusal(oPorter) contains "not a dbGrid")
            Get PortClassSource of oPorter asIn "NoSuchGrid" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send Assert (psRefusal(oPorter) contains "not declared")
        End_Procedure

        /* THE OBJECTS, IN PLACE: the dbGrid converter with the class named twice ("MyDbGrid,MyDbGrid,MyDbGridColumn")
           keeps the object's class, makes its columns from the new column class, writes no "behaviour not
           inherited" TODO and leaves the Use of the subclass's package as it is. */
        { Published = True }
        Procedure InPlace_ObjectKeepsItsClass
            String[] asIn asOut
            Integer  iGrids
            Boolean  bOk
            Move "Use MyDbGrid.pkg"                     to asIn[-1]
            Move "Object oGrid is a MyDbGrid"           to asIn[-1]
            Move "    Begin_Row"                        to asIn[-1]
            Move "        Entry_Item MyTable.Field1"    to asIn[-1]
            Move "    End_Row"                          to asIn[-1]
            Move "End_Object"                           to asIn[-1]
            Get ParseAndSetParameter of oDbGridWorker "MyDbGrid,MyDbGrid,MyDbGridColumn" to bOk
            Send Assert bOk
            Set pasSource of oDbGridWorker to asIn
            Get TransformSource of oDbGridWorker to iGrids
            Get pasSource of oDbGridWorker to asOut
            Send AssertIAreEqual 1 iGrids
            Send Assert (IndexOf(Self, asOut, "Object oGrid is a MyDbGrid") >= 0) "the object keeps its class"
            Send Assert (CountContaining(Self, asOut, "is a MyDbGridColumn") > 0) "its columns are the new column class"
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "TODO: oGrid was a"))
            Send AssertIAreEqual 0 (CountContaining(Self, asOut, "Begin_Row"))
            Send AssertSAreEqual "Use MyDbGrid.pkg" (Trim(asOut[0]))
        End_Procedure

    End_Object
