     About this class:
        NOTE: Code refactoring functions were moved to object package: oRefactorFunclib.pkg

        To add a function for that package, two things are needed:
     1) Add the code as a function to the oRefactorFuncLib.pkg object package,
        with the same parameters as the existing functions are using.
     2) Register the function using meta-tags. See the functions in the
        oRefactorFuncLib.pkg file for samples.
        There you can also learn more about different types of functions and
        their requested parameters.
     3) (Optional). If you need to include your own personal refactoring functions,
                    add them to the 'UserDefinedRefactorFunctions.inc'. The file
                    is included by the oRefactorFuncLib object file.
*/   
Use RefactorConstants.h.pkg
Use MetaTagHealth.pkg          // rfLeadingIndent / rfMetaTagHealthScan - shared with the
                               // MetaTagCheck service program, which cannot link this class.
Use cRefactorStatusLog.pkg
Use cBaseFuncLib.pkg
Use SupplementalRefactoringClasses.pkg
Use cFunctionsDataDictionary.dd
Use cJsonObject.pkg            // DataTypeToJson / JsonToDataType - the TypeToStructReport catalogue cache
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers

// GetTickCount (ms since boot) for the TypeToStructReport catalogue timing. Guard-declared once -
// the symbol collides case-insensitively across packages if redeclared.
#IFNDEF get_GetTickCount
    External_Function GetTickCount "GetTickCount" Kernel32.Dll Returns Integer
#ENDIF

// FT UI-yield hook (mirrors cModAnalyzer's): a long tokenize scan on the plan-build path
// (_CollectIndicatorNames) sends this to the FT dock to keep the marquee AND the elapsed-seconds
// status live. cModAnalyzer.AddNeededIndicatorCompanions bridges its own target onto ghoFuncLib
// only around that scan; a console/non-FT run leaves phoUIYieldTarget 0, so a bare Desktop pump is
// used instead (see _CollectIndicatorNames). Declared here so the Send compiles before cModAnalyzer's
// own Register is seen; a duplicate Register of the same message name is a no-op.
#IFNDEF DoYieldToUI
    Register_Procedure DoYieldToUI
#ENDIF
// Defined further down the class; the write-time guard (_GuardKeptTextOnWrite) calls them first.
Register_Function _KeptTextFlagsOf tLineInfo[] ByRef aInfo Boolean bCloserToo Returns Boolean[]
Register_Function _GuardAtStringTextOnWrite String[] ByRef asOld tLineInfo[] ByRef aOld String[] ByRef asNew Returns Integer
// cRefactorEngine's run origin (eRunTestBench...), declared there after this package compiles (_WriteDfTypesStructs).
Register_Function peRunOrigin Returns Integer

Class cRefactorFuncLib is a cBaseFuncLib

    Procedure Construct_Object
        Forward Send Construct_Object

        { Visibility = Public }
        { MethodType = Property }
        { Description = "Struct array containing all function names and info associated with those functions." }
        { Description = "Set by the RegisterInterface procedure." }
        Property tFuncLib[] pFuncLibArray
        /* tWinStructs.pkg, read once. All 58 of the install's tWin* structs live in that one file,
           so the legacy-Type-to-shipped-Struct lookup costs a single read per run rather than a walk
           of the 433-file Pkg folder. The latch is separate from the array because an install
           without the file is a real answer - "" - and must not be retried on every Type. */
        Property String[] pasWinStructsLines
        Property Boolean  pbWinStructsRead False
        /* Dftypes.pkg, read once, the same way (_DfTypesInstallLines) - and the test seam, as the two above are. The
           structs a _ConvertWin32TypeBuffersInLines call copied from it (names, and each block as one Character(10)-
           joined string) wait here for ChangeExternalFunctionCallers to write them (_WriteDfTypesStructs); the folder
           they go to is the workspace's AppSrc unless psDfTypesStructsFolder says otherwise (tests). */
        Property String[] pasDfTypesLines
        Property Boolean  pbDfTypesRead False
        Property String[] pasDfTypesLifted
        Property String[] pasDfTypesLiftedBlocks
        Property String   psDfTypesStructsFolder ""
        /* AutoFixWholeFileWouldChange runs a whole-file function on a COPY to see whether it would change anything. A
           function that also writes another file asks this first, and writes nothing while it is True (2026-11-13). */
        Property Boolean  pbWholeFileProbe False
        // FT marquee/status pump target, bridged in by cModAnalyzer.AddNeededIndicatorCompanions ONLY
        // around the plan-build indicator scan (reset to 0 after); 0 = no UI yield -> bare Desktop pump.
        Property Handle phoUIYieldTarget 0
        Move Self to ghoFuncLib
    End_Procedure

    Procedure End_Construct_Object
        Handle hoDD
        tFuncLib[] FuncLibArray

        Forward Send End_Construct_Object
        // Init class interface
        Send _AddAllKeyWords
        Send _InitializeFuncLib

        // Update Functions table with meta-tag data.
        Get Create (RefClass(cFunctionsDataDictionary)) to hoDD
        Get pFuncLibArray to FuncLibArray
        Send UpdateDataFromMetaTags of hoDD FuncLibArray
        Send Destroy of hoDD
        Set pFuncLibArray to FuncLibArray
    End_Procedure

    { Description = "Helper function for the Procedure RegisterInterface." }
    { Description += "Made into global function to be used in Case expressions." }
    Function IsMetaTag String sMetaTag Integer eTagType Returns Boolean
        Boolean bFound
        
        Move (Trim(Lowercase(sMetaTag))) to sMetaTag
        Move (Replaces(CS_S, sMetaTag, "")) to sMetaTag
        
        Case Begin
            Case (eTagType = eMethodType)
                Move (sMetaTag contains "{methodtype=") to bFound
                Case Break
            Case (eTagType = eSummaryText)
                Move (sMetaTag contains "{summarytext=") to bFound
                Case Break
            Case (eTagType = eEnumList)
                Move (sMetaTag contains "{enumlist=") to bFound
                Case Break
            Case (eTagType = eInitValue)
                Move (sMetaTag contains "{initialvalue=") to bFound
                Case Break
            Case (eTagType = eHelpTopic)
                Move (sMetaTag contains "{paramhelp=") to bFound
                Case Break
            Case (eTagType = ePrivate)
                Move (sMetaTag contains "{private=") to bFound
                Case Break
            Case (eTagType = eModRecipe)
                Move (sMetaTag contains "{modrecipe=") to bFound
                Case Break
            Case (eTagType = eFnGroup)
                Move (sMetaTag contains "{fngroup=") to bFound
                Case Break
            Case (eTagType = eNoDoc)
                Move (sMetaTag contains "{nodoc=") to bFound
                Case Break
            Case (eTagType = eFnFamily)
                Move (sMetaTag contains "{fnfamily=") to bFound
                Case Break
            Case Else
                Move False to bfound
        Case End
        
        Function_Return bFound
    End_Function
    
    // { FnGroup } enum <-> text converters (mirrors cModAnalyzer's CategoryText). Used INSTEAD of an
    // implicit 'Move a name-string into an Integer' resolution, which turns a non-Define string into 0
    // and faults under DF26 - see _ParameterIsEnum in cBaseFuncLib. Global so both the meta-tag parser
    // (cRefactorFuncLib ParseComment) and the Functions DD value-table can reach them.
    Function FnGroupText Integer eGroup Returns String
        If (eGroup = eFnGroupModernization) ;
            Function_Return CS_FnGroupModernization
        If (eGroup = eFnGroupCleanup) ;
            Function_Return CS_FnGroupCleanup
        If (eGroup = eFnGroupUnicode64) ;
            Function_Return CS_FnGroupUnicode64
        Function_Return CS_FnGroupOther
    End_Function
    
    // Resolve a { FnGroup } meta-tag's text (e.g. "Modernization") to its enum value, case-insensitively.
    // Unknown / blank -> eFnGroupOther (0), the same default an untagged function gets.
    Function FnGroupValue String sText Returns Integer
        String sTrim

        Move (Trim(Lowercase(sText))) to sTrim
        If (sTrim = Lowercase(FnGroupText(Self, eFnGroupModernization))) ;
            Function_Return eFnGroupModernization
        // The Tidy Up group matches its display text AND the original tag spelling "Cleanup" -
        // every { FnGroup = Cleanup } function header and old JSON export keeps resolving
        // (display renamed "Cleanup" -> "Tidy Up" 2026-07-16; same aliasing as Unicode64 below).
        If (sTrim = Lowercase(FnGroupText(Self, eFnGroupCleanup)) or sTrim = "cleanup") ;
            Function_Return eFnGroupCleanup
        // The x64+Unicode group matches its display text AND the clean tag spelling
        // "Unicode64" (the display "x64 + Unicode" is awkward inside a meta-tag).
        If (sTrim = Lowercase(FnGroupText(Self, eFnGroupUnicode64)) or sTrim = "unicode64") ;
            Function_Return eFnGroupUnicode64
        Function_Return eFnGroupOther
    End_Function

    Procedure PRIVATE_MESSAGES // For the Studio's Code Explorer
    End_Procedure

    { Visibility = Private }
    { Description  = "Collects data for all functions from the oRefactorFuncLib object." }
    { Description += "Saves the data in the pFuncLibArray struct array property." }
    Procedure RegisterInterface Handle hMsg String sMsgName String sParams String sComment
        Handle hNewTest       
        String sReturnType
        tFuncLib   FuncLib
        tFuncLib[] FuncLibArray
        tFuncParam[] FuncParamArray
        tFuncEnumList FuncEnumList
        
        If (Left(sMsgName, 4) = "msg_") Begin
            Move (Replace("msg_", sMsgName, "")) to sMsgName
        End
        If (Left(sMsgName, 4) = "get_") Begin
            Move (Replace("get_", sMsgName, "")) to sMsgName
        End
        
        If (sComment = "") Begin 
            // This is considered to be a fatal error:
            Error DFERR_PROGRAM "Library Function's meta tag '{ Description}' missing! Program will now Exit!"
            Send Exit_Application
        End

        Get ParseComment sComment to FuncLib

        If (sParams <> "") Begin
            Get ParseParams sParams (&sReturnType) to FuncParamArray
            Move FuncParamArray to FuncLib.FuncParamArray 
            Move sReturnType    to FuncLib.sReturnType
        End
        
        Get pFuncLibArray to FuncLibArray
        Move sMsgName     to FuncLib.sName
        Move FuncLib      to FuncLibArray[-1] 
        Set pFuncLibArray to FuncLibArray
    End_Procedure
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    Function ParseParams String sParams String ByRef sReturnType Returns tFuncParam[]
        tFuncParam[] FuncParamArray
        String[] asParams
        Integer iCount iSize iParam

        Move 0 to iParam
        Move (StrSplitToArray(sParams, CS_S)) to asParams
        Move (SizeOfArray(asParams)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            If (Lowercase(asParams[iCount]) = "returns") Begin
                Increment iCount
                Move asParams[iCount] to sReturnType
                Move iSize to iCount // Get out of here.
            End
            Else Begin
                Move asParams[iCount] to FuncParamArray[iParam].sType
                Increment iCount
                If (Lowercase(asParams[iCount]) = "byref") Begin
                    Move True to FuncParamArray[iParam].bByRef
                    Increment iCount
                End
                Move asParams[iCount] to FuncParamArray[iParam].sVarName 
                Increment iParam
            End
        Loop    
        Function_Return FuncParamArray
    End_Function 
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    Function ParseComment String sComment Returns tFuncLib
        tFuncLib FuncLib
        tFuncEnumList FuncEnumList
        String[] asComments asEnumList
        String sFunctionType sInitialValue sSummaryText sPrivate sModRecipe sFnGroup sNoDoc sFnFamily
        Integer iSize iCount iItem i iPos
        Boolean bIsMultiLine bFound
        
        Get IsMultiLineComment sComment to bIsMultiLine
        If (bIsMultiLine = False) Begin
            Move sComment to FuncLib.sHelp
            Function_Return FuncLib
        End 
        
        Get ParseHelpText sComment to FuncLib.sHelp
        If (FuncLib.sHelp <> "") Begin
            Move (Replace(FuncLib.sHelp, sComment, "")) to sComment
        End
        
        Move (StrSplitToArray(sComment, C_NewLine)) to asComments
        Move (SizeOfArray(asComments)) to iSize 
        Decrement iSize
        
        For iCount from 0 to iSize
            Case Begin
                Case (IsMetaTag(Self, asComments[iCount], eMethodType) = True)
                    Get ParseVariable asComments[iCount] to sFunctionType
                    Move sFunctionType to FuncLib.eFunctionType
                    Case Break 
                
                Case (IsMetaTag(Self, asComments[iCount], eSummaryText) = True)
                    Get ParseVariable asComments[iCount] to sSummaryText
                    Move sSummaryText to FuncLib.sSummary
                    Case Break
                    
                Case (IsMetaTag(Self, asComments[iCount], eEnumList) = True)
                    Get ParseEnumList asComments[iCount]             to FuncEnumList.asEnumList
                    Move (SizeOfArray(FuncEnumList.asEnumList) <> 0) to FuncLib.bFuncEnumList
                    Case Break
                    
                Case (IsMetaTag(Self, asComments[iCount], eInitValue) = True)
                    Get ParseVariable asComments[iCount] to sInitialValue
                    Move sInitialValue to FuncEnumList.sInitialValue
                    Case Break

                Case (IsMetaTag(Self, asComments[iCount], ePrivate) = True)
                    Get ParseVariable asComments[iCount] to sPrivate
                    Move (Lowercase(Trim(sPrivate)) = "true") to FuncLib.bPrivate
                    Case Break

                // { NoDoc = True } keeps a function out of the GENERATED help only - it stays
                // published, selectable and runnable. For a function whose behaviour is obvious
                // from its name, or one still being proven, where a manual entry would be noise.
                Case (IsMetaTag(Self, asComments[iCount], eNoDoc) = True)
                    Get ParseVariable asComments[iCount] to sNoDoc
                    Move (Lowercase(Trim(sNoDoc)) = "true") to FuncLib.bNoDoc
                    Case Break

                // { FnFamily } groups functions that do the same job on different keywords -
                // the fifteen legacy command-to-function converters, for instance. The generated
                // help renders a family as one table with a shared explanation instead of
                // repeating the same sentence per function.
                Case (IsMetaTag(Self, asComments[iCount], eFnFamily) = True)
                    Get ParseVariable asComments[iCount] to sFnFamily
                    Move (Trim(sFnFamily)) to FuncLib.sFnFamily
                    Case Break

                Case (IsMetaTag(Self, asComments[iCount], eModRecipe) = True)
                    Get ParseVariable asComments[iCount] to sModRecipe
                    Move sModRecipe to FuncLib.asModRecipe[SizeOfArray(FuncLib.asModRecipe)]
                    Case Break

                Case (IsMetaTag(Self, asComments[iCount], eFnGroup) = True)
                    Get ParseVariable asComments[iCount] to sFnGroup
                    // Resolve the { FnGroup } tag's human text (e.g. "Modernization") to its
                    // enum via the explicit converter - NOT a bare 'Move name-string to Integer'
                    // (that yields 0 / faults under DF26 on a non-Define string; see _ParameterIsEnum).
                    Move (FnGroupValue(Self, sFnGroup)) to FuncLib.eFunctionGroup
                    Case Break

                // { ParamHelp } may span several lines; ParseHelpTopic consumes exactly the
                // tag's own lines and reports the last one consumed, so tags placed AFTER it
                // ({ SummaryText }, { ModRecipe }, ...) parse normally. (The old "keep
                // eHelpTopic last" rule - it used to swallow every remaining line - is gone.)
                Case (IsMetaTag(Self, asComments[iCount], eHelpTopic) = True)
                    Get ParseHelpTopic iCount asComments (&iItem) to FuncEnumList.sParamHelp
                    Move iItem to iCount
                    Case Break
            Case End
        Loop
                
        Move FuncEnumList to FuncLib.FuncEnumList
        Function_Return FuncLib
    End_Function 
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    Function ParseVariable String sVariableValue Returns String
        Integer iPos
        
        Move (Pos("=", sVariableValue)) to iPos
        Move (Mid(sVariableValue, Length(sVariableValue), (iPos +1))) to sVariableValue
        Move (Trim(Replace("}", sVariableValue, ""))) to sVariableValue
        
        Function_Return sVariableValue
    End_Function
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    Function IsMultiLineComment String sComment Returns Boolean
        Boolean bOK
        String sMetaTagMulti
        
        Move (sComment contains '{' and sComment contains '}') to bOK
        Function_Return bOK
    End_Function
    
    { Visibility = Private }
    { Description  = "Helper function for the Procedure RegisterInterface." }
    { Description += "This will make sure that no formatting is lost for the Help text." }
    { Description += "Else the StrSplitToArray would remove how the help text is written," }
    { Description += "for a { Description = meta-tag for a function." }
    Function ParseHelpText String sComment Returns String
        String sHelpText
        Integer iPos
        
        Move "" to sHelpText
        Move (Pos('{', sComment)) to iPos
        If (iPos <> 0) Begin
            Move (Left(sComment, (iPos -1))) to sHelpText    
        End
        
        Function_Return sHelpText
    End_Function
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    Function ParseEnumList String sEnumList Returns String[]
        String[] asEnumList
        Integer iSize iCount iPos
        
        Move (Pos("=", sEnumList)) to iPos
        Move (Mid(sEnumList, Length(sEnumList), (iPos +1))) to sEnumList
        Move (Trim(Replace("}", sEnumList, ""))) to sEnumList
        Move (StrSplitToArray(sEnumList, ",")) to asEnumList
        Function_Return asEnumList
    End_Function
    
    { Visibility = Private }
    { Description = "Helper function for the Procedure RegisterInterface." }
    // Collects the { ParamHelp = ... } tag's text, which may span several lines. Consumes ONLY the
    // tag's own lines: it stops at the line carrying the tag's closing brace and reports that line
    // back via iConsumedTo, so the caller's tag scan continues with the NEXT line. The old version
    // swallowed EVERY remaining Description line - a tag placed after { ParamHelp } (typically
    // { SummaryText }) was never parsed, and the startup meta-sync then saw a BLANK parsed summary
    // and wiped the stored Functions.SummaryText on every launch (12 parameterized functions showed
    // an empty Summary Text in the Functions list, found 2026-07-05).
    Function ParseHelpTopic Integer iStart String[] asComments Integer ByRef iConsumedTo Returns String
        String sParamHelp sText sRaw
        Integer iSize iCount iPos
        Boolean bClosed

        Move "" to sParamHelp
        Move (SizeOfArray(asComments)) to iSize
        Decrement iSize
        Move iSize to iConsumedTo
        For iCount from iStart to iSize
            Move asComments[iCount] to sText
            Move (Trim(sText)) to sRaw
            // Hardening: a NEW tag opening while ParamHelp is still open means its closing
            // brace was forgotten in the source (EditorReIndent, 2026-07-05 - the follow-on
            // { SummaryText } line's own brace was read as ParamHelp's close and the summary
            // was swallowed). End ParamHelp here WITHOUT consuming the new tag's line, so
            // the caller parses it normally.
            If (iCount > iStart and Left(sRaw, 1) = "{") Begin
                Move (iCount - 1) to iConsumedTo
                Move iSize to iCount // Get out of here.
            End
            Else Begin
                Move (Right(sRaw, 1) = "}") to bClosed
                Move (Pos("=", sText)) to iPos
                If (iPos <> 0) Begin
                    Move (Mid(sText, Length(sText), (iPos +1))) to sText
                    Move (Trim(Replace("}", sText, ""))) to sText
                End
                Else If (bClosed = True) Begin
                    // A continuation line that closes the tag: drop the brace itself.
                    Move (Trim(Left(sRaw, (Length(sRaw) - 1)))) to sText
                End
                Append sParamHelp sText
                If (bClosed = True) Begin
                    Move iCount to iConsumedTo
                    Move iSize to iCount // Tag closed - get out of here.
                End
            End
        Loop
        Move (Replaces("\n", sParamHelp, C_NewLine)) to sParamHelp
        Function_Return sParamHelp
    End_Function
    
    Procedure PUBLIC_MESSAGES // For the Studio's Code Explorer
    End_Procedure

    // Case-insensitive membership test for a String[] - a plain loop, NOT SearchArray + RefFunc(DFSTRICMP).
    // That combination (with Self as the object) returned a false positive against this local accessor list,
    // making every Property look "protected" and silently suppressing the strip.
    Function _NameInList String sName String[] asList Returns Boolean
        Integer i iLast
        Move (Lowercase(sName)) to sName
        Move (SizeOfArray(asList) - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(asList[i]) = sName) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Returns the Nth (1-based) whitespace-delimited word of sText, or "" when there are fewer than N words.
    // Stateless on purpose: the funclib Tokenizer's asLineTokens / sOverstrikeLine come back wrong for a
    // declaration that FOLLOWS a Procedure/Function earlier in the file (sticky scope state) - which is the
    // line RemovePropertyPrivate must read - so it parses the raw source line itself.
    Function _NthWord String sText Integer iN Returns String
        String sWord sCh
        Integer iLen i iWord
        Boolean bInWord

        Move (Trim(sText)) to sText
        Move (Length(sText)) to iLen
        Move 0 to iWord
        Move False to bInWord
        Move "" to sWord
        For i from 1 to iLen
            Move (Mid(sText, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) Begin
                Move False to bInWord
            End
            Else Begin
                If (bInWord = False) Begin
                    Increment iWord
                    Move True to bInWord
                End
                If (iWord = iN) ;
                    Move (sWord + sCh) to sWord
            End
        Loop
        Function_Return sWord
    End_Function

    // Pulls the identifier tokens out of sText (maximal runs of A-Za-z0-9_ plus the '$' and '#' legacy
    // names carry - 'is$done', 'fn#' - one name, one run; 2026-09-13), dropping the boolean operator
    // word "not" AND any digit-leading token - an identifier can never start with a digit, so such a run
    // is a NUMBERED indicator or an item index (the '[0]' in 'Set Form_Datatype [0] to ...') and must not
    // surface as an indicator NAME (it became a 'Global_Variable Boolean 0' shim - LegacyApp,
    // 2026-07-05). Used to lift indicator NAMES out of a [bracket] expression or an
    // "Indicator A B C" list.
    Function _ExtractIdentifiers String sText Returns String[]
        String[] asResult
        String sTok sCh
        Integer iLen i iAsc
        Boolean bIn

        Move (Length(sText)) to iLen
        Move "" to sTok
        Move False to bIn
        For i from 1 to iLen
            Move (Mid(sText, 1, i)) to sCh
            Move (Ascii(sCh)) to iAsc
            If ((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or (iAsc >= 48 and iAsc <= 57) or sCh = "_" or sCh = "$" or sCh = "#") Begin
                Move (sTok + sCh) to sTok
                Move True to bIn
            End
            Else Begin
                If (bIn = True and Lowercase(sTok) <> "not" and (Ascii(sTok) < 48 or Ascii(sTok) > 57)) ;
                    Move sTok to asResult[SizeOfArray(asResult)]
                Move "" to sTok
                Move False to bIn
            End
        Loop
        If (bIn = True and Lowercase(sTok) <> "not" and (Ascii(sTok) < 48 or Ascii(sTok) > 57)) ;
            Move sTok to asResult[SizeOfArray(asResult)]
        Function_Return asResult
    End_Function

    // True if position iPos sits 'tight' against (immediately after, no space) an identifier char, a closing
    // ']' or a ')'. Tells array / property indexing (arr[i], a[i][j]) from an indicator bracket: a '[' that is
    // tight is an index; a '[' preceded by space / start / operator is an indicator. Also guards the 'Indicate'
    // keyword scan against a stray '...indicate ' embedded in a longer identifier.
    Function _IsTightPrefix String sText Integer iPos Returns Boolean
        String sCh
        Integer iAsc
        If (iPos <= 1) ;
            Function_Return False
        Move (Mid(sText, 1, iPos - 1)) to sCh
        Move (Ascii(sCh)) to iAsc
        Function_Return ((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or (iAsc >= 48 and iAsc <= 57) or sCh = "_" or sCh = "]" or sCh = ")")
    End_Function

    // Collect the legacy indicator names a source array USES (asUsed - from 'Indicate X' and standalone
    // '[X]' groups; RAW + unfiltered, incl. built-ins and SELECT) and DECLARES (asDeclared - from
    // 'Indicator X'). Read off the MASKED text (string literals overstruck); comment / image /
    // multi-line-string lines are skipped; array/property indexing (arr[i], 'names [i ]') is NOT collected.
    // Shared by _UndeclaredNamedIndicatorsIn (needs undeclared non-built-ins) and _ScopeHasSelectIndicator
    // (needs "is SELECT used") so the two - and the converters - can never disagree on what counts as an
    // indicator. Both outputs are CLEARED first; caller resets lexer state (ClearFuncLibProperties) beforehand.
    Procedure _CollectIndicatorNames String[] ByRef asSource String[] ByRef asUsed String[] ByRef asDeclared
        String[] asIdents
        String sLine sScan sLC sName sContent sWork
        Integer iCount iSize iBr iBrEnd i
        tTokenizer TD

        Move (ResizeArray(asUsed, 0))     to asUsed
        Move (ResizeArray(asDeclared, 0)) to asDeclared
        Move (SizeOfArray(asSource) - 1) to iSize
        For iCount from 0 to iSize
            // Keep the caller's UI alive during this tokenize-every-line scan (Nils 2026-07-09):
            // on the PLAN-BUILD path (AddNeededIndicatorCompanions -> _ScopeNeedsIndicatorCompanion
            // -> here) a big legacy file (~9700 lines in a real customer workspace) - froze the "Loading Refactoring
            // Plan..." marquee + elapsed-seconds status for a second-plus because the whole per-file
            // scan ran between the plan loop's yield beats. When the FT dock bridged its pump target
            // onto us (phoUIYieldTarget), route through DoYieldToUI so BOTH the marquee AND the seconds
            // stay live; otherwise (console / engine run) a bare Desktop pump animates the marquee. It
            // is read-only work, so a pumped paint/Cancel can't corrupt the scan.
            If (Mod(iCount, 256) = 0) Begin
                If (phoUIYieldTarget(Self) <> 0) ;
                    Send DoYieldToUI of (phoUIYieldTarget(Self))
                Else ;
                    Send PumpMsgQueue of Desktop
            End
            Move asSource[iCount] to sLine
            Get Tokenizer sLine to TD
            If (TD.bIsComment = False and TD.bIsBlank = False and TD.bIsInImage = False and TD.bIsInDF23MultiLineString = False) Begin
                Move (Trim(TD.sOverstrikeLine)) to sScan
                Move (Lowercase(sScan)) to sLC
                // 'Indicator X [Y Z]' DECLARATION (ChangeIndicatorToBoolean owns these) - record so we skip them.
                If (Pos("indicator ", sLC) = 1) Begin
                    Get _ExtractIdentifiers (Mid(sScan, Length(sScan), 11)) to asIdents
                    For i from 0 to (SizeOfArray(asIdents) - 1)
                        Move asIdents[i] to asDeclared[SizeOfArray(asDeclared)]
                    Loop
                End
                Else Begin
                    // 'Indicate X ...' USE -> X is the first word after the keyword (the indicator being SET).
                    Move (Pos("indicate ", sLC)) to iBr
                    If (iBr > 0 and (_IsTightPrefix(Self, sScan, iBr) = False)) Begin
                        Get _NthWord (Mid(sScan, Length(sScan), (iBr + 9))) 1 to sName
                        If (sName <> "") ;
                            Move sName to asUsed[SizeOfArray(asUsed)]
                    End
                    // '[X]' bracket USES -> identifiers inside each [...] group. Skip a '[' tight against an
                    // identifier / ']' / ')' (arr[i]) AND a SPACED index ('names [i ]', _IsIndexBracket).
                    Move sScan to sWork
                    Move (Pos("[", sWork)) to iBr
                    While (iBr > 0)
                        Move (Pos("]", sWork)) to iBrEnd
                        If (iBrEnd > iBr) Begin
                            If ((_IsTightPrefix(Self, sWork, iBr) = False) and (_IsIndexBracket(Self, sWork, iBr) = False)) Begin
                                Move (Mid(sWork, (iBrEnd - iBr - 1), (iBr + 1))) to sContent
                                Get _ExtractIdentifiers sContent to asIdents
                                For i from 0 to (SizeOfArray(asIdents) - 1)
                                    Move asIdents[i] to asUsed[SizeOfArray(asUsed)]
                                Loop
                            End
                            Move ("X" + Mid(sWork, Length(sWork), (iBrEnd + 1))) to sWork
                        End
                        Else Begin
                            Move "" to sWork
                        End
                        Move (Pos("[", sWork)) to iBr
                    Loop
                End
            End
        Loop
    End_Procedure

    // Returns the legacy NAMED indicators (raw, un-prefixed) that asSource USES - via 'Indicate X' or a
    // standalone '[X]' - but that carry no 'Indicator X' declaration of their own: exactly the names for
    // which DeclareRefactoredIndicators must splice a 'Global_Variable Boolean' once the converters rewrite
    // them to boolean-variable syntax (else the rewritten X / (X) is an undefined symbol). Built-ins
    // (Found/FindErr/Err), SELECT (DefineSelectMacro's job), digit-leading tokens (numbered indicators /
    // item indices) and array/property indexing (arr[i], 'names [i ]') are all excluded.
    //
    // This IS DeclareRefactoredIndicators' PASS 1 + name-filter, factored out so the refactor AND the
    // Auto-Select companion gate (cModAnalyzer.AddNeededIndicatorCompanions calls the scope wrapper below)
    // share ONE scan - the plan's decision to include the companion and the work the refactor actually does
    // can then never disagree. An EMPTY result means DeclareRefactoredIndicators would change nothing.
    // Caller resets lexer state (Send ClearFuncLibProperties) first; asSource ByRef = copy-avoidance only.
    Function _UndeclaredNamedIndicatorsIn String[] ByRef asSource Returns String[]
        String[] asUsed asDeclared asResult
        String sName
        Integer iCount iSize

        Move (SizeOfArray(asSource) - 1) to iSize
        If (iSize < 0) ;
            Function_Return asResult
        Send _CollectIndicatorNames (&asSource) (&asUsed) (&asDeclared)

        // Filter: keep a USED name only if it is NOT a built-in, NOT SELECT, NOT digit-leading (a NAMED
        // indicator is an identifier), NOT already declared 'Indicator X' here, and not already collected.
        Move (SizeOfArray(asUsed) - 1) to iSize
        For iCount from 0 to iSize
            Move asUsed[iCount] to sName
            // Skip DataFlex runtime indicators (Found/FindErr/Err/Select/SeqEof) + True/False literals - the
            // SAME canonical set _IndicatorVarName passes through - and any digit-leading token (a NAMED
            // indicator is an identifier, never numeric).
            If ((_IsBuiltInIndicatorName(Self, sName) = False) and (Ascii(sName) < 48 or Ascii(sName) > 57)) Begin
                If (_NameInList(Self, sName, asDeclared) = False and _NameInList(Self, sName, asResult) = False) Begin
                    Move sName to asResult[SizeOfArray(asResult)]
                End
            End
        Loop
        Function_Return asResult
    End_Function

    // True when sName is a NAME the indicator converters carry whole: a letter or underscore first,
    // then letters, digits, underscores and the '$' / '#' legacy names carry - exactly the rule
    // _IndicatorVarName applies, so what this admits the converters rename and what it refuses they
    // leave (2026-09-13: 'is$done' had read as odd and was pinned; DF26 takes the name).
    Function _IsPlainIdentifierName String sName Returns Boolean
        Integer i iLen iAsc
        String sCh
        Move (Length(sName)) to iLen
        If (iLen = 0) ;
            Function_Return False
        For i from 1 to iLen
            Move (Mid(sName, 1, i)) to sCh
            Move (Ascii(sCh)) to iAsc
            If (i = 1) Begin
                If (not((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or sCh = "_")) ;
                    Function_Return False
            End
            Else Begin
                If (not((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or (iAsc >= 48 and iAsc <= 57) or sCh = "_" or sCh = "$" or sCh = "#")) ;
                    Function_Return False
            End
        Loop
        Function_Return True
    End_Function

    // Pins one raw indicator token AS WRITTEN (uppercased) and, when it is not a plain identifier, its
    // identifier runs as well - so whichever form a converter captures the name in, it finds the pin.
    // Skips what no converter renames anyway: an empty token, not/true/false, a '|nn' system indicator
    // number, a '!n' macro argument, a digit-led token and the built-in names; a leading '~' is stripped.
    // asReasons stays index-parallel to asPinned (see _ComputePinnedIndicators).
    Procedure _PinRawIndicatorName String sRaw String sWhy Integer iLine String[] ByRef asPinned String[] ByRef asReasons
        String[] asRuns
        String sTok sLow
        Integer i
        Move (Trim(sRaw)) to sTok
        If (Left(sTok, 1) = "~") ;
            Move (Trim(Mid(sTok, Length(sTok), 2))) to sTok
        Move (Lowercase(sTok)) to sLow
        If (sTok = "" or sLow = "not" or sLow = "true" or sLow = "false" or Left(sTok, 1) = "|" or Left(sTok, 1) = "!") ;
            Procedure_Return
        If (Ascii(sTok) >= 48 and Ascii(sTok) <= 57) ;
            Procedure_Return
        If (_IsBuiltInIndicatorName(Self, sTok)) ;
            Procedure_Return
        If (_NameInList(Self, Uppercase(sTok), asPinned) = False) Begin
            Move (sWhy + "|" + String(iLine)) to asReasons[SizeOfArray(asPinned)]
            Move (Uppercase(sTok)) to asPinned[SizeOfArray(asPinned)]
        End
        If (_IsPlainIdentifierName(Self, sTok) = False) Begin
            Get _ExtractIdentifiers sTok to asRuns
            For i from 0 to (SizeOfArray(asRuns) - 1)
                If (_IsBuiltInIndicatorName(Self, asRuns[i]) = False and _NameInList(Self, Uppercase(asRuns[i]), asPinned) = False) Begin
                    Move (sWhy + "|" + String(iLine)) to asReasons[SizeOfArray(asPinned)]
                    Move (Uppercase(asRuns[i])) to asPinned[SizeOfArray(asPinned)]
                End
            Loop
        End
    End_Procedure

    /* 'Indicate X GROUP ANY|ALL [a b ...] [AND|OR ANY|ALL [...]]' -> 'Move (<expr>) to gbX' - the docs'
       form 4, measured against them 2026-09-13 (Nils: "how difficult would it be to resolve/refactor
       such lines as well?"). ANY joins a list with 'or', ALL with 'and'; 'not' or '~' in front of a
       member negates it; every further clause joins the whole with its own AND / OR, each clause in
       its own parentheses. Names go through _IndicatorVarName (the gb prefix; Found and the other
       built-ins stay bare). sCode is the CODE part of the line - comment gone, indentation gone;
       sIndent and sEndComment come back on the emitted line. The one prefix taken is 'If (cond)' as a
       single parenthesised group. A bracket in front, a legacy condition, a continued line, an empty
       list, a dangling 'not' or a name that is not a plain identifier all return False with sOut
       untouched - and the pin computation asks this same function, so a group line it will not write
       still freezes its names, and one it will write no longer does. PURE. */
    Function _GroupIndicateToMove String sCode String sIndent String sEndComment String ByRef sOut Returns Boolean
        String sTrim sLow sPrefix sTarget sRest sWord sList sExpr sClause sJoin sMember sName sGb sOp
        String[] asToks
        Integer iInd iGroup iBr iBrEnd i iClauses
        Boolean bNot bAll

        Move (Trim(sCode)) to sTrim
        Move (Lowercase(sTrim)) to sLow
        If (Right(sTrim, 1) = ";") ;
            Function_Return False
        Get _FindKeywordPos sLow "indicate" True 1 to iInd
        If (iInd = 0) ;
            Function_Return False
        Move (Trim(Left(sTrim, (iInd - 1)))) to sPrefix
        If (sPrefix <> "") Begin
            If (Lowercase(Left(sPrefix, 3)) <> "if ") ;
                Function_Return False
            If (_IsSingleParenGroup(Self, Trim(Mid(sPrefix, (Length(sPrefix) - 2), 3))) = False) ;
                Function_Return False
        End
        Move (Trim(Mid(sTrim, (Length(sTrim) - iInd - 7), (iInd + 8)))) to sRest
        Get _NthWord sRest 1 to sTarget
        Get _NthWord sRest 2 to sWord
        If (sTarget = "" or Lowercase(sWord) <> "group") ;
            Function_Return False
        If (_IsPlainIdentifierName(Self, sTarget) = False) ;
            Function_Return False
        Get _IndicatorVarName sTarget to sGb
        Get _FindKeywordPos (Lowercase(sRest)) "group" True 1 to iGroup
        Move (Trim(Mid(sRest, (Length(sRest) - iGroup - 4), (iGroup + 5)))) to sRest
        Move "" to sExpr
        Move "" to sJoin
        Move 0 to iClauses
        While (sRest <> "")
            Get _NthWord sRest 1 to sWord
            Move (Lowercase(sWord)) to sWord
            If (sWord <> "any" and sWord <> "all") ;
                Function_Return False
            Move (sWord = "all") to bAll
            Move (Pos("[", sRest)) to iBr
            Move (Pos("]", sRest)) to iBrEnd
            If (iBr = 0 or iBrEnd < iBr) ;
                Function_Return False
            If ((Lowercase(Trim(Left(sRest, (iBr - 1))))) <> sWord) ;
                Function_Return False
            Move (Trim(Mid(sRest, (iBrEnd - iBr - 1), (iBr + 1)))) to sList
            Move (StrSplitToArray(sList, " ")) to asToks
            Move "" to sClause
            Move False to bNot
            For i from 0 to (SizeOfArray(asToks) - 1)
                Move (Trim(asToks[i])) to sMember
                If (sMember <> "") Begin
                    If (Lowercase(sMember) = "not") Begin
                        Move True to bNot
                    End
                    Else Begin
                        If (Left(sMember, 1) = "~") Begin
                            Move True to bNot
                            Move (Mid(sMember, (Length(sMember) - 1), 2)) to sMember
                        End
                        If (_IsPlainIdentifierName(Self, sMember) = False) ;
                            Function_Return False
                        Get _IndicatorVarName sMember to sName
                        If (bNot = True) ;
                            Move ("not(" + sName + ")") to sName
                        If (sClause <> "") ;
                            Move (sClause + (If(bAll, " and ", " or "))) to sClause
                        Move (sClause + sName) to sClause
                        Move False to bNot
                    End
                End
            Loop
            If (sClause = "" or bNot = True) ;
                Function_Return False
            If (iClauses = 0) ;
                Move sClause to sExpr
            Else ;
                Move ("(" + sExpr + ") " + sJoin + " (" + sClause + ")") to sExpr
            Increment iClauses
            Move (Trim(Mid(sRest, (Length(sRest) - iBrEnd), (iBrEnd + 1)))) to sRest
            If (sRest <> "") Begin
                Get _NthWord sRest 1 to sOp
                Move (Lowercase(sOp)) to sJoin
                If (sJoin <> "and" and sJoin <> "or") ;
                    Function_Return False
                Move (Trim(Mid(sRest, (Length(sRest) - Length(sOp)), (Length(sOp) + 1)))) to sRest
                If (sRest = "") ;
                    Function_Return False
            End
        Loop
        If (iClauses = 0) ;
            Function_Return False
        Move (sIndent + (If((sPrefix <> ""), (sPrefix + " "), "")) + "Move (" + sExpr + ") to " + sGb) to sOut
        If (Trim(sEndComment) <> "") ;
            Move (sOut + "  " + Trim(sEndComment)) to sOut
        Function_Return True
    End_Function

    // Pins every token between brackets on sLine ('[not X]' -> X, '[ |122]' -> nothing, see _PinRawIndicatorName)
    // with reason sWhy: the ONE bracket walk for a #COMMAND body and for a raw '!'-led compiler directive.
    Procedure _PinBracketTokens String sLine String sWhy Integer iLine String[] ByRef asPinned String[] ByRef asReasons
        String[] asToks
        Integer iBr iBrEnd iTok
        Move (Pos("[", sLine)) to iBr
        While (iBr > 0)
            Move (Pos("]", sLine)) to iBrEnd
            If (iBrEnd > iBr) Begin
                Move (StrSplitToArray(Trim(Mid(sLine, (iBrEnd - iBr - 1), (iBr + 1))), " ")) to asToks
                For iTok from 0 to (SizeOfArray(asToks) - 1)
                    Send _PinRawIndicatorName asToks[iTok] sWhy iLine (&asPinned) (&asReasons)
                Loop
                Move ("X" + Mid(sLine, Length(sLine), (iBrEnd + 1))) to sLine
            End
            Else ;
                Move "" to sLine
            Move (Pos("[", sLine)) to iBr
        Loop
    End_Procedure

    /* ================================================================================================
       AN INCLUDE THAT CONVERTS WITH THE RUN (Nils 2026-09-14: "Build it").

       Pin reason (2) - a name read by a 'use'd local include - was unconditional, and its hint asked
       for a run nobody could start: "convert <include> and every program that uses it in the same
       run", when no scan row ever names an include and the engine only opens what was selected. One
       program, one .mac, one read: pinned for good.

       The lift: a local include CONVERTS WITH THE RUN - the engine appends it to its own file list
       (backup, the same line converters, the same whole-file pass, the same write) - when every file
       that shares an indicator name with it converts the same way, so the include's read and the
       program's write move together. Judged per include, once per run, from conditions LOCAL to each
       file, so that every caller (the engine, the analyzer's grid, its plan) reaches the same verdict
       in any order:
         plain  - no macro code at all: a #COMMAND body, a #DATA block, a '!' directive line are never
                  refactored, so a read inside one would stay legacy while the write moved
         flat   - no local include of its own (the run follows one level, not a chain)
         own    - it pins none of its own names (a group line the converter does not write, a
                  directive, an odd name - walk (1) of _ComputePinnedIndicators)
         users  - every file in its folder (and the run's folders) that 'use's it is in the run,
                  pasRunFiles: the engine's exact selection, or the analyzer's "*" (every file counts;
                  the engine re-judges at run time - the safe direction: a lift the grid promised but
                  the run cannot honour keeps the pin and the declaration's NOTE, never the reverse)
         holds  - no user keeps one of the include's indicator names legacy for a reason of its own
                  (its walk (1) pins)
         forms  - every mention of a user's indicator name in the include is one the LINE converters
                  rewrite: inside a '[...]' group, the target of an 'Indicate', a name on an 'Indicator'
                  declaration. A bare expression read ('If (X)') is legal Boolean syntax no line
                  converter touches; in a program the declaring file's DeclareRefactoredIndicators pass
                  renames it, but an include declares nothing and its own pass counts only bracket and
                  Indicate forms as uses, so such a read would stay behind under the legacy name
       and TOGETHER: two includes of one user that share an indicator name are one unit. The component
       is closed over "shares a name through a common user" and lifts as a whole or not at all -
       otherwise a lifting include would rename a read the other, unlifted one still makes under the
       legacy name, and the shim DeclareRefactoredIndicators writes would make that COMPILE: a silent
       logic bug, the one outcome this whole mechanism exists to prevent.

       Memoised per include per run (pasLiftVerdicts); the per-file facts - walk (1) pins, indicator
       candidates, local includes - once per file, one packed row each (pasLiftFactRows); an include's
       users from the run's 'Use' index, built once (pasLiftUseLeafs / pasLiftUseUsers). Keyed with the
       file size, the staleness class of pasPinIncKeys. Cleared by
       _SetRunFiles / _SetRunFilesAll / _InitializeFuncLib. No run context (pasRunFiles empty) = no
       lift, and the reason string reads exactly as before, so nothing downstream changes by accident.
       ================================================================================================ */

    // "<pathLc>|<size>" - the memo key every lift table uses for a file.
    Function _LiftFileKey String sPath Returns String
        Function_Return (Lowercase(sPath) + "|" + String(rfFileSizeLive(sPath)))
    End_Function

    // The folder of sPath, up to and including its last separator ("" when it has none). Inline, like
    // _ComputePinnedIndicators' own copy: no global path helper - this file compiles into every program.
    Function _LiftFolderOf String sPath Returns String
        Integer i
        String sCh
        Move (Length(sPath)) to i
        While (i > 0)
            Move (Mid(sPath, 1, i)) to sCh
            If (sCh = "\" or sCh = "/") ;
                Function_Return (Left(sPath, i))
            Move (i - 1) to i
        Loop
        Function_Return ""
    End_Function

    // The 'use <file>' targets of asLines that EXIST in sFolder (full paths) - the pin walk's own
    // resolution: a library 'use cX.pkg' is not there and is skipped.
    Function _LiftLocalUses String[] ByRef asLines String sFolder Returns String[]
        String[] asOut
        String sTrim sUseFile
        Integer i iLast
        If (sFolder = "") ;
            Function_Return asOut
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asLines[i])) to sTrim
            If (Lowercase(Left(sTrim, 4)) = "use " and Left(sTrim, 2) <> "//") Begin
                Get _NthWord sTrim 2 to sUseFile
                Move (vFolderFormat(sFolder) + sUseFile) to sUseFile
                If (vFilePathExists(sUseFile)) ;
                    Move sUseFile to asOut[SizeOfArray(asOut)]
            End
        Loop
        Function_Return asOut
    End_Function

    // True when sName ends with a DataFlex source extension (the app's standard list, plus .mac and .h)
    // - what the users scan bothers to read; a .dat or an .exe in the folder 'use's nothing.
    Function _LiftIsSourceName String sName Returns Boolean
        String[] asExt
        String sLow sExt
        Integer i
        Move (Lowercase(Trim(sName))) to sLow
        Move (StrSplitToArray((Lowercase(CS_StdExtensions) + ";*.mac;*.h"), ";")) to asExt
        For i from 0 to (SizeOfArray(asExt) - 1)
            Move (Replaces("*", Trim(asExt[i]), "")) to sExt
            If (sExt <> "" and Length(sLow) > Length(sExt)) Begin
                If (Right(sLow, Length(sExt)) = sExt) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    /* THE FACTS ROW of one file - three parts separated by Character(1), each led by a one-letter tag
       so that no part is ever empty (a split must never lose a part): "S" + the names its own walk (1)
       pins, "C" + its renameable indicator names, "I" + its local includes (full paths); items within a
       part Character(2)-separated. Names UPPERCASE, as the flat keys were. */
    Function _LiftJoinPart String[] asItems Returns String
        String sOut
        Integer i
        Move "" to sOut
        For i from 0 to (SizeOfArray(asItems) - 1)
            If (i = 0) ;
                Move asItems[i] to sOut
            Else ;
                Move (sOut + Character(2) + asItems[i]) to sOut
        Loop
        Function_Return sOut
    End_Function

    Function _LiftPackFacts String[] ByRef asSec1 String[] ByRef asCand String[] ByRef asInc Returns String
        String[] asS asC
        String sS sC sI
        Integer i
        For i from 0 to (SizeOfArray(asSec1) - 1)
            Move (Uppercase(asSec1[i])) to asS[i]
        Loop
        For i from 0 to (SizeOfArray(asCand) - 1)
            Move (Uppercase(Trim(asCand[i]))) to asC[i]
        Loop
        Get _LiftJoinPart asS   to sS
        Get _LiftJoinPart asC   to sC
        Get _LiftJoinPart asInc to sI
        Function_Return ("S" + sS + Character(1) + "C" + sC + Character(1) + "I" + sI)
    End_Function

    // One part of a file's facts row - iPart 1 = the names its own walk (1) pins, 2 = its renameable
    // indicator names, 3 = its local includes. Empty when the file has no row yet or the part is empty.
    // The caller holds the tables (fetched once), so a per-user lookup is one native search and one
    // split - never a property copy.
    Function _LiftFactsOf String sKey Integer iPart String[] ByRef asScanned String[] ByRef asRows Returns String[]
        String[] asParts asOut
        String sPart
        Integer iAt
        Move (SearchArray(sKey, asScanned)) to iAt
        If (iAt = -1) ;
            Function_Return asOut
        Move (StrSplitToArray(asRows[iAt], (Character(1)))) to asParts
        If (iPart < 1 or iPart > SizeOfArray(asParts)) ;
            Function_Return asOut
        Move asParts[iPart - 1] to sPart
        // the tag letter off
        Move (Right(sPart, (Length(sPart) - 1))) to sPart
        If (sPart = "") ;
            Function_Return asOut
        Move (StrSplitToArray(sPart, (Character(2)))) to asOut
        Function_Return asOut
    End_Function

    // Panel nudge for the lift's own walks (the 'Use' index, the facts reads): the text and the
    // per-file bar retargeted to the walk, wall-clock gated exactly like _NudgeLineProgress. A walk
    // over the 1,414 users of one include showed NOTHING before this - both bars stood still for
    // minutes and the panel still named the previous function (Nils 2026-09-21). No panel = no-op.
    Procedure _LiftNudge Integer iDone Integer iTotal String sLabel
        Boolean bDue
        If (ghoStatusPanel = 0) ;
            Procedure_Return
        If (Active_State(ghoStatusPanel) = False) ;
            Procedure_Return
        If (sLabel = "") ;
            Procedure_Return
        Get PanelPaintDue of ghoStatusPanel to bDue
        If (bDue = False) ;
            Procedure_Return
        Set pbLiftBarRetargeted to True
        Set piMaximum of ghoStatusPanel to iTotal
        Send Update_StatusPanel of ghoStatusPanel (sLabel * String(iDone + 1) * "of:" * String(iTotal))
        Set piPosition of ghoProgressBar to (iDone + 1)
    End_Procedure


    // Makes sure the include-scan identifier keys ("<pathLc>|<size>|<IDENT>", pasPinIncKeys) hold every
    // file in asPaths - the keys walk (2) builds for the includes of the file it pins, built the same
    // way, so the lift can ask "does this file mention NAME" with one binary search. On the CALLER'S
    // tables (fetched once per verdict, stored once at its end): a Get + sort + Set per include was
    // O(includes x keys) over a component of hundreds. Returns how many files were added.
    Function _LiftEnsureIdentKeysMany String[] ByRef asPaths String[] ByRef asIdScanned String[] ByRef asIdKeys Returns Integer
        String[] asLines asIdents
        String sKey
        Integer i j iAdded
        Move 0 to iAdded
        For i from 0 to (SizeOfArray(asPaths) - 1)
            Get _LiftFileKey asPaths[i] to sKey
            If (SearchArray(sKey, asIdScanned) = -1) Begin
                Move (rfReadEncodedFileAsStringArray(asPaths[i])) to asLines
                Get _IdentifierRunsFromLines (&asLines) to asIdents
                For j from 0 to (SizeOfArray(asIdents) - 1)
                    Move (sKey + "|" + asIdents[j]) to asIdKeys[SizeOfArray(asIdKeys)]
                Loop
                Move sKey to asIdScanned[SizeOfArray(asIdScanned)]
                Increment iAdded
            End
        Loop
        // ONE sort per batch, and only when something came in - the binary searches rest on it.
        If (iAdded > 0) ;
            Move (SortArray(asIdKeys)) to asIdKeys
        Function_Return iAdded
    End_Function

    // The one-file form against the stored tables. Returns the file's key.
    Function _LiftEnsureIdentKeys String sPath Returns String
        String[] asOne asIdScanned asIdKeys
        String sKey
        Integer iAdded
        Move sPath to asOne[0]
        Get pasPinIncScanned to asIdScanned
        Get pasPinIncKeys    to asIdKeys
        Get _LiftEnsureIdentKeysMany (&asOne) (&asIdScanned) (&asIdKeys) to iAdded
        If (iAdded > 0) Begin
            Set pasPinIncScanned to asIdScanned
            Set pasPinIncKeys    to asIdKeys
        End
        Get _LiftFileKey sPath to sKey
        Function_Return sKey
    End_Function

    /* Makes sure the lift facts of EVERY file in asPaths are in the CALLER'S tables (fetched once per
       verdict, stored once at its end - _LiftStoreTables): what each keeps legacy on its own (walk (1)),
       its renameable indicator names, its local includes (_LiftPackFacts). Files already known cost one
       native search each. The panel shows the walk (an include used by 1,414 files reads 1,414 files
       here) - sLabel "" = silent. Returns how many files were added. */
    Function _LiftEnsureFactsMany String[] ByRef asPaths String sLabel String[] ByRef asScanned String[] ByRef asRows Returns Integer
        String[] asLines asSec1 asCand asInc
        String sKey sFolder sRow
        Integer i iLast iAdded
        Move (SizeOfArray(asPaths) - 1) to iLast
        Move 0 to iAdded
        For i from 0 to iLast
            Send _LiftNudge i (iLast + 1) sLabel
            Get _LiftFileKey asPaths[i] to sKey
            If (SearchArray(sKey, asScanned) = -1) Begin
                Move (rfReadEncodedFileAsStringArray(asPaths[i])) to asLines
                // Walk (1) only ("" path: no include scan, no cache) - what this file keeps legacy on its own.
                Get _ComputePinnedIndicators (&asLines) "" to asSec1
                Get _RawIndicatorCandidates (&asLines) to asCand
                Get _LiftFolderOf asPaths[i] to sFolder
                Get _LiftLocalUses (&asLines) sFolder to asInc
                Get _LiftPackFacts (&asSec1) (&asCand) (&asInc) to sRow
                Move sKey to asScanned[SizeOfArray(asScanned)]
                Move sRow to asRows[SizeOfArray(asRows)]
                Increment iAdded
            End
        Loop
        Function_Return iAdded
    End_Function

    // The one-file form. Returns the file's key.
    Function _LiftEnsureFileFacts String sPath Returns String
        String[] asOne asScanned asRows
        String sKey
        Integer iAdded
        Move sPath to asOne[0]
        Get pasLiftUserScanned to asScanned
        Get pasLiftFactRows    to asRows
        Get _LiftEnsureFactsMany (&asOne) "" (&asScanned) (&asRows) to iAdded
        If (iAdded > 0) Begin
            Set pasLiftUserScanned to asScanned
            Set pasLiftFactRows    to asRows
        End
        Get _LiftFileKey sPath to sKey
        Function_Return sKey
    End_Function

    // The verdict's tables back into the properties - only the ones that grew (each Set is a copy).
    Procedure _LiftStoreTables String[] ByRef asScanned String[] ByRef asRows String[] ByRef asIdScanned String[] ByRef asIdKeys Integer iFactsBefore Integer iIdBefore
        If (SizeOfArray(asScanned) <> iFactsBefore) Begin
            Set pasLiftUserScanned to asScanned
            Set pasLiftFactRows    to asRows
        End
        If (SizeOfArray(asIdScanned) <> iIdBefore) Begin
            Set pasPinIncScanned to asIdScanned
            Set pasPinIncKeys    to asIdKeys
        End
    End_Procedure

    /* THE RUN'S 'USE' INDEX, built once per run: every source file of the run's folders (plus
       sExtraFolder - an include's own, when it lies elsewhere) read ONCE, and under the lowercase leaf
       of each 'use <file>' line the full path of the file that uses it, once per file. The users
       question then costs one search. It used to read the whole workspace again for EVERY include
       asked about - 3,442 files per include, on a workspace whose report views 'use' five local
       includes each (2026-09-21, the 12-minute stall on one file). A folder joins the index once. */
    Procedure _LiftEnsureUseIndex String sExtraFolder
        String[] asDone asLeafs asUsers asRunDirs asTodo asLines asSeen
        tRFSearchResult[] aFound
        String sDir sPath sTrim sUseFile sLeaf
        Integer i j k iLast iAt
        Get pasLiftUseFolders to asDone
        Get pasRunFolders to asRunDirs
        If (Trim(sExtraFolder) <> "") ;
            Move (vFolderFormat(sExtraFolder)) to asRunDirs[SizeOfArray(asRunDirs)]
        For i from 0 to (SizeOfArray(asRunDirs) - 1)
            Move (vFolderFormat(asRunDirs[i])) to sDir
            If (SearchArray(Lowercase(sDir), asDone) = -1) Begin
                Move (Lowercase(sDir)) to asDone[SizeOfArray(asDone)]
                Move sDir to asTodo[SizeOfArray(asTodo)]
            End
        Loop
        If (SizeOfArray(asTodo) = 0) ;
            Procedure_Return
        Get pasLiftUseLeafs to asLeafs
        Get pasLiftUseUsers to asUsers
        For i from 0 to (SizeOfArray(asTodo) - 1)
            Move (rfFileSearch((asTodo[i] + "*.*"), DIRMODE_FILES_ONLY, False)) to aFound
            Move (SizeOfArray(aFound) - 1) to iLast
            For j from 0 to iLast
                Send _LiftNudge j (iLast + 1) "Indexing which files 'use' which include - file:"
                If (_LiftIsSourceName(Self, aFound[j].sFilename) = True) Begin
                    Move (asTodo[i] + aFound[j].sFilename) to sPath
                    Move (rfReadEncodedFileAsStringArray(sPath)) to asLines
                    Move (ResizeArray(asSeen, 0)) to asSeen
                    For k from 0 to (SizeOfArray(asLines) - 1)
                        Move (Trim(asLines[k])) to sTrim
                        If (Lowercase(Left(sTrim, 4)) = "use " and Left(sTrim, 2) <> "//") Begin
                            Get _NthWord sTrim 2 to sUseFile
                            Move (Lowercase(ExtractFileName(sUseFile))) to sLeaf
                            // a file counts once under a leaf however many times it 'use's it
                            If (sLeaf <> "" and SearchArray(sLeaf, asSeen) = -1) Begin
                                Move sLeaf to asSeen[SizeOfArray(asSeen)]
                                Move (SearchArray(sLeaf, asLeafs)) to iAt
                                If (iAt = -1) Begin
                                    Move sLeaf to asLeafs[SizeOfArray(asLeafs)]
                                    Move sPath to asUsers[SizeOfArray(asUsers)]
                                End
                                Else ;
                                    Move (asUsers[iAt] + Character(2) + sPath) to asUsers[iAt]
                            End
                        End
                    Loop
                End
            Loop
        Loop
        Set pasLiftUseFolders to asDone
        Set pasLiftUseLeafs   to asLeafs
        Set pasLiftUseUsers   to asUsers
    End_Procedure

    // Every source file that 'use's the include (full paths, on-disk case), from the run's 'Use' index
    // (the include's own folder joins it when it is not one of the run's). The include itself is
    // skipped; a 'use' is matched by leaf name, which can only over-include (a same-named include in
    // another folder) - the safe direction, a lift refused rather than granted.
    Function _LiftUsersIn String sIncPath String[] ByRef asLeafs String[] ByRef asUsersIdx Returns String[]
        String[] asAll asOut
        String sLeaf
        Integer iAt i
        Move (Lowercase(ExtractFileName(sIncPath))) to sLeaf
        Move (SearchArray(sLeaf, asLeafs)) to iAt
        If (iAt = -1) ;
            Function_Return asOut
        Move (StrSplitToArray(asUsersIdx[iAt], (Character(2)))) to asAll
        For i from 0 to (SizeOfArray(asAll) - 1)
            If (Lowercase(asAll[i]) <> Lowercase(sIncPath)) ;
                Move asAll[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    // The index tables for a path's folder into the caller's locals: built or extended when the folder
    // is new to the index, and (re)fetched only then - or on the first call, when the locals are empty.
    Procedure _LiftIndexFor String sPath String[] ByRef asLeafs String[] ByRef asUsersIdx
        String[] asDone
        String sFolder
        Integer iBefore
        Get pasLiftUseFolders to asDone
        Move (SizeOfArray(asDone)) to iBefore
        Get _LiftFolderOf sPath to sFolder
        Send _LiftEnsureUseIndex sFolder
        Get pasLiftUseFolders to asDone
        If (SizeOfArray(asDone) <> iBefore or SizeOfArray(asLeafs) = 0) Begin
            Get pasLiftUseLeafs to asLeafs
            Get pasLiftUseUsers to asUsersIdx
        End
    End_Procedure

    // The one-call form: the index for the include's folder, then the lookup.
    Function _LiftIncludeUsers String sIncPath Returns String[]
        String[] asLeafs asUsersIdx asOut
        Send _LiftIndexFor sIncPath (&asLeafs) (&asUsersIdx)
        Get _LiftUsersIn sIncPath (&asLeafs) (&asUsersIdx) to asOut
        Function_Return asOut
    End_Function

    // Do two includes of one user share an indicator name: a candidate of either mentioned in the other?
    // A candidate made of identifier characters is one binary search in the other's identifier keys;
    // one carrying anything else ('$'-names, the measured case) takes the whole-word scan of the other's
    // lines, the same fallback walk (2) uses - the equivalence is never stretched past where it holds.
    // The caller has both files' facts and identifier keys in the tables it passes (fetched once).
    Function _LiftIncludesShare String sPathJ String sPathK String[] ByRef asScanned String[] ByRef asRows String[] ByRef asIdKeys Returns Boolean
        String[] asCand asLinesJ asLinesK
        String sKeyJ sKeyK
        Integer i
        Boolean bPure bReadJ bReadK bRef
        Get _LiftFileKey sPathJ to sKeyJ
        Get _LiftFileKey sPathK to sKeyK
        Move False to bReadJ
        Move False to bReadK
        Get _LiftFactsOf sKeyJ 2 (&asScanned) (&asRows) to asCand
        For i from 0 to (SizeOfArray(asCand) - 1)
            Get _IsPlainIdentifierName asCand[i] to bPure
            If (bPure = True and Pos("$", asCand[i]) = 0 and Pos("#", asCand[i]) = 0) Begin
                If (BinarySearchArray((sKeyK + "|" + asCand[i]), asIdKeys) <> -1) ;
                    Function_Return True
            End
            Else Begin
                If (bReadK = False) Begin
                    Move (rfReadEncodedFileAsStringArray(sPathK)) to asLinesK
                    Move True to bReadK
                End
                Get _LinesReferenceName (&asLinesK) asCand[i] to bRef
                If (bRef = True) ;
                    Function_Return True
            End
        Loop
        Get _LiftFactsOf sKeyK 2 (&asScanned) (&asRows) to asCand
        For i from 0 to (SizeOfArray(asCand) - 1)
            Get _IsPlainIdentifierName asCand[i] to bPure
            If (bPure = True and Pos("$", asCand[i]) = 0 and Pos("#", asCand[i]) = 0) Begin
                If (BinarySearchArray((sKeyJ + "|" + asCand[i]), asIdKeys) <> -1) ;
                    Function_Return True
            End
            Else Begin
                If (bReadJ = False) Begin
                    Move (rfReadEncodedFileAsStringArray(sPathJ)) to asLinesJ
                    Move True to bReadJ
                End
                Get _LinesReferenceName (&asLinesJ) asCand[i] to bRef
                If (bRef = True) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    // Are ALL of sName's mentions in these lines in a form the LINE converters rewrite - inside a '[...]'
    // group, the target of an 'Indicate', a name on an 'Indicator' declaration? See 'forms' in the block
    // above: a bare expression read would stay behind under the legacy name.
    Function _LiftReadsAreConvertible String[] ByRef asLines String sName Returns Boolean
        String sCode sLC sWork sTarget
        Integer i iLast iBr iBrEnd iPos iTgt
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            If (sCode <> "" and _FindKeywordPos(Self, sCode, sName, True, 1) > 0) Begin
                Move (Lowercase(Trim(sCode))) to sLC
                If (Left(sLC, 10) <> "indicator ") Begin
                    // blank every [...] group, then the target of an Indicate; what is left must not name it
                    Move sCode to sWork
                    Move (Pos("[", sWork)) to iBr
                    While (iBr > 0)
                        Move (Pos("]", sWork)) to iBrEnd
                        If (iBrEnd > iBr) ;
                            Move (Left(sWork, (iBr - 1)) + Repeat(" ", (iBrEnd - iBr + 1)) + Mid(sWork, Length(sWork), (iBrEnd + 1))) to sWork
                        Else ;
                            Move (Left(sWork, (iBr - 1)) + " " + Mid(sWork, Length(sWork), (iBr + 1))) to sWork
                        Move (Pos("[", sWork)) to iBr
                    Loop
                    Move (_FindKeywordPos(Self, sWork, "indicate", True, 1)) to iPos
                    If (iPos > 0) Begin
                        Get _NthWord (Mid(sWork, Length(sWork), (iPos + 9))) 1 to sTarget
                        If (Lowercase(sTarget) = Lowercase(sName)) Begin
                            Move (_FindKeywordPos(Self, sWork, sName, True, (iPos + 8))) to iTgt
                            If (iTgt > 0) ;
                                Move (Left(sWork, (iTgt - 1)) + Repeat(" ", Length(sName)) + Mid(sWork, Length(sWork), (iTgt + Length(sName)))) to sWork
                        End
                    End
                    If (_FindKeywordPos(Self, sWork, sName, True, 1) > 0) ;
                        Function_Return False
                End
            End
        Loop
        Function_Return True
    End_Function

    // The conditions LOCAL to one include (the block above): True and sWhy "" when it passes, else False
    // with sWhy = MACRO | NESTED | PINS|<NAME> | USER|<leaf> | HOLDS|<leaf>|<NAME> | EXPR|<NAME>.
    // pasRunFiles must be set (the verdict function guards that). The six tables are the verdict's
    // locals (index leafs/users, facts keys/rows, identifier keys/scanned): read and grown here, never
    // copied; the index tables are filled (or extended for a new folder) here when the users question
    // is reached, never earlier (_LiftIndexFor).
    Function _LiftIncludeLocal String sIncPath String ByRef sWhy String[] ByRef asLeafs String[] ByRef asUsersIdx String[] ByRef asScanned String[] ByRef asRows String[] ByRef asIdScanned String[] ByRef asIdKeys Returns Boolean
        String[] asLines asRun asUsers asCand asInc asOwn asOne
        Boolean[] abMacro
        String sKey sUserKey
        Integer i j iVoid
        Boolean bAll bPure bMentions bForms
        Move "" to sWhy
        Move (rfReadEncodedFileAsStringArray(sIncPath)) to asLines
        Get MacroCodeFlags (&asLines) to abMacro
        For i from 0 to (SizeOfArray(abMacro) - 1)
            If (abMacro[i] = True) Begin
                Move "MACRO" to sWhy
                Function_Return False
            End
        Loop
        Move sIncPath to asOne[0]
        Get _LiftEnsureFactsMany (&asOne) "" (&asScanned) (&asRows) to iVoid
        Get _LiftFileKey sIncPath to sKey
        Get _LiftFactsOf sKey 3 (&asScanned) (&asRows) to asInc
        If (SizeOfArray(asInc) > 0) Begin
            Move "NESTED" to sWhy
            Function_Return False
        End
        Get _LiftFactsOf sKey 1 (&asScanned) (&asRows) to asOwn
        If (SizeOfArray(asOwn) > 0) Begin
            Move ("PINS|" + asOwn[0]) to sWhy
            Function_Return False
        End
        Get pasRunFiles to asRun
        Move False to bAll
        If (SizeOfArray(asRun) > 0) ;
            Move (asRun[0] = "*") to bAll
        // The 'Use' index (built once per run, extended per new folder) - first needed here, so an
        // include refused above never pays for it.
        Send _LiftIndexFor sIncPath (&asLeafs) (&asUsersIdx)
        Get _LiftUsersIn sIncPath (&asLeafs) (&asUsersIdx) to asUsers
        If (bAll = False) Begin
            For i from 0 to (SizeOfArray(asUsers) - 1)
                If (BinarySearchArray(Lowercase(asUsers[i]), asRun) = -1) Begin
                    Move ("USER|" + ExtractFileName(asUsers[i])) to sWhy
                    Function_Return False
                End
            Loop
        End
        // Every user's facts (one read each, once per run), and this include's identifier keys.
        Get _LiftEnsureFactsMany (&asUsers) ("Checking include " + ExtractFileName(sIncPath) + " - reading the files that use it:") (&asScanned) (&asRows) to iVoid
        Get _LiftEnsureIdentKeysMany (&asOne) (&asIdScanned) (&asIdKeys) to iVoid
        // Per user, every indicator name of theirs the include mentions: not held legacy by that user,
        // and mentioned only in forms the line converters rewrite.
        For i from 0 to (SizeOfArray(asUsers) - 1)
            Get _LiftFileKey asUsers[i] to sUserKey
            Get _LiftFactsOf sUserKey 2 (&asScanned) (&asRows) to asCand
            For j from 0 to (SizeOfArray(asCand) - 1)
                Get _IsPlainIdentifierName asCand[j] to bPure
                If (bPure = True and Pos("$", asCand[j]) = 0 and Pos("#", asCand[j]) = 0) ;
                    Move (BinarySearchArray((sKey + "|" + asCand[j]), asIdKeys) <> -1) to bMentions
                Else ;
                    Get _LinesReferenceName (&asLines) asCand[j] to bMentions
                If (bMentions = True) Begin
                    Get _LiftFactsOf sUserKey 1 (&asScanned) (&asRows) to asOwn
                    If (SearchArray(asCand[j], asOwn) <> -1) Begin
                        Move ("HOLDS|" + ExtractFileName(asUsers[i]) + "|" + asCand[j]) to sWhy
                        Function_Return False
                    End
                    Get _LiftReadsAreConvertible (&asLines) asCand[j] to bForms
                    If (bForms = False) Begin
                        Move ("EXPR|" + asCand[j]) to sWhy
                        Function_Return False
                    End
                End
            Loop
        Loop
        Function_Return True
    End_Function

    // THE VERDICT for one include: does it convert with the run? Memoised per run. Judged together with
    // its component - every include that shares an indicator name with it through a common user, closed
    // transitively: all lift, or none. sWhy carries the first failing member's reason - its own form when
    // that member is this include, "VIA|<leaf>" when it is a partner. No run context = False with "".
    // The include's OWN conditions are judged first, and EVERY PARTNER'S THE MOMENT IT JOINS
    // (2026-09-21): one failing member fails the whole component whatever the rest say, so the walk
    // stops at the first - it no longer reads the 1,414 users of a hub include that carries its own
    // include before discovering that. Same verdict as the full walk; only the "VIA|<leaf>" can name a
    // different (equally failing) partner. All six tables live in locals for the whole verdict and go
    // back to the properties once at its end (_LiftStoreTables) - a property Get or Set of a String[]
    // copies the whole array, and the old walk paid that per user of every member.
    Function _LiftIncludeVerdict String sIncPath String ByRef sWhy Returns Boolean
        String[] asRun asMemo asComp asUsers asInc asCands asCandsLc asOne
        String[] asLeafs asUsersIdx asScanned asRows asIdScanned asIdKeys
        String sKey sVal sUserKey sKeyJ sLocalWhy sFailLeaf sFailWhy sLeaf
        Integer i j k m iLen iFail iFactsBefore iIdBefore iVoid
        Boolean bOK bFound bShare
        Move "" to sWhy
        Get pasRunFiles to asRun
        If (SizeOfArray(asRun) = 0) ;
            Function_Return False
        Get _LiftFileKey sIncPath to sKey
        Get pasLiftVerdicts to asMemo
        Move (Length(sKey) + 1) to iLen
        For i from 0 to (SizeOfArray(asMemo) - 1)
            If (Left(asMemo[i], iLen) = (sKey + "|")) Begin
                Move (Mid(asMemo[i], (Length(asMemo[i]) - iLen), (iLen + 1))) to sVal
                If (sVal = "1") ;
                    Function_Return True
                Move (Mid(sVal, (Length(sVal) - 2), 3)) to sWhy
                Function_Return False
            End
        Loop
        // The tables, ONCE (see above). The 'Use' index is NOT built here: an include refused for its
        // macro code, its own include or its own pins never needs it, and building it reads the whole
        // workspace once (12 s on 3,445 files) - _LiftIncludeLocal asks for it when it reaches users.
        Get pasLiftUserScanned to asScanned
        Get pasLiftFactRows    to asRows
        Get pasPinIncScanned   to asIdScanned
        Get pasPinIncKeys      to asIdKeys
        Move (SizeOfArray(asScanned))   to iFactsBefore
        Move (SizeOfArray(asIdScanned)) to iIdBefore
        // The seed's own conditions first: a refusal here is the component's refusal.
        Get _LiftIncludeLocal sIncPath (&sLocalWhy) (&asLeafs) (&asUsersIdx) (&asScanned) (&asRows) (&asIdScanned) (&asIdKeys) to bOK
        If (bOK = False) Begin
            Get pasLiftVerdicts to asMemo
            Move (sKey + "|0|" + sLocalWhy) to asMemo[SizeOfArray(asMemo)]
            Set pasLiftVerdicts to asMemo
            Send _LiftStoreTables (&asScanned) (&asRows) (&asIdScanned) (&asIdKeys) iFactsBefore iIdBefore
            Move sLocalWhy to sWhy
            Function_Return False
        End
        // The component: work-list closure over "another include of one of my users mentions one of
        // my indicator names, or I one of its". A partner that shares joins - and is judged at once.
        Move sIncPath to asComp[0]
        Move -1 to iFail
        Move "" to sFailLeaf
        Move "" to sFailWhy
        Move 0 to i
        While (i < SizeOfArray(asComp) and bOK = True)
            Move (ExtractFileName(asComp[i])) to sLeaf
            Send _LiftIndexFor asComp[i] (&asLeafs) (&asUsersIdx)
            Get _LiftUsersIn asComp[i] (&asLeafs) (&asUsersIdx) to asUsers
            Get _LiftEnsureFactsMany (&asUsers) ("Checking include " + sLeaf + " - reading the files that use it:") (&asScanned) (&asRows) to iVoid
            // every OTHER local include of those users, once each
            Move (ResizeArray(asCands, 0))   to asCands
            Move (ResizeArray(asCandsLc, 0)) to asCandsLc
            For j from 0 to (SizeOfArray(asUsers) - 1)
                Get _LiftFileKey asUsers[j] to sUserKey
                Get _LiftFactsOf sUserKey 3 (&asScanned) (&asRows) to asInc
                For k from 0 to (SizeOfArray(asInc) - 1)
                    Move False to bFound
                    For m from 0 to (SizeOfArray(asComp) - 1)
                        If (Lowercase(asComp[m]) = Lowercase(asInc[k])) ;
                            Move True to bFound
                    Loop
                    If (bFound = False and SearchArray(Lowercase(asInc[k]), asCandsLc) = -1) Begin
                        Move asInc[k]             to asCands[SizeOfArray(asCands)]
                        Move (Lowercase(asInc[k])) to asCandsLc[SizeOfArray(asCandsLc)]
                    End
                Loop
            Loop
            If (SizeOfArray(asCands) > 0) Begin
                Get _LiftEnsureFactsMany (&asCands) ("Checking include " + sLeaf + " - reading its partner includes:") (&asScanned) (&asRows) to iVoid
                Move asComp[i] to asOne[0]
                Get _LiftEnsureIdentKeysMany (&asOne)   (&asIdScanned) (&asIdKeys) to iVoid
                Get _LiftEnsureIdentKeysMany (&asCands) (&asIdScanned) (&asIdKeys) to iVoid
                For j from 0 to (SizeOfArray(asCands) - 1)
                    If (bOK = True) Begin
                        Get _LiftIncludesShare asComp[i] asCands[j] (&asScanned) (&asRows) (&asIdKeys) to bShare
                        If (bShare = True) Begin
                            Move asCands[j] to asComp[SizeOfArray(asComp)]
                            // judged as it joins - one failing member ends the walk
                            Get _LiftIncludeLocal asCands[j] (&sLocalWhy) (&asLeafs) (&asUsersIdx) (&asScanned) (&asRows) (&asIdScanned) (&asIdKeys) to bOK
                            If (bOK = False) Begin
                                Move (SizeOfArray(asComp) - 1) to iFail
                                Move (ExtractFileName(asCands[j])) to sFailLeaf
                                Move sLocalWhy to sFailWhy
                            End
                        End
                    End
                Loop
            End
            Increment i
        Loop
        // Every member remembers the verdict: the same question asked of a partner gets the same answer.
        Get pasLiftVerdicts to asMemo
        For i from 0 to (SizeOfArray(asComp) - 1)
            Get _LiftFileKey asComp[i] to sKeyJ
            If (bOK = True) Begin
                Move (sKeyJ + "|1") to asMemo[SizeOfArray(asMemo)]
            End
            Else If (i = iFail) Begin
                Move (sKeyJ + "|0|" + sFailWhy) to asMemo[SizeOfArray(asMemo)]
            End
            Else Begin
                Move (sKeyJ + "|0|VIA|" + sFailLeaf) to asMemo[SizeOfArray(asMemo)]
            End
        Loop
        Set pasLiftVerdicts to asMemo
        Send _LiftStoreTables (&asScanned) (&asRows) (&asIdScanned) (&asIdKeys) iFactsBefore iIdBefore
        If (bOK = False) ;
            Move ("VIA|" + sFailLeaf) to sWhy
        Function_Return bOK
    End_Function

    // Records a read the run converts WITH the program: the include for the engine's list, the name +
    // include leaf for the analyzer's hint. Each once.
    Procedure _NoteLiftedRead String sIncPath String sNameU
        String[] asInc asNames asLeafs
        String sLeaf
        Boolean bNew
        Integer i
        Get pasRunIncludes to asInc
        Move True to bNew
        For i from 0 to (SizeOfArray(asInc) - 1)
            If (Lowercase(asInc[i]) = Lowercase(sIncPath)) ;
                Move False to bNew
        Loop
        If (bNew = True) Begin
            Move sIncPath to asInc[SizeOfArray(asInc)]
            Set pasRunIncludes to asInc
        End
        Move (ExtractFileName(sIncPath)) to sLeaf
        Get pasLiftedNames    to asNames
        Get pasLiftedNameIncs to asLeafs
        Move True to bNew
        For i from 0 to (SizeOfArray(asNames) - 1)
            If (asNames[i] = sNameU and Lowercase(asLeafs[i]) = Lowercase(sLeaf)) ;
                Move False to bNew
        Loop
        If (bNew = True) Begin
            Move sNameU to asNames[SizeOfArray(asNames)]
            Move sLeaf  to asLeafs[SizeOfArray(asLeafs)]
            Set pasLiftedNames    to asNames
            Set pasLiftedNameIncs to asLeafs
        End
    End_Procedure

    // The run's file set for the include lift (the block above): asFiles = the files this run processes
    // (lowercased + sorted here), asFolders = the folders the users scan reads besides an include's own.
    // Clears every lift memo and the lifted lists: a new run, a new verdict.
    Procedure _SetRunFiles String[] asFiles String[] asFolders
        String[] asRun asDirs
        Integer i
        For i from 0 to (SizeOfArray(asFiles) - 1)
            If (Trim(asFiles[i]) <> "") ;
                Move (Lowercase(Trim(asFiles[i]))) to asRun[SizeOfArray(asRun)]
        Loop
        Move (SortArray(asRun)) to asRun
        For i from 0 to (SizeOfArray(asFolders) - 1)
            If (Trim(asFolders[i]) <> "") ;
                Move (vFolderFormat(Trim(asFolders[i]))) to asDirs[SizeOfArray(asDirs)]
        Loop
        Set pasRunFiles   to asRun
        Set pasRunFolders to asDirs
        Send _ClearLiftMemos
    End_Procedure

    // The analyzer's form: every file counts as in the run ("*") - the plan's file list is not final
    // while it builds, and the engine re-judges exactly at run time.
    Procedure _SetRunFilesAll
        String[] asRun asEmpty
        Move "*" to asRun[0]
        Set pasRunFiles   to asRun
        Set pasRunFolders to asEmpty
        Send _ClearLiftMemos
    End_Procedure

    // Compute the PINNED indicator names for one file (UPPERCASE) - names the converters must leave
    // ENTIRELY legacy because a reference to them cannot be safely converted (Nils 2026-07-09, a
    // real customer workspace - identifiers generalized):
    //   (1) GROUP/ALL participants of a group line the converter will NOT write (since 2026-09-13 it
    //       writes 'indicate <X> group any|all [a b c]' as a Move - see _GroupIndicateToMove; the ones it
    //       refuses, a bracket or legacy condition in front, a continued line, keep X + a/b/c indicators
    //       everywhere, or the group line's operands become undefined and its reads decouple from its write).
    //   (2) names read by a 'use'd LOCAL include that is NOT itself converted - 'use SHARED.MAC' pulls
    //       'if (SHARED_IND)' into this compile unit; renaming SHARED_IND here (but not in the .MAC)
    //       leaves the include reading an undefined symbol. Since 2026-09-14 an include that CONVERTS
    //       WITH THE RUN (_LiftIncludeVerdict, the block above) does not pin: its read moves too.
    // Reads the pre-conversion source. sFilePath is the file's full path (to resolve the includes relative
    // to its folder); "" disables the include scan (GROUP scan still runs). Called once per file by the
    // engine before the line pass; pure apart from reading the (small) include files.
    Function _ComputePinnedIndicators String[] ByRef asSource String sFilePath Returns String[]
        String[] asPinned asCand asIncLines asIdents asLocalUses asUseKeys asIncScanned asIncKeys asIncIdents asReasons asToks
        String sLine sLC sTrim sTarget sFolder sUseFile sCandU sCh sGb sCacheKey sUseKey sHitInc sLiftWhy
        Integer iCount iSize iPos iBr iBrEnd i iCand iTok
        Boolean bRef bKeysDirty bPureIdent bInMacro bGroupOK bLift bBarMoved
        tLineInfo[] aInfo

        Move (SizeOfArray(asSource) - 1) to iSize
        If (iSize < 0) Begin
            Set pasPinnedReasons to asReasons
            Function_Return asPinned
        End

        // Cache: a same-file recompute (path + line count) returns the stored set instantly. 1-slot
        // (a multi-slot jagged cache regressed - String[][] Get/Set deep-copies the whole cache; see
        // cBaseFuncLib). Only for a real path ("" = the unit-test GROUP-only form, not worth keying).
        Move "" to sCacheKey
        If (sFilePath <> "") Begin
            Move (sFilePath + "|" + String(iSize + 1)) to sCacheKey
            Get psPinnedCacheKey to sLC
            If (sCacheKey = sLC) Begin
                Get pasPinnedCacheSet to asPinned
                // The reasons ride the cache with the names - restoring names while leaving the
                // PREVIOUS file's reasons in place would label every hint on this file wrongly.
                Get pasPinnedCacheReasons to asReasons
                Set pasPinnedReasons to asReasons
                Function_Return asPinned
            End
        End

        /* ---- (1) GROUP/ALL participants. ----
           The two walks below run for EVERY file of EVERY run, before any refactor function is
           called, and neither reported progress - so a big file froze the panel outright (no
           setter call means no ProcessEvents, so Windows stops painting it and the Cancel button
           stops answering). Nils hit this on a 20,000-line file, 2026-07-28, and read it as the
           refactor function hanging; the function was innocent. Mod pre-filter first, per the
           _NudgeLineProgress contract - the common line never reaches the message. */
        Move False to bInMacro
        // Which lines are code, and which are a #COMMAND body, is the file walk's answer (ScanSourceFile,
        // 2026-10-29): a multi-line string's text is not code - a #COMMAND line there opens no macro body, and a
        // name in it is no use.
        Get ScanSourceFile (&asSource) to aInfo
        For iCount from 0 to iSize
            // "" = the lift's per-file facts scan (nested, hundreds of files): its lines are not this
            // file's progress, so only the real per-file call nudges.
            If (Mod(iCount, 20) = 0 and sFilePath <> "") ;
                Send _NudgeLineProgress iCount (iSize + 1) "Scanning line:"
            Move (Trim(asSource[iCount])) to sTrim
            If (aInfo[iCount].eKind = LK_StringText or aInfo[iCount].eKind = LK_StringCloser) ;
                Move "" to sTrim
            If (sTrim <> "" and Left(sTrim, 2) <> "//") Begin
                Move (Pos("//", sTrim)) to iPos
                If (iPos > 0) ;
                    Move (Trim(Left(sTrim, iPos - 1))) to sTrim
                Move (Lowercase(sTrim)) to sLC
                /* ---- (3) names referenced INSIDE a #COMMAND body, and (4) declared names that are not
                   plain identifiers (2026-09-07). The line converters skip macro bodies, so a declaration
                   converted to a Global_Variable Boolean while '[ X]' / '[~X]' stayed inside the macro left
                   'Indicator unresolved' at every expansion - 188 errors from one macro. And a name carrying
                   '$' or '?' split two ways between the declaration converter and the use renamer, under an
                   '#IFNDEF' the preprocessor rejects. Both kinds stay Indicators everywhere in the file:
                   every token between brackets and every Indicate target inside a macro body is pinned as
                   written, and so is an odd-named declaration (see _PinRawIndicatorName).
                   ---- (5) names inside brackets on a RAW COMPILER DIRECTIVE line ('!A [not X] $1C4 iImg',
                   later the same day): a directive takes an indicator and nothing else, so converting X's
                   'indicate X as [...]' to a Move into a gb Boolean and renaming X inside the directive left
                   'Indicator unresolved' on every such line. Same walk, reason DIRECTIVE. */
                // A #COMMAND body, as the file walk reads it - its own two directive lines pin nothing
                Move (aInfo[iCount].eMacro = MC_CommandBlock and Left(sLC, 8) <> "#command" and Left(sLC, 11) <> "#endcommand") to bInMacro
                If (bInMacro = True) Begin
                    Move sTrim to sLine
                    Send _PinBracketTokens sTrim "MACRO" (iCount + 1) (&asPinned) (&asReasons)
                    If (Pos("indicate", sLC) > 0) Begin
                        Move (_FindKeywordPos(Self, sLC, "indicate", True, 1)) to iBr
                        If (iBr > 0) Begin
                            Get _NthWord (Mid(sTrim, Length(sTrim), (iBr + 9))) 1 to sTarget
                            Get ReplaceBrackets sTarget to sTarget
                            Send _PinRawIndicatorName sTarget "MACRO" (iCount + 1) (&asPinned) (&asReasons)
                        End
                    End
                End
                Else If (Left(sLC, 1) = "!") Begin
                    Send _PinBracketTokens sTrim "DIRECTIVE" (iCount + 1) (&asPinned) (&asReasons)
                End
                Else If (Left(sLC, 10) = "indicator ") Begin
                    Move (StrSplitToArray(sTrim, " ")) to asToks
                    For iTok from 1 to (SizeOfArray(asToks) - 1)
                        If (Trim(asToks[iTok]) <> "" and _IsPlainIdentifierName(Self, Trim(asToks[iTok])) = False) ;
                            Send _PinRawIndicatorName asToks[iTok] "ODDNAME" (iCount + 1) (&asPinned) (&asReasons)
                    Loop
                End
                // A GROUP form: 'indicate <X> group ...'. GROUP (form 4 'group any|all') is the marker.
                // PERF pre-gate (Nils 2026-07-17, ~940ms/file on WinServ): the two interpreted whole-word
                // probes ran on EVERY code line - and a DataFlex 'and' does NOT short-circuit, so both
                // always paid. Native Pos on the already-lowercased line first: lines without both words
                // (virtually all of them) never reach the interpreted scans. _FindKeywordPos stays the
                // whole-word authority on the plausible lines.
                If (Pos("indicate", sLC) > 0 and Pos("group", sLC) > 0) Begin
                If ((_FindKeywordPos(Self, sLC, "indicate", True, 1) > 0) and (_FindKeywordPos(Self, sLC, "group", True, 1) > 0)) Begin
                    /* A GROUP LINE THE CONVERTER WRITES PINS NOTHING (2026-09-13). 'Indicate X GROUP ANY|ALL
                       [...]' has an exact Move form and ChangeLegacyIndicators writes it now, in the same
                       pass that converts the participants' own lines, so the write and its reads stay
                       coupled. Only a group line the converter refuses - a bracket or a legacy condition
                       in front of it, a continued line - still freezes its names, below. One line had
                       frozen 23 rows of a report view. */
                    Get _GroupIndicateToMove sTrim "" "" (&sGb) to bGroupOK
                    If (bGroupOK = False) Begin
                    // target = the word right after 'indicate'. Pin ONLY names the converters would
                    // actually RENAME (_IndicatorVarName changes them) - a BUILT-IN (Found/FindErr/Err/
                    // SeqEof), SELECT and True/False are never renamed, so `[Found]` -> `(Found)` stays valid
                    // even when Found is a GROUP member elsewhere; pinning them would wrongly freeze every
                    // `[Found]` line (Nils 2026-07-09: 'if [FOUND] begin' left unconverted).
                    Move (Pos("indicate ", sLC)) to iBr
                    If (iBr > 0) Begin
                        Get _NthWord (Mid(sTrim, Length(sTrim), (iBr + 9))) 1 to sTarget
                        Get ReplaceBrackets sTarget to sTarget
                        Get _IndicatorVarName sTarget to sGb
                        /* asReasons is index-parallel to asPinned: append to BOTH, always together.
                           The reason carries the GROUP line's 1-based NUMBER so the hint can cite it
                           (Nils 2026-07-30). He reported the GROUP verdict as flatly false on
                           'Indicate franvaro_stamp False' - the group line was 199 lines further down
                           the same report file, indented 40 columns in. Naming the reason without
                           saying where to check it just moves the guesswork. */
                        If (sTarget <> "" and sGb <> sTarget and _NameInList(Self, Uppercase(sTarget), asPinned) = False) Begin
                            Move ("GROUP|" + String(iCount + 1)) to asReasons[SizeOfArray(asPinned)]
                            Move (Uppercase(sTarget)) to asPinned[SizeOfArray(asPinned)]
                        End
                    End
                    // members = every identifier inside each [...] group
                    Move sTrim to sLine
                    Move (Pos("[", sLine)) to iBr
                    While (iBr > 0)
                        Move (Pos("]", sLine)) to iBrEnd
                        If (iBrEnd > iBr) Begin
                            Get _ExtractIdentifiers (Mid(sLine, (iBrEnd - iBr - 1), (iBr + 1))) to asIdents
                            For i from 0 to (SizeOfArray(asIdents) - 1)
                                Get _IndicatorVarName asIdents[i] to sGb
                                If (sGb <> asIdents[i] and _NameInList(Self, Uppercase(asIdents[i]), asPinned) = False) Begin
                                    Move ("GROUP|" + String(iCount + 1)) to asReasons[SizeOfArray(asPinned)]
                                    Move (Uppercase(asIdents[i])) to asPinned[SizeOfArray(asPinned)]
                                End
                            Loop
                            Move ("X" + Mid(sLine, Length(sLine), (iBrEnd + 1))) to sLine
                        End
                        Else ;
                            Move "" to sLine
                        Move (Pos("[", sLine)) to iBr
                    Loop
                    End   // bGroupOK = False: the converter will not write this group line
                End
                End   // pre-gate (native Pos) close
            End
        Loop

        // ---- (2) indicators read by a 'use'd LOCAL include. ----
        // (sFilePath = "" is the unit-test GROUP-only form: no include scan, no caching.)
        If (sFilePath = "") Begin
            Set pasPinnedReasons to asReasons
            Function_Return asPinned
        End
        // Folder = up to and including the last path separator (inline, so no dependency on a global
        // path helper - this file compiles into every program).
        Move "" to sFolder
        Move (Length(sFilePath)) to i
        While (i > 0)
            Move (Mid(sFilePath, 1, i)) to sCh
            If (sCh = "\" or sCh = "/") Begin
                Move (Left(sFilePath, i)) to sFolder
                Move 0 to i
            End
            Else ;
                Move (i - 1) to i
        Loop
        If (sFolder = "") ;
            Goto pinned_ret

        // PERF pre-gate (Nils 2026-07-09): collect the 'use <file>' targets that EXIST in this file's
        // folder FIRST (a cheap Trim/Pos scan). If there is NO local include, the include scan cannot
        // pin anything, so RETURN before the expensive _CollectIndicatorNames full-file tokenize -
        // most files have no local .mac/.inc include and were needlessly tokenizing the whole file every
        // analyze + plan build (the 8s->23s regression). A library 'use cX.pkg' resolves to the DataFlex
        // Pkg folder, not here, so it does not exist locally and is skipped.
        Move (ResizeArray(asLocalUses, 0)) to asLocalUses
        For iCount from 0 to iSize
            // Second full walk of the same file - and this one also stats the disk per 'use' line,
            // so it is the slower of the two. Same gate as walk (1) above.
            If (Mod(iCount, 20) = 0) ;
                Send _NudgeLineProgress iCount (iSize + 1) "Scanning includes, line:"
            Move (Trim(asSource[iCount])) to sTrim
            If (Lowercase(Left(sTrim, 4)) = "use " and Left(sTrim, 2) <> "//") Begin
                Get _NthWord sTrim 2 to sUseFile
                Move (vFolderFormat(sFolder) + sUseFile) to sUseFile
                If (vFilePathExists(sUseFile)) ;
                    Move sUseFile to asLocalUses[SizeOfArray(asLocalUses)]
            End
        Loop
        If (SizeOfArray(asLocalUses) = 0) ;
            Goto pinned_ret

        // Candidate names = the RENAMEABLE indicator names this file uses/declares (a BUILT-IN, SELECT, the
        // True/False literals are never renamed, so an include reading them is FINE - and since those names
        // are ubiquitous, NOT filtering them would pin Found and freeze every '[Found]' line; Nils
        // 2026-07-09). Collected by the CHEAP raw scan (no tokenizer) - a 9700-line file's tokenizing collect
        // cost ~7.7s, redone per analyze/plan/run; the raw scan is ~100x faster and over-inclusion here only
        // over-pins (safe).
        Get _RawIndicatorCandidates (&asSource) to asCand
        If (SizeOfArray(asCand) = 0) ;
            Goto pinned_ret

        /* INVERTED (2026-07-23), from "per candidate, re-scan the whole include" to "per include, one
           scan into an identifier set; per candidate, one binary search". The old nested loop ran
           _CodeOnlyLine + _FindKeywordPos over EVERY include line once per candidate - includes x
           candidates x lines - and re-did all of it for every main file using the same include:
           24,396 ms of a 55-second LegacyApp Analyze, measured per-phase (3w probe, 2026-07-23).
           The identifier sets live in the per-run cross-file cache (pasPinIncKeys, cBaseFuncLib), so
           each distinct include is read and scanned ONCE per run however many programs use it.
           Semantics are pinned by the IncludeScan* tests in oPinnedIndicators-Tests.pkg - the
           equivalence argument lives on _IdentifierRunsFromLines. */
        Get pasPinIncScanned to asIncScanned
        Get pasPinIncKeys    to asIncKeys
        Move False to bKeysDirty
        For iCount from 0 to (SizeOfArray(asLocalUses) - 1)
            Move (Lowercase(asLocalUses[iCount]) + "|" + String(rfFileSizeLive(asLocalUses[iCount]))) to sUseKey
            Move sUseKey to asUseKeys[iCount]
            If (SearchArray(sUseKey, asIncScanned) = -1) Begin
                Move (rfReadEncodedFileAsStringArray(asLocalUses[iCount])) to asIncLines
                Get _IdentifierRunsFromLines (&asIncLines) to asIncIdents
                For i from 0 to (SizeOfArray(asIncIdents) - 1)
                    Move (sUseKey + "|" + asIncIdents[i]) to asIncKeys[SizeOfArray(asIncKeys)]
                Loop
                Move sUseKey to asIncScanned[SizeOfArray(asIncScanned)]
                Move True to bKeysDirty
            End
        Loop
        If (bKeysDirty = True) Begin
            // One sort per NEWLY-scanned include set; lookups between additions stay valid.
            Move (SortArray(asIncKeys)) to asIncKeys
            Set pasPinIncScanned to asIncScanned
            Set pasPinIncKeys    to asIncKeys
        End
        For iCand from 0 to (SizeOfArray(asCand) - 1)
            Move (Uppercase(asCand[iCand])) to sCandU
            If (_NameInList(Self, sCandU, asPinned) = False) Begin
                // The run-equivalence only holds for a name made purely of identifier characters -
                // anything else (legacy names can carry odd characters) takes the old exact scan.
                Move True to bPureIdent
                For i from 1 to (Length(sCandU))
                    If (_IsIdentifierChar(Self, Mid(sCandU, 1, i)) = False) ;
                        Move False to bPureIdent
                Loop
                Move False to bRef
                Move "" to sHitInc
                For iCount from 0 to (SizeOfArray(asLocalUses) - 1)
                    If (bRef = False) Begin
                        If (bPureIdent = True) ;
                            Move (BinarySearchArray((asUseKeys[iCount] + "|" + sCandU), asIncKeys) <> -1) to bRef
                        Else Begin
                            Move (rfReadEncodedFileAsStringArray(asLocalUses[iCount])) to asIncLines
                            Get _LinesReferenceName (&asIncLines) asCand[iCand] to bRef
                        End
                        // WHICH include pinned it - the loop only enters while bRef is still False, so
                        // this records the FIRST reader and later includes cannot overwrite it. The
                        // hint names one file rather than all of them: it is the answer to "why is
                        // this row not auto-fixable", not an exhaustive cross-reference.
                        If (bRef = True) Begin
                            Move (ExtractFileName(asLocalUses[iCount])) to sHitInc
                            /* AN INCLUDE THAT CONVERTS WITH THE RUN DOES NOT PIN (2026-09-14; the contract
                               is the block above _LiftIncludeVerdict). Its read of the name changes in the
                               same run as this file's write, so the two stay coupled. Recorded for the
                               engine (pasRunIncludes) and the hint (pasLiftedNames); the walk moves on to
                               the next include, which may still pin. Otherwise the reason carries WHY this
                               include cannot lift, so the hint can say what would let it. */
                            Get _LiftIncludeVerdict asLocalUses[iCount] (&sLiftWhy) to bLift
                            If (bLift = True) Begin
                                Send _NoteLiftedRead asLocalUses[iCount] sCandU
                                Move False to bRef
                            End
                            Else If (sLiftWhy <> "") ;
                                Move (sHitInc + "|" + sLiftWhy) to sHitInc
                        End
                    End
                Loop
                If (bRef = True) Begin
                    Move ("USE|" + sHitInc) to asReasons[SizeOfArray(asPinned)]
                    Move sCandU to asPinned[SizeOfArray(asPinned)]
                End
            End
        Loop

        // Store the computed set for this file (path + line count) so a same-file repeat reuses it
        // instantly instead of recomputing. Every sFilePath<>"" exit funnels here ("" = uncached test form).
        pinned_ret:
        // A lift walk retargets the per-file bar to its own count (_LiftNudge); hand it back to this file.
        Get pbLiftBarRetargeted to bBarMoved
        If (bBarMoved = True) Begin
            Set pbLiftBarRetargeted to False
            Send _StartFileLineProgress (iSize + 1)
        End
        Set psPinnedCacheKey  to sCacheKey
        Set pasPinnedCacheSet to asPinned
        Set pasPinnedCacheReasons to asReasons
        Set pasPinnedReasons  to asReasons
        Function_Return asPinned
    End_Function

    // The CODE part of one raw source line: string literals are masked to spaces (position-preserving;
    // DataFlex has no doubled-quote escape, so a plain open/close toggle per quote kind is exact) and
    // the line is cut at the first '//' OUTSIDE a literal. A full-comment line comes back "".
    // Written for the pin include-scan (below), where ENGLISH PROSE in an include's comments
    // false-pinned a common-word indicator: LOGIN2's 'Indicator User' stayed legacy because a used
    // API-wrapper include said "...retrieves the current default user name..." in its header comment
    // (Nils 2026-07-10, the half-converted declaration block). Limitation: DF23+ /* */ block comments
    // are not tracked line-to-line (a fresh state per line) - legacy includes predate them, and a miss
    // only OVER-pins, never mis-converts. The line scanner's reading (ScanSourceLine, 2026-10-29).
    Function _CodeOnlyLine String sLine Returns String
        tLineScan Scan

        Get ScanSourceLine sLine "" True to Scan
        Function_Return Scan.sCode
    End_Function

    // The code of a line that opens a DF 23 multi-line string: what stands before the string's opening quote,
    // masked like _CodeOnlyLine, and blanks from that quote on - every position still matches the raw line. A
    // """ string opens at the line's final """, an @-string at the quote still open at its end (ScanSourceLine).
    Function _MultiLineStringOpenerCode String sLine Returns String
        tLineScan Scan

        Get ScanSourceLine sLine "" True to Scan
        If (Scan.sOpenOut = "") ;
            Function_Return Scan.sCode
        Function_Return (Left(Scan.sCode, (Scan.iOpenAt - 1)) + Repeat(" ", (Length(sLine) - Scan.iOpenAt + 1)))
    End_Function

    // The code of a line as the file walk read it (Info, its tLineInfo from ScanSourceFile): _CodeOnlyLine's
    // reading from the state the walk had at the line's start, so a block comment's text, a multi-line string's
    // text and a #HEADER or report-image line hold none - every position still that of the line. A string still
    // open at the line's end is text from its opening quote on, as _MultiLineStringOpenerCode reads it, so a
    // tokenizer fed this code never opens one.
    Function _WalkedCodeLine String sLine tLineInfo Info Returns String
        tLineScan Scan
        String sOpenIn

        If (Info.eKind = LK_Header or Info.eKind = LK_Image) ;
            Function_Return ""
        Move Info.sOpenIn to sOpenIn
        If (Info.bBlockOpenIn = True) ;
            Move "/*" to sOpenIn
        Get ScanSourceLine sLine sOpenIn True to Scan
        If (Scan.sOpenOut = "" or Scan.iOpenAt = 0) ;
            Function_Return Scan.sCode
        Function_Return (Left(Scan.sCode, (Scan.iOpenAt - 1)) + Repeat(" ", (Length(sLine) - Scan.iOpenAt + 1)))
    End_Function

    // True when sName appears as a WHOLE WORD (boundary-aware, so not a substring of a longer identifier)
    // in the CODE of any of asLines - comments and string literals are stripped first (_CodeOnlyLine), so
    // prose like "the user name" in an include's header comment can no longer pin an indicator named
    // User (Nils 2026-07-10). The include-content half of _ComputePinnedIndicators' 'use'd-include
    // scan, split out so it is unit-testable without disk I/O. (Nils 2026-07-09.)
    Function _LinesReferenceName String[] ByRef asLines String sName Returns Boolean
        String sCode
        Integer i iLast
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            If (sCode <> "" and _FindKeywordPos(Self, sCode, sName, True, 1) > 0) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* Every identifier in the CODE of these lines: the maximal [a-z0-9_] runs of each line after
       _CodeOnlyLine has cut its comment and masked its string literals. UPPERCASED; duplicates kept
       (the caller sorts, and BinarySearchArray is indifferent to duplicates).

       This is _LinesReferenceName turned inside out, and the equivalence is exact BY CONSTRUCTION for
       a name made of identifier characters: _FindKeywordPos declares a whole-word match where the
       characters before and after the match are non-identifier characters (_IsIdentifierChar,
       [a-z0-9_]) - which is precisely the definition of a maximal run. So "name matches somewhere in
       the lines" = "name equals one of these runs", and one scan of the include serves EVERY candidate
       instead of one scan per candidate. A candidate carrying any OTHER character (legacy names can)
       falls back to the old scan at the call site - under-pinning is the failure mode that mis-converts
       customer code, so the equivalence is never stretched past where it holds. PURE -> unit-testable. */
    Function _IdentifierRunsFromLines String[] ByRef asLines Returns String[]
        String[] asOut
        String sCode sCh sRun
        Integer i iLast iCh iLen

        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            If (sCode <> "") Begin
                Move (Length(sCode)) to iLen
                Move "" to sRun
                For iCh from 1 to iLen
                    Move (Mid(sCode, 1, iCh)) to sCh
                    If (_IsIdentifierChar(Self, sCh) = True) ;
                        Move (sRun + sCh) to sRun
                    Else Begin
                        If (sRun <> "") ;
                            Move (Uppercase(sRun)) to asOut[SizeOfArray(asOut)]
                        Move "" to sRun
                    End
                Loop
                If (sRun <> "") ;
                    Move (Uppercase(sRun)) to asOut[SizeOfArray(asOut)]
            End
        Loop
        Function_Return asOut
    End_Function

    /* THE RAW PRE-GATE SCAN behind _RawMayHaveCustomIndicator and _RawMayHaveSelectIndicator - the same walk
       with one predicate: with sOnlyNameLC, exactly that name ('Indicate Select', '[Select]'); without it, any
       name that is not a built-in indicator (and, after Indicate, not a number). Scans the raw lines, so it
       also matches inside strings/comments - that only OVER-reports (the masked tokenizer pass then confirms),
       never misses. Same _IsTightPrefix / _IsIndexBracket / _ExtractIdentifiers primitives as the real scan. */
    Function _RawMayHaveIndicatorNamed String[] ByRef asSource String sOnlyNameLC Returns Boolean
        String[] asIdents
        String sLine sLC sName sContent sWork
        Integer iCount iSize iBr iBrEnd i
        Boolean bHit

        Move (SizeOfArray(asSource) - 1) to iSize
        For iCount from 0 to iSize
            Move (Trim(asSource[iCount])) to sLine
            Move (Lowercase(sLine)) to sLC
            // 'Indicate X' -> X is the first word after the keyword.
            Move (Pos("indicate ", sLC)) to iBr
            If (iBr > 0 and (_IsTightPrefix(Self, sLine, iBr) = False)) Begin
                Get _NthWord (Mid(sLine, Length(sLine), (iBr + 9))) 1 to sName
                If (sOnlyNameLC <> "") ;
                    Move (Lowercase(Trim(sName)) = sOnlyNameLC) to bHit
                Else ;
                    Move (sName <> "" and (Ascii(sName) < 48 or Ascii(sName) > 57) and (_IsBuiltInIndicatorName(Self, sName) = False)) to bHit
                If (bHit = True) ;
                    Function_Return True
            End
            // '[X]' bracket uses (skip tight / spaced index) - any qualifying identifier inside.
            Move sLine to sWork
            Move (Pos("[", sWork)) to iBr
            While (iBr > 0)
                Move (Pos("]", sWork)) to iBrEnd
                If (iBrEnd > iBr) Begin
                    If ((_IsTightPrefix(Self, sWork, iBr) = False) and (_IsIndexBracket(Self, sWork, iBr) = False)) Begin
                        Move (Mid(sWork, (iBrEnd - iBr - 1), (iBr + 1))) to sContent
                        Get _ExtractIdentifiers sContent to asIdents
                        For i from 0 to (SizeOfArray(asIdents) - 1)
                            If (sOnlyNameLC <> "") ;
                                Move (Lowercase(Trim(asIdents[i])) = sOnlyNameLC) to bHit
                            Else ;
                                Move (_IsBuiltInIndicatorName(Self, asIdents[i]) = False) to bHit
                            If (bHit = True) ;
                                Function_Return True
                        Loop
                    End
                    Move ("X" + Mid(sWork, Length(sWork), (iBrEnd + 1))) to sWork
                End
                Else Begin
                    Move "" to sWork
                End
                Move (Pos("[", sWork)) to iBr
            Loop
        Loop
        Function_Return False
    End_Function

    // Cheap CONSERVATIVE pre-gate for the companion scan (_ScopeNeedsIndicatorCompanion): True if asSource RAW-mentions an
    // Indicate / [..] target that is NOT a built-in indicator - WITHOUT the per-line tokenizer (the expensive
    // part). It scans the raw lines, so it also matches inside strings/comments; that only makes it OVER-report,
    // so a True merely triggers the accurate (masked) tokenizer pass and a False guarantees there is nothing
    // to find (raw content is a superset of the masked content - it can never MISS a real indicator). Reuses
    // the same _IsTightPrefix / _IsIndexBracket / _ExtractIdentifiers / _IsBuiltInIndicatorName primitives as
    // the real scan. Lets a Found/Err-only file (the overwhelmingly common case) skip the tokenizer entirely.
    // The walk itself is _RawMayHaveIndicatorNamed, shared with the SELECT twin below.
    Function _RawMayHaveCustomIndicator String[] ByRef asSource Returns Boolean
        Boolean bHit
        Get _RawMayHaveIndicatorNamed (&asSource) "" to bHit
        Function_Return bHit
    End_Function

    // Cheap RAW collector of the RENAMEABLE indicator NAMES a file uses/declares - '[X]', 'Indicate X',
    // 'Indicator X [Y]' - via string ops only (NO per-line tokenizer). The tokenizing _CollectIndicatorNames
    // took ~7.7s on a 9700-line file, which the pin include-scan called once per analyze/plan/run (Nils
    // 2026-07-09). Over-includes a name that only appears in a string/comment (the raw scan can't mask), but
    // that is SAFE for the pin candidate purpose: a false candidate can only OVER-pin (leave an
    // indicator legacy - the code still compiles), never mis-convert. Built-ins/SELECT/literals are filtered
    // out here (never renamed, so never decouple).
    Function _RawIndicatorCandidates String[] ByRef asSource Returns String[]
        String[] asOut asIdents
        String sLine sLC sName sContent sWork sGb
        Integer iCount iSize iBr iBrEnd i iCmt

        Move (SizeOfArray(asSource) - 1) to iSize
        For iCount from 0 to iSize
            Move (Trim(asSource[iCount])) to sLine
            // Drop an inline '//' end comment (cheap - no tokenizer): the raw scan would otherwise treat
            // 'indicate'/'[X]' text INSIDE a comment as a candidate and over-pin. Over-stripping a '//'
            // that sits inside a string is harmless (a string holds no real indicator to collect).
            Move (Pos("//", sLine)) to iCmt
            If (iCmt > 0) ;
                Move (Trim(Left(sLine, iCmt - 1))) to sLine
            If (sLine <> "") Begin
                Move (Lowercase(sLine)) to sLC
                // 'Indicate X' target
                Move (Pos("indicate ", sLC)) to iBr
                If (iBr > 0 and (_IsTightPrefix(Self, sLine, iBr) = False)) Begin
                    Get _NthWord (Mid(sLine, Length(sLine), (iBr + 9))) 1 to sName
                    Get ReplaceBrackets sName to sName
                    Get _IndicatorVarName sName to sGb
                    If (sName <> "" and sGb <> sName and _NameInList(Self, sName, asOut) = False) ;
                        Move sName to asOut[SizeOfArray(asOut)]
                End
                // 'Indicator A [B C]' declaration names
                If (Pos("indicator ", sLC) = 1) Begin
                    Get _ExtractIdentifiers (Mid(sLine, Length(sLine), 11)) to asIdents
                    For i from 0 to (SizeOfArray(asIdents) - 1)
                        Get _IndicatorVarName asIdents[i] to sGb
                        If (sGb <> asIdents[i] and _NameInList(Self, asIdents[i], asOut) = False) ;
                            Move asIdents[i] to asOut[SizeOfArray(asOut)]
                    Loop
                End
                // '[X]' bracket uses (skip tight / spaced index)
                Move sLine to sWork
                Move (Pos("[", sWork)) to iBr
                While (iBr > 0)
                    Move (Pos("]", sWork)) to iBrEnd
                    If (iBrEnd > iBr) Begin
                        If ((_IsTightPrefix(Self, sWork, iBr) = False) and (_IsIndexBracket(Self, sWork, iBr) = False)) Begin
                            Move (Mid(sWork, (iBrEnd - iBr - 1), (iBr + 1))) to sContent
                            Get _ExtractIdentifiers sContent to asIdents
                            For i from 0 to (SizeOfArray(asIdents) - 1)
                                Get _IndicatorVarName asIdents[i] to sGb
                                If (sGb <> asIdents[i] and _NameInList(Self, asIdents[i], asOut) = False) ;
                                    Move asIdents[i] to asOut[SizeOfArray(asOut)]
                            Loop
                        End
                        Move ("X" + Mid(sWork, Length(sWork), (iBrEnd + 1))) to sWork
                    End
                    Else ;
                        Move "" to sWork
                    Move (Pos("[", sWork)) to iBr
                Loop
            End
        Loop
        Function_Return asOut
    End_Function

    // Every name on an 'Indicator ...' DECLARATION line, UPPERCASE - deliberately GENEROUS (all
    // identifiers on the line, not just word 2): treating a name as declared can only UNDER-offer the
    // companion, which matches its "never offer a no-op" design. Raw scan, no tokenizer. PURE.
    Function _RawDeclaredIndicatorNames String[] ByRef asSource Returns String[]
        String[] asOut asIdents
        String sTrim
        Integer i iLast j

        Move (SizeOfArray(asSource) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asSource[i])) to sTrim
            If (Lowercase(Left(sTrim, 10)) = "indicator " and Left(sTrim, 2) <> "//") Begin
                Get _ExtractIdentifiers (Mid(sTrim, Length(sTrim), 11)) to asIdents
                For j from 0 to (SizeOfArray(asIdents) - 1)
                    Move (Uppercase(asIdents[j])) to asOut[SizeOfArray(asOut)]
                Loop
            End
        Loop
        Function_Return asOut
    End_Function

    // Cheap RAW scan: True when asSource carries an 'Indicator <renameable-name>' DECLARATION at a
    // line start. Used by the companion gate below: a file whose indicators are all DECLARED still
    // needs DeclareRefactoredIndicators for its PASS 2b read-renames (ChangeIndicatorToBoolean
    // renames the declaration to gbX, so bare reads must follow; Nils 2026-07-09, a legacy customer
    // workspace's 'indicator smaller' + 'WHILE (smaller)'). No tokenizer: comments are skipped by
    // the '//' prefix test only,
    // so a string/odd comment can OVER-trigger - that just includes the companion, which then
    // renames nothing (its own masked pass is authoritative). Never misses a real declaration.
    Function _RawHasIndicatorDeclaration String[] ByRef asSource String[] asPinned Returns Boolean
        Integer i iLast
        String sTrim sName sNew

        Move (SizeOfArray(asSource) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asSource[i])) to sTrim
            If (Lowercase(Left(sTrim, 10)) = "indicator " and Left(sTrim, 2) <> "//") Begin
                Get _NthWord sTrim 2 to sName
                Get _IndicatorVarName sName to sNew
                // Renameable AND not pinned: a pinned declaration is left legacy (no PASS 2b rename),
                // so it does not need DeclareRefactoredIndicators (Nils 2026-07-09).
                If (sNew <> sName and SearchArray(Uppercase(Trim(sName)), asPinned) = -1) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    // True when ANY file in asFiles USES a legacy named indicator that the converters will rewrite but that
    // has no 'Indicator X' declaration - OR DECLARES one ('Indicator X'; its bare reads need the PASS 2b
    // rename once ChangeIndicatorToBoolean renames the declaration to gbX; Nils 2026-07-09) - i.e. the
    // DeclareRefactoredIndicators companion is genuinely needed for this run. Reads each file's
    // PRE-conversion source (the converters haven't run yet) and reuses _UndeclaredNamedIndicatorsIn - the
    // SAME scan the refactor itself uses - so Auto-Select and the run agree. A cheap
    // _RawMayHaveCustomIndicator pre-gate skips the tokenizer for built-in-only files, and it
    // short-circuits on the first file that qualifies.
    /* Does any of these files need the DeclareRefactoredIndicators companion? THE COMPILER IS THE
       USE-FINDER (2026-07-23): these files are in the list because 4538-family warnings mapped them to
       an indicator converter, and each warning points at a use line - so asLineKeys ("<pathLc>|<line>",
       every indicator-converter message incl. folded occurrences) enumerates the uses, and the question
       is EXISTENCE, which one warned use per name answers completely. The DECLARATION route is separate
       and cheap: declared (non-pinned, renameable) indicators still need the PASS 2b read-renames.

       PINNED IS DEFERRED (milestone 2): the pinned set only ever REMOVES qualifiers, so the cheap
       filters run first - declared-name subtraction on the warned-line candidates, and a superset
       declaration probe with an EMPTY pinned set. Only when something still qualifies does the file pay
       the pinned compute (GROUP scan + use-collection + include work - the 23.4s residual of a 32s Run
       Plan when it ran unconditionally per file). Skipping it cannot change a verdict: with nothing to
       subtract FROM, the answer is already No.

       Verdicts are remembered per session (pasCompanionVerdicts, "<pathLc>|<size>|0/1", cleared by
       _InitializeFuncLib when an engine run starts; size catches mid-session edits). */
    Function _ScopeNeedsIndicatorCompanion String[] asFiles String[] asLineKeys Returns Boolean
        String[] asSource asNames asPinned asVerdicts asDeclared asOneLine asSurvivors asEmptyPin
        String sKey sPrefix sLineNo sNameU
        Integer i iMax j k iAt iPrefixLen iLineNo iKeys
        Boolean bQualifies bPrePinnedHit

        Get pasCompanionVerdicts to asVerdicts
        Move (SizeOfArray(asLineKeys)) to iKeys
        Move (SizeOfArray(asFiles) - 1) to iMax
        For i from 0 to iMax
            If (phoUIYieldTarget(Self) <> 0) ;
                Send DoYieldToUI of (phoUIYieldTarget(Self))
            Move (Lowercase(asFiles[i]) + "|" + String(rfFileSizeLive(asFiles[i])) + "|") to sKey
            Move (SearchArray((sKey + "1"), asVerdicts)) to iAt
            If (iAt <> -1) ;
                Function_Return True
            Move (SearchArray((sKey + "0"), asVerdicts)) to iAt
            If (iAt = -1) Begin
                Move False to bQualifies
                Move (rfReadEncodedFileAsStringArray(asFiles[i])) to asSource
                // ---- the CHEAP filters, before any pinned work ----
                Get _RawDeclaredIndicatorNames (&asSource) to asDeclared
                // Any renameable declaration at all? Empty pinned = a superset of the real declaration
                // route; False here means that route cannot fire whatever the pinned set says.
                Get _RawHasIndicatorDeclaration (&asSource) asEmptyPin to bPrePinnedHit
                // Surviving USE candidates: names on this file's warned lines minus its declared names.
                Move (ResizeArray(asSurvivors, 0)) to asSurvivors
                If (iKeys > 0) Begin
                    Move (Lowercase(asFiles[i]) + "|") to sPrefix
                    Move (Length(sPrefix)) to iPrefixLen
                    For j from 0 to (iKeys - 1)
                        If (Left(asLineKeys[j], iPrefixLen) = sPrefix) Begin
                            Move (Right(asLineKeys[j], (Length(asLineKeys[j]) - iPrefixLen))) to sLineNo
                            Move sLineNo to iLineNo
                            If (iLineNo >= 1 and iLineNo <= SizeOfArray(asSource)) Begin
                                Move (ResizeArray(asOneLine, 0)) to asOneLine
                                Move asSource[iLineNo - 1] to asOneLine[0]
                                // Raw candidate patterns on ONE line; built-ins are excluded by the
                                // renameability test inside.
                                Get _RawIndicatorCandidates (&asOneLine) to asNames
                                For k from 0 to (SizeOfArray(asNames) - 1)
                                    Move (Uppercase(Trim(asNames[k]))) to sNameU
                                    If (SearchArray(sNameU, asDeclared) = -1) ;
                                        Move sNameU to asSurvivors[SizeOfArray(asSurvivors)]
                                Loop
                            End
                        End
                    Loop
                End
                // ---- only a file where something could still qualify pays for the pinned set ----
                If (bPrePinnedHit = True or SizeOfArray(asSurvivors) > 0) Begin
                    Send ClearFuncLibProperties
                    Get _ComputePinnedIndicators (&asSource) asFiles[i] to asPinned
                    // PINNED names (GROUP/ALL participants + 'use'd-include reads) are left legacy by
                    // DeclareRefactoredIndicators, so they need no shim / rename (Nils 2026-07-09).
                    If (bPrePinnedHit = True) ;
                        Get _RawHasIndicatorDeclaration (&asSource) asPinned to bQualifies
                    If (bQualifies = False) Begin
                        For k from 0 to (SizeOfArray(asSurvivors) - 1)
                            If (SearchArray(asSurvivors[k], asPinned) = -1) ;
                                Move True to bQualifies
                        Loop
                    End
                End
                If (bQualifies = True) ;
                    Move (sKey + "1") to asVerdicts[SizeOfArray(asVerdicts)]
                If (bQualifies = False) ;
                    Move (sKey + "0") to asVerdicts[SizeOfArray(asVerdicts)]
                Set pasCompanionVerdicts to asVerdicts
                If (bQualifies = True) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function




    // Cheap CONSERVATIVE pre-gate for _ScopeHasSelectIndicator: True if asSource RAW-mentions SELECT as an
    // indicator - 'Indicate Select' or a '[Select]' bracket - WITHOUT the per-line tokenizer. The SELECT twin
    // of _RawMayHaveCustomIndicator (same _IsTightPrefix / _IsIndexBracket / _ExtractIdentifiers primitives);
    // it just narrows the predicate from "any non-built-in name" to exactly "select". Scans raw lines, so it
    // also matches inside strings/comments - that only OVER-reports (the masked tokenizer pass then confirms),
    // never misses. This is what lets every file that merely contains the WORD 'select' (a 'Select All' menu,
    // an SQL SELECT, the DataFlex Select command) skip the tokenizer instead of dragging the whole workspace
    // through it - the bare-'select' gate was the post-Proceed lag on a large plan (Nils 2026-07-06).
    Function _RawMayHaveSelectIndicator String[] ByRef asSource Returns Boolean
        Boolean bHit
        Get _RawMayHaveIndicatorNamed (&asSource) "select" to bHit
        Function_Return bHit
    End_Function

    // True when ANY file in asFiles uses SELECT as a legacy indicator ('[Select]' or 'Indicate Select') -
    // the construct the converters turn into a bare 'Select' under eModernizeSelect, which then needs the
    // DefineSelectMacro companion. A cheap RAW pre-gate (_RawMayHaveSelectIndicator) skips the tokenizer for
    // every file that does not raw-mention '[Select]' / 'Indicate Select', so the bare WORD 'select' (menus,
    // SQL, the Select command) no longer tokenizes the whole run set; _CollectIndicatorNames then confirms
    // (masking strings/comments) so a '[Select]' inside a comment can't over-select the companion. Reuses the
    // SAME parse the converters use, so they agree. Short-circuits on the first file that qualifies.
    Function _ScopeHasSelectIndicator String[] asFiles Returns Boolean
        String[] asSource asUsed asDeclared
        Integer i iMax j jMax
        Boolean bMaybe

        Move (SizeOfArray(asFiles) - 1) to iMax
        For i from 0 to iMax
            Move (rfReadEncodedFileAsStringArray(asFiles[i])) to asSource
            // Cheap RAW pre-gate (no tokenizer): only a file that raw-mentions '[Select]' / 'Indicate Select'
            // pays the tokenizer pass. Raw is a superset of the masked scan, so it never MISSES a real SELECT
            // indicator - it can only over-trigger the (then-authoritative) _CollectIndicatorNames pass.
            Get _RawMayHaveSelectIndicator (&asSource) to bMaybe
            If (bMaybe = True) Begin
                Send ClearFuncLibProperties   // fresh tokenizer state per file
                Send _CollectIndicatorNames (&asSource) (&asUsed) (&asDeclared)
                Move (SizeOfArray(asUsed) - 1) to jMax
                For j from 0 to jMax
                    If (Lowercase(Trim(asUsed[j])) = "select") ;
                        Function_Return True
                Loop
            End
        Loop
        Function_Return False
    End_Function

    // Returns the identifiers reached via a qualified 'X.Y' reference in sText: for each '.' whose preceding
    // char is an identifier char and whose following char STARTS an identifier (letter/_, never a digit), the
    // run after the dot (Y). Used by RemovePropertyPrivate to protect a property accessed as 'mixin.property'
    // (e.g. VDFQuery's 'aps_panel_mx.p_resize_in_progress'): such a property registers under its scoped Private
    // name, so stripping Private breaks every qualified access (4328). A dot in a number (3.14) is rejected by
    // the digit-start test; a dot in a "file.ext" literal is at worst harmlessly over-collected.
    Function _DottedNames String sText Returns String[]
        String[] asResult
        String sTok sCh sPrev
        Integer iLen i iAsc iPrev
        Boolean bAfterDot bIn

        Move (Length(sText)) to iLen
        Move "" to sTok
        Move " " to sPrev    // a non-identifier sentinel so the first-char dot test never calls Ascii("")
        Move False to bAfterDot
        Move False to bIn
        For i from 1 to iLen
            Move (Mid(sText, 1, i)) to sCh
            Move (Ascii(sCh)) to iAsc
            If (bIn = True) Begin
                If ((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or (iAsc >= 48 and iAsc <= 57) or sCh = "_") Begin
                    Move (sTok + sCh) to sTok
                End
                Else Begin
                    Move sTok to asResult[SizeOfArray(asResult)]
                    Move "" to sTok
                    Move False to bIn
                End
            End
            Else If (bAfterDot = True) Begin
                // First char after a qualifying dot must START an identifier (letter or _), not a digit.
                If ((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or sCh = "_") Begin
                    Move sCh to sTok
                    Move True to bIn
                End
                Move False to bAfterDot
            End
            // A '.' whose previous char is an identifier char opens a qualified reference - and so does
            // the '!$.' form: '!$' is the current-class macro, so '!$.pMin' IS a class.property access to
            // a Private property, the very thing this list protects. A class reading its Private
            // properties that way lost every one of them to the strip (40 undefined symbols, 2026-09-07).
            Move (Ascii(sPrev)) to iPrev
            If (sCh = "." and ((iPrev >= 65 and iPrev <= 90) or (iPrev >= 97 and iPrev <= 122) or (iPrev >= 48 and iPrev <= 57) or sPrev = "_" or sPrev = "$")) Begin
                Move True to bAfterDot
            End
            Move sCh to sPrev
        Loop
        If (bIn = True and sTok <> "") ;
            Move sTok to asResult[SizeOfArray(asResult)]
        Function_Return asResult
    End_Function

    // True when an indicator conversion produced a STRUCTURALLY BROKEN line - the ONE check shared by both
    // ChangeLegacyIndicators and ChangeSquareBracketsIndicators, which revert to the original (a harmless [...]
    // warning) rather than emit a compile error. One home so the two callers cannot drift (cf. the grid/plan
    // recipe-matcher split). Two shapes seen on LegacyApp:
    // (a) Conditionless If - the [bracket] If <cond> <stmt> path drops the condition when it was not extracted
    //     as an expression, emitting 'If <statement>' with no parenthesised condition (list0040.vw
    //     'If Move (0) to iOK' -> a generated |EI/|EZ label, 4330). EVERY valid conversion parenthesises its
    //     condition ('If ('), so an 'If' not immediately followed by '(' is the mangle.
    // (b) Swallowed ';' continuation - a [bracket] whose ']' is immediately followed by a ';' line-continuation
    //     ('[FINDERR];   Begin') pulls the ';' INTO the indicator expression -> '(FINDERR;)', a stray ';'
    //     operator (err 52 "FEL FORMAT I UTTRYCKET (OPERATOR) ;"; UFUNC.INC). Detect a ';)' the conversion
    //     INTRODUCED (the original lacked it, so a ';)' already in a comment/string is left alone).
    Function _IndicatorLineIsMalformed String sConverted String sOriginal Returns Boolean
        String sToken

        If (sConverted = sOriginal) ;
            Function_Return False
        Move (Lowercase(Trim(sConverted))) to sToken
        // The condition must be parenthesised ('if (x)'). Skip the run of space(s) after 'if' before checking
        // for the '(' so a stray DOUBLE space ('if  (x)', LegacyApp INVC0183.rv) still reads as a valid conversion
        // rather than being flagged as a conditionless 'If' and reverted.
        If (Left(sToken, 3) = "if " and Left(Trim(Right(sToken, Length(sToken) - 2)), 1) <> "(") ;
            Function_Return True
        If ((sConverted contains ";)") and not(sOriginal contains ";)")) ;
            Function_Return True
        // A bracket conditional on a 'begin' block-opener MUST keep 'begin' ('[x] begin' -> 'If (x) begin',
        // 'ifnot [x] begin' -> 'If (Not(x)) begin'). If the original opened a block with 'begin' but the converted
        // dropped it, the matching 'end' is orphaned (4348 'Unresolved control block' + 4326 stack-pop -> a
        // cascade that even surfaces bogus 'Undefined symbol ~' at downstream End_Objects; a legacy
        // 'ifnot [seqeof] begin'). Word-bounded so 'begin' inside an identifier is not matched.
        If ((" " + Lowercase(sOriginal) + " ") contains " begin " and ;
            not((" " + Lowercase(sConverted) + " ") contains " begin ")) ;
            Function_Return True
        // NOTE: a bare 'loop' is NOT malformed here - it is a valid Repeat/While terminator (the original
        // 'repeat ... loop' compiled). A '[cond] loop' is converted to a post-test 'Until (...)' by the Sub's
        // Loop case / FixIndicatorsLoopRepeatCommand, not flagged as broken.
        Function_Return False
    End_Function

    // A [bracket] whose ']' is immediately followed by a ';' line-continuation ('[FINDERR];', with Begin on the
    // NEXT line) is a valid conversion the sub emits one char wrong: the ';' gets pulled INTO the condition,
    // '(FINDERR;)'. Move an INTRODUCED ';)' back out to ');' ('If (FINDERR);' - valid) rather than let
    // _IndicatorLineIsMalformed revert the whole line. Only the ';)' the conversion introduced (the original
    // lacked it, so a ';)' already in a comment/string is left alone). Called by BOTH indicator converters just
    // BEFORE the shared malformed check. (Nils, LegacyApp UFUNC.INC 2026-07-02.)
    Function _UnswallowSemicolon String sConverted String sOriginal Returns String
        If ((sConverted contains ";)") and not(sOriginal contains ";)")) ;
            Function_Return (Replace(";)", sConverted, ");"))
        Function_Return sConverted
    End_Function

    /* A leading 'ifnot (X) rest' - what the in-place bracket swap leaves of 'ifnot [X] rest' - finished as the
       modern 'If (Not(X)) rest' (2026-09-07). The IfNot converter cannot do it: it runs BEFORE the indicator
       converters in the per-line order and bails on a bracket operand, so 'ifnot (X)' used to wait for a second
       plan run. A '(Not(X))' left by '[~X]' collapses to 'If (X)', the way '[~X] loop' becomes 'Until (X)'.
       Only the first parenthesised group after the word is read; whatever follows - Begin, an inline statement,
       the end comment - is carried verbatim. Any other shape (no group right after 'ifnot', an unbalanced one,
       an empty one) comes back unchanged. */
    Function _FinishLeadingIfNot String sLine Returns String
        String sIndent sBody sInner sTail sCh
        Integer iLen i iDepth iOpen iClose iInnerLen iMatch

        Move (Length(sLine)) to iLen
        Move 1 to i
        While (i <= iLen and (Mid(sLine, 1, i) = " " or Mid(sLine, 1, i) = Character(9)))
            Increment i
        Loop
        Move (Left(sLine, (i - 1))) to sIndent
        Move (Mid(sLine, iLen, i)) to sBody
        If (Lowercase(Left(sBody, 6)) <> "ifnot ") ;
            Function_Return sLine
        // The group must be the next non-blank thing after the word.
        Move (Length(sBody)) to iLen
        Move 7 to i
        While (i <= iLen and Mid(sBody, 1, i) = " ")
            Increment i
        Loop
        If (i > iLen or Mid(sBody, 1, i) <> "(") ;
            Function_Return sLine
        Move i to iOpen
        Move 0 to iDepth
        Move 0 to iClose
        While (i <= iLen and iClose = 0)
            Move (Mid(sBody, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            Else If (sCh = ")") Begin
                Decrement iDepth
                If (iDepth = 0) ;
                    Move i to iClose
            End
            Increment i
        Loop
        If (iClose = 0) ;
            Function_Return sLine
        Move (Trim(Mid(sBody, (iClose - iOpen - 1), (iOpen + 1)))) to sInner
        Move (Mid(sBody, (iLen - iClose), (iClose + 1))) to sTail
        If (sInner = "") ;
            Function_Return sLine
        // '(Not(X))' -> 'If (X)' when the Not( ... ) IS the whole group: the '(' after Not must close on the
        // group's last character ('Not(A) and Not(B)' closes early and keeps its outer Not).
        Move (Length(sInner)) to iInnerLen
        If (Lowercase(Left(sInner, 4)) = "not(" and Right(sInner, 1) = ")") Begin
            Move 0 to iDepth
            Move 0 to iMatch
            Move 4 to i
            While (i <= iInnerLen and iMatch = 0)
                Move (Mid(sInner, 1, i)) to sCh
                If (sCh = "(") ;
                    Increment iDepth
                Else If (sCh = ")") Begin
                    Decrement iDepth
                    If (iDepth = 0) ;
                        Move i to iMatch
                End
                Increment i
            Loop
            If (iMatch = iInnerLen and iInnerLen > 5) ;
                Function_Return (sIndent + CS_If + " (" + Trim(Mid(sInner, (iInnerLen - 5), 5)) + ")" + sTail)
        End
        Function_Return (sIndent + CS_If + " (" + CS_Not + "(" + sInner + "))" + sTail)
    End_Function

    /* THE RULE: MACRO CODE IS NEVER REFACTORED (Nils, 2026-09-07 - his words: "no macro code should ever be
       refactored").

       Macro code is the FMAC layer of a DataFlex source: everything from a #COMMAND line through its
       #ENDCOMMAND, a #DATA block through its #ENDDATA, and any line whose code starts with an exclamation
       mark - a raw compiler directive such as '!A [not X] $1C4 iImg' or the '!e' family. It is not DataFlex
       statements, the converters cannot reason about it, and the compiler takes it literally: the day the
       rule was written, a plan had turned an 'indicate X as [...]' into a Move to a gb Boolean and renamed X
       inside two '!A [not X]' lines - a directive takes an indicator and nothing else, so a file that had
       compiled for twenty years stopped compiling.

       The engine enforces the rule ONCE, for every function type, with the methods below and the lexer's
       MacroCodeFlags (which lines of a file are macro code, from its file walk ScanSourceFile):
         MaskMacroCode /          swap the macro lines for sentinel comment lines before a whole-file function
         UnmaskMacroCode          runs, and put the originals back afterwards - found BY SENTINEL, so a function
                                  that inserted or deleted lines around them is no problem; one the function
                                  deleted outright is re-inserted at its original index and counted as lost,
                                  for the run notes
         GuardMacroCodeOnWrite    the write-time check for a pass that reads and writes files itself: puts a
                                  changed macro line back when the line count allows, and says when it cannot
       The line-by-line pass simply never hands a flagged line to a function. The engine and the analyzer call
       these through ghoFuncLib, as they call the rest of the library (until 2026-10-29 they were global functions
       in a package of their own, cMacroCodeGuard.pkg).

       THE SAME GUARD KEEPS TEXT AS WRITTEN (2026-10-29). A DF 23 multi-line string's text and every line of a
       #HEADER region are not code either, and whole-file functions that read raw lines changed them as they
       changed code. They are masked the same way, under their own sentinel (CS_KeptTextSentinel), so the run
       summary's macro count still counts macro code only: MaskFlaggedLines / UnmaskFlaggedLines take any set of
       lines, and KeptTextFlags says which lines those are, from the same file walk. The line pass leaves them
       alone through the Tokenizer (pbKeepLineAsWritten).

       A STRING'S TEXT IS NEVER A MACRO BLOCK (2026-10-29). A #COMMAND or #DATA line in a multi-line string's text
       is text - measured on DataFlex 26, a #COMMAND / #ENDCOMMAND pair there defines no command and an unclosed
       #COMMAND there swallows nothing - so it opens no block. Until then the code after such a string was flagged
       up to the next #ENDCOMMAND or to the end of the file: the run left it alone, and the scan's rows on it never
       cleared. The exclamation mark is built with Character(33) throughout: the compiler reads a literal one
       followed by a digit or a '$' as macro syntax even inside a string. */

    // Replaces every line of asCode whose abFlags entry is True with a sentinel, sPrefix + its number: a comment
    // line no function acts on. asSaved keeps the original text and aiIndex the original line index, in
    // parallel. Returns how many lines were masked (0 = nothing to do, arrays empty).
    Function MaskFlaggedLines String[] ByRef asCode Boolean[] ByRef abFlags String sPrefix String[] ByRef asSaved Integer[] ByRef aiIndex Returns Integer
        Integer i iLast iN

        Move (ResizeArray(asSaved, 0)) to asSaved
        Move (ResizeArray(aiIndex, 0)) to aiIndex
        Move (SizeOfArray(abFlags) - 1) to iLast
        Move 0 to iN
        For i from 0 to iLast
            If (abFlags[i] = True) Begin
                Move asCode[i] to asSaved[iN]
                Move i to aiIndex[iN]
                Move (sPrefix + String(iN)) to asCode[i]
                Increment iN
            End
        Loop
        Function_Return iN
    End_Function

    // Puts the lines MaskFlaggedLines masked under sPrefix back. Each sentinel is looked for at its original
    // index first and then anywhere in asCode (a function may have inserted or deleted lines around it, or
    // re-indented it); the original text replaces it wherever it is. A sentinel the function deleted has its
    // line re-inserted at the original index (clamped to the array), and iLost counts those - the rule beats
    // the function, and the caller names it in the run notes. Returns how many sentinels were found and replaced.
    Function UnmaskFlaggedLines String[] ByRef asCode String sPrefix String[] ByRef asSaved Integer[] ByRef aiIndex Integer ByRef iLost Returns Integer
        Integer iN iK i iSize iAt iBack
        String sSentinel

        Move 0 to iLost
        Move 0 to iBack
        Move (SizeOfArray(asSaved)) to iN
        For iK from 0 to (iN - 1)
            Move (sPrefix + String(iK)) to sSentinel
            Move (SizeOfArray(asCode)) to iSize
            Move -1 to iAt
            If (aiIndex[iK] < iSize) Begin
                If (Trim(asCode[aiIndex[iK]]) = sSentinel) ;
                    Move aiIndex[iK] to iAt
            End
            Move 0 to i
            While (iAt = -1 and i < iSize)
                If (Trim(asCode[i]) = sSentinel) ;
                    Move i to iAt
                Increment i
            Loop
            If (iAt >= 0) Begin
                Move asSaved[iK] to asCode[iAt]
                Increment iBack
            End
            Else Begin
                Move aiIndex[iK] to iAt
                If (iAt > iSize) ;
                    Move iSize to iAt
                Move (InsertInArray(asCode, iAt, asSaved[iK])) to asCode
                Increment iLost
            End
        Loop
        Function_Return iBack
    End_Function

    // Replaces every macro line of asCode with its sentinel (MaskFlaggedLines). Returns how many lines were masked.
    Function MaskMacroCode String[] ByRef asCode String[] ByRef asSaved Integer[] ByRef aiIndex Returns Integer
        Boolean[] abFlags
        Integer iN

        Get MacroCodeFlags (&asCode) to abFlags
        Get MaskFlaggedLines (&asCode) (&abFlags) CS_MacroSentinel (&asSaved) (&aiIndex) to iN
        Function_Return iN
    End_Function

    // Puts the macro lines MaskMacroCode masked back (UnmaskFlaggedLines).
    Function UnmaskMacroCode String[] ByRef asCode String[] ByRef asSaved Integer[] ByRef aiIndex Integer ByRef iLost Returns Integer
        Integer iBack

        Get UnmaskFlaggedLines (&asCode) CS_MacroSentinel (&asSaved) (&aiIndex) (&iLost) to iBack
        Function_Return iBack
    End_Function

    // An editor function re-indents a sentinel like any other comment line. This moves it back to column 0, so
    // the editor pass counts no sentinel as a changed line - the line it stands for comes back as written anyway.
    // Returns how many it moved back.
    Function UnindentSentinels String[] ByRef asCode Returns Integer
        Integer i iLast iN
        String sTrim

        Move 0 to iN
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(Replaces(Character(9), asCode[i], " "))) to sTrim
            If (Left(sTrim, Length(CS_SentinelStart)) = CS_SentinelStart and Length(sTrim) <> Length(asCode[i])) Begin
                Move sTrim to asCode[i]
                Increment iN
            End
        Loop
        Function_Return iN
    End_Function

    // The write-time check for a pass that reads and writes files itself (no engine masking in between):
    // asOld is the file as it is on disk, asNew what the pass wants to write. Every macro line of asOld must
    // come back byte for byte. Same line count: a changed macro line is simply put back (returns how many).
    // Different line count: each macro line must still be present verbatim somewhere - when one is not, the
    // pass changed or removed macro code AND moved the lines around it, and there is no safe way to put it
    // back: returns -1 with iFirstLine = the 1-based line of the first such line in asOld, and the caller
    // leaves the file alone and says so.
    Function GuardMacroCodeOnWrite String[] ByRef asOld String[] ByRef asNew Integer ByRef iFirstLine Returns Integer
        Boolean[] abFlags
        Integer i iLast iNew iBack
        Boolean bFound

        Move 0 to iFirstLine
        Get MacroCodeFlags (&asOld) to abFlags
        Move (SizeOfArray(abFlags) - 1) to iLast
        Move (SizeOfArray(asNew)) to iNew
        Move 0 to iBack
        For i from 0 to iLast
            If (abFlags[i] = True) Begin
                If (iNew = iLast + 1) Begin
                    If (asNew[i] <> asOld[i]) Begin
                        Move asOld[i] to asNew[i]
                        Increment iBack
                    End
                End
                Else Begin
                    Move False to bFound
                    If (i < iNew) ;
                        Move (asNew[i] = asOld[i]) to bFound
                    If (bFound = False) ;
                        Move (SearchArray(asOld[i], asNew) <> -1) to bFound
                    If (bFound = False and iFirstLine = 0) ;
                        Move (i + 1) to iFirstLine
                End
            End
        Loop
        If (iFirstLine > 0) ;
            Function_Return -1
        Function_Return iBack
    End_Function

    /* GuardMacroCodeOnWrite's check for a multi-line string's text and the #HEADER lines (KeptTextFlags),
       for a pass that reads and writes files itself. asOld is the file on disk, asNew what the pass wants to
       write. Same line count: a changed line is put back (returns how many). Different line count: the kept
       lines of asNew, found by the same walk, must be those of asOld in the same order, byte for byte - a
       search for each line would accept a blank text line or an 'End' line found anywhere. When they are not,
       returns -1 with iFirstLine = the 1-based line in asOld of the first one that differs. With the same line
       count the text on an @-string's opening and closing lines is put back too (_GuardAtStringTextOnWrite);
       with a different count only the whole lines are compared. */
    Function _GuardKeptTextOnWrite String[] ByRef asOld String[] ByRef asNew Integer ByRef iFirstLine Returns Integer
        tLineInfo[] aOld aNew
        Boolean[] abOld abNew
        Integer i j iLast iLastNew iBack iParts
        Boolean bFound

        Move 0 to iFirstLine
        Move 0 to iBack
        Get ScanSourceFile (&asOld) to aOld
        Get _KeptTextFlagsOf (&aOld) False to abOld
        Move (SizeOfArray(asOld) - 1) to iLast
        If (SizeOfArray(asNew) = SizeOfArray(asOld)) Begin
            For i from 0 to iLast
                If (abOld[i] = True) Begin
                    If (asNew[i] <> asOld[i] or Length(asNew[i]) <> Length(asOld[i])) Begin
                        Move asOld[i] to asNew[i]
                        Increment iBack
                    End
                End
            Loop
            Get _GuardAtStringTextOnWrite (&asOld) (&aOld) (&asNew) to iParts
            Function_Return (iBack + iParts)
        End
        Get ScanSourceFile (&asNew) to aNew
        Get _KeptTextFlagsOf (&aNew) False to abNew
        Move (SizeOfArray(asNew) - 1) to iLastNew
        Move 0 to j
        For i from 0 to iLast
            If (abOld[i] = True and iFirstLine = 0) Begin
                Move False to bFound
                While (bFound = False and j <= iLastNew)
                    If (abNew[j] = True) ;
                        Move True to bFound
                    Else ;
                        Increment j
                Loop
                If (bFound = False) ;
                    Move (i + 1) to iFirstLine
                Else Begin
                    If (asNew[j] <> asOld[i] or Length(asNew[j]) <> Length(asOld[i])) ;
                        Move (i + 1) to iFirstLine
                    Increment j
                End
            End
        Loop
        If (iFirstLine > 0) ;
            Function_Return -1
        Function_Return 0
    End_Function

    /* THE RULE AT WRITE TIME - for a pass that reads and writes files itself (the *All functions), where the
       engine's masking is not in between: macro code is never refactored (Nils, 2026-09-07), and neither is a
       multi-line string's text or a #HEADER line (2026-10-29). The file as it is on disk gives those lines;
       GuardMacroCodeOnWrite and _GuardKeptTextOnWrite put a changed one back when the line count allows,
       and when they cannot the file is left as it was and the run notes say so. Returns what the writer
       returns, and True for a declined write - declining is the rule working, not a failure. */
    Function _GuardedWriteEncodedFile String sFile String[] ByRef asNew Boolean bIsUtf8 Returns Boolean
        String[] asOld
        Integer iBack iFirst
        String sFn sLineBreak
        Boolean bOK bEndsWithLineBreak

        // The old file is opened here anyway, so take the two facts the array cannot carry with it:
        // whether the file ENDED with a line break, and WHICH break it used. Without the first a
        // whole-file pass wrote every BOM-less file one terminator short; without the second it
        // retyped an LF-only file to CRLF, which shows as every line changed and buries the real
        // edit (2026-09-09). rfDetectFileLineBreak is the same answer the engine's own read path
        // publishes as psLineBreak, so this write path and WriteStringArrayToFile cannot drift.
        Move (rfReadEncodedFileLines(sFile, False, &bEndsWithLineBreak)) to asOld
        Move (rfDetectFileLineBreak(sFile)) to sLineBreak
        Get GuardMacroCodeOnWrite (&asOld) (&asNew) (&iFirst) to iBack
        Get psExecutionContext to sFn
        If (iBack < 0) Begin
            Send AddRunNote sFn (sFile + ": left as it was - this pass changed or removed macro code (line" * String(iFirst) + "), which is never refactored, and the line count changed as well, so it could not be put back. Make the change by hand if it is wanted.")
            Function_Return True
        End
        If (iBack > 0) ;
            Send AddRunNote sFn (sFile + ":" * String(iBack) * "macro line(s) put back as written - macro code is never refactored.")
        // The same check for a multi-line string's text and the #HEADER lines (KeptTextFlags).
        Get _GuardKeptTextOnWrite (&asOld) (&asNew) (&iFirst) to iBack
        If (iBack < 0) Begin
            Send AddRunNote sFn (sFile + ": left as it was - this pass changed a multi-line string's text or a #HEADER line (line" * String(iFirst) + "), which is never refactored, and the line count changed as well, so it could not be put back. Make the change by hand if it is wanted.")
            Function_Return True
        End
        If (iBack > 0) ;
            Send AddRunNote sFn (sFile + ":" * String(iBack) * "line(s) of a multi-line string's text or a #HEADER region put back as written - they are never refactored.")
        Get rfWriteEncodedFileFromStringArrayEx (&asNew) sFile sLineBreak bIsUtf8 bEndsWithLineBreak to bOK
        Function_Return bOK
    End_Function

    // Detect the legacy 'not [indicator]' form - a standalone 'not' operator IMMEDIATELY before a bracket
    // indicator ('Until not [Found]', negation OUTSIDE the bracket, vs the usual '[~Found]'/'[Not Found]' INSIDE
    // it). The tokeniser captures the bare 'not' as the boolean and drops the bracket, so the converters mangle
    // it to 'Until (not)' - a dangling 'not' the compiler reports as 'Undefined symbol ~' (LegacyApp
    // TIME0760/ovrv0510 report-transfer loops). Both ChangeLegacyIndicators and ChangeSquareBracketsIndicators
    // skip such a line, leaving the harmless obsolete-indicator warning rather than emitting the broken form.
    Function _HasNotBeforeBracketIndicator tTokenizer TokenizerData Returns Boolean
        Integer iSize iItem
        Move (SizeOfArray(TokenizerData.asLineTokens) - 1) to iSize
        For iItem from 0 to (iSize - 1)
            If (Lowercase(TokenizerData.asLineTokens[iItem]) = Lowercase(CS_Not) and ;
                Left(TokenizerData.asLineTokens[iItem + 1], 1) = "[") ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Rewrite the FIRST clean 'not [<singleName>]' on a line to '[~<singleName>]' - the word 'not' sitting
    // OUTSIDE a bracket indicator is semantically identical to the tilde negation INSIDE it, which the converter
    // already turns into '(Not(X))'. Returns "" (no rewrite) for anything that is not a single, plain indicator
    // (compound bracket, a '~' already inside, whitespace inside the bracket), so the caller keeps the old safe
    // skip. sOverstrikeLine (strings masked) LOCATES the shape - so a 'not [' inside a string literal can't
    // false-match - while the real text is spliced from sLine. CAUTION: sOverstrikeLine has the leading indent
    // STRIPPED but sLine KEEPS it, so their columns are shifted by iOffset (measured at the first '['); every
    // splice back into sLine adds iOffset. (Nils 2026-07-02: the missing offset made every INDENTED line extract
    // garbage between [ ] and return "" - i.e. 'If not [X]' silently never converted.) See ChangeLegacyIndicators.
    { Visibility=Private }
    Function _NotBracketToTilde String sLine String sOverstrikeLine Returns String
        Integer iBr iClose iPreLen iOffset
        String sPre sName sHead sTail

        Move ((Pos("[", sLine)) - (Pos("[", sOverstrikeLine))) to iOffset   // indent sLine keeps that sOver dropped
        Move 1 to iBr
        While (True)
            Move (Pos("[", sOverstrikeLine, iBr)) to iBr
            If (iBr = 0) ;
                Function_Return ""
            Move (RTrim(Left(sOverstrikeLine, iBr - 1))) to sPre
            Move (Length(sPre)) to iPreLen
            // The code just before '[' must END with the standalone word 'not'.
            If (iPreLen >= 3 and Lowercase(Right(sPre, 3)) = "not" and ;
                (iPreLen = 3 or Mid(sPre, 1, iPreLen - 3) = " " or Mid(sPre, 1, iPreLen - 3) = Character(9))) Begin
                Move (Pos("]", sOverstrikeLine, iBr)) to iClose
                If (iClose > iBr + 1) Begin
                    Move (Mid(sLine, iClose - iBr - 1, iBr + 1 + iOffset)) to sName    // real content between [ and ]
                    // Single, plain indicator only (no space / tab / tilde / nested bracket).
                    If (sName <> "" and (Pos(" ", sName) = 0) and (Pos(Character(9), sName) = 0) ;
                        and (Pos("~", sName) = 0) and (Pos("[", sName) = 0)) Begin
                        Move (Left(sLine, iPreLen - 3 + iOffset)) to sHead              // '...If ' (up to just before 'not')
                        Move (Mid(sLine, Length(sLine) - iClose - iOffset, iClose + 1 + iOffset)) to sTail   // text after ']'
                        Function_Return (sHead + "[~" + sName + "]" + sTail)
                    End
                End
            End
            Move (iBr + 1) to iBr
        Loop
        Function_Return ""
    End_Function

    // A bare 'Select' immediately after Send/Get/Set is the built-in DataFlex Select MESSAGE (e.g.
    // 'Send Select 0 255' selects a text range in an entry), NOT the SELECT FMAC indicator macro. It must not
    // trigger DefineSelectMacro: defining SELECT as |!C would rewrite it to 'Send |!C ...' -> 4345 'SELECT,
    // INDICATOR NOT ALLOWED' (LegacyApp EXCLASS.INC). Only a Select used as an INDICATOR value ('(Select)' /
    // 'Indicate Select' / 'to Select') needs the macro; those forms are not preceded by Send/Get/Set.
    Function _BareSelectIsMessageSend tTokenizer TokenizerData Returns Boolean
        Integer iSel
        String sPrev
        Move (SearchArray(CS_Select, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iSel
        If (iSel < 1) ;
            Function_Return False
        Move (Lowercase(TokenizerData.asLineTokens[iSel - 1])) to sPrev
        Function_Return (sPrev = "send" or sPrev = "get" or sPrev = "set")
    End_Function

    // Compute the modern g-prefixed GLOBAL name for one bare shell global - the naming rule
    // reverse-engineered from the hand-modernized reference shell (Nils 2026-07-10): String->gs,
    // Integer->gi, Number->gn, Date->gd, Boolean->gb. An already-conventioned name passes through
    // (gsFoo stays gsFoo); a type-letter camel prefix is ABSORBED ('sCmdString' -> 'gsCmdString',
    // never 'gssCmdString'); anything else gets the prefix + an uppercased first letter ('arg001' ->
    // 'gsArg001', 'P_auto_login@' -> 'gsP_auto_login@' - the '@' stays, it is part of the
    // identifier, and this is EXACTLY the name the modernized shared packages read).
    Function _GlobalShellVarName String sName String sTypeLow Returns String
        String sPrefix sFirst
        Integer iSecond

        Move "" to sPrefix
        If (sTypeLow = "string") ;
            Move "gs" to sPrefix
        If (sTypeLow = "integer") ;
            Move "gi" to sPrefix
        If (sTypeLow = "number") ;
            Move "gn" to sPrefix
        If (sTypeLow = "date") ;
            Move "gd" to sPrefix
        If (sTypeLow = "boolean") ;
            Move "gb" to sPrefix
        If (sPrefix = "" or sName = "") ;
            Function_Return sName
        If (Lowercase(Left(sName, 2)) = sPrefix) ;
            Function_Return sName
        Move 0 to iSecond
        If (Length(sName) > 1) ;
            Move (Ascii(Mid(sName, 1, 2))) to iSecond
        If ((Lowercase(Left(sName, 1)) = Right(sPrefix, 1)) and iSecond >= 65 and iSecond <= 90) ;
            Function_Return ("g" + sName)
        Move (Uppercase(Left(sName, 1))) to sFirst
        Function_Return (sPrefix + sFirst + Mid(sName, (Length(sName)), 2))
    End_Function

    // Replace every whole-token occurrence of sOld with sNew in the CODE of sLine only: the match
    // position is located on the line's code as the file walk read it (_WalkedCodeLine, Info the line's
    // tLineInfo: string literals and block comments blanked, the line cut at a // outside literals, a
    // comment's or a multi-line string's text blank - positions up to the cut align with the original),
    // then spliced into the real line. So a rename can never touch 'arg1' inside a string literal or a comment.
    Function _ReplaceWholeTokenCodeAware String sLine tLineInfo Info String sOld String sNew Returns String
        String sMask
        Integer iPos iStart
        Move 1 to iStart
        Repeat
            Get _WalkedCodeLine sLine Info to sMask
            Get _FindKeywordPos sMask sOld True iStart to iPos
            If (iPos > 0) Begin
                Move (Left(sLine, (iPos - 1)) + sNew + Mid(sLine, (Length(sLine)), (iPos + Length(sOld)))) to sLine
                Move (iPos + Length(sNew)) to iStart
            End
        Until (iPos = 0)
        Function_Return sLine
    End_Function

    /* SCOPE BOOKKEEPING on a lowercased, trimmed line: the Object/Class, Procedure/Function and Struct
       nesting depths the bare-global passes keep (_TransformBareGlobals here, ConvertGosubToProcedure in
       oRefactorFuncLib) - only a line at depth 0 in all three is a file-scope declaration. A closer never
       takes a depth below zero. */
    Procedure _TrackScopeDepth String sLowTrim Integer ByRef iObjDepth Integer ByRef iProcDepth Integer ByRef iStructDepth
        If (Left(sLowTrim, 7) = "object " or Left(sLowTrim, 6) = "class ") ;
            Move (iObjDepth + 1) to iObjDepth
        If (Left(sLowTrim, 10) = "end_object" or Left(sLowTrim, 9) = "end_class") Begin
            If (iObjDepth > 0) ;
                Move (iObjDepth - 1) to iObjDepth
        End
        If (Left(sLowTrim, 10) = "procedure " or Left(sLowTrim, 9) = "function ") ;
            Move (iProcDepth + 1) to iProcDepth
        If (Left(sLowTrim, 13) = "end_procedure" or Left(sLowTrim, 12) = "end_function") Begin
            If (iProcDepth > 0) ;
                Move (iProcDepth - 1) to iProcDepth
        End
        If (Left(sLowTrim, 7) = "struct ") ;
            Move (iStructDepth + 1) to iStructDepth
        If (Left(sLowTrim, 10) = "end_struct") Begin
            If (iStructDepth > 0) ;
                Move (iStructDepth - 1) to iStructDepth
        End
    End_Procedure

    /* For each of asNames: does macro code of the file use it? (Any case.) Under RunWholeFileFunction asCode holds
       sentinels for that code, and the lines themselves are in pasMaskedMacroLines (2026-11-02: reading asCode alone
       this saw no macro in a real run); called directly, asCode still holds them. */
    Function _NamesReadByMacroCode String[] ByRef asCode String[] asNames Returns Boolean[]
        tLineInfo[] aInfo
        String[] asWords asSplit asMasked
        Boolean[] abOut
        String sCode
        Integer i iLast iWord iLastWord

        Get ScanSourceFile (&asCode) to aInfo
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            If (aInfo[i].eMacro <> MC_None) Begin
                Get _WalkedCodeLine asCode[i] aInfo[i] to sCode
                Get _NameWords sCode to asSplit
                Move (SizeOfArray(asSplit) - 1) to iLastWord
                For iWord from 0 to iLastWord
                    Move (Uppercase(asSplit[iWord])) to asWords[SizeOfArray(asWords)]
                Loop
            End
        Loop
        Get pasMaskedMacroLines to asMasked
        Move (SizeOfArray(asMasked) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asMasked[i] to sCode
            Get _NameWords sCode to asSplit
            Move (SizeOfArray(asSplit) - 1) to iLastWord
            For iWord from 0 to iLastWord
                Move (Uppercase(asSplit[iWord])) to asWords[SizeOfArray(asWords)]
            Loop
        Loop
        Move (SortArray(asWords)) to asWords
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move (BinarySearchArray(Uppercase(asNames[i]), asWords) <> -1) to abOut[i]
        Loop
        Function_Return abOut
    End_Function

    /* Whole-file worker for RefactorBareGlobalsToGlobalVariable (_BareGlobalsPass does the work). A NAME ANOTHER
       FILE READS KEEPS IT (2026-10-31): the rename reaches only this file, so a whole-workspace run broke every
       view, report and shared package that read a shell global by its old name - a shell's 'Integer sPer'
       became giSPer while its view still read sPer. A first pass on a copy names what would be renamed; a name
       a file of the run uses without declaring it (_RunFilesReadingNames) is kept, with a run note naming that
       file, and the pass runs again with those names kept. So is a name macro code of this file reads (2026-11-02):
       macro code is never refactored, so 'integer OG_Tmp#' became giOG_Tmp# under a #COMMAND body that still reads
       OG_Tmp#, and every use of the macro failed. Returns converted declaration lines. */
    Function _TransformBareGlobals String[] ByRef asCode Returns Integer
        String[] asTry asOld asKeep asReaders asNone
        Boolean[] abMacro
        Integer iCount i iLast

        Move asCode to asTry
        Get _BareGlobalsPass (&asTry) asNone (&asOld) to iCount
        If (SizeOfArray(asOld) > 0) Begin
            Get _RunFilesReadingNames asOld to asReaders
            Get _NamesReadByMacroCode (&asCode) asOld to abMacro
            Move (SizeOfArray(asOld) - 1) to iLast
            For i from 0 to iLast
                If (abMacro[i] = True) Begin
                    Move asOld[i] to asKeep[SizeOfArray(asKeep)]
                    Send AddRunNote "RefactorBareGlobalsToGlobalVariable" (asOld[i] + " keeps its name: a macro in this file uses it, and macro code is never changed.")
                End
                Else If (asReaders[i] <> "") Begin
                    Move asOld[i] to asKeep[SizeOfArray(asKeep)]
                    Send AddRunNote "RefactorBareGlobalsToGlobalVariable" (asOld[i] + " keeps its name: " + asReaders[i] + " uses it too, and a new name would break that file.")
                End
            Loop
        End
        If (SizeOfArray(asKeep) = 0) Begin
            Move asTry to asCode
            Function_Return iCount
        End
        Move (ResizeArray(asOld, 0)) to asOld
        Get _BareGlobalsPass (&asCode) asKeep (&asOld) to iCount
        Function_Return iCount
    End_Function

    // One pass of RefactorBareGlobalsToGlobalVariable: bare command-level declarations at
    // FILE scope ('String P_auto_login@ arg001', 'Integer Radio_State', old sized form
    // 'String arg1 1 arg2 1') become 'Global_Variable <Type> <g-named ...>' and EVERY in-file
    // reference follows the rename (code-aware: literals and comments are never touched) - but a name
    // in asKeep keeps it. asOld gets the names it renamed. FILE
    // SCOPE ONLY - a declaration inside an Object/Class, a Procedure/Function body (a LOCAL), or a
    // Struct (a MEMBER) passes through untouched, tracked by depth counters. Lines already
    // 'Global_Variable ...' are left alone (they compile; renaming them is not this function's
    // job). Size tokens (all digits) ride along unrenamed. Returns converted declaration lines.
    Function _BareGlobalsPass String[] ByRef asCode String[] asKeep String[] ByRef asOld Returns Integer
        String[] asNew
        String sLine sLowTrim sCodePart sComment sTypeWord sTypeLow sTok sNames sMapped sIndent sCh
        Integer iLine iSize iCount iObjDepth iProcDepth iStructDepth iWord iPair iPairs i iEnd
        Boolean bAllDigits bContinued bContinues
        tLineInfo[] aInfo

        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        Get ScanSourceFile (&asCode) to aInfo
        Move 0 to iCount
        Move 0 to iObjDepth
        Move 0 to iProcDepth
        Move 0 to iStructDepth
        Move False to bContinues
        For iLine from 0 to iSize
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Move asCode[iLine] to sLine
            /* ONLY THE LINE'S CODE, as the file walk read it (2026-10-30). A block comment's line at file scope
               that started with "string" ("string and hand it over, which keeps the rule intact") read as a
               declaration, and every word on it was renamed through the file - "The" to "gsThe" in every
               comment - and an "Object" or a "Procedure" opening a comment's line moved the scope depths. */
            Get _WalkedCodeLine sLine aInfo[iLine] to sCodePart
            Move (Lowercase(Trim(Replaces(Character(9), sCodePart, " ")))) to sLowTrim
            If (sLowTrim <> "") Begin
                // Scope bookkeeping - only depth-0 command-level lines are shell globals.
                Send _TrackScopeDepth sLowTrim (&iObjDepth) (&iProcDepth) (&iStructDepth)
                /* A CONTINUED LINE IS NO DECLARATION (2026-10-31): a line after one that ends in ';' belongs to
                   that statement - 'String lpnLength;', a parameter of a multi-line External_Function, became
                   'Global_Variable String gsLpnLength;' inside the declaration, and every program that used the
                   package stopped compiling. A declaration that itself goes on after a ';' is left alone too. */
                Move bContinues to bContinued
                Move (Right(sLowTrim, 1) = ";") to bContinues
                If (iObjDepth = 0 and iProcDepth = 0 and iStructDepth = 0 and bContinued = False and bContinues = False) Begin
                    Get _NthWord sCodePart 1 to sTypeWord
                    Move (Lowercase(sTypeWord)) to sTypeLow
                    If (sTypeLow = "string" or sTypeLow = "integer" or sTypeLow = "number" or ;
                        sTypeLow = "date" or sTypeLow = "boolean") Begin
                        // Parse the declared names (+ optional all-digit size tokens, kept in place).
                        Move "" to sNames
                        Move 2 to iWord
                        Repeat
                            Get _NthWord sCodePart iWord to sTok
                            If (sTok <> "") Begin
                                Move True to bAllDigits
                                For i from 1 to (Length(sTok))
                                    Move (Mid(sTok, 1, i)) to sCh
                                    If (sCh < "0" or sCh > "9") ;
                                        Move False to bAllDigits
                                Loop
                                If (bAllDigits = True) ;
                                    Append sNames CS_S sTok
                                Else Begin
                                    Get _GlobalShellVarName sTok sTypeLow to sMapped
                                    If (SearchArray(sTok, asKeep, Desktop, RefFunc(DFSTRICMP)) > -1) ;
                                        Move sTok to sMapped
                                    // A dotted name keeps it (2026-11-02): 'seq.object#' is already a naming scheme,
                                    // and _NameWords splits it at the dot, so no file reading it could be found.
                                    If (Pos(".", sTok) > 0) ;
                                        Move sTok to sMapped
                                    If (sMapped <> sTok and (SearchArray(sTok, asOld, Desktop, RefFunc(DFSTRICMP))) = -1) Begin
                                        Move sTok    to asOld[SizeOfArray(asOld)]
                                        Move sMapped to asNew[SizeOfArray(asNew)]
                                    End
                                    Append sNames CS_S sMapped
                                End
                            End
                            Increment iWord
                        Until (sTok = "")
                        If (sNames <> "") Begin
                            Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                            // The trailing comment survives: the code ends at its last character (positions
                            // align), so the remainder of the ORIGINAL line is the comment - a '//' one, which
                            // the code cuts, or a block comment, which it blanks.
                            Move (Length(RTrim(sCodePart))) to iEnd
                            Move (Mid(sLine, (Length(sLine)), (iEnd + 1))) to sComment
                            Move (sIndent + "Global_Variable " + sTypeWord + sNames) to sLine
                            If (Trim(sComment) <> "") ;
                                Move (sLine + "   " + Trim(sComment)) to sLine
                            Move sLine to asCode[iLine]
                            Increment iCount
                        End
                    End
                End
            End
        Loop
        // Rename every in-file reference of the renamed globals (declarations already carry the new
        // names, so the old tokens only remain at USE sites). Code-aware: literals/comments skipped.
        Move (SizeOfArray(asOld) - 1) to iPairs
        If (iPairs >= 0 and iCount > 0) Begin
            For iLine from 0 to iSize
                If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                    Send Update_StatusPanel of ghoStatusPanel ("Renaming globals, line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                    Set piPosition of ghoProgressBar to (iLine + 1)
                End
                For iPair from 0 to iPairs
                    Get _ReplaceWholeTokenCodeAware asCode[iLine] aInfo[iLine] asOld[iPair] asNew[iPair] to asCode[iLine]
                Loop
            Loop
        End
        Function_Return iCount
    End_Function

    // The names in a line's code: sCode split at every character no name holds (a name holds letters, digits,
    // '_', '@', '#' and '$'). A dotted 'Balance.Per' gives both parts.
    Function _NameWords String sCode Returns String[]
        String[] asSplit asOut
        String sSep
        Integer i iLast

        Move "()[]{},.;:+-*\/=<>!|&~^%?'`" to sSep
        Move (Replaces(Character(9), sCode, " ")) to sCode
        Move (Replaces('"', sCode, " ")) to sCode
        Move (Length(sSep)) to iLast
        For i from 1 to iLast
            Move (Replaces(Mid(sSep, 1, i), sCode, " ")) to sCode
        Loop
        Move (StrSplitToArray(sCode, " ")) to asSplit
        Move (SizeOfArray(asSplit) - 1) to iLast
        For i from 0 to iLast
            If (asSplit[i] <> "") ;
                Move asSplit[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    // A walk over files takes the per-file bar for as long as it lasts (_LiftNudge): what the bar was showing...
    Procedure _WalkBarHold Boolean ByRef bPanel Integer ByRef iMax Integer ByRef iPos Boolean ByRef bMoved
        Move False to bPanel
        If (ghoStatusPanel <> 0) ;
            Move (Active_State(ghoStatusPanel)) to bPanel
        If (bPanel = True) Begin
            Get piMaximum  of ghoProgressBar to iMax
            Get piPosition of ghoProgressBar to iPos
            Get pbLiftBarRetargeted to bMoved
        End
    End_Procedure

    // ...and the bar back to it, for the file the run is on.
    Procedure _WalkBarHandBack Boolean bPanel Integer iMax Integer iPos Boolean bMoved
        If (bPanel = True) Begin
            Set piMaximum  of ghoStatusPanel to iMax
            Set piPosition of ghoProgressBar to iPos
            Set pbLiftBarRetargeted to bMoved
        End
    End_Procedure

    /* THE NAME READERS OF A FILE LIST (2026-10-31, RefactorBareGlobalsToGlobalVariable; the Type converters
       2026-11-01): for every name the code of a file in asFiles uses without declaring it, the file - each read
       once. asOutWords is every such name, UPPERCASE and sorted, and aiOutReader the index in asFiles of the first
       file that uses it. A file's names are those in its code as the file walk reads it (_WalkedCodeLine: string
       literals, comments and image text left out). What a file declares is its own, not read from another file: a
       bare 'String x' or a Global_Variable at FILE scope - outside any Object, Class, method or Struct; a local of
       the same name in a method counts as a use, which keeps a name rather than break one - a 'Type X' block,
       which declares X and X_SIZE, and a method the file defines (Nils's first live run of the tray work, 2026-11-05:
       the file was its own reader of 'Procedure FillFromStruct', so in any real run every method looked called from
       elsewhere, and a test with no run list could not see it). sCaption leads the status-panel line.

       THE BAR IS THE WALK'S WHILE IT LASTS (Nils 2026-11-05). It is all the waiting there is in a one-file run:
       1,211 files of a real workspace took 17 s here, and listing them 47 ms and the sort at the end 0.3 s. It
       moved no bar, and said so only every 20th file. Now _LiftNudge fills the per-file bar on the clock, and the
       bar goes back to what it was showing before the file the run is on goes on. */
    Procedure _NameReaderIndex String[] asFiles String sCaption String[] ByRef asOutWords Integer[] ByRef aiOutReader
        tNameReader Reader
        tNameReader[] aAll
        tLineInfo[] aInfo
        String[] asSource asWords asDeclared asSplit
        String sCode sFirst sPrev sType
        Integer iFile iLastFile iLine iLastLine iObjDepth iProcDepth iStructDepth iWord iLastWord iFrom i iLast iBarMax iBarPos
        Boolean bPanel bBarWasMoved

        Move (ResizeArray(asOutWords, 0)) to asOutWords
        Move (ResizeArray(aiOutReader, 0)) to aiOutReader
        Move (SizeOfArray(asFiles) - 1) to iLastFile
        Send _WalkBarHold (&bPanel) (&iBarMax) (&iBarPos) (&bBarWasMoved)
        For iFile from 0 to iLastFile
            Send _LiftNudge iFile (iLastFile + 1) sCaption
            Move (rfReadEncodedFileAsStringArray(asFiles[iFile])) to asSource
            Get ScanSourceFile (&asSource) to aInfo
            Move 0 to iObjDepth
            Move 0 to iProcDepth
            Move 0 to iStructDepth
            Move (ResizeArray(asWords, 0)) to asWords
            Move (ResizeArray(asDeclared, 0)) to asDeclared
            Move (SizeOfArray(asSource) - 1) to iLastLine
            For iLine from 0 to iLastLine
                Get _WalkedCodeLine asSource[iLine] aInfo[iLine] to sCode
                Move (Trim(Replaces(Character(9), sCode, " "))) to sCode
                If (sCode <> "") Begin
                    Send _TrackScopeDepth (Lowercase(sCode)) (&iObjDepth) (&iProcDepth) (&iStructDepth)
                    Get _NameWords sCode to asSplit
                    Move (SizeOfArray(asSplit) - 1) to iLastWord
                    If (iObjDepth = 0 and iProcDepth = 0 and iStructDepth = 0 and iLastWord > 0) Begin
                        Move (Lowercase(asSplit[0])) to sFirst
                        Move -1 to iFrom
                        If (sFirst = "global_variable") ;
                            Move 2 to iFrom
                        Else Begin
                            Get _LocalDeclType sFirst to sType
                            If (sType <> "") ;
                                Move 1 to iFrom
                        End
                        If (iFrom > -1) Begin
                            For iWord from iFrom to iLastWord
                                Move (Uppercase(asSplit[iWord])) to asDeclared[SizeOfArray(asDeclared)]
                            Loop
                        End
                    End
                    // A Type declares its name and <name>_SIZE wherever it stands.
                    If (iLastWord > 0 and Lowercase(asSplit[0]) = "type") Begin
                        Move (Uppercase(asSplit[1]))           to asDeclared[SizeOfArray(asDeclared)]
                        Move (Uppercase(asSplit[1]) + "_SIZE") to asDeclared[SizeOfArray(asDeclared)]
                    End
                    // So does a method header, 'Procedure Set X' included.
                    If (iLastWord > 0 and (Lowercase(asSplit[0]) = "procedure" or Lowercase(asSplit[0]) = "function")) Begin
                        If (iLastWord > 1 and Lowercase(asSplit[1]) = "set") ;
                            Move (Uppercase(asSplit[2])) to asDeclared[SizeOfArray(asDeclared)]
                        Else ;
                            Move (Uppercase(asSplit[1])) to asDeclared[SizeOfArray(asDeclared)]
                    End
                    For iWord from 0 to iLastWord
                        Move (Uppercase(asSplit[iWord])) to asWords[SizeOfArray(asWords)]
                    Loop
                End
            Loop
            Move (SortArray(asWords)) to asWords
            Move (SortArray(asDeclared)) to asDeclared
            Move "" to sPrev
            Move (SizeOfArray(asWords) - 1) to iLast
            For i from 0 to iLast
                If (asWords[i] <> sPrev and BinarySearchArray(asWords[i], asDeclared) = -1) Begin
                    Move asWords[i] to Reader.sWord
                    Move iFile      to Reader.iFile
                    Move Reader to aAll[SizeOfArray(aAll)]
                End
                Move asWords[i] to sPrev
            Loop
        Loop
        Send _WalkBarHandBack bPanel iBarMax iBarPos bBarWasMoved
        // One reader per name: the first file that uses it.
        Move (SortArray(aAll)) to aAll
        Move (SizeOfArray(aAll) - 1) to iLast
        For i from 0 to iLast
            If (i = 0 or aAll[i].sWord <> sPrev) Begin
                Move aAll[i].sWord to asOutWords[SizeOfArray(asOutWords)]
                Move aAll[i].iFile to aiOutReader[SizeOfArray(aiOutReader)]
            End
            Move aAll[i].sWord to sPrev
        Loop
    End_Procedure

    /* THE RUN'S NAME READERS: _NameReaderIndex over the run's file list (pRefactorSettings' FileData.asFullFileNames),
       built once per run on first need and cleared by _InitializeFuncLib. No file list (a unit test that sets none)
       gives no reader. */
    Procedure _BuildNameReaders
        tRefactorSettings Settings
        String[] asFiles asOutWords
        Integer[] aiOutReader

        Get pRefactorSettings to Settings
        Move Settings.FileData.asFullFileNames to asFiles
        Send _NameReaderIndex asFiles "Finding the files that use each name, file:" (&asOutWords) (&aiOutReader)
        Set pasNameReaderWords to asOutWords
        Set paiNameReader      to aiOutReader
        Set pasNameReaderFiles to asFiles
        Set pbNameReadersBuilt to True
    End_Procedure

    // The source files outside asKnown a walk also has to read: the workspace's source folders and its libraries',
    // by sFilter, leaving out a file with the name of a known one (see _BuildOutsideNameReaders). None without asKnown.
    Function _OutsideReaderFiles String[] asKnown String sFilter Returns String[]
        tRFSearchResult[] aFound
        String[] asFolders asRunLeaf asFound asFiles
        String sFolder sFull sPrev sHome
        Integer iFolder iLastFolder i iLast

        Move (SizeOfArray(asKnown) - 1) to iLast
        If (iLast >= 0) Begin
            For i from 0 to iLast
                Move (Lowercase(ExtractFileName(asKnown[i]))) to asRunLeaf[i]
            Loop
            Move (SortArray(asRunLeaf)) to asRunLeaf
            Get pasOutsideReaderFolders to asFolders
            If (SizeOfArray(asFolders) = 0) Begin
                // A blank target home is the unit tests' cApplication, which has no such function.
                Get psHomeTarget of ghoApplication to sHome
                If (Trim(sHome) <> "") ;
                    Get WholeWorkspaceSourceFolders of ghoApplication to asFolders
            End
            Move (SizeOfArray(asFolders) - 1) to iLastFolder
            For iFolder from 0 to iLastFolder
                Move (vFolderFormat(asFolders[iFolder])) to sFolder
                Move (rfFileSearch((sFolder + "*.*"), DIRMODE_FILES_ONLY, False)) to aFound
                Move (SizeOfArray(aFound) - 1) to iLast
                For i from 0 to iLast
                    Move (sFolder + aFound[i].sFilename) to sFull
                    If (IsFileInFilter(Self, aFound[i].sFilename, sFilter) = True and BinarySearchArray(Lowercase(aFound[i].sFilename), asRunLeaf) = -1) ;
                        Move sFull to asFound[SizeOfArray(asFound)]
                Loop
            Loop
            // A folder listed twice gives its files once.
            Move (SortArray(asFound)) to asFound
            Move "" to sPrev
            Move (SizeOfArray(asFound) - 1) to iLast
            For i from 0 to iLast
                If (asFound[i] <> sPrev) ;
                    Move asFound[i] to asFiles[SizeOfArray(asFiles)]
                Move asFound[i] to sPrev
            Loop
        End
        Function_Return asFiles
    End_Function

    /* THE NAME READERS OUTSIDE THE RUN (2026-11-01, the Type converters): _NameReaderIndex over the source files the
       run does not cover but that compile against its packages - the workspace's source folders and its libraries'
       (WholeWorkspaceSourceFolders), by the run's file filter. A library's file reads the packages of the workspace
       whose programs it is compiled into: a library's winfolder.nui read vFileTime byte by byte from a workspace's
       vWin32fh.pkg, which the run had made a Struct. A file with the NAME of a run
       file is left out: the run's copy comes first on the path and the other is never compiled - a library's own
       vWin32fh.pkg, which the workspace's replaces, kept three Types that converted cleanly. A unit test names its
       own folders in pasOutsideReaderFolders. No run file list - a unit test that sets none, or a Deep Scan before
       any run - reads no folder and gives no reader. Built once per run on first need; cleared by
       _InitializeFuncLib. */
    Procedure _BuildOutsideNameReaders
        tRefactorSettings Settings
        String[] asKnown asFiles asOutWords
        Integer[] aiOutReader

        Get pRefactorSettings to Settings
        Move Settings.FileData.asFullFileNames to asKnown
        Get _OutsideReaderFiles asKnown Settings.sFileFilter to asFiles
        Send _NameReaderIndex asFiles "Finding the files outside the run that use each name, file:" (&asOutWords) (&aiOutReader)
        Set pasOutsideReaderWords to asOutWords
        Set paiOutsideReader      to aiOutReader
        Set pasOutsideReaderFiles to asFiles
        Set pbOutsideReadersBuilt to True
    End_Procedure

    // PURE. For each name of asNames, the file of asFiles that the index (asWords, aiReader - _NameReaderIndex)
    // names as its first reader, or "".
    Function _NameReadersIn String[] asNames String[] asWords Integer[] aiReader String[] asFiles Returns String[]
        String[] asOut
        Integer i iLast iAt

        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move "" to asOut[i]
            Move (BinarySearchArray(Uppercase(asNames[i]), asWords)) to iAt
            If (iAt > -1) ;
                Move asFiles[aiReader[iAt]] to asOut[i]
        Loop
        Function_Return asOut
    End_Function

    // For each name of asNames, a file of the run whose code uses it without declaring it at file scope - ""
    // when no file does (_BuildNameReaders, built on first need).
    Function _RunFilesReadingNames String[] asNames Returns String[]
        String[] asWords asFiles asOut
        Integer[] aiReader

        If (pbNameReadersBuilt(Self) = False) ;
            Send _BuildNameReaders
        Get pasNameReaderWords to asWords
        Get paiNameReader      to aiReader
        Get pasNameReaderFiles to asFiles
        Get _NameReadersIn asNames asWords aiReader asFiles to asOut
        Function_Return asOut
    End_Function

    /* A FILE ELSEWHERE THAT READS THE TYPE (2026-11-01, the Type converters) - "" when none does. A Type is public:
       every file compiled after it can read its member offsets (Put / GetBuff ... at <Type>.<member>), its
       <Type>_SIZE and its name in ZeroType / FillType, and a Struct has none of those. So a file that names the
       Type or its size - in the run (_RunFilesReadingNames) or outside it (_BuildOutsideNameReaders) - stops
       compiling when the declaration becomes a Struct; the run checks only the file it converts. A file that
       declares the same Type itself is no reader. */
    Function _FileReadingTypeElsewhere String sType Returns String
        String[] asNames asReaders asWords asFiles
        Integer[] aiReader
        Integer i

        Move (Trim(sType))           to asNames[0]
        Move (Trim(sType) + "_SIZE") to asNames[1]
        Get _RunFilesReadingNames asNames to asReaders
        For i from 0 to 1
            If (asReaders[i] <> "") ;
                Function_Return asReaders[i]
        Loop
        If (pbOutsideReadersBuilt(Self) = False) ;
            Send _BuildOutsideNameReaders
        Get pasOutsideReaderWords to asWords
        Get paiOutsideReader      to aiReader
        Get pasOutsideReaderFiles to asFiles
        Get _NameReadersIn asNames asWords aiReader asFiles to asReaders
        For i from 0 to 1
            If (asReaders[i] <> "") ;
                Function_Return asReaders[i]
        Loop
        Function_Return ""
    End_Function

    // The canonical simple-type name when sWord opens a local declaration line in a method body -
    // "" when it is no type keyword. Feeds the _TransformFunctionReturns locals map (struct and
    // class types are deliberately absent: a Function_Return of one of those is an expression the
    // inference must NOT guess at).
    Function _LocalDeclType String sWord Returns String
        Move (Lowercase(sWord)) to sWord
        If (sWord = "string") ;
            Function_Return "String"
        If (sWord = "integer") ;
            Function_Return "Integer"
        If (sWord = "number") ;
            Function_Return "Number"
        If (sWord = "real") ;
            Function_Return "Real"
        If (sWord = "date") ;
            Function_Return "Date"
        If (sWord = "datetime") ;
            Function_Return "DateTime"
        If (sWord = "timespan") ;
            Function_Return "TimeSpan"
        If (sWord = "boolean") ;
            Function_Return "Boolean"
        If (sWord = "handle") ;
            Function_Return "Handle"
        If (sWord = "uchar") ;
            Function_Return "UChar"
        If (sWord = "bigint") ;
            Function_Return "BigInt"
        If (sWord = "currency") ;
            Function_Return "Currency"
        If (sWord = "float") ;
            Function_Return "Float"
        If (sWord = "pointer") ;
            Function_Return "Pointer"
        If (sWord = "address") ;
            Function_Return "Address"
        If (sWord = "variant") ;
            Function_Return "Variant"
        If (sWord = "rowid") ;
            Function_Return "RowID"
        If (sWord = "dword") ;
            Function_Return "DWord"
        Function_Return ""
    End_Function

    // Merge two inferred return types into the one type that can carry BOTH - "" means "nothing
    // known yet" and never wins. Same type stays; Integer widens to Number when a decimal shows
    // up; a Boolean or Handle mixing with Integer stays Integer (integer-shaped at the runtime
    // boundary either way); String absorbs any other mix - a String return survives every
    // caller-side conversion, so it is the safe catch-all.
    Function _MergeReturnTypes String sA String sB Returns String
        String sLowA sLowB

        If (sA = "") ;
            Function_Return sB
        If (sB = "") ;
            Function_Return sA
        Move (Lowercase(sA)) to sLowA
        Move (Lowercase(sB)) to sLowB
        If (sLowA = sLowB) ;
            Function_Return sA
        If (sLowA = "string" or sLowB = "string") ;
            Function_Return "String"
        If ((sLowA = "integer" and sLowB = "number") or (sLowA = "number" and sLowB = "integer")) ;
            Function_Return "Number"
        If (sLowA = "integer" and (sLowB = "boolean" or sLowB = "handle")) ;
            Function_Return "Integer"
        If (sLowB = "integer" and (sLowA = "boolean" or sLowA = "handle")) ;
            Function_Return "Integer"
        Function_Return "String"
    End_Function

    // Classify ONE Function_Return argument to a return type - "" when the type cannot be read
    // off the text (a call, a parenthesized expression, an unresolved name). String/numeric/
    // True-False literals classify directly; a bare single identifier resolves against the body's
    // own local declarations (asLocalNames/asLocalTypes, matched case-insensitively).
    Function _ClassifyReturnArg String sArg String[] asLocalNames String[] asLocalTypes Returns String
        String sCh sLow sSecond
        Integer i iLen iLast iDots iDigits
        Boolean bNumeric

        Move (Trim(sArg)) to sArg
        If (sArg = "") ;
            Function_Return ""
        Move (Left(sArg, 1)) to sCh
        If (sCh = '"' or sCh = "'") ;
            Function_Return "String"
        Move (Lowercase(sArg)) to sLow
        If (sLow = "true" or sLow = "false") ;
            Function_Return "Boolean"
        // Numeric literal: optional leading sign, digits, at most one decimal point.
        Move (Length(sArg)) to iLen
        Move True to bNumeric
        Move 0 to iDots
        Move 0 to iDigits
        For i from 1 to iLen
            Move (Mid(sArg, 1, i)) to sCh
            If (sCh >= "0" and sCh <= "9") Begin
                Increment iDigits
            End
            Else If (sCh = ".") Begin
                Increment iDots
            End
            Else If (sCh <> "-" or i > 1) Begin
                Move False to bNumeric
            End
        Loop
        If (bNumeric = True and iDigits > 0 and iDots <= 1) Begin
            If (iDots = 1) ;
                Function_Return "Number"
            Function_Return "Integer"
        End
        // A single bare identifier: resolve against the locals map.
        Get _NthWord sArg 2 to sSecond
        If (sSecond = "") Begin
            Move (SizeOfArray(asLocalNames) - 1) to iLast
            For i from 0 to iLast
                If (Lowercase(asLocalNames[i]) = sLow) ;
                    Function_Return asLocalTypes[i]
            Loop
        End
        Function_Return ""
    End_Function

    // Whole-file worker for AddFunctionReturnsKeyword: a Function declaration with no
    // 'Returns <type>' clause is a hard error 4392 on the modern compiler ("Missing keyword
    // returns on function declaration") - the wizard-era shells declare
    // 'Function Verify_Exit_Application' bare (the LegacyApp3 error wall, Nils 2026-07-10). The clause
    // is APPENDED with a type inferred from the body: every Function_Return argument is classified
    // by _ClassifyReturnArg and the results merge via _MergeReturnTypes; a body that gives nothing
    // to read (only bare Function_Return, or expression-only returns) gets Integer plus a review
    // TODO tag - ANY Returns type compiles where the bare declaration hard-fails, and the runtime
    // converts on the caller side. A ';'-continued declaration is joined for the Returns check and
    // the clause lands on the LAST physical line (a continuation often already carries it, so the
    // check must see the whole logical line). Declarations inside Object/Class bodies are included
    // on purpose - 4392 hits them all the same. Trailing comments survive. Limitation: DF23+
    // /* */ block comments are not tracked (same as _CodeOnlyLine) - legacy shells predate them.
    // Returns the number of declarations fixed.
    Function _TransformFunctionReturns String[] ByRef asCode Returns Integer
        String[] asLocalNames asLocalTypes
        String sLine sCodePart sWord sLow sJoined sType sArgType sComment sTok sTypeCanon sArg
        Integer iLine iSize iCount iDeclEnd iScan iWord iPos
        Boolean bMore bDefaulted bDecl

        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        Move 0 to iCount
        For iLine from 0 to iSize
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Get _CodeOnlyLine asCode[iLine] to sCodePart
            Get _IsFunctionDeclaration sCodePart to bDecl
            If (bDecl = True) Begin
                // Join a ';'-continued declaration into ONE logical line; iDeclEnd tracks the
                // last physical line - where a missing Returns clause must land.
                Move (Trim(sCodePart)) to sJoined
                Move iLine to iDeclEnd
                While (Right(sJoined, 1) = ";" and iDeclEnd < iSize)
                    Move (Trim(Left(sJoined, (Length(sJoined) - 1)))) to sJoined
                    Increment iDeclEnd
                    Get _CodeOnlyLine asCode[iDeclEnd] to sCodePart
                    Move (Trim(sJoined + " " + Trim(sCodePart))) to sJoined
                Loop
                If (_FindKeywordPos(Self, sJoined, "returns", True, 1) = 0) Begin
                    // Inference pass: walk the body to End_Function, mapping local declarations
                    // and classifying every Function_Return argument.
                    Move (ResizeArray(asLocalNames, 0)) to asLocalNames
                    Move (ResizeArray(asLocalTypes, 0)) to asLocalTypes
                    Move "" to sType
                    Move iDeclEnd to iScan
                    Move True to bMore
                    While (bMore = True and iScan < iSize)
                        Increment iScan
                        Get _CodeOnlyLine asCode[iScan] to sCodePart
                        Get _NthWord sCodePart 1 to sWord
                        Move (Lowercase(sWord)) to sLow
                        If (sLow = "end_function" or sLow = "function" or sLow = "procedure" or ;
                            sLow = "end_object" or sLow = "end_class") Begin
                            Move False to bMore
                        End
                        Else Begin
                            Get _LocalDeclType sWord to sTypeCanon
                            If (sTypeCanon <> "") Begin
                                // A local declaration: map every declared name to its type (an
                                // all-digit size token can never match a returned name - harmless).
                                Move 2 to iWord
                                Repeat
                                    Get _NthWord sCodePart iWord to sTok
                                    If (sTok <> "") Begin
                                        Move sTok       to asLocalNames[SizeOfArray(asLocalNames)]
                                        Move sTypeCanon to asLocalTypes[SizeOfArray(asLocalTypes)]
                                    End
                                    Increment iWord
                                Until (sTok = "")
                            End
                            If (sLow = "function_return") Begin
                                Get _FindKeywordPos sCodePart "function_return" True 1 to iPos
                                Move (Trim(Mid(sCodePart, (Length(sCodePart)), (iPos + 15)))) to sArg
                                If (sArg <> "") Begin
                                    Get _ClassifyReturnArg sArg asLocalNames asLocalTypes to sArgType
                                    Get _MergeReturnTypes sType sArgType to sType
                                End
                            End
                        End
                    Loop
                    Move False to bDefaulted
                    If (sType = "") Begin
                        Move "Integer" to sType
                        Move True to bDefaulted
                    End
                    // Append on the last physical declaration line, in front of a trailing comment
                    // (_CodeOnlyLine cut the line at the '//' - positions align, so the remainder
                    // of the ORIGINAL line is the comment).
                    Move asCode[iDeclEnd] to sLine
                    Get _CodeOnlyLine sLine to sCodePart
                    Move "" to sComment
                    If (Length(sCodePart) < Length(sLine)) ;
                        Move (Trim(Mid(sLine, (Length(sLine)), (Length(sCodePart) + 1)))) to sComment
                    Move (RTrim(Left(sLine, (Length(sCodePart))))) to sLine
                    Move (sLine + " Returns " + sType) to sLine
                    If (sComment <> "") ;
                        Move (sLine + "   " + sComment) to sLine
                    If (bDefaulted = True) ;
                        Move (sLine + "   // TODO (DFRefactor): return type could not be inferred - verify.") to sLine
                    Move sLine to asCode[iDeclEnd]
                    Increment iCount
                End
            End
        Loop
        Function_Return iCount
    End_Function

    // Whole-file worker for ChangeCmdlineCommandToFunction: the retired 'Cmdline <var>' command
    // read the NEXT space-delimited command-line argument on each call - SEQUENTIAL, so a
    // mechanical per-line swap to the modern indexed cCommandLine.Argument(i) is impossible
    // (the index depends on flow: the classic shape is a While loop). The conversion keeps the
    // sequential semantics via a tiny GENERATED shim: every 'Cmdline <var>' becomes
    // 'Move (NextCmdLineArgument()) to <var>', and ONE compat block (Use cCommandLine.pkg + a
    // global counter + the NextCmdLineArgument global function - '' past the last argument,
    // exactly the legacy end condition) is injected at the TOP of the file, #IFDEF-guarded and
    // text-idempotent (the 'get_NextCmdLineArgument' marker only occurs in the guard line).
    // File scope is required for the global function, and top-of-file guarantees it precedes
    // every function-style call site (compile-time rule). Only the exact 2-token command form
    // converts ('Cmdline sArg'); anything else (a length argument, a variable named Cmdline
    // mid-line) is left untouched. Returns converted lines (the injection is not counted).
    Function _TransformCmdlineCommands String[] ByRef asCode Returns Integer
        String[] asIns
        String sLine sCodePart sW1 sW2 sW3 sComment sIndent
        Integer iLine iSize iCount
        Boolean bFound

        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        Move 0 to iCount
        For iLine from 0 to iSize
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Get _CodeOnlyLine asCode[iLine] to sCodePart
            Get _NthWord sCodePart 1 to sW1
            If (Lowercase(sW1) = "cmdline") Begin
                Get _NthWord sCodePart 2 to sW2
                Get _NthWord sCodePart 3 to sW3
                // Exactly 'Cmdline <var>' - one destination, nothing after it.
                If (sW2 <> "" and sW3 = "") Begin
                    Move asCode[iLine] to sLine
                    Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                    Move "" to sComment
                    If (Length(sCodePart) < Length(sLine)) ;
                        Move (Trim(Mid(sLine, (Length(sLine)), (Length(sCodePart) + 1)))) to sComment
                    Move (sIndent + "Move (NextCmdLineArgument()) to " + sW2) to sLine
                    If (sComment <> "") ;
                        Move (sLine + "   " + sComment) to sLine
                    Move sLine to asCode[iLine]
                    Increment iCount
                End
            End
        Loop
        // Inject the compat block ONCE per file (top of file = file scope, before every caller).
        If (iCount > 0) Begin
            Get _LinesContainMarker (&asCode) "get_NextCmdLineArgument" to bFound
            If (bFound = False) Begin
                Move "// Legacy Cmdline compatibility (generated by DFRefactor): NextCmdLineArgument() returns"  to asIns[0]
                Move "// the NEXT space-delimited command-line argument on each call - the retired Cmdline"     to asIns[1]
                Move "// command's sequential semantics - via the framework's cCommandLine ('' past the last)." to asIns[2]
                Move "#IFDEF get_NextCmdLineArgument"                                                            to asIns[3]
                Move "#ELSE"                                                                                     to asIns[4]
                Move "Use cCommandLine.pkg"                                                                      to asIns[5]
                Move "Global_Variable Integer giNextCmdLineArgNo"                                                to asIns[6]
                Move "Global_Variable Handle ghoNextCmdLineArgObj"                                               to asIns[7]
                Move "Function NextCmdLineArgument Global Returns String"                                        to asIns[8]
                Move "    String sArg"                                                                           to asIns[9]
                Move "    If (ghoNextCmdLineArgObj = 0) ;"                                                       to asIns[10]
                Move "        Get Create of Desktop (RefClass(cCommandLine)) to ghoNextCmdLineArgObj"            to asIns[11]
                Move "    Move (giNextCmdLineArgNo + 1) to giNextCmdLineArgNo"                                   to asIns[12]
                Move "    Get Argument of ghoNextCmdLineArgObj giNextCmdLineArgNo to sArg"                       to asIns[13]
                Move "    Function_Return sArg"                                                                  to asIns[14]
                Move "End_Function"                                                                              to asIns[15]
                Move "#ENDIF"                                                                                    to asIns[16]
                Move ""                                                                                          to asIns[17]
                Send _InsertLinesBefore (&asCode) 0 asIns
            End
        End
        Function_Return iCount
    End_Function

    // Raw substring probe over every line - the idempotence check for generated blocks. The
    // marker must be a string that only the generated block carries (here the '#IFDEF get_...'
    // guard symbol - the call sites use the bare function name, without the get_ prefix).
    Function _LinesContainMarker String[] ByRef asLines String sMarker Returns Boolean
        Integer i iLast
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (asLines[i] contains sMarker) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Map one legacy Workspace path-property name (the retired Workspc.pkg family, read via
    // 'Get <name> of ghoWorkspace') to its modern cWorkspace property - "" = no clean 1:1, the
    // caller leaves the line alone (CurrentWorkSpaceName / CurrentModuleName /
    // CurrentWorkspaceDescription / OriginalDfPath have no direct modern equivalent). The pairs are
    // verified 1:1 against the DF25 cWorkspace.pkg properties (Nils 2026-07-10, the LegacyApp3 error
    // wall: ~270 such reads across the workspace, all dead on a modern target - ghoWorkspace and
    // the Current* properties both left with Workspc.pkg).
    Function _ModernWorkspacePathProperty String sLegacy Returns String
        Move (Lowercase(Trim(sLegacy))) to sLegacy
        If (sLegacy = "currentdatapath") ;
            Function_Return "psDataPath"
        If (sLegacy = "currentprogrampath") ;
            Function_Return "psProgramPath"
        If (sLegacy = "currentbitmappath") ;
            Function_Return "psBitmapPath"
        If (sLegacy = "currenthelppath") ;
            Function_Return "psHelpPath"
        If (sLegacy = "currentappsrcpath") ;
            Function_Return "psAppSrcPath"
        If (sLegacy = "currentddsrcpath") ;
            Function_Return "psDdSrcPath"
        If (sLegacy = "currentsystemdfpath") ;
            Function_Return "psSystemDfPath"
        If (sLegacy = "currentdfpath") ;
            Function_Return "psDfPath"
        If (sLegacy = "currentfilelistpath") ;
            Function_Return "psFileList"
        Function_Return ""
    End_Function

    // True when sTokLow (lowercased) CONTINUES a condition rather than starting the statement after it:
    // a legacy comparison word, the legacy in/match/contains, and/or, or a modern operator symbol. The one
    // list for both IfNot paths - a negation that wraps only the operand in front of one of these rips the
    // condition apart ('If (Not(A)) in B' read as a valid If to ChangeInToContains, 2026-09-07).
    Function _IsIfConditionContinuation String sTokLow Returns Boolean
        Function_Return (sTokLow = "eq" or sTokLow = "ne" or sTokLow = "gt" or sTokLow = "lt" or sTokLow = "ge" or sTokLow = "le" or ;
                         sTokLow = "in" or sTokLow = "match" or sTokLow = "matches" or sTokLow = "contains" or sTokLow = "and" or sTokLow = "or" or ;
                         sTokLow = "=" or sTokLow = "<" or sTokLow = ">" or sTokLow = "<=" or sTokLow = ">=" or sTokLow = "<>" or ;
                         sTokLow = "+" or sTokLow = "-" or sTokLow = "*" or sTokLow = "/")
    End_Function

    /* A legacy CONDITION COMMAND that takes an argument, so the word alone is no operand: 'Status
       <file>' tests whether the file's buffer holds an active record (obsolete; DF_FILE_STATUS or a
       DataDictionary's HasRecord is the modern read). Both If-Not paths wrapped the word and left the
       argument outside - 'If (Not(Status)) ArAccnt Function_Return ...' - which does not compile
       (Nils 2026-09-19, a 2005-era workspace). Neither path can express it on one line without a
       declared variable, so both decline; the Deep Scan 'Status component' rule carries the Explain.
       Found / FindErr / SeqEof / Err take no argument and stay convertible. */
    Function _IsLegacyFileTestCommand String sTokLow Returns Boolean
        Function_Return (sTokLow = "status")
    End_Function

    // The TWO-WORD legacy negation: 'If Not <operand> ...' - the command-style If with NOT outside
    // the parens (Nils's LegacyApp3 find 2026-07-10: 'If Not (Found) Begin'). The one-word IFNOT is
    // handled by ChangeIfNotCommandToExpression's own path, which falls through to here when IFNOT
    // is absent. Converts the SAFE single-operand subset to 'If (Not(<operand>)) ...':
    //   - the command position must be If (one leading Else is allowed: 'Else If Not x ...');
    //   - the operand is exactly ONE token: a bare name ('Found') or a parenthesized group - the
    //     tokenizer extracts a whole (expression) as one token even with spaces inside, so
    //     'If Not (iA = iB) Begin' converts too. A redundant outer paren pair is folded into the
    //     Not(...) wrap: 'If Not (Found)' -> 'If (Not(Found))', never a double-wrap;
    //   - the token AFTER the operand must not continue the condition (legacy eq/ne/gt/lt/ge/le,
    //     in/match/contains, and/or, or a modern operator): a single-operand wrap would rip
    //     'If Not a eq b' apart, so those bail untouched;
    //   - a '[bracket]' operand bails - the indicator converters own bracket lines;
    //   - a trailing-';' continuation line CONVERTS (the wrap is local to this line - the ';'
    //     and next-line Begin stay valid): the lexer holds the ';' outside the token list, so
    //     the rebuild re-appends it. 'If NOT (Found) ;' / 'Begin' is the LegacyApp3 house style and
    //     survived the first Deep Scan fix-plan run as the biggest auto-fix leftover
    //     (AL_FUNC2.PKG ln 1380, Nils 2026-07-10).
    // The tail (Begin / an inline statement) is re-emitted token-by-token like the IFNOT path; a
    // trailing // comment is preserved. Returns True when the line changed.
    Function _ChangeIfNotPairToExpression String ByRef sLine Returns Boolean
        tTokenizer TokenizerData
        String sCode sOperand sNext sCore sCh
        Integer iIf iSize iCount iDepth
        Boolean bEndSemi

        Get pTokenizer to TokenizerData
        If (LineIsNotCode(&TokenizerData)) Function_Return False
        Move TokenizerData.bHasEndSemiColon to bEndSemi
        Move (TokenizerData.iTokenCount) to iSize
        Move 0 to iIf
        If (iSize > 0 and Lowercase(TokenizerData.asLineTokens[0]) = "else") ;
            Move 1 to iIf
        If (iSize < iIf + 3) ;
            Function_Return False
        If (Lowercase(TokenizerData.asLineTokens[iIf]) <> "if" or Lowercase(TokenizerData.asLineTokens[iIf + 1]) <> "not") ;
            Function_Return False
        Move TokenizerData.asLineTokens[iIf + 2] to sOperand
        If (sOperand = "" or Left(sOperand, 1) = "[") ;
            Function_Return False
        // A parenthesized operand: fold the redundant OUTER pair into the wrap - but only when that
        // pair encloses the whole token ('(a)(b)' keeps its outers; the inner scan proves it).
        Move sOperand to sCore
        If (Left(sOperand, 1) <> "(") Begin
            // A BARE operand must be a single word. The expression parser GLUES a legacy comparison
            // triple into one token ('If Not sName eq "X"' arrives as operand 'sName eq "X"'), and
            // wrapping that would emit a legacy operator inside a fresh expression - house rule is
            // to modernize operators when composing (cf. _ComposeIfCondIndicate), so the glued form
            // bails here; once ChangeLegacyOperators has parenthesized it, a later pass converts it.
            If (Pos(" ", sOperand) > 0 or Pos(Character(9), sOperand) > 0) ;
                Function_Return False
            // ...and not a legacy test command that takes an argument ('If Not Status <file> stmt').
            If (_IsLegacyFileTestCommand(Self, Lowercase(sOperand))) ;
                Function_Return False
        End
        If (Left(sOperand, 1) = "(") Begin
            If (Right(sOperand, 1) <> ")") ;
                Function_Return False
            // The parens must be USER-WRITTEN: the expression parser NORMALIZES a glued legacy
            // comparison triple into a parenthesized token ('If Not sName eq "X"' arrives as
            // '(sName eq "X")' even though the source has no parens). A fabricated token never
            // appears verbatim in the original line - bail on those (once ChangeLegacyOperators has
            // really parenthesized the condition, a later pass converts it).
            If (Pos(sOperand, sLine) = 0) ;
                Function_Return False
            Move (Mid(sOperand, (Length(sOperand) - 2), 2)) to sCore
            Move 0 to iDepth
            For iCount from 1 to (Length(sCore))
                Move (Mid(sCore, 1, iCount)) to sCh
                If (sCh = "(") ;
                    Increment iDepth
                If (sCh = ")") ;
                    Decrement iDepth
                If (iDepth < 0) ;
                    Function_Return False
            Loop
            If (iDepth <> 0) ;
                Function_Return False
        End
        // The token after the operand must START the statement, never continue the condition.
        If (iSize > iIf + 3) Begin
            Move (Lowercase(TokenizerData.asLineTokens[iIf + 3])) to sNext
            If (_IsIfConditionContinuation(Self, sNext)) ;
                Function_Return False
        End
        // Rebuild: indent + [Else] + If (Not(core)) + the tail tokens + any trailing comment.
        Move TokenizerData.sIndentation to sCode
        If (iIf = 1) ;
            Move (sCode + TokenizerData.asLineTokens[0] + CS_S) to sCode
        Move (sCode + CS_If * "(" + CS_Not + "(" + sCore + "))") to sCode
        Decrement iSize
        For iCount from (iIf + 3) to iSize
            Move (sCode * TokenizerData.asLineTokens[iCount]) to sCode
        Loop
        // A trailing-';' continuation rides along. The lexer USUALLY delivers it as the last
        // token (the tail loop above then re-emitted it already - appending again doubled it,
        // caught by the fixture) - the append below is only the belt for a token list that
        // arrives without it.
        If (bEndSemi = True and Right(sCode, 1) <> ";") ;
            Move (sCode * ";") to sCode
        If (TokenizerData.sEndComment <> "") ;
            Move (sCode * TokenizerData.sEndComment) to sCode
        Move (RTrim(sCode)) to sCode
        If (sCode <> sLine) Begin
            Move sCode to sLine
            Function_Return True
        End
        Function_Return False
    End_Function

    // Swap a LEADING command keyword (the first word on a code line) for another, preserving the indentation and
    // everything after the keyword. Whole-token, case-insensitive: the old keyword must be followed by whitespace
    // or end-of-line, so 'System' never matches 'System_State' and a mid-line use is left alone. Skips comment /
    // macro-body / image lines. Returns True + rewrites sLine when swapped. Thin {Published} wrappers use it for
    // obsolete-command renames (System -> Abort, External_Function32 -> External_Function, ...).
    Function _SwapLeadingCommandKeyword String ByRef sLine tTokenizer TokenizerData String sOld String sNew Returns Boolean
        String sTrim sIndent sAfterKw sNextChar
        Integer iOldLen iIndentLen

        If (TokenizerData.bLineIsReady = True or TokenizerData.bIsComment = True or ;
            TokenizerData.bIsInCommand = True or TokenizerData.bIsInImage = True) ;
            Function_Return False
        Move (Length(sLine) - Length(LTrim(sLine))) to iIndentLen
        Move (Left(sLine, iIndentLen)) to sIndent
        Move (LTrim(sLine)) to sTrim
        Move (Length(sOld)) to iOldLen
        If (Lowercase(Left(sTrim, iOldLen)) <> Lowercase(sOld)) ;
            Function_Return False
        If (Length(sTrim) > iOldLen) Begin
            Move (Mid(sTrim, 1, (iOldLen + 1))) to sNextChar   // char right after the keyword
            If (sNextChar <> " " and sNextChar <> (Character(9))) ;
                Function_Return False
        End
        Move (Mid(sTrim, (Length(sTrim) - iOldLen), (iOldLen + 1))) to sAfterKw   // everything after the keyword
        Move (sIndent + sNew + sAfterKw) to sLine
        Function_Return True
    End_Function

    // The base class named by a lowercased, trimmed declaration line - the token after ' is a ' / ' is an ' -
    // or "" when the line declares nothing that way.
    Function _DeclBaseToken String sLow Returns String
        Integer iPos iArt iEnd
        String sRest

        Move (Pos(" is a ", sLow)) to iPos
        Move 6 to iArt
        If (iPos = 0) Begin
            Move (Pos(" is an ", sLow)) to iPos
            Move 7 to iArt
        End
        If (iPos = 0) ;
            Function_Return ""
        Move (Trim(Mid(sLow, (Length(sLow)), (iPos + iArt)))) to sRest
        Move (Pos(" ", sRest)) to iEnd
        If (iEnd > 0) ;
            Move (Left(sRest, (iEnd - 1))) to sRest
        Function_Return (Trim(sRest))
    End_Function

    /* THE EDIT-FAMILY ENTRY the two published converters share (2026-09-07). Parses the 'Old,New' parameter
       (empty = the defaults), runs the transformer, and gives an EMPTY parameter the grid converters' reach
       over the subclasses the last Check learned - the edit way round: an object of such a subclass is left
       alone and FOLLOWS its class, whose 'Class <sub> is a <legacy>' line the plain pair converts in the file
       that declares it (the scan's subclass row brings that file into the plan). Two run notes make that
       visible: how many objects in this file follow their class, and - when this file already declares a
       sibling on the modern base - that the objects could move to the sibling and the legacy subclass
       retire (a workspace had twins of both, 2026-09-07). */
    Function _ConvertEditFamily String[] ByRef asCode String sParameter String sDefaultOld String sDefaultNew String sRootToken String sFnName Returns Integer
        String[] asParts asSubs asSiblings asCands
        String sOld sNew sLow sBase sName sFile sSibs
        Integer iRetval i iLast iFollow iSlash
        Boolean bEmpty

        Move sDefaultOld to sOld
        Move sDefaultNew to sNew
        Move True to bEmpty
        If (Trim(sParameter) contains ",") Begin
            Move False to bEmpty
            Move (StrSplitToArray(sParameter, ",")) to asParts
            If (SizeOfArray(asParts) >= 2) Begin
                If (Trim(asParts[0]) <> "") ;
                    Move (Trim(asParts[0])) to sOld
                If (Trim(asParts[1]) <> "") ;
                    Move (Trim(asParts[1])) to sNew
            End
        End
        If (bEmpty = True) ;
            Get LearnedSubclassesOf sRootToken to asSubs

        // Before the transform: the siblings already on the modern base, the subclasses declared here on
        // the legacy one, and the objects that follow a learned subclass.
        Move (SizeOfArray(asCode) - 1) to iLast
        Move 0 to iFollow
        For i from 0 to iLast
            Move (Lowercase(Trim(asCode[i]))) to sLow
            Get _DeclBaseToken sLow to sBase
            If (sBase <> "") Begin
                If (Left(sLow, 6) = "class ") Begin
                    If (sBase = Lowercase(sNew)) ;
                        Get _NthWord (Trim(asCode[i])) 2 to asSiblings[SizeOfArray(asSiblings)]
                    If (sBase = Lowercase(sOld)) ;
                        Get _NthWord (Trim(asCode[i])) 2 to asCands[SizeOfArray(asCands)]
                End
                Else If (Left(sLow, 7) = "object " and SizeOfArray(asSubs) > 0) Begin
                    If (SearchArray(sBase, asSubs) <> -1) ;
                        Increment iFollow
                End
            End
        Loop

        Get _TransformEditToTextEdit (&asCode) sOld sNew to iRetval

        // The notes, printed under this converter's own summary line.
        Move "" to sFile
        If (ghoEngine <> 0) Begin
            Get psCurrentSourceFileName of ghoEngine to sFile
            Move (Length(sFile)) to iSlash
            While (iSlash > 0 and Mid(sFile, 1, iSlash) <> Character(92) and Mid(sFile, 1, iSlash) <> "/")
                Decrement iSlash
            Loop
            If (iSlash > 0) ;
                Move (Mid(sFile, (Length(sFile) - iSlash), (iSlash + 1))) to sFile
        End
        If (Trim(sFile) <> "") ;
            Move (Trim(sFile) + ": ") to sFile
        If (iFollow > 0) ;
            Send AddRunNote sFnName (sFile + String(iFollow) + " object(s) of a workspace subclass of " + sOld + " follow their class - its base line converts in the file that declares it (the plan's subclass row).")
        If (iRetval > 0 and SizeOfArray(asSiblings) > 0 and SizeOfArray(asCands) > 0) Begin
            Move "" to sSibs
            For i from 0 to (SizeOfArray(asSiblings) - 1)
                Move (sSibs + (If(sSibs = "", "", ", ")) + asSiblings[i]) to sSibs
            Loop
            For i from 0 to (SizeOfArray(asCands) - 1)
                Move asCands[i] to sName
                Send AddRunNote sFnName (sFile + sName + " now derives from " + sNew + "; " + sSibs + " already did - consider moving " + sName + "'s objects to it and retiring " + sName + ".")
            Loop
        End
        Function_Return iRetval
    End_Function

    // Whole-file worker for the Edit->cTextEdit / dbEdit->cDbTextEdit converters (RefactorEditTocTextEdit /
    // RefactorDbEditTocDbTextEdit). NOT a pure class swap (Nils 2026-07-03, verified against docs.dataflex.dev
    // + the DF26 packages): the lineages differ (dbEdit <- Edit <- DfBaseEdit vs cDbTextEdit <- cTextEdit <-
    // DFBaseTextEdit). What this does:
    //   1. Swaps <sOld> for <sNew> on BOTH declaration forms - "Object <name> is a <sOld>" AND
    //      "Class <name> is a <sOld>" - so a user SUBCLASS ('Class dbEdit0 is a dbEdit', LegacyApp) gets its
    //      BASE modernised while its objects keep the subclass name. Whole-token, case-insensitive; the
    //      object/class NAME is never touched.
    //   2. INSIDE the converted block only (depth-tracked to its matching End_Object/End_Class):
    //      Set Wrap_State -> Set pbWrap (the modern name on DFBaseTextEdit), and the legacy properties with
    //      NO modern equivalent (Horizontal/Vertical_Scroll_Bar_Visible_State, Capslock_State,
    //      Physical_Wrap_State) get a "// TODO (DFRefactor)" tag appended - flagged, never removed.
    //   The SHARED surface passes through untouched: Entry_Item, Server, Size/Location, the Label family,
    //   Enabled_State, Read_Only_State, Value, Line_Count, peAnchors, Status_Help, verify_*_msg (DEO mixins).
    //   3. A converted 'Class <sub> is a' gets its target's Use even in a file with no Use at all, the same rule as
    //      _TransformWinReportToWinReport2. _EnsureUsePackage takes such a file for a fragment and adds nothing, but a
    //      package that declares a class needs its base class where it stands. An Object in such a file stays a
    //      fragment. A program that starts with DFAllEnt.pkg hides this, because that package brings both targets
    //      along; without it, two real packages stopped on U_CTEXTEDIT and U_CDBTEXTEDIT (2026-11-05).
    // Comment lines are skipped; idempotent (sNew never token-matches sOld; a TODO-tagged line is not
    // re-tagged). Returns the number of declarations converted.
    Function _TransformEditToTextEdit String[] ByRef asCode String sOld String sNew Returns Integer
        String[] asDeadProps
        String sLine sLowTrim sLowFull sRest sTok sOldLow sProp
        Integer iLine iSize iCount iDepth iPos iEnd iProp iDeadLast iArt
        Boolean bInside bOpener bCloser bClass

        // This converter counts DECLARATIONS converted, not lines - its summary line says so.
        Send SetSummaryUnit (psExecutionContext(Self)) "declaration(s)"
        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        Move (Lowercase(sOld)) to sOldLow
        // Legacy Edit-family properties with NO cTextEdit/DFBaseTextEdit equivalent - tag, don't touch.
        Move "horizontal_scroll_bar_visible_state" to asDeadProps[0]
        Move "vertical_scroll_bar_visible_state"   to asDeadProps[1]
        Move "capslock_state"                      to asDeadProps[2]
        Move "physical_wrap_state"                 to asDeadProps[3]
        // The plain form too (2026-09-07): cTextEdit has none of the three, and the plain one rode through
        // untagged - four objects and a subclass set it in one workspace.
        Move "scroll_bar_visible_state"            to asDeadProps[4]
        Move (SizeOfArray(asDeadProps) - 1) to iDeadLast
        Move 0 to iCount
        Move False to bInside
        Move False to bClass
        Move 0 to iDepth
        For iLine from 0 to iSize
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Move asCode[iLine] to sLine
            // Tab-normalised detection copy: Trim strips only SPACES, and LegacyApp has tab-indented
            // declarations (Redb0211.vw 'Object ... Is A edit') that would otherwise be missed. All
            // SPLICE positions are computed on the untouched sLine, so the normalisation is read-only.
            Move (Lowercase(Trim(Replaces(Character(9), sLine, " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//") Begin
                Move (Left(sLowTrim, 7) = "object " or Left(sLowTrim, 6) = "class ") to bOpener
                Move (Left(sLowTrim, 10) = "end_object" or Left(sLowTrim, 9) = "end_class") to bCloser
                // Declaration swap (any depth): "... is a <sOld>" -> "... is a <sNew>", whole token.
                // Legacy DataFlex accepts BOTH articles - "is a" AND "is an" ("Object text_formatter
                // is an edit", WinServ 2026-07-17; natural English for a vowel-initial class) - and
                // the Deep Scan class rule matches either, so the converter must too (grid==fix).
                // The splice keeps the article's original casing ("Is A" stays "Is A") and drops the
                // "an" form's n - every target class is consonant-initial, so "is a cTextEdit".
                If (bOpener = True) Begin
                    Move (Lowercase(sLine)) to sLowFull
                    Move (Pos(" is a ", sLowFull)) to iPos
                    Move 6 to iArt
                    If (iPos = 0) Begin
                        Move (Pos(" is an ", sLowFull)) to iPos
                        Move 7 to iArt
                    End
                    If (iPos > 0) Begin
                        Move (Mid(sLine, (Length(sLine)), (iPos + iArt))) to sRest
                        Move (Pos(" ", sRest)) to iEnd
                        If (iEnd > 0) Begin
                            Move (Left(sRest, (iEnd - 1))) to sTok
                        End
                        Else Begin
                            Move sRest to sTok
                        End
                        Move (Trim(sTok)) to sTok
                        If (Lowercase(sTok) = sOldLow) Begin
                            Move (Left(sLine, (iPos + 4)) + " " + sNew + Mid(sLine, (Length(sLine)), (iPos + iArt + Length(sTok)))) to sLine
                            Increment iCount
                            If (Left(sLowTrim, 6) = "class ") ;
                                Move True to bClass
                            If (bInside = False) Begin
                                Move True to bInside
                                Move 0 to iDepth   // the opener bookkeeping below makes it 1
                            End
                        End
                    End
                End
                If (bInside = True) Begin
                    // Depth bookkeeping so a nested child object's End_Object does not end OUR block.
                    If (bOpener = True) Begin
                        Increment iDepth
                    End
                    If (bCloser = True) Begin
                        Decrement iDepth
                        If (iDepth <= 0) ;
                            Move False to bInside
                    End
                    // Property translation inside the converted block.
                    If (Left(sLowTrim, 15) = "set wrap_state ") Begin
                        Move (Pos("wrap_state", Lowercase(sLine))) to iPos
                        Move (Left(sLine, (iPos - 1)) + "pbWrap" + Mid(sLine, (Length(sLine)), (iPos + 10))) to sLine
                    End
                    Else Begin
                        For iProp from 0 to iDeadLast
                            Move asDeadProps[iProp] to sProp
                            If (Left(sLowTrim, (Length(sProp) + 5)) = ("set " + sProp + " ")) Begin
                                If (not(sLine contains "TODO (DFRefactor)")) ;
                                    Move (sLine + "  // TODO (DFRefactor): no cTextEdit equivalent - review.") to sLine
                            End
                        Loop
                    End
                End
                Move sLine to asCode[iLine]
            End
        Loop
        // Fix up the Use statements the class swap depends on: files with the obsolete Edit / dbEdit controls
        // often carry a legacy 'Use Dftxtwin.pkg' (itself an OBSOLETE package - warning 4536), but their modern
        // targets live in their OWN packages (cTextEdit.pkg / cDbTextEdit.pkg) and are NOT reachable via
        // Windows.pkg (verified against the DF26 Pkg, Nils 2026-07-07). _EnsureUsePackage retires the obsolete
        // Dftxtwin Use AND guarantees the target package: swap-in-place if Dftxtwin is present, append if neither
        // is (only on a real conversion, iCount>0 - never a spurious Use), drop Dftxtwin if the target is already
        // Used. Standard targets only (a custom subclass's package is unknown). Runs regardless of iCount so a
        // manual re-run also retires a Dftxtwin Use an earlier class-only pass left behind. (Nils 2026-07-06/07.)
        If (Lowercase(Trim(sNew)) = "ctextedit") Begin
            Send _EnsureUsePackage (&asCode) "dftxtwin.pkg" "cTextEdit.pkg" (iCount > 0)
            If (bClass = True) ;
                Send _EnsureUseForNewDependency (&asCode) "cTextEdit.pkg"
        End
        If (Lowercase(Trim(sNew)) = "cdbtextedit") Begin
            Send _EnsureUsePackage (&asCode) "dftxtwin.pkg" "cDbTextEdit.pkg" (iCount > 0)
            If (bClass = True) ;
                Send _EnsureUseForNewDependency (&asCode) "cDbTextEdit.pkg"
        End
        Function_Return iCount
    End_Function

    /* THE RUN'S CLASS -> PACKAGE INDEX, built once per run (memoised on phoClassPkgIndex / psClassPkgIndexKey,
       destroyed by _InitializeFuncLib): the target install's Pkg folder plus the SELECTED source folders -
       the engine's own scope, which AllSourceFolders has already stripped of backup and non-source folders
       (2026-07-31). Lifted out of MakeFileAutonomous 2026-09-05 so the grid converters can ask it the same
       question from the other side (_ClassesDeclaredInPackage). */
    Function _RunClassPackageIndex Returns Handle
        String[] asExtra
        String sInstallPkg sKey
        Handle hoIdx
        Integer iMax

        Get psTargetPkgFolder of ghoApplication to sInstallPkg
        Get pasSelectedFolders of ghoApplication to asExtra
        If (SizeOfArray(asExtra) = 0) ;
            Get WholeWorkspaceSourceFolders of ghoApplication to asExtra
        Move (Lowercase(sInstallPkg) + "|" + String(SizeOfArray(asExtra))) to sKey
        If (SizeOfArray(asExtra) > 0) ;
            Move (sKey + "|" + Lowercase(asExtra[0])) to sKey
        Get phoClassPkgIndex to hoIdx
        If (hoIdx = 0 or psClassPkgIndexKey(Self) <> sKey) Begin
            If (hoIdx <> 0) ;
                Send Destroy of hoIdx
            Get Create (RefClass(cClassPackageIndex)) to hoIdx
            Get BuildIndex of hoIdx sInstallPkg (&asExtra) to iMax
            Set phoClassPkgIndex   to hoIdx
            Set psClassPkgIndexKey to sKey
        End
        Function_Return hoIdx
    End_Function

    // Every class one package file defines, per the run's index (UPPERCASE); empty when unknown.
    Function _ClassesDeclaredInPackage String sPkgLeaf Returns String[]
        String[] asOut
        Handle hoIdx

        Get _RunClassPackageIndex to hoIdx
        If (hoIdx <> 0) ;
            Get ClassesInPackage of hoIdx sPkgLeaf to asOut
        Function_Return asOut
    End_Function

    /* The classes a retire-able legacy package provides - the dependency a Use swap must not break.
       Small and explicit ON PURPOSE: only packages a converter actually retires appear here, and the
       names are read off the TARGET DataFlex's own Pkg source (verified 2026-07-26 against DF25:
       Dftxtwin.pkg declares dbEdit_, dbEditDS and dbEdit; cTextEdit.pkg declares none of them).
       An unknown package returns an empty list, so _EnsureUsePackage keeps its previous behaviour
       for anything not listed here. Add a package here when a converter starts retiring it. */
    Function _ClassesProvidedByPackage String sPkg Returns String[]
        String[] asOut
        String sLC

        Move (Lowercase(Trim(sPkg))) to sLC
        If (sLC = "dftxtwin.pkg") Begin
            Move "dbEdit"    to asOut[0]
            Move "dbEditDS"  to asOut[1]
            Move "dbEdit_"   to asOut[2]
        End
        // The two dedicated grid/list packages the cGridToCJGridBase converters retire (2026-08-10).
        // Read off the DF25 Pkg source. Dfsellst.pkg is the one that earns this guard: besides dbList
        // it also declares dbListRow and the search dialog/form, none of which any converter rewrites.
        If (sLC = "dftable.pkg") Begin
            Move "dbGrid"    to asOut[0]
            Move "dbGridDD"  to asOut[1]
            Move "dbGridDS"  to asOut[2]
            Move "dbGrid_"   to asOut[3]
        End
        If (sLC = "dfsellst.pkg") Begin
            Move "dbList"             to asOut[0]
            Move "dbListDS"           to asOut[1]
            Move "dbList_"            to asOut[2]
            Move "dbListRow"          to asOut[3]
            Move "dbListSearchDialog" to asOut[4]
            Move "dbListSearchForm"   to asOut[5]
        End
        Function_Return asOut
    End_Function

    // True when the file still NAMES any of asClasses as a whole word in real code - an Object or Class
    // declaration, an Import_Class_Protocol, a RefClass, anywhere. Comments and string literals are
    // masked first (_CodeOnlyLine), so a class name mentioned in prose never counts. Deliberately broader
    // than "is a <class>": the line that broke LegacyApp was an Import_Class_Protocol, which no converter
    // rewrites and no declaration-shaped test would have seen.
    Function _CodeNamesAnyClass String[] ByRef asCode String[] asClasses Returns Boolean
        String  sCode
        Integer i iLast j iNames

        Move (SizeOfArray(asClasses) - 1) to iNames
        If (iNames < 0) ;
            Function_Return False
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asCode[i] to sCode
            If (Trim(sCode) <> "") Begin
                For j from 0 to iNames
                    If (_FindKeywordPos(Self, sCode, asClasses[j], True, 1) > 0) ;
                        Function_Return True
                Loop
            End
        Loop
        Function_Return False
    End_Function

    // Ensure the source depends on <sTargetPkg> after a class-swap converter changes a class whose defining
    // package moved. Three cases, in order: (a) BOTH the obsolete <sLegacyPkg> and the target are Used -> drop
    // the obsolete Use (the target already covers it); (b) ONLY the legacy Use is present -> swap it in place
    // for the target (retires the obsolete-package warning 4536); (c) NEITHER is present AND bAppendIfAbsent ->
    // append 'Use <sTargetPkg>' after the file's leading Use block (a fresh conversion genuinely needs it -
    // without this, a file that took the obsolete class straight from Windows.pkg would be left with an
    // undefined target class). Idempotent: once the target is present and the legacy gone, a re-run no-ops. A
    // file with no leading Use block at all (a synthetic test fragment) is left alone, never sprouting a lone
    // Use. Case-insensitive on the keyword + package; a trailing // comment on a Use line is ignored.
    Procedure _EnsureUsePackage String[] ByRef asCode String sLegacyPkg String sTargetPkg Boolean bAppendIfAbsent
        Integer iLine iSize iPos iLegacyIdx iLastUse iOut iUseDepth
        Boolean bUseInBlock
        String sLine sLowTrim sPkg sIndent sTrim sLegLow sTgtLow
        String[] asNew asLegacyClasses
        Boolean bTargetPresent bSeenCode bStillNeeded

        /* NEVER retire a package the file STILL DEPENDS ON (Nils 2026-07-26 - this cost a whole
           388-error run). RefactorEditTocTextEdit swapped 'Use Dftxtwin.pkg' for 'Use cTextEdit.pkg'
           in LegacyApp's VDFTranslator.pkg - correct for the converted Edit objects, except that the
           same file still names dbEdit on an
               Import_Class_Protocol ExtensionClass dbEdit KeyAction_On_Key
           line, which no converter rewrites. Dftxtwin.pkg is where dbEdit / dbEditDS / dbEdit_ live,
           so dropping it left 'Undefined class DBEDIT' (4328) in the file that defines this
           workspace's whole cTr* class family - and everything downstream fell over behind it.
           A converter may retire a Use only when nothing of that package is left in the file. */
        Get _ClassesProvidedByPackage sLegacyPkg to asLegacyClasses
        Get _CodeNamesAnyClass (&asCode) asLegacyClasses to bStillNeeded
        Move (Lowercase(Trim(sLegacyPkg))) to sLegLow
        Move (Lowercase(Trim(sTargetPkg))) to sTgtLow
        Move -1    to iLegacyIdx
        Move -1    to iLastUse
        Move False to bTargetPresent
        Move False to bSeenCode
        Move (SizeOfArray(asCode) - 1) to iSize
        For iLine from 0 to iSize
            Move asCode[iLine] to sLine
            Move (Lowercase(Trim(sLine))) to sLowTrim
            If (bSeenCode = False) ;
                Send rfUseAnchorStep sLine iLine (&iUseDepth) (&bUseInBlock) (&iLastUse)
            If (Left(sLowTrim, 4) = "use ") Begin
                // Package = first token after 'Use '; drop any trailing comment.
                Move (Trim(Mid(sLowTrim, Length(sLowTrim), 5))) to sPkg
                Move (Pos(" ", sPkg)) to iPos
                If (iPos > 0) ;
                    Move (Left(sPkg, (iPos - 1))) to sPkg
                If (sPkg = sTgtLow) ;
                    Move True to bTargetPresent
                If (sPkg = sLegLow and iLegacyIdx = -1) ;
                    Move iLine to iLegacyIdx
            End
            Else If (bSeenCode = False) Begin
                // First real code line ends the leading Use block (skip blanks, //, /* and # lines).
                Move (Trim(sLine)) to sTrim
                If (sTrim <> "" and Left(sTrim, 2) <> "//" and Left(sTrim, 2) <> "/*" and Left(sTrim, 1) <> "#") ;
                    Move True to bSeenCode
            End
        Loop

        // STILL NEEDED -> the legacy Use stays. Only guarantee the target is present (append it after
        // the leading Use block when absent); never swap, never drop. Both packages Used together is
        // correct and compiles - the file genuinely depends on both.
        If (bStillNeeded = True) Begin
            If (bTargetPresent = True or iLastUse < 0) ;
                Procedure_Return
            If (bAppendIfAbsent = False) ;
                Procedure_Return
            Move 0 to iOut
            For iLine from 0 to iSize
                Move asCode[iLine] to asNew[iOut]
                Increment iOut
                If (iLine = iLastUse) Begin
                    // _LineIndent (cRefactorUtilities), NOT GetIndent - that one lives on
                    // cGridToCJGridBase, which this class does not descend from, so the Get went
                    // unanswered and died as a runtime Error 98 the compiler could not see.
                    Get _LineIndent asCode[iLine] to sIndent
                    Move (sIndent + "Use " + sTargetPkg) to asNew[iOut]
                    Increment iOut
                End
            Loop
            Move asNew to asCode
            Procedure_Return
        End
        // (a) Both present: drop the obsolete legacy Use (rebuild without that one line).
        If (iLegacyIdx >= 0 and bTargetPresent = True) Begin
            Move 0 to iOut
            For iLine from 0 to iSize
                If (iLine <> iLegacyIdx) Begin
                    Move asCode[iLine] to asNew[iOut]
                    Increment iOut
                End
            Loop
            Move asNew to asCode
            Procedure_Return
        End
        // (b) Only legacy present: swap it in place for the target (indentation preserved).
        If (iLegacyIdx >= 0) Begin
            // Was a third open-coded spelling of "the indent of this line" (a Pos(Trim(...)) search)
            // three branches from the Get that faulted. Same helper now - the answer is identical
            // for a Use line, and one home means the next caller cannot invent a fourth.
            Get _LineIndent asCode[iLegacyIdx] to sIndent
            Move (sIndent + "Use " + sTargetPkg) to asCode[iLegacyIdx]
            Procedure_Return
        End
        // (c) Neither present: append the target after the leading Use block, but only on a real conversion
        //     (bAppendIfAbsent) and only when the file HAS a leading Use block (never sprout a lone Use).
        If (bTargetPresent = True or bAppendIfAbsent = False or iLastUse < 0) ;
            Procedure_Return
        Move 0 to iOut
        For iLine from 0 to iSize
            Move asCode[iLine] to asNew[iOut]
            Increment iOut
            If (iLine = iLastUse) Begin
                Move ("Use " + sTargetPkg) to asNew[iOut]
                Increment iOut
            End
        Loop
        Move asNew to asCode
    End_Procedure

    // Refactors the obsolete WinPrint-1 WinReport report class to the WinPrint-2 cWinReport2 class. WinReport
    // is { Obsolete=True } in Dfwinrpt.pkg (compiler warning 4537 "Obsolete class: WinReport") and cWinReport2
    // lives in its own cWinReport2.pkg. Unlike the Edit family this is a near-pure class swap: WinReport and
    // cWinReport2 share the BasicReport report surface (Add_SubTotal, DFNew_Page, Output_Device_Mode,
    // Report_Header/Footer, ...), so no property translation is needed. What this does:
    //   1. Swaps <sOld> for <sNew> on BOTH declaration forms - "Object <name> is a <sOld>" AND
    //      "Class <name> is a <sOld>" - so a user subclass base is modernised while its objects keep the
    //      subclass name. Whole-token, case-insensitive; the object/class NAME is never touched.
    //   2. For the standard target (cWinReport2) _EnsureUsePackage retires the obsolete 'Use Dfwinrpt.pkg'
    //      (itself obsolete-package warning 4536) and guarantees 'Use cWinReport2.pkg' - swap-in-place if
    //      Dfwinrpt is present, append if neither is (only on a real conversion, iCount>0), drop Dfwinrpt if
    //      cWinReport2 is already Used.
    //   3. A converted 'Class <sub> is a' gets that Use even in a file with no Use at all. _EnsureUsePackage takes such
    //      a file for a fragment and adds nothing, but a package that declares a class needs its base class, and
    //      Myreport.pkg, a real one, was left with cWinReport2 undefined (Nils 2026-11-05).
    // (Header commands - DFHeaderFrame/LineCheck/Margin/Pos/Wrap - must sit inside DFBeginHeader/DFEndHeader for
    // WinPrint 2's stricter validation, but that is a separate runtime concern this pass does not touch.)
    // Comment lines are skipped; idempotent (sNew never token-matches sOld). Returns declarations converted.
    Function _TransformWinReportToWinReport2 String[] ByRef asCode String sOld String sNew Returns Integer
        String sLine sLowTrim sLowFull sRest sTok sOldLow
        Integer iLine iSize iCount iPos iEnd iArt
        Boolean bOpener bClass

        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        Move False to bClass
        Move (Lowercase(sOld)) to sOldLow
        Move 0 to iCount
        For iLine from 0 to iSize
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Move asCode[iLine] to sLine
            // Tab-normalised detection copy (Trim strips only spaces); all splice positions use the untouched sLine.
            Move (Lowercase(Trim(Replaces(Character(9), sLine, " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//") Begin
                Move (Left(sLowTrim, 7) = "object " or Left(sLowTrim, 6) = "class ") to bOpener
                If (bOpener = True) Begin
                    Move (Lowercase(sLine)) to sLowFull
                    // Either article - "is a" AND "is an" (the class-names parameter admits
                    // vowel-initial subclasses, e.g. 'Object oRep is an Myreport'; same lesson as
                    // the Edit family, WinServ 2026-07-17). Splice keeps the article's casing
                    // through its 'a' and drops an "an"'s n - targets are consonant-initial.
                    Move (Pos(" is a ", sLowFull)) to iPos
                    Move 6 to iArt
                    If (iPos = 0) Begin
                        Move (Pos(" is an ", sLowFull)) to iPos
                        Move 7 to iArt
                    End
                    If (iPos > 0) Begin
                        Move (Mid(sLine, (Length(sLine)), (iPos + iArt))) to sRest
                        Move (Pos(" ", sRest)) to iEnd
                        If (iEnd > 0) Begin
                            Move (Left(sRest, (iEnd - 1))) to sTok
                        End
                        Else Begin
                            Move sRest to sTok
                        End
                        Move (Trim(sTok)) to sTok
                        If (Lowercase(sTok) = sOldLow) Begin
                            Move (Left(sLine, (iPos + 4)) + " " + sNew + Mid(sLine, (Length(sLine)), (iPos + iArt + Length(sTok)))) to sLine
                            Increment iCount
                            Move sLine to asCode[iLine]
                            If (Left(sLowTrim, 6) = "class ") ;
                                Move True to bClass
                        End
                    End
                End
            End
        Loop
        // Retire the obsolete Winprint-1 package and guarantee the cWinReport2 package (standard target only;
        // a custom subclass's package is unknown). Runs regardless of iCount so a manual re-run also retires a
        // Dfwinrpt Use an earlier class-only pass left behind. Mirrors the Edit/dbEdit converters.
        If (Lowercase(Trim(sNew)) = "cwinreport2") Begin
            Send _EnsureUsePackage (&asCode) "dfwinrpt.pkg" "cWinReport2.pkg" (iCount > 0)
            If (bClass = True) ;
                Send _EnsureUseForNewDependency (&asCode) "cWinReport2.pkg"
        End
        Function_Return iCount
    End_Function

    // Whole-file worker for RefactorWorkspaceTocApplication: the legacy pre-Studio program shell's
    // 'Object <name> is a Workspace' (Workspc.pkg - REMOVED from modern DataFlex, so today it fails
    // HARD with 4313 include-not-found + 4345/4328 U_WORKSPACE, not a warning) becomes the modern
    // 'Object <name> is a cApplication', which re-provides ghoWorkspace for every downstream read.
    // DELIBERATELY NARROW (Nils 2026-07-10): ONLY the workspace object + its immediate wiring; the
    // rest of the legacy shell (bare command-level globals, the login block, .mn menus,
    // AppClientArea) is left for separate refactoring functions. What this does:
    //   1. 'Object <name> is a Workspace' -> '... is a cApplication' (whole-token, tab-normalised
    //      detection like the sibling converters). The object is RENAMED to the conventional
    //      oApplication only when the old name is referenced NOWHERE else in the file (whole-word
    //      scan; a comment mention counts as a reference - errs toward keeping the name). A
    //      'Class X is a Workspace' SUBCLASS is deliberately NOT converted (subclassing
    //      cApplication is a design decision, not a swap) - its analyzer row stays for the user.
    //   2. INSIDE the converted object (depth 1 only, never inside a nested Procedure/Function
    //      body): 'Set WorkspaceName to ...' -> 'Set psAutoOpenWorkspace to "<sWsFile>"' (the
    //      runtime .ws config the modern class auto-opens); every OTHER property Set
    //      (kEnter_Next_State, ModuleName, HelpName, ...) has no direct cApplication equivalent and
    //      is COMMENTED OUT with a '// TODO (DFRefactor)' tag - flagged, never deleted.
    //      Comment/blank lines pass through untouched.
    //   3. POST-PASS on a real conversion (iCount > 0): 'Use Workspc.pkg' is commented out (the
    //      package no longer ships; cApplication arrives via DfAllEnt.pkg, which these shells
    //      already Use), and the '#REPLACE CURRENT$WORKSPACE ...' feeder is commented out once
    //      nothing else in the file still reads the token (the converted WorkspaceName line was
    //      usually its only reader; any other reader keeps the #REPLACE).
    // Idempotent: cApplication never token-matches Workspace and commented lines are skipped.
    // Returns the number of workspace objects converted.
    Function _TransformWorkspaceToApplication String[] ByRef asCode String sWsFile Returns Integer
        String sLine sLowTrim sLowFull sRest sTok sName sIndent sTail
        Integer iLine iSize iCount iDepth iPos iEnd iRef iPos2 iObjPos iReplaceIdx iProcDepth
        Boolean bInside bOpener bCloser bNameUsed bTokenUsed

        Move (SizeOfArray(asCode) - 1) to iSize
        If (iSize < 0) ;
            Function_Return 0
        If (Trim(sWsFile) = "") ;
            Move "Config.ws" to sWsFile
        Move 0 to iCount
        Move False to bInside
        Move 0 to iDepth
        Move 0 to iProcDepth
        Move -1 to iReplaceIdx
        For iLine from 0 to iSize
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(iLine, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            Move asCode[iLine] to sLine
            // Tab-normalised detection copy (Trim strips only spaces); splices use the untouched sLine.
            Move (Lowercase(Trim(Replaces(Character(9), sLine, " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//") Begin
                // Remember the '#REPLACE CURRENT$WORKSPACE' feeder for the post-pass.
                If (Left(sLowTrim, 9) = "#replace " and (sLowTrim contains "current$workspace")) ;
                    Move iLine to iReplaceIdx
                Move (Left(sLowTrim, 7) = "object " or Left(sLowTrim, 6) = "class ") to bOpener
                Move (Left(sLowTrim, 10) = "end_object" or Left(sLowTrim, 9) = "end_class") to bCloser
                // Declaration swap: 'Object <name> is a Workspace' only (see the Class note above).
                If (bInside = False and Left(sLowTrim, 7) = "object ") Begin
                    Move (Lowercase(sLine)) to sLowFull
                    Move (Pos(" is a ", sLowFull)) to iPos
                    If (iPos > 0) Begin
                        Move (Mid(sLine, (Length(sLine)), (iPos + 6))) to sRest
                        Move (Pos(" ", sRest)) to iEnd
                        If (iEnd > 0) Begin
                            Move (Left(sRest, (iEnd - 1))) to sTok
                        End
                        Else Begin
                            Move sRest to sTok
                        End
                        Move (Trim(sTok)) to sTok
                        If (Lowercase(sTok) = "workspace") Begin
                            // The declared object NAME (between the Object keyword and ' is a').
                            Get _FindKeywordPos sLine "object" True 1 to iObjPos
                            Move (Trim(Mid(sLine, (iPos - iObjPos - 6), (iObjPos + 6)))) to sName
                            // Rename to oApplication ONLY when the old name is referenced nowhere else.
                            Move False to bNameUsed
                            If (sName <> "") Begin
                                For iRef from 0 to iSize
                                    If (iRef <> iLine) Begin
                                        Get _FindKeywordPos asCode[iRef] sName True 1 to iPos2
                                        If (iPos2 > 0) Begin
                                            Move True to bNameUsed
                                            Move iSize to iRef   // canonical DF loop-exit
                                        End
                                    End
                                Loop
                            End
                            Move (Mid(sLine, (Length(sLine)), (iPos + 6 + Length(sTok)))) to sTail
                            If (bNameUsed = True or sName = "") ;
                                Move (Left(sLine, (iPos + 5)) + "cApplication" + sTail) to sLine
                            Else ;
                                Move (Left(sLine, (iObjPos - 1)) + "Object oApplication is a cApplication" + sTail) to sLine
                            Increment iCount
                            Move True to bInside
                            Move 0 to iDepth        // the opener bookkeeping below makes it 1
                            Move 0 to iProcDepth
                        End
                    End
                End
                If (bInside = True) Begin
                    // Depth bookkeeping so a nested child's End_Object does not end OUR block.
                    If (bOpener = True) ;
                        Increment iDepth
                    If (bCloser = True) Begin
                        Decrement iDepth
                        If (iDepth <= 0) ;
                            Move False to bInside
                    End
                    // Method-body bookkeeping: a Set inside an OnCreate/OnStartUp is runtime code,
                    // not a workspace property - it must pass through untouched.
                    If (Left(sLowTrim, 10) = "procedure " or Left(sLowTrim, 9) = "function ") ;
                        Increment iProcDepth
                    If (Left(sLowTrim, 13) = "end_procedure" or Left(sLowTrim, 12) = "end_function") Begin
                        If (iProcDepth > 0) ;
                            Decrement iProcDepth
                    End
                    // Property translation - direct body only (depth 1, outside any method body).
                    If (bInside = True and iDepth = 1 and iProcDepth = 0) Begin
                        If (Left(sLowTrim, 18) = "set workspacename ") Begin
                            Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                            Move (sIndent + 'Set psAutoOpenWorkspace to "' + sWsFile + '"') to sLine
                        End
                        Else If (Left(sLowTrim, 4) = "set " and not(sLine contains "TODO (DFRefactor)")) Begin
                            Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                            Move (sIndent + "// " + LTrim(sLine) + "   // TODO (DFRefactor): no direct cApplication equivalent - review.") to sLine
                        End
                    End
                End
                Move sLine to asCode[iLine]
            End
        Loop
        // Post-pass, only on a real conversion: retire the dead Use lines, the Register_Object and
        // the #REPLACE feeder (all COMMENTED OUT, never deleted - reversible by design), then bring
        // the rest of the modern shell chrome in (_ScaffoldModernShell).
        If (iCount > 0) Begin
            For iLine from 0 to iSize
                Move asCode[iLine] to sLine
                Move (Lowercase(Trim(Replaces(Character(9), sLine, " ")))) to sLowTrim
                If (Left(sLowTrim, 4) = "use ") Begin
                    Move (Trim(Mid(sLowTrim, Length(sLowTrim), 5))) to sTok
                    Move (Pos(" ", sTok)) to iPos
                    If (iPos > 0) ;
                        Move (Left(sTok, (iPos - 1))) to sTok
                    If (sTok = "workspc.pkg" or sTok = "workspc") ;
                        Move ("// " + LTrim(sLine) + "   // DFRefactor: Workspc.pkg retired - cApplication (via DfAllEnt.pkg) replaces the Workspace object.") to asCode[iLine]
                    // Std_Help.pkg is replaced by the oHtmlHelp object + peHelpType the scaffolding adds.
                    If (sTok = "std_help.pkg" or sTok = "std_help") ;
                        Move ("// " + LTrim(sLine) + "   // DFRefactor: replaced by the oHtmlHelp object (peHelpType htHtmlHelp).") to asCode[iLine]
                End
                // The wizard-era forward registration of the client area is not needed in the modern shell.
                If (Left(sLowTrim, 16) = "register_object " and (sLowTrim contains "client_area")) ;
                    Move ("// " + LTrim(sLine) + "   // DFRefactor: retired - not needed with the modern shell.") to asCode[iLine]
            Loop
            If (iReplaceIdx >= 0) Begin
                Move False to bTokenUsed
                For iLine from 0 to iSize
                    If (iLine <> iReplaceIdx) Begin
                        Move (Lowercase(Trim(asCode[iLine]))) to sLowTrim
                        If (Left(sLowTrim, 2) <> "//" and (sLowTrim contains "current$workspace")) Begin
                            Move True to bTokenUsed
                            Move iSize to iLine   // canonical DF loop-exit
                        End
                    End
                Loop
                If (bTokenUsed = False) ;
                    Move ("// " + LTrim(asCode[iReplaceIdx]) + "   // DFRefactor: CURRENT$WORKSPACE retired with the Workspace object.") to asCode[iReplaceIdx]
            End
            Send _ScaffoldModernShell (&asCode)
        End
        Function_Return iCount
    End_Function

    // Insert the asIns lines BEFORE index iAt of asCode (iAt past the end = append). Rebuild-copy,
    // mirroring _EnsureUsePackage's append path. Generic splice helper for the shell scaffolding.
    Procedure _InsertLinesBefore String[] ByRef asCode Integer iAt String[] asIns
        String[] asNew
        Integer iLine iSize iOut iIns iInsMax

        Move (SizeOfArray(asCode) - 1) to iSize
        Move (SizeOfArray(asIns) - 1) to iInsMax
        Move 0 to iOut
        For iLine from 0 to iSize
            If (iLine = iAt) Begin
                For iIns from 0 to iInsMax
                    Move asIns[iIns] to asNew[iOut]
                    Increment iOut
                Loop
            End
            Move asCode[iLine] to asNew[iOut]
            Increment iOut
        Loop
        If (iAt > iSize) Begin
            For iIns from 0 to iInsMax
                Move asIns[iIns] to asNew[iOut]
                Increment iOut
            Loop
        End
        Move asNew to asCode
    End_Procedure

    // Replace EVERY whole-token occurrence of sOld in sLine with sNew (boundary-aware via
    // _FindKeywordPos, so Client_Area never matches Client_Id or My_Client_Area). Case-insensitive
    // match, sNew emitted verbatim.
    Function _ReplaceWholeTokenInLine String sLine String sOld String sNew Returns String
        Integer iPos iStart
        Move 1 to iStart
        Repeat
            Get _FindKeywordPos sLine sOld True iStart to iPos
            If (iPos > 0) Begin
                Move (Left(sLine, (iPos - 1)) + sNew + Mid(sLine, (Length(sLine)), (iPos + Length(sOld)))) to sLine
                Move (iPos + Length(sNew)) to iStart
            End
        Until (iPos = 0)
        Function_Return sLine
    End_Function

    // True when any non-comment line declares an object/class of sClassLow (lowercase) - the
    // idempotency guard for the shell scaffolding's inserted objects. Boundary-checked: the char
    // after the class token must be a space or end-of-line.
    Function _HasIsAClass String[] asCode String sClassLow Returns Boolean
        String sLowTrim sNeedle sAfter
        Integer iLine iSize iPos

        Move (" is a " + sClassLow) to sNeedle
        Move (SizeOfArray(asCode) - 1) to iSize
        For iLine from 0 to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//") Begin
                Move (Pos(sNeedle, sLowTrim)) to iPos
                If (iPos > 0) Begin
                    Move (Mid(sLowTrim, 1, (iPos + Length(sNeedle)))) to sAfter
                    If (sAfter = "" or sAfter = " ") ;
                        Function_Return True
                End
            End
        Loop
        Function_Return False
    End_Function

    // The matching End_Object/End_Class line index of the object/class declared at iDecl (-1 =
    // none found). Depth-tracked past nested children; comment lines skipped.
    Function _FindObjectEndLine String[] asCode Integer iDecl Returns Integer
        String sLowTrim
        Integer iLine iSize iDepth

        Move (SizeOfArray(asCode) - 1) to iSize
        Move 0 to iDepth
        For iLine from iDecl to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//") Begin
                If (Left(sLowTrim, 7) = "object " or Left(sLowTrim, 6) = "class ") ;
                    Increment iDepth
                If (Left(sLowTrim, 10) = "end_object" or Left(sLowTrim, 9) = "end_class") Begin
                    Decrement iDepth
                    If (iDepth <= 0) ;
                        Function_Return iLine
                End
            End
        Loop
        Function_Return -1
    End_Function

    // Remove the single line at index iAt (rebuild-copy). Partner of _InsertLinesBefore for the
    // shell scaffolding's move-a-line operations.
    Procedure _RemoveLineAt String[] ByRef asCode Integer iAt
        String[] asNew
        Integer iLine iSize iOut
        Move (SizeOfArray(asCode) - 1) to iSize
        Move 0 to iOut
        For iLine from 0 to iSize
            If (iLine <> iAt) Begin
                Move asCode[iLine] to asNew[iOut]
                Increment iOut
            End
        Loop
        Move asNew to asCode
    End_Procedure

    // Index of the first non-comment 'Object <name> is a <sClassLow>' declaration (-1 = none).
    // Same tab-normalised, whole-token class parse as the converters.
    Function _FindObjectDeclOfClass String[] asCode String sClassLow Returns Integer
        String sLowTrim sLowFull sRest sTok
        Integer iLine iSize iPos iEnd

        Move (SizeOfArray(asCode) - 1) to iSize
        For iLine from 0 to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 2) <> "//" and Left(sLowTrim, 7) = "object ") Begin
                Move (Lowercase(asCode[iLine])) to sLowFull
                Move (Pos(" is a ", sLowFull)) to iPos
                If (iPos > 0) Begin
                    Move (Mid(sLowFull, (Length(sLowFull)), (iPos + 6))) to sRest
                    Move (Pos(" ", sRest)) to iEnd
                    If (iEnd > 0) Begin
                        Move (Left(sRest, (iEnd - 1))) to sTok
                    End
                    Else Begin
                        Move sRest to sTok
                    End
                    Move (Trim(sTok)) to sTok
                    If (sTok = sClassLow) ;
                        Function_Return iLine
                End
            End
        Loop
        Function_Return -1
    End_Function

    // Shell SCAFFOLDING for _TransformWorkspaceToApplication (Nils's step list 2026-07-10): brings
    // the rest of the modern program-shell chrome in around the freshly-converted cApplication
    // object, mirroring the modern wizard shell. Runs ONLY after a real conversion, and ONLY in a
    // real program file - at least one LIVE Use line must survive the retirements (a bare test
    // fragment gets the object conversion alone). Every step is presence-guarded, so a re-run or a
    // half-modernized file never duplicates scaffolding:
    //   1. 'Use cCJStandardCommandBarSystem.pkg' + 'Use cCJCommandBarSystem.pkg' appended to the
    //      leading Use block (_EnsureUsePackage's append path; skipped when already present).
    //   2. An oHtmlHelp (cHtmlHelp, pbAlwaysOnTop False) object inserted ABOVE the cApplication
    //      object (its 'Use Std_Help.pkg' was commented out by the caller).
    //   3. Inside the cApplication object, right after psAutoOpenWorkspace: COMMENTED
    //      psCompany/psProduct placeholder lines (generic wording - a real company/product name is
    //      the user's to fill in; never emitted by the tool) + an ACTIVE 'Set peHelpType to
    //      htHtmlHelp'.
    //   4. 'Use cToolTipController.pkg' + a bare oToolTipController object inserted after the
    //      cApplication object's End_Object.
    //   5. The client area: 'Object Client_Area is a AppClientArea' -> 'Object oClientArea is a
    //      ClientArea' - the class token swaps, and when the legacy name is exactly Client_Area the
    //      object AND every whole-token same-file reference is renamed to oClientArea (the
    //      commented-out Register_Object keeps the old name: it is retired history). Finally an
    //      oCommandBarSystem (cCJCommandBarSystem, pbTimerUpdate True) is inserted just BEFORE the
    //      client-area object inside the main panel.
    //   6. A live 'Use StdAbout.pkg' is MOVED into the client area (end of its body) and the
    //      Activate_About skeleton follows it, with the wizard's DoAbout example line commented for
    //      the user to fill in. No StdAbout Use / an existing Activate_About -> the step is skipped.
    Procedure _ScaffoldModernShell String[] ByRef asCode
        String sLine sLowTrim sIndent sCAName sLowFull sRest sTok sAboutLine
        Integer iLine iSize iPos iEnd iApp iAuto iDepth iCA iObjPos iAbout
        Boolean bScaffold bOpener bCloser bHavePeHelp bHaveAbout
        String[] asIns asEmpty

        // Real-program gate: at least one LIVE (non-commented) Use line.
        Move False to bScaffold
        Move (SizeOfArray(asCode) - 1) to iSize
        For iLine from 0 to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 4) = "use ") Begin
                Move True to bScaffold
                Move iSize to iLine   // canonical DF loop-exit
            End
        Loop
        If (bScaffold = False) ;
            Procedure_Return
        // (1) The CodeJock command-bar system packages, at the top (after the leading Use block).
        Send _EnsureUsePackage (&asCode) "" "cCJStandardCommandBarSystem.pkg" True
        Send _EnsureUsePackage (&asCode) "" "cCJCommandBarSystem.pkg" True
        // (2) The oHtmlHelp object, ABOVE the cApplication object.
        Get _HasIsAClass asCode "chtmlhelp" to bOpener
        If (bOpener = False) Begin
            Get _FindObjectDeclOfClass asCode "capplication" to iApp
            If (iApp >= 0) Begin
                Move asCode[iApp] to sLine
                Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                Move asEmpty to asIns
                Move (sIndent + "Object oHtmlHelp is a cHtmlHelp")     to asIns[0]
                Move (sIndent + "    Set pbAlwaysOnTop to False")      to asIns[1]
                Move (sIndent + "End_Object")                          to asIns[2]
                Move ""                                                to asIns[3]
                Send _InsertLinesBefore (&asCode) iApp asIns
            End
        End
        // (3) psCompany/psProduct placeholders (commented) + peHelpType, after psAutoOpenWorkspace.
        Move False to bHavePeHelp
        Move (SizeOfArray(asCode) - 1) to iSize
        Move -1 to iAuto
        For iLine from 0 to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 15) = "set pehelptype ") ;
                Move True to bHavePeHelp
            If (iAuto = -1 and Left(sLowTrim, 2) <> "//" and Left(sLowTrim, 23) = "set psautoopenworkspace") ;
                Move iLine to iAuto
        Loop
        If (bHavePeHelp = False and iAuto >= 0) Begin
            Move asCode[iAuto] to sLine
            Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
            Move asEmpty to asIns
            Move (sIndent + '// Set psCompany to "Your company name"   // TODO (DFRefactor): fill in and uncomment.') to asIns[0]
            Move (sIndent + '// Set psProduct to "Your product name"   // TODO (DFRefactor): fill in and uncomment.') to asIns[1]
            Move (sIndent + "Set peHelpType to htHtmlHelp")                                                           to asIns[2]
            Send _InsertLinesBefore (&asCode) (iAuto + 1) asIns
        End
        // (4) The tooltip controller, after the cApplication object's End_Object.
        Get _HasIsAClass asCode "ctooltipcontroller" to bOpener
        If (bOpener = False) Begin
            Get _FindObjectDeclOfClass asCode "capplication" to iApp
            If (iApp >= 0) Begin
                Move asCode[iApp] to sLine
                Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                Get _FindObjectEndLine asCode iApp to iEnd
                If (iEnd >= 0) Begin
                    Move asEmpty to asIns
                    Move ""                                                              to asIns[0]
                    Move (sIndent + "Use cToolTipController.pkg")                        to asIns[1]
                    Move (sIndent + "Object oToolTipController is a cToolTipController") to asIns[2]
                    Move (sIndent + "End_Object")                                        to asIns[3]
                    Send _InsertLinesBefore (&asCode) (iEnd + 1) asIns
                End
            End
        End
        // (5) The client area: class swap + rename, then the command-bar system object before it.
        Get _FindObjectDeclOfClass asCode "appclientarea" to iCA
        If (iCA >= 0) Begin
            // The declared name (between the Object keyword and ' is a').
            Move asCode[iCA] to sLine
            Move (Lowercase(sLine)) to sLowFull
            Move (Pos(" is a ", sLowFull)) to iPos
            Get _FindKeywordPos sLine "object" True 1 to iObjPos
            Move (Trim(Mid(sLine, (iPos - iObjPos - 6), (iObjPos + 6)))) to sCAName
            // Rename Client_Area -> oClientArea, declaration + every whole-token reference (the
            // commented Register_Object line is skipped - retired history keeps the old name).
            If (Lowercase(sCAName) = "client_area") Begin
                Move (SizeOfArray(asCode) - 1) to iSize
                For iLine from 0 to iSize
                    Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
                    If (Left(sLowTrim, 2) <> "//") ;
                        Get _ReplaceWholeTokenInLine asCode[iLine] "Client_Area" "oClientArea" to asCode[iLine]
                Loop
            End
            // The class swap itself (whole-token, so an object NAME is never touched).
            Get _ReplaceWholeTokenInLine asCode[iCA] "AppClientArea" "ClientArea" to asCode[iCA]
            // The command-bar system object, just before the client area inside the main panel.
            Get _HasIsAClass asCode "ccjcommandbarsystem" to bOpener
            If (bOpener = False) Begin
                Move asCode[iCA] to sLine
                Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                Move asEmpty to asIns
                Move (sIndent + "Object oCommandBarSystem is a cCJCommandBarSystem") to asIns[0]
                Move (sIndent + "    Set pbTimerUpdate to True")                     to asIns[1]
                Move (sIndent + "End_Object")                                        to asIns[2]
                Move ""                                                              to asIns[3]
                Send _InsertLinesBefore (&asCode) iCA asIns
            End
        End
        // (6) The About wiring: a live 'Use StdAbout.pkg' is MOVED to the end of the client area's
        // body (where the modern shell keeps it, with the views it serves) and the Activate_About
        // skeleton is added right after it - the DoAbout example stays COMMENTED for the user to
        // fill in (it is the Studio wizard's own sample text, not real data). Skipped entirely when
        // the file already has an Activate_About (shell already wired) or has no StdAbout Use at
        // all (a program without an About box gets none forced on it).
        Move False to bHaveAbout
        Move -1 to iAbout
        Move "" to sAboutLine
        Move (SizeOfArray(asCode) - 1) to iSize
        For iLine from 0 to iSize
            Move (Lowercase(Trim(Replaces(Character(9), asCode[iLine], " ")))) to sLowTrim
            If (Left(sLowTrim, 24) = "procedure activate_about") ;
                Move True to bHaveAbout
            If (iAbout = -1 and Left(sLowTrim, 4) = "use ") Begin
                Move (Trim(Mid(sLowTrim, Length(sLowTrim), 5))) to sTok
                Move (Pos(" ", sTok)) to iPos
                If (iPos > 0) ;
                    Move (Left(sTok, (iPos - 1))) to sTok
                If (sTok = "stdabout.pkg" or sTok = "stdabout") Begin
                    Move iLine to iAbout
                    Move asCode[iLine] to sAboutLine
                End
            End
        Loop
        If (bHaveAbout = False and iAbout >= 0) Begin
            Get _FindObjectDeclOfClass asCode "clientarea" to iCA
            If (iCA >= 0) Begin
                Get _FindObjectEndLine asCode iCA to iEnd
                If (iEnd > iCA) Begin
                    Move asCode[iCA] to sLine
                    Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                    Move asEmpty to asIns
                    If (iAbout < iCA or iAbout > iEnd) Begin
                        // Outside the client area: MOVE it - remove the original line (verbatim
                        // text preserved, comments and all), then re-locate the shifted block end.
                        Send _RemoveLineAt (&asCode) iAbout
                        Get _FindObjectDeclOfClass asCode "clientarea" to iCA
                        Get _FindObjectEndLine asCode iCA to iEnd
                        Move sAboutLine to asIns[0]
                    End
                    Move (sIndent + "    Procedure Activate_About")   to asIns[SizeOfArray(asIns)]
                    Move (sIndent + '        //         Send DoAbout "Order Entry Sample Application" "2026.0" "Copyright (c) 2026 Data Access Corporation" "Data Access Worldwide" ""') to asIns[SizeOfArray(asIns)]
                    Move (sIndent + "    End_Procedure")              to asIns[SizeOfArray(asIns)]
                    Move ""                                           to asIns[SizeOfArray(asIns)]
                    Send _InsertLinesBefore (&asCode) iEnd asIns
                End
            End
        End
    End_Procedure

    Procedure ClearFuncLibProperties
        tTokenizer TokenizerDataEmpty
        Send _ClearRefactoringProperties
        Send ClearProjectObjectStructureProperties
        Set pTokenizer to TokenizerDataEmpty
    End_Procedure
        
    Function ReplaceAllLegacyOperators String sOverStrikeLine Returns String
        Get _ReplaceLegacyOperators sOverStrikeLine "lt" "<"  to sOverStrikeLine
        Get _ReplaceLegacyOperators sOverStrikeLine "le" "<=" to sOverStrikeLine
        Get _ReplaceLegacyOperators sOverStrikeLine "eq" "="  to sOverStrikeLine
        Get _ReplaceLegacyOperators sOverStrikeLine "ne" "<>" to sOverStrikeLine
        Get _ReplaceLegacyOperators sOverStrikeLine "gt" ">"  to sOverStrikeLine
        Get _ReplaceLegacyOperators sOverStrikeLine "ge" ">=" to sOverStrikeLine
        Function_Return sOverStrikeLine
    End_Function

    // True when a string-literal CONTENT looks like a calendar date: three digit groups separated by a
    // CONSISTENT '-' or '/', with a 4-digit year group, optionally trailed by a space + time. Loose across
    // YMD / DMY / MDY on purpose - Date() parses in the runtime locale, and in a LINE-BY-LINE pass we cannot
    // know the other operand's type, so the literal's FORMAT is the tell. The 4-digit-year requirement stops
    // things like "1-2-3" or "12" matching. (Nils 2026-07-15 - date-constant comparison wrapping.)
    Function _LooksLikeDateConstant String sContent Returns Boolean
        String sDate sCh sSep
        Integer i iLen iGroups iCur iMax

        Move (Trim(sContent)) to sDate
        Move (Pos(" ", sDate)) to i
        If (i > 0) ;                              // drop a trailing time part ("2016-12-31 23:59")
            Move (Left(sDate, i - 1)) to sDate
        Move (Length(sDate)) to iLen
        If (iLen < 8) ;                           // shortest real date (e.g. "2016-1-1") is 8 chars
            Function_Return False
        Move "" to sSep
        Move 0 to iGroups
        Move 0 to iCur
        Move 0 to iMax
        For i from 1 to iLen
            Move (Mid(sDate, 1, i)) to sCh
            If (sCh >= "0" and sCh <= "9") Begin
                Increment iCur
            End
            Else If (sCh = "-" or sCh = "/") Begin
                If (sSep = "") ;
                    Move sCh to sSep
                If (sCh <> sSep) ;                // mixed separators -> not a clean date
                    Function_Return False
                If (iCur = 0) ;                   // empty group ("2016--12")
                    Function_Return False
                Increment iGroups
                If (iCur > iMax) ;
                    Move iCur to iMax
                Move 0 to iCur
            End
            Else ;                                // any other char -> not a bare date
                Function_Return False
        Loop
        If (iCur = 0) ;                           // trailing separator, no final group
            Function_Return False
        Increment iGroups                         // count the final group
        If (iCur > iMax) ;
            Move iCur to iMax
        Function_Return (iGroups = 3 and iMax = 4)
    End_Function

    // Wrap a DATE-format string literal that is a comparison OPERAND in Date(), so the parenthesised expression
    // ChangeLegacyOperators produces defers the string->date coercion to RUNTIME (its correct locale) instead
    // of the COMPILER (which reads ISO "2016-12-31" as American MM-DD-YYYY and errors). Nils 2026-07-15: the
    // legacy command form 'If ddate gt "2016-12-31"' compiled + ran, but '(ddate > "2016-12-31")' does NOT
    // compile; Date() wrapping reproduces the legacy runtime behaviour. A literal is wrapped ONLY when the
    // nearest non-space char BEFORE or AFTER it is a relational-operator char (< > =), so a function argument
    // ('Foo("2016-12-31")' -> adjacent '(') and an already-wrapped 'Date("...")' (-> adjacent '(' / ')') are
    // left alone - which also makes it idempotent. '//' comments are copied verbatim (a date in a comment is
    // not code). String quotes tracked like _CodeOnlyLine (DataFlex has no doubled-quote escape).
    Function _WrapDateComparisonConstants String sLine Returns String
        String sOut sQuote sCh sLit sPrev sNext
        Integer i iLen j
        Boolean bWrap

        Move "" to sOut
        Move "" to sQuote
        Move "" to sLit
        Move (Length(sLine)) to iLen
        Move 1 to i
        While (i <= iLen)
            Move (Mid(sLine, 1, i)) to sCh
            If (sQuote <> "") Begin
                If (sCh = sQuote) Begin
                    // Literal closed - wrap iff it looks like a date AND is a comparison operand.
                    Move False to bWrap
                    If (_LooksLikeDateConstant(Self, sLit) = True) Begin
                        Move (Right(RTrim(sOut), 1)) to sPrev      // last non-space char before the open quote
                        Move "" to sNext
                        Move (i + 1) to j
                        While (j <= iLen and sNext = "")
                            Move (Mid(sLine, 1, j)) to sCh
                            If (sCh <> " " and sCh <> (Character(9))) ;
                                Move sCh to sNext                  // first non-space char after the close quote
                            Increment j
                        Loop
                        If (sPrev = ">" or sPrev = "<" or sPrev = "=" or ;
                            sNext = ">" or sNext = "<" or sNext = "=") ;
                            Move True to bWrap
                    End
                    If (bWrap = True) ;
                        Move (sOut + "Date(" + sQuote + sLit + sQuote + ")") to sOut
                    Else ;
                        Move (sOut + sQuote + sLit + sQuote) to sOut
                    Move "" to sQuote
                    Move "" to sLit
                End
                Else ;
                    Move (sLit + sCh) to sLit
            End
            Else Begin
                If (sCh = '"' or sCh = "'") Begin
                    Move sCh to sQuote
                    Move "" to sLit
                End
                Else If (sCh = "/" and i < iLen and Mid(sLine, 1, i + 1) = "/") Begin
                    // '//' comment start outside a literal - copy the remainder verbatim and stop.
                    Move (sOut + Mid(sLine, CI_EOL, i)) to sOut
                    Move iLen to i                                 // canonical DF loop-exit
                End
                Else ;
                    Move (sOut + sCh) to sOut
            End
            Increment i
        Loop
        If (sQuote <> "") ;                                        // unterminated literal - flush verbatim
            Move (sOut + sQuote + sLit) to sOut
        Function_Return sOut
    End_Function

    Procedure ClearProjectObjectStructureProperties
        String[] asObjectNames
        Set pbProjectObjectStructureStart to False
        Set pbProjectObjectStructureEnd   to False
        Set pbRegisterAllObjectsStart     to False
        Set pbRegisterAllObjectsEnd       to False
        Set pasObjectNames                to asObjectNames
    End_Procedure

    // Used by the SplitInlineIfElseLine function.
    Function IsLineEndSemiColonOrBegin String sLine Returns Boolean
        Boolean bFound

        Get _HasLineEndSemiColon sLine to bFound
        If (bFound = False) Begin
            Move (Trim(Lowercase(sLine))) to sLine
            If (Right(sLine, 5) = "begin") Begin
                Move True to bFound
            End
        End
        Function_Return bFound
    End_Function

    Function IsStudioGeneratedComment String sLine String sComment String sComt2 Returns Boolean
        String sText sComment2
        Boolean bFound
        
        If (num_arguments > 2) Begin
            Move sComt2 to sComment2
        End
        Move (Trim(Lowercase(sLine))) to sText

        If (sText contains (CS_CommentSymbol + Lowercase(sComment))) Begin
            Function_Return True
        End
        Else If (sText contains (CS_CommentSymbol + " " + Lowercase(sComment)) and sComment2 = "") Begin
            Function_Return True
        End
        Else If (sComment2 <> "") Begin
            Move (sText contains (CS_CommentSymbol + CS_S + Lowercase(sComment))) to bFound
            If (bFound = True) Begin
                Move (sText contains (CS_S + Lowercase(sComment2))) to bFound
                Function_Return bFound
            End
        End

        Function_Return False
    End_Function

    // helper function for IsKeywordInLine, when a keyword is found in a string declaration
    Function RemoveStringsFromLine String sLine Returns String
        Integer iLength iPos
        Boolean bSep1 bSep2
        String  sChar sSep1 sSep2 sReturn

        Move False to bSep1
        Move False to bSep2
        Move "'" to sSep1
        Move '"' to sSep2
        Move ""  to sReturn
        Move (Length(sLine)) to iLength

        For iPos from 1 to iLength
            Move (Mid(sLine, 1, iPos)) to sChar
            If (bSep1 = False and bSep2 = False) Begin
                If (sChar = sSep1) Begin
                    Move True to bSep1
                End
                Else If (sChar = sSep2) Begin
                    Move True to bSep2
                End
                If (bSep1 = False and bSep2 = False) Begin
                    Move (sReturn + sChar) to sReturn
                End
            End
            Else Begin
                If (bSep1) Begin
                    If (sChar = sSep1) Begin
                        Move False to bSep1
                    End
                End
                Else If (bSep2) Begin
                    If (sChar = sSep2) Begin
                        Move False to bSep2
                    End
                End
            End
        Loop

        Function_Return sReturn
    End_Function

    // Helper function for the SplitInlineIfElseLine function.
    {Visibility = Private}
    Function BreakupCompoundStatement Integer iLineIndent String ByRef sLine Integer eSplitBy Integer iTabSize Returns Boolean
        Boolean bChanged
        Integer iPos
        String  sLineIndent sIndent sLine1 sLine2
        tTokenizer TokenizerData

        // We need to get fresh tokenizer data here.
        Get Tokenizer sLine to TokenizerData

        Move False to bChanged
        Move (Repeat(CS_S, iTabSize - 1)) to sIndent  // it's tabsize-1 because the text still has a space in front of it
        Move (Repeat(CS_S, iLineIndent)) to sLineIndent

        // Use SecondLeftCommand to find the split position.
        // pasCommands now includes both current Scintilla keywords and deprecated/removed
        // legacy commands (merged in _AddAllKeyWords), so _LeftCommand finds them all.
        // Works for parenthesised conditions "If (cond) Cmd" (the tokeniser keeps the whole
        // (cond) as a single token, never mistaken for a command) and for unparenthesised
        // ones "If cond Cmd".
        // SecondLeftCommand.iStartPos is the 1-based position of the command token inside
        // sOverstrikeLine (which is trimmed). Adding Length(sIndentation) - 1 converts that
        // to the position of the space immediately before the command in the full sLine.
        Move 0 to iPos
        If (TokenizerData.SecondLeftCommand.iStartPos > 0) Begin
            Move (TokenizerData.SecondLeftCommand.iStartPos + Length(TokenizerData.sIndentation) - 1) to iPos
        End
        
        // The condition stays on the If line. A variable named like a command would leave none: 'If Begin' (2026-11-02).
        If (iPos <> 0) Begin
            If (Lowercase(Trim(Left(sLine, iPos))) = Lowercase(CS_If)) ;
                Function_Return False
        End

        If (iPos <> 0) Begin
            Move True to bChanged
            If (eSplitBy = eSplitBySpaceAndSemicolon) Begin
                Move (Insert(" ;" + C_NewLine + sLineIndent + sIndent, sLine, iPos)) to sLine
            End
            Else If (eSplitBy = eSplitBySemicolon) Begin
                Move (Insert(";" + C_NewLine + sLineIndent + sIndent, sLine, iPos)) to sLine
            End
            Else If (eSplitBy = eSplitToBeginEndBlock) Begin
                Move (Insert(" Begin" + C_NewLine + sLineIndent + sIndent, sLine, iPos)) to sLine
                Move (sLine + C_NewLine + sLineIndent + "End") to sLine
            End

            // Remove any spaces before the point on which we break the line
            Move (Left(sLine, iPos - 1)) to sLine1
            Move (Right(sLine, Length(sLine) - (iPos - 1))) to sLine2
            Move (RTrim(sLine1)) to sLine1
            Move (sLine1 + sLine2) to sLine
        End
        Function_Return bChanged
    End_Function

    Function RemovePropertyPublicPrivate String ByRef sLine String sPubPriv Returns Boolean
        Boolean bChanged
        String sText
        Integer iPos
        tTokenizer TokenizerData

        Get pTokenizer to TokenizerData
        Move False to bChanged
        Move (LTrim(sLine))     to sText
        Move (Left(sText, 9))   to sText
        Move (Lowercase(sText)) to sText
        If (sText = "property ") Begin
            Move (Lowercase(sLine) + CS_S) to sText // add a space to the test at the end for if the keyword is at the end of the line.
            Move (Pos(CS_S+ sPubPriv + CS_S, sText)) to iPos
            If (iPos = 0) Begin // if there's a tab char instead of a space then..
                Move (Pos(Character(9) + sPubPriv + CS_S, sText)) to iPos
            End
            // The trim is for the line it changed (2026-10-29): it trimmed every line it was handed, so a
            // run trimmed trailing spaces nobody asked to lose, uncounted - a multi-line string's text too.
            If (iPos > 0) Begin
                Get ReplaceLineToken TokenizerData sLine sPubPriv "" to sLine
                Move (Rtrim(sLine)) to sLine
                Move True to bChanged
            End
        End
        Function_Return bChanged
    End_Function

    Function IsRegisterAllObjectsEnd String sLine Returns Boolean
        Boolean bFound
        Integer iPos
        String sFirstWord

        Move False to bFound
        Move (Lowercase(sLine)) to sLine
        Move (Trim(sLine)) to sLine
        If (Left(sLine, 2) <> CS_CommentSymbol) Begin
            Move (Pos(CS_S, sLine)) to iPos
            If (iPos <> 0) Begin
                Move (Left(sLine, (iPos -1))) to sFirstWord
                Move (sFirstWord = "object" or sFirstWord = "activate_view" or sFirstWord = "deferred_view") to bFound
            End 
        End
        Function_Return bFound
    End_Function

    Function IsProjectObjectStructureLine String sOverstrikeLine String[] ByRef asObjectNames Returns Boolean
        Boolean bWriteLine
        Integer iPos iSize
        String sLine sObjectName

        Move sOverstrikeLine to sLine
        Move (Trim(sLine)) to sLine
        Move True to bWriteLine
        Move (Pos(CS_CommentSymbol, sLine)) to iPos
        If (iPos = 1) Begin
            Move (Lowercase(sLine)) to sLine
            Move (not(sLine contains " is a " or sLine contains " is an ")) to bWriteLine
            If (bWriteLine = False) Begin
                Move (SizeOfArray(asObjectNames)) to iSize
                Move (Pos(" is a", sLine)) to iPos
                Move (Left(sLine, (iPos -1))) to sObjectName
                Move (Replace(CS_CommentSymbol, sObjectName, "")) to sObjectName
                Move (Trim(sObjectName)) to sObjectName
                Move (Lowercase(sObjectName)) to asObjectNames[iSize]
                Set pasObjectNames            to asObjectNames
            End
        End
        If (sLine = (CS_CommentSymbol * Lowercase(CS_ProjectObjectStructure))) Begin
            Move False to bWriteLine
        End
        Function_Return bWriteLine
    End_Function

    Function IsProjectObjectStructureStart String sLine Returns Boolean
        Boolean bFound
        Move (sLine contains (CS_CommentSymbol * CS_ProjectObjectStructure)) to bFound
        Function_Return bFound
    End_Function

    Function IsRegisterObjectInArray String sOverstrikeLine String[] ByRef asObjectNames Returns Boolean
        Boolean bWriteLine bRegisterObjectStart
        Integer iPos

        Move False to bWriteLine
        Get IsRegisterAllObjectsStart sOverstrikeLine to bRegisterObjectStart
        If (bRegisterObjectStart = False) Begin
            Move (Lowercase(sOverstrikeLine)) to sOverstrikeLine
            Move (Replace(Trim(Lowercase(CS_RegisterObject)), sOverstrikeLine, "")) to sOverstrikeLine
            Move (Trim(sOverstrikeLine)) to sOverstrikeLine
            Move (SearchArray(sOverstrikeLine, asObjectNames)) to iPos
            Move (iPos = -1) to bWriteLine
        End

        Function_Return bWriteLine
    End_Function

    Function IsRegisterAllObjectsStart String sLine Returns Boolean
        Boolean bFound
        Move (sLine contains (CS_CommentSymbol * CS_RegisterAllObjects)) to bFound
        Function_Return bFound
    End_Function

    /* A legacy image's NAME OPTION: the 1-based position of the word sOptionLow (lowercase) on the
       image's name line - 7 for 'resident' in '/Body Resident' - or 0 when the line opens no image
       or carries no such word. RemoveResidentImageOption and Deep Scan's eDSImageOption rule both
       read the line through this, so the scan and the fix find the same word.

       Only the words AFTER the name count, so an image that is itself called Resident keeps its
       name, and the search stops at a '//' comment. A word counts only when spaces or tabs
       separate it. The DataFlex help allows the option without them ("need not be delimited by
       spaces"), but an image name can hold a '.' of its own ('/DFScript.Sample1'), so a cut at
       punctuation could cut into the name; such a line is left as written. */
    Function _ImageNameOptionPos String sLine String sOptionLow Returns Integer
        Integer iLen iPos iStart
        Boolean bStart

        Get IsImageStart sLine to bStart
        If (bStart = False) ;
            Function_Return 0
        Move (Length(sLine)) to iLen
        // Step over the name. Only blanks stand before its '/' (IsImageStart), so Pos finds that one.
        Move (Pos(CS_ImageNameStart, sLine) + 1) to iPos
        While (iPos <= iLen and Trim(Mid(sLine, 1, iPos)) <> "")
            Increment iPos
        Loop
        // Then word by word: skip the blanks, read up to the next blank.
        While (iPos <= iLen)
            While (iPos <= iLen and Trim(Mid(sLine, 1, iPos)) = "")
                Increment iPos
            Loop
            Move iPos to iStart
            While (iPos <= iLen and Trim(Mid(sLine, 1, iPos)) <> "")
                Increment iPos
            Loop
            If (iPos > iStart) Begin
                If (Mid(sLine, 2, iStart) = "//") ;
                    Function_Return 0
                If (Lowercase(Mid(sLine, (iPos - iStart), iStart)) = sOptionLow) ;
                    Function_Return iStart
            End
        Loop
        Function_Return 0
    End_Function

    /* The image name line without its sOptionLow word: the word goes with the blanks in front of
       it, whatever follows it stays, and blanks left at the end of the line go too ('/Body
       Resident' becomes '/Body', '/Screen Resident Help' becomes '/Screen Help'). Every such word
       goes, should a line repeat it. A line without the word comes back as it was - see
       _ImageNameOptionPos for what counts as the word. */
    Function _RemoveImageNameOption String sLine String sOptionLow Returns String
        Integer iAt iCut iEnd
        String sAfter

        Get _ImageNameOptionPos sLine sOptionLow to iAt
        While (iAt > 0)
            Move (iAt + Length(sOptionLow)) to iEnd
            Move (Right(sLine, (Length(sLine) - iEnd + 1))) to sAfter
            Move (iAt - 1) to iCut
            While (iCut > 0 and Trim(Mid(sLine, 1, iCut)) = "")
                Decrement iCut
            Loop
            If (Trim(sAfter) = "") ;
                Move (Left(sLine, iCut)) to sLine
            Else ;
                Move (Left(sLine, iCut) + sAfter) to sLine
            Get _ImageNameOptionPos sLine sOptionLow to iAt
        Loop
        Function_Return sLine
    End_Function

    // It is assumed that the sWord is neither blank or part of a comment or text constant.
    // Check if the "sWord" is a local variable declaraction *array* (exist in pasLocalVariableTypes)
    Function IsVariableArrayDeclaration String sOverstrikeLine Returns Boolean
        Boolean bFound
        String[] asLocalVariableArrayTypes
        Integer iItem iPos
        String sVariableType

        Get pasLocalVariableArrayTypes to asLocalVariableArrayTypes
        Move (Trim(Lowercase(sOverstrikeLine))) to sOverstrikeLine

        Move (sOverstrikeLine = Lowercase(CS_Local)) to bFound
        If (bFound = False) Begin
            Move (sOverstrikeLine = "global_variable") to bFound
        End
        If (bFound = False) Begin
            Move (Pos(CS_S, sOverstrikeLine)) to iPos
            If (iPos <> 0) Begin
                Move (Left(sOverstrikeLine, (iPos -1))) to sVariableType
            End
            Move (SearchArray(sVariableType, asLocalVariableArrayTypes)) to iItem
            Move (iItem <> -1) to bFound
        End
        Function_Return bFound
    End_Function

    Function IsVariableDeclarationLine String sOverstrikeLine Returns Boolean
        Boolean bVariableDeclaration bErr
        String[] asLocalVariableTypes asLocalVariableArrayTypes asScopeStart asScopeEnd asKeyWords
        String[] asRemovedCommands asCommands asCommandFunctions 
        Integer iItem iPos iLastErr
        String sToken sChar sAlphabet
        tTokenizer TokenizerData
        
        Move False to bVariableDeclaration  
        Get _RetrieveFirstToken sOverstrikeLine to sToken
        Move (Lowercase(Trim(sToken))) to sToken

        // Simple False cases
        If (sToken = "") Begin
            Function_Return False
        End
        Move (Left(sToken, 1)) to sChar 
        If (not(CS_LowercaseAlphabet contains sChar)) Begin
            Function_Return False
        End
        If (pbIsInDF23MultiLineComment(Self) = True) Begin
            Function_Return False
        End
        If (pbIsInSemiColonMultiLineString(Self) = True) Begin
            Function_Return False
        End
        If (piMultiLineStringType(Self) <> MLS_None) Begin
            Function_Return False
        End  
        If (pbInCommand(Self) = True) Begin
            Function_Return False
        End
        If (pbInStruct(Self) = True) Begin
            Function_Return False
        End
        If (pbIsInPage(Self) = True) Begin
            Function_Return False
        End

        // True cases:
        If (Right(sToken, 2) = "[]") Begin
            Function_Return True
        End
        Move (sToken = Lowercase(CS_Local)) to bVariableDeclaration
        If (bVariableDeclaration = True) Begin
            Function_Return True
        End
        Move (sToken = Lowercase(CS_GlobalVariable)) to bVariableDeclaration
        If (bVariableDeclaration = True) Begin
            Function_Return True
        End
        Get pasLocalVariableTypes to asLocalVariableTypes
        Move (SearchArray(sToken, asLocalVariableTypes)) to iItem
        If (iItem <> -1) Begin
            Function_Return True
        End
        Get pasLocalVariableArrayTypes to asLocalVariableArrayTypes
        Move (SearchArray(sToken, asLocalVariableArrayTypes, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return True
        End
        
        // More False cases:
        // Note: These tests must be after the two asLocalVariableXXX above, as they exist here as well.
        Get pasKeyWords to asKeyWords
        Move (SearchArray(sToken, asKeyWords, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        Get pasScopeStart to asScopeStart
        Move (SearchArray(sToken, asScopeStart, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        Get pasScopeEnd to asScopeEnd
        Move (SearchArray(sToken, asScopeEnd, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        Get pasRemovedCommands to asRemovedCommands
        Move (SearchArray(sToken, asRemovedCommands, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        Get pasCommands to asCommands
        Move (SearchArray(sToken, asCommands, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        Get pasCommandFunctions to asCommandFunctions
        Move (SearchArray(sToken, asCommandFunctions, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem <> -1) Begin
            Function_Return False
        End
        
        If (bVariableDeclaration = False) Begin
            Set pbIgnoreErrorState to True  
            Send Ignore_Error of ghoErrorHandler DFERR_BAD_SYMBOL_EXPRESSION
            // Some tokens (e.g. "Field_Changed_State") make Eval("_struct_"+token) raise FUNCTION_NOT_FOUND_IN_
            // EXPRESSION (4367) instead of BAD_SYMBOL_EXPRESSION (54) - ignore that too, or it ESCAPES during
            // plan-building (a tokenizer pass outside a refactor RUN) and crashes. The engine's
            // pbIgnoreErrorState handler only suppresses errors while the ENGINE is the active error object (a
            // refactor RUN), NOT here; this probe should treat ANY resolution failure as "not a struct type".
            Send Ignore_Error of ghoErrorHandler DFERR_FUNCTION_NOT_FOUND_IN_EXPRESSION
            Move Err to bErr
            Move LastErr to iLastErr
            Move False to Err
            Move (Eval("_struct_" + sToken)) to bVariableDeclaration 
            If (Err = True) Begin
                Move False to bVariableDeclaration
            End
            Send Trap_Error of ghoErrorHandler DFERR_BAD_SYMBOL_EXPRESSION
            Send Trap_Error of ghoErrorHandler DFERR_FUNCTION_NOT_FOUND_IN_EXPRESSION
            Move bErr to Err        
            Move iLastErr to LastErr
            Set pbIgnoreErrorState to False
        End
        
        Function_Return bVariableDeclaration
    End_Function

    Function IsValidRemoveEndCommentsLine String sLine Returns Boolean
        String sText
        Boolean bFound
        
        Move (Trim(Lowercase(sLine))) to sText
        Move (sText contains Lowercase(CS_EndClass)) to bFound
        If (bFound = False) Begin
            Move (sText contains Lowercase(CS_EndObject)) to bFound
        End
        If (bFound = False) Begin
            Move (sText contains "cd_end_object") to bFound
        End
        If (bFound = False) Begin
            Move (sText contains Lowercase(CS_EndFunction)) to bFound
        End
        If (bFound = False) Begin
            Move (sText contains Lowercase(CS_EndProcedure)) to bFound
        End
        
        Function_Return bFound    
    End_Function
    
    // Tests if the lowercase character passed in sLine on position iPos is
    // a valid character for a class name
    Function IsValidClassCharacter String sOverstrikeLine Integer iPos Returns Boolean
        Boolean bIsValid
        String  sChar
        Move False to bIsValid
        Move (Mid(sOverstrikeLine, 1, iPos)) to sChar
        If ("abcdefghijklmnopqrstuvwxyz1234567890_" contains sChar) Begin
            Move True to bIsValid
        End
        Function_Return bIsValid
    End_Function

    // Takes an sOverstrikeLine line as parameter plus a tTokenizer struct.
    // Returns a string with all overstriked values replaced with the original content.
    Function RestoreOverstrikeLineValues String sOverstrikeLine tTokenizer TokenizerData Returns String
        Boolean bFound
        Integer iSize iCount iPos
        
        Move (SizeOfArray(TokenizerData.asStringConstant)) to iSize
        If (iSize = 0) Begin
            Function_Return sOverstrikeLine
        End                   
        
        Decrement iSize
        For iCount from 0 to iSize
            Move (Pos(TokenizerData.asStringConstant[iCount].sOverwrite, sOverstrikeLine)) to iPos
            If (iPos <> 0) Begin
                Move (Replace(TokenizerData.asStringConstant[iCount].sOverwrite, sOverstrikeLine, TokenizerData.asStringConstant[iCount].sContent)) to sOverstrikeLine
            End
        Loop
        Function_Return sOverstrikeLine
    End_Function 
    
    /* A LINE'S LEADING [BRACKET] as a single-indicator condition, from the overstrike line: "[Found]" ->
       "Found", "[~Found]" / "[Not Found]" -> "Not(Found)". "" when the line does not start with a bracket, the
       bracket is too short to hold a name, or it is compound ("[Found ~Found]") - shapes the composers leave
       alone. iBrEnd is the closing bracket's position, where the rest of the line begins. Shared by
       _ComposeBracketIfIndicateBlock and _ComposeBracketNoAsIndicate. */
    Function _LeadingBracketCondition String sOver Integer ByRef iBrEnd Returns String
        String sVar
        Boolean bNeg

        Move 0 to iBrEnd
        If (Left(sOver, 1) <> "[") ;
            Function_Return ""
        Move (Pos("]", sOver)) to iBrEnd
        If (iBrEnd < 3) ;                                      // need at least "[x]"
            Function_Return ""
        Move (Trim(Mid(sOver, (iBrEnd - 2), 2))) to sVar       // content between [ and ]
        Move False to bNeg
        If (Left(sVar, 1) = CS_Tilde) Begin
            Move True to bNeg
            Move (Trim(Mid(sVar, (Length(sVar) - 1), 2))) to sVar
        End
        Else If (Lowercase(Left(sVar, 4)) = "not ") Begin
            Move True to bNeg
            Move (Trim(Mid(sVar, (Length(sVar) - 4), 5))) to sVar
        End
        If (sVar = "" or (Pos(" ", sVar) > 0)) ;               // compound bracket e.g. [Found ~Found] -> skip
            Function_Return ""
        If (bNeg = True) ;
            Function_Return (CS_Not + "(" + sVar + ")")
        Function_Return sVar
    End_Function

    /* THE CONDITIONS OF CHAINED IFS (2026-10-31, _ComposeBracketIfIndicateBlock). sRaw is the text between a
       line's first If and its Indicate, sOver the same stretch of the masked line (equal length): when another If
       stands in it - outside strings and parentheses - each condition is parenthesised (one balanced group stays
       as it is) and they are joined with 'and': '(a ne 0) and (a ne b)'. "" when there is no further If, "-" when
       a condition is empty. */
    Function _ChainedIfGuard String sRaw String sOver Returns String
        String sPart sOut
        Integer iAt iFrom iLeft iRight
        Boolean bOne

        Move "" to sOut
        Move 1 to iFrom
        Move 1 to iAt
        Repeat
            Get _FindKeywordPos sOver CS_If True iAt to iAt
            If (iAt > 0) Begin
                Get _NumberOfParanthesis (Left(sOver, (iAt - 1))) (&iLeft) to iRight
                If (iLeft = iRight) Begin
                    Move (Trim(Mid(sRaw, (iAt - iFrom), iFrom))) to sPart
                    If (sPart = "") ;
                        Function_Return "-"
                    Get _IsSingleParenGroup sPart to bOne
                    If (bOne = False) ;
                        Move ("(" + sPart + ")") to sPart
                    If (sOut <> "") ;
                        Move (sOut + " and ") to sOut
                    Move (sOut + sPart) to sOut
                    Move (iAt + Length(CS_If)) to iFrom
                End
                Move (iAt + Length(CS_If)) to iAt
            End
        Until (iAt = 0)
        If (sOut = "") ;
            Function_Return ""
        Move (Trim(Mid(sRaw, Length(sRaw), iFrom))) to sPart
        If (sPart = "") ;
            Function_Return "-"
        Get _IsSingleParenGroup sPart to bOne
        If (bOne = False) ;
            Move ("(" + sPart + ")") to sPart
        Function_Return (sOut + " and " + sPart)
    End_Function

    /* TWO BOOLEANS IN THE LEADING BRACKETS (2026-11-01) - the statement's opening brackets written again as two
       groups, '[A] [B] <rest>' (bSplit), or as one, '[A B] <rest>'; "" when they hold no such pair. A pair is two
       groups of one boolean each, with or without a space between them, or one group of two. A boolean is one
       word, a '~' in front allowed; a 'Not', a third word or a third group is no pair. sRest is the statement after
       the brackets, trimmed. '[A][B]' MEANS '[A] [B]' - both must hold - but the tokenizer read it as one
       indicator named 'A][B', which came out as gbAB, a name nothing declares. Only brackets that open the
       statement: no statement starts with an array index, so 'aGrid[i][j]' is never one. */
    Function _LeadingTwoBooleans String sLine Boolean bSplit String ByRef sRest Returns String
        String sIndent sBody sGroup1 sGroup2 sWord
        String[] asWords asSplit
        Integer iAt iClose i j iLen

        Move "" to sRest
        Move 1 to iAt
        While (iAt <= Length(sLine) and (Mid(sLine, 1, iAt) = " " or Mid(sLine, 1, iAt) = Character(9)))
            Increment iAt
        Loop
        Move (Left(sLine, (iAt - 1))) to sIndent
        Move (Mid(sLine, Length(sLine), iAt)) to sBody
        If (Left(sBody, 1) <> "[") ;
            Function_Return ""
        Move (Pos("]", sBody)) to iClose
        If (iClose = 0) ;
            Function_Return ""
        Move (Mid(sBody, (iClose - 2), 2)) to sGroup1
        Move (LTrim(Mid(sBody, Length(sBody), (iClose + 1)))) to sBody
        Move "" to sGroup2
        If (Left(sBody, 1) = "[") Begin
            Move (Pos("]", sBody)) to iClose
            If (iClose = 0) ;
                Function_Return ""
            Move (Mid(sBody, (iClose - 2), 2)) to sGroup2
            Move (LTrim(Mid(sBody, Length(sBody), (iClose + 1)))) to sBody
            If (Left(sBody, 1) = "[") ;
                Function_Return ""
        End
        // The words of each group: one each from two groups, or two from one.
        For j from 1 to 2
            If (j = 1) ;
                Move (StrSplitToArray(Replaces(Character(9), sGroup1, " "), " ")) to asSplit
            Else ;
                Move (StrSplitToArray(Replaces(Character(9), sGroup2, " "), " ")) to asSplit
            Move 0 to iLen
            For i from 0 to (SizeOfArray(asSplit) - 1)
                If (asSplit[i] <> "") Begin
                    Move asSplit[i] to asWords[SizeOfArray(asWords)]
                    Increment iLen
                End
            Loop
            If (j = 2 and sGroup2 <> "" and iLen <> 1) ;
                Function_Return ""
            If (j = 1 and sGroup2 <> "" and iLen <> 1) ;
                Function_Return ""
        Loop
        If (SizeOfArray(asWords) <> 2) ;
            Function_Return ""
        For i from 0 to 1
            Move asWords[i] to sWord
            If (Left(sWord, 1) = "~") ;
                Move (Mid(sWord, Length(sWord), 2)) to sWord
            If (sWord = "" or Lowercase(sWord) = "not") ;
                Function_Return ""
            For j from 1 to (Length(sWord))
                If (Pos(Lowercase(Mid(sWord, 1, j)), "abcdefghijklmnopqrstuvwxyz0123456789_@#$") = 0) ;
                    Function_Return ""
            Loop
        Loop
        Move (Trim(sBody)) to sRest
        If (bSplit = True) ;
            Move (sIndent + "[" + asWords[0] + "] [" + asWords[1] + "]") to sBody
        Else ;
            Move (sIndent + "[" + asWords[0] + " " + asWords[1] + "]") to sBody
        If (sRest <> "") ;
            Move (sBody + " " + sRest) to sBody
        Function_Return sBody
    End_Function

    /* TWO LEADING BRACKETS AND AN INDICATE (2026-10-31): '[Found] [~X] Indicate Found as T.Kind eq "C"' runs the
       Indicate when BOTH hold. The bracket path read the second bracket as the Indicate's target - 'If (Found)
       Move (T.Kind eq "C") to Not(gbX)', error 4345 - and the real target was lost. Composed here as one guarded
       line, the end comment kept: 'If (Found and Not(X)) Move (T.Kind eq "C") to Found'. "" for every other
       shape - a third bracket, a compound bracket, no Indicate right after the brackets, a no-"as" value of more
       than one token - which the caller leaves to the existing paths. */
    Function _ComposeStackedBracketIndicate tTokenizer TokenizerData Returns String
        String sOver sLine sCond1 sCond2 sRest sTarget sExpr sExprW sMaskTmp sOut
        Integer iBrEnd1 iBrEnd2 iIndPos iAsPos iOffset
        Boolean bOne

        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        Move TokenizerData.sLine to sLine
        Get _LeadingBracketCondition sOver (&iBrEnd1) to sCond1
        If (sCond1 = "") ;
            Function_Return ""
        Move (Trim(Mid(sOver, Length(sOver), (iBrEnd1 + 1)))) to sRest
        Get _LeadingBracketCondition sRest (&iBrEnd2) to sCond2
        If (sCond2 = "") ;
            Function_Return ""
        Move (Trim(Mid(sRest, Length(sRest), (iBrEnd2 + 1)))) to sRest
        If (Lowercase(Left(sRest, 9)) <> (Lowercase(CS_Indicate) + CS_S)) ;
            Function_Return ""
        // Positions in the masked line, text from the original - as _ComposeBracketIfIndicateBlock does.
        Get _FindKeywordPos sOver CS_Indicate True 1 to iIndPos
        If (iIndPos = 0) ;
            Function_Return ""
        Get _FindKeywordPos sOver CS_As True (iIndPos + 8) to iAsPos
        Move (Pos("[", sLine) - Pos("[", sOver)) to iOffset
        If (iAsPos > 0) Begin
            Move (Trim(Mid(sLine, (iAsPos - iIndPos - 8),       (iIndPos + 8 + iOffset))))  to sTarget
            Move (Trim(Mid(sLine, (Length(sOver) - iAsPos - 1), (iAsPos + 2 + iOffset))))   to sExpr
            Get _MaskStringLiterals sExpr to sMaskTmp
            Get _TrimTrailingExcessParens sExpr sMaskTmp to sExpr
        End
        Else Begin
            Move (Trim(Mid(sLine, (Length(sLine) - (iIndPos + 8 + iOffset) + 1), (iIndPos + 8 + iOffset)))) to sExpr
            If (TokenizerData.sEndComment <> "" and (sExpr contains TokenizerData.sEndComment)) ;
                Move (Trim(Replace(TokenizerData.sEndComment, sExpr, ""))) to sExpr
            Get _NthWord sExpr 1 to sTarget
            Move (Trim(Mid(sExpr, Length(sExpr), (Length(sTarget) + 2)))) to sExpr
            If (Pos(" ", sExpr) > 0) ;
                Function_Return ""
        End
        If (sTarget = "" or sExpr = "" or (Pos(" ", sTarget) > 0)) ;
            Function_Return ""
        Get _IsSingleParenGroup sExpr to bOne
        If (bOne = True) ;
            Move sExpr to sExprW
        Else ;
            Move ("(" + sExpr + ")") to sExprW
        Move (TokenizerData.sIndentation + CS_If + " (" + sCond1 + " and " + sCond2 + ") " + CS_Move + CS_S + sExprW + CS_S + CS_To + CS_S + sTarget) to sOut
        If (TokenizerData.sEndComment <> "") ;
            Move (sOut + CS_S + TokenizerData.sEndComment) to sOut
        Function_Return sOut
    End_Function

    // Compose the explicit guarded block for a LEADING bracket + If + "Indicate ... as ..." compound, e.g.
    //     [Found] If sResult ne "" Indicate Found as StatLog.Function_Name eq sData
    // becomes (original indentation preserved):
    //     If (Found and (sResult ne "")) Begin
    //         Move (StatLog.Function_Name eq sData) to Found
    //     End
    // The plain single-line indicator transform cannot compose this 3-way shape (it produced garbage like
    // "If Indicate (Found) to Found"), so ChangeLegacyIndicators delegates that exact shape here.
    //   - Keyword POSITIONS (If / Indicate / as) are found in the string-masked overstrike line, so a keyword
    //     inside a string or a parenthesised expression is never matched.
    //   - The condition / target / expression TEXT is then sliced from sLine (the UNTOUCHED original) so a
    //     parenthesised condition like "(sCust<>"")" - which the overstrike line masks with "|" fill, and
    //     which a string-only restore could not rebuild - comes through verbatim. Masking preserves length,
    //     so one offset (the indent sLine keeps but the overstrike line drops) maps positions across.
    // The bracket is read from the overstrike line (a spaced/negated form is captured whole). Guards are
    // AND-combined with the condition parenthesised (DataFlex would otherwise parse "a and b ne c" as
    // "(a and b) ne c"), and the Indicate expression parenthesised for the Move - but NEITHER is double-
    // wrapped when already a single parenthesised token. ne/eq/<> are left as-is (a separate operator refactor
    // handles those). Returns "" for shapes it will NOT touch (compound bracket, missing/out-of-order
    // If/Indicate/as) - which the caller then leaves unchanged (no corruption).
    Function _ComposeBracketIfIndicateBlock tTokenizer TokenizerData Returns String
        String sOver sLine sBracketExpr sCond sTarget sExpr sExprW sBlock sIndent sGuard sMaskTmp sChained
        Integer iBrEnd iIfPos iIndPos iAsPos iOffset
        Boolean bCondParen

        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        Move TokenizerData.sLine to sLine
        Get _LeadingBracketCondition sOver (&iBrEnd) to sBracketExpr
        If (sBracketExpr = "") ;
            Function_Return ""

        // --- locate If / Indicate / as by POSITION in the masked overstrike line (so a keyword inside a
        //     string or a parenthesised expression is never matched), then slice the TEXT from sLine (the
        //     UNTOUCHED original). The overstrike line masks a parenthesised condition "(sCust<>"")" with "|"
        //     fill and a string-only restore could not rebuild it - sLine has the real text. Masking
        //     preserves length, so one offset (the indent sLine keeps but the overstrike line drops) maps
        //     the positions across. ---
        Get _FindKeywordPos sOver CS_If       True (iBrEnd + 1)  to iIfPos
        If (iIfPos = 0) ;
            Function_Return ""
        Get _FindKeywordPos sOver CS_Indicate True (iIfPos + 2)  to iIndPos
        If (iIndPos = 0) ;
            Function_Return ""
        Get _FindKeywordPos sOver CS_As       True (iIndPos + 8) to iAsPos
        Move (Pos("[", sLine) - Pos("[", sOver)) to iOffset    // sLine keeps the indent; sOver does not
        Move (Trim(Mid(sLine, (iIndPos - iIfPos - 2), (iIfPos + 2 + iOffset)))) to sCond    // If..Indicate

        If (iAsPos > 0) Begin
            // with-"as" form: 'Indicate <target> as <expr>'
            Move (Trim(Mid(sLine, (iAsPos - iIndPos - 8),       (iIndPos + 8 + iOffset))))  to sTarget  // Indicate..as
            Move (Trim(Mid(sLine, (Length(sOver) - iAsPos - 1), (iAsPos + 2 + iOffset))))   to sExpr    // after as
            // Legacy Indicate ignored trailing junk - trim a typo'd excess ")" (string-masked count).
            Get _MaskStringLiterals sExpr to sMaskTmp
            Get _TrimTrailingExcessParens sExpr sMaskTmp to sExpr
        End
        Else Begin
            // no-"as" form: 'Indicate <target> <value>' -> Move (<value>) to <target>. Mode 5 (LegacyApp
            // '[Found] If A eq B Indicate HITTAT FALSE'): used to bail here and be SKIPPED, leaving 'Indicate
            // HITTAT' to clash with HITTAT's Boolean declaration (4345 MUST BE AN INDICATOR). Take the
            // after-Indicate text to EOL, drop the end comment, split target (1st word) + single-token value.
            Move (Trim(Mid(sLine, (Length(sLine) - (iIndPos + 8 + iOffset) + 1), (iIndPos + 8 + iOffset)))) to sExpr
            If (TokenizerData.sEndComment <> "" and (sExpr contains TokenizerData.sEndComment)) ;
                Move (Trim(Replace(TokenizerData.sEndComment, sExpr, ""))) to sExpr
            Get _NthWord sExpr 1 to sTarget
            Move (Trim(Mid(sExpr, Length(sExpr), (Length(sTarget) + 2)))) to sExpr   // value = text after the target
            If (Pos(" ", sExpr) > 0) ;                          // no-"as" value must be a SINGLE token (the
                Function_Return ""                              // with-"as" sExpr is an expression and may have spaces)
        End
        If (sCond = "" or sTarget = "" or sExpr = "" or (Pos(" ", sTarget) > 0)) ;
            Function_Return ""
        /* CHAINED IFS (2026-10-31): in '[X] If a ne 0 If a ne b Indicate X False' the second If is another
           condition, and the Indicate runs when all of them hold. The text between the first If and Indicate
           went into the guard whole - '(gbX and (a <> 0 If a <> b))', error 52. _ChainedIfGuard cuts it at every
           further If and parenthesises each part; "-" refuses the line. */
        Get _ChainedIfGuard (Mid(sLine, (iIndPos - iIfPos - 2), (iIfPos + 2 + iOffset))) (Mid(sOver, (iIndPos - iIfPos - 2), (iIfPos + 2))) to sChained
        If (sChained = "-") ;
            Function_Return ""

        // --- guard: AND-combine; parenthesise cond + expr for precedence, but do NOT double-wrap one that is
        //     already a single parenthesised expression (e.g. cond "(sCust<>"")"). ---
        // _IsSingleParenGroup, not a first/last-char check: '(a) and (b)' / '(A) = (B)' must
        // still be wrapped - only ONE balanced group may pass verbatim (2026-07-24).
        Get _IsSingleParenGroup sCond to bCondParen
        If (sChained <> "") ;
            Move (sBracketExpr + " and " + sChained) to sGuard
        Else If (bCondParen = True) ;
            Move (sBracketExpr + " and " + sCond) to sGuard
        Else ;
            Move (sBracketExpr + " and (" + sCond + ")") to sGuard
        Get _IsSingleParenGroup sExpr to bCondParen
        If (bCondParen = True) ;
            Move sExpr to sExprW
        Else ;
            Move ("(" + sExpr + ")") to sExprW

        // --- assemble the block (indent each line; keep the end comment) ---
        Move TokenizerData.sIndentation to sIndent
        Move (sIndent + CS_If + " (" + sGuard + ") " + CS_Begin) to sBlock
        Append sBlock C_NewLine sIndent "    " CS_Move CS_S sExprW CS_S CS_To CS_S sTarget
        If (TokenizerData.sEndComment <> "") ;
            Append sBlock CS_S TokenizerData.sEndComment
        Append sBlock C_NewLine sIndent "End"
        Function_Return sBlock
    End_Function

    // Compose the correct one-line guarded Move for a LEADING bracket + a no-"as" Indicate, e.g.
    //     [FINDERR] Indicate HITTAT FALSE   ->   If (FINDERR) Move (FALSE) to HITTAT
    // The old bStartBracket path (_ChangeLegacyIndicators_Sub) reuses the BRACKET indicator as the Move source
    // for this shape ("If (FINDERR) Move (FINDERR)"), dropping the real target + value. Every TESTED [bracket]
    // Indicate carries an "as"; THIS handles only the untested no-"as" form. Returns "" for: a non-bracket line,
    // a compound bracket, a non-Indicate rest, the with-"as" form (the existing path composes it correctly), or a
    // multi-token value - all of which the caller leaves to the existing path unchanged. A built-in indicator
    // (FindErr/Found) comes through as its own name, which IS the modern boolean - never a variable rewrite.
    Function _ComposeBracketNoAsIndicate tTokenizer TokenizerData Returns String
        String sOver sCond sRest sTarget sValue sLine sIndent
        Integer iBrEnd

        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        Get _LeadingBracketCondition sOver (&iBrEnd) to sCond
        If (sCond = "") ;
            Function_Return ""

        // the rest after the bracket must be a no-"as" Indicate
        Move (Trim(Mid(sOver, Length(sOver), (iBrEnd + 1)))) to sRest
        If (Lowercase(Left(sRest, 9)) <> (Lowercase(CS_Indicate) + CS_S)) ;   // not "Indicate " -> skip
            Function_Return ""
        Move (Trim(Mid(sRest, Length(sRest), 10))) to sRest                   // drop "Indicate "
        If (Lowercase(sRest) contains (CS_S + Lowercase(CS_As) + CS_S)) ;     // with-"as" form -> existing path
            Function_Return ""
        Get _NthWord sRest 1 to sTarget
        If (sTarget = "") ;
            Function_Return ""
        Move (Trim(Mid(sRest, Length(sRest), (Length(sTarget) + 2)))) to sValue
        If (sValue = "" or (Pos(CS_S, sValue) > 0)) ;                         // need a single-token value -> skip
            Function_Return ""
        Get RestoreOverstrikeLineValues sValue TokenizerData to sValue

        Move TokenizerData.sIndentation to sIndent
        Move (sIndent + CS_If + " (" + sCond + ") " + CS_Move + " (" + sValue + ") " + CS_To + " " + sTarget) to sLine
        If (TokenizerData.sEndComment <> "") ;
            Append sLine CS_S TokenizerData.sEndComment
        Function_Return sLine
    End_Function

    /* 'Ind' is Indicate's obsolete spelling - DataFlex 26's dafmac.pkg defines '#COMMAND Ind R' as
       'Indicate !1 !2 ...' - and a character-mode program writes it wherever it would write Indicate.
       Where on a line does an Ind COMMAND stand? sOver is the masked line (TokenizerData.sOverstrikeLine,
       trimmed: strings overstruck, no indentation, no end comment); the result is the 1-based position of
       the word in it, 0 when there is none. A command stands first on the line, after a leading Else,
       right after a leading '[...]' indicator group, or after the condition of an If. Only the first was
       read until GitHub 2026-10-06 (a DataFlex 3.2 program), and '[ found] ind found as <a> eq <b>' came
       out of a run as 'If (found) ind found as (<a> eq <b>) to'. Away from the line start the word counts
       only where Indicate's own grammar follows it - a name, then As / True / False / Group / Status -
       because ind is a fair variable name too: 'If iCount gt ind ind ready True' reads the variable and
       sets the indicator, and '[found] Move ind to iCount' holds no Ind at all. */
    Function _IndCommandWordPos String sOver Returns Integer
        String[] asWords
        Integer[] aiPos
        String sLow sCh sWord
        Integer iLen i iCount iW iFrom iTo
        Boolean bInGroup bMore bGrammar

        Move (Lowercase(sOver)) to sLow
        // the cheap gate - no 'ind' with a blank after it, no Ind command; most lines end here
        If (not(sLow contains "ind ") and not(sLow contains ("ind" + Character(9)))) ;
            Function_Return 0
        // the words of the line and where each one starts
        Move (Length(sLow)) to iLen
        Move "" to sWord
        For i from 1 to (iLen + 1)
            If (i > iLen) ;
                Move " " to sCh
            Else ;
                Move (Mid(sLow, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) Begin
                If (sWord <> "") Begin
                    Move sWord               to asWords[-1]
                    Move (i - Length(sWord)) to aiPos[-1]
                    Move "" to sWord
                End
            End
            Else ;
                Move (sWord + sCh) to sWord
        Loop
        Move (SizeOfArray(asWords)) to iCount
        If (iCount < 2) ;
            Function_Return 0
        If (asWords[0] = "ind") ;
            Function_Return aiPos[0]

        // step over a leading Else and the leading '[...]' group(s) - a word that opens one, and every word
        // up to the one that closes it
        Move 0 to iW
        If (asWords[0] = "else") ;
            Move 1 to iW
        Move False to bInGroup
        Move True to bMore
        While (bMore = True and iW < iCount)
            If (bInGroup = True or Left(asWords[iW], 1) = "[") Begin
                Move (Pos("]", asWords[iW]) = 0) to bInGroup
                Increment iW
            End
            Else ;
                Move False to bMore
        Loop
        If (iW >= iCount) ;
            Function_Return 0
        // the command is the word after the group(s) - or, on an If line, any word after the condition,
        // which takes at least one word
        Move iW to iFrom
        Move iW to iTo
        If (asWords[iW] = "if") Begin
            Move (iW + 2)     to iFrom
            Move (iCount - 1) to iTo
        End
        For i from iFrom to iTo
            If (asWords[i] = "ind" and (i + 2) < iCount) Begin
                Move asWords[i + 2] to sWord
                Move (sWord = "as" or sWord = "true" or sWord = "false" or sWord = "group" or sWord = "status") to bGrammar
                If (bGrammar = True) ;
                    Get _IsIdentifierChar (Left(asWords[i + 1], 1)) to bGrammar
                If (bGrammar = True) ;
                    Function_Return aiPos[i]
            End
        Loop
        Function_Return 0
    End_Function

    // 'Else <statement>' (Nils 2026-10-06): the statement after the Else as a line of its own, for an
    // indicator converter to convert before the Else goes back in front - the paths of those converters
    // write their line from its start and keep nothing in front of the Indicate or the bracket. Returns
    // the statement (no indentation, its end comment kept) and sElse the Else as written; "" when the
    // line does not open with an Else word, nothing follows it, or the statement holds no '[' - and,
    // with bIndicateToo, no Indicate word either: nothing the converter would touch. Words are read on
    // the masked line (strings overstruck), the text taken from the raw one.
    Function _ElseStatementCopy tTokenizer TokenizerData String sLine Boolean bIndicateToo String ByRef sElse Returns String
        String sOver sRest
        Integer iAt
        Boolean bWorth

        Move "" to sElse
        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        If (Lowercase(Left(sOver, 5)) <> "else " and Lowercase(Left(sOver, 5)) <> ("else" + Character(9))) ;
            Function_Return ""
        Move (Trim(Mid(sOver, Length(sOver), 6))) to sRest
        If (sRest = "") ;
            Function_Return ""
        Move (Pos("[", sRest) > 0) to bWorth
        If (bWorth = False and bIndicateToo = True) ;
            Move (_FindKeywordPos(Self, sRest, CS_Indicate, True, 1) > 0) to bWorth
        If (bWorth = False) ;
            Function_Return ""
        Move (Length(TokenizerData.sIndentation) + 1) to iAt          // where the Else stands on the raw line
        If (Lowercase(Mid(sLine, 4, iAt)) <> "else") ;
            Function_Return ""
        Move (Mid(sLine, 4, iAt)) to sElse
        Function_Return (Trim(Mid(sLine, Length(sLine), (iAt + 4))))
    End_Function

    // Convert the legacy comparison operators (lt/le/eq/ne/gt/ge) inside ONE sliced piece of a
    // source line. sPieceOS is the piece as cut from the MASKED overstrike line (string content
    // overstruck, so an operator word inside a literal can never match); sPieceRaw is the same
    // piece cut from the raw line. The transform runs on the masked text and the string content
    // is restored afterwards; when the restore cannot reproduce the raw piece exactly (an
    // unexpected mask artifact), the RAW piece is returned VERBATIM - legacy operators inside a
    // parenthesised expression still compile, so no-transform is always safe; a wrong splice is not.
    Function _ConvertLegacyOpsInSlice String sPieceOS String sPieceRaw tTokenizer TokenizerData Returns String
        String sCheck
        If (sPieceOS = sPieceRaw) Begin
            Get ReplaceAllLegacyOperators sPieceOS to sPieceOS
            Function_Return sPieceOS
        End
        Get RestoreOverstrikeLineValues sPieceOS TokenizerData to sCheck
        If (sCheck <> sPieceRaw) ;
            Function_Return sPieceRaw
        Get ReplaceAllLegacyOperators sPieceOS to sPieceOS
        Get RestoreOverstrikeLineValues sPieceOS TokenizerData to sPieceOS
        Function_Return sPieceOS
    End_Function

    // _IsSingleParenGroup moved DOWN to cRefactorUtilities (2026-07-24) - the expression parser's
    // multi-token after-as store needs it, and a declaration must sit at/above its caller.

    // Compose the one-line guarded Move for an If with a PARENTHESISED condition followed by an
    // inline Indicate command (Nils 2026-07-08, found in a legacy customer workspace -
    // identifiers generalized), e.g.:
    //     If (MORE_ROWS) indicate MORE_ROWS as Orders.Due_Date LE dCutOff
    //   ->
    //     If (MORE_ROWS) Move (Orders.Due_Date <= dCutOff) to MORE_ROWS
    // (the caller then gb-renames the returned target, so BOTH sides become gbMORE_ROWS).
    // The parenthesised condition makes the expression extractor swallow everything after 'If'
    // into ONE pseudo-expression token, so BooleanIndicator.bHasIndicateCommand reads False and
    // the line used to fall out of ChangeLegacyIndicators UNCONVERTED - while the file-level
    // gb-rename (DeclareRefactoredIndicators PASS 2b) still renamed the Indicate TARGET, leaving
    // 'Indicate gbX ...' = a guaranteed 4345 MUST-BE-AN-INDICATOR compile error.
    // Keyword POSITIONS are located on the masked overstrike line (a keyword inside a string
    // never matches) and the TEXT is sliced from sLine (offset = the indentation the overstrike
    // line drops), mirroring _ComposeBracketIfIndicateBlock. Legacy comparison operators in the
    // condition and expression are converted via _ConvertLegacyOpsInSlice (string-content safe).
    // Returns "" - and the caller leaves the line UNCHANGED - for every shape it will not touch:
    // the If not at line start (Else If ...), a ';' line-continuation, a '[' anywhere (bracket
    // indicators belong to the other compose paths; an array index is indistinguishable cheaply),
    // the GROUP / STATUS Indicate forms (the word right after the target - a FIELD named status
    // on the 'as' side is not the form), a missing target/expression, a SELECT-family target
    // without the eModernizeSelect opt-in, or a multi-token no-'as' value.
    Function _ComposeIfCondIndicate tTokenizer TokenizerData Boolean bModernizeSelect String ByRef sTargetRaw Returns String
        String sOver sLine sIndent sCondOS sCondRaw sCond sTarget sExprOS sExprRaw sExpr sRest sValue sInLeft sInRight
        String[] asBlack
        Integer iIfPos iIndPos iAsPos iOffset iInPos
        Boolean bSingle bNeg bCondReady

        Move "" to sTargetRaw
        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        Move TokenizerData.sLine to sLine
        If (Right(sOver, 1) = ";") ;                            // line-continuation: the statement is incomplete here
            Function_Return ""
        If (Pos("[", sOver) > 0) ;                              // bracket form -> other compose paths / out of scope
            Function_Return ""
        Get _FindKeywordPos sOver CS_If True 1 to iIfPos
        If (iIfPos <> 1) ;                                      // only a line-STARTING If is understood
            Function_Return ""
        Get _FindKeywordPos sOver CS_Indicate True (iIfPos + 2) to iIndPos
        If (iIndPos = 0) ;
            Function_Return ""
        // GROUP (multi-indicator, docs form 4) and STATUS (buffer-status, form 6) have no one-line
        // Move equivalent - leave the line (and its compiler warning) alone. In BOTH forms the keyword
        // is the word RIGHT AFTER the target ('Indicate <ind> GROUP ...' / 'Indicate <ind> STATUS
        // <file>'), so test exactly that word. A whole-word search over the rest of the line false-hit
        // on a TABLE FIELD named status/group on the 'as' side ('Indicate Select as DRAFT_A.STATUS Eq
        // "A"' - '.' is a token boundary), declined the line, and ChangeLegacyOperators then mangled
        // the still-legacy line into an Indicate inside an expression = Error 52 on 30+ WinServ lines
        // (Nils 2026-08-17). ('ALL' is only ever a word INSIDE the GROUP form - no separate check.)
        Move (Trim(Mid(sOver, Length(sOver), (iIndPos + 8)))) to sRest        // after 'Indicate '
        Get _NthWord sRest 2 to sValue                                       // word after the target
        Move (Lowercase(sValue)) to sValue
        If (sValue = "group" or sValue = "status") ;
            Function_Return ""

        Move (Length(TokenizerData.sIndentation)) to iOffset    // sLine keeps the indent; sOver does not
        Move (Trim(Mid(sOver, (iIndPos - iIfPos - 2), (iIfPos + 2))))           to sCondOS   // If..Indicate
        Move (Trim(Mid(sLine, (iIndPos - iIfPos - 2), (iIfPos + 2 + iOffset)))) to sCondRaw
        If (sCondRaw = "") ;
            Function_Return ""
        // Leading NOT: legacy 'IF NOT <cond> <stmt>' carries the negation in the COMMAND, not in
        // the expression - the BooleanIndicator parse captures the bare 'not' as the whole
        // condition and the Case rebuild emitted 'IF (NOT) Move ...' (Nils 2026-07-09). Strip it
        // here and re-wrap the rest as Not(...) below. The strip is identical in the OS and RAW
        // slices (identical leading text), so the pair stays aligned for the ops-roundtrip.
        Move False to bNeg
        If (_FindKeywordPos(Self, sCondOS, CS_Not, True, 1) = 1) Begin
            Move True to bNeg
            Move (Trim(Mid(sCondOS,  Length(sCondOS),  4))) to sCondOS
            Move (Trim(Mid(sCondRaw, Length(sCondRaw), 4))) to sCondRaw
            If (sCondRaw = "") ;
                Function_Return ""
        End
        // The legacy IN operator is compile-INVALID inside a parenthesised expression (Error 52,
        // verified 2026-07-13), so it cannot be wrapped as-is. Convert it here the way ChangeInToContains
        // does - 'A IN B' -> '(B Contains A)' (operands swapped; Contains IS a valid expression operator) -
        // for the SIMPLE case: a lone IN with single-token operands. (ChangeInToContains owns the
        // standalone IN rewrite and normally runs first, but IN emits no warning, so a warning-selected
        // Indicate line never triggers it - the reason the auto-fix never landed. Nils 2026-07-13.)
        // MATCH has no verified expression form -> still bail. Anything more complex than a lone IN
        // (a second IN, or non-single-token operands = IN mixed with another operator) also bails.
        Move False to bCondReady
        If (_FindKeywordPos(Self, sCondOS, "match", True, 1) > 0) ;
            Function_Return ""
        Get _FindKeywordPos sCondOS "in" True 1 to iInPos
        If (iInPos > 0) Begin
            If (_FindKeywordPos(Self, sCondOS, "in", True, (iInPos + 2)) > 0) ;
                Function_Return ""
            Move (Trim(Left(sCondRaw, (iInPos - 1))))                  to sInLeft
            Move (Trim(Mid(sCondRaw, Length(sCondRaw), (iInPos + 2)))) to sInRight
            If (sInLeft = "" or sInRight = "" or Pos(CS_S, sInLeft) > 0 or Pos(CS_S, sInRight) > 0) ;
                Function_Return ""
            Move ("(" + sInRight + CS_S + CS_Contains + CS_S + sInLeft + ")") to sCond
            Move True to bCondReady
        End

        Get _FindKeywordPos sOver CS_As True (iIndPos + 8) to iAsPos
        If (iAsPos > 0) Begin
            // with-"as" form: 'Indicate <target> as <expr>'
            Move (Trim(Mid(sOver, (iAsPos - iIndPos - 8), (iIndPos + 8))))              to sTarget   // Indicate..as
            Move (Trim(Mid(sOver, (Length(sOver) - iAsPos - 1), (iAsPos + 2))))         to sExprOS   // after as
            Move (Trim(Mid(sLine, (Length(sOver) - iAsPos - 1), (iAsPos + 2 + iOffset)))) to sExprRaw
            // Legacy Indicate ignored trailing junk - trim a typo'd excess ")" from BOTH twins
            // (the overstruck copy is the string-safe counting source for each).
            Get _TrimTrailingExcessParens sExprRaw sExprOS to sExprRaw
            Get _TrimTrailingExcessParens sExprOS  sExprOS to sExprOS
            If (sExprOS = "") ;
                Function_Return ""
            // Same IN / MATCH bail as the condition above.
            If (_FindKeywordPos(Self, sExprOS, "in",    True, 1) > 0 or ;
                _FindKeywordPos(Self, sExprOS, "match", True, 1) > 0) ;
                Function_Return ""
            Get _ConvertLegacyOpsInSlice sExprOS sExprRaw TokenizerData to sExpr
            Get _IsSingleParenGroup sExprOS to bSingle
            If (bSingle = False) ;
                Move ("(" + sExpr + ")") to sExpr
        End
        Else Begin
            // no-"as" form: 'Indicate <target> <value>' -> Move (<value>) to <target>. The value
            // must be a SINGLE token (mirrors _ComposeBracketNoAsIndicate).
            Move (Trim(Mid(sOver, (Length(sOver) - (iIndPos + 8) + 1), (iIndPos + 8)))) to sRest
            Get _NthWord sRest 1 to sTarget
            If (sTarget = "") ;
                Function_Return ""
            Move (Trim(Mid(sRest, Length(sRest), (Length(sTarget) + 2)))) to sValue
            If (sValue = "" or (Pos(CS_S, sValue) > 0)) ;
                Function_Return ""
            Get RestoreOverstrikeLineValues sValue TokenizerData to sValue
            Move ("(" + sValue + ")") to sExpr
        End
        If (sTarget = "" or (Pos(CS_S, sTarget) > 0) or (Pos("(", sTarget) > 0) or (Pos(")", sTarget) > 0)) ;
            Function_Return ""
        // SELECT (CS_NonRefactorableIndicators) keeps its legacy form unless the user opted in.
        If (bModernizeSelect = False) Begin
            Move (StrSplitToArray(Uppercase(CS_NonRefactorableIndicators), ",")) to asBlack
            If (SearchArray(Uppercase(sTarget), asBlack) <> -1) ;
                Function_Return ""
        End

        If (bCondReady = False) Begin
            Get _ConvertLegacyOpsInSlice sCondOS sCondRaw TokenizerData to sCond
            Get _IsSingleParenGroup sCondOS to bSingle
        End
        Else ;
            Move True to bSingle    // the composed '(B Contains A)' is already a single paren group
        // Wrap: 'IF NOT <cond>' -> '(Not(<cond>))' (reuse a single group's own parens - 'NOT (x)' ->
        // '(Not(x))', not '(Not((x)))'); a non-single plain condition gets one outer pair.
        If (bNeg = True) Begin
            If (bSingle = True) ;
                Move ("(" + CS_Not + sCond + ")") to sCond
            Else ;
                Move ("(" + CS_Not + "(" + sCond + "))") to sCond
        End
        Else If (bSingle = False) ;
            Move ("(" + sCond + ")") to sCond

        Move TokenizerData.sIndentation to sIndent
        Move (sIndent + CS_If + CS_S + sCond + CS_S + CS_Move + CS_S + sExpr + CS_S + CS_To + CS_S + sTarget) to sLine
        If (TokenizerData.sEndComment <> "") ;
            Append sLine CS_S TokenizerData.sEndComment
        Move sTarget to sTargetRaw
        Function_Return sLine
    End_Function

    // ChangeLegacyOperators' handling of 'If (<cond>) Indicate <target> as <comparison>' - the legacy
    // line the indicator converters left alone (eLeaveSelect, or a shape they decline). The expression
    // extractor swallows everything from the FIRST '(' to the comparison's right operand into ONE
    // fabricated token, so the generic token rebuild emitted 'If ((select) Indicate Select as
    // DRAFT_A.STATUS = "A")' - an Indicate COMMAND inside an expression: Error 52 "Bad format of
    // expression (operator) INDICATE" on 30+ WinServ lines (Nils 2026-08-17). Here the operators are
    // modernised WHERE THEY LIVE: inside the condition (already one paren group) and on the 'as' side,
    // which becomes the documented '(expression)' Indicate form (docs form 5) - valid legacy code that
    // compiles and that ChangeLegacyIndicators can still convert later. Positions come from the masked
    // overstrike line, text from sLine (offset = the indentation), the ops-roundtrip is string-content
    // safe (_ConvertLegacyOpsInSlice), and the raw 'Indicate <target> as' text is kept verbatim.
    // bIsShape reports whether the line IS this shape at all: the caller must then NEVER fall through
    // to the fabricating rebuild, even when "" comes back (nothing to convert). Out of scope ("" and
    // bIsShape False -> the generic path as before): a '[' anywhere, a ';' continuation, no line-start
    // If / Else If, or a condition that is not ONE balanced paren group (that is exactly the shape the
    // extractor swallows). A no-'as' form has no operator; an 'as' tail with IN / MATCH (compile-
    // invalid inside parens - ChangeInToContains owns IN) stays verbatim while the condition still
    // modernises.
    Function _ModernizeIfCondIndicateOps tTokenizer TokenizerData Boolean ByRef bIsShape Returns String
        String sOver sLine sPrefix sCondOS sCondRaw sCond sMidRaw sExprOS sExprRaw sExpr sNew
        Integer iIfPos iIndPos iAsPos iOffset
        Boolean bChanged bSingle bHasOp

        Move False to bIsShape
        Move (Trim(TokenizerData.sOverstrikeLine)) to sOver
        Move TokenizerData.sLine to sLine
        If (Right(sOver, 1) = ";" or Pos("[", sOver) > 0) ;
            Function_Return ""
        Get _FindKeywordPos sOver CS_If True 1 to iIfPos
        If (iIfPos <> 1) Begin
            // 'Else If (...) Indicate ...' is the same shape, one word in
            If (not(iIfPos = 6 and Lowercase(Left(sOver, 5)) = "else ")) ;
                Function_Return ""
        End
        Get _FindKeywordPos sOver CS_Indicate True (iIfPos + 2) to iIndPos
        If (iIndPos = 0) ;
            Function_Return ""
        Move (Trim(Mid(sOver, (iIndPos - iIfPos - 2), (iIfPos + 2)))) to sCondOS       // If..Indicate
        If (not(_IsSingleParenGroup(Self, sCondOS))) ;
            Function_Return ""
        Move True to bIsShape                     // from here on the caller must not use the generic rebuild
        Get _FindKeywordPos sOver CS_As True (iIndPos + 8) to iAsPos
        If (iAsPos = 0) ;                         // TRUE/FALSE, GROUP, STATUS forms carry no comparison
            Function_Return ""
        Move (Length(TokenizerData.sIndentation)) to iOffset                             // sLine keeps the indent; sOver does not
        Move (Trim(Mid(sLine, (iIndPos - iIfPos - 2), (iIfPos + 2 + iOffset))))     to sCondRaw
        Move (Trim(Mid(sOver, (Length(sOver) - iAsPos - 1), (iAsPos + 2))))          to sExprOS   // after 'as'
        Move (Trim(Mid(sLine, (Length(sOver) - iAsPos - 1), (iAsPos + 2 + iOffset))))  to sExprRaw
        If (sCondRaw = "" or sExprOS = "") ;
            Function_Return ""
        Move False to bChanged
        Get _ConvertLegacyOpsInSlice sCondOS sCondRaw TokenizerData to sCond
        If (sCond <> sCondRaw) ;
            Move True to bChanged
        Move sExprRaw to sExpr
        If (_FindKeywordPos(Self, sExprOS, "in", True, 1) = 0 and _FindKeywordPos(Self, sExprOS, "match", True, 1) = 0) Begin
            Get HasLegacyOperator sExprOS to bHasOp       // declared further down the class - message call, not an expression call
            If (bHasOp = True) Begin
                Get _ConvertLegacyOpsInSlice sExprOS sExprRaw TokenizerData to sExpr
                Get _IsSingleParenGroup sExprOS to bSingle
                If (bSingle = False) ;
                    Move ("(" + sExpr + ")") to sExpr
                Move True to bChanged
            End
        End
        If (bChanged = False) ;
            Function_Return ""
        // Raw prefix through the If keyword ('If' / 'Else If'); raw 'Indicate <target> as' verbatim.
        Move (Left(sLine, (iOffset + iIfPos + 1)))                            to sPrefix
        Move (Trim(Mid(sLine, (iAsPos + 2 - iIndPos), (iOffset + iIndPos))))  to sMidRaw
        Move (sPrefix + CS_S + sCond + CS_S + sMidRaw + CS_S + sExpr) to sNew
        If (TokenizerData.sEndComment <> "") ;
            Append sNew CS_S TokenizerData.sEndComment
        Function_Return sNew
    End_Function

    // ---------------- Gosub / Goto usage analysis (the GosubGotoReport cores) ----------------
    // Pure line/array functions - no engine state - so they are unit-testable
    // (oGosubGotoReport-Tests.pkg). All work on the CODE part of a raw source line (the caller
    // strips end comments); keyword matches are boundary-aware via _FindKeywordPos, so an
    // identifier merely CONTAINING "gosub"/"goto" never false-hits.

    // A label DEFINITION at line start: an unbroken identifier terminated by ':' (the docs'
    // definition). Returns the bare name (no colon), "" when the line defines no label.
    Function _GosubLineLabel String sTrim Returns String
        String sWord sCh
        Integer i iLen iAsc

        Get _NthWord sTrim 1 to sWord
        If (Right(sWord, 1) <> ":") ;
            Function_Return ""
        Move (Left(sWord, Length(sWord) - 1)) to sWord
        Move (Length(sWord)) to iLen
        If (iLen = 0) ;
            Function_Return ""
        For i from 1 to iLen
            Move (Mid(sWord, 1, i)) to sCh
            Move (Ascii(sCh)) to iAsc
            If (i = 1) Begin
                If (not((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or sCh = "_")) ;
                    Function_Return ""
            End
            Else Begin
                If (not((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or (iAsc >= 48 and iAsc <= 57) or sCh = "_")) ;
                    Function_Return ""
            End
        Loop
        Function_Return sWord
    End_Function

    // The target label(s) of a Gosub call on one code line: 'Gosub X' (line-start, or inline
    // after 'If ...' / a bracket guard) appends X; the computed 'ON <var> GOSUB l1 l2 ...'
    // dispatch appends EVERY listed label and returns bOnDispatch True. Targets are appended
    // LOWERCASED (the label namespace is case-insensitive); returns the number appended.
    Function _GosubCallTargets String sCode String[] ByRef asTargets Boolean ByRef bOnDispatch Returns Integer
        Integer iPos iOnPos iAdded iN
        String sRest sWord

        Move False to bOnDispatch
        Move 0 to iAdded
        Get _FindKeywordPos sCode "gosub" True 1 to iPos
        If (iPos = 0) ;
            Function_Return 0
        Get _FindKeywordPos sCode "on" True 1 to iOnPos
        If (iOnPos > 0 and iOnPos < iPos) ;
            Move True to bOnDispatch
        Move (Trim(Mid(sCode, Length(sCode), (iPos + 5)))) to sRest    // text after 'gosub'
        If (bOnDispatch = True) Begin
            Move 1 to iN
            Get _NthWord sRest iN to sWord
            While (sWord <> "")
                Move (Lowercase(sWord)) to asTargets[SizeOfArray(asTargets)]
                Increment iAdded
                Increment iN
                Get _NthWord sRest iN to sWord
            Loop
        End
        Else Begin
            Get _NthWord sRest 1 to sWord
            If (sWord <> "") Begin
                Move (Lowercase(sWord)) to asTargets[SizeOfArray(asTargets)]
                Increment iAdded
            End
        End
        Function_Return iAdded
    End_Function

    // Classifies a Gosub_Return on one code line: 0 = none, 1 = plain (resume after the calling
    // gosub - the SAFE form), 2 = 'Gosub_Return Return' (pops past a nested gosub),
    // 3 = 'Gosub_Return <label>' (jumps to the label and LEAVES the return address on the
    // stack - the Error-97 breeder; both 2 and 3 block a mechanical Procedure extraction).
    Function _GosubReturnKind String sCode Returns Integer
        Integer iPos
        String sRest sWord
        Get _FindKeywordPos sCode "gosub_return" True 1 to iPos
        If (iPos = 0) ;
            Function_Return 0
        Move (Trim(Mid(sCode, Length(sCode), (iPos + 12)))) to sRest   // text after 'gosub_return'
        If (sRest = "") ;
            Function_Return 1
        Get _NthWord sRest 1 to sWord
        If (Lowercase(sWord) = "return") ;
            Function_Return 2
        Function_Return 3
    End_Function

    // The target label of a Goto on one code line (lowercased), "" when the line has none.
    Function _GotoTarget String sCode Returns String
        Integer iPos
        String sRest sWord
        Get _FindKeywordPos sCode "goto" True 1 to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (Trim(Mid(sCode, Length(sCode), (iPos + 4)))) to sRest    // text after 'goto'
        Get _NthWord sRest 1 to sWord
        Function_Return (Lowercase(sWord))
    End_Function

    /* The COMMAND-position 'Return' - the gosub-era spelling of Gosub_Return, and the core of
       ChangeReturnToGosubReturn. Answers the 1-based position of that command on a code line, 0
       when the line carries none.

       STRICT BY DESIGN: 'return' must be the FIRST word of the code, and the character after it
       must be a blank or the end of the line. That is the same shape the scan catalogue's
       command-position kind matches, so the grid and the fix cannot drift apart - and the two
       refusals it buys are not theoretical. '.', '$' and '#' are NOT identifier characters here,
       so a boundary-aware keyword search happily matches 'return' inside a legacy name like
       'cfg.key.return' or 'p$return.max' and would splice the line in the middle of it; and
       'Gosub_Return Return' carries the word as an ARGUMENT, whose first word is gosub_return.

       An inline guard ('If (x) return', '[ ind] return') is refused for the same reason and stays
       a hand edit. It cannot be admitted by relaxing the first-word test alone - that is exactly
       what would re-admit the two shapes above - so it is a decision of its own, not a side
       effect of this one.

       Pass the MASKED line (sIndentation + sOverstrikeLine): its positions are aligned with the
       raw line, and a mention inside a string literal can never match. Pure - no engine state. */
    Function _ReturnCommandPos String sMaskedLine Returns Integer
        Integer iLen iPos
        String  sCh
        Boolean bAtCode

        Move (Length(sMaskedLine)) to iLen
        Move 1 to iPos
        Move False to bAtCode
        While (bAtCode = False and iPos <= iLen)
            Move (Mid(sMaskedLine, 1, iPos)) to sCh
            If (sCh <> CS_S and sCh <> (Character(9))) ;
                Move True to bAtCode
            Else ;
                Increment iPos
        Loop
        If (bAtCode = False) ;
            Function_Return 0
        If (Lowercase(Mid(sMaskedLine, 6, iPos)) <> "return") ;
            Function_Return 0
        // The word has to END there. 'return$flag:' is a LABEL, not the command.
        If ((iPos + 6) <= iLen) Begin
            Move (Mid(sMaskedLine, 1, (iPos + 6))) to sCh
            If (sCh <> CS_S and sCh <> (Character(9))) ;
                Function_Return 0
        End
        Function_Return iPos
    End_Function

    // The whole-file scan core behind LegacyDbApiReport (oRefactorFuncLib) - unit-tested via
    // oLegacyDbApiReport-Tests. Scans asCode for the legacy Database-API attribute COMMANDS at
    // command position (first word of a strings/comment-masked _SplitSourceWords split, so a mention
    // in a string or a modern Get_Attribute line never hits) and appends a "Line N: <src>" +
    // "modern: <note>" pair per site to asReport (the caller adds the file header + writes the
    // lines). Returns the site count. Pure - no engine/file state, like _GosubAuditFile. The
    // watch/hint lists are PARALLEL: keep them index-aligned when editing.
    /* DOES THE ENCLOSING METHOD ALREADY DECLARE THE GENERATED FLAG? Scans forward from iFrom to the
       method's End_Procedure / End_Function. Called at most once per method, and only where there is
       something to convert, so the cost is bounded by the method it is already inside.

       It has to look FORWARD as well as back because the declaration this converter writes sits
       immediately above its first use: on a second run over a method that gained a new Ifchange
       ABOVE the converted one, a backward-only check would emit a second declaration and the file
       would stop compiling. Stateless by design (_CodeOnlyLine per line, no tokenizer state), so it
       can be called from the middle of the main pass without disturbing it. */
    Function _MethodDeclaresFlag String[] ByRef asCode Integer iFrom String sFlagLow Returns Boolean
        String sLow
        Integer i iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from iFrom to iLast
            Move (Lowercase(Trim(_CodeOnlyLine(Self, asCode[i])))) to sLow
            If (_IsMethodEnd(Self, sLow)) ;
                Function_Return False
            If (Left(sLow, (8 + Length(sFlagLow))) = ("boolean " + sFlagLow)) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* THE IFCHANGE WORKER (Nils 2026-09-15, "yes, build the Ifchange converter as Review") -
       unit-tested through oChangeIfchangeCommandToAttribute-Tests; the published wrapper in
       oRefactorFuncLib is a one-line call.

       WHAT IT REWRITES.  Ifchange <file> <command...>  becomes three lines:

           Boolean bDfrFileChanged                                          (once per method)
           Get_Attribute DF_FILE_CHANGED of <file>.File_Number to bDfrFileChanged
           If bDfrFileChanged <command...>

       which is the shape DataFlex's own framework uses for this attribute (Data_set.pkg,
       Datadict.pkg, cDbCJGridPromptList.pkg all read it into a Boolean and test it on the next
       line). The legacy command is NOT an attribute read: FMAC gives it two dedicated opcodes -
       one for a defined symbol, one for <file>.FILE_NUMBER - and delivers the answer as indicator
       122, under which the rest of the line runs. That is also why the compiler reports THREE
       warnings on such a line and not one: 4533 for the obsolete command and two 4538s for the
       indicator.

       THE EQUIVALENCE IS MEASURED (2026-09-15, DF26 x64). It had to be: the docs' "replaced by the
       DF_FILE_CHANGED attribute" is a naming fact, and the two forms go through different code paths
       - the command has its own opcodes and answers through indicator 122, the attribute is read
       through the generic $501 path - so nothing about the source says they report the same thing.
       A probe read both against one table's buffer in four states:

           after Clear         legacy 0   attribute 0
           after Find          legacy 0   attribute 0
           after a field write legacy 1   attribute 1
           after writing the ORIGINAL value back   legacy 1   attribute 1

       Equal on every row, the last one included - restoring the old value does not clear the flag,
       because the buffer was written, and both forms say so. So the rewrite preserves the condition.

       WHY REVIEW ANYWAY. What remains is not about the values: this is the only converter in its
       family that puts a DECLARATION into someone's method rather than rewriting a line in place,
       and it is a 1-to-3 line expansion. On top of that it has never run against a real site - the
       command appears nowhere in any workspace to hand - and the bar for promoting a scan rule to
       Auto-fix here has been a measured live run, not a green fixture. Review hands the result back
       for a human to read, which is the right answer until such a run exists.

       A LOCAL IS METHOD-SCOPED, NOT BLOCK-SCOPED (compile-verified): a Boolean declared inside an
       If ... Begin / End is still readable after the End, so the declaration can go immediately
       above its first use instead of being hoisted to the top of the method, where the method's own
       ;-continued declaration line would have to be found first.

       WHAT IT DECLINES, and why each one is real - all three shapes below compile today:
        - The line is the body of a ;-continuation ("If (x) ;" on the line above). Three lines here
          would put the Get_Attribute under that If and orphan the rest.
        - It is not inside a method. The flag would become a global, which is a bigger decision than
          this conversion is allowed to make.
        - The line itself ends with ";" - its own tail continues on the next line, so there is no
          whole command to move.
        - The file argument is not a plain name (parenthesised, or dotted as something other than
          .File_Number). FMAC accepts a file NUMBER there as well as a name, and nothing in the
          source says which this is.
       A declined line gets a TRAILING TODO naming the reason and the hand-written form - trailing,
       never a line above, because inserting one would steal a ;-continuation guard. The marker also
       silences the Deep Scan row, so the scan stops promising a fix that will not come. A line that
       already carries a DFRefactor marker is left exactly as it is.

       An "Ifchange" that is not the first word ("If (x) Ifchange ...") never reaches here at all -
       the same command-position rule the Deep Scan rule uses - so the grid and the fix agree. */
    Function _TransformIfchangeCommands String[] ByRef asCode Returns Integer
        String[] asOut asWords
        String sLine sOver sTrimOver sIndent sRest sFile sFileArg sTail sCh sLow sFlag sFlagLow sWhy
        Integer iLine iLast iChanges i iLen iSp
        Boolean bInMethod bDeclared bPrevOpen bHandled bOK bEndsOpen
        tTokenizer TD

        Move (SizeOfArray(asCode) - 1) to iLast
        If (iLast < 0) ;
            Function_Return 0
        Move "bDfrFileChanged" to sFlag
        Move (Lowercase(sFlag)) to sFlagLow
        Move 0 to iChanges
        Move False to bInMethod
        Move False to bDeclared
        Move False to bPrevOpen

        For iLine from 0 to iLast
            Move asCode[iLine] to sLine
            // Whole-file functions drive the per-file bar themselves (the engine only advances it for
            // the line-by-line types); a no-op when no panel is showing.
            If (Mod(iLine, 20) = 0 and Active_State(ghoStatusPanel) = True) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iLine + 1) * "of:" * String(iLast + 1))
                Set piPosition of ghoProgressBar to (iLine + 1)
            End
            // EVERY line goes through the tokenizer, in order - it carries state across lines
            // (block comments, macro bodies, report images) and skipping one corrupts the rest.
            Get Tokenizer of Self sLine to TD
            Move TD.sOverstrikeLine to sOver
            Move (Trim(sOver)) to sTrimOver
            Move (Lowercase(sTrimOver)) to sLow

            // The generated flag is a LOCAL, so the "already declared" state belongs to one method.
            If (_IsMethodStart(Self, sOver)) Begin
                Move True to bInMethod
                Move False to bDeclared
            End
            Else If (_IsMethodEnd(Self, sOver)) Begin
                Move False to bInMethod
                Move False to bDeclared
            End
            If (Left(sLow, (8 + Length(sFlagLow))) = ("boolean " + sFlagLow)) ;
                Move True to bDeclared

            Move False to bHandled
            Move (sTrimOver <> "" and Right(sTrimOver, 1) = ";") to bEndsOpen
            If (TD.bLineIsReady = False and TD.bIsComment = False and TD.bIsInCommand = False and TD.bIsInImage = False) Begin
                Get _SplitSourceWords sLine to asWords
                If (SizeOfArray(asWords) > 0) Begin
                    If (Lowercase(asWords[0]) = "ifchange") Begin
                        Move "" to sWhy
                        Move "" to sFile
                        Move "" to sTail
                        // Split the ORIGINAL line, so the command that rides along keeps its casing,
                        // its string literals and any trailing comment exactly as they were.
                        Move TD.sIndentation to sIndent
                        Move (LTrim(sLine)) to sRest
                        Move (Trim(Mid(sRest, (Length(sRest) - 8), 9))) to sRest
                        Move (Length(sRest)) to iLen
                        Move 0 to iSp
                        Move 1 to i
                        While (i <= iLen and iSp = 0)
                            Move (Mid(sRest, 1, i)) to sCh
                            If (sCh = " " or sCh = (Character(9))) ;
                                Move i to iSp
                            Increment i
                        Loop
                        If (iSp > 1) Begin
                            Move (Left(sRest, (iSp - 1))) to sFile
                            Move (Trim(Mid(sRest, (Length(sRest) - iSp), (iSp + 1)))) to sTail
                        End
                        If (sTail = "") ;
                            Move "there is no command after the file for the test to guard" to sWhy
                        If (sWhy = "" and bEndsOpen = True) ;
                            Move "the statement continues on the next line" to sWhy
                        If (sWhy = "" and bPrevOpen = True) ;
                            Move "this line is the body of the ;-continuation above it" to sWhy
                        If (sWhy = "" and bInMethod = False) ;
                            Move "it is outside a Procedure / Function, where the flag would have to be a global" to sWhy
                        If (sWhy = "") Begin
                            Move (Lowercase(sFile)) to sLow
                            Move True to bOK
                            If (Pos("(", sFile) > 0) ;
                                Move False to bOK
                            If (Pos(".", sLow) > 0 and Right(sLow, 12) <> ".file_number") ;
                                Move False to bOK
                            If (bOK = False) ;
                                Move "the file argument is not a plain table name, and a file NUMBER is legal there too" to sWhy
                        End
                        If (sWhy = "") Begin
                            If (Right(Lowercase(sFile), 12) = ".file_number") ;
                                Move sFile to sFileArg
                            Else ;
                                Move (sFile + ".File_Number") to sFileArg
                            If (bDeclared = False) Begin
                                Get _MethodDeclaresFlag (&asCode) iLine sFlagLow to bDeclared
                                If (bDeclared = False) Begin
                                    Move (sIndent + "Boolean " + sFlag) to asOut[SizeOfArray(asOut)]
                                    Move True to bDeclared
                                End
                            End
                            Move (sIndent + "Get_Attribute DF_FILE_CHANGED of " + sFileArg + " to " + sFlag) to asOut[SizeOfArray(asOut)]
                            Move (sIndent + "If " + sFlag + " " + sTail) to asOut[SizeOfArray(asOut)]
                            Increment iChanges
                            Move True to bHandled
                        End
                        Else Begin
                            /* TRAILING marker, never a line above: an inserted line would steal a
                               ;-continuation guard from the statement before it. Skipped where the
                               line ends with ";" (a comment after the continuation is not legal) and
                               where a DFRefactor marker is already there - re-running must not stack
                               them up. */
                            If (bEndsOpen = False and not(Lowercase(sLine) contains "(dfrefactor)")) Begin
                                Move (sLine + "   // TODO (DFRefactor): NOT converted - " + sWhy ;
                                    + ". By hand: read Get_Attribute DF_FILE_CHANGED of <file>.File_Number into a Boolean, then test that Boolean before the command.") to asOut[SizeOfArray(asOut)]
                                Increment iChanges
                                Move True to bHandled
                            End
                        End
                    End
                End
            End
            If (bHandled = False) ;
                Move sLine to asOut[SizeOfArray(asOut)]
            // Does THIS line leave a statement open for the next one? Blank and comment-only lines
            // carry the answer forward rather than clearing it.
            If (sTrimOver <> "") ;
                Move bEndsOpen to bPrevOpen
        Loop
        Move asOut to asCode
        Function_Return iChanges
    End_Function

    Function _LegacyDbApiScanFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        String[] asWords asWatch asHints asAnyWatch asAnyHints
        Integer iLine iLineLast iIdx iSites iR iAny iAnyLast
        String sCode sNote
        Boolean bGate

        Move "file_size"             to asWatch[0]
        Move "size_of_field"         to asWatch[1]
        Move "get_current_lockcount" to asWatch[2]
        Move "get_date_format"       to asWatch[3]
        Move "get_number_format"     to asWatch[4]
        Move "get_filelist"          to asWatch[5]
        Move "set_filelist"          to asWatch[6]
        Move "get_date_attribute"    to asWatch[7]
        Move "ifchange"              to asWatch[8]
        Move "Get_Attribute DF_FILE_RECORDS_USED / DF_FILE_MAX_RECORDS / DF_FILE_NUMBER_FIELDS of <File>.File_Number to <var>. NOTE: legacy has a READ form (File_Size file to used max fields) AND a SET-max form (File_Size newmax to file) - args reversed; check which one this is." to asHints[0]
        Move "Use a Struct. This is NOT a database field length: Dll.pkg declares Size_of_Field as a legacy Type MEMBER's byte size (Obsolete command (not unicode safe): Size_of_Field. Use Structs), and the Type/Struct report covers the migration." to asHints[1]
        Move "Get_Attribute DF_TRAN_COUNT to <var> - the same number (measured on the DF26 x64 runtime: 0/0, 1/1, 2/2 across a nested Lock pair). ChangeGetCurrentLockcountToAttribute converts this one. The compiler never warns about it, so a Deep Scan is the only place it surfaces." to asHints[2]
        Move "Get_Attribute DF_DATE_FORMAT to <var> (returns DF_DATE_USA / DF_DATE_EUROPEAN / DF_DATE_MILITARY - the same values). ChangeGetDateFormatToAttribute converts this one." to asHints[3]
        Move "Get_Number_Format returns a FORMAT code, while DF_DECIMAL_SEPARATOR / DF_THOUSANDS_SEPARATOR return the separator CHARACTER (measured: 1 against 44) - read what the code does with the value before swapping in either attribute." to asHints[4]
        Move "Get_Attribute DF_FILELIST_NAME to <var> - a GLOBAL attribute, so there is no 'of <File>.File_Number' part, and the legacy command takes no 'to' at all. ChangeFileListCommandToAttribute converts this one." to asHints[5]
        Move "Set_Attribute DF_FILELIST_NAME to <value> - a GLOBAL attribute, so there is no 'of <File>.File_Number' part, and the legacy command takes no 'to' at all. ChangeFileListCommandToAttribute converts this one." to asHints[6]
        Move "Reads Y2K/epoch no-op state (SysDate4_State / Date4_State / Epoch_Value) - dates are always 4-digit now, so the read is usually dead. (DF_DATE_FORMAT is a DIFFERENT thing - display order - do NOT assume a swap.)" to asHints[7]
        Move "Get_Attribute DF_FILE_CHANGED of <file>.File_Number to bChanged, then  If bChanged <command>  (legacy: ifchange <file> <command> ran <command> when the record buffer changed). ChangeIfchangeCommandToAttribute converts this one - Review, because it writes a declaration into the method and has never run against a real site; the value equivalence itself is measured." to asHints[8]
        // ANYWHERE-position DB-file constants / obsolete predefined variables (not commands - they are
        // Get_/Set_Attribute args or bare variables), folded in from the Deep Scan catalog. Matched on the
        // _CodeOnlyLine mask via _FindKeywordPos (grid parity with the eDSAnywhere rules).
        Move "fieldindex"                    to asAnyWatch[0]
        Move "filenumber"                    to asAnyWatch[1]
        Move "df_file_primary_index_trigger" to asAnyWatch[2]
        Move "df_file_translate_oem_to_ansi" to asAnyWatch[3]
        Move "Loop fields via DF_FILE_NUMBER_FIELDS + Field_Value (the Fieldindex predefined variable is obsolete)." to asAnyHints[0]
        Move "Use the DF_FILE_NUMBER attribute (the Filenumber predefined variable is obsolete)." to asAnyHints[1]
        Move "DF_FILE_GENERATE_RECORD_ID_METHOD replaces it, but NOT by renaming: the old attribute is a Boolean and the new one takes RIM_NONE / RIM_IDENTITY_COLUMN / RIM_DISPENSER_TABLE / RIM_EXTERNAL. False lands on RIM_NONE (0), but True meant a trigger fills the column, which is RIM_EXTERNAL (3) - not the 1 a name swap would leave, and the compiler cannot catch the difference. The old attribute appears in no DF26 driver definition, so check whether the line is still needed at all, and decide the value per table." to asAnyHints[2]
        Move "Use DF_FILE_TABLE_CHARACTER_FORMAT (DF_FILE_TRANSLATE_OEM_TO_ANSI is obsolete)." to asAnyHints[3]
        // FILE PRE-GATE (Nils 2026-07-16 perf sweep): every finding requires a watch token
        // somewhere in the raw text - a file that never mentions any skips the per-line masked
        // splits entirely (_FileContainsAnyText: native pass, false hits harmless, reuses the
        // watch lists so the gate maintains itself when a list grows).
        Get _FileContainsAnyText (&asCode) (&asWatch) to bGate
        If (bGate = False) ;
            Get _FileContainsAnyText (&asCode) (&asAnyWatch) to bGate
        If (bGate = False) ;
            Function_Return 0
        Move 0 to iSites
        Move (SizeOfArray(asCode)) to iLineLast
        If (iLineLast = 0) ;
            Function_Return 0
        Decrement iLineLast
        Move (SizeOfArray(asAnyWatch)) to iAnyLast
        Decrement iAnyLast
        For iLine from 0 to iLineLast
            Move "" to sNote
            // command-position DB-API commands (first word)
            Get _SplitSourceWords of Self asCode[iLine] to asWords
            If (SizeOfArray(asWords) > 0) Begin
                Move (SearchArray(Lowercase(asWords[0]), asWatch)) to iIdx
                If (iIdx <> -1) ;
                    Move asHints[iIdx] to sNote
            End
            // anywhere-position DB-file constants / obsolete predefined variables
            Get _CodeOnlyLine asCode[iLine] to sCode
            For iAny from 0 to iAnyLast
                If (_FindKeywordPos(Self, sCode, asAnyWatch[iAny], True, 1) > 0) Begin
                    If (sNote = "") ;
                        Move asAnyHints[iAny] to sNote
                    Else If (not(sNote contains asAnyHints[iAny])) ;
                        Move (sNote + " | " + asAnyHints[iAny]) to sNote
                End
            Loop
            If (sNote <> "") Begin
                Move (SizeOfArray(asReport)) to iR
                Move ("  Line " + String(iLine + 1) + ":  " + Trim(asCode[iLine])) to asReport[iR]
                Move ("      modern:  " + sNote) to asReport[iR + 1]
                Increment iSites
            End
        Loop
        Function_Return iSites
    End_Function

    /* THE REPORT LOG, SHARED. A whole-workspace report (eReportFunctionAll) walks the selected files itself,
       writes one log under the backup folder and lists it under 'Other log files'. Ten of them - in
       oRefactorFuncLib.pkg and the Unicode include - carried the same four blocks each, so a change to the
       cancel handling or the panel drive had to be made ten times over. These carry them once; a report's
       own header lines, its scan core and its Total wording stay with the report. */

    // The status panel, when it shows: the total bar set to the file count. True when it shows.
    Function _ReportPanelStart Integer iFileLast Returns Boolean
        Boolean bPanel

        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        If (bPanel = True) ;
            Set piMaximumTot of ghoStatusPanel to (iFileLast + 1)
        Function_Return bPanel
    End_Function

    // The panel on the file about to be scanned: "<sCaption> i of: n", the title, the file - and the total
    // bar one step on. A no-op when the panel does not show.
    Procedure _ReportPanelFile Boolean bPanel String sCaption String sTitle String sFilePath Integer iFile Integer iFileLast
        If (bPanel = False) ;
            Procedure_Return
        Set Caption_Text of ghoStatusPanel to (sCaption * String(iFile + 1) * "of:" * String(iFileLast + 1))
        Set Title_Text of ghoStatusPanel to sTitle
        Set TableName_Text of ghoStatusPanel to sFilePath
        Send DoAdvanceTot of ghoStatusPanel
    End_Procedure

    // One file's findings into the log: the "=== file ===" line, the lines, a blank line.
    Procedure _ReportWriteFindings Integer iCh String sFilePath String[] asReport
        Integer i iLast

        Writeln channel iCh ("=== " + sFilePath + " ===")
        Move (SizeOfArray(asReport) - 1) to iLast
        For i from 0 to iLast
            Writeln channel iCh asReport[i]
        Loop
        Writeln channel iCh ""
    End_Procedure

    // The closing lines: the panel title cleared, the cancelled banner when the user stopped the run, the
    // "Total: <n><sTotalText>" line, the log closed - and listed under 'Other log files' when it holds anything.
    Procedure _ReportFinish Integer iCh String sLogFile Integer iTotal Boolean bCancel Boolean bPanel String sTotalText
        String[] asOtherLogFiles

        If (bPanel = True) ;
            Set Title_Text of ghoStatusPanel to ""
        If (bCancel = True) Begin
            Writeln channel iCh ""
            Writeln channel iCh "*** Cancelled by the user - this report is INCOMPLETE. ***"
        End
        Writeln channel iCh ("Total: " + String(iTotal) + sTotalText)
        Send rfCloseOutput iCh
        If (iTotal > 0) Begin
            Get pasOtherLogFiles to asOtherLogFiles
            Move sLogFile to asOtherLogFiles[SizeOfArray(asOtherLogFiles)]
            Set pasOtherLogFiles to asOtherLogFiles
        End
    End_Procedure

    /* ---- THE TECHSTACK READINESS REPORT (Nils 2026-11-20) ------------------------------------------------------
       DataFlex's TechStack - the DataFlex 27 previews - changes the data layer, replaces cHttpTransfer, does not
       run Windows UI, COM/ActiveX, SOAP or DLL calls everywhere yet, and converts a String to a Boolean another
       way. TechStackReadinessReport counts where a workspace uses those, per topic and per file. The topics are
       what DAW's own pages stated on 2026-11-20 (Nils chose all four groups and a report, not analyzer rows: the
       data layer alone touches nearly every line of a Windows app). TechStack is a preview and its list moves,
       so the topics' text, with the page each comes from, lives in _TechStackTopics and _TechStackReportLines
       only. Positions: the CI_TS* constants. */

    // The topics, parallel and in CI_TS* order: the tag a site line carries, the title, and what TechStack says.
    Procedure _TechStackTopics String[] ByRef asTag String[] ByRef asTitle String[] ByRef asSays
        Move "Open"                to asTag[CI_TSOpen]
        Move "Open <table>"        to asTitle[CI_TSOpen]
        Move "There is no global table buffer to open: each data dictionary object holds its own buffer." to asSays[CI_TSOpen]
        Move "Relate"              to asTag[CI_TSRelate]
        Move "Relate"              to asTitle[CI_TSRelate]
        Move "Relate goes: relations are declared on the entity, and Set DDO_Server connects the objects." to asSays[CI_TSRelate]
        Move "Add_Server_File"     to asTag[CI_TSServerFile]
        Move "Add_Server_File / Add_Client_File" to asTitle[CI_TSServerFile]
        Move "Replaced by Add_Relation on the entity plus Set DDO_Server." to asSays[CI_TSServerFile]
        Move "Make_File"           to asTag[CI_TSMakeFile]
        Move "Make_File"           to asTitle[CI_TSMakeFile]
        Move "Replaced by ExistsInDb and CreateDatabase." to asSays[CI_TSMakeFile]
        Move "File_Number"         to asTag[CI_TSFileNumber]
        Move "<table>.File_Number" to asTitle[CI_TSFileNumber]
        Move "The filelist and its numbers go: a table is an Entity ... End_Entity block in the source, referred to with RefEntity(...)." to asSays[CI_TSFileNumber]
        Move "Main_File"           to asTag[CI_TSMainFile]
        Move "Main_File"           to asTitle[CI_TSMainFile]
        Move "Becomes Set phEntity. Main_File stays as a compatibility accessor; DAW does not say for how long." to asSays[CI_TSMainFile]
        Move "Validate_Save"       to asTag[CI_TSValidate]
        Move "Validate_Save / Validate_Delete" to asTitle[CI_TSValidate]
        Move "The overrides become OnValidate_Add, OnValidate_Del and OnValidate_Has." to asSays[CI_TSValidate]
        Move "Field_Validate_msg"  to asTag[CI_TSFieldValidate]
        Move "Field_Validate_msg"  to asTitle[CI_TSFieldValidate]
        Move "Becomes cDD_Field_Validator." to asSays[CI_TSFieldValidate]
        Move "Entry_Item"          to asTag[CI_TSEntryItem]
        Move "Entry_Item <table>.<column>" to asTitle[CI_TSEntryItem]
        Move "Becomes Entry_Item <data dictionary object>.<field>." to asSays[CI_TSEntryItem]
        Move "table command"       to asTag[CI_TSTableCommand]
        Move "Find / Clear / SaveRecord / ZeroFile" to asTitle[CI_TSTableCommand]
        Move "The same commands, with a data dictionary object where the table was. Counted, not listed - a Windows application has many." to asSays[CI_TSTableCommand]
        Move "cHttpTransfer"       to asTag[CI_TSHttpTransfer]
        Move "cHttpTransfer, cXmlHttpTransfer, cJsonHttpTransfer" to asTitle[CI_TSHttpTransfer]
        Move "Replaced by cHttpClient, which runs on every platform, with some changes to the API." to asSays[CI_TSHttpTransfer]
        Move "Windows UI"          to asTag[CI_TSWindowsUI]
        Move "Windows UI files" to asTitle[CI_TSWindowsUI]
        Move "Views, dialogs, lookup lists, reports, and programs that start a Windows UI: TechStack runs no Windows desktop UI in its first revisions. Its UI is Web UI and FlexTron; a native UI has not been decided." to asSays[CI_TSWindowsUI]
        Move "COM/ActiveX"         to asTag[CI_TSComActiveX]
        Move "cComActiveXControl, cComAutomationObject" to asTitle[CI_TSComActiveX]
        Move "FlexCom on Windows is limited: no ActiveX, and no object nesting. Counted here: the workspace's own COM classes. The CodeJock controls (cCJ...) are ActiveX too, and come with the Windows UI files." to asSays[CI_TSComActiveX]
        Move "SOAP"                to asTag[CI_TSSoap]
        Move "cWebService, cClientWebService" to asTitle[CI_TSSoap]
        Move "SOAP web services are not implemented on any platform, and no phase is given for them." to asSays[CI_TSSoap]
        Move "External_Function"   to asTag[CI_TSExternalFunction]
        Move "External_Function" to asTitle[CI_TSExternalFunction]
        Move "DLL calls run on Windows and WebAssembly only - not on macOS or Linux." to asSays[CI_TSExternalFunction]
        Move "String->Boolean"     to asTag[CI_TSStringToBoolean]
        Move "A String moved into a Boolean" to asTitle[CI_TSStringToBoolean]
        Move ("A non-empty string converts to True unless it is " + Character(34) + "0" + Character(34) + " or " + Character(34) + "False" + Character(34) + ". Found by the types declared in one method: a conversion through a property or a function is not seen.") to asSays[CI_TSStringToBoolean]
    End_Procedure

    /* PURE. One file's TechStack readiness sites. aiSites[CI_TS*] grows by each site found, and asReport gets one
       "  Line N [tags]:  code" line per source line with a site - except a table command, which is counted and not
       listed (a Windows application has thousands). bWindowsUI is the caller's verdict on the file as a whole: one
       site, on the file's own line. Macro code is skipped - a #COMMAND body is the definition of a command, not a
       use of it. Returns the sites. */
    Function _TechStackScanFile String[] ByRef asCode Boolean bWindowsUI Integer[] ByRef aiSites String[] ByRef asReport Returns Integer
        String[] asWords asTag asTitle asSays asBools asStrings asTableCmds asHttp asCom asSoap
        Integer[] aiLine aiNone
        String sCode sW0 sW1 sTags sRaw sDest sSrc
        Integer i iLast iSites iW iWLast iTo iTopic iT iTables
        Boolean bInMacro bLiteral

        Send _TechStackTopics (&asTag) (&asTitle) (&asSays)
        Move (StrSplitToArray("find|clear|saverecord|zerofile", "|"))                       to asTableCmds
        Move (StrSplitToArray("chttptransfer|cxmlhttptransfer|cjsonhttptransfer", "|"))     to asHttp
        Move (StrSplitToArray("ccomactivexcontrol|ccomautomationobject", "|"))              to asCom
        Move (StrSplitToArray("cwebservice|cclientwebservice", "|"))                        to asSoap
        Move 0 to iSites
        Move 0 to iTables
        Move False to bInMacro
        If (bWindowsUI = True) Begin
            Move (aiSites[CI_TSWindowsUI] + 1) to aiSites[CI_TSWindowsUI]
            Move ("  The file [" + asTag[CI_TSWindowsUI] + "]: a Windows UI file") to asReport[SizeOfArray(asReport)]
            Increment iSites
        End
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _SplitSourceWords asCode[i] to asWords
            Move (SizeOfArray(asWords) - 1) to iWLast
            Move aiNone to aiLine
            If (iWLast >= 0) Begin
                Move (Lowercase(asWords[0])) to sW0
                Move "" to sW1
                If (iWLast >= 1) ;
                    Move (Lowercase(asWords[1])) to sW1
                // "Local Boolean bX" declares as "Boolean bX" does.
                If (sW0 = "local" and iWLast >= 1) Begin
                    Move sW1 to sW0
                    Move "" to sW1
                    If (iWLast >= 2) ;
                        Move (Lowercase(asWords[2])) to sW1
                End
                If (sW0 = "#command") ;
                    Move True to bInMacro
                Else If (sW0 = "#endcommand") ;
                    Move False to bInMacro
                Else If (bInMacro = False) Begin
                    // A method's own String and Boolean names, its parameters among them (for the String->Boolean move).
                    If (sW0 = "procedure" or sW0 = "function" or sW0 = "end_procedure" or sW0 = "end_function") Begin
                        Move (ResizeArray(asBools, 0))   to asBools
                        Move (ResizeArray(asStrings, 0)) to asStrings
                        If (sW0 = "procedure" or sW0 = "function") Begin
                            For iW from 1 to (iWLast - 1)
                                If (Lowercase(asWords[iW]) = "boolean" or Lowercase(asWords[iW]) = "string") Begin
                                    Move (iW + 1) to iT
                                    If (Lowercase(asWords[iT]) = "byref" and iT < iWLast) ;
                                        Increment iT
                                    If (Lowercase(asWords[iW]) = "boolean") ;
                                        Move (Lowercase(asWords[iT])) to asBools[SizeOfArray(asBools)]
                                    Else ;
                                        Move (Lowercase(asWords[iT])) to asStrings[SizeOfArray(asStrings)]
                                End
                            Loop
                        End
                    End
                    Else If (sW0 = "boolean" or sW0 = "string") Begin
                        For iW from 1 to iWLast
                            If (Lowercase(asWords[iW]) <> "local") Begin
                                If (sW0 = "boolean") ;
                                    Move (Lowercase(asWords[iW])) to asBools[SizeOfArray(asBools)]
                                Else ;
                                    Move (Lowercase(asWords[iW])) to asStrings[SizeOfArray(asStrings)]
                            End
                        Loop
                    End

                    // ---- the command-position topics ----
                    If (sW0 = "open") ;
                        Move CI_TSOpen to aiLine[SizeOfArray(aiLine)]
                    If (sW0 = "relate") ;
                        Move CI_TSRelate to aiLine[SizeOfArray(aiLine)]
                    If (sW0 = "make_file") ;
                        Move CI_TSMakeFile to aiLine[SizeOfArray(aiLine)]
                    If ((sW0 = "procedure" or sW0 = "function") and (sW1 = "validate_save" or sW1 = "validate_delete")) ;
                        Move CI_TSValidate to aiLine[SizeOfArray(aiLine)]
                    If (sW0 = "entry_item" and Pos(".", sW1) > 1 and Left(sW1, 1) <> "(") ;
                        Move CI_TSEntryItem to aiLine[SizeOfArray(aiLine)]
                    If (sW0 = "external_function") ;
                        Move CI_TSExternalFunction to aiLine[SizeOfArray(aiLine)]
                    If (SearchArray(sW0, asTableCmds) <> -1 and sW1 <> "") Begin
                        Move (aiSites[CI_TSTableCommand] + 1) to aiSites[CI_TSTableCommand]
                        Increment iTables
                        Increment iSites
                    End

                    // ---- the anywhere topics, on the code with its strings and comment masked ----
                    Get _CodeOnlyLine asCode[i] to sCode
                    Move (Lowercase(sCode)) to sCode
                    If (_FindKeywordPos(Self, sCode, "add_server_file", True, 1) > 0 or _FindKeywordPos(Self, sCode, "add_client_file", True, 1) > 0) ;
                        Move CI_TSServerFile to aiLine[SizeOfArray(aiLine)]
                    If (_FindKeywordPos(Self, sCode, "file_number", True, 1) > 0) ;
                        Move CI_TSFileNumber to aiLine[SizeOfArray(aiLine)]
                    If (_FindKeywordPos(Self, sCode, "main_file", True, 1) > 0) ;
                        Move CI_TSMainFile to aiLine[SizeOfArray(aiLine)]
                    If (_FindKeywordPos(Self, sCode, "field_validate_msg", True, 1) > 0) ;
                        Move CI_TSFieldValidate to aiLine[SizeOfArray(aiLine)]
                    For iW from 0 to (SizeOfArray(asHttp) - 1)
                        If (_FindKeywordPos(Self, sCode, asHttp[iW], True, 1) > 0 and SearchArray(CI_TSHttpTransfer, aiLine) = -1) ;
                            Move CI_TSHttpTransfer to aiLine[SizeOfArray(aiLine)]
                    Loop
                    For iW from 0 to (SizeOfArray(asCom) - 1)
                        If (_FindKeywordPos(Self, sCode, asCom[iW], True, 1) > 0 and SearchArray(CI_TSComActiveX, aiLine) = -1) ;
                            Move CI_TSComActiveX to aiLine[SizeOfArray(aiLine)]
                    Loop
                    For iW from 0 to (SizeOfArray(asSoap) - 1)
                        If (_FindKeywordPos(Self, sCode, asSoap[iW], True, 1) > 0 and SearchArray(CI_TSSoap, aiLine) = -1) ;
                            Move CI_TSSoap to aiLine[SizeOfArray(aiLine)]
                    Loop

                    /* ---- Move <a String> to <a Boolean> ---- the target is the word after the last "to" of the
                       masked split; the source a quoted literal (read on the raw line, where the quote still is) or
                       a String the method declares. */
                    If (sW0 = "move" and SizeOfArray(asBools) > 0) Begin
                        Move -1 to iTo
                        For iW from 1 to iWLast
                            If (Lowercase(asWords[iW]) = "to") ;
                                Move iW to iTo
                        Loop
                        If (iTo > 0 and iTo < iWLast) Begin
                            Move (Lowercase(asWords[iTo + 1])) to sDest
                            If (SearchArray(sDest, asBools) <> -1) Begin
                                Move (Trim(Replaces((Character(9)), asCode[i], " "))) to sRaw
                                Move (Trim(Right(sRaw, (Length(sRaw) - 4)))) to sRaw
                                // An empty literal converts to False either way: only a non-empty one changes.
                                Move ((Left(sRaw, 1) = '"' and Left(sRaw, 2) <> '""') or (Left(sRaw, 1) = "'" and Left(sRaw, 2) <> "''")) to bLiteral
                                Move "" to sSrc
                                If (iTo > 1) ;
                                    Move (Lowercase(asWords[1])) to sSrc
                                If (bLiteral = True or (iTo = 2 and SearchArray(sSrc, asStrings) <> -1)) ;
                                    Move CI_TSStringToBoolean to aiLine[SizeOfArray(aiLine)]
                            End
                        End
                    End
                End
            End
            // The line's sites: counted per topic, and one report line with their tags.
            If (SizeOfArray(aiLine) > 0) Begin
                Move "" to sTags
                For iT from 0 to (SizeOfArray(aiLine) - 1)
                    Move aiLine[iT] to iTopic
                    Move (aiSites[iTopic] + 1) to aiSites[iTopic]
                    Increment iSites
                    Move (sTags + (If(sTags = "", "", ", ")) + asTag[iTopic]) to sTags
                Loop
                Move ("  Line " + String(i + 1) + " [" + sTags + "]:  " + Trim(asCode[i])) to asReport[SizeOfArray(asReport)]
            End
        Loop
        If (iTables > 0) ;
            Move ("  " + String(iTables) + " table command(s) [" + asTag[CI_TSTableCommand] + "] - counted, not listed") to asReport[SizeOfArray(asReport)]
        Function_Return iSites
    End_Function

    /* PURE. The report's head and its summary: what TechStack is and when its pages were read, then each group of
       topics with the DAW page it comes from, and per topic its sites, its files and what TechStack says. */
    Function _TechStackReportLines Integer[] ByRef aiSites Integer[] ByRef aiFiles Integer iFilesScanned Returns String[]
        String[] asOut asTag asTitle asSays
        Integer iTopic

        Send _TechStackTopics (&asTag) (&asTitle) (&asSays)
        Move "TechStack readiness  (report only - no changes made)." to asOut[SizeOfArray(asOut)]
        Move "Where this workspace uses what DataFlex's TechStack - the DataFlex 27 previews - changes, or does not run yet." to asOut[SizeOfArray(asOut)]
        Move "TechStack is a preview: DAW offers it for trying out and feedback, not for production, and its list still moves." to asOut[SizeOfArray(asOut)]
        Move "Read this as where the work is, not as a verdict. The topics are what DAW's pages said on 2026-11-20, when the" to asOut[SizeOfArray(asOut)]
        Move "newest TechStack was 27.0.113.119 with toolchains 0.1.11 (14 October 2026)." to asOut[SizeOfArray(asOut)]
        Move ("Files read: " + String(iFilesScanned) + ".") to asOut[SizeOfArray(asOut)]
        For iTopic from 0 to (CI_TSTopicCount - 1)
            If (iTopic = CI_TSOpen) Begin
                Move "" to asOut[SizeOfArray(asOut)]
                Move "THE DATA LAYER - https://tsdocs.dataflex.dev/Tutorials/The-first-interactions-with-Data/" to asOut[SizeOfArray(asOut)]
            End
            If (iTopic = CI_TSHttpTransfer) Begin
                Move "" to asOut[SizeOfArray(asOut)]
                Move "HTTP - https://www.dataflex.dev/News-Events/NEWS-Answers-to-Q-A-Technology-Stack-Livestream-1161" to asOut[SizeOfArray(asOut)]
            End
            If (iTopic = CI_TSWindowsUI) Begin
                Move "" to asOut[SizeOfArray(asOut)]
                Move "NOT SUPPORTED YET - https://tsdocs.dataflex.dev/Roadmap/Phase-1-WebApp-Clients-and-Apps/ (and Phase 2 and 3)" to asOut[SizeOfArray(asOut)]
            End
            If (iTopic = CI_TSStringToBoolean) Begin
                Move "" to asOut[SizeOfArray(asOut)]
                Move "BREAKING IN 27.0.113 - https://tsdocs.dataflex.dev/Release-Notes/27-0-113-119-toolchains-0-1-11/" to asOut[SizeOfArray(asOut)]
            End
            // 52: the longest title is 50 characters, and a count must never run into it (Nils's first run, 2026-11-20).
            Move ("  " + Pad(asTitle[iTopic], 52) + String(aiSites[iTopic]) + " site(s) in " + String(aiFiles[iTopic]) + " file(s)") to asOut[SizeOfArray(asOut)]
            Move ("      " + asSays[iTopic]) to asOut[SizeOfArray(asOut)]
        Loop
        Move "" to asOut[SizeOfArray(asOut)]
        Move "THE SITES, FILE BY FILE" to asOut[SizeOfArray(asOut)]
        Move "" to asOut[SizeOfArray(asOut)]
        Function_Return asOut
    End_Function

    /* THE COMMAND-POSITION WATCH-LIST SCAN behind LegacyRegistryReport, LegacySqlReport and LegacyDfPathReport: a
       line whose first word (of a strings/comment-masked _SplitSourceWords split) is on the watch list gets a
       "Line N: <src>" + "modern: <hint>" pair appended to asReport. Watch and hint lists are PARALLEL. Pre-gated
       on the raw text (Nils 2026-07-16 perf sweep, see _LegacyDbApiScanFile): no watch word anywhere in the file
       means no masked split of any line. Returns the site count. */
    Function _WatchListScanFile String[] ByRef asCode String[] ByRef asReport String[] ByRef asWatch String[] ByRef asHints Returns Integer
        String[] asWords
        Integer iLine iLineLast iIdx iSites iR
        Boolean bGate

        Get _FileContainsAnyText (&asCode) (&asWatch) to bGate
        If (bGate = False) ;
            Function_Return 0
        Move 0 to iSites
        Move (SizeOfArray(asCode)) to iLineLast
        If (iLineLast = 0) ;
            Function_Return 0
        Decrement iLineLast
        For iLine from 0 to iLineLast
            Get _SplitSourceWords of Self asCode[iLine] to asWords
            If (SizeOfArray(asWords) > 0) Begin
                Move (SearchArray(Lowercase(asWords[0]), asWatch)) to iIdx
                If (iIdx <> -1) Begin
                    Move (SizeOfArray(asReport)) to iR
                    Move ("  Line " + String(iLine + 1) + ":  " + Trim(asCode[iLine])) to asReport[iR]
                    Move ("      modern:  " + asHints[iIdx]) to asReport[iR + 1]
                    Increment iSites
                End
            End
        Loop
        Function_Return iSites
    End_Function

    // The whole-file scan core behind LegacyRegistryReport (oRefactorFuncLib) - unit-tested via
    // oLegacyRegistryReport-Tests. Scans asCode for the legacy Windows-Registry / profile-string /
    // INI COMMANDS at command position (first word of a strings/comment-masked _SplitSourceWords
    // split) and appends a "Line N: <src>" + "modern: <note>" pair per site to asReport. Returns
    // the site count. Pure - no engine/file state, like _LegacyDbApiScanFile. The modern target is
    // the cRegistry class (an OBJECT holding the key path, not the legacy handle/callback model) and
    // cIniFile (Read_dfini), so the notes are class + migration-shape (the docs give no 1:1 method
    // map). Watch/hint lists are PARALLEL: keep them index-aligned when editing.
    Function _LegacyRegistryScanFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        String[] asWatch asHints
        Integer iSites

        Move "reg_open_key"               to asWatch[0]
        Move "reg_close_key"              to asWatch[1]
        Move "reg_create_key"             to asWatch[2]
        Move "reg_enum_key"               to asWatch[3]
        Move "reg_enum_key_info"          to asWatch[4]
        Move "reg_enum_value"             to asWatch[5]
        Move "reg_get_access_rights"      to asWatch[6]
        Move "reg_set_access_rights"      to asWatch[7]
        Move "get_profile_string"         to asWatch[8]
        Move "set_profile_string"         to asWatch[9]
        Move "get_foreign_profile_string" to asWatch[10]
        Move "set_foreign_profile_string" to asWatch[11]
        Move "set_app_profile_string"     to asWatch[12]
        Move "get_registry_root"          to asWatch[13]
        Move "set_registry_root"          to asWatch[14]
        Move "read_dfini"                 to asWatch[15]
        Move "cRegistry class: an object holding the key path, NOT a handle. Set its root + key-path properties, then read/write values - the Reg_Open_Key -> ... -> Reg_Close_Key handle pattern collapses into one object. Legacy: Reg_Open_Key <keypath> to hKey." to asHints[0]
        Move "cRegistry class: no explicit close needed (the object owns the key) - remove the Reg_Close_Key that paired a Reg_Open_Key handle." to asHints[1]
        Move "cRegistry class: point the object at the key path; keys are created on write. Replaces Reg_Create_Key <keypath> to hKey." to asHints[2]
        Move "cRegistry class: enumerate subkeys with a LOOP over the object - the legacy callback enumeration (Reg_*_Enum) has no modern equivalent; rewrite it." to asHints[3]
        Move "cRegistry class: subkey info via the object; the legacy callback enumeration needs a loop rewrite." to asHints[4]
        Move "cRegistry class: enumerate values with a LOOP - the legacy Reg_String_Value_Enum / Reg_Integer_Value_Enum callbacks have no modern equivalent; rewrite the enumeration." to asHints[5]
        Move "cRegistry class: access rights are properties of the object, not a Reg_Get_Access_Rights call." to asHints[6]
        Move "cRegistry class: set access rights via the object's properties before you open the key." to asHints[7]
        Move "cRegistry class: read a value from the object's key path. Legacy: Get_Profile_String <subkey> <valuename> to <var>." to asHints[8]
        Move "cRegistry class: write a value to the object's key path. Legacy: Set_Profile_String <subkey> <valuename> to <value> (there is also a multi-value 'keyname subkey ; name value, ...' form - split it)." to asHints[9]
        Move "cRegistry class: 'foreign' = an explicit non-default root - set the object's root + key path, then read the value." to asHints[10]
        Move "cRegistry class: set the object's root + key path (a non-default root), then write the value." to asHints[11]
        Move "cRegistry class: point the object at the application's own key path, then write the value." to asHints[12]
        Move "cRegistry class: the registry root is a property of the object, not a Get_Registry_Root call." to asHints[13]
        Move "cRegistry class: set the root via the object's key-path property before reading/writing." to asHints[14]
        Move "cIniFile class: read the INI file via cIniFile. Legacy: Read_dfini <path\file>." to asHints[15]
        Get _WatchListScanFile (&asCode) (&asReport) (&asWatch) (&asHints) to iSites
        Function_Return iSites
    End_Function

    // The whole-file scan core behind LegacySqlReport (oRefactorFuncLib) - unit-tested via
    // oLegacySqlReport-Tests. Scans asCode for the legacy Embedded-SQL COMMANDS at command position
    // (first word of a strings/comment-masked _SplitSourceWords split) and appends a "Line N: <src>"
    // + "modern: <note>" pair per site to asReport. Returns the site count. Pure - no engine/file
    // state, like _LegacyRegistryScanFile. Unlike Registry, the docs give a per-command class.method
    // map (cSQLHandleManager / cSQLConnection / cSQLStatement); the port is still a STATEFUL object
    // migration (implicit handle -> explicit object), covered in the report header. Watch/hint lists
    // are PARALLEL: keep them index-aligned when editing.
    Function _LegacySqlScanFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        String[] asWatch asHints
        Integer iSites

        Move "sqlconnect"              to asWatch[0]
        Move "sqlsetconnect"           to asWatch[1]
        Move "sqlfileconnect"          to asWatch[2]
        Move "sqldisconnect"           to asWatch[3]
        Move "sqlopen"                 to asWatch[4]
        Move "sqlclose"                to asWatch[5]
        Move "sqlprepare"              to asWatch[6]
        Move "sqlexecute"              to asWatch[7]
        Move "sqlexecdirect"           to asWatch[8]
        Move "sqlfetch"                to asWatch[9]
        Move "sqlgetdata"              to asWatch[10]
        Move "sqlcolumnmap"            to asWatch[11]
        Move "sqlnextresultset"        to asWatch[12]
        Move "sqlstmtattribute"        to asWatch[13]
        Move "sqlcall"                 to asWatch[14]
        Move "sqlgetarguments"         to asWatch[15]
        Move "sqlbindfetchfile"        to asWatch[16]
        Move "sqlfilefetch"            to asWatch[17]
        Move "sqlfetchactivatesbuffer" to asWatch[18]
        Move "cli_get_database_attribute" to asWatch[19]
        Move "cli_set_database_attribute" to asWatch[20]
        Move "cli_get_driver_attribute"   to asWatch[21]
        Move "cli_set_driver_attribute"   to asWatch[22]
        Move "db2_setconstraint"       to asWatch[23]
        Move "mssql_setconstraint"     to asWatch[24]
        Move "cSQLHandleManager.SQLConnect - open a connection on the manager object (it holds the handle)." to asHints[0]
        Move "cSQLHandleManager.SQLSetConnect." to asHints[1]
        Move "cSQLHandleManager.SQLFileConnect." to asHints[2]
        Move "cSQLConnection.SQLDisconnect." to asHints[3]
        Move "cSQLConnection.SQLOpen - open a statement on the connection object." to asHints[4]
        Move "cSQLStatement.SQLClose." to asHints[5]
        Move "cSQLStatement.SQLPrepare." to asHints[6]
        Move "cSQLStatement.SQLExecute." to asHints[7]
        Move "cSQLStatement.SQLExecDirect." to asHints[8]
        Move "cSQLStatement.SQLFetch." to asHints[9]
        Move "cSQLStatement.SQLGetData." to asHints[10]
        Move "cSQLStatement.SQLColumnMap." to asHints[11]
        Move "cSQLStatement.SQLNextResultSet." to asHints[12]
        Move "cSQLStatement.SQLStmtAttribute." to asHints[13]
        Move "cSQLStatement.SQLCall." to asHints[14]
        Move "cSQLStatement.SQLGetArgument - RENAMED to singular (legacy was plural SQLGetArguments)." to asHints[15]
        Move "cSQLStatement.SQLBindFile - RENAMED (legacy was SQLBindFetchFile)." to asHints[16]
        Move "cSQLStatement.SQLBindFile - RENAMED (legacy was SQLFileFetch)." to asHints[17]
        Move "cSQLStatement.SQLFetchActivatesBuffer." to asHints[18]
        Move "Get_Attribute (SQL drivers v5+) - no longer a CLI_ command." to asHints[19]
        Move "Set_Attribute (SQL drivers v5+) - no longer a CLI_ command." to asHints[20]
        Move "Get_Attribute (SQL drivers v5+) - no longer a CLI_ command." to asHints[21]
        Move "Set_Attribute (SQL drivers v5+) - no longer a CLI_ command." to asHints[22]
        Move "Use the DF_FILE_SQL_FILTER attribute (or Embedded SQL)." to asHints[23]
        Move "Use the DF_FILE_SQL_FILTER attribute (or Embedded SQL)." to asHints[24]
        Get _WatchListScanFile (&asCode) (&asReport) (&asWatch) (&asHints) to iSites
        Function_Return iSites
    End_Function

    /* CHARACTER-MODE DATAFLEX (Nils 2026-09-20: "I have accepted a request to make the tool also
       accept DF Character Mode code"). A DataFlex 3.x program's skeleton is Use UI - the
       character-mode base that defines its screen language: images (/name ... /*), Page, Accept,
       Entry, Gotoxy, Keyproc, the UI object set. DataFlex 26 ships no character mode, so such a
       program has no DataFlex 26 build at all: its first compile error is UI.PKG not found and
       everything after is cascade (a 2005-era workspace - DataFlex's own Winkern.pkg failing against
       itself, and a board of its names). Three pure pieces: the skeleton test that lets the Check
       say so instead of compiling, the image-start test they share, and the inventory scan that
       measures the screen layer - the half no line converter can carry, and the number a migration
       estimate needs. All unit-tested via oCharacterModeInventory-Tests. */
    // True when the program's Use list names the character-mode base (ui / ui.pkg) and no Windows
    // base (DFAllEnt, Windows, DfClient, AllWebAppClasses, VdfBase). Image bodies are skipped.
    Function _IsCharacterModeSkeleton String[] asLines Returns Boolean
        String[] asWords
        String sPkg
        Integer i iLast
        Boolean bUi bWin bInImage bStart

        Move False to bUi
        Move False to bWin
        Move False to bInImage
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CharModeImageStart asLines[i] to bStart
            If (bInImage = True) Begin
                If (Trim(asLines[i]) = "/*") ;
                    Move False to bInImage
            End
            Else If (bStart = True) Begin
                Move True to bInImage
            End
            Else Begin
                Get _SplitSourceWords asLines[i] to asWords
                If (SizeOfArray(asWords) >= 2) Begin
                    If (Lowercase(asWords[0]) = "use") Begin
                        Move (Lowercase(asWords[1])) to sPkg
                        If (Right(sPkg, 4) = ".pkg") ;
                            Move (Left(sPkg, (Length(sPkg) - 4))) to sPkg
                        If (sPkg = "ui") ;
                            Move True to bUi
                        If (sPkg = "dfallent" or sPkg = "windows" or sPkg = "dfclient" or sPkg = "allwebappclasses" or sPkg = "vdfbase") ;
                            Move True to bWin
                    End
                End
            End
        Loop
        Function_Return (bUi = True and bWin = False)
    End_Function

    // An image opens with "/" at column 1 followed by its name ("/vMain"); "/*" (an image's close,
    // or a DF23 block comment) and "//" are not images. The body runs to the next "/*" line.
    Function _CharModeImageStart String sLine Returns Boolean
        String sSecond

        If (Length(sLine) < 2) ;
            Function_Return False
        If (Left(sLine, 1) <> "/") ;
            Function_Return False
        Move (Mid(sLine, 1, 2)) to sSecond
        Function_Return (sSecond <> "*" and sSecond <> "/" and sSecond <> " " and sSecond <> Character(9))
    End_Function

    // The screen / keyboard commands of the character-mode base, at command position. A few are
    // also modern console commands (Show, Showln, Beep) - a console-mode program uses them as its
    // screen - so a Windows program can score a handful; the skeleton test, not the count, decides
    // what a program is.
    Function _IsCharModeScreenCommand String sCmdLow Returns Boolean
        Function_Return (sCmdLow = "page" or sCmdLow = "screenmode" or sCmdLow = "accept" or sCmdLow = "entry" ;
            or sCmdLow = "entry_display" or sCmdLow = "entry_update" or sCmdLow = "entry_clear" or sCmdLow = "autopage" ;
            or sCmdLow = "gotoxy" or sCmdLow = "show" or sCmdLow = "showln" or sCmdLow = "display" or sCmdLow = "clearscreen" ;
            or sCmdLow = "cls" or sCmdLow = "blankform" or sCmdLow = "blanksform" or sCmdLow = "print_screen" ;
            or sCmdLow = "inkey" or sCmdLow = "keycheck" or sCmdLow = "beep" or sCmdLow = "scroll" ;
            or sCmdLow = "cursor_off" or sCmdLow = "cursor_on")
    End_Function

    // The character-mode UI classes with no Windows namesake. Panel, Client, Label and Message are
    // Windows classes too and are left out; Menu is kept - character-mode programs are built of them.
    Function _IsCharModeUiClass String sClassLow Returns Boolean
        Function_Return (sClassLow = "entry_form" or sClassLow = "entry_list" or sClassLow = "entry_client" ;
            or sClassLow = "entry_header" or sClassLow = "menu" or sClassLow = "query" or sClassLow = "text_window" ;
            or sClassLow = "selection_list" or sClassLow = "selection_form" or sClassLow = "confirm" or sClassLow = "table")
    End_Function

    /* The inventory scan for one file - PURE. Counts into Inv and appends "Line N: <kind>: <source>"
       to asReport for the first CI_CharModeReportCap sites, then one "... and N more" line. Image
       bodies are skipped: their lines are screen text, not code. Commands are matched at command
       position only; the UI classes on "Object <name> is a <class>" lines. _SplitSourceWords
       masks strings and end comments but not a DF23 block comment across lines - a character-mode
       file has none, and for a report the odd extra line is harmless. */
    Function _CharModeInventoryScanFile String[] ByRef asCode String[] ByRef asReport tCharModeInventory ByRef Inv Returns Integer
        String[] asWords
        String sCmd sKind sCls
        Integer i iLast iSites iShown
        Boolean bInImage bStart bHit

        Move 0 to iSites
        Move 0 to iShown
        Move False to bInImage
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move "" to sKind
            Get _CharModeImageStart asCode[i] to bStart
            If (bInImage = True) Begin
                If (Trim(asCode[i]) = "/*") ;
                    Move False to bInImage
            End
            Else If (bStart = True) Begin
                Move True to bInImage
                Move "image" to sKind
                Move (Inv.iImages + 1) to Inv.iImages
            End
            Else Begin
                Get _SplitSourceWords asCode[i] to asWords
                If (SizeOfArray(asWords) > 0) Begin
                    Move (Lowercase(asWords[0])) to sCmd
                    Get _IsCharModeScreenCommand sCmd to bHit
                    If (sCmd = "keyproc") Begin
                        Move "keyproc" to sKind
                        Move (Inv.iKeyprocs + 1) to Inv.iKeyprocs
                    End
                    Else If (bHit = True) Begin
                        Move "screen command" to sKind
                        Move (Inv.iScreenCmds + 1) to Inv.iScreenCmds
                    End
                    Else If (sCmd = "object" and SizeOfArray(asWords) >= 5) Begin
                        If (Lowercase(asWords[2]) = "is" and Lowercase(asWords[3]) = "a") Begin
                            Move (Lowercase(asWords[4])) to sCls
                            Get _IsCharModeUiClass sCls to bHit
                            If (bHit = True) Begin
                                Move ("UI object (" + asWords[4] + ")") to sKind
                                Move (Inv.iUiObjects + 1) to Inv.iUiObjects
                            End
                        End
                    End
                End
            End
            If (sKind <> "") Begin
                Increment iSites
                If (iShown < CI_CharModeReportCap) Begin
                    Move ("Line " + String(i + 1) + ": " + sKind + ": " + Trim(asCode[i])) to asReport[SizeOfArray(asReport)]
                    Increment iShown
                End
            End
        Loop
        If (iSites > iShown) ;
            Move ("   ... and " + String(iSites - iShown) + " more site(s) in this file.") to asReport[SizeOfArray(asReport)]
        If (iSites > 0) ;
            Move (Inv.iFiles + 1) to Inv.iFiles
        Function_Return iSites
    End_Function

    // The whole-file scan core behind LegacyDfPathReport (oRefactorFuncLib) - unit-tested via
    // oLegacyDfPathReport-Tests. Scans asCode for the obsolete Set_dfpath command at command position
    // (first word of a strings/comment-masked _SplitSourceWords split) and appends a "Line N: <src>"
    // + "modern: <note>" pair per site to asReport. Returns the site count. Pure - no engine/file
    // state, like _LegacySqlScanFile. Set_dfpath REPLACED the whole DFPATH env var (char-mode only);
    // modern DataFlex assembles the path in cWorkspace (psSystemDfPath -> psDfPath via DoAssignPaths),
    // so the fix is a per-site judgement (delete / append / replace) spelled out in the report header,
    // NOT a token swap - hence report-only. The modern "Set psDfPath ..." replacement is NOT flagged
    // (its first word is "Set", not "set_dfpath"). Watch/hint lists are PARALLEL: keep them aligned.
    Function _LegacyDfPathScanFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        String[] asWatch asHints
        Integer iSites

        Move "set_dfpath" to asWatch[0]
        Move "cWorkspace pathing - usually redundant now (the .ws config sets the paths). See the header for the delete / append psSystemDfPath / replace psDfPath options." to asHints[0]
        Get _WatchListScanFile (&asCode) (&asReport) (&asWatch) (&asHints) to iSites
        Function_Return iSites
    End_Function

    // Page title and opening paragraph for one generated function-help file. Kept beside the
    // writer rather than in RefactorConstants so the two cannot drift: each title must match the
    // caption of the help topic the generated file is pasted into.
    Function _FunctionTypeTitle Integer eType Returns String
        If (eType = eStandardFunction) ;
            Function_Return "Standard - Line by Line"
        If (eType = eRemoveFunction) ;
            Function_Return "Remove - Line by Line"
        If (eType = eEditorFunction) ;
            Function_Return "Editor - One File"
        If (eType = eReportFunction) ;
            Function_Return "Report - One File"
        If (eType = eReportFunctionAll) ;
            Function_Return "Report - All Files"
        If (eType = eOtherFunction) ;
            Function_Return "Other - One File"
        If (eType = eOtherFunctionAll) ;
            Function_Return "Other - All Files"
        Function_Return "Other"
    End_Function

    /* The HelpNDoc library reference for a page's icon, so the generated file is a COMPLETE topic
       and pasting it is a straight replace. These ids come from the help project; they change only
       if the image is re-imported there. A type with no id simply gets no icon.
    */
    Function _FunctionTypeIcon Integer eType Returns String
        String sTag

        Move "hnd-library://" to sTag
        If (eType = eStandardFunction) ;
            Function_Return ("![Standard icon](<" + sTag + "C3F22E08127C45E7A01908641D441A18>)")
        If (eType = eRemoveFunction) ;
            Function_Return ("![Remove icon](<" + sTag + "E29D60A29F5F4B078AA8FB64EBB935EC>)")
        If (eType = eEditorFunction) ;
            Function_Return ("![Editor icon](<" + sTag + "AFB7E6CEDD2944DB867E56187C68C3A0>)")
        If (eType = eReportFunction) ;
            Function_Return ("![Report icon](<" + sTag + "4BE2CDAA934F4902BD8A08D81301DB29>)")
        If (eType = eReportFunctionAll) ;
            Function_Return ("![Report icon](<" + sTag + "D8DC9639489B436C9C32974DDB0F3457>)")
        If (eType = eOtherFunction) ;
            Function_Return ("![Other icon](<" + sTag + "C1A5AFF19BF34278A15000947D4DC83C>)")
        If (eType = eOtherFunctionAll) ;
            Function_Return ("![Other icon](<" + sTag + "DBFC1D1C61AA44A1A3278CD6234D4C61>)")
        Function_Return ""
    End_Function

    /* The developer note that heads the two whole-file pages. It is about WRITING a refactoring
       function rather than about any one function, so it belongs to the page, not to a
       { Description } - and it must survive a regenerate, hence living here.
    */
    Function _CancelHandlingNote Integer eType Returns String
        String sN
        If (eType <> eOtherFunction and eType <> eOtherFunctionAll) ;
            Function_Return ""
        Move ("## Cancel handling inside refactoring functions" + (Character(10)) + (Character(10))) to sN
        Move (sN + "> If a refactoring function (especially of the eOtherFunction and eOtherFunctionAll types) loops over many lines or files, it can let the user cancel without waiting for the loop to finish. Use:" + (Character(10)) + (Character(10))) to sN
        Move (sN + "> Get pbUserCancelRequested of ghoEngine to bCancel" + (Character(10)) + (Character(10))) to sN
        Move (sN + "> and leave the loop when it returns True. **Never** call Get Cancel_Check of ghoEngine from inside a refactoring function. That is the engine's own cancel handling: it closes the status panel and shows the confirmation dialog, and calling it from a function uses up the cancel request without anyone noticing. The engine then cannot see the cancel, and the program seems to hang while it continues with the remaining files. **pbUserCancelRequested** only reads the state and changes nothing, so the engine's own cancel check between files still works.") to sN
        Function_Return sN
    End_Function

    Function _FunctionTypeIntro Integer eType Returns String
        If (eType = eStandardFunction) ;
            Function_Return "Functions of type eStandardFunction work on one source line at a time. The engine calls each selected function for every line of every selected file. The line is passed by reference, and the function returns True if it changed the line."
        If (eType = eRemoveFunction) ;
            Function_Return "Functions of type eRemoveFunction work on one source line at a time. They remove legacy or generated lines from the source code. The function returns True when a line should be removed."
        If (eType = eEditorFunction) ;
            Function_Return "Functions of type eEditorFunction work on a whole file through the Scintilla editor control. The control is an OCX and must be visible to work, so the editor view is shown automatically during a run that includes one of these functions. For the same reason they are slower than the line-by-line types: the source code is passed through the editor control instead of being processed in memory."
        If (eType = eReportFunction) ;
            Function_Return "Functions of type eReportFunction receive one source file as a string array and report what they find. They make no changes to the source code."
        If (eType = eReportFunctionAll) ;
            Function_Return "Functions of type eReportFunctionAll check all selected files together and report what they find; they make no changes to the source code. Each one writes its results to a log file, which you open with Tools > Logs > Other Log Files."
        If (eType = eOtherFunction) ;
            Function_Return "Functions of type eOtherFunction work on a whole file, passed as a string array of source lines. The function returns the number of lines it changed."
        If (eType = eOtherFunctionAll) ;
            Function_Return "Functions of type eOtherFunctionAll receive all selected files of the workspace at once. They are used for changes that need to look at several files together."
        Function_Return ""
    End_Function

    /* Turns the raw text of a { Description } (or a { ParamHelp }) into markdown paragraphs.

       The text is prose WRAPPED at whatever width the author typed to, so one source line is not
       one paragraph: emitting each line separately splits sentences mid-thought, which is how the
       first generated draft read ("...the DF 25/26 error 4544 fix" / "for a name that nothing
       outside the workspace owns"). Joining everything into one paragraph is just as wrong - it
       runs deliberate structure, Example: lines and limitation lists, together.

       A line is treated as a CONTINUATION of the one before it when BOTH hold:
         - the previous line does not end a sentence (no '.', '!' or '?'), and
         - this line starts with a lower-case letter.

       Both halves are needed. Ending punctuation alone gets "Example: Sysdate dToday -> Move
       (Date(CurrentDateTime())) to dToday" wrong, because it ends in a variable name and the next
       sentence would be glued onto it. A lower-case start alone gets "...where renaming would
       change nothing." / "sParameter is 'Name=Type'" wrong, because sParameter begins lower-case.
       Together they classify every shape in the current library correctly.

       Case is tested through Ascii(), NOT by comparing to "a" and "z": DataFlex string comparison
       is case-INSENSITIVE, so "A" >= "a" is true and the test would pass for every letter.
       A blank line always ends a paragraph.
    */
    Function _DescriptionParagraphs String sText Returns String[]
        String[] asLines asParas
        String sPara sLine sLast sFirst
        Integer iLineLast iL iAsc

        Move (Replaces(C_NewLine, sText, (Character(10)))) to sText
        Move (Replaces((Character(13)), sText, (Character(10)))) to sText
        Move (StrSplitToArray(sText, (Character(10)))) to asLines
        Move (SizeOfArray(asLines)) to iLineLast
        If (iLineLast = 0) ;
            Function_Return asParas
        Decrement iLineLast

        Move "" to sPara
        For iL from 0 to iLineLast
            Move (Trim(asLines[iL])) to sLine
            If (sLine = "") Begin
                If (sPara <> "") Begin
                    Move sPara to asParas[SizeOfArray(asParas)]
                    Move "" to sPara
                End
            End
            Else Begin
                If (sPara = "") Begin
                    Move sLine to sPara
                End
                Else Begin
                    Move (Right(sPara, 1)) to sLast
                    Move (Left(sLine, 1)) to sFirst
                    Move (Ascii(sFirst)) to iAsc
                    If (sLast <> "." and sLast <> "!" and sLast <> "?" and iAsc >= 97 and iAsc <= 122) Begin
                        Move (sPara * sLine) to sPara
                    End
                    Else Begin
                        Move sPara to asParas[SizeOfArray(asParas)]
                        Move sLine to sPara
                    End
                End
            End
        Loop
        If (sPara <> "") ;
            Move sPara to asParas[SizeOfArray(asParas)]
        Function_Return asParas
    End_Function

    // The message numbers off a function's { ModRecipe } tags, deduped and comma-joined.
    // One function can carry several tags naming the same number, so the dedupe matters.
    Function _ModRecipeMessages String[] asModRecipe Returns String
        Integer iRecLast iR iBar
        String sMsgs sMsg
        String[] asSeen

        Move "" to sMsgs
        Move (SizeOfArray(asModRecipe)) to iRecLast
        If (iRecLast = 0) ;
            Function_Return ""
        Decrement iRecLast
        For iR from 0 to iRecLast
            Move (Trim(asModRecipe[iR])) to sMsg
            Move (Pos("|", sMsg)) to iBar
            If (iBar > 0) ;
                Move (Trim(Left(sMsg, (iBar - 1)))) to sMsg
            If (sMsg <> "" and (SearchArray(sMsg, asSeen)) = -1) Begin
                Move sMsg to asSeen[SizeOfArray(asSeen)]
                If (sMsgs <> "") ;
                    Move (sMsgs + ", ") to sMsgs
                Move (sMsgs + sMsg) to sMsgs
            End
        Loop
        Function_Return sMsgs
    End_Function

    /* The shared explanation that heads a { FnFamily } table. Kept here beside the writer rather
       than in a tag: it describes a GROUP, so no single function owns it, and { Description } has a
       size budget that prose about its neighbours has no business spending.
       A family with no text here still renders - it just gets its table without a preamble.
    */
    Function _FunctionFamilyIntro String sFamily Returns String
        String sF
        Move (Lowercase(Trim(sFamily))) to sF
        If (sF = "command to function") ;
            Function_Return "Each of these functions replaces a legacy command with the modern function of the same name, in a Move statement. The conversion is automatic and does not change what the code does. They are separate functions only so that a workspace can be converted one keyword at a time. The compiler reports the command forms; the function forms are already modern and are never changed."
        If (sF = "increment and decrement") ;
            Function_Return "These functions replace legacy short commands with their modern equivalents, one keyword per function."
        If (sF = "comment out obsolete") ;
            Function_Return "These functions do not rewrite anything. Each one comments out code that the target DataFlex no longer needs, so the original line is still visible, and the change can be undone. Use them when the code needs no modern replacement at all."
        Function_Return ""
    End_Function

    /* Writes ONE generated function-help markdown file: every documented function of eType, in
       alphabetical order, built from the PARSED meta-tags (pFuncLibArray) rather than from the
       source text - so what is documented is exactly what the engine, the Select Functions picker
       and the Modernization Analyzer see. Called once per type by the DFRefactorService program.
       Returns how many functions were written.

       Each source line of a { Description } becomes its own markdown paragraph, which is how the
       hand-written pages were laid out. A sentence wrapped across two source lines therefore
       splits into two paragraphs - a deliberate, visible nudge to re-wrap that Description one
       sentence per line, rather than something for this writer to guess at.

       Skips { NoDoc = True } and { Private = True }: the first by request, the second because a
       private function is not part of the shipped set.
    */
    Function _WriteFunctionHelpFile tFuncLib[] FuncLibArray Integer eType String sFile Returns Integer
        Integer iCh iFuncLast iFn iLast i iAt iLineLast iL iEnumLast iE iRecLast iR iBar iCount
        Integer iFam iFamLast
        String sText sMsgs sMsg sOne
        String[] asNames asLines asMsgSeen asFamilies

        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Function_Return 0

        // A COMPLETE topic: icon, intro, the page-level developer note, then the functions.
        // No HTML comment banner - HelpNDoc would render it as visible text in the manual.
        Move (_FunctionTypeIcon(Self, eType)) to sText
        If (sText <> "") Begin
            Writeln channel iCh sText
            Writeln channel iCh ""
        End
        Writeln channel iCh (_FunctionTypeIntro(Self, eType))
        Writeln channel iCh ""
        Move (_CancelHandlingNote(Self, eType)) to sText
        If (sText <> "") Begin
            Writeln channel iCh "&nbsp;"
            Writeln channel iCh ""
            Writeln channel iCh sText
            Writeln channel iCh ""
        End

        // Two passes over this page's functions. FIRST the { FnFamily } tables: a run of near-
        // identical converters reads far better as one table with a shared explanation than as
        // fifteen sections repeating the same sentence. THEN the individual sections, alphabetical,
        // for everything that carries no family. SearchArray is no use here - on a struct array it
        // compares whole structs, not the sName member.
        Move (SizeOfArray(FuncLibArray)) to iFuncLast
        Decrement iFuncLast
        For iFn from 0 to iFuncLast
            If (FuncLibArray[iFn].eFunctionType = eType) Begin
                If (FuncLibArray[iFn].bNoDoc = False and FuncLibArray[iFn].bPrivate = False) Begin
                    If (Trim(FuncLibArray[iFn].sFnFamily) = "") Begin
                        Move FuncLibArray[iFn].sName to asNames[SizeOfArray(asNames)]
                    End
                    Else Begin
                        // one entry per DISTINCT family name, in first-seen order
                        If ((SearchArray(FuncLibArray[iFn].sFnFamily, asFamilies)) = -1) ;
                            Move FuncLibArray[iFn].sFnFamily to asFamilies[SizeOfArray(asFamilies)]
                    End
                End
            End
        Loop
        Move (SortArray(asNames)) to asNames

        Move 0 to iCount
        // --- the family tables -----------------------------------------------------------
        Move (SizeOfArray(asFamilies)) to iFamLast
        Decrement iFamLast
        For iFam from 0 to iFamLast
            Writeln channel iCh "&nbsp;"
            Writeln channel iCh ""
            Writeln channel iCh ("## " + asFamilies[iFam])
            Writeln channel iCh ""
            Move (_FunctionFamilyIntro(Self, asFamilies[iFam])) to sText
            If (sText <> "") Begin
                Writeln channel iCh sText
                Writeln channel iCh ""
            End
            // Column 3 is spelled out, not "Fixes": a bare 4531 means nothing to a reader who
            // does not already know that DataFlex numbers its compiler messages. Matches the
            // "Fixes compiler message(s):" label used in the per-function sections below.
            Writeln channel iCh "| **Function** | **Example** | **Fixes compiler message** |"
            Writeln channel iCh "| --- | --- | --- |"
            For iFn from 0 to iFuncLast
                If (FuncLibArray[iFn].eFunctionType = eType and FuncLibArray[iFn].sFnFamily = asFamilies[iFam]) Begin
                    If (FuncLibArray[iFn].bNoDoc = False and FuncLibArray[iFn].bPrivate = False) Begin
                        /* Column 2 is the Description's Example line, with its "Example:"
                           label stripped - for a family of near-identical converters the
                           example carries the whole meaning, and the summary sentences are
                           interchangeable. Falls back to the first line for a member that
                           has no example, which is a sign that Description wants one. */
                        Get _DescriptionParagraphs FuncLibArray[iFn].sHelp to asLines
                        Move "" to sOne
                        Move (SizeOfArray(asLines)) to iLineLast
                        Decrement iLineLast
                        For iL from 0 to iLineLast
                            If (sOne = "") Begin
                                Move (Trim(asLines[iL])) to sText
                                If (Lowercase(Left(sText, 7)) = "example") Begin
                                    Move (Pos(":", sText)) to iBar
                                    If (iBar > 0) ;
                                        Move (Trim(Mid(sText, (Length(sText) - iBar), (iBar + 1)))) to sText
                                    Move sText to sOne
                                End
                            End
                        Loop
                        If (sOne = "" and SizeOfArray(asLines) > 0) ;
                            Move asLines[0] to sOne
                        Get _ModRecipeMessages FuncLibArray[iFn].asModRecipe to sMsgs
                        If (sMsgs = "") ;
                            Move "-" to sMsgs
                        Writeln channel iCh ("| " + FuncLibArray[iFn].sName + " | " + sOne + " | " + sMsgs + " |")
                        Increment iCount
                    End
                End
            Loop
            Writeln channel iCh ""
        Loop

        Move (SizeOfArray(asNames)) to iLast
        Decrement iLast
        For i from 0 to iLast
            Move -1 to iAt
            For iFn from 0 to iFuncLast
                If (iAt = -1 and FuncLibArray[iFn].sName = asNames[i]) ;
                    Move iFn to iAt
            Loop
            If (iAt <> -1) Begin
                Writeln channel iCh "&nbsp;"
                Writeln channel iCh ""
                Writeln channel iCh ("## " + asNames[i])
                Writeln channel iCh ""

                // The { Description } prose, re-joined into paragraphs.
                Get _DescriptionParagraphs FuncLibArray[iAt].sHelp to asLines
                Move (SizeOfArray(asLines)) to iLineLast
                Decrement iLineLast
                For iL from 0 to iLineLast
                    Writeln channel iCh asLines[iL]
                    Writeln channel iCh ""
                Loop

                // What the function is for, worded as the Select Functions picker groups it.
                Writeln channel iCh ("**Group:** " + FnGroupText(Self, FuncLibArray[iAt].eFunctionGroup))
                Writeln channel iCh ""

                // The sParameter values, when the function takes one.
                If (FuncLibArray[iAt].bFuncEnumList = True) Begin
                    Move "" to sOne
                    Move (SizeOfArray(FuncLibArray[iAt].FuncEnumList.asEnumList)) to iEnumLast
                    Decrement iEnumLast
                    For iE from 0 to iEnumLast
                        If (sOne <> "") ;
                            Move (sOne + ", ") to sOne
                        Move (sOne + Trim(FuncLibArray[iAt].FuncEnumList.asEnumList[iE])) to sOne
                    Loop
                    If (sOne <> "") Begin
                        Writeln channel iCh ("**Parameter:** " + sOne)
                        Writeln channel iCh ""
                    End
                    If (Trim(FuncLibArray[iAt].FuncEnumList.sInitialValue) <> "") Begin
                        Writeln channel iCh ("Default: " + Trim(FuncLibArray[iAt].FuncEnumList.sInitialValue))
                        Writeln channel iCh ""
                    End
                    // { ParamHelp } already carries real line breaks - RegisterInterface turns
                    // its \n markers into CRLF at parse time.
                    Get _DescriptionParagraphs FuncLibArray[iAt].FuncEnumList.sParamHelp to asLines
                    Move (SizeOfArray(asLines)) to iLineLast
                    Decrement iLineLast
                    For iL from 0 to iLineLast
                        Writeln channel iCh asLines[iL]
                        Writeln channel iCh ""
                    Loop
                End

                // The compiler messages this function is wired to fix, deduped.
                Get _ModRecipeMessages FuncLibArray[iAt].asModRecipe to sMsgs
                If (sMsgs <> "") Begin
                    Writeln channel iCh ("**Fixes compiler message(s):** " + sMsgs)
                    Writeln channel iCh ""
                End
                Increment iCount
            End
        Loop

        Send rfCloseOutput iCh
        Function_Return iCount
    End_Function


    // The whole-file scan core behind LegacyFieldOptionsReport (oRefactorFuncLib) - unit-tested via
    // oLegacyFieldOptionsReport-Tests. Unlike the command-position scans (_LegacySqlScanFile etc.), the
    // character-mode field ENTRY OPTIONS (autofind, noenter, displayonly, ...) appear as OPTIONS ANYWHERE
    // in a field/entry declaration - and usually PARENTHESISED, e.g. '(displayonly)' - not as the first
    // word. So this matches each watch token with _FindKeywordPos on the _CodeOnlyLine mask (comments/string
    // literals stripped) - EXACTLY the eDSAnywhere grid path (grid/plan parity) - which sees '(displayonly)'
    // as the word 'displayonly' but never a token inside a string or comment.
    // Per line it reports the DataDictionary Field_Options target(s) found, deduped. Pure - no engine/file
    // state. The watch set is the ENABLED entry-option Deep Scan rules only (the generic/noisy ones -
    // Required / Status / Group / Fill / ... - stay disabled & Explain). Report-only, so a stray same-named
    // identifier is harmless noise (noted in the report header). Watch/hint lists are PARALLEL: keep aligned.
    Function _LegacyFieldOptionsScanFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        String[] asWatch asHints
        Integer iLine iLineLast iTok iTokLast iSites iR
        String sHits sLine
        Boolean bGate

        Move "autofind"      to asWatch[0]
        Move "autofind_ge"   to asWatch[1]
        Move "capslock"      to asWatch[2]
        Move "displayonly"   to asWatch[3]
        Move "findreq"       to asWatch[4]
        Move "forceput"      to asWatch[5]
        Move "noenter"       to asWatch[6]
        Move "noput"         to asWatch[7]
        Move "skipfound"     to asWatch[8]
        Move "retainall"     to asWatch[9]
        Move "zero_suppress" to asWatch[10]
        Move "DD_AUTOFIND"                        to asHints[0]
        Move "Field_Options (autofind, GE variant)" to asHints[1]
        Move "DD_CAPSLOCK"                        to asHints[2]
        Move "DD_DISPLAYONLY"                     to asHints[3]
        Move "DD_FINDREQ"                         to asHints[4]
        Move "Field_Options (force-put)"          to asHints[5]
        Move "DD_NOENTER"                         to asHints[6]
        Move "DD_NOPUT"                           to asHints[7]
        Move "DD_SKIPFOUND"                       to asHints[8]
        Move "Field_Options (retain-all)"         to asHints[9]
        Move "Field_Options (zero-suppress)"      to asHints[10]
        // FILE PRE-GATE (Nils 2026-07-16 perf sweep) - see _LegacyDbApiScanFile.
        Get _FileContainsAnyText (&asCode) (&asWatch) to bGate
        If (bGate = False) ;
            Function_Return 0
        Move 0 to iSites
        Move (SizeOfArray(asCode)) to iLineLast
        If (iLineLast = 0) ;
            Function_Return 0
        Decrement iLineLast
        Move (SizeOfArray(asWatch)) to iTokLast
        Decrement iTokLast
        For iLine from 0 to iLineLast
            Get _CodeOnlyLine asCode[iLine] to sLine
            Move "" to sHits
            For iTok from 0 to iTokLast
                If (_FindKeywordPos(Self, sLine, asWatch[iTok], True, 1) > 0) Begin
                    If (sHits = "") ;
                        Move asHints[iTok] to sHits
                    Else If (not(sHits contains asHints[iTok])) ;
                        Move (sHits + ", " + asHints[iTok]) to sHits
                End
            Loop
            If (sHits <> "") Begin
                Move (SizeOfArray(asReport)) to iR
                Move ("  Line " + String(iLine + 1) + ":  " + Trim(asCode[iLine])) to asReport[iR]
                Move ("      modern:  set as DataDictionary Field_Options -> " + sHits) to asReport[iR + 1]
                Increment iSites
            End
        Loop
        Function_Return iSites
    End_Function

    /* PASS 1 OF THE GOSUB AUDIT AND THE GOSUB PLAN, shared: every label (lowercased, and as written) with its
       line, every Gosub / ON..GOSUB call target with its line and whether it came from an ON..GOSUB, every
       Gosub_Return with its kind, every Goto target with its line. Each line's code as the file walk read it
       (_WalkedCodeLine): strings blank, the end comment cut, and none in a block comment's, a report image's, a
       multi-line string's or a #HEADER line's text; blank and preprocessor lines skipped. Read raw until
       2026-10-30, commented-out Gosub code counted - its label split a real subroutine, and the converter wrote
       that label's Procedure line inside the comment and its End_Procedure in the code below - and a report
       image's "Total:" was a label. The two walks were verbatim copies kept in step by hand. */
    Procedure _GosubCollectSites String[] ByRef asCode String[] ByRef asLabels String[] ByRef asLabelsOrig Integer[] ByRef aiLabelLines ;
            String[] ByRef asCallTargets Integer[] ByRef aiCallLines Boolean[] ByRef abCallOn ;
            Integer[] ByRef aiRetLines Integer[] ByRef aiRetKinds String[] ByRef asGotoTargets Integer[] ByRef aiGotoLines
        Integer iLine iLast iCount i iN iKind
        String sTrim sCode sLabel sTarget
        Boolean bOn
        tLineInfo[] aInfo

        Move (SizeOfArray(asCode) - 1) to iLast
        Get ScanSourceFile (&asCode) to aInfo
        For iLine from 0 to iLast
            Get _WalkedCodeLine asCode[iLine] aInfo[iLine] to sCode
            Move (Trim(sCode)) to sTrim
            If (sTrim = "" or Left(sTrim, 1) = "#") Begin
                // no code (a blank line, a comment, a report image's or a string's text) / preprocessor
            End
            Else Begin
                Move sTrim to sCode
                Get _GosubLineLabel sCode to sLabel
                If (sLabel <> "") Begin
                    Move (Lowercase(sLabel)) to asLabels[SizeOfArray(asLabels)]
                    Move sLabel               to asLabelsOrig[SizeOfArray(asLabelsOrig)]
                    Move iLine                to aiLabelLines[SizeOfArray(aiLabelLines)]
                End
                Move False to bOn
                Move (SizeOfArray(asCallTargets)) to iN
                Get _GosubCallTargets sCode (&asCallTargets) (&bOn) to iCount
                For i from iN to (iN + iCount - 1)
                    Move iLine to aiCallLines[SizeOfArray(aiCallLines)]
                    Move bOn   to abCallOn[SizeOfArray(abCallOn)]
                Loop
                Get _GosubReturnKind sCode to iKind
                If (iKind > 0) Begin
                    Move iLine to aiRetLines[SizeOfArray(aiRetLines)]
                    Move iKind to aiRetKinds[SizeOfArray(aiRetKinds)]
                End
                Get _GotoTarget sCode to sTarget
                If (sTarget <> "") Begin
                    Move sTarget to asGotoTargets[SizeOfArray(asGotoTargets)]
                    Move iLine   to aiGotoLines[SizeOfArray(aiGotoLines)]
                End
            End
        Loop
    End_Procedure

    /* ON ERROR GOSUB <label> IS AN ERROR TRAP, NOT A DISPATCH (2026-11-02). FMAC's On command stores the label's
       address as the error handler, and a runtime error jumps there. Read as On <expr> Gosub it became a Case on a
       symbol called 'error' with a 'Send <label>_Sub' under it: that traps nothing and does not compile. The line
       stays as written and its label stays a label. */
    Function _GosubOnIsErrorTrap String sLine Returns Boolean
        String sCode sExpr
        Integer iOn iGosub

        Get _CodeOnlyLine sLine to sCode
        Get _FindKeywordPos sCode "gosub" True 1 to iGosub
        Get _FindKeywordPos sCode "on" True 1 to iOn
        If (iGosub = 0 or iOn = 0 or iOn > iGosub) ;
            Function_Return False
        Move (Trim(Mid(sCode, (iGosub - (iOn + 2)), (iOn + 2)))) to sExpr
        Function_Return (Lowercase(sExpr) = "error")
    End_Function

    // Is sLabel (lowercase) the target of an ON ERROR GOSUB? The site arrays are _GosubCollectSites'.
    Function _GosubIsErrorTrapLabel String[] ByRef asCode String[] ByRef asCallTargets Integer[] ByRef aiCallLines Boolean[] ByRef abCallOn String sLabel Returns Boolean
        Integer j iLast
        Boolean bTrap

        Move (SizeOfArray(asCallTargets) - 1) to iLast
        For j from 0 to iLast
            If (abCallOn[j] = True and asCallTargets[j] = sLabel) Begin
                Get _GosubOnIsErrorTrap asCode[aiCallLines[j]] to bTrap
                If (bTrap = True) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    /* WHY A SUBROUTINE'S BLOCK CANNOT BE A PROCEDURE, "" when it can (2026-11-02). A block runs to the line before
       the next called label, and the last one to the end of the file. So a subroutine with methods below it took them
       into its Procedure, and a label inside an 'If False Begin' wrapper took the wrapper's End: a Procedure opened
       inside an If and closed at the end of the file, with every method after it illegal. */
    Function _GosubBlockBlocker String[] ByRef asCode tLineInfo[] ByRef aInfo Integer iStart Integer iEnd Returns String
        String sCode sFirst
        Integer i iDepth iBegin

        Move 0 to iDepth
        For i from iStart to iEnd
            Get _WalkedCodeLine asCode[i] aInfo[i] to sCode
            Move (Lowercase(Trim(Replaces(Character(9), sCode, " ")))) to sCode
            If (sCode <> "") Begin
                Get _NthWord sCode 1 to sFirst
                If (sFirst = "function" or sFirst = "procedure" or sFirst = "class" or sFirst = "object" or sFirst = "struct" or ;
                    sFirst = "end_function" or sFirst = "end_procedure" or sFirst = "end_class" or sFirst = "end_object" or sFirst = "end_struct") ;
                    Function_Return ("its block runs over a '" + sFirst + "' at line " + String(i + 1))
                If (sFirst = "end" or sCode = "case end") Begin
                    Decrement iDepth
                    If (iDepth < 0) ;
                        Function_Return ("its block ends inside an If or other Begin block, at line " + String(i + 1))
                End
                Get _FindKeywordPos sCode "begin" True 1 to iBegin
                If (iBegin > 0) ;
                    Increment iDepth
            End
        Loop
        Function_Return ""
    End_Function

    /* THE SUBROUTINE BLOCKS: the labels a Gosub / ON..GOSUB actually calls, in line order, each block running to
       the line before the next called label (a goto-only label is an internal waypoint) and the last to iLast,
       the file's last line. */
    Procedure _GosubSubBlocks String[] ByRef asLabels String[] ByRef asLabelsOrig Integer[] ByRef aiLabelLines String[] ByRef asCallTargets Integer iLast ;
            String[] ByRef asSubs String[] ByRef asSubsOrig Integer[] ByRef aiSubLines Integer[] ByRef aiSubEnds
        Integer i iSubLast iBlockEnd

        For i from 0 to (SizeOfArray(asLabels) - 1)
            If (SearchArray(asLabels[i], asCallTargets) <> -1) Begin
                Move asLabels[i]     to asSubs[SizeOfArray(asSubs)]
                Move asLabelsOrig[i] to asSubsOrig[SizeOfArray(asSubsOrig)]
                Move aiLabelLines[i] to aiSubLines[SizeOfArray(aiSubLines)]
            End
        Loop
        Move (SizeOfArray(asSubs) - 1) to iSubLast
        For i from 0 to iSubLast
            If (i < iSubLast) ;
                Move (aiSubLines[i + 1] - 1) to iBlockEnd
            Else ;
                Move iLast to iBlockEnd
            Move iBlockEnd to aiSubEnds[i]
        Loop
    End_Procedure

    // True when a Goto at iGotoLine to a label at iTargetLine crosses the boundary of the block
    // iBlockStart..iBlockEnd, in either direction.
    Function _GosubGotoCrossesBlock Integer iGotoLine Integer iTargetLine Integer iBlockStart Integer iBlockEnd Returns Boolean
        If (iGotoLine >= iBlockStart and iGotoLine <= iBlockEnd) ;
            Function_Return (iTargetLine < iBlockStart or iTargetLine > iBlockEnd)
        Function_Return (iTargetLine >= iBlockStart and iTargetLine <= iBlockEnd)
    End_Function

    // The whole-file Gosub/Goto audit behind GosubGotoReport: fills asReport with the per-file
    // section (already indented; the caller adds the file header + writes the lines) and returns
    // the number of findings. Inventories the Gosub SUBROUTINES (labels called via Gosub /
    // ON..GOSUB) with a per-subroutine verdict - CANDIDATE for Procedure extraction vs MANUAL
    // (and why) - and classifies every Goto with a concrete rewrite hint (Nils 2026-07-09):
    // forward skip -> If/Else block; backward jump -> While/Repeat loop; boundary-crossing ->
    // untangle first (it blocks converting that subroutine); unknown target -> macro/include.
    // A subroutine BLOCK spans its label to the next gosub-called label (goto-only labels are
    // internal waypoints and do not end a block). The verdict is CONTROL-FLOW only - shared
    // module variables still need review (stated in the report header). Report-grade parsing:
    // raw lines, '//' end comments stripped, so a keyword inside a string literal could in
    // principle false-hit - acceptable for a read-only report (same trade as the other reports).
    Function _GosubAuditFile String[] ByRef asCode String[] ByRef asReport Returns Integer
        Integer iLast iPos i j iSubLast iFindings iCalls iRets
        String sReasons sVerdict sHint sOwner sBlocker
        Boolean bCrossing bGate bTrap
        tLineInfo[] aInfo
        String[] asLabels asLabelsOrig asCallTargets asGotoTargets asSubs asSubsOrig
        Integer[] aiLabelLines aiCallLines aiGotoLines aiRetLines aiRetKinds aiSubLines aiSubEnds
        Boolean[] abCallOn

        // FILE PRE-GATE (Nils 2026-07-16 perf sweep): a finding requires a Gosub or a Goto
        // somewhere in the raw text ("gosub" also covers ON..GOSUB and Gosub_Return) - no
        // mention = skip the per-line label/call collection entirely (_FileContainsText
        // semantics: false hits harmless, never a false miss).
        Get _FileContainsText (&asCode) "gosub" to bGate
        If (bGate = False) ;
            Get _FileContainsText (&asCode) "goto" to bGate
        If (bGate = False) ;
            Function_Return 0

        Move (SizeOfArray(asCode) - 1) to iLast
        Send _GosubCollectSites (&asCode) (&asLabels) (&asLabelsOrig) (&aiLabelLines) (&asCallTargets) (&aiCallLines) (&abCallOn) ;
            (&aiRetLines) (&aiRetKinds) (&asGotoTargets) (&aiGotoLines)
        Move 0 to iFindings

        // ---- The SUBROUTINES: labels that a Gosub / ON..GOSUB actually calls, in line order, with their block ends. ----
        Send _GosubSubBlocks (&asLabels) (&asLabelsOrig) (&aiLabelLines) (&asCallTargets) iLast (&asSubs) (&asSubsOrig) (&aiSubLines) (&aiSubEnds)
        Move (SizeOfArray(asSubs) - 1) to iSubLast

        If (iSubLast >= 0) Begin
            Get ScanSourceFile (&asCode) to aInfo
            Move ("  Subroutines (labels called via Gosub): " + String(iSubLast + 1)) to asReport[SizeOfArray(asReport)]
            For i from 0 to iSubLast
                // calls / returns inside this block
                Move 0 to iCalls
                For j from 0 to (SizeOfArray(asCallTargets) - 1)
                    If (asCallTargets[j] = asSubs[i]) ;
                        Increment iCalls
                Loop
                Move 0 to iRets
                Move "" to sReasons
                For j from 0 to (SizeOfArray(aiRetLines) - 1)
                    If (aiRetLines[j] >= aiSubLines[i] and aiRetLines[j] <= aiSubEnds[i]) Begin
                        Increment iRets
                        If (aiRetKinds[j] = 3) ;
                            Move (sReasons + "; 'Gosub_Return <label>' at line " + String(aiRetLines[j] + 1) + " (leaves the stack dirty)") to sReasons
                        If (aiRetKinds[j] = 2) ;
                            Move (sReasons + "; 'Gosub_Return Return' at line " + String(aiRetLines[j] + 1) + " (nested-stack pop)") to sReasons
                    End
                Loop
                If (iRets = 0) ;
                    Move (sReasons + "; no Gosub_Return in its block (falls through?)") to sReasons
                // gotos crossing this block's boundary (either direction)
                For j from 0 to (SizeOfArray(asGotoTargets) - 1)
                    Move (SearchArray(asGotoTargets[j], asLabels)) to iPos
                    If (iPos <> -1) Begin
                        Get _GosubGotoCrossesBlock aiGotoLines[j] aiLabelLines[iPos] aiSubLines[i] aiSubEnds[i] to bCrossing
                        If (bCrossing = True) ;
                            Move (sReasons + "; goto crosses its boundary (line " + String(aiGotoLines[j] + 1) + ")") to sReasons
                    End
                Loop
                Get _GosubIsErrorTrapLabel (&asCode) (&asCallTargets) (&aiCallLines) (&abCallOn) asSubs[i] to bTrap
                If (bTrap = True) ;
                    Move (sReasons + "; the target of ON ERROR GOSUB - an error handler, which stays a label") to sReasons
                Get _GosubBlockBlocker (&asCode) (&aInfo) aiSubLines[i] aiSubEnds[i] to sBlocker
                If (sBlocker <> "") ;
                    Move (sReasons + "; " + sBlocker) to sReasons
                If (sReasons = "") ;
                    Move "CANDIDATE for Procedure extraction - control flow is self-contained (still review shared variable use)" to sVerdict
                Else ;
                    Move ("MANUAL - " + Trim(Mid(sReasons, Length(sReasons), 3))) to sVerdict
                Move ("    " + asSubs[i] + ":  line " + String(aiSubLines[i] + 1) + ", " + String(iCalls) + " call(s), " + String(iRets) + " return(s)  ->  " + sVerdict) to asReport[SizeOfArray(asReport)]
                Increment iFindings
            Loop
        End

        // ---- ON..GOSUB dispatches (rewrite as a Case block of Send calls). ----
        For j from 0 to (SizeOfArray(aiCallLines) - 1)
            If (abCallOn[j] = True) Begin
                If (j = 0 or aiCallLines[j] <> aiCallLines[j - 1]) Begin
                    Get _GosubOnIsErrorTrap asCode[aiCallLines[j]] to bTrap
                    If (bTrap = True) ;
                        Move ("    line " + String(aiCallLines[j] + 1) + ":  ON ERROR GOSUB  ->  an error trap, not a dispatch - the converters leave it; it needs a rewrite by hand") to asReport[SizeOfArray(asReport)]
                    Else ;
                        Move ("    line " + String(aiCallLines[j] + 1) + ":  ON..GOSUB dispatch  ->  rewrite as a Case block of Send calls (value 1 = first label, 2 = second, ...)") to asReport[SizeOfArray(asReport)]
                    Increment iFindings
                End
            End
        Loop

        // ---- Gosub calls whose target label is NOT in this file (an include / .mac macro). ----
        For j from 0 to (SizeOfArray(asCallTargets) - 1)
            If (SearchArray(asCallTargets[j], asLabels) = -1) Begin
                Move ("    line " + String(aiCallLines[j] + 1) + ":  Gosub " + asCallTargets[j] + "  ->  target label is NOT in this file (include / macro?) - map it manually") to asReport[SizeOfArray(asReport)]
                Increment iFindings
            End
        Loop

        // ---- Every Goto, classified with its rewrite hint (Nils 2026-07-09). ----
        If (SizeOfArray(asGotoTargets) > 0) Begin
            Move ("  Goto sites: " + String(SizeOfArray(asGotoTargets))) to asReport[SizeOfArray(asReport)]
            For j from 0 to (SizeOfArray(asGotoTargets) - 1)
                Move (SearchArray(asGotoTargets[j], asLabels)) to iPos
                If (iPos = -1) Begin
                    Move "target not in this file (include / macro?) - resolve manually" to sHint
                End
                Else Begin
                    // crossing any subroutine boundary beats the direction-based hints
                    Move "" to sOwner
                    For i from 0 to iSubLast
                        If (aiGotoLines[j] >= aiSubLines[i] and aiGotoLines[j] <= aiSubEnds[i] and (aiLabelLines[iPos] < aiSubLines[i] or aiLabelLines[iPos] > aiSubEnds[i])) ;
                            Move asSubs[i] to sOwner
                        If (aiLabelLines[iPos] >= aiSubLines[i] and aiLabelLines[iPos] <= aiSubEnds[i] and (aiGotoLines[j] < aiSubLines[i] or aiGotoLines[j] > aiSubEnds[i])) ;
                            Move asSubs[i] to sOwner
                    Loop
                    If (sOwner <> "") ;
                        Move ("crosses subroutine '" + sOwner + "' - untangle first (this BLOCKS converting it)") to sHint
                    Else If (aiLabelLines[iPos] < aiGotoLines[j]) ;
                        Move "backward jump = a LOOP - rewrite as While / Repeat-Until" to sHint
                    Else ;
                        Move "forward skip - rewrite as an If/Else block around the skipped lines" to sHint
                End
                Move ("    line " + String(aiGotoLines[j] + 1) + ":  goto " + asGotoTargets[j] + "  ->  " + sHint) to asReport[SizeOfArray(asReport)]
                Increment iFindings
            Loop
        End

        // ---- Orphan labels: defined but never referenced by any Gosub or Goto. ----
        For i from 0 to (SizeOfArray(asLabels) - 1)
            If (SearchArray(asLabels[i], asCallTargets) = -1 and SearchArray(asLabels[i], asGotoTargets) = -1) Begin
                Move ("    orphan label '" + asLabels[i] + "':  line " + String(aiLabelLines[i] + 1) + "  ->  never referenced - dead code? (check for macro/include callers first)") to asReport[SizeOfArray(asReport)]
                Increment iFindings
            End
        Loop
        Function_Return iFindings
    End_Function

    // ---------------- Gosub -> Procedure conversion PLAN (Phase 2 of the Gosub work) ----------------
    // The CANDIDATE classification of _GosubAuditFile, returned as STRUCTURED data the converter acts
    // on (the report emits text; this emits a machine-usable plan). A subroutine is CONVERTIBLE when:
    //   (1) it is CANDIDATE - self-contained control flow: at least one PLAIN Gosub_Return, none of the
    //       'Gosub_Return Return' / 'Gosub_Return <label>' forms, and no goto crosses its boundary, AND
    //   (2) every subroutine it calls (plain Gosub and ON..GOSUB targets) is ALSO convertible - a
    //       transitive closure. A residual 'Gosub Y' left inside an extracted Procedure (Y unconverted
    //       or external / in a macro) would illegally cross the Procedure boundary, so such a caller is
    //       withdrawn from the set, and so on to a fixpoint.
    // Fills the parallel arrays - lowercased label, original-case label, 0-based block-START line
    // (the label line), 0-based block-END line - and returns the convertible count. Pure + unit-tested.
    Function _GosubConvertPlan String[] ByRef asCode String[] ByRef asCandLabels String[] ByRef asCandOrig Integer[] ByRef aiCandStart Integer[] ByRef aiCandEnd Returns Integer
        Integer iLast iPos iCount i j iSubLast iRets idx
        Boolean bCrossing bChanged bTrap
        String sBlocker
        tLineInfo[] aInfo
        String[] asLabels asLabelsOrig asCallTargets asGotoTargets asSubs asSubsOrig asEmptyS
        Integer[] aiLabelLines aiCallLines aiGotoLines aiRetLines aiRetKinds aiSubLines aiSubEnds aiEmptyI
        Boolean[] abCallOn abCand

        // caller passes fresh arrays, but reset the outputs defensively (this appends via SizeOfArray).
        Move asEmptyS to asCandLabels
        Move asEmptyS to asCandOrig
        Move aiEmptyI to aiCandStart
        Move aiEmptyI to aiCandEnd

        // ---- Pass 1: collect labels / calls / returns / gotos (shared with _GosubAuditFile) ----
        Move (SizeOfArray(asCode) - 1) to iLast
        Send _GosubCollectSites (&asCode) (&asLabels) (&asLabelsOrig) (&aiLabelLines) (&asCallTargets) (&aiCallLines) (&abCallOn) ;
            (&aiRetLines) (&aiRetKinds) (&asGotoTargets) (&aiGotoLines)

        // ---- The SUBROUTINES: labels that a Gosub / ON..GOSUB actually calls, in line order, with their block ends. ----
        Send _GosubSubBlocks (&asLabels) (&asLabelsOrig) (&aiLabelLines) (&asCallTargets) iLast (&asSubs) (&asSubsOrig) (&aiSubLines) (&aiSubEnds)
        Move (SizeOfArray(asSubs) - 1) to iSubLast

        // ---- CANDIDATE per sub: only PLAIN Gosub_Returns + no boundary-crossing goto, no error handler, and a
        //      block that is one piece of code (_GosubOnIsErrorTrap, _GosubBlockBlocker) ----
        If (iSubLast >= 0) ;
            Get ScanSourceFile (&asCode) to aInfo
        For i from 0 to iSubLast
            Move True to abCand[i]
            Move 0 to iRets
            For j from 0 to (SizeOfArray(aiRetLines) - 1)
                If (aiRetLines[j] >= aiSubLines[i] and aiRetLines[j] <= aiSubEnds[i]) Begin
                    Increment iRets
                    If (aiRetKinds[j] <> 1) ;
                        Move False to abCand[i]        // 'Return' / label-arg forms block extraction
                End
            Loop
            If (iRets = 0) ;
                Move False to abCand[i]                // no return in its block (falls through)
            For j from 0 to (SizeOfArray(asGotoTargets) - 1)
                Move (SearchArray(asGotoTargets[j], asLabels)) to iPos
                If (iPos <> -1) Begin
                    Get _GosubGotoCrossesBlock aiGotoLines[j] aiLabelLines[iPos] aiSubLines[i] aiSubEnds[i] to bCrossing
                    If (bCrossing = True) ;
                        Move False to abCand[i]
                End
            Loop
            Get _GosubIsErrorTrapLabel (&asCode) (&asCallTargets) (&aiCallLines) (&abCallOn) asSubs[i] to bTrap
            If (bTrap = True) ;
                Move False to abCand[i]
            Get _GosubBlockBlocker (&asCode) (&aInfo) aiSubLines[i] aiSubEnds[i] to sBlocker
            If (sBlocker <> "") ;
                Move False to abCand[i]
        Loop

        // ---- Transitive closure: withdraw any sub that calls a non-convertible / external target ----
        Repeat
            Move False to bChanged
            For i from 0 to iSubLast
                If (abCand[i] = True) Begin
                    For j from 0 to (SizeOfArray(aiCallLines) - 1)
                        If (aiCallLines[j] >= aiSubLines[i] and aiCallLines[j] <= aiSubEnds[i]) Begin
                            Move (SearchArray(asCallTargets[j], asSubs)) to idx
                            If (idx = -1) Begin
                                If (abCand[i] = True) Begin
                                    Move False to abCand[i]     // calls a label not defined as a sub here
                                    Move True to bChanged
                                End
                            End
                            Else If (abCand[idx] = False) Begin
                                If (abCand[i] = True) Begin
                                    Move False to abCand[i]     // calls a sub that itself is not convertible
                                    Move True to bChanged
                                End
                            End
                        End
                    Loop
                End
            Loop
        Until (bChanged = False)

        // ---- Emit the convertible plan ----
        Move 0 to iCount
        For i from 0 to iSubLast
            If (abCand[i] = True) Begin
                Move asSubs[i]     to asCandLabels[SizeOfArray(asCandLabels)]
                Move asSubsOrig[i] to asCandOrig[SizeOfArray(asCandOrig)]
                Move aiSubLines[i] to aiCandStart[SizeOfArray(aiCandStart)]
                Move aiSubEnds[i]  to aiCandEnd[SizeOfArray(aiCandEnd)]
                Increment iCount
            End
        Loop
        Function_Return iCount
    End_Function

    // Rewrites a plain / inline-If 'Gosub X' line to 'Send X_Sub' when X is a convertible subroutine
    // (asCandLabels lowercased, asCandOrig original-case, parallel). Preserves indentation, any leading
    // 'If <cond>' guard, and any trailing comment; the keyword is located boundary-aware on the
    // code-masked line so a 'gosub' inside a literal / comment is never touched. Returns the line
    // UNCHANGED when it holds no gosub call, an ON..GOSUB (handled by _GosubOnLineToCase), or a gosub
    // to a non-convertible target. Pure.
    Function _GosubCallLineToSend String sLine String[] ByRef asCandLabels String[] ByRef asCandOrig Returns String
        String sMask sTarget sTargetLc sOrig sTail sCh
        Integer iGosub iOn iAfter iLen iTStart iTEnd ii

        Get _CodeOnlyLine sLine to sMask
        Get _FindKeywordPos sMask "gosub" True 1 to iGosub
        If (iGosub = 0) ;
            Function_Return sLine
        Get _FindKeywordPos sMask "on" True 1 to iOn
        If (iOn > 0 and iOn < iGosub) ;
            Function_Return sLine                       // ON..GOSUB - not this helper's job
        Move (Length(sMask)) to iLen
        Move (iGosub + 5) to iAfter                     // first char after 'gosub'
        // skip whitespace to the target token
        Move iAfter to iTStart
        Move (Mid(sMask, 1, iTStart)) to sCh
        While (iTStart <= iLen and (sCh = " " or sCh = Character(9)))
            Increment iTStart
            Move (Mid(sMask, 1, iTStart)) to sCh
        Loop
        If (iTStart > iLen) ;
            Function_Return sLine
        // target token span
        Move iTStart to iTEnd
        Move (Mid(sMask, 1, iTEnd)) to sCh
        While (iTEnd <= iLen and sCh <> " " and sCh <> Character(9) and sCh <> "")
            Increment iTEnd
            Move (Mid(sMask, 1, iTEnd)) to sCh
        Loop
        Move (Mid(sLine, (iTEnd - iTStart), iTStart)) to sTarget    // target text (positions align)
        Move (Lowercase(Trim(sTarget))) to sTargetLc
        Move (SearchArray(sTargetLc, asCandLabels)) to ii
        If (ii = -1) ;
            Function_Return sLine
        Move asCandOrig[ii] to sOrig
        Move (Mid(sLine, Length(sLine), iTEnd)) to sTail            // trailing spaces + comment
        Function_Return (Left(sLine, (iGosub - 1)) + "Send " + sOrig + "_Sub" + sTail)
    End_Function

    // Rewrites an 'ON <expr> GOSUB l1 l2 ... lN' computed dispatch to a Case block of 'Send lK_Sub'
    // calls (value 1 selects l1, 2 selects l2, ...; an out-of-range value branches nowhere, matching
    // On..Gosub). Fills asOut with the generated block and returns its line count WHEN the line IS an
    // ON..GOSUB and EVERY target is convertible; 0 otherwise (caller leaves the line as-is). The
    // original line rides along as a leading '// [DFRefactor] was:' comment. Indentation is the source
    // line's. Pure.
    Function _GosubOnLineToCase String sLine String[] ByRef asCandLabels String[] ByRef asCandOrig String[] ByRef asOut Returns Integer
        String sMask sIndent sExpr sOrig sCh
        Integer iOn iGosub iN i ii
        Boolean bOn bAll bTrap
        String[] asTgt asEmpty

        Move asEmpty to asOut
        Get _GosubOnIsErrorTrap sLine to bTrap
        If (bTrap = True) ;
            Function_Return 0
        Get _CodeOnlyLine sLine to sMask
        Get _FindKeywordPos sMask "gosub" True 1 to iGosub
        If (iGosub = 0) ;
            Function_Return 0
        Get _FindKeywordPos sMask "on" True 1 to iOn
        If (iOn = 0 or iOn > iGosub) ;
            Function_Return 0
        Move False to bOn
        Get _GosubCallTargets sMask (&asTgt) (&bOn) to iN
        If (bOn = False or iN = 0) ;
            Function_Return 0
        Move True to bAll
        For i from 0 to (iN - 1)
            If (SearchArray(asTgt[i], asCandLabels) = -1) ;
                Move False to bAll
        Loop
        If (bAll = False) ;
            Function_Return 0
        // expression = the code between 'on' and 'gosub' (positions align on the real line)
        Move (Trim(Mid(sLine, (iGosub - (iOn + 2)), (iOn + 2)))) to sExpr
        Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
        Move (sIndent + "// [DFRefactor] was: " + Trim(sLine)) to asOut[SizeOfArray(asOut)]
        Move (sIndent + "Case Begin") to asOut[SizeOfArray(asOut)]
        For i from 0 to (iN - 1)
            Move (SearchArray(asTgt[i], asCandLabels)) to ii
            Move asCandOrig[ii] to sOrig
            Move (sIndent + "    Case (" + sExpr + " = " + String(i + 1) + ")") to asOut[SizeOfArray(asOut)]
            Move (sIndent + "        Send " + sOrig + "_Sub") to asOut[SizeOfArray(asOut)]
            Move (sIndent + "        Case Break") to asOut[SizeOfArray(asOut)]
        Loop
        Move (sIndent + "Case End") to asOut[SizeOfArray(asOut)]
        Function_Return (SizeOfArray(asOut))
    End_Function

    // Collects (lowercased, de-duplicated) the identifier tokens referenced inside the convertible
    // Gosub blocks [aiStart[i]..aiEnd[i]] - the candidate name set that, if a name ALSO appears as a
    // file-scope declaration, must be promoted to Global_Variable so an extracted Procedure can see it.
    // Tokenizes each line's code as the file walk read it (aInfo, _WalkedCodeLine), so names next to
    // operators / parentheses are caught and the words of a comment or a report image are not (2026-10-30).
    // Over-inclusive by design (keywords ride along harmlessly - only names that also match a file-scope
    // declaration are ever promoted). Pure enough - reads no engine state beyond the shared tokenizer.
    Function _GosubCollectBlockNames String[] ByRef asCode tLineInfo[] ByRef aInfo Integer[] ByRef aiStart Integer[] ByRef aiEnd String[] ByRef asNames Returns Integer
        String sTok sTokLc sCh sCode
        Integer iLine iLast i k iNTok iBlocks iAsc
        Boolean bInBlock bIdent
        tTokenizer TD
        String[] asEmpty

        Move asEmpty to asNames
        Move (SizeOfArray(asCode) - 1) to iLast
        Move (SizeOfArray(aiStart) - 1) to iBlocks
        For iLine from 0 to iLast
            Move False to bInBlock
            For i from 0 to iBlocks
                If (iLine >= aiStart[i] and iLine <= aiEnd[i]) ;
                    Move True to bInBlock
            Loop
            If (bInBlock = True) Begin
                Get _WalkedCodeLine asCode[iLine] aInfo[iLine] to sCode
                Move -1 to iNTok
                If (Trim(sCode) <> "") Begin
                    Get Tokenizer of Self sCode to TD
                    Move (SizeOfArray(TD.asLineTokens) - 1) to iNTok
                End
                For k from 0 to iNTok
                    Move TD.asLineTokens[k] to sTok
                    Move (Left(sTok, 1)) to sCh
                    Move (Ascii(sCh)) to iAsc
                    Move False to bIdent
                    If ((iAsc >= 65 and iAsc <= 90) or (iAsc >= 97 and iAsc <= 122) or sCh = "_") ;
                        Move True to bIdent
                    If (bIdent = True) Begin
                        Move (Lowercase(sTok)) to sTokLc
                        If (SearchArray(sTokLc, asNames) = -1) ;
                            Move sTokLc to asNames[SizeOfArray(asNames)]
                    End
                Loop
            End
        Loop
        Function_Return (SizeOfArray(asNames))
    End_Function

    // Transforms one line INSIDE the file for the Gosub->Procedure converter, filling asOutLines with
    // the result (1 line normally, several for an ON..GOSUB->Case expansion) and returning the count.
    // bInBlock = the line lies inside an extracted Procedure body (only then is a PLAIN 'Gosub_Return'
    // turned into 'Procedure_Return'; a top-level Gosub_Return in the still-flat entry code is left
    // alone). 'Gosub X'->'Send X_Sub' and 'ON..GOSUB'->Case apply in BOTH contexts (a converted sub is
    // a global procedure reachable by Send from anywhere). Non-matching lines pass through verbatim.
    Function _GosubTransformBodyLine String sLine Boolean bInBlock String[] ByRef asCandLabels String[] ByRef asCandOrig String[] ByRef asOutLines Returns Integer
        String sMask sNew
        Integer iN iKind iGR
        String[] asCase asEmpty

        Move asEmpty to asOutLines
        // ON..GOSUB -> Case (only when every target is convertible)
        Get _GosubOnLineToCase sLine (&asCandLabels) (&asCandOrig) (&asCase) to iN
        If (iN > 0) Begin
            Move asCase to asOutLines
            Function_Return iN
        End
        // plain / inline 'Gosub X' -> 'Send X_Sub'
        Get _GosubCallLineToSend sLine (&asCandLabels) (&asCandOrig) to sNew
        If (sNew <> sLine) Begin
            Move sNew to asOutLines[0]
            Function_Return 1
        End
        // plain 'Gosub_Return' -> 'Procedure_Return' (inside an extracted Procedure only)
        If (bInBlock = True) Begin
            Get _CodeOnlyLine sLine to sMask
            Get _GosubReturnKind sMask to iKind
            If (iKind = 1) Begin
                Get _FindKeywordPos sMask "gosub_return" True 1 to iGR
                If (iGR > 0) Begin
                    Move (Left(sLine, (iGR - 1)) + "Procedure_Return" + Mid(sLine, Length(sLine), (iGR + 12))) to sNew
                    Move sNew to asOutLines[0]
                    Function_Return 1
                End
            End
        End
        Move sLine to asOutLines[0]
        Function_Return 1
    End_Function

    // The usage of legacy indicator variables, sometimes was combined with some
    // strange programming styles. Amongst them are to apply square bracket indicators,
    // before 'Loop' and 'Repeat'(!)
    // Returns: If '<cond> Loop', a conditional loop-BACK, converts it to the post-test 'Until (Not(cond))'
    //          (the '~' form collapses, so '[~seqeof] loop' -> 'Until (seqeof)'); a bare 'Loop' stays 'Loop'.
    //          If 'Repeat', changes 'Repeat' to 'While' and moves the expression to
    //          the right of the command.
    Function FixIndicatorsLoopRepeatCommand String sOverstrikeLine Returns String
        Integer iPos
        String sExpression sTrimmed

        Move (Trim(sOverstrikeLine)) to sTrimmed
        // The 'Loop' keyword is the TRAILING token (the bracket pass already turned the indicator into '(cond)').
        // Match it by trailing boundary, NOT a substring Pos: the old Pos(CS_Loop) matched 'loop' inside an
        // identifier (e.g. a loopCount var) and clobbered the whole line to 'Loop'. A conditional loop-back
        // becomes 'Until (Not(cond))' so its exit test survives (a bare 'Loop' would spin forever; LegacyApp
        // files.nui '[~seqeof] loop'). A bare 'Loop' with no leading condition stays a plain terminator.
        If (Lowercase(sTrimmed) = Lowercase(CS_Loop)) Begin
            Move CS_Loop to sOverstrikeLine
        End
        Else If (Lowercase(Right(sTrimmed, (Length(CS_Loop) + 1))) = (CS_S + Lowercase(CS_Loop))) Begin
            Move (Trim(Left(sTrimmed, (Length(sTrimmed) - Length(CS_Loop) - 1)))) to sExpression
            If (sExpression <> "") Begin
                Get _NegateLoopBackCondition sExpression to sExpression
                Move (CS_Until * sExpression) to sOverstrikeLine
            End
            Else ;
                Move CS_Loop to sOverstrikeLine
        End
        Else Begin
            Move (Pos(Lowercase(CS_Repeat), Lowercase(sOverstrikeLine))) to iPos
            If (iPos <> 0) Begin
                Move (Left(sOverstrikeLine, (iPos -1))) to sExpression
                Move (CS_While * Trim(sExpression)) to sOverstrikeLine
            End
        End
        
        Function_Return sOverstrikeLine
    End_Function
    
    /* Position-aligned MASK of ONE rebuilt statement line, for the rename pair below: every
       character inside a string literal, and everything from a '//' outside literals, becomes
       '#' - so a keyword search on the mask can never hit prose or literal text, while every
       position still names the same character in the raw line. The lexer's _OverstrikeStrings
       is NOT reusable here: it trims and strips the line, so its output no longer aligns with
       the raw positions, and it carries page/multi-line state a single rebuilt statement never
       has. Single-line by contract - the rename pair only ever sees the converter's own
       one-statement output. */
    Function _MaskStatementLine String sLine Returns String
        Integer i iLen iState
        String sCh sNext sOut

        Move "" to sOut
        Move 0 to iState        // 0 = outside, 1 = inside "...", 2 = inside '...'
        Move (Length(sLine)) to iLen
        Move 1 to i
        While (i <= iLen)
            Move (Mid(sLine, 1, i)) to sCh
            If (iState = 0) Begin
                Move "" to sNext
                If (i < iLen) ;
                    Move (Mid(sLine, 1, (i + 1))) to sNext
                If (sCh = '"') Begin
                    Move (sOut + "#") to sOut
                    Move 1 to iState
                End
                Else Begin
                    If (sCh = "'") Begin
                        Move (sOut + "#") to sOut
                        Move 2 to iState
                    End
                    Else Begin
                        If (sCh = "/" and sNext = "/") Begin
                            Move (sOut + Repeat("#", (iLen - i + 1))) to sOut
                            Move iLen to i
                        End
                        Else Begin
                            Move (sOut + sCh) to sOut
                        End
                    End
                End
            End
            Else Begin
                Move (sOut + "#") to sOut
                If (iState = 1 and sCh = '"') ;
                    Move 0 to iState
                If (iState = 2 and sCh = "'") ;
                    Move 0 to iState
            End
            Increment i
        Loop
        Function_Return sOut
    End_Function

    // Post-process for ChangeLegacyIndicators' rebuilt output: replace every whole-word occurrence
    // of the RAW indicator name in sLine with its _IndicatorVarName ('gb'-prefixed) form. The Case
    // rebuild emits the raw names - the bIfStart dispatch in between searches the ORIGINAL line and
    // tokens BY those names, so the rename can only happen once, at the exit, on the final line.
    /* LOCATED ON A MASK, never on the raw text (alpha report, 2026-08-28): '[finderr] indicate
       leeg True  // als database leeg altijd doorgaan' renamed the indicator INSIDE the Dutch
       comment - 'leeg' is also a word of its prose - and a name inside a string literal or a
       File.Field reference is the same corruption. The masked sibling below already refuses all
       three (comment/literal via the mask, dotted hits explicitly); this wrapper now only
       builds the mask and delegates. */
    Function _PrefixIndicatorRefs String sLine String sRawName Returns String
        String sNew sMasked sWork
        Boolean bChanged

        Get _IndicatorVarName sRawName to sNew
        If (sNew = sRawName or sRawName = "") ;
            Function_Return sLine
        /* sWork, not sLine: the masked sibling takes its line ByRef, and handing it the address
           of this function's own PARAMETER emptied the line when the call arrived through the
           converter's deeper ByRef chain (engine &sLine -> converter -> here) - while a shallow
           direct call worked, which is what made it hard to see. A LOCAL is always addressable. */
        Move sLine to sWork
        Get _MaskStatementLine sWork to sMasked
        Get _PrefixIndicatorRefsMasked (&sWork) (&sMasked) sRawName to bChanged
        Function_Return sWork
    End_Function

    // Masked companion to _PrefixIndicatorRefs, for lines the converters never rewrote (bare
    // expression READS of a converted indicator, e.g. 'If (not(Login_Successful)) Begin').
    // Occurrences are LOCATED on sMasked - the overstruck text position-aligned with the raw
    // line (TokenizerData.sIndentation + sOverstrikeLine), so a name inside a string literal
    // or comment can never match - and the gb name is spliced into BOTH strings so the pair
    // stays aligned for the caller's next name. A hit with '.' on either side is a File.Field
    // or struct-member reference, never the indicator global - skipped. Defensive: a hit whose
    // raw-line text does not equal the name (mask misalignment) is skipped, not spliced blind.
    // Returns True when at least one occurrence was renamed.
    Function _PrefixIndicatorRefsMasked String ByRef sLine String ByRef sMasked String sRawName Returns Boolean
        String sNew sPrev sNext sAtRaw
        Integer iPos iStart iLen
        Boolean bChanged

        Get _IndicatorVarName sRawName to sNew
        If (sNew = sRawName or sRawName = "") ;
            Function_Return False
        Move (Length(sRawName)) to iLen
        Move 1 to iStart
        Get _FindKeywordPos sMasked sRawName True iStart to iPos
        While (iPos > 0)
            Move (Mid(sMasked, 1, (iPos - 1)))    to sPrev
            Move (Mid(sMasked, 1, (iPos + iLen))) to sNext
            Move (Mid(sLine, iLen, iPos))         to sAtRaw
            If (sPrev = "." or sNext = "." or (Lowercase(sAtRaw) <> Lowercase(sRawName))) Begin
                Move (iPos + iLen) to iStart
            End
            Else Begin
                Move (Left(sLine,   (iPos - 1)) + sNew + Mid(sLine,   Length(sLine),   (iPos + iLen))) to sLine
                Move (Left(sMasked, (iPos - 1)) + sNew + Mid(sMasked, Length(sMasked), (iPos + iLen))) to sMasked
                Move True to bChanged
                Move (iPos + Length(sNew)) to iStart
            End
            Get _FindKeywordPos sMasked sRawName True iStart to iPos
        Loop
        Function_Return bChanged
    End_Function

    // Samples:
    //   [FindErr], [Not Found], [~MyVar], [Found ~Found]
    // Returns:
    //   (FindErr), (not(Found)), (Not(MyVar)) (Found and Not(Found))
    //   User indicator names come back gb-PREFIXED ((Not(gbMyVar))) - see _IndicatorVarName.
    Function ConvertBracketIndicatorsToExpression Integer iLeftBracketNo tTokenizer TokenizerData Returns String
        String sToken sExpression
        Integer iPos iSize iCount iItem iLineTokensCount iItemTo iItemAs
        Boolean bHasBrackets bHasTo bHasAs
        
        Get _IsIndicatorStatement TokenizerData.sOverstrikeLine to bHasBrackets
        If (bHasBrackets = False) Begin
            Function_Return ""
        End
        Move (SearchArray("to", TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItemTo
        Move (SearchArray("as", TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItemAs
        
        Move 0 to iLineTokensCount
        // iLeftBracketNo is 1 based
        Decrement iLeftBracketNo
        Move (SizeOfArray(TokenizerData.asLineTokens)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move TokenizerData.asLineTokens[iCount] to sToken
            If (Left(sToken, 1) = "[" and iCount = iLeftBracketNo) Begin
                Move iCount to iLineTokensCount 
                Move iSize to iCount // We're out of here.
            End
        Loop
        Move (iItemTo <> -1 and iLineTokensCount >= iItemTo and iLineTokensCount <= iItemAs) to bHasTo
        Move (iItemAs <> -1 and iLineTokensCount >= iItemAs) to bHasAs
        
        Move "" to sExpression    
        If (bHasTo = False and bHasAs = False) Begin
            
            If (TokenizerData.BooleanIndicator.FirstBoolean.bHasBracket = True) Begin
                If (TokenizerData.BooleanIndicator.FirstBoolean.bHasNot = True) Begin
                    Append sExpression CS_Not "("
                End
                // Bracketed = an indicator name: emit its gb-prefixed form (system booleans and
                // non-identifiers pass through _IndicatorVarName unchanged). Same for the three
                // sibling members below.
                Get _IndicatorVarName TokenizerData.BooleanIndicator.FirstBoolean.sCode to sToken
                Append sExpression sToken
                If (TokenizerData.BooleanIndicator.FirstBoolean.bHasNot = True) Begin
                    Append sExpression ")"
                End
            End

            If (TokenizerData.BooleanIndicator.SecondBoolean.bHasBracket = True) Begin
                Append sExpression " and "
                If (TokenizerData.BooleanIndicator.SecondBoolean.bHasNot = True) Begin
                    Append sExpression CS_Not "("
                End
                Get _IndicatorVarName TokenizerData.BooleanIndicator.SecondBoolean.sCode to sToken
                Append sExpression sToken
                If (TokenizerData.BooleanIndicator.SecondBoolean.bHasNot = True) Begin
                    Append sExpression ")"
                End
            End
        End
        Else If (bHasTo = True) Begin
            If (TokenizerData.BooleanIndicator.ToBoolean.bHasBracket = True) Begin
                If (TokenizerData.BooleanIndicator.ToBoolean.bHasNot = True) Begin
                    Append sExpression CS_Not "("
                End
                Get _IndicatorVarName TokenizerData.BooleanIndicator.ToBoolean.sCode to sToken
                Append sExpression sToken
                If (TokenizerData.BooleanIndicator.ToBoolean.bHasNot = True) Begin
                    Append sExpression ")"
                End
            End
        End
        Else If (bHasAs = True) Begin
            If (TokenizerData.BooleanIndicator.AsBoolean.bHasBracket = True) Begin
                If (TokenizerData.BooleanIndicator.AsBoolean.bHasNot = True) Begin
                    Append sExpression CS_Not "("
                End
                Get _IndicatorVarName TokenizerData.BooleanIndicator.AsBoolean.sCode to sToken
                Append sExpression sToken
                If (TokenizerData.BooleanIndicator.AsBoolean.bHasNot = True) Begin
                    Append sExpression ")"
                End
            End
        End
        
        If (sExpression <> "") Begin
            Move ("(" + sExpression + ")") to sExpression
        End
        
        Move (Trim(sExpression)) to sExpression
        Function_Return sExpression
    End_Function
    
    // Returns the end comment if one exists - from its "//" to the end of the line - else "". A "//" inside a
    // string constant ("http://...") is no comment, and a whole-line comment is no END comment. The line
    // scanner's reading (ScanSourceLine, 2026-10-29).
    Function EndComment String sLine Returns String
        tLineScan Scan

        If (Left(Trim(Replaces((Character(9)), sLine, " ")), 2) = "//") ;
            Function_Return ""
        Get ScanSourceLine sLine "" False to Scan
        Function_Return (_ScannedEndComment(Self, sLine, Scan))
    End_Function

    // Sometimes a method has extra embedded spaces between its parameters.
    // We reduce consequitive spaces here to just one.
    // The Replaces function has a limit on how many occurances it can handle. 
    Function TrimInsideSpaces String sLine Returns String
        While (Pos("  ", sLine) <> 0)
            Move (Replaces("  ", sLine, CS_S)) to sLine  // as doc says you can't reduce 3+ spaces to 1 without running a loop
        Loop
        Function_Return sLine
    End_Function

    // Pass only the code part of a source line.
    // Returns True if the code contains any of "gt, ge, lt, le, eq, ne", in other words it is an expression.
    Function HasLegacyOperator String sOverStrikeLine Returns Boolean
        Boolean bHas

        Get _RemoveEndComment sOverStrikeLine to sOverStrikeLine
        Move (Lowercase(sOverStrikeLine)) to sOverStrikeLine

        Case Begin
            Case (sOverStrikeLine contains " gt ")
                Move True to bHas
                Case Break
            Case (sOverStrikeLine contains " ge ")
                Move True to bHas
                Case Break
            Case (sOverStrikeLine contains " lt ")
                Move True to bHas
                Case Break
            Case (sOverStrikeLine contains " le ")
                Move True to bHas
                Case Break
            Case (sOverStrikeLine contains " eq ")
                Move True to bHas
                Case Break
            Case (sOverStrikeLine contains " ne ")
                Move True to bHas
                Case Break
            Case Else
                Move False to bHas
        Case End

        Function_Return bHas
    End_Function

    // True when any legacy relational word (gt/ge/lt/le/eq/ne) on the MASKED line sits at
    // paren depth 0 - outside every parenthesis pair. DataFlex only allows an expression in
    // ARGUMENT position inside parens, so on a message-dispatch (Send/Get) line a depth-0
    // relational word is an ARGUMENT - typically an Integer find-MODE constant - never a
    // comparison operator (LegacyApp avtalsfakt.vw AddConstrain, 2026-07-24). Pass a line
    // that already has strings masked and the end-comment removed.
    Function _LegacyOpAtParenDepthZero String sMasked Returns Boolean
        String[] asOps
        String sChar
        Integer iOp iPos iStart iDepth i

        Move "gt" to asOps[0]
        Move "ge" to asOps[1]
        Move "lt" to asOps[2]
        Move "le" to asOps[3]
        Move "eq" to asOps[4]
        Move "ne" to asOps[5]
        For iOp from 0 to 5
            Move 1 to iStart
            Repeat
                Get _FindKeywordPos sMasked asOps[iOp] True iStart to iPos
                If (iPos > 0) Begin
                    Move 0 to iDepth
                    For i from 1 to (iPos - 1)
                        Move (Mid(sMasked, 1, i)) to sChar
                        If (sChar = "(") ;
                            Increment iDepth
                        Else If (sChar = ")") ;
                            Decrement iDepth
                    Loop
                    If (iDepth < 1) ;
                        Function_Return True
                    Move (iPos + 1) to iStart
                End
            Until (iPos = 0)
        Loop
        Function_Return False
    End_Function

    Function ReplaceParanthesis String sToken Returns String
        Integer iPos
        Move (Replace("(", sToken, "")) to sToken
        Move (RightPos(")", sToken)) to iPos    
        If (iPos <> 0) Begin
            Move (Overstrike(CS_S, sToken, iPos)) to sToken
        End
        Function_Return (Trim(sToken))
    End_Function

    // Removes any "[", "]" or "tilde" characters
    Function ReplaceBrackets String sToken Returns String
        Move (Replaces("[", sToken, "")) to sToken
        Move (Replaces("]", sToken, "")) to sToken
        Move (Replaces(CS_Tilde, sToken, "")) to sToken
        Function_Return (Trim(sToken))
    End_Function

    Function HasBracket tBooleanIndicator BooleanIndicator Returns Boolean
        Boolean bTrue
        Move (BooleanIndicator.FirstBoolean.bHasBracket = True or ;
              BooleanIndicator.SecondBoolean.bHasBracket = True or ;
              BooleanIndicator.ToBoolean.bHasBracket = True) to bTrue
        Function_Return bTrue
    End_Function

    // Swaps an obsolete COMMAND keyword for its modern equivalent IN PLACE (e.g. Decr -> Decrement),
    // preserving the line's indent, any nose (If/Else/...), and the arguments. Acts only when sOld
    // appears as a WHOLE token at the command position (tokenizer-confirmed), so a substring or a
    // variable named like the command is left untouched. Line-by-line (eStandardFunction) helper.
    Function _SwapCommandKeyword String ByRef sLine String sOld String sNew Returns Boolean
        tTokenizer TokenizerData
        Integer iItem iPos

        Get pTokenizer to TokenizerData
        If (LineIsNotCode(&TokenizerData)) Begin
            Function_Return False
        End
        Move (SearchArray(sOld, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem = -1) ;
            Function_Return False
        Move (Pos(Lowercase(sOld), Lowercase(sLine))) to iPos
        If (iPos = 0) ;
            Function_Return False
        Move (Left(sLine, (iPos - 1)) + sNew + Mid(sLine, Length(sLine), (iPos + Length(sOld)))) to sLine
        Function_Return True
    End_Function

    // Strips ONE redundant outer parenthesis pair when it wraps the WHOLE value, so a
    // pre-parenthesised command argument (e.g. "Character (9)") yields Character(9), not ((9)).
    // Leaves the value untouched when the outer parens do not enclose the entire expression
    // (e.g. "(a) + (b)").
    Function _StripRedundantParens String sVal Returns String
        Integer iLen i iDepth
        String sChar

        Move (Trim(sVal)) to sVal
        Move (Length(sVal)) to iLen
        If (iLen < 2) ;
            Function_Return sVal
        If ((Left(sVal, 1) <> "(") or (Right(sVal, 1) <> ")")) ;
            Function_Return sVal
        Move 0 to iDepth
        For i from 1 to iLen
            Move (Mid(sVal, 1, i)) to sChar
            If (sChar = "(") Begin
                Move (iDepth + 1) to iDepth
            End
            Else If (sChar = ")") Begin
                Move (iDepth - 1) to iDepth
            End
            // Outer pair closes before the end => it does NOT wrap everything; leave as-is.
            If ((iDepth = 0) and (i < iLen)) Begin
                Function_Return sVal
            End
        Loop
        Function_Return (Trim(Mid(sVal, (iLen - 2), 2)))
    End_Function

    // Given the lines of a legacy "Type ... End_Type" block, returns the proposed modern
    // "Struct ... End_Struct" lines: Type X -> Struct X; Field <name> AS <type> [count] ->
    // <type>[count] <name> (or <type> <name>); End_Type -> End_Struct. Any other line (comment /
    // blank / non-canonical Field) passes through unchanged. PURE (no file I/O) -> unit-testable;
    // powers the report-only TypeToStructReport worksheet and never rewrites source itself.
    // Lightweight STATELESS word splitter for the report-only Type scanners. Strips
    // string literals (RemoveStringsFromLine) and a trailing "//" comment
    // (_RemoveEndComment - a line whose FIRST non-blank chars are "//" is left intact,
    // so its leading "//" token simply matches no command), normalizes tabs, and
    // splits on whitespace into word tokens shaped like the stateful Tokenizer's
    // asLineTokens - but with NO cross-line/cross-call state. Report functions make no
    // source changes, so they never needed the heavy position-accurate Tokenizer;
    // calling it per line over 1000+ files made TypeToStructReport crawl, AND because
    // the engine Tokenizer is a shared singleton, skipping lines leaked stale
    // multi-line state between calls (the bogus "1" type-name; Nils 2026-06-11). PURE
    // -> unit-testable, and safe to call from any of the report scanners.
    // LIMITATION (acceptable for a REPORT): unlike the engine Tokenizer it does NOT
    // track /* */ block comments across lines, so a Type/accessor keyword written
    // inside a /* */ block would be picked up (a harmless extra worksheet line). If a
    // MUTATING refactor ever reuses this, add a cross-line bInBlockComment guard first.
    Function _SplitSourceWords String sLine Returns String[]
        String[] asRaw asWords
        Integer i iLast

        Get RemoveStringsFromLine sLine to sLine
        Get _RemoveEndComment sLine to sLine
        Move (Replaces(Character(9), sLine, " ")) to sLine
        Move (Trim(sLine)) to sLine
        // A whole-line comment has no source words. _RemoveEndComment deliberately LEAVES a leading
        // "//" in place (its other callers skip such lines themselves), and RemoveStringsFromLine ran
        // first, so the line still begins with "//" - return empty here so the stateless callers (the
        // used-type harvest, the accessor/CVTtoBytes scan) never tokenize the prose. Without this, a
        // comment like "...no rounding at all." was mis-read as the Type "all".
        If (sLine = "" or Left(sLine, 2) = CS_CommentSymbol) ;
            Function_Return asWords
        Move (StrSplitToArray(sLine, " ")) to asRaw
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            // Drop the empty cells StrSplitToArray emits for runs of spaces.
            If (asRaw[i] <> "") ;
                Move asRaw[i] to asWords[SizeOfArray(asWords)]
        Loop
        Function_Return asWords
    End_Function

    // Hungarian/type prefix for a Struct member of the given DataFlex data type (drops any array
    // suffix first, e.g. "Integer[5]" -> "Integer" -> "i"). "" for an unmapped type, so the member
    // keeps its bare name. Used by _HungarianMember (PART 1 struct members + PART 2 field refs).
    Function _TypePrefix String sType Returns String
        Integer iBracket

        Move (Pos("[", sType)) to iBracket
        If (iBracket > 1) ;
            Move (Left(sType, (iBracket - 1))) to sType
        Move (Trim(Lowercase(sType))) to sType
        Case Begin
            Case (sType = "integer")
                Function_Return "i"
            Case (sType = "uinteger")
                Function_Return "u"
            Case (sType = "bigint")
                Function_Return "bi"
            Case (sType = "ubigint")
                Function_Return "ubi"
            Case (sType = "number")
                Function_Return "n"
            Case (sType = "string")
                Function_Return "s"
            Case (sType = "boolean")
                Function_Return "b"
            Case (sType = "handle")
                Function_Return "h"
            Case (sType = "pointer")
                Function_Return "p"
            Case (sType = "dword")
                Function_Return "dw"
            Case (sType = "word")
                Function_Return "w"
            Case (sType = "char")
                Function_Return "c"
            Case (sType = "uchar")
                Function_Return "uc"
            Case (sType = "date")
                Function_Return "dt"
            Case (sType = "datetime")
                Function_Return "dt"
            Case (sType = "variant")
                Function_Return "v"
            Case Else
                Function_Return ""
        Case End
    End_Function

    // Apply the Hungarian convention: <prefix> + the bare member name with its first letter
    // upper-cased ("Integer","message" -> "iMessage"). To avoid doubling a prefix, a member that
    // ALREADY starts with its type prefix is left unchanged ("Handle","hwnd" -> "hwnd";
    // "Pointer","pt" -> "pt"; "String","sName" -> "sName"). An unmapped type returns the bare name.
    // PURE.
    Function _HungarianMember String sType String sBareName Returns String
        String sPrefix
        If (sBareName = "") ;
            Function_Return ""
        Get _TypePrefix sType to sPrefix
        If (sPrefix = "") ;
            Function_Return sBareName
        If (Lowercase(Left(sBareName, Length(sPrefix))) = sPrefix) ;
            Function_Return sBareName
        Function_Return (sPrefix + Uppercase(Left(sBareName, 1)) + Mid(sBareName, (Length(sBareName) - 1), 2))
    End_Function

    // Parse ONE Type-block line into a field's bare member name + data type + optional [count].
    // Handles both legacy forms: "Field <Type>.<field> as <datatype> [count]" and the type-first
    // "<datatype> <Type>.<field> [count]". The "<Type>." byte-offset prefix is stripped. Returns
    // False (outputs blank) for Type / End_Type / comment / blank / non-field lines. The single home
    // for field-line parsing - used by _TypeDefToStruct (PART 1) and _FieldDataType (PART 2). PURE.
    Function _ParseTypeField String sLine String ByRef sBareName String ByRef sDataType String ByRef sCount Returns Boolean
        String[] asWords
        String sCmd sNm sDt sCt
        Integer iNT iDot
     
        Move "" to sBareName
        Move "" to sDataType
        Move "" to sCount
        Move "" to sCt
        Get _SplitSourceWords sLine to asWords
        Move (SizeOfArray(asWords)) to iNT 

        If (iNT < 2) ;
            Function_Return False
        Move (Lowercase(asWords[0])) to sCmd
        If (sCmd = "type" or sCmd = "end_type") ;
            Function_Return False
        If (sCmd = "field") Begin
            // Field <name> as <datatype> [count]
            If (iNT < 4 or Lowercase(asWords[2]) <> "as") ;
                Function_Return False
            Move asWords[1] to sNm
            Move asWords[3] to sDt
            If (iNT > 4) ;
                Move asWords[4] to sCt
        End
        Else Begin
            // type-first "<datatype> <Type>.<field>": the 2nd token must be dotted.
            If (Pos(".", asWords[1]) < 1) ;
                Function_Return False
            Move asWords[0] to sDt
            Move asWords[1] to sNm
            If (iNT > 2) ;
                Move asWords[2] to sCt
        End
        // Strip the "<Type>." prefix from the member name.
        Move (Pos(".", sNm)) to iDot
        If (iDot >= 1 and iDot < Length(sNm)) ;
            Move (Mid(sNm, (Length(sNm) - iDot), (iDot + 1))) to sNm
        // Keep the size/dimension VERBATIM (a numeric literal OR a constant like 'CchFormName'). Do NOT
        // "Move sCt to <Integer>" to test it numeric: DF EVALUATES the string as a numeric expression, which
        // faults err 54 "Invalid symbol in expression" for a constant/identifier dimension (the
        // TypeToStructReport CCHFORMNAME error). The worksheet keeping the real dimension beats dropping it.
        If (sCt <> "") ;
            Move sCt to sCount
        If (sNm = "" or sDt = "") ;
            Function_Return False
        Move sNm to sBareName
        Move sDt to sDataType
        Function_Return True
    End_Function

    // The DataFlex data type of <sField> within the Type <sTypeName>, looked up in the Type catalog
    // (each tTypeDef.asBlock holds the raw Type-block lines). "" if the type or field is not found.
    // Lets PART 2 prefix a field reference (TheData.iMessage) consistently with PART 1's member. PURE.
    Function _FieldDataType tTypeDef[] aCatalog String sTypeName String sField Returns String
        Integer iK iKLast iL iLLast
        String sBare sDt sCt
        Boolean bField

        Move (SizeOfArray(aCatalog) - 1) to iKLast
        For iK from 0 to iKLast
            If (Lowercase(aCatalog[iK].sName) = Lowercase(sTypeName)) Begin
                Move (SizeOfArray(aCatalog[iK].asBlock) - 1) to iLLast
                For iL from 0 to iLLast
                    Get _ParseTypeField aCatalog[iK].asBlock[iL] (&sBare) (&sDt) (&sCt) to bField
                    If (bField and (Lowercase(sBare) = Lowercase(sField))) ;
                        Function_Return sDt
                Loop
            End
        Loop
        Function_Return ""
    End_Function

    Function _TypeDefToStruct String[] asBlock Returns String[]
        String[] asOut asWords
        String sLine sCmd sName sBare sDataType sCount
        Integer i iLast iOut iNTokens
        Boolean bField

        Move (SizeOfArray(asBlock) - 1) to iLast
        Move 0 to iOut
        For i from 0 to iLast
            Move asBlock[i] to sLine
            Get _SplitSourceWords sLine to asWords
            Move (SizeOfArray(asWords)) to iNTokens
            Move "" to sCmd
            If (iNTokens > 0) ;
                Move (Lowercase(asWords[0])) to sCmd
            Case Begin
                Case (sCmd = "type")
                    Move "" to sName
                    If (iNTokens > 1) ;
                        Move asWords[1] to sName
                    Move ("Struct " + sName) to asOut[iOut]
                    Increment iOut
                    Case Break
                Case (sCmd = "end_type")
                    Move "End_Struct" to asOut[iOut]
                    Increment iOut
                    Case Break
                Case Else
                    // A field line (either "Field <Type>.<field> as <dt> [count]" or the type-first
                    // "<dt> <Type>.<field>")? _ParseTypeField strips the "<Type>." prefix; _HungarianMember
                    // adds the type prefix (Integer message -> Integer iMessage). Comments / blanks /
                    // non-field lines pass through unchanged so the worksheet flags them.
                    Get _ParseTypeField sLine (&sBare) (&sDataType) (&sCount) to bField
                    If (bField = True) Begin
                        Get _HungarianMember sDataType sBare to sBare
                        If (sCount <> "") ;
                            Move (sDataType + "[" + sCount + "]") to sDataType
                        Move ("    " + sDataType + " " + sBare) to asOut[iOut]
                    End
                    Else Begin
                        Move sLine to asOut[iOut]
                    End
                    Increment iOut
            Case End
        Loop
        Function_Return asOut
    End_Function

    // ---- TypeToStructReport install-package catalogue cache -------------------------------------
    // The Type definitions live in the DataFlex install packages (psTargetPkgFolder), normally
    // changing only on a version bump - so scan them ONCE per target version and reuse. An in-place
    // update (same version folder) is caught too: each cache stamps the newest *.pkg write time and
    // self-invalidates when a package is later found newer (_PkgScanIsStale - shared by BOTH install
    // caches). Mirrors the ModAnalyzer recipe cache (cModAnalyzer: RecipeJsonPath / WriteRecipesToJson
    // / ReadRecipesFromJson).

    // ---- Install-package change watermark (shared by both install caches) -----------------------
    // The version-keyed cache filename detects a target SWITCH (different version folder), but not an
    // in-place update to the SAME version. These helpers fingerprint the install's *.pkg set by its
    // newest write time so a cache READ can self-invalidate when the packages were revised under the
    // same version. Stored/compared as a sortable string - lossless through JSON, locale-independent.

    // Newest last-write DateTime across a set of file-search results; NullDateTime() for an empty
    // set. Shared by the install-scan watermark writer (WalkInstallPackages) and the staleness probe.
    Function _NewestWriteTime tRFSearchResult[] aFiles Returns DateTime
        DateTime dtNewest dtThis
        Integer i iLast
        Boolean bHave

        Move (NullDateTime()) to dtNewest
        Move False to bHave
        Move (SizeOfArray(aFiles) - 1) to iLast
        For i from 0 to iLast
            Move aFiles[i].dtLastWriteDateTime to dtThis
            If (bHave = False or (dtThis > dtNewest)) Begin
                Move dtThis to dtNewest
                Move True to bHave
            End
        Loop
        Function_Return dtNewest
    End_Function

    // Sortable "YYYYMMDDHHMMSS" stamp for a DateTime at whole-second precision; "" for a null/zero
    // DateTime. Lexicographic order == chronological order, so the watermark is stored and compared
    // as a plain string - lossless through JSON, with no DateTime-in-JSON round-trip or decimal-
    // separator concerns. Second precision survives the round-trip cleanly (sub-second is dropped).
    Function _PkgTimeStamp DateTime dt Returns String
        Integer iY iMo iD iH iMi iS
        String sOut

        Move (DateGetYear(dt)) to iY
        If (iY <= 0) ;                                      // NullDateTime / unset -> no stamp
            Function_Return ""
        Move (DateGetMonth(dt))  to iMo
        Move (DateGetDay(dt))    to iD
        Move (DateGetHour(dt))   to iH
        Move (DateGetMinute(dt)) to iMi
        Move (DateGetSecond(dt)) to iS
        Move       (Right(("000" + String(iY)),  4)) to sOut
        Move (sOut + Right(("0"  + String(iMo)), 2)) to sOut
        Move (sOut + Right(("0"  + String(iD)),  2)) to sOut
        Move (sOut + Right(("0"  + String(iH)),  2)) to sOut
        Move (sOut + Right(("0"  + String(iMi)), 2)) to sOut
        Move (sOut + Right(("0"  + String(iS)),  2)) to sOut
        Function_Return sOut
    End_Function

    // The newest *.pkg last-write time in the TARGET install's Pkg folder as a sortable stamp (see
    // _PkgTimeStamp); "" when the folder is missing/empty (can't fingerprint). A metadata-only
    // directory search - no file contents are read - so it is cheap enough to run on every cache read.
    Function _NewestPkgTimeStamp Returns String
        tRFSearchResult[] aFiles
        DateTime dtNewest
        String sPkg sMask sStamp
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) ;
            Function_Return ""
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Get _NewestWriteTime aFiles to dtNewest
        Get _PkgTimeStamp dtNewest to sStamp
        Function_Return sStamp
    End_Function

    // True when the live install's newest *.pkg is newer than the watermark captured when a cache was
    // written - i.e. the system packages were revised under the SAME version folder (e.g. an in-place
    // DataFlex update / hotfix), which the version-keyed filename alone can't detect. A blank LIVE
    // stamp (folder missing/unreadable now) is NOT stale: we can't fingerprint, so keep the cache
    // rather than churn. A blank STORED stamp (a pre-watermark cache) is older than any real live
    // stamp, so such a cache re-walks once to acquire its watermark.
    Function _PkgScanIsStale String sStoredStamp Returns Boolean
        String sLive
        Get _NewestPkgTimeStamp to sLive
        If (sLive = "") ;
            Function_Return False
        Function_Return (sLive > sStoredStamp)
    End_Function

    // Full path to the per-version catalogue cache: DFRefactor's Data folder + DfVersion-TypeDefs-<ver>.json.
    // phoWorkspace(ghoApplication) (NOT Self) resolves the app's workspace data path.
    // The path for ANY version, not only the one targeted - the TestBench catalogue writer
    // builds these for an install the user picks, which need not be this session's.
    Function TypeDefsCacheJsonPathFor String sVer Returns String
        String sData sFile
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move CS_TypeDefsCacheJson to sFile
        If (Trim(sVer) <> "") ;
            Move (Replace(".json", sFile, ("-" + sVer + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    Function TypeDefsCacheJsonPath Returns String
        String sVer
        Get psTargetDfVersion of ghoApplication to sVer
        Function_Return (TypeDefsCacheJsonPathFor(Self, sVer))
    End_Function

    // Write the install-package Type catalogue + cache-format version + install change watermark
    // (sPkgNewest) to the JSON (pretty, NO BOM - a BOM breaks ParseUtf8). Mirrors WriteRecipesToJson.
    // Write to an EXPLICIT path, so one serializer serves both the runtime cache and a
    // catalogue generated for a hand-picked version.
    Procedure WriteTypeDefsCacheTo tTypeDef[] aDefs String sPkgNewest String sFile
        Handle hoJson
        tTypeDefCacheFile CacheFile
        UChar[] ucJson
        Integer iCh

        Move CI_TypeDefsCacheVersion to CacheFile.iVersion
        Move sPkgNewest to CacheFile.sPkgNewest
        Move aDefs to CacheFile.aDefs
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson CacheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // The runtime cache: this session's target, at its own path.
    Procedure WriteTypeDefsCache tTypeDef[] aDefs String sPkgNewest
        Send WriteTypeDefsCacheTo aDefs sPkgNewest (TypeDefsCacheJsonPath(Self))
    End_Procedure

    // Load the cached catalogue. Returns False (aDefs untouched) if the file is absent, won't parse,
    // carries a stale cache-format version (CI_TypeDefsCacheVersion), OR a system package is newer
    // than the cache's watermark (an in-place install update - see _PkgScanIsStale); the caller then
    // re-scans (no manual JSON delete needed). Mirrors cModAnalyzer.ReadRecipesFromJson.
    Function ReadTypeDefsCache tTypeDef[] ByRef aDefs Returns Boolean
        Handle hoJson
        Boolean bStale
        tTypeDefCacheFile CacheFile
        String sFile

        // Resolve the cache path FIRST - d1de57d (2026-08-01) dropped this line while splitting the
        // writers into ...To variants, so sFile probed EMPTY, every read said 'no cache', and the
        // full install-Pkg walk re-ran on every call - including on the compile poll tick, where it
        // silently starved every cTimer for the length of the compile (Nils 2026-08-10, measured).
        Get TypeDefsCacheJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to CacheFile
        Send Destroy of hoJson
        If (CacheFile.iVersion <> CI_TypeDefsCacheVersion) ;
            Function_Return False
        // Same-version install change? A package newer than the stored watermark means the system
        // packages were revised under the same version folder - treat as stale so the caller re-walks.
        Get _PkgScanIsStale CacheFile.sPkgNewest to bStale
        If (bStale = True) ;
            Function_Return False
        Move CacheFile.aDefs to aDefs
        Function_Return True
    End_Function

    // Scans a file's lines for every legacy "Type ... End_Type" block and returns them as catalog
    // entries (type name + raw block lines). Used to catalog Types from the system packages
    // (DfTypes.pkg etc. under psTargetPkgFolder) - and from the user files too, so a user-defined
    // Type is found as well. PURE (no file I/O) -> unit-testable.
    Function _TypeDefsFromLines String[] asLines Returns tTypeDef[]
        tTypeDef[] aOut
        String[] asBlock asEmpty asWords
        String sCmd sName
        Integer i iLast iOut iBlk
        Boolean bFoundEnd

        // Stateless: each line is split locally (_SplitSourceWords) - no shared
        // engine Tokenizer, so this is fast and free of cross-call state leakage.
        Move (SizeOfArray(asLines) - 1) to iLast
        Move 0 to iOut
        Move 0 to i
        While (i <= iLast)
            // Per-file bar + line text: TypeToStructReport's Phase B is four whole-array walks
            // per file, none of which moved the per-file bar, so the panel sat frozen on the
            // file counter while a big file was scanned (Nils 2026-07-26). Time-gated inside
            // the nudge; the caller scales the bar with _StartFileLineProgress.
            If (Mod(i, 64) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning Type definitions, line:"
            Get _SplitSourceWords asLines[i] to asWords
            Move "" to sCmd
            If (SizeOfArray(asWords) > 0) ;
                Move (Lowercase(asWords[0])) to sCmd
            If (sCmd = "type") Begin
                Move "" to sName
                If (SizeOfArray(asWords) > 1) ;
                    Move asWords[1] to sName
                Move asEmpty to asBlock
                Move 0 to iBlk
                Move False to bFoundEnd
                While (i <= iLast and bFoundEnd = False)
                    Move asLines[i] to asBlock[iBlk]
                    Increment iBlk
                    Get _SplitSourceWords asLines[i] to asWords
                    If (SizeOfArray(asWords) > 0) Begin
                        If (Lowercase(asWords[0]) = "end_type") ;
                            Move True to bFoundEnd
                    End
                    Increment i
                Loop
                If (sName <> "") Begin
                    Move sName to aOut[iOut].sName
                    Move asBlock to aOut[iOut].asBlock
                    Increment iOut
                End
            End
            Else ;
                Increment i
        Loop
        Function_Return aOut
    End_Function

    // Harvest every Function / Property / Register_Function DECLARATION from a file's lines, with its
    // registered return type - the raw material for FunctionReturnMismatchReport. DataFlex message names are
    // workspace-global: each such declaration registers a return type on the shared message id, and
    // when two declarations of one name DISAGREE on the type, DF 25/26's stricter expression typing
    // rejects every expression-style call of that name (error 4544; DF 19.1 resolved it silently).
    // Shapes handled (word[0], case-insensitive, on the strings/comment-masked split):
    //   Function <name> [Global] [<params>] [Returns <type>]   -> type after "Returns", else "(untyped)"
    //   Register_Function <name> [<params>] [Returns <type>]    -> bGlobal True (always global)
    //   Property <type> <name> [<initial>]                      -> type = word[1], name = word[2]
    //   External_Function <name> "<entry>" <dll> [<params>] [Returns <type>] -> bGlobal True. The
    //       4390 "already defined as an external_function" flavor lives or dies on these being
    //       visible: both sides of the WinInet clash (LegacyApp 2026-07-23) are External_Functions,
    //       so the guided row's Show declarations opened a report that named NOTHING.
    // A declaration continued with ";" carries its "Returns <type>" on a LATER physical line
    // (DataFlex's own Pkg External_Functions are written one parameter per line) - the chain is
    // followed for the type; the declaration still anchors to its FIRST line.
    // Register_Procedure is intentionally skipped (no return type = cannot cause a 4544 type clash).
    // PURE (no file I/O; caller supplies the line's file+base index) -> unit-testable. Stateless, so a
    // "Function"/"Property" WORD opening a line inside a /* */ block comment can over-harvest - harmless
    // for a REPORT (an extra advisory line), same limitation as _TypeDefsFromLines.
    /* CONDITIONAL ARMS (Nils 2026-09-20). The report said of SetConsoleTitle "Your workspace declares
       it in 3 place(s), disagreeing over 2 return types ... Align them" - and the three sit in the
       sibling arms of one #IF (!@ < 191) / #IFDEF IS$WIN64 / #ELSE block that this tool's own wide
       guard had written the day before. Only one arm ever compiles, so there was no collision, the
       advice was wrong, and every declaration the guard converters write would have been reported
       the same way. The harvester now tracks the #IF / #ELSE / #ENDIF nesting as it walks a file and
       stamps each declaration with the path of the arms enclosing it; _CollapseConditionalArms then
       keeps ONE of a name's declarations that sit in sibling arms of the same block - the LAST arm,
       because the guards this tool writes put the target release's declaration in the #ELSE arm.
       A declaration OUTSIDE a block beside one inside it is left as two (both can compile), and
       two in the SAME arm are the real duplicate they always were. */
    // "<block>:<arm>/..." for the open arms, outermost first; "" at file level.
    Function _ConditionalArmPath Integer[] aiBlockId Integer[] aiArm Returns String
        String sPath
        Integer i iLast

        Move "" to sPath
        Move (SizeOfArray(aiBlockId) - 1) to iLast
        For i from 0 to iLast
            If (i > 0) ;
                Move (sPath + "/") to sPath
            Move (sPath + String(aiBlockId[i]) + ":" + String(aiArm[i])) to sPath
        Loop
        Function_Return sPath
    End_Function

    // True when the two arm paths part at a block they SHARE but on different arms: the declarations
    // are alternatives, and at most one of them compiles. Equal paths (same arm), a blank path (file
    // level) or one path that merely extends the other (outside vs inside a block) are not. PURE.
    Function _AreConditionalAlternatives String sPathA String sPathB Returns Boolean
        String[] asA asB
        Integer i iLast iColonA iColonB

        If (sPathA = "" or sPathB = "" or sPathA = sPathB) ;
            Function_Return False
        Move (StrSplitToArray(sPathA, "/")) to asA
        Move (StrSplitToArray(sPathB, "/")) to asB
        Move (SizeOfArray(asA) - 1) to iLast
        If (SizeOfArray(asB) - 1 < iLast) ;
            Move (SizeOfArray(asB) - 1) to iLast
        For i from 0 to iLast
            If (asA[i] <> asB[i]) Begin
                Move (Pos(":", asA[i])) to iColonA
                Move (Pos(":", asB[i])) to iColonB
                Function_Return (iColonA > 0 and iColonB > 0 and Left(asA[i], iColonA) = Left(asB[i], iColonB))
            End
        Loop
        Function_Return False
    End_Function

    // One file's harvest with sibling-arm alternatives of a name collapsed to the last arm. Only a
    // declaration that carries an arm path is compared at all, so an unguarded file costs one pass.
    Function _CollapseConditionalArms tNameDecl[] aDecls Returns tNameDecl[]
        tNameDecl[] aOut
        Boolean[] abDrop
        Boolean bAlt
        Integer i j iLast

        Move (SizeOfArray(aDecls) - 1) to iLast
        For i from 0 to iLast
            Move False to abDrop[i]
        Loop
        For i from 0 to iLast
            If (aDecls[i].sCondPath <> "") Begin
                For j from (i + 1) to iLast
                    If (abDrop[i] = False and aDecls[j].sCondPath <> "" and Lowercase(aDecls[i].sName) = Lowercase(aDecls[j].sName)) Begin
                        Get _AreConditionalAlternatives aDecls[i].sCondPath aDecls[j].sCondPath to bAlt
                        If (bAlt = True) ;
                            Move True to abDrop[i]     // the later arm stands for both
                    End
                Loop
            End
        Loop
        For i from 0 to iLast
            If (abDrop[i] = False) ;
                Move aDecls[i] to aOut[SizeOfArray(aOut)]
        Loop
        Function_Return aOut
    End_Function

    Function _NameDeclsFromLines String[] asLines String sFile Returns tNameDecl[]
        tNameDecl[] aOut
        String[] asWords asContWords
        String sCmd sName sType sCondPath
        Integer i iLast iW iWLast iRet k iCont iCW iDepth iNextBlock
        Integer[] aiBlockId aiArm
        Boolean bGlobal bCont bOverloaded

        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            // Per-file bar + line text (Nils 2026-07-26): without this the report's panel sat on
            // "File No: 1 of: 182" for the whole of a big first file with a dead per-file bar,
            // while only the overall bar moved. Time-gated inside the nudge; the caller scales the
            // bar with _StartFileLineProgress. Same treatment ChangeCollidingMethodName already has.
            If (Mod(i, 64) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning declarations, line:"
            Get _SplitSourceWords asLines[i] to asWords
            Move (SizeOfArray(asWords)) to iWLast
            Move "" to sCmd
            If (iWLast > 0) ;
                Move (Lowercase(asWords[0])) to sCmd
            // The #IF / #ELSE / #ENDIF nesting (any #IF* form opens a block) - see the note above
            // _ConditionalArmPath. The directive words are built, not written: a literal one in
            // this package's source is FMAC's to consume during OUR compile.
            If (Left(sCmd, 3) = (Character(35) + "if")) Begin
                Move (SizeOfArray(aiBlockId)) to iDepth
                Move iNextBlock to aiBlockId[iDepth]
                Move 0          to aiArm[iDepth]
                Increment iNextBlock
            End
            Else If (sCmd = (Character(35) + "else")) Begin
                Move (SizeOfArray(aiArm) - 1) to iDepth
                If (iDepth >= 0) ;
                    Move (aiArm[iDepth] + 1) to aiArm[iDepth]
            End
            Else If (sCmd = (Character(35) + "endif")) Begin
                Move (SizeOfArray(aiArm) - 1) to iDepth
                If (iDepth >= 0) Begin
                    Move (ResizeArray(aiBlockId, iDepth)) to aiBlockId
                    Move (ResizeArray(aiArm, iDepth))     to aiArm
                End
            End
            Move "" to sName
            Move "(untyped)" to sType
            Move False to bGlobal
            Move False to bOverloaded
            If ((sCmd = "function" or sCmd = "register_function") and iWLast >= 2) Begin
                Move asWords[1] to sName
                Move (sCmd = "register_function") to bGlobal
                // Return type = the token after a "Returns" keyword; scan the remaining words.
                Move (iWLast - 1) to iRet
                Move 2 to iW
                While (iW <= iRet)
                    If (Lowercase(asWords[iW]) = "global") ;
                        Move True to bGlobal
                    // Overloaded rides in the same word run, between the name and Returns.
                    If (Lowercase(asWords[iW]) = "overloaded") ;
                        Move True to bOverloaded
                    If (Lowercase(asWords[iW]) = "returns" and iW < iRet) Begin
                        Move asWords[iW + 1] to sType
                        Move iRet to iW           // stop after the first Returns
                    End
                    Increment iW
                Loop
            End
            Else If (sCmd = "external_function" and iWLast >= 2) Begin
                Move asWords[1] to sName
                Move True to bGlobal            // External_Function is always workspace-global
                Move (iWLast - 1) to iRet
                Move 2 to iW
                While (iW <= iRet)
                    If (Lowercase(asWords[iW]) = "returns" and iW < iRet) Begin
                        Move asWords[iW + 1] to sType
                        Move iRet to iW           // stop after the first Returns
                    End
                    Increment iW
                Loop
            End
            Else If (sCmd = "property" and iWLast >= 3) Begin
                Move asWords[1] to sType
                Move asWords[2] to sName
            End
            // The ";"-continued declaration shape: the Returns sits lines below the name. Follow the
            // continuation chain until a line stops continuing or the type is found.
            If (sName <> "" and sType = "(untyped)" and sCmd <> "property") Begin
                Move i to iCont
                Get _LineContinues asLines[iCont] to bCont
                While (bCont = True and iCont < iLast and sType = "(untyped)")
                    Increment iCont
                    Get _SplitSourceWords asLines[iCont] to asContWords
                    Move (SizeOfArray(asContWords) - 1) to iCW
                    For iW from 0 to iCW
                        If (Lowercase(asContWords[iW]) = "returns" and iW < iCW) ;
                            Move asContWords[iW + 1] to sType
                    Loop
                    Get _LineContinues asLines[iCont] to bCont
                Loop
            End
            // A "!" in the name or type = a #COMMAND macro PARAMETER placeholder (function !1 ...
            // returns !2), not a real declaration - the VDFQuery .nui/.utl macro templates are full of
            // them. Skip: they are not identifiers and would mint phantom collisions (Nils/WinServ 2026-07-20).
            If (sName <> "" and not(sName contains "!") and not(sType contains "!")) Begin
                Move (SizeOfArray(aOut)) to k
                Move sName             to aOut[k].sName
                Move (asWords[0])      to aOut[k].sKind
                Move sType             to aOut[k].sReturnType
                Move sFile             to aOut[k].sFile
                Move (i + 1)           to aOut[k].iLine
                Move bGlobal           to aOut[k].bGlobal
                Move bOverloaded       to aOut[k].bOverloaded
                Get _ConditionalArmPath aiBlockId aiArm to sCondPath
                Move sCondPath         to aOut[k].sCondPath
            End
        Loop
        // Sibling-arm alternatives of one name are one declaration (see the note above).
        Get _CollapseConditionalArms aOut to aOut
        Function_Return aOut
    End_Function

    // True when the (strings/comment-stripped) line ends with the ";" continuation character.
    Function _LineContinues String sLine Returns Boolean
        Get RemoveStringsFromLine sLine to sLine
        Get _RemoveEndComment sLine to sLine
        Function_Return (Right(RTrim(sLine), 1) = ";")
    End_Function

    // Given a harvested declaration set, return the NAMES declared with 2+ DISTINCT return types.
    // CONTESTED, not yet a verdict: whether a contested name is a 4544 depends on the Overloaded
    // token, which _CollidingNames and _OverloadedNames decide over this one pass. Case-insensitive
    // on both name and type; the returned name keeps the casing of its first occurrence.
    // PURE -> unit-testable.
    Function _ContestedNames tNameDecl[] aDecls Returns String[]
        String[] asOut asNameLc asKeys
        String sLc sType sKey sCurName sCurType
        Integer i j iLast iPos iTypes

        Move (SizeOfArray(aDecls) - 1) to iLast
        If (iLast < 0) ;
            Function_Return asOut
        // Pre-fold the names once (compared repeatedly below).
        For i from 0 to iLast
            Move (Lowercase(aDecls[i].sName)) to asNameLc[i]
        Loop
        // SORT, don't re-scan. This was O(n^2) - for every declaration it walked every OTHER declaration -
        // which on a workspace with tens of thousands of declarations is ~10^9 string compares, running for
        // minutes between the report's two file passes with no progress shown at all (Nils 2026-07-21: "it
        // seems to get stuck after 1:48"). Sorting "name|returntype" keys puts every declaration of a name
        // together, with its types grouped inside that run, so ONE pass counts the distinct types per name.
        // A DataFlex identifier cannot contain "|", so the separator is unambiguous.
        For i from 0 to iLast
            Move (asNameLc[i] + "|" + Lowercase(Trim(aDecls[i].sReturnType))) to asKeys[i]
        Loop
        Move (SortArray(asKeys)) to asKeys
        Move "" to sCurName
        Move "" to sCurType
        Move 0  to iTypes
        For i from 0 to iLast
            Move asKeys[i] to sKey
            Move (Pos("|", sKey)) to iPos
            If (iPos > 0) Begin
                Move (Left(sKey, (iPos - 1)))                    to sLc
                Move (Right(sKey, (Length(sKey) - iPos)))        to sType
            End
            Else Begin
                Move sKey to sLc
                Move ""   to sType
            End
            If (sLc <> sCurName) Begin
                // A new name starts here - close the previous run off first.
                If (iTypes >= 2) Begin
                    Move (SearchArray(sCurName, asNameLc, Desktop, RefFunc(DFSTRICMP))) to j
                    If (j <> -1) ;
                        Move (aDecls[j].sName) to asOut[SizeOfArray(asOut)]   // report the ORIGINAL casing
                End
                Move sLc   to sCurName
                Move sType to sCurType
                Move 1     to iTypes
            End
            Else Begin
                // Same name: the keys are sorted, so a change in the type part IS a new distinct type.
                If (sType <> sCurType) Begin
                    Move sType to sCurType
                    Increment iTypes
                End
            End
        Loop
        // Close the final run.
        If (iTypes >= 2) Begin
            Move (SearchArray(sCurName, asNameLc, Desktop, RefFunc(DFSTRICMP))) to j
            If (j <> -1) ;
                Move (aDecls[j].sName) to asOut[SizeOfArray(asOut)]
        End
        Function_Return asOut
    End_Function

    /* The 4544 population: contested names MINUS the legal overload sets.
       An all-Overloaded name holds several return types legally - DataFlex resolves it by parameter
       count - so it can never raise 4544, and neither of the two fixes applies to it. Filtered here,
       in the one tested core, so the report, the analyzer grid and the saved plan all inherit it.
       A MIXED set is kept: that is error 4390, a real break, and the report says so per name.
       Same name and signature as before the Overloaded work, so callers and tests are unchanged. */
    Function _CollidingNames tNameDecl[] aDecls Returns String[]
        String[] asAll asOut
        tNameDecl[] aFor
        Integer i iLast iState
        Get _ContestedNames aDecls to asAll
        Move (SizeOfArray(asAll) - 1) to iLast
        For i from 0 to iLast
            Get _DeclsForName aDecls asAll[i] to aFor
            Get _OverloadedState aFor to iState
            If (iState <> CI_OverloadAll) ;
                Move asAll[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    /* The complement: contested names that ARE legal overload sets - exactly what _CollidingNames
       drops. The report lists these under their own heading rather than saying nothing, because a
       silent skip reads as "there was nothing here". They are not defects; the DataFlex docs do call
       overloading obsolete and point at distinct names or Num_Arguments, so they are worth SEEING. */
    Function _OverloadedNames tNameDecl[] aDecls Returns String[]
        String[] asAll asOut
        tNameDecl[] aFor
        Integer i iLast iState
        Get _ContestedNames aDecls to asAll
        Move (SizeOfArray(asAll) - 1) to iLast
        For i from 0 to iLast
            Get _DeclsForName aDecls asAll[i] to aFor
            Get _OverloadedState aFor to iState
            If (iState = CI_OverloadAll) ;
                Move asAll[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    // Count EXPRESSION-STYLE call sites of each target name in a file's lines - the calls that actually
    // trigger error 4544. The distinguishing form is the function-call syntax "name(" (Value(Self),
    // obj.Value(x), (Value(x) = y)); the STATEMENT forms Get name of obj / Set name / Send name use the
    // name WITHOUT the immediate "(" and do NOT provoke the ambiguous-return error, so they are not
    // counted. FunctionReturnMismatchReport uses this to split contested names into ERRORING (>= 1 call site)
    // vs LATENT (0 - a real conflict, harmless until someone uses the name in an expression). The
    // identifier is taken by walking back from each "(" (so a suffix like MyValue( never matches Value,
    // and obj.Value( correctly yields Value), then looked up in the target set. Returns an Integer[]
    // parallel to asTargetNamesLc (already lowercased). PURE -> unit-testable. Strings/comments are
    // masked (_CodeOnlyLine) so a "(" inside a literal or comment is not counted.
    Function _CountNameCallsInLines String[] asLines String[] asTargetNamesLc Returns Integer[]
        Integer[] aiCounts
        String sLineLc sIdent sCh sIdChars
        Integer iLast i p q iIdx iNames

        Move "abcdefghijklmnopqrstuvwxyz0123456789_" to sIdChars
        Move (SizeOfArray(asTargetNamesLc) - 1) to iNames
        For i from 0 to iNames
            Move 0 to aiCounts[i]
        Loop
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 64) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Counting call sites, line:"
            Get _CodeOnlyLine asLines[i] to sLineLc
            Move (Lowercase(sLineLc)) to sLineLc
            Move (Pos("(", sLineLc)) to p
            While (p > 0)
                If (p > 1) Begin
                    // Walk back from the "(" collecting the identifier immediately before it.
                    Move "" to sIdent
                    Move (p - 1) to q
                    While (q >= 1)
                        Move (Mid(sLineLc, 1, q)) to sCh
                        If (Pos(sCh, sIdChars) > 0) Begin
                            Move (sCh + sIdent) to sIdent
                            Decrement q
                        End
                        Else ;
                            Move 0 to q       // hit a non-identifier char - the name is complete
                    Loop
                    If (sIdent <> "") Begin
                        Move (SearchArray(sIdent, asTargetNamesLc, Desktop, RefFunc(DFSTRICMP))) to iIdx
                        If (iIdx <> -1) ;
                            Increment aiCounts[iIdx]
                    End
                End
                Move (Pos("(", sLineLc, (p + 1))) to p
            Loop
        Loop
        Function_Return aiCounts
    End_Function

    // Does ANY line DECLARE something whose text mentions one of these (already lowercased) needles?
    // The pre-gate for the install-package scan below, where word-splitting every line of every
    // DataFlex Pkg file is the expensive part.
    //
    // It tests the DECLARATION shape, not a bare mention, and that distinction is the whole point: the
    // commonest contested name is "Value", and "value" appears in very nearly every package the
    // install ships (sValue, psValue, "the value of ..."). A mention-gate would therefore skip almost
    // nothing and leave the third pass costing a full uncached walk. Requiring the line to OPEN with
    // Function / Property / Register_Function skips the file unless it could actually contribute a
    // declaration - which is exactly the condition under which _NameDeclsFromLines would find one, so
    // the gate never hides a result. Early-exits on the first hit. PURE -> unit-testable.
    Function _LinesDeclareAny String[] asLines String[] asNeedlesLc Returns Boolean
        String sLineLc sWord
        Integer i iLast j jLast p

        Move (SizeOfArray(asNeedlesLc) - 1) to jLast
        If (jLast < 0) ;
            Function_Return False
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            // Tabs indent real source too, and Trim only eats spaces.
            Move (Lowercase(asLines[i])) to sLineLc
            Move (Trim(Replaces(Character(9), sLineLc, " "))) to sLineLc
            Move (Pos(" ", sLineLc)) to p
            If (p > 1) Begin
                Move (Left(sLineLc, (p - 1))) to sWord
                If (sWord = "function" or sWord = "property" or sWord = "register_function" or sWord = "external_function") Begin
                    For j from 0 to jLast
                        If (Pos(asNeedlesLc[j], sLineLc) > 0) ;
                            Function_Return True
                    Loop
                End
            End
        Loop
        Function_Return False
    End_Function

    // Every declaration of ONE name out of a harvested set (case-insensitive). The report groups by
    // name and lists each side separately, so it asks this of the workspace set and of the install
    // set in turn. PURE -> unit-testable.
    Function _DeclsForName tNameDecl[] aDecls String sName Returns tNameDecl[]
        tNameDecl[] aOut
        String sLc
        Integer i iLast
        Move (Lowercase(Trim(sName))) to sLc
        Move (SizeOfArray(aDecls) - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(Trim(aDecls[i].sName)) = sLc) ;
                Move aDecls[i] to aOut[SizeOfArray(aOut)]
        Loop
        Function_Return aOut
    End_Function

    /* How ONE name's declarations use the Overloaded token: CI_OverloadNone / All / Mixed.
       Feed it a set already narrowed to one name (_DeclsForName), like _DistinctTypeCount.

       This is what keeps a legal overload set out of the 4544 population. Measured against DF26
       (2026-08-23): two Overloaded declarations of one name with DIFFERENT return types compile,
       and an expression call against them resolves - no 4544. Drop the token from the same pair
       and the expression call raises "4544: Function GET_FOO with ambiguous return type used in
       expression". DataFlex overloads on PARAMETER COUNT, so with the token the compiler always
       knows which return type applies; several return types under one name is then legal, not a
       conflict. An empty set is None - no declaration means nothing to be immune about.
       PURE -> unit-testable. */
    Function _OverloadedState tNameDecl[] aDecls Returns Integer
        Integer i iLast iOvl

        Move (SizeOfArray(aDecls) - 1) to iLast
        If (iLast < 0) ;
            Function_Return CI_OverloadNone
        Move 0 to iOvl
        For i from 0 to iLast
            If (aDecls[i].bOverloaded = True) ;
                Increment iOvl
        Loop
        If (iOvl = 0) ;
            Function_Return CI_OverloadNone
        If (iOvl = (iLast + 1)) ;
            Function_Return CI_OverloadAll
        Function_Return CI_OverloadMixed
    End_Function

    // How many DISTINCT return types a declaration set registers (case-insensitive). One = consistent,
    // two or more = the 4544 conflict. Reported verbatim ("declared with 3 different return types")
    // because the number is what tells the reader how tangled the name is. PURE -> unit-testable.
    Function _DistinctTypeCount tNameDecl[] aDecls Returns Integer
        String[] asSeen
        String sType
        Integer i iLast
        Move (SizeOfArray(aDecls) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(aDecls[i].sReturnType))) to sType
            If (SearchArray(sType, asSeen, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                Move sType to asSeen[SizeOfArray(asSeen)]
        Loop
        Function_Return (SizeOfArray(asSeen))
    End_Function

    /* PANEL NUDGE for a whole-file function's LINE walk - the one home for the every-~20-lines
       refresh the convention asks for (CLAUDE.md; cUnicodePointerToString is the pattern). The
       engine only auto-advances the per-file bar for LINE-BY-LINE function types, so a whole-file
       function must drive it while it walks, or the bar sits still for the length of the file.

       And a still bar reads as a STOPPED CLOCK (Nils 2026-07-25): the panel's Elapsed Time only
       repaints when a text setter fires, so a function whose finest update is one FILE leaves both
       frozen together on a big file - which is exactly how the colliding-declaration renames looked.

       Callers gate on the Mod themselves so the 19-in-20 no-op costs nothing in the hot loop:
           If (Mod(i, 20) = 0) Send _NudgeLineProgress i (iLast + 1) "Source line:"
       The label is built HERE, only when the nudge actually fires. Null/Active guarded, so it is a
       no-op in batch mode and in the DFUnit runner (whose cApplication has no panel). The caller
       sets the bar's MAXIMUM to the file's line count before the walk. */
    Procedure _NudgeLineProgress Integer iLine Integer iTotal String sLabel
        Boolean bDue

        If (ghoStatusPanel = 0) ;
            Procedure_Return
        If (Active_State(ghoStatusPanel) = False) ;
            Procedure_Return
        // WALL CLOCK, not line count (Nils 2026-07-26): Update_StatusPanel PUMPS the message
        // queue, and pumping is far dearer than the scanning between two nudges - a fixed
        // every-N-lines rule therefore charges by throughput instead of by what the eye needs.
        // PanelPaintDue bounds it to a few paints a second however fast the loop runs; callers
        // keep a cheap Mod pre-filter so the common line does not even reach this message.
        Get PanelPaintDue of ghoStatusPanel to bDue
        If (bDue = False) ;
            Procedure_Return
        Send Update_StatusPanel of ghoStatusPanel (sLabel * String(iLine + 1) * "of:" * String(iTotal))
        Set piPosition of ghoProgressBar to (iLine + 1)
    End_Procedure

    // Scale the PER-FILE bar to the file about to be walked. Call once per file, before the line
    // loop; _NudgeLineProgress then fills it as the walk proceeds. Guarded like the nudge, so it
    // is a no-op in batch mode and in the DFUnit runner.
    Procedure _StartFileLineProgress Integer iTotalLines
        If (ghoStatusPanel = 0) ;
            Procedure_Return
        If (Active_State(ghoStatusPanel) = False) ;
            Procedure_Return
        Set piMaximum  of ghoStatusPanel to iTotalLines
        Set piPosition of ghoProgressBar to 0
    End_Procedure

    // "<Child>|<Parent>" for every class declaration in a file. Both articles are legal DataFlex
    // ("Class cFoo is a cBar", "Class cFoo is an cObject"), so word 3 is accepted either way rather
    // than matched as text. PURE -> unit-testable.
    Function _ClassPairsFromLines String[] asLines Returns String[]
        String[] asOut asWords
        String sCode sArticle
        Integer i iLast

        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning classes, line:"
            Get _CodeOnlyLine asLines[i] to sCode
            Get _SplitSourceWords (Trim(sCode)) to asWords
            If (SizeOfArray(asWords) >= 5) Begin
                Move (Lowercase(asWords[3])) to sArticle
                If (Lowercase(asWords[0]) = "class" and Lowercase(asWords[2]) = "is") Begin
                    If (sArticle = "a" or sArticle = "an") ;
                        Move (asWords[1] + "|" + asWords[4]) to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // Every class that IS one of the seeds or DESCENDS from one. cSummaryTable overrides cHashTable's
    // Value with its own return type, so renaming only the class that the compiler happened to name
    // would leave the override behind - still declaring the contested name, still ambiguous. Iterated to
    // a fixed point because a chain can be declared in any order across files. PURE -> unit-testable.
    Function _ExpandClassFamily String[] asClassPairs String[] asSeeds Returns String[]
        String[] asOut
        String sPair sChild sParent
        Integer i iLast iPos iAdded

        Move (SizeOfArray(asSeeds) - 1) to iLast
        For i from 0 to iLast
            If (SearchArray(asSeeds[i], asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                Move asSeeds[i] to asOut[SizeOfArray(asOut)]
        Loop
        Move 1 to iAdded
        While (iAdded > 0)
            Move 0 to iAdded
            Move (SizeOfArray(asClassPairs) - 1) to iLast
            For i from 0 to iLast
                Move asClassPairs[i] to sPair
                Move (Pos("|", sPair)) to iPos
                If (iPos > 0) Begin
                    Move (Left(sPair, (iPos - 1)))              to sChild
                    Move (Right(sPair, (Length(sPair) - iPos))) to sParent
                    If (SearchArray(sParent, asOut, Desktop, RefFunc(DFSTRICMP)) <> -1) Begin
                        If (SearchArray(sChild, asOut, Desktop, RefFunc(DFSTRICMP)) = -1) Begin
                            Move sChild to asOut[SizeOfArray(asOut)]
                            Increment iAdded
                        End
                    End
                End
            Loop
        Loop
        Function_Return asOut
    End_Function

    // The identifiers in a file that demonstrably hold an object of one of these classes - the ONLY
    // receivers a rename may touch. Two shapes are provable from source alone:
    //     Object oFoo is a cHashTable                 -> oFoo
    //     Get Create (RefClass(cHashTable)) to hTbl   -> hTbl
    // A handle that arrives as a parameter, is read from a property, or is returned by a function is NOT
    // provable here, and is deliberately left alone - see _RenameMethodInLines, which records those
    // instead of guessing. bObjectsOnly returns just the Object names: an object name is workspace-wide
    // (Register_Object), so it is safe to carry across files, whereas a local handle variable called
    // "hTbl" in one file has nothing to do with an "hTbl" in another. PURE -> unit-testable.
    Function _ReceiverNamesFromLines String[] asLines String[] asFamily Boolean bObjectsOnly Returns String[]
        String[] asOut asWords asTail
        String sCode sLow sCls sArticle
        Integer i iLast iPos iEnd iLen

        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning receivers, line:"
            Get _CodeOnlyLine asLines[i] to sCode
            Move (Lowercase(sCode)) to sLow
            Get _SplitSourceWords (Trim(sCode)) to asWords
            If (SizeOfArray(asWords) >= 5) Begin
                Move (Lowercase(asWords[3])) to sArticle
                If (Lowercase(asWords[0]) = "object" and Lowercase(asWords[2]) = "is") Begin
                    If (sArticle = "a" or sArticle = "an") Begin
                        If (SearchArray(asWords[4], asFamily, Desktop, RefFunc(DFSTRICMP)) <> -1) Begin
                            If (SearchArray(asWords[1], asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                                Move asWords[1] to asOut[SizeOfArray(asOut)]
                        End
                    End
                End
            End
            If (bObjectsOnly = False) Begin
                // Get Create (RefClass(<Class>)) ... to <var>
                Move (Pos("refclass(", sLow)) to iPos
                If (iPos > 0) Begin
                    Move (iPos + 9) to iPos
                    Move (Pos(")", sLow, iPos)) to iEnd
                    If (iEnd > iPos) Begin
                        Move (iEnd - iPos) to iLen
                        Move (Trim(Mid(sCode, iLen, iPos))) to sCls
                        If (SearchArray(sCls, asFamily, Desktop, RefFunc(DFSTRICMP)) <> -1) Begin
                            Move (Pos(" to ", sLow, iEnd)) to iPos
                            If (iPos > 0) Begin
                                Move (Trim(Right(sCode, (Length(sCode) - (iPos + 3))))) to sCls
                                Get _SplitSourceWords sCls to asTail
                                If (SizeOfArray(asTail) >= 1) Begin
                                    If (SearchArray(asTail[0], asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                                        Move asTail[0] to asOut[SizeOfArray(asOut)]
                                End
                            End
                        End
                    End
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // The return type that MOST of these declarations agree on, "" when there is no strict winner (a
     // 2-2 split has no odd one out to align, and picking one would be a coin toss). Case-insensitive;
    // the winner keeps the casing of its first occurrence. PURE -> unit-testable.
    Function _MajorityReturnType tNameDecl[] aDecls Returns String
        String[] asTypes
        Integer[] aiCounts
        String sType sBest
        Integer i iLast j iIdx iBest iTies

        Move (SizeOfArray(aDecls) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(aDecls[i].sReturnType)) to sType
            Move (SearchArray(sType, asTypes, Desktop, RefFunc(DFSTRICMP))) to iIdx
            If (iIdx = -1) Begin
                Move (SizeOfArray(asTypes)) to iIdx
                Move sType to asTypes[iIdx]
                Move 0     to aiCounts[iIdx]
            End
            Move (aiCounts[iIdx] + 1) to aiCounts[iIdx]
        Loop
        Move ""  to sBest
        Move 0   to iBest
        Move 0   to iTies
        Move (SizeOfArray(asTypes) - 1) to iLast
        For j from 0 to iLast
            If (aiCounts[j] > iBest) Begin
                Move (aiCounts[j]) to iBest
                Move (asTypes[j])  to sBest
                Move 1 to iTies
            End
            Else If (aiCounts[j] = iBest) ;
                Increment iTies
        Loop
        If (iTies <> 1) ;
            Function_Return ""
        Function_Return sBest
    End_Function

    // Rewrite the DECLARED TYPE of a name to sType, on the declaration lines only - never a call site.
    //     Property <oldtype> <name> [init]   -> Property <sType> <name> [init]
    //     Function <name> ... Returns <old>  -> Function <name> ... Returns <sType>
    // Lines that already carry sType are left alone, so the count reports real edits. This is the fix for
    // a 4544 that NOTHING outside the workspace owns: two packages declaring pbSilent Boolean and a third
    // declaring it String need the third corrected, not all three renamed - a rename would carry the same
    // disagreement to the new name and change nothing (Nils 2026-07-22). Returns lines changed; asLines
    // is updated in place. PURE -> unit-testable.
    /* True when this file declares sName as an OVERLOADED function - "Function <name> ... Overloaded".
       The token sits among the words between the name and Returns, which is where the declaration
       harvester reads it too. Both 4544 fixes ask this before touching a name, because an overloaded
       name legally holds several return types and neither fix applies to it. PURE -> unit-testable. */
    Function _NameIsOverloadedInLines String[] asLines String sName Returns Boolean
        String[] asWords
        String sCode sNameLc
        Integer i iLast iW iWLast

        Move (Lowercase(Trim(sName))) to sNameLc
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            Get _SplitSourceWords (Trim(sCode)) to asWords
            Move (SizeOfArray(asWords) - 1) to iWLast
            If (iWLast >= 2) Begin
                If (Lowercase(asWords[0]) = "function" and Lowercase(asWords[1]) = sNameLc) Begin
                    For iW from 2 to iWLast
                        If (Lowercase(asWords[iW]) = "overloaded") ;
                            Function_Return True
                    Loop
                End
            End
        Loop
        Function_Return False
    End_Function

    Function _AlignDeclTypeInLines String[] ByRef asLines String sName String sType Returns Integer
        String[] asWords
        String sLine sCode sNameLc sTypeLc sOld
        Integer i iLast iChanged iPos iRet iLen iRPos iP
        Boolean bOvl

        Move 0 to iChanged
        Move (Lowercase(Trim(sName))) to sNameLc
        Move (Lowercase(Trim(sType))) to sTypeLc
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Aligning, line:"
            Move asLines[i] to sLine
            Get _CodeOnlyLine sLine to sCode
            Get _SplitSourceWords (Trim(sCode)) to asWords
            // Property <type> <name>: the type is word 1, the name word 2.
            If (SizeOfArray(asWords) >= 3) Begin
                If (Lowercase(asWords[0]) = "property" and Lowercase(asWords[2]) = sNameLc) Begin
                    If (Lowercase(asWords[1]) <> sTypeLc) Begin
                        Move asWords[1] to sOld
                        Get _FindKeywordPos sCode sOld True 1 to iPos
                        If (iPos > 0) Begin
                            Move (Length(sOld)) to iLen
                            Move (Left(sLine, (iPos - 1)) + sType + Right(sLine, (Length(sLine) - iPos - iLen + 1))) to sLine
                            Move sLine to asLines[i]
                            Increment iChanged
                        End
                    End
                End
            End
            // Function <name> ... Returns <type>: rewrite the token after the LAST Returns.
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "function" and Lowercase(asWords[1]) = sNameLc) Begin
                    // An OVERLOADED declaration is left alone. Its siblings differ in return type on
                    // purpose - DataFlex resolves them by parameter count - so retyping them to one
                    // "majority" would change what the functions return, to fix an error that this
                    // name cannot raise. Counted so the run notes can say it was skipped.
                    Move False to bOvl
                    For iPos from 2 to (SizeOfArray(asWords) - 1)
                        If (Lowercase(asWords[iPos]) = "overloaded") ;
                            Move True to bOvl
                    Loop
                    If (bOvl = True) ;
                        Set piOverloadSkips to (piOverloadSkips(Self) + 1)
                    Move -1 to iRet
                    For iPos from 2 to (SizeOfArray(asWords) - 2)
                        If (Lowercase(asWords[iPos]) = "returns") ;
                            Move iPos to iRet
                    Loop
                    If (iRet >= 0 and bOvl = False) Begin
                        Move (asWords[iRet + 1]) to sOld
                        If (Lowercase(sOld) <> sTypeLc) Begin
                            // Search for the type token AFTER the Returns keyword. A PARAMETER of the same
                            // type name sits earlier on the line - "Function Value Number nKey Returns
                            // Number" - and searching from position 1 rewrote that one instead, quietly
                            // changing the signature and leaving the return type untouched.
                            Move 0 to iRPos
                            Get _FindKeywordPos sCode "Returns" True 1 to iP
                            While (iP > 0)
                                Move iP to iRPos
                                Get _FindKeywordPos sCode "Returns" True (iP + 7) to iP
                            Loop
                            Get _FindKeywordPos sCode sOld True (iRPos + 7) to iPos
                            If (iPos > 0) Begin
                                Move (Length(sOld)) to iLen
                                Move (Left(sLine, (iPos - 1)) + sType + Right(sLine, (Length(sLine) - iPos - iLen + 1))) to sLine
                                Move sLine to asLines[i]
                                Increment iChanged
                            End
                        End
                    End
                End
            End
        Loop
        Function_Return iChanged
    End_Function

    /* Every place a name is DECLARED or USED in one file, as "<file>|<line>|<what>|<why>" worklist rows.

       For a hand rename the declarations alone are useless: Nils, 2026-07-22, on being handed the two
       Split declarations - "that doesn't really help, as it is the two function declarations that are
       listed in the grid. It doesn't help to track and change all places where they are being used."
       Quite. A rename is the declaration PLUS every call that means it, and the call sites are the part
       nobody can find by eye.

       Declaration lines are labelled as such and listed first for a file; every other boundary-aware
       occurrence in code is a use. Comments and string literals are excluded (_CodeOnlyLine), so a name
       mentioned in a remark never becomes a row. No attempt is made to decide WHICH declaration a use
       belongs to - with two same-named globals that is not decidable from source, and guessing it is
       exactly the mistake this whole family of converters exists to avoid. PURE -> unit-testable. */
    Function _NameSitesInLines String[] asLines String sName String sFile String sWhatDecl String sWhatUse String sWhy Returns String[]
        String[] asOut asWords
        String sLine sCode sNameLc sWhat
        Integer i iLast iPos
        Boolean bComment bDecl

        Move (Lowercase(Trim(sName))) to sNameLc
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Listing sites, line:"
            Move asLines[i] to sLine
            Get _IsCommentLine sLine to bComment
            If (bComment = False) Begin
                Get _CodeOnlyLine sLine to sCode
                Get _SplitSourceWords (Trim(sCode)) to asWords
                Move False to bDecl
                If (SizeOfArray(asWords) >= 2) Begin
                    If (Lowercase(asWords[0]) = "function" or Lowercase(asWords[0]) = "procedure") Begin
                        If (Lowercase(asWords[1]) = sNameLc) ;
                            Move True to bDecl
                    End
                End
                If (SizeOfArray(asWords) >= 3) Begin
                    If (Lowercase(asWords[0]) = "property") Begin
                        If (Lowercase(asWords[2]) = sNameLc) ;
                            Move True to bDecl
                    End
                    If (Lowercase(asWords[0]) = "procedure" and Lowercase(asWords[1]) = "set") Begin
                        If (Lowercase(asWords[2]) = sNameLc) ;
                            Move True to bDecl
                    End
                End
                Get _FindKeywordPos sCode sName True 1 to iPos
                If (iPos > 0) Begin
                    Move sWhatUse to sWhat
                    If (bDecl = True) ;
                        Move sWhatDecl to sWhat
                    Move (sFile + "|" + String(i + 1) + "|" + sWhat + "|" + sWhy) to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // The classes in this file that DECLARE the given message - the seeds of the rename family. The
    // compiler names the contested message, never the classes behind it, so this is what turns "Value is
    // ambiguous" into "cHashTable, cScriptingDictionary and cSummaryTable declare it". A declaration
    // outside any Class..End_Class is ignored: renaming an object-level or global one is a different job.
    // PURE -> unit-testable.
    Function _ClassesDeclaringName String[] asLines String sName Returns String[]
        String[] asOut asWords
        String sCode sCur sNameLc
        Integer i iLast
        Boolean bDecl

        Move (Lowercase(Trim(sName))) to sNameLc
        Move "" to sCur
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning declarations, line:"
            Get _CodeOnlyLine asLines[i] to sCode
            Get _SplitSourceWords (Trim(sCode)) to asWords
            If (SizeOfArray(asWords) >= 1) Begin
                If (Lowercase(asWords[0]) = "end_class") ;
                    Move "" to sCur
            End
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "class") ;
                    Move asWords[1] to sCur
            End
            Move False to bDecl
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "function" or Lowercase(asWords[0]) = "procedure") Begin
                    If (Lowercase(asWords[1]) = sNameLc) ;
                        Move True to bDecl
                End
            End
            If (SizeOfArray(asWords) >= 3) Begin
                If (Lowercase(asWords[0]) = "procedure" and Lowercase(asWords[1]) = "set") Begin
                    If (Lowercase(asWords[2]) = sNameLc) ;
                        Move True to bDecl
                End
                // A PROPERTY is a declaration of the name too. Missing it is why a rename run against
                // pbSilent found no classes and silently did nothing at all (Nils 2026-07-22).
                If (Lowercase(asWords[0]) = "property") Begin
                    If (Lowercase(asWords[2]) = sNameLc) ;
                        Move True to bDecl
                End
            End
            If (bDecl = True and sCur <> "") Begin
                If (SearchArray(sCur, asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                    Move sCur to asOut[SizeOfArray(asOut)]
            End
        Loop
        Function_Return asOut
    End_Function

    // One character of sCode, "" when iPos falls outside it. The scanner below looks at neighbours of a
    // match constantly, and a bare Mid() at position 0 or past the end is a fault waiting for the one
    // line that starts or ends with the name. PURE.
    Function _CharAt String sCode Integer iPos Returns String
        If (iPos < 1) ;
            Function_Return ""
        If (iPos > Length(sCode)) ;
            Function_Return ""
        Function_Return (Mid(sCode, 1, iPos))
    End_Function

    /* Scanning helpers for the rename below. All three walk a line one character at a time, and all
       three are written so the loop STOPS BY DEFAULT: bGo is cleared at the top of every pass and only
       set again on the path that consumed a character. Written the other way round first - continue by
       default, stop in an Else - they hung the whole test runner (2026-07-22): reading one character
       past either end of the line took neither branch, nothing advanced, and the process spun until it
       was killed. A loop that can only end via an Else has one way to be right and many to be wrong;
       this shape cannot spin however the neighbouring characters fall. Bounds are checked explicitly
       too, so no path depends on _CharAt returning "" to terminate. PURE -> unit-testable.

       _WordBeforePos used to sit here as a third. It was a SECOND declaration of a name already
       defined later in this file, so it never ran - the later one won, and that one also skips
       TABS, which this copy did not. Removed 2026-08-30; the survivor is beside
       _IdentifierRunEndingAt. */

    // The identifier starting at or after iPos, skipping spaces; "" if there is none. Lowercased.
    Function _WordAfterPos String sCode Integer iPos Returns String
        String sOut sCh
        Integer q iLen
        Boolean bGo

        Move "" to sOut
        Move (Length(sCode)) to iLen
        Get _PosOfNextNonSpace sCode iPos to q
        Move True to bGo
        Move (Length(sCode)) to iLen
        Move iPos to q
        Move True to bGo
        While (bGo = True)
            Move False to bGo
            If (q >= 1 and q <= iLen) Begin
                Get _CharAt sCode q to sCh
                If (sCh = " ") Begin
                    Increment q
                    Move True to bGo
                End
            End
        Loop
        Move True to bGo
        While (bGo = True)
            Move False to bGo
            If (q >= 1 and q <= iLen) Begin
                Get _CharAt sCode q to sCh
                Move (Lowercase(sCh)) to sCh
                If (sCh <> "") Begin
                    If (Pos(sCh, "abcdefghijklmnopqrstuvwxyz0123456789_") > 0) Begin
                        Move (sOut + sCh) to sOut
                        Increment q
                        Move True to bGo
                    End
                End
            End
        Loop
        Function_Return sOut
    End_Function

    // Position of the first non-space character at or after iPos; never runs past the end of the line.
    Function _PosOfNextNonSpace String sCode Integer iPos Returns Integer
        String sCh
        Integer q iLen
        Boolean bGo

        Move (Length(sCode)) to iLen
        Move iPos to q
        Move True to bGo
        While (bGo = True)
            Move False to bGo
            If (q >= 1 and q <= iLen) Begin
                Get _CharAt sCode q to sCh
                If (sCh = " ") Begin
                    Increment q
                    Move True to bGo
                End
            End
        Loop
        Function_Return q
    End_Function

    // The first non-space character at or after iPos, "" if the line ends first. Distinguishes the
    // expression form "Value(" from the statement form, tolerating "Value (" . PURE.
    Function _NextNonSpaceChar String sCode Integer iPos Returns String
        String sCh
        Integer q
        Get _PosOfNextNonSpace sCode iPos to q
        Get _CharAt sCode q to sCh
        Function_Return sCh
    End_Function

    /* Rename one message across a file, touching ONLY what can be proved from the source.

       This is the fix for a DF 25/26 error 4544 that no call-site rewrite can fully reach: with the
       workspace's own declarations out of the contested name, the name is left with DataFlex's single
       return type and EVERY call of it compiles - including calls split over two lines, calls inside a
       macro, and calls in DataFlex's own packages, which must never be edited.

       Renamed:
         - the declaration (Function / Procedure / Procedure Set) inside a class of the FAMILY
         - an unqualified call inside a family class body, and (<name>(Self ...)) there
         - Get/Set/Send <name> of <receiver>, where <receiver> is a PROVEN family object or handle
         - (<name>(<receiver> ...)) and <receiver>.<name>( , same proof required

       Never renamed, by design: anything whose receiver cannot be established from the source. A rename
       that guesses is a rename that breaks somebody's build, and this runs over library code. Those sites
       are recorded (pasRenameUnproven) and handed back as Manual Changes rows instead. bRecordUnproven
       keeps that list honest: in a file with no family object anywhere, a "Value(" belongs to somebody
       else's Value - recording it would bury the real work under hundreds of rows about form controls.

       Returns the number of LINES changed; asLines is updated in place. */
    Function _RenameMethodInLines String[] ByRef asLines String sOld String sNew String[] asReceivers String[] asFamily String sFile Boolean bRecordUnproven Returns Integer
        String[] asWords asUnproven asTail
        String sLine sCode sBefore sAfter sRecv sCh sEntry sOldLc sRest
        Integer i iLast iPos iLen iChanged iAt iNext iOpen
        Boolean bInFamily bComment bDoRename bLineChanged bKnown bDeclLine

        Move 0 to iChanged
        Move False to bInFamily
        Move (Length(sOld)) to iLen
        Move (Lowercase(sOld)) to sOldLc
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            If (Mod(i, 20) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Renaming, line:"
            Move asLines[i] to sLine
            Get _IsCommentLine sLine to bComment
            Get _CodeOnlyLine sLine to sCode
            Get _SplitSourceWords (Trim(sCode)) to asWords
            // ---- class context: only a family class body may have its own declarations renamed ----
            If (SizeOfArray(asWords) >= 1) Begin
                If (Lowercase(asWords[0]) = "end_class") ;
                    Move False to bInFamily
            End
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "class") ;
                    Move (SearchArray(asWords[1], asFamily, Desktop, RefFunc(DFSTRICMP)) <> -1) to bInFamily
            End
            // ---- is this line a DECLARATION of the name? Decided on the word list, not on character
            //      arithmetic: "Procedure Set Value ..." declares a setter, "Set Value of oX ..." calls one,
            //      and the two are only told apart by what comes BEFORE the Set.
            Move False to bDeclLine
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "function" or Lowercase(asWords[0]) = "procedure") Begin
                    If (Lowercase(asWords[1]) = sOldLc) ;
                        Move True to bDeclLine
                End
            End
            If (SizeOfArray(asWords) >= 3) Begin
                If (Lowercase(asWords[0]) = "procedure" and Lowercase(asWords[1]) = "set") Begin
                    If (Lowercase(asWords[2]) = sOldLc) ;
                        Move True to bDeclLine
                End
            End
            If (bComment = False) Begin
                Move False to bLineChanged
                Move 1 to iAt
                Get _FindKeywordPos sCode sOld True iAt to iPos
                While (iPos > 0)
                    Move (iPos + iLen) to iNext
                    Get _WordBeforePos sCode iPos  to sBefore
                    Get _WordAfterPos  sCode iNext to sAfter
                    Get _NextNonSpaceChar sCode iNext to sCh
                    Move False to bDoRename
                    Move True  to bKnown
                    If (sBefore = "function" or sBefore = "procedure" or (sBefore = "set" and bDeclLine = True)) Begin
                        Move bInFamily to bDoRename
                    End
                    Else If (sBefore = "get" or sBefore = "send" or sBefore = "set") Begin
                        // Statement form. "of <receiver>" names the target; without it the target is Self,
                        // which is only ours inside a family class body.
                        If (sAfter = "of") Begin
                            // Tokenise the tail rather than stepping a fixed number of characters: real
                            // source writes "Get Value  of oTbl" with any amount of space it likes.
                            Move (Trim(Right(sCode, (Length(sCode) - iNext + 1)))) to sRest
                            Get _SplitSourceWords sRest to asTail
                            Move "" to sRecv
                            If (SizeOfArray(asTail) >= 2) ;
                                Move asTail[1] to sRecv
                            Move (SearchArray(sRecv, asReceivers, Desktop, RefFunc(DFSTRICMP)) <> -1) to bDoRename
                            Move bDoRename to bKnown
                        End
                        Else ;
                            Move bInFamily to bDoRename
                    End
                    Else If (sCh = "(") Begin
                        // Expression form. The receiver is the identifier before a dot, or the first argument.
                        Get _PosOfNextNonSpace sCode iNext to iOpen
                        Get _CharAt sCode (iPos - 1) to sCh
                        If (sCh = ".") ;
                            Get _WordBeforePos sCode (iPos - 1) to sRecv
                        If (sCh <> ".") ;
                            Get _WordAfterPos sCode (iOpen + 1) to sRecv
                        If (sRecv = "self") ;
                            Move bInFamily to bDoRename
                        If (sRecv <> "self") Begin
                            Move (SearchArray(sRecv, asReceivers, Desktop, RefFunc(DFSTRICMP)) <> -1) to bDoRename
                            Move bDoRename to bKnown
                        End
                    End
                    If (bDoRename = True) Begin
                        Move (Left(sLine, (iPos - 1)) + sNew + Right(sLine, (Length(sLine) - iPos - iLen + 1))) to sLine
                        Get _CodeOnlyLine sLine to sCode
                        Move (iPos + Length(sNew)) to iAt
                        Move True to bLineChanged
                    End
                    Else Begin
                        // A receiver we could not type. Only worth reporting where the family is actually in
                        // play - elsewhere this is somebody else's message that happens to share the name.
                        If (bKnown = False and bRecordUnproven = True) Begin
                            Get pasRenameUnproven to asUnproven
                            Move (sFile + "|" + String(i + 1) + "|Check this " + sOld + " call and rename it to " + sNew + " by hand if it targets one of the renamed classes|The receiver could not be typed from the source, so it was left alone rather than guessed at") to sEntry
                            If (SearchArray(sEntry, asUnproven, Desktop, RefFunc(DFSTRICMP)) = -1) Begin
                                Move sEntry to asUnproven[SizeOfArray(asUnproven)]
                                Set pasRenameUnproven to asUnproven
                            End
                        End
                        Move iNext to iAt
                    End
                    Get _FindKeywordPos sCode sOld True iAt to iPos
                Loop
                If (bLineChanged = True) Begin
                    Move sLine to asLines[i]
                    Increment iChanged
                End
            End
        Loop
        Function_Return iChanged
    End_Function

    /* THE NAME A FUNCTION/PROCEDURE LINE DECLARES, from _SplitSourceWords' words of it (two or more). A global Set
       procedure's name is two words: "Procedure Set Profile_Dword Global String s" declares "Set Profile_Dword".
       Reading the second word alone made every one of them a global called "Set" (2026-11-02). DataFlex ships five,
       so that word stood in every catalogue, and every global Set procedure of a workspace - whatever its name - got
       a version guard it never needed: gone from the compile, every Set of it failing with error 4306, and hidden
       for as long as anything else stopped the compile first. */
    Function _GlobalDeclaredName String[] asWords Returns String
        If (SizeOfArray(asWords) >= 3) Begin
            If (Lowercase(asWords[0]) = "procedure" and Lowercase(asWords[1]) = "set" and Lowercase(asWords[2]) <> "global") ;
                Function_Return ("Set " + asWords[2])
        End
        Function_Return asWords[1]
    End_Function

    // Harvest the GLOBAL Function/Procedure NAMES declared in a package's lines - the names the target
    // DataFlex SHIPS. A user file that declares a Global function of the same name is a "backport" that
    // now collides with the native one (error 4390); the guided findings list flags it. The Global keyword
    // follows the name (Function Utf8ToOem Global String s Returns String), but we scan all trailing
    // words to be safe. PURE (no file I/O) -> unit-testable. Run over the install packages by the
    // shared walk (WalkInstallPackages).
    Function _GlobalFuncNamesFromLines String[] asLines Returns String[]
        String[] asOut asWords
        String sCmd sName
        Integer i iLast j jLast
        Boolean bGlobal

        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _SplitSourceWords asLines[i] to asWords
            If (SizeOfArray(asWords) >= 3) Begin
                Move (Lowercase(asWords[0])) to sCmd
                If (sCmd = "function" or sCmd = "procedure") Begin
                    Move False to bGlobal
                    Move (SizeOfArray(asWords) - 1) to jLast
                    For j from 2 to jLast
                        If (Lowercase(asWords[j]) = "global") ;
                            Move True to bGlobal
                    Loop
                    If (bGlobal = True) Begin
                        Get _GlobalDeclaredName asWords to sName
                        Move sName to asOut[SizeOfArray(asOut)]
                    End
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // A DataFlex version string -> the 3-digit number the compiler's own version macro compares against
    // (19.1 -> 191, 25.0 -> 250), for emitting version-guarded source. Accepts what real workspaces and
    // users actually supply: "19.1" / "25.0" (a .sws [Properties] Version or JSON "df"), a bare major
    // ("26" -> 260), or the macro form already ("191" -> 191). Comma is accepted as the separator too -
    // the value can reach us from a locale that writes decimals that way. 0 = "could not tell", the
    // caller's signal to REFUSE rather than write a guessed version into someone's source. PURE ->
    // unit-testable. (Only the MAJOR part had a helper before - MajorVersionFromVersionString in
    // cCompileMixin - which cannot express the .1 in 19.1.)
    Function DfVersionToMacroNumber String sVer Returns Integer
        String sTrim sMajor sMinor
        Integer iPos iMajor iMinor iLen

        Move (Trim(sVer)) to sTrim
        If (sTrim = "") ;
            Function_Return 0
        Move (Pos(".", sTrim)) to iPos
        If (iPos = 0) ;
            Move (Pos(",", sTrim)) to iPos
        If (iPos > 0) Begin
            Move (Trim(Left(sTrim, (iPos - 1))))                  to sMajor
            Move (Trim(Right(sTrim, (Length(sTrim) - iPos))))     to sMinor
            // Only the FIRST minor digit counts: the macro is major*10 + minor.
            If (sMinor <> "") ;
                Move (Left(sMinor, 1)) to sMinor
            If (sMinor = "") ;
                Move "0" to sMinor
            Move sMajor to iMajor
            Move sMinor to iMinor
            If (iMajor <= 0) ;
                Function_Return 0
            Function_Return ((iMajor * 10) + iMinor)
        End
        // No separator: 1-2 digits = a bare major ("26"); 3 = already the macro form ("191").
        Move (Length(sTrim)) to iLen
        Move sTrim to iMajor
        If (iMajor <= 0) ;
            Function_Return 0
        If (iLen >= 3) ;
            Function_Return iMajor
        Function_Return (iMajor * 10)
    End_Function

    // The closing #ENDIF's line of the guard whose marker is on iAt, or -1 when the lines from there are not exactly
    // what the guard wrote: marker, two comment lines, the #IF, a Procedure Set block, the #ENDIF.
    Function _WrongSetGuardEndAt String[] ByRef asCode Integer iAt Returns Integer
        String[] asWords
        String sWord
        Integer iJ iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        If ((iAt + 6) > iLast) ;
            Function_Return -1
        If (Uppercase(Left(Trim(asCode[iAt + 3]), 3)) <> (Character(35) + "IF")) ;
            Function_Return -1
        Get _SplitSourceWords asCode[iAt + 4] to asWords
        If (SizeOfArray(asWords) < 3) ;
            Function_Return -1
        If (Lowercase(asWords[0]) <> "procedure" or Lowercase(asWords[1]) <> "set") ;
            Function_Return -1
        For iJ from (iAt + 5) to (iLast - 1)
            Get _SplitSourceWords asCode[iJ] to asWords
            If (SizeOfArray(asWords) > 0) Begin
                Move (Lowercase(asWords[0])) to sWord
                If (sWord = "end_function" or sWord = "end_procedure") Begin
                    If (Uppercase(Trim(asCode[iJ + 1])) = (Character(35) + "ENDIF")) ;
                        Function_Return (iJ + 1)
                    Function_Return -1
                End
            End
        Loop
        Function_Return -1
    End_Function

    /* OUR OWN GUARD AROUND A "GLOBAL CALLED Set" COMES BACK OUT (2026-11-02, see _GlobalDeclaredName). No such global
       exists, and the guard kept a procedure of the workspace out of the compile. Only the exact shape the guard wrote
       is taken back; one somebody has edited stays, and so does any #IF without our marker. A Set procedure that does
       share its name with a native one gets the right guard straight after, from the walk in _GuardGlobalsInLines.
       The marker spells the word as the source did ('SET' as well as 'Set'), so it is compared in lowercase.
       Returns how many came out. */
    Function _RemoveWrongSetGuards String[] ByRef asCode Returns Integer
        String[] asOut asWords
        String sName
        Integer i iLast iEnd iJ iRemoved

        Move (SizeOfArray(asCode) - 1) to iLast
        Move 0 to iRemoved
        Move 0 to i
        While (i <= iLast)
            Move -1 to iEnd
            If (Pos("[dfrefactor] 'set' is now a native", Lowercase(asCode[i])) > 0) ;
                Get _WrongSetGuardEndAt (&asCode) i to iEnd
            If (iEnd = -1) Begin
                Move asCode[i] to asOut[SizeOfArray(asOut)]
                Increment i
            End
            Else Begin
                Get _SplitSourceWords asCode[i + 4] to asWords
                Get _GlobalDeclaredName asWords to sName
                Send AddRunNote "GuardRedundantGlobalFunctions" (sName + ": removed the version guard an earlier run wrote around it by mistake. It kept this procedure out of the compile, so calls to it failed with error 4306.")
                For iJ from (i + 4) to (iEnd - 1)
                    Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                Loop
                Increment iRemoved
                Move (iEnd + 1) to i
            End
        Loop
        If (iRemoved > 0) ;
            Move asOut to asCode
        Function_Return iRemoved
    End_Function

    // PURE core of GuardRedundantGlobalFunctions (oRefactorFuncLib): wraps every top-level GLOBAL
    // Function/Procedure whose name appears in asNative with an #IF (!@ <= iVer) ... #ENDIF guard, so the
    // home-brewed copy compiles only on releases that lack the built-in (duplicate-global error 4390).
    // Rewrites asCode in place and returns how many blocks were guarded. Pure by design - the caller
    // resolves the version and the install catalogue - so it is unit-testable WITHOUT an install walk or a
    // cRefactorApplication (the DFUnit runner builds a plain cApplication, which has no pTargetWS).
    // sVerText is the human spelling for the marker ("19.1"); iVer is the macro number (191).
    // The emitted "#" and "!" are Character()-built: FMAC evaluates its directive/counter tokens BEFORE
    // string-literal semantics exist, so a literal "#IF (!@" here would be consumed by OUR own compile.
    Function _GuardGlobalsInLines String[] ByRef asCode String[] asNative Integer iVer String sVerText Returns Integer
        String[] asOut asWords
        String sLine sTrim sFirst sName sIndent sEndTrim sEndTok sOpen sClose sPrev sFirstNative sKeptFor
        Integer iSize iGuarded iDepth iCount iSkipUntil iEnd iJ iP iSp2 iW iWLast iBack iFirstNative
        Boolean bFound bGlobal bAlready bPanel bRepaired bOurs

        // NAME THE EXIT. Both of these produce "guarded 0" and neither is "no such name in the
        // catalogue" - the caller used to report them as exactly that.
        If (iVer <= 0) Begin
            Set psGuardSkipReason to ("no usable DataFlex version for the guard (" + Character(35) + "IF) directive - got " + (If(sVerText = "", "a blank version", Character(34) + sVerText + Character(34))))
            Function_Return 0
        End
        If (SizeOfArray(asNative) = 0) Begin
            Set psGuardSkipReason to ("the catalogue of native DataFlex globals for " + sVerText + " came back EMPTY, so nothing could be matched against it")
            Function_Return 0
        End
        Move (Character(35) + "IF (" + Character(33) + "@ <= " + String(iVer) + ")") to sOpen
        Move (Character(35) + "ENDIF") to sClose

        // A guard taken back is a change like any other: the caller writes the file on the count.
        Get _RemoveWrongSetGuards (&asCode) to iGuarded
        Set piGuardedCount to (piGuardedCount(Self) + iGuarded)
        Move 0  to iDepth
        Move -1 to iSkipUntil
        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        // The engine only auto-advances the per-file progress bar for LINE-BY-LINE functions; a whole-file
        // eOtherFunction is one call per file, so it must drive the bar itself or a big file looks FROZEN
        // (Nils 2026-07-21: "seems frozen after 02:14"). Guarded on the panel existing AND being active, so
        // it is a no-op in batch mode and under the DFUnit runner - which keeps this core testable.
        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        For iCount from 0 to iSize
            If (bPanel = True and Mod(iCount, 20) = 0) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iCount + 1)
            End
            // Lines inside a block we just guarded were already emitted - skip them.
            If (iCount > iSkipUntil) Begin
                Move asCode[iCount] to sLine
                Move (Trim(sLine)) to sTrim
                // The canonical splitter - the same one the install-catalogue harvester uses - so the
                // GLOBAL-keyword scan below matches _GlobalFuncNamesFromLines exactly.
                Get _SplitSourceWords sLine to asWords
                Move "" to sFirst
                Move "" to sName
                Move False to bGlobal
                If (SizeOfArray(asWords) >= 1) ;
                    Move (Lowercase(asWords[0])) to sFirst
                If (SizeOfArray(asWords) >= 2) Begin
                    Get _GlobalDeclaredName asWords to sName
                    // The GLOBAL keyword FOLLOWS the name (Function Foo Global String s Returns String);
                    // scan every trailing word, exactly as the catalogue harvester does.
                    Move (SizeOfArray(asWords) - 1) to iWLast
                    For iW from 2 to iWLast
                        If (Lowercase(asWords[iW]) = "global") ;
                            Move True to bGlobal
                    Loop
                End

                If ((sFirst = "class") or (sFirst = "object")) Begin
                    Increment iDepth
                    Move sLine to asOut[SizeOfArray(asOut)]
                End
                Else If ((sFirst = "end_class") or (sFirst = "end_object")) Begin
                    If (iDepth > 0) ;
                        Move (iDepth - 1) to iDepth
                    Move sLine to asOut[SizeOfArray(asOut)]
                End
                Else If ((iDepth = 0) and (bGlobal = True) and ((sFirst = "function") or (sFirst = "procedure"))) Begin
                    // Does the target install ship this name as a Global? Case-insensitive.
                    If (SearchArray(sName, asNative, Desktop, RefFunc(DFSTRICMP)) <> -1) Begin
                        // Closing End_Function / End_Procedure (the first one - these do not nest).
                        Move -1 to iEnd
                        Move False to bFound
                        Move (iCount + 1) to iJ
                        While ((iJ <= iSize) and (bFound = False))
                            Move (Trim(Replaces((Character(9)), asCode[iJ], " "))) to sEndTrim
                            Move (Pos(" ", sEndTrim)) to iSp2
                            If (iSp2 > 0) Begin
                                Move (Lowercase(Left(sEndTrim, (iSp2 - 1)))) to sEndTok
                            End
                            Else Begin
                                Move (Lowercase(sEndTrim)) to sEndTok
                            End
                            If ((sEndTok = "end_function") or (sEndTok = "end_procedure")) Begin
                                Move iJ to iEnd
                                Move True to bFound
                            End
                            Increment iJ
                        Loop
                        If (bFound = True) Begin
                            // IDEMPOTENT: a block we already guarded is immediately preceded by our #IF
                            // line, so walk back over blank lines to the last REAL line and look for it.
                            // Conservative by design - ANY preceding #IF means hands off, so a block the
                            // user version-guarded by hand is never double-wrapped either.
                            Move False to bAlready
                            Move (SizeOfArray(asOut) - 1) to iBack
                            While ((iBack >= 0) and (bAlready = False))
                                Move (Trim(asOut[iBack])) to sPrev
                                If (sPrev <> "") Begin
                                    If (Uppercase(Left(sPrev, 3)) = (Character(35) + "IF")) ;
                                        Move True to bAlready
                                    Move 0 to iBack           // the first non-blank line decides
                                End
                                Decrement iBack
                            Loop
                            If (bAlready = True) Begin
                                /* REPAIR OUR OWN WRONG GUARD, LEAVE ANYONE ELSE'S ALONE (2026-08-16).
                                   The #IF found above is OURS if the "[DFRefactor] '<name>' is now a
                                   NATIVE" marker sits within the three lines before it - a hand-written
                                   guard has no marker and is never touched. If ours and the directive
                                   is not the per-function boundary this run would write (the
                                   "<= workspace" shape from before today), rewrite that one #IF line
                                   in place. The two OEMToUTF8 / UTF8toOEM guards written on 08-15
                                   as "<= 260" are exactly this: correct in every way except the
                                   number, and unfixable by re-running until now. */
                                Get FirstNativeVersionFor sName to sFirstNative
                                Get DfVersionToMacroNumber sFirstNative to iFirstNative
                                Move False to bRepaired
                                If (iFirstNative > 0) Begin
                                    Move (SizeOfArray(asOut) - 1) to iBack
                                    // iBack is at the #IF line (the loop above stopped on it); confirm the
                                    // marker is ours within three lines above it.
                                    While ((iBack >= 0) and (Trim(asOut[iBack]) = ""))
                                        Decrement iBack
                                    Loop
                                    // Our marker sits 1..3 lines above the #IF (marker, kept-for, verify).
                                    Move False to bOurs
                                    For iJ from (iBack - 3) to (iBack - 1)
                                        If (iJ >= 0) Begin
                                            If (Pos("[DFRefactor] '", asOut[iJ]) > 0) ;
                                                Move True to bOurs
                                        End
                                    Loop
                                    If (bOurs = True) Begin
                                        Begin
                                            Move (Character(35) + "IF (" + Character(33) + "@ < " + String(iFirstNative) + ")") to sOpen
                                            If (Trim(asOut[iBack]) <> sOpen) Begin
                                                Move (Pos(Trim(asOut[iBack]), asOut[iBack])) to iP
                                                Move (If(iP > 1, Left(asOut[iBack], iP - 1), "")) to sIndent
                                                Move (sIndent + sOpen) to asOut[iBack]
                                                Increment iGuarded
                                                Set piGuardedCount to (piGuardedCount(Self) + 1)
                                                Move True to bRepaired
                                            End
                                        End
                                    End
                                End
                                If (bRepaired = False) ;
                                    Set piAlreadyGuardedCount to (piAlreadyGuardedCount(Self) + 1)
                                Move sLine to asOut[SizeOfArray(asOut)]
                            End
                            Else Begin
                                // Marker + guard at the declaration's own indentation. The block itself is
                                // copied VERBATIM - a guard changes what COMPILES, never what the code says.
                                Move "" to sIndent
                                Move (Pos(sTrim, sLine)) to iP
                                If (iP > 1) ;
                                    Move (Left(sLine, (iP - 1))) to sIndent
                                /* THE BOUNDARY IS PER FUNCTION - the release DataFlex first shipped
                                   the name in - not the workspace's version (2026-08-16, see
                                   FirstNativeVersionFor). "< first" keeps the copy on every release
                                   BEFORE the native exists and drops it from the one that has it;
                                   the old "<= workspace version" kept OEMToUTF8 alive on a DF26
                                   compile because the workspace had been converted to 26.0 first.
                                   A name in no catalogue falls back to the workspace boundary - the
                                   guardable gate normally keeps such a name from reaching here. */
                                Get FirstNativeVersionFor sName to sFirstNative
                                Get DfVersionToMacroNumber sFirstNative to iFirstNative
                                If (iFirstNative > 0) Begin
                                    Move (Character(35) + "IF (" + Character(33) + "@ < " + String(iFirstNative) + ")") to sOpen
                                    Move ("// Kept for DataFlex releases before " + sFirstNative + ", where the native did not yet exist; " + sFirstNative + " and newer use the native one instead.") to sKeptFor
                                End
                                Else Begin
                                    Move (Character(35) + "IF (" + Character(33) + "@ <= " + String(iVer) + ")") to sOpen
                                    Move ("// Kept for DataFlex " + sVerText + " and older; newer builds use the native one instead.") to sKeptFor
                                End
                                Move (sIndent + "// [DFRefactor] '" + sName + "' is now a NATIVE DataFlex global (duplicate-global error 4390).") to asOut[SizeOfArray(asOut)]
                                Move (sIndent + sKeptFor) to asOut[SizeOfArray(asOut)]
                                Move (sIndent + "// VERIFY the built-in matches this implementation - it CAN differ (code page, error handling, edge cases).") to asOut[SizeOfArray(asOut)]
                                Move (sIndent + sOpen) to asOut[SizeOfArray(asOut)]
                                For iJ from iCount to iEnd
                                    Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                                Loop
                                Move (sIndent + sClose) to asOut[SizeOfArray(asOut)]
                                Increment iGuarded
                                Set piGuardedCount to (piGuardedCount(Self) + 1)
                                Move iEnd to iSkipUntil
                            End
                        End
                        Else Begin
                            // No closing End found - leave the line untouched.
                            Move sLine to asOut[SizeOfArray(asOut)]
                        End
                    End
                    Else Begin
                        Move sLine to asOut[SizeOfArray(asOut)]
                    End
                End
                Else Begin
                    Move sLine to asOut[SizeOfArray(asOut)]
                End
            End
        Loop

        // Finish the file at 100%: the nudge above only fires every 20 lines, so without this the caption
        // keeps the last multiple ("line 361 of 369") and looks STUCK mid-file for however long the next
        // file's setup takes (Nils 2026-07-21).
        If (bPanel = True) Begin
            Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iSize + 1) * "of:" * String(iSize + 1))
            Set piPosition of ghoProgressBar to (iSize + 1)
        End
        If (iGuarded > 0) ;
            Move asOut to asCode
        Function_Return iGuarded
    End_Function

    // Every External_Function NAME declared in these lines (word[1] of an external_function line).
    // PURE -> unit-testable; feeds both the install catalogue walk and the per-file candidate harvest
    // of GuardDuplicateExternalFunctions.
    Function _ExternalFnNamesFromLines String[] asLines Returns String[]
        String[] asOut asWords
        Integer i iLast
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _SplitSourceWords asLines[i] to asWords
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(asWords[0]) = "external_function") ;
                    Move asWords[1] to asOut[SizeOfArray(asOut)]
            End
        Loop
        Function_Return asOut
    End_Function

    /* The same declarations, packed as "NAME|dll|entry" - NAME uppercased for lookup, dll and entry
       lowercased so a comparison is a plain string test (DataFlex "=" is case-sensitive).

       WHY THE BINDING AND NOT JUST THE NAME (2026-08-09): a name match alone cannot tell a duplicate
       declaration from a DIFFERENTLY BOUND one. Measured over ~9,600 declarations in the DF18/DF19
       trees, 1,585 sites bind exactly what DataFlex binds, and 226 do not - nearly all of them
       ShellExecute declared against ShellExecuteA where DataFlex ships ShellExecuteW. Those 226 are
       the ones a reader must actually check, and the guard could not name them.

       Kept UNSORTED and packed rather than parallel to the sorted name array: sorting one of two
       parallel arrays breaks the correspondence, the trap already recorded on pasScopePairStart. */
    /* One declaration's head as "NAME|dll|entry", or "" when the line is not an External_Function or
       is not shaped like one.

       NOT _SplitSourceWords, which is the LEXER's splitter and overstrikes string literals - the
       entry point is a quoted literal, so it comes back gone and every token after the name shifts
       one left. That silently made the dll look like the entry point (caught by the tests here,
       2026-08-09). Plain whitespace split on the raw line, exactly as _AuditApiDeclaration does with
       the same three tokens, is the right tool: this reads the SHAPE of a declaration, not its code.

       The dll token must carry an extension. Anything else is a declaration this packing cannot
       describe, so it is skipped rather than guessed at. */
    Function _ExternalFnHeadPacked String sLine Returns String
        String[] asRaw asTok
        String sEntry sDll
        Integer i iLast iNum

        Move (Replaces((Character(9)), sLine, " ")) to sLine
        Move (StrSplitToArray(Trim(sLine), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTok[iNum]
                Increment iNum
            End
        Loop
        If (iNum < 4) ;
            Function_Return ""
        If (Lowercase(asTok[0]) <> "external_function") ;
            Function_Return ""
        Move (Lowercase(Replaces('"', asTok[2], ""))) to sEntry
        Move (Lowercase(asTok[3])) to sDll
        If (Pos(".", sDll) = 0) ;
            Function_Return ""
        Function_Return (Uppercase(asTok[1]) + "|" + sDll + "|" + sEntry)
    End_Function

    /* THE RECEIVER OF AN API RESULT, on one line. "Move (GetFoo(hWnd)) to iRet" answers True with
       sReceiver = "iRet"; a call whose result nothing stores answers False.

       WHY THE RECEIVER IS THE INTERESTING HALF: when ConvertWinAPIDeclarationTypes corrects a
       declaration from "Returns Integer" to "Returns Handle", the declaration compiles and the CALL
       SITES are where an x64 truncation actually lands - an 8-byte handle assigned into a 4-byte
       Integer. _CallSiteNoteForReturnChange already names those, but only in the file being converted
       and only while the run is happening. This is the cross-file, after-the-fact evidence.

       Searched on the MASKED line so a call inside a string or after "//" is invisible, and
       boundary-aware so "MyGetFoo(x)" is not GetFoo. The receiver is read from the RAW line, so its
       case survives into the report. */
    Function _ApiCallReceiverOnLine String sLine String sApiName String ByRef sReceiver Returns Boolean
        String[] asTok
        String sMask sRest
        Integer iPos iScan iClose iTo iLen

        Move "" to sReceiver
        If (Trim(sApiName) = "" or Trim(sLine) = "") ;
            Function_Return False
        Get _MaskStatementLine sLine to sMask
        Move (Length(sMask)) to iLen
        Get _FindKeywordPos sMask sApiName True 1 to iPos
        If (iPos = 0) ;
            Function_Return False
        // the name must be CALLED - a bare mention is not a call site
        Move (iPos + Length(sApiName)) to iScan
        While (iScan <= iLen and Mid(sMask, 1, iScan) = " ")
            Increment iScan
        Loop
        If (iScan > iLen) ;
            Function_Return False
        If (Mid(sMask, 1, iScan) <> "(") ;
            Function_Return False
        Get _FindMatchingParentheses sMask iScan to iClose
        If (iClose <= iScan or iClose > iLen) ;
            Function_Return False
        // "to <var>" AFTER the call closes. Bounded by the line length for the same reason the cast
        // scanner is: DataFlex ignores trailing spaces, so ("" = " ") is True past the end.
        Get _FindKeywordPos sMask "to" True (iClose + 1) to iTo
        If (iTo = 0) ;
            Function_Return False
        Move (iTo + 2) to iScan
        If (iScan > iLen) ;
            Function_Return False
        Move (Trim(Mid(sLine, (iLen - iScan + 1), iScan))) to sRest
        If (sRest = "") ;
            Function_Return False
        Move (StrSplitToArray(sRest, CS_S)) to asTok
        If (SizeOfArray(asTok) = 0) ;
            Function_Return False
        Move (Trim(asTok[0])) to sReceiver
        Function_Return (sReceiver <> "")
    End_Function

    /* Is this token a name DataFlex declares variables with? The union of the types that are legal
       conversion functions and the ones that are not (see _LegacyTypeCastInLine) - the two lists
       split on castability, which has nothing to do with whether you can declare with them. */
    Function _IsDeclarationTypeName String sTokenLc Returns Boolean
        Function_Return (sTokenLc = "integer"  or sTokenLc = "uinteger" or sTokenLc = "string"   or ;
                         sTokenLc = "handle"   or sTokenLc = "boolean"  or sTokenLc = "number"   or ;
                         sTokenLc = "date"     or sTokenLc = "datetime" or sTokenLc = "real"     or ;
                         sTokenLc = "pointer"  or sTokenLc = "address"  or sTokenLc = "longptr"  or ;
                         sTokenLc = "ulongptr" or sTokenLc = "dword"    or sTokenLc = "word"     or ;
                         sTokenLc = "short"    or sTokenLc = "ushort"   or sTokenLc = "bigint"   or ;
                         sTokenLc = "ubigint"  or sTokenLc = "char"     or sTokenLc = "uchar"    or ;
                         sTokenLc = "byte"     or sTokenLc = "rowid"    or sTokenLc = "variant"  or ;
                         sTokenLc = "timespan" or sTokenLc = "long")
    End_Function

    /* The DECLARED type of a variable, looked up in the lines of the file that uses it - "" when no
       declaration is visible there.

       "" is a REAL ANSWER, not a failure: a receiver can be a property, a struct member, or declared
       in an included file, and the report says "not declared in this file" rather than guessing. A
       report that quietly omitted those would understate the blast radius, which is the one thing it
       must not do.

       Matches "<Type> <var>" and "Property <Type> <var>", the two shapes that carry a type in front of
       a name. The type must be a name DataFlex actually declares with - a first-token check alone
       would read "Move iRet" as declaring a variable of type Move. */
    Function _DeclaredTypeOfVarInLines String[] ByRef asCode String sVar Returns String
        String[] asTok
        String sMask sTypeLc sTok
        Integer i iLast j jLast iFirst

        If (Trim(sVar) = "") ;
            Function_Return ""
        Move (Lowercase(Trim(sVar))) to sVar
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _MaskStatementLine asCode[i] to sMask
            Move (Replaces((Character(9)), sMask, " ")) to sMask
            Move (StrSplitToArray(Trim(sMask), CS_S)) to asTok
            Move (SizeOfArray(asTok) - 1) to jLast
            If (jLast >= 1) Begin
                Move 0 to iFirst
                // "Property Integer piX" carries the type one token further along.
                If (Lowercase(Trim(asTok[0])) = "property") ;
                    Move 1 to iFirst
                Move (Lowercase(Trim(asTok[iFirst]))) to sTypeLc
                If (_IsDeclarationTypeName(Self, sTypeLc) = True) Begin
                    For j from (iFirst + 1) to jLast
                        Move (Lowercase(Trim(asTok[j]))) to sTok
                        // a declaration may name several variables, comma separated or not
                        Move (Replaces(",", sTok, "")) to sTok
                        If (sTok = sVar) ;
                            Function_Return (Trim(asTok[iFirst]))
                    Loop
                End
            End
        Loop
        Function_Return ""
    End_Function

    Function _ExternalFnBindingsFromLines String[] asLines Returns String[]
        String[] asOut
        String sPacked
        Integer i iLast
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _ExternalFnHeadPacked asLines[i] to sPacked
            If (sPacked <> "") ;
                Move sPacked to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    /* The SDK prototype this app curates for a Win32 API the install does not declare, or "" when
       the catalogue does not cover it. Matched on dll AND entry point, both exactly. The dll must
       match - the same entry point in a different library is a different function, which is the
       mistake the guard's binding check exists to catch.

       A BARE ENTRY POINT IS ANSWERED BY A MEASURED ROW, NOT BY A SPELLING RULE (2026-09-12). Legacy
       code writes "ShellExecuteEx" where the SDK name is ShellExecuteExA, and this used to append
       "a", then "w", until something matched. That is a guess, and Windows disagrees with it often
       enough to matter: kernel32's bare ReplaceFile IS ReplaceFileW, shell32's ILCreateFromPath and
       IsLFNDrive likewise, PlaySound and the tapi32 family are their own code - and a bare name the
       dll does not export at all (GetPrivateProfileString) was answered with the A prototype for a
       declaration that cannot bind, one that raises Error 4355 at its first call. The catalogue now
       carries a row under the bare key wherever the dll really aliases it, measured by
       GetProcAddress (cWin32ProjectionHarvester.BareAliasRows), so the fact lives in the data and
       the lookup only has to read it. Where there is no row there is no answer, which is what every
       converter here treats as "not covered" and leaves alone. */
    /* Lower-bound binary search for the row starting with sPrefix, or -1.

       WHY (Nils, 2026-08-28, the WinServ scan): the harvest took the catalogue from 56 rows to
       1,294, and the lookup was a linear walk performed once per External_Function declaration -
       ~1,086 of them on WinServ - with a fresh COPY of the whole array per call on top, because
       every lookup did its own property Get. This is the same lesson the codebase already carries
       twice (LineIsNotCode's ByRef struct; _SweepRules' ByRef rules array): big arrays travel
       ByRef, and a sorted array is searched, not walked.

       SORTEDNESS IS ESTABLISHED AT THE ONE LOAD POINT (RefreshWinAPICatalogsFromJson sorts with
       DFSTRICMP), so a hand-edited JSON row lands in order regardless of where the editor put it.
       The identity prefix is lowercase by construction on both row flavours. */
    Function _WinAPICatalogFindRow String[] ByRef asCat String sPrefix Returns Integer
        String sMid
        Integer iLo iHi iMid iLen

        Move (Lowercase(sPrefix)) to sPrefix
        Move (Length(sPrefix)) to iLen
        Move 0 to iLo
        Move (SizeOfArray(asCat) - 1) to iHi
        // Plain string relationals on the LOWERCASED head, not DFSTRICMP - that comparator is only
        // ever invoked through RefFunc in this codebase, and on lowercase ASCII keys the two
        // orderings agree, which is all the sort/search pact needs.
        While (iLo <= iHi)
            Move ((iLo + iHi) / 2) to iMid
            Move (Lowercase(Left(asCat[iMid], iLen))) to sMid
            If (sMid = sPrefix) ;
                Function_Return iMid
            If (sMid < sPrefix) ;
                Move (iMid + 1) to iLo
            Else ;
                Move (iMid - 1) to iHi
        Loop
        Function_Return -1
    End_Function

    /* The prototype lookup against a caller-held catalogue - the ByRef core WinAPIPrototype wraps.
       Same tolerance, same order: exact entry, then the SDK's A form, then W. */
    Function _WinAPIPrototypeFromCat String[] ByRef asCat String sDll String sEntry Returns String
        String sD sE sRow
        Integer iAt

        Move (Lowercase(Trim(sDll)))   to sD
        Move (Lowercase(Trim(sEntry))) to sE
        If (sD = "" or sE = "") ;
            Function_Return ""
        Get _WinAPICatalogFindRow (&asCat) (sD + "|" + sE + "|") to iAt
        If (iAt = -1) ;
            Function_Return ""
        Move asCat[iAt] to sRow
        // payload = everything past the second "|"
        Move (Pos("|", sRow)) to iAt
        Move (Pos("|", sRow, (iAt + 1))) to iAt
        Function_Return (Right(sRow, (Length(sRow) - iAt)))
    End_Function

    Function WinAPIPrototype String sDll String sEntry Returns String
        String[] asCat

        // One property Get per CALL is this wrapper's cost - fine for the occasional callers.
        // The hot paths (the Deep Scan rule, the converter's file loop) hold the array themselves
        // and go through _WinAPIPrototypeFromCat ByRef, paying the copy once per file at most.
        Send RefreshWinAPICatalogsFromJson
        Get pasWinAPICatalog to asCat
        Function_Return (_WinAPIPrototypeFromCat(Self, &asCat, sDll, sEntry))
    End_Function

    /* ...and that prototype as a DataFlex External_Function, converted by the app's OWN converter.
       This is the whole reason the catalogue stores C and not DataFlex: CDeclarationToDataFlex
       already owns the pointer-width and Unicode rules, is unit-tested, and is audited against
       _AuditApiDeclaration. Converting here means the catalogue cannot grow a second type table
       that drifts from it - the defect [[feedback_reuse_funclib_helpers]] exists to prevent.

       Returns "" when the API is not covered. The converter's notes are discarded: they speak to a
       human pasting a prototype into the editor, and there is no human here. */
    /* THE STRUCT AN API TAKES, named by its own prototype - and the identification run the other
       way round (Nils, 2026-08-26).

       Matching a legacy Type to an SDK struct BY NAME is guesswork, because the name belongs to
       whoever wrote it: the same BROWSEINFO shape appears as vtBrowseInfo 72 times and
       tAKEBrowseInfo twice, and no prefix rule reaches the second. But the call site is not
       ambiguous. The catalogue already stores the SDK prototype, and the prototype says what it
       takes:

           shell32.dll | SHBrowseForFolderW | STDAPI_(PIDLIST_ABSOLUTE) SHBrowseForFolderW(_In_ LPBROWSEINFOW lpbi);

       So a Type handed to SHBrowseForFolder IS a BROWSEINFOW, whatever it is called locally. That
       is evidence rather than a guess, and it needs no new data - only reading the two catalogues
       against each other.

       LP/P is the pointer convention the SDK writes its parameters in (LPBROWSEINFOW is a pointer
       to BROWSEINFOW), so both are tried before the bare token. Returns the catalogue's own name
       for the struct, or "" when the prototype mentions none - most APIs take no struct at all. */
    /* BOTH ARMS OR ONE? - the question a converter has to answer before it rewrites an
       External_Function, and for all but four APIs the answer is one.

       DataFlex sizes Pointer, Handle and LongPtr per build, so a declaration typed with them is
       already correct on x86 and x64 from a single line; the x86-era bug is the TYPE (an Integer
       where a pointer belongs truncates the address on x64 and compiles clean), not a missing
       guard. Emitting #IFDEF around two identical arms would state a difference that is not there.

       Returns the packed row "dfname|dll|entry64|params64|entry32|params32" for the four whose
       exported ENTRY POINT changes with the bitness, or "" - which means "one declaration will
       do", the answer for everything else. Keyed on the DataFlex name because that is what a
       source line shows: the caller reading "GetWindowLongPtr" has not yet resolved an entry
       point, which is the very thing in question. */
    /* The corrected declaration line: the SDK's parameter TYPES on the LOCAL declaration's own
       name, entry point and dll.

       Three things are deliberately carried over from the local line rather than the SDK's:
         - the NAME, because every call site in the workspace uses it;
         - the ENTRY POINT, because moving an ...A wrapper to ...W changes what the code does with
           text buffers - a decision, not a typing fix, and GuardAnsiExternalFunctionWithWide's;
         - the DLL, for the reason the API lookup already gives - the same entry point in another
           library is another function.

       The SDK side contributes only what follows its dll placeholder: the parameter list and the
       Returns clause. Split on the PLACEHOLDER rather than by counting tokens, because a generated
       declaration always carries it (CS_CDeclDllPlaceholder) and token counting would drift the
       moment a type name gained a space.

       Returns "" if the SDK text is not shaped as expected, which the caller reads as "leave the
       block alone" - the same answer as every other refusal. */
    // The declaration's own name, exactly as written - token 1 of the line. Used for anything a
    // human reads, because the packed head is normalised for lookups and would name a line that
    // does not exist in the file.
    Function _ApiDeclLocalName String sDecl Returns String
        String[] asRaw
        Integer i iLast iNum

        Move (Replaces((Character(9)), sDecl, " ")) to sDecl
        Move (StrSplitToArray(Trim(sDecl), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Increment iNum
                If (iNum = 2) ;
                    Function_Return (Trim(asRaw[i]))
            End
        Loop
        Function_Return ""
    End_Function

    /* The corrected declaration: the LOCAL head and the LOCAL parameter names, with only the
       TYPES taken from the SDK side - and emitted one parameter per ";"-continued line, the
       install's own Pkg style.

       Three of Nils' findings from the first live conversion shaped this (2026-08-28):
       "Integer nShowCmd" had replaced "DWord iShowCmd" - the SDK's parameter NAME had overwritten
       the user's own spelling, which no reader asked for; the whole declaration was flattened to
       one line, harder to read and a compiler risk past the line limit; and the head rebuild is
       token-verbatim as before, so the local alias, entry and dll casing survive. */
    /* One TYPE agreeing with another, by MARSHALLING CLASS rather than by name.

       The strict name compare flagged WinServ's efShellExecute because it declared
       "DWord iShowCmd" where the SDK projection says "Integer nShowCmd" - same four bytes, same
       marshalling, nothing to do with 64-bit correctness - and the "fix" it offered was churn
       (Nils, 2026-08-28, the first live conversion). The mission is POINTER-WIDTH mistakes:
       an Integer where a pointer belongs truncates on x64; a DWord where an Integer belongs
       is a signedness opinion.

       The classes: pointer-sized (Pointer, Handle, Address, LongPtr, ULongPtr - all 8 bytes on
       x64, 4 on x86, and interchangeable at the call boundary), 4-byte integers (Integer,
       UInteger, DWord, Long), 2-byte (Short, UShort, Word), 1-byte (Char, UChar, Byte), 8-byte
       (BigInt, UBigInt), and the string marshals (String; WString) which stay DISTINCT from each
       other and from Pointer - String vs WString is the A/W decision, and Pointer vs String
       changes what a call site passes, neither of which is a typing fix. Anything unrecognised
       compares by name, the conservative direction.

       Declared ABOVE _ApiDeclWithSdkTypes, its first expression-form caller - a DataFlex
       function must sit at/above the expression that names it. */
    Function _ApiTypeClass String sType Returns String
        String sLc
        Move (Lowercase(Trim(sType))) to sLc
        If (sLc = "pointer" or sLc = "handle" or sLc = "address" or sLc = "longptr" or sLc = "ulongptr") ;
            Function_Return "ptr"
        If (sLc = "integer" or sLc = "uinteger" or sLc = "dword" or sLc = "long") ;
            Function_Return "int4"
        If (sLc = "short" or sLc = "ushort" or sLc = "word") ;
            Function_Return "int2"
        If (sLc = "char" or sLc = "uchar" or sLc = "byte") ;
            Function_Return "int1"
        If (sLc = "bigint" or sLc = "ubigint") ;
            Function_Return "int8"
        Function_Return sLc
    End_Function

    /* Does the SDK say this API returns NOTHING?

       Frank Cheng's projection spells that "Void_Type" as of upstream cec3389 (2026-08-30);
       before that it spelled it "Integer", and before THAT "Pointer". Three spellings for one
       fact, so the fact gets a function of its own rather than being inferred from whichever
       token is current - the next respelling upstream changes this one line and nothing else.

       VOID_TYPE is real DataFlex, not a foreign token to translate away: Winkern.pkg,
       MapiDllCalls.Pkg and cVdfInternetSession.pkg in the install all declare
       "External_Function ... Returns VOID_TYPE".

       Declared ABOVE its callers - a DataFlex function must sit at/above the expression that
       names it. */
    Function _IsVoidApiReturn String sType Returns Boolean
        Function_Return (Lowercase(Trim(sType)) = "void_type")
    End_Function

    // The declaration's tokens with tabs as spaces and blank tokens dropped - the split _ApiDeclWithSdkTypes and
    // _ExternalFnParamTypes both start from.
    Function _DeclTokens String sDecl Returns String[]
        String[] asRaw asTok
        Integer i iLast iNum

        Move (Replaces((Character(9)), sDecl, " ")) to sDecl
        Move (StrSplitToArray(Trim(sDecl), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTok[iNum]
                Increment iNum
            End
        Loop
        Function_Return asTok
    End_Function

    Function _ApiDeclWithSdkTypes String sIndent String sDecl String sSdk Returns String
        String[] asTok asSdkTypes asLocalNames asLocalTypes
        String sOut sSdkRet sLc sTypeTok sLocalRet sUse
        Integer i iLast iNum iIdx

        Get _ExternalFnParamTypes sSdk (&asSdkTypes) to sSdkRet
        If (Trim(sSdkRet) = "") ;
            Function_Return ""

        // tokenise the LOCAL declaration; positions 0-3 are the head, verbatim
        Get _DeclTokens sDecl to asTok
        Move (SizeOfArray(asTok)) to iNum
        If (iNum < 4) ;
            Function_Return ""

        // the local PARAMETER NAMES AND TYPES: after the head, tokens run type,name pairs
        // (ByRef/ByVal qualifiers skipped, as _ExternalFnParamTypes reads them) until Returns,
        // whose own type is captured too - the class compare below wants both sides.
        Move "" to sLocalRet
        Move 4 to iIdx
        While (iIdx < iNum)
            Move (Lowercase(asTok[iIdx])) to sLc
            If (sLc = "returns") Begin
                If ((iIdx + 1) < iNum) ;
                    Move asTok[iIdx + 1] to sLocalRet
                Move iNum to iIdx
            End
            Else Begin
                If (sLc = "byref" or sLc = "byval") ;
                    Increment iIdx
                Move "" to sTypeTok
                If (iIdx < iNum) ;
                    Move asTok[iIdx] to sTypeTok
                Increment iIdx                    // past the type
                If (iIdx < iNum) Begin
                    If (Lowercase(asTok[iIdx]) <> "returns") Begin
                        Move asTok[iIdx] to asLocalNames[SizeOfArray(asLocalNames)]
                        Move sTypeTok   to asLocalTypes[SizeOfArray(asLocalTypes)]
                    End
                    Increment iIdx                // past the name
                End
            End
        Loop
        If (SizeOfArray(asLocalNames) <> SizeOfArray(asSdkTypes)) ;
            Function_Return ""

        /* THE LOCAL SPELLING SURVIVES WHEREVER THE CLASSES AGREE (Nils 2026-08-28, on the first
           multi-line pair): the emitted arm differs from the user's declaration ONLY where
           wideness or pointer width demands it. "DWord iShowCmd" stays DWord beside the SDK's
           "Integer nShowCmd" - same four bytes, same marshalling - while "Integer pv" still
           becomes Pointer and String still becomes WString (distinct classes by design). The
           same rule covers the Returns, plus one rule of its own: A VOID SDK RETURN NEVER
           CHANGES THE USER'S RETURN (see _IsVoidApiReturn). That used to fall out of the
           spelling - the harvest stored void as Integer, which agrees with any int-classed
           local - until upstream cec3389 respelled it Void_Type (2026-08-30) and 1384 rows
           silently began rewriting "Returns Integer" to "Returns Void_Type", breaking every
           receiver that reads the result. The rule is now stated rather than inferred, so the
           next respelling upstream cannot reach it. */
        Move (sIndent + asTok[0] + " " + asTok[1] + " " + asTok[2] + " " + asTok[3]) to sOut
        Move (SizeOfArray(asSdkTypes) - 1) to iLast
        For i from 0 to iLast
            Move asSdkTypes[i] to sUse
            If (_ApiTypeClass(Self, asLocalTypes[i]) = _ApiTypeClass(Self, asSdkTypes[i])) ;
                Move asLocalTypes[i] to sUse
            Move (sOut + " ;" + (Character(13)) + (Character(10)) + sIndent + "    " ;
                + sUse + " " + asLocalNames[i]) to sOut
        Loop
        Move sSdkRet to sUse
        If (sLocalRet <> "") Begin
            If (_ApiTypeClass(Self, sLocalRet) = _ApiTypeClass(Self, sSdkRet)) ;
                Move sLocalRet to sUse
            If (_IsVoidApiReturn(Self, sSdkRet)) ;
                Move sLocalRet to sUse
        End
        Move (sOut + " ;" + (Character(13)) + (Character(10)) + sIndent + "    Returns " + sUse) to sOut
        Function_Return sOut
    End_Function

    /* Do the local declaration's types already say what the SDK says? Compared position by
       position, plus the return - a declaration that agrees needs no rewrite, and saying so is
       what makes a second run over a converted workspace a no-op rather than a churn.

       A differing COUNT answers False here, but the caller refuses on the count before it asks:
       positions no longer line up, so "they differ" would be true for an uninteresting reason. */
    Function _ApiDeclTypesAgree String[] asLocal String sLocalRet String[] asSdk String sSdkRet Returns Boolean
        Integer i iLast

        If (SizeOfArray(asLocal) <> SizeOfArray(asSdk)) ;
            Function_Return False
        /* A VOID SDK RETURN AGREES WITH WHATEVER THE LOCAL SAYS - the return is not the caller's
           to get wrong when there is no value to receive, and disagreeing here is what would send
           _ApiDeclWithSdkTypes off to rewrite it. Same rule, stated in both places it decides
           something (2026-08-30, upstream cec3389). */
        If (_IsVoidApiReturn(Self, sSdkRet) = False) Begin
            If (_ApiTypeClass(Self, sLocalRet) <> _ApiTypeClass(Self, sSdkRet)) ;
                Function_Return False
        End
        Move (SizeOfArray(asLocal) - 1) to iLast
        For i from 0 to iLast
            If (_ApiTypeClass(Self, asLocal[i]) <> _ApiTypeClass(Self, asSdk[i])) ;
                Function_Return False
        Loop
        Function_Return True
    End_Function

    /* ONE declaration judged, and either a corrected line or "" - which always means "leave the
       block exactly as it was". Every refusal below returns "", and the caller needs no other
       vocabulary for them.

       Takes the block's FIRST line (for its indentation) and the ";"-joined logical declaration,
       so the decision is made on the whole thing while the result keeps the file's own shape.

       WHEN IT REFUSES, and why each is a refusal rather than a best effort:
         - the API needs BOTH bitness arms - a guard, not a retyping, and a different converter's
           job. Noted, because a silent skip here would look like "nothing was wrong".
         - the catalogue does not cover it. Not noted: 687 of the 1,310 APIs seen in the wild are
           uncatalogued, and a note each would bury the ones that matter. The report's heuristics
           are what covers those, and a heuristic is not grounds to rewrite a binding.
         - the parameter COUNT disagrees with the SDK. Positions stop lining up, so a "correction"
           would be a guess about which parameter is which - and the count disagreeing is the more
           serious finding anyway. Noted with both numbers.
         - the types already agree, so a second run is a no-op rather than a churn. */
    /* Does any position (or the return) MIX a pointer-classed type with a string-marshal one?
       That mix is never a typing bug - it is a CALLING CONVENTION. A declaration that says
       Pointer where the SDK marshals text (vWin32fh's own A side: "Pointer lpOperation") is a
       library doing its own conversion, with AddressOf call sites feeding it raw buffers;
       "correcting" it to String would hand the marshaller an address to re-marshal, and the
       wide guard would be worse still (an AddressOf value rendered into a WString). Both
       pointer-sized, no x64 defect - hands off, said out loud (Nils 2026-08-28, the vWin32fhA.h
       aha moment). String vs WString stays correctable: both sides are runtime-marshalled text,
       so call sites are unaffected. */
    Function _ApiPtrVsMarshalMix String[] ByRef asLocalTypes String sLocalRet String[] ByRef asSdkTypes String sSdkRet Returns Boolean
        String sL sS
        Integer i iLast

        Move (SizeOfArray(asLocalTypes) - 1) to iLast
        For i from 0 to iLast
            Get _ApiTypeClass asLocalTypes[i] to sL
            Get _ApiTypeClass asSdkTypes[i]   to sS
            If ((sL = "ptr" and (sS = "string" or sS = "wstring")) or ;
                (sS = "ptr" and (sL = "string" or sL = "wstring"))) ;
                Function_Return True
        Loop
        Get _ApiTypeClass sLocalRet to sL
        Get _ApiTypeClass sSdkRet   to sS
        If ((sL = "ptr" and (sS = "string" or sS = "wstring")) or ;
            (sS = "ptr" and (sL = "string" or sL = "wstring"))) ;
            Function_Return True
        Function_Return False
    End_Function

    Function _CorrectedApiDecl String sFirstLine String sDecl String sHead String[] ByRef asCat String ByRef sNote Returns String
        String[] asLocalTypes asSdkTypes
        String sName sDll sEntry sSdk sIndent sLocalRet sSdkRet sRest sShown
        Integer iBar
        Boolean bAgree bMix

        Move "" to sNote

        Move (Pos("|", sHead)) to iBar
        If (iBar < 2) ;
            Function_Return ""
        Move (Left(sHead, (iBar - 1))) to sName
        Move (Right(sHead, (Length(sHead) - iBar))) to sRest
        Move (Pos("|", sRest)) to iBar
        If (iBar < 2) ;
            Function_Return ""
        Move (Left(sRest, (iBar - 1))) to sDll
        Move (Right(sRest, (Length(sRest) - iBar))) to sEntry
        // A NOTE MUST QUOTE THE USER'S OWN SPELLING. _ExternalFnHeadPacked uppercases the name for
        // its lookups, and a note reading "GETWINDOWLONGPTR" sends the reader hunting for a line
        // that does not exist. Take the display name from the declaration itself.
        Get _ApiDeclLocalName sDecl to sShown
        If (sShown = "") ;
            Move sName to sShown

        Get WinAPIBitnessSplit sName to sSdk
        If (sSdk <> "") Begin
            Move (sShown + " - the entry point differs by bitness, so it needs BOTH arms guarded; " ;
                + "left for the guard converter") to sNote
            Function_Return ""
        End

        Get _WinAPIDataFlexDeclFromCat (&asCat) sDll sEntry to sSdk
        If (sSdk = "") ;
            Function_Return ""

        Get _ExternalFnParamTypes sDecl (&asLocalTypes) to sLocalRet
        Get _ExternalFnParamTypes sSdk  (&asSdkTypes)   to sSdkRet
        If (SizeOfArray(asLocalTypes) <> SizeOfArray(asSdkTypes)) Begin
            Move (sShown + " - declares " + String(SizeOfArray(asLocalTypes)) + " parameter(s) where the SDK says " ;
                + String(SizeOfArray(asSdkTypes)) + "; refused, the positions do not line up") to sNote
            Function_Return ""
        End
        Get _ApiDeclTypesAgree asLocalTypes sLocalRet asSdkTypes sSdkRet to bAgree
        If (bAgree = True) ;
            Function_Return ""
        // Pointer-vs-marshal is a calling convention, never a typing fix (see _ApiPtrVsMarshalMix):
        // refuse the WHOLE declaration - a half-conversion of a manual-conversion binding is worse
        // than either whole state - and say why.
        Get _ApiPtrVsMarshalMix (&asLocalTypes) sLocalRet (&asSdkTypes) sSdkRet to bMix
        If (bMix = True) Begin
            Move (sShown + " - declares Pointer where the SDK marshals text (or the reverse); that " ;
                + "is a manual-conversion calling convention (AddressOf call sites), not a typing " ;
                + "bug, and both are pointer-sized on x64. Left alone.") to sNote
            Function_Return ""
        End

        Move (Left(sFirstLine, (Length(sFirstLine) - Length(LTrim(sFirstLine))))) to sIndent
        Function_Return (_ApiDeclWithSdkTypes(Self, sIndent, sDecl, sSdk))
    End_Function

    /* Every External_Function in one file, retyped where the SDK says the declaration is wrong.

       THE BLOCK IS COLLECTED BEFORE IT IS JUDGED, which is the whole shape of this loop. A
       declaration can span ";"-continued lines, so the decision needs the joined text while an
       unchanged block has to go back byte for byte - keeping only the first line would delete the
       parameters of everything it declined to touch, which is the way this goes wrong.

       A corrected declaration collapses to ONE line. That is a real change to the file's shape and
       it is deliberate: the retyped parameter list is what the reader needs to see next to the
       entry point, and re-flowing it across the original line breaks would mean guessing where
       they belonged. */
    // Append a CRLF-joined text as individual lines - the guarded-pair emission's splitter.
    Function _AppendLines String[] ByRef asOut String sText Returns Integer
        String[] asLines
        Integer i iLast
        Move (Replaces((Character(13)), sText, "")) to sText
        Move (StrSplitToArray(sText, (Character(10)))) to asLines
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move asLines[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return (iLast + 1)
    End_Function

    /* True when iLine (0-based) sits inside an #IFDEF IS$WIN64 ... #ENDIF region - either arm.
       A declaration there is already bitness-managed, by us or by hand, and must be left alone:
       the guarded-pair emission keeps the ORIGINAL in the #ELSE arm, so without this check every
       re-run would find that arm "wrong" and wrap the wrap (2026-08-28). Nesting-tolerant: an
       inner plain #IFDEF inside the region keeps the region alive until its own #ENDIF. */
    Function _InsideWin64Guard String[] ByRef asCode Integer iLine Returns Boolean
        String sT
        Integer i iDepth iWin
        Move 0 to iDepth
        Move 0 to iWin
        For i from 0 to (iLine - 1)
            Move (Lowercase(Trim(Replaces((Character(9)), asCode[i], " ")))) to sT
            If (Left(sT, 6) = (Character(35) + "ifdef")) Begin
                Increment iDepth
                If (iWin = 0 and Pos("is$win64", sT) > 0) ;
                    Move iDepth to iWin
            End
            Else If (Left(sT, 6) = (Character(35) + "endif")) Begin
                If (iWin = iDepth) ;
                    Move 0 to iWin
                If (iDepth > 0) ;
                    Move (iDepth - 1) to iDepth
            End
        Loop
        Function_Return (iWin > 0)
    End_Function

    /* Inside ANY conditional-compilation VARIANT arm? True when iLine sits in an arm the author
       chose between: a #IF / #IFDEF construct (either arm), or the #ELSE arm of a #IFNDEF. The
       #IFNDEF main arm answers False - "#IFNDEF get_X" is the declare-once guard idiom, a wrapper
       around one declaration rather than a choice between variants, and a declaration there is as
       convertible as an unguarded one.

       Born 2026-08-29 on a real 19.1 workspace whose cFilesystem.pkg gates WHOLE BATCHES:
       #IF (!@ < 200) ANSI batch #ELSE wide batch #ENDIF. The wide guard planted its
       per-declaration pairs INSIDE the ANSI-only arm - structurally legal, semantically
       unreachable (inside !@ < 200 the inner !@ < 260 is always true) - and the retyper read
       parameter lists across the arms. A declaration inside a variant arm is AUTHOR-MANAGED:
       both converters and both Deep Scan declaration rules leave it as written. Subsumes the
       IS$WIN64 case (an #IFDEF like any other). */
    /* The same walk, also reporting whether one of the enclosing gates is OURS - a gate carrying
       the [DFRefactor] banner, i.e. a pair this tool emitted (state 2).

       WHY THAT NEEDED SPLITTING OUT (Nils 2026-08-31). State 2 means "enterable", deliberately:
       the retyping converter must keep working inside an emitted pair's ANSI arm, and the
       composed both-apply matrix depends on it. But for DS 9221 - the rule that OFFERS the
       pairing - an emitted pair is finished work, and treating it as enterable meant the rule
       re-raised its own output on every scan: a row with a Run button that could only refuse,
       for ever, on exactly the declarations where the tool had already succeeded. The existing
       fixture missed it by omitting the banner the converter actually writes.
       So the two questions are now asked separately: "is this someone's variant arm?" (state 1,
       hands off for everyone) and "is this inside something we already emitted?" (state 2, which
       only the offering rule cares about). */
    Function _InsideConditionalArmEx String[] ByRef asCode Integer iLine Boolean ByRef bOwnEmitted Returns Boolean
        String sT sPrev
        Integer[] aiVariant
        Integer i iTop iBack

        For i from 0 to (iLine - 1)
            Move (Lowercase(Trim(Replaces((Character(9)), asCode[i], " ")))) to sT
            If (Left(sT, 1) = (Character(35))) Begin
                Move (SizeOfArray(aiVariant) - 1) to iTop
                If (Left(sT, 7) = (Character(35) + "ifndef")) ;
                    Move 0 to aiVariant[(iTop + 1)]
                Else If (Left(sT, 3) = (Character(35) + "if")) Begin
                    /* OUR OWN gates stay ENTERABLE (state 2): the wide guard banners every pair
                       it emits, and the composed both-apply matrix depends on the retyper still
                       working inside that pair's A arm (the reverse-order fixture pins it). A
                       gate without the banner is the AUTHOR's - hands off, state 1. */
                    // The banner is a comment BLOCK; the marker sits on its first line, so the
                    // whole run of comment lines above the gate is scanned, not just the nearest.
                    Move "" to sPrev
                    Move (i - 1) to iBack
                    While (iBack >= 0 and (not(sPrev contains "[dfrefactor]")) and (Trim(asCode[iBack]) = "" or Left(Trim(asCode[iBack]), 2) = "//"))
                        If (Lowercase(Trim(asCode[iBack])) contains "[dfrefactor]") ;
                            Move (Lowercase(Trim(asCode[iBack]))) to sPrev
                        Decrement iBack
                    Loop
                    If (sPrev contains "[dfrefactor]") ;
                        Move 2 to aiVariant[(iTop + 1)]
                    Else ;
                        Move 1 to aiVariant[(iTop + 1)]
                End
                Else If (Left(sT, 5) = (Character(35) + "else")) Begin
                    If (iTop >= 0) Begin
                        If (aiVariant[iTop] = 0) ;
                            Move 1 to aiVariant[iTop]
                    End
                End
                Else If (Left(sT, 6) = (Character(35) + "endif")) Begin
                    If (iTop >= 0) ;
                        Move (ResizeArray(aiVariant, iTop)) to aiVariant
                End
            End
        Loop
        Move False to bOwnEmitted
        Move (SizeOfArray(aiVariant) - 1) to iTop
        For i from 0 to iTop
            If (aiVariant[i] = 2) ;
                Move True to bOwnEmitted
        Loop
        For i from 0 to iTop
            If (aiVariant[i] = 1) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* The plain question - "is this inside somebody's variant arm?" - which is what every caller
       but DS 9221 wants. Defined AFTER the Ex core: a function-style call is resolved at compile
       time, so the callee has to come first. */
    Function _InsideConditionalArm String[] ByRef asCode Integer iLine Returns Boolean
        Boolean bOwn
        Function_Return (_InsideConditionalArmEx(Self, &asCode, iLine, &bOwn))
    End_Function

    /* The line with its trailing comment removed, raw otherwise - string literals intact.
       The declaration JOINERS need exactly this: a mid-declaration line like
       "String sFileName ;   // comment" ends with the COMMENT, so a joiner testing
       Right(sDecl, 1) = ";" stopped there, and the comment words it had already absorbed were
       counted as parameters ("fsDeleteFile declares 8 parameter(s)" - eight words of prose,
       2026-08-29). _CodeOnlyLine is NOT usable here: it masks string literals, and an
       External_Function's entry point is one. */
    Function _LineWithoutEndComment String sLine Returns String
        tTokenizer TD
        String sCode

        Get Tokenizer sLine to TD
        Move sLine to sCode
        If (TD.sEndComment <> "") ;
            Move (Replace(TD.sEndComment, sCode, "")) to sCode
        Function_Return sCode
    End_Function

    /* Same-file call sites of an API whose corrected RETURN became pointer-sized, as one note -
       or "" when the change needs no follow-up (same class, or not a widening to ptr). A
       receiver written for an Integer return - "Move (KeyboardEvent(...)) to iVoid" - stops
       compiling when the declaration starts returning a Handle, and that error is the POINT
       (the receiver was truncating a pointer on x64); this note says WHERE FIRST, before the
       compile does. The compile stays the authority - it also names the cross-file sites this
       same-file scan cannot see. Located on the mask, so a mention in a comment or a string
       is never reported; a hit must be a CALL (the next mark after the name is "("), and a
       declaration line is not a call site. */
    Function _CallSiteNoteForReturnChange String[] ByRef asCode String sName String sOldRet String sNewRet Returns String
        String sLineList sMasked sRest
        Integer i iLast iPos iFound

        If (Trim(sName) = "" or Trim(sOldRet) = "") ;
            Function_Return ""
        If (_ApiTypeClass(Self, sOldRet) = _ApiTypeClass(Self, sNewRet)) ;
            Function_Return ""
        If (_ApiTypeClass(Self, sNewRet) <> "ptr") ;
            Function_Return ""
        Move "" to sLineList
        Move 0 to iFound
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _MaskStatementLine asCode[i] to sMasked
            If (not(Lowercase(sMasked) contains "external_function")) Begin
                Get _FindKeywordPos sMasked sName True 1 to iPos
                If (iPos > 0) Begin
                    Move (Trim(Mid(sMasked, (Length(sMasked)), (iPos + Length(sName))))) to sRest
                    If (Left(sRest, 1) = "(") Begin
                        Increment iFound
                        If (iFound <= 8) Begin
                            If (sLineList <> "") ;
                                Move (sLineList + ", ") to sLineList
                            Move (sLineList + String(i + 1)) to sLineList
                        End
                    End
                End
            End
        Loop
        If (iFound = 0) ;
            Function_Return ""
        If (iFound > 8) ;
            Move (sLineList + " and " + String(iFound - 8) + " more") to sLineList
        Function_Return ("The corrected return of " + sName + " is now " + Trim(sNewRet) ;
            + " (pointer-sized; was " + Trim(sOldRet) + "). Receivers of its result may need the " ;
            + "same change - check the call site(s) at line " + sLineList ;
            + ". The next compile also names any site in other files.")
    End_Function

    Function _ConvertApiDeclTypesInLines String[] ByRef asCode String[] ByRef asNotes Returns Integer
        String[] asOut asBlock asCat asTmpTypes asNameTok
        String sLine sDecl sHead sNewLine sNote sFlatNew sOldRet sNewRet sCallNote sRawName sCont
        Integer i iLast j jLast iCount iBar iVarSkipped
        Boolean bGuarded

        Move (SizeOfArray(asCode) - 1) to iLast
        Move 0 to iCount
        Move 0 to i
        While (i <= iLast)
            Move asCode[i] to sLine
            Get _ExternalFnHeadPacked sLine to sHead
            If (sHead = "") Begin
                Move sLine to asOut[SizeOfArray(asOut)]
            End
            Else Begin
                Move (ResizeArray(asBlock, 0)) to asBlock
                Move sLine to asBlock[0]
                /* Each line joins COMMENT-STRIPPED (string literals intact). With the comment
                   left on, "String sFileName ;  // prose" does not end with ";" - the join
                   stopped there AND the absorbed prose words were later counted as parameters
                   (fsDeleteFile "declares 8 parameter(s)", 2026-08-29). */
                Get _LineWithoutEndComment sLine to sDecl
                Move (Trim(sDecl)) to sDecl
                While (Right(sDecl, 1) = ";" and i < iLast)
                    Move (Trim(Left(sDecl, (Length(sDecl) - 1)))) to sDecl
                    Increment i
                    Move asCode[i] to asBlock[SizeOfArray(asBlock)]
                    Get _LineWithoutEndComment asCode[i] to sCont
                    Move (sDecl + " " + Trim(sCont)) to sDecl
                Loop
                Move "" to sNote
                // The catalogue rides in ByRef, fetched ONCE per file below - at 1,294 rows a
                // property Get per declaration was an array copy per declaration (the WinServ
                // scan, 2026-08-28), the same lesson _SweepRules already carries for its rules.
                If (SizeOfArray(asCat) = 0) Begin
                    Send RefreshWinAPICatalogsFromJson
                    Get pasWinAPICatalog to asCat
                End
                // Inside ANY conditional variant arm - an IS$WIN64 region, a version gate like
                // cFilesystem's #IF (!@ < 200) batches, or any other #IF/#IFDEF choice - means the
                // declaration is author-managed: hands off, counted, and said so below.
                Move (i - (SizeOfArray(asBlock) - 1)) to jLast
                Get _InsideConditionalArm (&asCode) jLast to bGuarded
                Move "" to sNewLine
                If (bGuarded = True) ;
                    Increment iVarSkipped
                Else ;
                    Get _CorrectedApiDecl sLine sDecl sHead (&asCat) (&sNote) to sNewLine
                If (sNote <> "") ;
                    Move sNote to asNotes[SizeOfArray(asNotes)]
                If (sNewLine <> "") Begin
                    /* THE GUARDED PAIR (Nils, 2026-08-28): the corrected declaration serves the
                       x64 build; the ORIGINAL block rides the #ELSE arm verbatim, so a
                       still-shipping x86 build compiles byte-identical source and the change is
                       reversible by eye. The cost - two arms that could drift - is accepted for
                       API bindings, where "the 32-bit build cannot have changed" is worth more
                       than a single declaration. */
                    Move (Character(35) + "IFDEF IS$WIN64") to asOut[SizeOfArray(asOut)]
                    Get _AppendLines (&asOut) sNewLine to jLast
                    Move (Character(35) + "ELSE") to asOut[SizeOfArray(asOut)]
                    Move (SizeOfArray(asBlock) - 1) to jLast
                    For j from 0 to jLast
                        Move asBlock[j] to asOut[SizeOfArray(asOut)]
                    Loop
                    Move (Character(35) + "ENDIF") to asOut[SizeOfArray(asOut)]
                    Increment iCount
                    // The call-site courtesy when the RETURN widened to pointer-size (see
                    // _CallSiteNoteForReturnChange): old return from the flat original, new from
                    // the emitted arm (flattened - the parser reads one logical declaration).
                    // The NAME comes from the raw declaration, not the packed head - the head
                    // normalises case for matching, and the note must read like the user's code.
                    Get _ExternalFnParamTypes sDecl (&asTmpTypes) to sOldRet
                    Move (Replaces((Character(13)), sNewLine, " ")) to sFlatNew
                    Move (Replaces((Character(10)), sFlatNew, " ")) to sFlatNew
                    Move (Replaces(";", sFlatNew, " ")) to sFlatNew
                    Get _ExternalFnParamTypes sFlatNew (&asTmpTypes) to sNewRet
                    Move (StrSplitToArray(Trim(Replaces((Character(9)), sDecl, " ")), CS_S)) to asNameTok
                    Move "" to sRawName
                    Move 0 to iBar
                    For j from 0 to (SizeOfArray(asNameTok) - 1)
                        If (Trim(asNameTok[j]) <> "") Begin
                            Increment iBar
                            If (iBar = 2) ;
                                Move (Trim(asNameTok[j])) to sRawName
                        End
                    Loop
                    If (sRawName <> "") Begin
                        Get _CallSiteNoteForReturnChange (&asCode) sRawName sOldRet sNewRet to sCallNote
                        If (sCallNote <> "") ;
                            Move sCallNote to asNotes[SizeOfArray(asNotes)]
                    End
                End
                Else Begin
                    Move (SizeOfArray(asBlock) - 1) to jLast
                    For j from 0 to jLast
                        Move asBlock[j] to asOut[SizeOfArray(asOut)]
                    Loop
                End
            End
            Increment i
        Loop
        If (iVarSkipped > 0) ;
            Move (String(iVarSkipped) + " declaration(s) inside author-managed conditional arms (a version or feature gate chooses between variants) - left as written") to asNotes[SizeOfArray(asNotes)]
        Move asOut to asCode
        Function_Return iCount
    End_Function

    /* Is this the DUPLICATE-EXTERNAL flavour of 4390 - both sides binding the same Windows API, so
       the fix is guard-or-delete the duplicate rather than a rename?

       THE RULE USED TO REQUIRE THAT EVERY DECLARATION OF YOURS BE AN External_Function, and that is
       wrong in the one place it matters most: a wrapper CLASS around a Windows API. Prnt_dlg.pkg
       declares PageSetupDlg twice - the External_Function that binds PageSetupDlgA, and a method of
       Class PageSetupDialog that calls it. The method flipped the flag off, the guard was skipped,
       and the rename lane renamed the METHOD - leaving the actual duplicate in place and clearing
       nothing (Nils, 2026-08-26, LegacyApp4).

       So: DataFlex's side must be all External_Function - that is what says the name binds an API -
       and ONE of yours must be, which is the declaration a guard would wrap. What else shares the
       name is beside the point, because GuardDuplicateExternalFunctions only ever touches
       External_Function lines; it cannot reach the method whether or not it is there. */
    Function _IsDuplicateExternalPair tNameDecl[] aOwn tNameDecl[] aDf Returns Boolean
        Integer k iLast
        Boolean bAnyOwnExternal

        If (SizeOfArray(aOwn) = 0 or SizeOfArray(aDf) = 0) ;
            Function_Return False
        Move (SizeOfArray(aDf) - 1) to iLast
        For k from 0 to iLast
            If (Lowercase(aDf[k].sKind) <> "external_function") ;
                Function_Return False
        Loop
        Move False to bAnyOwnExternal
        Move (SizeOfArray(aOwn) - 1) to iLast
        For k from 0 to iLast
            If (Lowercase(aOwn[k].sKind) = "external_function") ;
                Move True to bAnyOwnExternal
        Loop
        Function_Return bAnyOwnExternal
    End_Function

    /* The line where this file Uses the RETIRED FlexCOM helper, or 0.

       WHY IT HALTS A RUN (Nils, 2026-08-27, LegacyApp4's rcmail.pkg, generated 2007):
       a FlexCOM-era COM proxy is written against a helper DataFlex 26 no longer ships at all -
       there is no FlexCOM.pkg in the install, only FlexCOM20. Nothing a refactoring function
       changes can make that code compile, and a run over the rest of the workspace only buries
       the real work: the proxy must be REGENERATED with the Studio's COM import, and swapping the
       Use to FlexCOM20.pkg cannot work because every generated method body speaks the old
       helper's dialect (is a cComAutomation, IsComponentConnected...).

       THE MATCH IS DELIBERATELY NARROW, because a false positive here blocks a whole workspace:
       the line's CODE must start with "use" - a comment or a string literal mentioning
       FlexCOM.pkg is not a dependency - and the token is "flexcom." with the dot, so
       FlexCOM20.pkg never matches. Case-insensitive, tab-tolerant, and cheap: two string ops per
       line, which is what lets the engine afford it as a pre-run pass over every selected file. */
    Function LineUsingRetiredFlexCom String[] ByRef asCode Returns Integer
        String sLine
        Integer i iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(Replaces(Character(9), asCode[i], " ")))) to sLine
            If (Left(sLine, 4) = "use ") Begin
                If (Pos("flexcom.", sLine) > 0) ;
                    Function_Return (i + 1)
            End
        Loop
        Function_Return 0
    End_Function

    Function WinAPIBitnessSplit String sDfName Returns String
        String[] asSplit
        String sKey sRow sPre
        Integer i iLast

        Move (Lowercase(Trim(sDfName))) to sKey
        If (sKey = "") ;
            Function_Return ""
        Send RefreshWinAPICatalogsFromJson   // once; no-op thereafter
        Get pasWinAPIBitnessSplit to asSplit
        Move (SizeOfArray(asSplit) - 1) to iLast
        Move (sKey + "|") to sPre
        For i from 0 to iLast
            Move asSplit[i] to sRow
            If (Left(sRow, Length(sPre)) = sPre) ;
                Function_Return sRow
        Loop
        Function_Return ""
    End_Function

    Function WinAPIStructForApi String sDll String sEntry Returns String
        String sProto sTok sCand sCh
        Integer i iLen
        Boolean bIsIdent

        Get WinAPIPrototype sDll sEntry to sProto
        If (sProto = "") ;
            Function_Return ""
        Move (Length(sProto)) to iLen
        Move "" to sTok
        For i from 1 to (iLen + 1)
            Move "" to sCh
            If (i <= iLen) ;
                Move (Mid(sProto, 1, i)) to sCh
            Get _IsIdentifierChar sCh to bIsIdent
            If (bIsIdent = True) Begin
                Move (sTok + sCh) to sTok
            End
            Else Begin
                If (sTok <> "") Begin
                    // The bare token, then with the SDK's pointer prefixes removed.
                    Get _WinAPIStructNameIfKnown sTok to sCand
                    If (sCand = "" and Length(sTok) > 2 and Uppercase(Left(sTok, 2)) = "LP") ;
                        Get _WinAPIStructNameIfKnown (Right(sTok, (Length(sTok) - 2))) to sCand
                    If (sCand = "" and Length(sTok) > 1 and Uppercase(Left(sTok, 1)) = "P") ;
                        Get _WinAPIStructNameIfKnown (Right(sTok, (Length(sTok) - 1))) to sCand
                    If (sCand <> "") ;
                        Function_Return sCand
                End
                Move "" to sTok
            End
        Loop
        Function_Return ""
    End_Function

    /* The catalogue's OWN name for a struct, or "" - the name half of WinAPIStructBody, which
       answers with the body and so cannot say what it matched. Kept beside it so the two stay in
       step: same rows, same ANSI/wide tolerance. */
    Function _WinAPIStructNameIfKnown String sName Returns String
        String[] asCat
        String sKey sRow sRowName
        Integer i iLast iBar

        Move (Uppercase(Trim(sName))) to sKey
        If (sKey = "") ;
            Function_Return ""
        Send RefreshWinAPICatalogsFromJson   // once; no-op thereafter
        Send RefreshWinAPICatalogsFromJson   // once; no-op thereafter
        Get pasWinAPIStructCatalog to asCat
        Move (SizeOfArray(asCat) - 1) to iLast
        For i from 0 to iLast
            Move asCat[i] to sRow
            Move (Pos("|", sRow)) to iBar
            If (iBar > 1) Begin
                Move (Left(sRow, (iBar - 1))) to sRowName
                If (sRowName = sKey or sRowName = (sKey + "A") or sRowName = (sKey + "W")) ;
                    Function_Return sRowName
            End
        Loop
        Function_Return ""
    End_Function

    Function _WinAPIDataFlexDeclFromCat String[] ByRef asCat String sDll String sEntry Returns String
        String[] asNotes
        String sProto sOut
        Integer iCut

        Get _WinAPIPrototypeFromCat (&asCat) sDll sEntry to sProto
        If (sProto = "") ;
            Function_Return ""
        /* TWO ROW FLAVOURS. A row whose payload starts "DF|" carries a READY-MADE DataFlex
           declaration - harvested from the Win32_DataFlex_Projection (Frank Cheng, MIT; generated
           from Microsoft's win32metadata), so there is no C to parse and none of the C-parse gaps
           to fall into: the eight STDAPI_(...) prototypes this converter returns "" for are the
           standing example. The declaration is stored flattened, with one optional trailing
           "// refs: ..." comment naming the structs it takes - that tail is for
           WinAPIStructForApi's scan and is CUT here, because _ExternalFnParamTypes tokenises by
           whitespace and would read comment words as parameter types.

           A legacy row (no marker) still carries the SDK's C prototype and takes the conversion
           path below, unchanged - the two flavours coexist row by row, and an OLD build reading a
           DF row simply fails its C-parse and refuses, which is the safe direction. */
        If (Left(sProto, 3) = "DF|") Begin
            Move (Right(sProto, (Length(sProto) - 3))) to sOut
            Move (Pos("//", sOut)) to iCut
            If (iCut > 0) ;
                Move (Left(sOut, (iCut - 1))) to sOut
            Function_Return (Trim(sOut))
        End
        Get CDeclarationToDataFlex sProto (&asNotes) to sOut
        // FLATTENED to one logical declaration. The converter emits DataFlex's own Pkg style - one
        // parameter per ";"-continued line - and every reader here wants the declaration, not its
        // layout. Flattening at the source rather than at each call site is what stops a caller
        // "passing" a check that in fact ran against embedded newlines.
        Move (Replaces((Character(13)), sOut, " ")) to sOut
        Move (Replaces((Character(10)), sOut, " ")) to sOut
        Move (Replaces(";", sOut, " ")) to sOut
        Function_Return (Trim(sOut))
    End_Function

    // The occasional-caller wrapper; hot paths hold the catalogue and use the ByRef core.
    Function WinAPIDataFlexDecl String sDll String sEntry Returns String
        String[] asCat

        Send RefreshWinAPICatalogsFromJson
        Get pasWinAPICatalog to asCat
        Function_Return (_WinAPIDataFlexDeclFromCat(Self, &asCat, sDll, sEntry))
    End_Function

    /* Voice the catalogue's state into sFnName's run notes: the recorded load problems, and the
       one state a load problem cannot describe - 0 rows with NOTHING recorded. That state existed
       (2026-08-28): the keyword re-seed wiped the loaded rows while the one-shot latch stayed
       armed, so a whole plan run answered "0 lines" from an empty catalogue with a clean load
       record. The seeds now drop the latch, but if the state ever returns it must say so: every
       converter whose "nothing done" can MEAN "the catalogue answered empty" calls this first. */
    Procedure _NoteWinAPICatalogueState String sFnName
        String[] asProblems asCat
        Integer i iLast

        Send RefreshWinAPICatalogsFromJson
        Get pasWinAPILoadProblems to asProblems
        Move (SizeOfArray(asProblems) - 1) to iLast
        For i from 0 to iLast
            Send AddRunNote sFnName asProblems[i]
        Loop
        Get pasWinAPICatalog to asCat
        If (SizeOfArray(asCat) = 0) ;
            Send AddRunNote sFnName ("The Windows API catalogue holds 0 rows in this session, so every lookup answers empty. Data\WinAPICatalog.json is missing or unreadable, or the in-memory catalogue was reset without a reload.")
    End_Procedure

    /* The ordered PARAMETER TYPES of one logical External_Function declaration, with the Returns
       type as the function's result. Tokenised exactly as _AuditApiDeclaration does - plain
       whitespace split of the raw text - so the two agree about where a type sits; ByRef / ByVal is
       a qualifier, not a type, and the parameter NAME after each type is skipped. */
    Function _ExternalFnParamTypes String sDecl String[] ByRef asTypes Returns String
        String[] asTok
        String sRet sTok sLC
        Integer iNum iIdx

        Move (ResizeArray(asTypes, 0)) to asTypes
        Move "" to sRet
        Get _DeclTokens sDecl to asTok
        Move (SizeOfArray(asTok)) to iNum
        If (iNum < 4) ;
            Function_Return ""
        Move 4 to iIdx
        While (iIdx < iNum)
            Move asTok[iIdx] to sTok
            Move (Lowercase(sTok)) to sLC
            If (sLC = "returns") Begin
                Increment iIdx
                If (iIdx < iNum) ;
                    Move asTok[iIdx] to sRet
                Move iNum to iIdx
            End
            Else Begin
                If (sLC = "byref" or sLC = "byval") Begin
                    Increment iIdx
                    If (iIdx < iNum) ;
                        Move asTok[iIdx] to sTok
                End
                If (iIdx < iNum) Begin
                    Move sTok to asTypes[SizeOfArray(asTypes)]
                    Move (iIdx + 2) to iIdx        // ...past the parameter NAME
                End
            End
        Loop
        Function_Return sRet
    End_Function

    /* A declaration judged against the Windows SDK instead of against its own parameter names.

       Returns -1 when the catalogue does not cover the API - the signal to fall back to
       _AuditApiDeclaration's name heuristics, which are all there is for the other 687. Otherwise
       the count of disagreements, each naming the position, what is declared, and what the SDK
       says. That is a FACT where the heuristic could only guess: _SuggestPointerType reads "hObject"
       and infers a handle, but it cannot know that CloseHandle's one parameter is a HANDLE, and it
       says nothing at all about a parameter called "cb".

       A differing parameter COUNT stops the comparison. Positions no longer line up, so every
       "mismatch" after the first would be noise - and a count that disagrees with the SDK is the
       more serious finding anyway. Refuse, and say why.

       External_Procedure is never covered: _ExternalFnHeadPacked answers only for functions, so
       those fall through to the heuristics untouched. */
    Function _WinAPICatalogueFindings String sDecl String[] ByRef asFindings Returns Integer
        String[] asOwnTypes asSdkTypes
        String sPacked sRest sDll sEntry sSdk sOwnRet sSdkRet
        Integer iBar iCount i iLast

        Move (ResizeArray(asFindings, 0)) to asFindings
        Get _ExternalFnHeadPacked sDecl to sPacked
        If (sPacked = "") ;
            Function_Return -1
        Move (Pos("|", sPacked)) to iBar
        Move (Right(sPacked, (Length(sPacked) - iBar))) to sRest
        Move (Pos("|", sRest)) to iBar
        Move (Left(sRest, (iBar - 1))) to sDll
        Move (Right(sRest, (Length(sRest) - iBar))) to sEntry
        Get WinAPIDataFlexDecl sDll sEntry to sSdk
        If (sSdk = "") ;
            Function_Return -1
        Get _ExternalFnParamTypes sDecl (&asOwnTypes) to sOwnRet
        Get _ExternalFnParamTypes sSdk  (&asSdkTypes) to sSdkRet
        Move 0 to iCount
        If (SizeOfArray(asOwnTypes) <> SizeOfArray(asSdkTypes)) Begin
            Move ("declares " + String(SizeOfArray(asOwnTypes)) + " parameters, the Windows SDK has " + String(SizeOfArray(asSdkTypes)) + " - types not compared") to asFindings[0]
            Function_Return 1
        End
        Move (SizeOfArray(asOwnTypes) - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(asOwnTypes[i]) <> Lowercase(asSdkTypes[i])) Begin
                Move ("parameter " + String(i + 1) + ": " + asOwnTypes[i] + " -> " + asSdkTypes[i] + " (Windows SDK)") to asFindings[SizeOfArray(asFindings)]
                Increment iCount
            End
        Loop
        If (sOwnRet <> "" and sSdkRet <> "") Begin
            If (Lowercase(sOwnRet) <> Lowercase(sSdkRet)) Begin
                Move ("Returns " + sOwnRet + " -> " + sSdkRet + " (Windows SDK)") to asFindings[SizeOfArray(asFindings)]
                Increment iCount
            End
        End
        Function_Return iCount
    End_Function

    // "dll|entry" for a declaration NAME in a packed binding set, or "" when it is not there. Linear

    // "dll|entry" for a declaration NAME in a packed binding set, or "" when it is not there. Linear
    // by design: the install declares ~330 of these and the scan only runs for a line whose name has
    // ALREADY matched, so this is a few hundred string compares per guarded declaration, not per line.
    Function _InstallBindingFor String sName String[] asBindings Returns String
        String sKey
        Integer i iLast iKeyLen
        Move (Uppercase(Trim(sName)) + "|") to sKey
        Move (Length(sKey)) to iKeyLen
        Move (SizeOfArray(asBindings) - 1) to iLast
        For i from 0 to iLast
            If (Left(asBindings[i], iKeyLen) = sKey) ;
                Function_Return (Right(asBindings[i], (Length(asBindings[i]) - iKeyLen)))
        Loop
        Function_Return ""
    End_Function

    /* The class names declared in one file's lines - the second word of every "Class <Name> is a ..."
       line (first-token test, as _IsClassDeclaration: the word inside a trailing comment never
       counts). A "Class" inside a block comment is the one shape this does not see, and an install
       package does not carry one. PURE -> unit-testable. */
    Function _ClassNamesFromLines String[] asCode Returns String[]
        String[] asOut
        String sLC sName
        Integer i iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(Replaces(Character(9), asCode[i], " ")))) to sLC
            // Length first: "class" = "class " is TRUE in DataFlex (trailing blanks ignored).
            If (Length(sLC) > 6 and Left(sLC, 6) = "class ") Begin
                Get _NthWord (Replaces(Character(9), asCode[i], " ")) 2 to sName
                Move (Trim(sName)) to sName
                If (sName <> "" and SearchArray(sName, asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                    Move sName to asOut[SizeOfArray(asOut)]
            End
        Loop
        Function_Return asOut
    End_Function

    /* Every CLASS name the target install's Pkg source declares - UPPERCASED and SORTED for
       BinarySearchArray, the declaring package packed "NAME|leaf.pkg" beside it (lookup
       InstallClassPkgFor). Session-cached like RunInstallExternalFnNames; a missing Pkg folder
       caches EMPTY. Built for the 4345 duplicate-name row (2026-09-03): "Class cRegEx is a
       cObject" fails because DataFlex 26 has a cRegEx - and a name the RUNTIME owns is in no Pkg
       file, so it reads back absent here and the caller words that case as DataFlex itself. */
    Function RunInstallClassNames Returns String[]
        String[] asOut asCode asNames asPkgAll
        tRFSearchResult[] aFiles
        String sPkg sMask sLeaf
        Integer i iLast j jLast iSlash

        If (pbInstallClassNamesLoaded(Self) = True) ;
            Function_Return (pasInstallClassNames(Self))
        Set pbInstallClassNamesLoaded to True
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) Begin
            Set pasInstallClassNames to asOut
            Set pasInstallClassPkgs  to asPkgAll
            Function_Return asOut
        End
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        For i from 0 to iLast
            Move (rfReadEncodedFileAsStringArray(aFiles[i].sFilename)) to asCode
            Move aFiles[i].sFilename to sLeaf
            Move (RightPos("\", sLeaf)) to iSlash
            If (iSlash > 0) ;
                Move (Right(sLeaf, (Length(sLeaf) - iSlash))) to sLeaf
            Get _ClassNamesFromLines asCode to asNames
            Move (SizeOfArray(asNames) - 1) to jLast
            For j from 0 to jLast
                Move (Uppercase(asNames[j])) to asOut[SizeOfArray(asOut)]
                Move (Uppercase(asNames[j]) + "|" + sLeaf) to asPkgAll[SizeOfArray(asPkgAll)]
            Loop
        Loop
        Move (SortArray(asOut)) to asOut
        Set pasInstallClassNames to asOut
        Set pasInstallClassPkgs  to asPkgAll
        Function_Return asOut
    End_Function

    // The install package that declares class sName - "" when the catalogue has no such class.
    Function InstallClassPkgFor String sName Returns String
        String[] asNames asPkgs
        String sKey

        Move (Uppercase(Trim(sName))) to sKey
        If (sKey = "") ;
            Function_Return ""
        Get RunInstallClassNames to asNames
        If (BinarySearchArray(sKey, asNames) = -1) ;
            Function_Return ""
        Get pasInstallClassPkgs to asPkgs
        Function_Return (_InstallBindingFor(Self, sKey, asPkgs))
    End_Function

    // Every External_Function NAME the target install's Pkg source declares - UPPERCASED and SORTED
    // for BinarySearchArray. Session-cached (pasInstallExternalNames, cleared by _InitializeFuncLib):
    // GuardDuplicateExternalFunctions runs PER FILE, and re-walking the install per file is the stall
    // RunNativeGlobalFuncNames exists to avoid. A missing Pkg folder sets pbInstallScanFailed and
    // caches EMPTY - refuse-not-guess, exactly like the globals catalogue.
    Function RunInstallExternalFnNames Returns String[]
        String[] asOut asCode asNames asBind asBindAll asPkgAll
        tRFSearchResult[] aFiles
        String sPkg sMask sLeaf
        Integer i iLast j jLast iSlash

        If (pbInstallExternalNamesLoaded(Self) = True) ;
            Function_Return (pasInstallExternalNames(Self))
        Set pbInstallExternalNamesLoaded to True
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) Begin
            Set pbInstallScanFailed to True
            Set pasInstallExternalNames    to asOut
            Set pasInstallExternalBindings to asBindAll
            Set pasInstallExternalPkgs     to asPkgAll
            Function_Return asOut
        End
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        For i from 0 to iLast
            Move (rfReadEncodedFileAsStringArray(aFiles[i].sFilename)) to asCode
            // The declaring package's LEAF name rides along, for the wide guard's Use-arm (sFilename is
            // a full path here - the RECURSIVE search fills it, unlike rfFileSearch; the strip is
            // defensive either way).
            Move aFiles[i].sFilename to sLeaf
            Move (RightPos("\", sLeaf)) to iSlash
            If (iSlash > 0) ;
                Move (Right(sLeaf, (Length(sLeaf) - iSlash))) to sLeaf
            Get _ExternalFnNamesFromLines asCode to asNames
            Move (SizeOfArray(asNames) - 1) to jLast
            For j from 0 to jLast
                Move (Uppercase(asNames[j])) to asOut[SizeOfArray(asOut)]
                Move (Uppercase(asNames[j]) + "|" + sLeaf) to asPkgAll[SizeOfArray(asPkgAll)]
            Loop
            // Bindings ride the SAME walk - the cost here is the file read, and doing it twice for
            // two views of one declaration set is what RunNativeGlobalFuncNames exists to avoid.
            Get _ExternalFnBindingsFromLines asCode to asBind
            Move (SizeOfArray(asBind) - 1) to jLast
            For j from 0 to jLast
                Move asBind[j] to asBindAll[SizeOfArray(asBindAll)]
            Loop
        Loop
        Move (SortArray(asOut)) to asOut
        Set pasInstallExternalNames    to asOut
        Set pasInstallExternalBindings to asBindAll   // NOT sorted - it is packed, see the extractor
        Set pasInstallExternalPkgs     to asPkgAll    // packed too: "NAME|leaf.pkg"
        Function_Return asOut
    End_Function

    // The member NAMES of an emitted Struct, in order - fillers and directives excluded, because
    // neither is something the legacy code can have referenced.
    Function _StructMemberNames String sStruct Returns String[]
        String[] asLines asOut
        String sLine sName
        Integer i iLast iSp

        // A DF-flavoured row (harvested, ready-made DataFlex) carries a "DF|" marker; the member
        // walk below already reads DataFlex shape - name last, "#" lines skipped - so stripping
        // the marker is the whole adaptation.
        If (Left(sStruct, 3) = "DF|") ;
            Move (Right(sStruct, (Length(sStruct) - 3))) to sStruct
        Move (StrSplitToArray(sStruct, (Character(10)))) to asLines
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(Replaces((Character(13)), asLines[i], ""))) to sLine
            // Neither directives nor COMMENT lines are members - the DF emission carries a
            // provenance comment, and without this its last word became a phantom member that
            // failed every count gate (caught by the SECURITY_ATTRIBUTES tests, 2026-08-28).
            If (sLine <> "" and Left(sLine, 1) <> (Character(35)) and Left(sLine, 2) <> "//") Begin
                If (Lowercase(Left(sLine, 7)) <> "struct " and Lowercase(sLine) <> "end_struct") Begin
                    // An INLINE comment carries the C type ("Handle hwndOwner  // HWND") - cut it
                    // first, or the last token is a comment word and every commented member gets
                    // the wrong name (the probe read "nLength Pointer* BOOL", 2026-08-28).
                    Move (Pos("//", sLine)) to iSp
                    If (iSp > 0) ;
                        Move (Trim(Left(sLine, (iSp - 1)))) to sLine
                    Move (RightPos(" ", sLine)) to iSp
                    If (iSp > 0) Begin
                        Move (Trim(Right(sLine, (Length(sLine) - iSp)))) to sName
                        If (Pos("MissingAlignment", sName) = 0) ;
                            Move sName to asOut[SizeOfArray(asOut)]
                    End
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* The member names of one catalogue row, in order, with the catalogue's own alignment members
       left out. Rows are "NAME|DF|Struct NAME<LF>member<LF>...<LF>End_Struct"; a member line is
       "<datatype> <name>", so the name is the second token. Comment, blank and directive lines are
       skipped. PURE. */
    Function _CatalogRowMemberNames String sRow Returns String[]
        String[] asOut asWords asEmpty
        String sBody sLine sLow
        Integer iNl iBar

        Move asEmpty to asOut
        Move (Pos("|", sRow)) to iBar
        If (iBar < 2) ;
            Function_Return asOut
        Move (Right(sRow, (Length(sRow) - iBar))) to sBody
        // Drop the "DF|" flavour marker and the leading "Struct <name>" line.
        Move (Pos((Character(10)), sBody)) to iNl
        If (iNl = 0) ;
            Function_Return asOut
        Move (Right(sBody, (Length(sBody) - iNl))) to sBody
        While (sBody <> "")
            Move (Pos((Character(10)), sBody)) to iNl
            If (iNl > 0) Begin
                Move (Left(sBody, (iNl - 1))) to sLine
                Move (Right(sBody, (Length(sBody) - iNl))) to sBody
            End
            Else Begin
                Move sBody to sLine
                Move ""    to sBody
            End
            // Strip an end-of-line comment, then look at what is left.
            Move (Pos("//", sLine)) to iNl
            If (iNl > 0) ;
                Move (Left(sLine, (iNl - 1))) to sLine
            Move (Trim(sLine)) to sLine
            Move (Lowercase(sLine)) to sLow
            If (sLine <> "" and Left(sLine, 1) <> "#" and Left(sLow, 10) <> "end_struct") Begin
                Get _SplitSourceWords sLine to asWords
                If (SizeOfArray(asWords) > 1) Begin
                    // The alignment members express padding a legacy Type block cannot write, so
                    // counting them here could never match one - see WinAPIStructNameByMemberShape.
                    If ((Lowercase(asWords[1]) contains "missingalignment") = False) ;
                        Move asWords[1] to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // Two member-name lists, same names in the same order, case-insensitively. PURE.
    Function _MemberNamesMatch String[] asA String[] asB Returns Boolean
        Integer i iLast

        Move (SizeOfArray(asA)) to iLast
        If (iLast <> SizeOfArray(asB)) ;
            Function_Return False
        Decrement iLast
        For i from 0 to iLast
            If (Lowercase(Trim(asA[i])) <> Lowercase(Trim(asB[i]))) ;
                Function_Return False
        Loop
        Function_Return True
    End_Function

    /* A legacy Type matched to a catalogue struct by its MEMBER NAMES, for when the NAME could not
       find it. Returns the catalogue's own name for the single struct whose members are these, in
       this order - "" when nothing matches, or when more than one thing does.

       WHY A SECOND WAY IN. WinAPIStructBody looks a Type up BY NAME, stripping the house prefixes
       (T, TAG, V, VT, _). That finds tBrowseInfo -> BROWSEINFO and always will. What it cannot find
       is a Type the developer named for their own code rather than for the API: ProcessMessages.pkg
       declares "Type tPrMsg" for the Win32 MSG struct, and no derivation of "PrMsg" reaches "MSG"
       (Nils 2026-09-01). Those buffers were invisible to this converter and kept the byte-level
       idiom - and in that file, a 32-byte buffer that PeekMessage writes 48 bytes into.

       THE MEMBER NAMES ARE THE IDENTITY - the same test _ConvertWinAPITypesInLines already applies
       once a struct HAS been found ("if the legacy block names the same members as the SDK, every
       existing X.member reference keeps working and only the TYPES change"). Using it to FIND the
       struct as well is that same evidence read in the other direction.

       TWO GUARDS, measured against the live catalogue (2026-11-04, 12,787 structs, every one the
       projection names; it was 2,287 before):
         - EXACTLY ONE match, never a best guess. Two structs of the same shape refuse each other.
         - AT LEAST CI_WinAPIShapeMatchMinMembers members. At four and above there are 5,491 shapes;
           4,792 belong to one struct, 699 to several, 347 of those being only an A and a W twin.

       THE LARGER CATALOGUE CUTS BOTH WAYS, and it was measured. 30 shapes that belonged to one struct at
       2,287 rows now belong to two or more, so a Type that reached SYSTEMTIME, BITMAPINFOHEADER,
       COMMTIMEOUTS or FORMATETC only by its member names no longer does (WTS_SYSTEMTIME,
       KS_BITMAPINFOHEADER, SERIAL_TIMEOUTS and REMFORMATETC share them). It then converts on its own
       member types, as a Type nobody catalogued does: its layout does not get worse, it just gets no
       correction. And 3,926 more shapes are reachable. Over 267 Type blocks in 85 real files, the shape
       route still answers for exactly the two Types it answered for before: tPrMsg and PROCESSINFO.

       A shape match is an INFERENCE where a name match is a fact, so the caller says so in the run
       notes rather than converting silently. PURE. */
    Function WinAPIStructNameByMemberShape String[] asMembers Returns String
        String[] asCat asRowMembers
        String sRow sHit sFirstLow sWordLine sWordComment sLow
        Integer i iLast iBar iHits

        If (SizeOfArray(asMembers) < CI_WinAPIShapeMatchMinMembers) ;
            Function_Return ""
        Move (Lowercase(Trim(asMembers[0]))) to sFirstLow
        // The first member as a whole word on a member line: "<type> cb" then a line end or a comment.
        Move (" " + sFirstLow + (Character(10))) to sWordLine
        Move (" " + sFirstLow + " ")             to sWordComment
        Move 0  to iHits
        Move "" to sHit
        Get pasWinAPIStructCatalog to asCat
        Move (SizeOfArray(asCat) - 1) to iLast
        For i from 0 to iLast
            Move asCat[i] to sRow
            // Cheap pre-gate: a row that does not have the first member cannot match, and this skips
            // almost all of them without parsing a body. As a WHOLE WORD, or "cb" lets through every
            // row that mentions cbSize, and those bodies are what used to take the time.
            Move (Lowercase(sRow)) to sLow
            If (Pos(sWordLine, sLow) > 0 or Pos(sWordComment, sLow) > 0) Begin
                Move (Pos("|", sRow)) to iBar
                If (iBar > 1) Begin
                    Get _CatalogRowMemberNames sRow to asRowMembers
                    If (_MemberNamesMatch(Self, asMembers, asRowMembers) = True) Begin
                        Increment iHits
                        Move (Left(sRow, (iBar - 1))) to sHit
                    End
                End
            End
        Loop
        If (iHits = 1) ;
            Function_Return sHit
        Function_Return ""
    End_Function

    /* A catalogue Struct declaration re-headed with <sAsName>, "" when it has no head to replace.

       The lookup finds the struct under the SDK's name; the emission has to carry the developer's
       own, or every "vtBrowseInfo BrowseInfo" declaration in the file stops resolving. Both ways in
       need this - WinAPIStructForLegacyName after a NAME match, and the shape path in
       _ConvertWin32TypeBuffersInLines after a MEMBER match, where the two names differ by more than
       a prefix (MSG found, tPrMsg emitted). PURE. */
    Function _ReheadStructDecl String sDecl String sAsName Returns String
        String sRest
        Integer iNl

        Move (Pos((Character(10)), sDecl)) to iNl
        If (iNl = 0) ;
            Function_Return ""
        Move (Right(sDecl, (Length(sDecl) - iNl))) to sRest
        Function_Return ("Struct " + sAsName + (Character(13)) + (Character(10)) + sRest)
    End_Function

    /* The catalogue's Struct for a LEGACY Type name, keeping the legacy name, or "" when the
       catalogue does not know it.

       The name is preserved deliberately. Legacy code declares its buffers as "vtBrowseInfo
       BrowseInfo"; renaming the type to the SDK's would break every one of those declarations, and
       the point of this conversion is that the DECLARATION changes and the code around it does not.

       The DataFlex prefixes come off before the lookup - vtBrowseInfo, vSystemTime, tMsg all name
       the Win32 struct underneath, and the catalogue is keyed on the SDK name.

       sSdkName is the catalogue's own name for the struct found (BROWSEINFOA), "" when nothing was:
       a refusal quotes it, because "the SDK struct" names nothing a reader can look up
       (Nils 2026-10-06). */
    Function WinAPIStructForLegacyName String sLegacy String[] ByRef asNotes String ByRef sSdkName Returns String
        String sBare sOut sTry

        Move "" to sSdkName
        Move (Trim(sLegacy)) to sBare
        Move sBare to sTry
        Get WinAPIStructDataFlexDecl sTry (&asNotes) to sOut
        If (sOut = "" and Length(sBare) > 3) Begin
            If (Lowercase(Left(sBare, 2)) = "vt") Begin
                Move (Right(sBare, (Length(sBare) - 2))) to sTry
                Get WinAPIStructDataFlexDecl sTry (&asNotes) to sOut
            End
        End
        If (sOut = "" and Length(sBare) > 2) Begin
            If (Lowercase(Left(sBare, 1)) = "v" or Lowercase(Left(sBare, 1)) = "t" or Left(sBare, 1) = "_") Begin
                Move (Right(sBare, (Length(sBare) - 1))) to sTry
                Get WinAPIStructDataFlexDecl sTry (&asNotes) to sOut
            End
        End
        If (sOut = "") ;
            Function_Return ""
        // The row the successful spelling reached: the same lookup WinAPIStructBody ran inside
        // WinAPIStructDataFlexDecl, so this is that row's name and no other.
        Get WinAPIStructCatalogName sTry to sSdkName
        Function_Return (_ReheadStructDecl(Self, sOut, sLegacy))
    End_Function

    /* WHY A TYPE MUST STAY A TYPE - "" when no line of asCode outside its own block (iStart..iEnd) reads it
       byte by byte (2026-10-31, _ConvertWinAPITypesInLines). A Struct keeps the member NAMES but has none of
       the symbols a Type gives the byte-level commands: the member offsets ('GetBuff From s at
       PRINTDLG.hDevNames to h', Put ... at, Offset_of_Field), the size (PRINTDLG_SIZE), and the Type name that
       ZeroType and FillType take. A printer-dialog package's PRINTDLG and DEVNAMES became Structs while those
       lines stayed, and every program that used the package stopped compiling. ChangeExternalFunctionCallers
       converts such a Type together with its buffers. */
    Function _TypeByteWiseUse String[] ByRef asCode String sType Integer iStart Integer iEnd Returns String
        String sCode sLow sFirst
        Integer i iLast iAt iAfter

        Move (Lowercase(Trim(sType))) to sType
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            If (i < iStart or i > iEnd) Begin
                Get _CodeOnlyLine asCode[i] to sCode
                Move (Lowercase(sCode)) to sLow
                If (Pos(sType, sLow) > 0) Begin
                    // A member offset: the Type name, a '.', a name.
                    Move 1 to iAt
                    Repeat
                        Get _FindKeywordPos sLow sType True iAt to iAt
                        If (iAt > 0) Begin
                            Move (iAt + Length(sType)) to iAfter
                            If (Mid(sLow, 1, iAfter) = "." and _IsIdentifierChar(Self, Mid(sLow, 1, (iAfter + 1))) = True) ;
                                Function_Return ("line " + String(i + 1) + " reads it byte by byte: " + Trim(sCode))
                            Move iAfter to iAt
                        End
                    Until (iAt = 0)
                    If (_FindKeywordPos(Self, sLow, (sType + "_size"), True, 1) > 0) ;
                        Function_Return ("line " + String(i + 1) + " reads its size: " + Trim(sCode))
                    Get _NthWord sLow 1 to sFirst
                    If ((sFirst = "zerotype" or sFirst = "filltype") and _FindKeywordPos(Self, sLow, sType, True, 1) > 0) ;
                        Function_Return ("line " + String(i + 1) + " fills a buffer of it: " + Trim(sCode))
                End
            End
        Loop
        Function_Return ""
    End_Function

    /* Rewrites legacy "Type <name> ... End_Type" blocks the Win32 catalogue knows into modern
       Structs carrying the SDK's own member types. Returns the number converted.

       WHY THE DECLARATION IS ENOUGH, for this shape. Real legacy code reaches these buffers by
       DOT-MEMBER access - "Move (AddressOf(sTitle)) to BrowseInfo.lpszTitle" - and passes them
       whole with AddressOf(BrowseInfo). Both are exactly what a modern Struct supports, so the
       surrounding code compiles unchanged. That is what makes this convertible where the byte-level
       family (Put / GetBuff / Offset_of_Field) is not: TypeToStructReport already separates those
       two populations, and this deliberately acts on neither of them directly - it acts on the
       DECLARATION, and refuses whenever the code around it would have to change. That refusal is
       _TypeByteWiseUse (2026-10-31): until then it was claimed and not made, and a Type the file reads
       byte by byte became a Struct the file could no longer compile against. A file ELSEWHERE that reads the
       Type refuses it the same way (_FileReadingTypeElsewhere, 2026-11-01): the declaration is public.

       THE GATE IS THE MEMBER NAMES, in order. If the legacy block names the same members as the
       SDK, every existing X.member reference keeps working and only the TYPES change - which is the
       entire point, because a legacy Word where the SDK says a pointer is the bug being fixed. If
       the names differ, the legacy block flattened a nested struct (13 members where the SDK nests
       8, the WIN32_FIND_DATA shape) or renamed things, and converting would break every reference.
       Refuse and say which member disagreed.

       A Type with no catalogue entry is left entirely alone; this converts what it can prove. */
    Function _ConvertWinAPITypesInLines String[] ByRef asCode String[] ByRef asNotes Returns Integer
        String[] asOut asLegacy asModern asStructLines asNoteBin
        String sLine sTrim sLow sName sMember sStruct sIndent sSdkBin sWhyByte sReader
        Integer i iLast iEnd iJ iP iCount iM iMLast
        Boolean bBad

        Move (SizeOfArray(asCode) - 1) to iLast
        Move 0 to iCount
        Move 0 to i
        While (i <= iLast)
            Move asCode[i] to sLine
            Move (Trim(sLine)) to sTrim
            Move (Lowercase(sTrim)) to sLow
            Move "" to sName
            If (Left(sLow, 5) = "type ") ;
                Move (Trim(Right(sTrim, (Length(sTrim) - 5)))) to sName
            If (Pos(" ", sName) > 0) ;
                Move (Left(sName, (Pos(" ", sName) - 1))) to sName
            If (sName = "") Begin
                Move sLine to asOut[SizeOfArray(asOut)]
                Increment i
            End
            Else Begin
                // Collect the block and its member names.
                Move (ResizeArray(asLegacy, 0)) to asLegacy
                Move i to iEnd
                Move False to bBad
                While (iEnd < iLast and bBad = False)
                    Increment iEnd
                    Move (Trim(asCode[iEnd])) to sTrim
                    Move (Lowercase(sTrim)) to sLow
                    If (Left(sLow, 8) = "end_type") ;
                        Move True to bBad
                    Else If (Left(sLow, 6) = "field ") Begin
                        Move (Trim(Right(sTrim, (Length(sTrim) - 6)))) to sMember
                        If (Pos(" ", sMember) > 0) ;
                            Move (Left(sMember, (Pos(" ", sMember) - 1))) to sMember
                        Move (RightPos(".", sMember)) to iP
                        If (iP > 0) ;
                            Move (Right(sMember, (Length(sMember) - iP))) to sMember
                        Move sMember to asLegacy[SizeOfArray(asLegacy)]
                    End
                Loop
                Get WinAPIStructForLegacyName sName (&asNoteBin) (&sSdkBin) to sStruct
                Move False to bBad
                If (sStruct = "") ;
                    Move True to bBad
                If (bBad = False) Begin
                    Get _StructMemberNames sStruct to asModern
                    If (SizeOfArray(asModern) <> SizeOfArray(asLegacy)) Begin
                        Move (sName + ": " + String(SizeOfArray(asLegacy)) + " members declared, the Windows SDK has " + String(SizeOfArray(asModern)) + " - left alone (the legacy block flattens what the SDK nests, so every reference would move)") to asNotes[SizeOfArray(asNotes)]
                        Move True to bBad
                    End
                End
                If (bBad = False) Begin
                    Move (SizeOfArray(asLegacy) - 1) to iMLast
                    For iM from 0 to iMLast
                        If (Lowercase(asLegacy[iM]) <> Lowercase(asModern[iM])) Begin
                            Move (sName + ": member " + String(iM + 1) + " is '" + asLegacy[iM] + "' but the SDK calls it '" + asModern[iM] + "' - left alone, every reference to it would break") to asNotes[SizeOfArray(asNotes)]
                            Move True to bBad
                        End
                    Loop
                End
                If (bBad = False) Begin
                    Get _TypeByteWiseUse (&asCode) sName i iEnd to sWhyByte
                    If (sWhyByte <> "") Begin
                        Move (sName + ": left as written - " + sWhyByte + " - a Struct has no byte offsets; ChangeExternalFunctionCallers converts a Type together with its buffers") to asNotes[SizeOfArray(asNotes)]
                        Move True to bBad
                    End
                End
                If (bBad = False) Begin
                    Get _FileReadingTypeElsewhere sName to sReader
                    If (sReader <> "") Begin
                        Move (sName + ": left as written - another file uses it too, and would stop compiling if it became a Struct: " + sReader) to asNotes[SizeOfArray(asNotes)]
                        Move True to bBad
                    End
                End
                If (bBad = True) Begin
                    // Untouched, verbatim - including its End_Type.
                    For iJ from i to iEnd
                        Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                    Loop
                End
                Else Begin
                    Move (Trim(sLine)) to sTrim
                    Move "" to sIndent
                    Move (Pos(sTrim, sLine)) to iP
                    If (iP > 1) ;
                        Move (Left(sLine, (iP - 1))) to sIndent
                    Move (sIndent + "// [DFRefactor] Was a legacy Type. Member TYPES now come from the Windows SDK;") to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// the names and the struct name are unchanged, so every reference still compiles.") to asOut[SizeOfArray(asOut)]
                    Move (StrSplitToArray(sStruct, (Character(10)))) to asStructLines
                    For iJ from 0 to (SizeOfArray(asStructLines) - 1)
                        Move (Trim(Replaces((Character(13)), asStructLines[iJ], ""))) to sTrim
                        If (sTrim <> "") ;
                            Move (sIndent + sTrim) to asOut[SizeOfArray(asOut)]
                    Loop
                    Increment iCount
                End
                Move (iEnd + 1) to i
            End
        Loop
        If (iCount > 0) ;
            Move asOut to asCode
        Function_Return iCount
    End_Function

    /* Why this file belongs to a dead dependency, or "" when it does not.

       Returns the REASON rather than a Boolean so whatever reports the skip can say why without a
       second lookup - "Crystal Reports - support dropped, no later version" beats "skipped".

       Matched on a token in the BASENAME, not the path: the same wrapper appears under a dozen
       names across these trees, several of them prefixed with the name of the company that wrote
       it, and a token covers those without this repository ever holding a customer's name. Source
       extensions only, so a .rpt or a .dat that happens to contain the word is not what decides.

       Narrower than the Deep Scan rule that WARNS about the same families, deliberately: a warning
       that misses a new wrapper is merely incomplete, but a skip that catches an innocent file
       removes findings the user never learns existed. That is also why the caller records every
       skip. */
    Function _DeadDependencyFor String sFileName Returns String
        String[] asDeps
        String sBase sExt sRow sToken sWhy
        Integer i iLast iPos iBar

        Move (Lowercase(Trim(sFileName))) to sBase
        Move (RightPos("\", sBase)) to iPos
        If (iPos > 0) ;
            Move (Right(sBase, (Length(sBase) - iPos))) to sBase
        Move (RightPos(".", sBase)) to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (Right(sBase, (Length(sBase) - iPos))) to sExt
        If (sExt <> "pkg" and sExt <> "inc" and sExt <> "src" and sExt <> "vw" and sExt <> "dg") ;
            Function_Return ""
        Get pasDeadDependencies to asDeps
        Move (SizeOfArray(asDeps) - 1) to iLast
        For i from 0 to iLast
            Move asDeps[i] to sRow
            Move (Pos("|", sRow)) to iBar
            If (iBar > 1) Begin
                Move (Left(sRow, (iBar - 1))) to sToken
                Move (Right(sRow, (Length(sRow) - iBar))) to sWhy
                If (sBase contains sToken) ;
                    Function_Return sWhy
            End
        Loop
        Function_Return ""
    End_Function

    /* SIZE AND ALIGNMENT of a DataFlex type on x64, packed "size|align", or "" when it cannot be
       resolved - the 64-bit answer of _DfTypeSizeAlignFor below, which every caller had before there was a
       32-bit one. Scalars come from the table; a tWin* struct is laid out RECURSIVELY from the
       install's own members, because its alignment is its widest member's and nothing else.

       That recursion is the rule's sharp edge. tWinFileTime is two DWords - size 8, align FOUR -
       and treating a nested struct as 8-aligned mispredicts tWin32FindData, which is exactly how
       this was caught while validating against DataFlex's own 57 structs.

       iDepth stops a cycle dead. A struct that nests itself cannot be laid out at all, and a
       recursion with no floor would take the program with it. */
    Function _DfTypeSizeAlign String sType Integer iDepth Returns String
        String sSA
        // Message form: _DfTypeSizeAlignFor sits below this function in the file (4367).
        Get _DfTypeSizeAlignFor sType True iDepth to sSA
        Function_Return sSA
    End_Function

    /* SIZE AND ALIGNMENT FOR ONE TARGET, packed "size|align" - bWin64 False answers for a 32-bit program
       (2026-11-06). What differs there is only the pointer-sized types: Pointer, Handle, LongPtr, ULongPtr
       and Address are 4 bytes, aligned 4. An 8-byte number aligns to 8 in a 32-bit program too - Windows'
       compiler puts a LONGLONG or a double there - and a GUID is 16 bytes aligned 4 in both.

       A Boolean is ONE byte: that is what DataFlex makes of one inside a struct (SizeOfType, measured
       2026-11-06). A Windows BOOL is four, which is why neither the catalogue nor this emitter ever writes
       Boolean for one.

       An install struct is laid out recursively for the same target. Its own guarded fillers are not among
       its members (RunInstallStructNames leaves them out), so a 64-bit tWinNmHdr comes out 24 bytes and a
       32-bit one 12. */
    Function _DfTypeSizeAlignFor String sType Boolean bWin64 Integer iDepth Returns String
        String sLC sMembers sPart sSub
        String[] asParts
        Integer iOff iMax iA iS i iLast iBar

        Move (Lowercase(Trim(sType))) to sLC
        If (sLC = "char" or sLC = "uchar" or sLC = "boolean") ;
            Function_Return "1|1"
        If (sLC = "short" or sLC = "ushort") ;
            Function_Return "2|2"
        If (sLC = "integer" or sLC = "uinteger" or sLC = "dword" or sLC = "date" or sLC = "float") ;
            Function_Return "4|4"
        If (sLC = "bigint" or sLC = "ubigint" or sLC = "number" or sLC = "real" or sLC = "currency") ;
            Function_Return "8|8"
        If (sLC = "handle" or sLC = "pointer" or sLC = "longptr" or sLC = "ulongptr" or sLC = "address") Begin
            If (bWin64 = True) ;
                Function_Return "8|8"
            Function_Return "4|4"
        End
        If (sLC = "guid") ;
            Function_Return "16|4"
        If (iDepth > 8) ;
            Function_Return ""
        Get _InstallStructMembers sType to sMembers
        If (sMembers = "") ;
            Function_Return ""
        Move (StrSplitToArray(sMembers, ";")) to asParts
        Move 0 to iOff
        Move 1 to iMax
        Move (SizeOfArray(asParts) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asParts[i])) to sPart
            If (sPart <> "") Begin
                // An array member carries its bound in the TYPE here - "Char[MAX_PATH]". The bound
                // is a Define this walk cannot evaluate, so a struct containing one is refused
                // rather than laid out on a guess.
                If (Pos("[", sPart) > 0) ;
                    Function_Return ""
                Get _DfTypeSizeAlignFor sPart bWin64 (iDepth + 1) to sSub
                If (sSub = "") ;
                    Function_Return ""
                Move (Pos("|", sSub)) to iBar
                Move (Integer(Left(sSub, (iBar - 1)))) to iS
                Move (Integer(Right(sSub, (Length(sSub) - iBar)))) to iA
                If (iA > iMax) ;
                    Move iA to iMax
                If (Mod(iOff, iA) <> 0) ;
                    Move (iOff + (iA - Mod(iOff, iA))) to iOff
                Move (iOff + iS) to iOff
            End
        Loop
        If (Mod(iOff, iMax) <> 0) ;
            Move (iOff + (iMax - Mod(iOff, iMax))) to iOff
        Function_Return (String(iOff) + "|" + String(iMax))
    End_Function

    /* The SDK body this app curates for a Win32 struct, or "" when the catalogue does not cover it.
       Matched on NAME with the same ANSI-first tolerance the API lookup uses: legacy code writes
       BROWSEINFO where the SDK typedef is BROWSEINFOA.

       AND WITH A LOCAL PREFIX STRIPPED, because almost nobody writes the SDK name. A scan of
       C:\Projects found the catalogued shapes hiding behind house prefixes: vtBrowseInfo 72 times,
       vtShFileOpStruct 71, tMSG 27 - every one of them a struct this catalogue already carries and
       none of them reachable, because the lookup only ever tried the name as written (2026-08-26).

       SAFE TO BE GENEROUS HERE, and that is the point: a name match only gets the block as far as
       the MEMBER gate, which compares member names in order and refuses anything that disagrees. A
       wrong guess is therefore rejected downstream rather than applied, so widening the lookup
       cannot widen what gets rewritten - only what gets considered.

       THE WHOLE ROW, "NAME|body", is what this returns. WinAPIStructBody and WinAPIStructCatalogName
       below each take their half of it, so a body and the name quoted beside it always come from
       the same lookup.

       THE UNDERSCORE COMES OUT LAST (2026-11-04). commctrl.h's old spellings are still what legacy code
       writes - LV_ITEM, NM_LISTVIEW, TV_ITEM, TC_ITEM, HD_ITEM - and the catalogue is keyed on the modern
       ones. Every name above is tried with its underscores first, so a row spelled with one always wins.

       ONE LEFT() PER ROW, not three with a concatenation each: at 12,787 rows that took a miss from 23.5 ms
       to 6-8 ms. The row is only looked at more closely once its head agrees. */
    Function _WinAPIStructCatalogRow String sName Returns String
        String[] asCat
        String[] asPrefix asTry
        String sKey sRow sTry sNext
        Integer i iLast iTry iTryLast iLen

        Move (Uppercase(Trim(sName))) to sKey
        If (sKey = "") ;
            Function_Return ""
        // The house prefixes seen in the wild, LONGEST FIRST so "VT" is tried before "V".
        Move "VT_" to asPrefix[0]
        Move "VT"  to asPrefix[1]
        Move "TAG" to asPrefix[2]
        Move "_"   to asPrefix[3]
        Move "T"   to asPrefix[4]
        Move "V"   to asPrefix[5]
        // The name as written, then with one house prefix stripped, then each of those without underscores.
        Move sKey to asTry[0]
        For iTry from 0 to 5
            If (Length(sKey) > Length(asPrefix[iTry]) and Left(sKey, Length(asPrefix[iTry])) = asPrefix[iTry]) ;
                Move (Right(sKey, (Length(sKey) - Length(asPrefix[iTry])))) to asTry[SizeOfArray(asTry)]
        Loop
        Move (SizeOfArray(asTry) - 1) to iTryLast
        For iTry from 0 to iTryLast
            If (Pos("_", asTry[iTry]) > 0) Begin
                Move (Replaces("_", asTry[iTry], "")) to sTry
                If (sTry <> "") ;
                    Move sTry to asTry[SizeOfArray(asTry)]
            End
        Loop
        Get pasWinAPIStructCatalog to asCat
        Move (SizeOfArray(asCat) - 1) to iLast
        Move (SizeOfArray(asTry) - 1) to iTryLast
        For iTry from 0 to iTryLast
            Move asTry[iTry] to sTry
            Move (Length(sTry)) to iLen
            For i from 0 to iLast
                If (Left(asCat[i], iLen) = sTry) Begin
                    Move asCat[i] to sRow
                    Move (Mid(sRow, 2, (iLen + 1))) to sNext
                    If (Left(sNext, 1) = "|" or sNext = "A|" or sNext = "W|") ;
                        Function_Return sRow
                End
            Loop
        Loop
        Function_Return ""
    End_Function

    // The SDK body for a Win32 struct name (house prefix and ANSI suffix tolerated - see above), or
    // "" when the catalogue does not cover it.
    Function WinAPIStructBody String sName Returns String
        String sRow
        Integer iBar

        Get _WinAPIStructCatalogRow sName to sRow
        Move (Pos("|", sRow)) to iBar
        If (iBar = 0) ;
            Function_Return ""
        Function_Return (Right(sRow, (Length(sRow) - iBar)))
    End_Function

    /* The catalogue's OWN name for the struct a Type name reaches - BROWSEINFOA for vtBrowseInfo - or
       "" when none does. A refusal quotes it so the reader learns which Windows struct the Type was
       taken for: "the SDK struct has 12" told them nothing (Nils 2026-10-06). The same lookup as the
       body, so the two cannot name different rows. */
    Function WinAPIStructCatalogName String sName Returns String
        String sRow
        Integer iBar

        Get _WinAPIStructCatalogRow sName to sRow
        Move (Pos("|", sRow)) to iBar
        If (iBar = 0) ;
            Function_Return ""
        Function_Return (Left(sRow, (iBar - 1)))
    End_Function

    /* PURE. A C type to its EXACT-WIDTH DataFlex equivalent, for STRUCT MEMBERS only.

       _CTypeToDataFlex deliberately widens everything narrower than Integer to Integer, and says so:
       "BOOL included, which is a 32-bit int in Win32 whatever its name says". That is right for the
       caller it was written for - an External_Function PARAMETER, which Win32 promotes to 32 bits on
       the stack regardless - and catastrophic for a struct member, where the width IS the layout.

       DEVNAMES is four WORDs. Widened, it came out as four Integers: sixteen bytes where Windows
       reads eight, with wDefault at offset 12 instead of 6. The legacy Type block being converted
       had it RIGHT, declaring Word - so the conversion made a correct file wrong, which is the one
       outcome this whole campaign exists to prevent (2026-08-30, found by reading the output of a
       live run rather than its summary).

       Only the narrow families are answered here; everything else goes to the shared mapper, so
       parameter declarations elsewhere keep the widening they were built on. */
    Function _CTypeToDataFlexExactWidth String sCType Integer iPtr Returns String
        String sLC

        If (iPtr > 0) ;
            Function_Return (_CTypeToDataFlex(Self, sCType, iPtr, False))
        Move (Lowercase(Trim(sCType))) to sLC
        // 16-bit
        If (sLC = "word" or sLC = "ushort" or sLC = "unsigned short" or sLC = "atom" ;
            or sLC = "langid" or sLC = "wchar" or sLC = "wchar_t" or sLC = "uint16" or sLC = "unsigned __int16") ;
            Function_Return "UShort"
        If (sLC = "short" or sLC = "int16" or sLC = "__int16" or sLC = "short int") ;
            Function_Return "Short"
        // 8-bit
        If (sLC = "byte" or sLC = "uchar" or sLC = "unsigned char" or sLC = "uint8" or sLC = "boolean") ;
            Function_Return "UChar"
        If (sLC = "char" or sLC = "int8" or sLC = "__int8" or sLC = "signed char") ;
            Function_Return "Char"
        Function_Return (_CTypeToDataFlex(Self, sCType, iPtr, False))
    End_Function

    /* _StripCNoise at TEXT level - it takes tokens with "(" and ")" already detached, the contract
       its own header states, so this splits, delegates and rejoins. A wrapper, not a second
       stripper: a struct member is annotated exactly like a parameter, and one rule table is the
       whole point. */
    Function _StripCNoiseFromText String sText Returns String
        String[] asRaw asTok asOut
        String sJoin
        Integer i iLast iNum

        Move (Replaces("(", sText, " ( ")) to sText
        Move (Replaces(")", sText, " ) ")) to sText
        Move (StrSplitToArray(Trim(sText), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTok[iNum]
                Increment iNum
            End
        Loop
        Get _StripCNoise asTok to asOut
        Move "" to sJoin
        Move (SizeOfArray(asOut) - 1) to iLast
        For i from 0 to iLast
            If (sJoin = "") ;
                Move asOut[i] to sJoin
            Else ;
                Move (sJoin + " " + asOut[i]) to sJoin
        Loop
        Function_Return sJoin
    End_Function

    // The DataFlex type that occupies exactly N padding bytes. The single-type cases match what
    // DataFlex writes by hand (Integer for the common 4-byte gap); anything else becomes a byte
    // array, which is how the SDK itself spells padding (TBBUTTON's BYTE bReserved[6]).
    Function WinAPIFillerType Integer iBytes Returns String
        If (iBytes = 1) ;
            Function_Return "UChar"
        If (iBytes = 2) ;
            Function_Return "Short"
        If (iBytes = 4) ;
            Function_Return "Integer"
        Function_Return ("UChar[" + String(iBytes) + "]")
    End_Function

    /* THE GAP BEFORE A MEMBER, FOR BOTH TARGETS: the lines that put it there, each led by sNl, or "" when
       neither a 32-bit nor a 64-bit program has a gap here (Nils 2026-11-06: "char then LPVOID is Char[7]
       on x64 and Char[3] on x86").

       DataFlex packs a struct on BOTH targets, so every gap Windows has must be written out on both: the
       same gap is one plain filler; a gap only a 64-bit program has (in front of a pointer, nearly always)
       goes inside #IFDEF IS$WIN64; one only a 32-bit program has inside #IFNDEF IS$WIN64; and two different
       gaps are an #IFDEF / #ELSE pair under one name. Until this, every computed filler went inside
       #IFDEF IS$WIN64, on the belief that a 32-bit program has no gaps - true in front of a pointer, false
       after a Char or a Short. iPad64 / iPad86: the bytes each program needs here. */
    Function _Win32FillerLines String sNl String sFillName Integer iPad64 Integer iPad86 Returns String
        String s64 s86

        If (iPad64 <= 0 and iPad86 <= 0) ;
            Function_Return ""
        Move ("    " + WinAPIFillerType(Self, iPad64) + " " + sFillName) to s64
        Move ("    " + WinAPIFillerType(Self, iPad86) + " " + sFillName) to s86
        If (iPad64 = iPad86) ;
            Function_Return (sNl + s64)
        If (iPad86 <= 0) ;
            Function_Return (sNl + (Character(35)) + "IFDEF IS$WIN64" + sNl + s64 + sNl + (Character(35)) + "ENDIF")
        If (iPad64 <= 0) ;
            Function_Return (sNl + (Character(35)) + "IFNDEF IS$WIN64" + sNl + s86 + sNl + (Character(35)) + "ENDIF")
        Function_Return (sNl + (Character(35)) + "IFDEF IS$WIN64" + sNl + s64 + sNl + (Character(35)) + "ELSE" + sNl + s86 + sNl + (Character(35)) + "ENDIF")
    End_Function

    /* PACKED TO THE BYTE IN A 32-BIT PROGRAM. commdlg.h and shellapi.h wrap their structs in pshpack1.h
       unless _WIN64 is defined - a 32-bit PRINTDLG is 66 bytes, a SHFILEOPSTRUCT 30 - which is how DataFlex
       lays any struct out, so a 32-bit program needs no gap in them at all. A 64-bit program aligns them
       normally, so a 64-bit catalogue cannot show this; it is known by name. sSdkName is the catalogue's own
       (OPENFILENAMEW): the A/W tail, an EX and an _NT4 are matched by prefix. PURE. */
    Function _Win32Pack1OnX86 String sSdkName Returns Boolean
        String[] asFamily
        String sKey
        Integer i iLast

        Move (Uppercase(Trim(sSdkName))) to sKey
        If (sKey = "") ;
            Function_Return False
        // commdlg.h
        Move "OPENFILENAME"         to asFamily[0]
        Move "CHOOSECOLOR"          to asFamily[1]
        Move "CHOOSEFONT"           to asFamily[2]
        Move "PRINTDLG"             to asFamily[3]
        Move "PRINTPAGERANGE"       to asFamily[4]
        Move "PAGESETUPDLG"         to asFamily[5]
        Move "FINDREPLACE"          to asFamily[6]
        Move "DEVNAMES"             to asFamily[7]
        Move "OFNOTIFY"             to asFamily[8]
        // shellapi.h
        Move "SHELLEXECUTEINFO"     to asFamily[9]
        Move "SHFILEOPSTRUCT"       to asFamily[10]
        Move "SHNAMEMAPPING"        to asFamily[11]
        Move "NOTIFYICONDATA"       to asFamily[12]
        Move "NOTIFYICONIDENTIFIER" to asFamily[13]
        Move "SHFILEINFO"           to asFamily[14]
        Move "APPBARDATA"           to asFamily[15]
        Move "DRAGINFO"             to asFamily[16]
        Move "SHQUERYRBINFO"        to asFamily[17]
        Move "SHCREATEPROCESSINFO"  to asFamily[18]
        Move "ASSOCIATIONELEMENT"   to asFamily[19]
        Move "SHSTOCKICONINFO"      to asFamily[20]
        Move (SizeOfArray(asFamily) - 1) to iLast
        For i from 0 to iLast
            If (Left(sKey, Length(asFamily[i])) = asFamily[i]) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* WINDOWS DECLARES OTHER MEMBERS FOR A 32-BIT PROGRAM. TBBUTTON pads with bReserved[6] on 64-bit and
       [2] on 32-bit, WSADATA and SERVENT put their members in another order, MEMORY_BASIC_INFORMATION has a
       PartitionId only on 64-bit, and the CONTEXT family is a different struct per processor. A 64-bit
       catalogue row of one of these says nothing about its 32-bit layout, whatever its offsets show, so
       its 32-bit compile is stopped instead. These are the ones known; one not listed would be laid out
       from its 64-bit members. PURE. */
    Function _Win32ArchVariantStruct String sSdkName Returns Boolean
        String[] asNames

        Move "TBBUTTON"                      to asNames[0]
        Move "WSADATA"                       to asNames[1]
        Move "SERVENT"                       to asNames[2]
        Move "MEMORY_BASIC_INFORMATION"      to asNames[3]
        Move "CONTEXT"                       to asNames[4]
        Move "XSAVE_FORMAT"                  to asNames[5]
        Move "DISPATCHER_CONTEXT"            to asNames[6]
        Move "KNONVOLATILE_CONTEXT_POINTERS" to asNames[7]
        Move "UNWIND_HISTORY_TABLE"          to asNames[8]
        Move "UNWIND_HISTORY_TABLE_ENTRY"    to asNames[9]
        Function_Return (SearchArray(Uppercase(Trim(sSdkName)), asNames) <> -1)
    End_Function

    /* The catalogue row named EXACTLY sName ("NAME|..."), or "". No prefix and no A/W tolerance, unlike
       _WinAPIStructCatalogRow: a harvested member type names the struct it nests exactly, and a tolerant
       match could hand back another one. */
    Function _Win32CatalogRowExact String sName Returns String
        String[] asCat
        String sKey
        Integer i iLast iLen

        Move (Trim(sName) + "|") to sKey
        Move (Length(sKey)) to iLen
        If (iLen < 2) ;
            Function_Return ""
        Get pasWinAPIStructCatalog to asCat
        Move (SizeOfArray(asCat) - 1) to iLast
        For i from 0 to iLast
            If (Left(asCat[i], iLen) = sKey) ;
                Function_Return asCat[i]
        Loop
        Function_Return ""
    End_Function

    /* A HARVESTED ROW'S MEMBER TYPE FOR ONE TARGET, "size|align": what _DfTypeSizeAlignFor answers, else
       another catalogue row of exactly that name - a harvested row nests FILETIME, POINT or NMHDR by their
       SDK names - laid out the same way and proven the same way (_Win32HarvestedLayout). "" when neither
       knows it, or when that row's layout cannot be proven. */
    Function _Win32MemberSizeAlign String sType Boolean bWin64 Integer iDepth Returns String
        String sSA sRow

        Get _DfTypeSizeAlignFor sType bWin64 iDepth to sSA
        If (sSA <> "") ;
            Function_Return sSA
        If (iDepth > 8) ;
            Function_Return ""
        Get _Win32CatalogRowExact sType to sRow
        If (sRow = "") ;
            Function_Return ""
        Get _Win32HarvestedLayout sRow bWin64 iDepth to sSA
        Function_Return sSA
    End_Function

    /* A HARVESTED ROW'S MEMBERS as parallel lists: asLines the member line as the row writes it (its
       "// C type" note included), asTypes the DataFlex type without its bound, aiCount the elements
       ([128] -> 128, none -> 1), asNames the name, abFill True for the row's own alignment members. sBody is
       "Struct NAME", the member lines and "End_Struct", one per line, the "DF|" marker already off.

       A UNION is a placeholder of its bytes, "UChar[n] UnionName<N>". abUnion marks one. Under 8 bytes it
       cannot hold a pointer - a 64-bit pointer would make it 8 - so it is n bytes in a 32-bit program as well,
       aligned at most 4 (_Win32HarvestedRowLayout checks where that leaves it). 8 or more, it may hold one,
       and nothing in a 64-bit projection gives its 32-bit size.

       False, with sWhyNot, for whatever cannot be laid out honestly: such a large union, a comment or
       directive line among the members, a bound that is not a number, a line that is not "<type> <name>". */
    Function _Win32DfBodyMembers String sBody String[] ByRef asLines String[] ByRef asTypes Integer[] ByRef aiCount ;
            String[] ByRef asNames Boolean[] ByRef abFill Boolean[] ByRef abUnion String ByRef sWhyNot Returns Boolean
        String[] asRaw
        String sLine sCode sType sName sRest sBound sNum
        Integer i iLast iAt iBr iBr2 iN
        Boolean bEnd bDigits bUnion

        Move (ResizeArray(asLines, 0)) to asLines
        Move (ResizeArray(asTypes, 0)) to asTypes
        Move (ResizeArray(aiCount, 0)) to aiCount
        Move (ResizeArray(asNames, 0)) to asNames
        Move (ResizeArray(abFill, 0)) to abFill
        Move (ResizeArray(abUnion, 0)) to abUnion
        Move "" to sWhyNot
        Move (StrSplitToArray(Replaces((Character(13)), sBody, ""), (Character(10)))) to asRaw
        Move False to bEnd
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 1 to iLast
            Move (Trim(asRaw[i])) to sLine
            If (bEnd = False and sLine <> "") Begin
                If (Lowercase(sLine) = "end_struct") Begin
                    Move True to bEnd
                End
                Else Begin
                    If (Left(sLine, 1) = (Character(35)) or Left(sLine, 2) = "//") Begin
                        Move "a comment or directive line among its members" to sWhyNot
                        Function_Return False
                    End
                    Move sLine to sCode
                    Move (Pos("//", sCode)) to iAt
                    If (iAt > 0) ;
                        Move (Trim(Left(sCode, (iAt - 1)))) to sCode
                    Get _NthWord sCode 1 to sType
                    Get _NthWord sCode 2 to sName
                    Get _NthWord sCode 3 to sRest
                    If (sType = "" or sName = "" or sRest <> "") Begin
                        Move ("a member line it cannot read: " + sLine) to sWhyNot
                        Function_Return False
                    End
                    Move (Lowercase(Left(sName, 9)) = "unionname") to bUnion
                    Move 1 to iN
                    Move (Pos("[", sType)) to iBr
                    If (iBr > 0) Begin
                        Move (Right(sType, (Length(sType) - iBr + 1))) to sBound
                        Move (Left(sType, (iBr - 1))) to sType
                        While (sBound <> "")
                            Move (Pos("]", sBound)) to iBr2
                            Move False to bDigits
                            If (Left(sBound, 1) = "[" and iBr2 > 2) Begin
                                Move (Mid(sBound, (iBr2 - 2), 2)) to sNum
                                Get _IsAllDigits sNum to bDigits
                            End
                            If (bDigits = False) Begin
                                Move ("an array bound that is not a number: " + sLine) to sWhyNot
                                Function_Return False
                            End
                            Move (iN * Integer(sNum)) to iN
                            Move (Right(sBound, (Length(sBound) - iBr2))) to sBound
                        Loop
                    End
                    If (bUnion = True and (Lowercase(sType) <> "uchar" or iN >= 8)) Begin
                        Move "it holds a union of 8 bytes or more, which may hold a pointer - its 32-bit size a 64-bit catalogue does not give" to sWhyNot
                        Function_Return False
                    End
                    Move sLine  to asLines[SizeOfArray(asLines)]
                    Move sType  to asTypes[SizeOfArray(asTypes)]
                    Move iN     to aiCount[SizeOfArray(aiCount)]
                    Move sName  to asNames[SizeOfArray(asNames)]
                    Move (Pos("missingalig", Lowercase(sName)) > 0) to abFill[SizeOfArray(abFill)]
                    Move bUnion to abUnion[SizeOfArray(abUnion)]
                End
            End
        Loop
        If (SizeOfArray(asNames) = 0) Begin
            Move "it declares no members" to sWhyNot
            Function_Return False
        End
        Function_Return True
    End_Function

    /* WHERE EACH MEMBER STARTS, FOR ONE TARGET. bPacked True lays them out as DataFlex does - one after the
       other, no gaps - which is how a harvested row's own fillers are measured; False as Windows does: each
       member on a multiple of its alignment, the struct padded to its widest member. iPack > 0 caps every
       alignment (1 = byte-packed). abSkip leaves a member out (its aiOff is -1): the fillers, when the gaps
       are to be computed. aiSize holds each member's bytes. False when a member type has no size for this
       target. */
    Function _Win32LayoutOffsets String[] ByRef asTypes Integer[] ByRef aiCount Boolean[] ByRef abSkip ;
            Boolean bWin64 Boolean bPacked Integer iPack Integer iDepth Integer[] ByRef aiOff Integer[] ByRef aiSize ;
            Integer ByRef iSize Integer ByRef iAlign Returns Boolean
        String sSA
        Integer i iLast iOff iMax iS iA iBar

        Move (ResizeArray(aiOff, 0)) to aiOff
        Move (ResizeArray(aiSize, 0)) to aiSize
        Move 0 to iOff
        Move 1 to iMax
        Move (SizeOfArray(asTypes) - 1) to iLast
        For i from 0 to iLast
            If (abSkip[i] = True) Begin
                Move -1 to aiOff[i]
                Move 0  to aiSize[i]
            End
            Else Begin
                Get _Win32MemberSizeAlign asTypes[i] bWin64 (iDepth + 1) to sSA
                If (sSA = "") ;
                    Function_Return False
                Move (Pos("|", sSA)) to iBar
                Move (Integer(Left(sSA, (iBar - 1))) * aiCount[i]) to iS
                Move (Integer(Right(sSA, (Length(sSA) - iBar)))) to iA
                If (bPacked = False) Begin
                    If (iPack > 0 and iA > iPack) ;
                        Move iPack to iA
                    If (iA > iMax) ;
                        Move iA to iMax
                    If (Mod(iOff, iA) <> 0) ;
                        Move (iOff + (iA - Mod(iOff, iA))) to iOff
                End
                Move iOff to aiOff[i]
                Move iS   to aiSize[i]
                Move (iOff + iS) to iOff
            End
        Loop
        If (bPacked = False and Mod(iOff, iMax) <> 0) ;
            Move (iOff + (iMax - Mod(iOff, iMax))) to iOff
        If (bPacked = True) ;
            Move 1 to iMax
        Move iOff to iSize
        Move iMax to iAlign
        Function_Return True
    End_Function

    /* A HARVESTED ROW LAID OUT FOR BOTH TARGETS - PROVEN FIRST. The projection is win32metadata's 64-bit
       layout, so this rule earns the right to answer for a 32-bit program by reproducing that one: its
       fillers left out, the real members laid out as Windows does must land where the row's own fillers put
       them, at the same size. Then the same members are laid out for a 32-bit program - byte-packed for
       commdlg.h and shellapi.h.

       A small union is laid out as its bytes, aligned 1: on 64-bit the proof catches a gap it needed in front,
       and on 32-bit it is exact when the struct is byte-packed there, or when the union lands on a multiple
       of 4 in a struct whose other members already align it to 4 - its own alignment is at most 4, so then it
       changes nothing. Anywhere else its alignment is unknown, and the row is not proven (NOTIFYICONDATA is
       the one that matters: a tray icon's struct, proven by the first rule).

       Measured over the catalogue (2026-11-06): 10,854 of the 12,774 harvested rows prove, each one laid out
       right for both targets when read back; the rest hold a large union, nest a struct that does not prove
       (IN_ADDR: a small union alone, alignment unknown), or a type nothing here can size.
       False, with sWhyNot, when it cannot be proven; sSdkName is the row's catalogue name, sBody its
       "Struct ..." text. */
    Function _Win32HarvestedRowLayout String sSdkName String sBody Integer iDepth String[] ByRef asLines ;
            String[] ByRef asTypes Integer[] ByRef aiCount String[] ByRef asNames Boolean[] ByRef abFill ;
            Integer[] ByRef aiOff64 Integer[] ByRef aiSize64 Integer ByRef iSize64 Integer ByRef iAlign64 ;
            Integer[] ByRef aiOff86 Integer[] ByRef aiSize86 Integer ByRef iSize86 Integer ByRef iAlign86 ;
            String ByRef sWhyNot Returns Boolean
        Boolean[] abNone abUnion
        Integer[] aiPk aiPkSize
        String sSA
        Integer i iLast iPkSize iPkAlign iPack86
        Boolean bOK bArch bPack1

        Get _Win32DfBodyMembers sBody (&asLines) (&asTypes) (&aiCount) (&asNames) (&abFill) (&abUnion) (&sWhyNot) to bOK
        If (bOK = False) ;
            Function_Return False
        Get _Win32ArchVariantStruct sSdkName to bArch
        If (bArch = True) Begin
            Move "Windows declares other members for it in a 32-bit program" to sWhyNot
            Function_Return False
        End
        Move (SizeOfArray(asTypes) - 1) to iLast
        For i from 0 to iLast
            Move False to abNone[i]
        Loop
        // The row as DataFlex lays it out: the projection's own 64-bit layout, its fillers included.
        Get _Win32LayoutOffsets (&asTypes) (&aiCount) (&abNone) True True 0 iDepth (&aiPk) (&aiPkSize) (&iPkSize) (&iPkAlign) to bOK
        If (bOK = True) ;
            Get _Win32LayoutOffsets (&asTypes) (&aiCount) (&abFill) True False 0 iDepth (&aiOff64) (&aiSize64) (&iSize64) (&iAlign64) to bOK
        If (bOK = False) Begin
            Move "a member type it cannot size" to sWhyNot
            For i from 0 to iLast
                Get _Win32MemberSizeAlign asTypes[i] True (iDepth + 1) to sSA
                If (sSA = "" and sWhyNot = "a member type it cannot size") ;
                    Move ("its member type " + asTypes[i] + ", which it cannot size") to sWhyNot
            Loop
            Function_Return False
        End
        If (iPkSize <> iSize64) Begin
            Move ("its 64-bit size by the rule here, " + String(iSize64) + ", is not the catalogue's " + String(iPkSize)) to sWhyNot
            Function_Return False
        End
        For i from 0 to iLast
            If (abFill[i] = False and aiOff64[i] <> aiPk[i]) Begin
                Move ("its member " + asNames[i] + " lies at " + String(aiOff64[i]) + " by the rule here and at " + String(aiPk[i]) + " in the catalogue") to sWhyNot
                Function_Return False
            End
        Loop
        Move 0 to iPack86
        Get _Win32Pack1OnX86 sSdkName to bPack1
        If (bPack1 = True) ;
            Move 1 to iPack86
        Get _Win32LayoutOffsets (&asTypes) (&aiCount) (&abFill) False False iPack86 iDepth (&aiOff86) (&aiSize86) (&iSize86) (&iAlign86) to bOK
        If (bOK = False) Begin
            Move "a member type it cannot size for a 32-bit program" to sWhyNot
            Function_Return False
        End
        If (iPack86 = 0) Begin
            For i from 0 to iLast
                If (abUnion[i] = True and (Mod(aiOff86[i], 4) <> 0 or iAlign86 < 4)) Begin
                    Move "it holds a union whose alignment in a 32-bit program is not known here" to sWhyNot
                    Function_Return False
                End
            Loop
        End
        Function_Return True
    End_Function

    // A catalogue row nested as a member, for one target: "size|align", or "" when the row is not a
    // harvested one or its layout cannot be proven (_Win32HarvestedRowLayout).
    Function _Win32HarvestedLayout String sRow Boolean bWin64 Integer iDepth Returns String
        String[] asLines asTypes asNames
        Integer[] aiCount aiOff64 aiSize64 aiOff86 aiSize86
        Boolean[] abFill
        String sName sBody sWhy
        Integer iBar iSize64 iAlign64 iSize86 iAlign86
        Boolean bOK

        Move (Pos("|", sRow)) to iBar
        If (iBar < 2) ;
            Function_Return ""
        Move (Left(sRow, (iBar - 1))) to sName
        Move (Right(sRow, (Length(sRow) - iBar))) to sBody
        If (Left(sBody, 3) <> "DF|") ;
            Function_Return ""
        Move (Right(sBody, (Length(sBody) - 3))) to sBody
        Get _Win32HarvestedRowLayout sName sBody iDepth (&asLines) (&asTypes) (&aiCount) (&asNames) (&abFill) (&aiOff64) (&aiSize64) (&iSize64) (&iAlign64) (&aiOff86) (&aiSize86) (&iSize86) (&iAlign86) (&sWhy) to bOK
        If (bOK = False) ;
            Function_Return ""
        If (bWin64 = True) ;
            Function_Return (String(iSize64) + "|" + String(iAlign64))
        Function_Return (String(iSize86) + "|" + String(iAlign86))
    End_Function

    /* A HARVESTED ROW AS DATAFLEX SOURCE FOR BOTH TARGETS. sBody is the row's "Struct ..." text, renamed and
       with its tabs out; sSdkName its catalogue name.

       PROVEN (_Win32HarvestedRowLayout): the row's own fillers are dropped and the gaps written for both
       targets, as the C path writes them (_Win32FillerLines), named iMissingAlignment<N> as the harvest
       names them. A 32-bit SECURITY_ATTRIBUTES comes out 12 bytes, where the row as harvested made it 20.

       NOT PROVEN (a large union, a type nothing can size, Windows' own 32-bit members differing): the row
       as it is, 64-bit, and a 32-bit compile STOPS at it with the reason (#ERROR in an
       #IFNDEF IS$WIN64) - a wrong layout compiles clean and moves every member after it, so silence is the
       one thing this must not do. The run notes say it too. */
    Function _Win32HarvestedStructDecl String sBody String sSdkName String[] ByRef asNotes Returns String
        String[] asLines asTypes asNames
        Integer[] aiCount aiOff64 aiSize64 aiOff86 aiSize86
        Boolean[] abFill
        String sNl sHead sStruct sOut sWhy
        Integer i iLast iNl iSize64 iAlign64 iSize86 iAlign86 iEnd64 iEnd86 iPad64 iPad86 iFill
        Boolean bOK

        Move (Character(10)) to sNl
        Move (Pos(sNl, sBody)) to iNl
        If (iNl = 0) ;
            Function_Return sBody
        Move (Trim(Replaces((Character(13)), Left(sBody, (iNl - 1)), ""))) to sHead
        Move (Trim(Right(sHead, (Length(sHead) - 7)))) to sStruct
        Get _Win32HarvestedRowLayout sSdkName sBody 0 (&asLines) (&asTypes) (&aiCount) (&asNames) (&abFill) (&aiOff64) (&aiSize64) (&iSize64) (&iAlign64) (&aiOff86) (&aiSize86) (&iSize86) (&iAlign86) (&sWhy) to bOK
        If (bOK = False) Begin
            Move (sHead + sNl + "    // 64-bit layout - win32metadata via Win32_DataFlex_Projection (MIT)") to sOut
            Move (sOut + sNl + (Character(35)) + "IFNDEF IS$WIN64") to sOut
            Move (sOut + sNl + (Character(35)) + "ERROR DFERR_PROGRAM " + '"' + sStruct + ": only its 64-bit layout is known - " + sWhy + '"') to sOut
            Move (sOut + sNl + (Character(35)) + "ENDIF") to sOut
            Move (sOut + sNl + Right(sBody, (Length(sBody) - iNl))) to sOut
            Move (sStruct + " takes Windows' 64-bit layout only (" + sWhy + "); a 32-bit compile stops at it with that reason rather than build a wrong layout") to asNotes[SizeOfArray(asNotes)]
            Function_Return sOut
        End
        Move (sHead + sNl + "    // win32metadata via Win32_DataFlex_Projection (MIT) - its gaps for 32- and 64-bit computed here") to sOut
        Move 0 to iEnd64
        Move 0 to iEnd86
        Move 0 to iFill
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            If (abFill[i] = False) Begin
                Move (aiOff64[i] - iEnd64) to iPad64
                Move (aiOff86[i] - iEnd86) to iPad86
                If (iPad64 > 0 or iPad86 > 0) Begin
                    Increment iFill
                    Move (sOut + _Win32FillerLines(Self, sNl, ("iMissingAlignment" + String(iFill)), iPad64, iPad86)) to sOut
                End
                Move (sOut + sNl + "    " + asLines[i]) to sOut
                Move (aiOff64[i] + aiSize64[i]) to iEnd64
                Move (aiOff86[i] + aiSize86[i]) to iEnd86
            End
        Loop
        Move (iSize64 - iEnd64) to iPad64
        Move (iSize86 - iEnd86) to iPad86
        If (iPad64 > 0 or iPad86 > 0) Begin
            Increment iFill
            Move (sOut + _Win32FillerLines(Self, sNl, ("iMissingAlignment" + String(iFill)), iPad64, iPad86)) to sOut
        End
        Function_Return (sOut + sNl + "End_Struct")
    End_Function

    /* A catalogued Win32 struct as DataFlex source, with alignment made explicit.

       THE RULE, derived from DataFlex's own tWinStructs.pkg and validated by reproducing 49 of its
       57 structs exactly (the rest are cases where the SDK itself carries the padding as a named
       member - see the refusal below):

         layout   plain C on x64. Each member sits at the next offset that is a multiple of its
                  alignment; a scalar aligns to its own size, a nested struct to its WIDEST member.
         interior a gap before a member becomes a filler.
         tail     the struct is padded to its own alignment.
         guard    each target gets its own gaps: DataFlex packs a struct in a 32-bit program too, so a
                  gap both have is a plain filler, a 64-bit-only one sits inside #IFDEF IS$WIN64 (in front
                  of a pointer - what DataFlex's own 74 guarded fillers all are), a 32-bit-only one inside
                  #IFNDEF IS$WIN64, and two different ones are an #IFDEF / #ELSE pair (2026-11-06; until
                  then every filler was guarded, which is wrong after a Char or a Short).
         nested   a struct-typed member is a REFERENCE (tWinFileTime ftCreationTime), never
                  flattened. Flattening is what the legacy Type blocks did and why most of them
                  cannot simply be swapped.

       IT REFUSES rather than guesses, and the refusals matter more than the emissions: an array
       whose bound is a Define this cannot evaluate, a member type with no DataFlex equivalent, or
       an SDK struct that carries its OWN _WIN64 padding member (TBBUTTON's bReserved[6]/[2]) -
       that last one must be mirrored from the SDK, both branches, not computed, and the catalogue
       does not yet keep the second branch. A wrong size does not fail to compile; it moves every
       later field. */
    /* PURE. Splits a source line into its indent, its code, and its trailing "//" comment, so a
       rewrite can put the code back between the two it must not disturb. A converted line that
       loses its author's comment or its indentation reads as a bigger change than it is. */
    /* _CodeOnlyLine, NOT a search of the masked line. _MaskStatementLine turns the "//" ITSELF into
       "##" along with the comment text, so Pos("//", mask) is always 0 and every commented-out line
       came back as live code. Two false refusals on the first workspace that had any: a
       "//Field DEVMODE.dmPanningWidth as dWord" was read as a malformed Field declaration, and a
       "//Put lpDescriptor To sSA at ..." as an unrewritable use of the buffer (2026-08-30).

       _CodeOnlyLine is the codebase's own answer and is quote-aware: it truncates at a "//" that is
       outside a string literal, so a "//" inside one stays. A wholly commented line yields "" here,
       which every caller already treats as nothing to do. */
    Procedure _SplitIndentCodeComment String sLine String ByRef sIndent String ByRef sCode String ByRef sComment
        String sBare
        Integer iCut

        /* ONLY THE BOUNDARY comes from _CodeOnlyLine; the code itself is sliced out of the RAW line.
           That helper BLANKS string contents as well as removing comments - it exists for keyword
           searching, where a literal must not match - so rebuilding a statement from its output
           would quietly empty every string in the file it converted. Its LENGTH is still exactly the
           comment boundary, because blanking preserves length and only the "//" truncates. */
        Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
        Get _CodeOnlyLine sLine to sBare
        Move (Length(sBare)) to iCut
        Move "" to sCode
        If (iCut > Length(sIndent)) ;
            Move (RTrim(Mid(sLine, (iCut - Length(sIndent)), (Length(sIndent) + 1)))) to sCode
        // The comment starts after the last non-space code character, so the run of spaces a writer
        // put between the statement and their "//" belongs to the comment and comes back with it.
        // Trimmed off both, a converted line loses the alignment its author gave it.
        Move (Mid(sLine, Length(sLine), (Length(sIndent) + Length(sCode) + 1))) to sComment
    End_Procedure

    /* ONE legacy byte-buffer statement, rewritten to its struct form. True when it rewrote, False
       when the line is not one of the five shapes (which is not an error - the caller passes every
       line of the cluster through here).

           ZeroType T To B                 ->  Move <empty> to B
           FillType T With 0 To B          ->  Move <empty> to B
           Put V To B At T.m               ->  Move V to B.m
           GetBuff From B At T.m To V      ->  Move B.m to V
           GetAddress Of B To P            ->  Move (AddressOf(B)) to P

       Three more shapes live outside this function: a bare buffer in a declared API's Pointer
       argument is rewritten by _ExternalFnPointerArgRewrite from the cluster walk, Size_of_Field
       on the Type by _Win32TypeSizeLines from the Type pass, and the two TEXT accessors -
       Put_String / GetBuff_String, which need the member's width - by _RewriteWin32TextLine
       (2026-09-13).

       EVERY ONE OF THESE IS FORCED, not a matter of taste: ZeroType, FillType, Put..At and SizeOf
       are all rejected outright by DF26 when their operand is a Struct rather than a String buffer
       (probe-compiled 2026-08-30), while Move-to-member, Move-from-member and AddressOf all compile.
       So there is no version of this conversion that leaves the accessors alone.

       THE ZEROING NEEDS A COMPANION. A struct has no ZeroType, and the shape that does compile is
       assigning another struct variable that has never been written to - so the caller declares one
       empty variable per struct type and passes its name in. That is why sEmptyVar is a parameter
       rather than something invented here: the declaration and the use have to agree, and only the
       caller sees both.

       Keywords are located at paren DEPTH ZERO. "Put (window_handle(focus(desktop))) To sBrowseInfo
       At vtBrowseInfo.hWndOwner" carries a "To"-free but paren-heavy value, and a naive split finds
       the wrong separator on lines like it. */
    Function _RewriteWin32BufferLine String sLine String sType String sBuffer String sEmptyVar ;
            String ByRef sOut Returns Boolean
        String sIndent sCode sComment sLow sVerb sValue sMember sTarget sRest sStructName
        Integer iTo iAt iFrom iWith iOf iPos
        Boolean bSwapped

        // "" unless this Type is being mapped onto a struct the INSTALL ships, in which case the
        // legacy <Type>_size symbol has to become SizeOfType(<that struct>).
        Get _ShippedStructForLegacyType sType to sStructName

        Move "" to sOut
        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        If (Trim(sCode) = "") ;
            Function_Return False
        Move (Lowercase(Trim(sCode))) to sLow

        // ---- ZeroType T To B ------------------------------------------------------------------
        If (Left(sLow, 9) = "zerotype ") Begin
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                Function_Return False
            Move (sIndent + "Move " + sEmptyVar + " to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- FillType T With <x> To B ---------------------------------------------------------
        If (Left(sLow, 9) = "filltype ") Begin
            Get _WordPosAtDepthZero sCode "With" 1 to iWith
            If (iWith = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iWith + 4) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                Function_Return False
            Move (sIndent + "Move " + sEmptyVar + " to " + sTarget + sComment) to sOut
            Function_Return True
        End

        /* ---- Move (Repeat(Character(0), T_SIZE)) To B -------------------------------------------
           ZeroType written out by hand, and it has to produce the same line, because it asks for
           the same thing. Guarded by the cheap substring test first - _ZeroFillBufferForType is
           the one place that decides what counts as this shape, shared with the binder so a line
           can never be bound by one and refused by the other. */
        If (Pos("_size", sLow) > 0) Begin
            Get _ZeroFillBufferForType sCode sType to sTarget
            If (sTarget <> "") Begin
                If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                    Function_Return False
                Move (sIndent + "Move " + sEmptyVar + " to " + sTarget + sComment) to sOut
                Function_Return True
            End
        End

        // ---- Put <value> To B At T.<member> ----------------------------------------------------
        If (Left(sLow, 4) = "put ") Begin
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iAt = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0 or iTo > iAt) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - 5), 5))) to sValue                    // between "Put " and " To "
            /* THE LEGACY SIZE SYMBOL. A Type gave you "<Name>_size" for free; a Struct does not, and
               the install's own modern code reaches for SizeOfType instead ("Move
               (SizeOfType(tWinWindowPlacement)) to WindowPlacement.length", Dfadlg.pkg). Left alone
               it is an undefined symbol - which is exactly how this whole gap announced itself. */
            If (sStructName <> "") ;
                Get _SwapWordInText sValue (sType + "_size") ("(SizeOfType(" + sStructName + "))") to sValue
            Move (Trim(Mid(sCode, (iAt - iTo - 4), (iTo + 3)))) to sTarget     // between " To " and " At "
            Move (Trim(Mid(sCode, Length(sCode), (iAt + 3)))) to sRest         // "<Type>.<member>"
            If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                Function_Return False
            Get _MemberFromAtOperand sRest sType to sMember
            If (sMember = "" or sValue = "") ;
                Function_Return False
            Move (sIndent + "Move " + sValue + " to " + sTarget + "." + sMember + sComment) to sOut
            Function_Return True
        End

        // ---- GetBuff From B At T.<member> To <target> -------------------------------------------
        If (Left(sLow, 8) = "getbuff ") Begin
            Get _WordPosAtDepthZero sCode "From" 1 to iFrom
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iFrom = 0 or iAt = 0 or iAt < iFrom) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iAt + 2) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iAt - iFrom - 6), (iFrom + 5)))) to sValue   // the buffer
            Move (Trim(Mid(sCode, (iTo - iAt - 3), (iAt + 3)))) to sRest        // "<Type>.<member>"
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget        // the receiver
            If (Lowercase(sValue) <> Lowercase(sBuffer)) ;
                Function_Return False
            Get _MemberFromAtOperand sRest sType to sMember
            If (sMember = "" or sTarget = "") ;
                Function_Return False
            Move (sIndent + "Move " + sValue + "." + sMember + " to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- GetAddress Of B To <ptr> ------------------------------------------------------------
        If (Left(sLow, 11) = "getaddress ") Begin
            Get _WordPosAtDepthZero sCode "Of" 1 to iOf
            If (iOf = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iOf + 2) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - iOf - 4), (iOf + 3)))) to sValue
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sValue) <> Lowercase(sBuffer)) ;
                Function_Return False
            If (sTarget = "") ;
                Function_Return False
            Move (sIndent + "Move (AddressOf(" + sValue + ")) to " + sTarget + sComment) to sOut
            Function_Return True
        End

        Function_Return False
    End_Function

    /* The legacy Types Dftypes.pkg declares with ONE field, and the scalar each one is.

       Measured 2026-09-13 against the DF26 install's Dftypes.pkg: 39 TYPE blocks, exactly two of
       them single-field - tDWORD (Field tDWORD.dword As DWord) and tHANDLE (Field tHANDLE.handle As
       Handle) - and neither has a tWin twin, because a struct of one number IS the number. The code
       that uses them asks an API for one value back through a byte buffer: ZeroType, take the
       address, GetBuff the field out. The modern form has no buffer at all - the local is the DWord
       and AddressOf(it) is what the API receives (Nils 2026-09-13: "those commands should never be
       used, that is the goal"). "" for any other name; sMember is the field's name, the only member
       an accessor may name. */
    Function _ShippedScalarForLegacyType String sLegacy String ByRef sMember Returns String
        String sLow

        Move "" to sMember
        Move (Lowercase(Trim(sLegacy))) to sLow
        If (sLow = "tdword") Begin
            Move "dword" to sMember
            Function_Return "DWord"
        End
        If (sLow = "thandle") Begin
            Move "handle" to sMember
            Function_Return "Handle"
        End
        Function_Return ""
    End_Function

    /* ONE legacy byte-buffer statement on a ONE-FIELD Type, rewritten to its scalar form - the
       sibling of _RewriteWin32BufferLine for a buffer that has become a plain local:

           ZeroType T To B                 ->  Move 0 to B
           FillType T With 0 To B          ->  Move 0 to B          (another fill value: not this shape)
           Put V To B At T.m               ->  Move V to B
           GetBuff From B At T.m To V      ->  Move B to V
           GetAddress Of B To P            ->  Move (AddressOf(B)) to P
           <Type>_size in a Put value      ->  (SizeOfType(<scalar>))

       Same keyword walk as the struct rewriter (depth zero, so a "To" inside a value is not the
       separator), and False for any other line, which the cluster walk then judges as it always
       has. The member check - that T.m names the Type's one field - is the caller's, done once per
       Type before any line is touched. */
    Function _RewriteScalarBufferLine String sLine String sType String sBuffer String sScalar ;
            String ByRef sOut Returns Boolean
        String sIndent sCode sComment sLow sValue sMember sTarget sRest sFill
        Integer iTo iAt iFrom iWith iOf

        Move "" to sOut
        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        If (Trim(sCode) = "") ;
            Function_Return False
        Move (Lowercase(Trim(sCode))) to sLow

        // ---- ZeroType T To B ------------------------------------------------------------------
        If (Left(sLow, 9) = "zerotype ") Begin
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                Function_Return False
            Move (sIndent + "Move 0 to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- FillType T With 0 To B -----------------------------------------------------------
        If (Left(sLow, 9) = "filltype ") Begin
            Get _WordPosAtDepthZero sCode "With" 1 to iWith
            If (iWith = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iWith + 4) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - iWith - 5), (iWith + 5)))) to sFill
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sTarget) <> Lowercase(sBuffer) or sFill <> "0") ;
                Function_Return False
            Move (sIndent + "Move 0 to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- Move (Repeat(Character(0), T_SIZE)) To B - ZeroType written out by hand -----------
        If (Pos("_size", sLow) > 0) Begin
            Get _ZeroFillBufferForType sCode sType to sTarget
            If (sTarget <> "") Begin
                If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                    Function_Return False
                Move (sIndent + "Move 0 to " + sTarget + sComment) to sOut
                Function_Return True
            End
        End

        // ---- Put <value> To B At T.<member> ----------------------------------------------------
        If (Left(sLow, 4) = "put ") Begin
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iAt = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0 or iTo > iAt) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - 5), 5))) to sValue
            Get _SwapWordInText sValue (sType + "_size") ("(SizeOfType(" + sScalar + "))") to sValue
            Move (Trim(Mid(sCode, (iAt - iTo - 4), (iTo + 3)))) to sTarget
            Move (Trim(Mid(sCode, Length(sCode), (iAt + 3)))) to sRest
            If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
                Function_Return False
            Get _MemberFromAtOperand sRest sType to sMember
            If (sMember = "" or sValue = "") ;
                Function_Return False
            Move (sIndent + "Move " + sValue + " to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- GetBuff From B At T.<member> To <target> -------------------------------------------
        If (Left(sLow, 8) = "getbuff ") Begin
            Get _WordPosAtDepthZero sCode "From" 1 to iFrom
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iFrom = 0 or iAt = 0 or iAt < iFrom) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iAt + 2) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iAt - iFrom - 6), (iFrom + 5)))) to sValue
            Move (Trim(Mid(sCode, (iTo - iAt - 3), (iAt + 3)))) to sRest
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sValue) <> Lowercase(sBuffer)) ;
                Function_Return False
            Get _MemberFromAtOperand sRest sType to sMember
            If (sMember = "" or sTarget = "") ;
                Function_Return False
            Move (sIndent + "Move " + sValue + " to " + sTarget + sComment) to sOut
            Function_Return True
        End

        // ---- GetAddress Of B To <ptr> ------------------------------------------------------------
        If (Left(sLow, 11) = "getaddress ") Begin
            Get _WordPosAtDepthZero sCode "Of" 1 to iOf
            If (iOf = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iOf + 2) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - iOf - 4), (iOf + 3)))) to sValue
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sTarget
            If (Lowercase(sValue) <> Lowercase(sBuffer)) ;
                Function_Return False
            If (sTarget = "") ;
                Function_Return False
            Move (sIndent + "Move (AddressOf(" + sValue + ")) to " + sTarget + sComment) to sOut
            Function_Return True
        End

        Function_Return False
    End_Function

    /* PURE. The byte WIDTH of a fixed text member as its declared type spells it - "64" from
       "Char[64]", "MAX_PATH" from "Char[MAX_PATH]", kept symbolic and never evaluated - or ""
       with the reason: a WIDE member (Short / UShort / WChar arrays are UTF-16, and the ANSI bytes
       the command wrote would not marshal into them - the struct-split question, which this
       rewrite must not settle by copying), or no block at all (a lone Char is one byte; String and
       Pointer are not blocks). */
    Function _TextMemberBlockSize String sMemberType String ByRef sWhyNot Returns String
        String sLow sBase sCount
        Integer iBr iBr2

        Move "" to sWhyNot
        Move (Lowercase(Trim(sMemberType))) to sLow
        Move (Pos("[", sLow)) to iBr
        Move (Pos("]", sLow)) to iBr2
        If (iBr < 2 or iBr2 <= iBr) Begin
            Move ("its member is " + Trim(sMemberType) + ", not a fixed text block") to sWhyNot
            Function_Return ""
        End
        Move (Left(sLow, (iBr - 1))) to sBase
        Move (Trim(Mid(Trim(sMemberType), (iBr2 - iBr - 1), (iBr + 1)))) to sCount
        If (sBase = "short" or sBase = "ushort" or sBase = "wchar") Begin
            Move ("its member is " + Trim(sMemberType) + ", a WIDE text block - the ANSI bytes the " ;
                + "command wrote would not marshal into it") to sWhyNot
            Function_Return ""
        End
        If (sBase <> "char" and sBase <> "uchar") Begin
            Move ("its member is " + Trim(sMemberType) + ", not a text block") to sWhyNot
            Function_Return ""
        End
        If (sCount = "") Begin
            Move ("its member " + Trim(sMemberType) + " has no fixed size") to sWhyNot
            Function_Return ""
        End
        Function_Return sCount
    End_Function

    /* THE TWO TEXT ACCESSORS, rewritten to what a Struct's fixed text member needs. Measured on
       DF26 x64 (2026-09-13, PutStringProbe) rather than assumed:

           Put_String V To B At T.m         copies min(len, n) bytes and ZERO-FILLS the rest of the
                                            n-byte field; never a terminator when full, never a
                                            byte past the field.
           GetBuff_String From B At T.m To V
                                            hands back exactly n bytes, NULLS KEPT - Trim() and
                                            CString() both cut them, and code downstream relies on
                                            one or the other.

       "Move sText to B.m" COMPILES for a Char[n] member and faults at run time (Error 4381,
       Illegal Datatype Conversion, Nils's dialog), and PointerToString reads past a full member
       into the next one - so neither is the rewrite. What DataFlex's own Font_dlg.pkg does is
       MemCopy, and that is what is emitted, shaped to the measurement:

           Move V to BText
           Move (MemCopy(AddressOf(B.m), AddressOf(BEmpty.m), n)) to BVoid           <- the zero-fill
           Move (MemCopy(AddressOf(B.m), AddressOf(BText), If(SizeOfString(BText) < n, SizeOfString(BText), n))) to BVoid

           Move (Repeat(Character(0), n)) to V
           Move (MemCopy(AddressOf(V), AddressOf(B.m), n)) to BVoid

       BText / BVoid are declared beside the buffer by _DeclLineWithBufferLifted, named after it
       so two buffers in one scope never collide; BEmpty is the never-written twin every struct
       buffer already has, whose member is n zero bytes. The cap is an If() because the install
       ships no Min(). The receiver on the read side must be a plain variable - AddressOf needs one.

       True with sOut when it rewrote; False with sWhyNot when the member cannot take it; False
       with sWhyNot blank when the line is neither command. */
    Function _RewriteWin32TextLine String sLine String sType String sBuffer String sDeclType ;
            String[] ByRef asBody String ByRef sOut String ByRef sWhyNot Returns Boolean
        String sIndent sCode sComment sLow sValue sMember sTarget sRest sMType sN sNl sTextVar sVoidVar sEmptyVar
        Integer iTo iAt iFrom i
        Boolean bPut bGet bPlain bBoundary

        Move "" to sOut
        Move "" to sWhyNot
        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        If (Trim(sCode) = "") ;
            Function_Return False
        Move (Lowercase(Trim(sCode))) to sLow
        Move (Left(sLow, 11) = "put_string ") to bPut
        Move (Left(sLow, 15) = "getbuff_string ") to bGet
        If (bPut = False and bGet = False) ;
            Function_Return False
        Move (Character(10)) to sNl
        Move (sBuffer + "Text")  to sTextVar
        Move (sBuffer + "Void")  to sVoidVar
        Move (sBuffer + "Empty") to sEmptyVar
        If (bPut = True) Begin
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iAt = 0) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0 or iTo > iAt) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iTo - 12), 12))) to sValue                  // between "Put_String " and " To "
            Move (Trim(Mid(sCode, (iAt - iTo - 4), (iTo + 3)))) to sTarget     // between " To " and " At "
            Move (Trim(Mid(sCode, Length(sCode), (iAt + 3)))) to sRest         // "<Type>.<member>"
        End
        Else Begin
            Get _WordPosAtDepthZero sCode "From" 1 to iFrom
            Get _WordPosAtDepthZero sCode "At" 1 to iAt
            If (iFrom = 0 or iAt = 0 or iAt < iFrom) ;
                Function_Return False
            Get _WordPosAtDepthZero sCode "To" (iAt + 2) to iTo
            If (iTo = 0) ;
                Function_Return False
            Move (Trim(Mid(sCode, (iAt - iFrom - 6), (iFrom + 5)))) to sTarget   // the buffer
            Move (Trim(Mid(sCode, (iTo - iAt - 3), (iAt + 3)))) to sRest        // "<Type>.<member>"
            Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sValue        // the receiver
        End
        If (Lowercase(sTarget) <> Lowercase(sBuffer)) ;
            Function_Return False
        Get _MemberFromAtOperand sRest sType to sMember
        If (sMember = "" or sValue = "") ;
            Function_Return False
        // the member's declared type: the emitted body when there is one, else the shipped struct
        Get _StructBodyMemberType (&asBody) sMember to sMType
        If (sMType = "") ;
            Get _ShippedStructMemberType sDeclType sMember to sMType
        If (sMType = "") Begin
            Move ("the text member " + sMember + " is not declared by " + sDeclType) to sWhyNot
            Function_Return False
        End
        Get _TextMemberBlockSize sMType (&sWhyNot) to sN
        If (sN = "") ;
            Function_Return False
        If (bPut = True) Begin
            Move (sIndent + "Move " + sValue + " to " + sTextVar + sComment + sNl ;
                + sIndent + "Move (MemCopy(AddressOf(" + sBuffer + "." + sMember + "), AddressOf(" + sEmptyVar + "." + sMember + "), " + sN + ")) to " + sVoidVar + sNl ;
                + sIndent + "Move (MemCopy(AddressOf(" + sBuffer + "." + sMember + "), AddressOf(" + sTextVar + "), If(SizeOfString(" + sTextVar + ") < " + sN + ", SizeOfString(" + sTextVar + "), " + sN + "))) to " + sVoidVar) to sOut
            Function_Return True
        End
        // the receiver must be a plain variable: AddressOf needs one
        Move True to bPlain
        For i from 1 to (Length(sValue))
            Get _IsWordBoundaryChar (Mid(sValue, 1, i)) to bBoundary
            If (bBoundary = True) ;
                Move False to bPlain
        Loop
        If (bPlain = False) Begin
            Move ("the GetBuff_String receiver " + sValue + " is not a plain variable, and AddressOf needs one") to sWhyNot
            Function_Return False
        End
        Move (sIndent + "Move (Repeat(Character(0), " + sN + ")) to " + sValue + sComment + sNl ;
            + sIndent + "Move (MemCopy(AddressOf(" + sValue + "), AddressOf(" + sBuffer + "." + sMember + "), " + sN + ")) to " + sVoidVar) to sOut
        Function_Return True
    End_Function

    // PURE. What stands between the "(" at iOpen and its own ")" - "" when it never closes.
    Function _TextInsideParens String sText Integer iOpen Returns String
        String sCh
        Integer i iLen iDepth

        Move (Length(sText)) to iLen
        Move 0 to iDepth
        For i from iOpen to iLen
            Move (Mid(sText, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            Else If (sCh = ")") Begin
                Decrement iDepth
                If (iDepth = 0) ;
                    Function_Return (Mid(sText, (i - iOpen - 1), (iOpen + 1)))
            End
        Loop
        Function_Return ""
    End_Function

    // PURE. x, lowercased, when sExpr is AddressOf(x) in however many parentheses - "" when it is not.
    Function _AddressOfOperand String sExpr Returns String
        String sLow

        Move (Lowercase(Trim(sExpr))) to sLow
        While (Left(sLow, 1) = "(" and Right(sLow, 1) = ")")
            Move (Trim(Mid(sLow, (Length(sLow) - 2), 2))) to sLow
        Loop
        If (Left(sLow, 10) = "addressof(" and Right(sLow, 1) = ")") Begin
            Move (Trim(Mid(sLow, (Length(sLow) - 11), 11))) to sLow
            If (_IsPlainIdentifierName(Self, sLow)) ;
                Function_Return sLow
        End
        Function_Return ""
    End_Function

    /* THE VARIABLE BEHIND ONE ARGUMENT of a call on line iCall, lowercased - "" when the argument is an
       expression. A buffer reaches an API three ways: bare, as AddressOf(<buffer>), or through a pointer
       the same method loaded from it. The nearest assignment above the call decides, and only inside the
       method, because real code reuses one pointer for one buffer after another. A name whose nearest
       assignment is not an address comes back as itself, so the caller's question - is this a buffer of
       that Type? - answers no for a pointer loaded from something else, and yes for a buffer passed bare. */
    Function _BufferBehindCallArg String[] ByRef asCode Integer iCall String sArg Returns String
        String sIndent sCode sComment sFirst sName sAssigned sValue
        Integer i iTo

        Get _AddressOfOperand sArg to sName
        If (sName <> "") ;
            Function_Return sName
        Move (Lowercase(Trim(sArg))) to sName
        While (Left(sName, 1) = "(" and Right(sName, 1) = ")")
            Move (Trim(Mid(sName, (Length(sName) - 2), 2))) to sName
        Loop
        If (_IsPlainIdentifierName(Self, sName) = False) ;
            Function_Return ""
        Move (iCall - 1) to i
        While (i >= 0)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Get _NthWord (Lowercase(sCode)) 1 to sFirst
            If (sFirst = "procedure" or sFirst = "function" or sFirst = "end_procedure" or sFirst = "end_function") ;
                Function_Return sName
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo > 0) Begin
                Move (Lowercase(Trim(Mid(sCode, Length(sCode), (iTo + 3))))) to sAssigned
                If (sAssigned = sName) Begin
                    Move (Trim(Left(sCode, (iTo - 1)))) to sValue
                    If (sFirst = "getaddress") ;
                        Function_Return (Lowercase(_NthWord(Self, sValue, 3)))
                    If (sFirst = "move") Begin
                        Move (Trim(Right(sValue, (Length(sValue) - 4)))) to sValue
                        Get _AddressOfOperand sValue to sValue
                        If (sValue <> "") ;
                            Function_Return sValue
                    End
                    Function_Return sName
                End
            End
            Decrement i
        Loop
        Function_Return sName
    End_Function

    /* EVERY VARIABLE THIS FILE HANDS TO A STRUCT PARAMETER OF A WINDOWS API, one row each:
       "<variable, lowercased>|<the struct, as the catalogue names it>|<the function, as the call spells it>".

       ONLY AN External_Function THIS FILE DECLARES, the rule _ExternalFnPointerArgRewrite works by: its
       head names the dll and the entry point, which is the catalogue's key, so nothing here is a guess.
       The row's own "// args:" tail then says which argument takes which struct. An argument the
       catalogue says nothing about proves nothing - RtlMoveMemory copies any bytes, SendMessage carries
       any struct in its lParam - and those Types stay with the name and the member shape.

       Built once per file by the caller: the rows are few, and each Type is looked up among them. */
    Function _Win32CallProofs String[] ByRef asCode Returns String[]
        String[] asOut asHeads asHead asCat asArgs
        String sHead sFlat sPiece sName sWant sProto sStruct sBuf sInside
        Integer i iLast iTo iOpen iNameAt iH iHLast iArg iArgLast
        Boolean bBoundary bDone

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            If (Pos("external_function", Lowercase(asCode[i])) > 0) Begin
                Get _ExternalFnHeadPacked asCode[i] to sHead
                If (sHead <> "") ;
                    Move sHead to asHeads[SizeOfArray(asHeads)]
            End
        Loop
        Move (SizeOfArray(asHeads) - 1) to iHLast
        If (iHLast < 0) ;
            Function_Return asOut
        Get pasWinAPICatalog to asCat
        Move 0 to i
        While (i <= iLast)
            // One statement, its ";" lines joined - _CodeOnlyLine blanks the strings, so a "(" here is code.
            Get _CodeOnlyLine asCode[i] to sFlat
            Move (RTrim(sFlat)) to sFlat
            Move i to iTo
            While (Right(sFlat, 1) = ";" and iTo < iLast)
                Increment iTo
                Get _CodeOnlyLine asCode[iTo] to sPiece
                Move (RTrim(RTrim(Left(sFlat, (Length(sFlat) - 1))) + " " + Trim(sPiece))) to sFlat
            Loop
            Move (Pos("(", sFlat)) to iOpen
            While (iOpen > 0)
                // the identifier ending right before this "(" is the callee; none means a plain group
                Move (iOpen - 1) to iNameAt
                Move False to bDone
                While (iNameAt >= 1 and bDone = False)
                    Get _IsWordBoundaryChar (Mid(sFlat, 1, iNameAt)) to bBoundary
                    If (bBoundary = True) ;
                        Move True to bDone
                    Else ;
                        Decrement iNameAt
                Loop
                Move (Trim(Mid(sFlat, (iOpen - 1 - iNameAt), (iNameAt + 1)))) to sName
                If (sName <> "") Begin
                    Move (Uppercase(sName) + "|") to sWant
                    For iH from 0 to iHLast
                        If (Left(asHeads[iH], Length(sWant)) = sWant) Begin
                            Move (StrSplitToArray(asHeads[iH], "|")) to asHead
                            Get _WinAPIPrototypeFromCat (&asCat) asHead[1] asHead[2] to sProto
                            If (Pos("// args:", sProto) > 0) Begin
                                Get _TextInsideParens sFlat iOpen to sInside
                                Get _SplitCallArgs sInside to asArgs
                                Move (SizeOfArray(asArgs) - 1) to iArgLast
                                For iArg from 0 to iArgLast
                                    Get _WinAPIArgStructOf sProto (iArg + 1) to sStruct
                                    If (sStruct <> "") Begin
                                        Get _BufferBehindCallArg (&asCode) i asArgs[iArg] to sBuf
                                        If (sBuf <> "") ;
                                            Move (sBuf + "|" + sStruct + "|" + sName) to asOut[SizeOfArray(asOut)]
                                    End
                                Loop
                            End
                        End
                    Loop
                End
                Move (Pos("(", sFlat, (iOpen + 1))) to iOpen
            Loop
            Move (iTo + 1) to i
        Loop
        Function_Return asOut
    End_Function

    /* The struct the calls prove for these buffers - "" when no call does, or when two calls name two
       structs, which is not a proof of either. sApi is the function that proved it. */
    Function _Win32StructProvenByCalls String[] ByRef asProofs String[] ByRef asBuffers String ByRef sApi Returns String
        String[] asRow
        String sFound
        Integer i iLast j jLast

        Move "" to sApi
        Move "" to sFound
        Move (SizeOfArray(asProofs) - 1) to iLast
        Move (SizeOfArray(asBuffers) - 1) to jLast
        For i from 0 to iLast
            Move (StrSplitToArray(asProofs[i], "|")) to asRow
            For j from 0 to jLast
                If (asRow[0] = Lowercase(Trim(asBuffers[j]))) Begin
                    If (sFound <> "" and sFound <> asRow[1]) ;
                        Function_Return ""
                    Move asRow[1] to sFound
                    Move asRow[2] to sApi
                End
            Loop
        Loop
        Function_Return sFound
    End_Function

    /* PURE. A member type's width in a 32-bit program, which is what a legacy Type block was written for, and
       so what a flattened Type can be held to: 0 when it cannot be said. An array counts as its base type,
       because its bound is as often a constant (Char vMax_Path) as a number. */
    Function _Win32Width32 String sType Returns Integer
        String sLow
        Integer iBr

        Move (Lowercase(Trim(sType))) to sLow
        Move (Pos("[", sLow)) to iBr
        If (iBr > 1) ;
            Move (Left(sLow, (iBr - 1))) to sLow
        If (sLow = "char" or sLow = "uchar") ;
            Function_Return 1
        If (sLow = "short" or sLow = "ushort" or sLow = "word") ;
            Function_Return 2
        If (sLow = "integer" or sLow = "uinteger" or sLow = "dword" or sLow = "boolean" or sLow = "handle" ;
            or sLow = "pointer" or sLow = "address" or sLow = "longptr" or sLow = "ulongptr") ;
            Function_Return 4
        If (sLow = "bigint" or sLow = "ubigint") ;
            Function_Return 8
        Function_Return 0
    End_Function

    /* A Type's member paths and types as it writes them: "PT.x" for "Field T.PT.x As DWord", with a bound
       as "Char[14]". _LegacyTypeMemberNames refuses a dotted name; this is the reading that lets a caller
       decide what to do about one. False when a line is not a Field of this Type. */
    Function _LegacyMemberPaths String[] ByRef asCode Integer iStart Integer iEnd String sType ;
            String[] ByRef asPaths String[] ByRef asTypes Returns Boolean
        String sIndent sCode sComment sLine sBare sDt sCt sName
        Integer i iDot
        Boolean bField

        Move (ResizeArray(asPaths, 0)) to asPaths
        Move (ResizeArray(asTypes, 0)) to asTypes
        For i from (iStart + 1) to (iEnd - 1)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Trim(sCode)) to sLine
            If (sLine <> "") Begin
                Get _NthWord sLine 2 to sName
                Move (Pos(".", sName)) to iDot
                If (iDot > 0 and Lowercase(Left(sName, (iDot - 1))) <> Lowercase(Trim(sType))) ;
                    Function_Return False
                Get _ParseTypeField sLine (&sBare) (&sDt) (&sCt) to bField
                If (bField = False) ;
                    Function_Return False
                If (sCt <> "") ;
                    Move (sDt + "[" + sCt + "]") to sDt
                Move sBare to asPaths[SizeOfArray(asPaths)]
                Move sDt   to asTypes[SizeOfArray(asTypes)]
            End
        Loop
        Function_Return (SizeOfArray(asPaths) > 0)
    End_Function

    // Adds a shipped struct's members under sPrefix ("pt.x"), a nested tWin struct's members in its place.
    Procedure _AddShippedLeaves String sStruct String sPrefix String[] ByRef asLeaves String[] ByRef asTypes
        String[] asNames
        String sType
        Integer i iLast
        Boolean bFound

        Get _ShippedStructMembers sStruct (&asNames) to bFound
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            // tWinStructs.pkg spells its fillers both iMissingAlignment and iMissingAligment.
            If (Pos("missingalig", Lowercase(asNames[i])) = 0) Begin
                Get _ShippedStructMemberType sStruct asNames[i] to sType
                If (Lowercase(Left(sType, 4)) = "twin") Begin
                    Send _AddShippedLeaves sType (sPrefix + "." + asNames[i]) (&asLeaves) (&asTypes)
                End
                Else Begin
                    Move (sPrefix + "." + asNames[i]) to asLeaves[SizeOfArray(asLeaves)]
                    Move sType to asTypes[SizeOfArray(asTypes)]
                End
            End
        Loop
    End_Procedure

    /* A STRUCT DECLARATION'S MEMBERS, WITH THE NESTED ONES WRITTEN OUT: MSG's "POINT pt" gives pt.x and pt.y,
       under the names of the tWin struct the emission will actually use. asTop holds its own members, and
       aiCount how many leaves each one is. False when a nested member has no shipped twin, or is an array:
       nothing here could then be reached under a name that compiles. */
    Function _Win32StructLeaves String sDecl String[] ByRef asLeaves String[] ByRef asTypes ;
            String[] ByRef asTop Integer[] ByRef aiCount Returns Boolean
        String[] asLines
        String sLine sLow sType sName sBase sTwin
        Integer i iLast iBr iAt iBefore
        Boolean bFiller bScalar

        Move (ResizeArray(asLeaves, 0)) to asLeaves
        Move (ResizeArray(asTypes, 0)) to asTypes
        Move (ResizeArray(asTop, 0)) to asTop
        Move (ResizeArray(aiCount, 0)) to aiCount
        Move (StrSplitToArray(Replaces((Character(13)), sDecl, ""), (Character(10)))) to asLines
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asLines[i])) to sLine
            Move (Lowercase(sLine)) to sLow
            If (sLine <> "" and Left(sLow, 7) <> "struct " and sLow <> "end_struct" and Left(sLow, 2) <> "//" and Left(sLine, 1) <> "#") Begin
                // Message form: both sit below this function in the file (4367).
                Get _IsAlignmentFillerLine sLine to bFiller
                If (bFiller = False) Begin
                    Move (Pos("//", sLine)) to iAt
                    If (iAt > 0) ;
                        Move (Trim(Left(sLine, (iAt - 1)))) to sLine
                    Get _NthWord sLine 1 to sType
                    Get _NthWord sLine 2 to sName
                    Move sType to sBase
                    Move (Pos("[", sType)) to iBr
                    If (iBr > 1) ;
                        Move (Left(sType, (iBr - 1))) to sBase
                    Move (SizeOfArray(asLeaves)) to iBefore
                    Get _IsWinStructScalarType sBase to bScalar
                    If (bScalar = True) Begin
                        Move sName to asLeaves[SizeOfArray(asLeaves)]
                        Move sType to asTypes[SizeOfArray(asTypes)]
                    End
                    Else Begin
                        Get _ShippedStructNameFor sBase to sTwin
                        If (sTwin = "" or iBr > 1) ;
                            Function_Return False
                        Send _AddShippedLeaves sTwin sName (&asLeaves) (&asTypes)
                    End
                    Move sName to asTop[SizeOfArray(asTop)]
                    Move (SizeOfArray(asLeaves) - iBefore) to aiCount[SizeOfArray(aiCount)]
                End
            End
        Loop
        Function_Return (SizeOfArray(asLeaves) > 0)
    End_Function

    /* A TYPE THAT WRITES OUT WHAT WINDOWS NESTS (Nils 2026-11-04). "Type tMSG" with ptX and ptY where MSG has
       one "POINT pt", WIN32_FIND_DATA's three FILETIMEs as six DWords, 'Field PAGESETUPDLG.ptPaperSize.x'. The
       member count disagrees with the struct, so it was refused - but the count disagrees for a reason that can
       be checked: write the struct's nested members out too, and the two lists are the same length.

       POSITION IS THE ONLY CORRESPONDENCE, because the names often differ (ftCreationLowDateTime against
       ftCreationTime.dwLowDateTime). So each pair must also agree in width on 32-bit, which is what a legacy
       block was written for: a Word where the struct has a 4-byte member means the lists only look alike.

       A UNION DOES NOT FIT, and stays refused. DEVMODE and SYSTEM_INFO write out the members of a union the
       catalogue holds as one byte block, so there is nothing to pair them with.

       True with asNames, one for each of the struct's own members - the Type's name for a plain one, the SDK's
       for a nested one - and asMap, "<old member>|<new member>" for each member reached differently now. */
    Function _Win32FlatMemberMap String[] ByRef asCode Integer iStart Integer iEnd String sType String sSdkDecl ;
            String[] ByRef asNames String[] ByRef asMap Returns Boolean
        String[] asPaths asTypes asLeaves asLeafTypes asTop
        Integer[] aiCount
        Integer i iLast iTop iTopLast iAt iJ iWidthA iWidthB
        Boolean bOK

        Move (ResizeArray(asNames, 0)) to asNames
        Move (ResizeArray(asMap, 0)) to asMap
        Get _LegacyMemberPaths (&asCode) iStart iEnd sType (&asPaths) (&asTypes) to bOK
        If (bOK = False) ;
            Function_Return False
        Get _Win32StructLeaves sSdkDecl (&asLeaves) (&asLeafTypes) (&asTop) (&aiCount) to bOK
        If (bOK = False) ;
            Function_Return False
        If (SizeOfArray(asPaths) <> SizeOfArray(asLeaves) or SizeOfArray(asLeaves) <= SizeOfArray(asTop)) ;
            Function_Return False
        Move (SizeOfArray(asPaths) - 1) to iLast
        For i from 0 to iLast
            Get _Win32Width32 asTypes[i] to iWidthA
            Get _Win32Width32 asLeafTypes[i] to iWidthB
            If (iWidthA > 0 and iWidthB > 0 and iWidthA <> iWidthB) ;
                Function_Return False
        Loop
        Move 0 to iAt
        Move (SizeOfArray(asTop) - 1) to iTopLast
        For iTop from 0 to iTopLast
            If (aiCount[iTop] = 1 and Pos(".", asLeaves[iAt]) = 0) Begin
                // A plain member keeps the Type's name, as in every other conversion here.
                If (Pos(".", asPaths[iAt]) > 0) ;
                    Function_Return False
                Move asPaths[iAt] to asNames[iTop]
                Increment iAt
            End
            Else Begin
                Move asTop[iTop] to asNames[iTop]
                For iJ from 1 to aiCount[iTop]
                    If (Lowercase(asPaths[iAt]) <> Lowercase(asLeaves[iAt])) ;
                        Move (asPaths[iAt] + "|" + asLeaves[iAt]) to asMap[SizeOfArray(asMap)]
                    Increment iAt
                Loop
            End
        Loop
        Function_Return True
    End_Function

    /* A DOTTED TYPE THE CATALOGUE HAS NEVER HEARD OF. 'Field tLVHITTESTINFO.PT.x As DWord' writes nesting a
       Struct can only declare with a type of its own, and nothing says which - most of these are notification
       and hit-test structs no API prototype mentions. It keeps its own member types like any uncatalogued Type,
       with the dots joined (PT_x). Structs are packed under the same offset rule as Type, so the bytes do not
       move. True with asMap ("PT.x|PT_x") when it has a dotted member and the joined names are free. */
    Function _OwnDottedMemberMap String[] ByRef asCode Integer iStart Integer iEnd String sType String[] ByRef asMap Returns Boolean
        String[] asPaths asTypes asLow
        String sJoined
        Integer i iLast
        Boolean bOK

        Move (ResizeArray(asMap, 0)) to asMap
        Get _LegacyMemberPaths (&asCode) iStart iEnd sType (&asPaths) (&asTypes) to bOK
        If (bOK = False) ;
            Function_Return False
        Move (SizeOfArray(asPaths) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(asPaths[i])) to asLow[i]
        Loop
        For i from 0 to iLast
            If (Pos(".", asPaths[i]) > 0) Begin
                Move (Replaces(".", asPaths[i], "_")) to sJoined
                If (SearchArray(Lowercase(sJoined), asLow) <> -1) Begin
                    Move (ResizeArray(asMap, 0)) to asMap
                    Function_Return False
                End
                Move (asPaths[i] + "|" + sJoined) to asMap[SizeOfArray(asMap)]
            End
        Loop
        Function_Return (SizeOfArray(asMap) > 0)
    End_Function

    // asStmt with each buffer command's "At" operand renamed by asMap, so the rewriters read the new member.
    Procedure _RemapAtOperands String[] ByRef asStmt String sType String[] ByRef asMap
        String[] asRow
        String sIndent sCode sComment sFirst sOperand sMember sPrefix
        Integer i iLast iAt iFrom j jLast

        Move (Lowercase(Trim(sType)) + ".") to sPrefix
        Move (SizeOfArray(asStmt) - 1) to iLast
        Move (SizeOfArray(asMap) - 1) to jLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asStmt[i] (&sIndent) (&sCode) (&sComment)
            Get _NthWord (Lowercase(sCode)) 1 to sFirst
            If (sFirst = "put" or sFirst = "put_string" or sFirst = "getbuff" or sFirst = "getbuff_string") Begin
                Get _WordPosAtDepthZero sCode "At" 1 to iAt
                If (iAt > 0) Begin
                    Get _NthWord (Mid(sCode, Length(sCode), (iAt + 2))) 1 to sOperand
                    Move sOperand to sMember
                    If (Lowercase(Left(sOperand, Length(sPrefix))) = sPrefix) ;
                        Move (Right(sOperand, (Length(sOperand) - Length(sPrefix)))) to sMember
                    For j from 0 to jLast
                        Move (StrSplitToArray(asMap[j], "|")) to asRow
                        If (Lowercase(asRow[0]) = Lowercase(sMember)) Begin
                            Move (Pos(sOperand, sCode, (iAt + 2))) to iFrom
                            Move (sIndent + Left(sCode, (iFrom - 1)) + Left(sOperand, (Length(sOperand) - Length(sMember))) + asRow[1] ;
                                + Mid(sCode, Length(sCode), (iFrom + Length(sOperand))) + sComment) to asStmt[i]
                        End
                    Loop
                End
            End
        Loop
    End_Procedure

    // PURE. The run note's list: "PT.x is now PT_x, PT.y is now PT_y".
    Function _MemberMapText String[] ByRef asMap Returns String
        String[] asRow
        String sOut
        Integer i iLast

        Move "" to sOut
        Move (SizeOfArray(asMap) - 1) to iLast
        For i from 0 to iLast
            Move (StrSplitToArray(asMap[i], "|")) to asRow
            Move (sOut + If((sOut = ""), "", ", ") + asRow[0] + " is now " + asRow[1]) to sOut
        Loop
        Function_Return sOut
    End_Function

    /* DOES ANY API TAKE THIS STRUCT? The function catalogue's "// refs:" tails say. PURE apart from the read.

       It decides what a name can prove. MENUITEMINFOA has APIs, so a Type that lists only its first members and
       is handed to none of them is a buffer nobody can vouch for. LVITEMA has none, and never will: it travels
       only through SendMessage's lParam, which no prototype types, so no call in any file can ever prove it. */
    Function _WinAPIStructHasAnApi String sSdkName Returns Boolean
        String[] asCat
        String sWant sRefs
        Integer i iLast

        Move (" " + Lowercase(Trim(sSdkName)) + " ") to sWant
        Get pasWinAPICatalog to asCat
        Move (SizeOfArray(asCat) - 1) to iLast
        For i from 0 to iLast
            If (Pos("// refs:", asCat[i]) > 0) Begin
                Get _WinAPIRefsOf asCat[i] to sRefs
                If (Pos(sWant, (" " + Lowercase(sRefs) + " ")) > 0) ;
                    Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    /* DOES THIS TYPE FIT THE STRUCT ITS NAME FOUND, WHEN NO CALL CAN EVER SAY? For a struct no API takes.

       THE CATALOGUE GREW FROM 2,287 STRUCTS TO 12,787, and a name that hits a row now may be a coincidence:
       the projection has rows called VAL, CAL, TINT, BLUR and DAILY. So a miss here is not a refusal. Before that
       row existed the Type converted on its own member types, and it still does: a bigger catalogue can only add
       (found on real files: tLVCOLUMN and tLVHITTESTINFO went from converted to refused before this existed).

       THREE WAYS TO FIT:
         - the same count, with at least half the member names agreeing, by their last word. Position decides the
           layout, as everywhere here, so "at least half" is what tells that struct from another of that name.
         - that, with what the struct nests written out (_Win32FlatMemberMap). tNM_LISTVIEW is NMLISTVIEW.
         - fewer than the struct has, every name agreeing in order, at least CI_WinAPIShapeMatchMinMembers of them,
           stopping where one of the struct's own members ends. tLV_ITEM is the first 10 of LVITEMA's 15. It
           becomes the WHOLE struct: bigger is the safe direction, and no later member can be misread as padding.
           asShortNames then holds the names and sShortMissing what was added.

       And whatever the way, the emission has to be writable: every nested member needs a shipped twin. */
    Function _Win32FitsStructNoApiTakes String[] ByRef asCode Integer iStart Integer iEnd String sType ;
            String sSdkDecl String sSdkName String[] ByRef asShortNames String[] ByRef asShortMap ;
            String ByRef sShortMissing Returns Boolean
        String[] asPaths asTypes asLeaves asLeafTypes asTop asNames asMap asBody
        Integer[] aiCount
        String sWhy sA sB
        Integer i iLast iAgree iPaths iAt iTop iTopLast iWidthA iWidthB iDot
        Boolean bOK

        Move (ResizeArray(asShortNames, 0)) to asShortNames
        Move (ResizeArray(asShortMap, 0)) to asShortMap
        Move "" to sShortMissing
        Get _LegacyMemberPaths (&asCode) iStart iEnd sType (&asPaths) (&asTypes) to bOK
        If (bOK = False) ;
            Function_Return False
        Get _Win32StructLeaves sSdkDecl (&asLeaves) (&asLeafTypes) (&asTop) (&aiCount) to bOK
        If (bOK = False) ;
            Function_Return False
        Move (SizeOfArray(asPaths)) to iPaths
        If (iPaths > SizeOfArray(asLeaves)) ;
            Function_Return False

        If (iPaths = SizeOfArray(asLeaves)) Begin
            Move 0 to iAgree
            For i from 0 to (iPaths - 1)
                Move (Lowercase(asPaths[i])) to sA
                Move (RightPos(".", sA)) to iDot
                If (iDot > 0) ;
                    Move (Right(sA, (Length(sA) - iDot))) to sA
                Move (Lowercase(asLeaves[i])) to sB
                Move (RightPos(".", sB)) to iDot
                If (iDot > 0) ;
                    Move (Right(sB, (Length(sB) - iDot))) to sB
                If (sA = sB) ;
                    Increment iAgree
            Loop
            If ((iAgree * 2) < iPaths) ;
                Function_Return False
            Get _Win32FlatMemberMap (&asCode) iStart iEnd sType sSdkDecl (&asNames) (&asMap) to bOK
            If (bOK = False) ;
                Get _LegacyTypeMemberNames (&asCode) iStart iEnd sType (&asNames) (&sWhy) to bOK
            If (bOK = False) ;
                Function_Return False
            Get _Win32StructBodyFromLegacy (&asNames) sSdkDecl (&asBody) (&sWhy) sSdkName to bOK
            Function_Return bOK
        End

        If (iPaths < CI_WinAPIShapeMatchMinMembers) ;
            Function_Return False
        Move (iPaths - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(asPaths[i]) <> Lowercase(asLeaves[i])) ;
                Function_Return False
            Get _Win32Width32 asTypes[i] to iWidthA
            Get _Win32Width32 asLeafTypes[i] to iWidthB
            If (iWidthA > 0 and iWidthB > 0 and iWidthA <> iWidthB) ;
                Function_Return False
        Loop
        Move 0 to iAt
        Move (SizeOfArray(asTop) - 1) to iTopLast
        For iTop from 0 to iTopLast
            If (iAt >= iPaths) Begin
                Move asTop[iTop] to asNames[iTop]
                Move (sShortMissing + If((sShortMissing = ""), "", ", ") + asTop[iTop]) to sShortMissing
            End
            Else If (aiCount[iTop] = 1 and Pos(".", asLeaves[iAt]) = 0) Begin
                Move asPaths[iAt] to asNames[iTop]
                Increment iAt
            End
            Else Begin
                // A nested member is all there or not at all: half a POINT is not a place to stop.
                If ((iAt + aiCount[iTop]) > iPaths) Begin
                    Move "" to sShortMissing
                    Function_Return False
                End
                Move asTop[iTop] to asNames[iTop]
                Move (iAt + aiCount[iTop]) to iAt
            End
        Loop
        Get _Win32StructBodyFromLegacy (&asNames) sSdkDecl (&asBody) (&sWhy) sSdkName to bOK
        If (bOK = False) Begin
            Move "" to sShortMissing
            Function_Return False
        End
        Move asNames to asShortNames
        Function_Return True
    End_Function

    // PURE. Nothing but the digits 0-9, and at least one of them.
    Function _IsAllDigits String sText Returns Boolean
        Integer i iLen iAsc

        Move (Length(sText)) to iLen
        If (iLen = 0) ;
            Function_Return False
        For i from 1 to iLen
            Move (Ascii(Mid(sText, 1, i))) to iAsc
            If (iAsc < 48 or iAsc > 57) ;
                Function_Return False
        Loop
        Function_Return True
    End_Function

    /* The size in bytes of a harvested struct, 0 when it cannot be said. A DF row already holds its own alignment
       fillers, so the size is the sum of its lines. Only scalars and arrays with a number for a bound count: a
       nested struct or a bound that is a constant gets no answer rather than a guess. */
    Function _Win32CatalogStructBytes String sName Returns Integer
        String[] asLines
        String sBody sLine sLow sType sBound sSize
        Integer i iLast iBar iBr iSum iCount iUnit

        Get WinAPIStructBody sName to sBody
        If (Left(sBody, 3) <> "DF|") ;
            Function_Return 0
        Move (StrSplitToArray(Replaces((Character(13)), sBody, ""), (Character(10)))) to asLines
        Move 0 to iSum
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asLines[i])) to sLine
            Move (Lowercase(sLine)) to sLow
            If (sLine <> "" and Left(sLow, 10) <> "df|struct " and Left(sLow, 7) <> "struct " and sLow <> "end_struct" and Left(sLow, 2) <> "//") Begin
                Get _NthWord sLine 1 to sType
                Move 1 to iCount
                Move (Pos("[", sType)) to iBr
                If (iBr > 1) Begin
                    Move (Replaces("]", Right(sType, (Length(sType) - iBr)), "")) to sBound
                    If (_IsAllDigits(Self, sBound) = False) ;
                        Function_Return 0
                    Move sBound to iCount
                    Move (Left(sType, (iBr - 1))) to sType
                End
                Get _DfTypeSizeAlign sType 0 to sSize
                Move (Pos("|", sSize)) to iBar
                If (iBar = 0) ;
                    Function_Return 0
                Move (Left(sSize, (iBar - 1))) to iUnit
                Move (iSum + (iUnit * iCount)) to iSum
            End
        Loop
        Function_Return iSum
    End_Function

    /* A MEMBER NOBODY READS, WRITTEN AS THE BYTES IT TAKES UP (Nils 2026-11-04). NOTIFYICONDATA ends in a GUID,
       and DataFlex ships no struct for one, so a Type that lists only its first members could not take the
       whole struct: it fell back to its own member types, with hwnd at offset 4 where 64-bit Windows has it at
       8. But a member past the end of what the Type lists has no accessor anywhere, so all the Struct has to
       get right is how much room it takes. sDecl with each such member from member iFrom on (counted from 0)
       as "UChar[16] guidItem  // Guid". A member the catalogue cannot size stays as it is, and the caller's
       body check then refuses it. Where a 32-bit program's count differs - a pointer inside - the two come
       as an IS$WIN64 pair; the directive lines of the declaration (its guarded fillers) are not members. */
    Function _Win32OpaqueTailMembers String sDecl Integer iFrom Returns String
        String[] asLines
        String sOut sLine sLow sType sName sBase sTwin sSA86
        Integer i iLast iReal iBr iAt iBytes iBytes86
        Boolean bFiller bScalar

        Move (StrSplitToArray(Replaces((Character(13)), sDecl, ""), (Character(10)))) to asLines
        Move 0 to iReal
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asLines[i])) to sLine
            Move (Lowercase(sLine)) to sLow
            If (sLine <> "" and Left(sLow, 7) <> "struct " and sLow <> "end_struct" and Left(sLow, 2) <> "//" and Left(sLine, 1) <> "#") Begin
                Get _IsAlignmentFillerLine sLine to bFiller
                If (bFiller = False) Begin
                    If (iReal >= iFrom) Begin
                        Move (Pos("//", sLine)) to iAt
                        If (iAt > 0) ;
                            Move (Trim(Left(sLine, (iAt - 1)))) to sLine
                        Get _NthWord sLine 1 to sType
                        Get _NthWord sLine 2 to sName
                        Move sType to sBase
                        Move (Pos("[", sType)) to iBr
                        If (iBr > 1) ;
                            Move (Left(sType, (iBr - 1))) to sBase
                        Get _IsWinStructScalarType sBase to bScalar
                        If (bScalar = False and iBr = 0) Begin
                            Get _ShippedStructNameFor sBase to sTwin
                            If (sTwin = "") Begin
                                Get _Win32CatalogStructBytes sBase to iBytes
                                If (iBytes > 0) Begin
                                    Move iBytes to iBytes86
                                    Get _Win32MemberSizeAlign sBase False 0 to sSA86
                                    If (sSA86 <> "") ;
                                        Move (Integer(Left(sSA86, (Pos("|", sSA86) - 1)))) to iBytes86
                                    If (iBytes86 = iBytes) Begin
                                        Move ("UChar[" + String(iBytes) + "] " + sName + "  // " + sBase) to asLines[i]
                                    End
                                    Else Begin
                                        Move ((Character(35)) + "IFDEF IS$WIN64" + (Character(10)) + "    UChar[" + String(iBytes) + "] " + sName + "  // " + sBase ;
                                            + (Character(10)) + (Character(35)) + "ELSE" + (Character(10)) + "    UChar[" + String(iBytes86) + "] " + sName + "  // " + sBase ;
                                            + (Character(10)) + (Character(35)) + "ENDIF") to asLines[i]
                                    End
                                End
                            End
                        End
                    End
                    Increment iReal
                End
            End
        Loop
        Move "" to sOut
        For i from 0 to iLast
            Move (sOut + If((i = 0), "", Character(10)) + asLines[i]) to sOut
        Loop
        Function_Return sOut
    End_Function

    // The name a Procedure or Function header declares, lowercased - "" for any other line. PURE.
    Function _MethodHeaderName String sCode Returns String
        String sLow sFirst sName

        Move (Lowercase(Trim(sCode))) to sLow
        Get _NthWord sLow 1 to sFirst
        If (sFirst <> "procedure" and sFirst <> "function") ;
            Function_Return ""
        Get _NthWord sLow 2 to sName
        If (sName = "set") ;
            Get _NthWord sLow 3 to sName
        Function_Return sName
    End_Function

    // PURE. Where a method header declares this name as a String parameter ('string sStruct') - 0 if it does not.
    Function _HeaderStringParamPos String sCode String sBuffer Returns Integer
        String sLow sAfter
        Integer iAt iNext

        Move (Lowercase(sCode)) to sLow
        Move 1 to iNext
        Repeat
            Get _FindKeywordPos sLow "string" True iNext to iAt
            If (iAt > 0) Begin
                Get _NthWord (Mid(sLow, Length(sLow), (iAt + 6))) 1 to sAfter
                If (sAfter = Lowercase(Trim(sBuffer))) ;
                    Function_Return iAt
                Move (iAt + 6) to iNext
            End
        Until (iAt = 0)
        Function_Return 0
    End_Function

    // Is sWord one of these buffers, whatever its case? PURE.
    Function _IsWin32BufferName String sWord String[] ByRef asBuffers Returns Boolean
        Integer i iLast

        Move (SizeOfArray(asBuffers) - 1) to iLast
        For i from 0 to iLast
            If (Lowercase(Trim(asBuffers[i])) = Lowercase(Trim(sWord))) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // True when no code line of this file but the method's own header names it, and no other file does.
    Function _Win32MethodIsUncalled String[] ByRef asCode Integer iHeader String sMethod Returns Boolean
        String sCode sReader
        Integer i iLast iAt

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            If (i <> iHeader and Pos(sMethod, Lowercase(asCode[i])) > 0) Begin
                Get _CodeOnlyLine asCode[i] to sCode
                Get _FindKeywordPos (Lowercase(sCode)) sMethod True 1 to iAt
                If (iAt > 0) ;
                    Function_Return False
            End
        Loop
        Get _FileReadingTypeElsewhere sMethod to sReader
        Function_Return (sReader = "")
    End_Function

    /* MAY THIS FUNCTION RETURN THE STRUCT? True, with the variables receiving it added to asBuffers, only when:
       it returns String, every Function_Return in it names a buffer, every other mention in this file is
       'Get <it> ... to <a String local>', and no other file names it. Anything else - a second definition, an
       expression call - leaves its Function_Return line for the cluster walk to refuse, naming the line. */
    Function _Win32FlowOfReturn String[] ByRef asCode Integer iHeader String sMethod String[] ByRef asBuffers Returns Boolean
        String[] asReceivers
        String sIndent sCode sComment sLow sFirst sWord sVar sReader
        Integer i iLast iAt iTo iDeclAt
        Boolean bKnown bIn

        Send _SplitIndentCodeComment asCode[iHeader] (&sIndent) (&sCode) (&sComment)
        Move (Lowercase(sCode)) to sLow
        Get _FindKeywordPos sLow "returns" True 1 to iAt
        If (iAt = 0) ;
            Function_Return False
        If (Trim(Mid(sLow, Length(sLow), (iAt + 7))) <> "string") ;
            Function_Return False
        Move (SizeOfArray(asCode) - 1) to iLast
        Move True to bIn
        For i from (iHeader + 1) to iLast
            If (bIn = True) Begin
                Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
                Get _NthWord (Lowercase(sCode)) 1 to sFirst
                If (sFirst = "end_function") ;
                    Move False to bIn
                If (sFirst = "function_return") Begin
                    Get _NthWord sCode 2 to sWord
                    Get _IsWin32BufferName sWord (&asBuffers) to bKnown
                    If (bKnown = False) ;
                        Function_Return False
                End
            End
        Loop
        For i from 0 to iLast
            If (i <> iHeader and Pos(sMethod, Lowercase(asCode[i])) > 0) Begin
                Get _CodeOnlyLine asCode[i] to sCode
                Move (Lowercase(sCode)) to sLow
                Get _FindKeywordPos sLow sMethod True 1 to iAt
                If (iAt > 0) Begin
                    Get _NthWord sLow 1 to sFirst
                    Get _NthWord sLow 2 to sWord
                    If (sFirst <> "get" or sWord <> sMethod) ;
                        Function_Return False
                    Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
                    Get _WordPosAtDepthZero sCode "To" 1 to iTo
                    If (iTo = 0) ;
                        Function_Return False
                    Move (Trim(Mid(sCode, Length(sCode), (iTo + 3)))) to sVar
                    If (_IsPlainIdentifierName(Self, sVar) = False) ;
                        Function_Return False
                    Get _BufferDeclLineIdx (&asCode) sVar to iDeclAt
                    If (iDeclAt = -1) ;
                        Function_Return False
                    Move sVar to asReceivers[SizeOfArray(asReceivers)]
                End
            End
        Loop
        Get _FileReadingTypeElsewhere sMethod to sReader
        If (sReader <> "") ;
            Function_Return False
        Move (SizeOfArray(asReceivers) - 1) to iLast
        For i from 0 to iLast
            Get _IsWin32BufferName asReceivers[i] (&asBuffers) to bKnown
            If (bKnown = False) ;
                Move asReceivers[i] to asBuffers[SizeOfArray(asBuffers)]
        Loop
        Function_Return True
    End_Function

    // The lines that can open or close a method or return from one: what _Win32BufferFlow reads. PURE.
    Function _Win32MethodLines String[] ByRef asCode Returns Integer[]
        Integer[] aiLines
        String sLow
        Integer i iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(asCode[i])) to sLow
            If (Pos("procedure", sLow) > 0 or Pos("function", sLow) > 0) ;
                Move i to aiLines[SizeOfArray(aiLines)]
        Loop
        Function_Return aiLines
    End_Function

    /* A BUFFER THAT CROSSES A METHOD (Nils 2026-11-04, SYSTRAY_NOTIFY). A package fills its Type in a Function that
       returns the bytes as a String; the caller receives them in a String of its own, and that one is what reaches
       Shell_NotifyIcon. The accessors bind only the first variable, so the converter refused at Function_Return,
       and the call-site proof could not connect the Type to the API at all.

       A Struct travels the same way: a Function can return one and a local can receive it. So inside ONE FILE
       this follows the buffer: a Function returning it (see _Win32FlowOfReturn) adds its receivers to asBuffers,
       as a buffer of the same Type, and a parameter is followed only when nothing calls that method, because a
       caller's argument would have to be followed backwards. The walk repeats, as a receiver can be returned
       in turn. Anything else stays with the cluster walk, which refuses that line and names it.

       Returns the rows the cluster reads: "f|<function>" returns the struct, "p|<method>" takes it.

       It runs for every Type, so it reads only the lines _Win32MethodLines listed, and splits only those naming
       a buffer. Measured on 85 real files: walking and splitting every line made the run 44% slower, this 4%. */
    Function _Win32BufferFlow String[] ByRef asCode Integer[] ByRef aiMethodLines String[] ByRef asBuffers Returns String[]
        String[] asFlow
        String sIndent sCode sComment sFirst sMethod sWord sLow
        Integer iAtLine i j iLast iHeader iRound iB iAt
        Boolean bGrew bKnown bOK bNamed

        If (SizeOfArray(asBuffers) = 0) ;
            Function_Return asFlow
        Move (SizeOfArray(aiMethodLines) - 1) to iLast
        Move 0 to iRound
        Repeat
            Move False to bGrew
            For iAtLine from 0 to iLast
                Move aiMethodLines[iAtLine] to i
                // The cheap question first: nearly every one of these lines names no buffer at all.
                Move (Lowercase(asCode[i])) to sLow
                Move False to bNamed
                For iB from 0 to (SizeOfArray(asBuffers) - 1)
                    If (Pos(Lowercase(Trim(asBuffers[iB])), sLow) > 0) ;
                        Move True to bNamed
                Loop
                If (bNamed = True) Begin
                    Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
                    Get _NthWord (Lowercase(sCode)) 1 to sFirst
                    If (sFirst = "procedure" or sFirst = "function") Begin
                        Get _MethodHeaderName sCode to sMethod
                        If (SearchArray(("p|" + sMethod), asFlow) = -1) Begin
                            For iB from 0 to (SizeOfArray(asBuffers) - 1)
                                Get _HeaderStringParamPos sCode asBuffers[iB] to iAt
                                If (iAt > 0) Begin
                                    Get _Win32MethodIsUncalled (&asCode) i sMethod to bOK
                                    If (bOK = True and SearchArray(("p|" + sMethod), asFlow) = -1) ;
                                        Move ("p|" + sMethod) to asFlow[SizeOfArray(asFlow)]
                                End
                            Loop
                        End
                    End
                    Else If (sFirst = "function_return") Begin
                        Get _NthWord sCode 2 to sWord
                        Get _IsWin32BufferName sWord (&asBuffers) to bKnown
                        If (bKnown = True) Begin
                            // The method it returns from: the nearest header above.
                            Move "" to sMethod
                            Move -1 to iHeader
                            Move (iAtLine - 1) to j
                            While (j >= 0 and sMethod = "")
                                Move aiMethodLines[j] to iHeader
                                Get _CodeOnlyLine asCode[iHeader] to sWord
                                Get _MethodHeaderName sWord to sMethod
                                Decrement j
                            Loop
                            If (sMethod <> "" and SearchArray(("f|" + sMethod), asFlow) = -1) Begin
                                Get _Win32FlowOfReturn (&asCode) iHeader sMethod (&asBuffers) to bOK
                                If (bOK = True) Begin
                                    Move ("f|" + sMethod) to asFlow[SizeOfArray(asFlow)]
                                    Move True to bGrew
                                End
                            End
                        End
                    End
                End
            Loop
            Increment iRound
        Until (bGrew = False or iRound > 4)
        Function_Return asFlow
    End_Function

    /* WHAT A LINE MEANS TO A BUFFER THAT CROSSES A METHOD. 0: nothing, the cluster walk judges it. 1: it stands as
       written, a Struct does the same thing there ('Function_Return sStruct', 'Get F of o to sOther'). 2: a method
       header whose String parameter becomes the Struct, in sOut, with the locals a declaration would bring. */
    Function _Win32FlowLine String[] ByRef asCode Integer iLine String sLine String sBuffer String sDeclType ;
            Boolean bText String[] ByRef asFlow String ByRef sOut Returns Integer
        String sIndent sCode sComment sFirst sWord sName sLocals
        Integer i iAt iTo iNl

        Move "" to sOut
        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        Get _NthWord (Lowercase(sCode)) 1 to sFirst
        If (sFirst = "function_return") Begin
            Get _NthWord (Lowercase(sCode)) 2 to sWord
            If (sWord <> Lowercase(Trim(sBuffer))) ;
                Function_Return 0
            Move (iLine - 1) to i
            Move "" to sName
            While (i >= 0 and sName = "")
                Get _CodeOnlyLine asCode[i] to sWord
                Get _MethodHeaderName sWord to sName
                Decrement i
            Loop
            Function_Return (If((SearchArray(("f|" + sName), asFlow) = -1), 0, 1))
        End
        If (sFirst = "get") Begin
            Get _NthWord (Lowercase(sCode)) 2 to sWord
            If (SearchArray(("f|" + sWord), asFlow) = -1) ;
                Function_Return 0
            Get _WordPosAtDepthZero sCode "To" 1 to iTo
            If (iTo = 0) ;
                Function_Return 0
            Function_Return (If((Lowercase(Trim(Mid(sCode, Length(sCode), (iTo + 3)))) = Lowercase(Trim(sBuffer))), 1, 0))
        End
        If (sFirst = "procedure" or sFirst = "function") Begin
            Get _MethodHeaderName sCode to sName
            If (SearchArray(("p|" + sName), asFlow) = -1) ;
                Function_Return 0
            Get _HeaderStringParamPos sCode sBuffer to iAt
            If (iAt = 0) ;
                Function_Return 0
            Get _DeclLineWithBufferLifted (sIndent + "    String " + sBuffer) sBuffer sDeclType True bText to sLocals
            Move (Pos((Character(10)), sLocals)) to iNl
            Move (sIndent + Left(sCode, (iAt - 1)) + sDeclType + Mid(sCode, Length(sCode), (iAt + 6)) + sComment ;
                + Mid(sLocals, Length(sLocals), iNl)) to sOut
            Function_Return 2
        End
        Function_Return 0
    End_Function

    // Each Function _Win32BufferFlow follows now returns the Struct: its 'Returns String' is staged.
    Procedure _StageFlowReturnTypes String[] ByRef asCode String sType String[] ByRef asFlow Integer[] ByRef aiStage String[] ByRef asStage
        String sIndent sCode sComment sName sLine sLow
        Integer i iLast iAt

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Get _MethodHeaderName sCode to sName
            If (sName <> "") Begin
                If (SearchArray(("f|" + sName), asFlow) <> -1) Begin
                    Move asCode[i] to sLine
                    If (aiStage[i] = 2) ;
                        Move asStage[i] to sLine
                    Move (Lowercase(sLine)) to sLow
                    Get _FindKeywordPos sLow "returns" True 1 to iAt
                    If (iAt > 0) ;
                        Get _FindKeywordPos sLow "string" True iAt to iAt
                    If (iAt > 0) Begin
                        Move (Left(sLine, (iAt - 1)) + sType + Mid(sLine, Length(sLine), (iAt + 6))) to asStage[i]
                        Move 2 to aiStage[i]
                    End
                End
            End
        Loop
    End_Procedure

    // PURE. The run note's list: "createstruct returns it, fillfromstruct takes it".
    Function _Win32FlowText String[] ByRef asFlow Returns String
        String sOut
        Integer i iLast

        Move "" to sOut
        Move (SizeOfArray(asFlow) - 1) to iLast
        For i from 0 to iLast
            Move (sOut + If((sOut = ""), "", ", ") + Mid(asFlow[i], Length(asFlow[i]), 3) + If((Left(asFlow[i], 1) = "f"), " returns it", " takes it")) to sOut
        Loop
        Function_Return sOut
    End_Function

    /* THE STRUCT DECLARATION A CALL PROVES FOR THIS TYPE, re-headed with the Type's name - "" when no call
       proves one, or when the members do not fit what was proved.

       THE SAME COUNT pairs by position, as every struct here does (_Win32StructBodyFromLegacy).

       A TYPE THAT STOPS SHORT is the one thing a proof changes. tagMENUITEMINFO lists MENUITEMINFO's first
       11 members and leaves out the 12th, hbmpItem, because it was written before Windows added it. The
       member-count gate reads that as a flattened struct, which it is not: the names agree, in order, and
       the buffer is handed to InsertMenuItemA, which takes exactly that struct (Nils 2026-11-03). So it
       becomes the WHOLE struct. Bigger is the safe direction - a Type too short for what Windows writes is
       an overrun, and SizeOfType now reports the size Windows documents. Every name has to agree here,
       because with the counts apart position alone proves nothing, and sMissing lists what was added.

       WITHOUT A CALL THE SAME TYPE STAYS REFUSED: three members of MSG and no API in sight is a buffer
       nobody can vouch for (DeepScan_DeclinedWin32BufferMemberCountRowNamesTypeAndStruct).

       A PROOF CAN ONLY ADD, so the body is built here. A struct the members fit can still be one this
       conversion cannot write, such as a nested struct DataFlex has no twin for in a member the Type lists.
       Answering with it refused a Type that had been converting on its own member types, and "" lets it carry
       on doing so (found by comparing both answers on the real files). Past the end of what the Type lists
       it can be written after all: _Win32OpaqueTailMembers.

       A Type that writes out what the proved struct nests fits as well: _Win32FlatMemberMap. */
    Function _Win32DeclProvenByCalls String[] ByRef asCode Integer[] ByRef aiMethodLines Integer iStart Integer iEnd String sType ;
            String[] ByRef asProofs String ByRef sSdkName String ByRef sApi String ByRef sMissing Returns String
        String[] asBuffers asNames asSdk asNoNotes asBody asNoMap asNoFlow
        String sProved sWhy sDecl
        Integer i iLegacy iSdk
        Boolean bOK bFlat

        Move "" to sApi
        Move "" to sMissing
        If (SizeOfArray(asProofs) = 0) ;
            Function_Return ""
        Get _Win32BuffersForType (&asCode) sType to asBuffers
        // What reaches the API may be a variable the buffer was returned into: _Win32BufferFlow.
        Get _Win32BufferFlow (&asCode) (&aiMethodLines) (&asBuffers) to asNoFlow
        Get _Win32StructProvenByCalls (&asProofs) (&asBuffers) (&sApi) to sProved
        If (sProved = "") ;
            Function_Return ""
        Get WinAPIStructDataFlexDecl sProved (&asNoNotes) to sDecl
        Move (_ReheadStructDecl(Self, sDecl, sType)) to sDecl
        If (sDecl = "") ;
            Function_Return ""
        Get _Win32FlatMemberMap (&asCode) iStart iEnd sType sDecl (&asNames) (&asNoMap) to bFlat
        If (bFlat = False) Begin
            Get _LegacyTypeMemberNames (&asCode) iStart iEnd sType (&asNames) (&sWhy) to bOK
            If (bOK = False) ;
                Function_Return ""
            Get _StructMemberNames sDecl to asSdk
            Move (SizeOfArray(asNames)) to iLegacy
            Move (SizeOfArray(asSdk)) to iSdk
            If (iLegacy > iSdk) ;
                Function_Return ""
            If (iLegacy < iSdk) Begin
                For i from 0 to (iLegacy - 1)
                    If (Lowercase(Trim(asNames[i])) <> Lowercase(Trim(asSdk[i]))) ;
                        Function_Return ""
                Loop
                For i from iLegacy to (iSdk - 1)
                    Move (sMissing + If((sMissing = ""), "", ", ") + Trim(asSdk[i])) to sMissing
                Loop
                Send _AppendSdkMembersPast (&asNames) sDecl
                Get _Win32OpaqueTailMembers sDecl iLegacy to sDecl
            End
        End
        Get _Win32StructBodyFromLegacy (&asNames) sDecl (&asBody) (&sWhy) sProved to bOK
        If (bOK = False) ;
            Function_Return ""
        Get WinAPIStructCatalogName sProved to sSdkName
        Function_Return sDecl
    End_Function

    // The SDK's names for the members past the end of asNames, so a Type proved short pairs by position.
    Procedure _AppendSdkMembersPast String[] ByRef asNames String sSdkDecl
        String[] asSdk
        Integer i iFrom iLast

        Get _StructMemberNames sSdkDecl to asSdk
        Move (SizeOfArray(asNames)) to iFrom
        Move (SizeOfArray(asSdk) - 1) to iLast
        For i from iFrom to iLast
            Move asSdk[i] to asNames[i]
        Loop
    End_Procedure

    /* THE CONVERSION. Legacy Win32 Type blocks and the byte buffers bound to them become Structs and
       struct variables. Returns the number of Type blocks converted; every refusal is appended to
       asNotes with the reason and the line, because a silent skip reads as "nothing needed doing".

       WHY THIS IS SAFE NOW AND WAS NOT IN JULY. The Tier-1 study (2026-07-17) graded these clusters
       and found none convertible, because it counted A TAKEN ADDRESS as a blocker - and every
       marshaled Win32 buffer takes its address, that being how it reaches the API. That was the
       right call while the replacement layout was a guess. The harvested struct catalogue is exactly
       what retires it: the SDK member widths and the alignment rule are known, so the struct handed
       to Windows has the layout Windows expects. Address-taken is therefore NOT a blocker here - but
       only for a Type the catalogue actually covers, which is the gate below.

       WHAT IT REFUSES, and each is a refusal rather than a best effort:
         - a Type the catalogue does not know. Most legacy Types are not Win32 at all (the Crystal
           PE / UXF family is 1754 of the 2119 accessor lines measured); nothing can be said about
           their layout and nothing is.
         - a member count that disagrees with the SDK. Position is the only correspondence available and a
           differing count disproves it. Three cases are not this: a Type that lists the struct's first
           members and is provably handed to an API taking it (_Win32DeclProvenByCalls), a Type that
           writes out what the struct nests (_Win32FlatMemberMap), and a struct no API takes, where no
           call could ever prove anything (_Win32FitsStructNoApiTakes).
         - a buffer whose every mention is not one of the five known shapes plus its declaration. If
           one line does something else with those bytes, converting the other lines around it would
           leave the file inconsistent, so the whole cluster stays as written.
         - a buffer with no visible declaration (a parameter, or a global from another file): there
           is nothing here to retype, and guessing its scope is how a converter corrupts a file. The
           one exception crosses methods inside this file, where every step can be seen: _Win32BufferFlow.
         - an Offset_of_Field on the Type: a Struct exposes no member offset, so there is nothing
           to rewrite it to. (Size_of_Field, by contrast, becomes SizeOfType of the member.)
         - a Type another file uses too, in the run or outside it - a library's file included: the
           declaration is public, and a Struct has none of the symbols that file reads
           (_FileReadingTypeElsewhere, 2026-11-01).

       ONE PASS DECIDES, A SECOND PASS WRITES. Deciding and inserting at once would shift the very
       line numbers the decisions are keyed on; the action array keeps the two apart. */
    Function _ConvertWin32TypeBuffersInLines String[] ByRef asCode String[] ByRef asNotes Returns Integer
        String[] asOut asNames asBody asBuffers asNew asSdk asLookNotes asOrphan asOnly asNoBody asProofs asMemberMap asFlatNames asNoMap asShortNames asShortMap asFlow asNoFlow
        String[] asDfTypes asLiftBody asLiftBlock asLiftMembers asNoneS
        String sShipped sShaped sShapedDecl sScalar sScalarMember sProvenApi sProvenMissing sByName sShortMissing sNoFit
        String sLifted sLiftWhy sLiftDecl
        Integer[] aiAction aiMethodLines
        String sLine sCode sIndent sComment sType sSdkDecl sWhy sBuf sRewritten sEmpty sLow sSdkName
        Integer i j iLast iEnd iConverted iDecl iBufLast iStructAt iStage iOrph iOrphLast
        Integer[] aiStage
        String[] asStage
        Boolean bOK bAllOk bFallbackBody bProofsBuilt bFlat bHasApi bLifted

        Move 0 to iConverted
        Move False to bProofsBuilt
        // What this call copies from Dftypes.pkg, for ChangeExternalFunctionCallers to write (_WriteDfTypesStructs).
        Set pasDfTypesLifted       to asNoneS
        Set pasDfTypesLiftedBlocks to asNoneS
        Move (SizeOfArray(asCode) - 1) to iLast
        If (iLast < 1) ;
            Function_Return 0
        // The catalogue is the gate for every decision below, so this makes sure it is loaded
        // rather than trusting a caller to have done it - the load is latched, so asking twice
        // costs nothing, and asking zero times converts nothing while looking like a clean run.
        Send RefreshWinAPICatalogsFromJson
        // action per ORIGINAL line: 0 keep, 1 comment out, 2 replace with asNew[i]
        For i from 0 to iLast
            Move 0  to aiAction[i]
            Move "" to asNew[i]
        Loop

        Move 0 to i
        While (i <= iLast)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            If (Left(sLow, 5) = "type " and aiAction[i] = 0) Begin
                Move (Trim(Mid(Trim(sCode), Length(sCode), 6))) to sType
                // find End_Type
                Move -1 to iEnd
                For j from (i + 1) to iLast
                    If (iEnd = -1) Begin
                        Send _SplitIndentCodeComment asCode[j] (&sIndent) (&sCode) (&sComment)
                        If (Left(Lowercase(Trim(sCode)), 8) = "end_type") ;
                            Move j to iEnd
                    End
                Loop
                If (iEnd > i and Trim(sType) <> "") Begin
                    Move "" to sShortMissing
                    Move "" to sNoFit
                    /* THE CALL COMES FIRST (Nils 2026-11-04). A name can only suggest which Windows struct
                       a Type is; a buffer of it handed to an API parameter that takes that struct says so.
                       Over 75 Types in the test workspaces the two never disagreed, and the calls reach
                       Types no name does. It can only add: no proof, or a proof the members do not fit,
                       and everything below runs as it did. See _Win32DeclProvenByCalls. */
                    If (bProofsBuilt = False) Begin
                        Get _Win32CallProofs (&asCode) to asProofs
                        Get _Win32MethodLines (&asCode) to aiMethodLines
                        Move True to bProofsBuilt
                    End
                    Get _Win32DeclProvenByCalls (&asCode) (&aiMethodLines) i iEnd sType (&asProofs) (&sSdkName) (&sProvenApi) (&sProvenMissing) to sSdkDecl
                    If (sSdkDecl = "") Begin
                        Move "" to sProvenApi
                        Move "" to sProvenMissing
                    End
                    /* A THROWAWAY ARRAY, NOT THE RUN NOTES. WinAPIStructDataFlexDecl - reached
                       through WinAPIStructForLegacyName - opens by RESIZING the notes array it is
                       handed to zero: that parameter is its own output, not a list to append to.
                       Passing the run notes in wiped every refusal recorded so far, so a file with
                       several Types reported only whatever was added after the LAST lookup - two
                       Types were declined in total silence on the first live run, and silence is
                       the one thing a refusal must never be (2026-08-30). */
                    If (sSdkDecl = "") Begin
                        Move (ResizeArray(asLookNotes, 0)) to asLookNotes
                        Get WinAPIStructForLegacyName sType (&asLookNotes) (&sSdkName) to sSdkDecl
                        For iStage from 0 to (SizeOfArray(asLookNotes) - 1)
                            Move asLookNotes[iStage] to asNotes[SizeOfArray(asNotes)]
                        Loop
                        // A struct no API takes: its name is all the evidence there can ever be, and a
                        // name that does not fit was a coincidence, not a reason to refuse.
                        If (sSdkDecl <> "") Begin
                            Get _WinAPIStructHasAnApi sSdkName to bHasApi
                            If (bHasApi = False) Begin
                                Get _Win32FitsStructNoApiTakes (&asCode) i iEnd sType sSdkDecl sSdkName (&asShortNames) (&asShortMap) (&sShortMissing) to bOK
                                If (bOK = False) Begin
                                    Move sSdkName to sNoFit
                                    Move "" to sSdkDecl
                                    Move "" to sSdkName
                                End
                            End
                        End
                    End
                    /* THE SECOND WAY IN, when the name did not find it (Nils 2026-09-01). The
                       lookup above is name-derived - strip a house prefix, ask the catalogue - so a
                       Type the developer named for their own code rather than for the API never
                       resolves: ProcessMessages.pkg declares "Type tPrMsg" for the Win32 MSG
                       struct, and nothing gets from "PrMsg" to "MSG". Ask the member names
                       instead, which is the identity test this converter already applies once a
                       struct HAS been found. Refused unless exactly one catalogue struct has that
                       shape - see WinAPIStructNameByMemberShape for the two guards. */
                    If (sSdkDecl = "") Begin
                        Get _LegacyTypeMemberNames (&asCode) i iEnd sType (&asNames) (&sWhy) to bOK
                        If (bOK = True) Begin
                            Get WinAPIStructNameByMemberShape asNames to sShaped
                            If (sShaped <> "") Begin
                                Move (ResizeArray(asLookNotes, 0)) to asLookNotes
                                Get WinAPIStructDataFlexDecl sShaped (&asLookNotes) to sShapedDecl
                                Move (_ReheadStructDecl(Self, sShapedDecl, sType)) to sSdkDecl
                                // The same rule as the name above: a row with a member nothing can write,
                                // and no API behind it, cannot cost this Type its conversion.
                                If (sSdkDecl <> "") Begin
                                    Get _WinAPIStructHasAnApi sShaped to bHasApi
                                    If (bHasApi = False) Begin
                                        Get _Win32FitsStructNoApiTakes (&asCode) i iEnd sType sSdkDecl sShaped (&asShortNames) (&asShortMap) (&sShortMissing) to bOK
                                        If (bOK = False) ;
                                            Move "" to sSdkDecl
                                    End
                                End
                                If (sSdkDecl <> "") Begin
                                    Move sShaped to sSdkName
                                    Move ("Type " + sType + " matched the SDK struct " + sShaped + " by its member names (" + String(SizeOfArray(asNames)) + " of " + String(SizeOfArray(asNames)) + ", in order) - the NAME did not resolve. Verify this is the struct you meant.") to asNotes[SizeOfArray(asNotes)]
                                End
                            End
                        End
                    End
                    /* A CATALOGUE MISS IS NOT A REFUSAL (Nils 2026-09-01). The catalogue exists to
                       CORRECT member types - it is what turns a legacy "lParam as dWord" into the
                       LongPtr x64 actually requires - and it had been wired in as a PRECONDITION for
                       converting at all. Those are two different jobs, and conflating them meant a
                       Type the catalogue had never heard of was abandoned along with every consumer
                       bound to it: 12 of the 13 buffer-bound Types in a real three-workspace scan were
                       offered nothing whatsoever, one member or eleven.

                       A Type nobody catalogued still carries the types its author wrote, and DataFlex
                       Structs are PACKED under the same cumulative-offset rule as Type - nothing
                       auto-aligns, which is exactly why tWinStructs.pkg carries 31 hand-written
                       iMissingAlignment fillers. Emitting those declared types one-for-one therefore
                       reproduces the byte layout exactly, and AddressOf hands the API the identical
                       bytes. So: the catalogue when we have it, the author own declaration when we do
                       not.

                       WHAT THE FALLBACK DOES NOT DO is fix a type that was already wrong for x64. It
                       modernises the syntax and preserves the semantics; a member four bytes short
                       stays four bytes short. That is the status quo rather than a regression, it is
                       said out loud in the run notes at the commit below, and the catalogue path still
                       corrects it wherever the struct can be identified. Every other gate is
                       untouched: the member names must still read, and every buffer bound to the Type
                       must still be wholly convertible before a single line is written. */
                    Move False to bFallbackBody
                    If (sSdkDecl = "") Begin
                        /* BUFFER-BOUND TYPES ONLY, and this gate is the whole reason the run notes
                           stay readable. _LegacyStructBodyFromType succeeds on ANY well-formed Type
                           block - that is its job - so without this test every ordinary Type in the
                           workspace would walk on into the buffer check below and come back out as
                           "no buffer is bound to it in this file". Hundreds of notes about Types that
                           were never candidates, burying the handful of real refusals: precisely what
                           the silent skip here was protecting against in the first place.

                           Asking for the buffers first costs one extra pass and answers the only
                           question that matters - is this Type actually used as a byte buffer. If it
                           is not, nothing has changed and nothing is said. */
                        Get _Win32BuffersForType (&asCode) sType to asBuffers
                        If (SizeOfArray(asBuffers) > 0) ;
                            Get _LegacyStructBodyFromType (&asCode) i iEnd (&asBody) (&sWhy) to bFallbackBody
                    End
                    If (sSdkDecl = "" and bFallbackBody = False) Begin
                        // Neither catalogued NOR readable as a plain Type block - silent, this is the
                        // common case and noting each would bury the refusals that matter.
                        Move iEnd to i
                    End
                    Else Begin
                        // A Type that writes out nested members, each of the two ways: with the struct
                        // known, or on its own member types. Everything else reads the names as it did.
                        If (bFallbackBody = True) ;
                            Get _OwnDottedMemberMap (&asCode) i iEnd sType (&asMemberMap) to bFlat
                        Else If (sShortMissing <> "") Begin
                            Move asShortNames to asFlatNames
                            Move asShortMap   to asMemberMap
                            Move True         to bFlat
                        End
                        Else ;
                            Get _Win32FlatMemberMap (&asCode) i iEnd sType sSdkDecl (&asFlatNames) (&asMemberMap) to bFlat
                        Move True to bOK
                        If (bFlat = False) ;
                            Get _LegacyTypeMemberNames (&asCode) i iEnd sType (&asNames) (&sWhy) to bOK
                        If (bOK = False) Begin
                            Move ("Type " + sType + " left as written - " + sWhy) to asNotes[SizeOfArray(asNotes)]
                            Move iEnd to i
                        End
                        Else Begin
                            // asBody is already built when the fallback above supplied it. A Type a call
                            // proved short takes the rest of the struct under the SDK's own names.
                            If (bFallbackBody = False) Begin
                                If (bFlat = True) ;
                                    Move asFlatNames to asNames
                                Else If (sProvenMissing <> "") ;
                                    Send _AppendSdkMembersPast (&asNames) sSdkDecl
                                Get _Win32StructBodyFromLegacy (&asNames) sSdkDecl (&asBody) (&sWhy) sSdkName to bOK
                            End
                            If (bOK = False) Begin
                                Move ("Type " + sType + " left as written - " + sWhy) to asNotes[SizeOfArray(asNotes)]
                                Move iEnd to i
                            End
                            Else Begin
                                Get _Win32BuffersForType (&asCode) sType to asBuffers
                                Get _Win32BufferFlow (&asCode) (&aiMethodLines) (&asBuffers) to asFlow
                                Move (SizeOfArray(asBuffers) - 1) to iBufLast
                                Move True to bAllOk
                                // A CLEAN SLATE PER TYPE. The clusters write here, not into the
                                // file-wide arrays, and only a Type that survives every one of its
                                // buffers gets merged in below.
                                /* ON TOP OF WHAT EARLIER TYPES COMMITTED (2026-10-31). Staged from zero, a
                                   line another Type had rewritten - a declaration naming a buffer of each,
                                   'String sftTime sSystemTime' - came back as this Type's version of the
                                   ORIGINAL line and replaced that rewrite: sftTime stayed a String while its
                                   accessors became struct access. _Win32BufferCluster lifts a declaration
                                   again from what is left of it, and refuses an accessor line already
                                   rewritten. */
                                For iStage from 0 to iLast
                                    Move 0  to aiStage[iStage]
                                    Move "" to asStage[iStage]
                                    If (aiAction[iStage] = 2) Begin
                                        Move 2               to aiStage[iStage]
                                        Move asNew[iStage]   to asStage[iStage]
                                    End
                                Loop
                                If (iBufLast < 0) Begin
                                    Move False to bAllOk
                                    Move ("Type " + sType + " left as written - no buffer is bound to it in this file") to asNotes[SizeOfArray(asNotes)]
                                End
                                // every buffer must be wholly convertible before ANY line is touched
                                For j from 0 to iBufLast
                                    If (bAllOk = True) Begin
                                        Get _Win32BufferCluster (&asCode) sType asBuffers[j] sType False (&asBody) (&aiStage) (&asStage) (&sWhy) (&asMemberMap) (&asFlow) to bOK
                                        If (bOK = False) Begin
                                            Move False to bAllOk
                                            Move ("Type " + sType + " left as written - buffer " + asBuffers[j] + ": " + sWhy) to asNotes[SizeOfArray(asNotes)]
                                        End
                                    End
                                Loop
                                If (bAllOk = True and SizeOfArray(asFlow) > 0) ;
                                    Send _StageFlowReturnTypes (&asCode) sType (&asFlow) (&aiStage) (&asStage)
                                // Size_of_Field / Offset_of_Field name the TYPE, never a buffer, so the
                                // cluster walk above cannot see them - see _Win32TypeSizeLines.
                                If (bAllOk = True) Begin
                                    Get _Win32TypeSizeLines (&asCode) sType (&asBody) (&aiStage) (&asStage) (&sWhy) to bOK
                                    If (bOK = False) Begin
                                        Move False to bAllOk
                                        Move ("Type " + sType + " left as written - " + sWhy) to asNotes[SizeOfArray(asNotes)]
                                    End
                                End
                                // Last, as the one check that reads other files: a file elsewhere that reads the Type.
                                If (bAllOk = True) Begin
                                    Get _FileReadingTypeElsewhere sType to sWhy
                                    If (sWhy <> "") Begin
                                        Move False to bAllOk
                                        Move ("Type " + sType + " left as written - another file uses it too, and would stop compiling if it became a Struct: " + sWhy) to asNotes[SizeOfArray(asNotes)]
                                    End
                                End
                                If (bAllOk = True) Begin
                                    // COMMIT this Type: its staged accessor rewrites, then its block.
                                    For iStage from 0 to iLast
                                        If (aiStage[iStage] = 2) Begin
                                            Move 2            to aiAction[iStage]
                                            Move asStage[iStage] to asNew[iStage]
                                        End
                                    Loop
                                    // comment the Type block out; the Struct is emitted in its place below
                                    For j from i to iEnd
                                        Move 1 to aiAction[j]
                                    Loop
                                    Move (Character(10)) to sEmpty
                                    Move ("Struct " + sType) to sRewritten
                                    For j from 0 to (SizeOfArray(asBody) - 1)
                                        Move (sRewritten + sEmpty + asBody[j]) to sRewritten
                                    Loop
                                    Move (sRewritten + sEmpty + "End_Struct" + sEmpty) to asNew[i]
                                    Increment iConverted
                                    // Only once the Type is actually COMMITTED - a note about a
                                    // conversion that then got refused is worse than no note at all.
                                    If (bFallbackBody = True) ;
                                        Move ("Type " + sType + " was converted using ITS OWN member types - " + If((sNoFit = ""), "the Windows API struct catalogue has no entry for it", ("its name points at the Windows struct " + sNoFit + ", but its members do not fit that struct")) + ". The byte layout is preserved exactly as written, so every call site keeps working; but any member type that was already wrong for 64-bit is carried across UNCHANGED, not corrected. Check it against the API signature.") to asNotes[SizeOfArray(asNotes)]
                                    If (sShortMissing <> "") ;
                                        Move ("Type " + sType + " is now the whole Windows struct " + sSdkName + ", because its name and all its members agree with that struct's first ones. No API takes this struct, only messages carry it, so no call could have proved it. Added, and left at zero: " + sShortMissing + ". The size this code tells Windows is now the full size, which is the one Windows documents.") to asNotes[SizeOfArray(asNotes)]
                                    If (SizeOfArray(asFlow) > 0) ;
                                        Move ("Type " + sType + " travels between methods in this file, and now does so as a Struct: " + _Win32FlowText(Self, &asFlow) + ".") to asNotes[SizeOfArray(asNotes)]
                                    If (bFlat = True and bFallbackBody = False and sShortMissing = "") ;
                                        Move ("Type " + sType + " listed one by one the members the Windows struct " + sSdkName + " nests. It now has that struct's own layout." + If((SizeOfArray(asMemberMap) > 0), (" " + _MemberMapText(Self, &asMemberMap) + "."), "")) to asNotes[SizeOfArray(asNotes)]
                                    If (bFlat = True and bFallbackBody = True) ;
                                        Move ("Type " + sType + " wrote nested members with dots, which a Struct cannot declare without a type of its own. " + _MemberMapText(Self, &asMemberMap) + ".") to asNotes[SizeOfArray(asNotes)]
                                    If (sProvenApi <> "") Begin
                                        Get WinAPIStructCatalogName sType to sByName
                                        If (sProvenMissing <> "") ;
                                            Move ("Type " + sType + " is now the whole Windows struct " + sSdkName + ", because " + sProvenApi + " takes that struct and the Type listed only its first members. Added, and left at zero: " + sProvenMissing + ". The size this code tells Windows is now the full size, which is the one Windows documents.") to asNotes[SizeOfArray(asNotes)]
                                        Else If (sByName <> sSdkName) ;
                                            Move ("Type " + sType + " takes its member types from the Windows struct " + sSdkName + ", because it is passed to " + sProvenApi + ", which takes that struct. Its name alone would not have shown that.") to asNotes[SizeOfArray(asNotes)]
                                    End
                                End
                                // A FAILED TYPE NEEDS NO UNDO - nothing of its was ever committed.
                                // It used to call a routine that cleared every rewrite in the FILE,
                                // which gutted the accessors of an EARLIER, successful Type while
                                // leaving that Type block commented out: a Struct declared, its Type
                                // gone, and ZeroType / Put..At still standing on the name. The file
                                // could not compile, and the run reported success (2026-08-30, first
                                // live run on a real workspace - two Types in one file is a shape no
                                // single-Type fixture could produce).
                                Move iEnd to i
                            End
                        End
                    End
                End
            End
            Increment i
        Loop

        Get _OrphanAccessorTypes (&asCode) to asOrphan
        /* PASS 2 - A TYPE THE WORKSPACE NEVER DECLARES. The accessors are here, the declaration is
           not: it lived in Dftypes.pkg, which DataFlex marks obsolete and a modernised workspace no
           longer includes. So the code reads "Put tWindowPlacement_size to sWp at
           tWindowPlacement.length" against a name nothing defines, and every one of those lines is
           an undefined-symbol error that has been sitting in the build for years.

           Pass 1 cannot see these - it walks Type blocks, and there is no block. Nothing is emitted
           or commented out here either; the struct already exists in the install. Only the buffer
           declaration and the accessors move.

           THE GATE IS THE MEMBERS THE CODE ACTUALLY NAMES, not the shape of the struct. Comparing
           whole shapes would refuse a sound conversion over a member nobody touches; what has to
           hold is that every "<Type>.<member>" still resolves afterwards. */
        Move (SizeOfArray(asOrphan) - 1) to iOrphLast
        For iOrph from 0 to iOrphLast
            Move asOrphan[iOrph] to sType
            Get _ShippedStructForLegacyType sType to sShipped
            /* A ONE-FIELD TYPE IS A SCALAR WEARING A BUFFER (Nils 2026-09-13). Dftypes.pkg still
               declares tDWORD and tHANDLE, one field each and no tWin twin, and the code using them
               asks an API for one number back through a byte buffer. The modern form has no buffer:
               the local IS the DWord, and AddressOf(it) is what the API receives. So the buffer is
               retyped to the field's type, ZeroType becomes Move 0, and Put / GetBuff become plain
               Moves - _ShippedScalarForLegacyType and _RewriteScalarBufferLine. Everything else in
               this pass - the member gate, the all-or-nothing cluster - applies exactly as it does
               to a shipped struct. */
            Move "" to sScalar
            Move "" to sScalarMember
            If (sShipped = "") ;
                Get _ShippedScalarForLegacyType sType (&sScalarMember) to sScalar
            /* NEITHER SHIPPED NOR ONE FIELD: a Type DataFlex ships no Struct for, copied from its Dftypes.pkg into the
               workspace's DfTypesStructs.pkg (_DfTypesLiftedStruct, 2026-11-13). */
            Move False to bLifted
            Move "" to sLiftWhy
            Move (ResizeArray(asLiftBody, 0)) to asLiftBody
            If (sShipped = "" and sScalar = "") Begin
                Get _DfTypesInstallLines to asDfTypes
                Get _DfTypesLiftedStruct sType (&asDfTypes) (&sLifted) (&asLiftBody) (&asLiftBlock) (&sLiftWhy) to bLifted
            End
            If (sShipped = "" and sScalar = "" and bLifted = False) Begin
                /* TWO DIFFERENT REASONS, and they must not wear the same sentence. "The install
                   ships no struct for it" is a fact about DataFlex; "no compiler is configured" is
                   a fact about this session, and telling someone the former when the latter is true
                   sends them looking in the wrong place entirely. */
                Get psTargetPkgFolder of ghoApplication to sShipped
                If (Trim(sShipped) = "") ;
                    Move ("Type " + sType + " left as written - no DataFlex install folder is known " ;
                        + "for this run, so its shipped structs could not be consulted") to asNotes[SizeOfArray(asNotes)]
                Else If (sLiftWhy <> "") ;
                    Move ("Type " + sType + " left as written - it is not declared in this file, the install ships " ;
                        + "no modern struct for it, and its Dftypes.pkg declaration cannot be copied into one: " + sLiftWhy) to asNotes[SizeOfArray(asNotes)]
                Else ;
                    Move ("Type " + sType + " left as written - it is not declared in this file and " ;
                        + "the install ships no modern struct for it") to asNotes[SizeOfArray(asNotes)]
                Move "" to sShipped
            End
            Else Begin
                If (sScalar <> "") Begin
                    Move (ResizeArray(asOnly, 0)) to asOnly
                    Move sScalarMember to asOnly[0]
                    Get _AccessorMembersWithin (&asCode) sType (&asOnly) sType (&sWhy) to bOK
                    Move sScalar to sShipped      // what the buffer is DECLARED as from here on
                End
                Else If (bLifted = True) Begin
                    Move (StrJoinFromArray(asLiftBlock, (Character(10)))) to sLiftDecl
                    Get _StructMemberNames sLiftDecl to asLiftMembers
                    Get _AccessorMembersWithin (&asCode) sType (&asLiftMembers) sLifted (&sWhy) to bOK
                    Move sLifted to sShipped      // what the buffer is DECLARED as from here on
                End
                Else ;
                    Get _AccessorMembersExist (&asCode) sType sShipped (&sWhy) to bOK
                If (bOK = False) Begin
                    Move ("Type " + sType + " left as written - " + sWhy) to asNotes[SizeOfArray(asNotes)]
                End
                Else Begin
                    Get _Win32BuffersForType (&asCode) sType to asBuffers
                    Move (SizeOfArray(asBuffers) - 1) to iBufLast
                    Move True to bAllOk
                    // On top of what pass 1 and the Types before committed - see pass 1.
                    For iStage from 0 to iLast
                        Move 0  to aiStage[iStage]
                        Move "" to asStage[iStage]
                        If (aiAction[iStage] = 2) Begin
                            Move 2             to aiStage[iStage]
                            Move asNew[iStage] to asStage[iStage]
                        End
                    Loop
                    If (iBufLast < 0) ;
                        Move False to bAllOk
                    For j from 0 to iBufLast
                        If (bAllOk = True) Begin
                            Get _Win32BufferCluster (&asCode) sType asBuffers[j] sShipped (sScalar <> "") (&asLiftBody) (&aiStage) (&asStage) (&sWhy) (&asNoMap) (&asNoFlow) to bOK
                            If (bOK = False) Begin
                                Move False to bAllOk
                                Move ("Type " + sType + " left as written - buffer " + asBuffers[j] + ": " + sWhy) to asNotes[SizeOfArray(asNotes)]
                            End
                        End
                    Loop
                    // A copied Type's size symbol, anywhere in the file (GlobalAlloc, CopyMemory): SizeOfType of its Struct.
                    If (bAllOk = True and bLifted = True) Begin
                        Get _Win32TypeSizeLinesAs (&asCode) sType sLifted (&asLiftBody) (&aiStage) (&asStage) (&sWhy) to bOK
                        If (bOK = False) Begin
                            Move False to bAllOk
                            Move ("Type " + sType + " left as written - " + sWhy) to asNotes[SizeOfArray(asNotes)]
                        End
                    End
                    If (bAllOk = True) Begin
                        For iStage from 0 to iLast
                            If (aiStage[iStage] = 2) Begin
                                Move 2               to aiAction[iStage]
                                Move asStage[iStage] to asNew[iStage]
                            End
                        Loop
                        Increment iConverted
                        If (bLifted = True) Begin
                            Send _RecordDfTypesLift sLifted (&asLiftBlock)
                            Move ("Type " + sType + " is now the Struct " + sLifted + ", declared in " + CS_DfTypesStructsPkg ;
                                + " in the workspace's AppSrc folder, which this file now Uses. DataFlex ships no Struct for it, so its" ;
                                + " Dftypes.pkg declaration is copied member for member: the same bytes, where DataFlex's own" ;
                                + " printer-dialog code still reads them.") to asNotes[SizeOfArray(asNotes)]
                        End
                        If (sScalar <> "") ;
                            Move ("Type " + sType + " has one field, so its buffer is now a plain " + sScalar ;
                                + " local - the API receives the same address, and the byte buffer is gone") to asNotes[SizeOfArray(asNotes)]
                    End
                End
            End
        Loop

        If (iConverted = 0) ;
            Function_Return 0
        // ---- emit ------------------------------------------------------------------------------
        For i from 0 to iLast
            If (aiAction[i] = 0) Begin
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            End
            Else If (aiAction[i] = 1) Begin
                // the Struct goes in FIRST, where the Type block used to start
                If (asNew[i] <> "") ;
                    Send _AppendSplitLines (&asOut) asNew[i]
                Move ("// " + asCode[i]) to asOut[SizeOfArray(asOut)]
            End
            // A blank rewrite is a line a ";" carried a joined command onto: it went with that command.
            Else If (asNew[i] <> "") Begin
                Send _AppendSplitLines (&asOut) asNew[i]
            End
        Loop
        Move asOut to asCode
        /* THE FILE MAY HAVE JUST ACQUIRED A DEPENDENCY ON tWinStructs.pkg, and must say so. Two
           ways in: a Type DataFlex already ships a Struct for is retyped straight to that tWin<X>
           and no Struct is emitted at all, and a nested member (POINT, RECT, FILETIME) is pointed
           at the install's twin by _Win32StructBodyFromLegacy. Either way the file now names a
           type it does not declare - apply_hide_tab_page.pkg had no Use line anywhere and was
           retyped to tWinTcItem (Nils 2026-09-01). Asked only when a tWin name is actually there,
           so a conversion that emits a self-contained Struct gains no Use it does not need. */
        If (iConverted > 0) Begin
            Get _CodeReferencesShippedStruct (&asCode) to bOK
            If (bOK = True) ;
                Send _EnsureUseForNewDependency (&asCode) "tWinStructs.pkg"
            // A Struct copied from Dftypes.pkg lives in the workspace's own package (_DfTypesStructNameFor).
            If (SizeOfArray(pasDfTypesLifted(Self)) > 0) ;
                Send _EnsureUseForNewDependency (&asCode) CS_DfTypesStructsPkg
        End
        Function_Return iConverted
    End_Function

    // Appends a block that may carry embedded newlines as separate array entries.
    Procedure _AppendSplitLines String[] ByRef asOut String sBlock
        String[] asBits
        Integer i

        Move (Replaces((Character(13)), sBlock, "")) to sBlock
        Move (StrSplitToArray(sBlock, (Character(10)))) to asBits
        For i from 0 to (SizeOfArray(asBits) - 1)
            Move asBits[i] to asOut[SizeOfArray(asOut)]
        Loop
    End_Procedure

    /* PURE. The parameter TYPES of the External_Function this file declares under sName, its
       ";"-continued lines joined comment-stripped exactly as the retyper joins them. False when
       the file declares no such function - the common case, and not a finding: most calls on a
       line are DataFlex's own. */
    Function _ExternalFnParamTypesInFile String[] ByRef asCode String sName String[] ByRef asTypes Returns Boolean
        String sHead sDecl sCont sRet sWant
        Integer i iAt iLast

        Move (ResizeArray(asTypes, 0)) to asTypes
        Move (Uppercase(Trim(sName)) + "|") to sWant
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _ExternalFnHeadPacked asCode[i] to sHead
            If (sHead <> "" and Left(sHead, Length(sWant)) = sWant) Begin
                Get _LineWithoutEndComment asCode[i] to sDecl
                Move (Trim(sDecl)) to sDecl
                Move i to iAt
                While (Right(sDecl, 1) = ";" and iAt < iLast)
                    Move (Trim(Left(sDecl, (Length(sDecl) - 1)))) to sDecl
                    Increment iAt
                    Get _LineWithoutEndComment asCode[iAt] to sCont
                    Move (sDecl + " " + Trim(sCont)) to sDecl
                Loop
                Get _ExternalFnParamTypes sDecl (&asTypes) to sRet
                Function_Return True
            End
        Loop
        Function_Return False
    End_Function

    /* A BUFFER HANDED STRAIGHT TO A WINDOWS API. "Move (Win32_NotifyIcon(0, sNotify)) to iRet"
       passes the byte buffer BARE where the declaration says Pointer; DataFlex marshals a String
       there as the address of its bytes. A Struct does not go through that door - the modern
       spelling is AddressOf(<struct>), which every tWinStructs caller in the install writes and
       which this converter already leaves alone. So a bare buffer in a Pointer position becomes
       AddressOf(<buffer>), and nothing else on the line moves. This was the one line that stopped
       a real cluster short: everything else converted, this refused, and the file stayed on the
       report rules with Ignore as its only offer (2026-09-13).

       ONLY WHEN THE CALLEE IS PROVABLY THAT: an External_Function THIS file declares, whose
       parameter at that position is pointer-class (_ApiTypeClass "ptr" - Pointer, Handle,
       Address, LongPtr). A callee the file does not declare gets no opinion here and falls
       through to the walk's ordinary refusal, because "CString(sBuf)" is also a call with the
       buffer as an argument and there the bytes are being READ, not handed over. A declared
       callee whose parameter is String (or anything not a pointer) is a refusal with the reason:
       the API wants text, and a Struct is not text.

       Every bare mention across every call on the line is judged, and the splices are applied
       RIGHT TO LEFT so the positions found first stay true. True with sOut when it rewrote;
       False with sWhyNot when it refused; False with sWhyNot blank when the line is not its
       business. */
    Function _ExternalFnPointerArgRewrite String[] ByRef asCode String sLine String sBuffer ;
            String ByRef sOut String ByRef sWhyNot Returns Boolean
        String[] asTypes asRepl
        Integer[] aiFrom aiTo
        String sIndent sCode sComment sWork sCh sName sArg sWant sCls
        Integer i j iLen iDepth iNameAt iArgAt iArgNo iHits
        Boolean bBoundary bDone bFound

        Move "" to sOut
        Move "" to sWhyNot
        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        Move sCode to sWork
        Move (Length(sWork)) to iLen
        Move (Lowercase(Trim(sBuffer))) to sWant
        Move 0 to iHits
        For i from 1 to iLen
            If (Mid(sWork, 1, i) = "(") Begin
                // the identifier ending right before this "(" is the callee; none means a plain group
                Move (i - 1) to iNameAt
                Move False to bDone
                While (iNameAt >= 1 and bDone = False)
                    Get _IsWordBoundaryChar (Mid(sWork, 1, iNameAt)) to bBoundary
                    If (bBoundary = True) ;
                        Move True to bDone
                    Else ;
                        Decrement iNameAt
                Loop
                Move (Trim(Mid(sWork, (i - 1 - iNameAt), (iNameAt + 1)))) to sName
                If (sName <> "") Begin
                    // this call's arguments, split at depth one; a bare buffer is judged in place
                    Move 1 to iDepth
                    Move (i + 1) to iArgAt
                    Move 0 to iArgNo
                    Move (i + 1) to j
                    Move False to bDone
                    While (j <= iLen and bDone = False)
                        Move (Mid(sWork, 1, j)) to sCh
                        If (sCh = "(") ;
                            Increment iDepth
                        Else If (sCh = ")") ;
                            Decrement iDepth
                        If ((sCh = "," and iDepth = 1) or iDepth = 0) Begin
                            Move (Mid(sWork, (j - iArgAt), iArgAt)) to sArg
                            If (Lowercase(Trim(sArg)) = sWant) Begin
                                Get _ExternalFnParamTypesInFile (&asCode) sName (&asTypes) to bFound
                                If (bFound = False) ;
                                    Function_Return False
                                If (iArgNo >= SizeOfArray(asTypes)) Begin
                                    Move ("hands the buffer to " + sName + " as argument " + String(iArgNo + 1) ;
                                        + ", which its External_Function declaration does not have") to sWhyNot
                                    Function_Return False
                                End
                                Get _ApiTypeClass asTypes[iArgNo] to sCls
                                If (sCls <> "ptr") Begin
                                    Move ("hands the buffer to " + sName + ", whose parameter " + String(iArgNo + 1) ;
                                        + " is " + Trim(asTypes[iArgNo]) + ", not a pointer - a Struct cannot be " ;
                                        + "marshalled as text") to sWhyNot
                                    Function_Return False
                                End
                                Move iArgAt  to aiFrom[iHits]
                                Move (j - 1) to aiTo[iHits]
                                Move (Replace(Trim(sArg), sArg, ("AddressOf(" + Trim(sArg) + ")"))) to asRepl[iHits]
                                Increment iHits
                            End
                            Move (j + 1) to iArgAt
                            Increment iArgNo
                        End
                        If (iDepth = 0) ;
                            Move True to bDone
                        Increment j
                    Loop
                End
            End
        Loop
        If (iHits = 0) ;
            Function_Return False
        // splice right to left, so every earlier span is still where it was found
        Move (iHits - 1) to i
        While (i >= 0)
            Move (Left(sWork, (aiFrom[i] - 1)) + asRepl[i] + Mid(sWork, (Length(sWork) - aiTo[i]), (aiTo[i] + 1))) to sWork
            Decrement i
        Loop
        Move (sIndent + sWork + sComment) to sOut
        Function_Return True
    End_Function

    /* PURE. The declared TYPE of one member of an emitted Struct body - "Char[64]" for a
       dimensioned one - or "" when the body declares no such name. Both body builders emit the
       same "    <type> <name>  // note" shape, so the first two source words are all there is. */
    Function _StructBodyMemberType String[] ByRef asBody String sMember Returns String
        String[] asWords
        Integer i iLast

        Move (SizeOfArray(asBody) - 1) to iLast
        For i from 0 to iLast
            Get _SplitSourceWords asBody[i] to asWords
            If (SizeOfArray(asWords) >= 2) Begin
                If (Lowercase(Trim(asWords[1])) = Lowercase(Trim(sMember))) ;
                    Function_Return (Trim(asWords[0]))
            End
        Loop
        Function_Return ""
    End_Function

    /* THE TWO COMMANDS THAT NAME THE TYPE RATHER THAN THE BUFFER, and so were never graded.

       The cluster walk judges every line that MENTIONS THE BUFFER, which is the right key for
       ZeroType, Put, GetBuff and the rest - each of them names its buffer. Size_of_Field and
       Offset_of_Field do not: "Size_of_Field tNotify.iSize to iSize" names the TYPE and a
       member, no buffer anywhere on the line, so the walk never saw it. It stayed as written
       while the Type it names was commented out, and the emitted file did not compile:
       Size_of_Field on a Struct member is four errors (4345 x3, 4328; probe-compiled
       2026-09-13). The report's own grader had flagged exactly this line as a blocker all
       along - the two graders disagreed, and the one that WRITES was the one that was wrong.

       Size_of_Field asks the width of one member, and a Struct answers that with SizeOfType of
       the member's declared type - the type the STRUCT declares, not the legacy Field, because
       the catalogue may have widened it and the buffer now IS the struct. A dimensioned member
       ("Char[64]") is that many of its base type.

       Offset_of_Field has no Struct equivalent at all - DataFlex exposes no member offset - so
       it refuses the Type, naming the line. Both operand forms are read, as the accessors' "At"
       operand is, and an operand naming ANOTHER Type is not this Type's business. Staged like
       the accessors, so a later refusal of the same Type abandons these too.

       THE TYPE'S SIZE SYMBOL (2026-10-31). A Type also defines <Type>_SIZE, in any statement - 'Move
       (DEVNAMES_Size + Length(sDriver)) To iSize', 'CopyMemory(p, q, DEVNAMES_Size)' - and a Struct defines
       nothing of the kind: DEVNAMES became a Struct while four such lines stayed, and every program that used
       the printer-dialog package stopped compiling. SizeOfType(<Type>) is the size of the struct the buffer
       now is (_ReplaceTypeSizeSymbol), so it goes in instead - on top of a rewrite already staged for that
       line, and a refusal when that rewrite is a declaration lift, which this cannot follow. */
    Function _Win32TypeSizeLines String[] ByRef asCode String sType String[] ByRef asBody ;
            Integer[] ByRef aiStage String[] ByRef asStage String ByRef sWhyNot Returns Boolean
        Boolean bOK
        Get _Win32TypeSizeLinesAs (&asCode) sType sType (&asBody) (&aiStage) (&asStage) (&sWhyNot) to bOK
        Function_Return bOK
    End_Function

    // _Win32TypeSizeLines for a buffer that became a Struct of ANOTHER name than its Type - one copied from
    // Dftypes.pkg (tDevMode for DEVMODE, 2026-11-13): <Type>_SIZE becomes SizeOfType(<sStruct>).
    Function _Win32TypeSizeLinesAs String[] ByRef asCode String sType String sStruct String[] ByRef asBody ;
            Integer[] ByRef aiStage String[] ByRef asStage String ByRef sWhyNot Returns Boolean
        String[] asTok
        String sIndent sCode sComment sLow sMember sMType sBase sCount sExpr sOwner sSized
        Integer i iLast iBr iBr2
        Boolean bOffset

        Move "" to sWhyNot
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            // A joined command's symbol can stand on a line its staged rewrite has already taken up.
            If (Pos((Lowercase(Trim(sType)) + "_size"), (sLow + " " + If((aiStage[i] = 2), Lowercase(asStage[i]), ""))) > 0) Begin
                If (aiStage[i] = 2 and Pos(Character(10), asStage[i]) > 0) Begin
                    Move ("line " + String(i + 1) + " names " + sType + "_SIZE in a line rewritten another way - convert that by hand") to sWhyNot
                    Function_Return False
                End
                If (aiStage[i] = 2) ;
                    Get _ReplaceTypeSizeSymbolAs asStage[i] sType sStruct to sSized
                Else ;
                    Get _ReplaceTypeSizeSymbolAs asCode[i] sType sStruct to sSized
                If (sSized <> "") Begin
                    Move sSized to asStage[i]
                    Move 2 to aiStage[i]
                End
            End
            Move (Left(sLow, 16) = "offset_of_field ") to bOffset
            If (Left(sLow, 14) = "size_of_field " or bOffset = True) Begin
                Get _SplitSourceWords sCode to asTok
                Move "" to sMember
                If (SizeOfArray(asTok) >= 4) Begin
                    If (Lowercase(Trim(asTok[2])) = "to") ;
                        Get _MemberFromAtOperand asTok[1] sType to sMember
                    // A bare operand is this Type's only if this Type is the ONE that declares
                    // it - the same ambiguity guard the buffer binder applies.
                    If (sMember <> "" and Pos(".", Trim(asTok[1])) = 0) Begin
                        Get _TypeDeclaringMember (&asCode) sMember to sOwner
                        If (Lowercase(sOwner) <> Lowercase(sType)) ;
                            Move "" to sMember
                    End
                End
                If (sMember <> "") Begin
                    If (bOffset = True) Begin
                        Move ("line " + String(i + 1) + " takes the byte OFFSET of member " + sMember ;
                            + " (Offset_of_Field), which a Struct cannot express - convert that by hand") to sWhyNot
                        Function_Return False
                    End
                    Get _StructBodyMemberType (&asBody) sMember to sMType
                    If (sMType = "") Begin
                        Move ("line " + String(i + 1) + " asks Size_of_Field of " + sMember ;
                            + ", which the Struct built for this Type does not declare") to sWhyNot
                        Function_Return False
                    End
                    Move (Pos("[", sMType)) to iBr
                    Move (Pos("]", sMType)) to iBr2
                    If (iBr > 1 and iBr2 > iBr) Begin
                        Move (Left(sMType, (iBr - 1))) to sBase
                        Move (Mid(sMType, (iBr2 - iBr - 1), (iBr + 1))) to sCount
                        Move ("(" + Trim(sCount) + " * SizeOfType(" + sBase + "))") to sExpr
                    End
                    Else Begin
                        Move ("(SizeOfType(" + sMType + "))") to sExpr
                    End
                    Move (sIndent + "Move " + sExpr + " to " + Trim(asTok[3]) + sComment) to asStage[i]
                    Move 2 to aiStage[i]
                End
            End
        Loop
        Function_Return True
    End_Function

    // PURE. sLine with every whole-word <sType>_SIZE in its code - not in a string or a comment - replaced by
    // SizeOfType(<sType>); "" when it has none (_Win32TypeSizeLines). Outside any parentheses it stands as
    // an operand of its own ('Move T_SIZE to x', which is what 'Put T_SIZE to b at T.m' becomes), and there
    // a function call needs its own pair, the way the install writes it.
    Function _ReplaceTypeSizeSymbol String sLine String sType Returns String
        String sOut
        Get _ReplaceTypeSizeSymbolAs sLine sType sType to sOut
        Function_Return sOut
    End_Function

    // PURE. _ReplaceTypeSizeSymbol with the size taken of sStruct - the Struct the Type became, when its name differs.
    Function _ReplaceTypeSizeSymbolAs String sLine String sType String sStruct Returns String
        String sCode sSym sNew sBefore
        Integer iAt iStart
        Boolean bAny

        Move (Lowercase(Trim(sType)) + "_size") to sSym
        Move False to bAny
        Move 1 to iStart
        Repeat
            Get _CodeOnlyLine sLine to sCode
            Get _FindKeywordPos (Lowercase(sCode)) sSym True iStart to iAt
            If (iAt > 0) Begin
                Move ("SizeOfType(" + Trim(sStruct) + ")") to sNew
                Move (Left(sCode, (iAt - 1))) to sBefore
                If (Length(Replaces("(", sBefore, "")) = Length(Replaces(")", sBefore, ""))) ;
                    Move ("(" + sNew + ")") to sNew
                Move (Left(sLine, (iAt - 1)) + sNew + Mid(sLine, Length(sLine), (iAt + Length(sSym)))) to sLine
                Move (iAt + Length(sNew)) to iStart
                Move True to bAny
            End
        Until (iAt = 0)
        If (bAny = False) ;
            Function_Return ""
        Function_Return sLine
    End_Function

    /* PURE. Is this line ALREADY in the form the converter would produce for this buffer?

       Two shapes count: member access, "<buf>.<member>" in either direction, and "AddressOf(<buf>)".
       Both are what a Struct is reached with, and both are exactly what this converter emits.

       WHY IT MATTERS TWICE OVER. Real legacy code mixes the two eras in one procedure - the file
       that prompted this has ZeroType and Put..At on a buffer whose address is already taken the
       modern way, three lines apart - and calling the modern line "a use this converter does not
       rewrite" refused a cluster that was most of the way converted already. It also makes a second
       run over converted source a no-op instead of a refusal, which is the difference between a
       converter you can run twice and one you cannot. */
    Function _IsStructFormLineFor String sLine String sBuffer Returns Boolean
        String sIndent sCode sComment sBefore
        Integer iPos iLen

        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        If (Trim(sCode) = "" or Trim(sBuffer) = "") ;
            Function_Return False
        Get _FindKeywordPos sCode sBuffer True 1 to iPos
        If (iPos = 0) ;
            Function_Return False
        Move (Length(sCode)) to iLen
        // "<buf>." - a member is being read or written, which only a Struct can do
        Move (iPos + Length(sBuffer)) to iPos
        If (iPos <= iLen) Begin
            If (Mid(sCode, 1, iPos) = ".") ;
                Function_Return True
        End
        // "AddressOf(<buf>)" - the modern way to hand a struct to an API
        Get _FindKeywordPos sCode sBuffer True 1 to iPos
        If (iPos > 10) Begin
            Move (Lowercase(Mid(sCode, 10, (iPos - 10)))) to sBefore
            If (sBefore = "addressof(") ;
                Function_Return True
        End
        Function_Return False
    End_Function

    /* PURE. asCode with every legacy buffer command a ";" carries over several lines joined on its first
       line, and the lines it used left blank, so every index still means the same line. The rewriters all
       read one line that starts with the verb, so 'Put (MIIM_STATE+MIIM_ID) ;' with 'to sInfo at
       T.fMask' under it stopped the whole cluster: the second line names the buffer and no rewriter knows
       it (a popup menu package, 2026-11-03). Only the commands are joined - a ";" in anything else keeps
       the refusal it always had. */
    Function _JoinedBufferCommands String[] ByRef asCode Returns String[]
        String[] asOut
        String sIndent sCode sComment sFirst sJoined sNotes sOtherIndent sPiece sNote
        Integer i j iLast
        Boolean bMore

        Move asCode to asOut
        Move (SizeOfArray(asCode) - 1) to iLast
        Move 0 to i
        While (i < iLast)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move "" to sFirst
            If (Right(sCode, 1) = ";") ;
                Get _NthWord (Lowercase(sCode)) 1 to sFirst
            If (sFirst = "put" or sFirst = "put_string" or sFirst = "getbuff" or sFirst = "getbuff_string" ;
                or sFirst = "zerotype" or sFirst = "filltype" or sFirst = "getaddress") Begin
                Move (RTrim(Left(sCode, (Length(sCode) - 1)))) to sJoined
                Move sComment to sNotes
                Move i to j
                Move True to bMore
                While (bMore = True and j < iLast)
                    Increment j
                    Send _SplitIndentCodeComment asCode[j] (&sOtherIndent) (&sPiece) (&sNote)
                    Move (Right(sPiece, 1) = ";") to bMore
                    If (bMore = True) ;
                        Move (Left(sPiece, (Length(sPiece) - 1))) to sPiece
                    Move (RTrim(sJoined) + " " + Trim(sPiece)) to sJoined
                    Move (sNotes + sNote) to sNotes
                    Move "" to asOut[j]
                Loop
                Move (sIndent + RTrim(sJoined) + sNotes) to asOut[i]
                Move j to i
            End
            Increment i
        Loop
        Function_Return asOut
    End_Function

    /* ONE buffer, judged whole and recorded. True only when EVERY line that mentions this buffer is
       either its declaration or one of the five shapes the rewriter handles; the per-line decisions
       are written into aiAction/asNew so the caller can still abandon them if a SIBLING buffer of
       the same Type fails.

       ALL OR NOTHING, PER TYPE. Converting some lines of a buffer and leaving others would produce a
       file where a Struct and a byte buffer are the same variable, which compiles for a while and
       then does not. So one unrecognised mention refuses the whole cluster, and the reason names the
       line - "left as written" with no line number is the readout this app keeps retiring.

       THE DECLARATION IS REQUIRED. Without a visible String/Address/Pointer declaration the buffer is
       a parameter or a global from another file: there is nothing here to retype, and inventing a
       scope for it is how a converter corrupts a file it half understands.

       THE COMPANION EMPTY VARIABLE is declared beside the buffer, because a Struct has no ZeroType -
       assigning a never-written struct variable is the only zeroing shape DF26 accepts. It is named
       after the buffer rather than the Type so two buffers of one Type cannot collide. */
    /* sDeclType is what the buffer will BE DECLARED AS, which is not always sType. Pass 1 converts a
       local Type block and keeps its name, so the two are the same. Pass 2 maps a Type this file
       never declared onto a struct the install already ships, and there the declaration must name
       THAT struct - tWinWindowPlacement - while the accessors still match on the legacy name the
       source is written with. */
    Function _Win32BufferCluster String[] ByRef asCode String sType String sBuffer String sDeclType ;
            Boolean bScalar String[] ByRef asBody Integer[] ByRef aiAction String[] ByRef asNew String ByRef sWhyNot ;
            String[] ByRef asMemberMap String[] ByRef asFlow Returns Boolean
        String[] asStmt
        String sIndent sCode sComment sOut sEmptyVar sLow
        Integer i j iLast iDecl iAt iDeclCount iFlow
        Boolean bOK bSkip bIsDecl bText bMore

        Get _JoinedBufferCommands (&asCode) to asStmt
        // A member the Struct reaches differently: _Win32FlatMemberMap, _OwnDottedMemberMap.
        If (SizeOfArray(asMemberMap) > 0) ;
            Send _RemapAtOperands (&asStmt) sType (&asMemberMap)
        Move "" to sWhyNot
        Move 0 to iDeclCount
        Move (sBuffer + "Empty") to sEmptyVar
        Move (SizeOfArray(asCode) - 1) to iLast
        /* THE TEXT HELPERS ARE DECLARED WITH THE BUFFER, so the declaration has to know before the
           walk reaches the accessor that needs them: one pass ahead for a Put_String or a
           GetBuff_String on THIS buffer. A scalar has no text member and never needs them. */
        Move False to bText
        If (bScalar = False) Begin
            For i from 0 to iLast
                Send _SplitIndentCodeComment asStmt[i] (&sIndent) (&sCode) (&sComment)
                Move (Lowercase(Trim(sCode))) to sLow
                If (Left(sLow, 11) = "put_string " or Left(sLow, 15) = "getbuff_string ") Begin
                    Get _FindKeywordPos sCode sBuffer True 1 to iAt
                    If (iAt > 0) ;
                        Move True to bText
                End
            Loop
        End
        For i from 0 to iLast
            Send _SplitIndentCodeComment asStmt[i] (&sIndent) (&sCode) (&sComment)
            If (Trim(sCode) <> "") Begin
                /* MENTIONED AT ANY DEPTH - _FindKeywordPos, not _WordPosAtDepthZero. Depth is how the
                   REWRITER finds its keywords, because a "To" inside the value is not the separator.
                   It is the wrong tool for asking "does this line touch the buffer at all": the line
                   that broke it was "Move (CString(sBrowseInfo)) to sOther", where the buffer sits at
                   depth 2, so a depth-zero search reported the line as unrelated and the cluster
                   converted around a line still treating those bytes as a String. Caught by the
                   refusal test, which until this point had been passing for the wrong reason. */
                Get _FindKeywordPos sCode sBuffer True 1 to iAt
                If (iAt > 0) Begin
                    /* EVERY declaration, not just the first. The same local declared in two
                       procedures is two declarations of one name; lifting only the first left the
                       second as a String and the file half converted - and the walk then met that
                       second declaration as an unrewritable use and refused the whole cluster
                       (DEVNAMES, 2026-08-30). */
                    // Message form: this function sits above _IsBufferDeclLine in the file, and
                    // DataFlex resolves an expression call at its point of use (4367).
                    Get _IsBufferDeclLine asCode[i] sBuffer to bIsDecl
                    If (bIsDecl = True) Begin
                        Increment iDeclCount
                        // Another buffer was lifted from this line already: lift this one from what is left.
                        If (aiAction[i] = 2) Begin
                            Get _DeclLineWithBufferLiftedAgain asNew[i] sBuffer sDeclType (bScalar = False) bText to sOut
                            If (sOut = "") Begin
                                Move ("line " + String(i + 1) + " declares it, and its rewrite for another buffer cannot be followed - " + Trim(sCode)) to sWhyNot
                                Function_Return False
                            End
                            Move sOut to asNew[i]
                        End
                        Else ;
                            Get _DeclLineWithBufferLifted asCode[i] sBuffer sDeclType (bScalar = False) bText to asNew[i]
                        Move 2 to aiAction[i]
                    End
                    Else Begin
                        Move False to bSkip
                        // bScalar: the buffer is a plain local now - Move 0, Move in, Move out.
                        If (bScalar = True) ;
                            Get _RewriteScalarBufferLine asStmt[i] sType sBuffer sDeclType (&sOut) to bOK
                        Else ;
                            Get _RewriteWin32BufferLine asStmt[i] sType sBuffer sEmptyVar (&sOut) to bOK
                        // The two TEXT accessors have their own rewriter and their own refusals - a
                        // wide member, a one-byte member, a receiver AddressOf cannot take.
                        If (bOK = False and bScalar = False) Begin
                            Get _RewriteWin32TextLine asStmt[i] sType sBuffer sDeclType (&asBody) (&sOut) (&sWhyNot) to bOK
                            If (bOK = False and sWhyNot <> "") Begin
                                Move ("line " + String(i + 1) + " " + sWhyNot) to sWhyNot
                                Function_Return False
                            End
                        End
                        If (bOK = False) Begin
                            // Already what this converter would have written - leave it exactly so.
                            If (_IsStructFormLineFor(Self, asStmt[i], sBuffer) = True) ;
                                Move True to bSkip
                            // A line where the buffer crosses a method: _Win32BufferFlow.
                            If (bSkip = False and SizeOfArray(asFlow) > 0) Begin
                                Get _Win32FlowLine (&asCode) i asStmt[i] sBuffer sDeclType bText (&asFlow) (&sOut) to iFlow
                                If (iFlow = 1) ;
                                    Move True to bSkip
                                If (iFlow = 2) Begin
                                    Move True to bOK
                                    Increment iDeclCount
                                End
                            End
                            // A bare buffer in a declared API's Pointer position becomes AddressOf
                            // (_ExternalFnPointerArgRewrite). Its refusal, when it has one, names the
                            // parameter and is kept over the generic line below.
                            If (bSkip = False and bOK = False) Begin
                                Get _ExternalFnPointerArgRewrite (&asCode) asStmt[i] sBuffer (&sOut) (&sWhyNot) to bOK
                                If (bOK = False and sWhyNot <> "") Begin
                                    Move ("line " + String(i + 1) + " " + sWhyNot) to sWhyNot
                                    Function_Return False
                                End
                            End
                            If (bSkip = False and bOK = False) Begin
                                Move ("line " + String(i + 1) + " uses those bytes in a way this converter " ;
                                    + "does not rewrite - " + Trim(sCode)) to sWhyNot
                                Function_Return False
                            End
                        End
                        // A line another buffer's rewrite already took: rewriting the original again would undo it.
                        If (bSkip = False and aiAction[i] = 2) Begin
                            Move ("line " + String(i + 1) + " is rewritten for another buffer too - " + Trim(sCode)) to sWhyNot
                            Function_Return False
                        End
                        If (bSkip = False) Begin
                            Move 2    to aiAction[i]
                            Move sOut to asNew[i]
                            // The lines a ";" carried this command onto go with it.
                            Move (i + 1) to j
                            Move True to bMore
                            While (bMore = True and j <= iLast)
                                Move (asStmt[j] = "" and Trim(asCode[j]) <> "") to bMore
                                If (bMore = True) Begin
                                    Move 2  to aiAction[j]
                                    Move "" to asNew[j]
                                    Increment j
                                End
                            Loop
                        End
                    End
                End
            End
        Loop
        If (iDeclCount = 0) Begin
            Move ("no String/Address/Pointer declaration for it is visible in this file, so it is a " ;
                + "parameter or a global declared elsewhere") to sWhyNot
            Function_Return False
        End
        Function_Return True
    End_Function

    /* Type names the accessors NAME but this file never DECLARES.

       The population pass 2 exists for. A Type declared in Dftypes.pkg - which DataFlex marks
       obsolete, so a modernised workspace stops including it - leaves its accessors behind with
       nothing defining the name they use. Every such line is already an undefined-symbol error in
       the build; they are not new breakage, they are old breakage nothing has been able to reach.

       A Type WITH a block here is pass 1s business and is excluded, whether pass 1 converted it or
       refused it - two passes must never both act on one Type. */
    Function _OrphanAccessorTypes String[] ByRef asCode Returns String[]
        String[] asOut asSeen asDeclared asTok
        String sIndent sCode sComment sLow sName sRest
        Integer i iLast iPos iAt

        Move (SizeOfArray(asCode) - 1) to iLast
        // what this file declares itself
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            If (Left(sLow, 5) = "type ") Begin
                Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                If (SizeOfArray(asTok) >= 2) ;
                    Move (Lowercase(Trim(asTok[1]))) to asDeclared[SizeOfArray(asDeclared)]
            End
        Loop
        // what the accessors name
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            Move "" to sName
            If (Left(sLow, 9) = "zerotype " or Left(sLow, 9) = "filltype ") Begin
                Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                If (SizeOfArray(asTok) >= 2) ;
                    Move (Trim(asTok[1])) to sName
            End
            Else If (Left(sLow, 4) = "put " or Left(sLow, 8) = "getbuff " or Left(sLow, 11) = "put_string " or Left(sLow, 15) = "getbuff_string ") Begin
                Get _WordPosAtDepthZero sCode "At" 1 to iAt
                If (iAt > 0) Begin
                    Move (Trim(Mid(sCode, Length(sCode), (iAt + 3)))) to sRest
                    Move (Pos(".", sRest)) to iPos
                    If (iPos > 0) ;
                        Move (Trim(Left(sRest, (iPos - 1)))) to sName
                End
            End
            If (Trim(sName) <> "") Begin
                If (SearchArray(Lowercase(sName), asDeclared) = -1) Begin
                    If (SearchArray(Lowercase(sName), asSeen) = -1) Begin
                        Move (Lowercase(sName)) to asSeen[SizeOfArray(asSeen)]
                        Move (Trim(sName))      to asOut[SizeOfArray(asOut)]
                    End
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* THE MEMBER AN "At" OPERAND NAMES, in either form DataFlex accepts - "<Type>.<member>"
       or a bare "<member>". Returns "" when the operand names a DIFFERENT Type, which is a
       refusal both callers must keep making: a Put aimed at another Type's field is not part
       of this cluster and rewriting it would move bytes into the wrong struct.

       The bare form needs no Type check because there is nothing to check - and nothing to
       get wrong either. By the time a line reaches the rewriter its buffer has already been
       bound to exactly one Type by _Win32BuffersForType, which applies the ambiguity guard
       (_TypeDeclaringMember) that this function has no way to apply on a single line.

       Extracted from the Put and GetBuff branches, which carried it twice, verbatim. */
    Function _MemberFromAtOperand String sOperand String sType Returns String
        String sRest
        Integer iPos

        Move (Trim(sOperand)) to sRest
        Move (Pos(".", sRest)) to iPos
        If (iPos = 0) ;
            Function_Return sRest
        If (Lowercase(Trim(Left(sRest, (iPos - 1)))) <> Lowercase(sType)) ;
            Function_Return ""
        Function_Return (Trim(Mid(sRest, Length(sRest), (iPos + 1))))
    End_Function

    /* WHICH TYPE OWNS A BARE MEMBER NAME - and "" unless EXACTLY ONE does.

       "Put 16 to lsSize At dwSize" names no Type at all, so binding that buffer means
       asking the file which Type declares a member called dwSize.

       ONLY BARE DECLARATIONS COUNT. "Field dwSize" puts the symbol dwSize in file scope;
       "Field tBeta.dwSize" puts tBeta.dwSize there instead and leaves dwSize undeclared, so
       it can never be what a bare "At dwSize" names. The two forms coexist happily, and a
       bare operand therefore has exactly one possible owner. Verified against DF26 rather
       than assumed: a SECOND bare declaration of the same name is Error 4332 "Symbol already
       defined", while a bare one alongside a qualified one compiles clean (2026-09-02).

       Counting the qualified form too made this guard refuse a file that was never ambiguous
       - and refuse it in SILENCE, because an unbound buffer just leaves its Type looking
       unused. That is the same way vsWin32ids.pkg went a day without being offered anything.

       The count is kept even though the compiler already guarantees at most one: this reads
       source that may not compile, and a coin-toss between two layouts is the one outcome
       worth refusing - what WinAPIStructNameByMemberShape does for ambiguous shapes. */
    Function _TypeDeclaringMember String[] ByRef asCode String sMember Returns String
        String[] asTok
        String sIndent sCode sComment sLow sType sHit sName sWanted
        Integer i iLast iCount

        Move (Lowercase(Trim(sMember))) to sWanted
        If (sWanted = "") ;
            Function_Return ""
        Move "" to sType
        Move "" to sHit
        Move 0  to iCount
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            If (Left(sLow, 5) = "type ") Begin
                Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                Move "" to sType
                If (SizeOfArray(asTok) >= 2) ;
                    Move (Trim(asTok[1])) to sType
            End
            Else If (Left(sLow, 8) = "end_type") Begin
                // Outside a block a Field line belongs to nothing - do not attribute it.
                Move "" to sType
            End
            Else If (Left(sLow, 6) = "field " and sType <> "") Begin
                Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                If (SizeOfArray(asTok) >= 2) Begin
                    Move (Trim(asTok[1])) to sName
                    // A qualified declaration answers a qualified operand, never a bare one:
                    // it declares tBeta.dwSize and leaves dwSize undeclared. See the header.
                    If (Pos(".", sName) = 0) Begin
                        If (Lowercase(sName) = sWanted) Begin
                            Increment iCount
                            Move sType to sHit
                        End
                    End
                End
            End
        Loop
        If (iCount = 1) ;
            Function_Return sHit
        Function_Return ""
    End_Function

    /* THE MANUAL ZEROING OF A TYPE BUFFER - "Move (Repeat(Character(0), <Type>_SIZE)) to <buf>".
       Returns the buffer that line fills, or "" when it is not that shape.

       <Type>_SIZE is compiler-generated for EVERY Type declaration - it is how legacy DataFlex
       asks for a Type's byte length - so this line names its Type every bit as plainly as
       "ZeroType <Type> to <buf>" does, and means precisely the same thing. Nothing ever looked
       for it: the size symbol was only SUBSTITUTED once a Type had been identified some other
       way (see _RewriteWin32BufferLine's Put branch), never used to identify one. So a file
       that zeroes by hand bound no buffer, its Type looked unused, and it was passed over in
       silence - vsWin32ids.pkg, and Nils had to point out that _SIZE is a Type reference
       before the search would look for it (2026-09-01).

       DELIBERATELY NARROW. Only Character(0) counts. A space-fill or a literal length is not
       provably "a zeroed buffer of this Type's size", and a converter that guessed would
       quietly change what the API receives; those stay the refusal they are today. */
    Function _ZeroFillBufferForType String sCode String sType Returns String
        String sSqueezed sBuf
        Integer iPos

        Move (Lowercase(Replaces(" ", sCode, ""))) to sSqueezed
        If (Pos("repeat(", sSqueezed) = 0 or Pos("character(0", sSqueezed) = 0) ;
            Function_Return ""
        Get _FindKeywordPos sCode (sType + "_size") True 1 to iPos
        If (iPos = 0) ;
            Function_Return ""
        Get _WordPosAtDepthZero sCode "To" 1 to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (Trim(Mid(sCode, Length(sCode), (iPos + 3)))) to sBuf
        Function_Return sBuf
    End_Function

    /* Buffers bound to this Type anywhere in the file - read straight off the accessor statements,
       which name both operands. This is the binding that made Tier-1 hard when it had to be INFERRED
       from a String declaration and its uses; in the byte-level syntax it is simply stated. */
    Function _Win32BuffersForType String[] ByRef asCode String sType Returns String[]
        String[] asOut asTok asSeen
        String sIndent sCode sComment sLow sBuf sOperand sOwner sZeroBuf
        Integer i iLast iPos
        Boolean bAtNamesType

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Lowercase(Trim(sCode))) to sLow
            Move "" to sBuf
            /* The cheap substring first: _ZeroFillBufferForType does real work, and all but a
               handful of lines can be dismissed on a Pos() before paying for it. */
            Move "" to sZeroBuf
            If (Pos("_size", sLow) > 0) ;
                Move (_ZeroFillBufferForType(Self, sCode, sType)) to sZeroBuf
            If (Left(sLow, 9) = "zerotype " or Left(sLow, 9) = "filltype ") Begin
                Get _WordPosAtDepthZero sCode "To" 1 to iPos
                If (iPos > 0) ;
                    Move (Trim(Mid(sCode, Length(sCode), (iPos + 3)))) to sBuf
                If (Left(sLow, 9) = "zerotype ") Begin
                    Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                    If (SizeOfArray(asTok) < 2) ;
                        Move "" to sBuf
                    Else If (Lowercase(Trim(asTok[1])) <> Lowercase(sType)) ;
                        Move "" to sBuf
                End
                Else Begin
                    Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                    If (SizeOfArray(asTok) < 2) ;
                        Move "" to sBuf
                    Else If (Lowercase(Trim(asTok[1])) <> Lowercase(sType)) ;
                        Move "" to sBuf
                End
            End
            Else If (Left(sLow, 4) = "put " or Left(sLow, 8) = "getbuff " or Left(sLow, 11) = "put_string " or Left(sLow, 15) = "getbuff_string ") Begin
                /* THE OPERAND AFTER "At", IN EITHER FORM DATAFLEX ACCEPTS. "<Type>.<member>"
                   names its Type outright. A bare "<member>" does not, and requiring the prefix
                   meant a file written that way bound NO buffer to the Type at all - so the Type
                   looked unused, and was passed over without a word (vsWin32ids.pkg writes
                   "Put 16 to lsSize At dwSize"; Nils 2026-09-01).

                   For the bare form the Type has to be inferred, so ask which Type declares that
                   member and bind ONLY when exactly one does - see _TypeDeclaringMember. Two
                   Types sharing a member name cannot be told apart from the line, and a wrong
                   binding here would hand the buffer the wrong layout. */
                Get _WordPosAtDepthZero sCode "At" 1 to iPos
                If (iPos > 0) Begin
                    Move (Trim(Mid(sCode, Length(sCode), (iPos + 3)))) to sOperand
                    Move (StrSplitToArray(Trim(Replaces((Character(9)), sOperand, " ")), CS_S)) to asTok
                    If (SizeOfArray(asTok) > 0) ;
                        Move (Trim(asTok[0])) to sOperand
                    Move False to bAtNamesType
                    If (Lowercase(Left(sOperand, (Length(sType) + 1))) = Lowercase(sType + ".")) Begin
                        Move True to bAtNamesType
                    End
                    Else If (Pos(".", sOperand) = 0) Begin
                        Get _TypeDeclaringMember (&asCode) sOperand to sOwner
                        If (sOwner <> "" and Lowercase(sOwner) = Lowercase(sType)) ;
                            Move True to bAtNamesType
                    End
                    If (bAtNamesType = True) Begin
                        If (Left(sLow, 4) = "put " or Left(sLow, 11) = "put_string ") Begin
                            Get _WordPosAtDepthZero sCode "To" 1 to iPos
                            If (iPos > 0) Begin
                                Move (Trim(Mid(sCode, Length(sCode), (iPos + 3)))) to sBuf
                                Get _WordPosAtDepthZero sBuf "At" 1 to iPos
                                If (iPos > 0) ;
                                    Move (Trim(Left(sBuf, (iPos - 1)))) to sBuf
                            End
                        End
                        Else Begin
                            Get _WordPosAtDepthZero sCode "From" 1 to iPos
                            If (iPos > 0) Begin
                                Move (Trim(Mid(sCode, Length(sCode), (iPos + 5)))) to sBuf
                                Get _WordPosAtDepthZero sBuf "At" 1 to iPos
                                If (iPos > 0) ;
                                    Move (Trim(Left(sBuf, (iPos - 1)))) to sBuf
                            End
                        End
                    End
                End
            End
            // The hand-written equivalent of ZeroType - it names the Type through <Type>_SIZE.
            Else If (sZeroBuf <> "") Begin
                Move sZeroBuf to sBuf
            End
            /* DEDUPED case-insensitively, STORED as the author wrote it. Lowercasing the stored name
               was rewriting "sBrowseInfo" as "sbrowseinfo" in the emitted declaration - the converter
               changing a name it had no business touching, on every line it produced. */
            If (Trim(sBuf) <> "") Begin
                If (SearchArray(Lowercase(sBuf), asSeen) = -1) Begin
                    Move (Lowercase(sBuf)) to asSeen[SizeOfArray(asSeen)]
                    Move (Trim(sBuf))      to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* PURE. The member NAMES of one legacy Type block, in declaration order. False + a reason when
       the block is not the shape this converter can reason about.

       ONE shape is accepted: "Field <Type>.<member> As <type>", which is 801 of the 924 member lines
       in the legacy corpus measured 2026-08-30. The other 123 carry a DOTTED member name -
       "Field PAGESETUPDLG.ptPaperSize.x as dWord" - which is a nested SDK struct written out
       longhand. Those are refused here rather than guessed at: the dot means the block flattened
       something, and the member count will not line up with the SDK anyway. */
    Function _LegacyTypeMemberNames String[] ByRef asCode Integer iStart Integer iEnd String sType ;
            String[] ByRef asNames String ByRef sWhyNot Returns Boolean
        String[] asTok
        String sLine sCode sIndent sComment sName
        Integer i iPos

        Move (ResizeArray(asNames, 0)) to asNames
        Move "" to sWhyNot
        For i from (iStart + 1) to (iEnd - 1)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            If (Trim(sCode) <> "") Begin
                Move (Replaces((Character(9)), sCode, " ")) to sCode
                Move (StrSplitToArray(Trim(sCode), CS_S)) to asTok
                If (SizeOfArray(asTok) < 4) Begin
                    Move ("line " + String(i + 1) + " is not a Field declaration: " + Trim(sCode)) to sWhyNot
                    Function_Return False
                End
                If (Lowercase(Trim(asTok[0])) <> "field") Begin
                    Move ("line " + String(i + 1) + " is not a Field declaration: " + Trim(sCode)) to sWhyNot
                    Function_Return False
                End
                Move (Trim(asTok[1])) to sName
                Move (Pos(".", sName)) to iPos
                /* THE "<Type>." PREFIX IS OPTIONAL IN DATAFLEX, and demanding it here refused
                   every block that left it off. "Field dwSize as DWord" sitting inside
                   "Type X ... End_Type" names X's member exactly as unambiguously as
                   "Field X.dwSize" does - a Field line cannot belong to anything but the block
                   enclosing it. vsWin32ids.pkg writes it the short way and was skipped for that
                   alone, before the catalogue or anything else got a say (Nils 2026-09-01).

                   A prefix that IS present is still checked, because a present prefix can
                   disagree - and one that names another Type means the block was flattened or
                   the line was pasted from elsewhere, which is a real refusal. */
                If (iPos > 0) Begin
                    If (Lowercase(Left(sName, (iPos - 1))) <> Lowercase(sType)) Begin
                        Move ("line " + String(i + 1) + " belongs to another Type: " + Trim(sCode)) to sWhyNot
                        Function_Return False
                    End
                    Move (Mid(sName, Length(sName), (iPos + 1))) to sName
                End
                If (Pos(".", sName) > 0) Begin
                    Move ("member " + sName + " is a nested path, so this block flattened a struct " ;
                        + "the SDK nests - convert it by hand") to sWhyNot
                    Function_Return False
                End
                Move sName to asNames[SizeOfArray(asNames)]
            End
        Loop
        If (SizeOfArray(asNames) = 0) Begin
            Move "the block declares no members" to sWhyNot
            Function_Return False
        End
        Function_Return True
    End_Function

    /* PURE. The line that DECLARES this buffer, or -1.

       ONE NAME OR SEVERAL. The first version of this required the line to hold exactly the type and
       the buffer, and on the first live run that refused every single cluster in the workspace -
       because real code declares its locals together:

           String sDriverName sDeviceName sOutputName sDevNames
           String sFolder sBrowseInfo sTitle

       Not one buffer in that workspace was declared on its own. A converter that only handles the
       tidy shape converts nothing (2026-08-30).

       Still exact on the NAME - a longer name containing it is not it - and still only the three
       types a byte buffer is declared with. "String[] asFoo" is not one of them: the first token
       must be the bare type, so an array declaration never matches. */
    Function _BufferDeclLineIdx String[] ByRef asCode String sBuffer Returns Integer
        String[] asTok
        String sIndent sCode sComment sLow
        Integer i iLast j

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            If (Trim(sCode) <> "") Begin
                Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
                If (SizeOfArray(asTok) >= 2) Begin
                    Move (Lowercase(Trim(asTok[0]))) to sLow
                    If (sLow = "string" or sLow = "address" or sLow = "pointer") Begin
                        For j from 1 to (SizeOfArray(asTok) - 1)
                            If (Lowercase(Trim(asTok[j])) = Lowercase(Trim(sBuffer))) ;
                                Function_Return i
                        Loop
                    End
                End
            End
        Loop
        Function_Return -1
    End_Function

    /* PURE. Does THIS line declare the buffer? The per-line half of _BufferDeclLineIdx, because one
       buffer name can be declared more than once - the same local in two procedures is two
       declarations of one name, and both have to become struct variables or the file ends up with a
       Struct in one method and a String in the next. */
    Function _IsBufferDeclLine String sLine String sBuffer Returns Boolean
        String[] asTok
        String sIndent sCode sComment sLow
        Integer j

        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        If (Trim(sCode) = "") ;
            Function_Return False
        Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
        // "Local String sDevMode" declares it as plainly (2026-11-13) - the legacy prefix of a method's locals.
        If (SizeOfArray(asTok) > 0) Begin
            If (Lowercase(Trim(asTok[0])) = "local") ;
                Move (RemoveFromArray(asTok, 0)) to asTok
        End
        If (SizeOfArray(asTok) < 2) ;
            Function_Return False
        Move (Lowercase(Trim(asTok[0]))) to sLow
        If (sLow <> "string" and sLow <> "address" and sLow <> "pointer") ;
            Function_Return False
        For j from 1 to (SizeOfArray(asTok) - 1)
            If (Lowercase(Trim(asTok[j])) = Lowercase(Trim(sBuffer))) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* PURE. The declaration line, rewritten so that ONE of its names becomes a struct variable while
       its siblings stay exactly as they were:

           String sFolder sBrowseInfo sTitle
                    ->  String sFolder sTitle
                        vtBrowseInfo sBrowseInfo
                        vtBrowseInfo sBrowseInfoEmpty

       The siblings keep their type, their order and the line they were written on; only the buffer
       leaves. When it was the only name the original line goes entirely, since an empty "String" is
       not a declaration.

       Declaration ORDER among locals carries no meaning in DataFlex, so moving one name to its own
       line changes nothing but the text.

       The Empty twin is a struct's zeroing partner. A ONE-FIELD Type becomes a scalar, which zeroes
       with Move 0 and gets no twin - bEmptyTwin False (2026-09-13). */
    Function _DeclLineWithBufferLifted String sLine String sBuffer String sType Boolean bEmptyTwin Boolean bTextHelpers Returns String
        String[] asTok
        String sIndent sCode sComment sKept sNl sLocal
        Integer j iLast

        Send _SplitIndentCodeComment sLine (&sIndent) (&sCode) (&sComment)
        Move (StrSplitToArray(Trim(Replaces((Character(9)), sCode, " ")), CS_S)) to asTok
        /* "Local String sA sDevMode" (2026-11-13): the siblings keep the prefix they were written with; the struct
           lines go without it, a method's variables being local with or without it. */
        Move "" to sLocal
        If (SizeOfArray(asTok) > 0) Begin
            If (Lowercase(Trim(asTok[0])) = "local") Begin
                Move (Trim(asTok[0]) + " ") to sLocal
                Move (RemoveFromArray(asTok, 0)) to asTok
            End
        End
        Move (Character(10)) to sNl
        Move "" to sKept
        Move (SizeOfArray(asTok) - 1) to iLast
        For j from 1 to iLast
            If (Trim(asTok[j]) <> "") Begin
                If (Lowercase(Trim(asTok[j])) <> Lowercase(Trim(sBuffer))) Begin
                    If (sKept <> "") ;
                        Move (sKept + " ") to sKept
                    Move (sKept + Trim(asTok[j])) to sKept
                End
            End
        Loop
        Move "" to sLine
        If (sKept <> "") ;
            Move (sIndent + sLocal + Trim(asTok[0]) + " " + sKept + sComment + sNl) to sLine
        Move (sLine + sIndent + sType + " " + sBuffer) to sLine
        If (bEmptyTwin = True) ;
            Move (sLine + sNl + sIndent + sType + " " + sBuffer + "Empty") to sLine
        // The text accessors' scratch: a String the value lands in first, and the Integer MemCopy
        // returns into. Named after the buffer, so two buffers in one scope never collide.
        If (bTextHelpers = True) ;
            Move (sLine + sNl + sIndent + "String " + sBuffer + "Text" + sNl + sIndent + "Integer " + sBuffer + "Void") to sLine
        Function_Return sLine
    End_Function

    /* PURE. _DeclLineWithBufferLifted on a declaration line ANOTHER buffer has already been lifted from
       (2026-10-31): sStaged is that earlier lift - what is left of the declaration first (unless nothing
       is), then the lines of the buffers lifted. This buffer leaves that first line; the lines after it
       stay as they are. "" when the first line does not declare the buffer. */
    Function _DeclLineWithBufferLiftedAgain String sStaged String sBuffer String sType Boolean bEmptyTwin Boolean bTextHelpers Returns String
        String sFirst sRest
        Integer iNl
        Boolean bIsDecl

        Move (Pos(Character(10), sStaged)) to iNl
        If (iNl = 0) Begin
            Move sStaged to sFirst
            Move "" to sRest
        End
        Else Begin
            Move (Left(sStaged, (iNl - 1))) to sFirst
            Move (Mid(sStaged, Length(sStaged), (iNl + 1))) to sRest
        End
        Get _IsBufferDeclLine sFirst sBuffer to bIsDecl
        If (bIsDecl = False) ;
            Function_Return ""
        Get _DeclLineWithBufferLifted sFirst sBuffer sType bEmptyTwin bTextHelpers to sFirst
        If (sRest = "") ;
            Function_Return sFirst
        Function_Return (sFirst + Character(10) + sRest)
    End_Function

    // The lines of the install's tWinStructs.pkg, read once per run (pbWinStructsRead) and kept in
    // pasWinStructsLines; empty when the target package folder is unknown.
    Function _WinStructsLines Returns String[]
        String sPkg
        Boolean bRead

        Get pbWinStructsRead to bRead
        If (bRead = False) Begin
            Set pbWinStructsRead to True
            Get psTargetPkgFolder of ghoApplication to sPkg
            If (Trim(sPkg) <> "") ;
                Set pasWinStructsLines to (rfReadEncodedFileAsStringArray(vFolderFormat(sPkg) + "tWinStructs.pkg"))
        End
        Function_Return (pasWinStructsLines(Self))
    End_Function

    /* ---- THE LEGACY TYPES DATAFLEX SHIPS NO STRUCT FOR (2026-11-13) ----------------------------------------------
       Dftypes.pkg declares 39 Types and DataFlex 26 ships a modern twin for most; pass 2 of
       _ConvertWin32TypeBuffersInLines retypes a buffer to that twin. DEVMODE and DEVNAMES have none, and the code
       that fills them is DataFlex's own printer-dialog code, copied into many workspaces ("ZeroType DEVMODE To
       sDevMode"): pass 2 left every one of them as written. Nils: "we should be able to identify the DEVMODE, and
       add a corresponding Struct and change the code to use a struct variable".

       THE STRUCT IS THE TYPE, BYTE FOR BYTE - never the Windows SDK's. DataFlex's DEVMODE leaves out
       dmDisplayFrequency, so its last seven members sit four bytes before the SDK's. But Prnt_dlg.pkg's ReadDevMode
       reads the printer's DEVMODE at those same places (BytesToDWord(sDevMode, 121) for ICMMethod) and the code
       writes it back through the Type, so the round trip agrees with itself. A Struct with the SDK's layout would put
       those values where DataFlex's own code does not look. (The harvested DEVMODEA is no help either: its first
       union is 8 bytes short.)

       ONE SHARED PACKAGE, NOT A COPY PER FILE (Nils's choice). Two files of one program commonly both fill a DEVMODE,
       and a Struct declared twice does not compile. So the structs go to DfTypesStructs.pkg in the workspace's AppSrc
       folder (_WriteDfTypesStructs) and each converted file Uses it. The Struct needs a NAME of its own: Prnt_dlg.pkg
       Uses Dftypes.pkg, so every program with a PrintDialog still has DEVMODE, DEVMODE_Size and DEVMODE.dmSize.

       ONLY THESE TWO, and only while every member has a fixed size. The other Types with no twin hold a Handle or a
       Pointer, and Dftypes.pkg's Types carry no alignment padding: a byte copy would keep the 64-bit fault. Those need
       the SDK's layout - pass 1's business. Add a name here only for a Type of fixed-size members. */
    Function _DfTypesStructNameFor String sType Returns String
        Move (Lowercase(Trim(sType))) to sType
        If (sType = "devmode") ;
            Function_Return "tDevMode"
        If (sType = "devnames") ;
            Function_Return "tDevNames"
        Function_Return ""
    End_Function

    // The lines of the install's Dftypes.pkg, read once (pbDfTypesRead) and kept in pasDfTypesLines; empty when the
    // target package folder is unknown.
    Function _DfTypesInstallLines Returns String[]
        String sPkg
        Boolean bRead

        Get pbDfTypesRead to bRead
        If (bRead = False) Begin
            Set pbDfTypesRead to True
            Get psTargetPkgFolder of ghoApplication to sPkg
            If (Trim(sPkg) <> "") ;
                Set pasDfTypesLines to (rfReadEncodedFileAsStringArray(vFolderFormat(sPkg) + "Dftypes.pkg"))
        End
        Function_Return (pasDfTypesLines(Self))
    End_Function

    // PURE. The number a member size in Dftypes.pkg stands for: itself when it is one, else what that file Defines it
    // as ("Define CCHDEVICENAME for 32"); "" when neither.
    Function _DfTypesSizeValue String[] ByRef asDfTypes String sCount Returns String
        String[] asWords
        String sCode
        Integer i iLast
        Boolean bDigits

        Move (Trim(sCount)) to sCount
        Get _IsAllDigits sCount to bDigits
        If (bDigits = True) ;
            Function_Return sCount
        Move (SizeOfArray(asDfTypes) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asDfTypes[i] to sCode
            Get _SplitSourceWords sCode to asWords
            If (SizeOfArray(asWords) >= 4) Begin
                If (Lowercase(asWords[0]) = "define" and Lowercase(asWords[1]) = Lowercase(sCount) and Lowercase(asWords[2]) = "for") Begin
                    Get _IsAllDigits (Trim(asWords[3])) to bDigits
                    If (bDigits = True) ;
                        Function_Return (Trim(asWords[3]))
                    Function_Return ""
                End
            End
        Loop
        Function_Return ""
    End_Function

    /* PURE. The Struct a Dftypes.pkg Type becomes, read from asDfTypes (that file's lines): sStruct its name, asBody
       its member lines - the shape _LegacyStructBodyFromType emits, so the accessor rewriters read it as they read any
       converted body - and asBlock the whole declaration for DfTypesStructs.pkg. False with sWhyNot blank when this
       is not a Type that is copied at all, and with the reason when it is but cannot be. A size Dftypes.pkg spells
       with a constant ("Char CCHDEVICENAME") is written as the number that file Defines for it, so the package needs
       nothing else to compile. */
    Function _DfTypesLiftedStruct String sType String[] ByRef asDfTypes String ByRef sStruct ;
            String[] ByRef asBody String[] ByRef asBlock String ByRef sWhyNot Returns Boolean
        String[] asTok asOut
        String sCode sLow sName sBase sCount sNum sLine
        Integer i iLast iStart iEnd iBr iBr2 iPos
        Boolean bOK

        Move "" to sWhyNot
        Move (ResizeArray(asBody, 0)) to asBody
        Move (ResizeArray(asBlock, 0)) to asBlock
        Get _DfTypesStructNameFor sType to sStruct
        If (sStruct = "") ;
            Function_Return False
        // The block: "Type <name>" to its End_Type.
        Move -1 to iStart
        Move -1 to iEnd
        Move (SizeOfArray(asDfTypes) - 1) to iLast
        For i from 0 to iLast
            If (iEnd = -1) Begin
                Get _CodeOnlyLine asDfTypes[i] to sCode
                Move (Lowercase(Trim(Replaces((Character(9)), sCode, " ")))) to sLow
                If (iStart = -1) Begin
                    If (sLow = ("type " + Lowercase(Trim(sType)))) ;
                        Move i to iStart
                End
                Else If (Left(sLow, 8) = "end_type") ;
                    Move i to iEnd
            End
        Loop
        If (iLast < 0) Begin
            Move "the install's Dftypes.pkg could not be read" to sWhyNot
            Function_Return False
        End
        If (iStart = -1 or iEnd = -1) Begin
            Move "the install's Dftypes.pkg does not declare it" to sWhyNot
            Function_Return False
        End
        // A dotted member ("Field T.pt.x") is a nested one, which a Struct cannot declare by that name.
        For i from (iStart + 1) to (iEnd - 1)
            Get _CodeOnlyLine asDfTypes[i] to sCode
            Get _SplitSourceWords sCode to asTok
            If (SizeOfArray(asTok) >= 2) Begin
                If (Lowercase(asTok[0]) = "field") Begin
                    Move (Trim(asTok[1])) to sName
                    Move (Pos(".", sName)) to iPos
                    If (iPos > 0) ;
                        Move (Right(sName, (Length(sName) - iPos))) to sName
                    If (Pos(".", sName) > 0) Begin
                        Move ("its member " + sName + " is a nested one, which a Struct cannot declare by that name") to sWhyNot
                        Function_Return False
                    End
                End
            End
        Loop
        Get _LegacyStructBodyFromType (&asDfTypes) iStart iEnd (&asOut) (&sWhyNot) to bOK
        If (bOK = False) ;
            Function_Return False
        Move (SizeOfArray(asOut) - 1) to iLast
        For i from 0 to iLast
            Move asOut[i] to sLine
            Get _SplitSourceWords sLine to asTok
            If (Left(Trim(sLine), 2) <> "//" and SizeOfArray(asTok) >= 2) Begin
                Move (Trim(asTok[0])) to sBase
                Move "" to sCount
                Move (Pos("[", sBase)) to iBr
                Move (Pos("]", sBase)) to iBr2
                If (iBr > 1 and iBr2 > iBr) Begin
                    Move (Trim(Mid(sBase, (iBr2 - iBr - 1), (iBr + 1)))) to sCount
                    Move (Left(sBase, (iBr - 1))) to sBase
                End
                // The same size on 32 and 64 bit, or the copy is not the same bytes on both.
                If (Pos(("|" + Lowercase(sBase) + "|"), "|char|uchar|short|ushort|integer|uinteger|dword|bigint|ubigint|") = 0) Begin
                    Move ("its member " + Trim(asTok[1]) + " is " + sBase + ", whose size differs between 32 and 64 bit, and a Dftypes.pkg Type has no alignment padding to copy") to sWhyNot
                    Function_Return False
                End
                If (sCount <> "") Begin
                    Get _DfTypesSizeValue (&asDfTypes) sCount to sNum
                    If (sNum = "") Begin
                        Move ("the size of its member " + Trim(asTok[1]) + ", " + sCount + ", is no number Dftypes.pkg defines") to sWhyNot
                        Function_Return False
                    End
                    If (sNum <> sCount) Begin
                        Move (Replace(("[" + sCount + "]"), sLine, ("[" + sNum + "]"))) to sLine
                        If (Pos("//", sLine) > 0) ;
                            Move (sLine + " (" + sCount + ")") to sLine
                        Else ;
                            Move (sLine + "  // " + sCount) to sLine
                    End
                End
            End
            Move sLine to asBody[SizeOfArray(asBody)]
        Loop
        Move ("// " + Trim(sType) + " as DataFlex's Dftypes.pkg declares it, member for member: the same bytes.") to asBlock[0]
        Move ("Struct " + sStruct) to asBlock[1]
        For i from 0 to (SizeOfArray(asBody) - 1)
            Move asBody[i] to asBlock[SizeOfArray(asBlock)]
        Loop
        Move "End_Struct" to asBlock[SizeOfArray(asBlock)]
        Function_Return True
    End_Function

    // One copied Struct the caller has to have written (pasDfTypesLifted / pasDfTypesLiftedBlocks), once.
    Procedure _RecordDfTypesLift String sStruct String[] ByRef asBlock
        String[] asNames asBlocks

        Get pasDfTypesLifted       to asNames
        Get pasDfTypesLiftedBlocks to asBlocks
        If (SearchArray(sStruct, asNames) = -1) Begin
            Move sStruct to asNames[SizeOfArray(asNames)]
            Move (StrJoinFromArray(asBlock, (Character(10)))) to asBlocks[SizeOfArray(asBlocks)]
            Set pasDfTypesLifted       to asNames
            Set pasDfTypesLiftedBlocks to asBlocks
        End
    End_Procedure

    // PURE. DfTypesStructs.pkg's lines with every Struct in asNames it does not declare yet appended (its block from
    // asBlocks, one Character(10)-joined string per name); a new package gets its header first. The same lines, and
    // so the same size, when it declares them all.
    Function _DfTypesStructsMerged String[] ByRef asOld String[] ByRef asNames String[] ByRef asBlocks Returns String[]
        String[] asNew asBits asWords
        String sCode
        Integer i j iLast
        Boolean bHas

        Move asOld to asNew
        If (SizeOfArray(asNew) = 0) Begin
            Move "// DfTypesStructs.pkg - written by DFRefactor (ChangeExternalFunctionCallers)." to asNew[0]
            Move "//" to asNew[1]
            Move "// Structs for legacy Types that DataFlex's Dftypes.pkg declares and DataFlex ships no Struct for. Each" to asNew[2]
            Move "// is copied member for member from Dftypes.pkg, so its bytes are exactly the Type's. Keep it that way:" to asNew[3]
            Move "// DataFlex's own code (Prnt_dlg.pkg) still reads and writes those bytes through the legacy Type." to asNew[4]
        End
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move False to bHas
            For j from 0 to (SizeOfArray(asNew) - 1)
                Get _CodeOnlyLine asNew[j] to sCode
                Get _SplitSourceWords sCode to asWords
                If (SizeOfArray(asWords) >= 2) Begin
                    If (Lowercase(asWords[0]) = "struct" and Lowercase(asWords[1]) = Lowercase(Trim(asNames[i]))) ;
                        Move True to bHas
                End
            Loop
            If (bHas = False and i < SizeOfArray(asBlocks)) Begin
                Move "" to asNew[SizeOfArray(asNew)]
                Move (StrSplitToArray(asBlocks[i], (Character(10)))) to asBits
                For j from 0 to (SizeOfArray(asBits) - 1)
                    Move asBits[j] to asNew[SizeOfArray(asNew)]
                Loop
            End
        Loop
        Function_Return asNew
    End_Function

    /* WRITES what the last _ConvertWin32TypeBuffersInLines copied from Dftypes.pkg into DfTypesStructs.pkg, the one
       package each converted file Uses (see _DfTypesStructNameFor). A Struct the package already declares stays as it
       is, and an existing package is backed up first, as the engine backs up every file it changes. Nothing is
       written in a read-only run or by an analyzer probe (pbWholeFileProbe): neither writes the file the Use is in.
       The folder is the workspace's first AppSrc folder (WorkspaceSourceRoots); in the Test Bench, which works on
       DFRefactor's own LegacyCode.pkg, the source file's folder, so a try-out never writes into the workspace. False,
       with a note, when the package could not be written: the caller then leaves its file as it was, because a Use
       of a package that is not there does not compile. */
    Function _WriteDfTypesStructs String[] ByRef asNotes Returns Boolean
        String[] asNames asBlocks asOld asNew asRoots
        String sFolder sFile sSrc
        Integer iOrigin
        Boolean bOK bExists bVoid bUtf8

        Get pasDfTypesLifted       to asNames
        Get pasDfTypesLiftedBlocks to asBlocks
        If (SizeOfArray(asNames) = 0) ;
            Function_Return True
        If (pbReadOnly(Self) = True or pbWholeFileProbe(Self) = True) ;
            Function_Return True
        Get psDfTypesStructsFolder to sFolder
        If (Trim(sFolder) = "" and ghoEngine <> 0) Begin
            Get peRunOrigin of ghoEngine to iOrigin
            If (iOrigin = eRunTestBench) Begin
                Get psCurrentSourceFileName of ghoEngine to sSrc
                Move (Left(sSrc, RightPos("\", sSrc))) to sFolder
            End
        End
        If (Trim(sFolder) = "") Begin
            Get WorkspaceSourceRoots of ghoApplication to asRoots
            If (SizeOfArray(asRoots) > 0) ;
                Move asRoots[0] to sFolder
        End
        If (Trim(sFolder) = "") Begin
            Move ("left as it was - no AppSrc folder is known for this workspace, so " + CS_DfTypesStructsPkg + ", which would declare " + StrJoinFromArray(asNames, ", ") + ", could not be written") to asNotes[SizeOfArray(asNotes)]
            Function_Return False
        End
        Move (vFolderFormat(sFolder) + CS_DfTypesStructsPkg) to sFile
        Move (vFilePathExists(sFile)) to bExists
        If (bExists = True) ;
            Move (rfReadEncodedFileAsStringArray(sFile)) to asOld
        Get _DfTypesStructsMerged (&asOld) (&asNames) (&asBlocks) to asNew
        // Every one of them declared already: nothing to write.
        If (bExists = True and SizeOfArray(asNew) = SizeOfArray(asOld)) ;
            Function_Return True
        If (bExists = True) Begin
            Get SaveBackupFile of ghoApplication sFile to bVoid
            Move (rfFileHasBOM(sFile)) to bUtf8
            Get _GuardedWriteEncodedFile sFile (&asNew) bUtf8 to bOK
        End
        Else ;
            Get rfWriteEncodedFileFromStringArrayEx (&asNew) sFile (Character(13) + Character(10)) False True to bOK
        If (bOK = False) Begin
            Move ("left as it was - " + sFile + " could not be written, and this file would Use it for " + StrJoinFromArray(asNames, ", ")) to asNotes[SizeOfArray(asNotes)]
            Function_Return False
        End
        Move (sFile + " declares " + StrJoinFromArray(asNames, ", ") + " now") to asNotes[SizeOfArray(asNotes)]
        Function_Return True
    End_Function

    /* The members of a struct the INSTALL ships, or False when it ships no such struct.

       Reads tWinStructs.pkg once per run and keeps it (see pasWinStructsLines). Member NAMES only -
       that is all the caller needs, because what it has to prove is that every member the legacy
       accessors NAME still exists under the new declaration. */
    Function _ShippedStructMembers String sStructName String[] ByRef asMembers Returns Boolean
        String[] asLines asTok
        String sLine sLow sWant
        Integer i iLast
        Boolean bIn

        Move (ResizeArray(asMembers, 0)) to asMembers
        If (Trim(sStructName) = "") ;
            Function_Return False
        Get _WinStructsLines to asLines
        Move (Lowercase("struct " + Trim(sStructName))) to sWant
        Move False to bIn
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(Replaces((Character(9)), asLines[i], " "))) to sLine
            Move (Lowercase(sLine)) to sLow
            If (bIn = True) Begin
                If (Left(sLow, 10) = "end_struct") ;
                    Function_Return (SizeOfArray(asMembers) > 0)
                // _SplitSourceWords, not a split on one space: "DWord  code" in tWinNmHdr gave a blank second word,
                // so tNM_LISTVIEW's GetBuff of NMHDR.code came out as 'Move sNmLV.hdr. to iCode' (2026-11-04).
                If (sLine <> "" and Left(sLow, 2) <> "//" and Left(sLine, 1) <> "#") Begin
                    Get _SplitSourceWords sLine to asTok
                    If (SizeOfArray(asTok) >= 2) ;
                        Move (Trim(asTok[1])) to asMembers[SizeOfArray(asMembers)]
                End
            End
            Else If (sLow = sWant) ;
                Move True to bIn
        Loop
        Function_Return False
    End_Function

    /* The declared TYPE of one member of a struct the install ships - "Char[MAX_PATH]" for
       tWinWin32FindData.cFileName - or "" when the struct or the member is not there. The text
       rewriter needs the width of the block it copies into, and the names alone cannot say. */
    Function _ShippedStructMemberType String sStructName String sMember Returns String
        String[] asLines asTok
        String sLine sLow sWant
        Integer i iLast
        Boolean bIn

        If (Trim(sStructName) = "" or Trim(sMember) = "") ;
            Function_Return ""
        Get _WinStructsLines to asLines
        Move (Lowercase("struct " + Trim(sStructName))) to sWant
        Move False to bIn
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(Replaces((Character(9)), asLines[i], " "))) to sLine
            Move (Lowercase(sLine)) to sLow
            If (bIn = True) Begin
                If (Left(sLow, 10) = "end_struct") ;
                    Function_Return ""
                If (sLine <> "" and Left(sLow, 2) <> "//" and Left(sLine, 1) <> "#") Begin
                    Get _SplitSourceWords sLine to asTok
                    If (SizeOfArray(asTok) >= 2) Begin
                        If (Lowercase(Trim(asTok[1])) = Lowercase(Trim(sMember))) ;
                            Function_Return (Trim(asTok[0]))
                    End
                End
            End
            Else If (sLow = sWant) ;
                Move True to bIn
        Loop
        Function_Return ""
    End_Function

    /* The struct the INSTALL ships in place of a legacy Type name, or "".

       DataFlex renamed these mechanically when it modernised Dftypes.pkg - t<X> became tWin<X> -
       and measuring the whole file confirms the rule rather than assuming it: of the 39 legacy
       TYPEs there, 28 have a tWin twin, one is already a Struct under its own name, and 10 have no
       shipped equivalent at all (DEVMODE, DEVNAMES, PAGESETUPDLG, PRINTDLG and friends). So the
       derivation is checked against the install every time and "" is a perfectly ordinary answer.

       Case is ignored, because the install is not consistent about it - twinMEMORYSTATUS sits
       beside tWinChooseFont. */
    Function _ShippedStructForLegacyType String sLegacy Returns String
        String[] asMembers
        String sStem sCand

        Move (Trim(sLegacy)) to sStem
        If (sStem = "") ;
            Function_Return ""
        If (Lowercase(Left(sStem, 1)) = "t") ;
            Move (Right(sStem, (Length(sStem) - 1))) to sStem
        Move ("tWin" + sStem) to sCand
        If (_ShippedStructMembers(Self, sCand, (&asMembers)) = True) ;
            Function_Return sCand
        // some legacy names are ALREADY the shipped name
        If (_ShippedStructMembers(Self, Trim(sLegacy), (&asMembers)) = True) ;
            Function_Return (Trim(sLegacy))
        Function_Return ""
    End_Function

    /* Does the shipped struct carry every member these accessors name? The gate for converting a
       cluster whose Type is not declared in the workspace at all.

       MEMBERS USED, not members declared - and that is the point. Comparing whole shapes would
       refuse a conversion over a member nobody touches, while what actually has to hold is narrower
       and exact: every "<Type>.<member>" the code writes must still resolve afterwards. */
    Function _AccessorMembersExist String[] ByRef asCode String sType String sStruct String ByRef sWhyNot Returns Boolean
        String[] asMembers
        Boolean bOK

        Move "" to sWhyNot
        If (_ShippedStructMembers(Self, sStruct, (&asMembers)) = False) Begin
            Move ("the install ships no struct called " + sStruct) to sWhyNot
            Function_Return False
        End
        Get _AccessorMembersWithin (&asCode) sType (&asMembers) sStruct (&sWhyNot) to bOK
        Function_Return bOK
    End_Function

    /* The member walk of _AccessorMembersExist with the member list SUPPLIED - so a one-field Type
       (tDWORD, tHANDLE) is held to its single field exactly as a shipped struct is held to its
       members. sHolder only names the thing in the refusal. */
    Function _AccessorMembersWithin String[] ByRef asCode String sType String[] ByRef asMembers ;
            String sHolder String ByRef sWhyNot Returns Boolean
        String[] asTok
        String sIndent sCode sComment sRest sMember
        Integer i iLast iPos iAt

        Move "" to sWhyNot
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            If (Trim(sCode) <> "") Begin
                Get _WordPosAtDepthZero sCode "At" 1 to iAt
                If (iAt > 0) Begin
                    Move (Trim(Mid(sCode, Length(sCode), (iAt + 3)))) to sRest
                    Move (Pos(".", sRest)) to iPos
                    If (iPos > 0) Begin
                        If (Lowercase(Trim(Left(sRest, (iPos - 1)))) = Lowercase(sType)) Begin
                            Move (Trim(Mid(sRest, Length(sRest), (iPos + 1)))) to sMember
                            Move (StrSplitToArray(sMember, CS_S)) to asTok
                            If (SizeOfArray(asTok) > 0) ;
                                Move (Trim(asTok[0])) to sMember
                            If (sMember <> "") Begin
                                If (SearchArray(Lowercase(sMember), asMembers, Desktop, RefFunc(DFSTRICMP)) = -1) Begin
                                    Move ("line " + String(i + 1) + " uses " + sType + "." + sMember ;
                                        + ", which " + sHolder + " does not have") to sWhyNot
                                    Function_Return False
                                End
                            End
                        End
                    End
                End
            End
        Loop
        Function_Return True
    End_Function

    /* PURE. One whole-word token swapped wherever it appears in a fragment. Not _SwapCommandKeyword,
       which only ever looks at the COMMAND position - the legacy <Type>_size symbol turns up as an
       operand, and asking a command-position helper about it silently did nothing. */
    Function _SwapWordInText String sText String sOld String sNew Returns String
        Integer iPos iGuard

        Move 0 to iGuard
        Get _FindKeywordPos sText sOld True 1 to iPos
        While (iPos > 0 and iGuard < 20)
            Increment iGuard
            Move (Left(sText, (iPos - 1)) + sNew ;
                + Mid(sText, Length(sText), (iPos + Length(sOld)))) to sText
            Get _FindKeywordPos sText sOld True (iPos + Length(sNew)) to iPos
        Loop
        Function_Return sText
    End_Function

    /* PURE. Anything that cannot be part of a DataFlex identifier. "_", "$" and "#" ARE part of one
       - legacy names like "struct#" and "Dates$SystemTime.iHour" are real, and treating either as a
       boundary would split a name in half.

       Tested with Ascii(), never with sCh >= "a" - DataFlex string comparison is case-INSENSITIVE,
       so a range test on letters answers the same for both cases and cannot be used to tell them
       apart. Declared above its expression-form caller. */
    Function _IsWordBoundaryChar String sCh Returns Boolean
        Integer iA

        If (Length(sCh) = 0) ;
            Function_Return True
        Move (Ascii(sCh)) to iA
        If (iA >= 65 and iA <= 90) ;
            Function_Return False
        If (iA >= 97 and iA <= 122) ;
            Function_Return False
        If (iA >= 48 and iA <= 57) ;
            Function_Return False
        If (sCh = "_" or sCh = "$" or sCh = "#") ;
            Function_Return False
        Function_Return True
    End_Function

    /* PURE. Position of a whole word at paren depth ZERO, or 0.

       The legacy buffer statements put their keywords between operands that can contain anything -
       "Put (window_handle(focus(desktop))) To sBrowseInfo At vtBrowseInfo.hWndOwner" - so splitting
       on spaces finds a "To" inside the value as readily as the real one, and the rewrite would cut
       the statement in the wrong place. Depth is what tells them apart.

       Search starts at iFrom (1-based) so a caller can walk a statement left to right. */
    Function _WordPosAtDepthZero String sLine String sWord Integer iFrom Returns Integer
        String sCh sLow sWordLow
        Integer i iLen iDepth iWLen
        Boolean bLeft bRight

        Move (Lowercase(sLine)) to sLow
        Move (Lowercase(Trim(sWord))) to sWordLow
        Move (Length(sWordLow)) to iWLen
        If (iWLen = 0) ;
            Function_Return 0
        Move (Length(sLine)) to iLen
        Move 0 to iDepth
        If (iFrom < 1) ;
            Move 1 to iFrom
        For i from 1 to iLen
            Move (Mid(sLine, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            Else If (sCh = ")") Begin
                If (iDepth > 0) ;
                    Decrement iDepth
            End
            Else If (i >= iFrom and iDepth = 0) Begin
                If (Mid(sLow, iWLen, i) = sWordLow) Begin
                    Move True to bLeft
                    If (i > 1) ;
                        Move (_IsWordBoundaryChar(Self, Mid(sLine, 1, (i - 1)))) to bLeft
                    Move True to bRight
                    If ((i + iWLen) <= iLen) ;
                        Move (_IsWordBoundaryChar(Self, Mid(sLine, 1, (i + iWLen)))) to bRight
                    If (bLeft = True and bRight = True) ;
                        Function_Return i
                End
            End
        Loop
        Function_Return 0
    End_Function

    /* PURE. Is this SDK member line one of the emitter's own ALIGNMENT FILLERS rather than a real
       member? Fillers are named iMissingAlignment<N> by WinAPIStructDataFlexDecl and exist only to
       put the next real member at the offset the ABI demands - they carry no data and the legacy
       block never had them, so they must be excluded when the two member lists are counted against
       each other and emitted verbatim when the struct is written. */
    Function _IsAlignmentFillerLine String sLine Returns Boolean
        String[] asTok

        Move (StrSplitToArray(Trim(Replaces((Character(9)), sLine, " ")), CS_S)) to asTok
        If (SizeOfArray(asTok) < 2) ;
            Function_Return False
        // Anywhere in the name: a harvested row says iMissingAlignment1, and the padding computed for
        // a C-flavoured row says tNMCUSTOMDRAWMissingAlignment1.
        Function_Return (Pos("missingalignment", Lowercase(Trim(asTok[1]))) > 0)
    End_Function

    /* The scalar member types the DataFlex projection emits. There are exactly fourteen, and
       EVERYTHING ELSE in a catalogue member line names another struct - measured over the live
       catalogue: 2287 structs, these fourteen tokens covering every non-struct member, and 417
       distinct struct references alongside them. An "[n]" array suffix is the caller's to strip
       before asking. PURE. */
    Function _IsWinStructScalarType String sType Returns Boolean
        String[] as
        String sLow

        Move (Lowercase(Trim(sType))) to sLow
        Move "bigint"   to as[0]
        Move "char"     to as[1]
        Move "float"    to as[2]
        Move "handle"   to as[3]
        Move "integer"  to as[4]
        Move "longptr"  to as[5]
        Move "pointer"  to as[6]
        Move "real"     to as[7]
        Move "short"    to as[8]
        Move "ubigint"  to as[9]
        Move "uchar"    to as[10]
        Move "uinteger" to as[11]
        Move "ulongptr" to as[12]
        Move "ushort"   to as[13]
        Function_Return (SearchArray(sLow, as) <> -1)
    End_Function

    /* The INSTALL'S OWN Struct for an SDK struct name used as a member TYPE - "tWinPoint" for
       "POINT" - or "" when DataFlex ships none.

       WHY A MEMBER TYPE CANNOT SIMPLY BE COPIED THROUGH. The catalogue's MSG row ends "POINT pt",
       and there is no "Struct POINT" anywhere: not in the install, not in either workspace tree.
       The converted file named a type nothing declares and could not compile (Nils 2026-09-01).

       AND EMITTING ONE IS NOT THE ANSWER. DataFlex Struct declarations are GLOBAL, so a
       "Struct POINT" written into one converted file collides with the next file converted - on
       exactly the generic names this hits most (POINT, RECT, SIZE, FILETIME). The install already
       ships these as tWin<X>, so the member is pointed at the vendor's declaration instead and the
       file gets a Use for it. A nested type with no tWin twin refuses the whole Type, which is why
       this returns "" rather than guessing.

       Returns the name AS THE INSTALL SPELLS IT, so the emitted code reads like the vendor's own.
       Shares _ShippedStructMembers' lazy read of tWinStructs.pkg and its latch. */
    Function _ShippedStructNameFor String sSdkType Returns String
        String[] asLines asTok
        String sLine sWant sBare
        Integer i iLast

        Move (Trim(sSdkType)) to sBare
        If (sBare = "") ;
            Function_Return ""
        Get _WinStructsLines to asLines
        Move (Lowercase("struct twin" + sBare)) to sWant
        // A C-flavoured catalogue row (NMSELCHANGE) reaches here with the install's own name already on it.
        If (Lowercase(Left(sBare, 4)) = "twin") ;
            Move (Lowercase("struct " + sBare)) to sWant
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(Replaces((Character(9)), asLines[i], " "))) to sLine
            If (Lowercase(sLine) = sWant) Begin
                Get _SplitSourceWords sLine to asTok
                If (SizeOfArray(asTok) > 1) ;
                    Function_Return asTok[1]
            End
        Loop
        Function_Return ""
    End_Function

    // Does this code NAME a struct the install ships - any token beginning "tWin"? The signal that
    // the file has just acquired a dependency on tWinStructs.pkg. Code only, so a tWin name in a
    // comment does not count. PURE.
    Function _CodeReferencesShippedStruct String[] ByRef asCode Returns Boolean
        String[] asWords
        String sCode
        Integer i iLast j jLast

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asCode[i] to sCode
            If (Pos("tWin", sCode) > 0 or Pos("twin", Lowercase(sCode)) > 0) Begin
                Get _SplitSourceWords sCode to asWords
                Move (SizeOfArray(asWords) - 1) to jLast
                For j from 0 to jLast
                    If (Lowercase(Left(asWords[j], 4)) = "twin") ;
                        Function_Return True
                Loop
            End
        Loop
        Function_Return False
    End_Function

    /* Guarantees "Use <sPkg>" is in this file, adding it when it is not.

       NOT _EnsureUsePackage, and the difference is the point. That one retires an obsolete package
       in favour of a replacement, and deliberately REFUSES to sprout a lone Use into a file that
       has no leading Use block at all - right for a swap, because a file whose author never wrote
       a Use block is not asking for one. This is the other case: the converter has just introduced
       a dependency the file did not have, so the Use is not a tidy-up, it is what makes the file
       compile. apply_hide_tab_page.pkg has no Use line anywhere and was retyped to tWinTcItem
       (Nils 2026-09-01) - _EnsureUsePackage would have left it broken.

       Placed after any leading Use block, else before the first real code line, so it lands above
       the code that needs it and below the file's header comment. Block comments are tracked, so a
       "Use" mentioned in prose inside one cannot be mistaken for the real thing. */
    Procedure _EnsureUseForNewDependency String[] ByRef asCode String sPkg
        String[] asNew
        String sLine sTrim sLow sWant
        Integer i iLast iLastUse iFirstCode iAt iDepth iDepthBefore
        Boolean bInBlock bUseInBlock

        Move (Lowercase("use " + Trim(sPkg))) to sWant
        Move -1 to iLastUse
        Move -1 to iFirstCode
        Move False to bInBlock
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asCode[i])) to sTrim
            Move (Lowercase(sTrim)) to sLow
            If (bInBlock = True) Begin
                If (Pos("*/", sTrim) > 0) ;
                    Move False to bInBlock
            End
            Else Begin
                Move iDepth to iDepthBefore
                Send rfUseAnchorStep asCode[i] i (&iDepth) (&bUseInBlock) (&iLastUse)
                If (Left(sTrim, 2) = "/*" and Pos("*/", sTrim) = 0) ;
                    Move True to bInBlock
                Else If (Left(sLow, 4) = "use ") Begin
                    // Already declared - nothing to do, whatever else the file holds.
                    If (Left(sLow, Length(sWant)) = sWant) ;
                        Procedure_Return
                End
                Else If (sTrim <> "" and Left(sTrim, 2) <> "//" and Left(sTrim, 1) <> "#") Begin
                    If (iFirstCode = -1) ;
                        Move i to iFirstCode
                End
                /* A COMPILER CONDITIONAL AT THE TOP LEVEL is code too (2026-11-13): below its opening line the Use
                   would compile in one arm only. A package that opens by guarding a Global_Variable in one got its
                   'Use DfTypesStructs.pkg' inside the guard. */
                Else If (iDepthBefore = 0 and Left(sLow, 3) = (Character(35) + "if")) Begin
                    If (iFirstCode = -1) ;
                        Move i to iFirstCode
                End
            End
        Loop
        // After the leading Use block when there is one; otherwise immediately above the first
        // real line. A file that is nothing but comments gets it at the end - there is no code
        // for it to sit above, and appending is still better than dropping it.
        If (iLastUse >= 0) ;
            Move iLastUse to iAt
        Else If (iFirstCode >= 0) ;
            Move (iFirstCode - 1) to iAt
        Else ;
            Move iLast to iAt
        For i from 0 to iLast
            If (i = (iAt + 1) and iAt < 0) ;
                Move ("Use " + sPkg) to asNew[SizeOfArray(asNew)]
            Move asCode[i] to asNew[SizeOfArray(asNew)]
            If (i = iAt and iAt >= 0) ;
                Move ("Use " + sPkg) to asNew[SizeOfArray(asNew)]
        Loop
        If (iAt < 0 and SizeOfArray(asNew) = SizeOfArray(asCode)) ;
            Move ("Use " + sPkg) to asNew[SizeOfArray(asNew)]
        Move asNew to asCode
    End_Procedure

    /* THE LEGACY MEMBER NAMES, CARRYING THE SDK'S TYPES. Builds the body of the Struct that replaces
       a legacy Win32 Type block, and returns False with a reason when it cannot be built.

       WHY THE LEGACY NAMES SURVIVE AND THE TYPES DO NOT. Every existing reference to this buffer
       names a MEMBER - "Put lpsTitle To sBrowseInfo At vtBrowseInfo.lpszTitle" - so keeping the
       author's member names means every one of those rewrites mechanically and none has to be
       renamed. The types are the whole point of the exercise: the legacy block declares
       "lParam as dWord" where the SDK says LongPtr, which is four bytes short on x64, and it has
       none of the interior padding the ABI requires. Taking names from one side and types from the
       other is what fixes the layout without touching a single call site.

       POSITIONAL, and that is why the count must match exactly (a Type a call proved short arrives
       with the rest of the SDK's names added: _Win32DeclProvenByCalls). The SDK's own names are often not
       the legacy ones (BROWSEINFOA calls it lpfn where the legacy block says lpfnCallback), so
       matching by name would refuse conversions that are perfectly sound. Position is the only
       correspondence available, and it is only trustworthy when both sides describe the same
       members in the same order - which a differing COUNT disproves outright. A legacy block that
       FLATTENED a nested SDK struct is exactly that case (13 members against WIN32_FIND_DATA's 10)
       and is refused here by name, with the two counts in the reason.

       THE REASON IS READ ON A CHECK ROW, by someone who has never seen this code. It names the
       Windows struct the Type was taken for (sSdkName - "" from a caller that has none), gives both
       counts, says what the pairing needs and what usually breaks it. "It flattened a nested struct
       or renamed members, so position cannot be trusted" was what it said until Nils met it on a
       real row (2026-10-06): true, and gibberish.

       Alignment fillers are the SDK's, never the legacy block's: they are skipped when counting and
       emitted verbatim, because their whole job is to sit between two real members. */
    Function _Win32StructBodyFromLegacy String[] ByRef asLegacyNames String sSdkDecl ;
            String[] ByRef asOutBody String ByRef sWhyNot String sSdkName Returns Boolean
        String[] asSdk asReal
        String sLine sLow sType sComment sTrail sArr sNested sWhom sHave
        Integer i iLast iReal iNext iPos iBr

        Move (ResizeArray(asOutBody, 0)) to asOutBody
        Move "" to sWhyNot
        If (Trim(sSdkDecl) = "") Begin
            Move "the Windows API struct catalogue has no entry for it" to sWhyNot
            Function_Return False
        End
        // split the catalogue declaration into lines; it is stored with real newlines
        Move (Replaces((Character(13)), sSdkDecl, "")) to sSdkDecl
        Move (StrSplitToArray(sSdkDecl, (Character(10)))) to asSdk
        Move (SizeOfArray(asSdk) - 1) to iLast
        // count the REAL members (fillers and the Struct/End_Struct head-and-tail are not members)
        Move 0 to iReal
        For i from 0 to iLast
            Move (Trim(asSdk[i])) to sLine
            Move (Lowercase(sLine)) to sLow
            /* A "//" line inside the declaration is neither a member nor a filler - the emitter puts
               a provenance note there ("64-bit layout - win32metadata ..."). Counting it made the SDK
               look one member longer than it is and refused every conversion (2026-08-30). */
            If (sLine <> "" and Left(sLow, 7) <> "struct " and sLow <> "end_struct" and Left(sLow, 2) <> "//" and Left(sLine, 1) <> "#") Begin
                If (_IsAlignmentFillerLine(Self, sLine) = False) ;
                    Increment iReal
            End
        Loop
        If (iReal <> SizeOfArray(asLegacyNames)) Begin
            Move "the Windows struct it is named after" to sWhom
            If (Trim(sSdkName) <> "") ;
                Move (sWhom + ", " + Trim(sSdkName) + ",") to sWhom
            Move (If((SizeOfArray(asLegacyNames) = 1), "member", "members")) to sHave
            Move ("the Type lists " + String(SizeOfArray(asLegacyNames)) + " " + sHave + " and " + sWhom ;
                + " has " + String(iReal) + ". The conversion keeps the Type's member names and takes each member's type " ;
                + "from the Windows struct, pairing them by position, so the two must list the same members in the same order. " ;
                + "Usually the Type leaves a member out or writes a nested struct as its separate parts") to sWhyNot
            Function_Return False
        End
        // emit: SDK type + LEGACY name, fillers verbatim
        Move 0 to iNext
        For i from 0 to iLast
            Move (Trim(asSdk[i])) to sLine
            Move (Lowercase(sLine)) to sLow
            If (sLine <> "" and Left(sLow, 7) <> "struct " and sLow <> "end_struct") Begin
                If (Left(sLow, 2) = "//") Begin
                    Move ("    " + sLine) to asOutBody[SizeOfArray(asOutBody)]
                End
                // The IS$WIN64 guard a C-flavoured row's padding stands in.
                Else If (Left(sLine, 1) = "#") Begin
                    Move sLine to asOutBody[SizeOfArray(asOutBody)]
                End
                Else If (_IsAlignmentFillerLine(Self, sLine) = True) Begin
                    Move ("    " + sLine) to asOutBody[SizeOfArray(asOutBody)]
                End
                Else Begin
                    // "<Type> <sdkName>  // <C type>" - keep the type and any trailing comment,
                    // swap the name for the author's own.
                    Move (Pos(CS_S, sLine)) to iPos
                    If (iPos = 0) Begin
                        Move ("the SDK entry has an unreadable member line: " + sLine) to sWhyNot
                        Function_Return False
                    End
                    Move (Left(sLine, (iPos - 1))) to sType
                    /* A MEMBER TYPE THAT NAMES ANOTHER STRUCT CANNOT BE COPIED THROUGH. The
                       catalogue's MSG row ends "POINT pt" and nothing anywhere declares a
                       "Struct POINT" - the emitted file named a type that does not exist and
                       could not compile (Nils 2026-09-01). Point it at the install's tWin<X>
                       instead; writing our own would collide globally with the next file
                       converted. No twin, no conversion - see _ShippedStructNameFor. */
                    Move "" to sArr
                    Move (Pos("[", sType)) to iBr
                    If (iBr > 1) Begin
                        Move (Right(sType, (Length(sType) - iBr + 1))) to sArr
                        Move (Left(sType, (iBr - 1))) to sType
                    End
                    If (_IsWinStructScalarType(Self, sType) = False) Begin
                        Get _ShippedStructNameFor sType to sNested
                        If (sNested = "") Begin
                            // A refusal leaves NOTHING behind, like every other refusal here - the
                            // members emitted before this one are half a struct, and a caller that
                            // trusted the count would be handed one.
                            Move (ResizeArray(asOutBody, 0)) to asOutBody
                            Move ("its " + asLegacyNames[iNext] + " member is the nested struct " ;
                                + sType + ", and DataFlex ships no tWin" + sType ;
                                + " to point it at - converting it would name a type nothing declares") to sWhyNot
                            Function_Return False
                        End
                        Move sNested to sType
                    End
                    Move (sType + sArr) to sType
                    Move "" to sComment
                    Move (Pos("//", sLine)) to iPos
                    If (iPos > 0) ;
                        Move ("  " + Mid(sLine, (Length(sLine) - iPos + 1), iPos)) to sComment
                    Move ("    " + sType + " " + asLegacyNames[iNext] + sComment) to asOutBody[SizeOfArray(asOutBody)]
                    Increment iNext
                End
            End
        Loop
        Function_Return True
    End_Function

    /* PURE. A legacy Type field's data type as a Struct member can declare it (2026-11-12). A Type's Field takes
       Word, Byte and Long, which DataFlex 26 does not declare at all: "Word StructSize" in a Struct is error 4298
       "Command not found WORD", the Struct is then empty (4545) and every read of a member fails - 62 errors in one
       converted Crystal Reports package. MEASURED by compiling one Struct per type: Word, Byte and Long fail; DWord,
       Char, UChar, Short, UShort, Integer, Pointer, Handle, Address, String, Number and Date compile. The width
       stays: Word -> UShort (2 bytes), Byte -> UChar (1), Long -> Integer (4). Any other type comes back as
       written. */
    Function _LegacyFieldTypeToDataFlex String sType Returns String
        String sLow

        Move (Lowercase(Trim(sType))) to sLow
        If (sLow = "word") ;
            Function_Return "UShort"
        If (sLow = "byte") ;
            Function_Return "UChar"
        If (sLow = "long") ;
            Function_Return "Integer"
        Function_Return sType
    End_Function

    /* THE AUTHOR OWN DECLARATION, WHEN THE CATALOGUE HAS NEVER HEARD OF IT. The sibling of
       _Win32StructBodyFromLegacy above, and deliberately the same output shape - four-space
       indented "<type> <name>" lines, no head and no tail - so the caller can hand either one
       to the same emitter. This one reads the legacy block itself instead of an SDK entry.

       NAMES ARE COPIED VERBATIM, and that is the whole difference between this and the report
       _TypeDefToStruct, which runs every member through _HungarianMember (message -> iMessage).
       A report is free to rename because nothing downstream depends on it; a REWRITE is not,
       because every "X.member" reference still standing in the file has to keep resolving.

       Interior comments are carried over rather than dropped - they are usually the only record
       of what an opaque member is for, and losing them is a silent cost the author never agreed
       to. A line that is not a Field declaration refuses the whole block: half a struct is worse
       than none, and the caller counts on all-or-nothing (see _Win32StructBodyFromLegacy). */
    Function _LegacyStructBodyFromType String[] ByRef asCode Integer iStart Integer iEnd ;
            String[] ByRef asOutBody String ByRef sWhyNot Returns Boolean
        String sIndent sCode sComment sLine sBare sDataType sCount sTrail
        Integer i iMembers
        Boolean bField

        Move (ResizeArray(asOutBody, 0)) to asOutBody
        Move "" to sWhyNot
        Move 0 to iMembers
        For i from (iStart + 1) to (iEnd - 1)
            Send _SplitIndentCodeComment asCode[i] (&sIndent) (&sCode) (&sComment)
            Move (Trim(sCode)) to sLine
            Move "" to sTrail
            If (Trim(sComment) <> "") ;
                Move ("  " + Trim(sComment)) to sTrail
            If (sLine = "") Begin
                // A comment-only line, or a blank one: keep the comment, drop the blank.
                If (sTrail <> "") ;
                    Move ("    " + Trim(sComment)) to asOutBody[SizeOfArray(asOutBody)]
            End
            Else Begin
                Get _ParseTypeField sLine (&sBare) (&sDataType) (&sCount) to bField
                If (bField = False) Begin
                    Move (ResizeArray(asOutBody, 0)) to asOutBody
                    Move ("line " + String(i + 1) + " is not a Field declaration: " + sLine) to sWhyNot
                    Function_Return False
                End
                // A Field type a Struct cannot declare gets the same-width one (2026-11-12, _LegacyFieldTypeToDataFlex).
                Get _LegacyFieldTypeToDataFlex sDataType to sDataType
                /* THE DIMENSION IS COPIED, NEVER EVALUATED. _ParseTypeField keeps it verbatim
                   because it is as often a constant ("CchFormName") as a literal, and DataFlex
                   would EVALUATE the string if it were moved to a numeric. */
                If (sCount <> "") ;
                    Move (sDataType + "[" + sCount + "]") to sDataType
                // A dotted member joins, as _OwnDottedMemberMap renames its accessors.
                Move ("    " + sDataType + " " + Replaces(".", sBare, "_") + sTrail) to asOutBody[SizeOfArray(asOutBody)]
                Increment iMembers
            End
        Loop
        If (iMembers = 0) Begin
            Move (ResizeArray(asOutBody, 0)) to asOutBody
            Move "the block declares no members" to sWhyNot
            Function_Return False
        End
        Function_Return True
    End_Function

    /* PURE. The Struct members of asCode typed Word, Byte or Long get the same-width type a Struct can declare
       (_LegacyFieldTypeToDataFlex) - the repair for a Struct a converter wrote before 2026-11-12, and for one written
       by hand. Only a member line between "Struct X" and "End_Struct" (by its first word, any case, comments left
       out), and only the type word; the rest of the line stays as written. Returns the members retyped. */
    Function _LegacyStructMemberTypesInLines String[] ByRef asCode Returns Integer
        String sLine sCode sFirst
        Integer i iLast iCount iPos
        Boolean bInStruct

        Move 0 to iCount
        Move False to bInStruct
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move asCode[i] to sLine
            Get _CodeOnlyLine sLine to sCode
            Get _NthWord (Lowercase(Trim(sCode))) 1 to sFirst
            If (sFirst = "struct") ;
                Move True to bInStruct
            Else If (sFirst = "end_struct") ;
                Move False to bInStruct
            Else If (bInStruct = True and (sFirst = "word" or sFirst = "byte" or sFirst = "long")) Begin
                // the type word is the line's first word, so its first occurrence is the one
                Move (Pos(sFirst, Lowercase(sLine))) to iPos
                If (iPos > 0) Begin
                    Move (Left(sLine, (iPos - 1)) + _LegacyFieldTypeToDataFlex(Self, sFirst) + Right(sLine, (Length(sLine) - iPos - Length(sFirst) + 1))) to asCode[i]
                    Increment iCount
                End
            End
        Loop
        Function_Return iCount
    End_Function

    Function WinAPIStructDataFlexDecl String sName String[] ByRef asNotes Returns String
        String[] asStructs asMembers
        String sBody sOut sMember sType sMName sDfType sNested sArr sSA sSA86 sTail sBare sSdk sNl
        Integer i iLast iBr iBr2 iSp iPtr iOff64 iOff86 iMax64 iMax86 iA iS iA86 iS86 iBar iFill iPad64 iPad86 iPack86
        Boolean bInIf bInElse bPack1

        Move (ResizeArray(asNotes, 0)) to asNotes
        Get WinAPIStructBody sName to sBody
        If (sBody = "") ;
            Function_Return ""
        Get WinAPIStructCatalogName sName to sSdk
        /* A HARVESTED ROW (Win32_DataFlex_Projection, MIT - generated from Microsoft's win32metadata) already
           carries the finished DataFlex Struct for a 64-BIT program, its alignment members included. What it
           cannot carry is the 32-bit layout, and DataFlex packs a struct on both targets, so its 64-bit
           fillers compiled into a 32-bit program moved every member after them (Nils 2026-11-06).
           _Win32HarvestedStructDecl lays the members out for both, PROVEN first: the same rule must
           reproduce the row's own 64-bit layout, or the row stays 64-bit only and a 32-bit compile stops at
           it with the reason. The t-prefix rule the C path applies to the struct NAME applies here too. */
        If (Left(sBody, 3) = "DF|") Begin
            Move (Right(sBody, (Length(sBody) - 3))) to sBody
            Move (Replaces((Character(9)), sBody, "    ")) to sBody
            Move (Trim(sName)) to sBare
            If (Lowercase(Left(sBare, 1)) <> "t") Begin
                // First line is "Struct <SDKNAME>" - rename to the t-convention, SDK name kept.
                If (Lowercase(Left(sBody, 7)) = "struct ") ;
                    Move ("Struct t" + Trim(Right(sBody, (Length(sBody) - 7)))) to sBody
            End
            Get _Win32HarvestedStructDecl sBody sSdk (&asNotes) to sOut
            Function_Return sOut
        End
        Move ((Character(13)) + (Character(10))) to sNl
        Move (Replaces("{", sBody, " ")) to sBody
        Move (Replaces("}", sBody, " ")) to sBody
        Get RunInstallStructNames to asStructs
        Move (StrSplitToArray(sBody, ";")) to asMembers
        /* "t" MARKS THE TYPE, and only the type (Nils 2026-08-09, settling on DataFlex's own
           convention rather than a DFRefactor one): "tBrowseInfo BrowseInfo", never
           "tBrowseInfo tBrowseInfo". A type says what a thing IS, an instance says what it is FOR,
           and prefixing both says neither.

           An "st" marker was considered and dropped. All 59 Win32 structs DataFlex ships are
           "t"-prefixed, so a second convention would have meant a workspace carrying both -
           identifiable at the cost of consistent, which is the wrong trade in someone else's
           codebase.

           NOT ADDED IF IT IS ALREADY THERE. The SDK name leads this, and some of them already
           begin with T (TBBUTTON, TRUSTEEA, TVITEMA); "tTBBUTTON" would be a prefix explaining a
           prefix. Where the name already carries it, the SDK spelling stands as it is. */
        Move (Trim(sName)) to sBare
        If (Lowercase(Left(sBare, 1)) = "t") ;
            Move ("Struct " + sBare) to sOut
        Else ;
            Move ("Struct t" + sBare) to sOut
        // Each target's own offset and widest member: DataFlex packs a struct in both, so a 32-bit
        // program needs its gaps written out as much as a 64-bit one - fewer of them, and smaller.
        Move 0 to iOff64
        Move 0 to iOff86
        Move 1 to iMax64
        Move 1 to iMax86
        Move 0 to iFill
        Move 0 to iPack86
        Get _Win32Pack1OnX86 sSdk to bPack1
        If (bPack1 = True) ;
            Move 1 to iPack86
        Move False to bInIf
        Move False to bInElse
        Move (SizeOfArray(asMembers) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asMembers[i])) to sMember
            /* THE SDK'S OWN _WIN64 PAIR, PASSED THROUGH (Nils 2026-08-09: "preserve both #ifdef
               _WIN64 branches at extraction").

               Where the SDK conditions members on the target - TBBUTTON's BYTE bReserved[6] vs [2],
               WSADATA's two member ORDERS - the catalogue keeps both arms and this renders them as
               DataFlex's own IS$WIN64 guard. Mirroring beats computing here: the SDK's padding
               member has a documented name and intent, and its ordering differences are not
               padding at all.

               For LAYOUT each arm is its own target's: the members before #else are measured for a
               64-bit program only, the ones after it for a 32-bit one. The SDK balanced each arm, so
               nothing computed is added inside the pair. */
            If (Left(sMember, 1) = (Character(35))) Begin
                If (Lowercase(Left(sMember, 6)) = (Character(35) + "ifdef")) Begin
                    Move (sOut + sNl + (Character(35)) + "IFDEF IS$WIN64") to sOut
                    Move True to bInIf
                    Move False to bInElse
                End
                Else If (Lowercase(Left(sMember, 5)) = (Character(35) + "else")) Begin
                    Move (sOut + sNl + (Character(35)) + "ELSE") to sOut
                    Move False to bInIf
                    Move True to bInElse
                End
                Else If (Lowercase(Left(sMember, 6)) = (Character(35) + "endif")) Begin
                    Move (sOut + sNl + (Character(35)) + "ENDIF") to sOut
                    Move False to bInIf
                    Move False to bInElse
                End
                Move "" to sMember
            End
            If (sMember <> "") Begin
                // A C array carries its bound with the NAME; DataFlex carries it with the TYPE.
                // That move is the only rearrangement here.
                Move "" to sArr
                Move (Pos("[", sMember)) to iBr
                If (iBr > 0) Begin
                    Move (Pos("]", sMember)) to iBr2
                    If (iBr2 > iBr) ;
                        Move (Trim(Mid(sMember, (iBr2 - iBr - 1), (iBr + 1)))) to sArr
                    Move (Trim(Left(sMember, (iBr - 1)))) to sMember
                End
                Get _StripCNoiseFromText sMember to sMember
                Move (Trim(sMember)) to sMember
                Move (SizeOfArray(StrSplitToArray(sMember, "*")) - 1) to iPtr
                Move (RightPos(" ", sMember)) to iSp
                If (iSp > 0) Begin
                    Move (Trim(Right(sMember, (Length(sMember) - iSp)))) to sMName
                    Move (Trim(Replaces("*", Left(sMember, (iSp - 1)), ""))) to sType
                    Move (Replaces("*", sMName, "")) to sMName
                    // Only the struct ITSELF becomes a reference. A POINTER to one is an address.
                    Move "" to sNested
                    If (iPtr = 0) ;
                        Get _DfStructForWinAPIType sType asStructs to sNested
                    // EXACT width in the Else - a struct member's type is its layout, and the shared
                    // mapper widens narrow types on purpose for parameters. These comments stand ABOVE the
                    // If because a comment after "Else ;" ENDS the Else: the next line then ran every time,
                    // so NMSELCHANGE came out as "Integer nmhdr" and three Integers (found 2026-11-04).
                    If (sNested <> "") ;
                        Move sNested to sDfType
                    Else ;
                        Get _CTypeToDataFlexExactWidth sType iPtr to sDfType
                    If (sDfType = "" or sMName = "") Begin
                        Move ("member " + String(i + 1) + " (" + Trim(asMembers[i]) + ") has no DataFlex type - refused") to asNotes[SizeOfArray(asNotes)]
                        Function_Return ""
                    End
                    Get _DfTypeSizeAlignFor sDfType True 0 to sSA
                    Get _DfTypeSizeAlignFor sDfType False 0 to sSA86
                    If (sSA = "" or sSA86 = "") Begin
                        Move ("member " + sMName + " (" + sDfType + ") has no computable size - refused, because a guess here moves every later field") to asNotes[SizeOfArray(asNotes)]
                        Function_Return ""
                    End
                    Move (Pos("|", sSA)) to iBar
                    Move (Integer(Left(sSA, (iBar - 1)))) to iS
                    Move (Integer(Right(sSA, (Length(sSA) - iBar)))) to iA
                    Move (Pos("|", sSA86)) to iBar
                    Move (Integer(Left(sSA86, (iBar - 1)))) to iS86
                    Move (Integer(Right(sSA86, (Length(sSA86) - iBar)))) to iA86
                    If (iPack86 > 0 and iA86 > iPack86) ;
                        Move iPack86 to iA86
                    If (sArr <> "") Begin
                        // An array's ALIGNMENT is its element's, but its SIZE needs the bound - and
                        // the bound is a C constant this cannot evaluate. Emit it, and stop
                        // computing: no member after an unmeasurable one can be placed honestly.
                        Move ("array member " + sMName + "[" + sArr + "] - bound not evaluated, alignment beyond this point not computed") to asNotes[SizeOfArray(asNotes)]
                        Move (sOut + sNl + "    " + sDfType + "[" + sArr + "] " + sMName) to sOut
                        Move -1 to iOff64
                        Move -1 to iOff86
                    End
                    Else Begin
                        // Each arm of an SDK pair is measured for its own target only.
                        Move 0 to iPad64
                        Move 0 to iPad86
                        If (iOff64 >= 0 and bInElse = False) Begin
                            If (iA > iMax64) ;
                                Move iA to iMax64
                            If (Mod(iOff64, iA) <> 0) ;
                                Move (iA - Mod(iOff64, iA)) to iPad64
                            Move (iOff64 + iPad64 + iS) to iOff64
                        End
                        If (iOff86 >= 0 and bInIf = False) Begin
                            If (iA86 > iMax86) ;
                                Move iA86 to iMax86
                            If (Mod(iOff86, iA86) <> 0) ;
                                Move (iA86 - Mod(iOff86, iA86)) to iPad86
                            Move (iOff86 + iPad86 + iS86) to iOff86
                        End
                        If (iPad64 > 0 or iPad86 > 0) Begin
                            Increment iFill
                            Move (sOut + _Win32FillerLines(Self, sNl, ("t" + Trim(sName) + "MissingAlignment" + String(iFill)), iPad64, iPad86)) to sOut
                        End
                        Move (sOut + sNl + "    " + sDfType + " " + sMName) to sOut
                    End
                End
            End
        Loop
        // TAIL: each target pads to its own widest member. Only when everything was measurable - after an
        // unevaluated array bound the offset is unknown and a tail filler would be invention.
        If (iOff64 >= 0 and iOff86 >= 0) Begin
            Move 0 to iPad64
            Move 0 to iPad86
            If (Mod(iOff64, iMax64) <> 0) ;
                Move (iMax64 - Mod(iOff64, iMax64)) to iPad64
            If (Mod(iOff86, iMax86) <> 0) ;
                Move (iMax86 - Mod(iOff86, iMax86)) to iPad86
            If (iPad64 > 0 or iPad86 > 0) Begin
                Increment iFill
                Move (sOut + _Win32FillerLines(Self, sNl, ("t" + Trim(sName) + "MissingAlignment" + String(iFill)), iPad64, iPad86)) to sOut
            End
        End
        Function_Return (sOut + sNl + "End_Struct")
    End_Function

    /* Every STRUCT name the target install declares, packed "WIN32NAME|tWinName" where the Win32
       name is derived from DataFlex's own naming convention (tWinPoint -> POINT, tWin32FindData ->
       WIN32FINDDATA). Session-cached on the same walk discipline as the External_Function names.

       This is what lets a nested member be EMITTED AS A REFERENCE - "tWinPoint pt" - instead of
       being flattened (Nils 2026-08-09: "nested struct members should reference tWinPoint, not
       flatten"). Flattening is exactly what the legacy Type blocks did, and it is why 31 of the 44
       bucket-A mappings could not be swapped: tnm_treeview inlines 26 members where DataFlex nests
       6. Derived rather than curated, so a struct DataFlex adds later is picked up for free. */
    Function RunInstallStructNames Returns String[]
        String[] asOut asCode asMem
        tRFSearchResult[] aFiles
        String sPkg sMask sLine sName sWin sCurrent sMembers sPack
        Integer i iLast j jLast iSp

        If (pbInstallStructNamesLoaded(Self) = True) ;
            Function_Return (pasInstallStructNames(Self))
        Set pbInstallStructNamesLoaded to True
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) Begin
            Set pasInstallStructNames to asOut
            Function_Return asOut
        End
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        For i from 0 to iLast
            Move (rfReadEncodedFileAsStringArray(aFiles[i].sFilename)) to asCode
            Move (SizeOfArray(asCode) - 1) to jLast
            Move "" to sCurrent
            Move "" to sMembers
            For j from 0 to jLast
                Move (Trim(asCode[j])) to sLine
                If (Lowercase(Left(sLine, 7)) = "struct ") Begin
                    Move (Trim(Right(sLine, (Length(sLine) - 7)))) to sName
                    If (Pos(" ", sName) > 0) ;
                        Move (Left(sName, (Pos(" ", sName) - 1))) to sName
                    Move sName to sCurrent
                    Move "" to sMembers
                    // The convention: tWin<Name> describes the Win32 <Name>. Anything not shaped
                    // that way is a DataFlex struct of its own and has no Win32 counterpart to key.
                    If (Lowercase(Left(sName, 4)) = "twin") Begin
                        Move (Uppercase(Right(sName, (Length(sName) - 4)))) to sWin
                        If (sWin <> "") ;
                            Move (sWin + "|" + sName) to asOut[SizeOfArray(asOut)]
                    End
                End
                Else If (sCurrent <> "" and Lowercase(Left(sLine, 11)) = "end_struct") Begin
                    Move "" to sCurrent
                End
                Else If (sCurrent <> "") Begin
                    /* MEMBERS TOO, so a nested member's ALIGNMENT can be computed rather than
                       assumed. tWinFileTime is two DWords - it aligns to 4, not 8 - and assuming 8
                       mispredicts tWin32FindData's layout. The type is the first word and that is
                       all the layout needs. The preprocessor lines AND the fillers they guard are
                       skipped (a name with MissingAlig in it - tWinStructs.pkg also spells it
                       MissingAligment): a filler is not part of the shape being measured, the layout
                       computes it, and for a 32-bit program it must not be there at all. */
                    If (Left(sLine, 1) <> "#" and Left(sLine, 2) <> "//" and sLine <> "" and Pos("missingalig", Lowercase(sLine)) = 0) Begin
                        Move (Pos(" ", sLine)) to iSp
                        If (iSp > 1) ;
                            Move (sMembers + Left(sLine, (iSp - 1)) + ";") to sMembers
                        Move (Uppercase(sCurrent) + "|" + sMembers) to sPack
                        Move sPack to asMem[SizeOfArray(asMem)]
                    End
                End
            Loop
        Loop
        // Last-write-wins per struct: the loop appends a growing prefix, so the final entry for a
        // name is its complete member list. Compacted here rather than in the hot loop.
        Set pasInstallStructMembers to asMem
        Set pasInstallStructNames to asOut
        Function_Return asOut
    End_Function

    // The member TYPE list of an install struct, "Type;Type;...", or "" when unknown. Reads the
    // last (longest) entry recorded for the name - see the note in RunInstallStructNames.
    Function _InstallStructMembers String sName Returns String
        String[] asMem
        String sKey sRow sBest
        Integer i iLast
        Move (Uppercase(Trim(sName)) + "|") to sKey
        Get pasInstallStructMembers to asMem
        Move ""  to sBest
        Move (SizeOfArray(asMem) - 1) to iLast
        For i from 0 to iLast
            Move asMem[i] to sRow
            If (Left(sRow, Length(sKey)) = sKey) ;
                Move (Right(sRow, (Length(sRow) - Length(sKey)))) to sBest
        Loop
        Function_Return sBest
    End_Function

    // The DataFlex struct name for a Win32 struct type, or "" when the install has none. Tolerates
    // the underscores Win32 names carry (WIN32_FIND_DATA vs tWin32FindData) by comparing without
    // them - the convention drops them, so a literal compare would miss every multi-word name.
    Function _DfStructForWinAPIType String sType String[] asStructs Returns String
        String sKey sRow sLeft
        Integer i iLast iBar

        Move (Uppercase(Replaces("_", Trim(sType), ""))) to sKey
        If (sKey = "") ;
            Function_Return ""
        Move (SizeOfArray(asStructs) - 1) to iLast
        For i from 0 to iLast
            Move asStructs[i] to sRow
            Move (Pos("|", sRow)) to iBar
            Move (Replaces("_", Left(sRow, (iBar - 1)), "")) to sLeft
            If (sLeft = sKey) ;
                Function_Return (Right(sRow, (Length(sRow) - iBar)))
        Loop
        Function_Return ""
    End_Function

    // The packed "NAME|dll|entry" view of the same install declarations. Goes through
    // RunInstallExternalFnNames rather than reading the property, so it can never be answered from an
    // empty cache that simply has not been filled yet - the walk and the loaded flag stay one gate.
    Function RunInstallExternalFnBindings Returns String[]
        String[] asIgnore
        Get RunInstallExternalFnNames to asIgnore
        Function_Return (pasInstallExternalBindings(Self))
    End_Function

    // The declaring PACKAGE of each install declaration, packed "NAME|leaf.pkg" - what the wide guard's
    // Use-arm names. Same single gate as the bindings: through RunInstallExternalFnNames.
    Function RunInstallExternalFnPkgs Returns String[]
        String[] asIgnore
        Get RunInstallExternalFnNames to asIgnore
        Function_Return (pasInstallExternalPkgs(Self))
    End_Function

    // The install package (leaf name) that declares NAME, or "" - the same "NAME|" packed lookup as
    // _InstallBindingFor, over the pkg view.
    Function _InstallPkgFor String sName String[] asPkgs Returns String
        Function_Return (_InstallBindingFor(Self, sName, asPkgs))
    End_Function

    // PURE core of GuardDuplicateExternalFunctions (oRefactorFuncLib): wraps every External_Function
    // declaration whose name appears in asNames with an #IF (!@ <= iVer) ... #ENDIF guard, so the
    // duplicate compiles only on releases where DataFlex does not declare the same API itself (the
    // "already defined as an external_function" 4390). A ";"-continued declaration is guarded as ONE
    // block (DataFlex's own Pkg style - one parameter per line). Rewrites asCode in place; returns
    // the number of blocks guarded. Mirrors _GuardGlobalsInLines: same directive, same walk-back
    // idempotence (ANY preceding #IF = hands off), same Character()-built "#"/"!" (the FMAC lesson).
    /* The catalogue's declaration for an API, re-bound to the CALLER's DataFlex name and DLL.

       The catalogue converts an SDK prototype, so it comes back named after the C function and
       bound to CDeclarationToDataFlex's non-compiling DLL placeholder. Both have to become the
       user's: the NAME because every call site in the workspace uses theirs, and the DLL because
       the placeholder exists precisely so a guessed one cannot compile and fail at run time. */
    Function _RebindExternalHead String sDecl String sName String sDll Returns String
        String[] asRaw asTok
        String sOut
        Integer i iLast iNum

        Move (StrSplitToArray(Trim(sDecl), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTok[iNum]
                Increment iNum
            End
        Loop
        If (iNum < 5) ;
            Function_Return ""
        Move sName to asTok[1]
        Move sDll  to asTok[3]
        Move "" to sOut
        For i from 0 to (iNum - 1)
            If (sOut = "") ;
                Move asTok[i] to sOut
            Else ;
                Move (sOut + " " + asTok[i]) to sOut
        Loop
        Function_Return sOut
    End_Function

    /* The LOCAL declaration re-bound to the TWIN's entry point: token 2 - the quoted entry, with
       the twin's own casing - is the only thing copied across; the local name, dll, types and
       parameter names all stay the caller's. The counterpart of _RebindExternalHead, which walks
       the other way (twin declaration, local name + dll). "" when either side is too short to
       be a declaration. */
    Function _RebindExternalEntry String sLocal String sTwin Returns String
        String[] asRaw asTok asTwinTok
        String sOut
        Integer i iLast iNum iTwinNum

        Move (StrSplitToArray(Trim(sTwin), CS_S)) to asRaw
        Move 0 to iTwinNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTwinTok[iTwinNum]
                Increment iTwinNum
            End
        Loop
        Move (StrSplitToArray(Trim(sLocal), CS_S)) to asRaw
        Move 0 to iNum
        Move (SizeOfArray(asRaw) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asRaw[i]) <> "") Begin
                Move (Trim(asRaw[i])) to asTok[iNum]
                Increment iNum
            End
        Loop
        If (iNum < 4 or iTwinNum < 4) ;
            Function_Return ""
        Move asTwinTok[2] to asTok[2]
        Move "" to sOut
        For i from 0 to (iNum - 1)
            If (sOut = "") ;
                Move asTok[i] to sOut
            Else ;
                Move (sOut + " " + asTok[i]) to sOut
        Loop
        Function_Return sOut
    End_Function

    // The pair's three banner comment lines - ONE spelling, whichever emitter writes them.
    /* ONE FLATTENING of a ";"-continued External_Function block, END COMMENTS STRIPPED.

       THE STRIPPING IS THE WHOLE POINT (Nils 2026-08-31, DUF cDbUpdateUserCount.h.pkg). The two
       emission sites used to join the RAW lines, so a perfectly ordinary header -

           External_Function Win32_CreateFile "CreateFileA" KERNEL32.DLL ;
               Pointer lpFileName ;              // file name
               ...

       - flattened with its prose inside. _ExternalFnParamTypes then counted the comment words as
       parameters, the count no longer matched the catalogue twin, and the safety check below
       SILENTLY SWITCHED ITSELF OFF: the pair was built, with WString on the wide arm against
       Pointer on the ANSI one. Every call site passes an address, so on a Unicode DataFlex that
       address would have been marshalled as text. The guard existed and the comments walked
       around it.
       _LineWithoutEndComment is the same stripper the Deep Scan rule uses on the same block, so
       the rule and the fix read identical text - see _AnsiWideRefusalReason. */
    Function _FlatExternalFnBlock String[] ByRef asCode Integer iFrom Integer iTo Returns String
        String sFlat sPiece
        Integer i

        Move "" to sFlat
        For i from iFrom to iTo
            Get _LineWithoutEndComment asCode[i] to sPiece
            Move (sFlat + " " + sPiece) to sFlat
        Loop
        Move (Replaces((Character(9)), sFlat, " ")) to sFlat
        Move (Replaces(";", sFlat, " ")) to sFlat
        Function_Return (Trim(sFlat))
    End_Function

    /* WHY THIS ANSI DECLARATION CANNOT BE PAIRED with its catalogue wide twin - "" when it can.

       ONE ANSWER, TWO CALLERS. The converter refuses with it and the Deep Scan rule (DS 9221)
       declines to raise a finding with it, so the board can no longer offer a Run button over a
       declaration the run will refuse (Nils 2026-08-31: "There is simply no point of having it if
       it cannot do anything"). Split between the two, they drifted immediately.

       A COUNT MISMATCH IS A REFUSAL, not a pass. It used to fall through to "no mix found" -
       which is exactly how the commented block above got paired. If the local parameter list and
       the catalogue twin do not line up, nothing here can promise the two arms take the same
       arguments, and a pair that changes the call contract is worse than no pair. */
    /* PURE. The "// refs: A B" tail of a RAW catalogue payload, normalised to "A B" - "" when the
       row carries none. The harvester writes it (cWin32ProjectionHarvester.FunctionRow) and
       WinAPIStructForApi reads it for the FIRST struct name; this is the second reader, and it
       wants the whole list, because an API can take two (BuildSecurityDescriptorA refs both
       TRUSTEE_A and EXPLICIT_ACCESS_A) and a pair is unsafe if ANY of them differs.

       Pos is case-sensitive and the harvester writes the marker in lower case, so an exact match
       is right here - see [[feedback_dataflex_pos_is_case_sensitive]] for the reverse mistake. */
    Function _WinAPIRefsOf String sRow Returns String
        String sRefs
        Integer iAt

        Move (Pos("// refs:", sRow)) to iAt
        If (iAt = 0) ;
            Function_Return ""
        Move (Trim(Right(sRow, (Length(sRow) - (iAt + 7))))) to sRefs
        // "// args:" follows it on a row that has one - see _WinAPIArgStructOf.
        Move (Pos("//", sRefs)) to iAt
        If (iAt > 0) ;
            Move (Trim(Left(sRefs, (iAt - 1)))) to sRefs
        Function_Return sRefs
    End_Function

    /* PURE. The struct a RAW catalogue payload says argument iArg (counted from 1) points at - "" when it
       says none. The "// args: 4=MENUITEMINFOA" tail is the harvester's (FunctionRow), and it answers
       what "// refs:" cannot: refs names every struct the FUNCTION mentions, not which argument takes
       which. */
    Function _WinAPIArgStructOf String sRow Integer iArg Returns String
        String[] asPairs
        String sWant
        Integer iAt i iLast

        Move (Pos("// args:", sRow)) to iAt
        If (iAt = 0) ;
            Function_Return ""
        Move (Trim(Right(sRow, (Length(sRow) - (iAt + 7))))) to sWant
        // Up to the next tail only - a "1=PSTR" from another tail would answer for argument 1.
        Move (Pos("//", sWant)) to iAt
        If (iAt > 0) ;
            Move (Trim(Left(sWant, (iAt - 1)))) to sWant
        Move (StrSplitToArray(sWant, CS_S)) to asPairs
        Move (String(iArg) + "=") to sWant
        Move (SizeOfArray(asPairs) - 1) to iLast
        For i from 0 to iLast
            If (Left(asPairs[i], Length(sWant)) = sWant) ;
                Function_Return (Right(asPairs[i], (Length(asPairs[i]) - Length(sWant))))
        Loop
        Function_Return ""
    End_Function

    /* PURE. The C type a RAW catalogue payload records for argument iArg (counted from 1) when the
       declaration passes it as raw memory - "" when the row says nothing about it. The "// ptrs:" tail
       is the harvester's (FunctionRow), written on ...A and ...W rows only: "// ptrs: 1=PSTR 2=UInteger*".
       It stops at the next tail, like the other two readers. */
    Function _WinAPIPtrCTypeOf String sRow Integer iArg Returns String
        String[] asPairs
        String sTail sWant
        Integer iAt i iLast

        Move (Pos("// ptrs:", sRow)) to iAt
        If (iAt = 0) ;
            Function_Return ""
        Move (Trim(Right(sRow, (Length(sRow) - (iAt + 7))))) to sTail
        Move (Pos("//", sTail)) to iAt
        If (iAt > 0) ;
            Move (Trim(Left(sTail, (iAt - 1)))) to sTail
        Move (StrSplitToArray(sTail, CS_S)) to asPairs
        Move (String(iArg) + "=") to sWant
        Move (SizeOfArray(asPairs) - 1) to iLast
        For i from 0 to iLast
            If (Left(asPairs[i], Length(sWant)) = sWant) ;
                Function_Return (Right(asPairs[i], (Length(asPairs[i]) - Length(sWant))))
        Loop
        Function_Return ""
    End_Function

    Function _AnsiWideRefusalReason String sFlatLocal String sWideDecl ;
            String sCatAnsiRaw String sCatWideRaw Returns String
        String[] asLocal asTwin
        String sLocalRet sTwinRet sRefA sRefW sPtrA sPtrW sL sT
        Integer i iLast
        Boolean bMix

        If (Trim(sFlatLocal) = "" or Trim(sWideDecl) = "") ;
            Function_Return "its declaration or the catalogue twin could not be read"
        Get _ExternalFnParamTypes sFlatLocal (&asLocal) to sLocalRet
        Get _ExternalFnParamTypes sWideDecl  (&asTwin)  to sTwinRet
        If (SizeOfArray(asLocal) <> SizeOfArray(asTwin)) ;
            Function_Return ("its parameter list does not line up with the catalogue wide twin (" ;
                + String(SizeOfArray(asLocal)) + " against " + String(SizeOfArray(asTwin)) ;
                + "), so the two arms could not be guaranteed to take the same arguments")
        Get _ApiPtrVsMarshalMix (&asLocal) sLocalRet (&asTwin) sTwinRet to bMix
        If (bMix = True) ;
            Function_Return ("it declares Pointer where the wide twin marshals text: a manual-conversion " ;
                + "(AddressOf) binding, not pairable mechanically - the vWin32fh wrappers are the migration " ;
                + "for that shape")
        /* The same convention in 32-bit dress (2026-11-21): an address kept in an Integer, where the wide
           twin marshals text. _ApiPtrVsMarshalMix classes Integer as a number, not a pointer, so it does not
           see it - and the wide arm would turn the address itself into text. _ApiPtrVsMarshalMix is shared
           with the retyper, so the extra case lives here, where only the pairing asks. */
        Move (SizeOfArray(asLocal) - 1) to iLast
        For i from 0 to iLast
            Get _ApiTypeClass asLocal[i] to sL
            Get _ApiTypeClass asTwin[i]  to sT
            If ((sL = "int4" or sL = "int8") and (sT = "string" or sT = "wstring")) ;
                Function_Return ("argument " + String(i + 1) + " is declared " + asLocal[i] + " where the wide twin " ;
                    + "marshals text: the call sites pass an address in it (AddressOf), and the wide entry would " ;
                    + "receive that number as text - a manual-conversion binding, not pairable mechanically")
        Loop

        /* THE STRUCT SPLIT, and it is the one the first two checks cannot see (2026-09-16).
           SHFileOperationA and SHFileOperationW both declare "Pointer lpFileOp": the arity lines
           up, there is no pointer-vs-marshal mix, and the pair was being offered as an Auto-fix.
           But the catalogue records that one takes SHFILEOPSTRUCTA and the other SHFILEOPSTRUCTW.
           Swapping the entry point is one line; the structure the CALL SITE fills is not, and the
           converter cannot see those sites - so the emitted wide arm would receive an ANSI layout.
           Nothing fails to compile. It is wrong at run time, silently, which is the worst kind of
           row to put a Run button on.

           Measured over the catalogue: 367 of 2,069 A/W pairs differ this way, and DS 9221 raised
           15 live Auto-fix rows on exactly that shape across the test workspaces.

           BOTH tails must be present to judge. A row with no "// refs:" tells us nothing about the
           structures it takes, and refusing on silence would decline 1,702 pairs that are fine. */
        Get _WinAPIRefsOf sCatAnsiRaw to sRefA
        Get _WinAPIRefsOf sCatWideRaw to sRefW
        If (sRefA <> "" and sRefW <> "" and sRefA <> sRefW) ;
            Function_Return ("the wide twin takes " + sRefW + " where this one takes " + sRefA ;
                + ": the entry point can be swapped but the structure its call sites fill cannot, " ;
                + "so the pair would hand the wide entry an ANSI-laid-out buffer - a fault that " ;
                + "compiles cleanly and is wrong only when it runs")

        /* RAW MEMORY THAT IS NOT THE SAME MEMORY (2026-11-21). GetComputerNameA and GetComputerNameW
           both declare "Pointer lpBuffer Pointer nSize": the arity lines up, there is no marshalled
           text to mix with, and neither takes a structure, so every check above passes. But the
           buffer is PSTR on one and PWSTR on the other. The call sites hand over AddressOf an 8-bit
           String; the wide entry writes UTF-16 into it, and the caller reads back the first letter.
           That is the pair DS 9221 made on 2026-09-11, and nothing here could see it, because the
           DataFlex types agree and only the C types differ.

           The harvester keeps those C types in the "// ptrs:" tail. Measured over the catalogue: 936
           of 2,069 A/W pairs have a raw-memory argument whose C type differs between the arms - text
           buffers (PSTR against PWSTR, Char* against UShort*), pointers to text, callbacks that receive text, and the
           structure pointers the refs check above already declines. One pair is refused that would
           have been fine (BroadcastSystemMessage: UInteger* against a structure pointer for the same
           DWORD) - refusing leaves the ANSI declaration as it is, which is the safe direction.

           As with refs, BOTH rows must state a type for the argument; silence is not evidence. */
        Move (SizeOfArray(asLocal)) to iLast
        For i from 1 to iLast
            Get _WinAPIPtrCTypeOf sCatAnsiRaw i to sPtrA
            Get _WinAPIPtrCTypeOf sCatWideRaw i to sPtrW
            If (sPtrA <> "" and sPtrW <> "" and sPtrA <> sPtrW) ;
                Function_Return ("argument " + String(i) + " is raw memory that the wide entry reads as " ;
                    + sPtrW + " where this one reads " + sPtrA + ": the call sites prepare that memory " ;
                    + "for the ANSI entry, and the declaration cannot change what they put in it, so the " ;
                    + "pair would compile cleanly and give wrong results when it runs")
        Loop
        Function_Return ""
    End_Function

    Procedure _EmitWideBanner String[] ByRef asOut String sIndent String sVerText
        Move (sIndent + "// [DFRefactor] ANSI and wide side by side - the compiler picks (DataFlex " + sVerText + " and later is Unicode).") to asOut[SizeOfArray(asOut)]
        Move (sIndent + "// Same DataFlex name on both arms, so no call site changes. A buffer handed to the wide") to asOut[SizeOfArray(asOut)]
        Move (sIndent + "// entry is WString, not String - check the ones that pass raw memory.") to asOut[SizeOfArray(asOut)]
    End_Procedure

    /* The Use-arm's banner - _EmitWideBanner's sibling for a name the TARGET DataFlex declares itself
       (Nils 2026-09-02, WinServ: DataFlex 26's cHttpTransfer.pkg ships WinAPI_InternetSetOption and
       WinAPI_InternetQueryOption; four scratch compiles proved that ANY second External_Function of a
       name is error 4390, whatever its entry or return type - so a wide twin there breaks the very
       build it was written for). Two lines, both tagged for the banner scans: the [DFRefactor] marker
       keeps the gate enterable for the retyper and reads as finished work to DS 9221. */
    Procedure _EmitUseArmBanner String[] ByRef asOut String sIndent String sName String sPkg String sTargetText
        Move (sIndent + "// [DFRefactor] DataFlex " + sTargetText + " declares " + sName + " itself (" + sPkg + ") - a second External_Function of the name is error 4390.") to asOut[SizeOfArray(asOut)]
        Move (sIndent + "// The declaration below stays for older releases; from " + sTargetText + " the package's own declaration is used - same name, no call site changes.") to asOut[SizeOfArray(asOut)]
    End_Procedure

    /* The wide arm's emitted text (multi-line, CRLF-joined): the twin's entry and types with the
       block's own name, dll, parameter names and class-agreeing type spellings; the SDK-name
       reflow when the block's names cannot be aligned (an inline comment, an odd legacy shape);
       the flat rebound declaration only as the last resort for a twin too short to parse.
       sLocalFlat is the flattened ANSI declaration, sWideDecl the catalogue twin already REBOUND
       to the local name and dll. */
    Function _WideArmText String sIndent String sLocalFlat String sWideDecl Returns String
        String sLocalWide sWideMulti

        Get _RebindExternalEntry (Trim(sLocalFlat)) sWideDecl to sLocalWide
        Move "" to sWideMulti
        If (sLocalWide <> "") ;
            Get _ApiDeclWithSdkTypes sIndent sLocalWide sWideDecl to sWideMulti
        If (sWideMulti = "") ;
            Get _ApiDeclWithSdkTypes sIndent sWideDecl sWideDecl to sWideMulti
        If (sWideMulti = "") ;
            Move (sIndent + sWideDecl) to sWideMulti
        Function_Return sWideMulti
    End_Function

    /* THE COMPOSITION FIX (probe-verified gap, Nils 2026-08-28). A top-level "#IFDEF IS$WIN64"
       pair whose BOTH arms bind the same ...A entry is the retyper's guarded pair - a
       declaration that qualified for BOTH converters. The plain per-declaration walk composed
       that wrongly: it skipped the x64 arm (previous line starts #IF) but wrapped the x86 arm
       where it stood, nesting the version gate INSIDE the #ELSE - legal on every build, stable
       on re-runs, and the x64+DF26 build silently kept calling the ANSI entry while both run
       counters reported success. Recognised HERE, the whole pair rides the version gate's #IF
       arm and the wide twin its #ELSE:

           #IF (!@ < ver)
               #IFDEF IS$WIN64 / corrected A / #ELSE / original A / #ENDIF
           #ELSE
               <the W twin>
           #ENDIF

       - every cell of the version x bitness matrix gets its right arm, WHICHEVER converter ran
       first (the retyper composes the same shape from the other direction: it corrects inside a
       version arm and leaves the W arm alone, whose types already agree - and plan runs are
       per-grid-row scoped passes, so neither order can be relied on).

       TWO GATE IDIOMS, ON PURPOSE - decided with Nils 2026-08-28 evening, after weighing a
       single-idiom unification. Each gate names the condition it actually switches on: the type
       pair gates on IS$WIN64 because pointer WIDTH is a bitness fact, and the wide pair gates
       on the DataFlex VERSION because wideness is a runtime-generation fact - an x86 build on
       DataFlex 26 is still Unicode and rightly gets the W entry (gate the wide pair on bitness
       and that build regresses to ANSI text conversion). The matrix above only composes BECAUSE
       the two conditions are independent axes; one idiom for both would collapse a cell.

       Returns the consumed END index with the region handled, or -1 when the region is not this
       shape (the caller then treats the line as ordinary). bWrapped answers False for the
       copied-through cases: already version-wrapped (idempotence), no twin in the catalogue, or
       a pointer-vs-marshal binding (voiced, exactly like the plain path).

       THE TARGET INSTALL FIRST (Nils 2026-09-02): when the target DataFlex declares the name itself
       (asInstall / asInstallPkgs - RunInstallExternalFnNames' cached walk), the pair needs no wide
       twin at all: the whole IS$WIN64 pair rides the TARGET version's #IF arm and the #ELSE arm is
       'Use <the declaring package>' - see the plain path in _GuardAnsiWideInLines. iTargetVer bounds
       that gate (0 = iVer), the wide pair keeps iVer. */
    /* THE FILE ITSELF MAY BE THE PACKAGE (2026-09-03). A workspace copy of a DataFlex package -
       the shadowing-copy population the system-override line lists - carries the same leaf as
       the install file that declares the name, so a 'Use <leaf>' written into it would resolve
       to the file itself; and the install's copy, the one the Use was meant to reach, is
       shadowed and not compiled at all. Answers "" after saying so - the twin route then serves,
       the copy's declaration being the only one compiled - and the package otherwise. A blank
       leaf (the pure core's test callers) checks nothing. */
    Function _UseArmUnlessSelf String sUsePkg String sSelfLeaf String sLocalName Returns String
        String sSelf

        Move sSelfLeaf to sSelf
        If (sUsePkg = "" or Trim(sSelf) = "") ;
            Function_Return sUsePkg
        If (Lowercase(Trim(sSelf)) <> Lowercase(Trim(sUsePkg))) ;
            Function_Return sUsePkg
        Send AddRunNote "GuardAnsiExternalFunctionWithWide" (sLocalName + " - this file shares its name with DataFlex's own " ;
            + sUsePkg + ", so 'Use " + sUsePkg + "' would read the file itself; the wide twin serves instead. " ;
            + "A workspace copy of a DataFlex package is retired, not guarded - see the system-override line on the dashboard.")
        Function_Return ""
    End_Function

    Function _TryWrapWin64Pair String[] ByRef asCode Integer iStart Integer iSize Integer iVer String sVerText String[] ByRef asOut Boolean ByRef bWrapped Integer iTargetVer String sTargetText String[] ByRef asInstall String[] ByRef asInstallPkgs String sSelfLeaf Returns Integer
        String[] asTmpA asTmpB asHeadTok
        String sT sPacked1 sPacked2 sIndent sPrev sLocalFlat sWideDecl sWide sWideMulti sDll sEntry sRest sWhyNot
        String sOldRet sNewRet sCallNote sRawHead sName sUsePkg sLocalName
        Integer i iDepth iElse iEndBlock iBar iJ iNum
        Boolean bMix

        Move False to bWrapped
        // the region: matching #ELSE and #ENDIF at this pair's own depth, nesting-tolerant
        Move -1 to iElse
        Move -1 to iEndBlock
        Move 0 to iDepth
        Move (iStart + 1) to i
        While (i <= iSize and iEndBlock = -1)
            Move (Lowercase(Trim(Replaces((Character(9)), asCode[i], " ")))) to sT
            If (Left(sT, 3) = "#if") ;
                Increment iDepth
            Else Begin
                If (Left(sT, 6) = "#endif") Begin
                    If (iDepth = 0) ;
                        Move i to iEndBlock
                    Else ;
                        Move (iDepth - 1) to iDepth
                End
                Else Begin
                    If (sT = "#else" and iDepth = 0) ;
                        Move i to iElse
                End
            End
            Increment i
        Loop
        If (iEndBlock = -1 or iElse <= iStart) ;
            Function_Return -1

        // both arms must bind the SAME ...A entry - the first packed head of each arm decides
        Move "" to sPacked1
        Move "" to sPacked2
        Move "" to sRawHead
        For i from (iStart + 1) to (iElse - 1)
            If (sPacked1 = "") ;
                Get _ExternalFnHeadPacked asCode[i] to sPacked1
        Loop
        For i from (iElse + 1) to (iEndBlock - 1)
            If (sPacked2 = "") Begin
                Get _ExternalFnHeadPacked asCode[i] to sPacked2
                If (sPacked2 <> "") ;
                    Move asCode[i] to sRawHead
            End
        Loop
        If (sPacked1 = "" or sPacked1 <> sPacked2) ;
            Function_Return -1
        Move (Pos("|", sPacked1)) to iBar
        Move (Right(sPacked1, (Length(sPacked1) - iBar))) to sRest
        Move (Pos("|", sRest)) to iBar
        Move (Left(sRest, (iBar - 1))) to sDll
        Move (Right(sRest, (Length(sRest) - iBar))) to sEntry
        If (Right(sEntry, 1) <> "a") ;
            Function_Return -1

        // From here the region is OURS to place in asOut, whatever the verdict below.
        // Idempotence: a pair already riding a version gate is done - copy it through.
        Move (SizeOfArray(asOut) - 1) to i
        Move "" to sPrev
        While (i >= 0 and sPrev = "")
            Move (Trim(asOut[i])) to sPrev
            Decrement i
        Loop
        If (Uppercase(Left(sPrev, 3)) = (Character(35) + "IF")) Begin
            For i from iStart to iEndBlock
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Function_Return iEndBlock
        End

        // the local name and dll, in the USER'S casing, from the raw head line
        Move (Replaces((Character(9)), sRawHead, " ")) to sRawHead
        Move (StrSplitToArray(Trim(sRawHead), " ")) to asTmpA
        Move 0 to iNum
        For i from 0 to (SizeOfArray(asTmpA) - 1)
            If (Trim(asTmpA[i]) <> "") Begin
                Move (Trim(asTmpA[i])) to asHeadTok[iNum]
                Increment iNum
            End
        Loop
        If (iNum < 4) Begin
            For i from iStart to iEndBlock
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Function_Return iEndBlock
        End
        Move asHeadTok[1] to sLocalName

        // THE TARGET INSTALL FIRST: a name DataFlex declares itself gets the Use-arm, not a twin.
        Move (Left(sPacked1, (Pos("|", sPacked1) - 1))) to sName
        Move "" to sUsePkg
        If (SizeOfArray(asInstall) > 0) Begin
            If (BinarySearchArray(sName, asInstall) <> -1) ;
                Get _InstallPkgFor sName asInstallPkgs to sUsePkg
        End
        Get _UseArmUnlessSelf sUsePkg sSelfLeaf sLocalName to sUsePkg
        If (sUsePkg <> "") Begin
            Move (Left(asCode[iStart], (Length(asCode[iStart]) - Length(LTrim(asCode[iStart]))))) to sIndent
            Send _EmitUseArmBanner (&asOut) sIndent sLocalName sUsePkg sTargetText
            Move (sIndent + Character(35) + "IF (" + Character(33) + "@ < " + String(iTargetVer) + ")") to asOut[SizeOfArray(asOut)]
            For i from iStart to iEndBlock
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Move (sIndent + Character(35) + "ELSE") to asOut[SizeOfArray(asOut)]
            Move (sIndent + "Use " + sUsePkg) to asOut[SizeOfArray(asOut)]
            Move (sIndent + Character(35) + "ENDIF") to asOut[SizeOfArray(asOut)]
            Send AddRunNote "GuardAnsiExternalFunctionWithWide" (sLocalName + " - DataFlex " + sTargetText ;
                + " declares it itself (" + sUsePkg + "), so no wide twin: the pair now compiles only below " ;
                + sTargetText + ", and from there the file reads it through 'Use " + sUsePkg ;
                + "'. Check the call sites that pass text buffers or store the return against that declaration.")
            Move True to bWrapped
            Function_Return iEndBlock
        End

        // the twin, from the catalogue only - exactly the plain path's rule
        Move (Left(sEntry, (Length(sEntry) - 1)) + "w") to sWide
        Get WinAPIPrototype sDll sWide to sWideDecl
        If (sWideDecl = "") Begin
            For i from iStart to iEndBlock
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Function_Return iEndBlock
        End

        // the ORIGINAL (x86) arm is the local declaration: names, casing and type spellings
        Get _FlatExternalFnBlock (&asCode) (iElse + 1) (iEndBlock - 1) to sLocalFlat
        Get _RebindExternalHead sWideDecl asHeadTok[1] asHeadTok[3] to sWideDecl

        // The RETURN types are still parsed here: _CallSiteNoteForReturnChange below needs them,
        // and they must come from the same flattened text the refusal judged.
        Get _ExternalFnParamTypes (Trim(sLocalFlat)) (&asTmpA) to sOldRet
        Get _ExternalFnParamTypes sWideDecl (&asTmpB) to sNewRet
        // Unpairable bindings are refused whole and voiced - the shared rule, so this path and
        // the plain one below cannot answer differently (see _AnsiWideRefusalReason).
        // The RAW catalogue rows, not the rebound/cut ones: the struct check reads their
        // "// refs:" tails, which _WinAPIDataFlexDeclFromCat strips on the way past.
        Get _AnsiWideRefusalReason (Trim(sLocalFlat)) sWideDecl ;
            (WinAPIPrototype(Self, sDll, sEntry)) (WinAPIPrototype(Self, sDll, sWide)) to sWhyNot
        If (sWhyNot <> "") Begin
            For i from iStart to iEndBlock
                Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Send AddRunNote "GuardAnsiExternalFunctionWithWide" ((asHeadTok[1]) ;
                + " - left alone: " + sWhyNot + ".")
            Function_Return iEndBlock
        End

        // the composed matrix: banner, version gate, the WHOLE IS$WIN64 pair, then the twin
        Move (Left(asCode[iStart], (Length(asCode[iStart]) - Length(LTrim(asCode[iStart]))))) to sIndent
        Send _EmitWideBanner (&asOut) sIndent sVerText
        Move (sIndent + Character(35) + "IF (" + Character(33) + "@ < " + String(iVer) + ")") to asOut[SizeOfArray(asOut)]
        For i from iStart to iEndBlock
            Move asCode[i] to asOut[SizeOfArray(asOut)]
        Loop
        Move (sIndent + Character(35) + "ELSE") to asOut[SizeOfArray(asOut)]
        Get _WideArmText sIndent (Trim(sLocalFlat)) sWideDecl to sWideMulti
        Get _AppendLines (&asOut) sWideMulti to iJ
        Move (sIndent + Character(35) + "ENDIF") to asOut[SizeOfArray(asOut)]
        Get _CallSiteNoteForReturnChange (&asCode) asHeadTok[1] sOldRet sNewRet to sCallNote
        If (sCallNote <> "") ;
            Send AddRunNote "GuardAnsiExternalFunctionWithWide" sCallNote
        Move True to bWrapped
        Function_Return iEndBlock
    End_Function

    /* THE REPAIR of a wide pair this tool emitted EARLIER for a name the target install turns out to
       declare itself (Nils 2026-09-02: the WinAPI wide-guard campaign wrote WinServ's
       InternetOption.pkg a wide arm for WinAPI_InternetSetOption / WinAPI_InternetQueryOption, and
       DataFlex 26's own cHttpTransfer.pkg - pulled in through Combo_mx.pkg - declares both: two
       errors 4390 the campaign itself had planted). Called at a depth-0 version gate; answers -1
       unless ALL of these hold, and the caller then treats the line as ordinary (the idempotence
       walk copies the pair through untouched):
         - the last three lines placed so far are _EmitWideBanner's three, verbatim - OUR pair, not
           the author's gate and not a hand-edited banner (refuse-not-guess);
         - the region has a depth-0 #ELSE and #ENDIF, and the FIRST declaration head of each arm
           names the same External_Function;
         - the target install declares that name (asInstall / asInstallPkgs).
       Then the old banner comes off asOut, the Use-arm banner goes on, the gate is rewritten to the
       TARGET version, the #IF arm (the ANSI declaration, or a whole IS$WIN64 pair) is kept verbatim,
       and the wide arm is replaced by 'Use <package>'. Re-runs see the new banner, not the old, and
       fall through to the idempotence walk. Returns the consumed END index. */
    Function _TryRepairWidePairToUse String[] ByRef asCode Integer iStart Integer iSize Integer iTargetVer String sTargetText String[] ByRef asOut String[] ByRef asInstall String[] ByRef asInstallPkgs String sSelfLeaf Returns Integer
        String[] asTmp asHeadTok
        String sT sPackedA sPackedW sNameA sNameW sUsePkg sIndent sRawHead sLocalName
        Integer i iDepth iElse iEndBlock iOut iNum

        If (SizeOfArray(asInstall) = 0) ;
            Function_Return -1
        // OURS: _EmitWideBanner's three lines are the last three placed so far.
        Move (SizeOfArray(asOut)) to iOut
        If (iOut < 3) ;
            Function_Return -1
        If (not(asOut[iOut - 3] contains "[DFRefactor] ANSI and wide side by side")) ;
            Function_Return -1
        If (not(asOut[iOut - 2] contains "Same DataFlex name on both arms")) ;
            Function_Return -1
        If (not(asOut[iOut - 1] contains "entry is WString, not String")) ;
            Function_Return -1
        // the region: matching #ELSE and #ENDIF at this gate's own depth, nesting-tolerant (an
        // IS$WIN64 pair inside the #IF arm is one level down and passes through)
        Move -1 to iElse
        Move -1 to iEndBlock
        Move 0 to iDepth
        Move (iStart + 1) to i
        While (i <= iSize and iEndBlock = -1)
            Move (Lowercase(Trim(Replaces((Character(9)), asCode[i], " ")))) to sT
            If (Left(sT, 3) = (Character(35) + "if")) ;
                Increment iDepth
            Else Begin
                If (Left(sT, 6) = (Character(35) + "endif")) Begin
                    If (iDepth = 0) ;
                        Move i to iEndBlock
                    Else ;
                        Move (iDepth - 1) to iDepth
                End
                Else Begin
                    If (sT = (Character(35) + "else") and iDepth = 0) ;
                        Move i to iElse
                End
            End
            Increment i
        Loop
        If (iEndBlock = -1 or iElse <= iStart) ;
            Function_Return -1
        // the first declaration head of each arm - same name on both, or this is not a pair of ours
        Move "" to sPackedA
        Move "" to sPackedW
        Move "" to sRawHead
        For i from (iStart + 1) to (iElse - 1)
            If (sPackedA = "") Begin
                Get _ExternalFnHeadPacked asCode[i] to sPackedA
                If (sPackedA <> "") ;
                    Move asCode[i] to sRawHead
            End
        Loop
        For i from (iElse + 1) to (iEndBlock - 1)
            If (sPackedW = "") ;
                Get _ExternalFnHeadPacked asCode[i] to sPackedW
        Loop
        If (sPackedA = "" or sPackedW = "") ;
            Function_Return -1
        Move (Left(sPackedA, (Pos("|", sPackedA) - 1))) to sNameA
        Move (Left(sPackedW, (Pos("|", sPackedW) - 1))) to sNameW
        If (sNameA <> sNameW) ;
            Function_Return -1
        If (BinarySearchArray(sNameA, asInstall) = -1) ;
            Function_Return -1
        Get _InstallPkgFor sNameA asInstallPkgs to sUsePkg
        If (sUsePkg = "") ;
            Function_Return -1
        // the local name in the USER'S casing, from the raw head line
        Move (Replaces((Character(9)), sRawHead, " ")) to sRawHead
        Move (StrSplitToArray(Trim(sRawHead), " ")) to asTmp
        Move 0 to iNum
        For i from 0 to (SizeOfArray(asTmp) - 1)
            If (Trim(asTmp[i]) <> "") Begin
                Move (Trim(asTmp[i])) to asHeadTok[iNum]
                Increment iNum
            End
        Loop
        If (iNum < 4) ;
            Function_Return -1
        Move asHeadTok[1] to sLocalName
        // A file named like the package keeps its wide pair (-1 = the idempotence walk copies it through).
        Get _UseArmUnlessSelf sUsePkg sSelfLeaf sLocalName to sUsePkg
        If (sUsePkg = "") ;
            Function_Return -1
        // the repair: our old banner off, the Use-arm on
        Move (ResizeArray(asOut, (iOut - 3))) to asOut
        Move (Left(asCode[iStart], (Length(asCode[iStart]) - Length(LTrim(asCode[iStart]))))) to sIndent
        Send _EmitUseArmBanner (&asOut) sIndent sLocalName sUsePkg sTargetText
        Move (sIndent + Character(35) + "IF (" + Character(33) + "@ < " + String(iTargetVer) + ")") to asOut[SizeOfArray(asOut)]
        For i from (iStart + 1) to (iElse - 1)
            Move asCode[i] to asOut[SizeOfArray(asOut)]
        Loop
        Move (sIndent + Character(35) + "ELSE") to asOut[SizeOfArray(asOut)]
        Move (sIndent + "Use " + sUsePkg) to asOut[SizeOfArray(asOut)]
        Move (sIndent + Character(35) + "ENDIF") to asOut[SizeOfArray(asOut)]
        Send AddRunNote "GuardAnsiExternalFunctionWithWide" (sLocalName + " - the earlier wide arm replaced by 'Use " ;
            + sUsePkg + "': DataFlex " + sTargetText + " declares this name itself, and a second External_Function " ;
            + "of it is error 4390 whatever its entry point. The declaration now compiles only below " + sTargetText + ".")
        Function_Return iEndBlock
    End_Function

    /* Every ANSI External_Function that HAS a wide twin gets both, under one version guard:

           #IF (!@ < <ver>)
               <the declaration exactly as written>
           #ELSE
               <the same DataFlex NAME, bound to the ...W entry, with the catalogue's types>
           #ENDIF

       Same DataFlex name on both arms - that is the whole point. Every call site keeps compiling
       untouched, and which entry point it reaches becomes the compiler's decision rather than a
       rewrite of the workspace.

       THE W ARM COMES FROM THE CATALOGUE, never from swapping "A" for "W" in the line. LPCSTR maps
       to String and LPCWSTR to WString, so the parameter TYPES differ, not only the entry string;
       an in-place letter swap yields a declaration that compiles and marshals wrongly. No twin in
       the catalogue means the declaration is left alone - and the twin is never DERIVED by
       stripping a trailing letter, which would invent SetClipboardDatW.

       A retyper-emitted IS$WIN64 pair is consumed WHOLE by _TryWrapWin64Pair above, and every
       OTHER IS$WIN64 region is hands-off entirely (the incremental region tracking below) -
       a declaration inside one is already bitness-managed, by us or by hand.

       The ";"-chain walk is _GuardExternalsInLines' rule, reused verbatim. Idempotence is NOT:
       "any preceding #IF means hands off" also swallows the #IFNDEF declare-once idiom, so here it
       is "preceded by a VERSION gate" - see the note at the check itself.

       THE TARGET INSTALL IS ASKED FIRST (Nils 2026-09-02). A name the target DataFlex declares
       itself must NOT get a wide twin: ANY second External_Function of a name is error 4390 on that
       build, whatever its entry point or return type (four scratch compiles; WinServ's
       InternetOption.pkg against DataFlex 26's cHttpTransfer.pkg, reached through Combo_mx.pkg).
       Such a declaration gets a Use-arm instead:

           #IF (!@ < <target>)
               <the declaration exactly as written>
           #ELSE
               Use <the package that declares it>
           #ENDIF

       Correct on every compile unit (one that already includes the package just has the Use
       twice), same DataFlex name, no call-site change - and unlike GuardDuplicateExternalFunctions'
       guard-out it is safe for a package whose own wrappers call the API. The gate is the TARGET's
       version (iTargetVer, 0 = iVer): the install scanned is the target's, so that is the release
       known to declare the name; the Unicode boundary iVer is a different question and keeps
       bounding the wide pairs. Our own EARLIER wide pairs of such a name are repaired to this shape
       (_TryRepairWidePairToUse). The catalogue (RunInstallExternalFnNames) is one cached walk per
       run and answers EMPTY without a target Pkg folder, which simply disables this path. */
    Function _GuardAnsiWideInLines String[] ByRef asCode Integer iVer String sVerText Integer iTargetVer String sTargetText String sSelfLeaf Returns Integer
        String[] asOut asRawTok asHead asTmpTypes asTwinTypes asInstall asInstallPkgs
        String sLine sTrim sIndent sPrev sPacked sRest sDll sEntry sName sWide sWideDecl sRaw
        String sOpen sElse sClose sLocalFlat sLocalWide sWideMulti sOldRet sNewRet sCallNote sTrimLC sPrevNb sWhyNot
        String sUsePkg sTargetOpen sLocalName sTgtText sSelf
        Integer iSize iCount iSkipUntil iEnd iJ iP iBack iBar iGuarded iNum iDepth iWinDepth iWrapEnd iVariant iTopG iVarSkipped iTgtVer
        Integer[] aiGate
        Boolean bAlready bCont bMix bPairWrapped

        If (iVer <= 0) ;
            Function_Return 0
        // Trailing arguments: omitted (or 0) means the Unicode boundary bounds the Use-arms too.
        // Read into LOCALS first - an OMITTED argument does not compare as 0 (the fallback never
        // fired on the pure core's 3-argument callers and the gate came out "< 0", 2026-09-03).
        Move iTargetVer to iTgtVer
        Move sTargetText to sTgtText
        // The file's own leaf, for _UseArmUnlessSelf; omitted (the tests) = no check. Into a local first, as above.
        Move sSelfLeaf to sSelf
        If (iTgtVer <= 0) Begin
            Move iVer to iTgtVer
            Move sVerText to sTgtText
        End
        Get RunInstallExternalFnNames to asInstall
        Get RunInstallExternalFnPkgs  to asInstallPkgs
        Move (Character(35) + "IF (" + Character(33) + "@ < " + String(iTgtVer) + ")") to sTargetOpen
        Move (Character(35) + "IF (" + Character(33) + "@ < " + String(iVer) + ")") to sOpen
        Move (Character(35) + "ELSE")  to sElse
        Move (Character(35) + "ENDIF") to sClose
        Move 0  to iGuarded
        Move -1 to iSkipUntil
        Move 0  to iDepth
        Move 0  to iWinDepth
        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            If (iCount > iSkipUntil) Begin
                /* A top-level IS$WIN64 pair is the retyper's work and composes as a WHOLE (see
                   _TryWrapWin64Pair); when it handles the region - wrapped or copied through -
                   the walk resumes after it. */
                Move (Lowercase(Trim(Replaces((Character(9)), asCode[iCount], " ")))) to sTrimLC
                If (iDepth = 0 and sTrimLC = (Character(35) + "ifdef is$win64")) Begin
                    Get _TryWrapWin64Pair (&asCode) iCount iSize iVer sVerText (&asOut) (&bPairWrapped) iTgtVer sTgtText (&asInstall) (&asInstallPkgs) sSelf to iWrapEnd
                    If (iWrapEnd >= 0) Begin
                        If (bPairWrapped = True) ;
                            Increment iGuarded
                        Move iWrapEnd to iSkipUntil
                    End
                End
                Else If (iDepth = 0 and Left(sTrimLC, 3) = (Character(35) + "if") and (sTrimLC contains (Character(33) + "@"))) Begin
                    /* A depth-0 VERSION gate may be a wide pair this tool emitted earlier for a name
                       the target install declares itself - repaired to the Use-arm shape here, whole
                       (see _TryRepairWidePairToUse). -1 = not that: the line is ordinary and the
                       region tracking below sees it as before. */
                    Get _TryRepairWidePairToUse (&asCode) iCount iSize iTgtVer sTgtText (&asOut) (&asInstall) (&asInstallPkgs) sSelf to iWrapEnd
                    If (iWrapEnd >= 0) Begin
                        Increment iGuarded
                        Move iWrapEnd to iSkipUntil
                    End
                End
            End
            If (iCount > iSkipUntil) Begin
                /* Region tracking, the same walk _InsideWin64Guard does but incremental: a
                   declaration inside ANY IS$WIN64 region is already bitness-managed - by the
                   retyper or by hand - and wrapping it where it stands is how the version gate
                   used to end up nested inside somebody's #ELSE arm. */
                If (Left(sTrimLC, 3) = (Character(35) + "if")) Begin
                    Increment iDepth
                    If (iWinDepth = 0 and (sTrimLC contains "is$win64")) ;
                        Move iDepth to iWinDepth
                    /* The variant stack (2026-08-29): a #IF/#IFDEF arm is an author's CHOICE
                       between variants - declarations there are managed (cFilesystem gates whole
                       ANSI/wide batches with #IF (!@ < 200); a pair planted inside its ANSI arm
                       is dead code in every compile). #IFNDEF is the declare-once guard idiom
                       and stays convertible - unless its #ELSE arm, which is a choice again. */
                    If (Left(sTrimLC, 7) = (Character(35) + "ifndef")) ;
                        Move 0 to aiGate[SizeOfArray(aiGate)]
                    Else Begin
                        // Our own bannered gates stay enterable (see _InsideConditionalArm).
                        Move "" to sPrevNb
                        Move (iCount - 1) to iTopG
                        While (iTopG >= 0 and (not(sPrevNb contains "[dfrefactor]")) and (Trim(asCode[iTopG]) = "" or Left(Trim(asCode[iTopG]), 2) = "//"))
                            If (Lowercase(Trim(asCode[iTopG])) contains "[dfrefactor]") ;
                                Move (Lowercase(Trim(asCode[iTopG]))) to sPrevNb
                            Decrement iTopG
                        Loop
                        If (sPrevNb contains "[dfrefactor]") ;
                            Move 2 to aiGate[SizeOfArray(aiGate)]
                        Else Begin
                            Move 1 to aiGate[SizeOfArray(aiGate)]
                            Increment iVariant
                        End
                    End
                End
                Else Begin
                    If (Left(sTrimLC, 5) = (Character(35) + "else")) Begin
                        Move (SizeOfArray(aiGate) - 1) to iTopG
                        If (iTopG >= 0) Begin
                            If (aiGate[iTopG] = 0) Begin
                                Move 1 to aiGate[iTopG]
                                Increment iVariant
                            End
                        End
                    End
                    If (Left(sTrimLC, 6) = (Character(35) + "endif")) Begin
                        If (iWinDepth = iDepth) ;
                            Move 0 to iWinDepth
                        If (iDepth > 0) ;
                            Move (iDepth - 1) to iDepth
                        Move (SizeOfArray(aiGate) - 1) to iTopG
                        If (iTopG >= 0) Begin
                            If (aiGate[iTopG] = 1) ;
                                Move (iVariant - 1) to iVariant
                            Move (ResizeArray(aiGate, iTopG)) to aiGate
                        End
                    End
                End
                Move asCode[iCount] to sLine
                Move "" to sWide
                Move "" to sUsePkg
                Get _ExternalFnHeadPacked sLine to sPacked
                If (sPacked <> "") Begin
                    Move (Pos("|", sPacked)) to iBar
                    Move (Left(sPacked, (iBar - 1))) to sName
                    Move (Right(sPacked, (Length(sPacked) - iBar))) to sRest
                    Move (Pos("|", sRest)) to iBar
                    Move (Left(sRest, (iBar - 1))) to sDll
                    Move (Right(sRest, (Length(sRest) - iBar))) to sEntry
                    // ANSI only, only where the catalogue holds the twin, and never inside an
                    // IS$WIN64 region or any other conditional variant arm - a declaration
                    // there is already managed, by the retyper or by the author's own gates.
                    If (Right(sEntry, 1) = "a" and iVariant > 0) ;
                        Increment iVarSkipped
                    If (Right(sEntry, 1) = "a" and iWinDepth = 0 and iVariant = 0) Begin
                        // The target install first: a name it declares itself takes the Use-arm and
                        // never looks for a twin (see the header). The packed name is uppercase, as
                        // the sorted catalogue is.
                        If (SizeOfArray(asInstall) > 0) Begin
                            If (BinarySearchArray(sName, asInstall) <> -1) ;
                                Get _InstallPkgFor sName asInstallPkgs to sUsePkg
                        End
                        // ...unless this file IS that package (then the twin below is the right arm).
                        Get _UseArmUnlessSelf sUsePkg sSelf sName to sUsePkg
                        If (sUsePkg = "") Begin
                            Move (Left(sEntry, (Length(sEntry) - 1)) + "w") to sWide
                            Get WinAPIPrototype sDll sWide to sWideDecl
                            If (sWideDecl = "") ;
                                Move "" to sWide
                        End
                    End
                End
                /* ALREADY GUARDED MEANS ALREADY VERSION-GUARDED - not "preceded by any #IF"
                   (Nils 2026-08-31, DUF cDbUpdateUserCount.h.pkg). This idempotence walk was
                   inherited verbatim from _GuardExternalsInLines, where the blanket rule is
                   harmless; here it collided with the variant stack above, which deliberately
                   admits #IFNDEF <symbol> - the DataFlex declare-once idiom that wraps very
                   nearly every hand-written WinAPI header. The gate said convertible, this said
                   hands off, and the stricter one won IN SILENCE: DS 9221 named the declaration,
                   the plan ran, and the log read "0 lines" with no note to explain it.
                   The only thing this must refuse is OUR OWN emitted pair, whose opening line is
                   a version gate - so require the version macro. A hand-written #IF / #IFDEF arm
                   is still refused, one step earlier and with a run note, by iVariant. */
                Move False to bAlready
                If (sWide <> "" or sUsePkg <> "") Begin
                    Move (SizeOfArray(asOut) - 1) to iBack
                    While ((iBack >= 0) and (bAlready = False))
                        Move (Trim(asOut[iBack])) to sPrev
                        If (sPrev <> "") Begin
                            If (Uppercase(Left(sPrev, 3)) = (Character(35) + "IF") and (sPrev contains (Character(33) + "@"))) ;
                                Move True to bAlready
                            Move 0 to iBack
                        End
                        Decrement iBack
                    Loop
                End
                If ((sWide <> "" or sUsePkg <> "") and bAlready = False) Begin
                    /* The name and DLL are taken from the RAW line, not from the packed head, which
                       normalises case for matching - name up, dll down. The wide arm has to read
                       like the user's own code: MyGetTempPath and Kernel32.dll, not MYGETTEMPPATH
                       and kernel32.dll. Matching is case-insensitive; OUTPUT is not. */
                    Move (Replaces((Character(9)), sLine, " ")) to sRaw
                    Move (StrSplitToArray(Trim(sRaw), CS_S)) to asRawTok
                    Move 0 to iNum
                    For iJ from 0 to (SizeOfArray(asRawTok) - 1)
                        If (Trim(asRawTok[iJ]) <> "") Begin
                            Move (Trim(asRawTok[iJ])) to asHead[iNum]
                            Increment iNum
                        End
                    Loop
                    Move "" to sWideDecl
                    If (iNum >= 4 and sWide <> "") Begin
                        Get WinAPIDataFlexDecl sDll sWide to sWideDecl
                        Get _RebindExternalHead sWideDecl asHead[1] asHead[3] to sWideDecl
                    End
                    // A head too short to name the declaration cannot be given a Use-arm either.
                    If (iNum < 4) ;
                        Move "" to sUsePkg
                End
                If (bAlready = False and (sUsePkg <> "" or (sWide <> "" and sWideDecl <> ""))) Begin
                    Move iCount to iEnd
                    Get _LineContinues asCode[iEnd] to bCont
                    While (bCont = True and iEnd < iSize)
                        Increment iEnd
                        Get _LineContinues asCode[iEnd] to bCont
                    Loop
                    Move (Trim(sLine)) to sTrim
                    Move "" to sIndent
                    Move (Pos(sTrim, sLine)) to iP
                    If (iP > 1) ;
                        Move (Left(sLine, (iP - 1))) to sIndent
                    If (sUsePkg <> "") Begin
                        // THE USE-ARM (see the header): banner, TARGET gate, original block, Use.
                        Move asHead[1] to sLocalName
                        Send _EmitUseArmBanner (&asOut) sIndent sLocalName sUsePkg sTgtText
                        Move (sIndent + sTargetOpen) to asOut[SizeOfArray(asOut)]
                        For iJ from iCount to iEnd
                            Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                        Loop
                        Move (sIndent + sElse) to asOut[SizeOfArray(asOut)]
                        Move (sIndent + "Use " + sUsePkg) to asOut[SizeOfArray(asOut)]
                        Move (sIndent + sClose) to asOut[SizeOfArray(asOut)]
                        Increment iGuarded
                        Send AddRunNote "GuardAnsiExternalFunctionWithWide" (sLocalName + " - DataFlex " + sTgtText ;
                            + " declares it itself (" + sUsePkg + "), so no wide twin: the declaration now compiles only below " ;
                            + sTgtText + ", and from there the file reads it through 'Use " + sUsePkg ;
                            + "'. Check the call sites that pass text buffers or store the return against that declaration.")
                        Move iEnd to iSkipUntil
                    End
                    Else Begin
                        /* THE WIDE ARM IN THE BLOCK'S OWN STYLE (Nils, 2026-08-28, on the first live
                           pair): local head and parameter NAMES, the twin's entry and TYPES, one
                           parameter per continuation - the same contract the retyping converter's
                           emission keeps. Built by handing the flattened ANSI block, re-bound to the
                           W entry, to the same pretty-printer. When the names cannot be aligned (a
                           comment inside the block, an odd legacy shape) the flat one-liner stands -
                           a formatting preference must never cost the guard itself. */
                        Get _FlatExternalFnBlock (&asCode) iCount iEnd to sLocalFlat
                        /* Pointer-vs-marshal locals are a manual-conversion convention (vWin32fhA.h's
                           own "Pointer lpOperation" shape, Nils 2026-08-28): the binding's call
                           sites feed it AddressOf'd buffers, and pairing it mechanically would hand
                           those raw addresses to WString marshalling on the modern arm - an address
                           rendered as text, silently. Refused whole, and voiced; the vWin32fh
                           wrappers are the migration path for that shape. The reason comes from the
                           SHARED decision so DS 9221 declines the same declarations - a board row
                           whose Run button can only refuse is worse than no row (Nils 2026-08-31). */
                        Get _ExternalFnParamTypes (Trim(sLocalFlat)) (&asTmpTypes) to sOldRet
                        Get _ExternalFnParamTypes sWideDecl (&asTwinTypes) to sNewRet
                        // RAW rows for the struct check - see caller above.
                        Get _AnsiWideRefusalReason (Trim(sLocalFlat)) sWideDecl ;
                            (WinAPIPrototype(Self, sDll, sEntry)) (WinAPIPrototype(Self, sDll, sWide)) to sWhyNot
                        If (sWhyNot <> "") Begin
                            For iJ from iCount to iEnd
                                Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                            Loop
                            Send AddRunNote "GuardAnsiExternalFunctionWithWide" ((asHead[1]) ;
                                + " - left alone: " + sWhyNot + ".")
                            Move iEnd to iSkipUntil
                        End
                        Else Begin
                            // banner, gate, original block, twin - via the SAME builders the pair
                            // recognizer uses (_EmitWideBanner / _WideArmText), so the two emission
                            // sites cannot drift.
                            Send _EmitWideBanner (&asOut) sIndent sVerText
                            Move (sIndent + sOpen) to asOut[SizeOfArray(asOut)]
                            For iJ from iCount to iEnd
                                Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                            Loop
                            Move (sIndent + sElse) to asOut[SizeOfArray(asOut)]
                            Get _WideArmText sIndent (Trim(sLocalFlat)) sWideDecl to sWideMulti
                            Get _AppendLines (&asOut) sWideMulti to iJ
                            Move (sIndent + sClose) to asOut[SizeOfArray(asOut)]
                            Increment iGuarded
                            // The call-site courtesy when the twin's RETURN widens to pointer-size on
                            // the modern arm (see _CallSiteNoteForReturnChange), reusing the returns
                            // parsed for the mix check above. Sent directly - this private is only
                            // ever reached from GuardAnsiExternalFunctionWithWide.
                            Get _CallSiteNoteForReturnChange (&asCode) asHead[1] sOldRet sNewRet to sCallNote
                            If (sCallNote <> "") ;
                                Send AddRunNote "GuardAnsiExternalFunctionWithWide" sCallNote
                            Move iEnd to iSkipUntil
                        End
                    End
                End
                Else Begin
                    Move sLine to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        If (iVarSkipped > 0) ;
            Send AddRunNote "GuardAnsiExternalFunctionWithWide" (String(iVarSkipped) + " ANSI declaration(s) inside author-managed conditional arms (a version or feature gate chooses between variants) - left as written")
        If (iGuarded > 0) ;
            Move asOut to asCode
        Function_Return iGuarded
    End_Function

    /* Is sFileName within MakeFileAutonomous's extension scope under sParameter? The parameter
       normalisation lives here beside the DEFAULT: vw;dg;rv;sl;pkg;src - widened 2026-08-28
       (Nils): a package instantiates classes as much as a view does, and a program file's
       autonomy matters for the same reason. That widening RETIRES the hard ".src is always
       ignored" block of 2026-07-31 (a Use added to a .src once changed which file first pulled
       a package in - runtime error 98 after a clean compile). The lesson is mitigated, not
       forgotten: new Use lines land after the file's LAST existing Use, so everything already
       included keeps its order, and the Check loop compile-verifies every run. Commas serve as
       separators too, leading dots are dropped, matching is case-insensitive. */
    Function _MfaExtensionInScope String sFileName String sParameter Returns Boolean
        String[] asExt
        String sExt
        Integer iPos

        Move (RightPos(".", sFileName)) to iPos
        If (iPos = 0) ;
            Function_Return False
        Move (Lowercase(Mid(sFileName, (Length(sFileName) - iPos), (iPos + 1)))) to sExt
        Move (Trim(Replaces(",", sParameter, ";"))) to sParameter
        Move (Replaces(".", sParameter, "")) to sParameter
        If (sParameter = "") ;
            Move "vw;dg;rv;sl;pkg;src" to sParameter
        Move (StrSplitToArray(Lowercase(sParameter), ";")) to asExt
        Function_Return (SearchArray(sExt, asExt) <> -1)
    End_Function

    /* The line where this compile unit CALLS the function, or 0 - the check that stops a guard
       from removing a declaration the same file depends on.

       LegacyApp4, 2026-08-26: Prnt_dlg.pkg declares PrintDlg, PageSetupDlg and
       CommDlgExtendedError, and calls all three a few hundred lines later -

           Move (PageSetupDlg(pPageSetupDlg)) To iResult

       Guarding them out on 26.0 left those calls with nothing to bind to. Three guards, 543
       compile errors. The declaration was a real duplicate and the guard was written correctly;
       what nobody asked was whether the file could survive without it.

       A CALL IS THE NAME FOLLOWED BY "(", whitespace allowed between - the same shape
       _RenameMaskedCalls matches, and the shape an External_Function is always used in. The
       declaration itself can never look like one: there the name is followed by a quoted entry
       point. Read off the RAW lines, so a call inside a comment counts too - refusing to guard
       because of a commented-out call is a false negative that costs nothing, while missing a real
       one costs the build. */
    Function _LineCallingFunction String[] asCode String sName Returns Integer
        String sLine sCh
        Integer i iLast iPos iLen iNameLen iAt
        Boolean bBoundary

        If (Trim(sName) = "") ;
            Function_Return 0
        Move (Length(sName)) to iNameLen
        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(asCode[i])) to sLine
            Move (Length(sLine)) to iLen
            Move 1 to iPos
            While (iPos > 0 and iPos <= iLen)
                Move (Pos(Lowercase(sName), sLine, iPos)) to iAt
                If (iAt = 0) ;
                    Move 0 to iPos
                Else Begin
                    // Whole word: the character before must not be part of an identifier.
                    Move True to bBoundary
                    If (iAt > 1) Begin
                        Get _IsIdentifierChar (Mid(sLine, 1, (iAt - 1))) to bBoundary
                        Move (bBoundary = False) to bBoundary
                    End
                    If (bBoundary = True) Begin
                        // ...and what follows, past any spaces, must be "(".
                        Move (iAt + iNameLen) to iPos
                        While (iPos <= iLen and Mid(sLine, 1, iPos) = " ")
                            Increment iPos
                        Loop
                        If (iPos <= iLen and Mid(sLine, 1, iPos) = "(") ;
                            Function_Return (i + 1)
                    End
                    Move (iAt + iNameLen) to iPos
                End
            Loop
        Loop
        Function_Return 0
    End_Function

    Function _GuardExternalsInLines String[] ByRef asCode String[] asNames String[] asBindings Integer iVer String sVerText Boolean bExcludeVer Returns Integer
        String[] asOut asWords asSkipped
        String sLine sTrim sName sIndent sOpen sClose sPrev
        String sOwnBind sInstBind sVerify
        Integer iSize iGuarded iCount iSkipUntil iEnd iJ iP iBack iBar iGuardAt iCallsAt
        Boolean bAlready bPanel bCont bOursToFix

        If (iVer <= 0) ;
            Function_Return 0
        If (SizeOfArray(asNames) = 0) ;
            Function_Return 0
        /* WHICH COMPARISON, and it turns on what iVer MEANS to the caller - the one character that
           made this guard a no-op (Nils, 2026-08-26, LegacyApp4).

           bExcludeVer FALSE - iVer is "keep it for this release and older", a version the user
           named. "<=" is right and "<" would break them: guarding a 19.1 app with "< 191" removes
           the declaration on the very release that has no native one.

           bExcludeVer TRUE - iVer is the version being COMPILED WITH, the release where DataFlex
           declares the API itself. Then "<=" is true on the very build raising the 4390: the
           duplicate goes on compiling and the guard clears nothing while reporting success, which
           is what happened on LegacyApp4 with "<= 260" against a 26.0 target. "<" keeps the
           declaration for every release below it and drops it on the target and newer - the same
           shape _GuardGlobalsInLines emits from FirstNativeVersionFor. Conservative, because no
           per-version catalogue of External_Functions exists to say when DataFlex first shipped
           one: this excludes the target only, never an older release that may still need it. */
        If (bExcludeVer = True) ;
            Move (Character(35) + "IF (" + Character(33) + "@ < " + String(iVer) + ")") to sOpen
        Else ;
            Move (Character(35) + "IF (" + Character(33) + "@ <= " + String(iVer) + ")") to sOpen
        Move (Character(35) + "ENDIF") to sClose
        Move 0  to iGuarded
        Move -1 to iSkipUntil
        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        For iCount from 0 to iSize
            If (bPanel = True and Mod(iCount, 20) = 0) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iCount + 1)
            End
            If (iCount > iSkipUntil) Begin
                Move asCode[iCount] to sLine
                Get _SplitSourceWords sLine to asWords
                Move "" to sName
                Move "" to sOwnBind
                If (SizeOfArray(asWords) >= 2) Begin
                    If (Lowercase(asWords[0]) = "external_function") Begin
                        Move asWords[1] to sName
                        /* The declaration's own binding, from the RAW line - the head (name, entry,
                           dll) is always on this one line, whatever the ";" chain does below it.
                           Through _ExternalFnHeadPacked rather than the asWords above, which came
                           from the lexer's splitter and no longer holds the quoted entry point. */
                        Get _ExternalFnHeadPacked sLine to sOwnBind
                        If (sOwnBind <> "") Begin
                            Move (Pos("|", sOwnBind)) to iBar
                            Move (Right(sOwnBind, (Length(sOwnBind) - iBar))) to sOwnBind
                        End
                    End
                End
                If (sName <> "") Begin
                    If (SearchArray(sName, asNames, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                        Move "" to sName
                End
                Move False to bAlready
                If (sName <> "") Begin
                    // IDEMPOTENT: a block we (or the user, by hand) already guarded is preceded by an
                    // #IF line - walk back over blanks to the last REAL emitted line and look for it.
                    Move (SizeOfArray(asOut) - 1) to iBack
                    Move -1 to iGuardAt
                    While ((iBack >= 0) and (bAlready = False))
                        Move (Trim(asOut[iBack])) to sPrev
                        If (sPrev <> "") Begin
                            If (Uppercase(Left(sPrev, 3)) = (Character(35) + "IF")) Begin
                                Move True to bAlready
                                Move iBack to iGuardAt
                            End
                            Move 0 to iBack           // the first non-blank line decides
                        End
                        Decrement iBack
                    Loop
                    /* ...AND REPAIR OUR OWN WRONG ONE, which "already guarded" used to hide forever.
                       A guard we wrote before the comparison was fixed says "<= 260" on a 26.0
                       target - true on the very build reporting the error - and skipping it as
                       already-guarded meant no amount of re-running could ever clear it
                       (LegacyApp4, 2026-08-26).

                       OURS is the one carrying the "[DFRefactor] '<name>'" marker just above. A #IF
                       with no marker is somebody's deliberate guard and stays exactly as written -
                       the same line _GuardGlobalsInLines draws, and for the same reason. */
                    If (bAlready = True and iGuardAt >= 0) Begin
                        Move False to bOursToFix
                        Move (iGuardAt - 1) to iJ
                        While (iJ >= 0 and iJ >= (iGuardAt - 4) and bOursToFix = False)
                            If (Pos("[DFRefactor] '", asOut[iJ]) > 0) ;
                                Move True to bOursToFix
                            Decrement iJ
                        Loop
                        If (bOursToFix = True and Trim(asOut[iGuardAt]) <> sOpen) Begin
                            Move (Left(asOut[iGuardAt], (Length(asOut[iGuardAt]) - Length(LTrim(asOut[iGuardAt]))))) to sIndent
                            Move (sIndent + sOpen) to asOut[iGuardAt]
                            Increment iGuarded
                        End
                        Else ;
                            Set piAlreadyGuardedExternalCount to (piAlreadyGuardedExternalCount(Self) + 1)
                    End
                End
                /* NEVER GUARD WHAT THIS FILE CALLS. The declaration may be a genuine duplicate,
                   but if the same compile unit uses it, removing it on the target leaves the call
                   with nothing to bind to - three guards, 543 errors (LegacyApp4). Skipped
                   and reported by name and line, because a silent skip here reads as "already
                   fine" when it is the opposite. */
                If (sName <> "" and bAlready = False) Begin
                    Get _LineCallingFunction asCode sName to iCallsAt
                    If (iCallsAt > 0) Begin
                        Get pasGuardSkippedCalled to asSkipped
                        Move (sName + " (called at line " + String(iCallsAt) + ")") to asSkipped[SizeOfArray(asSkipped)]
                        Set pasGuardSkippedCalled to asSkipped
                        Move "" to sName
                    End
                End
                If (sName <> "" and bAlready = False) Begin
                    // End of the declaration = the last line of its ";" continuation chain.
                    Move iCount to iEnd
                    Get _LineContinues asCode[iEnd] to bCont
                    While (bCont = True and iEnd < iSize)
                        Increment iEnd
                        Get _LineContinues asCode[iEnd] to bCont
                    Loop
                    // Marker + guard at the declaration's own indentation. The block itself is copied
                    // VERBATIM - a guard changes what COMPILES, never what the code says.
                    Move (Trim(sLine)) to sTrim
                    Move "" to sIndent
                    Move (Pos(sTrim, sLine)) to iP
                    If (iP > 1) ;
                        Move (Left(sLine, (iP - 1))) to sIndent
                    Move (sIndent + "// [DFRefactor] '" + sName + "' is declared by DataFlex itself now (duplicate External_Function, error 4390).") to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// Kept for DataFlex " + sVerText + " and older; newer builds use DataFlex's own declaration.") to asOut[SizeOfArray(asOut)]
                    /* THE VERIFY NOTE ONLY WHERE THERE IS SOMETHING TO VERIFY (2026-08-09).

                       It used to be emitted on EVERY guarded block. Measured across the DF18/DF19
                       trees that is wrong 7 times in 8 - 1,585 declarations bind exactly what
                       DataFlex binds, 226 do not - and a warning that fires on everything is one a
                       reader learns to skip, including the 226 times it is the whole point.

                       So it fires on a real difference and CITES it, naming both entry points
                       instead of describing the hazard in the abstract; the app's own rule that an
                       explanation must carry its evidence. An unknown binding still warns: not
                       finding the install's side is a reason to look, not a reason to be quiet. */
                    Move "" to sVerify
                    Get _InstallBindingFor sName asBindings to sInstBind
                    If (sInstBind = "" or sOwnBind = "") Begin
                        Move (sIndent + "// VERIFY the entry points match: an ANSI (...A) binding here vs DataFlex's wide (...W) one differs where text buffers cross.") to sVerify
                    End
                    Else If (sInstBind <> sOwnBind) Begin
                        Move (sIndent + "// VERIFY: this binds " + sOwnBind + " but DataFlex binds " + sInstBind + " - an ANSI/wide difference changes how text buffers cross.") to sVerify
                    End
                    If (sVerify <> "") ;
                        Move sVerify to asOut[SizeOfArray(asOut)]
                    Move (sIndent + sOpen) to asOut[SizeOfArray(asOut)]
                    For iJ from iCount to iEnd
                        Move asCode[iJ] to asOut[SizeOfArray(asOut)]
                    Loop
                    Move (sIndent + sClose) to asOut[SizeOfArray(asOut)]
                    Increment iGuarded
                    Move iEnd to iSkipUntil
                End
                Else Begin
                    Move sLine to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        // Finish the file at 100% (the nudge above only fires every 20 lines).
        If (bPanel = True) Begin
            Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iSize + 1) * "of:" * String(iSize + 1))
            Set piPosition of ghoProgressBar to (iSize + 1)
        End
        If (iGuarded > 0) ;
            Move asOut to asCode
        Function_Return iGuarded
    End_Function

    // The identifier RUN (a-z0-9_) that ENDS at position iEnd of sText (inclusive), lowercased;
    // "" when the character at iEnd is not an identifier character. Helper for the rename core's
    // word-before/word-after classification.
    Function _IdentifierRunEndingAt String sText Integer iEnd Returns String
        Integer iStart
        Boolean bIdent

        If (iEnd < 1) ;
            Function_Return ""
        Get _IsIdentifierChar (Mid(sText, 1, iEnd)) to bIdent
        If (bIdent = False) ;
            Function_Return ""
        Move iEnd to iStart
        Move True to bIdent
        While (iStart > 1 and bIdent = True)
            Get _IsIdentifierChar (Mid(sText, 1, (iStart - 1))) to bIdent
            If (bIdent = True) ;
                Decrement iStart
        Loop
        Function_Return (Lowercase(Mid(sText, (iEnd - iStart + 1), iStart)))
    End_Function

    // The identifier RUN that STARTS at position iStart of sText, lowercased; "" when the character
    // there is not an identifier character.
    Function _IdentifierRunStartingAt String sText Integer iStart Returns String
        Integer iEnd iLen
        Boolean bIdent

        Move (Length(sText)) to iLen
        If (iStart < 1 or iStart > iLen) ;
            Function_Return ""
        Get _IsIdentifierChar (Mid(sText, 1, iStart)) to bIdent
        If (bIdent = False) ;
            Function_Return ""
        Move iStart to iEnd
        Move True to bIdent
        While (iEnd < iLen and bIdent = True)
            Get _IsIdentifierChar (Mid(sText, 1, (iEnd + 1))) to bIdent
            If (bIdent = True) ;
                Increment iEnd
        Loop
        Function_Return (Lowercase(Mid(sText, (iEnd - iStart + 1), iStart)))
    End_Function

    // Core of RenameCollidingGlobalFunction (oRefactorFuncLib): renames a GLOBAL function name
    // across one file's lines. Three shapes rename - the DECLARATION (Function <Old> ... Global /
    // Register_Function <Old>), EXPRESSION CALLS (<Old> followed by "(", spaces allowed - the
    // _RenameMaskedCalls convention), and OF-LESS Get statements (Get <Old> args to var). OF-forms
    // (Get/Send <Old> of hObj) are OBJECT-targeted - a class method, often DataFlex's own statement
    // API (sql.pkg's SQLExecute) - and are NEVER touched: that discriminator is what makes the
    // rename safe to automate (Nils 2026-07-23, after 164 hand edits for SPLIT). A plain Function
    // <Old> WITHOUT the Global keyword is a class METHOD and is left alone too - unless
    // pbRenameMethodDecl is up, which is RenameSameNamedMethod's one-shot (2026-09-04): run over
    // the ODD declaration's own file, that method IS the thing to rename.
    // Occurrences match on the MASKED aligned line (literals/comments never rename) and splice
    // RIGHT-TO-LEFT so earlier positions stay valid. Idempotent by word boundary: a <New> that
    // contains <Old> as a prefix (SplitX vs Split) never re-matches.
    Function _RenameGlobalNameInLines String[] ByRef asCode String sOld String sNew Returns Integer
        tTokenizer TD
        String sLine sAligned sPrevWord sNextWord sCh
        Integer iSize iCount iRen iOldLen iPos iStart iH iAfter iLen
        Integer[] aiHit
        Boolean bRename bGlobalOnLine bPanel bMethodDecl

        Move (Length(sOld)) to iOldLen
        If (iOldLen = 0 or sNew = "" or Lowercase(sOld) = Lowercase(sNew)) ;
            Function_Return 0
        Get pbRenameMethodDecl to bMethodDecl
        Move 0 to iRen
        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        For iCount from 0 to iSize
            If (bPanel = True and Mod(iCount, 20) = 0) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iCount + 1)
            End
            Move asCode[iCount] to sLine
            If (Pos(Lowercase(sOld), Lowercase(sLine)) > 0) Begin
                Get Tokenizer of ghoFuncLib sLine to TD
                Move (TD.sIndentation + TD.sOverstrikeLine) to sAligned
                Move (Length(sAligned)) to iLen
                // Collect every whole-word occurrence left-to-right...
                Move (ResizeArray(aiHit, 0)) to aiHit
                Move 1 to iStart
                Get _FindKeywordPos sAligned sOld True iStart to iPos
                While (iPos > 0)
                    Move iPos to aiHit[SizeOfArray(aiHit)]
                    Move (iPos + iOldLen) to iStart
                    Get _FindKeywordPos sAligned sOld True iStart to iPos
                Loop
                // "Global" anywhere on the masked line - cheap pre-answer for the declaration shape.
                Get _FindKeywordPos sAligned "global" True 1 to iPos
                Move (iPos > 0) to bGlobalOnLine
                // ...then classify + splice RIGHT-TO-LEFT (a While counting down - DataFlex For
                // only counts up), so earlier hit positions stay valid across splices.
                Move (SizeOfArray(aiHit) - 1) to iH
                While (iH >= 0)
                    Move aiHit[iH] to iPos
                    Move False to bRename
                    // (a) CALL: the next non-blank char is "(" (spaces allowed, the
                    //     _RenameMaskedCalls convention).
                    Move (iPos + iOldLen) to iAfter
                    While (iAfter <= iLen and (Mid(sAligned, 1, iAfter) = " " or Mid(sAligned, 1, iAfter) = Character(9)))
                        Increment iAfter
                    Loop
                    Move "" to sCh
                    If (iAfter <= iLen) ;
                        Move (Mid(sAligned, 1, iAfter)) to sCh
                    If (sCh = "(") ;
                        Move True to bRename
                    If (bRename = False) Begin
                        // (b) DECLARATION: preceded by Function / Register_Function, with the
                        //     Global keyword on the line (a keyword-less Function = a class method).
                        Get _WordBeforePos sAligned iPos to sPrevWord
                        If ((sPrevWord = "function" and (bGlobalOnLine = True or bMethodDecl = True)) or sPrevWord = "register_function") ;
                            Move True to bRename
                        // (c) OF-LESS Get statement: preceded by Get, NOT followed by the word "of".
                        If (bRename = False and sPrevWord = "get") Begin
                            Get _IdentifierRunStartingAt sAligned iAfter to sNextWord
                            If (sNextWord <> "of") ;
                                Move True to bRename
                        End
                    End
                    If (bRename = True) Begin
                        Move (Left(sLine, (iPos - 1)) + sNew + Right(sLine, (Length(sLine) - (iPos + iOldLen - 1)))) to sLine
                        Increment iRen
                    End
                    Decrement iH
                Loop
                If (sLine <> asCode[iCount]) ;
                    Move sLine to asCode[iCount]
            End
        Loop
        If (bPanel = True) Begin
            Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iSize + 1) * "of:" * String(iSize + 1))
            Set piPosition of ghoProgressBar to (iSize + 1)
        End
        Function_Return iRen
    End_Function

    /* The fifth class-reference shape: the CLASS-ID SYMBOL "U_<Class>" (Get Create U_cRegEx to h). Missed
       on the first live run (WinServ regexp.pkg 264/298, 2026-09-03) - and the worst miss possible: on a
       DataFlex that defines the class, U_<Old> still COMPILES, against the native class, so the wrapper
       quietly creates the wrong object. "U_" is an identifier character, so the whole-word search for
       the bare name never sees it; this pass searches "U_<Old>" itself, keeps the user's "U_" spelling
       and replaces the name part. Every U_<Class> IS a class reference, so no shape test. Masked,
       right-to-left, on ONE line; returns the count. Runs BEFORE the shape pass, which re-tokenizes. */
    Function _RenameUClassRefs String ByRef sLine String sOld String sNew Returns Integer
        tTokenizer TD
        String sAligned sKey
        Integer iPos iStart iOldLen iRen iH
        Integer[] aiHit

        // Lowercased KEY against the lowercased line - Pos is case-sensitive (the gate never opened
        // with "u_cRegEx" against "u_cregex" on the first run, 2026-09-03).
        Move (Lowercase("u_" + sOld)) to sKey
        If (Pos(sKey, Lowercase(sLine)) = 0) ;
            Function_Return 0
        Move (Length(sOld)) to iOldLen
        Get Tokenizer of ghoFuncLib sLine to TD
        Move (TD.sIndentation + TD.sOverstrikeLine) to sAligned
        Move 1 to iStart
        Get _FindKeywordPos sAligned sKey True iStart to iPos
        While (iPos > 0)
            Move iPos to aiHit[SizeOfArray(aiHit)]
            Move (iPos + iOldLen + 2) to iStart
            Get _FindKeywordPos sAligned sKey True iStart to iPos
        Loop
        Move 0 to iRen
        Move (SizeOfArray(aiHit) - 1) to iH
        While (iH >= 0)
            Move (aiHit[iH] + 2) to iPos     // past the user's own "U_"
            Move (Left(sLine, (iPos - 1)) + sNew + Right(sLine, (Length(sLine) - (iPos + iOldLen - 1)))) to sLine
            Increment iRen
            Decrement iH
        Loop
        Function_Return iRen
    End_Function

    /* Core of RenameCollidingClass (oRefactorFuncLib): renames a CLASS name across one file's lines.
       Five shapes rename - the DECLARATION ("Class <Old> is a ..."), the BASE reference ("is a <Old>" /
       "is an <Old>", on Object and Class lines alike), RefClass(<Old>) (Create / RefClass calls, blanks
       allowed inside the parentheses), the AUGMENTATION target ("Procedure X for <Old>" /
       "Function X for <Old>") and the CLASS-ID SYMBOL U_<Old> (_RenameUClassRefs, above). Anything
       else that spells the word - a variable, a method, a file name
       in a Use line - is not a class reference and stays. Occurrences match on the MASKED aligned
       line (literals/comments never rename; a whole-line comment is skipped outright) and splice
       RIGHT-TO-LEFT so earlier positions stay valid; whole-word, so <Old>X never re-matches
       (idempotent). Same discipline as _RenameGlobalNameInLines above. PURE -> unit-testable. */
    Function _RenameClassNameInLines String[] ByRef asCode String sOld String sNew Returns Integer
        tTokenizer TD
        String sLine sAligned sPrevWord sPrev2 sFirst sCh
        Integer iSize iCount iRen iOldLen iPos iStart iH iLen iBefore iP2 iU
        Integer[] aiHit
        Boolean bRename bPanel

        Move (Length(sOld)) to iOldLen
        If (iOldLen = 0 or sNew = "" or Lowercase(sOld) = Lowercase(sNew)) ;
            Function_Return 0
        Move 0 to iRen
        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        For iCount from 0 to iSize
            If (bPanel = True and Mod(iCount, 20) = 0) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iCount + 1)
            End
            Move asCode[iCount] to sLine
            If (Pos(Lowercase(sOld), Lowercase(sLine)) > 0 and Left(LTrim(sLine), 2) <> "//") Begin
                // (e) the U_<Old> class-id symbols first - on the raw line, before the shape pass reads it.
                Get _RenameUClassRefs (&sLine) sOld sNew to iU
                Move (iRen + iU) to iRen
                Get Tokenizer of ghoFuncLib sLine to TD
                Move (TD.sIndentation + TD.sOverstrikeLine) to sAligned
                Move (Length(sAligned)) to iLen
                Get _IdentifierRunStartingAt sAligned (Length(TD.sIndentation) + 1) to sFirst
                // Collect every whole-word occurrence left-to-right...
                Move (ResizeArray(aiHit, 0)) to aiHit
                Move 1 to iStart
                Get _FindKeywordPos sAligned sOld True iStart to iPos
                While (iPos > 0)
                    Move iPos to aiHit[SizeOfArray(aiHit)]
                    Move (iPos + iOldLen) to iStart
                    Get _FindKeywordPos sAligned sOld True iStart to iPos
                Loop
                // ...then classify + splice RIGHT-TO-LEFT so earlier hit positions stay valid.
                Move (SizeOfArray(aiHit) - 1) to iH
                While (iH >= 0)
                    Move aiHit[iH] to iPos
                    Move False to bRename
                    Get _WordBeforePos sAligned iPos to sPrevWord
                    // (a) DECLARATION: "Class <Old>" - the line's first word is Class and it is the word before.
                    If (sPrevWord = "class" and sFirst = "class") ;
                        Move True to bRename
                    // (b) BASE: "is a <Old>" / "is an <Old>".
                    If (bRename = False and (sPrevWord = "a" or sPrevWord = "an")) Begin
                        Move (iPos - 1) to iP2
                        While (iP2 >= 1 and (Mid(sAligned, 1, iP2) = " " or Mid(sAligned, 1, iP2) = Character(9)))
                            Decrement iP2
                        Loop
                        Move (iP2 - Length(sPrevWord) + 1) to iBefore
                        Get _WordBeforePos sAligned iBefore to sPrev2
                        If (sPrev2 = "is") ;
                            Move True to bRename
                    End
                    // (c) RefClass(<Old>): the previous non-blank char is "(" and the word before it is RefClass.
                    If (bRename = False and sPrevWord = "") Begin
                        Move (iPos - 1) to iP2
                        While (iP2 >= 1 and (Mid(sAligned, 1, iP2) = " " or Mid(sAligned, 1, iP2) = Character(9)))
                            Decrement iP2
                        Loop
                        Move "" to sCh
                        If (iP2 >= 1) ;
                            Move (Mid(sAligned, 1, iP2)) to sCh
                        If (sCh = "(") Begin
                            Get _WordBeforePos sAligned iP2 to sPrev2
                            If (sPrev2 = "refclass") ;
                                Move True to bRename
                        End
                    End
                    // (d) AUGMENTATION: "Procedure X for <Old>" / "Function X for <Old>".
                    If (bRename = False and sPrevWord = "for" and (sFirst = "procedure" or sFirst = "function")) ;
                        Move True to bRename
                    If (bRename = True) Begin
                        Move (Left(sLine, (iPos - 1)) + sNew + Right(sLine, (Length(sLine) - (iPos + iOldLen - 1)))) to sLine
                        Increment iRen
                    End
                    Decrement iH
                Loop
                If (sLine <> asCode[iCount]) ;
                    Move sLine to asCode[iCount]
            End
        Loop
        If (bPanel = True) Begin
            Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iSize + 1) * "of:" * String(iSize + 1))
            Set piPosition of ghoProgressBar to (iSize + 1)
        End
        Function_Return iRen
    End_Function

    // The lowercased word immediately BEFORE position iPos of sText (skipping blanks between).
    Function _WordBeforePos String sText Integer iPos Returns String
        Integer i
        String sWord
        Move (iPos - 1) to i
        While (i >= 1 and (Mid(sText, 1, i) = " " or Mid(sText, 1, i) = Character(9)))
            Decrement i
        Loop
        If (i < 1) ;
            Function_Return ""
        Get _IdentifierRunEndingAt sText i to sWord
        Function_Return sWord
    End_Function

    // Blanks out every STRING LITERAL in a line (quotes included) so positional searches can never match
    // inside one. DataFlex has no doubled-quote escape, so quote tracking is unambiguous: the first quote
    // opens, the next matching one closes. Same length as the input, so positions map 1:1 back onto it.
    // PURE -> unit-testable.
    Function _MaskStringLiterals String sLine Returns String
        String sMask sCh sPut
        Integer i iLen iQ

        Move 0 to iQ
        Move "" to sMask
        Move (Length(sLine)) to iLen
        For i from 1 to iLen
            Move (Mid(sLine, 1, i)) to sCh
            Move sCh to sPut
            If (iQ = 0) Begin
                If (sCh = "'") Begin
                    Move 1   to iQ
                    Move " " to sPut
                End
                Else If (sCh = '"') Begin
                    Move 2   to iQ
                    Move " " to sPut
                End
            End
            Else Begin
                Move " " to sPut
                If ((iQ = 1 and sCh = "'") or (iQ = 2 and sCh = '"')) ;
                    Move 0 to iQ
            End
            Move (sMask + sPut) to sMask
        Loop
        Function_Return sMask
    End_Function

    // Finds the RIGHTMOST call of one of asNames in sLine - "Name(" at a word boundary, outside string
    // literals, with balanced parentheses. RIGHTMOST on purpose: in a nested call like
    // Value(hoA, Value(hoB, k)) the inner one starts later, so hoisting right-to-left always lifts the
    // INNERMOST first and the outer call is left with a plain variable. Returns the name as written ("" if
    // none), with iStart = 1-based position of the name and iOpen/iClose = its parentheses. PURE.
    Function _RightmostAmbiguousCall String sLine String[] asNames Integer ByRef iStart Integer ByRef iOpen Integer ByRef iClose Returns String
        String sMask sMaskLow sName sBefore sFound
        Integer i iLast iPos iBest iBestOpen iLen j iDepth iNameLen

        Move 0  to iStart
        Move 0  to iOpen
        Move 0  to iClose
        Move "" to sFound
        Move 0  to iBest
        Move 0  to iBestOpen
        Get _MaskStringLiterals sLine to sMask
        Move (Lowercase(sMask)) to sMaskLow
        Move (Length(sMask))    to iLen
        Move (SizeOfArray(asNames) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(asNames[i]))) to sName
            Move (Length(sName)) to iNameLen
            If (sName <> "") Begin
                Move 1 to iPos
                While (iPos > 0)
                    Move (Pos(sName + "(", sMaskLow, iPos)) to iPos
                    If (iPos > 0) Begin
                        // Word boundary: the character before must not continue an identifier, or we would
                        // match "MyValue(" when looking for "Value(".
                        Move "" to sBefore
                        If (iPos > 1) ;
                            Move (Mid(sMask, 1, (iPos - 1))) to sBefore
                        If ((sBefore = "") or (Pos(Lowercase(sBefore), "abcdefghijklmnopqrstuvwxyz0123456789_") = 0)) Begin
                            If (iPos > iBest) Begin
                                Move iPos                to iBest
                                Move (iPos + iNameLen)   to iBestOpen
                                Move (Mid(sLine, iNameLen, iPos)) to sFound
                            End
                        End
                        Move (iPos + 1) to iPos
                    End
                Loop
            End
        Loop
        If (sFound = "") ;
            Function_Return ""
        // Balanced close paren, scanned on the MASK so parentheses inside literals never count.
        Move 1 to iDepth
        Move (iBestOpen + 1) to j
        Move 0 to iClose
        While (j <= iLen and iDepth > 0)
            If (Mid(sMask, 1, j) = "(") ;
                Move (iDepth + 1) to iDepth
            If (Mid(sMask, 1, j) = ")") ;
                Move (iDepth - 1) to iDepth
            If (iDepth = 0) ;
                Move j to iClose
            Increment j
        Loop
        If (iClose = 0) ;
            Function_Return ""      // unbalanced (continued line?) - leave it alone
        Move iBest     to iStart
        Move iBestOpen to iOpen
        Function_Return sFound
    End_Function

    // Splits a call's argument text at TOP-LEVEL commas: commas inside nested parentheses or inside string
    // literals do not split. Returns the raw segments (caller trims). PURE -> unit-testable.
    Function _SplitCallArgs String sInside Returns String[]
        String[] asOut
        String sMask sCh
        Integer i iLen iDepth iStart

        If (Trim(sInside) = "") ;
            Function_Return asOut
        Get _MaskStringLiterals sInside to sMask
        Move (Length(sInside)) to iLen
        Move 0 to iDepth
        Move 1 to iStart
        For i from 1 to iLen
            Move (Mid(sMask, 1, i)) to sCh
            If (sCh = "(") ;
                Move (iDepth + 1) to iDepth
            If (sCh = ")") ;
                Move (iDepth - 1) to iDepth
            If (iDepth = 0 and sCh = ",") Begin
                Move (Mid(sInside, (i - iStart), iStart)) to asOut[SizeOfArray(asOut)]
                Move (i + 1) to iStart
            End
        Loop
        Move (Mid(sInside, ((iLen - iStart) + 1), iStart)) to asOut[SizeOfArray(asOut)]
        Function_Return asOut
    End_Function

    // PURE core of ChangeAmbiguousCallToGet: rewrites EXPRESSION-style calls of an ambiguous-return-type
    // method into a hoisted Get statement, which is what clears error 4544 ("Function GET_X with ambiguous
    // return type used in expression"). Verified against DF25 on a minimal fixture: two classes declaring
    // Function Value with different return types make
    //     If (Value(oAaa,"k") = 1)                      -> ERROR 4544
    //     Variant v / Get Value of (oAaa) ("k") to v / If (v = 1)  -> compiles clean
    // The Get STATEMENT form is unambiguous because the destination variable supplies the type, so no type
    // inference is needed here - and the compiler already told us which names are ambiguous.
    //
    // Emitted at the call's own indentation, immediately above its line:
    //     Variant vDfrGetN
    //     Get <Name> of (<object>) (<arg>)... to vDfrGetN
    // and the call span becomes vDfrGetN. Temps are numbered per FILE so two hoists can never collide
    // inside one method. DataFlex allows a local declaration mid-method AND inside a Begin/End block (both
    // verified), which is why no declaration-block tracking is needed.
    //
    // Deliberately CONSERVATIVE - anything uncertain is left untouched rather than half-converted:
    //   * comment lines;
    //   * a CONTINUATION line (the one above ends with ";") - inserting statements between them would break
    //     the continuation;
    //   * unbalanced parentheses on the line;
    //   * Name() with no first argument - that is not an object call.
    // Nested calls are handled by hoisting RIGHTMOST-first, so the innermost lifts out before the outer.
    // asNames must be OBJECT-METHOD names: a global function has no object to put after "of".
    // True when the (masked) text carries a legacy comparison word - eq ne gt ge lt le - as a whole
    // space-delimited word. The hoist's one test for "legacy comparison syntax", used on a single
    // line and on a whole ';'-continued statement alike.
    Function _LineHasLegacyCompareWord String sMasked Returns Boolean
        String sLow
        Move (" " + Lowercase(sMasked) + " ") to sLow
        If (sLow contains " eq ") Function_Return True
        If (sLow contains " ne ") Function_Return True
        If (sLow contains " gt ") Function_Return True
        If (sLow contains " ge ") Function_Return True
        If (sLow contains " lt ") Function_Return True
        If (sLow contains " le ") Function_Return True
        Function_Return False
    End_Function

    Function _HoistAmbiguousCallsInLines String[] ByRef asCode String[] asNames Returns Integer
        String[] asOut asPre asEmptyStr asArgs asDeclined
        String sLine sTrim sPrevTrim sIndent sName sInside sObj sTmp sArg sGet sMasked sLow sNum sCh sWhy sEntry sStmtIndent sStmtText
        Integer iSize iCount iHoisted iSeq iStart iOpen iClose iP iA iALast j iNum iStmtStartOut
        Boolean bSkip bFound bComment bPanel bLegacy bTwoLine bDbMode bContinuation bPrevComment bStmtLegacy bStmtDbMode

        Move 0  to iHoisted
        Move "" to sPrevTrim
        Move (SizeOfArray(asCode) - 1) to iSize
        // Continue numbering ABOVE any temp this converter already left in the file. A file can be
        // PARTLY converted (legacy-operator lines above are skipped, so a later run may convert more),
        // and restarting at 1 would then declare vDfrGet1 twice in the same method - a compile error
        // introduced by the fix itself. Scan once for the highest existing number.
        Move 0 to iSeq
        For iCount from 0 to iSize
            Move (Lowercase(asCode[iCount])) to sLow
            Move (Pos("vdfrget", sLow)) to iP
            While (iP > 0)
                Move "" to sNum
                Move (iP + 7) to j
                While (j <= Length(sLow))
                    Move (Mid(sLow, 1, j)) to sCh
                    If (Pos(sCh, "0123456789") = 0) ;
                        Move (Length(sLow) + 1) to j      // stop at the first non-digit
                    Else Begin
                        Move (sNum + sCh) to sNum
                        Increment j
                    End
                Loop
                If (sNum <> "") Begin
                    Move sNum to iNum
                    If (iNum > iSeq) ;
                        Move iNum to iSeq
                End
                Move (Pos("vdfrget", sLow, (iP + 1))) to iP
            Loop
        Loop
        // Whole-file function: the engine only auto-advances the per-file bar for line-by-line functions,
        // so drive it here or a big file looks frozen. No-op when no panel is up (batch / DFUnit runner).
        Move (ghoStatusPanel <> 0 and Active_State(ghoStatusPanel) = True) to bPanel
        /* A CONTINUED STATEMENT IS ONE STATEMENT (Nils 2026-08-17: 26 of the 30 calls left "by hand" on
           WinServ were the SAME shape - a multi-line 'If (A and ;' whose Value(oX) calls sit on the
           continuation lines - and the report of them: "How on earth would that help anybody?"). A Get
           cannot go between a line and its ';' continuation, but it can go ABOVE THE STATEMENT'S FIRST
           LINE - which is where the temp has to be declared anyway. So: iStmtStartOut remembers where
           the current statement began in asOut; a continuation line converts like any other and its
           Variant + Get lines are INSERTED there instead of appended here. The legacy check is made over
           the WHOLE statement's text (a Ne on line 2 of a call on line 1 is the same 4317), computed
           once at the statement's first line and carried. "split over two lines" survives only as the
           reason for a continuation whose start could not be seen (a file that begins mid-statement). */
        Move -1    to iStmtStartOut
        Move ""    to sStmtIndent
        Move False to bStmtLegacy
        Move False to bStmtDbMode
        Move False to bPrevComment
        For iCount from 0 to iSize
            If (bPanel = True and Mod(iCount, 20) = 0) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iCount + 1) * "of:" * String(iSize + 1))
                Set piPosition of ghoProgressBar to (iCount + 1)
            End
            Move asCode[iCount] to sLine
            Move (Trim(sLine))  to sTrim
            Move asEmptyStr to asPre
            Move False to bSkip
            Get _IsCommentLine sLine to bComment
            If (bComment = True) ;
                Move True to bSkip
            Move False to bTwoLine
            Move False to bLegacy
            Move False to bDbMode
            // Continuation = the previous CODE line ended with ';' (a comment ending in ';' is prose).
            Move (bPrevComment = False and Right(sPrevTrim, 1) = ";") to bContinuation
            If (bContinuation = False and bComment = False) Begin
                // A statement starts here: remember where it lands in asOut (before any pre-lines of its
                // own), its indent, and - when it continues - the legacy verdict of the whole statement.
                Move (SizeOfArray(asOut)) to iStmtStartOut
                Move "" to sStmtIndent
                Move (Pos(sTrim, sLine)) to iP
                If (iP > 1) ;
                    Move (Left(sLine, (iP - 1))) to sStmtIndent
                Move False to bStmtLegacy
                Move False to bStmtDbMode
                If (Right(sTrim, 1) = ";") Begin
                    Move "" to sStmtText
                    Move iCount to j
                    While (j <= iSize)
                        Get _MaskStringLiterals asCode[j] to sMasked
                        Move (sStmtText + " " + sMasked) to sStmtText
                        If (Right(Trim(asCode[j]), 1) <> ";") ;
                            Move (iSize + 1) to j
                        Else ;
                            Increment j
                    Loop
                    Get _LineHasLegacyCompareWord sStmtText to bStmtLegacy
                    If (bStmtLegacy = True) Begin
                        If (_ConstrainCommandPos(Self, sStmtText) > 0 or _FindKeywordPos(Self, sStmtText, CS_Find, True, 1) > 0) Begin
                            Move True  to bStmtDbMode
                            Move False to bStmtLegacy
                        End
                    End
                End
            End
            If (bContinuation = True and iStmtStartOut < 0) Begin
                Move True to bSkip
                Move True to bTwoLine          // a continuation whose statement start was never seen
            End
            // LEGACY COMPARISON SYNTAX cannot take a Variant operand. "If (v) Ne ..." and
            // "Indicate ... Ge (v)" both fail with error 4317 ("not valid for logical evaluation") -
            // VERIFIED against DF25, where the identical line with a String temp compiles. Switching the
            // temp to String is NOT the fix: it would silently turn numeric comparisons into STRING
            // comparisons ("20" > "100"), and a silent behaviour change is far worse than a compile error.
            // Variant is correct precisely because it preserves the value's type. So leave these lines to
            // ChangeLegacyOperators, which modernises Ge/Le/Ne/Eq/Gt/Lt first - after which they convert
            // cleanly. (Nils's first live run, 2026-07-21: this converter introduced 10 such errors.)
            // "indicate" is deliberately NOT a skip on its own: an Indicate line is only a problem while
            // it still carries a LEGACY operator (verified against DF25 - a Variant IS valid in a modern
            // >= / <= comparison; only the legacy Ge/Ne form rejects it, error 4317). Nils 2026-07-22.
            If (bSkip = False) Begin
                Get _MaskStringLiterals sLine to sMasked
                Get _LineHasLegacyCompareWord sMasked to bLegacy
                /* A MODE WORD IS NOT A COMPARISON (Nils 2026-08-17). On a Find / Constrain / VConstrain
                   line the eq/ge/... is the command's own argument; ChangeLegacyOperators refuses it by
                   design, so declining the line as "old comparison words" made the dashboard offer an
                   operators run that changed 0 lines, then a re-convert that converted 0 - twice in a
                   row on WinServ ('Constrain WEB_FORM.NR eq (Value(oWebFormNrComboForm))'). It is
                   still declined - a Variant temp cannot stand in a mode argument any more than in a
                   legacy comparison - but under its own reason and counter, so the caller says "hand
                   work" and does not offer the futile run. */
                If (bLegacy = True) Begin
                    If (_ConstrainCommandPos(Self, sMasked) > 0 or _FindKeywordPos(Self, sMasked, CS_Find, True, 1) > 0) Begin
                        Move True  to bDbMode
                        Move False to bLegacy
                    End
                End
                // The statement's verdict covers every one of its lines.
                If (bStmtLegacy = True) ;
                    Move True to bLegacy
                If (bStmtDbMode = True and bLegacy = False) ;
                    Move True to bDbMode
                If (bLegacy = True or bDbMode = True) ;
                    Move True to bSkip
            End
            // Only count a skip when the line ACTUALLY carries one of the ambiguous calls - otherwise every
            // ordinary legacy-operator line in the file would inflate the tally and the report would be
            // useless. Cheap because it only runs on lines we were about to decline.
            If (bSkip = True) Begin
                Get _RightmostAmbiguousCall sLine asNames (&iStart) (&iOpen) (&iClose) to sName
                If (sName <> "") Begin
                    Move "" to sWhy
                    If (bLegacy = True) ;
                        Move "old comparison words" to sWhy
                    If (bDbMode = True) ;
                        Move "argument of a Find / Constrain" to sWhy
                    If (bTwoLine = True and bLegacy = False and bDbMode = False) ;
                        Move "split over two lines" to sWhy
                    // Record WHERE, so a row can open the editor there - the position in the OUTPUT (each
                    // conversion above inserts two lines), i.e. SizeOfArray(asOut) + 1 for the line appended
                    // next. DEDUPED, and the counters count only what is recorded (the engine can put a
                    // whole-file function over the same file more than once). The line's TEXT rides along
                    // as a fourth field so the report can show WHAT is left, not just where.
                    If (sWhy <> "") Begin
                        Get pasHoistDeclined to asDeclined
                        Move (psHoistCurrentFile(Self) + "|" + String(SizeOfArray(asOut) + 1) + "|" + sWhy + "|" + sTrim) to sEntry
                        If (SearchArray(sEntry, asDeclined, Desktop, RefFunc(DFSTRICMP)) = -1) Begin
                            Move sEntry to asDeclined[SizeOfArray(asDeclined)]
                            Set pasHoistDeclined to asDeclined
                            If (bLegacy = True) ;
                                Set piHoistSkipLegacy to (piHoistSkipLegacy(Self) + 1)
                            If (bDbMode = True) ;
                                Set piHoistSkipDbMode to (piHoistSkipDbMode(Self) + 1)
                            If (bLegacy = False and bDbMode = False) ;
                                Set piHoistSkipTwoLine to (piHoistSkipTwoLine(Self) + 1)
                        End
                    End
                End
            End
            If (bSkip = False) Begin
                // The temp lines take the STATEMENT's indent - on a continuation line that is the first
                // line's, since that is where they will be inserted.
                If (bContinuation = True) ;
                    Move sStmtIndent to sIndent
                Else Begin
                    Move "" to sIndent
                    Move (Pos(sTrim, sLine)) to iP
                    If (iP > 1) ;
                        Move (Left(sLine, (iP - 1))) to sIndent
                End
                Move True to bFound
                While (bFound = True)
                    Get _RightmostAmbiguousCall sLine asNames (&iStart) (&iOpen) (&iClose) to sName
                    Move (sName <> "") to bFound
                    If (bFound = True) Begin
                        Move (Mid(sLine, (iClose - iOpen - 1), (iOpen + 1))) to sInside
                        Get _SplitCallArgs sInside to asArgs
                        If (SizeOfArray(asArgs) = 0) Begin
                            Move False to bFound      // no object argument - leave this line alone
                        End
                        Else Begin
                            Increment iSeq
                            Move ("vDfrGet" + String(iSeq)) to sTmp
                            Move (Trim(asArgs[0])) to sObj
                            Move ("Get " + sName) to sGet
                            // Self needs no "of" - it is the implicit target (matches the Get form the
                            // existing ChangeObjectFunctionCallToGet emits).
                            If (Lowercase(sObj) <> "self") ;
                                Move (sGet + " of (" + sObj + ")") to sGet
                            Move (SizeOfArray(asArgs) - 1) to iALast
                            For iA from 1 to iALast
                                Move (Trim(asArgs[iA])) to sArg
                                Move (sGet + " (" + sArg + ")") to sGet
                            Loop
                            Move (sGet + " to " + sTmp) to sGet
                            Move (sIndent + "Variant " + sTmp) to asPre[SizeOfArray(asPre)]
                            Move (sIndent + sGet)              to asPre[SizeOfArray(asPre)]
                            Move (Left(sLine, (iStart - 1)) + sTmp + Mid(sLine, (Length(sLine) - iClose), (iClose + 1))) to sLine
                            Increment iHoisted
                            Set piHoistConverted to (piHoistConverted(Self) + 1)
                        End
                    End
                Loop
            End
            Move (SizeOfArray(asPre) - 1) to iA
            If (bContinuation = True and iA >= 0) Begin
                // INSERT above the statement's first line: everything from iStmtStartOut on moves down by
                // the pre-lines' count. iStmtStartOut itself stays: the next continuation's temps go in at
                // the same index, above the earlier ones - the order among the temps is immaterial, only
                // that all of them sit above the statement.
                Move (SizeOfArray(asOut) - 1) to j
                Move (ResizeArray(asOut, (SizeOfArray(asOut) + iA + 1))) to asOut
                While (j >= iStmtStartOut)
                    Move asOut[j] to asOut[j + iA + 1]
                    Decrement j
                Loop
                For j from 0 to iA
                    Move asPre[j] to asOut[iStmtStartOut + j]
                Loop
            End
            Else Begin
                For j from 0 to iA
                    Move asPre[j] to asOut[SizeOfArray(asOut)]
                Loop
            End
            Move sLine    to asOut[SizeOfArray(asOut)]
            Move sTrim    to sPrevTrim
            Move bComment to bPrevComment
        Loop
        // Finish the file at 100% - see the note in _GuardGlobalsInLines.
        If (bPanel = True) Begin
            Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(iSize + 1) * "of:" * String(iSize + 1))
            Set piPosition of ghoProgressBar to (iSize + 1)
        End
        If (iHoisted > 0) ;
            Move asOut to asCode
        Function_Return iHoisted
    End_Function

    /* ---- The COMPILER's built-in globals (Data\DfVersion-BuiltIns-<ver>.json, from the install's own
       Lib\GlobalFunctions.lst). Path / write / read / stale mirror the catalogues below. ----

       WHY A SECOND CATALOGUE. The Pkg-source walk below finds what the PACKAGES declare. It cannot
       find what the compiler implements, because those have no declaration to find: measured
       2026-08-01 against DF 25, the walk sees 2 of the 85 names in GlobalFunctions.lst. The other 83
       - Abs, Trim, Cast, Character, If, Eval, Integer, every DateGet / DateSet - are exactly the
       "runtime globals the catalogue cannot see" that the 4390 rule warns about. Data Access ships
       the list; there is no reason to keep inferring around it.

       Not a performance cache. The .lst is 85 lines and parses in microseconds, unlike the walk this
       sits beside - which is what the JSON there exists for. This one is persisted for parity and for
       the case the walk also has to handle: a target install that is not on this machine. */

    // <install root>\Lib\GlobalFunctions.lst for the TARGET version, derived from the Pkg folder the
    // app already resolves (bin -> root -> Pkg), so no second copy of that walk-up lives here.
    Function InstallGlobalFunctionsLstPath Returns String
        String sPkg sRoot
        Integer iPos
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (Trim(sPkg) = "") ;
            Function_Return ""
        If (Right(sPkg, 1) = "\") ;
            Move (Left(sPkg, (Length(sPkg) - 1))) to sPkg
        Move (RightPos("\", sPkg)) to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (Left(sPkg, (iPos - 1))) to sRoot
        Function_Return (vFolderFormat(sRoot) + "Lib\" + CS_InstallGlobalFunctionsLst)
    End_Function

    /* PURE parser for the .lst's one-line-per-function format:

           Abs: (Real rValue) [Real]
           CurrentDateTime: () [DateTime]
           Cast: (AnyType v, Type-name) [AnyType]

       Kept separate from the file read so it can be unit-tested without an install present - the same
       reason the Use-line parser sits apart from the usage scan. A line without a colon is not an
       entry (the file has no comment convention today, but a blank or stray line must not become a
       function called ""). The return type is optional: no brackets means the .lst did not state one,
       and blank is recorded rather than a guess. */
    Function _BuiltInFuncsFromLines String[] asLines Returns tBuiltInFunc[]
        tBuiltInFunc[] aOut
        tBuiltInFunc F
        String sLine sRest
        Integer i iMax iPos iOpen iClose

        Move (SizeOfArray(asLines) - 1) to iMax
        For i from 0 to iMax
            Move (Trim(asLines[i])) to sLine
            Move (Pos(":", sLine)) to iPos
            If (sLine <> "" and iPos > 1) Begin
                Move (Trim(Left(sLine, (iPos - 1)))) to F.sName
                Move (Trim(Mid(sLine, (Length(sLine) - iPos), (iPos + 1)))) to sRest
                Move "" to F.sParams
                Move "" to F.sReturns
                // Parameters: the first (...) group.
                Move (Pos("(", sRest)) to iOpen
                Move (Pos(")", sRest)) to iClose
                If (iOpen > 0 and iClose > iOpen) ;
                    Move (Mid(sRest, (iClose - iOpen + 1), iOpen)) to F.sParams
                // Return type: the [...] group, when the line states one.
                Move (Pos("[", sRest)) to iOpen
                Move (Pos("]", sRest)) to iClose
                If (iOpen > 0 and iClose > (iOpen + 1)) ;
                    Move (Trim(Mid(sRest, (iClose - iOpen - 1), (iOpen + 1)))) to F.sReturns
                If (F.sName <> "") ;
                    Move F to aOut[SizeOfArray(aOut)]
            End
        Loop
        Function_Return aOut
    End_Function

    // The .lst's identity for staleness: last-write + size. One file, so this is exact rather than a
    // watermark over a tree.
    Function _BuiltInsSourceStamp Returns String
        String sFile
        Boolean bExists
        Get InstallGlobalFunctionsLstPath to sFile
        If (sFile = "") ;
            Function_Return ""
        Get vFilePathExists sFile to bExists
        If (bExists = False) ;
            Function_Return ""
        Function_Return (String(rfFileDate(sFile)) + "|" + String(rfFileSizeLive(sFile)))
    End_Function

    // The cache path for ANY version, not just the one currently targeted - the TestBench catalogue
    // writer builds files for a version the user picks, which is not necessarily this session's.
    Function BuiltInFuncsCacheJsonPathFor String sVer Returns String
        String sData sFile
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move CS_BuiltInFuncsCacheJson to sFile
        If (Trim(sVer) <> "") ;
            Move (Replace(".json", sFile, ("-" + sVer + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    Function BuiltInFuncsCacheJsonPath Returns String
        String sVer
        Get psTargetDfVersion of ghoApplication to sVer
        Function_Return (BuiltInFuncsCacheJsonPathFor(Self, sVer))
    End_Function

    // Write to an EXPLICIT path, so the same serializer serves both the runtime cache and a
    // catalogue built for a version the user picked by hand.
    Procedure WriteBuiltInFuncsCacheTo tBuiltInFunc[] aFuncs String sStamp String sFile
        Handle hoJson
        tBuiltInFuncsCacheFile CacheFile
        UChar[] ucJson
        Integer iCh

        Move CI_BuiltInFuncsCacheVersion to CacheFile.iVersion
        Move sStamp to CacheFile.sSourceStamp
        Move aFuncs to CacheFile.aFuncs
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson CacheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // The runtime cache: this session's target, at its own path.
    Procedure WriteBuiltInFuncsCache tBuiltInFunc[] aFuncs String sStamp
        Send WriteBuiltInFuncsCacheTo aFuncs sStamp (BuiltInFuncsCacheJsonPath(Self))
    End_Procedure

    // False (aFuncs untouched) if absent / unparseable / stale schema / the .lst changed under it.
    // vFilePathExists guard: rfOpenInput raises Error 33 on a missing file, not a < 0 return.
    Function ReadBuiltInFuncsCache tBuiltInFunc[] ByRef aFuncs Returns Boolean
        Handle hoJson
        tBuiltInFuncsCacheFile CacheFile
        String sFile sStamp

        Get BuiltInFuncsCacheJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to CacheFile
        Send Destroy of hoJson
        If (CacheFile.iVersion <> CI_BuiltInFuncsCacheVersion) ;
            Function_Return False
        Get _BuiltInsSourceStamp to sStamp
        // A blank stamp means the install is not reachable right now. The cache is then the ONLY
        // answer there is, so it is served rather than discarded - the alternative is losing the
        // catalogue entirely because a machine happens not to have that version installed.
        If (sStamp <> "" and sStamp <> CacheFile.sSourceStamp) ;
            Function_Return False
        Move CacheFile.aFuncs to aFuncs
        Function_Return True
    End_Function

    /* The built-in globals for the target version, cached per session then per file.

       REFUSE, DO NOT GUESS: no install and no cache returns EMPTY, exactly like the Pkg walk's
       catalogues. An empty list must read as "not known" at every call site, never as "there are no
       built-in functions" - the 4390 rule exists because that distinction was got wrong once. */
    Function RunBuiltInFuncNames Returns tBuiltInFunc[]
        tBuiltInFunc[] aFuncs
        String[] asLines
        String sFile sStamp
        Boolean bOK bExists

        If (pbBuiltInFuncsLoaded(Self) = True) ;
            Function_Return (paBuiltInFuncs(Self))
        Set pbBuiltInFuncsLoaded to True
        Get ReadBuiltInFuncsCache (&aFuncs) to bOK
        If (bOK = True) Begin
            Set paBuiltInFuncs to aFuncs
            Function_Return aFuncs
        End
        Get InstallGlobalFunctionsLstPath to sFile
        If (sFile <> "") ;
            Get vFilePathExists sFile to bExists
        If (bExists = False) Begin
            Set pbInstallScanFailed to True
            Set paBuiltInFuncs to aFuncs
            Function_Return aFuncs
        End
        Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
        Get _BuiltInFuncsFromLines asLines to aFuncs
        Get _BuiltInsSourceStamp to sStamp
        Send WriteBuiltInFuncsCache aFuncs sStamp
        Set paBuiltInFuncs to aFuncs
        Function_Return aFuncs
    End_Function

    // ---- The target install's NAMED ERROR NUMBERS (Data\DfVersion-ErrorNames-<ver>.json), read from
    // <install>\Pkg\errornum.inc - the same scheme as the built-in globals above: one install file,
    // stamped by last-write + size, loaded once per run (2026-10-23, DS 9244 / 9245). ----

    // <install>\Pkg\errornum.inc for the TARGET version.
    Function InstallErrorNumIncPath Returns String
        String sPkg
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (Trim(sPkg) = "") ;
            Function_Return ""
        Function_Return (vFolderFormat(sPkg) + CS_InstallErrorNumInc)
    End_Function

    /* PURE parser for errornum.inc's one-line-per-name format:

           #REPLACE DFERR_REC_NOT_FOUND                             25

       Only a DFERR_ name with a whole number is an entry; the file's include guard
       ('#REPLACE ERRORNUM_INCLUDED |CI1') is not. Kept apart from the file read so it can be
       unit-tested without an install present. Were a release ever to name a number twice, both
       entries are kept and ErrorNameForNumber answers with the first. */
    Function _ErrorNamesFromLines String[] asLines Returns tErrorName[]
        tErrorName[] aOut
        tErrorName E
        String sName sValue
        Integer i iMax j iLen
        Boolean bDigits

        Move (SizeOfArray(asLines) - 1) to iMax
        For i from 0 to iMax
            If (Lowercase(_NthWord(Self, asLines[i], 1)) = "#replace") Begin
                Get _NthWord asLines[i] 2 to sName
                Get _NthWord asLines[i] 3 to sValue
                Move (Length(sValue)) to iLen
                Move (iLen > 0 and iLen <= 9) to bDigits
                For j from 1 to iLen
                    If (Pos(Mid(sValue, 1, j), "0123456789") = 0) ;
                        Move False to bDigits
                Loop
                If (bDigits = True and Uppercase(Left(sName, 6)) = "DFERR_") Begin
                    Move sValue to E.iNumber
                    Move sName  to E.sName
                    Move E to aOut[SizeOfArray(aOut)]
                End
            End
        Loop
        Function_Return aOut
    End_Function

    // errornum.inc's identity for staleness: last-write + size, as for GlobalFunctions.lst.
    Function _ErrorNamesSourceStamp Returns String
        String sFile
        Boolean bExists
        Get InstallErrorNumIncPath to sFile
        If (sFile = "") ;
            Function_Return ""
        Get vFilePathExists sFile to bExists
        If (bExists = False) ;
            Function_Return ""
        Function_Return (String(rfFileDate(sFile)) + "|" + String(rfFileSizeLive(sFile)))
    End_Function

    // The cache path for ANY version, not only the one targeted.
    Function ErrorNamesCacheJsonPathFor String sVer Returns String
        String sData sFile
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move CS_ErrorNamesCacheJson to sFile
        If (Trim(sVer) <> "") ;
            Move (Replace(".json", sFile, ("-" + sVer + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    Function ErrorNamesCacheJsonPath Returns String
        String sVer
        Get psTargetDfVersion of ghoApplication to sVer
        Function_Return (ErrorNamesCacheJsonPathFor(Self, sVer))
    End_Function

    // Write to an EXPLICIT path (NO BOM) - mirrors WriteBuiltInFuncsCacheTo.
    Procedure WriteErrorNamesCacheTo tErrorName[] aNames String sStamp String sFile
        Handle hoJson
        tErrorNamesCacheFile CacheFile
        UChar[] ucJson
        Integer iCh

        Move CI_ErrorNamesCacheVersion to CacheFile.iVersion
        Move sStamp to CacheFile.sSourceStamp
        Move aNames to CacheFile.aNames
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson CacheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // False (aNames untouched) if absent / unparseable / stale schema / errornum.inc changed under it.
    // A blank stamp (the install is not on this machine) serves the cache: it is the only answer there is.
    Function ReadErrorNamesCache tErrorName[] ByRef aNames Returns Boolean
        Handle hoJson
        tErrorNamesCacheFile CacheFile
        String sFile sStamp

        Get ErrorNamesCacheJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to CacheFile
        Send Destroy of hoJson
        If (CacheFile.iVersion <> CI_ErrorNamesCacheVersion) ;
            Function_Return False
        Get _ErrorNamesSourceStamp to sStamp
        If (sStamp <> "" and sStamp <> CacheFile.sSourceStamp) ;
            Function_Return False
        Move CacheFile.aNames to aNames
        Function_Return True
    End_Function

    /* The named error numbers of the target version, cached per run then per file.

       REFUSE, DO NOT GUESS: no install and no cache returns EMPTY, and an empty list reads as "not
       known" - never as "DataFlex names no errors". ErrorNamesKnown is the test for it. */
    Function RunErrorNames Returns tErrorName[]
        tErrorName[] aNames
        String[] asLines
        String sFile sStamp
        Boolean bOK bExists

        If (pbErrorNamesLoaded(Self) = True) ;
            Function_Return (paErrorNames(Self))
        Set pbErrorNamesLoaded to True
        Get ReadErrorNamesCache (&aNames) to bOK
        If (bOK = True) Begin
            Set paErrorNames to aNames
            Function_Return aNames
        End
        Get InstallErrorNumIncPath to sFile
        Move False to bExists
        If (sFile <> "") ;
            Get vFilePathExists sFile to bExists
        If (bExists = False) Begin
            Set pbInstallScanFailed to True
            Set paErrorNames to aNames
            Function_Return aNames
        End
        Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
        Get _ErrorNamesFromLines asLines to aNames
        Get _ErrorNamesSourceStamp to sStamp
        Send WriteErrorNamesCacheTo aNames sStamp (ErrorNamesCacheJsonPath(Self))
        Set paErrorNames to aNames
        Function_Return aNames
    End_Function

    // True when the target version's error names are known at all (an install or a cache).
    Function ErrorNamesKnown Returns Boolean
        tErrorName[] aNames
        Get RunErrorNames to aNames
        Function_Return (SizeOfArray(aNames) > 0)
    End_Function

    // The target DataFlex's name for error number iNum (25 -> DFERR_REC_NOT_FOUND), or "" when it
    // names none - or when the names are not known at all, which ErrorNamesKnown tells apart.
    Function ErrorNameForNumber Integer iNum Returns String
        tErrorName[] aNames
        Integer i iMax
        Get RunErrorNames to aNames
        Move (SizeOfArray(aNames) - 1) to iMax
        For i from 0 to iMax
            If (aNames[i].iNumber = iNum) ;
                Function_Return aNames[i].sName
        Loop
        Function_Return ""
    End_Function

    /* THE LITERAL NUMBER OF AN ERROR COMMAND - 'Error 42', 'If (x) Error 300', 'Else Error 42',
       '[found] Error 25' - or 0 when the line has none. ONE decision for the Deep Scan rules (DS 9244 /
       9245) and for ChangeErrorNumberToName, so the scan and the fix cannot drift apart. sMasked must
       have its string literals and comments blanked (the overstrike line, or the scan's code-only
       line), so a number inside a message text never counts. iNumPos / iNumLen say where the digits
       are on that line (1-based).

       COMMAND POSITION ONLY: first on the line, after an indicator's "]", after the ")" of an If or
       Else If condition, or after Else / Begin. So Error_Report, On Error, Send Error, Error DFERR_X
       and Error (iErr) are never it - and neither is a legacy If without parentheses, which gets no
       row rather than a guess. */
    Function _ErrorCommandNumber String sMasked Integer ByRef iNumPos Integer ByRef iNumLen Returns Integer
        String sLow sBefore sCh sDigits
        Integer iLen iAt i iEnd iSp iNum
        Boolean bCmd

        Move 0 to iNumPos
        Move 0 to iNumLen
        // Tabs to spaces, one for one, so every position still matches sMasked.
        Move (Lowercase(Replaces(Character(9), sMasked, " "))) to sLow
        Move (Length(sLow)) to iLen
        Get _FindKeywordPos sLow "error" True 1 to iAt
        While (iAt > 0)
            Move (Trim(Left(sLow, (iAt - 1)))) to sBefore
            Move (sBefore = "") to bCmd
            If (bCmd = False) Begin
                Move (Right(sBefore, 1)) to sCh
                If (sCh = "]") ;
                    Move True to bCmd
                Else If (sCh = ")") ;
                    Move (_FindKeywordPos(Self, sBefore, "if", True, 1) = 1 or _FindKeywordPos(Self, sBefore, "else", True, 1) = 1) to bCmd
                Else Begin
                    Move (RightPos(" ", sBefore)) to iSp
                    Move (Mid(sBefore, (Length(sBefore) - iSp), (iSp + 1))) to sCh
                    Move (sCh = "else" or sCh = "begin") to bCmd
                End
            End
            If (bCmd = True and Mid(sLow, 1, (iAt + 5)) = " ") Begin
                Move (iAt + 5) to i
                While (i <= iLen and Mid(sLow, 1, i) = " ")
                    Increment i
                Loop
                Move i to iEnd
                While (iEnd <= iLen and Pos(Mid(sLow, 1, iEnd), "0123456789") > 0)
                    Increment iEnd
                Loop
                // The digits must end the word: the end of the line, a space or a ';' continuation.
                If (iEnd > i and (iEnd - i) <= 9) Begin
                    Move (Mid(sLow, 1, iEnd)) to sCh
                    If (iEnd > iLen or sCh = " " or sCh = ";") Begin
                        Move i to iNumPos
                        Move (iEnd - i) to iNumLen
                        Move (Mid(sLow, iNumLen, iNumPos)) to sDigits
                        Move sDigits to iNum
                        Function_Return iNum
                    End
                End
            End
            Get _FindKeywordPos sLow "error" True (iAt + 5) to iAt
        Loop
        Function_Return 0
    End_Function

    /* WHICH ERROR NUMBERS DOES CODE READ (2026-11-05, ChangeErrorNumberToGenericError). The fix turns many numbers
       into one, so a number something tells apart has to stay. Read means: on a code line naming LastErr, Ignore_Error,
       Trap_Error or the error handler's own messages, or anywhere in the body of an Error_Report or HandleError. A
       number that only stands in a variable first is not seen. The files are the run's, the Deep Scan's
       (pasErrorReaderScope) and the workspace's outside those. "<number>|<file>" per number, its first reader. Built
       once on first need, and cleared by _InitializeFuncLib. Only a line that says 'err' is scanned at all, so the walk
       stays far cheaper than the name readers' 17 s over 1,211 files. */
    Procedure _BuildErrorNumberReaders
        tRefactorSettings Settings
        String[] asFiles asMore asSource asWords asSeen asOut
        String sFilter sLow sCode sFirst sPrev
        Integer iFile iLastFile iLine iLastLine iWord iLastWord iBarMax iBarPos
        Boolean bHandler bRead bDigits bPanel bBarWasMoved

        Set pbErrorReadersBuilt to True
        Get pRefactorSettings to Settings
        Move Settings.FileData.asFullFileNames to asFiles
        Get pasErrorReaderScope to asMore
        Move (AppendArray(asFiles, asMore)) to asFiles
        Move Settings.sFileFilter to sFilter
        If (Trim(sFilter) = "") ;
            Move "*.pkg;*.src;*.vw;*.dg;*.sl;*.inc;*.h;*.mod;*.nui;*.dd;*.bp;*.rv;*.cui" to sFilter
        Get _OutsideReaderFiles asFiles sFilter to asMore
        Move (AppendArray(asFiles, asMore)) to asFiles
        Move (SortArray(asFiles)) to asFiles
        Move (SizeOfArray(asFiles) - 1) to iLastFile
        Move "" to sPrev
        Send _WalkBarHold (&bPanel) (&iBarMax) (&iBarPos) (&bBarWasMoved)
        For iFile from 0 to iLastFile
            Send _LiftNudge iFile (iLastFile + 1) "Finding the code that reads an error number, file:"
            If (asFiles[iFile] <> sPrev) Begin
                Move (rfReadEncodedFileAsStringArray(asFiles[iFile])) to asSource
                Move False to bHandler
                Move (SizeOfArray(asSource) - 1) to iLastLine
                For iLine from 0 to iLastLine
                    Move (Lowercase(asSource[iLine])) to sLow
                    If (bHandler = True or Pos("err", sLow) > 0) Begin
                        Get _CodeOnlyLine sLow to sCode
                        Get _NameWords sCode to asWords
                        Move (SizeOfArray(asWords) - 1) to iLastWord
                        If (iLastWord >= 0) Begin
                            Move asWords[0] to sFirst
                            If (sFirst = "end_procedure" or sFirst = "end_function") ;
                                Move False to bHandler
                            If (iLastWord > 0 and (sFirst = "procedure" or sFirst = "function") and (asWords[1] = "error_report" or asWords[1] = "handleerror")) ;
                                Move True to bHandler
                            Move bHandler to bRead
                            For iWord from 0 to iLastWord
                                If (asWords[iWord] = "lasterr" or asWords[iWord] = "ignore_error" or asWords[iWord] = "trap_error" ;
                                    or asWords[iWord] = "ignoreerror" or asWords[iWord] = "traperror" or asWords[iWord] = "addusererror" ;
                                    or asWords[iWord] = "removeusererror" or asWords[iWord] = "isusererror" or asWords[iWord] = "add_user_error" ;
                                    or asWords[iWord] = "remove_user_error" or asWords[iWord] = "error_report") ;
                                    Move True to bRead
                            Loop
                            If (bRead = True) Begin
                                For iWord from 0 to iLastWord
                                    Get _IsAllDigits asWords[iWord] to bDigits
                                    If (bDigits = True and SearchArray(asWords[iWord], asSeen) = -1) Begin
                                        Move asWords[iWord] to asSeen[SizeOfArray(asSeen)]
                                        Move (asWords[iWord] + "|" + asFiles[iFile]) to asOut[SizeOfArray(asOut)]
                                    End
                                Loop
                            End
                        End
                    End
                Loop
            End
            Move asFiles[iFile] to sPrev
        Loop
        Send _WalkBarHandBack bPanel iBarMax iBarPos bBarWasMoved
        Set pasErrorNumberReaders to asOut
    End_Procedure

    // The first file whose code reads error number iNum (_BuildErrorNumberReaders), "" when none does.
    Function _ErrorNumberReader Integer iNum Returns String
        String[] asRows
        String sPre
        Integer i iLast

        If (pbErrorReadersBuilt(Self) = False) ;
            Send _BuildErrorNumberReaders
        Get pasErrorNumberReaders to asRows
        Move (String(iNum) + "|") to sPre
        Move (SizeOfArray(asRows) - 1) to iLast
        For i from 0 to iLast
            If (Left(asRows[i], Length(sPre)) = sPre) ;
                Function_Return (Right(asRows[i], (Length(asRows[i]) - Length(sPre))))
        Loop
        Function_Return ""
    End_Function

    /* PURE. The error numbers a Flexerrs.dat holds a text for, in aiNumbers. False when the bytes are not that file. The
       record number is the error number; measured 2026-11-05 on a real one and with DataFlex 26: a 512-byte header, a
       record of 64 bytes with the text in its first 40, record 0 unused, and FlexErrs reads a record added at 300. */
    Function _FlexErrsNumbers UChar[] ByRef ucFile Integer[] ByRef aiNumbers Returns Boolean
        Integer iSize iLastRec iRec iAt iByte
        Boolean bText

        Move (ResizeArray(aiNumbers, 0)) to aiNumbers
        Move (SizeOfArray(ucFile)) to iSize
        If (iSize < (512 + 64) or Mod((iSize - 512), 64) <> 0) ;
            Function_Return False
        Move (((iSize - 512) / 64) - 1) to iLastRec
        For iRec from 1 to iLastRec
            Move (512 + (iRec * 64)) to iAt
            Move False to bText
            For iByte from 0 to 39
                If (ucFile[iAt + iByte] <> 0 and ucFile[iAt + iByte] <> 32) ;
                    Move True to bText
            Loop
            If (bText = True) ;
                Move iRec to aiNumbers[SizeOfArray(aiNumbers)]
        Loop
        Function_Return True
    End_Function

    /* THE TEXTS THE TARGET'S Flexerrs.dat HOLDS (2026-11-05). DataFlex 26 reads that file from beside the program; a copy
       in the Data folder changed nothing, measured. The Data folder is read here as well, because a record there says
       someone meant that number to have a text, and leaving the line alone costs nothing. A blank target home is the
       unit tests' cApplication; pasFlexErrsFolders replaces the folders for a test. Once per run. */
    Procedure _ReadFlexErrs
        tWorkspacePaths WS
        String[] asFolders
        Integer[] aiHeld aiOne
        UChar[] ucFile
        String sHome sFile
        Integer i iLast iCh
        Boolean bExists bOK

        Set pbFlexErrsRead to True
        Set pbFlexErrsUnreadable to False
        Get pasFlexErrsFolders to asFolders
        If (SizeOfArray(asFolders) = 0) Begin
            Get psHomeTarget of ghoApplication to sHome
            If (Trim(sHome) <> "") Begin
                Get pTargetWS of ghoApplication to WS
                Move WS.sPrograms to asFolders[0]
                Move WS.sData     to asFolders[1]
            End
        End
        Move (SizeOfArray(asFolders) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asFolders[i]) <> "") Begin
                Move (vFolderFormat(asFolders[i]) + "Flexerrs.dat") to sFile
                Get vFilePathExists sFile to bExists
                If (bExists = True) Begin
                    Move (ResizeArray(ucFile, 0)) to ucFile
                    Get rfOpenInput sFile to iCh
                    If (iCh >= 0) Begin
                        Read_Block channel iCh ucFile -1
                        Send rfCloseInput iCh
                    End
                    Get _FlexErrsNumbers (&ucFile) (&aiOne) to bOK
                    If (bOK = True) ;
                        Move (AppendArray(aiHeld, aiOne)) to aiHeld
                    Else ;
                        Set pbFlexErrsUnreadable to True
                End
            End
        Loop
        Set paiFlexErrsHeld to aiHeld
    End_Procedure

    /* WHY THIS ERROR LINE KEEPS ITS NUMBER - "" when it can take a generic one. ONE decision for the rules (DS 9245 keeps
       what this declines, DS 9252 takes the rest) and for ChangeErrorNumberToGenericError. sLine is the raw line, and the
       caller has already seen on the masked one that it is an Error command with a number DataFlex does not name.

       A LINE WITH ITS OWN TEXT shows that text alone, unless a Flexerrs.dat record for the number stands in front of it
       (cBaseErrorHandler.ErrorDescription: record, a blank line, the text). So those two are what a bare number and a
       record decide. A variable or an expression counts as text: if one is ever blank the message is just as empty as
       it was. And a number code reads stays, because all of them are about to become one. */
    Function _MadeUpErrorWhyNot String sLine Returns String
        String sCode sRest sReader
        Integer iNum iNumPos iNumLen
        Boolean bHeld

        Get _CodeOnlyLine sLine to sCode
        Get _ErrorCommandNumber sCode (&iNumPos) (&iNumLen) to iNum
        If (iNum <= 0) ;
            Function_Return "It is not an Error command with a number."
        Move (Trim(Replaces(Character(9), Mid(sLine, Length(sLine), (iNumPos + iNumLen)), " "))) to sRest
        If (sRest = "" or Left(sRest, 2) = "//") ;
            Function_Return ("Error " + String(iNum) + " has no text of its own, so any text it shows comes from Flexerrs.dat. It can stay.")
        If (Left(sRest, 1) = ";") ;
            Function_Return ("Error " + String(iNum) + " goes on over the next line, which the automatic fix does not follow.")
        If (ErrorNameForNumber(Self, 4401) = "" or ErrorNameForNumber(Self, 4402) = "") ;
            Function_Return "The target DataFlex has no name for the generic errors 4401 and 4402."
        If (pbFlexErrsRead(Self) = False) ;
            Send _ReadFlexErrs
        If (pbFlexErrsUnreadable(Self) = True) ;
            Function_Return ("A Flexerrs.dat in this workspace could not be read, so whether it has a text for " + String(iNum) + " is not known.")
        Move (SearchArray(iNum, paiFlexErrsHeld(Self)) <> -1) to bHeld
        If (bHeld = True) ;
            Function_Return ("Flexerrs.dat has a text for " + String(iNum) + ", and DataFlex shows it above the line's own text. A generic number would lose it.")
        Get _ErrorNumberReader iNum to sReader
        If (sReader <> "") ;
            Function_Return (sReader + " reads the number " + String(iNum) + ", and a generic number would change what that code sees.")
        Function_Return ""
    End_Function

    /* The class after 'for' in a method header - 'Procedure Foo for cObject', 'Procedure Set psFoo for
       BaseClass String sValue', 'Function Foo for DFDesktop Integer i Returns String' - lowercased, or ""
       when the line is no such header. sLow is a masked line, lowercased, tabs as spaces; iForPos and
       iClassPos say where the two words start (1-based). Shared by the method-target and the class-name
       rules (DS 9247-9249), so a line is read the same way by both. */
    Function _MethodHeaderForClass String sLow Integer ByRef iForPos Integer ByRef iClassPos Returns String
        String[] asWords
        Integer[] aiPos
        Integer i iLen iStart iW iName

        Move 0 to iForPos
        Move 0 to iClassPos
        Move (Length(sLow)) to iLen
        Move 1 to i
        Move 0 to iW
        While (i <= iLen and iW < 5)
            While (i <= iLen and Mid(sLow, 1, i) = " ")
                Increment i
            Loop
            If (i <= iLen) Begin
                Move i to iStart
                While (i <= iLen and Mid(sLow, 1, i) <> " ")
                    Increment i
                Loop
                Move (Mid(sLow, (i - iStart), iStart)) to asWords[iW]
                Move iStart to aiPos[iW]
                Increment iW
            End
        Loop
        If (iW < 4) ;
            Function_Return ""
        If (asWords[0] <> "procedure" and asWords[0] <> "function") ;
            Function_Return ""
        Move 1 to iName
        If (asWords[1] = "set") ;
            Move 2 to iName
        If (iW < (iName + 3)) ;
            Function_Return ""
        If (asWords[iName + 1] <> "for") ;
            Function_Return ""
        Move aiPos[iName + 1] to iForPos
        Move aiPos[iName + 2] to iClassPos
        Function_Return asWords[iName + 2]
    End_Function

    /* The obsolete target of a 'for' method header (DS 9247 / 9248): "dfdesktop", "desktop" or "baseclass",
       or "" for any other line. Measured on DataFlex 26 (probe, 2026-10-23): a 'for Desktop' or 'for
       BaseClass' method runs directly in a cObject that does not delegate - both names are cObject in
       VdfBase.pkg - and a 'for DFDesktop' method, like one marked with the Desktop keyword, only in the
       desktop. */
    Function _ObsoleteMethodTarget String sMasked Integer ByRef iForPos Integer ByRef iClassPos Returns String
        String sLow sClass

        Move (Lowercase(Replaces(Character(9), sMasked, " "))) to sLow
        Get _MethodHeaderForClass sLow (&iForPos) (&iClassPos) to sClass
        If (sClass = "dfdesktop" or sClass = "desktop" or sClass = "baseclass") ;
            Function_Return sClass
        Function_Return ""
    End_Function

    /* THE OLD CLASS NAMES (DS 9249): the current name of an old one, or "". The table is DataFlex's own -
       the 27 '#Replace U_<old> U_<new>' lines of Pkg\VdfBase.pkg, identical on 18.1, 19.1 and 26 - and a
       probe on DataFlex 26 (2026-10-23) found each old name to be exactly its new class, so the rename
       changes nothing. NOT the docs' 8.3 list, which gives cUIObject for Desktop and BaseClass (VdfBase.pkg
       says cObject, and so did the probe) and dfBaseVertScrollBar for VertScrollBar. The new names are
       spelled the way the DataFlex 26 class reference spells them. */
    Function _ObsoleteClassNewName String sOldLow Returns String
        If (sOldLow = "message") ;
            Function_Return "cUIObject"
        If (sOldLow = "desktop") ;
            Function_Return "cObject"
        If (sOldLow = "baseclass") ;
            Function_Return "cObject"
        If (sOldLow = "dfobject") ;
            Function_Return "DfBaseObject"
        If (sOldLow = "dfwindow") ;
            Function_Return "DfBaseWindow"
        If (sOldLow = "dfuiwindow") ;
            Function_Return "DfBaseUIWindow"
        If (sOldLow = "dfcontainer") ;
            Function_Return "DfBaseContainer"
        If (sOldLow = "dfdialog") ;
            Function_Return "DfBaseDialog"
        If (sOldLow = "dfpanel") ;
            Function_Return "DfBasePanel"
        If (sOldLow = "dfdesktop") ;
            Function_Return "cDesktop"
        If (sOldLow = "dfcontrol") ;
            Function_Return "DfBaseControl"
        If (sOldLow = "dfmenu") ;
            Function_Return "DfBaseMenu"
        If (sOldLow = "dflist") ;
            Function_Return "DfBaseList"
        If (sOldLow = "dfform") ;
            Function_Return "DfBaseForm"
        If (sOldLow = "dfbutton") ;
            Function_Return "DfBaseButton"
        If (sOldLow = "dfsession") ;
            Function_Return "DfBaseSession"
        If (sOldLow = "dfserial") ;
            Function_Return "DfBaseSerial"
        If (sOldLow = "dfmapisession") ;
            Function_Return "DfBaseMapiSession"
        If (sOldLow = "dftristate") ;
            Function_Return "DfBaseTriState"
        If (sOldLow = "dfchecklist") ;
            Function_Return "DfBaseCheckList"
        If (sOldLow = "dfradiolist") ;
            Function_Return "DfBaseRadioList"
        If (sOldLow = "dftristatelist") ;
            Function_Return "DfBaseTriStateList"
        If (sOldLow = "dfpushbuttonlist") ;
            Function_Return "DfBasePushButtonList"
        If (sOldLow = "vertscrollbar") ;
            Function_Return "DfBaseScrollBar"
        If (sOldLow = "horzscrollbar") ;
            Function_Return "DfBaseHorzScrollBar"
        If (sOldLow = "systemmenu") ;
            Function_Return "DfBaseSysMenu"
        If (sOldLow = "imagelist") ;
            Function_Return "DfBaseImageList"
        Function_Return ""
    End_Function

    // The identifier on sLow that starts at iAt ("" when none starts there).
    Function _IdentifierAt String sLow Integer iAt Returns String
        Integer iEnd iLen
        Move (Length(sLow)) to iLen
        Move iAt to iEnd
        While (iEnd <= iLen and _IsIdentifierChar(Self, Mid(sLow, 1, iEnd)) = True)
            Increment iEnd
        Loop
        Function_Return (Mid(sLow, (iEnd - iAt), iAt))
    End_Function

    // Cheap first test for _ObsoleteClassNameAt: does any of the 27 old names occur in sLow at all? Built-in
    // Pos only, so the common line - one with "u_" in some identifier - costs next to nothing.
    Function _HasObsoleteClassNameText String sLow Returns Boolean
        Function_Return (Pos("message", sLow) > 0 or ;
                         Pos("desktop", sLow) > 0 or ;
                         Pos("baseclass", sLow) > 0 or ;
                         Pos("dfobject", sLow) > 0 or ;
                         Pos("dfwindow", sLow) > 0 or ;
                         Pos("dfuiwindow", sLow) > 0 or ;
                         Pos("dfcontainer", sLow) > 0 or ;
                         Pos("dfdialog", sLow) > 0 or ;
                         Pos("dfpanel", sLow) > 0 or ;
                         Pos("dfdesktop", sLow) > 0 or ;
                         Pos("dfcontrol", sLow) > 0 or ;
                         Pos("dfmenu", sLow) > 0 or ;
                         Pos("dflist", sLow) > 0 or ;
                         Pos("dfform", sLow) > 0 or ;
                         Pos("dfbutton", sLow) > 0 or ;
                         Pos("dfsession", sLow) > 0 or ;
                         Pos("dfserial", sLow) > 0 or ;
                         Pos("dfmapisession", sLow) > 0 or ;
                         Pos("dftristate", sLow) > 0 or ;
                         Pos("dfchecklist", sLow) > 0 or ;
                         Pos("dfradiolist", sLow) > 0 or ;
                         Pos("dftristatelist", sLow) > 0 or ;
                         Pos("dfpushbuttonlist", sLow) > 0 or ;
                         Pos("vertscrollbar", sLow) > 0 or ;
                         Pos("horzscrollbar", sLow) > 0 or ;
                         Pos("systemmenu", sLow) > 0 or ;
                         Pos("imagelist", sLow) > 0)
    End_Function

    /* The first OLD CLASS NAME at or after iStart in a CLASS position of a masked line - 'is a <old>' /
       'is an <old>', 'for <old>' in a method header, 'RefClass(<old>)' and 'U_<old>' - as its new name, or
       "". iPos / iLen say where the old name is (for U_<old>, the part after 'U_'). One decision for the
       scan (DS 9249) and for ChangeObsoleteClassNames.

       The 'for' targets Desktop, BaseClass and DFDesktop belong to ChangeObsoleteMethodTarget (DS 9247 /
       9248), and Desktop counts nowhere else but U_Desktop: 'is a Desktop' does not even compile on
       DataFlex 26, because DESKTOP is the desktop object's handle (error 4345, probe 2026-10-23). */
    Function _ObsoleteClassNameAt String sMasked Integer iStart Integer ByRef iPos Integer ByRef iLen Returns String
        String sLow sWord sNew sBest
        Integer iAll i j iForPos iClassPos iBest iBestLen
        Boolean bAny

        Move 0 to iPos
        Move 0 to iLen
        Move "" to sBest
        Move 0 to iBest
        Move (Lowercase(Replaces(Character(9), sMasked, " "))) to sLow
        Get _HasObsoleteClassNameText sLow to bAny
        If (bAny = False) ;
            Function_Return ""
        Move (Length(sLow)) to iAll

        // 1. The class after 'for' in a method header.
        Get _MethodHeaderForClass sLow (&iForPos) (&iClassPos) to sWord
        If (sWord <> "" and sWord <> "desktop" and sWord <> "baseclass" and sWord <> "dfdesktop" and iClassPos >= iStart) Begin
            Get _ObsoleteClassNewName sWord to sNew
            If (sNew <> "") Begin
                Move iClassPos to iBest
                Move (Length(sWord)) to iBestLen
                Move sNew to sBest
            End
        End

        // 2. 'is a <old>' / 'is an <old>'.
        Get _FindKeywordPos sLow "is" True iStart to i
        While (i > 0 and (iBest = 0 or i < iBest))
            Move (i + 2) to j
            While (j <= iAll and Mid(sLow, 1, j) = " ")
                Increment j
            Loop
            Move "" to sWord
            If (Mid(sLow, 3, j) = "an ") ;
                Move (j + 3) to j
            Else If (Mid(sLow, 2, j) = "a ") ;
                Move (j + 2) to j
            Else ;
                Move 0 to j
            If (j > 0) Begin
                While (j <= iAll and Mid(sLow, 1, j) = " ")
                    Increment j
                Loop
                Get _IdentifierAt sLow j to sWord
            End
            If (sWord <> "" and sWord <> "desktop") Begin
                Get _ObsoleteClassNewName sWord to sNew
                If (sNew <> "" and (iBest = 0 or j < iBest)) Begin
                    Move j to iBest
                    Move (Length(sWord)) to iBestLen
                    Move sNew to sBest
                End
            End
            Get _FindKeywordPos sLow "is" True (i + 2) to i
        Loop

        // 3. 'RefClass(<old>)'.
        Get _FindKeywordPos sLow "refclass" True iStart to i
        While (i > 0 and (iBest = 0 or i < iBest))
            Move (i + 8) to j
            While (j <= iAll and Mid(sLow, 1, j) = " ")
                Increment j
            Loop
            Move "" to sWord
            If (Mid(sLow, 1, j) = "(") Begin
                Increment j
                While (j <= iAll and Mid(sLow, 1, j) = " ")
                    Increment j
                Loop
                Get _IdentifierAt sLow j to sWord
            End
            If (sWord <> "" and sWord <> "desktop") Begin
                Get _ObsoleteClassNewName sWord to sNew
                If (sNew <> "" and (iBest = 0 or j < iBest)) Begin
                    Move j to iBest
                    Move (Length(sWord)) to iBestLen
                    Move sNew to sBest
                End
            End
            Get _FindKeywordPos sLow "refclass" True (i + 8) to i
        Loop

        // 4. 'U_<old>' - the class-id symbol itself, the one place Desktop counts.
        Get _FindKeywordPos sLow "u_" False iStart to i
        While (i > 0 and (iBest = 0 or i < iBest))
            Get _IdentifierAt sLow (i + 2) to sWord
            If (sWord <> "") Begin
                Get _ObsoleteClassNewName sWord to sNew
                If (sNew <> "" and (iBest = 0 or (i + 2) < iBest)) Begin
                    Move (i + 2) to iBest
                    Move (Length(sWord)) to iBestLen
                    Move sNew to sBest
                End
            End
            Get _FindKeywordPos sLow "u_" False (i + 2) to i
        Loop

        If (sBest <> "") Begin
            Move iBest to iPos
            Move iBestLen to iLen
        End
        Function_Return sBest
    End_Function

    /* Where the article of an 'is an <name>' starts (1-based) when the name at iPos follows one, or 0. sMasked
       is the masked line; tabs count as spaces and case is ignored. ChangeObsoleteClassNames uses it to write
       'is a' in front of the new name (2026-10-24). */
    Function _AnArticleBefore String sMasked Integer iPos Returns Integer
        String sLow
        Integer j iArt

        Move (Lowercase(Replaces(Character(9), sMasked, " "))) to sLow
        // Spaces, 'an', at least one space, then 'is' as a whole word.
        Move (iPos - 1) to j
        While (j > 0 and Mid(sLow, 1, j) = " ")
            Decrement j
        Loop
        If (j < 2 or j = (iPos - 1) or Mid(sLow, 2, (j - 1)) <> "an") ;
            Function_Return 0
        Move (j - 1) to iArt
        Move (iArt - 1) to j
        If (j < 1 or Mid(sLow, 1, j) <> " ") ;
            Function_Return 0
        While (j > 0 and Mid(sLow, 1, j) = " ")
            Decrement j
        Loop
        If (j < 2 or Mid(sLow, 2, (j - 1)) <> "is") ;
            Function_Return 0
        If (j > 2 and _IsIdentifierChar(Self, Mid(sLow, 1, (j - 2))) = True) ;
            Function_Return 0
        Function_Return iArt
    End_Function

    /* Field_Main_Index on a masked line (DS 9250 / 9251): 1 = a call - 'Get Field_Main_Index of hoDD iFile
       iField to iIndex', '(Field_Main_Index(hoDD, iFile, iField))' - 2 = an augmentation ('Function
       Field_Main_Index ...'), 0 = neither. A Register_Function line and a 'Forward Get' are neither: the
       first only declares the message, and the second lives inside an augmentation, where renaming it
       would forward to a different message. iPos is where the name starts. */
    Function _FieldMainIndexUse String sMasked Integer ByRef iPos Returns Integer
        String sLow sW1 sW2

        Move (Lowercase(Replaces(Character(9), sMasked, " "))) to sLow
        Get _FindKeywordPos sLow "field_main_index" True 1 to iPos
        If (iPos = 0) ;
            Function_Return 0
        Get _NthWord sLow 1 to sW1
        Get _NthWord sLow 2 to sW2
        If (sW1 = "register_function" or sW1 = "register_procedure" or sW1 = "forward") ;
            Function_Return 0
        If ((sW1 = "function" or sW1 = "procedure") and sW2 = "field_main_index") ;
            Function_Return 2
        Function_Return 1
    End_Function

    /* A read of the retired ghoWorkspace global (DS 9253 / 9254, ChangeLegacyWorkspaceAccessors): 'Get <name> of
       ghoWorkspace to <dest>' with Get in command position. 1 = <name> has a modern property, which sModern
       names; 2 = it has none (Module_Name, CurrentWorkSpaceName...), so the line is the user's to change; 0 = not
       this shape: another object, an expression, a line going on over ';', a comment. One decision for the scan
       and the fix. sName is the name as the line writes it. */
    Function _LegacyWorkspaceRead String sLine String ByRef sName String ByRef sModern Returns Integer
        String[] asWords
        Integer iLast

        Move "" to sName
        Move "" to sModern
        Get _SplitSourceWords sLine to asWords
        Move (SizeOfArray(asWords) - 1) to iLast
        If (iLast < 5) ;
            Function_Return 0
        If (Lowercase(asWords[0]) <> "get" or Lowercase(asWords[2]) <> "of") ;
            Function_Return 0
        If (Lowercase(asWords[3]) <> "ghoworkspace" or Lowercase(asWords[4]) <> "to") ;
            Function_Return 0
        If (Right(asWords[iLast], 1) = ";") ;
            Function_Return 0
        Move asWords[1] to sName
        Get _ModernWorkspacePathProperty sName to sModern
        If (sModern = "") ;
            Function_Return 2
        Function_Return 1
    End_Function

    /* The CODE of every line of a file, for a whole-file function: string literals masked to spaces and
       '//' comments cut (_CodeOnlyLine, so every position still matches the raw line), and these lines
       blank: block comments, legacy report images, #COMMAND / #DATA bodies and directive lines, #HEADER
       regions, and a DF 23 multi-line string's body and closing line - its opening line keeps the code before
       the string (2026-10-24; an @-string's too since 2026-10-29). The closing line is blank as the line pass
       hands it to no converter. Nothing in any of those is ever changed. The same masking the Deep Scan applies
       before its rules read a line, so a whole-file converter and its scan rows agree. The lines are told apart
       by the file walk (ScanSourceFile), the one every lane reads. */
    Function _CodeOnlyFileLines String[] ByRef asCode Returns String[]
        String[] asOut
        tLineInfo[] aInfo
        String sCode
        Integer i iLast

        Move (SizeOfArray(asCode) - 1) to iLast
        If (iLast < 0) ;
            Function_Return asOut
        Get ScanSourceFile (&asCode) to aInfo
        For i from 0 to iLast
            Move "" to sCode
            If (aInfo[i].eMacro = MC_None) Begin
                If (aInfo[i].eKind = LK_Code) ;
                    Get _CodeOnlyLine asCode[i] to sCode
                If (aInfo[i].eKind = LK_StringOpener) ;
                    Get _MultiLineStringOpenerCode asCode[i] to sCode
            End
            Move sCode to asOut[i]
        Loop
        Function_Return asOut
    End_Function

    /* THE LINES NO FUNCTION MAY CHANGE, besides macro code: a DF 23 multi-line string's text and every line of
       a #HEADER region, #HEADER and #ENDHEADER included - one Boolean per line, from the file walk (ScanSourceFile).
       They are the lines the line pass hands to no function (the tokenizer's pbKeepLineAsWritten); this is the
       same rule for a whole-file pass. A string's opening and closing lines are code and stay visible: a local
       used on the closing line is in use (an @-string's hold text too, and only that text is masked -
       MaskKeptText). bCloserToo flags the closing line as well, for the editor functions: whether DataFlex
       takes the text's indentation from where the closing line stands is not measured, so re-indent must not
       move it. A macro line is never flagged here - macro code is masked under its own sentinel
       (MaskMacroCode). */
    Function KeptTextFlags String[] ByRef asCode Boolean bCloserToo Returns Boolean[]
        tLineInfo[] aInfo
        Boolean[] abKeep

        Get ScanSourceFile (&asCode) to aInfo
        Get _KeptTextFlagsOf (&aInfo) bCloserToo to abKeep
        Function_Return abKeep
    End_Function

    // KeptTextFlags from a file walk the caller already has.
    Function _KeptTextFlagsOf tLineInfo[] ByRef aInfo Boolean bCloserToo Returns Boolean[]
        Boolean[] abKeep
        Integer i iLast

        Move (SizeOfArray(aInfo) - 1) to iLast
        If (iLast < 0) ;
            Function_Return abKeep
        Move (ResizeArray(abKeep, (iLast + 1))) to abKeep
        For i from 0 to iLast
            Move (aInfo[i].eMacro = MC_None and (aInfo[i].eKind = LK_StringText or aInfo[i].eKind = LK_Header or ;
                (bCloserToo = True and aInfo[i].eKind = LK_StringCloser))) to abKeep[i]
        Loop
        Function_Return abKeep
    End_Function

    /* THE TEXT ON AN @-STRING'S OPENING AND CLOSING LINES (2026-10-29). An @"... or @'... string's text starts on
       its opening line, after the quote, and ends on its closing line, before the first quote - and both lines
       hold code as well, which a whole-file function must still read (a local used on the closing line is in
       use). From the line's file-walk entry: iOpen = the quote the text follows, iClose = the quote it stands
       before, 0 for none; a line can have both ('b" + @"c'). A """ string's opening and closing lines hold no
       text. Measured the day the rule came: RefactorWinReportTocWinReport2 rewrote 'is a WinReport' in the text
       before a closing quote. */
    Procedure _AtTextQuotes tLineInfo Info Integer ByRef iOpen Integer ByRef iClose
        Move 0 to iOpen
        Move 0 to iClose
        If ((Info.eKind = LK_StringOpener or Info.eKind = LK_StringCloser) and (Info.sOpenOut = '"' or Info.sOpenOut = "'")) ;
            Move Info.iOpenAt to iOpen
        If (Info.eKind = LK_StringCloser and (Info.sOpenIn = '"' or Info.sOpenIn = "'")) ;
            Move Info.iCloseAt to iClose
    End_Procedure

    /* Swaps every KeptTextFlags line of asCode for a sentinel comment line (CS_KeptTextSentinel; see the
       macro-code guard, MaskFlaggedLines), and on an @-string's opening and closing lines only the text (_AtTextQuotes) for a
       token (CS_KeptPartSentinel + its number + "@@"): the code and the quotes stay where they are, so the line
       still opens or closes the string for every reader. UnmaskKeptText puts them back. asSaved and aiIndex hold
       the whole lines first, numbered as MaskFlaggedLines numbers them, then the text parts: aiIndex is -1 -
       the line's index, asSaved "O" + the text after the opening quote or "C" + the text before the closing one.
       Returns how many lines and parts were masked. */
    Function MaskKeptText String[] ByRef asCode Boolean bCloserToo String[] ByRef asSaved Integer[] ByRef aiIndex Returns Integer
        tLineInfo[] aInfo
        Integer iN

        Get ScanSourceFile (&asCode) to aInfo
        Get _MaskKeptTextOf (&asCode) (&aInfo) bCloserToo False (&asSaved) (&aiIndex) to iN
        Function_Return iN
    End_Function

    /* A BLOCK COMMENT'S AND A REPORT IMAGE'S TEXT (2026-10-30), kept for a whole-file function's call only
       (RunWholeFileFunction). Neither is code, and functions that read raw lines changed both as they changed
       code: the comment and image sweeps (oMultiLineString-Tests) found six that did - five rewrote a
       'Function', 'Begin_Constraints', 'Cmdline', 'is a dbEdit' or 'is a WinReport' line there, and three put
       their Use line or macro block inside a leading comment, where the code below cannot see it. One Boolean
       per line: a line wholly inside a block comment (open at its start, no closing marker on it), and an
       image's text - every image line but a page's name line ('/Body', which RemoveResidentImageOption edits)
       and the closing '/*'. A comment's opening and closing lines stay visible, so the comment still opens
       and closes for every reader; only their text is masked (_CommentTextMarks). The editor functions do not
       get this mask (eEditorFunctions masks KeptTextFlags only), so re-indent moves a comment's lines with the
       code as before. A macro line is never flagged here. The line pass keeps the same lines: the Tokenizer
       marks them pbKeepLineAsWritten. */
    Function _CommentAndImageTextFlagsOf String[] ByRef asCode tLineInfo[] ByRef aInfo Returns Boolean[]
        Boolean[] abText
        Integer i iLast

        Move (SizeOfArray(aInfo) - 1) to iLast
        If (iLast < 0) ;
            Function_Return abText
        Move (ResizeArray(abText, (iLast + 1))) to abText
        For i from 0 to iLast
            If (aInfo[i].eMacro = MC_None) Begin
                If (aInfo[i].eKind = LK_BlockComment and aInfo[i].bBlockOpenIn = True) ;
                    Move (Pos("*/", asCode[i]) = 0) to abText[i]
                Else If (aInfo[i].eKind = LK_Image) ;
                    Move (IsImageStart(Self, asCode[i]) = False and IsImageEnd(Self, asCode[i]) = False) to abText[i]
            End
        Loop
        Function_Return abText
    End_Function

    /* The text on a block comment's opening and closing lines (2026-10-30), placed as _AtTextQuotes places an
       @-string's, so _MaskKeptTextOf masks both alike: iOpen = the star of the opening marker the line leaves
       open (its text follows it), iClose = the star of the closing marker that ends the comment open at the
       line's start (its text stands before it), 0 for none - and 0 too for text that is only blanks, so a
       closing line with nothing but its indentation before the marker stays as it is for the function. */
    Procedure _CommentTextMarks String sLine tLineInfo Info Integer ByRef iOpen Integer ByRef iClose
        tLineScan Scan
        String sOpenIn

        Move 0 to iOpen
        Move 0 to iClose
        If (Info.eKind <> LK_BlockComment) ;
            Procedure_Return
        Move "" to sOpenIn
        If (Info.bBlockOpenIn = True) ;
            Move "/*" to sOpenIn
        Get ScanSourceLine sLine sOpenIn True to Scan
        If (Info.bBlockOpenIn = True and Scan.iBlockEndAt > 1) Begin
            If (Trim(Left(sLine, (Scan.iBlockEndAt - 1))) <> "") ;
                Move Scan.iBlockEndAt to iClose
        End
        // A comment left open cuts sCode just before its opening marker
        If (Scan.bBlockOpenOut = True) Begin
            If (Trim(Mid(sLine, Length(sLine), (Length(Scan.sCode) + 3))) <> "") ;
                Move (Length(Scan.sCode) + 2) to iOpen
        End
    End_Procedure

    // MaskKeptText from a file walk the caller already has (RunWholeFileFunction masks the macro code from it too).
    // bCommentsToo masks a block comment's and a report image's text as well (_CommentAndImageTextFlagsOf).
    Function _MaskKeptTextOf String[] ByRef asCode tLineInfo[] ByRef aInfo Boolean bCloserToo Boolean bCommentsToo String[] ByRef asSaved Integer[] ByRef aiIndex Returns Integer
        Boolean[] abKeep abText
        Integer iN i iLast iOpen iClose iK

        Get _KeptTextFlagsOf (&aInfo) bCloserToo to abKeep
        Move (SizeOfArray(asCode) - 1) to iLast
        If (bCommentsToo = True) Begin
            Get _CommentAndImageTextFlagsOf (&asCode) (&aInfo) to abText
            For i from 0 to iLast
                If (abText[i] = True) ;
                    Move True to abKeep[i]
            Loop
        End
        Get MaskFlaggedLines (&asCode) (&abKeep) CS_KeptTextSentinel (&asSaved) (&aiIndex) to iN
        For i from 0 to iLast
            If (abKeep[i] = False and aInfo[i].eMacro = MC_None) Begin
                If (bCommentsToo = True and aInfo[i].eKind = LK_BlockComment) ;
                    Send _CommentTextMarks asCode[i] aInfo[i] (&iOpen) (&iClose)
                Else ;
                    Send _AtTextQuotes aInfo[i] (&iOpen) (&iClose)
                // The text after an opening quote (or marker) first: it stands right of the closing one on the same line
                If (iOpen > 0 and iOpen < Length(asCode[i])) Begin
                    Move (SizeOfArray(asSaved)) to iK
                    Move ("O" + Mid(asCode[i], Length(asCode[i]), (iOpen + 1))) to asSaved[iK]
                    Move (-1 - i) to aiIndex[iK]
                    Move (Left(asCode[i], iOpen) + CS_KeptPartSentinel + String(iK) + "@@") to asCode[i]
                    Increment iN
                End
                If (iClose > 1) Begin
                    Move (SizeOfArray(asSaved)) to iK
                    Move ("C" + Left(asCode[i], (iClose - 1))) to asSaved[iK]
                    Move (-1 - i) to aiIndex[iK]
                    Move (CS_KeptPartSentinel + String(iK) + "@@" + Mid(asCode[i], Length(asCode[i]), iClose)) to asCode[i]
                    Increment iN
                End
            End
        Loop
        Function_Return iN
    End_Function

    // Puts one text part MaskKeptText masked back: its token is looked for on its own line first, then on any;
    // the text replaces everything before the token ("C") or from the token on ("O"), so the line's code keeps
    // what the function did to it. False when the token is gone.
    Function _UnmaskKeptPart String[] ByRef asCode Integer iK String sSaved Integer iLine Returns Boolean
        String sToken sText
        Integer i iSize iAt iPos

        Move (CS_KeptPartSentinel + String(iK) + "@@") to sToken
        Move (Mid(sSaved, Length(sSaved), 2)) to sText
        Move (SizeOfArray(asCode)) to iSize
        Move -1 to iAt
        If (iLine < iSize) Begin
            If (Pos(sToken, asCode[iLine]) > 0) ;
                Move iLine to iAt
        End
        Move 0 to i
        While (iAt = -1 and i < iSize)
            If (Pos(sToken, asCode[i]) > 0) ;
                Move i to iAt
            Increment i
        Loop
        If (iAt = -1) ;
            Function_Return False
        Move (Pos(sToken, asCode[iAt])) to iPos
        If (Left(sSaved, 1) = "O") ;
            Move (Left(asCode[iAt], (iPos - 1)) + sText) to asCode[iAt]
        Else ;
            Move (sText + Mid(asCode[iAt], Length(asCode[iAt]), (iPos + Length(sToken)))) to asCode[iAt]
        Function_Return True
    End_Function

    // Puts back what MaskKeptText masked - a whole line found by sentinel, a deleted one re-inserted where it was
    // (UnmaskFlaggedLines), and every text part by its token. iLost counts the lines re-inserted and the parts
    // whose token a function removed with its line. Returns how many were found.
    Function UnmaskKeptText String[] ByRef asCode String[] ByRef asSaved Integer[] ByRef aiIndex Integer ByRef iLost Returns Integer
        String[] asLines
        Integer[] aiLines
        Integer iBack iK iLast
        Boolean bFound

        Move (SizeOfArray(asSaved) - 1) to iLast
        For iK from 0 to iLast
            If (aiIndex[iK] >= 0) Begin
                Move asSaved[iK] to asLines[SizeOfArray(asLines)]
                Move aiIndex[iK] to aiLines[SizeOfArray(aiLines)]
            End
        Loop
        Get UnmaskFlaggedLines (&asCode) CS_KeptTextSentinel (&asLines) (&aiLines) (&iLost) to iBack
        For iK from 0 to iLast
            If (aiIndex[iK] < 0) Begin
                Get _UnmaskKeptPart (&asCode) iK asSaved[iK] (-1 - aiIndex[iK]) to bFound
                If (bFound = True) ;
                    Increment iBack
                Else ;
                    Increment iLost
            End
        Loop
        Function_Return iBack
    End_Function

    /* The write-time check for the text on an @-string's opening and closing lines (_AtTextQuotes), for a file
       whose line count the pass kept: a changed text part is put back, and the line's code stays as the pass
       wrote it; a line whose quote the pass took away is put back whole. aOld is asOld's file walk. Returns how
       many lines were put back. */
    Function _GuardAtStringTextOnWrite String[] ByRef asOld tLineInfo[] ByRef aOld String[] ByRef asNew Returns Integer
        tLineInfo[] aNew
        Integer i iLast iBack iOldOpen iOldClose iNewOpen iNewClose
        String sOldText sNewText sLine

        Move 0 to iBack
        If (SizeOfArray(asNew) <> SizeOfArray(asOld)) ;
            Function_Return 0
        Get ScanSourceFile (&asNew) to aNew
        Move (SizeOfArray(asOld) - 1) to iLast
        For i from 0 to iLast
            Send _AtTextQuotes aOld[i] (&iOldOpen) (&iOldClose)
            If (iOldOpen > 0 or iOldClose > 0) Begin
                Send _AtTextQuotes aNew[i] (&iNewOpen) (&iNewClose)
                Move asNew[i] to sLine
                If ((iOldOpen > 0 and iNewOpen = 0) or (iOldClose > 0 and iNewClose = 0)) Begin
                    Move asOld[i] to sLine
                End
                Else Begin
                    If (iOldOpen > 0) Begin
                        Move (Mid(asOld[i], Length(asOld[i]), (iOldOpen + 1))) to sOldText
                        Move (Mid(sLine, Length(sLine), (iNewOpen + 1))) to sNewText
                        If (sOldText <> sNewText or Length(sOldText) <> Length(sNewText)) ;
                            Move (Left(sLine, iNewOpen) + sOldText) to sLine
                    End
                    If (iOldClose > 0) Begin
                        Move (Left(asOld[i], (iOldClose - 1))) to sOldText
                        Move (Left(sLine, (iNewClose - 1))) to sNewText
                        If (sOldText <> sNewText or Length(sOldText) <> Length(sNewText)) ;
                            Move (sOldText + Mid(sLine, Length(sLine), iNewClose)) to sLine
                    End
                End
                If (sLine <> asNew[i] or Length(sLine) <> Length(asNew[i])) Begin
                    Move sLine to asNew[i]
                    Increment iBack
                End
            End
        Loop
        Function_Return iBack
    End_Function

    /* THE ENGINE'S MASK, FOR ANY PASS OVER A WHOLE FILE (2026-10-30): a DF 23 multi-line string's text, every
       #HEADER line, a block comment's and a report image's text (_CommentAndImageTextFlagsOf) and the macro code
       are swapped for sentinel comment lines - on an @-string's or a comment's opening and closing lines only the
       text (MaskKeptText) - and Mask keeps what UnmaskAfterTransform puts back. One file walk (ScanSourceFile)
       serves both masks, as masking the text leaves the macro lines as they were. RunWholeFileFunction masks every
       eOtherFunction with it, and the converters that read and write files themselves mask their own transform
       with it - the grid and list converters (cGridToCJGridBase's TransformSource), the menu converter
       (_CJConvertMenuInFile), RestyleDDOs and the grid subclass porter: a sweep (oMultiLineString-Tests) found the
       four grid and list converters converting a commented-out grid, and the menu converter converting a
       commented-out menu instead of the real one. Returns how many macro lines were masked. */
    Function MaskForTransform String[] ByRef asCode tWholeFileMask ByRef Mask Returns Integer
        String[] asText asMacro
        Integer[] aiText aiMacro
        tLineInfo[] aInfo
        Boolean[] abMacro

        Get ScanSourceFile (&asCode) to aInfo
        Get _MaskKeptTextOf (&asCode) (&aInfo) False True (&asText) (&aiText) to Mask.iText
        Get MacroCodeFlagsOf (&aInfo) to abMacro
        Get MaskFlaggedLines (&asCode) (&abMacro) CS_MacroSentinel (&asMacro) (&aiMacro) to Mask.iMacro
        Move asText  to Mask.asText
        Move aiText  to Mask.aiText
        Move asMacro to Mask.asMacro
        Move aiMacro to Mask.aiMacro
        Function_Return Mask.iMacro
    End_Function

    // Puts back what MaskForTransform masked: the macro lines, then the text (UnmaskMacroCode, UnmaskKeptText). A
    // masked line the pass deleted is re-inserted where it was; returns how many were.
    Function UnmaskAfterTransform String[] ByRef asCode tWholeFileMask ByRef Mask Returns Integer
        String[] asText asMacro
        Integer[] aiText aiMacro
        Integer iLost iLostText iBack

        Move 0 to iLost
        Move 0 to iLostText
        If (Mask.iMacro > 0) Begin
            Move Mask.asMacro to asMacro
            Move Mask.aiMacro to aiMacro
            Get UnmaskMacroCode (&asCode) (&asMacro) (&aiMacro) (&iLost) to iBack
        End
        If (Mask.iText > 0) Begin
            Move Mask.asText to asText
            Move Mask.aiText to aiText
            Get UnmaskKeptText (&asCode) (&asText) (&aiText) (&iLostText) to iBack
        End
        Function_Return (iLost + iLostText)
    End_Function

    /* ONE WHOLE-FILE FUNCTION'S CALL, as the engine makes it for every eOtherFunction (cRefactorEngine's
       eOtherFunctions): the function runs between MaskForTransform and UnmaskAfterTransform, so no function,
       however it reads the file, can change a string's, a comment's or an image's text, a #HEADER line or macro
       code. Here and not in the engine so the tests make the same call. iMacro = macro lines masked (the run
       summary counts them), iLost = masked lines the function deleted and that were put back where they were.
       Returns what the function returns. */
    Function RunWholeFileFunction Integer iFunctionID String[] ByRef asCode String sParameter Integer ByRef iMacro Integer ByRef iLost Returns Integer
        tWholeFileMask Mask
        String[] asNone
        Integer iRetval

        Get MaskForTransform (&asCode) (&Mask) to iMacro
        Set pasMaskedMacroLines to Mask.asMacro
        Get iFunctionID of Self (&asCode) sParameter to iRetval
        Set pasMaskedMacroLines to asNone
        Get UnmaskAfterTransform (&asCode) (&Mask) to iLost
        Function_Return iRetval
    End_Function

    /* THE SOURCE-FOLDER SEARCH - here since 2026-10-30, from cRefactorApplication, which keeps doors of the same
       names (RecursiveSearchFolders is the door to RecursiveFolderSearch): the test runner runs without
       cRefactorApplication, so only here can it be tested (oSourceFolderSearch-Tests).
       NoFolderListAsArray: the folder names a search never goes into (CS_NoFolderList), and the backup folder's
       name too unless bNoBackupFolder - the backup search's list. */
    Function NoFolderListAsArray Boolean bNoBackupFolder Returns String[]
        String sNoFolderList
        String[] saNoFolderList

        Move CS_NoFolderList to sNoFolderList
        If (bNoBackupFolder = False) Begin
            Move (sNoFolderList + CS_D + CS_BackupFolder) to sNoFolderList
        End
        Move (Lowercase(sNoFolderList)) to sNoFolderList
        Move (StrSplitToArray(sNoFolderList, CS_D)) to saNoFolderList
        Function_Return saNoFolderList
    End_Function

    // True when a part of sFolderName (split at the separator) is a name in saNoFolderList; "." in the list also
    // names the folders "." and "..".
    Function IsFolderInNoFolderList String[] saNoFolderList String sFolderName Returns Boolean
        Integer iSize iCount iIndex iCurrentFolder
        Boolean bOK bFound
        String sNoFolder sFolderNameShort
        String[] asFolderList

        Move False to bOK
        Move (SearchArray(".",  saNoFolderList)) to iCurrentFolder
        Move (iCurrentFolder <> -1) to bFound
        If (bFound = True) Begin
            // We need to remove "." from the array to avoid problems with folders containing a "."
            Move (RemoveFromArray(saNoFolderList, iCurrentFolder)) to saNoFolderList
            // The rightmost folder name:
            Get ParseFileName sFolderName to sFolderNameShort
            Move (sFolderNameShort = ".." or sFolderNameShort = ".") to bOK // Then we're done
        End

        If (bOK = False) Begin
            Move (Lowercase(sFolderName)) to sFolderName
            Move (StrSplitToArray(sFolderName, CS_DirSeparator)) to asFolderList
            Move (SizeOfArray(saNoFolderList)) to iSize
            Decrement iSize
            For iCount from 0 to iSize
                Move (Lowercase(saNoFolderList[iCount])) to sNoFolder
                Move (SearchArray(sNoFolder, asFolderList)) to iIndex
                If (iIndex <> -1) Begin
                    Move True to bOK
                End
                If (bOK = True) ;
                    Break
            Loop
        End

        Function_Return bOK
    End_Function

    /* THE BASE A SEARCH MEASURES THE NEVER-SCAN NAMES FROM (2026-10-30, _FolderPartToTest): the workspace home
       sHome - or, for a search that starts in the backup folder, the home's mirror there, as a backup mirrors its
       file's full path below the backup folder (CreateBackupFolder). "" without a home. A source search starts
       at the home, a library folder or a selected folder, so its base is the home, and the backup folder's own
       name, on its list, keeps the backups out of it. PURE. */
    Function _NoScanBase String sStart String sHome Returns String
        String sBackup

        If (Trim(sHome) = "") ;
            Function_Return ""
        Move (vFolderFormat(sHome)) to sHome
        Move (sHome + CS_BackupFolder + CS_DirSeparator) to sBackup
        If (Left(Lowercase(vFolderFormat(sStart)), Length(sBackup)) = Lowercase(sBackup)) ;
            Function_Return (sBackup + Replace(":", sHome, ""))
        Function_Return sHome
    End_Function

    /* THE PART OF A FOLDER'S PATH THE NEVER-SCAN NAMES ARE TESTED ON (IsFolderInNoFolderList, 2026-10-30): what
       lies below sBase (_NoScanBase), or the whole path for a folder outside it - a library kept elsewhere, tested
       as before. The folders above the home are where the user keeps the workspace, not part of it: until then
       the whole path was tested, so a workspace kept in D:\Data\Projects\MyApp listed no folder in Select
       Folders, and a run took none of a selected folder's subfolders - every path held 'data' (seen 2026-10-05
       with a copy in E:\LegacyApp5\Programs). A library in the home's DfPkg folder still has 'dfpkg' in its part,
       so it stays out as before. PURE. */
    Function _FolderPartToTest String sFolder String sBase Returns String
        If (Trim(sBase) = "") ;
            Function_Return sFolder
        Move (vFolderFormat(sBase)) to sBase
        If (Left((Lowercase(sFolder) + CS_DirSeparator), Length(sBase)) = Lowercase(sBase)) ;
            Function_Return (Mid(sFolder, Length(sFolder), (Length(sBase) + 1)))
        Function_Return sFolder
    End_Function

    /* Every folder below sFolderName - relative to the workspace home sHome when it names no drive - itself
       included, sorted, but those a name in asNoFolderList excludes, tested on the part of each path below the
       home only (_NoScanBase, _FolderPartToTest): the rule cFolderSelHeaDataDictionary's RemoveSystemFolders has
       applied to the stored rows since 2026-08-18, now the search's too. */
    Function RecursiveFolderSearch String sFolderName String sHome String[] asNoFolderList Returns String[]
        Boolean bFound
        Integer iCount iSize iItem
        String sMask sPrevFolderName sHomePath sBase sTestPart
        tRFSearchResult[] asSearchResult
        String[] saSearchFolders

        If (not(sFolderName contains ":")) Begin
            Move (vFolderFormat(sHome)) to sHomePath
            Move (sHomePath + sFolderName) to sFolderName
        End
        Move (vFolderFormat(sFolderName)) to sFolderName
        Move (sFolderName + "*") to sMask

        Move 0 to iItem

        // Recursive folder search
        Move (rfFileSearchRecursive(sMask, DIRMODE_DIRECTORIES_ONLY, False)) to asSearchResult
        Move (SizeOfArray(asSearchResult)) to iSize
        Decrement iSize

        // Remove folder names from array where we should not search for source files - tested on the part of each
        // path below the workspace home only (_FolderPartToTest)
        Get _NoScanBase sFolderName sHome to sBase
        Move "" to sPrevFolderName
        For iCount from 0 to iSize
            Get _FolderPartToTest asSearchResult[iCount].sFilename sBase to sTestPart
            Get IsFolderInNoFolderList asNoFolderList sTestPart to bFound
            If (bFound = False) Begin
                If (asSearchResult[iCount].sFilename <> sPrevFolderName) Begin
                    Move asSearchResult[iCount].sFilename to saSearchFolders[iItem]
                    Increment iItem
                End
            End
            Move asSearchResult[iCount].sFilename to sPrevFolderName
        Loop

        Move sFolderName to saSearchFolders[SizeOfArray(saSearchFolders)]
        // Sort the folder array to get the top one first.
        Move (SortArray(saSearchFolders)) to saSearchFolders

        Function_Return saSearchFolders
    End_Function

    /* WHERE A WORKSPACE COPY WOULD LAND (2026-10-31) - the two tests SelectCopyScopeFT's DoConfirm asks about
       before it copies; here, where they are unit-tested (oCopyDestination-Tests). On 2026-10-05 a copy went into
       a new folder E:\LegacyApp5\Programs - inside the folder of an older copy, one level too deep - and every test
       the dialog had passed it: a full path, no drive root, outside the source, empty.
       WorkspaceFileAbove: the workspace file (*.sws) in the nearest folder ABOVE sFolder that holds one, as a full
       path - "" when no folder does, up to the drive root. sFolder itself is not looked in, and need not exist. */
    Function WorkspaceFileAbove String sFolder Returns String
        tRFSearchResult[] aFound
        Integer iPos

        Move (Trim(sFolder)) to sFolder
        If (Right(sFolder, 1) = CS_DirSeparator) ;
            Move (Left(sFolder, Length(sFolder) - 1)) to sFolder
        // A drive ("E:") is looked in; the "\\server" of a share path is no folder.
        Move (RightPos(CS_DirSeparator, sFolder)) to iPos
        While (iPos > 2)
            Move (Left(sFolder, iPos - 1)) to sFolder
            If (Left(sFolder, 2) = "\\" and Pos(CS_DirSeparator, Mid(sFolder, Length(sFolder), 3)) = 0) ;
                Break
            Move (rfFileSearch((sFolder + CS_DirSeparator + "*.sws"), DIRMODE_FILES_ONLY, True)) to aFound
            If (SizeOfArray(aFound) > 0) ;
                Function_Return (sFolder + CS_DirSeparator + aFound[0].sFilename)
            Move (RightPos(CS_DirSeparator, sFolder)) to iPos
        Loop
        Function_Return ""
    End_Function

    // True when sFolder's own name - not the folders above it - is one a source search never goes into
    // (NoFolderListAsArray: Data, Programs, Bitmaps ..., the names of a workspace's own folders).
    Function IsWorkspaceFolderName String sFolder Returns Boolean
        String[] asList
        String sName
        Integer iPos

        Move (Trim(sFolder)) to sFolder
        If (Right(sFolder, 1) = CS_DirSeparator) ;
            Move (Left(sFolder, Length(sFolder) - 1)) to sFolder
        Move (RightPos(CS_DirSeparator, sFolder)) to iPos
        Move (Lowercase(Right(sFolder, (Length(sFolder) - iPos)))) to sName
        If (sName = "") ;
            Function_Return False
        Get NoFolderListAsArray False to asList
        Function_Return (SearchArray(sName, asList) <> -1)
    End_Function

    // ---- Global-function-name catalogue cache (Data\DfVersion-GlobalFuncs-<ver>.json) - mirrors the
    // TypeDefs cache exactly (path / write / read / stale), the third product of the shared walk. ----

    // Full path to the per-version cache. phoWorkspace(ghoApplication) resolves the app's data path.
    // The path for ANY version, not only the one targeted - the TestBench catalogue writer
    // builds these for an install the user picks, which need not be this session's.
    Function GlobalFuncNamesCacheJsonPathFor String sVer Returns String
        String sData sFile
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move CS_GlobalFuncNamesCacheJson to sFile
        If (Trim(sVer) <> "") ;
            Move (Replace(".json", sFile, ("-" + sVer + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    /* THE RELEASE IN WHICH DATAFLEX FIRST SHIPPED A GLOBAL FUNCTION NAME - the version whose
       catalogue (Data\DfVersion-GlobalFuncs-<ver>.json) is the OLDEST to contain it, or "" when
       no catalogue on this machine does. Read from the per-version files that already exist
       (one per DataFlex install the user has pointed the tool at); no walk, no cache write.

       WHY (Nils 2026-08-16): GuardRedundantGlobalFunctions wrapped OEMToUTF8 in #IF (!@ <= 260)
       because the TARGET WORKSPACE's .sws said 26.0 - it had been converted to DF26 JSON before
       the guard ran - and 260 <= 260 is TRUE on a DF26 compile, so the guarded copy was still
       compiled and still collided: two "Guard them" rows came straight back on the next Check.
       The workspace's own version was only ever a stand-in for the real boundary, correct by
       coincidence on a still-19.1 workspace and wrong the moment the workspace was converted
       first. The real boundary is per FUNCTION - the release the native appeared in - and
       OEMToUTF8 is in the 20.1 catalogue, so the right guard is #IF (!@ < 201): keep the copy
       on every release BEFORE the one that ships it. */
    Function FirstNativeVersionFor String sName Returns String
        String[] asVersions asNames
        String sVer sFile
        Integer i iMax
        Boolean bOk

        // Oldest first: the first catalogue that has the name is the answer.
        Move "18.1" to asVersions[0]
        Move "19.1" to asVersions[1]
        Move "20.1" to asVersions[2]
        Move "23.0" to asVersions[3]
        Move "24.0" to asVersions[4]
        Move "25.0" to asVersions[5]
        Move "26.0" to asVersions[6]
        Move (SizeOfArray(asVersions) - 1) to iMax
        For i from 0 to iMax
            Get GlobalFuncNamesCacheJsonPathFor asVersions[i] to sFile
            Get _ReadGlobalFuncNamesFile sFile (&asNames) to bOk
            If (bOk = True) Begin
                If (SearchArray(sName, asNames, Desktop, RefFunc(DFSTRICMP)) <> -1) ;
                    Function_Return asVersions[i]
            End
        Loop
        Function_Return ""
    End_Function

    // ReadGlobalFuncNamesCache for an ARBITRARY version file: same parse, no staleness test (the
    // question is "did release X ship this name", which an older-than-newest Pkg walk still answers).
    Function _ReadGlobalFuncNamesFile String sFile String[] ByRef asNames Returns Boolean
        Handle hoJson
        tGlobalFuncNamesCacheFile CacheFile

        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to CacheFile
        Send Destroy of hoJson
        Move CacheFile.asNames to asNames
        Function_Return True
    End_Function

    Function GlobalFuncNamesCacheJsonPath Returns String
        String sVer
        Get psTargetDfVersion of ghoApplication to sVer
        Function_Return (GlobalFuncNamesCacheJsonPathFor(Self, sVer))
    End_Function

    // Write the native Global-name set + format version + install watermark (NO BOM). Mirrors
    // WriteTypeDefsCache.
    // Write to an EXPLICIT path, so one serializer serves both the runtime cache and a
    // catalogue generated for a hand-picked version.
    Procedure WriteGlobalFuncNamesCacheTo String[] asNames String sPkgNewest String sFile
        Handle hoJson
        tGlobalFuncNamesCacheFile CacheFile
        UChar[] ucJson
        Integer iCh

        Move CI_GlobalFuncNamesCacheVersion to CacheFile.iVersion
        Move sPkgNewest to CacheFile.sPkgNewest
        Move asNames    to CacheFile.asNames
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson CacheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // The runtime cache: this session's target, at its own path.
    Procedure WriteGlobalFuncNamesCache String[] asNames String sPkgNewest
        Send WriteGlobalFuncNamesCacheTo asNames sPkgNewest (GlobalFuncNamesCacheJsonPath(Self))
    End_Procedure

    // Load the cached catalogue. False (asNames untouched) if absent / unparseable / stale format
    // version / a package newer than the watermark. Mirrors ReadTypeDefsCache (incl. the vFilePathExists
    // guard - rfOpenInput raises Error 33 on a missing file, not a < 0 return).
    Function ReadGlobalFuncNamesCache String[] ByRef asNames Returns Boolean
        Handle hoJson
        Boolean bStale
        tGlobalFuncNamesCacheFile CacheFile
        String sFile

        // Resolve the cache path FIRST - d1de57d (2026-08-01) dropped this line while splitting the
        // writers into ...To variants, so sFile probed EMPTY, every read said 'no cache', and the
        // full install-Pkg walk re-ran on every call - including on the compile poll tick, where it
        // silently starved every cTimer for the length of the compile (Nils 2026-08-10, measured).
        Get GlobalFuncNamesCacheJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to CacheFile
        Send Destroy of hoJson
        If (CacheFile.iVersion <> CI_GlobalFuncNamesCacheVersion) ;
            Function_Return False
        Get _PkgScanIsStale CacheFile.sPkgNewest to bStale
        If (bStale = True) ;
            Function_Return False
        Move CacheFile.asNames to asNames
        Function_Return True
    End_Function

    // True when the Global-name cache is missing / unparseable / a stale version / has a package newer
    // than its watermark. Mirrors _TypeDefsCacheStale.
    Function _GlobalFuncNamesCacheStale Returns Boolean
        String[] asNames
        Boolean bOK
        Get ReadGlobalFuncNamesCache (&asNames) to bOK
        Function_Return (not(bOK))
    End_Function

    // The install's native Global-function-name set via the shared cache: ensures it is fresh (walking
    // iff stale, piggybacking the other caches if they too are stale) and returns it. Mirrors
    // InstallScanRecipes. Empty array if the install can't be located.
    Function InstallGlobalFuncNames Returns String[]
        String[] asNames
        Boolean bOK
        Send EnsureInstallCaches False False True False
        Get ReadGlobalFuncNamesCache (&asNames) to bOK
        Function_Return asNames
    End_Function

    // The same catalogue, but loaded ONCE PER RUN - what a PER-FILE caller must use. InstallGlobalFuncNames
    // above probes its cache file for staleness AND parses the JSON on every single call; a whole-file
    // converter runs once per file, so on a 2000-file workspace that was thousands of probes+parses. The
    // symptom was a run that looked hung between files, with the progress caption frozen on the previous
    // file's last line nudge (Nils 2026-07-21). The memo lives in cBaseFuncLib so _InitializeFuncLib can
    // clear it, and that fires before every engine run - so a target-version switch is always picked up.
    Function RunNativeGlobalFuncNames Returns String[]
        String[] asNames
        Boolean bLoaded
        Get pbRunNativeGlobalsLoaded to bLoaded
        If (bLoaded = True) Begin
            Get pasRunNativeGlobals to asNames
            Function_Return asNames
        End
        Get InstallGlobalFuncNames to asNames
        Set pasRunNativeGlobals      to asNames
        Set pbRunNativeGlobalsLoaded to True
        Function_Return asNames
    End_Function

    // Every DataFlex-OWNED declaration of the given (lowercased) names, read live from the TARGET
    // install's Pkg folder. This is what makes the report's advice correct instead of merely
    // plausible. DataFlex declares Value as "Function Value Integer iItem Returns String" in nine of
    // its own packages, so a workspace whose three library classes declare it Variant/Variant/Number
    // does NOT get a clean build by aligning those three with each other - they would still fight the
    // shipped String. You cannot change DataFlex's side; the only fix that works is to rename yours
    // (Nils 2026-07-22). Without this pass the report happily recommended the change that does not work.
    //
    // Deliberately NOT cached, unlike the three catalogues the shared walk maintains: this asks about a
    // handful of names, only when the user opens the report, and a full install-declaration catalogue
    // would be a large cache to keep fresh for a rare question. The per-file pre-gate (_LinesDeclareAny)
    // skips every package that could not contribute a declaration, which is very nearly all of them.
    Function InstallNameDeclsForNames String[] asNamesLc Boolean bShowProgress Returns tNameDecl[]
        tNameDecl[] aOut aFileDecls
        tRFSearchResult[] aFiles
        String[] asCode
        String sPkg sMask
        Integer i iLast j jLast iCurMax
        Boolean bPanel bCancel bMention

        If (SizeOfArray(asNamesLc) = 0) ;
            Function_Return aOut
        Get psTargetPkgFolder of ghoApplication to sPkg
        Set psInstallScanPath to sPkg
        // SAY SO when the catalogue cannot be read. Returning an empty array is indistinguishable from
        // "DataFlex declares none of these", and the caller draws the opposite conclusion from it.
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) Begin
            Set pbInstallScanFailed to True
            Function_Return aOut
        End
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        Move (bShowProgress and (ghoStatusPanel <> 0) and (Active_State(ghoStatusPanel) = True)) to bPanel
        If (bPanel = True) Begin
            // Budget these packages into the running total so the bar keeps moving through the scan.
            Get piMaximumTot of ghoStatusPanel to iCurMax
            Set piMaximumTot of ghoStatusPanel to (iCurMax + iLast + 1)
        End
        For i from 0 to iLast
            If (bPanel = True) Begin
                Set Caption_Text   of ghoStatusPanel to ("DataFlex package No:" * String(i + 1) * "of:" * String(iLast + 1))
                Set TableName_Text of ghoStatusPanel to (aFiles[i].sFilename)
                Send DoAdvanceTot of ghoStatusPanel
            End
            Move (rfReadEncodedFileAsStringArray(aFiles[i].sFilename)) to asCode
            Get _LinesDeclareAny asCode asNamesLc to bMention
            If (bMention = True) Begin
                Get _NameDeclsFromLines asCode (aFiles[i].sFilename) to aFileDecls
                Move (SizeOfArray(aFileDecls) - 1) to jLast
                For j from 0 to jLast
                    If (SearchArray(Lowercase(Trim(aFileDecls[j].sName)), asNamesLc, Desktop, RefFunc(DFSTRICMP)) <> -1) ;
                        Move aFileDecls[j] to aOut[SizeOfArray(aOut)]
                Loop
            End
            // Mid-run cancel: poll the safe accessor (NEVER Cancel_Check - it consumes the signal).
            Get pbUserCancelRequested of ghoEngine to bCancel
            If (bCancel = True) ;
                Move iLast to i
        Loop
        Function_Return aOut
    End_Function

    // ============================================================================================
    // Shared install-package walk - ONE pass over the TARGET install's Pkg folder that feeds THREE
    // caches: the ModAnalyzer obsolete-warning scan (DfVersion-ObsoleteScan-<ver>.json, consumed by cModAnalyzer),
    // the TypeToStructReport Type catalogue (DfVersion-TypeDefs-<ver>.json), and the guided findings list's native
    // Global-function-name set (DfVersion-GlobalFuncs-<ver>.json). The scans used to walk the same hundreds of
    // packages independently; this reads each *.pkg ONCE and runs the requested pure extractors, so when
    // several caches are cold (e.g. just after a target-version switch) a single walk refreshes them all.
    // Each cache keeps its own FORMAT version, so a bump to one (e.g. a recipe edit) does NOT force the
    // others to re-walk.
    // ============================================================================================

    // Parse ONE DataFlex system-package file's lines for obsolete-command / -type-command / -package
    // warning DEFINITIONS, returning Explain recipes. The packages DEFINE these as:
    //   #COMMAND <Name> ... WarningEx GENERAL DFERR_COMP_WARNING_OBSOLETE_<suffix> "<message>" ...
    // so the quoted <message> IS the authoritative warning text (and carries the replacement).
    // match-text + hint both = the message (a guaranteed substring of the .prn warning); function-
    // backed recipes (added BEFORE these in BuildDefaultRecipes) win on first-match, so a gap command
    // shows as Explain while a covered one still auto-fixes. Only CMD/TYPE_CMD/PACKAGE suffixes are
    // mapped. PURE (no file I/O) -> unit-testable. RELOCATED here from cModAnalyzer so the shared walk
    // can run it next to _TypeDefsFromLines in one pass; cModAnalyzer reaches it via ghoFuncLib. The
    // Explain row is built inline (the old AddRecipe / CategoryText stay on cModAnalyzer).
    Function _ObsoleteRecipesFromLines String[] asLines Returns tModAnalyzer[]
        tModAnalyzer[] aOut
        Integer i iSize iNum iP1 iP2 k
        String sLine sUp sSuffix sMsg sRest

        Move (SizeOfArray(asLines) - 1) to iSize
        For i from 0 to iSize
            Move asLines[i] to sLine
            Move (Uppercase(sLine)) to sUp
            If ((sUp contains "WARNINGEX") and (sUp contains "DFERR_") and (sUp contains "OBSOLETE_")) Begin
                // Suffix after the constant's "OBSOLETE_" (e.g. CMD, TYPE_CMD, PACKAGE).
                Move (Pos("OBSOLETE_", sUp)) to iP1
                Move (Mid(sUp, 30, (iP1 + 9))) to sSuffix
                Move (Pos(" ", sSuffix)) to iP2
                If (iP2 > 0) ;
                    Move (Left(sSuffix, (iP2 - 1))) to sSuffix
                Move 0 to iNum
                Case Begin
                    Case (sSuffix = "CMD")
                        Move 4533 to iNum
                        Case Break
                    Case (sSuffix = "TYPE_CMD")
                        Move 4532 to iNum
                        Case Break
                    Case (sSuffix = "PACKAGE")
                        Move 4536 to iNum
                        Case Break
                    Case Else
                        Move 0 to iNum
                Case End
                // Message = the text inside the first pair of double quotes on the line.
                Move "" to sMsg
                Move (Pos('"', sLine)) to iP1
                If (iP1 > 0) Begin
                    Move (Mid(sLine, Length(sLine), (iP1 + 1))) to sRest
                    Move (Pos('"', sRest)) to iP2
                    If (iP2 > 0) ;
                        Move (Left(sRest, (iP2 - 1))) to sMsg
                End
                Move (Trim(sMsg)) to sMsg
                If ((iNum > 0) and (sMsg <> "")) Begin
                    // Inline Explain recipe (was: Get AddRecipe aOut iNum True sMsg "" eModExplain sMsg).
                    // sCategoryText for eModExplain is "Explain" (cModAnalyzer.CategoryText).
                    Move (SizeOfArray(aOut)) to k
                    Move iNum        to aOut[k].iMsgNumber
                    Move True        to aOut[k].bIsWarning
                    Move sMsg        to aOut[k].sMatchText
                    Move eModExplain to aOut[k].eCategory
                    Move "Explain"   to aOut[k].sCategoryText
                    Move sMsg        to aOut[k].sHint
                    Move ""          to aOut[k].sRefactorFn
                End
            End
        Loop
        Function_Return aOut
    End_Function

    // Full path to the per-version raw obsolete-warning scan cache: Data\DfVersion-ObsoleteScan-<ver>.json.
    // Mirrors TypeDefsCacheJsonPath / cModAnalyzer.RecipeJsonPath. phoWorkspace(ghoApplication) (NOT
    // Self) resolves the app's workspace data path.
    // The path for ANY version, not only the one targeted - the TestBench catalogue writer
    // builds these for an install the user picks, which need not be this session's.
    Function ObsoleteScanCacheJsonPathFor String sVer Returns String
        String sData sFile
        Get psDataPath of (phoWorkspace(ghoApplication)) to sData
        Move CS_ObsoleteScanJson to sFile
        If (Trim(sVer) <> "") ;
            Move (Replace(".json", sFile, ("-" + sVer + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    Function ObsoleteScanCacheJsonPath Returns String
        String sVer
        Get psTargetDfVersion of ghoApplication to sVer
        Function_Return (ObsoleteScanCacheJsonPathFor(Self, sVer))
    End_Function

    // Write the raw obsolete-warning scan + cache-format version + install change watermark
    // (sPkgNewest) to the JSON (pretty, NO BOM - a BOM breaks ParseUtf8). Reuses the tModRecipeFile
    // wrapper. Mirrors WriteTypeDefsCache.
    // Write to an EXPLICIT path, so one serializer serves both the runtime cache and a
    // catalogue generated for a hand-picked version.
    Procedure WriteObsoleteScanCacheTo tModAnalyzer[] aRecipes String sPkgNewest String sFile
        Handle hoJson
        tModRecipeFile ScanFile
        UChar[] ucJson
        Integer iCh

        Move CI_ObsoleteScanVersion to ScanFile.iVersion
        Move sPkgNewest to ScanFile.sPkgNewest
        Move aRecipes to ScanFile.aRecipes
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson ScanFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // The runtime cache: this session's target, at its own path.
    Procedure WriteObsoleteScanCache tModAnalyzer[] aRecipes String sPkgNewest
        Send WriteObsoleteScanCacheTo aRecipes sPkgNewest (ObsoleteScanCacheJsonPath(Self))
    End_Procedure

    // Load the cached raw scan. Returns False (aRecipes untouched) if the file is absent, won't parse,
    // carries a stale cache-format version (CI_ObsoleteScanVersion), OR a system package is newer than
    // the cache's watermark (an in-place install update - see _PkgScanIsStale). Mirrors ReadTypeDefsCache.
    Function ReadObsoleteScanCache tModAnalyzer[] ByRef aRecipes Returns Boolean
        Handle hoJson
        Boolean bStale
        tModRecipeFile ScanFile
        String sFile

        // Resolve the cache path FIRST - d1de57d (2026-08-01) dropped this line while splitting the
        // writers into ...To variants, so sFile probed EMPTY, every read said 'no cache', and the
        // full install-Pkg walk re-ran on every call - including on the compile poll tick, where it
        // silently starved every cTimer for the length of the compile (Nils 2026-08-10, measured).
        Get ObsoleteScanCacheJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return False
        Get JsonToDataType of hoJson to ScanFile
        Send Destroy of hoJson
        If (ScanFile.iVersion <> CI_ObsoleteScanVersion) ;
            Function_Return False
        // Same-version install change? A package newer than the stored watermark means the system
        // packages were revised under the same version folder - treat as stale so the caller re-walks.
        Get _PkgScanIsStale ScanFile.sPkgNewest to bStale
        If (bStale = True) ;
            Function_Return False
        Move ScanFile.aRecipes to aRecipes
        Function_Return True
    End_Function

    // True when the raw obsolete-warning scan cache is missing / unparseable / a stale format version
    // / has a package newer than its watermark (i.e. the install packages must be (re)walked for
    // recipes). ReadObsoleteScanCache enforces the version + watermark check.
    Function _ObsoleteScanCacheStale Returns Boolean
        tModAnalyzer[] aScan
        Boolean bOK
        Get ReadObsoleteScanCache (&aScan) to bOK
        Function_Return (not(bOK))
    End_Function

    // True when the Type-def catalogue cache is missing / unparseable / a stale format version / has
    // a package newer than its watermark. ReadTypeDefsCache enforces the version + watermark check.
    Function _TypeDefsCacheStale Returns Boolean
        tTypeDef[] aDefs
        Boolean bOK
        Get ReadTypeDefsCache (&aDefs) to bOK
        Function_Return (not(bOK))
    End_Function

    // The ONE shared walk: enumerate the TARGET install's *.pkg ONCE and run whichever extractors are
    // requested, then write the corresponding cache(s). bShowProgress drives the per-package total bar
    // via ghoStatusPanel (the TypeToStructReport path passes True; the silent recipe path passes
    // False, preserving its old behaviour). Best-effort: a blank / missing Pkg folder writes nothing
    // (callers fall back to an empty scan / re-walk next time the install appears).
    /* The walk, over an EXPLICIT install and writing catalogues named for an EXPLICIT version.

       Split out so the same pass serves two callers that differ only in which install they mean: the
       product, which always means the target it resolved from the selected compiler, and the
       TestBench catalogue writer, which means whichever version the user pointed at. Everything a
       version's catalogues describe comes from its own Pkg folder, so the folder and the name on the
       file are the only two things that vary. */
    Procedure WalkInstallPackagesFor String sPkg String sVer Boolean bDoRecipes Boolean bDoTypeDefs Boolean bDoGlobalFuncs Boolean bShowProgress
        tModAnalyzer[] aRecipes aFileRecs
        tTypeDef[] aDefs aFileDefs
        tRFSearchResult[] aFiles
        String[] asCode asGlobalNames asFileNames
        String sMask sNewestStamp
        Integer i iLast j jLast iCurMax
        Boolean bPanel
        DateTime dtNewest

        If (bDoRecipes = False and bDoTypeDefs = False and bDoGlobalFuncs = False) ;
            Procedure_Return
        If (sPkg = "" or rfDirectoryExists(sPkg) = False) ;
            Procedure_Return
        Move (vFolderFormat(sPkg) + "*.pkg") to sMask
        Get rfFileSearchRecursive sMask DIRMODE_FILES_ONLY False to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        // Fingerprint the install up front: the newest *.pkg write time, stamped into both caches so a
        // later read detects a same-version install update (a package newer than this -> _PkgScanIsStale).
        Get _NewestWriteTime aFiles to dtNewest
        Get _PkgTimeStamp dtNewest to sNewestStamp
        Move (bShowProgress and (ghoStatusPanel <> 0) and (Active_State(ghoStatusPanel) = True)) to bPanel
        If (bPanel = True) Begin
            // Budget the (now-known) package count into the running total bar so it keeps moving
            // through the scan instead of freezing (mirrors the per-file passes that follow).
            Get piMaximumTot of ghoStatusPanel to iCurMax
            Set piMaximumTot of ghoStatusPanel to (iCurMax + iLast + 1)
        End
        For i from 0 to iLast
            If (bPanel = True) Begin
                // "Package No: x of: y" counter, mirroring the engine's per-file caption for line-by-line
                // functions (cRefactorEngine.pkg) - the install-Pkg scan is the long cold-cache phase.
                Set Caption_Text   of ghoStatusPanel to ("Package No:" * String(i + 1) * "of:" * String(iLast + 1))
                Set TableName_Text of ghoStatusPanel to (aFiles[i].sFilename)
                Send DoAdvanceTot of ghoStatusPanel
            End
            Move (rfReadEncodedFileAsStringArray(aFiles[i].sFilename)) to asCode
            If (bDoRecipes = True) Begin
                Get _ObsoleteRecipesFromLines asCode to aFileRecs
                Move (SizeOfArray(aFileRecs) - 1) to jLast
                For j from 0 to jLast
                    Move aFileRecs[j] to aRecipes[SizeOfArray(aRecipes)]
                Loop
            End
            If (bDoTypeDefs = True) Begin
                Get _TypeDefsFromLines asCode to aFileDefs
                Move (SizeOfArray(aFileDefs) - 1) to jLast
                For j from 0 to jLast
                    Move aFileDefs[j] to aDefs[SizeOfArray(aDefs)]
                Loop
            End
            If (bDoGlobalFuncs = True) Begin
                Get _GlobalFuncNamesFromLines asCode to asFileNames
                Move (SizeOfArray(asFileNames) - 1) to jLast
                For j from 0 to jLast
                    // Dedup as we accumulate - the same Global name recurs across packages, and the
                    // consumer only needs the SET (keeps the cached JSON small).
                    If (SearchArray(asFileNames[j], asGlobalNames, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                        Move asFileNames[j] to asGlobalNames[SizeOfArray(asGlobalNames)]
                Loop
            End
        Loop
        If (bDoRecipes = True) ;
            Send WriteObsoleteScanCacheTo aRecipes sNewestStamp (ObsoleteScanCacheJsonPathFor(Self, sVer))
        If (bDoTypeDefs = True) ;
            Send WriteTypeDefsCacheTo aDefs sNewestStamp (TypeDefsCacheJsonPathFor(Self, sVer))
        If (bDoGlobalFuncs = True) ;
            Send WriteGlobalFuncNamesCacheTo asGlobalNames sNewestStamp (GlobalFuncNamesCacheJsonPathFor(Self, sVer))
    End_Procedure

    // The product's entry point: this session's target, unchanged.
    Procedure WalkInstallPackages Boolean bDoRecipes Boolean bDoTypeDefs Boolean bDoGlobalFuncs Boolean bShowProgress
        String sPkg sVer
        Get psTargetPkgFolder of ghoApplication to sPkg
        Get psTargetDfVersion of ghoApplication to sVer
        Send WalkInstallPackagesFor sPkg sVer bDoRecipes bDoTypeDefs bDoGlobalFuncs bShowProgress
    End_Procedure

    // Ensure the install caches the caller needs are fresh, walking ONCE if needed. When a walk IS
    // required it opportunistically refreshes EVERY stale install cache in that single pass (so the
    // other consumer later finds a hit) - this is what makes "one walk feeds both" real. bShowProgress
    // is handed to the walk for the per-package progress bar.
    Procedure EnsureInstallCaches Boolean bForRecipes Boolean bForTypeDefs Boolean bForGlobalFuncs Boolean bShowProgress
        Boolean bRecipesStale bTypeDefsStale bGlobalFuncsStale bNeedWalk

        // Probe only the cache(s) the CALLER needs, to decide IF we walk - so a fresh-cache call costs
        // one small read, not also a parse of the (potentially large) other cache.
        If (bForRecipes = True) ;
            Get _ObsoleteScanCacheStale to bRecipesStale
        If (bForTypeDefs = True) ;
            Get _TypeDefsCacheStale to bTypeDefsStale
        If (bForGlobalFuncs = True) ;
            Get _GlobalFuncNamesCacheStale to bGlobalFuncsStale
        Move ((bForRecipes and bRecipesStale) or (bForTypeDefs and bTypeDefsStale) or (bForGlobalFuncs and bGlobalFuncsStale)) to bNeedWalk
        If (bNeedWalk = False) ;
            Procedure_Return
        // Walking anyway: re-probe the OTHER caches (unconditioned) so this single pass refreshes them
        // too if they are also stale - the piggyback that makes "one walk feeds all" real.
        If (bForRecipes = False) ;
            Get _ObsoleteScanCacheStale to bRecipesStale
        If (bForTypeDefs = False) ;
            Get _TypeDefsCacheStale to bTypeDefsStale
        If (bForGlobalFuncs = False) ;
            Get _GlobalFuncNamesCacheStale to bGlobalFuncsStale
        Send WalkInstallPackages bRecipesStale bTypeDefsStale bGlobalFuncsStale bShowProgress
    End_Procedure

    // The install's obsolete-warning catalogue (Explain recipes) via the shared cache: ensures the
    // ObsoleteScan cache is fresh (walking iff stale, piggybacking the Type-def cache if it too is
    // stale) and returns the cached scan. Replaces cModAnalyzer.ScanInstallPackages - the walk lives
    // here so it runs ONCE for both the recipe scan and the TypeToStructReport catalogue. Silent (no
    // progress bar): the recipe scan never drove one. Empty array if the install can't be located.
    Function InstallScanRecipes Returns tModAnalyzer[]
        tModAnalyzer[] aScan
        Boolean bOK
        Send EnsureInstallCaches True False False False
        Get ReadObsoleteScanCache (&aScan) to bOK
        Function_Return aScan
    End_Function

    // True when the raw install obsolete-warning scan is stale: the DfVersion-ObsoleteScan-<ver>.json cache is
    // missing / unparseable / a stale format version / OR a package is newer than its watermark (an
    // in-place DataFlex update under the same version). cModAnalyzer's RefreshRecipeTable consults this
    // so it RE-MERGES the recipe set (re-walking the packages via InstallScanRecipes) when the install
    // changed - otherwise a present-and-current merged ModAnalyzerRecipes-<ver>.json would short-circuit
    // the merge and the raw cache (and the recipe table) would never refresh. Public peer of
    // InstallScanRecipes; the underlying _ObsoleteScanCacheStale is the same probe EnsureInstallCaches uses.
    Function InstallScanIsStale Returns Boolean
        Boolean bStale
        Get _ObsoleteScanCacheStale to bStale
        Function_Return bStale
    End_Function

    // Returns the legacy Type names a file's lines reference, so the report knows which catalogued
    // Types to propose Structs for. Two reliable signals: (1) the first argument of a type-first
    // command (ZeroType / FillType / Offset_of_Field / Size_of_Field); (2) the "<type>.<field>"
    // operand after "At" in a Put / GETBUFF / StoreField / ... accessor (the part before the dot).
    // Candidates are de-duplicated; the caller filters them against the Type catalog, so a stray
    // non-type candidate is harmless. PURE (no file I/O) -> unit-testable.
    Function _UsedTypeNamesFromLines String[] asLines Returns String[]
        String[] asOut asWords
        String sCmd sCand sType sBuf
        Integer i iLast iOut iNTok iDot iDup
        Boolean bIsAcc

        // Stateless: each line is split locally (_SplitSourceWords) - no shared engine
        // Tokenizer. Two signals, BOTH verb-gated: (1) the byte-arithmetic type-first commands
        // (Offset_of_Field/Size_of_Field) -> arg 1 is the Type (dot-stripped: the real usage is
        // "Offset_of_Field <Type>.<field> ...", and the dotted form never matched the catalog);
        // (2) a real buffer ACCESSOR line (ZeroType/FillType/Put/GetBuff/... via
        // _AccessorTypeBuffer) -> its bound Type. The old signal (2) took ANY line's
        // "At <x>.<y>" token, so char-mode print-position forms ("Print ... At FormRow.3")
        // minted phantom "used Types" that PART 1 flagged "definition not found - check it is
        // a Type" (LegacyApp2 2026-07-16 log: transdate / FormRow - not Types at all).
        Move (SizeOfArray(asLines) - 1) to iLast
        Move 0 to iOut
        For i from 0 to iLast
            If (Mod(i, 64) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Scanning Type usage, line:"
            Get _SplitSourceWords asLines[i] to asWords
            Move (SizeOfArray(asWords)) to iNTok
            If (iNTok > 1) Begin
                Move (Lowercase(asWords[0])) to sCmd
                Move "" to sCand
                If (sCmd = "offset_of_field" or sCmd = "size_of_field") Begin
                    Move asWords[1] to sCand
                    Move (Pos(".", sCand)) to iDot
                    If (iDot > 1) ;
                        Move (Left(sCand, (iDot - 1))) to sCand
                End
                Else Begin
                    Get _AccessorTypeBuffer asWords (&sType) (&sBuf) to bIsAcc
                    If (bIsAcc = True) ;
                        Move sType to sCand
                End
                If (sCand <> "") Begin
                    Move (SearchArray(sCand, asOut, Desktop, RefFunc(DFSTRICMP))) to iDup
                    If (iDup = -1) Begin
                        Move sCand to asOut[iOut]
                        Increment iOut
                    End
                End
            End
        Loop
        Function_Return asOut
    End_Function

    // The field name after the dot in a "<Type>.<field>" operand token; "" if there is no dotted
    // field. Used by _SuggestStructLine to drop the byte-offset Type prefix.
    Function _FieldAfterDot String sTok Returns String
        Integer iDot
        Move (Pos(".", sTok)) to iDot
        If (iDot < 1 or iDot >= Length(sTok)) ;
            Function_Return ""
        Function_Return (Mid(sTok, (Length(sTok) - iDot), (iDot + 1)))
    End_Function

    /* The TYPE name in a "<Type>.<field>" operand token - _FieldAfterDot's sibling, and the one
       home for the head of that split. "" when the token names no Type.

       IT ALSO STRIPS A PACKAGE QUALIFIER, which is the whole reason it exists. DataFlex lets a
       Type declared in a Use'd package be reached as "<Package>$<Type>.<field>", and VDFQuery's
       fvsystempounder.pkg does exactly that:

           getbuff from lsValue at Dates$SystemTime.iHour to liHour

       Taking everything before the dot yields "Dates$SystemTime", which matches no Type block
       anywhere, so those clusters were graded against a name that cannot exist and refused for a
       reason that was not the true one (Nils 2026-09-01). The Type is SystemTime; Dates is the
       package it was Use'd from. Eight lines across two copies of that library.

       A cluster whose Type lives in another package is still refused - "not declared in this
       file" is correct for it - but now it is refused for the reason that is actually true, and
       the report names a Type the reader can go and look at. PURE. */
    Function _TypeBeforeDot String sTok Returns String
        String sHead
        Integer iDot iDollar

        Move (Trim(sTok)) to sHead
        Move (Pos(".", sHead)) to iDot
        If (iDot > 1) ;
            Move (Left(sHead, (iDot - 1))) to sHead
        Else If (iDot <> 0) ;
            Function_Return ""
        // Last "$", so a hypothetical A$B$C still yields C.
        Move (Pos("$", sHead)) to iDollar
        While (iDollar > 0 and iDollar < Length(sHead))
            Move (Right(sHead, (Length(sHead) - iDollar))) to sHead
            Move (Pos("$", sHead)) to iDollar
        Loop
        If (Pos("$", sHead) > 0) ;
            Function_Return ""
        Function_Return sHead
    End_Function

    // Suggest a modern Struct-based rewrite for ONE legacy byte-buffer accessor line, from its split
    // words (asWords[0] = the accessor verb, as produced by _SplitSourceWords) + the Type catalog
    // (so a field reference can be prefixed to match PART 1's Hungarian member, e.g. message ->
    // iMessage; aCatalog comes from TypeToStructReport's Phase A/B). The buffer becomes a Struct local
    // named 'TheData' (an abstract, readable name - the 's' String prefix is misleading once it is a
    // Struct; the user renames the buffer's other uses to match) and the "<Type>." byte-offset prefix
    // drops (a Struct addresses members by name). Returns "" when there is no safe 1:1 rewrite (the
    // line is still LISTED, just without a suggestion). PURE -> unit-testable. Operands are read off the
    // (string-masked) word split, so a string-literal operand can show garbled - the banner says review.
    //   GetBuff[_String] from <buf> At <Type>.<field> to <dest>  ->  Move TheData.<field> to <dest>
    //   Put[_String]     <src> to <buf> At <Type>.<field>        ->  Move <src> to TheData.<field>
    //   ZeroType         <Type> to <buf>                          ->  declare '<Type> TheData' (zeroed)
    Function _SuggestStructLine String[] asWords tTypeDef[] aCatalog Returns String
        Integer iN iFrom iAt iTo iDot
        String sVerb sBuf sDest sSrc sField sType sTok sTypeName sFieldType

        Move (SizeOfArray(asWords)) to iN
        If (iN < 2) ;
            Function_Return ""
        Move (Lowercase(asWords[0])) to sVerb
        Move (SearchArray("from", asWords, Desktop, RefFunc(DFSTRICMP))) to iFrom
        Move (SearchArray("At",   asWords, Desktop, RefFunc(DFSTRICMP))) to iAt
        Move (SearchArray("to",   asWords, Desktop, RefFunc(DFSTRICMP))) to iTo
        Move "" to sField
        If (iAt <> -1 and (iAt + 1) <= (iN - 1)) Begin
            Move asWords[iAt + 1] to sTok
            Get _FieldAfterDot sTok to sField
            // Prefix the field to match PART 1's Hungarian member: the "<Type>." prefix on the operand
            // names the Type; look its field's data type up in the catalog. Fall back to the bare name.
            Get _TypeBeforeDot sTok to sTypeName
            If (sField <> "" and sTypeName <> "") Begin
                Get _FieldDataType aCatalog sTypeName sField to sFieldType
                If (sFieldType <> "") ;
                    Get _HungarianMember sFieldType sField to sField
            End
        End
        Case Begin
            Case (sVerb = "getbuff" or sVerb = "getbuff_string" or sVerb = "retrievefield")
                // <verb> from <buf> At <Type>.<field> to <dest>
                If (iFrom = -1 or iAt = -1 or iTo = -1 or sField = "" or (iTo + 1) > (iN - 1)) ;
                    Function_Return ""
                Move asWords[iTo + 1] to sDest
                Function_Return ("Move TheData." + sField + " to " + sDest)
                Case Break
            Case (sVerb = "put" or sVerb = "put_string" or sVerb = "storefield")
                // <verb> <src> to <buf> At <Type>.<field>
                If (iTo = -1 or iAt = -1 or sField = "" or (iTo + 1) > (iN - 1)) ;
                    Function_Return ""
                Move asWords[1] to sSrc
                Function_Return ("Move " + sSrc + " to TheData." + sField)
                Case Break
            Case (sVerb = "arrayput")
                // ArrayPut <src> to <arr> At <Type>.<field> <idx>  ->  a write into a Struct[] element.
                If (iTo = -1 or iAt = -1 or sField = "" or (iTo + 1) > (iN - 1)) ;
                    Function_Return ""
                Move asWords[1] to sSrc
                Function_Return ("Move " + sSrc + " to TheData[i]." + sField + "  (TheData is the Struct[] element - supply the index)")
                Case Break
            Case (sVerb = "zerotype")
                // ZeroType <Type> to <buf>  ->  the buffer becomes a Struct local (auto-zeroed)
                If (iTo = -1 or (iTo + 1) > (iN - 1)) ;
                    Function_Return ""
                Move asWords[1]       to sType
                Move asWords[iTo + 1] to sBuf
                Function_Return ("declare '" + sType + " TheData' as a Struct local (starts zeroed); rename " + sBuf + " -> TheData and drop the String buffer")
                Case Break
            Case (sVerb = "filltype")
                If (iTo = -1 or (iTo + 1) > (iN - 1)) ;
                    Function_Return ""
                Move asWords[1]       to sType
                Move asWords[iTo + 1] to sBuf
                Function_Return ("no direct Struct form - declare '" + sType + " TheData' then set its members explicitly; rename " + sBuf + " -> TheData")
                Case Break
            Case (sVerb = "offset_of_field" or sVerb = "size_of_field")
                Function_Return ("byte offset/size is obsolete with a Struct - address the member by name and rework the surrounding pointer/length logic by hand")
                Case Break
            Case Else
                Function_Return ""
        Case End
    End_Function

    // Extracts the variable whose ADDRESS is taken on a line, or "" if none. This is the tell that a
    // Type buffer is passed to native code (a Windows API / External_Function), so its migration to a
    // Struct needs human care. Two forms: the 'GetAddress OF <var>' command LegacyApp uses before a
    // Windows_Message (word-split, so spacing is irrelevant), and the 'AddressOf(<var>)' /
    // 'GetAddressOf(<var>)' function forms (raw Pos, robust to surrounding parens). PURE -> unit-testable.
    Function _AddressTakenVar String sLine Returns String
        String[] asWords
        String sLow sRest sVar
        Integer iW iWLast iPos iEnd

        // Function form: AddressOf(<var>) / GetAddressOf(<var>), with OPTIONAL whitespace before the "("
        // (LegacyApp's cSystemInfo uses 'AddressOf (sSystemInfo)'). Find "addressof" (9 chars), skip any
        // whitespace, require "(", then take the operand up to the next ")". The "(" guard stops a var
        // merely NAMED "...addressof..." from matching.
        Move (Lowercase(sLine)) to sLow
        Move (Pos("addressof", sLow)) to iPos
        If (iPos > 0) Begin
            Move (Trim(Mid(sLine, Length(sLine), (iPos + 9)))) to sRest
            If (Left(sRest, 1) = "(") Begin
                Move (Trim(Mid(sRest, Length(sRest), 2))) to sRest
                Move (Pos(")", sRest)) to iEnd
                If (iEnd > 1) ;
                    Move (Trim(Left(sRest, (iEnd - 1)))) to sVar
                If (sVar <> "") ;
                    Function_Return sVar
            End
        End
        // Command form: GetAddress OF <var> to <ptr>  -> <var> is the word after "of".
        Get _SplitSourceWords sLine to asWords
        Move (SizeOfArray(asWords) - 1) to iWLast
        For iW from 0 to iWLast
            If (Lowercase(asWords[iW]) = "getaddress" and (iW + 2) <= iWLast and (Lowercase(asWords[iW + 1]) = "of")) ;
                Function_Return asWords[iW + 2]
        Loop
        Function_Return ""
    End_Function

    // Extracts the (Type, buffer) binding from a legacy byte-buffer accessor line (its _SplitSourceWords
    // split): which String buffer is being read/written AS which Type. Returns True (and sets sType +
    // sBuffer ByRef) for a recognised accessor, else False. Mirrors _SuggestStructLine's operand parse.
    //   ZeroType/FillType <Type> to <buf>
    //   GetBuff[_String]/RetrieveField from <buf> At <Type>.<field> ...
    //   Put[_String]/StoreField/ArrayPut <src> to <buf> At <Type>.<field> ...
    // PURE -> unit-testable. Used by _MarshaledTypeNames.
    Function _AccessorTypeBuffer String[] asWords String ByRef sType String ByRef sBuffer Returns Boolean
        Integer iN iFrom iAt iTo iDot
        String sVerb sTok

        Move "" to sType
        Move "" to sBuffer
        Move (SizeOfArray(asWords)) to iN
        If (iN < 2) ;
            Function_Return False
        Move (Lowercase(asWords[0])) to sVerb
        Move (SearchArray("from", asWords, Desktop, RefFunc(DFSTRICMP))) to iFrom
        Move (SearchArray("At",   asWords, Desktop, RefFunc(DFSTRICMP))) to iAt
        Move (SearchArray("to",   asWords, Desktop, RefFunc(DFSTRICMP))) to iTo
        Case Begin
            Case (sVerb = "zerotype" or sVerb = "filltype")
                // <verb> <Type> to <buf>
                If (iTo = -1 or (iTo + 1) > (iN - 1)) ;
                    Function_Return False
                // _TypeBeforeDot, not asWords[1] raw: the Type may carry a package qualifier
                // ("ZeroType Dates$SystemTime to sBuf"), and the cluster is keyed on the bare name.
                Get _TypeBeforeDot asWords[1] to sType
                Move asWords[iTo + 1] to sBuffer
                Function_Return (sType <> "" and sBuffer <> "")
                Case Break
            Case (sVerb = "getbuff" or sVerb = "getbuff_string" or sVerb = "retrievefield")
                // <verb> from <buf> At [<Package>$]<Type>.<field> to <dest>
                If (iFrom = -1 or (iFrom + 1) > (iN - 1) or iAt = -1 or (iAt + 1) > (iN - 1)) ;
                    Function_Return False
                Move asWords[iFrom + 1] to sBuffer
                Move asWords[iAt + 1]   to sTok
                Get _TypeBeforeDot sTok to sType
                Function_Return (sType <> "" and sBuffer <> "")
                Case Break
            Case (sVerb = "put" or sVerb = "put_string" or sVerb = "storefield" or sVerb = "arrayput")
                // <verb> <src> to <buf> At [<Package>$]<Type>.<field> [idx]
                If (iTo = -1 or (iTo + 1) > (iN - 1) or iAt = -1 or (iAt + 1) > (iN - 1)) ;
                    Function_Return False
                Move asWords[iTo + 1] to sBuffer
                Move asWords[iAt + 1] to sTok
                Get _TypeBeforeDot sTok to sType
                Function_Return (sType <> "" and sBuffer <> "")
                Case Break
        Case End
        Function_Return False
    End_Function

    // Classifies which Types in a file are MARSHALED to native code (a buffer bound to the Type has its
    // ADDRESS taken -> it is passed to a Windows API / External_Function, so a Struct must marshal by
    // address and the migration needs human care) vs pure in-memory (safe to auto-convert). Returns the
    // distinct MARSHALED Type names. Two passes: (1) collect buffer vars whose address is taken;
    // (2) bind each accessor's buffer to its Type and mark the Type when its buffer is address-taken.
    // CONSERVATIVE: a buffer-name reused across procedures can over-mark a Type, erring toward
    // "hand-migrate" (the safe side). PURE -> unit-testable. (Nils 2026-07-03.)
    Function _MarshaledTypeNames String[] asLines Returns String[]
        String[] asMarshaled asAddrVars asWords
        String sType sBuffer sVar
        Integer iLine iLast
        Boolean bIsAcc

        Move (SizeOfArray(asLines) - 1) to iLast
        // Pass 1: buffer vars whose address is taken.
        For iLine from 0 to iLast
            If (Mod(iLine, 64) = 0) ;
                Send _NudgeLineProgress iLine (iLast + 1) "Scanning marshaled Types, line:"
            Get _AddressTakenVar asLines[iLine] to sVar
            If (sVar <> "" and (SearchArray(sVar, asAddrVars, Desktop, RefFunc(DFSTRICMP)) = -1)) ;
                Move sVar to asAddrVars[SizeOfArray(asAddrVars)]
        Loop
        // No address ever taken -> nothing marshaled.
        If (SizeOfArray(asAddrVars) = 0) ;
            Function_Return asMarshaled
        // Pass 2: an accessor whose buffer had its address taken marks its Type marshaled.
        For iLine from 0 to iLast
            If (Mod(iLine, 64) = 0) ;
                Send _NudgeLineProgress iLine (iLast + 1) "Scanning marshaled Types, line:"
            Get _SplitSourceWords asLines[iLine] to asWords
            Get _AccessorTypeBuffer asWords (&sType) (&sBuffer) to bIsAcc
            If (bIsAcc = True) Begin
                If (SearchArray(sBuffer, asAddrVars, Desktop, RefFunc(DFSTRICMP)) <> -1) Begin
                    If (SearchArray(sType, asMarshaled, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                        Move sType to asMarshaled[SizeOfArray(asMarshaled)]
                End
            End
        Loop
        Function_Return asMarshaled
    End_Function


    /* ---- TIER 2: a legacy Type that DataFlex itself has REPLACED with a shipped Struct ----------

       Tier-1 grading (below) refuses any cluster whose buffer has its ADDRESS taken, and it is right
       to: nothing it can see proves a hand-written Struct has the Type's byte layout, and a wrong
       layout marshals silently. That refusal is also what leaves every Windows-API buffer - the
       commonest legacy Type there is - permanently in the report.

       Tier 2 answers exactly that, for a set where the answer comes from the VENDOR. 22 of the 31
       legacy Types in Dftypes.pkg have a tWin<X> twin in tWinStructs.pkg, and DataFlex passes those
       twins to the same APIs itself - cApplication.pkg marshals tWinWindowPlacement with AddressOf
       and SizeOfType. So for those pairs the layout is guaranteed by the install rather than by our
       analysis, and the address-taken blocker is lifted. For no others.

       THE NAME RULE IS A CANDIDATE, NEVER A CONCLUSION - the WinAPI catalogue's stance. t<X> ->
       tWin<X> holds for 24 of the 31, which makes it a good way to LOOK; the pair is then verified
       against the TARGET install, where the struct must exist and every field the code actually
       touches must resolve through it. Two of the 24 restructure their members (tWindowPlacement
       drops the pt/rc prefixes, tTvInsertStruct drops a t) and are deliberately NOT here: they need
       a member map, which is the next slice.
       (Nils 2026-08-31. Step 1's own note called this "a future opt-in Type->Struct converter".) */
    Function _WinStructTwinCandidates Returns String[]
        String[] as
        Move "tPOINT|tWinPOINT"                     to as[0]
        Move "tRECT|tWinRECT"                       to as[1]
        Move "tPaintStruct|tWinPaintStruct"         to as[2]
        Move "tNMHDR|tWinNMHDR"                     to as[3]
        Move "tNmMouse|tWinNmMouse"                 to as[4]
        Move "tPbRange|tWinPbRange"                 to as[5]
        Move "tTbInsertMark|tWinTbInsertMark"       to as[6]
        Move "tTbReplaceBitmap|tWinTbReplaceBitmap" to as[7]
        Move "tTbButtonInfo|tWinTbButtonInfo"       to as[8]
        Move "tNmTbHotItem|tWinNmTbHotItem"         to as[9]
        Move "tNmTbGetInfoTip|tWinNmTbGetInfoTip"   to as[10]
        Move "tNmTbDispInfo|tWinNmTbDispInfo"       to as[11]
        Move "tTbButton|tWinTbButton"               to as[12]
        Move "tNmToolbar|tWinNmToolbar"             to as[13]
        Move "tTcItem|tWinTcItem"                   to as[14]
        Move "tTvItem|tWinTvItem"                   to as[15]
        Move "tTvItemEx|tWinTvItemEx"               to as[16]
        Move "tNmTreeView|tWinNmTreeView"           to as[17]
        Move "tTvHitTestInfo|tWinTvHitTestInfo"     to as[18]
        Move "tNmTvGetInfoTip|tWinNmTvGetInfoTip"   to as[19]
        Move "tNmTvDispInfo|tWinNmTvDispInfo"       to as[20]
        Move "tFileTime|tWinFileTime"               to as[21]
        /* THE MAPPED PAIRS. A third "|" part carries the member map (see _WinStructMemberMap):
           these two structs RENAMED members rather than only nesting them, so their fields have
           to be translated before they are verified or emitted. Everything above lines up as it
           stands and carries no map. */
        Move "tWindowPlacement|tWinWindowPlacement|ptMinPosition>MinPosition;ptMaxPosition>MaxPosition;rcNormalPosition>NormalPosition" to as[22]
        Move "tTvInsertStruct|tWinTvInsertStruct|tTvItemEx>TvItemEx" to as[23]
        /* NOT MAPPED, ON PURPOSE - the RESERVED slots. Verified against the DF26 install: three
           pairs carry fields that do not resolve after mapping - tTbButton.bReserved1/2 and
           tNmToolbar.tbButton.bReserved1/2 (the struct declares bReserved twice), and
           tTcItem.lpReserved1/2 (the struct REPURPOSED them as dwState/dwStateMask). Those are
           different fields, not renamed ones, so there is nothing honest to map them to: a
           cluster that touches one is refused at verification and says which field. Do not add
           map entries for them - that would write a member with the wrong meaning. Everything
           else in all 24 pairs resolves. */
        Function_Return as
    End_Function

    // The candidate twin's EXACT spelling for a legacy Type name, "" when there is no candidate.
    // Matched case-insensitively (DataFlex compares that way); the spelling returned is the
    // install's own, so emitted code reads like tWinStructs.pkg and not like the Type it replaced.
    Function _WinStructTwinName String sTypeName Returns String
        String[] asPairs
        String sLow sRow sRest
        Integer i iLast iBar

        Move (Lowercase(Trim(sTypeName))) to sLow
        If (sLow = "") ;
            Function_Return ""
        Get _WinStructTwinCandidates to asPairs
        Move (SizeOfArray(asPairs) - 1) to iLast
        For i from 0 to iLast
            Move asPairs[i] to sRow
            Move (Pos("|", sRow)) to iBar
            If (Lowercase(Left(sRow, (iBar - 1))) = sLow) Begin
                // Stop at the NEXT bar - a mapped row carries a third part after the name.
                Move (Right(sRow, (Length(sRow) - iBar))) to sRest
                Move (Pos("|", sRest)) to iBar
                If (iBar = 0) ;
                    Function_Return sRest
                Function_Return (Left(sRest, (iBar - 1)))
            End
        Loop
        Function_Return ""
    End_Function

    /* The member map of a mapped pair, "" when the members line up as they are.

       Format: "old>new;old>new", matched against the FIRST segment of a dotted field path. That is
       the whole shape of the restructuring DataFlex did: the old Type spelled its nesting into the
       field NAME with a Hungarian prefix (ptMinPosition.x, rcNormalPosition.left), and the struct
       made the nesting real and dropped the prefix (tWinPoint MinPosition, tWinRect NormalPosition).
       Only the head segment is ever renamed - .x, .y, .left survive untouched, which is why the
       map is three entries and not eleven. */
    Function _WinStructMemberMap String sTypeName Returns String
        String[] asPairs
        String sLow sRow sRest
        Integer i iLast iBar

        Move (Lowercase(Trim(sTypeName))) to sLow
        Get _WinStructTwinCandidates to asPairs
        Move (SizeOfArray(asPairs) - 1) to iLast
        For i from 0 to iLast
            Move asPairs[i] to sRow
            Move (Pos("|", sRow)) to iBar
            If (Lowercase(Left(sRow, (iBar - 1))) = sLow) Begin
                Move (Right(sRow, (Length(sRow) - iBar))) to sRest
                Move (Pos("|", sRest)) to iBar
                If (iBar = 0) ;
                    Function_Return ""
                Function_Return (Right(sRest, (Length(sRest) - iBar)))
            End
        Loop
        Function_Return ""
    End_Function

    /* sDottedField as the shipped struct spells it. Unmapped pairs and unmapped head segments come
       back unchanged, so this is safe to call for every field of every pair - the caller never has
       to know which kind it is holding. The result is what gets VERIFIED against the install and
       what gets EMITTED, so a map that is wrong fails closed at verification rather than writing a
       member that will not compile. */
    Function _WinStructMapField String sTypeName String sDottedField Returns String
        String sMap sHead sRest sEntry sFrom sTo
        Integer iDot iSemi iGt

        Get _WinStructMemberMap sTypeName to sMap
        If (sMap = "" or Trim(sDottedField) = "") ;
            Function_Return sDottedField
        Move (Pos(".", sDottedField)) to iDot
        If (iDot > 1) Begin
            Move (Left(sDottedField, (iDot - 1))) to sHead
            Move (Right(sDottedField, (Length(sDottedField) - iDot))) to sRest
        End
        Else Begin
            Move sDottedField to sHead
            Move "" to sRest
        End
        While (sMap <> "")
            Move (Pos(";", sMap)) to iSemi
            If (iSemi > 0) Begin
                Move (Left(sMap, (iSemi - 1))) to sEntry
                Move (Right(sMap, (Length(sMap) - iSemi))) to sMap
            End
            Else Begin
                Move sMap to sEntry
                Move ""   to sMap
            End
            Move (Pos(">", sEntry)) to iGt
            If (iGt > 1) Begin
                Move (Left(sEntry, (iGt - 1))) to sFrom
                Move (Right(sEntry, (Length(sEntry) - iGt))) to sTo
                If (Lowercase(sFrom) = Lowercase(sHead)) Begin
                    If (sRest = "") ;
                        Function_Return sTo
                    Function_Return (sTo + "." + sRest)
                End
            End
        Loop
        Function_Return sDottedField
    End_Function

    /* The TARGET install's tWinStructs.pkg as a flat member table - one row per declared member,
       "<owner struct>|<member type>|<member name>", all lowercased. Flat on purpose: a dotted path
       is resolved by WALKING it (see _WinStructHasField), which is cheaper than pre-expanding every
       leaf and is the honest model of what the compiler does.
       Loaded once per target folder. An unreadable file leaves the table EMPTY, and every
       verification then fails closed - a missing catalogue must refuse conversions, never wave them
       through (the lesson _NoteWinAPICatalogueState exists to voice). */
    Procedure _RefreshWinStructCatalog
        String[] asLines asRows
        String sPkg sFile sPrev sCode sCur sT sN
        Integer i iLast
        Boolean bExists

        Get psWinStructPkgOverride to sFile        // test seam - see the property
        If (sFile = "") Begin
            Get psTargetPkgFolder of ghoApplication to sPkg
            Move (vFolderFormat(sPkg) + "tWinStructs.pkg") to sFile
        End
        Else ;
            Move "seam" to sPkg
        Get psWinStructCatalogFile to sPrev
        If (sPrev = sFile and pbWinStructCatalogLoaded(Self) = True) ;
            Procedure_Return
        Set psWinStructCatalogFile   to sFile
        Set pbWinStructCatalogLoaded to True
        Set pasWinStructMember to asRows
        If (Trim(sPkg) = "") ;
            Procedure_Return
        Get vFilePathExists sFile to bExists
        If (bExists = False) ;
            Procedure_Return
        Move (rfReadEncodedFileAsStringArray(sFile)) to asLines
        Move "" to sCur
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            Move (Trim(sCode)) to sCode
            If (Lowercase(Left(sCode, 7)) = "struct ") Begin
                Get _NthWord sCode 2 to sCur
                Move (Lowercase(sCur)) to sCur
            End
            Else If (Lowercase(Left(sCode, 10)) = "end_struct") Begin
                Move "" to sCur
            End
            Else If (sCur <> "" and sCode <> "") Begin
                Get _NthWord sCode 1 to sT
                Get _NthWord sCode 2 to sN
                If (sT <> "" and sN <> "") ;
                    Move (sCur + "|" + Lowercase(sT) + "|" + Lowercase(sN)) to asRows[SizeOfArray(asRows)]
            End
        Loop
        Set pasWinStructMember to asRows
    End_Procedure

    // The declared type of sMember on sStruct, "" when it is not a member. Both lowercased.
    Function _WinStructMemberType String sStruct String sMember Returns String
        String[] asRows
        String sKey sRow sRest
        Integer i iLast iBar

        Get pasWinStructMember to asRows
        Move (Lowercase(Trim(sStruct)) + "|") to sKey
        Move (SizeOfArray(asRows) - 1) to iLast
        For i from 0 to iLast
            Move asRows[i] to sRow
            If (Left(sRow, Length(sKey)) = sKey) Begin
                Move (Right(sRow, (Length(sRow) - Length(sKey)))) to sRest
                Move (Pos("|", sRest)) to iBar
                If (iBar > 1) Begin
                    If (Right(sRest, (Length(sRest) - iBar)) = Lowercase(Trim(sMember))) ;
                        Function_Return (Left(sRest, (iBar - 1)))
                End
            End
        Loop
        Function_Return ""
    End_Function

    /* Does sDottedField resolve on sStruct in the TARGET install? Walks the path segment by segment,
       which is what makes the old flat spelling and the new nested one comparable at all: the Type
       wrote rcPaint.left as one field NAME, the Struct writes tWinRect rcPaint, and both reach the
       same source text. Fails closed on an empty catalogue or any segment that does not resolve. */
    Function _WinStructHasField String sStruct String sDottedField Returns Boolean
        String sCur sPath sSeg sNext
        Integer iDot iGuard

        Send _RefreshWinStructCatalog
        Move (Lowercase(Trim(sStruct)))      to sCur
        Move (Lowercase(Trim(sDottedField))) to sPath
        If (sCur = "" or sPath = "") ;
            Function_Return False
        For iGuard from 1 to 8
            Move (Pos(".", sPath)) to iDot
            If (iDot = 0) Begin
                Get _WinStructMemberType sCur sPath to sNext
                Function_Return (sNext <> "")
            End
            Move (Left(sPath, (iDot - 1))) to sSeg
            Move (Right(sPath, (Length(sPath) - iDot))) to sPath
            Get _WinStructMemberType sCur sSeg to sNext
            If (sNext = "") ;
                Function_Return False
            Move sNext to sCur
        Loop
        Function_Return False
    End_Function

    // Is sStruct declared at all in the target install's tWinStructs.pkg?
    Function _WinStructExists String sStruct Returns Boolean
        String[] asRows
        String sKey
        Integer i iLast

        Send _RefreshWinStructCatalog
        Get pasWinStructMember to asRows
        Move (Lowercase(Trim(sStruct)) + "|") to sKey
        Move (SizeOfArray(asRows) - 1) to iLast
        For i from 0 to iLast
            If (Left(asRows[i], Length(sKey)) = sKey) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function


    /* Literals overstruck with "_", LENGTH PRESERVED - so a position found on the masked line is
       the same position on the raw one. RemoveStringsFromLine (used by the word splitters) DELETES
       them instead, which is right for tokenizing and useless for slicing: the rewriter below has
       to lift the user's own expression text out of a Put line, and a literal containing " to "
       would otherwise cut it in the wrong place. Stateless - no multi-line string state, because
       every caller here works on one accessor line. */
    Function _MaskLiteralsKeepLength String sLine Returns String
        String sOut sCh sQuote
        Integer i iLen

        Move sLine to sOut
        Move ""    to sQuote
        Move (Length(sLine)) to iLen
        For i from 1 to iLen
            Move (Mid(sOut, 1, i)) to sCh
            If (sQuote = "") Begin
                If (sCh = '"' or sCh = "'") Begin
                    Move sCh to sQuote
                    Move (Overstrike("_", sOut, i)) to sOut
                End
            End
            Else Begin
                If (sCh = sQuote) ;
                    Move "" to sQuote
                Move (Overstrike("_", sOut, i)) to sOut
            End
        Loop
        Function_Return sOut
    End_Function

    // The leading whitespace of a line, so a rewritten statement keeps the block's indentation.
    Function _LeadingIndent String sLine Returns String
        Integer iAt
        Move (Length(sLine) - Length(LTrim(sLine))) to iAt
        If (iAt < 1) ;
            Function_Return ""
        Function_Return (Left(sLine, iAt))
    End_Function

    /* The trailing "// ..." of a line, "" when there is none - re-attached to a rewritten statement
       so the user's own note survives the conversion. */
    Function _EndCommentOf String sLine Returns String
        String sCode
        Get _LineWithoutEndComment sLine to sCode
        If (Length(sCode) >= Length(sLine)) ;
            Function_Return ""
        Function_Return (Right(sLine, (Length(sLine) - Length(sCode))))
    End_Function

    /* The buffer's String declaration, checked for the ONE shape a retype can safely rewrite:
       exactly "[Local] String <buffer>". A line declaring a second variable is refused - retyping
       it would silently retype the other one too. "" when the line is fine, else the reason.

       Lifted out of _WinStructClusterWhyNot so any converter that RETYPES a buffer declaration
       asks one question rather than carrying its own copy - a second copy of this check is a
       second opinion waiting to drift. PURE. */
    Function _BufferDeclWhyNot tTypeBufferCluster rClu String[] ByRef asCode Returns String
        String[] asDeclW
        String sCode
        Integer iBase

        If (rClu.iDeclLine < 1 or rClu.iDeclLine > SizeOfArray(asCode)) ;
            Function_Return ("no String declaration for " + rClu.sBuffer + " was found in " + rClu.sScope)
        Get _LineWithoutEndComment asCode[(rClu.iDeclLine - 1)] to sCode
        Get _SplitSourceWords sCode to asDeclW
        Move 0 to iBase
        If (SizeOfArray(asDeclW) > 0) Begin
            If (Lowercase(asDeclW[0]) = "local") ;
                Move 1 to iBase
        End
        If (SizeOfArray(asDeclW) <> (iBase + 2)) ;
            Function_Return ("its declaration is not a plain 'String " + rClu.sBuffer + "' line, so retyping it could change another variable with it")
        If (Lowercase(asDeclW[iBase]) <> "string") ;
            Function_Return "the buffer is not declared as a String"
        If (Lowercase(asDeclW[(iBase + 1)]) <> Lowercase(rClu.sBuffer)) ;
            Function_Return ("the declaration line does not name " + rClu.sBuffer)
        Function_Return ""
    End_Function

    /* WHY this graded cluster cannot become a shipped Struct - "" when it can.

       ONE PREDICATE, TWO CALLERS, and that is the whole point: the converter refuses with it, and
       the Deep Scan rule that OFFERS the converter declines to raise a finding with it. Split
       between the two, a row would promise a Run button over a cluster the run then refuses - which
       is the defect this codebase paid for twice on 2026-08-31 (DS 9221, and the sys-override line).

       Expects a cluster from _TypeClustersFromLinesEx with bAddressIsOk True, so a taken address has
       already been left out of asBlockers: for these verified pairs DataFlex marshals the same
       struct to the same API itself. Any OTHER blocker still refuses.
       asCode must be the array the cluster was graded against - the line numbers are into it. */
    Function _WinStructClusterWhyNot tTypeBufferCluster rClu String[] ByRef asCode Returns String
        String[] asWords
        String sTwin sField sTok sWhy
        Integer i iN iLn iAt iDot
        Boolean bOk

        Get _WinStructTwinName rClu.sTypeName to sTwin
        If (sTwin = "") ;
            Function_Return (rClu.sTypeName + " has no shipped Struct that DataFlex replaced it with")
        Get _WinStructExists sTwin to bOk
        If (bOk = False) ;
            Function_Return ("the target DataFlex install does not declare " + sTwin + " in tWinStructs.pkg, so the pair could not be verified")
        Move (SizeOfArray(rClu.asBlockers) - 1) to iN
        If (iN >= 0) ;
            Function_Return (rClu.asBlockers[0])
        Get _BufferDeclWhyNot rClu (&asCode) to sWhy
        If (sWhy <> "") ;
            Function_Return sWhy
        // Every field touched must resolve on the struct, in the TARGET install, after the member
        // map - so a wrong map entry fails here rather than emitting code that will not compile.
        Move (SizeOfArray(rClu.aiAccLines) - 1) to iN
        For i from 0 to iN
            Move (rClu.aiAccLines[i] - 1) to iLn
            If (iLn >= 0 and iLn < SizeOfArray(asCode)) Begin
                Get _SplitSourceWords asCode[iLn] to asWords
                Move (SearchArray("At", asWords, Desktop, RefFunc(DFSTRICMP))) to iAt
                If (iAt <> -1 and (iAt + 1) <= (SizeOfArray(asWords) - 1)) Begin
                    Move asWords[(iAt + 1)] to sTok
                    Move (Pos(".", sTok)) to iDot
                    If (iDot > 1) Begin
                        Move (Right(sTok, (Length(sTok) - iDot))) to sField
                        Get _WinStructMapField rClu.sTypeName sField to sField
                        Get _WinStructHasField sTwin sField to bOk
                        If (bOk = False) ;
                            Function_Return (sTwin + " has no field " + sField + " in the target install")
                    End
                End
            End
        Loop
        Function_Return ""
    End_Function

    /* ---- TIER 2, the converter: legacy Type byte-buffer -> the shipped tWin<X> Struct -----------

       Rewrites ONLY the clusters _TypeClustersFromLines graded, on the lines it graded (see
       tTypeBufferCluster.aiAccLines) - the grading and the rewrite must not be two opinions about
       the same code. A cluster converts when ALL of:

         - its Type has a candidate twin (_WinStructTwinName) that EXISTS in the target install;
         - every field it touches resolves on that struct (_WinStructHasField, walked segment by
           segment so the old flat spelling and the new nested one are compared honestly);
         - its only blocker is the taken address - which for these pairs is not a blocker at all,
           because DataFlex marshals the same struct to the same API (see the Tier-2 note above);
         - its declaration is exactly "[Local] String <buffer>". A line declaring a second variable
           is refused: retyping it would silently retype the other one too.

       What it emits, which is the install's own idiom (cApplication.pkg DoLoadEnvironment):

         String sWP                                  ->  tWinWindowPlacement sWP
         ZeroType tWP to sWP                          ->  (removed - a Struct local is already zero,
                                                          which is what the compiler's own message
                                                          says: "Use Structs and it's not needed")
         Put X to sWP At tWP.length                   ->  Move X to sWP.length
         GetBuff from sWP At tWP.showCmd to eShow     ->  Move sWP.showCmd to eShow
         tWP_size                                     ->  (SizeOfType(tWinWindowPlacement))
         AddressOf(sWP)                               ->  unchanged - and the whole point

       The Type DEFINITION is never touched: these 22 live in the install's Dftypes.pkg, and other
       clusters in other files may still be using them. Returns the number of clusters converted. */
    Function _LegacyTypeToWinStructInLines String[] ByRef asCode String sFilePath String[] ByRef asNotes Returns Integer
        tTypeBufferCluster[] aClu
        String[] asWords asDeclW asKeep
        Boolean[] abDrop
        String sTwin sType sBuf sRaw sCode sTail sIndent sSrc sDest sField sTok sVerb sLow sWhyNot
        Integer i iLast j jLast iLn iConv iDot iTo iAt iFrom iN iP1 iP2
        Boolean bBad bIsAcc

        Move 0 to iConv
        Move (SizeOfArray(asCode) - 1) to iLast
        If (iLast < 0) ;
            Function_Return 0
        For i from 0 to iLast
            Move False to abDrop[i]
        Loop
        // True: for these verified pairs a taken address is the POINT, not a blocker.
        Get _TypeClustersFromLinesEx (&asCode) sFilePath True to aClu
        Move (SizeOfArray(aClu) - 1) to jLast
        For j from 0 to jLast
            Move aClu[j].sTypeName to sType
            Move aClu[j].sBuffer   to sBuf
            Get _WinStructTwinName sType to sTwin
            If (sTwin <> "") Begin
                // ONE predicate, shared with the Deep Scan rule that OFFERS this converter, so a
                // row can never promise a run that will refuse (see _WinStructClusterWhyNot).
                Get _WinStructClusterWhyNot aClu[j] (&asCode) to sWhyNot
                Move (sWhyNot <> "") to bBad
                If (bBad = True) ;
                    Send AddRunNote "ChangeLegacyTypeToWinStruct" (sBuf + " in " + aClu[j].sScope + " - " + sWhyNot + ". Left alone.")
                If (bBad = False) Begin
                    // ---- rewrite ----
                    Move (aClu[j].iDeclLine - 1) to iLn
                    Get _LeadingIndent asCode[iLn] to sIndent
                    Get _EndCommentOf   asCode[iLn] to sTail
                    Get _SplitSourceWords asCode[iLn] to asDeclW
                    Move "" to sCode
                    If (Lowercase(asDeclW[0]) = "local") ;
                        Move "Local " to sCode
                    Move (sIndent + sCode + sTwin + " " + sBuf + sTail) to asCode[iLn]
                    Move (SizeOfArray(aClu[j].aiAccLines) - 1) to iN
                    For i from 0 to iN
                        Move (aClu[j].aiAccLines[i] - 1) to iLn
                        Move asCode[iLn] to sRaw
                        Get _LineWithoutEndComment sRaw to sCode
                        Get _EndCommentOf   sRaw to sTail
                        Get _LeadingIndent  sRaw to sIndent
                        Get _MaskLiteralsKeepLength sCode to sLow
                        Get _SplitSourceWords sCode to asWords
                        Move "" to sVerb
                        If (SizeOfArray(asWords) > 0) ;
                            Move (Lowercase(asWords[0])) to sVerb
                        Move (SearchArray("At", asWords, Desktop, RefFunc(DFSTRICMP))) to iAt
                        Move "" to sField
                        If (iAt <> -1 and (iAt + 1) <= (SizeOfArray(asWords) - 1)) Begin
                            Move asWords[(iAt + 1)] to sTok
                            Move (Pos(".", sTok)) to iDot
                            If (iDot > 1) Begin
                                Move (Right(sTok, (Length(sTok) - iDot))) to sField
                                Get _WinStructMapField sType sField to sField   // as the struct spells it
                            End
                        End
                        Case Begin
                            Case (sVerb = "zerotype")
                                // A Struct local is already zero - the line simply goes.
                                Move True to abDrop[iLn]
                                Case Break
                            Case (sVerb = "put")
                                Move (_FindKeywordPos(Self, sLow, "Put", True, 1)) to iP1
                                Move (_FindKeywordPos(Self, sLow, "to",  True, (iP1 + 3))) to iP2
                                If (iP1 > 0 and iP2 > (iP1 + 3)) Begin
                                    Move (Trim(Mid(sCode, (iP2 - iP1 - 3), (iP1 + 3)))) to sSrc
                                    Move (sIndent + "Move " + sSrc + " to " + sBuf + "." + sField + sTail) to asCode[iLn]
                                End
                                Case Break
                            Case (sVerb = "getbuff")
                                Move (_FindKeywordPos(Self, sLow, "At", True, 1)) to iP1
                                Move (_FindKeywordPos(Self, sLow, "to", True, (iP1 + 2))) to iP2
                                If (iP1 > 0 and iP2 > iP1) Begin
                                    Move (Trim(Right(sCode, (Length(sCode) - iP2 - 1)))) to sDest
                                    Move (sIndent + "Move " + sBuf + "." + sField + " to " + sDest + sTail) to asCode[iLn]
                                End
                                Case Break
                        Case End
                        // The Type's generated size constant becomes the struct's own size.
                        Move (Replaces((sType + "_size"), asCode[iLn], ("(SizeOfType(" + sTwin + "))"))) to asCode[iLn]
                        Move (Replaces((Lowercase(sType) + "_size"), asCode[iLn], ("(SizeOfType(" + sTwin + "))"))) to asCode[iLn]
                    Loop
                    Increment iConv
                    Send AddRunNote "ChangeLegacyTypeToWinStruct" (sBuf + " in " + aClu[j].sScope + " - " + sType + " -> " + sTwin + " (DataFlex marshals this struct to the same API, so the layout is the install's guarantee). Verify the run.")
                End
            End
        Loop
        If (iConv = 0) ;
            Function_Return 0
        // One compaction pass - dropping as we went would have invalidated every later line number.
        For i from 0 to iLast
            If (abDrop[i] = False) ;
                Move asCode[i] to asKeep[SizeOfArray(asKeep)]
        Loop
        Move asKeep to asCode
        /* THE FILE NOW DEPENDS ON tWinStructs.pkg AND MUST SAY SO. Every buffer this tier retypes
           is retyped to a tWin<X> the INSTALL declares, and nothing here declared it - so a file
           with no Use for that package named a type it could not resolve (Nils 2026-09-01). Every
           file declares what it consumes; leaning on whichever .src happens to Use it first is
           exactly what breaks when the package is included somewhere else. */
        Send _EnsureUseForNewDependency (&asCode) "tWinStructs.pkg"
        Function_Return iConv
    End_Function

    // ---- Tier-1 auto-convert feasibility: byte-buffer usage clusters ----------------------------
    // Groups a file's legacy Type-buffer usage into CLUSTERS - one buffer variable in one scope,
    // used AS one Type via the accessors (ZeroType/Put/GetBuff/...) - and grades each. An EMPTY
    // blocker list = every touch of that buffer is a mechanical Struct rewrite (the Tier-1 subset a
    // future opt-in converter could auto-apply); otherwise each blocker names the exact reason +
    // line, the worksheet for lifting that cluster by hand. Scope-aware: a buffer name reused in
    // two methods is TWO independent clusters (each with its own local declaration); a buffer
    // declared at FILE scope is ONE "(file)" cluster whose bindings merge from every method and
    // whose grading scans the whole file (the gosub-era global-buffer style). CONSERVATIVE by
    // design - any use of the buffer beyond the accessors (Move/Length/Send/...), a missing
    // String declaration (a parameter or foreign global), a second Type on the same buffer,
    // FillType/ArrayPut/CVTtoBytes, byte-offset arithmetic on the Type, or a taken address each
    // block the cluster - so an AUTO-CONVERTIBLE verdict can be trusted. Stateless per line
    // (_SplitSourceWords / _CodeOnlyLine, no engine Tokenizer) -> unit-testable.
    // (Nils 2026-07-17, Type->Struct step 1: measure the Tier-1 subset before building the converter.)
    /* The report asks this question: is every touch of the buffer a mechanical Struct rewrite?
       A taken ADDRESS is a blocker there, and rightly - nothing it can see proves layout.
       Tier 2 asks a DIFFERENT question, for the 22 pairs where DataFlex ships the struct and
       marshals it to the same API itself, and passes bAddressIsOk True. The flag lives here
       rather than in a filter over the returned blockers because an address line raises TWO of
       them - the address AND "used outside the accessors" - and only the grader knows they are
       the same line (Nils 2026-08-31). */
    Function _TypeClustersFromLines String[] asLines String sFilePath Returns tTypeBufferCluster[]
        tTypeBufferCluster[] aOut
        // Get form, not function-style: a function-style call is resolved at COMPILE time and the
        // Ex core is defined below this wrapper.
        Get _TypeClustersFromLinesEx asLines sFilePath False to aOut
        Function_Return aOut
    End_Function

    Function _TypeClustersFromLinesEx String[] asLines String sFilePath Boolean bAddressIsOk Returns tTypeBufferCluster[]
        tTypeBufferCluster[] aOut
        tTypeBufferCluster rClu
        String[] asWords asCodeOnly asCodeLow asLineScope asBlockers asEmptyS
        String[] asKey asKeyScopeDisp asKeyBuf asDeclKey asAddrScope asAddrVar asOffTypeLow asCvtScope

        String[][] asKeyTypes
        Integer[] aiDeclLine aiAddrLine aiOffLine aiCvtLine aiKeyFirst aiKeyBind aiEmptyI
        Integer[][] aiKeyAccLines
        Boolean[] abKeyFill abKeyArrayPut abLineSkip
        String sScopeLow sScopeDisp sCode sW0 sW1 sType sBuf sKey sVar sName sCh
        String sTypeLow sBufLow sDeclKey sScopeKey sList
        Integer i iLast iN j k iKey iKeyLast iDup iLn iEsc iA iALast iOffLast iCvtLast iTypeLast
        Boolean bInType bInStruct bIsAcc bAllDigits bHit bInScopeLine

        Move (SizeOfArray(asLines) - 1) to iLast
        Move ""       to sScopeLow
        Move "(file)" to sScopeDisp
        Move False to bInType
        Move False to bInStruct

        // ---- Single walk: scopes, declarations, accessor bindings, blocker signals --------------
        For i from 0 to iLast
            If (Mod(i, 64) = 0) ;
                Send _NudgeLineProgress i (iLast + 1) "Grading buffer clusters, line:"
            Get _CodeOnlyLine asLines[i] to sCode
            Move sCode             to asCodeOnly[i]
            Move (Lowercase(sCode)) to asCodeLow[i]
            Get _SplitSourceWords asLines[i] to asWords
            Move (SizeOfArray(asWords)) to iN
            Move "" to sW0
            If (iN > 0) ;
                Move (Lowercase(asWords[0])) to sW0
            // Scope tracking: a method OPENS on its declaration line (its params belong to it) and
            // CLOSES after its End_ line (the End_ line still belongs to the method).
            If (sW0 = "procedure" or sW0 = "function") Begin
                Move "" to sName
                If (iN > 1) ;
                    Move asWords[1] to sName
                If (sW0 = "procedure" and iN > 2 and Lowercase(sName) = "set") ;
                    Move asWords[2] to sName
                Move (Lowercase(sName)) to sScopeLow
                Move sName to sScopeDisp
            End
            Move sScopeLow to asLineScope[i]
            If (sW0 = "end_procedure" or sW0 = "end_function") Begin
                Move ""       to sScopeLow
                Move "(file)" to sScopeDisp
            End
            // Type/Struct block tracking: member lines must read as neither declarations nor
            // buffer mentions (a member named like the buffer would false-block the cluster).
            If (sW0 = "type") ;
                Move True to bInType
            If (sW0 = "end_type") ;
                Move False to bInType
            If (sW0 = "struct") ;
                Move True to bInStruct
            If (sW0 = "end_struct") ;
                Move False to bInStruct
            Move (bInType = True or bInStruct = True) to abLineSkip[i]

            If (abLineSkip[i] = False and iN > 0) Begin
                // String-buffer DECLARATION: "String a b ..." / "Local String a b ..." - record each
                // declared name once per scope (all-digit tokens = legacy size args, skipped).
                Move "" to sW1
                If (iN > 1) ;
                    Move (Lowercase(asWords[1])) to sW1
                Move 0 to j
                If (sW0 = "string") ;
                    Move 1 to j
                If (sW0 = "local" and sW1 = "string") ;
                    Move 2 to j
                If (j > 0) Begin
                    While (j <= (iN - 1))
                        Move asWords[j] to sName
                        Move True to bAllDigits
                        For k from 1 to (Length(sName))
                            Move (Mid(sName, 1, k)) to sCh
                            If (sCh < "0" or sCh > "9") ;
                                Move False to bAllDigits
                        Loop
                        If (sName <> "" and bAllDigits = False) Begin
                            Move (sScopeLow + "|" + Lowercase(sName)) to sDeclKey
                            If (SearchArray(sDeclKey, asDeclKey) = -1) Begin
                                Move sDeclKey to asDeclKey[SizeOfArray(asDeclKey)]
                                Move (i + 1)  to aiDeclLine[SizeOfArray(aiDeclLine)]
                            End
                        End
                        Increment j
                    Loop
                End
                // Accessor line: bind (buffer -> Type) into its cluster. The cluster scope is the
                // buffer's DECLARATION scope: declared in this method -> method cluster; declared at
                // file scope -> the "(file)" cluster (bindings merge from every method); declared
                // nowhere (a parameter / property / foreign global) -> method cluster the post-pass
                // blocks with the no-declaration reason.
                Get _AccessorTypeBuffer asWords (&sType) (&sBuf) to bIsAcc
                If (bIsAcc = True) Begin
                    Move (Lowercase(sBuf)) to sBufLow
                    Move sScopeLow to sScopeKey
                    If (SearchArray((sScopeLow + "|" + sBufLow), asDeclKey) = -1) Begin
                        If (SearchArray(("|" + sBufLow), asDeclKey) <> -1) ;
                            Move "" to sScopeKey
                    End
                    Move (sScopeKey + "|" + sBufLow) to sKey
                    Move (SearchArray(sKey, asKey)) to iKey
                    If (iKey = -1) Begin
                        Move (SizeOfArray(asKey)) to iKey
                        Move sKey to asKey[iKey]
                        // The JAGGED parallels must be extended explicitly: reading a fresh outer
                        // element (the SizeOfArray/SearchArray on it below) before any write faults,
                        // which left the type list empty and emitted no rows at all.
                        Move asEmptyS to asKeyTypes[iKey]
                        Move aiEmptyI to aiKeyAccLines[iKey]
                        If (sScopeKey = "") ;
                            Move "(file)" to asKeyScopeDisp[iKey]
                        Else ;
                            Move sScopeDisp to asKeyScopeDisp[iKey]
                        Move sBuf     to asKeyBuf[iKey]
                        Move (i + 1)  to aiKeyFirst[iKey]
                        Move 0        to aiKeyBind[iKey]
                        Move False    to abKeyFill[iKey]
                        Move False    to abKeyArrayPut[iKey]
                    End
                    If (SearchArray(sType, asKeyTypes[iKey], Desktop, RefFunc(DFSTRICMP)) = -1) ;
                        Move sType to asKeyTypes[iKey][SizeOfArray(asKeyTypes[iKey])]
                    Increment aiKeyBind[iKey]
                    Move (i + 1) to aiKeyAccLines[iKey][SizeOfArray(aiKeyAccLines[iKey])]
                    If (sW0 = "filltype") ;
                        Move True to abKeyFill[iKey]
                    If (sW0 = "arrayput") ;
                        Move True to abKeyArrayPut[iKey]
                End
                // Byte-offset arithmetic on a Type (Offset_of_Field/Size_of_Field <Type>[.field] ...):
                // meaningless on a Struct, so it blocks every cluster of that Type. (The dotted form
                // carries the Type before the dot; the Db-API "file.field" form just records a name
                // no Type cluster will ever match.)
                If ((sW0 = "offset_of_field" or sW0 = "size_of_field") and iN > 1) Begin
                    Move asWords[1] to sVar
                    Move (Pos(".", sVar)) to k
                    If (k > 1) ;
                        Move (Left(sVar, (k - 1))) to sVar
                    Move (Lowercase(sVar)) to asOffTypeLow[SizeOfArray(asOffTypeLow)]
                    Move (i + 1)           to aiOffLine[SizeOfArray(aiOffLine)]
                End
                // CVTtoBytes is a mid-line function ("Move (CVTtoBytes(...)) to sBuf"), not a leading
                // command - detect by content on the masked split; bind it to a buffer post-pass.
                Move False to bHit
                For k from 0 to (iN - 1)
                    If (Uppercase(asWords[k]) contains "CVTTOBYTES") ;
                        Move True to bHit
                Loop
                If (bHit = True) Begin
                    Move (i + 1)   to aiCvtLine[SizeOfArray(aiCvtLine)]
                    Move sScopeLow to asCvtScope[SizeOfArray(asCvtScope)]
                End
            End
            // Address-taken vars (AddressOf(x) / GetAddress OF x) - the marshaled-to-native tell.
            Get _AddressTakenVar asLines[i] to sVar
            If (sVar <> "") Begin
                Move sScopeLow          to asAddrScope[SizeOfArray(asAddrScope)]
                Move (Lowercase(sVar))  to asAddrVar[SizeOfArray(asAddrVar)]
                Move (i + 1)            to aiAddrLine[SizeOfArray(aiAddrLine)]
            End
        Loop

        // ---- Post-pass: grade each cluster, emit one row per bound Type -------------------------
        Move (SizeOfArray(asKey) - 1) to iKeyLast
        For iKey from 0 to iKeyLast
            Move asEmptyS to asBlockers
            Move asKey[iKey] to sKey
            Move (Pos("|", sKey)) to k
            Move (Left(sKey, (k - 1)))        to sScopeKey     // "" = file scope
            Move (Lowercase(asKeyBuf[iKey]))  to sBufLow
            // (1) One buffer, one Type: a second Type on the same buffer means the byte block is
            // reused - there is no single Struct instance to rewrite to.
            If (SizeOfArray(asKeyTypes[iKey]) > 1) Begin
                Move "" to sList
                Move (SizeOfArray(asKeyTypes[iKey]) - 1) to iTypeLast
                For k from 0 to iTypeLast
                    If (sList = "") ;
                        Move asKeyTypes[iKey][k] to sList
                    Else ;
                        Move (sList + ", " + asKeyTypes[iKey][k]) to sList
                Loop
                Move ("buffer is bound to more than one Type (" + sList + ") - one buffer must map to ONE Struct instance") to asBlockers[SizeOfArray(asBlockers)]
            End
            // (2) The declaration must be in this file (its String -> Struct type change is what the
            // converter rewrites): a parameter / property / global from another file is not file-local.
            If (SearchArray((sScopeKey + "|" + sBufLow), asDeclKey) = -1 and SearchArray(("|" + sBufLow), asDeclKey) = -1) ;
                Move "no String declaration found in this file (a parameter, property, or global declared elsewhere)" to asBlockers[SizeOfArray(asBlockers)]
            // (3) Address taken -> marshaled to native code (mirrors the Type-level MARSHALED tag,
            // but scope-precise so the helper grades honestly standalone).
            Move (SizeOfArray(asAddrVar) - 1) to iALast
            Move False to bHit
            For iA from 0 to iALast
                If (bHit = False and asAddrVar[iA] = sBufLow) Begin
                    If (sScopeKey = "" or asAddrScope[iA] = sScopeKey or asAddrScope[iA] = "") Begin
                        If (bAddressIsOk = False) ;
                            Move ("the buffer's ADDRESS is taken (line " + String(aiAddrLine[iA]) + ") - it is marshaled to native code") to asBlockers[SizeOfArray(asBlockers)]
                        Move True to bHit
                    End
                End
            Loop
            // (4) Accessors with no mechanical Struct form.
            If (abKeyFill[iKey] = True) ;
                Move "FillType has no direct Struct equivalent (set the members explicitly)" to asBlockers[SizeOfArray(asBlockers)]
            If (abKeyArrayPut[iKey] = True) ;
                Move "ArrayPut writes a Struct[] array element - convert the array + index logic by hand" to asBlockers[SizeOfArray(asBlockers)]
            // (5) Byte-offset arithmetic on any of the cluster's Types.
            Move (SizeOfArray(asOffTypeLow) - 1) to iOffLast
            Move False to bHit
            For iA from 0 to iOffLast
                If (bHit = False and (SearchArray(asOffTypeLow[iA], asKeyTypes[iKey], Desktop, RefFunc(DFSTRICMP)) <> -1)) Begin
                    Move ("byte-offset arithmetic on the Type (Offset_of_Field/Size_of_Field, line " + String(aiOffLine[iA]) + ") - offsets are meaningless on a Struct") to asBlockers[SizeOfArray(asBlockers)]
                    Move True to bHit
                End
            Loop
            // (6) CVTtoBytes packing raw bytes into this buffer.
            Move (SizeOfArray(aiCvtLine) - 1) to iCvtLast
            For iA from 0 to iCvtLast
                If (sScopeKey = "" or asCvtScope[iA] = sScopeKey or asCvtScope[iA] = "") Begin
                    Get _FindKeywordPos asCodeOnly[aiCvtLine[iA] - 1] sBufLow True 1 to iLn
                    If (iLn > 0) ;
                        Move ("CVTtoBytes packs raw bytes into the buffer (line " + String(aiCvtLine[iA]) + ") - byte packing has no Struct form") to asBlockers[SizeOfArray(asBlockers)]
                End
            Loop
            // (7) Any OTHER use of the buffer (Move/Length/Send/...): the converter would change the
            // variable's type under it. Scan the cluster's scope (whole file for a file-scope buffer),
            // skipping its own accessor lines, its declaration line(s), and the CVT lines already
            // blocked above. Native-Pos pre-gate; whole-word confirm via _FindKeywordPos.
            Move 0 to iEsc
            For i from 0 to iLast
                Move False to bInScopeLine
                If (sScopeKey = "") ;
                    Move True to bInScopeLine
                Else If (asLineScope[i] = sScopeKey) ;
                    Move True to bInScopeLine
                If (bInScopeLine = True and abLineSkip[i] = False and asCodeLow[i] <> "" and (Pos(sBufLow, asCodeLow[i]) > 0)) Begin
                    Move (i + 1) to iLn
                    If (SearchArray(iLn, aiKeyAccLines[iKey]) = -1 and SearchArray(iLn, aiCvtLine) = -1) Begin
                        Move False to bHit
                        Move (SearchArray((sScopeKey + "|" + sBufLow), asDeclKey)) to iDup
                        If (iDup <> -1 and aiDeclLine[iDup] = iLn) ;
                            Move True to bHit
                        Move (SearchArray(("|" + sBufLow), asDeclKey)) to iDup
                        If (iDup <> -1 and aiDeclLine[iDup] = iLn) ;
                            Move True to bHit
                        If (bHit = False) Begin
                            Get _FindKeywordPos asCodeOnly[i] sBufLow True 1 to k
                            // ...and when a taken address is acceptable, the line that takes it is
                            // not an unknown use of the buffer either - it is the SAME line.
                            If (k > 0 and bAddressIsOk = True) Begin
                                If (SearchArray(iLn, aiAddrLine) <> -1) ;
                                    Move 0 to k
                            End
                            If (k > 0) Begin
                                Increment iEsc
                                If (iEsc <= 3) ;
                                    Move ("used outside the byte-buffer accessors (line " + String(iLn) + ": " + Left(Trim(asLines[i]), 60) + ")") to asBlockers[SizeOfArray(asBlockers)]
                            End
                        End
                    End
                End
            Loop
            If (iEsc > 3) ;
                Move ("... and " + String(iEsc - 3) + " more line(s) using the buffer outside the accessors") to asBlockers[SizeOfArray(asBlockers)]
            // Emit one graded row per Type bound in this cluster (shared blockers).
            Move (SizeOfArray(asKeyTypes[iKey]) - 1) to iTypeLast
            For k from 0 to iTypeLast
                Move asKeyTypes[iKey][k]  to rClu.sTypeName
                Move sFilePath            to rClu.sFile
                Move asKeyScopeDisp[iKey] to rClu.sScope
                Move asKeyBuf[iKey]       to rClu.sBuffer
                Move aiKeyFirst[iKey]     to rClu.iFirstLine
                Move aiKeyBind[iKey]      to rClu.iBindings
                Move asBlockers           to rClu.asBlockers
                // ...and the lines themselves, so a converter rewrites exactly what was graded.
                Move aiKeyAccLines[iKey]  to rClu.aiAccLines
                Move -1 to rClu.iDeclLine
                Move (SearchArray((sScopeKey + "|" + sBufLow), asDeclKey)) to iDup
                If (iDup = -1) ;
                    Move (SearchArray(("|" + sBufLow), asDeclKey)) to iDup
                If (iDup <> -1) ;
                    Move aiDeclLine[iDup] to rClu.iDeclLine
                Move rClu to aOut[SizeOfArray(aOut)]
            Loop
        Loop
        Function_Return aOut
    End_Function

    // Migrate one "Object ... is a dfTimer ... End_Object" block to the modern cTimer. Returns the
    // migrated lines. When the block is NOT safe to auto-migrate it sets sReason (ByRef) and returns
    // the block UNCHANGED, so the caller leaves it in place and logs the flag. Unsafe ONLY when:
    //   - "Set Timer_Message" is set (the old message-dispatch pattern; needs a hand-written OnTimer),
    //   - the OnTimer body uses its params beyond the "Forward Send OnTimer".
    // Safe blocks: swap the class, drop Auto_Start_State/Auto_Stop_State/Timer_object, rename
    // Timeout -> piTimeout, and strip the OnTimer params (declaration + Forward). A dfTimer auto-starts
    // but cTimer does not, so when the block had NO "Set Auto_Start_State to False" (it relied on the
    // default auto-start) we ALSO inject "Set pbEnabled to True" right after the class line - that is
    // mechanical, so it migrates (no longer flagged). PURE (tokenizes each line locally; no engine
    // pTokenizer state), so it is unit-testable. Caller handles Timer_Active_State.
    Function _MigrateDfTimerBlock String[] asBlock String ByRef sReason Returns String[]
        String[] asOut asParams
        String sLine sLow sT0 sT1 sDecl sNew sObjName sSelfRef sBodyIndent
        Integer i iLast iOut iN iP iPLast iPos
        Boolean bAutoStartFalse bHasMessage bParamUsed bDrop
        tTokenizer TD

        Move "" to sReason
        Move (SizeOfArray(asBlock) - 1) to iLast

        // The object name is the 2nd token of "Object <name> is a dfTimer" (asBlock[0]). Inside this
        // object's own body, "of (<name>(Self))" is a redundant self-reference we strip below.
        Move "" to sObjName
        Get Tokenizer of Self asBlock[0] to TD
        If (SizeOfArray(TD.asLineTokens) > 1) ;
            Move TD.asLineTokens[1] to sObjName

        // --- Pass 1: classify (find the unsafe patterns) ---
        Move False to bAutoStartFalse
        Move False to bHasMessage
        Move "" to sDecl
        For i from 0 to iLast
            Get Tokenizer of Self asBlock[i] to TD
            Move (SizeOfArray(TD.asLineTokens)) to iN
            Move "" to sT0
            Move "" to sT1
            If (iN > 0) ;
                Move (Lowercase(TD.asLineTokens[0])) to sT0
            If (iN > 1) ;
                Move (Lowercase(TD.asLineTokens[1])) to sT1
            If (sT0 = "set" and sT1 = "auto_start_state" and iN > 3 and (Lowercase(TD.asLineTokens[3]) = "false")) ;
                Move True to bAutoStartFalse
            If (sT0 = "set" and sT1 = "timer_message") ;
                Move True to bHasMessage
            If (sT0 = "procedure" and sT1 = "ontimer" and iN > 2) ;
                Move asBlock[i] to sDecl
        Loop

        // OnTimer param-usage: pull the param names from the declaration, then scan the body for them
        // (skipping the declaration + the Forward line). Any hit means we can't safely drop the params.
        Move False to bParamUsed
        If (sDecl <> "") Begin
            Get Tokenizer of Self sDecl to TD
            Move (SizeOfArray(TD.asLineTokens)) to iN
            Move 3 to iP                              // Procedure(0) OnTimer(1) Integer(2) name(3) Integer(4) name(5) ...
            While (iP < iN)
                If (TD.asLineTokens[iP] <> "") ;
                    Move TD.asLineTokens[iP] to asParams[SizeOfArray(asParams)]
                Move (iP + 2) to iP
            Loop
            Move (SizeOfArray(asParams) - 1) to iPLast
            For i from 0 to iLast
                Move (Lowercase(Trim(asBlock[i]))) to sLow
                If ((Left(sLow, 18) <> "procedure ontimer ") and (Left(sLow, 20) <> "forward send ontimer")) Begin
                    // Whole-token match (not substring): a short param name like "w" must not
                    // false-match every line that merely contains the letter w.
                    Get Tokenizer of Self asBlock[i] to TD
                    For iPos from 0 to iPLast
                        If (SearchArray(asParams[iPos], TD.asLineTokens, Desktop, RefFunc(DFSTRICMP)) > -1) ;
                            Move True to bParamUsed
                    Loop
                End
            Loop
        End

        If (bHasMessage = True) Begin
            Move "Uses the Timer_Message/Timer_object dispatch - rewrite OnTimer by hand." to sReason
            Function_Return asBlock
        End
        If (bParamUsed = True) Begin
            Move "OnTimer body uses its params; cTimer's OnTimer takes none - migrate by hand." to sReason
            Function_Return asBlock
        End

        // Body indentation for the injected "Set pbEnabled to True": the first non-blank body line's
        // leading whitespace, else the object's own indent + 4 spaces.
        Move "" to sBodyIndent
        For i from 1 to (iLast - 1)
            If (sBodyIndent = "" and Trim(asBlock[i]) <> "") Begin
                Move (Pos(Trim(asBlock[i]), asBlock[i])) to iPos
                If (iPos > 1) ;
                    Move (Left(asBlock[i], (iPos - 1))) to sBodyIndent
            End
        Loop
        If (sBodyIndent = "") Begin
            Move (Pos(Trim(asBlock[0]), asBlock[0])) to iPos
            If (iPos > 1) ;
                Move (Left(asBlock[0], (iPos - 1)) + "    ") to sBodyIndent
            Else ;
                Move "    " to sBodyIndent
        End

        // --- Pass 2: safe mechanical migration ---
        Move 0 to iOut
        For i from 0 to iLast
            Move asBlock[i] to sLine
            Get Tokenizer of Self sLine to TD
            Move (SizeOfArray(TD.asLineTokens)) to iN
            Move "" to sT0
            Move "" to sT1
            If (iN > 0) ;
                Move (Lowercase(TD.asLineTokens[0])) to sT0
            If (iN > 1) ;
                Move (Lowercase(TD.asLineTokens[1])) to sT1
            // Drop the properties cTimer has no equivalent for (their effect is cTimer's default).
            Move False to bDrop
            If (sT0 = "set" and (sT1 = "auto_start_state" or sT1 = "auto_stop_state" or sT1 = "timer_object")) ;
                Move True to bDrop
            If (bDrop = False) Begin
                Move sLine to sNew
                // Class swap: replace the WHOLE-WORD "dfTimer" (the class, or a "dfTimer" word in a
                // comment) -> "cTimer". A bare Pos matched the prefix of the IDE-generated object NAME
                // "dfTimer23" (renaming the object to cTimer23 and leaving the class), so use the
                // boundary-aware _FindKeywordPos - it skips "dfTimer" inside "dfTimer23" and lands on the
                // standalone class token.
                Get _FindKeywordPos sNew "dfTimer" True 1 to iPos
                If (iPos > 0) ;
                    Move (Left(sNew, (iPos - 1)) + "cTimer" + Mid(sNew, Length(sNew), (iPos + 7))) to sNew
                // Timeout -> piTimeout, only on a "Set Timeout ..." line (Timeout is a common word elsewhere)
                If (sT0 = "set" and sT1 = "timeout") Begin
                    Move (Pos("timeout", Lowercase(sNew))) to iPos
                    If (iPos > 0) ;
                        Move (Left(sNew, (iPos - 1)) + "piTimeout" + Mid(sNew, Length(sNew), (iPos + 7))) to sNew
                End
                // strip the OnTimer params on the declaration and the Forward (cTimer's OnTimer has none)
                If ((sT0 = "procedure" and sT1 = "ontimer") or (sT0 = "forward" and sT1 = "send")) Begin
                    Move (Pos("ontimer", Lowercase(sNew))) to iPos
                    If (iPos > 0) ;
                        Move (Left(sNew, (iPos + 6))) to sNew
                End
                // Strip the redundant self-reference: inside this object's own body, "of (oTimer1(Self))"
                // just points back at itself. External refs (another object's "of <obj>") are untouched.
                If (sObjName <> "") Begin
                    Move ("of (" + Lowercase(sObjName) + "(self))") to sSelfRef
                    Move (Pos(sSelfRef, Lowercase(sNew))) to iPos
                    If (iPos > 1) ;
                        Move (Left(sNew, (iPos - 2)) + Mid(sNew, Length(sNew), (iPos + Length(sSelfRef)))) to sNew
                End
                Move sNew to asOut[iOut]
                Increment iOut
                // dfTimer auto-started; cTimer does not. When this object relied on that default
                // (no "Set Auto_Start_State to False"), inject "Set pbEnabled to True" right after the
                // class line so the migrated timer still runs on creation.
                If (i = 0 and bAutoStartFalse = False) Begin
                    Move (sBodyIndent + "Set pbEnabled to True    // dfTimer auto-started; cTimer needs this to run") to asOut[iOut]
                    Increment iOut
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* ======================================================================================
       strmark / strlen - the side products of the legacy string commands.

       The shared engine of ChangeStrMarkToExpression / ChangeStrLenToExpression (published in
       oRefactorFuncLib). What a command leaves in the two predefined variables was MEASURED on
       the DataFlex 26 run time (2026-09-08), not read off the docs' character-mode text:

           command                         strmark               strlen                    Found
           Pos n in h [to d]               Pos(n, h)             Length(h) - strmark + 1   strmark > 0
           Replace o in v with n           Pos(o, v), BEFORE     Length(v) - strmark + 1   strmark > 0
           Left s to d c / Pad s to d c    c                     -                         -
           Right s to d c                  -                     c                         -
           Mid s to d l st                 st                    l                         -
           Insert x in v at p              p                     -                         -
           Left/Right/Mid/Pad, count-less  unchanged (the command TAKES the value)          -
           Sysdate, File_Size, Page,
           Index_Def                       set, underivable      set, underivable          -
           every FUNCTION form             untouched             untouched                 untouched

       "Not found" leaves 0 and Length + 1, which is exactly what the two expressions give, so
       one expression covers both outcomes. Nothing else (Append, Length, Trim, Uppercase, ...)
       touches them.

       A READ is rewritten as the expression of the nearest preceding setter in the same method:
       in place after Pos (the operands are still what they were), and by MOVING a plain 'Move
       strmark to x' above a Replace (the value exists only before the replacement). A WRITE
       ('... to strmark') is a scratch use of the global, so the method gets a local instead -
       iStrMark / iStrLen when it reads the value back, iVoid (the run time's own name for a
       discarded return) when it never does. What the table cannot answer keeps its line and
       gets a trailing '// TODO (DFRefactor): NOT converted - <reason>', which the Deep Scan and
       the analyzer both read as the outcome. The helpers below are ordered callee-first.
       ====================================================================================== */

    // Identifier characters as legacy DataFlex spells a NAME: letters, digits, '_', and the '$',
    // '#' and '.' old code carries inside names (Dates$Year, fn#, File.Field). Wider than the
    // lexer's _IsIdentifierChar on purpose - a whole name must travel as one word here.
    Function _StrVarIdentChar String sCh Returns Boolean
        If (sCh = "") ;
            Function_Return False
        Function_Return (Pos(Lowercase(sCh), "abcdefghijklmnopqrstuvwxyz0123456789_$#.") > 0)
    End_Function

    // The text between two 1-based positions (inclusive), trimmed; "" for an empty span.
    Function _StrVarSpan String sText Integer iFrom Integer iTo Returns String
        If (iTo < iFrom or iFrom < 1) ;
            Function_Return ""
        Function_Return (Trim(Mid(sText, (iTo - iFrom + 1), iFrom)))
    End_Function

    // The leading whitespace (spaces and tabs) of a line.
    Function _StrVarIndentOf String sLine Returns String
        Integer i iLen iEnd
        String sCh

        Move (Length(sLine)) to iLen
        Move 0 to iEnd
        Move 1 to i
        While (i <= iLen)
            Move (Mid(sLine, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) Begin
                Move i to iEnd
                Increment i
            End
            Else Begin
                Move (iLen + 1) to i
            End
        Loop
        Function_Return (Left(sLine, iEnd))
    End_Function

    // The whitespace-delimited word that ENDS just before position iPos of sLow; "" at line start.
    Function _StrVarPrevWord String sLow Integer iPos Returns String
        Integer i
        String sWord sCh

        Move (iPos - 1) to i
        While (i >= 1 and (Mid(sLow, 1, i) = " " or Mid(sLow, 1, i) = Character(9)))
            Decrement i
        Loop
        Move "" to sWord
        While (i >= 1)
            Move (Mid(sLow, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) Begin
                Move 0 to i
            End
            Else Begin
                Move (sCh + sWord) to sWord
                Decrement i
            End
        Loop
        Function_Return sWord
    End_Function

    // The whitespace-delimited word that STARTS at or after position iFrom of sLow; "" when none.
    Function _StrVarNextWord String sLow Integer iFrom Returns String
        Integer i iLen
        String sWord sCh

        Move (Length(sLow)) to iLen
        Move iFrom to i
        While (i <= iLen and (Mid(sLow, 1, i) = " " or Mid(sLow, 1, i) = Character(9)))
            Increment i
        Loop
        Move "" to sWord
        While (i <= iLen)
            Move (Mid(sLow, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) Begin
                Move (iLen + 1) to i
            End
            Else Begin
                Move (sWord + sCh) to sWord
                Increment i
            End
        Loop
        Function_Return sWord
    End_Function

    // Parenthesis depth in front of position iPos of a code-only line - 0 for a bare token.
    Function _StrVarParenDepthAt String sCode Integer iPos Returns Integer
        Integer i iDepth
        String sCh

        Move 0 to iDepth
        For i from 1 to (iPos - 1)
            Move (Mid(sCode, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            If (sCh = ")") ;
                Decrement iDepth
        Loop
        Function_Return iDepth
    End_Function

    // Whole-word position of sWordLow in sLowCode from iStart on, with the wide identifier set
    // above; 0 when it does not occur as a word.
    Function _StrVarWholeWordPos String sLowCode String sWordLow Integer iStart Returns Integer
        Integer iLen iWordLen iRel iPos iStartAt
        String sRest
        Boolean bBefore bAfter

        Move (Length(sLowCode)) to iLen
        Move (Length(sWordLow)) to iWordLen
        If (iWordLen = 0) ;
            Function_Return 0
        Move iStart to iStartAt
        If (iStartAt < 1) ;
            Move 1 to iStartAt
        While (iStartAt <= iLen)
            Move (Mid(sLowCode, (iLen - iStartAt + 1), iStartAt)) to sRest
            Move (Pos(sWordLow, sRest)) to iRel
            If (iRel = 0) ;
                Function_Return 0
            Move (iStartAt + iRel - 1) to iPos
            Move False to bBefore
            Move False to bAfter
            If (iPos > 1) ;
                Get _StrVarIdentChar (Mid(sLowCode, 1, (iPos - 1))) to bBefore
            If ((iPos + iWordLen) <= iLen) ;
                Get _StrVarIdentChar (Mid(sLowCode, 1, (iPos + iWordLen))) to bAfter
            If (bBefore = False and bAfter = False) ;
                Function_Return iPos
            Move (iPos + 1) to iStartAt
        Loop
        Function_Return 0
    End_Function

    // The identifier WORDS of a masked operand text, in their source casing - the names whose
    // change between the command and the read would make the derived value wrong. A name followed
    // by '(' is a function call and is skipped (the Trim in 'Pos(Trim(x), s)' is no operand); so
    // are numbers.
    Function _StrVarWordsOf String sMasked Returns String[]
        String[] asWords
        String sWord sCh
        Integer i iLen iNext
        Boolean bIdent bCall bNumber

        Move (Length(sMasked)) to iLen
        Move 1 to i
        While (i <= iLen)
            Move (Mid(sMasked, 1, i)) to sCh
            Get _StrVarIdentChar sCh to bIdent
            If (bIdent = False) Begin
                Increment i
            End
            Else Begin
                Move "" to sWord
                While (i <= iLen and bIdent = True)
                    Move (Mid(sMasked, 1, i)) to sCh
                    Get _StrVarIdentChar sCh to bIdent
                    If (bIdent = True) Begin
                        Move (sWord + sCh) to sWord
                        Increment i
                    End
                Loop
                Move i to iNext
                While (iNext <= iLen and Mid(sMasked, 1, iNext) = " ")
                    Increment iNext
                Loop
                Move False to bCall
                If (iNext <= iLen) ;
                    Move (Mid(sMasked, 1, iNext) = "(") to bCall
                Move (Pos(Left(sWord, 1), "0123456789.") > 0) to bNumber
                If (bCall = False and bNumber = False) ;
                    Move sWord to asWords[SizeOfArray(asWords)]
            End
        Loop
        Function_Return asWords
    End_Function

    // The first of asWords the code-only line mentions as a whole word (in its source casing), or
    // "" when none. A File.Field is also 'mentioned' by a Find / Clear / Relate line, which changes
    // the buffer without naming the field.
    Function _StrVarLineMentions String sLowCode String[] ByRef asWords Returns String
        Integer i iMax iPos
        String sWord sLow sFirst

        Move (SizeOfArray(asWords) - 1) to iMax
        If (iMax < 0 or Trim(sLowCode) = "") ;
            Function_Return ""
        Get _NthWord sLowCode 1 to sFirst
        For i from 0 to iMax
            Move asWords[i] to sWord
            Move (Lowercase(sWord)) to sLow
            If (Pos(".", sLow) > 0) Begin
                If (sFirst = "find" or sFirst = "clear" or sFirst = "relate" or sFirst = "refind" or sFirst = "vfind" or sFirst = "constrained_find" or sFirst = "clear_relate" or sFirst = "attach") ;
                    Function_Return sWord
            End
            Get _StrVarWholeWordPos sLowCode sLow 1 to iPos
            If (iPos > 0) ;
                Function_Return sWord
        Loop
        Function_Return ""
    End_Function

    // The first of asWords whose VALUE the code-only line changes: a destination ('... to x'), a
    // ByRef argument ('&x'), the operand of a command that rewrites its argument in place (Append,
    // Uppercase, Lowercase, Increment, Decrement, ZeroString, ZeroType, Sysdate, Systime, Read,
    // Readln, Input, Accept, Fill, and the 'in' variable of Replace / Insert), or a File.Field on a
    // Find / Clear / Relate line, which changes the buffer without naming the field. "" when none -
    // a line that only READS the word leaves the derived value valid.
    Function _StrVarLineChanges String sLowCode String[] ByRef asWords Returns String
        Integer i iMax iPos iLen
        String sWord sLow sFirst sPrev sInVar sOperand
        String[] asMutators

        Move (SizeOfArray(asWords) - 1) to iMax
        If (iMax < 0 or Trim(sLowCode) = "") ;
            Function_Return ""
        Get _NthWord sLowCode 1 to sFirst
        Move (StrSplitToArray("append|uppercase|lowercase|increment|decrement|zerostring|zerotype|sysdate|systime|read|readln|input|accept|read_block|fill", "|")) to asMutators
        Move "" to sOperand
        If (SearchArray(sFirst, asMutators) >= 0) ;
            Get _NthWord sLowCode 2 to sOperand
        Move "" to sInVar
        If (sFirst = "replace" or sFirst = "insert") Begin
            Get _FindKeywordPos sLowCode "in" True 1 to iPos
            If (iPos > 0) ;
                Get _StrVarNextWord sLowCode (iPos + 2) to sInVar
        End
        For i from 0 to iMax
            Move asWords[i] to sWord
            Move (Lowercase(sWord)) to sLow
            Move (Length(sLow)) to iLen
            If (Pos(".", sLow) > 0) Begin
                If (sFirst = "find" or sFirst = "clear" or sFirst = "relate" or sFirst = "refind" or sFirst = "vfind" or sFirst = "constrained_find" or sFirst = "clear_relate" or sFirst = "attach") ;
                    Function_Return sWord
            End
            If (sLow = sOperand or sLow = sInVar) ;
                Function_Return sWord
            Get _StrVarWholeWordPos sLowCode sLow 1 to iPos
            While (iPos > 0)
                Get _StrVarPrevWord sLowCode iPos to sPrev
                If (sPrev = "to") ;
                    Function_Return sWord
                If (iPos > 1) Begin
                    If (Mid(sLowCode, 1, (iPos - 1)) = "&") ;
                        Function_Return sWord
                End
                Get _StrVarWholeWordPos sLowCode sLow (iPos + iLen) to iPos
            Loop
        Loop
        Function_Return ""
    End_Function

    // A line that opens or closes a block, loops, jumps, returns, raises, continues onto the next
    // line or is a compiler directive - a moved 'Move strmark to x' must not cross one of these.
    Function _StrVarIsBlockBoundary String sLowCode Returns Boolean
        String sTrim sFirst
        String[] asWords
        Integer iLen
        Boolean bIdent

        Move (Lowercase(Trim(sLowCode))) to sTrim
        If (sTrim = "") ;
            Function_Return False
        If (Right(sTrim, 1) = ";") ;
            Function_Return True
        Get _NthWord sTrim 1 to sFirst
        If (Left(sFirst, 1) = "#") ;
            Function_Return True
        Move (StrSplitToArray("begin|end|else|case|for|while|repeat|until|loop|object|end_object|procedure|function|end_procedure|end_function|goto|gosub|return|procedure_return|function_return|abort|error", "|")) to asWords
        If (SearchArray(sFirst, asWords) >= 0) ;
            Function_Return True
        // a trailing 'begin' opens a block whatever precedes it: If (x) Begin, Else Begin, [ind] Begin
        Move (Length(sTrim)) to iLen
        If (iLen >= 5 and Right(sTrim, 5) = "begin") Begin
            If (iLen = 5) ;
                Function_Return True
            Get _StrVarIdentChar (Mid(sTrim, 1, (iLen - 5))) to bIdent
            Function_Return (bIdent = False)
        End
        Function_Return False
    End_Function

    // Positions of the top-level commas from sLow[iFrom] (the character after an opening paren) to
    // its matching ')'; returns that ')' position, 0 when the paren never closes.
    Function _StrVarSplitTopLevel String sLow Integer iFrom Integer[] ByRef aiCommas Returns Integer
        Integer i iLen iDepth
        String sCh
        Integer[] aiEmpty

        Move aiEmpty to aiCommas
        Move (Length(sLow)) to iLen
        Move 0 to iDepth
        For i from iFrom to iLen
            Move (Mid(sLow, 1, i)) to sCh
            If (sCh = "(") Begin
                Increment iDepth
            End
            Else If (sCh = ")") Begin
                If (iDepth = 0) ;
                    Function_Return i
                Decrement iDepth
            End
            Else If (sCh = "," and iDepth = 0) Begin
                Move i to aiCommas[SizeOfArray(aiCommas)]
            End
        Loop
        Function_Return 0
    End_Function

    // The whitespace-separated tokens between positions iFrom and iTo of sLow, a parenthesised
    // group counting as ONE token; their positions come back in aiStart / aiEnd (inclusive).
    Function _StrVarTopTokens String sLow Integer iFrom Integer iTo Integer[] ByRef aiStart Integer[] ByRef aiEnd Returns Integer
        Integer i iDepth iCount
        String sCh
        Boolean bIn
        Integer[] aiEmpty

        Move aiEmpty to aiStart
        Move aiEmpty to aiEnd
        Move 0 to iDepth
        Move False to bIn
        Move 0 to iCount
        If (iTo > Length(sLow)) ;
            Move (Length(sLow)) to iTo
        For i from iFrom to iTo
            Move (Mid(sLow, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            If (sCh = ")") ;
                Decrement iDepth
            If ((sCh = " " or sCh = Character(9)) and iDepth <= 0) Begin
                If (bIn = True) Begin
                    Move (i - 1) to aiEnd[iCount - 1]
                    Move False to bIn
                End
            End
            Else Begin
                If (bIn = False) Begin
                    Move i to aiStart[iCount]
                    Move 0 to aiEnd[iCount]
                    Increment iCount
                    Move True to bIn
                End
            End
        Loop
        If (bIn = True) ;
            Move iTo to aiEnd[iCount - 1]
        Function_Return iCount
    End_Function

    // One redundant outer parenthesis pair off an operand - '(Trim(x))' -> 'Trim(x)' - so a built
    // call reads Pos(Trim(x), s), not Pos((Trim(x)), s). A word, a literal or a call comes back as is.
    Function _StrVarUnwrap String sExpr Returns String
        Boolean bGroup

        Move (Trim(sExpr)) to sExpr
        Get _IsSingleParenGroup sExpr to bGroup
        If (bGroup = True and Length(sExpr) > 2) ;
            Move (Trim(Mid(sExpr, (Length(sExpr) - 2), 2))) to sExpr
        Function_Return sExpr
    End_Function

    // The expression a command leaves in sVarLow ("strmark" / "strlen") - "" when that command
    // leaves the variable alone. sNeedle / sHay are the Pos / Replace operands, sArg the count or
    // position argument of the other commands (for Mid the caller passes the one that matters).
    Function _StrVarExprFor String sCmd String sVarLow String sNeedle String sHay String sArg Returns String
        String sN sH
        Boolean bMark

        Move (sVarLow = "strmark") to bMark
        If (sCmd = "pos" or sCmd = "replace") Begin
            Get _StrVarUnwrap sNeedle to sN
            Get _StrVarUnwrap sHay to sH
            If (sN = "" or sH = "") ;
                Function_Return ""
            If (bMark = True) ;
                Function_Return ("Pos(" + sN + ", " + sH + ")")
            Function_Return ("(Length(" + sH + ") - Pos(" + sN + ", " + sH + ") + 1)")
        End
        If (Trim(sArg) = "") ;
            Function_Return ""
        If (bMark = True) Begin
            If (sCmd = "left" or sCmd = "pad" or sCmd = "insert" or sCmd = "mid") ;
                Function_Return (Trim(sArg))
        End
        Else Begin
            If (sCmd = "right" or sCmd = "mid") ;
                Function_Return (Trim(sArg))
        End
        Function_Return ""
    End_Function

    // Parses one string command whose keyword sits at iKw of sLow (the code-only line, lowercased):
    // its operands as raw source text (from sLine - same positions) and as masked text (from
    // sCode). True when the line has the command's shape; an empty count / position operand is the
    // command's count-less form.
    Function _StrVarParseCommand String sLine String sCode String sLow String sCmd Integer iKw tStrVarOperands ByRef Ops Returns Boolean
        Integer iAfter iIn iTo iWith iAt iLen iEnd iC
        Integer[] aiStart aiEnd
        tStrVarOperands OpsEmpty

        Move OpsEmpty to Ops
        Move (Length(sLow)) to iLen
        Move (iKw + Length(sCmd)) to iAfter
        If (iAfter > iLen) ;
            Function_Return (sCmd = "sysdate" or sCmd = "page")
        If (Mid(sLow, 1, iAfter) <> " " and Mid(sLow, 1, iAfter) <> Character(9)) ;
            Function_Return False
        If (sCmd = "sysdate" or sCmd = "file_size" or sCmd = "page" or sCmd = "index_def") ;
            Function_Return True
        If (sCmd = "pos" or sCmd = "replace" or sCmd = "insert") Begin
            Get _FindKeywordPos sLow "in" True iAfter to iIn
            If (iIn = 0) ;
                Function_Return False
            Get _StrVarSpan sLine iAfter (iIn - 1) to Ops.sNeedle
            Get _StrVarSpan sCode iAfter (iIn - 1) to Ops.sNeedleMasked
            If (Ops.sNeedle = "") ;
                Function_Return False
            If (sCmd = "pos") Begin
                Get _FindKeywordPos sLow "to" True (iIn + 2) to iTo
                If (iTo > 0) Begin
                    Move (iTo - 1) to iEnd
                End
                Else Begin
                    Move iLen to iEnd
                End
                Get _StrVarSpan sLine (iIn + 2) iEnd to Ops.sHay
                Get _StrVarSpan sCode (iIn + 2) iEnd to Ops.sHayMasked
                Function_Return (Ops.sHay <> "")
            End
            If (sCmd = "replace") Begin
                Get _FindKeywordPos sLow "with" True (iIn + 2) to iWith
                If (iWith = 0) ;
                    Function_Return False
                Get _StrVarSpan sLine (iIn + 2) (iWith - 1) to Ops.sHay
                Get _StrVarSpan sCode (iIn + 2) (iWith - 1) to Ops.sHayMasked
                Function_Return (Ops.sHay <> "")
            End
            Get _FindKeywordPos sLow "at" True (iIn + 2) to iAt
            If (iAt = 0) ;
                Function_Return False
            Get _StrVarSpan sLine (iIn + 2) (iAt - 1) to Ops.sHay
            Get _StrVarSpan sCode (iIn + 2) (iAt - 1) to Ops.sHayMasked
            Get _StrVarSpan sLine (iAt + 2) iLen to Ops.sArg
            Get _StrVarSpan sCode (iAt + 2) iLen to Ops.sArgMasked
            Function_Return (Ops.sHay <> "" and Ops.sArg <> "")
        End
        // left / right / pad / mid: '<source> to <destination> [<count> [<start>]]'
        Get _FindKeywordPos sLow "to" True iAfter to iTo
        If (iTo = 0) ;
            Function_Return False
        Get _StrVarSpan sLine iAfter (iTo - 1) to Ops.sNeedle
        If (Ops.sNeedle = "") ;
            Function_Return False
        Get _StrVarTopTokens sLow (iTo + 2) iLen (&aiStart) (&aiEnd) to iC
        If (iC < 1) ;
            Function_Return False
        If (sCmd = "mid") Begin
            If (iC > 3) ;
                Function_Return False
            If (iC >= 2) Begin
                Get _StrVarSpan sLine (aiStart[1]) (aiEnd[1]) to Ops.sArg
                Get _StrVarSpan sCode (aiStart[1]) (aiEnd[1]) to Ops.sArgMasked
            End
            If (iC = 3) Begin
                Get _StrVarSpan sLine (aiStart[2]) (aiEnd[2]) to Ops.sArg2
                Get _StrVarSpan sCode (aiStart[2]) (aiEnd[2]) to Ops.sArg2Masked
            End
            Function_Return True
        End
        If (iC > 2) ;
            Function_Return False
        If (iC = 2) Begin
            Get _StrVarSpan sLine (aiStart[1]) (aiEnd[1]) to Ops.sArg
            Get _StrVarSpan sCode (aiStart[1]) (aiEnd[1]) to Ops.sArgMasked
        End
        Function_Return True
    End_Function

    // A converted command - 'Move (Pos(n, h)) to d' or 'Move (Replace(o, v, n)) to v', the exact
    // shapes the command converters emit: "pos" / "replace" with the operands, "" for any other
    // line. The function forms never set strmark / strlen, so a read after one is already stale;
    // taking the line as the producer restores the value the command used to leave.
    Function _StrVarFunctionForm String sLine String sCode String sLow tStrVarOperands ByRef Ops Returns String
        Integer iLastTo iPos iAfter iOpen i iParen iClose iLen iCommaCount iGroupEnd
        Integer[] aiCommas
        String sGroup sCmd sDest
        Boolean bGroup
        tStrVarOperands OpsEmpty

        Move OpsEmpty to Ops
        Move (Length(sLow)) to iLen
        Get _FindKeywordPos sLow "move" True 1 to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (iPos + 4) to iAfter
        Move 0 to iLastTo
        Get _FindKeywordPos sLow "to" True iAfter to iPos
        While (iPos > 0)
            Move iPos to iLastTo
            Get _FindKeywordPos sLow "to" True (iPos + 2) to iPos
        Loop
        If (iLastTo = 0) ;
            Function_Return ""
        Get _StrVarSpan sLow iAfter (iLastTo - 1) to sGroup
        Get _IsSingleParenGroup sGroup to bGroup
        If (bGroup = False) ;
            Function_Return ""
        // the group's '(' and the call name right after it
        Move iAfter to iOpen
        While (iOpen < iLastTo and Mid(sLow, 1, iOpen) <> "(")
            Increment iOpen
        Loop
        Move (iOpen + 1) to i
        While (i < iLastTo and Mid(sLow, 1, i) = " ")
            Increment i
        Loop
        Move "" to sCmd
        Move 0 to iParen
        If (Mid(sLow, 3, i) = "pos") Begin
            Move "pos" to sCmd
            Move (i + 3) to iParen
        End
        Else If (Mid(sLow, 7, i) = "replace") Begin
            Move "replace" to sCmd
            Move (i + 7) to iParen
        End
        If (sCmd = "") ;
            Function_Return ""
        While (iParen < iLastTo and Mid(sLow, 1, iParen) = " ")
            Increment iParen
        Loop
        If (Mid(sLow, 1, iParen) <> "(") ;
            Function_Return ""
        Get _StrVarSplitTopLevel sLow (iParen + 1) (&aiCommas) to iClose
        If (iClose = 0) ;
            Function_Return ""
        // the call must be the WHOLE group: only blanks between its ')' and the group's ')'
        Move (iClose + 1) to iGroupEnd
        While (iGroupEnd < iLastTo and Mid(sLow, 1, iGroupEnd) = " ")
            Increment iGroupEnd
        Loop
        If (Mid(sLow, 1, iGroupEnd) <> ")") ;
            Function_Return ""
        Move (SizeOfArray(aiCommas)) to iCommaCount
        If (sCmd = "pos") Begin
            If (iCommaCount <> 1) ;
                Function_Return ""
            Get _StrVarSpan sLine (iParen + 1) (aiCommas[0] - 1) to Ops.sNeedle
            Get _StrVarSpan sCode (iParen + 1) (aiCommas[0] - 1) to Ops.sNeedleMasked
            Get _StrVarSpan sLine (aiCommas[0] + 1) (iClose - 1) to Ops.sHay
            Get _StrVarSpan sCode (aiCommas[0] + 1) (iClose - 1) to Ops.sHayMasked
        End
        Else Begin
            If (iCommaCount <> 2) ;
                Function_Return ""
            Get _StrVarSpan sLine (iParen + 1) (aiCommas[0] - 1) to Ops.sNeedle
            Get _StrVarSpan sCode (iParen + 1) (aiCommas[0] - 1) to Ops.sNeedleMasked
            Get _StrVarSpan sLine (aiCommas[0] + 1) (aiCommas[1] - 1) to Ops.sHay
            Get _StrVarSpan sCode (aiCommas[0] + 1) (aiCommas[1] - 1) to Ops.sHayMasked
            // the converter's own shape puts the result back into the 'in' variable
            Get _StrVarSpan sLow (iLastTo + 2) iLen to sDest
            If (sDest <> Lowercase(Ops.sHayMasked)) ;
                Function_Return ""
        End
        If (Ops.sNeedle = "" or Ops.sHay = "") ;
            Function_Return ""
        Function_Return sCmd
    End_Function

    // What one source line does to sVarLow ("strmark" / "strlen"): whether it reads it, writes it,
    // modifies it, sets it as a string command's side product (and to which expression), takes it
    // as a count-less command's count, or sets it to something no expression can state. sCode is
    // the line's code-only twin (_StrVarCodeLines), position-aligned with sLine.
    Function _StrVarLineInfo String sLine String sCode String sVarLow Returns tStrVarLineInfo
        tStrVarLineInfo Info
        tStrVarOperands Ops OpsTry
        String[] asCmds asWords
        String sLow sFirst sPrev sCmd sHit
        Integer iPos iLen iKw i iBest
        Boolean bMark bShape

        Move (Lowercase(sCode)) to sLow
        Move (Length(sLow)) to iLen
        Move (sVarLow = "strmark") to bMark
        If (Trim(sLow) = "") ;
            Function_Return Info
        Get _NthWord sLow 1 to sFirst

        // 1. the variable's own occurrences: a destination (write), Increment/Decrement, or a read
        Get _FindKeywordPos sLow sVarLow True 1 to iPos
        While (iPos > 0)
            Get _StrVarPrevWord sLow iPos to sPrev
            If (sPrev = "to") Begin
                Move True to Info.bWrite
                Move True to Info.bSets
            End
            Else If ((sFirst = "increment" or sFirst = "decrement") and sPrev = sFirst) Begin
                Move True to Info.bModifies
                Move True to Info.bSets
            End
            Else Begin
                Move True to Info.bReads
            End
            Get _FindKeywordPos sLow sVarLow True (iPos + Length(sVarLow)) to iPos
        Loop

        // 2. the string command on the line - at command position, or behind a one-line guard
        Move (StrSplitToArray("pos|replace|left|right|mid|insert|pad|sysdate|file_size|page|index_def", "|")) to asCmds
        Move "" to sCmd
        Move 0 to iKw
        If (SearchArray(sFirst, asCmds) >= 0) Begin
            Move (Pos(sFirst, sLow)) to iKw
            Get _StrVarParseCommand sLine sCode sLow sFirst iKw (&Ops) to bShape
            If (bShape = True) ;
                Move sFirst to sCmd
        End
        Else Begin
            Move 0 to iBest
            For i from 0 to (SizeOfArray(asCmds) - 1)
                Get _FindKeywordPos sLow (asCmds[i]) True 1 to iPos
                If (iPos > 0 and (iBest = 0 or iPos < iBest)) Begin
                    Get _StrVarParseCommand sLine sCode sLow (asCmds[i]) iPos (&OpsTry) to bShape
                    If (bShape = True) Begin
                        Move iPos to iBest
                        Move asCmds[i] to sCmd
                        Move OpsTry to Ops
                    End
                End
            Loop
            Move iBest to iKw
            If (sCmd <> "") ;
                Move True to Info.bHasPrefix
        End

        // 3. what that command leaves behind
        If (sCmd <> "") Begin
            Move sCmd to Info.sCommand
            If (sCmd = "sysdate" or sCmd = "file_size" or sCmd = "page" or sCmd = "index_def") Begin
                Move True to Info.bOpaque
                Move True to Info.bSets
            End
            Else If (sCmd = "pos" or sCmd = "replace") Begin
                Get _StrVarExprFor sCmd sVarLow Ops.sNeedle Ops.sHay "" to Info.sExpr
                Get _StrVarExprFor sCmd sVarLow Ops.sNeedleMasked Ops.sHayMasked "" to Info.sExprMasked
                If (Info.sExpr <> "") ;
                    Move True to Info.bSets
                Move (sCmd = "replace") to Info.bReorderOnly
            End
            Else If (sCmd = "insert") Begin
                If (bMark = True) Begin
                    Move Ops.sArg to Info.sExpr
                    Move Ops.sArgMasked to Info.sExprMasked
                    Move True to Info.bSets
                    // a position computed from the very string Insert changes exists only before it
                    Get _StrVarWordsOf Ops.sHayMasked to asWords
                    Get _StrVarLineMentions (Lowercase(Ops.sArgMasked)) (&asWords) to sHit
                    Move (sHit <> "") to Info.bReorderOnly
                End
            End
            Else If (sCmd = "mid") Begin
                If (bMark = True) Begin
                    If (Ops.sArg2 <> "") Begin
                        Move Ops.sArg2 to Info.sExpr
                        Move Ops.sArg2Masked to Info.sExprMasked
                        Move True to Info.bSets
                    End
                    Else Begin
                        Move True to Info.bConsumes
                    End
                End
                Else Begin
                    If (Ops.sArg <> "") Begin
                        Move Ops.sArg to Info.sExpr
                        Move Ops.sArgMasked to Info.sExprMasked
                        Move True to Info.bSets
                    End
                    Else Begin
                        Move True to Info.bConsumes
                    End
                End
            End
            Else If (sCmd = "left" or sCmd = "pad") Begin
                If (bMark = True) Begin
                    If (Ops.sArg <> "") Begin
                        Move Ops.sArg to Info.sExpr
                        Move Ops.sArgMasked to Info.sExprMasked
                        Move True to Info.bSets
                    End
                    Else Begin
                        Move True to Info.bConsumes
                    End
                End
            End
            Else If (sCmd = "right") Begin
                If (bMark = False) Begin
                    If (Ops.sArg <> "") Begin
                        Move Ops.sArg to Info.sExpr
                        Move Ops.sArgMasked to Info.sExprMasked
                        Move True to Info.bSets
                    End
                    Else Begin
                        Move True to Info.bConsumes
                    End
                End
            End
        End
        Else If (sFirst = "move" and Info.bWrite = False) Begin
            // 4. a converted command (the function form) - the exact shapes the command converters emit
            Get _StrVarFunctionForm sLine sCode sLow (&Ops) to sCmd
            If (sCmd <> "") Begin
                Move sCmd to Info.sCommand
                Move True to Info.bFunctionForm
                Get _StrVarExprFor sCmd sVarLow Ops.sNeedle Ops.sHay "" to Info.sExpr
                Get _StrVarExprFor sCmd sVarLow Ops.sNeedleMasked Ops.sHayMasked "" to Info.sExprMasked
                If (Info.sExpr <> "") ;
                    Move True to Info.bSets
                Move (sCmd = "replace") to Info.bReorderOnly
            End
        End
        Function_Return Info
    End_Function

    // The code-only twin of every line: string literals blanked and '//' comments cut
    // (_CodeOnlyLine, position-preserving), DF 23 block comments and report images blanked whole -
    // the line contract the Deep Scan uses (cDeepScanner ScanLines), so scan and fix read one text.
    Function _StrVarCodeLines String[] ByRef asCode Returns String[]
        String[] asOnly
        Boolean bInBlock bInImage bHit
        Integer i iMax

        Move False to bInBlock
        Move False to bInImage
        Move (SizeOfArray(asCode) - 1) to iMax
        Move (ResizeArray(asOnly, (iMax + 1))) to asOnly
        For i from 0 to iMax
            Get _CodeOnlyLine (asCode[i]) to asOnly[i]
            If (bInImage = True) Begin
                Get IsImageEnd (asCode[i]) to bHit
                If (bHit = True) ;
                    Move False to bInImage
                Move "" to asOnly[i]
            End
            Else Begin
                Get IsImageStart (asCode[i]) to bHit
                If (bHit = True) Begin
                    Move True to bInImage
                    Move "" to asOnly[i]
                End
                Else If (bInBlock = True) Begin
                    Get _BlockCommentOpenAtEnd (asCode[i]) True to bInBlock
                    Move "" to asOnly[i]
                End
                Else Begin
                    Get _IsDF23CommentStart (asCode[i]) to bHit
                    If (bHit = True) Begin
                        Move "" to asOnly[i]
                        Get _BlockCommentOpenAtEnd (asCode[i]) False to bInBlock
                    End
                End
            End
        Loop
        Function_Return asOnly
    End_Function

    // A line that already carries a DFRefactor marker: a converter has been here and said why.
    Function _StrVarMarked String sLine Returns Boolean
        String sLow

        Move (Lowercase(sLine)) to sLow
        If (sLow contains "(dfrefactor)") ;
            Function_Return ((sLow contains "todo") or (sLow contains "note"))
        Function_Return False
    End_Function

    // The line with the trailing skip-marker the Deep Scan and the analyzer both honour.
    Function _StrVarMark String sLine String sReason Returns String
        Function_Return (sLine + "   // TODO (DFRefactor): NOT converted - " + sReason)
    End_Function

    // The derived expression as it goes into a line: a call or a compound expression is
    // parenthesised at depth 0 ('Move (Pos(n, h)) to x'); inside an existing expression, or when it
    // is one word or already one group, it goes in as it is.
    Function _StrVarWrapForDepth String sExpr Integer iDepth Returns String
        Boolean bGroup

        Move (Trim(sExpr)) to sExpr
        If (iDepth > 0) ;
            Function_Return sExpr
        Get _IsSingleParenGroup sExpr to bGroup
        If (bGroup = True) ;
            Function_Return sExpr
        If (Pos(" ", sExpr) = 0 and Pos("(", sExpr) = 0) ;
            Function_Return sExpr
        Function_Return ("(" + sExpr + ")")
    End_Function

    // Every READ of sVarLow on the line replaced by sExpr (right to left, so the positions hold);
    // the destination of a '... to strmark' and an Increment/Decrement operand are not reads.
    Function _StrVarSubstituteReads String sLine String sCode String sVarLow String sExpr Returns String
        Integer[] aiPos
        Integer iPos i iDepth iLen
        String sLow sPrev sFirst sIns
        Boolean bSkip

        Move (Lowercase(sCode)) to sLow
        Get _NthWord sLow 1 to sFirst
        Move (Length(sVarLow)) to iLen
        Get _FindKeywordPos sLow sVarLow True 1 to iPos
        While (iPos > 0)
            Get _StrVarPrevWord sLow iPos to sPrev
            Move (sPrev = "to") to bSkip
            If ((sFirst = "increment" or sFirst = "decrement") and sPrev = sFirst) ;
                Move True to bSkip
            If (bSkip = False) ;
                Move iPos to aiPos[SizeOfArray(aiPos)]
            Get _FindKeywordPos sLow sVarLow True (iPos + iLen) to iPos
        Loop
        Move (SizeOfArray(aiPos) - 1) to i
        While (i >= 0)
            Move aiPos[i] to iPos
            Get _StrVarParenDepthAt sCode iPos to iDepth
            Get _StrVarWrapForDepth sExpr iDepth to sIns
            Move (Left(sLine, (iPos - 1)) + sIns + Mid(sLine, CI_EOL, (iPos + iLen))) to sLine
            Decrement i
        Loop
        Function_Return sLine
    End_Function

    // Every occurrence of sVarLow on the line (any role) renamed to sNew - the scratch-variable path.
    Function _StrVarRenameAll String sLine String sCode String sVarLow String sNew Returns String
        Integer[] aiPos
        Integer iPos i iLen
        String sLow

        Move (Lowercase(sCode)) to sLow
        Move (Length(sVarLow)) to iLen
        Get _FindKeywordPos sLow sVarLow True 1 to iPos
        While (iPos > 0)
            Move iPos to aiPos[SizeOfArray(aiPos)]
            Get _FindKeywordPos sLow sVarLow True (iPos + iLen) to iPos
        Loop
        Move (SizeOfArray(aiPos) - 1) to i
        While (i >= 0)
            Move aiPos[i] to iPos
            Move (Left(sLine, (iPos - 1)) + sNew + Mid(sLine, CI_EOL, (iPos + iLen))) to sLine
            Decrement i
        Loop
        Function_Return sLine
    End_Function

    // The destination of a plain 'Move strmark to x' line - exactly four words - or "" for any
    // other shape (a guard, an expression, a second statement: none of those can move above a Replace).
    Function _StrVarPlainMoveDest String sCode String sVarLow Returns String
        String sW1 sW2 sW3 sW4 sW5

        Get _NthWord sCode 1 to sW1
        Get _NthWord sCode 2 to sW2
        Get _NthWord sCode 3 to sW3
        Get _NthWord sCode 4 to sW4
        Get _NthWord sCode 5 to sW5
        If (Lowercase(sW1) = "move" and Lowercase(sW2) = sVarLow and Lowercase(sW3) = "to" and sW4 <> "" and sW5 = "") ;
            Function_Return sW4
        Function_Return ""
    End_Function

    // One method (iStart = its header line, iEnd = its End_ line): every read / write of sVarLow
    // decided and applied by the rules in the block comment above. Edits are collected first and
    // applied bottom-up, so no index moves under a pending one; asOnly (the code-only twins) is
    // kept in step. Returns the change in line count.
    Function _StrVarProcessMethod String[] ByRef asCode String[] ByRef asOnly Integer iStart Integer iEnd String sVarLow Integer ByRef iConverted Integer ByRef iMarked Integer ByRef iRenamed Integer ByRef iStale Returns Integer
        tStrVarLineInfo[] aInfo
        tStrVarLineInfo Info Setter
        String[] asRepl asAbove asWords asParts asDest
        Boolean[] abRepl abDel abRename
        String sReason sDest sHit sNew sIndent sLocal sTail sLow
        Integer i j k iHdrEnd iSet iDelta iFirstBody
        Boolean bHasConsumer bNeedLocal bReadsBack bFound bBoundary bDeclared

        // the header may continue over ';' lines; the body starts after the last of them
        Move iStart to iHdrEnd
        While (iHdrEnd < iEnd and Right(Trim(asOnly[iHdrEnd]), 1) = ";")
            Increment iHdrEnd
        Loop
        Move (ResizeArray(aInfo, (iEnd + 1)))    to aInfo
        Move (ResizeArray(asRepl, (iEnd + 1)))   to asRepl
        Move (ResizeArray(asAbove, (iEnd + 1)))  to asAbove
        Move (ResizeArray(abRepl, (iEnd + 1)))   to abRepl
        Move (ResizeArray(abDel, (iEnd + 1)))    to abDel
        Move (ResizeArray(abRename, (iEnd + 1))) to abRename

        // pass 1: what every body line does to the variable
        Move False to bHasConsumer
        For i from (iHdrEnd + 1) to (iEnd - 1)
            Get _StrVarLineInfo (asCode[i]) (asOnly[i]) sVarLow to aInfo[i]
            If (aInfo[i].bConsumes = True) ;
                Move True to bHasConsumer
        Loop

        // pass 2: decide every read and write
        Move False to bReadsBack
        For i from (iHdrEnd + 1) to (iEnd - 1)
            Move aInfo[i] to Info
            If (Info.bReads = True or Info.bWrite = True or Info.bModifies = True) Begin
                Get _StrVarMarked (asCode[i]) to bFound
                If (bFound = False) Begin
                    Move "" to sReason
                    If (Info.bModifies = True) Begin
                        Move "changed in place (Increment/Decrement) - rewrite by hand" to sReason
                    End
                    Else If (Info.bWrite = True) Begin
                        If (bHasConsumer = True) Begin
                            Move ("the value feeds a count-less string command in this method (it takes its count from " + sVarLow + ") - kept as the global") to sReason
                        End
                        Else Begin
                            Move True to abRename[i]
                            If (Info.bReads = True) ;
                                Move True to bReadsBack
                        End
                    End
                    Else Begin
                        // a read: the nearest line above that leaves a value in the variable
                        Move -1 to iSet
                        Move (i - 1) to j
                        While (j > iHdrEnd and iSet < 0)
                            If (aInfo[j].bSets = True) ;
                                Move j to iSet
                            Decrement j
                        Loop
                        If (iSet < 0) Begin
                            Move ("no string command sets " + sVarLow + " earlier in this method - the value comes from elsewhere") to sReason
                        End
                        Else Begin
                            Move aInfo[iSet] to Setter
                            If (Setter.bOpaque = True) Begin
                                Move ("set by the " + Setter.sCommand + " command above - a value no expression can state") to sReason
                            End
                            Else If (Setter.bModifies = True) Begin
                                Move ("follows an Increment/Decrement of " + sVarLow + " - rewrite by hand") to sReason
                            End
                            Else If (Setter.bHasPrefix = True) Begin
                                Move ("set by a conditional " + Setter.sCommand + " above (a one-line If) - which value reaches this line is a run-time question") to sReason
                            End
                            Else If (Setter.bWrite = True) Begin
                                If (bHasConsumer = True) Begin
                                    Move ("reads a value this method wrote to " + sVarLow + " itself, in a method that also feeds it to a count-less string command - kept as the global") to sReason
                                End
                                Else Begin
                                    Move True to abRename[i]
                                    Move True to bReadsBack
                                End
                            End
                            Else If (Setter.sExpr = "") Begin
                                Move ("the " + Setter.sCommand + " command above leaves no value in " + sVarLow) to sReason
                            End
                            Else Begin
                                // the operands must still be what the command saw
                                Get _StrVarWordsOf Setter.sExprMasked to asWords
                                Move "" to sHit
                                For k from (iSet + 1) to (i - 1)
                                    If (sHit = "") ;
                                        Get _StrVarLineChanges (Lowercase(asOnly[k])) (&asWords) to sHit
                                Loop
                                If (sHit <> "") Begin
                                    Move (sHit + " is changed between the " + Setter.sCommand + " above and this line - the derived value would be wrong") to sReason
                                End
                                Else If (Setter.bReorderOnly = True) Begin
                                    Get _StrVarPlainMoveDest (asOnly[i]) sVarLow to sDest
                                    If (sDest = "") Begin
                                        Move ("read after a " + Setter.sCommand + ", whose " + sVarLow + " exists only before it runs - only a plain 'Move " + sVarLow + " to x' can move above it; rewrite by hand") to sReason
                                    End
                                    Else Begin
                                        Move False to bBoundary
                                        Move (ResizeArray(asDest, 0)) to asDest
                                        Move sDest to asDest[0]
                                        Move "" to sHit
                                        For k from (iSet + 1) to (i - 1)
                                            If (bBoundary = False) ;
                                                Get _StrVarIsBlockBoundary (asOnly[k]) to bBoundary
                                            If (sHit = "") ;
                                                Get _StrVarLineMentions (Lowercase(asOnly[k])) (&asDest) to sHit
                                        Loop
                                        If (bBoundary = True) Begin
                                            Move ("a block boundary (Begin/End, a loop, a jump or a return) lies between the " + Setter.sCommand + " above and this line - the moved assignment would run at the wrong time") to sReason
                                        End
                                        Else If (sHit <> "") Begin
                                            Move (sDest + " is used between the " + Setter.sCommand + " above and this line - the moved assignment would change it too early") to sReason
                                        End
                                        Else Begin
                                            Get _StrVarIndentOf (asCode[iSet]) to sIndent
                                            Get _StrVarWrapForDepth Setter.sExpr 0 to sNew
                                            Move (sIndent + "Move " + sNew + " to " + sDest) to sNew
                                            // the read line's own trailing comment travels with it
                                            Move (Trim(Mid(asCode[i], CI_EOL, (Length(asOnly[i]) + 1)))) to sTail
                                            If (sTail <> "") ;
                                                Move (sNew + "  " + sTail) to sNew
                                            If (asAbove[iSet] = "") Begin
                                                Move sNew to asAbove[iSet]
                                            End
                                            Else Begin
                                                Move (asAbove[iSet] + Character(1) + sNew) to asAbove[iSet]
                                            End
                                            Move True to abDel[i]
                                            Increment iConverted
                                            If (Setter.bFunctionForm = True) ;
                                                Increment iStale
                                        End
                                    End
                                End
                                Else Begin
                                    Get _StrVarSubstituteReads (asCode[i]) (asOnly[i]) sVarLow Setter.sExpr to asRepl[i]
                                    Move True to abRepl[i]
                                    Increment iConverted
                                    If (Setter.bFunctionForm = True) ;
                                        Increment iStale
                                End
                            End
                        End
                    End
                    If (sReason <> "") Begin
                        Get _StrVarMark (asCode[i]) sReason to asRepl[i]
                        Move True to abRepl[i]
                        Increment iMarked
                    End
                End
            End
        Loop

        // pass 3: the scratch uses become a local
        Move False to bNeedLocal
        Move False to bDeclared
        Move "" to sLocal
        For i from (iHdrEnd + 1) to (iEnd - 1)
            If (abRename[i] = True) ;
                Move True to bNeedLocal
        Loop
        If (bNeedLocal = True) Begin
            If (bReadsBack = True) Begin
                If (sVarLow = "strmark") Begin
                    Move "iStrMark" to sLocal
                End
                Else Begin
                    Move "iStrLen" to sLocal
                End
            End
            Else Begin
                Move "iVoid" to sLocal
            End
            // declared or in use already? then only the rename
            For i from iStart to iEnd
                If (bDeclared = False) Begin
                    If (_FindKeywordPos(Self, Lowercase(asOnly[i]), Lowercase(sLocal), True, 1) > 0) ;
                        Move True to bDeclared
                End
            Loop
            For i from (iHdrEnd + 1) to (iEnd - 1)
                If (abRename[i] = True) Begin
                    Get _StrVarRenameAll (asCode[i]) (asOnly[i]) sVarLow sLocal to asRepl[i]
                    Move True to abRepl[i]
                    Increment iRenamed
                End
            Loop
        End

        // pass 4: apply, bottom-up
        Move 0 to iDelta
        Move (iEnd - 1) to i
        While (i > iHdrEnd)
            If (abDel[i] = True) Begin
                Move (RemoveFromArray(asCode, i)) to asCode
                Move (RemoveFromArray(asOnly, i)) to asOnly
                Decrement iDelta
            End
            Else If (abRepl[i] = True) Begin
                Move asRepl[i] to asCode[i]
                Get _CodeOnlyLine (asRepl[i]) to asOnly[i]
            End
            If (asAbove[i] <> "") Begin
                Move (StrSplitToArray(asAbove[i], Character(1))) to asParts
                Move (SizeOfArray(asParts) - 1) to k
                While (k >= 0)
                    Move (InsertInArray(asCode, i, asParts[k])) to asCode
                    Get _CodeOnlyLine (asParts[k]) to sLow
                    Move (InsertInArray(asOnly, i, sLow)) to asOnly
                    Increment iDelta
                    Decrement k
                Loop
            End
            Decrement i
        Loop

        // pass 5: the local's declaration, first line of the body
        If (bNeedLocal = True and bDeclared = False) Begin
            Move -1 to iFirstBody
            For k from (iHdrEnd + 1) to (iEnd + iDelta - 1)
                If (iFirstBody < 0 and Trim(asCode[k]) <> "") ;
                    Move k to iFirstBody
            Loop
            If (iFirstBody >= 0) Begin
                Get _StrVarIndentOf (asCode[iFirstBody]) to sIndent
            End
            Else Begin
                Get _StrVarIndentOf (asCode[iStart]) to sIndent
                Move (sIndent + "    ") to sIndent
            End
            Move (sIndent + "Integer " + sLocal) to sNew
            Move (InsertInArray(asCode, (iHdrEnd + 1), sNew)) to asCode
            Move (InsertInArray(asOnly, (iHdrEnd + 1), sNew)) to asOnly
            Increment iDelta
        End
        Function_Return iDelta
    End_Function

    // The whole-file pass shared by ChangeStrMarkToExpression / ChangeStrLenToExpression: each
    // method in turn (_StrVarProcessMethod); a use outside every method gets the marker, since no
    // local can stand in for the global there. Returns the lines rewritten (a marker is not one).
    Function _StrVarToExpression String[] ByRef asCode String sVarLow String sFnName Returns Integer
        String[] asOnly
        String sLeaf sNote
        Integer i iEnd iDelta iConverted iMarked iRenamed iStale iSize iPos iRefreshed
        Boolean bHit bStart bEnd bFound
        tStrVarLineInfo Info

        /* Rewriting a read is exactly what makes the Pos / Replace guard's marker above it
           untrue, so re-state or remove those markers first. It runs BEFORE the gate below
           because a file can carry a marker and no longer carry the variable at all - and a
           marker left standing keeps Deep Scan and the analyzer quiet about a command line
           that is ready to convert. (2026-09-08.) */
        Get _SideProductRefreshMarks (&asCode) to iRefreshed
        Get _FileContainsText (&asCode) sVarLow to bHit
        If (bHit = False) ;
            Function_Return iRefreshed
        Get _StrVarCodeLines (&asCode) to asOnly
        Move 0 to iConverted
        Move 0 to iMarked
        Move 0 to iRenamed
        Move 0 to iStale
        Move 0 to i
        While (i < SizeOfArray(asCode))
            Move (SizeOfArray(asCode)) to iSize
            // per-file progress: the bar fills as the pass walks (a no-op without the panel)
            If (Mod(i, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(i + 1) * "of:" * String(iSize))
                Set piPosition of ghoProgressBar to (i + 1)
            End
            Get _IsMethodStart (asOnly[i]) to bStart
            If (bStart = True) Begin
                Move i to iEnd
                Move False to bEnd
                While (iEnd < (iSize - 1) and bEnd = False)
                    Increment iEnd
                    Get _IsMethodEnd (asOnly[iEnd]) to bEnd
                Loop
                Get _StrVarProcessMethod (&asCode) (&asOnly) i iEnd sVarLow (&iConverted) (&iMarked) (&iRenamed) (&iStale) to iDelta
                Move (iEnd + iDelta + 1) to i
            End
            Else Begin
                Get _StrVarLineInfo (asCode[i]) (asOnly[i]) sVarLow to Info
                If (Info.bReads = True or Info.bWrite = True or Info.bModifies = True) Begin
                    Get _StrVarMarked (asCode[i]) to bFound
                    If (bFound = False) Begin
                        Get _StrVarMark (asCode[i]) (sVarLow + " is used outside a procedure or function - no local can stand in for the global here; rewrite by hand") to asCode[i]
                        Increment iMarked
                    End
                End
                Increment i
            End
        Loop

        If ((iConverted + iMarked + iRenamed + iRefreshed) > 0) Begin
            Move "" to sLeaf
            If (ghoEngine <> 0) Begin
                Get psCurrentSourceFileName of ghoEngine to sLeaf
                Move (Length(sLeaf)) to iPos
                While (iPos > 0 and Mid(sLeaf, 1, iPos) <> Character(92) and Mid(sLeaf, 1, iPos) <> "/")
                    Decrement iPos
                Loop
                If (iPos > 0) ;
                    Move (Mid(sLeaf, CI_EOL, (iPos + 1))) to sLeaf
                If (sLeaf <> "") ;
                    Move (sLeaf + ": ") to sLeaf
            End
            If ((iConverted + iMarked + iRenamed) > 0) Begin
                Move (sLeaf + String(iConverted) + " read(s) of " + sVarLow + " rewritten as the expression the string command left, " + String(iRenamed) + " line(s) moved to a local, " + String(iMarked) + " left with a TODO marker (the reason is on the line).") to sNote
                Send AddRunNote sFnName sNote
            End
            If (iRefreshed > 0) ;
                Send AddRunNote sFnName (sLeaf + String(iRefreshed) + " string command line(s) carried the side-product guard's TODO marker and no longer need it as it stood - the reads it named are gone or have changed. The marker came off (or now names what is left), so the command can convert on the next run.")
            If (iStale > 0) ;
                Send AddRunNote sFnName (sLeaf + String(iStale) + " of those reads followed a Pos() / Replace() FUNCTION line - the function never sets " + sVarLow + ", so the read was already stale (a converted string command leaves its side product behind); it now computes what the command would have left. Check the intent.")
        End
        Function_Return (iConverted + iRenamed + iRefreshed)
    End_Function

    /* ---- THE SIDE PRODUCTS OF THE LEGACY STRING COMMANDS ---------------------------------------

       Measured on DataFlex 26 with a scratch program (2026-09-08), not read off the docs:

         command                    strmark               strlen                     Found
         Pos n in h [to d]          Pos(n, h)             Length(h) - strmark + 1    strmark > 0
         Replace o in v with n      Pos(o, v), BEFORE     Length(v) - strmark + 1    strmark > 0
         Left / Pad s to d c        c                     -                          -
         Right s to d c             -                     c                          -
         Mid s to d l st            st                    l                          -
         Insert x in v at p         p                     -                          -
         every FUNCTION form        untouched             untouched                  untouched

       The last row is why this exists. A converter that rewrites the command as its function form
       drops all three, and the result still compiles: a following 'If [Found]' or 'Move strmark to
       i' goes on reading whatever happened to be there. A workspace's date parser stopped
       decomposing dates exactly that way, with no error and no warning (Nils, 2026-09-08).

       So a command converter asks _SideProductVeto before it rewrites the line. When something
       below still reads what the conversion would drop, the line is LEFT AS IT IS and takes the
       trailing '// TODO (DFRefactor): NOT converted - <reason>' marker that Deep Scan and the
       analyzer both honour - so the row is demoted out of the plan instead of being offered for
       ever, and the reason travels with the code instead of living in a run note nobody keeps.

       FindErr is deliberately NOT one of the products. It belongs to the find machinery, not to
       the string commands, so a '[FindErr]' below a Replace reads what a Find left and the
       conversion cannot change it.

       The look-ahead needs what a line-by-line function is never handed: the lines after its own.
       The engine stashes the file in pasLinePassSource and the current index in piLinePassIndex -
       once per file and once per line, and only when a converter that asks for them is selected
       (see _NoteIfLookAheadNeeded in cRefactorEngine). On every other path - the unit tests, the
       test bench, the analyzer's single-line dry run - the array is empty, the veto answers
       "convert", and each converter behaves exactly as it did before it was wired up.

       Cost. pbLinePassSideProducts is the per-file gate. Reading the array costs a full copy, as
       every property Get of a String[] does, so the walk is paid ONCE PER CONFIRMED LEGACY COMMAND
       LINE - after every shape gate, never per line - and not at all on a file that mentions none
       of the three names.

       Four limits, stated rather than hidden:
         - the walk runs FORWARD to the end of the method, so a read that only executes on a
           backward jump (a reader ABOVE the command inside a loop) is not seen;
         - a message send is not a setter of Found here, so the walk carries on past it and can
           decline a line it need not have;
         - a read inside a '#IF' arm the compiler drops still counts as a read - the directive is
           not evaluated;
         - a command line whose code ends in ';' continues onto the next line, so no comment can go
           after it: such a line is declined SILENTLY, with no marker.
       Only the first can be wrong in the dangerous direction. The others over-decline, and an
       over-decline costs a comment, never a behaviour change.  */

    // The side products a legacy string COMMAND leaves behind, '|'-separated and lowercase. "" for
    // a command that leaves none - Length, Trim, Uppercase, Lowercase, Ascii, Character, ZeroString
    // and anything that is not one of the six - so the shared workers can call the veto for every
    // keyword they handle and pay nothing for the nine that have nothing to lose.
    Function _SideProductsOf String sCmdLow Returns String
        Move (Lowercase(Trim(sCmdLow))) to sCmdLow
        If (sCmdLow = "pos" or sCmdLow = "replace") ;
            Function_Return "found|strmark|strlen"
        If (sCmdLow = "mid") ;
            Function_Return "strmark|strlen"
        If (sCmdLow = "left" or sCmdLow = "pad" or sCmdLow = "insert") ;
            Function_Return "strmark"
        If (sCmdLow = "right") ;
            Function_Return "strlen"
        Function_Return ""
    End_Function

    // The command a published converter converts, "" when it converts nothing that leaves a side
    // product behind. ONE list, so the engine's per-run gate, the analyzer's whole-file dry run and
    // the veto itself cannot drift on which converters need the look-ahead.
    Function _SideProductCommandOfFunction String sFnName Returns String
        String sLow

        Move (Lowercase(Trim(sFnName))) to sLow
        If (sLow = "changeposcommandtofunction") ;
            Function_Return "pos"
        If (sLow = "changereplacecommandtofunction") ;
            Function_Return "replace"
        If (sLow = "changeleftcommandtofunction") ;
            Function_Return "left"
        If (sLow = "changerightcommandtofunction") ;
            Function_Return "right"
        If (sLow = "changemidcommandtofunction") ;
            Function_Return "mid"
        If (sLow = "changepadcommandtofunction") ;
            Function_Return "pad"
        If (sLow = "changeinsertcommandtofunction") ;
            Function_Return "insert"
        Function_Return ""
    End_Function

    // The opening words of the marker this guard writes - its SIGNATURE, so a later run can tell
    // its own marker from a hand-written comment and from another converter's. ONE definition; the
    // sentence builder and the marker reader both come here for it.
    Function _SideProductMarkSignature Returns String
        Function_Return "the code below still reads "
    End_Function

    // A code-only line's relation to the Found indicator: 2 = it SETS Found (a database find, a
    // Clear / Relate / Attach, an 'Indicate Found as ...', or another Pos / Replace COMMAND),
    // 1 = it READS Found, 0 = neither. A dotted '.Found' is a struct or object member, not the
    // indicator, and a longer name (bFound, NotFound, FoundRec) never matches - the test is
    // whole-word. The setter list is deliberately SHORT: an unrecognised line counts as neither, so
    // the walk carries on and the converter declines rather than converts, which is the safe way to
    // be wrong.
    Function _FoundUseOnLine String sCode Returns Integer
        String sLow sFirst sSecond
        Integer iPos
        String[] asSetters

        Move (Lowercase(sCode)) to sLow
        If (Trim(sLow) = "") ;
            Function_Return 0
        Get _NthWord sLow 1 to sFirst
        Get _NthWord sLow 2 to sSecond
        // 'Indicate Found as (x)' WRITES the indicator - a setter, not a reader.
        If (sFirst = "indicate" and sSecond = "found") ;
            Function_Return 2
        Get _FindKeywordPos sLow "found" True 1 to iPos
        While (iPos > 0)
            If (iPos = 1) ;
                Function_Return 1
            If (Mid(sLow, 1, (iPos - 1)) <> ".") ;
                Function_Return 1
            Get _FindKeywordPos sLow "found" True (iPos + 5) to iPos
        Loop
        Move (StrSplitToArray("find|refind|vfind|find_by_index|find_by_recnum|constrained_find|clear|clear_relate|relate|attach|pos|replace", "|")) to asSetters
        If (SearchArray(sFirst, asSetters) >= 0) ;
            Function_Return 2
        Function_Return 0
    End_Function

    // The same three-way answer for strmark / strlen, taken off the tStrVarLineInfo that the
    // strmark / strlen converters already build for a line - so the two features cannot drift on
    // what counts as a read. A count-less Left / Right / Mid / Pad CONSUMES the variable, which is
    // a read; Increment / Decrement both read and write, and the read wins.
    Function _StrVarUseOnLine String sLine String sCode String sVarLow Returns Integer
        tStrVarLineInfo Info

        Get _StrVarLineInfo sLine sCode sVarLow to Info
        If (Info.bReads = True or Info.bConsumes = True or Info.bModifies = True) ;
            Function_Return 1
        If (Info.bSets = True or Info.bWrite = True) ;
            Function_Return 2
        Function_Return 0
    End_Function

    // Which of the side products in sProducts ('|'-separated) the code BELOW line iLine still
    // reads before anything sets them again: "Found", "strmark", "strlen" or a '|'-joined list of
    // them in that order, and "" when every one of them is dead or re-set - the answer that lets
    // the line convert. The walk stops at the end of the enclosing method and at the next method's
    // header (in DataFlex either ender closes either method), skips DF23 block comments, image
    // blocks and macro code, and drops a product from the watch list the moment a line sets it.
    // Which lines are code is the file walk's answer (aInfo - ScanSourceFile, made once
    // per file with the lines, pasLinePassSource): macro code (#COMMAND / #DATA blocks and directive
    // lines - never refactored, and not run-time code either), #HEADER regions and a DF 23 multi-line
    // string's text and closing line are skipped as block comments and images are (2026-10-29) - text
    // that reads 'End_Procedure' or 'Found' is neither. A walk that is not this file's is made here.
    Function _SideProductsReadBelow String[] ByRef asCode tLineInfo[] ByRef aInfo Integer iLine String sProducts Returns String
        Integer i iMax iUse
        String sRaw sCode sTrim sList
        Boolean bGo bHit
        Boolean bWatchFound bWatchMark bWatchLen bReadFound bReadMark bReadLen

        Move (SizeOfArray(asCode) - 1) to iMax
        If (iLine < 0 or iLine >= iMax) ;
            Function_Return ""
        Move (Pos("found",   sProducts) > 0) to bWatchFound
        Move (Pos("strmark", sProducts) > 0) to bWatchMark
        Move (Pos("strlen",  sProducts) > 0) to bWatchLen
        If (bWatchFound = False and bWatchMark = False and bWatchLen = False) ;
            Function_Return ""

        If (SizeOfArray(aInfo) <> SizeOfArray(asCode)) ;
            Get ScanSourceFile (&asCode) to aInfo
        Move True  to bGo
        Move (iLine + 1) to i
        While (i <= iMax and bGo = True)
            If (aInfo[i].eMacro = MC_None and (aInfo[i].eKind = LK_Code or aInfo[i].eKind = LK_StringOpener)) Begin
                Move asCode[i] to sRaw
                Move (Trim(Replaces(Character(9), sRaw, " "))) to sTrim
                If (sTrim <> "" and Left(sTrim, 1) <> "#") Begin
                    Get _CodeOnlyLine sRaw to sCode
                    If (Trim(sCode) <> "") Begin
                        Get _IsMethodEnd sCode to bHit
                        If (bHit = False) ;
                            Get _IsMethodStart sCode to bHit
                        If (bHit = True) Begin
                            Move False to bGo
                        End
                        Else Begin
                            If (bWatchFound = True) Begin
                                Get _FoundUseOnLine sCode to iUse
                                If (iUse = 1) Begin
                                    Move True  to bReadFound
                                    Move False to bWatchFound
                                End
                                Else If (iUse = 2) ;
                                    Move False to bWatchFound
                            End
                            If (bWatchMark = True) Begin
                                Get _StrVarUseOnLine sRaw sCode "strmark" to iUse
                                If (iUse = 1) Begin
                                    Move True  to bReadMark
                                    Move False to bWatchMark
                                End
                                Else If (iUse = 2) ;
                                    Move False to bWatchMark
                            End
                            If (bWatchLen = True) Begin
                                Get _StrVarUseOnLine sRaw sCode "strlen" to iUse
                                If (iUse = 1) Begin
                                    Move True  to bReadLen
                                    Move False to bWatchLen
                                End
                                Else If (iUse = 2) ;
                                    Move False to bWatchLen
                            End
                            If (bWatchFound = False and bWatchMark = False and bWatchLen = False) ;
                                Move False to bGo
                        End
                    End
                End
            End
            Increment i
        Loop

        Move "" to sList
        If (bReadFound = True) ;
            Move "Found" to sList
        If (bReadMark = True) Begin
            If (sList <> "") ;
                Move (sList + "|") to sList
            Move (sList + "strmark") to sList
        End
        If (bReadLen = True) Begin
            If (sList <> "") ;
                Move (sList + "|") to sList
            Move (sList + "strlen") to sList
        End
        Function_Return sList
    End_Function

    // The command name as it appears in the marker sentence: "replace" -> "Replace".
    Function _SideProductCommandCased String sCmdLow Returns String
        Move (Lowercase(Trim(sCmdLow))) to sCmdLow
        If (sCmdLow = "") ;
            Function_Return ""
        Function_Return (Uppercase(Left(sCmdLow, 1)) + Mid(sCmdLow, CI_EOL, 2))
    End_Function

    // The marker sentence for a command that would drop the products in sList ('|'-separated, as
    // _SideProductsReadBelow returns them). It opens with the signature above, names what is read
    // and which function form leaves it untouched, and says what to run - the whole reason, on the
    // line, in words a maintainer can act on without opening this program. It also names the
    // COMMAND, which is how a re-run tells its own marker from one left by a different converter on
    // the same line.
    Function _SideProductReason String sCmdLow String sList Returns String
        String sNames sHelp sIt sReason sCmd
        String[] asNames
        Integer i iMax

        Move (StrSplitToArray(sList, "|")) to asNames
        Move (SizeOfArray(asNames) - 1) to iMax
        Move "" to sNames
        For i from 0 to iMax
            If (i = 0) ;
                Move asNames[i] to sNames
            Else If (i = iMax) ;
                Move (sNames + " and " + asNames[i]) to sNames
            Else ;
                Move (sNames + ", " + asNames[i]) to sNames
        Loop
        If (iMax > 0) ;
            Move "them" to sIt
        Else ;
            Move "it" to sIt

        Move "" to sHelp
        If ((sList contains "strmark") or (sList contains "strlen")) ;
            Move "ChangeStrMarkToExpression / ChangeStrLenToExpression rewrite those reads" to sHelp
        If (sList contains "Found") Begin
            If (sHelp <> "") ;
                Move (sHelp + "; ") to sHelp
            Move (sHelp + "Found has no converter - after Pos / Replace it is (Pos(needle, haystack) > 0)") to sHelp
        End

        Get _SideProductCommandCased sCmdLow to sCmd
        Get _SideProductMarkSignature to sReason
        Move (sReason + sNames + " - the " + sCmd + "() function leaves " + sIt + " untouched. " + sHelp + ". Then delete this comment.") to sReason
        Function_Return sReason
    End_Function

    // Where this guard's own marker starts in sLine (the position of its '//'), 0 when the line
    // carries no marker of ours. Only an exact signature match counts, so a hand-written comment
    // and another converter's marker are never rewritten or removed.
    Function _SideProductMarkPos String sLine Returns Integer
        Integer iSig iSlash
        String sSig

        Get _SideProductMarkSignature to sSig
        Move (Pos(sSig, sLine)) to iSig
        If (iSig = 0) ;
            Function_Return 0
        Move iSig to iSlash
        While (iSlash >= 1 and Mid(sLine, 2, iSlash) <> "//")
            Decrement iSlash
        Loop
        If (iSlash < 1) ;
            Function_Return 0
        Function_Return iSlash
    End_Function

    // THE GATE every command converter passes through, once it has established that the line really
    // is the command and BEFORE it rewrites anything.
    //
    // True means leave the line as it is. bMarked comes back True when this call put the marker
    // there, re-stated a marker whose reason had changed, or took one off - the converter returns
    // that value, so the engine re-tokenizes the line, writes the file and counts it once. It comes
    // back False when the line already carried exactly the right marker: a re-run then adds
    // nothing and the file stays byte-identical.
    //
    // The guard also takes its own marker OFF again. Once the reads it named have been converted or
    // deleted the line is free and converts on that very pass - otherwise the marker would go on
    // keeping Deep Scan and the analyzer quiet about a line that is ready, and the command would
    // stay legacy for good.
    Function _SideProductVeto String ByRef sLine String sCmdLow Boolean ByRef bMarked Returns Boolean
        String sProducts sList sReason sOld sFn sCode sMine
        String[] asSrc
        tLineInfo[] aSrcInfo
        Integer iLine iPos
        Boolean bAny

        Move False to bMarked
        Get _SideProductsOf sCmdLow to sProducts
        If (sProducts = "") ;
            Function_Return False
        Get _SideProductMarkPos sLine to iPos
        // Someone else's refusal already stands here. Do not convert over it (that would carry a
        // "NOT converted" comment into converted code) and do not stack a second marker beside it.
        If (iPos = 0 and (Lowercase(sLine) contains "not converted -")) ;
            Function_Return True
        If (iPos > 0) Begin
            // Our marker, but written for a different command on this line - leave it to its owner.
            Get _SideProductCommandCased sCmdLow to sMine
            Move (Mid(sLine, CI_EOL, iPos)) to sOld
            If ((sOld contains ("the " + sMine + "() function")) = False) ;
                Function_Return True
        End

        Get pbLinePassSideProducts to bAny
        Get piLinePassIndex to iLine
        Move "" to sList
        If (bAny = True and iLine >= 0) Begin
            Get pasLinePassSource to asSrc
            Get paLinePassInfo to aSrcInfo
            Get _SideProductsReadBelow (&asSrc) (&aSrcInfo) iLine sProducts to sList
        End

        If (sList = "") Begin
            // Nothing below reads what the conversion drops. Free the line - and take our own stale
            // marker with it, so it converts here and now instead of staying silenced for ever.
            If (iPos > 0) Begin
                Move (RTrim(Left(sLine, (iPos - 1)))) to sLine
                Move True to bMarked
            End
            Function_Return False
        End

        // A trailing ';' means the statement continues on the next line, so nothing may be appended
        // after it. Decline, but say nothing on the line - a comment there would break the code.
        Get _CodeOnlyLine sLine to sCode
        If (Right(RTrim(sCode), 1) = ";") ;
            Function_Return True

        Get _SideProductReason sCmdLow sList to sReason
        If (iPos > 0) Begin
            If (sOld contains sReason) ;
                Function_Return True
            // The list has changed - say what is true now, not what was true last run.
            Move (RTrim(Left(sLine, (iPos - 1)))) to sLine
        End
        Get _StrVarMark sLine sReason to sLine
        Move True to bMarked
        // Filed under the converter that declined, derived from the command rather than read
        // off psExecutionContext - the Tokenizer sets that to its own name (cRefactorLexer),
        // so the ambient value is only the function name by luck of the call order.
        Get _SideProductCommandCased sCmdLow to sMine
        Move ("Change" + sMine + "CommandToFunction") to sFn
        If (sMine <> "") ;
            Send AddRunNote sFn "One or more lines were left exactly as they are, each with a trailing TODO marker naming the reason: the code below them still reads Found, strmark or strlen, and the function form of the command sets none of the three - converting would have compiled and then run wrong. The engine always runs the line-by-line pass before the whole-file one, so to clear the strmark / strlen cases run ChangeStrMarkToExpression / ChangeStrLenToExpression in a pass of their own first, then this one again."
        Function_Return True
    End_Function

    // Re-state, or take away, every marker this guard left in a file - the strmark / strlen
    // converters call it after they have rewritten reads, because rewriting a read is exactly what
    // makes the marker above it untrue. Without this the marker would silence the row for good and
    // the command would never be offered again. Returns how many lines it changed.
    Function _SideProductRefreshMarks String[] ByRef asCode Returns Integer
        String[] asOnly
        tLineInfo[] aInfo
        String sSig sList sReason sProducts sOld
        Integer i iMax iPos iChanged
        Boolean bHit
        tStrVarLineInfo Info

        Get _SideProductMarkSignature to sSig
        Get _FileContainsText (&asCode) (Lowercase(sSig)) to bHit
        If (bHit = False) ;
            Function_Return 0
        Get _StrVarCodeLines (&asCode) to asOnly
        Get ScanSourceFile (&asCode) to aInfo
        Move (SizeOfArray(asCode) - 1) to iMax
        Move 0 to iChanged
        For i from 0 to iMax
            Get _SideProductMarkPos (asCode[i]) to iPos
            If (iPos > 0) Begin
                Get _StrVarLineInfo (asCode[i]) (asOnly[i]) "strmark" to Info
                Get _SideProductsOf Info.sCommand to sProducts
                Move "" to sList
                If (sProducts <> "") ;
                    Get _SideProductsReadBelow (&asCode) (&aInfo) i sProducts to sList
                If (sList = "") Begin
                    Move (RTrim(Left(asCode[i], (iPos - 1)))) to asCode[i]
                    Increment iChanged
                End
                Else Begin
                    Get _SideProductReason Info.sCommand sList to sReason
                    Move (Mid(asCode[i], CI_EOL, iPos)) to sOld
                    If ((sOld contains sReason) = False) Begin
                        Move (RTrim(Left(asCode[i], (iPos - 1)))) to asCode[i]
                        Get _StrVarMark (asCode[i]) sReason to asCode[i]
                        Increment iChanged
                    End
                End
            End
        Loop
        Function_Return iChanged
    End_Function

    /* ---- '#REPLACE <name> <value>' -> 'Define <name> for <value>' ------------------------------

       Measured on DataFlex 26 with a scratch program (2026-09-08), not read off the docs. The two
       really are one substitution mechanism: a number, a negative number, a quoted string, a
       parenthesised expression, a name carrying '$' or a dot, a value that is itself another
       symbol, even a value later used in COMMAND or TYPE position - all behave identically either
       way, and neither substitutes inside a string literal.

       A compile-time '#IF <name>' reads a Define exactly as it reads a #REPLACE - measured, because
       it is the first thing that looks like it might break and it does not.

       Five differences, and each one is a refusal:

       1. INSIDE AN Enum_List THE TWO ARE NOT INTERCHANGEABLE. A #REPLACE does not touch the running
          counter; a 'Define <name> for <value>' RESETS it. Measured:
              Enum_List / Define gOne / #REPLACE gMid 40 / Define gThree  -> 0, 40, 1
              Enum_List / Define fOne / Define fTwo for 40 / Define fThree -> 0, 40, 41
          Converting renumbers every entry below it, silently, and it still compiles.

       2. AN UNQUOTED VALUE WITH SPACES DOES NOT SURVIVE. '#REPLACE X 1 + 2' works, because the
          directive takes the REST OF THE LINE; 'Define X for 1 + 2' is Error 4345, type check,
          too many arguments. Rare but real - one line in the whole DataFlex install has the shape.

       3. A RESERVED WORD AS THE NAME. 'Define End_Procedure for 5' is Error 4330, reserved word
          used. Replacing a keyword is a macro, never a constant; the Deep Scan rule has refused
          that shape since 2026-07-28 and so does this.

       4. '#IFDEF' AND '#IFNDEF' DO NOT SEE THE TWO ALIKE. '#IFDEF X' is blind to '#REPLACE X ...'
          - X has already been substituted by the time the directive is read, so it asks about the
          value - but it DOES see 'Define X for ...'. Converting switches on an arm that is dead
          today, silently. A file that tests one of its own #REPLACE names keeps that line.

       5. A NAME ALREADY DEFINED ELSEWHERE. Redefining a Define with a DIFFERENT value is Error
          4332; with the same value it compiles. No per-file pass can see that, so it is not
          guarded - but a name can only be #REPLACEd once in the first place (the second directive
          reads its own substituted text and fails with 4396), so converting cannot create the
          clash on its own.

       What it converts is what the Deep Scan flags: a name that is not a reserved word, is not
       CURRENT$WORKSPACE and starts with a letter, and a LITERAL value - a number, a negative
       number, or a quoted string. A parenthesised expression is left alone although it looks
       convertible: a #REPLACE value is lazy text while a Define resolves its value at its own line,
       so '(A ior B)' compiles as a directive and is error 4328 as a Define wherever A and B are
       declared further down or arrive from a used package. An identifier value
       ('#REPLACE OLE_Handle Integer', '#REPLACE aps_make_row_space make_row_space') and a macro
       fragment ('|CI$8000', '!1') are left alone in silence: they would compile as Defines, but
       they are substitution machinery rather than constants, and calling them constants would say
       something about the code that is not true. The two shapes that LOOK convertible and are not -
       inside an Enum_List, and an unquoted value with spaces - get the trailing marker instead, so
       the row goes quiet rather than being offered again every Check.

       Never touched: the #HEADER region, which is precompiled and not ours; a Language_*.inc, where
       the whole file IS the substitution mechanism DataFlex builds a localised app with; and macro
       code, which the engine masks away before this function is ever handed the file.

       The value keeps its COLUMN. 'Define ' is two characters shorter than '#REPLACE ', so the gap
       before the value is padded to put it back where it was, and a block of aligned constants stays
       aligned.  */

    // What a Define can express, from the value text as it stands on the line: 1 = a number, with
    // an optional leading minus and no spaces; 2 = one quoted string, nothing after the closing
    // quote; 0 = anything else.
    //
    // LITERALS ONLY, and that is the measured reason: a #REPLACE value is lazy TEXT, while a Define
    // resolves its value AT ITS OWN LINE. '#Replace X (A ior B)' compiles with A and B defined
    // further down; 'Define X for (A ior B)' in the same place is Error 4328, undefined symbol in
    // argument. Whether the names it uses are already known cannot be decided from one file - they
    // may arrive from a package the file uses - so a parenthesised or symbolic value is left alone
    // however convertible it looks.
    Function _ReplaceDirectiveValueKind String sValue Returns Integer
        String sTrim sCh sQuote
        Integer i iLen

        Move (Trim(sValue)) to sTrim
        Move (Length(sTrim)) to iLen
        If (iLen = 0) ;
            Function_Return 0
        Move (Left(sTrim, 1)) to sCh

        If (sCh = '"' or sCh = "'") Begin
            Move sCh to sQuote
            Move 2 to i
            While (i <= iLen)
                If (Mid(sTrim, 1, i) = sQuote) Begin
                    If (i = iLen) ;
                        Function_Return 2
                    Function_Return 0
                End
                Increment i
            Loop
            Function_Return 0
        End

        // A number: optionally negative, and ONE token - a space here is the '1 + 2' shape that
        // the directive swallows to the end of the line and the Define command will not compile.
        If (sCh = "-") Begin
            If (iLen < 2) ;
                Function_Return 0
            Move (Mid(sTrim, 1, 2)) to sCh
        End
        If (sCh < "0" or sCh > "9") ;
            Function_Return 0
        Move 1 to i
        While (i <= iLen)
            Move (Mid(sTrim, 1, i)) to sCh
            If (sCh = " " or sCh = Character(9)) ;
                Function_Return 0
            Increment i
        Loop
        Function_Return 1
    End_Function

    // The three pieces of a '#REPLACE <name> <value>' line, taken by POSITION off the code-only
    // twin (which blanks string content and cuts the line at '//', so a '#replace' inside a literal
    // or a comment can never match) and sliced out of the RAW line, so the value keeps its own text
    // and the trailing comment survives untouched. False when the line is not the directive, or
    // carries no value. iKeyword and iValueStart are 1-based columns into sLine.
    Function _ReplaceDirectiveParts String sLine String ByRef sName String ByRef sValue Integer ByRef iKeyword Integer ByRef iValueStart Returns Boolean
        String sCode sCh
        Integer iLen iEnd i iNameStart iNameEnd

        Move "" to sName
        Move "" to sValue
        Move 0 to iKeyword
        Move 0 to iValueStart

        Get _CodeOnlyLine sLine to sCode
        Move (Length(sCode)) to iEnd
        While (iEnd >= 1 and (Mid(sCode, 1, iEnd) = " " or Mid(sCode, 1, iEnd) = Character(9)))
            Decrement iEnd
        Loop
        If (iEnd < 9) ;
            Function_Return False

        Move 1 to i
        While (i <= iEnd and (Mid(sCode, 1, i) = " " or Mid(sCode, 1, i) = Character(9)))
            Increment i
        Loop
        // The directive is spelled '#Replace' in the DataFlex install as often as '#REPLACE', and
        // the compiler takes either, so the test is case-insensitive.
        If (Lowercase(Mid(sCode, 8, i)) <> "#replace") ;
            Function_Return False
        Move i to iKeyword
        Move (i + 8) to i
        If (i <= iEnd) Begin
            Move (Mid(sCode, 1, i)) to sCh
            If (sCh <> " " and sCh <> Character(9)) ;
                Function_Return False
        End

        While (i <= iEnd and (Mid(sCode, 1, i) = " " or Mid(sCode, 1, i) = Character(9)))
            Increment i
        Loop
        If (i > iEnd) ;
            Function_Return False
        Move i to iNameStart
        While (i <= iEnd and Mid(sCode, 1, i) <> " " and Mid(sCode, 1, i) <> Character(9))
            Increment i
        Loop
        Move (i - 1) to iNameEnd

        While (i <= iEnd and (Mid(sCode, 1, i) = " " or Mid(sCode, 1, i) = Character(9)))
            Increment i
        Loop
        If (i > iEnd) ;
            Function_Return False

        Move i to iValueStart
        Move (Mid(sLine, (iNameEnd - iNameStart + 1), iNameStart)) to sName
        Move (Mid(sLine, (iEnd - iValueStart + 1), iValueStart)) to sValue
        Function_Return True
    End_Function

    // The converted line: the original indentation, 'Define <name>', then enough spaces that the
    // value lands in the COLUMN it stood in before, then 'for ' and the rest of the raw line -
    // value and trailing comment together, exactly as they were.
    Function _ReplaceDirectiveAsDefine String sLine String sName Integer iKeyword Integer iValueStart Returns String
        String sHead sPad
        Integer iPad

        Move (Left(sLine, (iKeyword - 1)) + "Define " + sName) to sHead
        Move (iValueStart - 5 - Length(sHead)) to iPad
        If (iPad < 1) ;
            Move 1 to iPad
        Move (Repeat(" ", iPad)) to sPad
        Function_Return (sHead + sPad + "for " + Mid(sLine, CI_EOL, iValueStart))
    End_Function

    // A Language_*.inc is the mechanism DataFlex compiles a localised application with - one file
    // per language, every line of it a #REPLACE. Rewriting those as Defines would break the thing
    // the file exists to do, so the whole file is left alone. Same test the Deep Scan uses when it
    // drops these hits, deliberately NOT a bare 'language' prefix: a LanguageRules.inc is ordinary
    // source.
    Function _ReplaceDirectiveIsLanguageFile String sFullFileName Returns Boolean
        String sBase
        Integer iPos

        Move (Lowercase(sFullFileName)) to sBase
        Move (RightPos(Character(92), sBase)) to iPos
        If (iPos > 0) ;
            Move (Right(sBase, (Length(sBase) - iPos))) to sBase
        Move (RightPos("/", sBase)) to iPos
        If (iPos > 0) ;
            Move (Right(sBase, (Length(sBase) - iPos))) to sBase
        Function_Return (Left(sBase, 9) = "language_" and Right(sBase, 4) = ".inc")
    End_Function

    // True when this file tests the name with '#IFDEF' or '#IFNDEF'. The two directives do NOT see
    // the same thing, measured on DataFlex 26: '#IFDEF X' is BLIND to a '#REPLACE X ...' - by the
    // time it is read, X has already been substituted, so the directive asks about the value - but
    // it DOES see 'Define X for ...'. Converting therefore switches on an arm that was dead, and
    // nothing about the file says so. Whole-word, off the code-only text, so a mention in a comment
    // or a literal does not count.
    Function _ReplaceDirectiveNameIsTested String[] ByRef asCode String sNameLow Returns Boolean
        String sCode sLow sFirst
        Integer i iMax iPos

        Move (SizeOfArray(asCode) - 1) to iMax
        For i from 0 to iMax
            Get _CodeOnlyLine (asCode[i]) to sCode
            Move (Lowercase(Trim(sCode))) to sLow
            If (Left(sLow, 1) = "#") Begin
                Get _NthWord sLow 1 to sFirst
                If (sFirst = "#ifdef" or sFirst = "#ifndef") Begin
                    Get _FindKeywordPos sLow sNameLow True 1 to iPos
                    If (iPos > 0) ;
                        Function_Return True
                End
            End
        Loop
        Function_Return False
    End_Function

    // One directive line, once its three pieces are known: the name gates, then what a Define can
    // express, then convert or mark. Silence is deliberate for a line the Deep Scan does not offer
    // either - a reserved word as the name, CURRENT$WORKSPACE, an identifier value, a macro
    // fragment: none of those is a candidate, and a marker on each would bury the file. The two
    // shapes the scan DOES offer and this refuses get the marker, so the row goes quiet instead of
    // coming back every Check.
    Procedure _ReplaceDirectiveOneLine String[] ByRef asCode Integer iLine String sName String sValue Integer iKeyword Integer iValueStart Boolean bInEnum Boolean bHasIfDef Integer ByRef iConverted Integer ByRef iMarkedEnum Integer ByRef iMarkedValue Integer ByRef iMarkedIfDef
        String sLow sCh sTrimmed
        Integer iKind
        Boolean bHit

        Move (Lowercase(sName)) to sLow
        // The legacy shell's workspace-name macro belongs to RefactorWorkspaceTocApplication, which
        // comments the directive out as part of converting the object it feeds.
        If (sLow = "current$workspace") ;
            Procedure_Return
        Get _IsReservedWord sName to bHit
        If (bHit = True) ;
            Procedure_Return
        // "{new-symbol} ... must start with a letter" - the Define documentation, and error 4330
        // agrees on a keyword.
        Move (Left(sLow, 1)) to sCh
        If (sCh < "a" or sCh > "z") ;
            Procedure_Return
        // A '!' anywhere in the name makes it a macro ARGUMENT, not a symbol ('#Replace U_!1 U_!2').
        // Those live in #COMMAND bodies the engine masks away, so this never fires in a normal run -
        // it is here so the rule does not depend on the masking staying perfect.
        If (Pos(Character(33), sName) > 0) ;
            Procedure_Return
        Get _StrVarMarked (asCode[iLine]) to bHit
        If (bHit = True) ;
            Procedure_Return

        Get _ReplaceDirectiveValueKind sValue to iKind
        If (iKind = 0) Begin
            /* A value that OPENS like a number and then runs on - '15 ...' - is the one refusal the
               Deep Scan cannot see: its value test reads the FIRST CHARACTER only, so the grid
               offers that line and the converter has to explain itself on it. Every other value it
               rejects here (an identifier, a parenthesised expression, a macro fragment) the scan
               rejects too, so those are skipped in silence rather than marked. */
            Move (Trim(sValue)) to sTrimmed
            Move (Left(sTrimmed, 1)) to sCh
            If (sCh = "-" and Length(sTrimmed) > 1) ;
                Move (Mid(sTrimmed, 1, 2)) to sCh
            If (sCh >= "0" and sCh <= "9" and Pos(" ", sTrimmed) > 0) Begin
                Get _StrVarMark (asCode[iLine]) "the value is unquoted text with spaces - the #REPLACE directive takes the rest of the line, and Define does not compile that (error 4345). Quote it or bracket it, then convert." to asCode[iLine]
                Increment iMarkedValue
            End
            Procedure_Return
        End

        If (bHasIfDef = True) Begin
            Get _ReplaceDirectiveNameIsTested (&asCode) sLow to bHit
            If (bHit = True) Begin
                Get _StrVarMark (asCode[iLine]) "this file tests the name with #IFDEF / #IFNDEF, and the two do not see the same thing: #IFDEF is blind to a #REPLACE but it does see a Define, so converting would switch on an arm that is dead today. Rewrite the test with the directive, or leave both." to asCode[iLine]
                Increment iMarkedIfDef
                Procedure_Return
            End
        End

        If (bInEnum = True) Begin
            Get _StrVarMark (asCode[iLine]) "inside an Enum_List a #REPLACE leaves the running counter alone, but Define WITH a value resets it - converting would silently renumber every entry below. Move it out of the block first, or leave the directive." to asCode[iLine]
            Increment iMarkedEnum
            Procedure_Return
        End

        Get _ReplaceDirectiveAsDefine (asCode[iLine]) sName iKeyword iValueStart to asCode[iLine]
        Increment iConverted
    End_Procedure

    // The whole-file worker. Walks the file once, keeping the region latches a directive line has
    // to be read against - #HEADER, Enum_List, DF23 block comments and report images - converts the
    // lines a Define can express, and leaves the two look-alike shapes with the marker that says
    // why. Returns the number of lines converted; the markers are counted into the run notes, and
    // the engine writes the file on the array diff either way.
    Function _ReplaceDirectiveToDefine String[] ByRef asCode Returns Integer
        String sLine sCode sLow sName sValue sLeaf sNote
        String[] asNeedles
        Integer i iMax iKeyword iValueStart iKind iConverted iMarkedEnum iMarkedValue iMarkedIfDef iPos
        Boolean bHit bInHeader bInEnum bInBlock bInImage bShape bHasIfDef

        Get _FileContainsText (&asCode) "#replace" to bHit
        If (bHit = False) ;
            Function_Return 0
        Move "" to sLeaf
        If (ghoEngine <> 0) ;
            Get psCurrentSourceFileName of ghoEngine to sLeaf
        Get _ReplaceDirectiveIsLanguageFile sLeaf to bHit
        If (bHit = True) Begin
            Send AddRunNote "ChangeReplaceDirectiveToDefine" "A Language_*.inc was left untouched: every #REPLACE in it IS the substitution mechanism DataFlex compiles a localised application with, one file per language, and a Define cannot stand in for that."
            Function_Return 0
        End

        // One cheap pass decides whether ANY name in this file could be #IFDEF-tested; almost no
        // file has one, and then the per-name walk below never runs at all.
        Move (StrSplitToArray("#ifdef|#ifndef", "|")) to asNeedles
        Get _FileContainsAnyText (&asCode) (&asNeedles) to bHasIfDef
        Move 0 to iConverted
        Move 0 to iMarkedEnum
        Move 0 to iMarkedValue
        Move 0 to iMarkedIfDef
        Move False to bInHeader
        Move False to bInEnum
        Move False to bInBlock
        Move False to bInImage
        Move (SizeOfArray(asCode) - 1) to iMax
        For i from 0 to iMax
            Move asCode[i] to sLine
            // per-file progress: the bar fills as the pass walks (a no-op without the panel)
            If (Mod(i, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(i + 1) * "of:" * String(iMax + 1))
                Set piPosition of ghoProgressBar to (i + 1)
            End
            If (bInImage = True) Begin
                Get IsImageEnd sLine to bHit
                If (bHit = True) ;
                    Move False to bInImage
            End
            Else If (bInBlock = True) Begin
                Get _BlockCommentOpenAtEnd sLine True to bInBlock
            End
            Else If (bInHeader = True) Begin
                // A #HEADER ... #ENDHEADER region is precompiled into the .pkd and is not ours.
                Get _IsHeaderEnd sLine to bHit
                If (bHit = True) ;
                    Move False to bInHeader
            End
            Else Begin
                Get IsImageStart sLine to bHit
                If (bHit = True) Begin
                    Move True to bInImage
                End
                Else Begin
                    Get _IsDF23CommentStart sLine to bHit
                    If (bHit = True) Begin
                        Get _BlockCommentOpenAtEnd sLine False to bInBlock
                    End
                    Else Begin
                        Get _IsHeaderDeclaration sLine to bHit
                        If (bHit = True) Begin
                            Move True to bInHeader
                        End
                        Else Begin
                            // The enumeration latch, off the line's FIRST CODE WORD - so a
                            // trailing comment cannot fool it - and under BOTH spellings the
                            // compiler takes. 'enumeration_list' is the one a legacy workspace
                            // actually writes; matching only 'enum_list' would let the counter
                            // trap through in exactly the files that have it.
                            Get _CodeOnlyLine sLine to sCode
                            Get _NthWord (Lowercase(sCode)) 1 to sLow
                            If (sLow = "enum_list" or sLow = "enumeration_list") ;
                                Move True to bInEnum
                            If (sLow = "end_enum_list" or sLow = "end_enumeration_list") ;
                                Move False to bInEnum
                            Get _ReplaceDirectiveParts sLine (&sName) (&sValue) (&iKeyword) (&iValueStart) to bShape
                            If (bShape = True) ;
                                Send _ReplaceDirectiveOneLine (&asCode) i sName sValue iKeyword iValueStart bInEnum bHasIfDef (&iConverted) (&iMarkedEnum) (&iMarkedValue) (&iMarkedIfDef)
                        End
                    End
                End
            End
        Loop

        If ((iConverted + iMarkedEnum + iMarkedValue + iMarkedIfDef) > 0) Begin
            Move (RightPos(Character(92), sLeaf)) to iPos
            If (iPos > 0) ;
                Move (Right(sLeaf, (Length(sLeaf) - iPos))) to sLeaf
            If (sLeaf <> "") ;
                Move (sLeaf + ": ") to sLeaf
            Move (sLeaf + String(iConverted) + " #REPLACE directive(s) rewritten as Define, keeping the value in its own column.") to sNote
            Send AddRunNote "ChangeReplaceDirectiveToDefine" sNote
            If (iMarkedEnum > 0) ;
                Send AddRunNote "ChangeReplaceDirectiveToDefine" (sLeaf + String(iMarkedEnum) + " line(s) inside an Enum_List were left as they are and marked: a #REPLACE does not touch the enumeration's running counter, but a Define WITH a value resets it, so converting would silently renumber every entry below.")
            If (iMarkedValue > 0) ;
                Send AddRunNote "ChangeReplaceDirectiveToDefine" (sLeaf + String(iMarkedValue) + " line(s) whose value is unquoted text with spaces were left as they are and marked: the directive takes the rest of the line, and the Define command does not compile that.")
            If (iMarkedIfDef > 0) ;
                Send AddRunNote "ChangeReplaceDirectiveToDefine" (sLeaf + String(iMarkedIfDef) + " line(s) whose name this file tests with #IFDEF / #IFNDEF were left as they are and marked: #IFDEF is blind to a #REPLACE but sees a Define, so converting would switch on an arm that is dead today.")
        End
        Function_Return iConverted
    End_Function

    /* 'Pos <needle> in <var>' with NO 'to': the command is there only for what it sets - Found, strmark
       and strlen. Once nothing below reads strmark or strlen (ChangeStrMarkToExpression and
       ChangeStrLenToExpression rewrite those reads into Pos() expressions), only Found is left, and
       'Move (Pos(<needle>, <var>) > 0) to Found' sets exactly that: the command sets Found when the
       text is found. Until 2026-11-27 this form was never converted, so a file kept its legacy Pos lines
       (warning 4531) even after every strmark read was gone (a Data Access report).
       Only the exact shape - the command first on the line, one variable after 'in', no end comment -
       and only with the line pass's look-ahead: without it (a lone line) nothing can be proved, and the
       line stays as it is. */
    Function _PosFoundOnlyToFunction String ByRef sLine Returns Boolean
        tTokenizer TokenizerData
        String sTrim sMasked sIndent sNeedle sVar sList
        String[] asSrc
        tLineInfo[] aSrcInfo
        Integer iIn iLine
        Boolean bAny

        Get pTokenizer to TokenizerData
        If (TokenizerData.sEndComment <> "") ;
            Function_Return False
        If (SizeOfArray(TokenizerData.asLineTokens) < 4) ;
            Function_Return False
        If (Lowercase(TokenizerData.asLineTokens[0]) <> Lowercase(CS_Pos)) ;
            Function_Return False
        Get pbLinePassSideProducts to bAny
        Get piLinePassIndex to iLine
        If (bAny = False or iLine < 0) ;
            Function_Return False
        Get pasLinePassSource to asSrc
        Get paLinePassInfo to aSrcInfo
        Get _SideProductsReadBelow (&asSrc) (&aSrcInfo) iLine "strmark|strlen" to sList
        If (sList <> "") ;
            Function_Return False
        // The masked line keeps the positions of the left-trimmed line, with string text overstruck, so
        // an " in " inside a string literal is never taken for the keyword.
        Move (Trim(sLine)) to sTrim
        Move (Left(sLine, (Pos(sTrim, sLine) - 1))) to sIndent
        Move (Lowercase(TokenizerData.sOverstrikeLine)) to sMasked
        Move (Pos(" in ", sMasked)) to iIn
        If (iIn <= (Length(CS_Pos) + 1)) ;
            Function_Return False
        Move (Trim(Mid(sTrim, (iIn - Length(CS_Pos) - 1), (Length(CS_Pos) + 2)))) to sNeedle
        Move (Trim(Mid(sTrim, Length(sTrim), (iIn + 4)))) to sVar
        If (sNeedle = "" or sVar = "" or (sVar contains " ")) ;
            Function_Return False
        Move (sIndent + "Move (" + CS_Pos + "(" + sNeedle + ", " + sVar + ") > 0) to " + CS_Found) to sLine
        Function_Return True
    End_Function

    Function SingleCommandSyntaxToFunction String ByRef sLine String sKeyWord Returns Boolean
        Boolean bFound
        String sText sNose sVar1 sVar2 sVar3 sVar4
        Integer iPos iItem iParam iTo
        Boolean bVeto bMarked
        tTokenizer TokenizerData
        
        Get pTokenizer to TokenizerData
        If (LineIsNotCode(&TokenizerData)) Begin
            Function_Return False
        End
        
        Move (SearchArray(sKeyWord, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
        If (iItem = -1) Begin
            Function_Return False
        End
        // If only two items or less in the token array, there is nothing to do.
        // This is to guard from misuse of e.g. function names as variables.
        // E.g. "Read Pos", where "Pos" in this case is a string variable. It compiles and runs just fine.
        If (SizeOfArray(TokenizerData.asLineTokens) < 3) Begin
            Function_Return False
        End
        
        // A command whose function form writes into a 'to <dest>' MUST have that 'to'. Legacy
        // 'Pos <needle> in <str>' with NO destination exists only for its [Found] side-effect
        // (e.g. 'Pos " " in s' then 'While [Found]'); converting drops the target and emits a
        // dangling 'Move (...) to ' (LegacyApp OVRV0410.PKG). Replace is the lone exception - its
        // result goes back into the 'in' variable, so it needs no 'to'. Leave the line untouched
        // (return False BEFORE any sLine edit) when 'to' is required but absent.
        //
        // HARDENED 2026-07-05 (err 4509 "array index out of bounds" in a real ChangeRightCommand-
        // ToFunction run - the case bodies below read asLineTokens[<anchor>+n] RAW): every anchor
        // read is now pre-validated HERE, before any sLine edit, so a malformed line or a false
        // match (e.g. a variable that happens to be named Right, sitting as the line's last token)
        // is left untouched instead of crashing - or being silently mangled into a non-compiling
        // single-argument Left()/Right():
        //   - the keyword itself must not be the LAST token (Replace/ZeroString read [keyword+1]);
        //   - 'to' must be followed by its destination ([to+1] - every branch reads it);
        //   - Left/Right/Pad need ONE trailing argument after the destination ([to+2]), Mid TWO
        //     ([to+2]+[to+3]) - their function forms do not compile without them, so a line
        //     missing them is not that command;
        //   - Pos/Replace parse '<arg> in <var>': 'in' must exist and be followed by its variable.
        If (iItem + 1 >= SizeOfArray(TokenizerData.asLineTokens)) ;
            Function_Return False
        If (Lowercase(sKeyWord) <> Lowercase(CS_Replace)) Begin
            Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iTo
            // Pos with no destination: its own conversion, to the Found it sets (see above).
            If (iTo = -1 and Lowercase(sKeyWord) = Lowercase(CS_Pos)) Begin
                Get _PosFoundOnlyToFunction (&sLine) to bMarked
                Function_Return bMarked
            End
            If (iTo = -1 or (iTo + 1 >= SizeOfArray(TokenizerData.asLineTokens))) ;
                Function_Return False
            If ((Lowercase(sKeyWord) = Lowercase(CS_Left)) or (Lowercase(sKeyWord) = Lowercase(CS_Right)) or (Lowercase(sKeyWord) = Lowercase(CS_Pad))) Begin
                If (iTo + 2 >= SizeOfArray(TokenizerData.asLineTokens)) Begin
                    // The LENGTH-LESS command form ('Left in_str to del_kod' / 'Right P$NR to P$NR')
                    // takes its count from STRMARK, set by the PREVIOUS string command - unknowable
                    // here, so the function form cannot be built and the line stays a hand-fix.
                    // Instead of a silent bail, TAG it for the programmer (Nils 2026-07-11) -
                    // idempotent, and ONLY for the exact command-position 'kw src to dst' shape (a
                    // variable that happens to be NAMED Left/Right sitting mid-line is not the
                    // command and must stay untouched, per the 2026-07-05 hardening).
                    If (iItem = 0 and iTo = 2 and SizeOfArray(TokenizerData.asLineTokens) = 4 and ;
                        not(sLine contains "TODO (DFRefactor)")) Begin
                        Move (sLine + "   // TODO (DFRefactor): NOT converted - the count argument is missing (legacy strmark form: the count comes from the previous string command). Convert to " + sKeyWord + "() with an explicit count by hand.") to sLine
                        Function_Return True
                    End
                    Function_Return False
                End
            End
            If (Lowercase(sKeyWord) = Lowercase(CS_Mid)) Begin
                If (iTo + 3 >= SizeOfArray(TokenizerData.asLineTokens)) ;
                    Function_Return False
            End
        End
        If ((Lowercase(sKeyWord) = Lowercase(CS_Pos)) or (Lowercase(sKeyWord) = Lowercase(CS_Replace))) Begin
            Move (SearchArray(CS_In, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iTo
            If (iTo = -1 or (iTo + 1 >= SizeOfArray(TokenizerData.asLineTokens))) ;
                Function_Return False
        End

        // Pos, Left, Right, Mid and Pad leave a side product behind that their function forms do
        // not set; the line stays as it is, marked, while anything below still reads one.
        // _SideProductsOf answers "" for every other keyword, so the rest pay nothing.
        Get _SideProductVeto (&sLine) (Lowercase(sKeyWord)) (&bMarked) to bVeto
        If (bVeto = True) ;
            Function_Return bMarked

        Move "" to sNose
        Move (Trim(sLine)) to sLine
        // Remove the keyword. Located on the MASKED, left-trimmed line
        // (sOverstrikeLine, position-aligned with the trimmed sLine) at a
        // TOKEN BOUNDARY via _FindKeywordPos: a bare Pos could land inside an
        // identifier in the nose ("iLeftMargin" before a Left command) or
        // inside a string literal, splicing the line at the wrong place
        // (2026-06-10 audit).
        Get _FindKeywordPos TokenizerData.sOverstrikeLine sKeyWord True 1 to iPos
        If (iPos > 0) Begin
            Move (Left(sLine, (iPos -1))) to sNose
            Move (Mid(sLine, CI_EOL, iPos)) to sLine
        End

        // Get the first variable
        If (SizeOfArray(TokenizerData.asLineTokens) > (iItem +1)) Begin
            Move TokenizerData.asLineTokens[iItem + 1] to sVar1
        End
        Else Begin
            Move "" to sVar1
        End
        // Check if this is a string constant, in case the array value contains underscores only.
        Get _IsStringArrayConstant sVar1 to bFound
        If (bFound = True) Begin
            Get _ExtractFirstStringConstant sLine to sVar1    
        End
        // Drop a redundant outer parenthesis pair so "Character (9)" -> Character(9), not ((9)).
        Get _StripRedundantParens sVar1 to sVar1
        Move 0 to iParam

        Case Begin
            Case ((Lowercase(sKeyWord) = Lowercase(CS_Length)) or (Lowercase(sKeyWord) = Lowercase(CS_Character)))
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_To) + CS_S), Lowercase( sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2    
                    End
                End
                Move ("(" + String(sKeyWord) + "(" + String(sVar1) + "))" * CS_To * String(sVar2)) to sLine
                Case Break  
                
            Case ((Lowercase(sKeyWord) = Lowercase(CS_Left)) or (Lowercase(sKeyWord) = Lowercase(CS_Right)))
                // Left and Right: the same shape, with or without the count argument.
                Move "" to sVar3
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_To) + CS_S), Lowercase( sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2
                    End
                    // '<' like every sibling branch - the old '<=' read ONE PAST the array when the
                    // destination was the line's last token (the err-4509 crash the pre-checks above
                    // now also stop; this is the belt).
                    If (iItem + 2 < SizeOfArray(TokenizerData.asLineTokens)) Begin
                        Move TokenizerData.asLineTokens[iItem +2] to sVar3
                    End
                End
                If (sVar3 <> "") Begin
                    Move ("(" + String(sKeyWord) + "(" + String(sVar1) + ", " + String(sVar3) + "))" * CS_To * String(sVar2)) to sLine
                End
                Else Begin
                    Move ("(" + String(sKeyWord) + "(" + String(sVar1) + "))" * CS_To * String(sVar2)) to sLine
                End
                Case Break  
                
            Case (Lowercase(sKeyWord) = Lowercase(CS_Mid))
                Move "" to sVar3
                Move "" to sVar4
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_To) + CS_S), Lowercase( sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2
                    End
                    If (iItem + 2 < SizeOfArray(TokenizerData.asLineTokens)) Begin
                        Move TokenizerData.asLineTokens[iItem +2] to sVar3
                    End
                    If (iItem + 3 < SizeOfArray(TokenizerData.asLineTokens)) Begin
                        Move TokenizerData.asLineTokens[iItem +3] to sVar4
                    End
                End
                Move ("(" + String(sKeyWord) + "(" + String(sVar1) + ", " + String(sVar3) + ", " + String(sVar4) + "))" * CS_To * String(sVar2)) to sLine
                Case Break

            Case (Lowercase(sKeyWord) = Lowercase(CS_Pos))
                Move (SearchArray(CS_In, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_In) + CS_S), Lowercase(sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2    
                    End
                End
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar3
                End
                If (sVar1 <> "") Begin
                    Move ("(" + String(sKeyWord) + "(" + String(sVar1) + "," + String(sVar2) + "))" * CS_To * String(sVar3)) to sLine
                End
                Case Break 
            Case (Lowercase(sKeyWord) = Lowercase(CS_Replace))
                Move (SearchArray(CS_Replace, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar1
                    Get _IsStringArrayConstant sVar1 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_Replace) + CS_S), Lowercase(sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar1
                    End
                End
                Move (SearchArray(CS_In, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_In) + CS_S), Lowercase(sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2
                    End 
                End
                // Extract the full With argument directly from sLine (handles complex expressions like ("_" + (Trim(sVal2))))
                Move (Pos((CS_S + Lowercase(CS_With) + CS_S), Lowercase(sLine))) to iPos
                If (iPos > 0) Begin
                    Move (Mid(sLine, Length(sLine), (iPos + Length(CS_With) + 2))) to sVar3
                    Move (Trim(sVar3)) to sVar3
                    // Strip end comment if it was included in the extracted value:
                    If (TokenizerData.sEndComment <> "") Begin
                        If (sVar3 contains TokenizerData.sEndComment) Begin
                            Move (Replace(TokenizerData.sEndComment, sVar3, "")) to sVar3
                            Move (Trim(sVar3)) to sVar3
                        End
                    End
                End
                Move ("(" + String(sKeyWord) + "(" + String(sVar1) + "," + String(sVar2) + "," + String(sVar3) + "))" * CS_To * String(sVar2)) to sLine
                Case Break 
                
            Case (Lowercase(sKeyWord) = Lowercase(CS_ZeroString))
                Move (SearchArray(CS_ZeroString, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar1
                End
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_To) + CS_S), Lowercase(sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2
                    End 
                End
                Move ("(" + String(sKeyWord) + "(" + String(sVar1) + "))" * CS_To * String(sVar2)) to sLine
                Case Break

            // Pad: source, "to" result, then ONE trailing length arg.
            // e.g.  Pad sVar to sResult 20  ->  Move (Pad(sVar, 20)) to sResult
            Case (Lowercase(sKeyWord) = Lowercase(CS_Pad))
                Move "" to sVar3
                Move (SearchArray(CS_To, TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP))) to iItem
                If (iItem <> -1) Begin
                    Move TokenizerData.asLineTokens[iItem +1] to sVar2
                    Get _IsStringArrayConstant sVar2 to bFound
                    If (bFound = True) Begin
                        Move (Pos((CS_S + Lowercase(CS_To) + CS_S), Lowercase(sLine))) to iPos
                        Move (Mid(sLine, Length(sLine), (iPos + 1))) to sText
                        Get _ExtractFirstStringConstant sText to sVar2
                    End
                    If (iItem + 2 < SizeOfArray(TokenizerData.asLineTokens)) Begin
                        Move TokenizerData.asLineTokens[iItem +2] to sVar3
                    End
                End
                Move ("(" + String(sKeyWord) + "(" + String(sVar1) + ", " + String(sVar3) + "))" * CS_To * String(sVar2)) to sLine
                Case Break
            Case Else
        Case End
                         
        If (sNose <> "") Begin
            Move (TokenizerData.sIndentation + String(sNose) * CS_Move * String(sLine)) to sLine
        End 
        Else Begin
            Move (TokenizerData.sIndentation + CS_Move * String(sLine)) to sLine
        End
        If (Length(TokenizerData.sEndComment)  > 0) Begin  
            Append sLine CS_S TokenizerData.sEndComment
        End

        Function_Return True
    End_Function

    // To be used by cRefactorFuncLib functions to replace one word with another,
    // regardless of lowercase/uppercase characters and spaces.
    // Returns the replaced result string.
    // Returns blank ("") if the "sFrom" parameter was not found in the "sLine" param
    Function ReplaceLineToken tTokenizer TokenizerData String sLine String sFrom String sTo Returns String
        String sFill sIndent sEndComment sText sLineLC sEndFill sToken
        Integer iPos iLength iCount iSize iStart iItem
        String[] asLine

        If (TokenizerData.bLineIsReady = True) Begin
            Function_Return ""
        End
        
        // Split parameter sLine into a string array
        Move (StrSplitToArray(sLine, CS_S)) to asLine
        Move (SearchArray(sFrom, asLine, Desktop, (RefFunc(DFSTRICMP)))) to iItem
        
        // If not found, we might have a "sFrom" token that is part of an expression, and
        // thus is not its own item in the string array.
        If (iItem = -1) Begin
            Move (SizeOfArray(asLine)) to iSize
            Decrement iSize
            For iCount from 0 to iSize
                Move -1 to iItem
                Move asLine[iCount] to sToken
                If (Lowercase(sToken) contains Lowercase(sFrom)) Begin
                    Move iCount to iItem
                End
                If (iItem <> -1) Begin
                    Move iSize to iCount // We're out of here.
                End
            Loop
            If (iItem = -1) Begin
                Function_Return ""
            End
            
            Move (Pos(Lowercase(sFrom), Lowercase(sToken))) to iPos
            Move iPos to iStart
            Move (iStart + Length(sFrom) - 1) to iSize
            // Overstrike "sFrom" token:
            For iCount from iStart to iSize
                Move (Overstrike(CS_D, sToken, iCount)) to sToken
            Loop
            Move (Length(sFrom)) to iLength
            Move (FillString(CS_D, iLength)) to sFill
            // Replace overstrike with ""
            Move (Replace(sFill, sToken, "")) to sToken
            // Insert the "sTo" token
            Move (Insert(sTo, sToken, iPos)) to sToken 
            Move sToken to sTo
        End
        
        // Move the "sTo" token back into string array and re-create the sLine string.
        Move sTo to asLine[iItem]
        Move (StrJoinFromArray(asLine, CS_S)) to sLine
        Function_Return (Rtrim(sLine))
    End_Function

    // Returns True if this is a comment line with "//" to the left,
    // or if the line is blank.
    Function IsCommentLineOrBlank String sLine Returns Boolean
        Boolean bIsComment bIsBlank

        Get _IsCommentLine sLine to bIsComment
        Get _IsBlankLine sLine to bIsBlank

        Function_Return (bIsComment = True or bIsBlank = True)
    End_Function

    // Returns true if the passed sKeyword exists in the asLineTokens array,
    // else returns False.
    // Note that the asLineTokens doesn't contain any string literals, and expressions are
    // kept together as one item in the array.
    // Note: The sKeywords string must be separated by "|".
    Function IsKeywordInLine String sKeywords String[] asLineTokens Returns Boolean
        String sKeyword
        String[] asKeywords
        Integer iSize iCount iItem

        Move (Lowercase(sKeywords)) to sKeywords
        Move (StrSplitToArray(sKeywords, CS_D)) to asKeywords
        Move (SizeOfArray(asKeywords)) to iSize
        Decrement iSize
        For iCount from 0 to iSize                                // This makes the search case insensitive.
            Move (SearchArray(asKeywords[iCount], asLineTokens, Desktop, (RefFunc(DFSTRICMP)))) to iItem
            If (iItem <> -1) Begin
                Function_Return True
            End
        Loop

        Function_Return False
    End_Function

    Procedure RestoreErrorState
        Get piLastErr to LastErr
        If (pbErr(Self)) Begin
            Move True to Err
        End
        Else Begin
            Move False to Err
        End
    End_Procedure

    Procedure SaveErrorState
        Set piLastErr to LastErr
        If (Err = True) Begin
            Set pbErr to True
        End
        Else Begin
            Set pbErr to False
        End
        Move False to Err
        Move 0 to LastErr
    End_Procedure

    // This *must* be called *once* per source line, *before* any of the refactor functions are called.
    // It calls the Tokenizer function and sets the class property pTokenizer that is used
    // by refactoring functions in this class!
    // The call is made automatically by the refactoring engine, but there are special cases were
    // this also needs to be done manually.
    Procedure InitializeTokenizer String sLine
        tTokenizer TokenizerData
        // Note: This function call also sets the pTokenizer class property.
        Get Tokenizer sLine to TokenizerData
    End_Procedure

    // DRY-RUN a line-by-line refactor function on ONE warned line, in isolation, to learn whether it would
    // actually change it. The Modernization Analyzer's keyword source-guard (VerifyAutoFix) is necessary but
    // NOT sufficient: a converter can still DECLINE a line for a content reason the guard can't see - e.g. a
    // no-"to" Pos used for its [Found] side-effect (not convertible to a function call), or an already-fixed
    // line - so it labels the row "Auto-fix" yet Run Plan never clears it. Running the REAL function is the
    // ground truth ("the function is its own detector"), so this stays correct as functions gain/lose forms
    // (e.g. the in-place Uppercase/Lowercase support added 2026-07-01). Returns True (= "applies, keep the
    // Auto-fix") when the function changes the line OR cannot be resolved (never demote on doubt); False ONLY
    // when the function ran and left the line untouched. Isolated: error state saved/restored + properties
    // cleared, so a probe can never pollute the live analysis or the StatLog. Intended for line-by-line
    // (eStandardFunction) converters; a whole-file function whose guard is file-wide (RemoveProperty*) is NOT
    // probed this way and stays as classified.
    // True when the named refactor function exposes an { EnumList } parameter (the class-names
    // family: the grid/list/edit converters). The engine's run summary uses this to attach the
    // subclass-parameter hint to a plan-selected class converter that converted NOTHING - a 0
    // there almost always means the surviving rows are SUBCLASS instances the DEFAULT parameter
    // never matches (LegacyApp2 2026-07-17: both grid fns at 0, then 33+174 conversions once the
    // class-names parameter was set). pFuncLibArray-based, so it answers in the app AND the pure
    // DFUnit runner (unlike FunctionsA).
    Function FunctionHasEnumListParam String sFn Returns Boolean
        tFuncLib[] FuncLibArray
        Integer i iCount
        String sFnLc
        Move (Lowercase(Trim(sFn))) to sFnLc
        If (sFnLc = "") ;
            Function_Return False
        Get pFuncLibArray to FuncLibArray
        Move (SizeOfArray(FuncLibArray)) to iCount
        For i from 0 to (iCount - 1)
            If (Lowercase(FuncLibArray[i].sName) = sFnLc) ;
                Function_Return FuncLibArray[i].bFuncEnumList
        Loop
        Function_Return False
    End_Function

    Function AutoFixChangesLine String sFn String sSourceLine Returns Boolean
        Boolean bChanged
        Integer iFunctionID i iCount
        String sLineCopy sFnLc
        tFuncLib[] FuncLibArray

        Move (Trim(sFn)) to sFn
        If (sFn = "") ;
            Function_Return True
        Move (Eval("get_" - sFn)) to iFunctionID
        If (iFunctionID = 0) ;
            Function_Return True
        // The dispatch below hands the function a SINGLE line (String ByRef), so it is valid ONLY for the
        // line-by-line families (eStandardFunction / eRemoveFunction). A whole-file function takes a
        // String[] ByRef, and forcing a String into it faults 4381 (Illegal Datatype Conversion) - e.g.
        // ChangeBeginEndConstraint is eOtherFunction yet carries "command: Begin_Constraint" recipes, so
        // VerifyAutoFix's Guard D routes it here. Look up the METHOD TYPE FunctionsA-free (pFuncLibArray is
        // built in the app AND the pure DFUnit runner, unlike FunctionsA) and never line-probe a
        // non-line-by-line function - keep it (return True, no demote) rather than crash. Its whole-file
        // counterpart AutoFixWholeFileWouldChange handles the whole-file dry-run. (Nils, LegacyApp 2026-07-02.)
        Move (Lowercase(sFn)) to sFnLc
        Get pFuncLibArray to FuncLibArray
        Move (SizeOfArray(FuncLibArray)) to iCount
        For i from 0 to (iCount - 1)
            If (Lowercase(FuncLibArray[i].sName) = sFnLc) Begin
                If (FuncLibArray[i].eFunctionType <> eStandardFunction and FuncLibArray[i].eFunctionType <> eRemoveFunction) ;
                    Function_Return True
                Move iCount to i    // matched line-by-line (names are unique): stop scanning, then dispatch
            End
        Loop
        Send SaveErrorState
        Send ClearFuncLibProperties
        Move sSourceLine to sLineCopy
        Send InitializeTokenizer sLineCopy
        Get iFunctionID of Self (&sLineCopy) "" to bChanged
        Send ClearFuncLibProperties
        Send RestoreErrorState
        Function_Return bChanged
    End_Function

    // "Would running this refactor function change this FILE anywhere?" - the whole-FILE probe the analyzer
    // uses to demote a permanently-recurring Auto-fix row whose function actually leaves the file untouched
    // (RemovePropertyPrivate keeps a same-named backing store; RemovePropertyPublic finds no PUBLIC property -
    // record_set_mixin.pkg / aps.pkg). Answers per the (file, function) row: True = actionable (the function
    // fixes at least one occurrence) -> keep Auto-fix; False = nothing here -> demote to Explain. Returns True
    // (keep, never demote on doubt) if the function can't be resolved. Routes by the function's MethodType
    // (looked up by name via FunctionsA, Index.2): eOtherFunction = ONE whole-file call (returns a change
    // count); eStandardFunction / eRemoveFunction = run over EVERY line as the engine does (change if ANY line
    // changes - these converters decide purely from line content, so an isolated per-line run is faithful);
    // anything else -> keep. Isolated (error state + properties saved/restored); no file write - a copy is
    // discarded. (Nils, 2026-07-01.)
    // (asLines ByRef purely to avoid deep-copying the whole file per call - the analyzer probes
    // ~1400 (file,function) pairs per analyze and the copy happens at the CALL boundary, before
    // any early-out. Never modified: the eOtherFunction dry-run works on its own asCopy below.)
    Function AutoFixWholeFileWouldChange String sFn String[] ByRef asLines Returns Boolean
        Integer iFunctionID iRetval iType i iN
        String[] asCopy asNeedles
        Boolean bChanged bLineChanged bLook bWasProbe
        String sLineCopy sFnLc sSideCmd

        Move (Trim(sFn)) to sFn
        If (sFn = "") ;
            Function_Return True
        // FAST PATH for the property removers: running the FULL RemovePropertyPrivate/Public over every file
        // to answer "would this change anything?" was ~26s of the LegacyApp analyze. WouldRemovePropertyChange
        // gives the IDENTICAL yes/no with a lightweight scan (a "Property ... <keyword>" line - a pure string
        // test - and for Private a name that is not a backing-store accessor), early-exiting on the first
        // changeable line, with NO per-property tokenize / output build. It shares RemovePropertyPrivate's
        // protected-name PASS via _CollectPropertyProtectedNames, so the two can't drift. (Nils perf 2026-07-02.)
        Move (Lowercase(sFn)) to sFnLc
        If (sFnLc = "removepropertyprivate") Begin
            Get WouldRemovePropertyChange (&asLines) "private" to bChanged
            Function_Return bChanged
        End
        If (sFnLc = "removepropertypublic") Begin
            Get WouldRemovePropertyChange (&asLines) "public" to bChanged
            Function_Return bChanged
        End
        Clear FunctionsA
        Move sFn to FunctionsA.Function_Name
        Find eq FunctionsA.Function_Name
        If (Found = False) ;
            Function_Return True
        Move FunctionsA.Type to iType
        Move (Eval("get_" - sFn)) to iFunctionID
        If (iFunctionID = 0) ;
            Function_Return True
        Send SaveErrorState
        Send ClearFuncLibProperties
        Move False to bChanged
        If (iType = eOtherFunction) Begin
            // WHOLE-FILE: one call, ByRef String[], returns the change count.
            Move asLines to asCopy
            // A function that also writes ANOTHER file (ChangeExternalFunctionCallers: DfTypesStructs.pkg) asks
            // pbWholeFileProbe first: this is a question about the copy, never a run (2026-11-13).
            Get pbWholeFileProbe to bWasProbe
            Set pbWholeFileProbe to True
            Get iFunctionID of Self (&asCopy) "" to iRetval
            Set pbWholeFileProbe to bWasProbe
            Move (iRetval <> 0) to bChanged
        End
        Else If (iType = eStandardFunction or iType = eRemoveFunction) Begin
            // LINE-BY-LINE: run over EVERY line (as the engine does); actionable if ANY line changes. Early
            // out once a change is seen; each line tokenized fresh.
            /* A command converter that can DECLINE on what FOLLOWS the line (the side-product guard,
               2026-09-08) needs the same look-ahead the engine gives it, or this probe answers for a
               line with nothing under it and the plan keeps promising an Auto-fix the run refuses.
               Gated on the function actually being one of those: the array copy is the very reason
               asLines is ByRef, and ~1400 (file, function) pairs are probed per analyze. */
            Get _SideProductCommandOfFunction sFn to sSideCmd
            If (sSideCmd <> "") Begin
                Move (StrSplitToArray("found|strmark|strlen", "|")) to asNeedles
                Get _FileContainsAnyText (&asLines) (&asNeedles) to bLook
                If (bLook = True) ;
                    Set pasLinePassSource to asLines
                Set pbLinePassSideProducts to bLook
            End
            Move (SizeOfArray(asLines) - 1) to iN
            For i from 0 to iN
                If (bChanged = False) Begin
                    Set piLinePassIndex to i
                    Move asLines[i] to sLineCopy
                    Send InitializeTokenizer sLineCopy
                    Get iFunctionID of Self (&sLineCopy) "" to bLineChanged
                    If (bLineChanged = True) ;
                        Move True to bChanged
                End
            Loop
            If (sSideCmd <> "") Begin
                Set pasLinePassSource to asCopy
                Set pbLinePassSideProducts to False
                Set piLinePassIndex to -1
            End
        End
        Else Begin
            // Editor / *All / unknown - not probed this way; don't demote.
            Move True to bChanged
        End
        Send ClearFuncLibProperties
        Send RestoreErrorState
        Function_Return bChanged
    End_Function

    // Collect the "protected accessor" names in a source file: a custom getter (Function <name>) / setter
    // (Procedure Set <name>), or a qualified class.property reference, makes a same-named Private Property a
    // load-bearing BACKING STORE / mixin store whose Private must NOT be stripped. Stateless string parsing
    // (NOT the funclib Tokenizer, which mis-tracks cross-line scope and hid the Property AFTER a Procedure /
    // Function - the LegacyApp backing-store bug). Shared by RemovePropertyPrivate (PASS 1) and the analyzer's
    // WouldRemovePropertyChange fast path so the two never drift. (Nils 2026-07-01; extracted perf 2026-07-02.)
    // (asCode ByRef = copy-avoidance only, never modified - see AutoFixWholeFileWouldChange.)
    Function _CollectPropertyProtectedNames String[] ByRef asCode Returns String[]
        String[] asProtected asDotted
        String sName sLC
        Integer iCount iSize iDotMax iDotIdx

        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from 0 to iSize
            Move (Lowercase(Trim(asCode[iCount]))) to sLC
            If (Left(sLC, 2) <> "//" and sLC <> "") Begin
                // "function " (with the trailing space) excludes Function_Return, which is a single token.
                If (Pos("function ", sLC) = 1) Begin
                    Get _NthWord asCode[iCount] 2 to sName
                    If (sName <> "") ;
                        Move sName to asProtected[SizeOfArray(asProtected)]
                End
                Else If (Pos("procedure set ", sLC) = 1) Begin
                    Get _NthWord asCode[iCount] 3 to sName
                    If (sName <> "") ;
                        Move sName to asProtected[SizeOfArray(asProtected)]
                End
                // A property declared WITHOUT Private anywhere in the file protects a Private twin of the
                // same name: they are two storages (the Private one registers under its class-scoped name),
                // and stripping Private would merge them - one class carrying both forms of the same two
                // names lost 40 symbols that way (2026-09-07). Only Private lines are checked against
                // this list, so a public name in it costs nothing.
                Else If (Pos("property ", sLC) = 1 and Pos(" private", sLC) = 0) Begin
                    Get _NthWord asCode[iCount] 3 to sName
                    If (sName <> "") ;
                        Move sName to asProtected[SizeOfArray(asProtected)]
                End
                // Also protect a property reached via a qualified 'class.property' reference (e.g. a VDFQuery
                // mixin's 'aps_panel_mx.p_resize_in_progress'): stripping Private breaks every qualified access.
                Get _DottedNames asCode[iCount] to asDotted
                Move (SizeOfArray(asDotted) - 1) to iDotMax
                For iDotIdx from 0 to iDotMax
                    Move asDotted[iDotIdx] to asProtected[SizeOfArray(asProtected)]
                Loop
            End
        Loop
        Function_Return asProtected
    End_Function

    // "Would RemovePropertyPrivate / RemovePropertyPublic change this file?" - the analyzer's demote asks this
    // per file, and running the FULL refactor to answer it was ~26s of the LegacyApp analyze. This returns the
    // IDENTICAL yes/no from a lightweight scan: RemovePropertyPublicPrivate strips the keyword EXACTLY when a
    // "Property ..." line carries a space/tab-delimited <keyword> (a pure string test - the tokenize it does
    // has no bearing on the yes/no). For "private" a name that is a protected backing-store accessor is
    // excluded (the SAME PASS the real function runs, via _CollectPropertyProtectedNames); "public" is
    // unconditional (RemovePropertyPublic is line-by-line, no backing-store PASS). Early-exits on the first
    // changeable line. (Nils perf 2026-07-02.)
    // (asCode ByRef = copy-avoidance only, never modified - see AutoFixWholeFileWouldChange.)
    Function WouldRemovePropertyChange String[] ByRef asCode String sKeyword Returns Boolean
        String[] asProtected
        String sLC sName sText sKw
        Integer iCount iSize iPos
        Boolean bCheckProtected bProtected

        Move (Lowercase(Trim(sKeyword))) to sKw
        Move (sKw = "private") to bCheckProtected
        If (bCheckProtected) ;
            Get _CollectPropertyProtectedNames (&asCode) to asProtected
        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from 0 to iSize
            Move (Lowercase(Trim(asCode[iCount]))) to sLC
            If (Left(sLC, 2) <> "//" and Pos("property ", sLC) = 1) Begin
                Move False to bProtected
                If (bCheckProtected) Begin
                    Get _NthWord asCode[iCount] 3 to sName
                    Get _NameInList sName asProtected to bProtected
                    If (sName = "") ;
                        Move True to bProtected   // the real PASS 2 acts only when the name is non-blank
                End
                If (bProtected = False) Begin
                    // RemovePropertyPublicPrivate's EXACT change condition: lowercased line + a trailing space,
                    // then look for the keyword space-delimited (or tab-delimited on the left).
                    Move (Lowercase(asCode[iCount]) + CS_S) to sText
                    Move (Pos(CS_S + sKw + CS_S, sText)) to iPos
                    If (iPos = 0) ;
                        Move (Pos(Character(9) + sKw + CS_S, sText)) to iPos
                    If (iPos > 0) ;
                        Function_Return True
                End
            End
        Loop
        Function_Return False
    End_Function

    // Joins all tokens from iStart onwards into a single space-separated string (RTrimmed).
    // Use this instead of an explicit For-loop over asLineTokens when rebuilding a source line.
    Function RebuildLineFromTokens String[] asTokens Integer iStart Returns String
        String sResult
        Integer iCount iSize

        Move "" to sResult
        Move (SizeOfArray(asTokens)) to iSize
        Decrement iSize
        For iCount from iStart to iSize
            Append sResult asTokens[iCount] CS_S
        Loop
        Move (RTrim(sResult)) to sResult
        Function_Return sResult
    End_Function

    // Prepends indentation and appends end comment to sContent, returning the final output line.
    // This is the standard way to reconstruct an output source line inside a refactoring function.
    Function AssembleOutputLine String sContent tTokenizer TokenizerData Returns String
        String sLine

        Move (TokenizerData.sIndentation + String(sContent)) to sLine
        If (TokenizerData.sEndComment <> "") Begin
            Append sLine CS_S TokenizerData.sEndComment
        End
        Function_Return sLine
    End_Function

    // ==== ChangeObjectFunctionCallToGet helpers (DF26 call-syntax modernization) ==================
    // DF26 rejects an OBJECT method called in the EXPRESSION form  (Name(Self, args))  and wants the Get
    // command  Get Name args to dest . These helpers classify + rewrite the safe shape and leave the rest
    // for a human. All matching runs on the string/comment-masked twin (TD.sOverstrikeLine) so a paren,
    // comma or "self" inside a literal or comment is never counted.

    // Names of Functions declared WITHOUT the [Global] keyword in this file = object methods (the calls we
    // may touch). Syntax is "Function <name> [Global] ...", so the method test is: the token after the name
    // is not "Global". Plain string parse (no stateful Tokenizer) so it does not advance the lexer's block-
    // comment state before the rewrite pass. A leading "//" comment can't match the "function " prefix; a
    // Function line buried inside a /* */ block is a rare false positive that at worst yields a spurious flag.
    Function _CollectLocalFunctionNames String[] ByRef asCode Returns String[]
        String[] asNames
        String sLine sT sRest sRest2 sName sWord
        Integer iCount iSize iSp iSp2

        Move (SizeOfArray(asCode)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move (Trim(asCode[iCount])) to sT
            If (Lowercase(Left(sT, 9)) = "function ") Begin
                Move (Trim(Right(sT, (Length(sT) - 9)))) to sRest
                Move (Pos(" ", sRest)) to iSp
                If (iSp > 0) Begin
                    Move (Left(sRest, (iSp - 1))) to sName
                    Move (Trim(Right(sRest, (Length(sRest) - iSp)))) to sRest2
                    Move (Pos(" ", sRest2)) to iSp2
                    If (iSp2 > 0) ;
                        Move (Lowercase(Left(sRest2, (iSp2 - 1)))) to sWord
                    Else ;
                        Move (Lowercase(sRest2)) to sWord
                    If (sWord <> "global" and sName <> "") ;
                        Move sName to asNames[SizeOfArray(asNames)]
                End
            End
        Loop
        Function_Return asNames
    End_Function

    // Given a masked line sOver and the position of a "(", returns the position of the matching ")". 0 if
    // unbalanced. sOver has literals blanked, so every paren here is real code.
    Function _MatchParenInOver String sOver Integer iOpen Returns Integer
        Integer iLen iDepth i
        String sCh

        Move (Length(sOver)) to iLen
        Move 0 to iDepth
        For i from iOpen to iLen
            Move (Mid(sOver, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            Else If (sCh = ")") Begin
                Decrement iDepth
                If (iDepth = 0) ;
                    Function_Return i
            End
        Loop
        Function_Return 0
    End_Function

    /* _LegacyTypeCastInLine - the TYPE NAME USED AS A CONVERSION FUNCTION, rewritten to Cast().

           Send exportGridToExcel (Handle(Self))  ->  Send exportGridToExcel (Cast(Self, Handle))

       DF 26 rejects it with error 4328 "Undefined symbol in argument" - and names the type's INTERNAL
       name, which for two of them is a word that appears nowhere in the source: Handle reports LONGPTR
       and Pointer reports ADDRESS. That is what makes the row unreadable (Nils 2026-08-19, WinServ:
       "Undefined symbol - a missing DB field/table..." on a line with no field and no Type member).

       EIGHTEEN type names, not the five this started with. The 2026-08-19 pass probe-proved five and
       described them as "exactly the type names DF 26 refuses"; re-probing the whole type vocabulary on
       2026-08-30 found thirteen more, so the original five were a sample rather than the set. Each of the
       eighteen errors 4328 in the call form and each Cast(<expr>, <Type>) replacement compiles clean;
       Integer, String, Number, Date and Real remain legal conversion functions and are NOT touched.

       The distinction is not guessable from the name, which is why every entry is compiled rather than
       reasoned about: Integer(x) is fine and UInteger(x) is not; Date(x) is fine and DateTime(x) is not;
       Real(x) is fine and BigInt(x) is not. A name added here on the strength of looking like a type
       would rewrite working code.

       Adding one: build a scratch program with "Move (<Type>(iX)) to hoY" against the 26.0 toolchain,
       and put a deliberate bad symbol in the same file so a compile that never ran cannot read as a
       pass. Error 4328 means it belongs in the list; a clean build means it must stay out.

       Works on the MASKED line (literals and comments blanked) so a cast inside a string or a comment is
       invisible, and re-tokenizes after every rewrite because the positions move. A declaration
       ("Handle hMenu") is never a call - the name must be followed by "(" - and an already-converted
       Cast(x, Handle) is skipped for the same reason, which makes this idempotent.

       Returns the number of rewrites; sLine is updated in place. */
    Function _LegacyTypeCastInLine String ByRef sLine Returns Integer
        tTokenizer TD
        String[] asTypes
        String sOver sInner sType
        Integer iType iPos iOpen iClose iChanged iGuard iOverLen
        Boolean bRestart

        // The original five (probed 2026-08-19).
        Move "Handle"   to asTypes[0]
        Move "Pointer"  to asTypes[1]
        Move "Boolean"  to asTypes[2]
        Move "DateTime" to asTypes[3]
        Move "UChar"    to asTypes[4]
        // The thirteen the first pass missed (probed 2026-08-30, same technique). The compiler
        // reports the RESOLVED alias, which is why several share one 4328 text: Handle and Longptr
        // both report LONGPTR, Pointer and Address both report ADDRESS, UInteger and DWord both
        // report UINTEGER.
        Move "Longptr"  to asTypes[5]
        Move "ULongptr" to asTypes[6]
        Move "Address"  to asTypes[7]
        Move "UInteger" to asTypes[8]
        Move "DWord"    to asTypes[9]
        Move "Word"     to asTypes[10]
        Move "Short"    to asTypes[11]
        Move "BigInt"   to asTypes[12]
        Move "Char"     to asTypes[13]
        Move "Byte"     to asTypes[14]
        Move "RowId"    to asTypes[15]
        Move "Variant"  to asTypes[16]
        Move "TimeSpan" to asTypes[17]

        Move 0 to iChanged
        Move 0 to iGuard
        Move True to bRestart
        While (bRestart = True and iGuard < 20)
            Move False to bRestart
            Increment iGuard
            Get Tokenizer of Self sLine to TD
            // The overstrike line has the indent STRIPPED - re-attach it so the masked twin is
            // position-aligned with sLine (the same correction UnicodeOemAnsiFunctions makes).
            Move (TD.sIndentation + TD.sOverstrikeLine) to sOver
            Move (Length(sOver)) to iOverLen
            // BOUND FROM THE ARRAY, never a literal. This read "For iType from 0 to 4" while the list
            // held five names; when the list grew to eighteen on 2026-08-30 the loop still stopped at
            // the fifth, so the thirteen new types were silently never scanned. Nothing failed - the
            // converter just quietly did four-fifths less than its own list promised.
            For iType from 0 to (SizeOfArray(asTypes) - 1)
                If (bRestart = False) Begin
                    Move asTypes[iType] to sType
                    Get _FindKeywordPos of Self sOver sType True 1 to iPos
                    While (iPos > 0 and bRestart = False)
                        Move (iPos + Length(sType)) to iOpen
                        /* BOUNDED BY THE LINE LENGTH, and that is not belt-and-braces: DataFlex compares
                           strings ignoring trailing spaces, so a Mid() past the end returns "" and
                           ("" = " ") is TRUE. Without the iOpen <= iOverLen test this loop runs forever
                           on any line whose LAST token is one of these type names - which is exactly what
                           hung the test runner on 2026-08-19. */
                        While (iOpen <= iOverLen and Mid(sOver, 1, iOpen) = " ")
                            Increment iOpen
                        Loop
                        If (Mid(sOver, 1, iOpen) = "(") Begin
                            Get _MatchParenInOver of Self sOver iOpen to iClose
                            // (iClose > iOpen + 1) - an empty "Handle()" is not a cast, leave it be.
                            If (iClose > (iOpen + 1)) Begin
                                Move (Mid(sLine, (iClose - iOpen - 1), (iOpen + 1))) to sInner
                                Move (Left(sLine, (iPos - 1)) + "Cast(" + sInner + ", " + sType + ")" ;
                                      + Right(sLine, (Length(sLine) - iClose))) to sLine
                                Increment iChanged
                                Move True to bRestart      // positions moved - re-tokenize and rescan
                            End
                        End
                        If (bRestart = False) ;
                            Get _FindKeywordPos of Self sOver sType True (iPos + 1) to iPos
                    Loop
                End
            Loop
        Loop
        Function_Return iChanged
    End_Function

    // (The three helpers below are declared BEFORE the function that calls them - DataFlex resolves an
    //  object function used in an expression at the point of use.)

    // Position of the LAST " to " in a lower-cased code line, 0 when there is none. (The destination of
    // a Get is what follows it; an argument list can contain the word too, so the last one wins.)
    Function _LastToPos String sLow Returns Integer
        Integer iPos iFound
        Move 0 to iFound
        Get _FindKeywordPos of Self sLow "to" True 1 to iPos
        While (iPos > 0)
            Move iPos to iFound
            Get _FindKeywordPos of Self sLow "to" True (iPos + 1) to iPos
        Loop
        Function_Return iFound
    End_Function

    // Index of the next line that carries CODE (not blank, not a whole-line comment), or 0.
    Function _NextCodeLineIdx String[] ByRef asCode Integer iFrom Integer iSize Returns Integer
        Integer j
        String sCode
        For j from iFrom to iSize
            Get _CodeOnlyLine of Self asCode[j] to sCode
            If (Trim(sCode) <> "") ;
                Function_Return j
        Loop
        Function_Return 0
    End_Function

    /* The index of the line that CLOSES the If starting at iIf, or 0 when it cannot be determined.
       Three shapes: "If (...) Begin" ... "End"; "If (...) ;" with the statement on the next line; and a
       one-line "If (...) <statement>". Nesting is counted on the trailing Begin / bare End only, which is
       what a DataFlex block uses - End_Procedure and friends carry a suffix and never match. */
    Function _IfBlockEndIdx String[] ByRef asCode Integer iIf Integer iSize Returns Integer
        String sCode sLow
        Integer j iDepth

        Get _CodeOnlyLine of Self asCode[iIf] to sCode
        Move (Lowercase(Trim(sCode))) to sLow
        If (Right(sLow, 6) = " begin" or sLow = "begin") Begin
            Move 1 to iDepth
            For j from (iIf + 1) to iSize
                Get _CodeOnlyLine of Self asCode[j] to sCode
                Move (Lowercase(Trim(sCode))) to sLow
                If (Right(sLow, 6) = " begin" or sLow = "begin") ;
                    Increment iDepth
                If (sLow = "end") Begin
                    Decrement iDepth
                    If (iDepth = 0) ;
                        Function_Return j
                End
            Loop
            Function_Return 0
        End
        // "If (...) ;" - the statement continues on the next line.
        If (Right(sLow, 1) = ";") Begin
            Get _NextCodeLineIdx of Self (&asCode) (iIf + 1) iSize to j
            Function_Return j
        End
        // A one-line If with its statement on the same line.
        Function_Return iIf
    End_Function

    /* OEM_TRANSLATE_STATE, retired (W 4540 "Obsolete Object Function ... controls are Unicode now").
       DataFlex marks BOTH accessors obsolete in Windows.pkg; the property still exists, so everything
       still compiles and the only signal is the warning. Two shapes, and they are NOT the same problem
       (Nils 2026-08-19, whose workspace has 18 of the first and 1 of the second):

       WRITE - "Set Oem_Translate_State [of <obj>] to <x>". Nothing reads a value, so the statement is a
       pure no-op today. Commenting it out cannot change behaviour.

       READ - "Get Oem_Translate_State ... to <var>" feeding a test:

           Get Oem_Translate_State of (phTextRegParent(Self)) to bOEMTranslateState
           If (not(bOEMTranslateState)) Begin
               Move (Utf8ToAnsi(sText)) to sText
           End

       Commenting out ONLY the Get is the trap: <var> falls back to its declared default (False for a
       Boolean), so "not(False)" is True and the body starts running ALWAYS - and here that body
       downgrades UTF-8 to ANSI on its way into a control that is now Unicode, i.e. the naive rewrite
       picks the one outcome that corrupts text. So the WHOLE block goes behind a marker instead, for a
       human to delete or to keep unconditionally. That decision cannot be read off the source.

       Four guards, all of which must hold before a block is touched; any failure leaves the lines alone
       and is counted as declined (the caller reports them):
         1. the very next code line is an If that tests <var>,
         2. <var> appears NOWHERE else in the file (otherwise the other reader silently changes),
         3. the block has no Else (one of the two branches would be live code, and which one is a
            judgement),
         4. the block's End is found at the right depth.
       Returns the number of lines commented; piOemStateDeclined counts the read sites left alone. */
    Function _RetireOemTranslateStateInLines String[] ByRef asCode Returns Integer
        String[] asOut
        String sLine sCode sLow sVar sIndent sNextCode sMarker
        Integer i iSize iChanged iDeclined iNext iEnd j iPos iUses
        Boolean bBlockOk

        Move 0 to iChanged
        Move 0 to iDeclined
        Move (SizeOfArray(asCode) - 1) to iSize
        Move 0 to i
        While (i <= iSize)
            Move asCode[i] to sLine
            Get _CodeOnlyLine of Self sLine to sCode
            Move (Lowercase(sCode)) to sLow
            If (Pos("oem_translate_state", sLow) = 0) Begin
                Move sLine to asOut[SizeOfArray(asOut)]
                Increment i
            End
            Else If (Left(Trim(sLow), 4) = "set ") Begin
                // WRITE form - a no-op statement, commented in place.
                Move (Trim(sLine)) to sIndent
                Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                Move (sIndent + "// " + LTrim(sLine) + "   // DFRefactor: retired - Oem_Translate_State does nothing on a Unicode DataFlex (W 4540).") to asOut[SizeOfArray(asOut)]
                Increment iChanged
                Increment i
            End
            Else If (Pos("get ", sLow) > 0 and Pos(" to ", sLow) > 0) Begin
                // READ form - only the guarded whole-block retire, never the Get on its own.
                /* The destination starts 3 characters past the "t" of "to" (t-o-space), so the tail to
                   keep is Length - iToPos - 2. It was -3 first, which ate the variable's FIRST letter -
                   "bOEM" became "OEM" - and the whole-word guard below then rejected the very block it
                   was reading. The guard TESTS still passed, because they assert that nothing happens:
                   a false negative is invisible to a test written for the negative case. */
                Move (_LastToPos(Self, sLow)) to iPos
                Move (Trim(Right(sCode, (Length(sCode) - iPos - 2)))) to sVar
                Move False to bBlockOk
                Move 0 to iEnd
                If (sVar <> "") Begin
                    Get _NextCodeLineIdx of Self (&asCode) (i + 1) iSize to iNext
                    If (iNext > 0) Begin
                        Get _CodeOnlyLine of Self asCode[iNext] to sNextCode
                        // Guard 1: the next code line is an If that tests this variable.
                        If (Left(Lowercase(Trim(sNextCode)), 3) = "if " and _FindKeywordPos(Self, sNextCode, sVar, True, 1) > 0) Begin
                            Get _IfBlockEndIdx of Self (&asCode) iNext iSize to iEnd
                            If (iEnd > 0) ;
                                Move True to bBlockOk
                        End
                    End
                End
                /* Guard 2: nothing else in the file touches the variable. Its DECLARATION is the one
                   mention that is harmless (it is what makes the commented block still compile away),
                   so declaration lines are excluded by IsVariableDeclarationLine rather than by
                   counting - an earlier "more than one mention" threshold let a real reader through
                   whenever the file had no declaration line of its own. */
                If (bBlockOk = True) Begin
                    Move 0 to iUses
                    For j from 0 to iSize
                        If (j < i or j > iEnd) Begin
                            Get _CodeOnlyLine of Self asCode[j] to sNextCode
                            If (_FindKeywordPos(Self, sNextCode, sVar, True, 1) > 0) Begin
                                If (IsVariableDeclarationLine(Self, sNextCode) = False) ;
                                    Increment iUses
                            End
                        End
                    Loop
                    If (iUses > 0) ;
                        Move False to bBlockOk
                End
                /* Guard 3: the If has no Else. The Else does NOT sit inside the block - it follows the
                   End that closes it - so this asks the next CODE line, which is where it lives. */
                If (bBlockOk = True) Begin
                    Get _NextCodeLineIdx of Self (&asCode) (iEnd + 1) iSize to j
                    If (j > 0) Begin
                        Get _CodeOnlyLine of Self asCode[j] to sNextCode
                        If (Left(Lowercase(Trim(sNextCode)), 4) = "else") ;
                            Move False to bBlockOk
                    End
                End
                If (bBlockOk = True) Begin
                    Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                    Move (sIndent + "// *** DFRefactor: Oem_Translate_State is obsolete (W 4540) - it does nothing on a") to sMarker
                    Move sMarker to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// *** Unicode DataFlex, so this test can only ever take one branch. The WHOLE block is") to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// *** commented out for you to decide: delete it if the body is a legacy artefact (a") to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// *** conversion into a control that is Unicode now), or restore the body WITHOUT the") to asOut[SizeOfArray(asOut)]
                    Move (sIndent + "// *** test if it is still wanted. Nothing else in this file reads " + sVar + ".") to asOut[SizeOfArray(asOut)]
                    For j from i to iEnd
                        Move (Left(asCode[j], (Length(asCode[j]) - Length(LTrim(asCode[j]))))) to sIndent
                        Move (sIndent + "// " + LTrim(asCode[j])) to asOut[SizeOfArray(asOut)]
                        Increment iChanged
                    Loop
                    Move (iEnd + 1) to i
                End
                Else Begin
                    // Left exactly as it was - the caller reports it as hand work.
                    Move sLine to asOut[SizeOfArray(asOut)]
                    Increment iDeclined
                    Increment i
                End
            End
            Else Begin
                Move sLine to asOut[SizeOfArray(asOut)]
                Increment i
            End
        Loop
        Set piOemStateDeclined to iDeclined
        If (iChanged > 0) ;
            Move asOut to asCode
        Function_Return iChanged
    End_Function

    // Splits argument list sArgs at TOP-LEVEL commas. sArgsOver is its masked twin (same length), so commas
    // inside nested parens or string literals are not split points. Each returned argument is trimmed.
    Function _SplitTopLevelArgs String sArgs String sArgsOver Returns String[]
        String[] asOut
        String sCh
        Integer iLen iDepth iStart i

        Move (Length(sArgs)) to iLen
        Move 0 to iDepth
        Move 1 to iStart
        For i from 1 to iLen
            Move (Mid(sArgsOver, 1, i)) to sCh
            If (sCh = "(") ;
                Increment iDepth
            Else If (sCh = ")") ;
                Decrement iDepth
            Else If (sCh = "," and iDepth = 0) Begin
                Move (Trim(Mid(sArgs, (i - iStart), iStart))) to asOut[SizeOfArray(asOut)]
                Move (i + 1) to iStart
            End
        Loop
        If (iStart <= iLen) ;
            Move (Trim(Mid(sArgs, (iLen - iStart + 1), iStart))) to asOut[SizeOfArray(asOut)]
        Function_Return asOut
    End_Function

    // A "simple" Get argument: safe to drop bare (space-separated) into the Get command - a single
    // identifier / number / property, or one fully-quoted string literal. Nested calls, embedded spaces and
    // arithmetic operators are NOT simple; the caller flags such calls instead of guessing a parenthesised form.
    Function _IsSimpleGetArg String sArg Returns Boolean
        String sT
        Integer iQ

        Move (Trim(sArg)) to sT
        If (sT = "") ;
            Function_Return False
        // Replaces (ALL occurrences), NOT Replace (first only): a single string literal has exactly two
        // quote chars, so removing them must strip BOTH. With Replace the count came back 1, the iQ=2 test
        // failed, and a quoted arg CONTAINING A SPACE ("New York") fell through to the space check below and
        // was wrongly judged non-simple -> the whole call got flagged instead of rewritten. (Nils 2026-07-07.)
        If (Left(sT, 1) = '"' and Right(sT, 1) = '"') Begin
            Move (Length(sT) - Length(Replaces('"', sT, ""))) to iQ
            If (iQ = 2) ;
                Function_Return True
        End
        If (Left(sT, 1) = "'" and Right(sT, 1) = "'") Begin
            Move (Length(sT) - Length(Replaces("'", sT, ""))) to iQ
            If (iQ = 2) ;
                Function_Return True
        End
        If (Pos("(", sT) > 0) ;
            Function_Return False
        If (Pos(" ", sT) > 0) ;
            Function_Return False
        If (Pos("+", sT) > 0 or Pos("*", sT) > 0 or Pos("/", sT) > 0) ;
            Function_Return False
        Function_Return True
    End_Function

    // The identifier that ends at position iEndPos in sText (scanning left over identifier chars). "" if the
    // char there is not part of an identifier (e.g. the "(" was preceded by a space - the outer Move paren).
    Function _IdentBefore String sText Integer iEndPos Returns String
        String sCh sName
        Integer i iLen
        Boolean bIdent bMore

        Move "" to sName
        Move (Length(sText)) to iLen
        If (iEndPos < 1 or iEndPos > iLen) ;
            Function_Return ""
        Move iEndPos to i
        Move True to bMore
        While (i >= 1 and bMore = True)
            Move (Mid(sText, 1, i)) to sCh
            Get _IsIdentifierChar sCh to bIdent
            If (bIdent = True) Begin
                Move (sCh + sName) to sName
                Decrement i
            End
            Else ;
                Move False to bMore
        Loop
        Function_Return sName
    End_Function

    // True if the (masked) line holds a call "Name(Self..." where Name is a confirmed local method and Self is
    // its FIRST argument (followed by ',' or ')'). Used to decide whether a non-fixable line still deserves a flag.
    Function _HasLocalSelfCall String sCode String sOver String[] asLocalFns Returns Boolean
        String sCh sFour sAfter sName
        Integer iLen i iFound
        Boolean bResult bBoundary bIdentAfter

        Move False to bResult
        Move (Length(sOver)) to iLen
        For i from 1 to iLen
            If (bResult = False) Begin
                Move (Mid(sOver, 1, i)) to sCh
                If (sCh = "(" and ((i + 4) <= iLen)) Begin
                    Move (Lowercase(Mid(sOver, 4, (i + 1)))) to sFour
                    If (sFour = "self") Begin
                        Move True to bBoundary
                        If ((i + 5) <= iLen) Begin
                            Move (Mid(sOver, 1, (i + 5))) to sAfter
                            Get _IsIdentifierChar sAfter to bIdentAfter
                            If (bIdentAfter = True) ;
                                Move False to bBoundary
                        End
                        If (bBoundary = True) Begin
                            Get _IdentBefore of Self sCode (i - 1) to sName
                            If (sName <> "") Begin
                                Move (SearchArray(sName, asLocalFns, Desktop, RefFunc(DFSTRICMP))) to iFound
                                If (iFound > -1) ;
                                    Move True to bResult
                            End
                        End
                    End
                End
            End
        Loop
        Function_Return bResult
    End_Function

    // The core per-line converter. iAction (ByRef): 0 = no local-method expression call (copy verbatim);
    // 1 = rewritten (return value is the "Get Name args to dest" line, indent + trailing comment preserved);
    // 2 = a local-method expression call that is NOT the clean whole-'Move (Name(Self..)) to dest' shape with
    // simple args (nested in a bigger expression, complex/nested-call args, non-Move host, first arg not Self)
    // -> the caller flags the ORIGINAL line. Only confirmed in-file methods are touched, so a global call, or
    // a name declared elsewhere, is left strictly alone.
    Function _ObjExprCallToGet String sLine String[] asLocalFns Integer ByRef iAction Returns String
        tTokenizer TD
        String sOver sCode sLowCode sName sInner sInnerOver sCallArgs sCallArgsOver sDest sGetArgs sContent sCh
        String[] asArgs
        Integer iOpen iClose iToPos iCallOpen iCallClose iLen iInnerLen i iN iFound
        Boolean bHasCall bFixed bAllSimple bMore bIdent bSimple

        Move 0 to iAction
        Get Tokenizer of Self sLine to TD
        Move TD.sOverstrikeLine to sOver
        Move sLine to sCode
        If (TD.sEndComment <> "") ;
            Move (Replace(TD.sEndComment, sCode, "")) to sCode
        Move (Trim(sCode)) to sCode

        If (Pos("(self", (Lowercase(sOver))) = 0) ;
            Function_Return sLine
        Get _HasLocalSelfCall of Self sCode sOver asLocalFns to bHasCall
        If (bHasCall = False) ;
            Function_Return sLine

        // Try the clean, auto-fixable shape:  Move ( Name(Self[, simple args]) ) to dest
        Move False to bFixed
        Move (Lowercase(sCode)) to sLowCode
        Move (Length(sCode)) to iLen
        If (Left(sLowCode, 6) = "move (") Begin
            Move 6 to iOpen
            Get _MatchParenInOver of Self sOver iOpen to iClose
            If (iClose > iOpen) Begin
                Get _FindKeywordPos of Self sOver "to" True (iClose + 1) to iToPos
                If (iToPos > iClose) Begin
                    // only whitespace between the outer ')' and the 'to'
                    If (Trim(Mid(sCode, (iToPos - iClose - 1), (iClose + 1))) = "") Begin
                        Move (Trim(Right(sCode, (iLen - iToPos - 1)))) to sDest
                        /* AN INDICATOR TAKES NO GET (2026-10-31): 'Get Row_Count to Found' is error 4345 ("FOUND,
                           INDICATOR NOT ALLOWED"), so a Move into Found, FindErr, Err, SeqEof or Select stays as
                           it is. */
                        If (_IsBuiltInIndicatorName(Self, sDest)) ;
                            Function_Return sLine
                        Move (Mid(sCode, (iClose - iOpen - 1), (iOpen + 1))) to sInner        // raw, aligned
                        Move (Mid(sOver, (iClose - iOpen - 1), (iOpen + 1))) to sInnerOver    // masked twin
                        Move (Length(sInner)) to iInnerLen
                        // skip leading spaces, read the callee identifier
                        Move 1 to i
                        While (i <= iInnerLen and Mid(sInner, 1, i) = " ")
                            Increment i
                        Loop
                        Move "" to sName
                        Move True to bMore
                        While (i <= iInnerLen and bMore = True)
                            Move (Mid(sInner, 1, i)) to sCh
                            Get _IsIdentifierChar sCh to bIdent
                            If (bIdent = True) Begin
                                Move (sName + sCh) to sName
                                Increment i
                            End
                            Else ;
                                Move False to bMore
                        Loop
                        While (i <= iInnerLen and Mid(sInner, 1, i) = " ")
                            Increment i
                        Loop
                        If (sName <> "" and i <= iInnerLen and Mid(sInner, 1, i) = "(") Begin
                            Move i to iCallOpen
                            Get _MatchParenInOver of Self sInnerOver iCallOpen to iCallClose
                            If (iCallClose > iCallOpen) Begin
                                // the call's ")" must be the last non-space char of sInner (single call only)
                                If (Trim(Right(sInner, (iInnerLen - iCallClose))) = "") Begin
                                    Move (Mid(sInner,     (iCallClose - iCallOpen - 1), (iCallOpen + 1))) to sCallArgs
                                    Move (Mid(sInnerOver, (iCallClose - iCallOpen - 1), (iCallOpen + 1))) to sCallArgsOver
                                    Get _SplitTopLevelArgs of Self sCallArgs sCallArgsOver to asArgs
                                    Move (SearchArray(sName, asLocalFns, Desktop, RefFunc(DFSTRICMP))) to iFound
                                    If (iFound > -1 and SizeOfArray(asArgs) >= 1 and Lowercase(asArgs[0]) = "self") Begin
                                        Move True to bAllSimple
                                        Move "" to sGetArgs
                                        Move (SizeOfArray(asArgs) - 1) to iN
                                        For i from 1 to iN
                                            Get _IsSimpleGetArg of Self asArgs[i] to bSimple
                                            If (bSimple = False) ;
                                                Move False to bAllSimple
                                            If (sGetArgs = "") ;
                                                Move asArgs[i] to sGetArgs
                                            Else ;
                                                Move (sGetArgs + " " + asArgs[i]) to sGetArgs
                                        Loop
                                        If (bAllSimple = True) ;
                                            Move True to bFixed
                                    End
                                End
                            End
                        End
                    End
                End
            End
        End

        If (bFixed = True) Begin
            Move 1 to iAction
            Move ("Get " + sName + (If(sGetArgs = "", "", (" " + sGetArgs))) + " to " + sDest) to sContent
            Get AssembleOutputLine of Self sContent TD to sLine
            Function_Return sLine
        End
        Move 2 to iAction
        Function_Return sLine
    End_Function

    /* DROP THE ARGUMENTS A CALL PASSES BEYOND WHAT THE METHOD DECLARES - the arithmetic half of
       E 4379 (Nils 2026-09-04, LegacyApp PlanView.VW: "Entry_Item (fheadvalue(Self, plandetail.ref,
       plandetail.porder))" against a one-parameter fHeadValue). DataFlex 19.1 and earlier passed the
       surplus along and the method never read it, so removing it changes nothing at run time; DF26
       counts it. Edits the argument list of ONE call of sName on the line, wherever the call sits -
       inside an Entry_Item, a Move, a bigger expression - and leaves everything else as it was,
       indent and trailing comment included.

       Refuses, returning the line unchanged with iDropped = 0, when: there is no such call (a longer
       identifier ending in the name is not it); the parens do not balance on this line (a
       ";"-continued call - the board counts those on the joined line, but a rewrite wants the whole
       call in hand); the first argument is not Self (the handle-receiver row's shape, measured
       against a declaration this file may not own); the count already fits; or a surplus argument
       carries a parenthesis - a nested call could have side effects, and "changes nothing" would no
       longer be true. Works on the masked twin, so a call inside a literal or a comment is
       invisible. PURE - the guided board uses it twice: once to decide whether to offer the chip at
       all (iDropped > 0 on the row's own line), once to show the real Was / Now in the dialog. */
    Function _DropSurplusArgsInLine String sLine String sName Integer iKeep Integer ByRef iDropped Returns String
        tTokenizer TD
        String sOver sLow sCode sNameLc sCallArgs sCallArgsOver sBefore sNewArgs sContent
        String[] asArgs
        Integer iPos iOpen iClose iN i
        Boolean bIdent

        Move 0 to iDropped
        Move (Lowercase(Trim(sName))) to sNameLc
        If (sNameLc = "" or iKeep < 0) ;
            Function_Return sLine
        // Per-line fast gate before the tokenizer, the same shape ChangeObjectFunctionCallToGet keeps.
        If (Pos((sNameLc + "("), Lowercase(sLine)) = 0) ;
            Function_Return sLine
        Get Tokenizer of Self sLine to TD
        If (TD.bLineIsReady = True or TD.bIsInImage = True) ;
            Function_Return sLine
        Move TD.sOverstrikeLine to sOver
        Move (Lowercase(sOver)) to sLow
        Move sLine to sCode
        If (TD.sEndComment <> "") ;
            Move (Replace(TD.sEndComment, sCode, "")) to sCode
        Move (Trim(sCode)) to sCode
        Move (Pos((sNameLc + "("), sLow)) to iPos
        If (iPos = 0) ;
            Function_Return sLine
        // Boundary on the left: "Myfheadvalue(" must not read as "fheadvalue(".
        If (iPos > 1) Begin
            Move (Mid(sOver, 1, (iPos - 1))) to sBefore
            Get _IsIdentifierChar sBefore to bIdent
            If (bIdent = True) ;
                Function_Return sLine
        End
        Move (iPos + Length(sNameLc)) to iOpen
        Get _MatchParenInOver sOver iOpen to iClose
        If (iClose <= iOpen) ;
            Function_Return sLine
        Move (Mid(sCode, (iClose - iOpen - 1), (iOpen + 1))) to sCallArgs
        Move (Mid(sOver, (iClose - iOpen - 1), (iOpen + 1))) to sCallArgsOver
        Get _SplitTopLevelArgs sCallArgs sCallArgsOver to asArgs
        Move (SizeOfArray(asArgs)) to iN
        If (iN < 1 or Lowercase(asArgs[0]) <> "self") ;
            Function_Return sLine
        If ((iN - 1) <= iKeep) ;
            Function_Return sLine
        For i from (iKeep + 1) to (iN - 1)
            If (Pos("(", asArgs[i]) > 0) ;
                Function_Return sLine
        Loop
        Move asArgs[0] to sNewArgs
        For i from 1 to iKeep
            Move (sNewArgs + ", " + asArgs[i]) to sNewArgs
        Loop
        Move (Left(sCode, iOpen) + sNewArgs + Right(sCode, (Length(sCode) - iClose + 1))) to sContent
        Move (iN - 1 - iKeep) to iDropped
        Get AssembleOutputLine sContent TD to sLine
        Function_Return sLine
    End_Function

    /* THE FUNCTIONS THAT DO NOTHING WITHOUT A PARAMETER, and why this is a hand-kept list rather
       than something derived (Nils 2026-08-06).

       THE DATA CANNOT ANSWER IT. Every published function takes `String sParameter` - it is the
       uniform signature, so taking one means nothing. `{EnumList}` marks the 17 that pick from a
       list and always carry an InitialValue, so those are never blank. `{ParamHelp}` looked like
       the signal and is not: GuardRedundantGlobalFunctions and GuardDuplicateExternalFunctions
       both document a parameter they do not need (they fall back to a catalogue), while
       ChangeCollidingMethodName and AlignCollidingDeclarationType REQUIRE one and carry no help
       tag at all. The two sets barely overlap.

       So the criterion is behavioural, and the test is in the function itself: on a blank
       sParameter, does it return 0 without doing anything? All four below do.

       A FIFTH APPEARS the day someone writes another converter whose whole job is "do this to the
       name the compiler just gave us" - the guided lane discovers the name, a manual tick has
       nothing to pass. Add it here and both callers pick it up.

       WHY IT MATTERS: the guided flow always supplies these (RunScopedFunction passes the name off
       the finding), so a MANUAL selection is the one path that reaches them empty - and a Select
       All sweeps in every one. Callers use this to say so BEFORE the run rather than leaving the
       user with a silent zero. The functions still log their own SKIPPED note if reached anyway
       (the 2026-08-03 policy); this is the earlier warning, not a replacement for it. */
    Function FunctionRequiresParameter String sFnName Returns Boolean
        String sLc
        Move (Lowercase(Trim(sFnName))) to sLc
        If (sLc = "renamecollidingglobalfunction") ;
            Function_Return True
        If (sLc = "changecollidingmethodname") ;
            Function_Return True
        If (sLc = "aligncollidingdeclarationtype") ;
            Function_Return True
        If (sLc = "changeambiguouscalltoget") ;
            Function_Return True
        // The fifth (2026-09-04): "Name|Count" off the E 4379 arity row - blank, it changes nothing.
        If (sLc = "dropsurpluscallarguments") ;
            Function_Return True
        If (sLc = "renamesamenamedmethod") ;
            Function_Return True
        Function_Return False
    End_Function

    /* WHICH CONVERTERS NEED A WINDOWS PROGRAM (Nils 2026-09-20, on taking on character-mode
       workspaces). The criterion: the function rewrites Windows USER-INTERFACE objects or
       properties - a Grid, List or Edit into a CodeJock or cTextEdit object, a DFCreate_Menu into
       command bars, Shadow_State into Enabled_State, the Workspace object into cApplication, a Use
       line for a Windows class - or removes commands that a character-mode program still lives
       by. A program written for character mode has no Windows user interface for them to work
       on: its screens are images and Page / Accept / Entry commands, which have to be rewritten
       by hand first (the character-mode inventory counts them). Run on such a program these
       either find nothing or, worse, comment out its screen handling, so the engine skips them
       and says so (_SkipForCharacterMode).

       NOT on the list, and it was for a few hours (Nils 2026-09-23): RemoveLocalKeyWord and
       ChangeChainToRunprogram. A 3.x compiler needs Local (without it a method variable is the
       program's) and has no Runprogram - true, and the USER'S call, not this gate's: which
       converters a workspace can take is what the "never pick" list is for
       (cRefactorApplication.NeverPickFunctions), and the character-mode notice on the board
       says so. This gate keeps only what would damage a character-mode program's screens.

       NOT on the list, deliberately: everything that rewrites SYNTAX (Chain, Status, If-Not,
       Insert, Gosub, indicators, legacy operators, the command-to-function set) - that is the
       half of a character-mode migration this tool does do - and the External_Function work
       (the wide guard included): its output is what the future Windows program needs, and its
       #ELSE arms are invisible to a 3.x compiler. Add a converter here the day it rewrites a
       Windows UI object; the test fixture (oCharacterModeInventory-Tests) pins the members. */
    Function FunctionNeedsWindowsProgram String sFnName Returns Boolean
        String sLc
        Move (Lowercase(Trim(sFnName))) to sLc
        // CodeJock targets
        If (sLc = "changedfcreatemenutocodejock" or sLc = "changefloatingpopupmenutocodejock") ;
            Function_Return True
        If (sLc = "refactordbgridtocdbcjgrid" or sLc = "refactordblisttocdbcjgridpromptlist") ;
            Function_Return True
        If (sLc = "refactorgridtocjgrid" or sLc = "refactorlisttocjgrid" or sLc = "changecodejockreporttogrid") ;
            Function_Return True
        // Windows class and property swaps
        If (sLc = "changedftimertoctimer" or sLc = "changelegacyclasstomodern" or sLc = "changelegacyshadow_state") ;
            Function_Return True
        If (sLc = "refactoredittoctextedit" or sLc = "refactordbedittocdbtextedit") ;
            Function_Return True
        If (sLc = "refactorworkspacetocapplication" or sLc = "changelegacyworkspaceaccessors" or sLc = "makefileautonomous") ;
            Function_Return True
        // Removals a character-mode program cannot afford
        If (sLc = "commentoutobsoletedevcommands" or sLc = "commentoutobsoletepackageuse") ;
            Function_Return True
        Function_Return False
    End_Function


    /* =============================================================================================
       DFCreate_Menu -> CodeJock command bars: the PURE core (ChangeDFCreateMenuToCodeJock's engine).

       No file I/O and no engine state, so the whole grammar is unit-testable - which is the point:
       the published wrapper adds the file walk and the insertion, and those are the parts fixtures
       cannot reach.

       THE GRAMMAR, measured over 1,394 real blocks in the DF18/DF19 trees 2026-08-11:
         DFCreate_Menu <Name>                        the root            -> cCJMenuBar
         DFCreate_Menu "&Cap" <obj> is a <class>     a pulldown          -> cCJMenuItem + popup type
         On_Item "&Cap \aCtrl+1"  Send <Message>     an item             -> catalogue class or generic
         On_Item "" Send NONE                        a separator         -> pbControlBeginGroup on NEXT
         Set Status_Help To "text"                   -> psToolTip on the item just emitted
         End_Pull_Down / End_Menu                    close
       Anything else is carried across COMMENTED, never dropped. Real blocks contain live code (Set
       select_mode, property declarations, whole If/Move sequences); silently deleting a line the
       tool did not understand is how a converter loses behaviour without anyone noticing.

       THE TARGET SHAPE is the Studio's own, Pkg\Config\DefaultCommandBarSystem.tpl. Read that before
       changing what is emitted: peControlType/xtpControlPopup on every popup and pbAddToDesignerMenu
       on the standard items both come from it and are easy to omit by eye.

       CAPTIONS: a catalogue hit gets NO psCaption - the shipped class carries its own localized one
       (see CJMenuCatalog.inc). A generic item keeps the legacy caption verbatim. Accelerators are
       emitted COMMENTED (Nils 2026-08-11): the legacy "\aCtrl+1" is display text, not a binding, and
       inventing a CodeJock shortcut from it would silently change which keys the program answers to.
       ============================================================================================= */

    // An object name built from a caption: letters and digits only, so "&Contact Type Entry/Edit"
    // becomes oContactTypeEntryEdit_MenuItem. DataFlex identifiers are ASCII-only, so anything else
    // is dropped rather than transliterated, and a digit-leading result is prefixed (a caption like
    // "&1. Batch Check" would otherwise produce an illegal identifier).
    // Measured 2026-09-13: a DECODED umlaut compares above "z" and above "Z", so the range test drops
    // it (CJMenu_NameFromNonAsciiCaption pins that). What does slip through is an UNDECODED OEM byte
    // - a file read raw hands the runtime a lone 0x94, the character-based Mid glues it onto the
    // letter before it, and the slice compares as that letter. The engine decodes every file it
    // reads (rfReadEncodedFileAsStringArray), so that shape reaches this function only from a probe.
    Function _CJMenuNameFromCaption String sCaption String sSuffix Returns String
        String sOut sChar
        Integer iCount iSize

        Move "" to sOut
        Move (Length(sCaption)) to iSize
        For iCount from 1 to iSize
            Move (Mid(sCaption, 1, iCount)) to sChar
            If ((sChar >= "a" and sChar <= "z") or (sChar >= "A" and sChar <= "Z") or (sChar >= "0" and sChar <= "9")) ;
                Move (sOut + sChar) to sOut
        Loop
        If (sOut = "") ;
            Move "Item" to sOut
        Move (Left(sOut, 1)) to sChar
        If (sChar >= "0" and sChar <= "9") ;
            Move ("M" + sOut) to sOut
        Function_Return ("o" + sOut + sSuffix)
    End_Function

    /* The first quoted literal on a line, or "" when there is none - an expression caption
       (On_Item ("&" + sName + " \aCtrl+1")) or a root DFCreate_Menu line, which carries no quotes.
       Both quote styles are handled because the legacy sources mix them: File_PM.inc writes
       Set Status_Help To 'text' with single quotes while its On_Item lines use double. */
    Function _CJQuotedText String sLine Returns String
        Integer iOpen iClose
        String sQuote sRest

        Move (Pos('"', sLine)) to iOpen
        Move '"' to sQuote
        If (iOpen = 0) Begin
            Move (Pos("'", sLine)) to iOpen
            Move "'" to sQuote
        End
        If (iOpen = 0) ;
            Function_Return ""
        Move (Mid(sLine, (Length(sLine) - iOpen), (iOpen + 1))) to sRest
        Move (Pos(sQuote, sRest)) to iClose
        If (iClose < 2) ;
            Function_Return ""
        Function_Return (Left(sRest, (iClose - 1)))
    End_Function

    // The caption without its accelerator: "&Clear/Add\aF5" -> "&Clear/Add". The \a marker is a
    // literal backslash followed by 'a' in the source, not an escape.
    Function _CJCaptionWithoutAccel String sCaption Returns String
        Integer iPos

        Move (Pos(("\" + "a"), sCaption)) to iPos
        If (iPos > 0) ;
            Function_Return (Trim(Left(sCaption, (iPos - 1))))
        Function_Return (Trim(sCaption))
    End_Function

    // ...and the accelerator itself, or "" - kept so it can be emitted as a comment rather than lost.
    Function _CJAcceleratorOf String sCaption Returns String
        Integer iPos

        Move (Pos(("\" + "a"), sCaption)) to iPos
        If (iPos > 0) ;
            Function_Return (Trim(Mid(sCaption, (Length(sCaption) - iPos + 1), iPos)))
        Function_Return ""
    End_Function

    /* The message an On_Item fires: the identifier after the LAST 'send' on the line. LAST, because
       the real form is `On_Item "&Tool-bar" send Toggle_ToolBar To Current_Object` and a caption may
       itself contain the word "send". Boundary-aware (never a bare Pos), so "Resend" cannot match.
       Returns "" for `send NONE` - the separator marker - and for a line with no send at all. */
    Function _CJMessageFromOnItem String sLine Returns String
        Integer iPos iNext iHit iLen iCount
        String sRest sMsg sChar
        Boolean bDone

        Move 0 to iPos
        Move 1 to iNext
        Move False to bDone
        While (bDone = False)
            Get _FindKeywordPos sLine "send" True iNext to iHit
            If (iHit = 0) Begin
                Move True to bDone
            End
            Else Begin
                Move iHit to iPos
                Move (iHit + 4) to iNext
            End
        Loop
        If (iPos = 0) ;
            Function_Return ""
        Move (Length(sLine) - (iPos + 3)) to iLen
        If (iLen < 1) ;
            Function_Return ""
        Move (Trim(Mid(sLine, iLen, (iPos + 4)))) to sRest
        Move "" to sMsg
        Move (Length(sRest)) to iLen
        Move False to bDone
        Move 1 to iCount
        While (iCount <= iLen and bDone = False)
            Move (Mid(sRest, 1, iCount)) to sChar
            // Every character a legacy identifier may carry - '.', '$' and '#' included: a dotted message name
            // cut at the dot became 'Send Report' for 'Send Report.ShowFiles' - which compiles and does
            // nothing (a workspace, 2026-09-07).
            If ((sChar >= "a" and sChar <= "z") or (sChar >= "A" and sChar <= "Z") or (sChar >= "0" and sChar <= "9") or (sChar = "_") or (sChar = ".") or (sChar = "$") or (sChar = "#")) Begin
                Move (sMsg + sChar) to sMsg
            End
            Else Begin
                Move True to bDone
            End
            Increment iCount
        Loop
        If (Lowercase(sMsg) = "none") ;
            Function_Return ""
        Function_Return sMsg
    End_Function

    // True when the line opens a menu: DFCreate_Menu, at command position.
    Function _CJIsMenuOpen String sLine Returns Boolean
        Function_Return ((_FindKeywordPos(Self, sLine, "DFCreate_Menu", True, 1)) > 0)
    End_Function

    // True when the line closes one: End_Pull_Down or End_Menu.
    Function _CJIsMenuClose String sLine Returns Boolean
        If ((_FindKeywordPos(Self, sLine, "End_Pull_Down", True, 1)) > 0) ;
            Function_Return True
        Function_Return ((_FindKeywordPos(Self, sLine, "End_Menu", True, 1)) > 0)
    End_Function


    /* Legacy item bookkeeping for the OnInitMenu translation (see _CJEmitPopupInit). A pulldown's
       "Set Shadow_State Item N" addresses its N-th On_Item, counting from 0 - and a separator
       ("On_Item "" Send None") TAKES AN INDEX: DataFlex's own Navi_pm.inc has four items, the
       separator, then "Set Shadow_state 5" for Prompt. A nested pulldown is an item of its parent
       too. So every child records its parent popup slot and its legacy index at the moment it is
       met; a separator only advances the parent's counter. iSlot = -1 is that "count only" case.
       The root's counter rides iRootNext (the root has no slot of its own to hang it on). */
    Procedure _CJNoteChildIndex Integer iSlot Integer[] ByRef aiStack Integer[] ByRef aiParent Integer[] ByRef aiItemIx Integer[] ByRef aiNextIx Integer ByRef iRootNext
        Integer iTop iParent iIx

        Move (SizeOfArray(aiStack)) to iTop
        Move -1 to iParent
        If (iTop > 0) ;
            Move aiStack[iTop - 1] to iParent
        If (iParent >= 0) Begin
            Move aiNextIx[iParent] to iIx
            Move (iIx + 1) to aiNextIx[iParent]
        End
        Else Begin
            Move iRootNext to iIx
            Move (iIx + 1) to iRootNext
        End
        If (iSlot >= 0) Begin
            Move iParent to aiParent[iSlot]
            Move iIx     to aiItemIx[iSlot]
        End
    End_Procedure

    /* ONE line of a legacy OnInitMenu, in CodeJock terms. The two item-addressed calls translate:
         Set Shadow_State [Item] N to X   ->  Set pbEnabled of (<Nth child>(Self)) to <not X>
         Set Select_State [Item] N to X   ->  Set pbChecked of (<Nth child>(Self)) to X
       (the Item keyword is optional in the legacy form - Navi_pm.inc writes "Set Shadow_state 5";
       without an index the call means the pulldown itself). Every other line - the user lookup,
       the If / Else / End, the Integer declarations, comments - is plain DataFlex and goes across
       verbatim. Two things are NOT guessed at: an index that is not a literal (a For loop's
       variable), and an index with no child object behind it - a separator line, or one past the
       last item (Order.mn shadows Item 10, which is its separator, and never its 12th item; that is
       the user's latent bug and it is shown, not silently fixed). Both become a TODO comment that
       keeps the original line. The trailing comment, if any, rides along. PURE. */
    Function _CJTranslateInitLine String sLine Integer iPopup Integer[] ByRef aiParent Integer[] ByRef aiItemIx String[] ByRef asObjName Returns String
        String sTrim sLead sCode sMasked sComment sLow sW1 sW2 sW3 sW4 sIx sVal sValLc sNeg sChild sOf sCh
        Integer iToPos iIx i iLast iLen
        Boolean bShadow bSelect bNumeric

        Move (Trim(sLine)) to sTrim
        If (sTrim = "" or Left(sTrim, 2) = "//") ;
            Function_Return sLine
        Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sLead
        Get _CodeOnlyLine sTrim to sMasked
        Move (Trim(Left(sTrim, Length(sMasked)))) to sCode
        Move (Trim(Right(sTrim, (Length(sTrim) - Length(sMasked))))) to sComment
        Move (Lowercase(sCode)) to sLow
        Get _NthWord sLow 1 to sW1
        Get _NthWord sLow 2 to sW2
        Get _NthWord sLow 3 to sW3
        Get _NthWord sLow 4 to sW4
        Move (sW1 = "set" and sW2 = "shadow_state") to bShadow
        Move (sW1 = "set" and sW2 = "select_state") to bSelect
        If (bShadow = False and bSelect = False) ;
            Function_Return sLine
        // the index: "Item N", a bare "N", or nothing (the pulldown itself)
        If (sW3 = "item") ;
            Move sW4 to sIx
        Else ;
            Move sW3 to sIx
        Move "" to sChild
        If (sIx <> "to") Begin
            Move (Length(sIx) > 0) to bNumeric
            Move (Length(sIx)) to iLen
            For i from 1 to iLen
                Move (Mid(sIx, 1, i)) to sCh
                If (sCh < "0" or sCh > "9") ;
                    Move False to bNumeric
            Loop
            If (bNumeric = False) ;
                Function_Return (sLead + "//  " + sTrim + "   // TODO (DFRefactor): the item index is not a literal - re-express this on the child object by hand.")
            Move sIx to iIx
            Move (SizeOfArray(aiParent) - 1) to iLast
            For i from 0 to iLast
                If (aiParent[i] = iPopup and aiItemIx[i] = iIx and asObjName[i] <> "") ;
                    Move asObjName[i] to sChild
            Loop
            If (sChild = "") ;
                Function_Return (sLead + "//  " + sTrim + "   // TODO (DFRefactor): item " + sIx + " is a separator line or lies past the last item - there is no child object to enable or disable.")
        End
        // the value: what follows the LAST "to" of the code part
        Get _LastToPos sLow to iToPos
        If (iToPos = 0) ;
            Function_Return sLine
        Move (Trim(Right(sCode, (Length(sCode) - iToPos - 1)))) to sVal
        Move (Lowercase(sVal)) to sValLc
        If (sValLc = "true") ;
            Move "False" to sNeg
        Else If (sValLc = "false") ;
            Move "True" to sNeg
        Else If (Left(sVal, 1) = "(") ;
            Move ("(not" + sVal + ")") to sNeg
        Else ;
            Move ("(not(" + sVal + "))") to sNeg
        If (sChild = "") ;
            Move "" to sOf
        Else ;
            Move (" of (" + sChild + "(Self))") to sOf
        If (bShadow = True) ;
            Move (sLead + "Set pbEnabled" + sOf + " to " + sNeg) to sCode
        Else ;
            Move (sLead + "Set pbChecked" + sOf + " to " + sVal) to sCode
        If (sComment <> "") ;
            Move (sCode + "   " + sComment) to sCode
        Function_Return sCode
    End_Function

    /* A child object name that is UNIQUE among its siblings. Two items with the same caption in one
       pulldown (LegacyApp Order.mn's Utskrifter has four such pairs) produced the same object name
       twice; DF26 compiles that without a word, and "(oX_MenuItem(Self))" then reaches only one of
       the twins - so an OnPopupInit translated from Shadow_State would drive the wrong item in
       silence. The second and later twins get _2, _3... Siblings = every earlier slot with the
       same parent; the root's children have parent -1, and the root itself never takes a name. */
    Function _CJUniqueChildName String sName Integer iSlot Integer[] ByRef aiParent String[] ByRef asObjName Returns String
        String sTry
        Integer i iN
        Boolean bTaken

        Move sName to sTry
        Move 1 to iN
        Move True to bTaken
        While (bTaken = True)
            Move False to bTaken
            For i from 0 to (iSlot - 1)
                If (aiParent[i] = aiParent[iSlot] and asObjName[i] = sTry) ;
                    Move True to bTaken
            Loop
            If (bTaken = True) Begin
                Increment iN
                Move (sName + "_" + String(iN)) to sTry
            End
        Loop
        Function_Return sTry
    End_Function

    /* The pulldown's OnInitMenu, emitted as its CodeJock twin inside the popup object - after the
       child objects, before the popup's End_Object. Legacy sends OnInitMenu from Initialize_Menu as
       the pulldown is about to open; cCJMenuItem's OnPopupInit fires at the same moment ("before
       called, self and all items IsEnabled, IsChecked and IsVisible are called" - cCJCommandBarSystem
       .pkg), and pbEnabled / pbChecked set there reach the COM control at once. The body keeps its
       own nesting: the smallest indent of its lines is taken as the base. (Nils 2026-09-04: "Using
       OnInitMenu procedures were common and we should be able to deal with them" - LegacyApp's
       Order.mn carries 93 of them, 580 Shadow_State lines decided by userinfo rights.) */
    Procedure _CJEmitPopupInit String[] ByRef asOut String sBody Integer iPopup Integer[] ByRef aiParent Integer[] ByRef aiItemIx String[] ByRef asObjName String sPad
        String[] asLines
        String sLine sOutLine
        Integer i iLast iMin iInd

        Move (StrSplitToArray(sBody, Character(1))) to asLines
        Move (SizeOfArray(asLines) - 1) to iLast
        Move 999 to iMin
        For i from 0 to iLast
            If (Trim(asLines[i]) <> "") Begin
                Move (Length(asLines[i]) - Length(LTrim(asLines[i]))) to iInd
                If (iInd < iMin) ;
                    Move iInd to iMin
            End
        Loop
        If (iMin = 999) ;
            Move 0 to iMin
        Move (sPad + "    Procedure OnPopupInit Variant vCommandBarControl Handle hoCommandBarControls") to asOut[SizeOfArray(asOut)]
        Move (sPad + "        // DFRefactor: the legacy pulldown's OnInitMenu. Shadow_State Item N -> pbEnabled of the N-th child object (negated); Select_State -> pbChecked.") to asOut[SizeOfArray(asOut)]
        For i from 0 to iLast
            Move asLines[i] to sLine
            If (Trim(sLine) = "") Begin
                Move "" to asOut[SizeOfArray(asOut)]
            End
            Else Begin
                If (Length(sLine) > iMin) ;
                    Move (Right(sLine, (Length(sLine) - iMin))) to sLine
                Get _CJTranslateInitLine sLine iPopup (&aiParent) (&aiItemIx) (&asObjName) to sOutLine
                Move (sPad + "        " + sOutLine) to asOut[SizeOfArray(asOut)]
            End
        Loop
        Move (sPad + "    End_Procedure") to asOut[SizeOfArray(asOut)]
    End_Procedure

    /* The block -> object tree emitter. TWO PASSES on purpose.

       Pass 1 turns the legacy lines into a flat model (kind / caption / message / tooltip / group)
       held in parallel arrays; pass 2 walks that model and writes the objects. The alternative -
       emitting as we parse - founders on Status_Help, which arrives AFTER the thing it describes and
       , for a pulldown, after that pulldown's End_Pull_Down. Attaching it would then mean inserting
       a line into text already written, and every stored index would have to be re-based. As a
       model index it is simple arithmetic, and the emitter stays a straight walk.

       WHAT A POPUP BECOMES. Normally cCJMenuItem + xtpControlPopup. The one exception is the Window
       pulldown, which becomes cCJMDIWindowsMenuItem - a container that fills itself with the open
       views at run time. That is detected by the MESSAGES it contains (Cascade_Windows,
       Tile_Windows_*, Minimize_all_Windows, Restore_all_Windows, Arrange_Icons), never by its
       caption: "&Window" is localized in every non-English workspace, and the whole catalogue exists
       because caption text cannot be trusted. A Window menu with none of those messages is left as
       an ordinary popup, which is the honest outcome - nothing about it said "MDI".

       UNRECOGNISED LINES ARE CARRIED COMMENTED, never dropped. Real menus contain live code (Set
       select_mode to Multi_Select, property declarations, whole If/Move sequences); a converter that
       silently deletes what it does not understand loses behaviour that nobody will notice until it
       is in production. */
    Function _CJMenuBlockToObjects String[] asBlock String sIndent String[] ByRef asOut Returns Integer
        String[] asKind asCap asMsg asTip asGrp asRaw asEmpty asInit asObjName
        Integer[] aiClose aiStack aiEmptyI aiParent aiItemIx aiNextIx
        String sLine sTrim sCap sMsg sClass sPad sName sAccel sLow sCodePart sW1 sW2
        Integer iCount iSize iSlot iTop iOwner iDepth iEmitted iPrev iInitSlot iRootNext iP
        Boolean bGroup bIsWindow bInInit

        Move False to bInInit
        Move -1 to iInitSlot
        Move 0 to iRootNext
        Move asEmpty to asKind
        Move asEmpty to asCap
        Move asEmpty to asMsg
        Move asEmpty to asTip
        Move asEmpty to asGrp
        Move asEmpty to asRaw
        Move aiEmptyI to aiClose
        Move aiEmptyI to aiStack

        // ---- PASS 1: lines -> model -----------------------------------------------------------
        Move False to bGroup
        Move (SizeOfArray(asBlock) - 1) to iSize
        For iCount from 0 to iSize
            Move asBlock[iCount] to sLine
            Move (Trim(sLine)) to sTrim
            Move (Lowercase(sTrim)) to sLow
            Move (SizeOfArray(asKind)) to iSlot
            // Every slot carries its parent / legacy index / emitted name / init body; defaults here,
            // filled in where the slot is made. (iSlot is reused by the next real row, so a line that
            // makes no slot leaves nothing behind.)
            Move -1 to aiParent[iSlot]
            Move -1 to aiItemIx[iSlot]
            Move ""  to asInit[iSlot]
            Move ""  to asObjName[iSlot]
            Get _CodeOnlyLine sLine to sCodePart
            Get _NthWord (Lowercase(Trim(sCodePart))) 1 to sW1
            Get _NthWord (Lowercase(Trim(sCodePart))) 2 to sW2
            If (bInInit = True) Begin
                // Inside a pulldown's OnInitMenu: the body goes to the popup's slot, verbatim (its
                // own comments and nesting included), until either ender closes it.
                If (sW1 = "end_procedure" or sW1 = "end_function") ;
                    Move False to bInInit
                Else ;
                    Move (asInit[iInitSlot] + (If((asInit[iInitSlot] = ""), "", Character(1))) + sLine) to asInit[iInitSlot]
            End
            Else If (sW1 = "procedure" and sW2 = "oninitmenu" and SizeOfArray(aiStack) > 0) Begin
                // A pulldown's OnInitMenu -> its OnPopupInit (_CJEmitPopupInit at the pulldown's
                // close). A ROOT-level one has no popup to hang on and falls through to OTHER.
                Move aiStack[SizeOfArray(aiStack) - 1] to iInitSlot
                Move True to bInInit
            End
            Else If (Left(sLow, 8) = "#include" and Pos("helper methods of the legacy menu", sLow) > 0) Begin
                // A methods-only fragment the expander left live (_CJIsMethodsFragment): emitted as
                // is, inside whatever object it sits in - the menu bar, normally.
                Move "INCLUDE" to asKind[iSlot]
                Move "" to asCap[iSlot]
                Move "" to asMsg[iSlot]
                Move "" to asTip[iSlot]
                Move "" to asGrp[iSlot]
                Move sTrim to asRaw[iSlot]
                Move -1 to aiClose[iSlot]
            End
            Else If (sTrim = "" or Left(sTrim, 2) = "//") Begin
                // blank and comment lines carry no model weight
            End
            Else If (_CJIsMenuOpen(Self, sTrim)) Begin
                // The CODE part only: LegacyApp's root reads 'DFCreate_Menu Main_Menu //"LegacyApp Business
                // System"' and the quotes in the COMMENT made the root a popup - no menu bar at all,
                // 4,563 lines under one item (2026-09-04).
                // _CodeOnlyLine MASKS literals too, so only its LENGTH is used: the code part of the
                // original line, quotes intact, comment gone.
                Get _CodeOnlyLine sTrim to sCodePart
                Get _CJQuotedText (Left(sTrim, Length(sCodePart))) to sCap
                Move "" to asMsg[iSlot]
                Move "" to asTip[iSlot]
                Move "" to asRaw[iSlot]
                Move sCap to asCap[iSlot]
                Move (If(bGroup, "G", "")) to asGrp[iSlot]
                Move False to bGroup
                Move -1 to aiClose[iSlot]
                If (sCap = "") Begin
                    Move "ROOT" to asKind[iSlot]
                End
                Else Begin
                    Move "POPUP" to asKind[iSlot]
                    Move (SizeOfArray(aiStack)) to iTop
                    Send _CJNoteChildIndex iSlot (&aiStack) (&aiParent) (&aiItemIx) (&aiNextIx) (&iRootNext)
                    Move 0 to aiNextIx[iSlot]
                    Move iSlot to aiStack[iTop]
                End
            End
            Else If (_CJIsMenuClose(Self, sTrim)) Begin
                Move "CLOSE" to asKind[iSlot]
                Move "" to asCap[iSlot]
                Move "" to asMsg[iSlot]
                Move "" to asTip[iSlot]
                Move "" to asGrp[iSlot]
                Move "" to asRaw[iSlot]
                Move -1 to aiClose[iSlot]
                Move (SizeOfArray(aiStack)) to iTop
                If (iTop > 0) Begin
                    Move aiStack[iTop - 1] to aiClose[iSlot]
                    Move (RemoveFromArray(aiStack, iTop - 1)) to aiStack
                End
            End
            Else If ((_FindKeywordPos(Self, sTrim, "On_Item", True, 1)) > 0) Begin
                Get _CJQuotedText sTrim to sCap
                Get _CJMessageFromOnItem sTrim to sMsg
                If (sMsg = "" and (Trim(sCap)) = "") Begin
                    // a separator: no object of its own, it decorates the NEXT item - but it
                    // TAKES a legacy item index (Navi_pm.inc), so the parent's counter advances.
                    Send _CJNoteChildIndex -1 (&aiStack) (&aiParent) (&aiItemIx) (&aiNextIx) (&iRootNext)
                    Move True to bGroup
                End
                Else Begin
                    Move "ITEM" to asKind[iSlot]
                    Send _CJNoteChildIndex iSlot (&aiStack) (&aiParent) (&aiItemIx) (&aiNextIx) (&iRootNext)
                    Move sCap to asCap[iSlot]
                    Move sMsg to asMsg[iSlot]
                    Move "" to asTip[iSlot]
                    Move "" to asRaw[iSlot]
                    Move -1 to aiClose[iSlot]
                    Move (If(bGroup, "G", "")) to asGrp[iSlot]
                    Move False to bGroup
                End
            End
            Else If ((_FindKeywordPos(Self, sTrim, "Status_Help", True, 1)) > 0) Begin
                // Attach to the thing it describes: the pulldown just closed, else the last object.
                Get _CJQuotedText sTrim to sCap
                Move -1 to iOwner
                Move (SizeOfArray(asKind) - 1) to iPrev
                While (iPrev >= 0 and iOwner = -1)
                    If (asKind[iPrev] = "CLOSE") Begin
                        If (aiClose[iPrev] >= 0) ;
                            Move aiClose[iPrev] to iOwner
                        Move -1 to iPrev
                    End
                    Else If (asKind[iPrev] = "ITEM" or asKind[iPrev] = "POPUP" or asKind[iPrev] = "ROOT") Begin
                        Move iPrev to iOwner
                    End
                    Decrement iPrev
                Loop
                If (iOwner >= 0) Begin
                    If (asTip[iOwner] = "") ;
                        Move sCap to asTip[iOwner]
                End
            End
            Else Begin
                Move "OTHER" to asKind[iSlot]
                Move "" to asCap[iSlot]
                Move "" to asMsg[iSlot]
                Move "" to asTip[iSlot]
                Move "" to asGrp[iSlot]
                Move sTrim to asRaw[iSlot]
                Move -1 to aiClose[iSlot]
            End
        Loop

        // ---- PASS 2: model -> objects ----------------------------------------------------------
        Move 0 to iEmitted
        Move 0 to iDepth
        Move (SizeOfArray(asKind) - 1) to iSize
        For iCount from 0 to iSize
            Move (sIndent + Repeat(" ", (iDepth * 4))) to sPad
            If (asKind[iCount] = "ROOT") Begin
                Move (sPad + "Object oMenuBar is a cCJMenuBar") to asOut[SizeOfArray(asOut)]
                Increment iDepth
            End
            Else If (asKind[iCount] = "POPUP") Begin
                Get _CJPopupIsMDIWindow (&asKind) (&asMsg) (&aiClose) iCount to bIsWindow
                Get _CJCaptionWithoutAccel asCap[iCount] to sCap
                Get _CJMenuNameFromCaption sCap "_Menu" to sName
                Get _CJUniqueChildName sName iCount (&aiParent) (&asObjName) to sName
                Move sName to asObjName[iCount]
                If (bIsWindow = True) Begin
                    Move (sPad + "Object " + sName + " is a cCJMDIWindowsMenuItem") to asOut[SizeOfArray(asOut)]
                End
                Else Begin
                    Move (sPad + "Object " + sName + " is a cCJMenuItem") to asOut[SizeOfArray(asOut)]
                End
                Move (sPad + "    Set peControlType to xtpControlPopup") to asOut[SizeOfArray(asOut)]
                Move (sPad + '    Set psCaption to "' + sCap + '"') to asOut[SizeOfArray(asOut)]
                If (asTip[iCount] <> "") ;
                    Move (sPad + '    Set psToolTip to "' + asTip[iCount] + '"') to asOut[SizeOfArray(asOut)]
                If (asGrp[iCount] = "G") ;
                    Move (sPad + "    Set pbControlBeginGroup to True") to asOut[SizeOfArray(asOut)]
                Increment iDepth
                Increment iEmitted
            End
            Else If (asKind[iCount] = "ITEM") Begin
                Get _CJCaptionWithoutAccel asCap[iCount] to sCap
                Get _CJAcceleratorOf asCap[iCount] to sAccel
                Get CJMenuClassForMessage asMsg[iCount] to sClass
                Get _CJMenuNameFromCaption sCap "_MenuItem" to sName
                Get _CJUniqueChildName sName iCount (&aiParent) (&asObjName) to sName
                Move sName to asObjName[iCount]
                If (sClass <> "") Begin
                    // Catalogue hit: the shipped class carries its own localized caption and action.
                    Move (sPad + "Object " + sName + " is a " + sClass) to asOut[SizeOfArray(asOut)]
                    Move (sPad + "    Set pbAddToDesignerMenu to True") to asOut[SizeOfArray(asOut)]
                End
                Else Begin
                    Move (sPad + "Object " + sName + " is a cCJMenuItem") to asOut[SizeOfArray(asOut)]
                    Move (sPad + '    Set psCaption to "' + sCap + '"') to asOut[SizeOfArray(asOut)]
                End
                If (asGrp[iCount] = "G") ;
                    Move (sPad + "    Set pbControlBeginGroup to True") to asOut[SizeOfArray(asOut)]
                If (asTip[iCount] <> "") ;
                    Move (sPad + '    Set psToolTip to "' + asTip[iCount] + '"') to asOut[SizeOfArray(asOut)]
                If (sAccel <> "") ;
                    Move (sPad + "//  " + sAccel + "   // TODO (DFRefactor): legacy accelerator - bind a CodeJock shortcut by hand.") to asOut[SizeOfArray(asOut)]
                If (sClass = "") Begin
                    Move (sPad + "    Procedure OnExecute Variant vCommandBarControl") to asOut[SizeOfArray(asOut)]
                    Move (sPad + "        Send " + asMsg[iCount]) to asOut[SizeOfArray(asOut)]
                    Move (sPad + "    End_Procedure") to asOut[SizeOfArray(asOut)]
                End
                Move (sPad + "End_Object") to asOut[SizeOfArray(asOut)]
                Increment iEmitted
            End
            Else If (asKind[iCount] = "CLOSE") Begin
                If (iDepth > 0) ;
                    Decrement iDepth
                Move (sIndent + Repeat(" ", (iDepth * 4))) to sPad
                // The pulldown's OnInitMenu, as OnPopupInit - after its children, inside it.
                Move aiClose[iCount] to iP
                If (iP >= 0 and asInit[iP] <> "") ;
                    Send _CJEmitPopupInit (&asOut) asInit[iP] iP (&aiParent) (&aiItemIx) (&asObjName) sPad
                Move (sPad + "End_Object") to asOut[SizeOfArray(asOut)]
            End
            Else If (asKind[iCount] = "INCLUDE") Begin
                Move (sPad + asRaw[iCount]) to asOut[SizeOfArray(asOut)]
            End
            Else If (asKind[iCount] = "OTHER") Begin
                Move (sPad + "//  " + asRaw[iCount] + "   // TODO (DFRefactor): not part of the menu grammar - carried across for review.") to asOut[SizeOfArray(asOut)]
            End
        Loop
        // A block whose End_Menu was missing (every *_PM.inc fragment) leaves the tree open - close it.
        While (iDepth > 0)
            Decrement iDepth
            Move (sIndent + Repeat(" ", (iDepth * 4))) to sPad
            Move (sPad + "End_Object") to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return iEmitted
    End_Function

    /* True when the popup starting at iStart is the MDI Window pulldown - decided by the messages it
       CONTAINS, never by its caption (see the emitter's note). Scans forward to the CLOSE that this
       popup owns, so a nested Display Options sub-menu cannot borrow the verdict from its parent. */
    Function _CJPopupIsMDIWindow String[] ByRef asKind String[] ByRef asMsg Integer[] ByRef aiClose Integer iStart Returns Boolean
        Integer iCount iSize
        String sLow
        Boolean bFound

        Move False to bFound
        Move (SizeOfArray(asKind) - 1) to iSize
        Move (iStart + 1) to iCount
        While (iCount <= iSize and bFound = False)
            If (asKind[iCount] = "CLOSE") Begin
                If (aiClose[iCount] = iStart) ;
                    Move iSize to iCount
            End
            If (asKind[iCount] = "ITEM") Begin
                Move (Lowercase(asMsg[iCount])) to sLow
                If (sLow = "cascade_windows" or sLow = "tile_windows_horizontal" or sLow = "tile_windows_vertical" ;
                    or sLow = "minimize_all_windows" or sLow = "restore_all_windows" or sLow = "arrange_icons") ;
                    Move True to bFound
            End
            Increment iCount
        Loop
        Function_Return bFound
    End_Function


    /* The index of the End_Object that closes the Object opened at iStart, or -1. Depth-counted, so a
       nested object cannot end the search early. Comment lines are skipped - a commented End_Object
       is retired history, not structure. */
    Function _CJMatchingEndObject String[] ByRef asCode Integer iStart Returns Integer
        Integer iCount iSize iDepth
        String sTrim sLow

        Move 0 to iDepth
        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from iStart to iSize
            Move (Trim(asCode[iCount])) to sTrim
            Move (Lowercase(sTrim)) to sLow
            If (Left(sLow, 2) <> "//") Begin
                If ((_FindKeywordPos(Self, sTrim, "Object", True, 1)) = 1) ;
                    Increment iDepth
                If ((_FindKeywordPos(Self, sTrim, "End_Object", True, 1)) = 1) Begin
                    Decrement iDepth
                    If (iDepth = 0) ;
                        Function_Return iCount
                End
            End
        Loop
        Function_Return -1
    End_Function

    /* Locate the OUTERMOST legacy menu block, iFrom onwards. Depth-counted over DFCreate_Menu vs
       End_Pull_Down/End_Menu, so nested pulldowns do not close the outer block early.

       A fragment with no closing line at all (every *_PM.inc is one - they are spliced INTO a block,
       so they never carry their own End_Menu) yields iEnd = the last line: the caller is converting
       a whole file whose entire content is menu, and truncating it at a close that never comes would
       silently drop items. Returns False when there is no menu here at all. */
    Function _CJFindMenuBlock String[] ByRef asCode Integer iFrom Integer ByRef iStart Integer ByRef iEnd Returns Boolean
        Integer iCount iSize iDepth
        String sTrim

        Move -1 to iStart
        Move -1 to iEnd
        Move 0 to iDepth
        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from iFrom to iSize
            Move (Trim(asCode[iCount])) to sTrim
            If (Left(sTrim, 2) <> "//") Begin
                If (_CJIsMenuOpen(Self, sTrim)) Begin
                    If (iStart = -1) ;
                        Move iCount to iStart
                    Increment iDepth
                End
                Else If (_CJIsMenuClose(Self, sTrim)) Begin
                    If (iStart >= 0) Begin
                        Decrement iDepth
                        If (iDepth <= 0) Begin
                            Move iCount to iEnd
                            Function_Return True
                        End
                    End
                End
            End
        Loop
        If (iStart >= 0) Begin
            Move iSize to iEnd      // an unterminated fragment: the block IS the rest of the file
            Function_Return True
        End
        Function_Return False
    End_Function

    /* Splice the menu fragments a block pulls in. A legacy Main_Menu is mostly #INCLUDE lines - the
       File/Navigate/Window/Help pulldowns live in their own files - so converting only what is
       physically present would emit a menu bar carrying one pulldown and leave the rest legacy.

       READS other files, WRITES none: the fragment's lines are inlined into this block and the
       #INCLUDE line is commented, which leaves the .src self-contained (the move MakeFileAutonomous
       already makes) and keeps every write inside the file the engine backed up. One level deep, and
       a fragment that cannot be read is left as its original line rather than silently vanishing. */
    /* Where a menu fragment lives: the program's own folder first, then the workspace's source folders (2026-11-01,
       _CJFindInWorkspace), else the TARGET install's Pkg
       (LegacyApp 2026-09-04: every legacy Main_Menu says "#include File_PM.inc / Navi_pm.inc /
       win_PM.inc / Helpa_PM.inc", and those ship in every DataFlex Pkg folder, 17.1 to 27 - never
       in AppSrc. Resolving against the base folder alone turned all four standard pulldowns into
       TODO comments in 18 programs). "" when neither has it; bFromInstall says which one won, so
       the caller can tell shipped code (whose OnInitMenu the cCJ* catalogue classes already
       replace) from the user's own. psTargetPkgFolder is blank under the test runner, which is
       the right answer there. */
    Function _CJResolveFragmentPath String sName String sBaseDir Boolean ByRef bFromInstall Returns String
        String sPath sPkg

        Move False to bFromInstall
        Get _CJFindInWorkspace sName sBaseDir to sPath
        If (sPath <> "") ;
            Function_Return sPath
        Get psTargetPkgFolder of ghoApplication to sPkg
        If (Trim(sPkg) <> "") Begin
            Move (vFolderFormat(sPkg) + sName) to sPath
            If (vFilePathExists(sPath)) Begin
                Move True to bFromInstall
                Function_Return sPath
            End
        End
        Function_Return ""
    End_Function

    /* Where a file a program pulls in by name lives, as DataFlex looks for it: the program's own folder, then the
       workspace's source folders in their order - its AppSrc and DDSrc paths, then its libraries' (WorkspaceSourceRoots);
       "" when none has it (2026-11-01). A workspace whose AppSrcPath is '.\AppSrc;.\Pkg' keeps its menu files in Pkg\,
       and the converter looked beside the program only: a 'Use <menu>.mn' line in some 140 programs found no menu,
       and the menus stayed legacy. The install's Pkg is the caller's business (_CJResolveFragmentPath). */
    Function _CJFindInWorkspace String sName String sBaseDir Returns String
        String[] asRoots
        String   sPath
        Integer  i iLast

        If (Trim(sName) = "") ;
            Function_Return ""
        Move (sBaseDir + sName) to sPath
        If (vFilePathExists(sPath)) ;
            Function_Return sPath
        Get pasCJSourceRootsOverride to asRoots
        If (SizeOfArray(asRoots) = 0) ;
            Get WorkspaceSourceRoots of ghoApplication to asRoots
        Move (SizeOfArray(asRoots) - 1) to iLast
        For i from 0 to iLast
            Move (vFolderFormat(asRoots[i]) + sName) to sPath
            If (vFilePathExists(sPath)) ;
                Function_Return sPath
        Loop
        Function_Return ""
    End_Function

    /* Hand-written code inside a menu block: the Procedure / Function declarations, by the code
       part of each line (a commented-out one does not count). sFirst comes back with the first
       one's name. What decides whether a program may be converted at all - see
       _CJConvertMenuInFile. PURE. */
    Function _CJCountProcDecls String[] ByRef asLines String ByRef sFirst Returns Integer
        String sCode sW1 sW2
        Integer i iLast iCount

        Move "" to sFirst
        Move 0 to iCount
        Move (SizeOfArray(asLines) - 1) to iLast
        For i from 0 to iLast
            Get _CodeOnlyLine asLines[i] to sCode
            Get _NthWord (Lowercase(Trim(sCode))) 1 to sW1
            Get _NthWord (Lowercase(Trim(sCode))) 2 to sW2
            // OnInitMenu is TRANSLATED (-> OnPopupInit, see _CJEmitPopupInit), so it does not count.
            If ((sW1 = "procedure" or sW1 = "function") and sW2 <> "oninitmenu") Begin
                Increment iCount
                If (sFirst = "") ;
                    Get _NthWord (Trim(sCode)) 2 to sFirst
            End
        Loop
        Function_Return iCount
    End_Function

    /* A SHIPPED fragment, reduced to its menu grammar. File_pm.inc, Navi_pm.inc and Win_pm.inc each
       carry a Procedure OnInitMenu (DEO-focus shadowing, ~40 lines) and a #warning line; inlined
       whole, the emitter's "carried across for review" rule turned them into ~115 TODO comments in
       EVERY converted program (LegacyApp 2026-09-04, 19 programs). That rule exists for the USER's
       lines - DataFlex's own fragment code is not for review, and the cCJ* catalogue items already
       carry the shadowing. Keeps exactly the lines the emitter models (DFCreate_Menu, On_Item,
       End_Pull_Down / End_Menu, Status_Help - the same tests it makes) and counts the rest in
       iOmitted, which reaches the run note. PURE. */
    Function _CJShippedFragmentGrammarOnly String[] ByRef asInc Integer ByRef iOmitted Returns String[]
        String[] asOut
        String sTrim
        Integer i iLast
        Boolean bKeep

        Move 0 to iOmitted
        Move (SizeOfArray(asInc) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asInc[i])) to sTrim
            Move False to bKeep
            If (sTrim = "" or Left(sTrim, 2) = "//") ;
                Move True to bKeep          // no model weight either way - keep for readability of the block
            Else If (_CJIsMenuOpen(Self, sTrim)) ;
                Move True to bKeep
            Else If (_CJIsMenuClose(Self, sTrim)) ;
                Move True to bKeep
            Else If ((_FindKeywordPos(Self, sTrim, "On_Item", True, 1)) > 0) ;
                Move True to bKeep
            Else If ((_FindKeywordPos(Self, sTrim, "Status_Help", True, 1)) > 0) ;
                Move True to bKeep
            If (bKeep = True) ;
                Move asInc[i] to asOut[SizeOfArray(asOut)]
            Else ;
                Increment iOmitted
        Loop
        Function_Return asOut
    End_Function

    /* A fragment with no menu grammar in it at all - LegacyApp's MyShadow.pkg: five Open lines and the
       two functions (fANum / fStopView) the pulldowns' OnInitMenu bodies call. Inlined, its
       functions would be "carried across for review" as comments and the OnPopupInit bodies would
       call into nothing. The legacy menu #included it INSIDE the Main_Menu object, which made those
       functions methods of the menu bar, reached from every pulldown by delegation; the CodeJock
       tree keeps exactly that shape by leaving the #Include line LIVE inside oMenuBar. PURE. */
    Function _CJIsMethodsFragment String[] ByRef asInc Returns Boolean
        String sTrim
        Integer i iLast

        Move (SizeOfArray(asInc) - 1) to iLast
        If (iLast < 0) ;
            Function_Return False
        For i from 0 to iLast
            Move (Trim(asInc[i])) to sTrim
            If (Left(sTrim, 2) <> "//" and sTrim <> "") Begin
                If (_CJIsMenuOpen(Self, sTrim)) ;
                    Function_Return False
                If ((_FindKeywordPos(Self, sTrim, "On_Item", True, 1)) > 0) ;
                    Function_Return False
            End
        Loop
        Function_Return True
    End_Function

    Function _CJExpandMenuIncludes String[] ByRef asBlock String sBaseDir Returns String[]
        String[] asOut asInc
        String sTrim sLow sName sPath sFirst
        Integer iCount iSize iInc iIncSize iPos iProcs iOmitted
        Boolean bFromInstall bMethods

        Move (SizeOfArray(asBlock) - 1) to iSize
        For iCount from 0 to iSize
            Move (Trim(asBlock[iCount])) to sTrim
            Move (Lowercase(sTrim)) to sLow
            Move 0 to iPos
            If (Left(sLow, 8) = "#include") ;
                Move 8 to iPos
            If (iPos = 0) Begin
                Move asBlock[iCount] to asOut[SizeOfArray(asOut)]
            End
            Else Begin
                Move (Trim(Mid(sTrim, (Length(sTrim) - iPos), (iPos + 1)))) to sName
                // strip a trailing end-of-line comment: '#INCLUDE File_PM.inc  // file pulldown'
                Move (Pos("//", sName)) to iPos
                If (iPos > 1) ;
                    Move (Trim(Left(sName, (iPos - 1)))) to sName
                Get _CJResolveFragmentPath sName sBaseDir (&bFromInstall) to sPath
                // Empty the array, not `Move "" to asInc` - a string into an array is a
                // 4381 at RUNTIME (Nils's first live Auto-fix run, 2026-08-16); the compiler
                // does not object, and no test reached this branch.
                Move (ResizeArray(asInc, 0)) to asInc
                If (sPath <> "") ;
                    Move (rfReadEncodedFileAsStringArray(sPath)) to asInc
                // A SHIPPED fragment is reduced to its grammar (see _CJShippedFragmentGrammarOnly).
                If (SizeOfArray(asInc) > 0 and bFromInstall = True) Begin
                    Get _CJShippedFragmentGrammarOnly (&asInc) (&iOmitted) to asInc
                    Set piCJShippedOmitted to (piCJShippedOmitted(Self) + iOmitted)
                End
                // A methods-only fragment of the user's own (MyShadow.pkg) is not inlined at all: it
                // becomes a live #Include inside the menu bar object - see _CJIsMethodsFragment.
                Move False to bMethods
                If (SizeOfArray(asInc) > 0 and bFromInstall = False) ;
                    Get _CJIsMethodsFragment (&asInc) to bMethods
                If (bMethods = True) Begin
                    Move ("#Include " + sName + "   // DFRefactor: helper methods of the legacy menu - now methods of the menu bar object.") to asOut[SizeOfArray(asOut)]
                    Move (ResizeArray(asInc, 0)) to asInc
                End
                // A fragment from the user's OWN folder may carry hand-written procedures - those
                // count against converting the program (a shipped one's OnInitMenu does not).
                If (SizeOfArray(asInc) > 0 and bFromInstall = False) Begin
                    Get _CJCountProcDecls (&asInc) (&sFirst) to iProcs
                    If (iProcs > 0) Begin
                        If (psCJFirstUserProc(Self) = "") ;
                            Set psCJFirstUserProc to sFirst
                        Set piCJUserProcs to (piCJUserProcs(Self) + iProcs)
                    End
                End
                If (SizeOfArray(asInc) = 0 and bMethods = False) Begin
                    // unreadable or not found - keep the original line, never drop it
                    Move asBlock[iCount] to asOut[SizeOfArray(asOut)]
                End
                Else If (bMethods = True) Begin
                    // already emitted as the live #Include above
                End
                Else Begin
                    Move ("//  " + sTrim + "   // TODO (DFRefactor): inlined below by ChangeDFCreateMenuToCodeJock.") to asOut[SizeOfArray(asOut)]
                    Move (SizeOfArray(asInc) - 1) to iIncSize
                    For iInc from 0 to iIncSize
                        Move asInc[iInc] to asOut[SizeOfArray(asOut)]
                    Loop
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* Where the menu bar goes, and what has to be built around it.

       Two shapes, because this function must work whichever order the user runs things in - the
       engine executes a run's functions ALPHABETICALLY, so ChangeDFCreateMenuToCodeJock runs BEFORE
       RefactorWorkspaceTocApplication in the same plan and cannot assume the modern shell exists:
         - a cCJCommandBarSystem is already present -> nest the menu bar inside it (iAnchor is its
           End_Object, bWrap False);
         - none -> the whole system is emitted around the menu bar, before the client area
           (iAnchor is the client-area line, bWrap True).
       Returns False when neither is found, which is the correct verdict for a file that is not a
       program shell at all - a .pkg fragment, say - and the caller then leaves it untouched. */
    Function _CJFindMenuAnchor String[] ByRef asCode Integer ByRef iAnchor Boolean ByRef bWrap String ByRef sIndent Returns Boolean
        Integer iCount iSize iEnd iPos iSkip
        String sTrim sLow sLine sClass

        Move -1 to iAnchor
        Move False to bWrap
        Move "" to sIndent
        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from 0 to iSize
            Move asCode[iCount] to sLine
            Move (Trim(sLine)) to sTrim
            Move (Lowercase(sTrim)) to sLow
            If (Left(sLow, 2) <> "//") Begin
                If ((Pos("is a ccjcommandbarsystem", sLow)) > 0) Begin
                    Get _CJMatchingEndObject (&asCode) iCount to iEnd
                    If (iEnd > 0) Begin
                        Move iEnd to iAnchor
                        Move False to bWrap
                        Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                        Move (sIndent + "    ") to sIndent
                        Function_Return True
                    End
                End
            End
        Loop
        // No command bar system: fall back to the client area, and bring the system with us.
        // THE CLASS MAY BE A SUBCLASS (Nils 2026-09-04, LegacyApp: "Object Client_Area is a
        // cAmAppClientArea", 7 programs; the two .src with a live menu block converted NOTHING
        // because this matched the two shipped names only). The token after "is a" ending in
        // "clientarea" is the test - the same ends-with rule the dbGrid converter keys on.
        For iCount from 0 to iSize
            Move asCode[iCount] to sLine
            Move (Trim(sLine)) to sTrim
            Move (Lowercase(sTrim)) to sLow
            If (Left(sLow, 7) = "object ") Begin
                Move (Pos(" is a ", sLow)) to iPos
                Move 6 to iSkip
                If (iPos = 0) Begin
                    Move (Pos(" is an ", sLow)) to iPos
                    Move 7 to iSkip
                End
                Move "" to sClass
                If (iPos > 0) ;
                    Get _NthWord (Right(sLow, (Length(sLow) - iPos - iSkip + 1))) 1 to sClass
                If (sClass <> "" and Right(sClass, 10) = "clientarea") Begin
                    Move iCount to iAnchor
                    Move True to bWrap
                    Move (Left(sLine, (Length(sLine) - Length(LTrim(sLine))))) to sIndent
                    Function_Return True
                End
            End
        Loop
        Function_Return False
    End_Function


    /* The menu block a program pulls in from a .mn / .mnu file (LegacyApp's shape: the .src carries
       "Use LegacyApp_5.mn //  Menu package." and nothing else of the menu). Finds the first code-level
       Use / #Include of such a file, reads it from sBaseDir, and when it holds a DFCreate_Menu
       block hands that block back with the Use line's index and the file's leaf name. False when
       no such line, the file is missing, or it holds no block. READS only. PURE apart from the read. */
    Function _CJMenuFromUsedFragment String[] ByRef asCode String sBaseDir Integer ByRef iUseLine String[] ByRef asBlock String ByRef sLeaf Returns Boolean
        String[] asFrag asEmpty
        String sTrim sLow sName sExt sPath
        Integer iCount iSize iPos iStart iEnd
        Boolean bFound

        Move -1 to iUseLine
        Move "" to sLeaf
        Move asEmpty to asBlock
        Move (SizeOfArray(asCode) - 1) to iSize
        For iCount from 0 to iSize
            Move (Trim(asCode[iCount])) to sTrim
            Move (Lowercase(sTrim)) to sLow
            Move 0 to iPos
            If (Left(sLow, 4) = "use ") ;
                Move 4 to iPos
            If (Left(sLow, 9) = "#include ") ;
                Move 9 to iPos
            If (iPos > 0) Begin
                Move (Trim(Mid(sTrim, (Length(sTrim) - iPos), (iPos + 1)))) to sName
                Move (Pos("//", sName)) to iPos
                If (iPos > 1) ;
                    Move (Trim(Left(sName, (iPos - 1)))) to sName
                Get _NthWord sName 1 to sName
                Move (Lowercase(Right(sName, 4))) to sExt
                If (Lowercase(Right(sName, 3)) = ".mn" or sExt = ".mnu") Begin
                    // Beside the program, or in the workspace's source folders (2026-11-01).
                    Get _CJFindInWorkspace sName sBaseDir to sPath
                    Move (ResizeArray(asFrag, 0)) to asFrag
                    If (vFilePathExists(sPath)) ;
                        Move (rfReadEncodedFileAsStringArray(sPath)) to asFrag
                    If (SizeOfArray(asFrag) > 0) Begin
                        Get _CJFindMenuBlock (&asFrag) 0 (&iStart) (&iEnd) to bFound
                        If (bFound = True) Begin
                            For iPos from iStart to iEnd
                                Move asFrag[iPos] to asBlock[SizeOfArray(asBlock)]
                            Loop
                            Move iCount to iUseLine
                            Move sName to sLeaf
                            Function_Return True
                        End
                    End
                End
            End
        Loop
        Function_Return False
    End_Function

    /* The programs that pull a menu FILE in - for a .mn / .mnu the plan handed to the converter.
       The scan flags the fragment (it is where the DFCreate_Menu lines are), but the fragment has
       no anchor to place a CodeJock menu in and is never written; the .src that says "Use
       <leaf>" or "#Include <leaf>" is. Every .src in the fragment's own folder is read once
       (LegacyApp: ~130) and those with a code-level Use / #Include of that leaf come back as full
       paths. Empty when nothing pulls it in - the caller says so in the run notes. */
    Function _CJIncludersOfFragment String sFragment Returns String[]
        String[] asOut asMap
        String sLeaf

        Move (Lowercase(Trim(ExtractFileName(sFragment)))) to sLeaf
        If (sLeaf = "") ;
            Function_Return asOut
        Get _CJMenuUseMapForFolder (ExtractFilePath(sFragment)) to asMap
        Get _CJProgramsPullingIn sLeaf (&asMap) 0 to asOut
        Function_Return asOut
    End_Function

    /* The PROGRAMS a fragment reaches, through the map: a .src that pulls the leaf in directly, or
       one that pulls in a .mn / .mnu / .inc which in turn pulls it in (LegacyApp: HELP_APP.inc is
       #included by the .mn files, which the programs Use - one hop; capped at four). The map
       carries every code-level Use / #Include of a menu-ish file, from programs AND fragments, so
       a fragment whose only includer is itself dead resolves to nothing - which is the point. */
    Function _CJProgramsPullingIn String sLeaf String[] ByRef asMap Integer iDepth Returns String[]
        String[] asOut asUp
        String sKey sPath sExt
        Integer i j iLast iLen

        If (iDepth > 4) ;
            Function_Return asOut
        Move (Lowercase(Trim(sLeaf)) + "|") to sKey
        Move (Length(sKey)) to iLen
        Move (SizeOfArray(asMap) - 1) to iLast
        For i from 0 to iLast
            If (Left(asMap[i], iLen) = sKey) Begin
                Move (Right(asMap[i], (Length(asMap[i]) - iLen))) to sPath
                Move (Lowercase(Right(sPath, 4))) to sExt
                If (sExt = ".src") Begin
                    If (SearchArray(sPath, asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                        Move sPath to asOut[SizeOfArray(asOut)]
                End
                Else Begin
                    Get _CJProgramsPullingIn (ExtractFileName(sPath)) (&asMap) (iDepth + 1) to asUp
                    For j from 0 to (SizeOfArray(asUp) - 1)
                        If (SearchArray(asUp[j], asOut, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                            Move asUp[j] to asOut[SizeOfArray(asOut)]
                    Loop
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* Whether the map names sLeaf at all - some program or menu file in the folder pulls it in, live
       or not. What tells a fragment whose chain is DEAD (named, with no program at the top: the Deep
       Scan drops its menu hits) from one the map never saw - a .pkg a program merely Uses, which the
       map does not follow, so "never named" is not "dead" there (cDeepScanner._DropDeadMenuFileHits).
       PURE. */
    Function _CJMapNamesLeaf String sLeaf String[] ByRef asMap Returns Boolean
        String sKey
        Integer i iLast iLen

        Move (Lowercase(Trim(sLeaf)) + "|") to sKey
        Move (Length(sKey)) to iLen
        Move (SizeOfArray(asMap) - 1) to iLast
        For i from 0 to iLast
            If (Left(asMap[i], iLen) = sKey) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    /* Every menu-ish file the programs AND fragments of one folder pull in: one
       "<lowercased leaf>|<includer path>" row per code-level "Use x.mn" / "#Include x.inc" whose
       target ends in .mn / .mnu / .inc, read from every .src, .mn and .mnu of sFolder (a commented
       Use is not a use - it is what the converter leaves behind). Fragments are read too because
       a menu file pulls its pulldowns in with #include (LegacyApp's HELP_APP.inc), and whether THAT is
       live depends on whether its .mn is - _CJProgramsPullingIn walks the chain. One read of the
       folder answers the question for every fragment in it, which is why the Deep Scan memoises
       this per folder (cDeepScanner._DropDeadMenuFileHits) rather than asking per file.
       AN #INCLUDE OF ANY FILE IS A ROW (2026-09-11). The converter inlines whatever a menu block
       #includes (_CJExpandMenuIncludes resolves the name as written), so a pulldown kept in a .pkg
       is reached exactly as an .inc one is - but the map knew .mn / .mnu / .inc only, and such a
       .pkg read as pulled in by nobody. A Use still counts for a menu FILE only: the converter never
       follows a Use of a package, so a row for one would promise a run that changes nothing. */
    Function _CJMenuUseMapForFolder String sFolder Returns String[]
        String[] asOut
        String sDir

        Move (vFolderFormat(sFolder)) to sDir
        Send _CJAddMenuUseRows sDir "*.src" (&asOut)
        Send _CJAddMenuUseRows sDir "*.mn"  (&asOut)
        Send _CJAddMenuUseRows sDir "*.mnu" (&asOut)
        Function_Return asOut
    End_Function

    /* The same rows for every folder that holds one of asFiles, sAlsoFolder ("" = none) and the workspace's source
       folders (WholeWorkspaceSourceFolders) - each folder read once (2026-11-01). A menu file is pulled in by programs
       that need not sit beside it: one workspace keeps its menu files in Pkg\ and its programs in AppSrc\, and the map
       of the menu file's folder alone held no program - the converter skipped every one of them as pulled in by
       nobody, the Deep Scan dropped their menu hits as dead, and every program kept failing on them. The workspace's
       folders are in because a plan run hands the converter the flagged menu files only, not the programs. */
    Function _CJMenuUseMapForFiles String[] asFiles String sAlsoFolder Returns String[]
        String[] asOut asRows asFolders asLow asWs
        String sFolder
        Integer i iLast j

        If (Trim(sAlsoFolder) <> "") ;
            Move (vFolderFormat(sAlsoFolder)) to asFolders[0]
        Move (SizeOfArray(asFiles) - 1) to iLast
        For i from 0 to iLast
            If (Trim(asFiles[i]) <> "") ;
                Move (vFolderFormat(ExtractFilePath(Trim(asFiles[i])))) to asFolders[SizeOfArray(asFolders)]
        Loop
        Get WholeWorkspaceSourceFolders of ghoApplication to asWs
        For i from 0 to (SizeOfArray(asWs) - 1)
            Move (vFolderFormat(asWs[i])) to asFolders[SizeOfArray(asFolders)]
        Loop
        Move (SizeOfArray(asFolders) - 1) to iLast
        For i from 0 to iLast
            Move asFolders[i] to sFolder
            If (SearchArray(Lowercase(sFolder), asLow) = -1) Begin
                Move (Lowercase(sFolder)) to asLow[SizeOfArray(asLow)]
                Get _CJMenuUseMapForFolder sFolder to asRows
                For j from 0 to (SizeOfArray(asRows) - 1)
                    Move asRows[j] to asOut[SizeOfArray(asOut)]
                Loop
            End
        Loop
        Function_Return asOut
    End_Function

    // One file mask's worth of rows for _CJMenuUseMapForFolder.
    Procedure _CJAddMenuUseRows String sDir String sMask String[] ByRef asOut
        tRFSearchResult[] aFiles
        String[] asCode
        String sFile sTrim sLow sName sExt
        Integer i iLast j jLast iPos
        Boolean bInclude

        Move (rfFileSearch((sDir + sMask), DIRMODE_FILES_ONLY, False)) to aFiles
        Move (SizeOfArray(aFiles) - 1) to iLast
        For i from 0 to iLast
            Move (sDir + aFiles[i].sFilename) to sFile
            Move (rfReadEncodedFileAsStringArray(sFile)) to asCode
            Move (SizeOfArray(asCode) - 1) to jLast
            For j from 0 to jLast
                Move (Trim(asCode[j])) to sTrim
                Move (Lowercase(sTrim)) to sLow
                Move 0 to iPos
                If (Left(sLow, 4) = "use ") ;
                    Move 4 to iPos
                If (Left(sLow, 9) = "#include ") ;
                    Move 9 to iPos
                Move (iPos = 9) to bInclude
                If (iPos > 0) Begin
                    Move (Trim(Mid(sTrim, (Length(sTrim) - iPos), (iPos + 1)))) to sName
                    Move (Pos("//", sName)) to iPos
                    If (iPos > 1) ;
                        Move (Trim(Left(sName, (iPos - 1)))) to sName
                    Get _NthWord sName 1 to sName
                    Move (Lowercase(sName)) to sName
                    Move (Right(sName, 4)) to sExt
                    // Any #Include; a Use only of a menu file - see _CJMenuUseMapForFolder.
                    If (Right(sName, 3) = ".mn" or sExt = ".mnu" or sExt = ".inc" or bInclude = True) ;
                        Move (sName + "|" + sFile) to asOut[SizeOfArray(asOut)]
                End
            Loop
        Loop
    End_Procedure

    /* One PROGRAM file, read, converted and written back when anything changed - the file walk's
       unit of work, shared by the .src entries and the fragment entries (which resolve to their
       program). Returns the menu items emitted; 0 leaves the file untouched on disk - unless the
       menu was EMPTY and retired (pbCJEmptyMenu), which is a change with no items in it. */
    Function _CJConvertProgramFile String sFile Boolean bBackupFirst Returns Integer
        String[] asCode
        String sBaseDir
        Integer iChanged
        Boolean bIsUtf8 bOK bVoid bKept

        Set pbCJLegacyMenuKept to False
        Move (rfFileHasBOM(sFile)) to bIsUtf8
        Move (rfReadEncodedFileAsStringArray(sFile)) to asCode
        // The folder the fragments are resolved against - the .src's own.
        Move (vFolderFormat(ExtractFilePath(sFile))) to sBaseDir
        Get _CJConvertMenuInFile (&asCode) sBaseDir to iChanged
        /* A LEGACY MENU LEFT AS IT IS STILL HAS TO COMPILE (2026-11-01). The converter leaves a menu that carries
           hand-written code, or that it cannot place - and DataFlex 26 compiles DFCreate_Menu only with Dfmenu.pkg,
           and the menus' ViewPopupMenu / DEOPopupMenu only with Dfdeomnu.pkg, which Uses Dfmenu.pkg itself. DataFlex 26
           still ships both, obsolete; no DfAllEnt brings them. So such a program gets 'Use Dfdeomnu.pkg': it compiles
           and behaves as it did, with the obsolete-package warning, until the menu is ported (the run note says what
           to port). One workspace's 150 programs share a File pulldown with procedures of its own. */
        If (iChanged = 0 and pbCJEmptyMenu(Self) = False and (piCJUserProcs(Self) > 0 or psCJDecline(Self) <> "")) Begin
            Move (rfReadEncodedFileAsStringArray(sFile)) to asCode
            Get _CJKeepLegacyMenuCompiling (&asCode) to bKept
            If (bKept = True) Begin
                If (bBackupFirst = True) ;
                    Get SaveBackupFile of ghoApplication sFile to bVoid
                Get _GuardedWriteEncodedFile sFile (&asCode) bIsUtf8 to bOK
                If (bOK = False) ;
                    Error DFErr_Program ("Write failed:" * sFile * "(ChangeDFCreateMenuToCodeJock)")
                Set pbCJLegacyMenuKept to True
            End
        End
        If (iChanged > 0 or pbCJEmptyMenu(Self) = True) Begin
            /* A PROGRAM REACHED THROUGH ITS .mn WAS NEVER IN THE ENGINE'S LIST, so the engine did not
               back it up for this run - the first .mn run wrote 18 programs with no fresh copy behind
               them (2026-09-04). The engine's own routine, so the cycle rules are the same ones. */
            If (bBackupFirst = True) ;
                Get SaveBackupFile of ghoApplication sFile to bVoid
            // Through the write-time macro guard: macro code is never refactored (see _GuardedWriteEncodedFile).
            Get _GuardedWriteEncodedFile sFile (&asCode) bIsUtf8 to bOK
            If (bOK = False) ;
                Error DFErr_Program ("Write failed:" * sFile * "(ChangeDFCreateMenuToCodeJock)")
        End
        Function_Return iChanged
    End_Function

    // A program whose legacy menu stays: 'Use Dfdeomnu.pkg' - the legacy menu classes, and Dfmenu.pkg with its commands -
    // added unless a Use already brings it (Dfdeomnu.pkg itself or OldDfAllEnt.pkg). True when a line was added.
    Function _CJKeepLegacyMenuCompiling String[] ByRef asCode Returns Boolean
        String[] asNeed
        String sLow sName
        Integer i iLast iN

        Move (SizeOfArray(asCode) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(asCode[i]))) to sLow
            If (Left(sLow, 4) = "use ") Begin
                Get _NthWord sLow 2 to sName
                If (sName = "dfdeomnu.pkg" or sName = "dfdeomnu" or sName = "olddfallent.pkg" or sName = "olddfallent") ;
                    Function_Return False
            End
        Loop
        Move "Dfdeomnu.pkg" to asNeed[0]
        Get _CJEnsureUses (&asCode) (&asNeed) "the legacy menu stays until it is ported: DataFlex 26 compiles it with this obsolete package (and Dfmenu.pkg, which it Uses)" to iN
        Function_Return (iN > 0)
    End_Function

    /* THE PACKAGES THE EMITTED TREE NEEDS (2026-09-07). DfAllEnt brings cCJCommandBarSystem.pkg, so the
       command bar system, the menu bar and cCJMenuItem compile on their own - but the standard items the
       tree uses for Exit, the status bar and cascade/tile/minimize/restore/arrange live in
       cCJStandardMenuItemClasses.pkg, and the Windows pulldown's container in cCJMDIWindowsMenuItem.pkg,
       neither of which a legacy program Uses: twenty 'MUST BE DEFINED' errors in one program's compile.
       Each missing Use goes after the program's last top-level Use line before its first top-level
       Object - never inside an object; before that Object when there is no Use line; at the top when there
       is neither. A Use already present anywhere is left alone. Returns how many lines were added.
       THE ABOUT ITEM HAS A PACKAGE OF ITS OWN (2026-10-31): cCJAboutMenuItem.pkg, not the standard items'.
       It was counted among those, so every converted Help menu with an About item failed to compile -
       'U_CCJABOUTMENUITEM, MUST BE DEFINED' - although _CJPopupItemClassPackage knew the right package. */
    Function _CJEnsureMenuPackages String[] ByRef asCode Returns Integer
        String[] asNeed
        String sLow
        Integer i iLast iN
        Boolean bStandard bMdi bAbout

        Move (SizeOfArray(asCode) - 1) to iLast
        Move False to bStandard
        Move False to bMdi
        Move False to bAbout
        For i from 0 to iLast
            Move (Lowercase(Trim(asCode[i]))) to sLow
            If (Left(sLow, 7) = "object " and (sLow contains " is a ccj")) Begin
                If (sLow contains " is a ccjmdiwindowsmenuitem") ;
                    Move True to bMdi
                Else If (sLow contains " is a ccjaboutmenuitem") ;
                    Move True to bAbout
                Else If (sLow contains "ccjtilehorizontally" or sLow contains "ccjtilevertically") ;
                    Move True to bStandard
                Else If ((sLow contains "menuitem") and not(sLow contains " is a ccjmenuitem")) ;
                    Move True to bStandard
            End
        Loop
        If (bStandard = True) ;
            Move "cCJStandardMenuItemClasses.pkg" to asNeed[SizeOfArray(asNeed)]
        If (bMdi = True) ;
            Move "cCJMDIWindowsMenuItem.pkg" to asNeed[SizeOfArray(asNeed)]
        If (bAbout = True) ;
            Move "cCJAboutMenuItem.pkg" to asNeed[SizeOfArray(asNeed)]
        Get _CJEnsureUses (&asCode) (&asNeed) "ChangeDFCreateMenuToCodeJock: classes of the converted menu" to iN
        Function_Return iN
    End_Function

    /* Each package in asNeed the file does not Use yet, added with the program's other Use lines:
       after the last top-level Use before the first top-level Object - never inside an object;
       before that Object when there is no Use line; at the top when there is neither. A Use already
       present anywhere is left alone. sWhy is the trailing comment on every line added. Returns how
       many lines were added. The placement half of _CJEnsureMenuPackages, split out on 2026-09-13
       so the popup converter places its Use lines by the same rule. */
    Function _CJEnsureUses String[] ByRef asCode String[] ByRef asNeed String sWhy Returns Integer
        String[] asIns asNew
        String sLow sName
        Integer i iLast iAt iN iNeed iDepth
        Boolean bHave bObjectSeen bUseInBlock

        Move (SizeOfArray(asCode) - 1) to iLast
        Move (SizeOfArray(asNeed) - 1) to iNeed
        For iN from 0 to iNeed
            Move (Lowercase(asNeed[iN])) to sName
            Move False to bHave
            For i from 0 to iLast
                Move (Lowercase(Trim(asCode[i]))) to sLow
                If (Left(sLow, 4) = "use " and (sLow contains sName)) ;
                    Move True to bHave
            Loop
            If (bHave = False) ;
                Move ("Use " + asNeed[iN] + "   // " + sWhy) to asIns[SizeOfArray(asIns)]
        Loop
        If (SizeOfArray(asIns) = 0) ;
            Function_Return 0

        // Where: the last Use before the first top-level Object that compiles in every case (rfUseAnchorStep). The
        // Object is looked for on the raw lines - column 0 only.
        Move -1 to iAt
        Move 0 to iDepth
        Move False to bUseInBlock
        Move False to bObjectSeen
        Move 0 to i
        While (i <= iLast and bObjectSeen = False)
            Move (Lowercase(asCode[i])) to sLow
            If (Left(sLow, 7) = "object ") Begin
                Move True to bObjectSeen
                If (iAt = -1) ;
                    Move (i - 1) to iAt
            End
            Else ;
                Send rfUseAnchorStep asCode[i] i (&iDepth) (&bUseInBlock) (&iAt)
            Increment i
        Loop
        Move (ResizeArray(asNew, 0)) to asNew
        If (iAt < 0) Begin
            For iN from 0 to (SizeOfArray(asIns) - 1)
                Move asIns[iN] to asNew[SizeOfArray(asNew)]
            Loop
        End
        For i from 0 to iLast
            Move asCode[i] to asNew[SizeOfArray(asNew)]
            If (i = iAt) Begin
                For iN from 0 to (SizeOfArray(asIns) - 1)
                    Move asIns[iN] to asNew[SizeOfArray(asNew)]
                Loop
            End
        Loop
        Move asNew to asCode
        Function_Return (SizeOfArray(asIns))
    End_Function

    /* A legacy menu with nothing in it: every code line of the block is the root's DFCreate_Menu (no
       caption) or a close - no On_Item, no pulldown, no #include, no other code at all. Strict on
       purpose: _CJConvertMenuInFile retires an empty block with no menu bar in its place, which is
       right only when there was nothing to carry. A block whose #include could not be read also
       emits nothing, and must never read as empty. False for no block at all. PURE. */
    Function _CJMenuBlockIsEmpty String[] ByRef asBlock Returns Boolean
        String sTrim sCode sCap
        Integer i iLast iOpen

        Move 0 to iOpen
        Move (SizeOfArray(asBlock) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asBlock[i])) to sTrim
            Get _CodeOnlyLine sTrim to sCode
            If (Trim(sCode) <> "") Begin
                If (_CJIsMenuOpen(Self, sTrim)) Begin
                    // the root only: a captioned DFCreate_Menu is a pulldown, and that is content
                    Get _CJQuotedText (Left(sTrim, Length(sCode))) to sCap
                    If (sCap <> "") ;
                        Function_Return False
                    Increment iOpen
                End
                Else If ((_CJIsMenuClose(Self, sTrim)) = False) ;
                    Function_Return False
            End
        Loop
        Function_Return (iOpen > 0)
    End_Function

    /* _CJConvertMenuLines with the text masked (2026-10-30, MaskForTransform): a commented-out menu is no menu,
       and its text is never refactored - the converter converted a commented-out copy and left the real menu as
       it was, its CodeJock menu written inside the comment (measured). A masked line the conversion removed is
       put back where it was, and the run notes say so. */
    Function _CJConvertMenuInFile String[] ByRef asCode String sBaseDir Returns Integer
        tWholeFileMask Mask
        Integer iEmitted iMacro iLost

        Get MaskForTransform (&asCode) (&Mask) to iMacro
        Get _CJConvertMenuLines (&asCode) sBaseDir to iEmitted
        Get UnmaskAfterTransform (&asCode) (&Mask) to iLost
        If (iLost > 0) ;
            Send AddRunNote (psExecutionContext(Self)) (String(iLost) * "line(s) of comment, image or string text or macro code the conversion had removed were put back where they were - check the file.")
        Function_Return iEmitted
    End_Function

    /* One file: legacy menu block -> CodeJock menu, in place. Returns the number of menu ITEMS
       emitted (0 = nothing to do, and the caller leaves the file entirely alone - EXCEPT an empty
       menu, retired in place with pbCJEmptyMenu set: see "AN EMPTY MENU" below). A 0 with a reason
       worth a run note leaves it in psCJDecline.

       THE TWO INSERTS ARE DONE HIGHEST-INDEX-FIRST. Commenting lines in place moves nothing, but
       inserting does - so the marker above the legacy block and the tree at the anchor would each
       invalidate the other's index if done in the wrong order. Doing the larger index first leaves
       the smaller one still valid, whichever way round the two sit in the file (the anchor is
       normally the client-area line ABOVE the block, but a command bar system already present is
       an End_Object that can be either side of it).

       THE LEGACY BLOCK IS COMMENTED, NEVER DELETED (Nils 2026-08-11). It carries the #INCLUDE lines
       naming where each pulldown came from, and a converted menu is exactly what a maintainer wants
       to diff against its original. CommentOutObsoletePackageUse sets the same precedent. */
    Function _CJConvertMenuLines String[] ByRef asCode String sBaseDir Returns Integer
        String[] asBlock asTree asWrapped asMark asEmpty
        String sIndent sInner sLeaf sFirst
        Integer iStart iEnd iAnchor iCount iEmitted iSize iProcs
        Boolean bFound bWrap bFromUse bEmptyMenu

        Move 0 to iEmitted
        Move False to bFromUse
        Set piCJUserProcs to 0
        Set psCJFirstUserProc to ""
        Set piCJShippedOmitted to 0
        Set pbCJEmptyMenu to False
        Set psCJDecline to ""
        Move asEmpty to asBlock
        Get _CJFindMenuBlock (&asCode) 0 (&iStart) (&iEnd) to bFound
        If (bFound = True) Begin
            For iCount from iStart to iEnd
                Move asCode[iCount] to asBlock[SizeOfArray(asBlock)]
            Loop
        End
        Else Begin
            /* THE BLOCK MAY NOT BE IN THIS FILE AT ALL (Nils 2026-09-04, LegacyApp: 16 programs keep
               the whole DFCreate_Menu ... End_Menu in a .mn file and pull it in with "Use
               LegacyApp_5.mn", so the .src has no block and this returned 0 for every one of them).
               The block is read out of the fragment and converted HERE, where the anchor is; the
               Use line is what gets commented, and the .mn file is never written. */
            Get _CJMenuFromUsedFragment (&asCode) sBaseDir (&iStart) (&asBlock) (&sLeaf) to bFound
            Move iStart to iEnd
            Move True to bFromUse
        End
        If (bFound = False) ;
            Function_Return 0
        Get _CJFindMenuAnchor (&asCode) (&iAnchor) (&bWrap) (&sIndent) to bFound
        If (bFound = False) Begin
            Set psCJDecline to "it has a legacy menu, but no client area and no command bar system to place a CodeJock menu in"
            Function_Return 0
        End

        /* HAND-WRITTEN CODE IN THE MENU IS A REFUSAL, NOT A COMMENT (Nils 2026-09-04, LegacyApp
           Order.mn: 93 "Procedure OnInitMenu" blocks - 580 "Set shadow_state Item N" decided by
           userinfo.no_* - i.e. the program's user-rights model, which the "carried across for
           review" rule turned into comments. The result compiled, ran, and showed every menu item
           to every user.) A Property mid-menu is still carried commented; a Procedure or Function
           the user wrote is a different thing: dropping it changes behaviour in silence, so the
           program is left as it is and the run notes say what to port first (OnPopupInit /
           pbEnabled). Counted on the program's own block lines and on fragments from its own
           folder; the shipped *_PM.inc fragments carry an OnInitMenu of their own, and the cCJ*
           catalogue classes already do that work, so those do not count. */
        Get _CJCountProcDecls (&asBlock) (&sFirst) to iProcs
        If (iProcs > 0) Begin
            Set psCJFirstUserProc to sFirst
            Set piCJUserProcs to iProcs
        End
        // The block's lines, with its menu fragments spliced in (adds the user-fragment procedures).
        Get _CJExpandMenuIncludes (&asBlock) sBaseDir to asBlock
        If (piCJUserProcs(Self) > 0) ;
            Function_Return 0

        /* AN EMPTY MENU IS RETIRED, NOT LEFT (Nils 2026-09-11). A program used a menu file whose
           Main_Menu held nothing at all - the root, its End_Menu, a blank line between. The emitter
           had nothing to emit, so this returned 0 and changed nothing: the legacy block stayed live,
           the scan flagged it at the next Check, and every plan run was "0 file(s) Refactored" with
           no reason given. An empty legacy menu has an exact CodeJock translation - no menu bar - so
           the block (or the Use of the menu file) is commented where it stands, with one marker, and
           nothing is added: no tree, no command bar system, no packages. What counts as empty is
           strict (_CJMenuBlockIsEmpty): a block whose #include could not be read also emits nothing,
           and that one is left alone below, never retired. */
        Get _CJMenuBlockIsEmpty (&asBlock) to bEmptyMenu
        If (bEmptyMenu = True) Begin
            For iCount from iStart to iEnd
                If ((Trim(asCode[iCount])) <> "") ;
                    Move ("//  " + asCode[iCount]) to asCode[iCount]
            Loop
            Move asEmpty to asMark
            If (bFromUse = True) ;
                Move ("//  TODO (DFRefactor): ChangeDFCreateMenuToCodeJock - the legacy menu in " + sLeaf + " is EMPTY, so no CodeJock menu bar takes its place; " + sLeaf + " is no longer used here and was not changed.") to asMark[0]
            Else ;
                Move "//  TODO (DFRefactor): ChangeDFCreateMenuToCodeJock - this legacy menu is EMPTY, so no CodeJock menu bar takes its place." to asMark[0]
            Send _InsertLinesBefore (&asCode) iStart asMark
            Set pbCJEmptyMenu to True
            Function_Return 0
        End

        // Emit. Where no command bar system exists yet we bring one, so the result compiles either way.
        Move asEmpty to asTree
        If (bWrap = True) Begin
            Move (sIndent + "    ") to sInner
        End
        Else Begin
            Move sIndent to sInner
        End
        Get _CJMenuBlockToObjects (&asBlock) sInner (&asTree) to iEmitted
        If (iEmitted = 0) Begin
            Set psCJDecline to "its legacy menu holds nothing the converter can emit - no On_Item and no pulldown it could read (is a fragment it #includes missing?)"
            Function_Return 0
        End

        Move asEmpty to asWrapped
        If (bWrap = True) Begin
            Move (sIndent + "Object oCommandBarSystem is a cCJCommandBarSystem") to asWrapped[SizeOfArray(asWrapped)]
            Move (sIndent + "    Set pbTimerUpdate to True") to asWrapped[SizeOfArray(asWrapped)]
        End
        Move (SizeOfArray(asTree) - 1) to iSize
        For iCount from 0 to iSize
            Move asTree[iCount] to asWrapped[SizeOfArray(asWrapped)]
        Loop
        If (bWrap = True) ;
            Move (sIndent + "End_Object") to asWrapped[SizeOfArray(asWrapped)]
        Move "" to asWrapped[SizeOfArray(asWrapped)]

        // Comment the legacy block where it stands - no index moves.
        For iCount from iStart to iEnd
            If ((Trim(asCode[iCount])) <> "") ;
                Move ("//  " + asCode[iCount]) to asCode[iCount]
        Loop
        Move asEmpty to asMark
        If (bFromUse = True) ;
            Move ("//  TODO (DFRefactor): converted to the CodeJock menu above by ChangeDFCreateMenuToCodeJock - the legacy block stays in " + sLeaf + ", which is no longer used here and was not changed.") to asMark[0]
        Else ;
            Move ("//  TODO (DFRefactor): converted to the CodeJock menu above by ChangeDFCreateMenuToCodeJock.") to asMark[0]

        // ...then the two inserts, larger index first.
        If (iAnchor > iStart) Begin
            Send _InsertLinesBefore (&asCode) iAnchor asWrapped
            Send _InsertLinesBefore (&asCode) iStart asMark
        End
        Else Begin
            Send _InsertLinesBefore (&asCode) iStart asMark
            Send _InsertLinesBefore (&asCode) iAnchor asWrapped
        End
        // The packages the tree needs, with the program's other Use lines (see _CJEnsureMenuPackages).
        Get _CJEnsureMenuPackages (&asCode) to iCount
        Function_Return iEmitted
    End_Function


    /* =============================================================================================
       FloatingPopupMenu / dbFloatingPopupMenu -> cCJContextMenu: the PURE core
       (ChangeFloatingPopupMenuToCodeJock's engine, 2026-09-13).

       THE GRAMMAR, measured over 48 objects in 27 files of the test workspaces (backups and package
       forks excluded):
         Object <name> is a FloatingPopupMenu | dbFloatingPopupMenu  -> Object <name> is a cCJContextMenu
         Item_List / End_Item_List                                     the wrapper of the On_Item form, dropped
         On_Item "&Cap" Send <Message> [to <target>]                  -> cCJMenuItem + OnExecute (13 objects)
         Send Add_Item Msg_<Message> "Cap"                             -> the same (68 lines)
         Msg_None / On_Item "" Send NONE                               a separator: pbControlBeginGroup on the NEXT item
         Set Status_Help to "text"                                     -> psToolTip on the item just read
         Procedure Popup ... Forward Send Popup ... End_Procedure      carried across (22 objects), Shadow_State translated
         On_Item "Cap" ;  /  Send <Message> to <target>                one item: ';' continues the line (a view's tree menu, 9 of them)
         Property <type> <name> <value>                                carried verbatim - the override reads it, a caller sets it
         Set Aux_Value to <target>                                     retired: commented out under a note (Nils 2026-09-13)
         Set Shadow_State Item N to X   (at object level)              translated like the override's
       Anything else REFUSES the object with the reason - a hand-written Procedure or Function, an If
       around the Add_Items, a nested object, an expression caption. A converter that carries what it
       does not understand as comments changes behaviour in silence, and that is the one thing this
       family must never do (Nils 2026-09-04, the OnInitMenu rule).

       THE OBJECT NAME IS KEPT. Every popup is reached by name - 1,332 'Set Floating_Menu_Object to
       (x(Current_Object))' lines and a 'Send Popup to (x(Current_Object))' in each Mouse_Down
       augmentation - and cCJContextMenu answers Popup, so those lines stay as written and keep
       working. What the popup needs at run time is the program's cCJCommandBarSystem: without one
       it raises "Context menu not attached to commandbars" when it pops (cCJCommandBarSystem.pkg).

       WHERE AN ITEM'S MESSAGE GOES. The legacy pulldown delivers it to the 'to' target when there is
       one, else to the FOCUS (PopupMenu.Redirect_Message: 'Get Focus of desktop'). In the test
       workspaces the handlers live on a dbGroup that is a SIBLING of the popup, so a plain 'Send X'
       from the item - delegation up the item's own parents - would never reach them. The item
       therefore sends 'of (Focus(Desktop))', the legacy dispatch to the letter; a 'to <target>'
       clause is carried verbatim, and 'Current_Object' on such a line meant the popup, so it becomes
       (Parent(Self)). The 'Msg_' prefix of an Add_Item message is the message ID's spelling, not
       part of the name - 'Send Msg_X' and 'Send X' both compile and both reach X (probe 2026-09-13)
       - so it is dropped and the catalogue is asked about the bare name.

       THE POPUP OVERRIDE. 'Set Shadow_State Item N to X' before 'Forward Send Popup' becomes
       'Set pbEnabled of (<Nth child>(Self)) to (not X)' through _CJTranslateInitLine - the same
       translation the menu converter gives an OnInitMenu. Set BEFORE the COM instance exists, the
       value lands in pbPrivateEnabled, which CreateComAction seeds ComEnabled from at popup time
       (cCJCommandBarSystem.pkg, read 2026-09-13), so the order the legacy code relied on still
       holds. Everything else in the override goes across verbatim: it ran before the legacy popup
       showed, it runs before the CodeJock one shows.

       A dbFloatingPopupMenu INHERITS TEN ITEMS from its class (Dfdeoft.pkg: a separator, Prompt, a
       separator, Find_Next, Find_Previous, a separator, Request_Clear_All, Request_Clear,
       Request_Save, Request_Delete) and its own Add_Items follow from index 10. The ten become the
       shipped cCJ*MenuItem classes through the catalogue - each carries its own localized caption
       and the enable logic the legacy class computed by hand in its Popup - and the indexes a
       Shadow_State names stay the absolute ones the legacy object used.
       ============================================================================================= */

    /* 'Object <name> is a FloatingPopupMenu' or '... dbFloatingPopupMenu' - the code part of the
       line, whole words, either article. The literal classes only: a subclass definition is
       ConvertPopupMenuSubclassToCodeJock's (_CJPopupClassToContextMenu, at the end of this class), and
       an object of a subclass follows its class (its items may live in the class's Construct_Object,
       where this converter does not look). */
    Function _CJPopupDeclParts String sLine String ByRef sName Boolean ByRef bDb Returns Boolean
        String sCode sLow sW1 sW3 sW4 sW5

        Get _CodeOnlyLine sLine to sCode
        Move (Lowercase(Trim(sCode))) to sLow
        Get _NthWord sLow 1 to sW1
        If (sW1 <> "object") ;
            Function_Return False
        Get _NthWord sLow 3 to sW3
        Get _NthWord sLow 4 to sW4
        Get _NthWord sLow 5 to sW5
        If (sW3 <> "is" or (sW4 <> "a" and sW4 <> "an")) ;
            Function_Return False
        If (sW5 <> "floatingpopupmenu" and sW5 <> "dbfloatingpopupmenu") ;
            Function_Return False
        Get _NthWord (Trim(sCode)) 2 to sName
        Move (sW5 = "dbfloatingpopupmenu") to bDb
        Function_Return True
    End_Function

    // A legacy message as the item names it: the 'Msg_' prefix of an Add_Item argument is the
    // message ID's spelling, not part of the name (Send Msg_X and Send X both reach X - probe 2026-09-13).
    Function _CJPopupMessageName String sToken Returns String
        Move (Trim(sToken)) to sToken
        If (Lowercase(Left(sToken, 4)) = "msg_") ;
            Function_Return (Mid(sToken, (Length(sToken) - 4), 5))
        Function_Return sToken
    End_Function

    /* The 'to <target>' after the message of an On_Item line, or "". sTrim is the original line,
       sCode its code part (literals masked, comment gone - the same length up to the cut), sMsg the
       message AS WRITTEN there. Read off the code part only, so a commented-out target - 'Send
       X //To (Client_Area(Main(Self)))', a real shape - stays gone. 'Current_Object' meant
       the popup being built; inside the item it would mean the item, so it becomes (Parent(Self)). */
    Function _CJOnItemTarget String sTrim String sCode String sMsg Returns String
        Integer iPos iAfter iLen
        String sRest sLow sCodePart

        If (sMsg = "") ;
            Function_Return ""
        Move (Left(sTrim, Length(sCode))) to sCodePart
        Get _FindKeywordPos sCode sMsg True 1 to iPos
        If (iPos = 0) ;
            Function_Return ""
        Move (iPos + Length(sMsg)) to iAfter
        Move (Length(sCodePart)) to iLen
        If (iAfter > iLen) ;
            Function_Return ""
        Move (Trim(Mid(sCodePart, (iLen - iAfter + 1), iAfter))) to sRest
        Move (Lowercase(sRest)) to sLow
        If (Left(sLow, 3) <> "to " and Left(sLow, 3) <> ("to" + Character(9))) ;
            Function_Return ""
        Move (Trim(Mid(sRest, (Length(sRest) - 3), 4))) to sRest
        If (Lowercase(sRest) = "current_object") ;
            Function_Return "(Parent(Self))"
        Function_Return sRest
    End_Function

    /* 'Send Add_Item <Msg_Message> "Caption"' -> the bare message ("" for Msg_None, the separator)
       and the caption. False when the line is not an Add_Item at all. bLiteral says whether the
       caption was a quoted literal: an expression caption cannot be carried, and the caller refuses
       the object rather than inventing one. */
    Function _CJAddItemParts String sTrim String sCode String ByRef sMsg String ByRef sCap Boolean ByRef bLiteral Returns Boolean
        String sLow sW1 sW2 sW3 sCodePart

        Move (Lowercase(Trim(sCode))) to sLow
        Get _NthWord sLow 1 to sW1
        Get _NthWord sLow 2 to sW2
        If (sW1 <> "send" or sW2 <> "add_item") ;
            Function_Return False
        Get _NthWord (Trim(sCode)) 3 to sW3
        Move "" to sMsg
        Move "" to sCap
        If (Lowercase(sW3) <> "msg_none" and Lowercase(sW3) <> "none") ;
            Get _CJPopupMessageName sW3 to sMsg
        Move (Left(sTrim, Length(sCode))) to sCodePart
        Get _CJQuotedText sCodePart to sCap
        Move ((sCodePart contains '"') or (sCodePart contains "'")) to bLiteral
        Function_Return True
    End_Function

    /* The package a catalogue class needs a Use for, or "" when a windowed program has it already.
       Measured against the DF26 install 2026-09-13 with a probe that Uses DFAllEnt.pkg alone: the
       DEO items (cCJDeoMenuItemClasses.pkg) compile, because cCJCommandBarSystem.pkg Uses that
       package itself; the Edit, Exit and Windows items live in cCJStandardMenuItemClasses.pkg and do
       not ("U_CCJCUTMENUITEM, MUST BE DEFINED"); cCJAboutMenuItem has a package of its own. */
    Function _CJPopupItemClassPackage String sClass Returns String
        String sLow

        Move (Lowercase(Trim(sClass))) to sLow
        If (sLow = "ccjaboutmenuitem") ;
            Function_Return "cCJAboutMenuItem.pkg"
        If (sLow = "ccjarrangeiconsmenuitem" or sLow = "ccjautoarrangeiconsmenuitem" or sLow = "ccjcascademenuitem" or sLow = "ccjcopymenuitem" or sLow = "ccjcutmenuitem" or sLow = "ccjdeleteeditmenuitem" or sLow = "ccjexitmenuitem" or sLow = "ccjhelpmenuitem" or sLow = "ccjminimizewindowsmenuitem" or sLow = "ccjpastemenuitem" or sLow = "ccjrestoremenusmenuitem" or sLow = "ccjrestorewindowsmenuitem" or sLow = "ccjselectallmenuitem" or sLow = "ccjstatusbarmenuitem" or sLow = "ccjtilehorizontally" or sLow = "ccjtilevertically" or sLow = "ccjundomenuitem") ;
            Function_Return "cCJStandardMenuItemClasses.pkg"
        Function_Return ""
    End_Function

    // The Use lines an emitted context menu needs, distinct, read off its 'Object x is a <class>' lines.
    Function _CJPopupPackagesNeeded String[] ByRef asNew Returns String[]
        String[] asPkgs
        String sLow sClass sPkg
        Integer i iLast

        Move (SizeOfArray(asNew) - 1) to iLast
        For i from 0 to iLast
            Move (Lowercase(Trim(asNew[i]))) to sLow
            If (Left(sLow, 7) = "object ") Begin
                Get _NthWord sLow 5 to sClass
                Get _CJPopupItemClassPackage sClass to sPkg
                If (sPkg <> "" and SearchArray(sPkg, asPkgs) = -1) ;
                    Move sPkg to asPkgs[SizeOfArray(asPkgs)]
            End
        Loop
        Function_Return asPkgs
    End_Function

    /* The block -> object emitter. asBlock is the legacy object, its 'Object' line first and its
       'End_Object' last; sIndent the declaration's own indent; iFirstLine the block's first line in
       the file (0-based), so a refusal names the file line. TWO PASSES like the menu emitter, and for
       the same reason: Status_Help arrives AFTER the item it describes.
       LOGICAL LINES (2026-09-13, Nils's first live run): a line whose code ends in ';' continues on
       the next - an item written as  On_Item "Cap" ;  /  Send X to (target)  is ONE item, and a view's
       tree menu wrote all nine that way - so the object-level lines are joined before they are read;
       the Popup override's body is kept line for line. Tabs read as spaces here, so a tab-only line
       is blank, not a refusal. Returns True with the object's lines in asOut and its item objects
       counted in iItems, or False with sWhyNot - and then asOut is left as it was. PURE. */
    Function _CJPopupBlockToContextMenu String[] ByRef asBlock String sIndent Integer iFirstLine String[] ByRef asOut Integer ByRef iItems String ByRef sWhyNot Returns Boolean
        tCJPopupRow[] aRows
        tCJPopupRow Row Blank
        String[] asBody asTen asObjName
        Integer[] aiParent aiItemIx
        String sName sLine sTrim sCode sLow sW1 sW2 sW2Raw sCap sMsg sRawMsg sTgt sTip sClass sPad sAccel sBase sObj sOutLine
        Integer i iLast iNext iRow iRows iMin iInd iEmitted iPopup iAt
        Boolean bDb bInPopup bPopup bGroup bLit bOK

        Move 0 to iItems
        Move "" to sWhyNot
        Move (SizeOfArray(asBlock) - 1) to iLast
        If (iLast < 1) Begin
            Move "the object has no End_Object" to sWhyNot
            Function_Return False
        End
        Get _CJPopupDeclParts asBlock[0] (&sName) (&bDb) to bOK
        If (bOK = False) Begin
            Move "the first line is not a FloatingPopupMenu declaration" to sWhyNot
            Function_Return False
        End

        // ---- PASS 1: lines -> rows ---------------------------------------------------------------
        Move 0 to iNext
        Move False to bGroup
        If (bDb = True) Begin
            // The ten the class adds in its Construct_Object (Dfdeoft.pkg), indexes 0-9; "" = a separator.
            Move ""                  to asTen[0]
            Move "Prompt"            to asTen[1]
            Move ""                  to asTen[2]
            Move "Find_Next"         to asTen[3]
            Move "Find_Previous"     to asTen[4]
            Move ""                  to asTen[5]
            Move "Request_Clear_All" to asTen[6]
            Move "Request_Clear"     to asTen[7]
            Move "Request_Save"      to asTen[8]
            Move "Request_Delete"    to asTen[9]
            For i from 0 to 9
                If (asTen[i] = "") Begin
                    Move True to bGroup
                    Increment iNext
                End
                Else Begin
                    Move Blank to Row
                    Move "ITEM"   to Row.sKind
                    Move asTen[i] to Row.sMsg
                    Move iNext    to Row.iItemIx
                    Move bGroup   to Row.bGroup
                    Move Row to aRows[SizeOfArray(aRows)]
                    Move False to bGroup
                    Increment iNext
                End
            Loop
        End
        Move False to bInPopup
        Move False to bPopup
        Move 1 to i
        While (i <= (iLast - 1))
            Move asBlock[i] to sLine
            Move i to iAt
            If (bInPopup = True) Begin
                // The override's body, verbatim, until either ender closes it (End_Procedure closes a
                // Function too, and the reverse).
                Move (Trim(sLine)) to sTrim
                Get _CodeOnlyLine sTrim to sCode
                Move (Lowercase(Trim(sCode))) to sLow
                Get _NthWord sLow 1 to sW1
                If (sW1 = "end_procedure" or sW1 = "end_function") ;
                    Move False to bInPopup
                Else ;
                    Move sLine to asBody[SizeOfArray(asBody)]
            End
            Else Begin
                Move (Trim(Replaces(Character(9), sLine, " "))) to sTrim
                Get _CodeOnlyLine sTrim to sCode
                // A ';' at the end of the CODE part continues the line: joined with the next, the mark
                // dropped, until the logical line is complete. The code text keeps its quotes; a comment
                // on a continued line is dropped, the last line's comment rides along.
                While ((Right(Trim(sCode), 1)) = ";" and i < (iLast - 1))
                    Move (Trim(Left(sTrim, Length(sCode)))) to sTrim
                    Move (Trim(Left(sTrim, (Length(sTrim) - 1)))) to sTrim
                    Increment i
                    Move (sTrim + " " + Trim(Replaces(Character(9), asBlock[i], " "))) to sTrim
                    Get _CodeOnlyLine sTrim to sCode
                Loop
                Move (Lowercase(Trim(sCode))) to sLow
                Get _NthWord sLow 1 to sW1
                Get _NthWord sLow 2 to sW2
                Get _NthWord (Trim(sCode)) 2 to sW2Raw
                If (sTrim = "") Begin
                    Move Blank to Row
                    Move "BLANK" to Row.sKind
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                End
                Else If (Left(sTrim, 2) = "//") Begin
                    Move Blank to Row
                    Move "COMMENT" to Row.sKind
                    Move sTrim to Row.sRaw
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                End
                Else If (sW1 = "item_list" or sW1 = "end_item_list") Begin
                    // the wrapper of the On_Item form; nothing of its own
                End
                Else If (sW1 = "on_item") Begin
                    Get _CJQuotedText (Left(sTrim, Length(sCode))) to sCap
                    Get _CJMessageFromOnItem (Left(sTrim, Length(sCode))) to sRawMsg
                    Get _CJPopupMessageName sRawMsg to sMsg
                    If (sMsg = "" and sCap = "") Begin
                        Move True to bGroup
                        Increment iNext
                    End
                    Else If (sMsg = "") Begin
                        Move ("line " + String(iFirstLine + iAt + 1) + " is an On_Item that sends nothing") to sWhyNot
                    End
                    Else Begin
                        Get _CJOnItemTarget sTrim sCode sRawMsg to sTgt
                        Move Blank to Row
                        Move "ITEM" to Row.sKind
                        Move sCap   to Row.sCap
                        Move sMsg   to Row.sMsg
                        Move sTgt   to Row.sTarget
                        Move iNext  to Row.iItemIx
                        Move bGroup to Row.bGroup
                        Move Row to aRows[SizeOfArray(aRows)]
                        Move False to bGroup
                        Increment iNext
                    End
                End
                Else If (sW1 = "send" and sW2 = "add_item") Begin
                    Get _CJAddItemParts sTrim sCode (&sMsg) (&sCap) (&bLit) to bOK
                    If (sMsg = "" and sCap = "") Begin
                        Move True to bGroup
                        Increment iNext
                    End
                    Else If (bLit = False) Begin
                        Move ("line " + String(iFirstLine + iAt + 1) + " gives Add_Item a caption that is not a literal") to sWhyNot
                    End
                    Else If (sMsg = "") Begin
                        Move ("line " + String(iFirstLine + iAt + 1) + " is an Add_Item with no message") to sWhyNot
                    End
                    Else Begin
                        Move Blank to Row
                        Move "ITEM" to Row.sKind
                        Move sCap   to Row.sCap
                        Move sMsg   to Row.sMsg
                        Move iNext  to Row.iItemIx
                        Move bGroup to Row.bGroup
                        Move Row to aRows[SizeOfArray(aRows)]
                        Move False to bGroup
                        Increment iNext
                    End
                End
                Else If (sW1 = "set" and sW2 = "status_help") Begin
                    Get _CJQuotedText (Left(sTrim, Length(sCode))) to sTip
                    Move -1 to iRow
                    Move (SizeOfArray(aRows) - 1) to iRows
                    While (iRows >= 0 and iRow = -1)
                        If (aRows[iRows].sKind = "ITEM") ;
                            Move iRows to iRow
                        Decrement iRows
                    Loop
                    If (iRow = -1) ;
                        Move ("line " + String(iFirstLine + iAt + 1) + " sets Status_Help before any item") to sWhyNot
                    Else ;
                        Move sTip to aRows[iRow].sTip
                End
                Else If (sW1 = "set" and sW2 = "aux_value") Begin
                    // Retired, not honoured (Nils 2026-09-13: "disregard if there is a Set aux_value line and
                    // convert anyway, then comment out the line"): the line goes across commented, under a
                    // note saying why, and the items dispatch as every other converted item does.
                    Move Blank to Row
                    Move "COMMENT" to Row.sKind
                    Move "// DFRefactor (ChangeFloatingPopupMenuToCodeJock): Aux_Value was the legacy popup menu's own property - a cCJContextMenu has no use for it, so the line below is retired." to Row.sRaw
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                    Move Blank to Row
                    Move "COMMENT" to Row.sKind
                    Move ("//  " + sTrim) to Row.sRaw
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                End
                Else If (sW1 = "property") Begin
                    // A property of the object's own (the override reads it, a caller sets it): verbatim.
                    Move Blank to Row
                    Move "VERBATIM" to Row.sKind
                    Move sTrim to Row.sRaw
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                End
                Else If (sW1 = "set" and (sW2 = "shadow_state" or sW2 = "select_state")) Begin
                    // An item shadowed at construction: the override's translation, at object level.
                    Move Blank to Row
                    Move "SETLINE" to Row.sKind
                    Move sTrim to Row.sRaw
                    Move -1 to Row.iItemIx
                    Move Row to aRows[SizeOfArray(aRows)]
                End
                Else If (sW1 = "procedure" and sW2 = "popup") Begin
                    If (bPopup = True) ;
                        Move ("line " + String(iFirstLine + iAt + 1) + " is a second Procedure Popup") to sWhyNot
                    Move True to bPopup
                    Move True to bInPopup
                End
                Else If (sW1 = "procedure" or sW1 = "function") Begin
                    Move ("line " + String(iFirstLine + iAt + 1) + " is a hand-written " + sW1 + " (" + sW2Raw + ") the converter cannot translate") to sWhyNot
                End
                Else If (sW1 = "object") Begin
                    Move ("line " + String(iFirstLine + iAt + 1) + " declares a nested object") to sWhyNot
                End
                Else Begin
                    Move ("line " + String(iFirstLine + iAt + 1) + " is not part of the popup grammar: '" + sTrim + "'") to sWhyNot
                End
            End
            If (sWhyNot <> "") ;
                Function_Return False
            Increment i
        Loop
        If (bInPopup = True) Begin
            Move "its Procedure Popup has no End_Procedure" to sWhyNot
            Function_Return False
        End

        // ---- PASS 2: rows -> objects -------------------------------------------------------------
        // Names first, for every item, so an object-level Shadow_State ahead of the items it names
        // and the override both resolve their children.
        Move -1 to iPopup
        Move (SizeOfArray(aRows) - 1) to iRows
        For iRow from 0 to iRows
            Move -1 to aiParent[iRow]
            Move aRows[iRow].iItemIx to aiItemIx[iRow]
            Move "" to asObjName[iRow]
        Loop
        For iRow from 0 to iRows
            If (aRows[iRow].sKind = "ITEM") Begin
                // The name from the caption, as the menu converter does; from the message when the
                // item has none (the ten a dbFloatingPopupMenu inherits).
                Get _CJCaptionWithoutAccel aRows[iRow].sCap to sCap
                If (sCap <> "") ;
                    Move sCap to sBase
                Else ;
                    Move aRows[iRow].sMsg to sBase
                Get _CJMenuNameFromCaption sBase "_MenuItem" to sObj
                Get _CJUniqueChildName sObj iRow (&aiParent) (&asObjName) to sObj
                Move sObj to asObjName[iRow]
            End
        Loop
        Move (sIndent + "Object " + sName + " is a cCJContextMenu") to asOut[SizeOfArray(asOut)]
        Move (sIndent + "    ") to sPad
        Move 0 to iEmitted
        For iRow from 0 to iRows
            If (aRows[iRow].sKind = "BLANK") Begin
                // one blank at a time: the legacy blank after End_Procedure lands here, before the override
                If (asOut[SizeOfArray(asOut) - 1] <> "") ;
                    Move "" to asOut[SizeOfArray(asOut)]
            End
            Else If (aRows[iRow].sKind = "COMMENT" or aRows[iRow].sKind = "VERBATIM") Begin
                Move (sPad + aRows[iRow].sRaw) to asOut[SizeOfArray(asOut)]
            End
            Else If (aRows[iRow].sKind = "SETLINE") Begin
                Get _CJTranslateInitLine aRows[iRow].sRaw iPopup (&aiParent) (&aiItemIx) (&asObjName) to sOutLine
                Move (sPad + sOutLine) to asOut[SizeOfArray(asOut)]
            End
            Else Begin
                Get _CJCaptionWithoutAccel aRows[iRow].sCap to sCap
                Get _CJAcceleratorOf aRows[iRow].sCap to sAccel
                Get CJMenuClassForMessage aRows[iRow].sMsg to sClass
                Move asObjName[iRow] to sObj
                If (sClass <> "") Begin
                    // Catalogue hit: the shipped class carries its own localized caption and action.
                    Move (sPad + "Object " + sObj + " is a " + sClass) to asOut[SizeOfArray(asOut)]
                End
                Else Begin
                    Move (sPad + "Object " + sObj + " is a cCJMenuItem") to asOut[SizeOfArray(asOut)]
                    Move (sPad + '    Set psCaption to "' + sCap + '"') to asOut[SizeOfArray(asOut)]
                End
                // A separator ahead of the FIRST item would draw a rule above nothing.
                If (aRows[iRow].bGroup = True and iEmitted > 0) ;
                    Move (sPad + "    Set pbControlBeginGroup to True") to asOut[SizeOfArray(asOut)]
                If (aRows[iRow].sTip <> "") ;
                    Move (sPad + '    Set psToolTip to "' + aRows[iRow].sTip + '"') to asOut[SizeOfArray(asOut)]
                If (sAccel <> "") ;
                    Move (sPad + "//  " + sAccel + "   // TODO (DFRefactor): legacy accelerator - bind a CodeJock shortcut by hand.") to asOut[SizeOfArray(asOut)]
                If (sClass = "") Begin
                    Move (sPad + "    Procedure OnExecute Variant vCommandBarControl") to asOut[SizeOfArray(asOut)]
                    If (aRows[iRow].sTarget <> "") ;
                        Move (sPad + "        Send " + aRows[iRow].sMsg + " to " + aRows[iRow].sTarget) to asOut[SizeOfArray(asOut)]
                    Else ;
                        Move (sPad + "        Send " + aRows[iRow].sMsg + " of (Focus(Desktop))") to asOut[SizeOfArray(asOut)]
                    Move (sPad + "    End_Procedure") to asOut[SizeOfArray(asOut)]
                End
                Move (sPad + "End_Object") to asOut[SizeOfArray(asOut)]
                Increment iEmitted
            End
        Loop

        // The override, after its children: the smallest indent of its lines is the base, every
        // Shadow_State / Select_State on an item goes through the OnInitMenu translation.
        If (bPopup = True) Begin
            Move 999 to iMin
            Move (SizeOfArray(asBody) - 1) to iLast
            For i from 0 to iLast
                If (Trim(asBody[i]) <> "") Begin
                    Move (Length(asBody[i]) - Length(LTrim(asBody[i]))) to iInd
                    If (iInd < iMin) ;
                        Move iInd to iMin
                End
            Loop
            If (iMin = 999) ;
                Move 0 to iMin
            Move (sPad + "Procedure Popup") to asOut[SizeOfArray(asOut)]
            For i from 0 to iLast
                Move asBody[i] to sLine
                If (Trim(sLine) = "") Begin
                    Move "" to asOut[SizeOfArray(asOut)]
                End
                Else Begin
                    If (Length(sLine) > iMin) ;
                        Move (Right(sLine, (Length(sLine) - iMin))) to sLine
                    Get _CJTranslateInitLine sLine iPopup (&aiParent) (&aiItemIx) (&asObjName) to sOutLine
                    Move (sPad + "    " + sOutLine) to asOut[SizeOfArray(asOut)]
                End
            Loop
            Move (sPad + "End_Procedure") to asOut[SizeOfArray(asOut)]
        End
        Move (sIndent + "End_Object") to asOut[SizeOfArray(asOut)]
        Move iEmitted to iItems
        Function_Return True
    End_Function

    /* Does the popup converter's OWN refusal marker still hold for the object declared at iDecl
       (0-based)? A marker is written by the version that refused; a later version may take the shape
       (Nils 2026-09-13: the first run refused a ';'-continued item list, the same day's build reads
       it, and the marker from the morning kept the afternoon's converter from ever being asked -
       the scan stayed quiet on the line and the compiler row was demoted to Explain quoting the stale
       reason). So both lanes ask HERE before they honour such a marker: True = the object still
       refuses, the marker stands; False = it converts now, the offer stands and the run replaces the
       marker. Anything that is not a live popup declaration answers True - not this converter's
       business. Dry-run only: nothing is written. */
    Function _CJPopupMarkerStillHolds String[] ByRef asCode Integer iDecl Returns Boolean
        String[] asBlock asOut
        String sName sIndent sWhyNot
        Integer iEnd j iItems
        Boolean bDb bOK

        If (iDecl < 0 or iDecl >= SizeOfArray(asCode)) ;
            Function_Return True
        Get _CJPopupDeclParts asCode[iDecl] (&sName) (&bDb) to bOK
        If (bOK = False) ;
            Function_Return True
        Get _CJMatchingEndObject (&asCode) iDecl to iEnd
        If (iEnd < 0) ;
            Function_Return True
        For j from iDecl to iEnd
            Move asCode[j] to asBlock[SizeOfArray(asBlock)]
        Loop
        Get _LineIndent asCode[iDecl] to sIndent
        Get _CJPopupBlockToContextMenu (&asBlock) sIndent iDecl (&asOut) (&iItems) (&sWhyNot) to bOK
        Function_Return (bOK = False)
    End_Function

    /* Every legacy popup object in the file, converted where it stands: the CodeJock object first,
       then a marker, then the legacy block COMMENTED - never deleted (the menu converter's rule). A
       refused object is left as written under a skip-marker naming the reason: the line the scan
       and the analyzer both read (VerifySkipMarker), so its row turns Explain instead of promising
       the same run again - and a marker from an earlier run is replaced, never stacked (the dfTimer
       lesson, 2026-07-06); the marker over an object converted on a later run is dropped. Returns
       the objects converted; asDone carries "<name>|<items>" per conversion and asRefused
       "<name>|<reason>" per refusal. The Use lines the emitted classes need go in once, at the end. */
    Function _CJConvertPopupMenusInFile String[] ByRef asCode String[] ByRef asDone String[] ByRef asRefused Returns Integer
        String[] asBlock asNew asMark asNeed asPkgs asEmpty
        String sName sIndent sWhyNot sPrev sMarker
        Integer i iEnd iCount j iItems iN iVoid
        Boolean bDb bOK bMarked

        Move 0 to iCount
        Move 0 to i
        While (i < SizeOfArray(asCode))
            Get _CJPopupDeclParts asCode[i] (&sName) (&bDb) to bOK
            If (bOK = True) Begin
                Get _LineIndent asCode[i] to sIndent
                Get _CJMatchingEndObject (&asCode) i to iEnd
                Move asEmpty to asBlock
                Move asEmpty to asNew
                Move "" to sWhyNot
                If (iEnd < 0) Begin
                    Move "the object has no End_Object" to sWhyNot
                End
                Else Begin
                    For j from i to iEnd
                        Move asCode[j] to asBlock[SizeOfArray(asBlock)]
                    Loop
                    Get _CJPopupBlockToContextMenu (&asBlock) sIndent i (&asNew) (&iItems) (&sWhyNot) to bOK
                End
                // An earlier run's marker sits directly above the declaration.
                Move False to bMarked
                If (i > 0) Begin
                    Move (Lowercase(Trim(asCode[i - 1]))) to sPrev
                    If (Left(sPrev, 2) = "//" and (sPrev contains "changefloatingpopupmenutocodejock left")) ;
                        Move True to bMarked
                End
                If (sWhyNot <> "") Begin
                    Move (sIndent + "//  TODO (DFRefactor): ChangeFloatingPopupMenuToCodeJock left " + sName + " as written - " + sWhyNot + ". Clear that and run it again, or port the object to cCJContextMenu by hand.") to sMarker
                    If (bMarked = True) Begin
                        Move sMarker to asCode[i - 1]
                    End
                    Else Begin
                        Move asEmpty to asMark
                        Move sMarker to asMark[0]
                        Send _InsertLinesBefore (&asCode) i asMark
                        Increment i
                        If (iEnd >= 0) ;
                            Increment iEnd
                    End
                    Move (sName + "|" + sWhyNot) to asRefused[SizeOfArray(asRefused)]
                    If (iEnd >= 0) ;
                        Move (iEnd + 1) to i
                    Else ;
                        Increment i
                End
                Else Begin
                    If (bMarked = True) Begin
                        Move (RemoveFromArray(asCode, (i - 1))) to asCode
                        Decrement i
                        Decrement iEnd
                    End
                    Get _CJPopupPackagesNeeded (&asNew) to asPkgs
                    For iN from 0 to (SizeOfArray(asPkgs) - 1)
                        If (SearchArray(asPkgs[iN], asNeed) = -1) ;
                            Move asPkgs[iN] to asNeed[SizeOfArray(asNeed)]
                    Loop
                    // The legacy block commented where it stands, then the new object and the marker
                    // above it - one insert, no index moves.
                    For j from i to iEnd
                        If ((Trim(asCode[j])) <> "") ;
                            Move ("//  " + asCode[j]) to asCode[j]
                    Loop
                    Move "" to asNew[SizeOfArray(asNew)]
                    Move (sIndent + "//  TODO (DFRefactor): converted to the CodeJock context menu above by ChangeFloatingPopupMenuToCodeJock.") to asNew[SizeOfArray(asNew)]
                    Send _InsertLinesBefore (&asCode) i asNew
                    Move (sName + "|" + String(iItems)) to asDone[SizeOfArray(asDone)]
                    Increment iCount
                    Move (iEnd + SizeOfArray(asNew) + 1) to i
                End
            End
            Else ;
                Increment i
        Loop
        If (SizeOfArray(asNeed) > 0) ;
            Get _CJEnsureUses (&asCode) (&asNeed) "ChangeFloatingPopupMenuToCodeJock: classes of the converted context menu" to iVoid
        Function_Return iCount
    End_Function

    /* =============================================================================================
       A workspace SUBCLASS of FloatingPopupMenu -> a subclass of cCJContextMenu, in place
       (ConvertPopupMenuSubclassToCodeJock's engine, 2026-10-05).

       WHY THIS IS NOT THE OBJECT CONVERTER ABOVE. An object's items stand in the source, one line
       each, and become child objects. A subclass is there to be FILLED: the one this was written for
       is empty, is created at run time ('Get Create (RefClass(cX))') and gets its items from the
       code that owns it - 'Send Add_Item of (phoPopupMenu(Self)) iMsg sText', message and caption
       both arriving as values. There is no list to turn into objects, and no way to tell from the
       class file who else sends the menu what.

       SO THE CLASS KEEPS ITS LEGACY MESSAGES. Its base becomes cCJContextMenu, and the class itself
       answers the two messages that fill-and-show code uses:
         Add_Item <msg> <caption>   makes one item object per call - an item of a small class written
                                    ABOVE the menu class, <Class>Item, a cCJMenuItem that remembers
                                    the message and sends it when the item is chosen
         Item_Count                 what it answered before: every Add_Item, a separator too
       Popup is cCJContextMenu's own. The code that creates, fills and pops the menu stays exactly as
       written - which is the point, because none of it can be found from here.

       WHERE AN ITEM'S MESSAGE GOES: to the object that has the focus, where the legacy menu sent an
       item that named no destination (PopupMenu.Redirect_Message, 'Get Focus of Desktop' - see the
       object converter's note above). The item asks its menu, ItemMessageTarget, so there is ONE
       place to send it elsewhere - in the class, or in an object of it.

       A SEPARATOR was 'Send Add_Item Msg_None ""'. It makes no object; the next item begins a group
       (pbControlBeginGroup) - unless nothing stands above it, where a rule would sit over nothing.

       "NO MESSAGE" IS TWO VALUES. Msg_None is a real message id - 50, measured in the test runner
       2026-10-05, where the first draft of this had taken it for 0 - and the legacy menu sent it like
       any other; it just does nothing. A zero it skipped itself ('If Msg# Begin'). So what this writes
       treats both as "nothing to send", in Add_Item's separator test and in the item's OnExecute:
       sending a 0 would be an error where the legacy menu was silent.

       WHAT cCJContextMenu DOES WITH ITEMS MADE AT RUN TIME (read in cCJCommandBarSystem.pkg,
       DataFlex 26, 2026-10-05): Popup builds the COM popup every time it is sent, by broadcasting
       CreateComInstance to whatever child objects the menu has at that moment, and an item whose id
       could not be assigned when it was constructed gets one then (CreateComAction). So an item made
       by Add_Item, long after the menu, takes part like one written in the source.

       WHAT IS CONVERTED. A class whose body is nothing but Construct_Object / End_Construct_Object
       holding 'Forward Send', Add_Item lines (they reach the new Add_Item - any caption, a variable
       too), Property lines, comments and blanks. Anything else REFUSES the class with the reason: a
       hand-written method may send or answer a message a cCJContextMenu does not have, and a class
       converted on a guess fails when it runs, in front of the user, not when it compiles.

       WHAT IS NOT CARRIED, and cannot be seen from the class file: any OTHER FloatingPopupMenu
       message some code sends to the menu - Delete_Data, Shadow_State, Aux_Value, an item's Value.
       Such a line still compiles and fails when it runs. That is why the scan lists this function
       for review instead of ticking it, and why its run note says so.

       COMMENTS. Every function here reads the CODE-ONLY twin of the lines (_StrVarCodeLines: '//'
       cut, literals blanked, every line of a DF 23 block comment blank - the line contract the Deep
       Scan uses), so a class declared inside a block comment is not a class, an End_Class in one does
       not close anything, and a block comment in a class body is carried like any other comment.

       NO MARKER is written above a class that is left. The Check asks _CJPopupClassWhyNot about
       every such class and its row carries the reason, each time; a marker would silence that row,
       and the compiler reports nothing on a subclass line, so the class would drop off the board
       unported.
       ============================================================================================= */

    /* 'Class <name> is a FloatingPopupMenu' - the code part of the line, whole words, either
       article. Returns the class name as written, "" for any other line. The plain class only: a
       dbFloatingPopupMenu subclass inherits ten items and is still ported by hand. */
    Function _CJPopupClassDeclName String sLine Returns String
        String sCode sLow sW1 sW3 sW4 sW5 sName

        Get _CodeOnlyLine sLine to sCode
        Move (Lowercase(sCode)) to sLow
        Get _NthWord sLow 1 to sW1
        If (sW1 <> "class") ;
            Function_Return ""
        Get _NthWord sLow 3 to sW3
        Get _NthWord sLow 4 to sW4
        Get _NthWord sLow 5 to sW5
        If (sW3 <> "is" or (sW4 <> "a" and sW4 <> "an") or sW5 <> "floatingpopupmenu") ;
            Function_Return ""
        Get _NthWord sCode 2 to sName
        Function_Return sName
    End_Function

    // The index of the End_Class that closes the class opened at iDecl, or -1. asOnly is the
    // code-only twin of the file (_StrVarCodeLines), so a commented line never counts; a second
    // Class line before any End_Class means the first was never closed.
    Function _CJMatchingEndClass String[] ByRef asOnly Integer iDecl Returns Integer
        String  sW1
        Integer i iLast

        Move (SizeOfArray(asOnly) - 1) to iLast
        For i from (iDecl + 1) to iLast
            Get _NthWord (Lowercase(asOnly[i])) 1 to sW1
            If (sW1 = "end_class") ;
                Function_Return i
            If (sW1 = "class") ;
                Function_Return -1
        Loop
        Function_Return -1
    End_Function

    /* The class block -> the item class and the ported class. asBlock is the legacy class, its
       'Class' line first and its 'End_Class' last; iFirstLine the block's first line in the file
       (0-based), so a refusal names the file line. TWO PASSES: the body is read to the end before
       anything is written, because one line the converter does not know refuses the whole class.
       Returns True with the new lines in asOut, or False with sWhyNot - and then asOut is left as it
       was. PURE. */
    Function _CJPopupClassToContextMenu String[] ByRef asBlock Integer iFirstLine String[] ByRef asOut String ByRef sWhyNot Returns Boolean
        String[] asNew asProps asOnly
        String  sName sItem sTrim sCode sLow sW1 sW2 sW3 sW2Raw sIndent sPad sIn sCodePart sWhere
        Integer i iLast iForward iPos iProp
        Boolean bInCtor bInEnd bCtor bEnd

        Move "" to sWhyNot
        Move (SizeOfArray(asBlock) - 1) to iLast
        If (iLast < 1) Begin
            Move "the class has no End_Class" to sWhyNot
            Function_Return False
        End
        Get _CJPopupClassDeclName asBlock[0] to sName
        If (sName = "") Begin
            Move "the first line does not declare a FloatingPopupMenu subclass" to sWhyNot
            Function_Return False
        End
        Move (sName + "Item") to sItem
        Get _LineIndent asBlock[0] to sIndent
        Move (sIndent + "    ") to sPad

        // ---- PASS 1: every line of the body must be one the converter knows ---------------------
        // Read off the code-only twin: "" for a blank line, a '//' line and every line of a block comment.
        Get _StrVarCodeLines (&asBlock) to asOnly
        Move False to bInCtor
        Move False to bInEnd
        Move False to bCtor
        Move False to bEnd
        Move -1 to iForward
        For i from 1 to (iLast - 1)
            Move (Trim(Replaces(Character(9), asBlock[i], " "))) to sTrim
            Move (Trim(Replaces(Character(9), asOnly[i], " "))) to sCode
            Move (Lowercase(sCode)) to sLow
            Get _NthWord sLow 1 to sW1
            Get _NthWord sLow 2 to sW2
            Get _NthWord sLow 3 to sW3
            Get _NthWord sCode 2 to sW2Raw
            Move ("line " + String(iFirstLine + i + 1)) to sWhere
            If (sLow = "") Begin
                // a blank line or a comment: carried as written
            End
            Else If (bInCtor = True or bInEnd = True) Begin
                If (sW1 = "end_procedure") Begin
                    If (bInCtor = True and iForward = -1) ;
                        Move "its Construct_Object does not forward to the class it is built on" to sWhyNot
                    Move False to bInCtor
                    Move False to bInEnd
                End
                Else If (sW1 = "forward" and sW2 = "send" and bInCtor = True and sW3 = "construct_object") Begin
                    If (iForward <> -1) ;
                        Move (sWhere + " forwards Construct_Object a second time") to sWhyNot
                    Move i to iForward
                End
                Else If (sW1 = "forward" and sW2 = "send" and bInEnd = True and sW3 = "end_construct_object") Begin
                    // carried as written
                End
                Else If (sW1 = "send" and sW2 = "add_item") Begin
                    // It reaches the class's own Add_Item - which needs the properties, so not before the forward.
                    If (bInCtor = True and iForward = -1) ;
                        Move (sWhere + " adds an item before Construct_Object is forwarded") to sWhyNot
                End
                Else If (sW1 = "property" and bInCtor = True) Begin
                    // a property of the class's own: carried as written
                End
                Else Begin
                    Move (sWhere + " does more than add an item: '" + sTrim + "'") to sWhyNot
                End
            End
            Else If (sW1 = "procedure" and sW2 = "construct_object") Begin
                If (bCtor = True) ;
                    Move (sWhere + " is a second Construct_Object") to sWhyNot
                Move True to bCtor
                Move True to bInCtor
            End
            Else If (sW1 = "procedure" and sW2 = "end_construct_object") Begin
                If (bEnd = True) ;
                    Move (sWhere + " is a second End_Construct_Object") to sWhyNot
                Move True to bEnd
                Move True to bInEnd
            End
            Else If (sW1 = "procedure" or sW1 = "function") Begin
                Move (sWhere + " is a hand-written " + sW1 + " (" + sW2Raw + "), and what it sends or answers may not exist in a cCJContextMenu") to sWhyNot
            End
            Else Begin
                Move (sWhere + " is not a line the converter knows in a menu class: '" + sTrim + "'") to sWhyNot
            End
            If (sWhyNot <> "") ;
                Function_Return False
        Loop
        If (bInCtor = True or bInEnd = True) Begin
            Move "a procedure in it has no End_Procedure" to sWhyNot
            Function_Return False
        End

        // ---- PASS 2: the item class, then the class on its new base with its two messages -------
        Move "Property Integer piAddedItems 0               // every Add_Item so far, a separator too: what Item_Count answers" to asProps[0]
        Move "Property Boolean pbItemMade False             // an item object exists" to asProps[1]
        Move "Property Boolean pbNextItemBeginsGroup False  // a separator came after the last item" to asProps[2]

        Move (sIndent + "// DFRefactor (ConvertPopupMenuSubclassToCodeJock): one item of a " + sName + ". A CodeJock menu item is an") to asNew[-1]
        Move (sIndent + "// object, so Add_Item of " + sName + " makes one of these per item and gives it the message the item sends.") to asNew[-1]
        Move (sIndent + "Class " + sItem + " is a cCJMenuItem") to asNew[-1]
        Move (sPad + "Procedure Construct_Object") to asNew[-1]
        Move (sPad + "    Forward Send Construct_Object") to asNew[-1]
        Move (sPad + "    Property Integer piItemMessage 0") to asNew[-1]
        Move (sPad + "End_Procedure") to asNew[-1]
        Move "" to asNew[-1]
        Move (sPad + "// Chosen: the message goes where the menu says - see ItemMessageTarget in " + sName + ".") to asNew[-1]
        Move (sPad + "Procedure OnExecute Variant vCommandBarControl") to asNew[-1]
        Move (sPad + "    Integer iMsg") to asNew[-1]
        Move (sPad + "    Handle  hoTarget") to asNew[-1]
        Move (sPad + "    Get piItemMessage to iMsg") to asNew[-1]
        Move (sPad + "    Get ItemMessageTarget of (Parent(Self)) to hoTarget") to asNew[-1]
        Move (sPad + "    If (iMsg <> 0 and iMsg <> Msg_None and hoTarget > Desktop) Begin") to asNew[-1]
        Move (sPad + "        Send iMsg of hoTarget") to asNew[-1]
        Move (sPad + "    End") to asNew[-1]
        Move (sPad + "End_Procedure") to asNew[-1]
        Move (sIndent + "End_Class") to asNew[-1]
        Move "" to asNew[-1]

        // The class line: the base changes, the rest of the line - name, spelling, comment - stays.
        Get _CodeOnlyLine asBlock[0] to sCode
        Move (Left(asBlock[0], Length(sCode))) to sCodePart
        Move (RightPos("floatingpopupmenu", Lowercase(sCodePart))) to iPos
        Move (Left(asBlock[0], (iPos - 1)) + "cCJContextMenu" + Mid(asBlock[0], Length(asBlock[0]), (iPos + 17))) to asNew[-1]
        // A class with no Construct_Object gets one: the properties need a home.
        If (bCtor = False) Begin
            Move (sPad + "Procedure Construct_Object") to asNew[-1]
            Move (sPad + "    Forward Send Construct_Object") to asNew[-1]
            For iProp from 0 to 2
                Move (sPad + "    " + asProps[iProp]) to asNew[-1]
            Loop
            Move (sPad + "End_Procedure") to asNew[-1]
        End
        For i from 1 to (iLast - 1)
            Move asBlock[i] to asNew[-1]
            If (i = iForward) Begin
                Get _LineIndent asBlock[i] to sIn
                For iProp from 0 to 2
                    Move (sIn + asProps[iProp]) to asNew[-1]
                Loop
            End
        Loop
        If (Trim(asNew[SizeOfArray(asNew) - 1]) <> "") ;
            Move "" to asNew[-1]
        Move (sPad + "// DFRefactor (ConvertPopupMenuSubclassToCodeJock): the FloatingPopupMenu messages that the code filling") to asNew[-1]
        Move (sPad + "// this menu uses, kept so that code stays as it is. No message and no text was a separator.") to asNew[-1]
        Move (sPad + "Procedure Add_Item Integer iMsg String sText") to asNew[-1]
        Move (sPad + "    Handle hoItem") to asNew[-1]
        Move (sPad + "    Set piAddedItems to (piAddedItems(Self) + 1)") to asNew[-1]
        Move (sPad + '    If ((iMsg = 0 or iMsg = Msg_None) and sText = "") Begin') to asNew[-1]
        Move (sPad + "        Set pbNextItemBeginsGroup to (pbItemMade(Self))") to asNew[-1]
        Move (sPad + "        Procedure_Return") to asNew[-1]
        Move (sPad + "    End") to asNew[-1]
        Move (sPad + "    Get Create (RefClass(" + sItem + ")) to hoItem") to asNew[-1]
        Move (sPad + "    Set psCaption of hoItem to sText") to asNew[-1]
        Move (sPad + "    Set piItemMessage of hoItem to iMsg") to asNew[-1]
        Move (sPad + "    Set pbControlBeginGroup of hoItem to (pbNextItemBeginsGroup(Self))") to asNew[-1]
        Move (sPad + "    Set pbNextItemBeginsGroup to False") to asNew[-1]
        Move (sPad + "    Set pbItemMade to True") to asNew[-1]
        Move (sPad + "End_Procedure") to asNew[-1]
        Move "" to asNew[-1]
        Move (sPad + "Function Item_Count Returns Integer") to asNew[-1]
        Move (sPad + "    Function_Return (piAddedItems(Self))") to asNew[-1]
        Move (sPad + "End_Function") to asNew[-1]
        Move "" to asNew[-1]
        Move (sPad + "// Where an item's message goes: to the object that has the focus, as a FloatingPopupMenu sent it.") to asNew[-1]
        Move (sPad + "// Answer another object here to send it there instead.") to asNew[-1]
        Move (sPad + "Function ItemMessageTarget Returns Handle") to asNew[-1]
        Move (sPad + "    Handle hoFocus") to asNew[-1]
        Move (sPad + "    Get Focus of Desktop to hoFocus") to asNew[-1]
        Move (sPad + "    Function_Return hoFocus") to asNew[-1]
        Move (sPad + "End_Function") to asNew[-1]
        Move asBlock[iLast] to asNew[-1]
        Move asNew to asOut
        Function_Return True
    End_Function

    /* Would the class declared at iDecl (0-based) convert? "" = yes; otherwise why not, in the words
       its Check row and the run note both use. A dry run - nothing is written. The Check asks this
       for every FloatingPopupMenu subclass line (cDeepScanner._SweepRules) and the run asks it again
       before it writes, so the row and the run can never disagree. */
    Function _CJPopupClassWhyNot String[] ByRef asCode Integer iDecl Returns String
        String[] asBlock asOut asOnly
        String  sName sWhyNot sItemLc sLow
        Integer iEnd j iLast
        Boolean bOK

        If (iDecl < 0 or iDecl >= SizeOfArray(asCode)) ;
            Function_Return "the line is outside the file"
        Get _StrVarCodeLines (&asCode) to asOnly
        Get _CJPopupClassDeclName asOnly[iDecl] to sName
        If (sName = "") ;
            Function_Return "the line does not declare a FloatingPopupMenu subclass"
        Get _CJMatchingEndClass (&asOnly) iDecl to iEnd
        If (iEnd < 0) ;
            Function_Return "the class has no End_Class"
        // The item class takes the name <Class>Item, which must be free in this file.
        Move (Lowercase(sName) + "item") to sItemLc
        Move (SizeOfArray(asCode) - 1) to iLast
        For j from 0 to iLast
            Move (Lowercase(asOnly[j])) to sLow
            If (_NthWord(Self, sLow, 1) = "class") Begin
                If (_NthWord(Self, sLow, 2) = sItemLc) ;
                    Function_Return ("this file already declares a class named " + sName + "Item, the name the menu's item class takes")
            End
        Loop
        For j from iDecl to iEnd
            Move asCode[j] to asBlock[-1]
        Loop
        Get _CJPopupClassToContextMenu (&asBlock) iDecl (&asOut) (&sWhyNot) to bOK
        Function_Return sWhyNot
    End_Function

    /* Every FloatingPopupMenu subclass in the file, converted where it stands. Returns the classes
       converted; asDone carries each one's name, asRefused "<name>|<reason>" for a class left as it
       is - left exactly as written, with no marker (see the block above). The package of
       cCJContextMenu and cCJMenuItem goes in once, with the file's other Use lines, when a class
       converted and the file does not Use it. */
    Function _CJConvertPopupClassesInFile String[] ByRef asCode String[] ByRef asDone String[] ByRef asRefused Returns Integer
        String[] asBlock asNew asAll asNeed asEmpty asOnly
        String  sName sWhyNot
        Integer i iEnd j iCount iVoid
        Boolean bOK

        Move 0 to iCount
        Move 0 to i
        Get _StrVarCodeLines (&asCode) to asOnly
        While (i < SizeOfArray(asCode))
            // Per-file progress bar: the canonical ~20-line nudge (no-op without a panel).
            If (Mod(i, 20) = 0 and (Active_State(ghoStatusPanel) = True)) Begin
                Send Update_StatusPanel of ghoStatusPanel ("Source line:" * String(i + 1) * "of:" * String(SizeOfArray(asCode)))
                Set piPosition of ghoProgressBar to (i + 1)
            End
            Get _CJPopupClassDeclName asOnly[i] to sName
            If (sName = "") Begin
                Increment i
            End
            Else Begin
                Get _CJPopupClassWhyNot (&asCode) i to sWhyNot
                If (sWhyNot <> "") Begin
                    Move (sName + "|" + sWhyNot) to asRefused[-1]
                    Increment i
                End
                Else Begin
                    Get _CJMatchingEndClass (&asOnly) i to iEnd
                    Move asEmpty to asBlock
                    Move asEmpty to asNew
                    Move asEmpty to asAll
                    For j from i to iEnd
                        Move asCode[j] to asBlock[-1]
                    Loop
                    Get _CJPopupClassToContextMenu (&asBlock) i (&asNew) (&sWhyNot) to bOK
                    // The new lines in the place of the old ones.
                    For j from 0 to (i - 1)
                        Move asCode[j] to asAll[-1]
                    Loop
                    For j from 0 to (SizeOfArray(asNew) - 1)
                        Move asNew[j] to asAll[-1]
                    Loop
                    For j from (iEnd + 1) to (SizeOfArray(asCode) - 1)
                        Move asCode[j] to asAll[-1]
                    Loop
                    Move asAll to asCode
                    Get _StrVarCodeLines (&asCode) to asOnly
                    Move sName to asDone[-1]
                    Increment iCount
                    Move (i + SizeOfArray(asNew)) to i
                End
            End
        Loop
        If (iCount > 0) Begin
            Move "cCJCommandBarSystem.pkg" to asNeed[0]
            Get _CJEnsureUses (&asCode) (&asNeed) "ConvertPopupMenuSubclassToCodeJock: cCJContextMenu and cCJMenuItem" to iVoid
        End
        Function_Return iCount
    End_Function

End_Class
