//****************************************************************************
// $Module type: Test fixture
// $Module name: oLegacyDbApiReport-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-14
//
// Description : Unit tests for the LegacyDbApiReport scan core (_LegacyDbApiScanFile, cRefactorFuncLib): a pure
//               whole-file classifier - no engine/file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oLegacyDbApiReport is a cTestFixture
        Set psFunctionName to "LegacyDbApiReport"

        // Each legacy DB-API command at command position reports the RIGHT modern note (which also
        // proves the parallel watch/hint arrays stay index-aligned); a mention inside a string and a
        // modern Get_Attribute look-alike are NOT flagged.
        {Published = True}
        Procedure LegacyDbApiReport_ScanFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    File_Size parts to num max nfields"      to asCode[0]
            Move "    ifchange pay gosub logchange"            to asCode[1]
            Move '    Move "file_size" to sLabel'              to asCode[2]
            Move "    Get_Attribute DF_FILE_CHANGED of x to b" to asCode[3]
            Move "    Get_Date_Attribute Date4_State to iX"    to asCode[4]
            Move "    Size_of_Field tRect iBottom to iLen"     to asCode[5]
            Get _LegacyDbApiScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 4 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            // the four command sites, each carrying its own modern note
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "DF_FILE_RECORDS_USED")   // File_Size
            Send Assert (sAll contains "DF_FILE_CHANGED")        // ifchange
            Send Assert (sAll contains "no-op state")            // Get_Date_Attribute
            /* Size_of_Field used to be answered with DF_FIELD_LENGTH / DF_FIELD_PRECISION, as if it
               read a database field. It does not: Dll.pkg declares it (#COMMAND SIZE_OF_FIELD R R "TO" R)
               as a legacy Type MEMBER's byte size and its own warning says "Use Structs". The note now
               says that, and the Deep Scan rule routes the row to TypeToStructReport (2026-09-15). */
            Send Assert (sAll contains "Use a Struct")            // Size_of_Field
            // the masked-string line (3) and the modern Get_Attribute line (4) are NOT flagged
            Send Assert (not(sAll contains "Line 3:"))
            Send Assert (not(sAll contains "Line 4:"))
        End_Procedure

        // A file with no legacy DB-API commands yields nothing - a modern Get_Attribute line that
        // merely NAMES the attribute must not be mistaken for the legacy command.
        {Published = True}
        Procedure LegacyDbApiReport_NoHits
            String[] asCode asReport
            Integer iN
            Move "    Move 1 to iX"                                              to asCode[0]
            Move "    Get_Attribute DF_FILE_RECORDS_USED of x.File_Number to iY" to asCode[1]
            Get _LegacyDbApiScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

        // The obsolete DB-file constants / predefined variables (Fieldindex, Filenumber,
        // DF_FILE_PRIMARY_INDEX_TRIGGER, DF_FILE_TRANSLATE_OEM_TO_ANSI) are folded in here and matched
        // ANYWHERE on the code-only line. A modern DF_FILE_NUMBER / File_Number is NOT mistaken for
        // Filenumber (the '_' boundary blocks it), and a name inside a string is masked out (_CodeOnlyLine).
        {Published = True}
        Procedure LegacyDbApiReport_AnywhereConstants
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    Move Filenumber to iFile"                                 to asCode[0]
            Move "    Set_Attribute DF_FILE_TRANSLATE_OEM_TO_ANSI of x to True" to asCode[1]
            Move "    Get_Attribute DF_FILE_NUMBER of x.File_Number to iNum"    to asCode[2]
            Move '    Move "filenumber" to sLabel'                              to asCode[3]
            Move "    Set_Attribute DF_FILE_PRIMARY_INDEX_TRIGGER of h to (False)"  to asCode[4]
            Get _LegacyDbApiScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 3 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "DF_FILE_NUMBER attribute")        // bare Filenumber variable
            Send Assert (sAll contains "Line 2:")
            Send Assert (sAll contains "DF_FILE_TABLE_CHARACTER_FORMAT")  // DF_FILE_TRANSLATE_OEM_TO_ANSI arg
            /* The trigger attribute is the one that LOOKS like a rename and is not: it is a Boolean,
               its replacement takes RIM_NONE / RIM_IDENTITY_COLUMN / RIM_DISPENSER_TABLE / RIM_EXTERNAL,
               and True meant a trigger fills the column - RIM_EXTERNAL, not the 1 a swap would leave. The
               note has to carry that, which is why this row stays Review rather than Auto-fix. */
            Send Assert (sAll contains "Line 5:")
            Send Assert (sAll contains "RIM_EXTERNAL")
            // the modern DF_FILE_NUMBER / File_Number line (3) and the masked-string 'filenumber' (4)
            // are NOT flagged
            Send Assert (not(sAll contains "Line 3:"))
            Send Assert (not(sAll contains "Line 4:"))
        End_Procedure

    End_Object
