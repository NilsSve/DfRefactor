        Object oStatusBar is a cCJStatusBar
            Set Statusbar_Id to Self

            // PANE 1 = the ACTIVE VIEW's name. phoViewPane is the pane the framework writes the
            // current view's label into ("Check workspace"), and it used to be pane 2 - the same
            // pane StatusText uses - so activating a view after an analyze WIPED its "Total XXs"
            // result (Nils 2026-07-26). The two are different kinds of message: the view name is
            // WHERE YOU ARE (pane 1, alongside the idle text), a run's result is WHAT HAPPENED
            // (pane 2). ActionText below now names pane 2 explicitly rather than following
            // phoViewPane, so it stays with StatusText where it belongs.
            Object oStatusPane1 is a cCJStatusBarPane
                Set piID to sbpIDIdlePane
                Set phoViewPane to Self
                Set pbStyleStretch to True
            End_Object

            Object oStatusPane2 is a cCJStatusBarPane
                Set pbStyleStretch to True
            End_Object

            // Made these objects mimic NotePad++
            Object oNumberOfCharacters_StatusbarPane is a cCJStatusBarPane
                Set psText to "length:"
            End_Object

            Object oNumberOfLines_StatusbarPane is a cCJStatusBarPane
                Set psText to "lines:"
            End_Object

            Object oUTF8_OEM_Text is a cCJStatusBarPane
                Set psText to "OEM"
            End_Object

            Procedure Set NumberOfEditorLines String sText
                Move (FormatValue(sText, ",###")) to sText
                Set psText of oNumberOfLines_StatusbarPane to ("lines:" * String(sText))
            End_Procedure

            Procedure Set NumberOfEditorCharacters String sText
                Move (FormatValue(sText, ",###")) to sText
                Set psText of oNumberOfCharacters_StatusbarPane to ("length:" * String(sText))
            End_Procedure

            Procedure Set StatusText String sText
                Set psText of oStatusPane2 to sText
            End_Procedure                          
            
            // Named pane, NOT phoViewPane: that now points at pane 1 (the view name), and an
            // action message belongs beside StatusText in pane 2 (see the pane comment above).
            Procedure Set ActionText String sText
                Set psText of oStatusPane2 to sText
            End_Procedure

            /* The framework's view-name write, pinned to pane 1 EXPLICITLY.
               Dfadlg.pkg's Entering_Scope sends Show_View_Name (Label(Self)) to Statusbar_Id, and the
               stock handler writes it to whatever phoViewPane happens to point at - which is resolved
               by delegation up the object tree and is therefore easy to get wrong from a pane object.
               Naming the pane here settles it: the view name lands in pane 1 whatever phoViewPane says,
               so it can never again overwrite the analyze result in pane 2 (Nils 2026-07-26). */
            Procedure Show_View_Name String sName
                Set psText of oStatusPane1 to sName
            End_Procedure

            Procedure Set UTF8Text String sText
                Set psText of (oUTF8_OEM_Text(Self)) to sText
            End_Procedure
            
        End_Object

    End_Object

    Object oClientArea is a ClientArea
        Use oMainRefactorObjects.pkg
        /* In oMainRefactorObjects, the two main refactoring objects are created;
            Object oRefactorEngine is a cRefactorEngine
                Set pbBatchMode to (pbBatchMode(ghoApplication))
                #Include oRefactorFuncLib.pkg
            End_Object

           cRefactorFuncLib -> ghoFuncLib and,
           cRefactorEngine  -> ghoEngine.
            
           Always use at top of ClientArea.
        */
        
        // *** Other program files: ***
//        Use Dd_debug.dg
        Use ProgramSetupFT.dg
        Use CompilerSetupFT.dg
        Use ScintillaParameters.dg
        Use DropSelfConfirmFT.dg         // FT: Drop Self's question with FT buttons - BEFORE EditorViewFT.vw, whose editor packages then leave DropSelfConfirm.dg out
        Use ScintillaGotoFT.dg           // FT: the editor's Go To Line with FT buttons - BEFORE EditorViewFT.vw, as the line above
        Use ScintillaFindFT.dg           // FT: the editor's Find with FT buttons - BEFORE EditorViewFT.vw, as the lines above
        Use ScintillaReplaceFT.dg        // FT: the editor's Replace with FT buttons - BEFORE EditorViewFT.vw, as the lines above
        Use GotoDefinitionPickerFT.dg    // FT: the editor's Go to definition chooser with FT buttons - BEFORE EditorViewFT.vw, as the lines above
        Use EngineErrorLogFT.dg
        Use BackupFilesFT.dg
        Use RetireShadowsFT.dg           // the per-file Rename dialog behind the board's overriding-copies line (ChooseShadowCopiesToRetire)
        Use EngineLogFileFT.dg
        Use ModProgressHistoryFT.dg      // FT: phase-2 burn-down history modal (opened from the dashboard progress strip)
        Use ShowOtherLogFilesFT.dg
        Use CmdLineIniFileExporterFT.dg
        Use DeepScanRulesFT.dg           // FT: per-rule enable UI for the Deep Scan catalog (Data\DeepScanRules.json)

        // FT: the merged bottom dock - ONE cRefactorCJToolPanel hosting the Compiler Output + Modernization
        // Analyzer areas as bottom tabs. OutputDockFT.dg Uses CompilerOutputFT.dg + ModAnalyzerFT.dg as
        // Container3d AREAS inside its panel, and carries all their global entry procs
        // (ActivateCompileErrorDialog / ActivateModAnalyzer / ShowCompileOutputLive / ...). MUST precede
        // RefactorView.vw (TestCompileFT.dg) + the toolbar buttons that Send those globals.
        Use OutputDockFT.dg
        Use EditorViewFT.vw
        Use ConvertWorkspaceFT.dg  // the .sws INI -> DF26 JSON conversion, with df-cli's output live
        Use AddPackageFT.dg        // the one field: a path, publisher/package, or a git url
        Use MaintainLibrariesFT.dg // THE Libraries dialog: the list, its verdicts, and Add / Remove
        Use SelectCopyScopeFT.dg   // migration step 0 - what to copy to the new location
        Use SelectFoldersViewFT.vw
        Use SelectFunctionsFT.vw
        Use DashboardFT.vw         // THE dashboard: the guided flow (this file was CheckWorkspaceFT.vw until 2026-08-10)
        Use ManualDashboardFT.vw   // the manual flow on its own board
        Use StartCenterFT.vw       // the pre-workspace screen: workspaces, Getting Started, and the Guided|Manual door

        Use AboutFT.pkg            // the About text as the DFAbout library's resource, then the library's FTStdAbout.pkg:
                                   // Activate_About and DoAbout, as StdAbout.pkg (the About dialog is the library's
                                   // cFTAboutDialog since 2026-10-08; a page of this program's own from 2026-10-06)
        Procedure Activate_About
            // True, show the Help\AboutFT.html file in the dialog.
            Set pbShowAboutFile of ghoFTAboutDialog to True // False
            Send DoAbout "" "" "" "" "DFRefactor72x72.bmp"
        End_Procedure

        Function Verify_Exit_Application Returns Integer
            Integer iFail iRetval
            Boolean bChanged

            Move 0 to iFail
            Broadcast Recursive Get pbShouldSave to bChanged
            If (bChanged = True) Begin
                Get YesNoCancel_Box "Changes exists! Do you want to save changes?" "" MB_DEFBUTTON3 to iRetval
                If (iRetval = MBR_Yes) Begin
                    Send Execute of (oSave_ToolItem(ghoCommandBars))
                    Move 0 to iFail
                End
                If (iRetval = MBR_No) Begin
                    Move 0 to iFail
                End
                If (iRetval = MBR_Cancel) Begin
                    Move 1 to iFail
                End
            End
            Function_Return iFail
        End_Function

    End_Object

