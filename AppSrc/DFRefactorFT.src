        Object oMainToolBar is a cCJToolbar
            Set psTitle to "Main Toolbar"
            Set peStretched to stStretchShared
            Set pbCloseable to False
            Set pbCustomizable to False

            /* The Start Center - the screen before a workspace is open, and the startup view (see
               oMain.Add_Focus). The boards' workspace crumbs are the other way back, so this item
               is a convenience rather than the only route - which matters, because a NEW toolbar
               item is dropped from the SAVED CodeJock layout and may not appear until the layout
               is reset. Losing a convenience to that is survivable; losing the only route would
               not be. */
            Object oStartCenter_MenuItem is a cCJMenuItem
                Set psToolTip to "Start Center - open a workspace, or pick the guided or manual flow"
                Set psDescription to "Open the Start Center"
                Set psImage to "StartCenter.ico"
                Set pbActiveUpdate to True
                Set peControlStyle to xtpButtonIconAndCaption
                Set psCaption to "Start Center"

                Procedure OnExecute Variant vCommandBarControl
                    Send Activate_oStartCenter_vw of (Client_Id(ghoCommandBars))
                End_Procedure
            End_Object

            /* THE dashboard since 2026-08-10. It was the "Dashboard (WIP)" trail built on the
               guided-flow-redesign branch, shown alongside the old split board so the two could be
               compared; Nils's call is that this one wins, so the view file is now DashboardFT.vw
               and the old split board is retired below. */
            /* ITS OWN PICTURE since 2026-10-04 - the sparkles, the Start Center's Guided refactor lane glyph
               (Nils: "I think that is what we should use for the Guided Dashboard"). The two dashboards shared
               the gauge, which could not be told apart once the toolbar text is hidden; the button, the lane
               and the view's tab now show the one picture. */
            Object oDashboard_MenuItem is a cCJMenuItem
                Set psToolTip to "Guided Dashboard - the guided flow, one step at a time"
                Set psDescription to "Open the guided dashboard"
                Set psImage to "GuidedDashboard.ico"
                Set pbActiveUpdate to True
                Set peControlStyle to xtpButtonIconAndCaption
                // Same text as the view's Label, so the button and the tab it opens agree.
                Set psCaption to "Guided Dashboard"

                Procedure OnExecute Variant vCommandBarControl
                    Send Activate_oDashboard_vw of (Client_Id(ghoCommandBars))
                End_Procedure
            End_Object

            /* The manual flow on its own board (Nils 2026-08-02). It outlived the split Dashboard it
               was trialled against: with that board retired, these two - Guided and Manual - are the
               dashboards. */
            // Its own picture since 2026-10-04: Nils's open hand (Manual.ico), which the Start Center's Manual
            // refactor lane shows too (CS_GlyphManual) - the gauge it shared with the Guided Dashboard is gone.
            Object oManualDash_MenuItem is a cCJMenuItem
                Set psToolTip to "Manual Dashboard - pick folders and functions yourself"
                Set psDescription to "Open the manual-flow board"
                Set psImage to "Manual.ico"
                Set pbActiveUpdate to True
                Set peControlStyle to xtpButtonIconAndCaption
                Set psCaption to "Manual Dashboard"

                Procedure OnExecute Variant vCommandBarControl
                    Send Activate_oManualDashboard_vw of (Client_Id(ghoCommandBars))
                End_Procedure
            End_Object

            // The editor, beside the boards (Nils 2026-09-23) - the view's own icon, so the button
            // and the tab it opens read as one thing.
            Object oEditor_MenuItem is a cCJMenuItem
                Set psToolTip to "Editor - the source file you are working on"
                Set psDescription to "Open the editor view"
                Set psImage to "Editor.ico"
                Set pbActiveUpdate to True
                Set peControlStyle to xtpButtonIconAndCaption
                Set psCaption to "Editor"

                Procedure OnExecute Variant vCommandBarControl
                    Send Activate_oEditorView_vw of (Client_Id(ghoCommandBars))
                End_Procedure
            End_Object

            /* RETIRED 2026-08-10 - the old split "cockpit" board's toolbar button. The guided board
               above is the Dashboard now, so this was the last way in to DashboardFTOLD.vw, which is
               no longer Used (see the Use block further down).

               Remarked rather than deleted. The view file itself was deleted on 2026-09-23 - it is in
               git history (e.g. git show b870d411:AppSrc/DashboardFTOLD.vw). Note the send
               below would NOT reach it any more even if re-enabled: Activate_oDashboard_vw now
               resolves to the guided board, which took that object name with it.

            Object oDashBoardOLD_MenuItem is a cCJMenuItem
                Set psToolTip to "Dashboard"
                Set psDescription to "Open Dashboard"
                Set psImage to "Dashboard.ico"
                Set pbActiveUpdate to True
                Set pbControlBeginGroup to True
                Set peControlStyle to xtpButtonIconAndCaption

                Procedure OnExecute Variant vCommandBarControl
                    Send Activate_oDashboard_vw of (Client_Id(ghoCommandBars))
                End_Procedure

            End_Object
            */

            Object oShowCompilePane_MenuItem is a cCJMenuItem
                Set psCaption to "Show Compile pane"
                Set psToolTip to "Compile pane"
                Set psDescription to "Show or hide the Compile pane"
                Set psImage to "CompilePane.ico"
                Set pbActiveUpdate to True
                Set pbControlBeginGroup to True
                Set peControlStyle to xtpButtonIconAndCaption
                Set pbChecked to False

                // Toggle the Modernize dock: show it (switching to its home editor view first, since the
                // toolbar can be clicked from any view) when hidden, hide it when shown. The hide branch
                // mirrors the editor's Ctrl+M toggle exactly (clear the user-wants flag so it won't
                // auto-restore, then close the dock).
                Procedure OnExecute Variant vCommandBarControl
                    Boolean bWanted
                    Get pbModernizePanelWanted of ghoApplication to bWanted
                    If (bWanted) Begin
                        Set pbModernizePanelWanted of ghoApplication to False
                        Send CloseTestCompileDialog of (Client_Id(ghoCommandBars))
                    End
                    Else Begin
                        Send Activate_oEditorView_vw of (Client_Id(ghoCommandBars))
                        Send ShowTestCompileDockOnly of (Client_Id(ghoCommandBars))
                    End
                End_Procedure

                // IsEnabled is polled by pbActiveUpdate, so we ALSO reflect the dock state here from the
                // single-source pbModernizePanelWanted flag (flipped by EVERY show/hide path - this toolbar,
                // the editor's Ctrl+M / web toggle, and the dock's own Close). Pressed + "Hide Compile
                // pane" when shown; released + "Show Compile pane" when hidden. Both are set only on a
                // change, so there's no per-poll churn.
                Function IsEnabled Returns Boolean
                    String sSWSFile sWantCap sCurCap
                    Boolean bWanted bChecked

                    Get pbModernizePanelWanted of ghoApplication to bWanted
                    Get pbChecked to bChecked
                    If (bChecked <> bWanted) ;
                        Set pbChecked to bWanted
                    If (bWanted) ;
                        Move "Hide Compile pane" to sWantCap
                    Else ;
                        Move "Show Compile pane" to sWantCap
                    Get psCaption to sCurCap
                    If (sCurCap <> sWantCap) ;
                        Set psCaption to sWantCap
                    Get psSWSFile of ghoApplication to sSWSFile
                    Function_Return (sSWSFile <> "")
                End_Function

            End_Object



            Object oSplitView_MenuItem is a cCJMenuItem
                Set psCaption to "Split View"
                Set psToolTip to "Split / Un-split View Workspace"
                Set psDescription to "Toggle a side-by-side split: Dashboard left, the other views right. Click again to merge back into one group."
                Set psImage to "SplitVertical.ico"
                Set pbChecked to False
                Set pbActiveUpdate to True
                Set peControlStyle to xtpButtonIconAndCaption

                Procedure OnExecute Variant vCommandBarControl
                    Send SplitViewWorkspace of (phoMainPanel(ghoApplication))
                End_Procedure

                Function IsEnabled Returns Boolean
                    String sSWSFile
                    Get psSWSFile of ghoApplication to sSWSFile
                    Function_Return (sSWSFile <> "")
                End_Function

            End_Object

            Object oClear_MenuItem is a cCJMenuItem
                Set pbControlBeginGroup to True
                Set pbActiveUpdate to True
                Set psCaption to "Clear"
                Set psToolTip to "Clear/Close Workspace/File"
                Set psDescription to "Clears the currently selected workspace/or File depending on the selected mode"
                Set psImage to "ActionClear.ico"
                Set peControlStyle to xtpButtonIconAndCaption

                Procedure OnExecute Variant vCommandBarControl
                    Boolean bChanged bMode
                    Integer iRetval
                    Handle hoEditor

                    Send UpdateWorkspaceSelectorDisplay of ghoApplication ""
                    Get phoEditor of ghoApplication to hoEditor
                    Send Request_Clear of hoEditor
                    Set pbWorkspaceMode of ghoApplication to True
                    Broadcast Recursive Send Request_Clear of (Client_Id(ghoCommandBars))
                    /* THE START CENTER, not a board (Nils 2026-08-08). Clear closes the workspace -
                       it has just set psSWSFile to "" - and a board with no workspace open is the
                       empty screen the Start Center exists to replace: every band short-circuits
                       and the guidance names buttons that are not there. This is precisely the
                       state the Start Center is for, so it is where Clear should land. */
                    Send Activate_oStartCenter_vw of (Client_Id(ghoCommandBars))
                End_Procedure

                Function IsEnabled Returns Boolean
                    String sSWSFile
                    Get psSWSFile of ghoApplication to sSWSFile
                    Function_Return (sSWSFile <> "")
                End_Function

            End_Object

            Object oSave_ToolItem is a cCJSaveMenuItem
                Set peControlStyle to xtpButtonIcon
                Set psCaption to "&Save"
                Set psToolTip to "Save"
                Set psDescription to "Save editor changes (Alt+S)"
                Set psShortcut to "Alt+S"

                Function IsEnabled Returns Boolean
                    Boolean bChanged

                    Move False to bChanged
//                    If (oSysfile_DD(phoRefactorView(ghoApplication))) Begin
//                        Get Should_Save of (oSysfile_DD(phoRefactorView(ghoApplication))) to bChanged
//                    End
                    If (oSysfile_DD(phoFoldersView(ghoApplication))) Begin
                        Get Should_Save of (oSysfile_DD(phoFoldersView(ghoApplication))) to bChanged
                    End
                    If (bChanged = False) Begin
                        Get pbShouldSave of (phoEditorView(ghoApplication)) to bChanged
                    End
                    If (bChanged = False) Begin
//                        Get pbShouldSave of (phoFunctionView(ghoApplication)) to bChanged
//                        Get pbShouldSave of (phoRefactorView(ghoApplication)) to bChanged
                    End
                    Function_Return bChanged
                End_Function

