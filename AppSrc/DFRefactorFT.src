Use FTThemeSeed.pkg   // SeedFTTheme (DFRefactor's own) - oApplication's End_Construct_Object sends it

Object oApplication is a cRefactorApplication
    Set psProduct to "DFRefactor"
    Set psCompany to "RDC Tools International"
    Set peHelpType to htHtmlHelp
    Set psHelpFile to "DFRefactor.chm"

    Property String psCmdLineIniFile ""  
    /* THE CI SCAN (/scan <ini> [/baseline], 2026-11-20 - cCIScan.pkg, RunCIScanAndExit): the switches, and what
       ReadScanIniFile read from the INI. psScanError keeps a fault for the run to report with exit code 2. */
    Property Boolean  pbScanMode False
    Property Boolean  pbScanBaseline False
    Property String   psScanIniFile ""
    Property String[] pasScanFolders
    Property String   psScanFilter ""
    Property String   psScanBaselineFile ""
    Property String   psScanJsonFile ""
    Property String   psScanSarifFile ""
    Property String   psScanError ""
    Property Handle phoTestCompileFT
    // FT: does the user want the Modernize dock (Test Compile + Compiler Output + ModAnalyzer) shown while on
    // the Refactoring Editor view? Set True by every show path (ShowTestCompileDockOnly); set False ONLY by an
    // explicit user close (Close button / Esc / the editor toggle) - never by the view-switch auto-hide. The
    // editor view's Activate restores the dock when this is True; the editor's toggle button + Ctrl+M flip it.
    Property Boolean pbModernizePanelWanted False

//    Procedure OnWorkspaceOpened
//        String sProduct
//        Integer iRetval
//        
//        Forward Send OnWorkspaceOpened  
//        /* Check that the 'correct' collating.cfg is used when the program is
//           started. The data in the database was entered with an english (standard)
//           collating sequence. If another df_collate.cfg is encountered at runtime,
//           all data tables will automatically be reindexed, prior to running the program.
//           Note: We cannot use the event OnCreate for this, because the psDataPath
//           et. al. is set after that event.
//        */
//        Open Functions
//        Send CheckCollatingSequence of ghoDatabaseFunctions File_Field Functions.Function_Name
//    End_Procedure

    Procedure OnFileNameUpdate String sFileName
        Set psCurrentSourceFileName to sFileName
    End_Procedure

    Procedure SelectSourceFile
        Boolean bOpen bReadOnly bExists
        String  sFileName sHomePath sAppSrcPath sInitialFolder
        Handle ho

        Move (phoOpenSourceFileDialog(Self)) to ho
        Get Initial_Folder of ho to sInitialFolder
        If (sInitialFolder = "") Begin
            Get psHomeTarget to sHomePath
            // If an "AppSrc" folder exists we want to display those source files.
            Move (vFolderFormat(sHomePath)) to sAppSrcPath
            Move (sAppSrcPath + "AppSrc") to sAppSrcPath
            Move (vFolderExists(sAppSrcPath)) to bExists
            If (bExists = True) Begin
                Move sAppSrcPath to sHomePath
            End

            Set Initial_Folder of ho to sHomePath
        End
        Get Show_Dialog of ho to bOpen
        If (bOpen = True) Begin
            Get File_Name of ho to sFileName
            // Check if user is opening file as read_only
            Get TickReadOnly_State of ho to bReadOnly
            If (bReadOnly = True) Begin
                Send FTInfoBox ("Files should not be opened as ReadOnly.") "Warning!"
            End
            Else Begin
                Set pbWorkspaceMode to False
                Send OnFileNameUpdate sFileName
                Send LoadFile of (phoEditor(Self)) sFileName
                Send Activate_oEditorView_vw of (Client_Id(phoMainPanel(Self)))
            End
        End
    End_Procedure     
    
    /* THE ICON SET FOLLOWS THE THEME. The DK icons are drawn for a dark ground and vanish on a
       light one (Nils 2026-08-13). They used to be bound by an [Icons] remap in DFRefactorFT.cfg -
       name = DK\name - which the compiler EMBEDS, so it could not vary at runtime; that list has
       been removed, and the icons now load from the bitmap path instead.

       THREE FOLDERS in the dark theme (2026-11-14): this program's own Bitmaps\DK, then
       Bitmaps\RDCFlexTron\Dk - the dark icons RDCFlexTron 0.9.31 and later installs into every workspace
       that uses it (Save outlined blue, Delete Record red, the common toolbar and menu icons; the 28
       identical copies Bitmaps\DK had are gone) - then Bitmaps, so an icon with no dark version shows
       its light one. The library's FTSeedThemeIcons builds the same list after the workspace opens; it
       is not used here because Programs\Config.ws's BitmapPath is switched by hand per build, and the
       list below must not depend on it.

       A LIST, not a swap, and that is the whole point: the two folders are not parallel sets.
       113 names exist in both, but 117 live only in Bitmaps and 72 only in Bitmaps\DK. Pointing
       dark at Bitmaps\DK alone would lose the 117. Dark therefore prefers DK and falls back to
       Bitmaps for everything DK does not carry; light just uses Bitmaps.

       Here rather than earlier because the workspace object is what owns psBitmapPath, and it
       only exists once a workspace is open. Anything whose icon was already loaded keeps it -
       if a toolbar comes up with the wrong set, that is the reason, and the fix is a reload
       rather than an earlier Set (there is no earlier - the property has no owner yet). */
    Procedure OnCreate
        Integer iMode
        Get ReadInteger CS_FTThemeSection CS_FTTheme CI_FTThemeDark to iMode
        If (iMode = CI_FTThemeLight) ;
            Set psBitmapPath of (phoWorkspace(Self)) to "Bitmaps"
        Else ;
            Set psBitmapPath of (phoWorkspace(Self)) to "Bitmaps\DK;Bitmaps\RDCFlexTron\Dk;Bitmaps"
    End_Procedure

    /* THE FT THEME, read as soon as this object is built: its psCompany and psProduct - the registry key -
       are set by then, and it is well before line ~1350, where the FT dialogs are Used; they colour
       themselves as they are built. Not a line earlier: the setting is read through ghoApplication, which
       is assigned when this object is BUILT (2026-08-13: sent before it, SeedFTTheme took its guard and did
       nothing at all, silently). The library's cFTApplication does the same for its programs; this object
       is a cRefactorApplication, shared with the light builds, so it sends DFRefactor's own SeedFTTheme
       (FTThemeSeed.pkg). */
    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        Send SeedFTTheme
        Send SeedFTAppGlyphs    // DFRefactor's own glyphs, AppHtml\FTGlyphs - from pOrgWS (FTThemeSeed.pkg)
    End_Procedure

    /* Command Line Interface:
       "/h" "/help" or "/?" - Show command line parameters help
    
      Enables the ability to pass, on the command line;
      - The path and name of a *.sws file
      - And path to a source -folder or -filename
      
      Command line samples:
      /sws "C:\DataFlex 24.0 Examples\Order Entry\Order Entry.sws" /d AppSrc;AppHtml;DDSrc
      /c "C:\DataFlex 24.0 Examples\DFRefactorCmdLineOE.ini"
      
      This command line sample would tell the DFRefactor program to run automatically, 
      applying all previously selected refactoring functions and apply them to all source
      files for the AppSrc, AppHtml and DDSrc folders, that matches the file extensions previously
      setup in the DFRefactor program. Then exit the program when done.   
      Note: The program's UI will be visible while the program runs. However, no UI
            interaction is needed while it is run. All actions as well as possible errors,
            will be automatically registered, but not shown on screen.
    */
    Procedure OnWorkspaceOpened
        Handle hoCmdLine
        String sSourceFile sSWSFile sChar sArgument sParamText sFolders sPath sCmdLineIniFile sProduct sScanIniFile
        Integer iWin10BetaSetting iNumArgs iCount iMode iRetval
        Boolean bShowParamHelp bDebugMode bBatch bConfigFile bScan bScanBaseline
        String[] asFolders
        
        Forward Send OnWorkspaceOpened  
        // Test for serious Windows 10 "bug": "https://support.dataaccess.com/Forums/showthread.php?64797-Recent-Microsoft-Changes-to-Windows-10-May-Impact-Functionality-and-or-Data-Integrity"
        Move (GetACP()) to iWin10BetaSetting
        If (iWin10BetaSetting = 65001) Begin
            Send FTInfoBox ("Windows 10 ouch! This workstation has its BETA option set to TRUE. This means that the normal codepage that DataFlex relies on does not work. This also means that some refactoring functions will fail. Program will now exit!")
            Send vShellExecute "Open" "https://support.dataaccess.com/Forums/showthread.php?64797-Recent-Microsoft-Changes-to-Windows-10-May-Impact-Functionality-and-or-Data-Integrity" "" ""
            Send Exit_Application
        End

        /* Check that the 'correct' collating.cfg is used when the program is
           started. The data in the database was entered with an english (standard)
           collating sequence. If another df_collate.cfg is encountered at runtime,
           all data tables will automatically be reindexed, prior to running the program.
           Note: We cannot use the event OnCreate for this, because the psDataPath
           et. al. is set after that event.
        */
        Open Functions
        Send CheckCollatingSequence of ghoDatabaseFunctions File_Field Functions.Function_Name

        Get phoCommandLine to hoCmdLine
        Get CountOfArgs of hoCmdLine to iNumArgs

        For iCount from 1 to iNumArgs
            Get Argument of hoCmdLine iCount to sArgument   
            Move (Left(sArgument, 1)) to sChar
            If (sChar = "-") Begin
                Move (Replace("-", sArgument, "/")) to sArgument
            End
            Move (Lowercase(sArgument)) to sArgument

            Case Begin
                Case (sArgument = CS_CmdLineDebug)
                    Move True to bDebugMode
                    Case Break

                Case (sArgument = CS_CmdLineHelp1 or sArgument = CS_CmdLineHelp2 or sArgument = CS_CmdLineHelp3 or sArgument = CS_CmdLineHelp4)
                    Move True to bShowParamHelp
                    Case Break

                Case (sArgument = CS_CmdLineSWSFile)
                    Get Argument of hoCmdLine (iCount + 1) to sSWSFile
                    Move (Trim(sSWSFile)) to sSWSFile
                    Case Break
                                    
                Case (sArgument = CS_CmdLineFileName1 or sArgument = CS_CmdLineFileName2)
                    Get Argument of hoCmdLine (iCount + 1) to sSourceFile
                    Case Break
                
                Case (sArgument = CS_CmdLineFolders1 or sArgument = CS_CmdLineFolders2 or sArgument = CS_CmdLineFolders3)
                    Get Argument of hoCmdLine (iCount + 1) to sFolders
                    Case Break

                Case (sArgument = CS_CmdLineBatch1 or sArgument = CS_CmdLineBatch2)
                    Move True to bBatch
                    Case Break
                
                /* /bm is THE documented switch now; /c, -c and --console still work but are no
                   longer advertised (Nils 2026-08-03: two flags that both meant batch mode was
                   the confusion). Keeping them costs one line and breaks nobody's script - and
                   it also revives every Run-...ps1 generated before today, which emitted /bm
                   against a parser that did not accept it. */
                Case (sArgument = CS_BatchModeShort or sArgument = CS_BatchModeLong or ;
                      sArgument = CS_CmdConfigFile1 or sArgument = CS_CmdConfigFile2 or sArgument = CS_CmdConfigFile3)
                    Get Argument of hoCmdLine (iCount +1) to sCmdLineIniFile
                    Get ParseFolderName sCmdLineIniFile to sPath
                    If (sPath = "") Begin
                        Get psProgramPath of (phoWorkspace(ghoApplication)) to sPath
                        Move (vFolderFormat(sPath)) to sPath
                        Move (sPath + sCmdLineIniFile) to sCmdLineIniFile
                    End
                    Set psCmdLineIniFile to sCmdLineIniFile
                    Move True to bConfigFile
                    Move True to bBatch
                    Case Break

                /* THE CI SCAN (2026-11-20): Analyze Source for a build, read-only - see cCIScan.pkg. Its INI is
                   found the way /bm finds its own. */
                Case (sArgument = CS_CmdLineScan)
                    Get Argument of hoCmdLine (iCount + 1) to sScanIniFile
                    Get ParseFolderName sScanIniFile to sPath
                    If (sPath = "") Begin
                        Get psProgramPath of (phoWorkspace(ghoApplication)) to sPath
                        Move (vFolderFormat(sPath)) to sPath
                        Move (sPath + sScanIniFile) to sScanIniFile
                    End
                    Move True to bScan
                    Case Break

                Case (sArgument = CS_CmdLineScanBaseline)
                    Move True to bScanBaseline
                    Case Break
            Case End
        Loop
        
        If (bShowParamHelp = True) Begin
            Move "" to sParamText
            Append sParamText "PARAMETER SYNTAX:"
            Append sParamText "\n=============="

            Append sParamText "\n\n/h or /help or /? - Displays *this* help text. Then exits the program."
            Append sParamText "\n\n/debug - displays all passed parameters. Then exits the program."
            Append sParamText " The /h takes precedence over the /debug flag."
            Append sParamText "\nIf the /batch flag is omitted, the program will wait for the user to start the process."
            Append sParamText "\n\nNote: Parameters and its value(s) must all be passed as a pair separated by a SPACE, when applicable."
            Append sParamText "\nParameters can be passed in any order."
            Append sParamText "\n\nPaths should be surrounded by single- or double-quotes('""')"
            Append sParamText "\nOnly parameters that are necessary needs to be passed."
            Append sParamText "\nUppercase/Lowercase doesn't matter when spelling flags."
            Append sParamText "\nEach flag must be preceeded by a '/' (forward slash) or a '-' (dash) character."
                              
            Append sParamText "\n\nFLAGS AND SAMPLE USAGE:"
            Append sParamText "\n========================"

            Append sParamText "\n *.sws workspace file:"
            Append sParamText '\n/sws "C:\Projects\DF20\My_Folder\MySWSFile.sws"'
            Append sParamText "\nMandatory, unless /bm supplies an ini-file that names the workspace."
            
            Append sParamText "\n\nSingle Source File:"
            Append sParamText "\n/f or /file - A single file name with full path."
            Append sParamText '\n/f "C:\Projects\DF20\My_Folder\AppSrc\MySourceFile.vw"' 
            Append sParamText "A Single Source File takes precedence over a *.sws workspace file."
            
            Append sParamText "\n\nFolder Names Selections:"
            Append sParamText "\n/d or /dirs or /folders - followed by a semi-comma separated list with folder names to be selected."
            Append sParamText "\nThe semi-comma separated list with folders will be added to those previously saved for the workspace."
            Append sParamText "\n/d AppSrc;DDSrc;AppHtml;Libraries (only together with the /sws param)"

            Append sParamText "\n\nBATCH MODE - start and run a refactoring with no user interaction."
            Append sParamText "\nThe program's UI is shown while it runs, but nothing is asked of the user."

            Append sParamText "\n\n/bm <ini file> - run the settings held in an ini-file. This is the usual way."
            Append sParamText "\n/bm " CS_CmdIniFileName
            Append sParamText "\nA bare file name is looked for in the program's Programs folder; otherwise pass a full path."
            Append sParamText "\nAn ini-file already names the workspace, folders, filters and functions, so /sws is not needed with it."
            Append sParamText "\nThe run writes STATUS=SUCCESS or STATUS=FAILED to the result file the ini-file names,"
            Append sParamText "\nand exits with code 0 on success, 1 on failure - so a build can check either."

            Append sParamText "\n\n/b or /batch - run the settings already stored for the workspace, with no ini-file."
            Append sParamText "\nIf neither flag is given, the program starts, shows the parameters it was passed, and waits."

            Append sParamText "\n\nCI SCAN - Analyze Source for a build. It reads the source and changes nothing."
            Append sParamText "\n/scan <ini file> - the ini-file /bm takes: the workspace, folders, file filter and result file."
            Append sParamText "\nThe findings go to <ini>.findings.json and <ini>.findings.sarif (SARIF 2.1.0, which GitHub shows on a pull request)."
            Append sParamText "\nExit code 0 = no new findings, 1 = findings the baseline does not have, 2 = the scan could not run."
            Append sParamText "\n/scan <ini file> /baseline - accepts today's findings: writes <ini>.baseline.json, exit code 0."
            Append sParamText "\nThe ini-file's [Scan Section] can name the three files: Baseline File, Json File and Sarif File."

            Append sParamText "\n\nTop Tip: the main toolbar's Export dialog writes an ini-file for the current workspace,"
            Append sParamText "\ntogether with a ready-to-run <ini name>_RUN.ps1 beside it - no need to write one from scratch."
            Append sParamText "\nFor /scan it writes <ini name>_SCAN.ps1 too (-Baseline, and -WorkspaceRoot for a build server's checkout),"
            Append sParamText "\nand <ini name>_CI-SAMPLE.yml, a starter GitHub Actions workflow: build, DFUnit tests, the scan, SARIF upload."

            Send FTInfoBox sParamText
            Abort 
        End 
        
        If (bDebugMode = True) Begin
            Move "Parameters passed on the command line:" to sParamText
            Append sParamText "\n\nDebug mode:"
            Append sParamText "\n/debug = TRUE"

            Append sParamText "\n\n *.sws param and file:"
            If (sSWSFile <> "") Begin
                Append sParamText "\n/sws " sSWSFile
            End
            Else Begin
                Append sParamText "\n/sws " "None specified"
            End
                    
            Append sParamText "\n\nSingle Source File:"
            If (sSourceFile <> "") Begin
                Append sParamText "\n/f " sSourceFile
            End
            Else Begin
                Append sParamText "\n/f " "None specified"
            End
            
            Append sParamText "\n\n Folder Names:"
            If (sFolders <> "") Begin
                Append sParamText "\n/f " sFolders
            End
            Else Begin
                Append sParamText "\n/f " "None specified"
            End
                
            Append sParamText "\n\nBatch mode:"
            Append sParamText "\n/batch = " (If(bBatch = True, "TRUE", "FALSE"))
            Append sParamText "\nIf omitted, program will start, display the passed parameters, but *will not* start automatically."
            
            Append sParamText "\n\nIni-file:"
            If (sCmdLineIniFile <> "") Begin
                Append sParamText "\n" sCmdLineIniFile
                Append sParamText "\n/batch = TRUE"
            End
            Else Begin
                Append sParamText "\n" "None specified"
            End
                    
            Send FTInfoBox sParamText
            Abort 
        End

        // We need to send messages in this order:
        If (sSWSFile <> "") Begin
            If (bConfigFile = False) Begin
                Set pbWorkspaceMode to True
                Send UpdateWorkspaceSelectorDisplay sSWSFile
            End
            Else Begin
                /* /sws TOGETHER WITH /bm IS LEGAL - it names the workspace the INI does not.
                   This used to Abort with "You need to specify an .sws file on the command line!",
                   which is the opposite of what had just happened: we are inside If (sSWSFile <> "")
                   and the user HAD passed one. The feature was built and then walled off - the INI
                   read below takes (psSWSFile(Self)) as its DEFAULT, which is only meaningful if the
                   command line could have supplied it, and the abort made that unreachable.

                   Recorded, not displayed: ReadCmdLineIniFile does the workspace switch once, with
                   the INI's own [SWS File Section] winning when it has one and this as the fallback.
                   Doing the switch here as well would load a workspace twice per run. */
                Set psSWSFile to sSWSFile
            End
        End
        Else If (sSourceFile <> "") Begin
            Set pbWorkspaceMode to False
            Send OnFileNameUpdate sSourceFile
        End
        If (sFolders <> "") Begin
            Move (StrSplitToArray(sFolders, ";")) to asFolders
            Set pasSelectedFolders to asFolders
            Set pasCmdLineFolders  to asFolders
        End
        /* /scan TAKES OVER (2026-11-20): nothing of a refactoring run - the scan reads its own INI, and OnStartup
           runs it before the batch branch, which it never reaches (RunCIScanAndExit ends the program). pbBatchMode
           keeps every error dialog away, as it does for /bm: a CI run must never wait for a click. */
        If (bScan = True) Begin
            Set pbScanMode     to True
            Set pbScanBaseline to bScanBaseline
            Set pbBatchMode    to True
            Send ReadScanIniFile sScanIniFile
        End
        Else Begin
            If (bBatch = True) Begin
                Set pbBatchMode to True
            End
            If (bConfigFile = True) Begin
                Set pbBatchMode to True
                Send ReadCmdLineIniFile sCmdLineIniFile
            End
        End
    End_Procedure
    
    // Helper message for: Command Line Interface:
    Procedure ReadCmdLineIniFile String sCmdLineIniFile
        Handle hoIni hoDD
        String sSWSFile sUserName sFolder sFilters sFunction sFileName sText sProgramPath sResultFile sSingleFile
        String[] asFolders asFunctions
        Boolean bFolders bExists
        Integer iCount iSize
        
        Get vFilePathExists sCmdLineIniFile to bExists
        If (bExists = False) Begin
            Send FTStopBox ("The CmdLineIniFile can't be found:" * String(sCmdLineIniFile) + "\nThe program will now close.")
            Abort
        End
            
        Get Create (RefClass(cIniFile)) to hoIni
        Set psFileName of hoIni to sCmdLineIniFile
        
        // SWS-File:
        Get ReadString of hoIni CS_CmdIniSWSFileSection CS_CmdIniSWSFile (psSWSFile(Self)) to sSWSFile
        If (sSWSFile <> "") Begin
            Set pbWorkspaceMode to True
            Send UpdateWorkspaceSelectorDisplay sSWSFile
        End
        Else Begin           
            Get psSWSFile to sFileName
            If (sFileName = "") Begin 
                // Begin/End on purpose: this used to be a bare "If (sCmdLineIniFile <> "")" with no
                // block, so it guarded only the message and the Abort ran unconditionally. Harmless
                // while sCmdLineIniFile is always set here, but it reads as - and would behave as -
                // a silent exit the moment that stops being true.
                If (sCmdLineIniFile <> "") Begin
                    Send FTStopBox ("The .sws file is missing from the ini-file and has not been specified on the command line. Cannot continue. Program will now close.")
                    Abort
                End
            End
        End

        // User Name:
        Get ReadString of hoIni CS_CmdIniUserSection CS_CmdIniUserName "" to sUserName
        If (sUserName <> "") Begin
            Set psUserName to sUserName
        End
                
        // Folders:
        Move 1000 to iSize // Just an arbitrarly large integer.
        For iCount from 1 to iSize
            Get ReadString of hoIni CS_CmdIniFoldersSection (CS_CmdIniFolderName + String(iCount)) "" to sFolder
            If (sFolder = "") Begin
                Move iSize to iCount
            End
            Else Begin
                Move sFolder to asFolders[-1]
            End
        Loop
        // Update Folders table selections
        Set pasSelectedFolders to asFolders
        Set pasCmdLineFolders  to asFolders
            
        // Filters:
        Get ReadString of hoIni CS_CmdIniFileFilterSection CS_CmdIniFileFilters "" to sFilters
        // Kept, not written: ApplyCmdLineSelections puts it into SysFile from the batch block, just before the run,
        // and RestoreCmdLineSelections puts the user's own back after it (2026-11-20).
        Set psCmdLineFilter to (Trim(sFilters))
        
        // Functions:
        For iCount from 1 to iSize
            Get ReadString of hoIni CS_CmdIniFunctionSection (CS_CmdInitFunction + String(iCount)) "" to sFunction
            If (sFunction = "") Begin
                Move iSize to iCount
            End
            Else Begin
                Move sFunction to asFunctions[-1]
            End
        Loop

        // The specs, kept whole: ApplyCmdLineSelections ticks the names, and the parameter half has to reach the
        // table before the run too (ApplyCmdLineFunctionParameters) - both driven from the batch block.
        Set pasCmdLineFunctionSpecs to asFunctions
        Get Create (RefClass(cFunctionsDataDictionary)) to hoDD
        /* The ticks are NOT changed here (2026-11-20): ApplyCmdLineSelections ticks the INI's functions from the
           batch block, just before the run, and RestoreCmdLineSelections puts the user's own back after it. This
           ran while the command line was parsed, and a run that stopped before the batch block left the user's
           ticks replaced for good. */
        // Say what the INI asked for that is not there - a moved folder and a name this build no
        // longer has both make an unattended run quietly do LESS than asked, and every readout
        // afterwards reads as an honest success. Surfaced in the run summary by CollectSummary.
        Send ValidateCmdLineIniSelections asFolders asFunctions hoDD

        Send Destroy of hoDD
        // Result file: optional path where this run records its outcome (STATUS=SUCCESS/FAILED) so a
        // build / toolchain can check it alongside the process exit code. "" = don't write one.
        Get ReadString of hoIni CS_CmdIniResultSection CS_CmdIniResultFile "" to sResultFile
        Set psBatchResultFile to sResultFile

        /* [Single File Section] - OPTIONAL, and it takes precedence over the .sws, exactly as the
           constant's own comment has always claimed. It was never written by an exporter nor read
           by either reader, so the header promised a feature that did not exist (Nils 2026-08-03).

           Read LAST, because it OVERRIDES: the .sws block above has already set pbWorkspaceMode
           True and the folders are already loaded, and naming one file narrows the run to it. The
           workspace still matters - it supplies the backup folder and the paths - so this replaces
           the SCOPE of the run, not its context. That is also how the program behaves interactively.

           A named file that is not there FAILS the run rather than quietly falling back to scanning
           the whole workspace: doing a different job from the one the INI asked for, and reporting
           SUCCESS, is the worst of the options. ExitBatchWithCode (not a Stop_Box) because a
           headless run must never wait for a click - it writes STATUS=FAILED and exits non-zero. */
        Get ReadString of hoIni CS_CmdIniSingleFileSection CS_CmdIniSingleFileName "" to sSingleFile
        Move (Trim(sSingleFile)) to sSingleFile
        Send Destroy of hoIni
        If (sSingleFile <> "") Begin
            Get vFilePathExists sSingleFile to bExists
            If (bExists = False) ;
                Send ExitBatchWithCode eEngineError ("INI [Single File Section]: the file named there does not exist, so there was nothing to refactor -" * sSingleFile)
            Set pbWorkspaceMode to False
            Send OnFileNameUpdate sSingleFile
        End
    End_Procedure

    /* THE CI SCAN'S INI (2026-11-20): the /bm INI, read for a scan - the workspace, the folders, the file filter,
       the result file, and [Scan Section]'s three file names. Nothing else, and nothing saved: a scan must not
       change the function selection, the folder ticks or the stored file filter that a refactoring run uses, all
       three of which ReadCmdLineIniFile sets for /bm. A fault is kept in psScanError for RunCIScanAndExit, which
       ends the run with exit code 2. */
    Procedure ReadScanIniFile String sIniFile
        Handle hoIni
        String sSWSFile sFolder sFilters sResultFile sBase sFile
        String[] asFolders
        Integer iCount iSize
        Boolean bExists

        Set psScanIniFile to sIniFile
        Get vFilePathExists sIniFile to bExists
        If (bExists = False) Begin
            Set psScanError to ("the INI file is not there: " + sIniFile)
            Procedure_Return
        End
        Get Create (RefClass(cIniFile)) to hoIni
        Set psFileName of hoIni to sIniFile

        /* The result file FIRST: every fault below still has to be written there. With the workspace check ahead of it,
           a missing workspace ended the run with exit code 2 and no result file, and the CI log could only say the scan
           "crashed, hung, or never finished" (found by the live test of the exported _SCAN.ps1, 2026-11-21). */
        Get ReadString of hoIni CS_CmdIniResultSection CS_CmdIniResultFile "" to sResultFile
        Set psBatchResultFile to (Trim(sResultFile))

        // The workspace: the INI's, else the one /sws named.
        Get ReadString of hoIni CS_CmdIniSWSFileSection CS_CmdIniSWSFile (psSWSFile(Self)) to sSWSFile
        Move (Trim(sSWSFile)) to sSWSFile
        Move False to bExists
        If (sSWSFile <> "") ;
            Get vFilePathExists sSWSFile to bExists
        If (bExists = False) Begin
            Send Destroy of hoIni
            If (sSWSFile = "") ;
                Set psScanError to ("the INI names no workspace in [" + CS_CmdIniSWSFileSection + "], and /sws named none: " + sIniFile)
            Else ;
                Set psScanError to ("the workspace the INI names is not there: " + sSWSFile)
            Procedure_Return
        End
        Set pbWorkspaceMode to True
        Send UpdateWorkspaceSelectorDisplay sSWSFile

        // The folders; none = the workspace's source folders (RunCIScanAndExit).
        Move 1000 to iSize
        For iCount from 1 to iSize
            Get ReadString of hoIni CS_CmdIniFoldersSection (CS_CmdIniFolderName + String(iCount)) "" to sFolder
            Move (Trim(sFolder)) to sFolder
            If (sFolder = "") ;
                Move iSize to iCount
            Else ;
                Move sFolder to asFolders[SizeOfArray(asFolders)]
        Loop
        Set pasScanFolders to asFolders

        // The file filter, for this run only: RunCIScanAndExit puts it in the SysFile buffer and never saves it.
        Get ReadString of hoIni CS_CmdIniFileFilterSection CS_CmdIniFileFilters "" to sFilters
        Set psScanFilter to (Trim(sFilters))

        /* The three files, each beside the INI under its name unless [Scan Section] names it. "findings" for what every
           run writes anew, "baseline" for what only /baseline writes - names that cannot be taken for each other (Nils
           2026-11-20 edited the findings for the baseline, when they were .scan.json and .scan-baseline.json). */
        Get BatchArtifactBase sIniFile to sBase
        Get ReadString of hoIni CS_CmdIniScanSection CS_CmdIniScanBaselineFile (sBase + ".baseline.json") to sFile
        Set psScanBaselineFile to (Trim(sFile))
        Get ReadString of hoIni CS_CmdIniScanSection CS_CmdIniScanJsonFile (sBase + ".findings.json") to sFile
        Set psScanJsonFile to (Trim(sFile))
        Get ReadString of hoIni CS_CmdIniScanSection CS_CmdIniScanSarifFile (sBase + ".findings.sarif") to sFile
        Set psScanSarifFile to (Trim(sFile))
        Send Destroy of hoIni
    End_Procedure

End_Object

// Includes automatic database update logic:
Use DoDatabaseUpdateStuff.pkg
                                
Use cRDCTooltipController.pkg
Object oToolTipController is a cRDCTooltipController
End_Object

Declare_Datafile SysFile
Declare_Datafile StatLog
Register_Object oSysfile_DD

Use ScintillaLexerApi.h.pkg
Use cRefactorEditorSettings.pkg   // JSON-backed settings: repoints ghoEditorProperties (must follow oEditorProperties.pkg)
Use oEditContextMenu.pkg
Use oDEOEditContextMenu.pkg

Object oMain is a Panel
    Set Label to (psProduct(ghoApplication) * "- Refactors Legacy Source Code")
    Set Size to 310 610
    Set piMinSize to 294 610
    Set Icon to "DFRefactor.ico"

    // One-shot latch for the startup view below.
    Property Boolean pbStartViewChosen False

    /* THE STARTUP VIEW IS NAMED HERE, ONCE - deliberately not via pbAutoActivate.

       pbAutoActivate reads like "activate me at startup", but AppPanel.Add_Focus (Dfpanel.pkg) replays
       the ENTIRE phoAutoActivateViews list on every Add_Focus - and this panel gets focus back every
       time a modal dialog closes. With the guided trail marked auto-activate, picking a .sws from the
       Dashboard (SelectWorkspaceFile pops a modal Open dialog) silently handed the screen to the trail
       on the way back: the user asked for one board and ended up reading another, mid-load, before
       psSWSFile was set. Every modal in the app did the same thing. (Nils 2026-07-31.)

       So no view auto-activates now; this fires once, on the first focus the panel takes, and after
       that a view is on screen only because something asked for it by name.

       THE STARTUP VIEW IS THE START CENTER (Nils 2026-08-06). It was the guided trail, which meant
       the first thing anyone saw with no workspace loaded was a board whose builders all
       short-circuit to an empty wrap - one workspace card, and a line telling them to run a Check
       they had no way to reach. The Start Center is the screen for that state; a board is what you
       get once a workspace is open, reached through one of its two lanes or its own toolbar item.
       To fall back, send Activate_oDashboard_vw (the trail) or Activate_oDashboard_vw (the
       old cockpit) here instead. */
    Procedure Add_Focus Handle hoParent Returns Integer
        Integer iError
        Boolean bChosen
        Forward Get msg_Add_Focus hoParent to iError
        If (iError = 0) Begin
            Get pbStartViewChosen to bChosen
            If (bChosen = False) Begin
                Set pbStartViewChosen to True
                Send Activate_oStartCenter_vw of (Client_Id(Self))
            End
        End
        Procedure_Return iError
    End_Procedure

    Object oCJCommandBarSystem is a cRDCCJCommandBarSystem
        Set peRestoreLayout to rlSaveRestoreLayout
        Set peVisualTheme to (FTCJTheme())
        // 18 (2026-11-19): the menu bar, and the Tools and Settings toolbars gone - a layout saved by build 17
        // would bring the old toolbars back and leave the menu bar out.
        Set piLayoutBuild to 18    
        Set pbLargeIcons to False
        Set pbShowExpandButtonAlways to False

        // EXPERIMENT (revive view tab-grouping after a tool panel docks): capture the CodeJock MDI
        // tab-workspace handle from the base cRDCCJCommandBarSystem's DisplayTabWorkspace hook. A docked
        // tool panel (a CommandBars dialog-bar) appears to disable the workspace's drag-to-split;
        // the dock re-asserts ComEnableGroups on this handle after each dock (see OutputDockFT.dg's Activate)
        // to test whether interactive grouping can be revived.
        Procedure OnCreateTabbedWorkspace Handle hoTabWorkspace Handle hoTabPaintManager
            Forward Send OnCreateTabbedWorkspace hoTabWorkspace hoTabPaintManager
            Move hoTabWorkspace to ghoTabWorkspace
        End_Procedure

        /* SHOW OR HIDE THE TOOLBAR TEXT (Nils 2026-10-04: the toolbar takes a lot of horizontal space). A
           toolbar item declared with a caption - peControlStyle xtpButtonIconAndCaption - takes the style the
           Program Settings dialog saved (peToolbarButtonStyle of ghoApplication): its text beside the icon, or
           the icon alone. An icon-only item is left as it is, and so is every menu: a menu bar or a popup draws
           its items its own way.

           The style belongs to each toolbar CONTROL, and CodeJock reads it only when it creates one, so it is
           set on the controls themselves. A control's action carries its DataFlex menu item in ComTag - the
           back pointer cCJAction sets, which OnComExecute follows the same way - and that item's own
           peControlStyle, never changed at run time, says whether it is one of the captioned ones. So a new
           item with a caption follows the setting with nothing to add here. */
        Procedure ApplyToolbarButtonStyle
            Handle hoBar hoControls hoControl hoAction hoItem
            Variant vBar vControls vControl vAction
            Integer eStyle eItemStyle eBarType iBars iBar iCount i

            If (not(IsComObjectCreated(Self))) ;
                Procedure_Return
            Get peToolbarButtonStyle of ghoApplication to eStyle
            Get Create U_cCJCommandBar         to hoBar
            Get Create U_cCJCommandBarControls to hoControls
            Get Create U_cCJCommandBarControl  to hoControl
            Get Create U_cCJCommandBarAction   to hoAction
            Get ComCount to iBars
            For iBar from 1 to iBars
                Get ComItem iBar to vBar
                Set pvComObject of hoBar to vBar
                Get ComType of hoBar to eBarType
                If (eBarType = xtpBarTypeNormal) Begin
                    Get ComControls of hoBar to vControls
                    Set pvComObject of hoControls to vControls
                    Get ComCount of hoControls to iCount
                    For i from 1 to iCount
                        Get ComItem of hoControls i to vControl
                        Set pvComObject of hoControl to vControl
                        Get ComAction of hoControl to vAction
                        If (not(IsNullComObject(vAction))) Begin
                            Set pvComObject of hoAction to vAction
                            Get ComTag of hoAction to hoItem
                            If (hoItem <> 0) Begin
                                If (IsObjectOfClass(hoItem, RefClass(cCJMenuItem))) Begin
                                    Get peControlStyle of hoItem to eItemStyle
                                    If (eItemStyle = xtpButtonIconAndCaption) ;
                                        Set ComStyle of hoControl to eStyle
                                End
                            End
                        End
                    Loop
                End
            Loop
            Send Destroy of hoAction
            Send Destroy of hoControl
            Send Destroy of hoControls
            Send Destroy of hoBar
            Send ComRecalcLayout
        End_Procedure

        // The saved layout brings the toolbar controls back with the style they were saved in, so the setting is
        // applied after it: CreateCommandBars loads the environment once every item exists.
        Procedure LoadEnvironment
            Forward Send LoadEnvironment
            Send ApplyToolbarButtonStyle
        End_Procedure

        /* THE MENU BAR (Nils 2026-11-19: "adding a menu-system - just as we did for CMS"). Every command has a
           named place here, with its key: a dozen toolbar buttons were icons only, and several dialogs could be
           reached only from a dashboard tile or from a key nothing showed. The main toolbar keeps the views,
           Compile pane, Split View, Clear, Save, Undo, Redo and Source Explorer; the help bar stays as it was;
           the Tools and Settings toolbars and the clipboard buttons are in the menus now.

           Alt plus a letter opens a menu, so the four Alt keys that used a menu's letter are gone: Alt+F (the
           workspace/file switch), Alt+E (Source Explorer), Alt+W (Open Workspace) and Alt+T (Settings). Each
           keeps its Ctrl key. The keys themselves are the On_Key lines at the end of oMain.

           Check and the refactoring plan stay on the dashboards: their steps decide when each one is ready.
           An item that repeats a toolbar button asks that button (Execute, IsEnabled), so the two cannot
           disagree. A menu item is updated as its menu opens, so none needs pbActiveUpdate. */
        Object oMenuBar is a cCJMenuBar

            Object oFile_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "&File"
                Set psDescription to "Open a workspace or a source file, clear, save, or quit the program."

                Object oOpenWorkspace_MenuItem is a cCJMenuItem
                    Set psCaption to "&Open Workspace..."
                    Set psDescription to "Choose the workspace (.sws) to work on"
                    Set psImage to "ActionOpenWorkspace.ico"
                    Set psShortcut to "Ctrl+W"

                    Procedure OnExecute Variant vCommandBarControl
                        Send ActivateWorkspaceDialog of (phoMainPanel(ghoApplication))
                    End_Procedure
                End_Object

                Object oOpenSourceFile_MenuItem is a cCJMenuItem
                    Set psCaption to "Open a Source &File..."
                    Set psDescription to "Choose one source file to refactor on its own"
                    Set psImage to "ActionOpen.ico"
                    Set psShortcut to "Ctrl+O"

                    Procedure OnExecute Variant vCommandBarControl
                        Send ActivateBrowseDialog of (phoMainPanel(ghoApplication))
                    End_Procedure
                End_Object

                Object oClear_FileMenuItem is a cCJMenuItem
                    Set psCaption to "&Clear"
                    Set psDescription to "Close the workspace or the file, and go back to the Start Center"
                    Set psImage to "ActionClear.ico"
                    Set pbControlBeginGroup to True

                    Procedure OnExecute Variant vCommandBarControl
                        Send Execute of (oClear_MenuItem(ghoCommandBars))
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (IsEnabled(oClear_MenuItem(ghoCommandBars)))
                    End_Function
                End_Object

                Object oSave_FileMenuItem is a cCJMenuItem
                    Set psCaption to "&Save"
                    Set psDescription to "Save the changes in the editor"
                    Set psImage to "ActionSave.ico"
                    Set psShortcut to "Ctrl+S"

                    Procedure OnExecute Variant vCommandBarControl
                        Send Execute of (oSave_ToolItem(ghoCommandBars))
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (IsEnabled(oSave_ToolItem(ghoCommandBars)))
                    End_Function
                End_Object

                Object oExit_FileMenuItem is a cCJExitMenuItem
                    Set psImage to "ActionExit.ico"
                    Set pbControlBeginGroup to True
                End_Object
            End_Object

            Object oEdit_Menu is a cCJMenuItem
                Set peControlType to xtpControlPopup
                Set psCaption to "&Edit"
                Set psDescription to "Undo, the clipboard, and find and go to in the editor."

                // The editor's own commands apply while the editor has the focus.
                Function EditorHasFocus Returns Boolean
                    Handle hoEditor
                    Get phoEditor of ghoApplication to hoEditor
                    Function_Return (hoEditor <> 0 and Focus(Desktop) = hoEditor)
                End_Function

                Object oUndo_EditMenuItem is a cCJMenuItem
                    Set psCaption to "&Undo"
                    Set psDescription to "Undo the last editor action"
                    Set psImage to "ActionUndo.ico"
                    Set psShortcut to "Ctrl+Z"

                    Procedure OnExecute Variant vCommandBarControl
                        Send Execute of (oUndo_MenuItem(ghoCommandBars))
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (IsEnabled(oUndo_MenuItem(ghoCommandBars)))
                    End_Function
                End_Object

                Object oRedo_EditMenuItem is a cCJMenuItem
                    Set psCaption to "&Redo"
                    Set psDescription to "Redo the last editor action"
                    Set psImage to "ActionRedo.ico"
                    Set psShortcut to "Ctrl+Y"

                    Procedure OnExecute Variant vCommandBarControl
                        Send Execute of (oRedo_MenuItem(ghoCommandBars))
                    End_Procedure

                    Function IsEnabled Returns Boolean
                        Function_Return (IsEnabled(oRedo_MenuItem(ghoCommandBars)))
                    End_Function
                End_Object

                Object oCut_EditMenuItem is a cCJCutMenuItem
                    Set pbControlBeginGroup to True
                End_Object

                Object oCopy_EditMenuItem is a cCJCopyMenuItem
                End_Object

                Object oPaste_EditMenuItem is a cCJPasteMenuItem
                End_Object

                Object oDelete_EditMenuItem is a cCJDeleteEditMenuItem
                End_Object

                Object oFind_EditMenuItem is a cCJMenuItem
                    Set psCaption to "&Find..."
                    Set psDescription to "Find text in the editor"
                    Set psImage to "ActionFind.ico"
                    Set psShortcut to "Ctrl+F"
                    Set pbControlBeginGroup to True

