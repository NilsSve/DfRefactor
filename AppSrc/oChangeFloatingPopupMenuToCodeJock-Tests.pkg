//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeFloatingPopupMenuToCodeJock-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-13
//
// Description : Unit tests for FloatingPopupMenu / dbFloatingPopupMenu -> cCJContextMenu: the block
//               emitter and the in-file walk.
//
//               Every fixture is a shape read out of a test workspace, never an invented one: the
//               Item_List form with Status_Help and a commented-out target, the Add_Item form with
//               Msg_None separators, the Popup override that shadows items by a flag, the explicit
//               'to' target, the If around the Add_Items, the dbFloatingPopupMenu with one item of
//               its own. The refusals are here because each would otherwise lose behaviour in silence.
//               Object names come from the caption AS WRITTEN, letters and digits only - "&Insert row"
//               is oInsertrow_MenuItem - so the expectations below spell them that way on purpose.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeFloatingPopupMenuToCodeJock_Tests is a cTestFixture
        Set psFunctionName to "ChangeFloatingPopupMenuToCodeJock"

        // The block through the emitter, with a four-space indent and line 0 as its file position.
        Function Converted String[] asBlock Integer ByRef iItems String ByRef sWhyNot Returns String[]
            String[] asOut
            Boolean bOK
            Get _CJPopupBlockToContextMenu of ghoFuncLib (&asBlock) "    " 0 (&asOut) (&iItems) (&sWhyNot) to bOK
            Function_Return asOut
        End_Function

        // True when one of asLines, trimmed, is exactly sWant.
        Function HasLine String[] asLines String sWant Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asLines) - 1)
                If ((Trim(asLines[i])) = sWant) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // The index of the first line (trimmed) equal to sWant, -1 when none - for ORDER assertions.
        Function LineAt String[] asLines String sWant Returns Integer
            Integer i
            For i from 0 to (SizeOfArray(asLines) - 1)
                If ((Trim(asLines[i])) = sWant) ;
                    Function_Return i
            Loop
            Function_Return -1
        End_Function

        // True when the object declared by sDecl carries sWant before its End_Object.
        Function ObjectHas String[] asLines String sDecl String sWant Returns Boolean
            Integer i
            Boolean bIn
            Move False to bIn
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (bIn = False) Begin
                    If ((Trim(asLines[i])) = sDecl) ;
                        Move True to bIn
                End
                Else Begin
                    If ((Trim(asLines[i])) = "End_Object") ;
                        Function_Return False
                    If ((Trim(asLines[i])) = sWant) ;
                        Function_Return True
                End
            Loop
            Function_Return False
        End_Function

        // How many lines contain sLc (lowercase substring).
        Function LinesContaining String[] asLines String sLc Returns Integer
            Integer i iCount
            Move 0 to iCount
            For i from 0 to (SizeOfArray(asLines) - 1)
                If (Lowercase(asLines[i]) contains sLc) ;
                    Increment iCount
            Loop
            Function_Return iCount
        End_Function

        // The lines joined, trimmed, so two files can be compared whole.
        Function Joined String[] asLines Returns String
            String sOut
            Integer i
            Move "" to sOut
            For i from 0 to (SizeOfArray(asLines) - 1)
                Move (sOut + Trim(asLines[i]) + Character(1)) to sOut
            Loop
            Function_Return sOut
        End_Function

        // ---- the Item_List form -------------------------------------------------------------------
        // A view's row menu: two items with Status_Help, a commented-out 'To' target after each Send,
        // and a Popup override that records the row before it forwards. The object keeps its name, the
        // wrapper disappears, each item sends its message to the focus (the commented target stays
        // gone), and the override rides along verbatim.
        {Published = True}
        Procedure Popup_ItemListObjectBecomesAContextMenu
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oRowMenu is a FloatingPopupMenu'                          to asBlock[0]
            Move ''                                                                            to asBlock[1]
            Move '        Item_List'                                                           to asBlock[2]
            Move '            On_Item "&Insert row"    Send Msg_InsertRow  //To (Client_Area(Main(Self)))' to asBlock[3]
            Move '            Set Status_Help to "Insert a row"'                                to asBlock[4]
            Move ''                                                                            to asBlock[5]
            Move '            On_Item "&Delete row"    Send Msg_DeleteRow  //To (Client_Area(Main(Self)))' to asBlock[6]
            Move '            Set Status_Help to "Delete the row"'                               to asBlock[7]
            Move '        End_Item_List'                                                       to asBlock[8]
            Move ''                                                                            to asBlock[9]
            Move '        Procedure Popup'                                                     to asBlock[10]
            Move '            Integer iFoc iRow'                                                to asBlock[11]
            Move '            Get Focus to iFoc'                                               to asBlock[12]
            Move '            Get CurrentRow of iFoc to iRow'                                  to asBlock[13]
            Move '            Set piSelectedRow of (oGridView(Current_Object)) to iRow'       to asBlock[14]
            Move '            Forward Send Popup'                                              to asBlock[15]
            Move '        End_Procedure'                                                       to asBlock[16]
            Move '    End_Object'                                                              to asBlock[17]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 2 iItems
            Send AssertSAreEqual "    Object oRowMenu is a cCJContextMenu" asOut[0]
            Send AssertSAreEqual "    End_Object" (asOut[SizeOfArray(asOut) - 1])
            Send Assert (HasLine(Self, asOut, "Object oInsertrow_MenuItem is a cCJMenuItem"))
            Send Assert (HasLine(Self, asOut, 'Set psCaption to "&Insert row"'))
            Send Assert (HasLine(Self, asOut, 'Set psToolTip to "Insert a row"'))
            Send Assert (HasLine(Self, asOut, "Send InsertRow of (Focus(Desktop))"))
            Send Assert (HasLine(Self, asOut, "Object oDeleterow_MenuItem is a cCJMenuItem"))
            Send Assert (HasLine(Self, asOut, "Send DeleteRow of (Focus(Desktop))"))
            Send Assert (HasLine(Self, asOut, "Procedure Popup"))
            Send Assert (HasLine(Self, asOut, "Set piSelectedRow of (oGridView(Current_Object)) to iRow"))
            Send Assert (HasLine(Self, asOut, "Forward Send Popup"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "item_list"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "client_area"))
        End_Procedure

        // ---- the Add_Item form --------------------------------------------------------------------
        // A tree's custom menu: six items and two Msg_None separators. The separator marks the NEXT
        // item with pbControlBeginGroup, the Msg_ prefix is dropped from the message, and the rest of
        // the items carry no group mark.
        {Published = True}
        Procedure Popup_AddItemFormWithSeparators
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '      Object oTreeMenu is a FloatingPopupMenu'                    to asBlock[0]
            Move '        Send Add_Item msg_ShowProperties "&Properties"'          to asBlock[1]
            Move '        Send Add_Item msg_None ""'                                to asBlock[2]
            Move '        Send Add_Item msg_FolderBefore "New Folder Before"'      to asBlock[3]
            Move '        Send Add_Item msg_FolderAfter "New Folder After"'        to asBlock[4]
            Move '        Send Add_Item msg_ItemBefore "New Item Before"'        to asBlock[5]
            Move '        Send Add_Item msg_ItemAfter "New Item After"'          to asBlock[6]
            Move '        Send Add_Item msg_None ""'                                to asBlock[7]
            Move '        Send Add_Item msg_DeleteItem "&Delete Current Item"'       to asBlock[8]
            Move '      End_Object // oTreeMenu'                                   to asBlock[9]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 6 iItems
            Send Assert (HasLine(Self, asOut, "Object oTreeMenu is a cCJContextMenu"))
            Send Assert (HasLine(Self, asOut, 'Set psCaption to "&Properties"'))
            Send Assert (HasLine(Self, asOut, "Send ShowProperties of (Focus(Desktop))"))
            Send Assert (ObjectHas(Self, asOut, "Object oProperties_MenuItem is a cCJMenuItem", "Set pbControlBeginGroup to True") = False)
            Send Assert (ObjectHas(Self, asOut, "Object oNewFolderBefore_MenuItem is a cCJMenuItem", "Set pbControlBeginGroup to True"))
            Send Assert (ObjectHas(Self, asOut, "Object oNewFolderAfter_MenuItem is a cCJMenuItem", "Set pbControlBeginGroup to True") = False)
            Send Assert (ObjectHas(Self, asOut, "Object oDeleteCurrentItem_MenuItem is a cCJMenuItem", "Set pbControlBeginGroup to True"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "msg_"))
        End_Procedure

        // ---- the db form --------------------------------------------------------------------------
        // A dbFloatingPopupMenu inherits ten items from its class; this one adds a separator and one
        // item of its own at index 10, and forwards its Popup. The ten come first as the shipped DEO
        // classes - no caption, no OnExecute, the class carries both - the own item follows with its
        // group mark, and the separator ahead of the very first item draws nothing.
        {Published = True}
        Procedure Popup_DbFormInheritsTheTenStandardItems
            String[] asBlock asOut
            String sWhyNot
            Integer iItems iPromptAt iNextAt iDeleteAt iOwnAt

            Move '    Object oCopyMenu is a dbFloatingPopupMenu'                to asBlock[0]
            Move ''                                                                   to asBlock[1]
            Move '        Send Add_Item Msg_None ""'                                  to asBlock[2]
            Move '        Send Add_Item Msg_CopyRow "Copy row"'        to asBlock[3]
            Move ''                                                                   to asBlock[4]
            Move '        Procedure Popup'                                            to asBlock[5]
            Move '            Integer iFoc'                                           to asBlock[6]
            Move '            Get Focus to iFoc'                                      to asBlock[7]
            Move '            Forward Send Popup'                                     to asBlock[8]
            Move '        End_Procedure//popup'                                       to asBlock[9]
            Move ''                                                                   to asBlock[10]
            Move '    End_Object'                                                     to asBlock[11]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 8 iItems
            Get LineAt asOut "Object oPrompt_MenuItem is a cCJPromptMenuItem"          to iPromptAt
            Get LineAt asOut "Object oFindNext_MenuItem is a cCJFindNextMenuItem"      to iNextAt
            Get LineAt asOut "Object oRequestDelete_MenuItem is a cCJDeleteMenuItem"   to iDeleteAt
            Get LineAt asOut "Object oCopyrow_MenuItem is a cCJMenuItem"        to iOwnAt
            Send Assert (iPromptAt > 0 and iNextAt > iPromptAt and iDeleteAt > iNextAt and iOwnAt > iDeleteAt)
            // the shipped class needs nothing from us: the Prompt object closes on its next line
            If (iPromptAt > 0) ;
                Send AssertSAreEqual "End_Object" (Trim(asOut[iPromptAt + 1]))
            Send Assert (ObjectHas(Self, asOut, "Object oPrompt_MenuItem is a cCJPromptMenuItem", "Set pbControlBeginGroup to True") = False)
            Send Assert (ObjectHas(Self, asOut, "Object oFindNext_MenuItem is a cCJFindNextMenuItem", "Set pbControlBeginGroup to True"))
            Send Assert (ObjectHas(Self, asOut, "Object oRequestClearAll_MenuItem is a cCJClearAllMenuItem", "Set pbControlBeginGroup to True"))
            Send Assert (ObjectHas(Self, asOut, "Object oCopyrow_MenuItem is a cCJMenuItem", "Set pbControlBeginGroup to True"))
            Send Assert (HasLine(Self, asOut, "Send CopyRow of (Focus(Desktop))"))
            Send Assert (HasLine(Self, asOut, "Get Focus to iFoc"))
            Send Assert (HasLine(Self, asOut, "Forward Send Popup"))
        End_Procedure

        // ---- the Popup override -------------------------------------------------------------------
        // A program's background menu: two items with an explicit 'to' target, and a Popup override
        // that shadows one item or the other by a flag. Shadow_State Item N becomes pbEnabled of the
        // N-th child, negated; the target clause is carried as written; the If and the flag lookup
        // go across verbatim.
        {Published = True}
        Procedure Popup_PopupOverrideShadowStateBecomesPbEnabled
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '        Object oBackdropMenu is a FloatingPopupMenu'                                            to asBlock[0]
            Move '            Item_List'                                                                   to asBlock[1]
            Move '                On_Item "&Hide backdrop"    Send HideBackdrop  to (oClientArea(Main(Self)))' to asBlock[2]
            Move '                Set Status_Help to "Hide the backdrop"'                                   to asBlock[3]
            Move '                On_Item "&Show backdrop"    Send ShowBackdrop   to (oClientArea(Main(Self)))'   to asBlock[4]
            Move '                Set Status_Help to "Show the backdrop"'                                      to asBlock[5]
            Move '            End_Item_List'                                                               to asBlock[6]
            Move '            Procedure Popup'                                                             to asBlock[7]
            Move '                Integer iShown'                                                       to asBlock[8]
            Move '                Get pbBackdropShown of (oClientArea(self)) to iShown'                      to asBlock[9]
            Move '                If (iShown=1) Begin'                                                  to asBlock[10]
            Move '                    Set Shadow_State Item 1 to true'                                     to asBlock[11]
            Move '                    Set Shadow_State Item 0 to false'                                    to asBlock[12]
            Move '                End'                                                                     to asBlock[13]
            Move ''                                                                                        to asBlock[14]
            Move '                Forward Send popup'                                                      to asBlock[15]
            Move '            End_Procedure'                                                               to asBlock[16]
            Move '        End_Object'                                                                      to asBlock[17]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 2 iItems
            // the helper hands the emitter a four-space indent whatever the block carried
            Send AssertSAreEqual "    Object oBackdropMenu is a cCJContextMenu" asOut[0]
            Send Assert (HasLine(Self, asOut, "Send HideBackdrop to (oClientArea(Main(Self)))"))
            Send Assert (HasLine(Self, asOut, "Send ShowBackdrop to (oClientArea(Main(Self)))"))
            Send Assert (HasLine(Self, asOut, "Set pbEnabled of (oShowbackdrop_MenuItem(Self)) to False"))
            Send Assert (HasLine(Self, asOut, "Set pbEnabled of (oHidebackdrop_MenuItem(Self)) to True"))
            Send Assert (HasLine(Self, asOut, "Get pbBackdropShown of (oClientArea(self)) to iShown"))
            Send Assert (HasLine(Self, asOut, "If (iShown=1) Begin"))
            Send Assert (HasLine(Self, asOut, "Forward Send popup"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "shadow_state"))
        End_Procedure

        // ---- the refusals -------------------------------------------------------------------------
        // A hand-written procedure in the object: dropping it would lose behaviour in silence, so
        // the object is refused, the reason names the line and the procedure, and nothing is emitted.
        {Published = True}
        Procedure Popup_HandWrittenProcedureRefuses
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oPop is a FloatingPopupMenu'         to asBlock[0]
            Move '        Send Add_Item Msg_Foo "Foo"'            to asBlock[1]
            Move '        Procedure OnSomething'                  to asBlock[2]
            Move '            Send Foo'                           to asBlock[3]
            Move '        End_Procedure'                          to asBlock[4]
            Move '    End_Object'                                 to asBlock[5]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "line 3 is a hand-written procedure (OnSomething) the converter cannot translate" sWhyNot
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
            Send AssertIAreEqual 0 iItems
        End_Procedure

        // An If around the Add_Items (a query tool's admin-only entries): the items depend on a run-time
        // test the emitter cannot express, so the object is refused at that line.
        {Published = True}
        Procedure Popup_IfAroundTheItemsRefuses
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    object oPopupMenu is a FloatingPopupMenu'                      to asBlock[0]
            Move 'if (IsAdminMode()) begin'                                          to asBlock[1]
            Move '      send Add_Item MSG_CreateView   "Create a view"'       to asBlock[2]
            Move 'end'                                                                to asBlock[3]
            Move '      send Add_Item MSG_CreateQuery  "Create a query"'      to asBlock[4]
            Move '    end_object'                                                     to asBlock[5]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send Assert (sWhyNot contains "line 2 is not part of the popup grammar: 'if (IsAdminMode()) begin'")
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        // An expression caption cannot be carried into a psCaption literal.
        {Published = True}
        Procedure Popup_ExpressionCaptionRefuses
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oPop is a FloatingPopupMenu'         to asBlock[0]
            Move '        Send Add_Item Msg_Foo (sCaption)'       to asBlock[1]
            Move '    End_Object'                                 to asBlock[2]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send Assert (sWhyNot contains "line 2 gives Add_Item a caption that is not a literal")
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

        // ---- shapes from the first live run (a view's tree menu) ---------------------------------
        // Every On_Item split over two lines with ';' - the caption on one, the Send and its target on
        // the next. Read as one logical line: one item each, the target carried, the Status_Help on the
        // right item, and the override's Shadow_State on the right child.
        {Published = True}
        Procedure Popup_ContinuedOnItemIsOneItem
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oTreeMenu is a FloatingPopupMenu'                    to asBlock[0]
            Move '        Item_List'                                              to asBlock[1]
            Move '            On_Item "Balance" ;'                                to asBlock[2]
            Move '            Send DoOpenBalance to (oTree(Group(self)))'        to asBlock[3]
            Move '            Set Status_Help to "Balance"'                       to asBlock[4]
            Move ''                                                               to asBlock[5]
            Move '            On_Item "Bookings" ;'                               to asBlock[6]
            Move '            Send DoOpenBookings to (oTree(Group(self)))'       to asBlock[7]
            Move '            Set Status_Help to "Show the bookings"'             to asBlock[8]
            Move '        End_Item_List'                                          to asBlock[9]
            Move '        Procedure Popup'                                        to asBlock[10]
            Move '            If (bAdmin@ = 1) Begin'                             to asBlock[11]
            Move '                Set Shadow_State Item 1 to true'                to asBlock[12]
            Move '            End'                                                to asBlock[13]
            Move '            Forward Send popup'                                 to asBlock[14]
            Move '        End_Procedure'                                          to asBlock[15]
            Move '    End_Object'                                                 to asBlock[16]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 2 iItems
            Send Assert (HasLine(Self, asOut, "Object oBalance_MenuItem is a cCJMenuItem"))
            Send Assert (HasLine(Self, asOut, "Send DoOpenBalance to (oTree(Group(self)))"))
            Send Assert (ObjectHas(Self, asOut, "Object oBookings_MenuItem is a cCJMenuItem", 'Set psToolTip to "Show the bookings"'))
            Send Assert (HasLine(Self, asOut, "Send DoOpenBookings to (oTree(Group(self)))"))
            Send Assert (HasLine(Self, asOut, "Set pbEnabled of (oBookings_MenuItem(Self)) to False"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "on_item"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "focus(desktop)"))
        End_Procedure

        // The object declares a Property of its own and sets Aux_Value. The property is carried
        // verbatim; the Aux_Value line is retired - commented out under a note saying why (Nils
        // 2026-09-13: "disregard ... convert anyway, then comment out the line") - and the items
        // dispatch as every other converted item: to the focus, or to their own 'to' target.
        {Published = True}
        Procedure Popup_PropertyIsKeptAndAuxValueRetired
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oTreeMenu is a FloatingPopupMenu'                    to asBlock[0]
            Move '        Property Integer piRightItem 0'                         to asBlock[1]
            Move '        Set aux_value to (oTree(self))'                         to asBlock[2]
            Move '        Item_List'                                              to asBlock[3]
            Move '            On_Item "Open" Send DoOpenItem'                     to asBlock[4]
            Move '            On_Item "Close" Send DoCloseItem to (oOther(self))' to asBlock[5]
            Move '        End_Item_List'                                          to asBlock[6]
            Move '    End_Object'                                                 to asBlock[7]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 2 iItems
            Send AssertSAreEqual "Property Integer piRightItem 0" (Trim(asOut[1]))
            Send AssertSAreEqual "// DFRefactor (ChangeFloatingPopupMenuToCodeJock): Aux_Value was the legacy popup menu's own property - a cCJContextMenu has no use for it, so the line below is retired." (Trim(asOut[2]))
            Send AssertSAreEqual "//  Set aux_value to (oTree(self))" (Trim(asOut[3]))
            Send Assert (HasLine(Self, asOut, "Send DoOpenItem of (Focus(Desktop))"))
            Send Assert (HasLine(Self, asOut, "Send DoCloseItem to (oOther(self))"))
            Send AssertIAreEqual 0 (LinesContaining(Self, asOut, "send doopenitem to"))
        End_Procedure

        // A tab-only line is blank, and a tab ahead of a comment is indentation - neither is a refusal
        // (the generic refusal used to quote such a line as nothing at all).
        {Published = True}
        Procedure Popup_TabOnlyLineIsBlank
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oPop is a FloatingPopupMenu'                         to asBlock[0]
            Move (Character(9))                                                   to asBlock[1]
            Move '        Send Add_Item Msg_Foo "Foo"'                            to asBlock[2]
            Move (Character(9) + "// a note")                                     to asBlock[3]
            Move '    End_Object'                                                 to asBlock[4]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertIAreEqual 1 iItems
            Send Assert (HasLine(Self, asOut, "// a note"))
        End_Procedure

        // Shadow_State at OBJECT level (set once, at construction) translates like the override's, and
        // resolves a child declared later in the object.
        {Published = True}
        Procedure Popup_ObjectLevelShadowStateTranslates
            String[] asBlock asOut
            String sWhyNot
            Integer iItems

            Move '    Object oPop is a FloatingPopupMenu'                         to asBlock[0]
            Move '        Set Shadow_State Item 1 to True'                        to asBlock[1]
            Move '        Send Add_Item Msg_Foo "Foo"'                            to asBlock[2]
            Move '        Send Add_Item Msg_Bar "Bar"'                            to asBlock[3]
            Move '    End_Object'                                                 to asBlock[4]
            Get Converted asBlock (&iItems) (&sWhyNot) to asOut
            Send AssertSAreEqual "" sWhyNot
            Send AssertSAreEqual "Set pbEnabled of (oBar_MenuItem(Self)) to False" (Trim(asOut[1]))
        End_Procedure

        // ---- the file walk ------------------------------------------------------------------------
        // One legacy object in a program: the CodeJock object takes its place, the legacy block is
        // COMMENTED below a marker (never deleted), and the one Use line the emitted classes need
        // (the Edit item; the DEO item needs none) lands with the program's other Use lines. A second
        // run finds nothing and changes nothing.
        {Published = True}
        Procedure Popup_FileWalkCommentsTheLegacyObjectAndAddsTheUse
            String[] asCode asDone asRefused
            String sBefore
            Integer iCount

            Move 'Use DfAllEnt.pkg'                                to asCode[0]
            Move ''                                                to asCode[1]
            Move 'Object oMain is a Panel'                         to asCode[2]
            Move '    Object oPop is a FloatingPopupMenu'          to asCode[3]
            Move '        Item_List'                               to asCode[4]
            Move '            On_Item "&Save" Send Request_Save'  to asCode[5]
            Move '            On_Item "&Cut" Send Cut'           to asCode[6]
            Move '        End_Item_List'                           to asCode[7]
            Move '    End_Object'                                  to asCode[8]
            Move 'End_Object'                                      to asCode[9]
            Get _CJConvertPopupMenusInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 1 (SizeOfArray(asDone))
            Send AssertIAreEqual 0 (SizeOfArray(asRefused))
            If (SizeOfArray(asDone) = 1) ;
                Send AssertSAreEqual "oPop|2" asDone[0]
            Send Assert (HasLine(Self, asCode, "Object oPop is a cCJContextMenu"))
            Send Assert (HasLine(Self, asCode, "Object oSave_MenuItem is a cCJSaveMenuItem"))
            Send Assert (HasLine(Self, asCode, "Object oCut_MenuItem is a cCJCutMenuItem"))
            Send Assert (HasLine(Self, asCode, "//  TODO (DFRefactor): converted to the CodeJock context menu above by ChangeFloatingPopupMenuToCodeJock."))
            // the legacy declaration survives, commented, ahead of nothing live
            Send AssertIAreEqual 1 (LinesContaining(Self, asCode, "//      object opop is a floatingpopupmenu"))
            Send AssertIAreEqual 2 (LinesContaining(Self, asCode, "//              on_item "))
            // the Use: after the program's own Use line, for the Edit item only
            Send AssertSAreEqual "Use cCJStandardMenuItemClasses.pkg" (Left(Trim(asCode[1]), 34))
            Send AssertIAreEqual 0 (LinesContaining(Self, asCode, "ccjdeomenuitemclasses"))
            // idempotent
            Get Joined asCode to sBefore
            Move (ResizeArray(asDone, 0)) to asDone
            Get _CJConvertPopupMenusInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual sBefore (Joined(Self, asCode))
        End_Procedure

        // A refused object gets ONE marker above it, naming the reason, and a second run replaces
        // that marker rather than stacking another (the dfTimer flags grew a line per run, 2026-07-06).
        {Published = True}
        Procedure Popup_RefusedObjectGetsOneMarkerNotTwo
            String[] asCode asDone asRefused
            Integer iCount iSize

            Move 'Object oMain is a Panel'                         to asCode[0]
            Move '    Object oPop is a FloatingPopupMenu'          to asCode[1]
            Move '        Send Add_Item Msg_Foo "Foo"'             to asCode[2]
            Move '        Procedure OnSomething'                   to asCode[3]
            Move '        End_Procedure'                           to asCode[4]
            Move '    End_Object'                                  to asCode[5]
            Move 'End_Object'                                      to asCode[6]
            Get _CJConvertPopupMenusInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asDone))
            Send AssertIAreEqual 1 (SizeOfArray(asRefused))
            If (SizeOfArray(asRefused) = 1) ;
                Send AssertSAreEqual "oPop|line 4 is a hand-written procedure (OnSomething) the converter cannot translate" asRefused[0]
            Send AssertIAreEqual 8 (SizeOfArray(asCode))
            Send AssertSAreEqual "//  TODO (DFRefactor): ChangeFloatingPopupMenuToCodeJock left oPop as written - line 4 is a hand-written procedure (OnSomething) the converter cannot translate. Clear that and run it again, or port the object to cCJContextMenu by hand." (Trim(asCode[1]))
            Send AssertSAreEqual "Object oPop is a FloatingPopupMenu" (Trim(asCode[2]))
            // again: the same file, the same one marker
            Move (SizeOfArray(asCode)) to iSize
            Move (ResizeArray(asRefused, 0)) to asRefused
            Get _CJConvertPopupMenusInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual iSize (SizeOfArray(asCode))
            Send AssertIAreEqual 1 (LinesContaining(Self, asCode, "changefloatingpopupmenutocodejock left"))
        End_Procedure

        // A SUBCLASS definition is not this converter's: ConvertPopupMenuSubclassToCodeJock takes it
        // (oConvertPopupMenuSubclassToCodeJock-Tests.pkg), and this one leaves it exactly as written.
        {Published = True}
        Procedure Popup_SubclassDefinitionIsLeftAlone
            String[] asCode asDone asRefused
            String sBefore
            Integer iCount

            Move 'Class cTreePopupMenu is a FloatingPopupMenu'  to asCode[0]
            Move '    Procedure Construct_Object'                   to asCode[1]
            Move '        Forward Send Construct_Object'            to asCode[2]
            Move '    End_Procedure'                                to asCode[3]
            Move 'End_Class'                                        to asCode[4]
            Get Joined asCode to sBefore
            Get _CJConvertPopupMenusInFile of ghoFuncLib (&asCode) (&asDone) (&asRefused) to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 0 (SizeOfArray(asRefused))
            Send AssertSAreEqual sBefore (Joined(Self, asCode))
        End_Procedure

    End_Object
