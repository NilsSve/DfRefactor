//
// Description : Unit tests for the LegacyRegistryReport scan core (_LegacyRegistryScanFile, cRefactorFuncLib):
//               a pure whole-file classifier - no engine/file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oLegacyRegistryReport is a cTestFixture
        Set psFunctionName to "LegacyRegistryReport"

        // Each legacy Registry / profile / INI command at command position reports the RIGHT note
        // (which also proves the parallel watch/hint arrays stay index-aligned); a mention inside a
        // string and a non-command line are NOT flagged.
        {Published = True}
        Procedure LegacyRegistryReport_ScanFile
            String[] asCode asReport
            String sAll
            Integer iN i

            Move "    Reg_Open_Key sKey to hKey"               to asCode[0]
            Move "    Get_Profile_String sSub sName to sVal"   to asCode[1]
            Move "    Reg_Enum_Value hKey"                     to asCode[2]
            Move '    Move "reg_open_key" to sLabel'           to asCode[3]
            Move "    Send DoRegStuff of oMyRegistry"          to asCode[4]
            Move "    Read_dfini App.ini"                      to asCode[5]
            Get _LegacyRegistryScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 4 iN
            Move "" to sAll
            For i from 0 to (SizeOfArray(asReport) - 1)
                Move (sAll + asReport[i] + Character(10)) to sAll
            Loop
            Send Assert (sAll contains "Line 1:")
            Send Assert (sAll contains "cRegistry class")            // Reg_Open_Key / Get_Profile_String
            Send Assert (sAll contains "rewrite the enumeration")    // Reg_Enum_Value note
            Send Assert (sAll contains "cIniFile class")             // Read_dfini note
            // the masked-string line (4) and the non-command line (5) are NOT flagged
            Send Assert (not(sAll contains "Line 4:"))
            Send Assert (not(sAll contains "Line 5:"))
        End_Procedure

        // No legacy Registry commands -> nothing; a modern "Get <object> to <handle>" is not mistaken
        // for a legacy command.
        {Published = True}
        Procedure LegacyRegistryReport_NoHits
            String[] asCode asReport
            Integer iN
            Move "    Move 1 to iX"            to asCode[0]
            Move "    Get oMyRegistry to hReg" to asCode[1]
            Get _LegacyRegistryScanFile of ghoFuncLib (&asCode) (&asReport) to iN
            Send AssertIAreEqual 0 iN
        End_Procedure

    End_Object
