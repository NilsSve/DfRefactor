//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeIndicatorToBoolean-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-19
//
// Description : Unit tests for ChangeIndicatorToBoolean - modernises a legacy GLOBAL "Indicator <name>"
//               declaration to "Global_Variable Boolean <name>". Indicator declarations are always global,
//               so there is no scope-dependent variant. Owns the 4538 "Obsolete command: Indicator" warning.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeIndicatorToBoolean is a cTestFixture
        Set psFunctionName to "ChangeIndicatorToBoolean"

        {Published = True}
        Procedure ChangeIndicatorToBoolean_Single
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Indicator User" to sLine
            Move ("#IFNDEF gbUser" + C_NewLine + "    Global_Variable Boolean gbUser" + C_NewLine + "#ENDIF") to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // A '$' in the name travels into the Boolean whole (DF26 takes it - probe 2026-09-13); until then
        // the name read as odd, was pinned, and its row blamed a GROUP/ALL Indicate it was not in.
        Procedure ChangeIndicatorToBoolean_DollarName
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Indicator is$done" to sLine
            Move ("#IFNDEF gbis$done" + C_NewLine + "    Global_Variable Boolean gbis$done" + C_NewLine + "#ENDIF") to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Multiple names on one line are all kept (mirrors Global_Variable String a b c).
        Procedure ChangeIndicatorToBoolean_MultipleNames
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Indicator Boss_Avd Boss_Form Boss_Hkst" to sLine
            Move ("#IFNDEF gbBoss_Avd" + C_NewLine + "    Global_Variable Boolean gbBoss_Avd" + C_NewLine + "#ENDIF") to sExpected
            Append sExpected C_NewLine "#IFNDEF gbBoss_Form" C_NewLine "    Global_Variable Boolean gbBoss_Form" C_NewLine "#ENDIF"
            Append sExpected C_NewLine "#IFNDEF gbBoss_Hkst" C_NewLine "    Global_Variable Boolean gbBoss_Hkst" C_NewLine "#ENDIF"
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // Indentation and a trailing comment are preserved verbatim.
        Procedure ChangeIndicatorToBoolean_IndentAndComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    Indicator Boss_Avd  // a flag" to sLine
            Move ("    #IFNDEF gbBoss_Avd" + C_NewLine + "        Global_Variable Boolean gbBoss_Avd // a flag" + C_NewLine + "    #ENDIF") to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send Assert bChanged
        End_Procedure

        {Published = True}
        // An identifier that merely STARTS with "Indicator" (and isn't the first keyword) is left alone.
        Procedure ChangeIndicatorToBoolean_NotAnIdentifierPrefix
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move Indicator_State to iX" to sLine
            Move "Move Indicator_State to iX" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        {Published = True}
        // A USAGE line (ChangeLegacyIndicators' domain) is not this function's job - leave it untouched.
        Procedure ChangeIndicatorToBoolean_UsageLineUntouched
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "If [Found] Begin" to sLine
            Move "If [Found] Begin" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertSAreEqual sExpected sLine
            Send AssertFalse bChanged
        End_Procedure

        {Published = True}
        // A PINNED declaration is KEPT - but no longer silently (Nils 2026-07-12): a same-line
        // NOTE says why (read by legacy code left unconverted), so the kept line stops reading as
        // a converter miss. Second pass: the marker guard makes it a no-op (no stacking).
        Procedure ChangeIndicatorToBoolean_PinnedGetsNoteOnce
            String sLine
            String[] asPinned
            Boolean bChanged
            tTokenizer TokenizerData

            Move "GBUSER" to asPinned[0]
            Set pasPinnedIndicators of ghoFuncLib to asPinned
            Move "Indicator gbUser" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (Left(sLine, 16) = "Indicator gbUser")             // declaration KEPT
            Send Assert (sLine contains "NOTE (DFRefactor)")               // ...with the why
            Send Assert (sLine contains "4538")
            // Second pass over the noted line: no change, no second note.
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send AssertFalse bChanged
        End_Procedure

        {Published = True}
        // A MULTI-NAME line where only ONE name is pinned: the whole line is kept (splitting is
        // not worth the risk) and gets the note.
        Procedure ChangeIndicatorToBoolean_PinnedMultiNameKept
            String sLine
            String[] asPinned
            Boolean bChanged
            tTokenizer TokenizerData
            Move "GBBOSS_FORM" to asPinned[0]
            Set pasPinnedIndicators of ghoFuncLib to asPinned
            Move "Indicator gbBoss_Avd gbBoss_Form gbBoss_Hkst" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIndicatorToBoolean of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "Indicator gbBoss_Avd gbBoss_Form gbBoss_Hkst")
            Send Assert (sLine contains "NOTE (DFRefactor)")
        End_Procedure

    End_Object
