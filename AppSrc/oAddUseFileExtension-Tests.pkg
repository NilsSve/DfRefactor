//****************************************************************************
// $Module type: Test fixture
// $Module name: oAddUseFileExtension-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-06-08
//
// Description : Unit tests for the AddUseFileExtension refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oAddUseFileExtension is a cTestFixture
        Set psFunctionName to "AddUseFileExtension"

        // Use cMyClass -> Use cMyClass.pkg
        { Published = True }
        Procedure AddUseFileExtension_AddsPkg
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use cMyClass' to sLine
            Move 'Use cMyClass.pkg' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Already has the .pkg extension -> unchanged, reports no change.
        { Published = True }
        Procedure AddUseFileExtension_AlreadyPkg
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use cMyClass.pkg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Use cMyClass.pkg' sLine
        End_Procedure

        // A non-.pkg extension (.vw etc.) is left untouched.
        { Published = True }
        Procedure AddUseFileExtension_OtherExtension
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use MyView.vw' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Use MyView.vw' sLine
        End_Procedure

        // Leading indentation and a trailing comment are preserved.
        { Published = True }
        Procedure AddUseFileExtension_PreservesIndentAndComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Use cBar  // grid base' to sLine
            Move '    Use cBar.pkg  // grid base' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A non-Use line is returned unchanged and reports no change.
        { Published = True }
        Procedure AddUseFileExtension_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Move x to y' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Move x to y' sLine
        End_Procedure

        // Regression (2026-06-25): a QUOTED Use path is a literal target (often with spaces and its own
        // extension) and must be left untouched. The space-split used to grab only the first token
        // (`"Acme`), see no ".", and produce Use "Acme.pkg Electrical\DG\PowerMeters.DG".
        { Published = True }
        Procedure AddUseFileExtension_QuotedPathWithSpaceUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use "Acme Electrical\DG\PowerMeters.DG"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Use "Acme Electrical\DG\PowerMeters.DG"' sLine
        End_Procedure

        // A quoted target (even without a space) is a literal path - left untouched.
        { Published = True }
        Procedure AddUseFileExtension_QuotedNoSpaceUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use "SubDir\MyClass.vw"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Use "SubDir\MyClass.vw"' sLine
        End_Procedure

        // 'Use UI' is the DataFlex character-mode base and is left as it is (Nils 2026-09-23: "I don't
        // think there ever was an UI.pkg" - a Check had turned 'use ui' into 'use ui.pkg'). Any case, with
        // a comment; a name that only STARTS with UI still gets the extension.
        { Published = True }
        Procedure AddUseFileExtension_CharacterModeBaseUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Use UI' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Use UI' sLine
            Move '    use ui  // the screen base' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '    use ui  // the screen base' sLine
            // positive control
            Move 'Use UiHelpers' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get AddUseFileExtension of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Use UiHelpers.pkg' sLine
        End_Procedure

    End_Object
