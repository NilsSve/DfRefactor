    Object oRemoveProjectObjectStructure is a cTestFixture
        Set psFunctionName to "RemoveProjectObjectStructure"

        // Blank line: bLineIsReady guard fires, line unchanged, return False.
        {Published = True}
        Procedure RemoveProjectObjectStructure_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '' to sLine
            Move '' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regular code line outside any register section must be kept, return False.
        {Published = True}
        Procedure RemoveProjectObjectStructure_NoMatch
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move x to y" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move x to y" sLine
        End_Procedure

        // Register_Object line whose object name is in pasObjectNames must be removed.
        {Published = True}
        Procedure RemoveProjectObjectStructure_RegisterObjectRemoved
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            String[] asObjectNames
            Move "omainwindow" to asObjectNames[0]
            Set pasObjectNames of ghoFuncLib to asObjectNames
            Set pbRegisterAllObjectsStart of ghoFuncLib to True
            Move "Register_Object oMainWindow" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual "" sLine
        End_Procedure

        // Register_Object line whose object name is NOT in pasObjectNames must be kept.
        {Published = True}
        Procedure RemoveProjectObjectStructure_RegisterObjectKept
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            String[] asObjectNames
            Move "omainwindow" to asObjectNames[0]
            Set pasObjectNames of ghoFuncLib to asObjectNames
            Set pbRegisterAllObjectsStart of ghoFuncLib to True
            Move "Register_Object oUnknown" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Register_Object oUnknown" sLine
        End_Procedure

        /* The extractor on its own - no caller, no tokenizer state. Splits the two halves of the
           2026-08-07 failure: this one stayed GREEN throughout, which is what proved the name
           parsing was fine and sent the hunt to the caller's guard instead. */
        {Published = True}
        Procedure RemoveProjectObjectStructure_ExtractorAlone
            String sLine
            Boolean bKeep
            String[] asNames
            Move "//   Customer_vw is a dbView" to sLine
            Get IsProjectObjectStructureLine of ghoFuncLib sLine (&asNames) to bKeep
            Send Assert (bKeep = False) "a '// X is a Y' tree line should not be kept"
            Send AssertIAreEqual 1 (SizeOfArray(asNames))
            Send AssertSAreEqual "customer_vw" asNames[0]
        End_Procedure

        /* THE WHOLE BLOCK, in file order - which nothing above this actually tested.

           The two Register_Object tests set pbRegisterAllObjectsStart and pasObjectNames BY HAND,
           so IsProjectObjectStructureStart and IsProjectObjectStructureLine - the pair that reads
           the comment tree and BUILDS that name list - were never run end to end. Four green tests
           and the function still did nothing on a real file (Nils 2026-08-07, customer.vw).

           This walks the real shape: the marker, an indented tree line, the "Register all objects"
           marker, then a Register_Object naming an object the tree declared. Every line goes
           through Tokenizer first, exactly as the engine drives it - which is what made it fail:
           the Tokenizer flags a comment line bLineIsReady, and the function bailed on that. */
        {Published = True}
        Procedure RemoveProjectObjectStructure_WholeBlockInFileOrder
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            String[] asNames

            // 1. the block header - removed, and it opens the block
            Move "// Project Object Structure" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged "the '// Project Object Structure' header line should be removed"

            // 2. an INDENTED tree line - removed, and its object name is collected
            Move "//   Customer_vw is a dbView" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged "an indented '// X is a Y' tree line should be removed"
            Get pasObjectNames of ghoFuncLib to asNames
            Send Assert (SizeOfArray(asNames) > 0) ;
                "the tree line should have contributed its object name to pasObjectNames"
            // The NAME as well as the count: a name stored with the comment marker or the indent
            // still attached would look collected and never match a Register_Object line.
            Send AssertIAreEqual 1 (SizeOfArray(asNames))
            Send AssertSAreEqual "customer_vw" asNames[0]

            // 3. the second marker - the Register_Object run starts here
            Move "// Register all objects" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged "the '// Register all objects' line should be removed"

            // 4. ...and a Register_Object for an object the TREE declared goes with it
            Move "Register_Object Customer_vw" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get RemoveProjectObjectStructure of ghoFuncLib (&sLine) "" to bChanged
            Send Assert bChanged ;
                "Register_Object for an object named in the tree should be removed"
        End_Procedure

    End_Object
