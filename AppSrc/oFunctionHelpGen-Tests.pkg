//****************************************************************************
// $Module type: Test fixture
// $Module name: oFunctionHelpGen-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-24
//
// Description : Unit tests for _DescriptionParagraphs (cRefactorFuncLib) - the rule that turns a wrapped
//               { Description } back into markdown paragraphs for the generated function help.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oFunctionHelpGen is a cTestFixture
        Set psFunctionName to "GenerateFunctionHelp"

        // A sentence wrapped across two source lines is ONE paragraph: the first line does not end
        // a sentence and the second starts lower-case. This is the common case in the library, and
        // getting it wrong made the first generated draft read as if it were cut in half.
        {Published = True}
        Procedure FunctionHelpGen_JoinsAWrappedSentence
            String[] asOut
            String sIn sLF
            Move (Character(10)) to sLF
            Move ("Aligns a name declared with more than one type - the 4544 fix" + sLF + ;
                  "for a name that nothing outside the workspace owns.") to sIn
            Get _DescriptionParagraphs of ghoFuncLib sIn to asOut
            Send AssertIAreEqual 1 (SizeOfArray(asOut))
            Send Assert (asOut[0] contains "4544 fix for a name")
        End_Procedure

        // Ending punctuation starts a new paragraph even when the next line begins lower-case -
        // 'sParameter' is the case that made a lower-case-only rule wrong.
        {Published = True}
        Procedure FunctionHelpGen_PunctuationBreaksEvenBeforeLowerCase
            String[] asOut
            String sIn sLF
            Move (Character(10)) to sLF
            Move ("...where renaming would change nothing." + sLF + ;
                  "sParameter is 'Name=Type'.") to sIn
            Get _DescriptionParagraphs of ghoFuncLib sIn to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
        End_Procedure

        // A capitalised start breaks the paragraph even with no ending punctuation - the case that
        // made a punctuation-only rule wrong, because an example line can end in a variable name.
        {Published = True}
        Procedure FunctionHelpGen_CapitalStartBreaksWithoutPunctuation
            String[] asOut
            String sIn sLF
            Move (Character(10)) to sLF
            Move ("Example: Sysdate dToday -> Move (Date(CurrentDateTime())) to dToday" + sLF + ;
                  "The rarer date and time form is left alone.") to sIn
            Get _DescriptionParagraphs of ghoFuncLib sIn to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            Send Assert (asOut[1] contains "The rarer")
        End_Procedure

        // A blank line always ends a paragraph, and empty input yields nothing rather than one
        // empty paragraph - the generated file would otherwise carry a stray blank entry.
        {Published = True}
        Procedure FunctionHelpGen_BlankLinesAndEmptyInput
            String[] asOut
            String sIn sLF
            Move (Character(10)) to sLF
            Move ("first line here" + sLF + sLF + "second block here") to sIn
            Get _DescriptionParagraphs of ghoFuncLib sIn to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            Get _DescriptionParagraphs of ghoFuncLib "" to asOut
            Send AssertIAreEqual 0 (SizeOfArray(asOut))
        End_Procedure

    End_Object
