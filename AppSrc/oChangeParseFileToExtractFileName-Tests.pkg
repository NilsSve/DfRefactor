//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeParseFileToExtractFileName-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-29
//
// Description : Unit tests for ChangeParseFileToExtractFileName - the line-by-line
//               (eStandardFunction) refactor that renames the obsolete global
//                 Parse_File(x) -> ExtractFileName(x)
//
//               Each test sets one source line, tokenizes it (Get Tokenizer ... populates the
//               funclib's pTokenizer, which the function reads for the masked overstrike), then
//               calls the function and checks the result. The rename is whole-word and masked,
//               so an already-converted call, a call inside a string literal, a comment, and the
//               near-miss sibling Parse_Path are all left alone.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeParseFileToExtractFileName is a cTestFixture
        Set psFunctionName to "ChangeParseFileToExtractFileName"

        // The ordinary call.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_Renamed
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Move (Parse_File(sSpec)) to sName" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual "    Move (ExtractFileName(sSpec)) to sName" sLine
        End_Procedure

        /* THE COMMAND FORM, which is the shape real code actually uses. All five call sites in
           Nils's workspace look like this, with no parentheses anywhere:

               Get Parse_File  sFilename   to sFilename

           The first cut of this converter used only the paren-form renamer, so it matched none of
           them: the analyzer listed the files, the plan ran, and the log said "0 lines". Extra
           spacing is preserved, because only the NAME is spliced. */
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_GetCommandForm_Renamed
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "                    Get Parse_File  sFilename   to sFilename" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual "                    Get ExtractFileName  sFilename   to sFilename" sLine
        End_Procedure

        // The command form only counts in the SECOND token of a Get. The same name as an argument
        // or a destination is a variable, not the function being called.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_NameAsArgument_Untouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Get SomeOtherFn Parse_File to sName" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual "    Get SomeOtherFn Parse_File to sName" sLine
        End_Procedure

        // Case-insensitive, like every other call rename in the library.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_LowerCase_Renamed
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Move (parse_file(sSpec)) to sName" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = True)
            Send AssertSAreEqual "    Move (ExtractFileName(sSpec)) to sName" sLine
        End_Procedure

        // THE SIBLING THAT MUST NOT BE TOUCHED. Parse_Path is NOT equivalent to
        // ExtractFilePath (drive and trailing separator both differ, and it probes the
        // disk), so no converter may rewrite it - see the note in oRefactorFuncLib.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_ParsePath_Untouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Move (Parse_Path(sSpec)) to sPath" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual "    Move (Parse_Path(sSpec)) to sPath" sLine
        End_Procedure

        // Already modern - nothing to do, and no double rename.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_AlreadyModern_Untouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Move (ExtractFileName(sSpec)) to sName" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual "    Move (ExtractFileName(sSpec)) to sName" sLine
        End_Procedure

        // Inside a string literal the name is data, not a call.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_InLiteral_Untouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    Move "Parse_File is obsolete" to sMsg' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual '    Move "Parse_File is obsolete" to sMsg' sLine
        End_Procedure

        // A longer identifier that merely CONTAINS the name is not a match.
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_LongerName_Untouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Send ClearFuncLibProperties of ghoFuncLib
            Move "    Move (Parse_FileSpec(sSpec)) to sName" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeParseFileToExtractFileName of ghoFuncLib (&sLine) "" to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual "    Move (Parse_FileSpec(sSpec)) to sName" sLine
        End_Procedure

        /* A meta-tag block belongs to the NEXT Function in the file, so a new function
           spliced between another function's tags and its declaration STEALS them.

           Not hypothetical - it happened while adding this one. Two ModAnalyzer tests
           failed and the diagnostic said the recipe matching "use of ToOEM" carried
           sRefactorFn = "ChangeParseFileToExtractFileName": the right match text
           bolted to the wrong function. Two confident guesses (a brace-tag inside a
           comment, then a doubled quote in the Description) were both wrong and cost a
           build each; printing the actual value found it immediately.

           So this asserts the PAIRING, not just that each recipe exists - the failure
           mode is precisely a tag pointing at its neighbour. */
        {Published = True}
        Procedure ChangeParseFileToExtractFileName_MetaTagsNotStolenFromNeighbour
            Handle ho
            tModAnalyzer Recipe
            tModAnalyzer[] aRecipes
            Get Create (RefClass(cModAnalyzer)) to ho
            Get BuildDefaultRecipes of ho to aRecipes
            Get ClassifyFromRecipes of ho 4534 "Obsolete Global Function: PARSE_FILE" aRecipes to Recipe
            Send AssertSAreEqual "ChangeParseFileToExtractFileName" Recipe.sRefactorFn
            Get ClassifyFromRecipes of ho 4534 "Obsolete use of ToOEM, use Utf8ToOem or AnsiToUtf8 instead." aRecipes to Recipe
            Send AssertSAreEqual "UnicodeOemAnsiFunctions" Recipe.sRefactorFn
            Send Destroy of ho
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
