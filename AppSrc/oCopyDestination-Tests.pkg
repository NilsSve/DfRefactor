//****************************************************************************
// $Module type: Test fixture
// $Module name: oCopyDestination-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-10-31
//
// Description : Unit tests for the two things the migration copy dialog (SelectCopyScopeFT's DoConfirm) asks
//               about before it copies a workspace: is there a workspace file in a folder above the
//               destination (WorkspaceFileAbove), and is the destination's own name one of a workspace's own
//               folders - Data, Programs ... (IsWorkspaceFolderName).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorFileIO.pkg           // rfDirectoryCreateEx / rfRemoveFolderTree / rfOpenOutput
    Object oCopyDestination_Tests is a cTestFixture
        Set psFunctionName to "WorkspaceFileAbove"

        // A one-line workspace file at sFile.
        Procedure _WriteSws String sFile
            Integer iCh
            Move (rfOpenOutput(sFile)) to iCh
            If (iCh <> DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
                Writeln channel iCh "[WorkspacePaths]"
                Send rfCloseOutput iCh
            End
        End_Procedure

        {Published = True}
        Procedure CopyDestination_WorkspaceFileAbove
            // The 2026-10-05 copy, on a folder tree in the Windows TEMP folder: a new folder Programs inside the
            // folder of an older copy that holds its .sws - found, with a trailing separator and further down
            // too; the nearest workspace file wins; the folder itself is not looked in. A folder with no workspace
            // above it in the tree answers what the tree's own folder answers - a folder above the TEMP folder
            // could hold one.
            String sRoot sOutside sFound
            Boolean bOk

            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_CopyDestination\") to sRoot
            Move (rfRemoveFolderTree(sRoot)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "LegacyApp5\Inner\"), False)) to bOk
            Move (rfDirectoryCreateEx((sRoot + "Plain\Sub\"), False)) to bOk
            Send Assert bOk "the fixture: the folders"
            Send _WriteSws (sRoot + "LegacyApp5\LegacyApp5_20.sws")
            Send _WriteSws (sRoot + "LegacyApp5\Inner\Inner.sws")

            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "LegacyApp5\Programs") to sFound
            Send Assert (sFound = (sRoot + "LegacyApp5\LegacyApp5_20.sws")) ("a new Programs folder in an older copy's folder: '" + sFound + "'")
            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "LegacyApp5\Programs\") to sFound
            Send Assert (sFound = (sRoot + "LegacyApp5\LegacyApp5_20.sws")) ("with a trailing separator: '" + sFound + "'")
            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "LegacyApp5\Programs\New\Deeper") to sFound
            Send Assert (sFound = (sRoot + "LegacyApp5\LegacyApp5_20.sws")) ("further down: '" + sFound + "'")
            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "LegacyApp5\Inner\Copy") to sFound
            Send Assert (sFound = (sRoot + "LegacyApp5\Inner\Inner.sws")) ("the nearest wins: '" + sFound + "'")
            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "LegacyApp5\Inner") to sFound
            Send Assert (sFound = (sRoot + "LegacyApp5\LegacyApp5_20.sws")) ("the folder itself is not looked in: '" + sFound + "'")

            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "Plain") to sOutside
            Send Assert (Left(Lowercase(sOutside), Length(sRoot)) <> Lowercase(sRoot)) ("nothing in the tree above Plain: '" + sOutside + "'")
            Get WorkspaceFileAbove of ghoFuncLib (sRoot + "Plain\Sub\New") to sFound
            Send Assert (sFound = sOutside) ("no workspace above Plain\Sub\New in the tree: '" + sFound + "'")
            Move (rfRemoveFolderTree(sRoot)) to bOk
        End_Procedure

        {Published = True}
        Procedure CopyDestination_WorkspaceFolderName
            // Only the destination's own name counts, in any case, with or without a trailing separator.
            Boolean bName
            Get IsWorkspaceFolderName of ghoFuncLib "E:\LegacyApp5\Programs" to bName
            Send Assert (bName = True) "E:\LegacyApp5\Programs"
            Get IsWorkspaceFolderName of ghoFuncLib "E:\LegacyApp5\programs\" to bName
            Send Assert (bName = True) "lower case, with a trailing separator"
            Get IsWorkspaceFolderName of ghoFuncLib "D:\Data" to bName
            Send Assert (bName = True) "D:\Data"
            Get IsWorkspaceFolderName of ghoFuncLib "E:\Copies\Bitmaps" to bName
            Send Assert (bName = True) "Bitmaps"
            Get IsWorkspaceFolderName of ghoFuncLib "E:\LegacyApp5 DF26" to bName
            Send Assert (bName = False) "the suggested kind of name"
            Get IsWorkspaceFolderName of ghoFuncLib "D:\My Data" to bName
            Send Assert (bName = False) "a name that only holds one"
            Get IsWorkspaceFolderName of ghoFuncLib "E:\Programs\LegacyApp5" to bName
            Send Assert (bName = False) "a folder above it named Programs"
            Get IsWorkspaceFolderName of ghoFuncLib "" to bName
            Send Assert (bName = False) "no folder"
        End_Procedure

    End_Object
