    Object oMacroCodeGuard is a cTestFixture
        Set psFunctionName to "MacroCodeGuard"

        /* THE RULE: macro code is never refactored (Nils, 2026-09-07) - see the macro-code guard in cRefactorFuncLib. The exclamation
           mark is built with Character(33) in every fixture string: the compiler reads a literal one followed
           by a digit or a '$' as macro syntax even inside a string. */

        {Published = True}
        { Description = "#COMMAND..#ENDCOMMAND bodies, #DATA..#ENDDATA blocks and directive lines are macro code; preprocessor lines, comments and code are not" }
        Procedure MacroCodeGuard_FlagsTheRightLines
            String[] asSource
            Boolean[] abFlags
            String sBang
            Move (Character(33)) to sBang
            Move "#IFDEF SOMETHING"                                   to asSource[0]
            Move "  if a eq b move 1 to c"                            to asSource[1]
            Move "#Command MY_CMD"                                    to asSource[2]
            Move ("  " + sBang + "1 [ bFlag] move 2 to c")            to asSource[3]
            Move "  if x eq y move 3 to c"                            to asSource[4]
            Move "#EndCommand // done"                                to asSource[5]
            Move ("    " + sBang + "A [not bFlag] $1C4 iImg")         to asSource[6]
            Move ("  // " + sBang + "A a comment about a directive")  to asSource[7]
            Move "#DATA"                                              to asSource[8]
            Move "  1 2 3"                                            to asSource[9]
            Move "#ENDDATA"                                           to asSource[10]
            Move "  move 4 to c"                                      to asSource[11]
            Move (Character(9) + sBang + "e move 5 to c")             to asSource[12]
            Get MacroCodeFlags of ghoFuncLib (&asSource) to abFlags
            Send AssertIAreEqual 13 (SizeOfArray(abFlags))
            Send Assert (abFlags[0] = False)
            Send Assert (abFlags[1] = False)
            Send Assert (abFlags[2] = True)
            Send Assert (abFlags[3] = True)
            Send Assert (abFlags[4] = True)
            Send Assert (abFlags[5] = True)
            Send Assert (abFlags[6] = True)
            Send Assert (abFlags[7] = False)
            Send Assert (abFlags[8] = True)
            Send Assert (abFlags[9] = True)
            Send Assert (abFlags[10] = True)
            Send Assert (abFlags[11] = False)
            Send Assert (abFlags[12] = True)
        End_Procedure

        // Six lines: code, a three-line macro, a directive, code - four of them macro code.
        Procedure BuildSample String[] ByRef asSource
            String sBang
            Move (Character(33)) to sBang
            Move (ResizeArray(asSource, 0)) to asSource
            Move "  move 0 to iX"                                to asSource[0]
            Move "#COMMAND MY_CMD"                               to asSource[1]
            Move "  [ bFlag] move 1 to iX"                       to asSource[2]
            Move "#ENDCOMMAND"                                   to asSource[3]
            Move ("    " + sBang + "A [not bFlag] $1C4 iImg")    to asSource[4]
            Move "  move 2 to iX"                                to asSource[5]
        End_Procedure

        {Published = True}
        { Description = "Mask then unmask with nothing in between gives the file back byte for byte" }
        Procedure MacroCodeGuard_MaskUnmaskRoundTrip
            String[] asSource asOrig asSaved
            Integer[] aiIdx
            Integer iMasked iBack iLost i
            Send BuildSample (&asSource)
            Move asSource to asOrig
            Get MaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) to iMasked
            Send AssertIAreEqual 4 iMasked
            Send AssertIAreEqual 6 (SizeOfArray(asSource))
            Send Assert (asSource[1] <> asOrig[1])
            Send Assert (Left(Trim(asSource[4]), 2) = "//")
            Send AssertSAreEqual asOrig[0] asSource[0]
            Send AssertSAreEqual asOrig[5] asSource[5]
            Get UnmaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 4 iBack
            Send AssertIAreEqual 0 iLost
            For i from 0 to 5
                Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
        End_Procedure

        {Published = True}
        { Description = "A sentinel the function re-indented still comes back as the original line, original indentation included" }
        Procedure MacroCodeGuard_UnmaskSurvivesReindent
            String[] asSource asOrig asSaved
            Integer[] aiIdx
            Integer iMasked iBack iLost
            Send BuildSample (&asSource)
            Move asSource to asOrig
            Get MaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) to iMasked
            Move ("            " + Trim(asSource[4])) to asSource[4]
            Move (Trim(asSource[2])) to asSource[2]
            Get UnmaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 4 iBack
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual asOrig[4] asSource[4]
            Send AssertSAreEqual asOrig[2] asSource[2]
        End_Procedure

        {Published = True}
        { Description = "Lines a function inserted before the macro code shift it; the originals are still put back where the sentinels are" }
        Procedure MacroCodeGuard_UnmaskSurvivesInsertedLines
            String[] asSource asOrig asSaved asShifted
            Integer[] aiIdx
            Integer iMasked iBack iLost i
            Send BuildSample (&asSource)
            Move asSource to asOrig
            Get MaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) to iMasked
            Move "Global_Variable Boolean gbFlag" to asShifted[0]
            Move "Move False to gbFlag"           to asShifted[1]
            For i from 0 to 5
                Move asSource[i] to asShifted[i + 2]
            Loop
            Get UnmaskMacroCode of ghoFuncLib (&asShifted) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 4 iBack
            Send AssertIAreEqual 0 iLost
            Send AssertIAreEqual 8 (SizeOfArray(asShifted))
            Send AssertSAreEqual "Global_Variable Boolean gbFlag" asShifted[0]
            For i from 0 to 5
                Send AssertSAreEqual asOrig[i] asShifted[i + 2]
            Loop
        End_Procedure

        {Published = True}
        { Description = "A sentinel the function deleted has its macro line re-inserted at the original index and counted as lost" }
        Procedure MacroCodeGuard_UnmaskReinsertsADeletedLine
            String[] asSource asOrig asSaved
            Integer[] aiIdx
            Integer iMasked iBack iLost
            Send BuildSample (&asSource)
            Move asSource to asOrig
            Get MaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) to iMasked
            Move (RemoveFromArray(asSource, 4)) to asSource        // the directive's sentinel is gone
            Send AssertIAreEqual 5 (SizeOfArray(asSource))
            Get UnmaskMacroCode of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 3 iBack
            Send AssertIAreEqual 1 iLost
            Send AssertIAreEqual 6 (SizeOfArray(asSource))
            Send AssertSAreEqual asOrig[4] asSource[4]
            Send AssertSAreEqual asOrig[5] asSource[5]
        End_Procedure

        {Published = True}
        { Description = "Write guard, same line count: a changed macro line is put back and the pass's other changes stay" }
        Procedure MacroCodeGuard_WriteGuardRestoresByIndex
            String[] asOld asNew
            Integer iBack iFirst
            String sBang
            Move (Character(33)) to sBang
            Send BuildSample (&asOld)
            Move asOld to asNew
            Move ("    " + sBang + "A [not gbbFlag] $1C4 iImg") to asNew[4]     // the pass renamed inside the directive
            Move "  [ gbbFlag] move 1 to iX"                    to asNew[2]     // and inside the macro body
            Move "  Move 2 to iX"                               to asNew[5]     // a legitimate change
            Get GuardMacroCodeOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual 2 iBack
            Send AssertIAreEqual 0 iFirst
            Send AssertSAreEqual asOld[4] asNew[4]
            Send AssertSAreEqual asOld[2] asNew[2]
            Send AssertSAreEqual "  Move 2 to iX" asNew[5]
        End_Procedure

        {Published = True}
        { Description = "Write guard, different line count: macro lines present verbatim elsewhere are accepted" }
        Procedure MacroCodeGuard_WriteGuardAcceptsMovedLines
            String[] asOld asNew
            Integer iBack iFirst i
            Send BuildSample (&asOld)
            Move "Use cApplication.pkg" to asNew[0]
            For i from 0 to 5
                Move asOld[i] to asNew[i + 1]
            Loop
            Get GuardMacroCodeOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual 0 iBack
            Send AssertIAreEqual 0 iFirst
            Send AssertIAreEqual 7 (SizeOfArray(asNew))
        End_Procedure

        {Published = True}
        { Description = "Write guard, different line count and a macro line changed: refused, naming the first such line" }
        Procedure MacroCodeGuard_WriteGuardRefusesWhenLost
            String[] asOld asNew
            Integer iBack iFirst i
            String sBang
            Move (Character(33)) to sBang
            Send BuildSample (&asOld)
            Move "Use cApplication.pkg" to asNew[0]
            For i from 0 to 5
                Move asOld[i] to asNew[i + 1]
            Loop
            Move ("    " + sBang + "A [not gbbFlag] $1C4 iImg") to asNew[5]
            Get GuardMacroCodeOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual -1 iBack
            Send AssertIAreEqual 5 iFirst
        End_Procedure

        /* THE WHOLE-FILE PASS THAT BROKE THE RULE, under the engine's masking. DeclareRefactoredIndicators shims
           an undeclared named indicator as a gb Boolean and renames its whole-word uses across the file - macro
           body and directive included, as a plan did to a report package (4314 twice). The control run shows
           the pass would do it; the masked run shows the macro lines come back untouched. */
        {Published = True}
        { Description = "Masked around DeclareRefactoredIndicators, a macro body and a directive line come back byte for byte" }
        Procedure MacroCodeGuard_WholeFilePassLeavesMacroCode
            String[] asOrig asCode asControl asSaved asEmpty
            Integer[] aiIdx
            Integer iMasked iBack iLost iChanged
            String sBang
            Move (Character(33)) to sBang
            // The file as loaded (the pass reads this pre-conversion snapshot from the engine).
            Move "#COMMAND MY_CMD"                               to asOrig[0]
            Move "  [ iflag] move 1 to iX"                       to asOrig[1]
            Move "#ENDCOMMAND"                                   to asOrig[2]
            Move ("    " + sBang + "A [not iflag] $1C4 iImg")    to asOrig[3]
            Move "  indicate iflag true"                         to asOrig[4]
            Move "  if [iflag] move 2 to iX"                     to asOrig[5]
            // After the line pass: the macro lines untouched (the rule), the rest converted and gb-prefixed.
            Move asOrig to asCode
            Move "  Move (True) to gbiflag"                      to asCode[4]
            Move "  If (gbiflag) move 2 to iX"                   to asCode[5]
            Set pasOriginalSource of ghoEngine to asOrig
            Set pasPinnedIndicators of ghoFuncLib to asEmpty
            // Control: the pass alone renames the raw name inside the directive line.
            Move asCode to asControl
            Send ClearFuncLibProperties of ghoFuncLib
            Get DeclareRefactoredIndicators of ghoFuncLib (&asControl) "" to iChanged
            Send Assert ((SearchArray(asOrig[3], asControl)) = -1)
            // Guarded: masked before, put back after - what the engine does around every whole-file function.
            Send ClearFuncLibProperties of ghoFuncLib
            Get MaskMacroCode of ghoFuncLib (&asCode) (&asSaved) (&aiIdx) to iMasked
            Send AssertIAreEqual 4 iMasked
            Get DeclareRefactoredIndicators of ghoFuncLib (&asCode) "" to iChanged
            Get UnmaskMacroCode of ghoFuncLib (&asCode) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 4 iBack
            Send AssertIAreEqual 0 iLost
            Send Assert ((SearchArray(asOrig[0], asCode)) >= 0)
            Send Assert ((SearchArray(asOrig[1], asCode)) >= 0)
            Send Assert ((SearchArray(asOrig[2], asCode)) >= 0)
            Send Assert ((SearchArray(asOrig[3], asCode)) >= 0)
            // ... while the pass still did its own job on the code it may touch.
            Send Assert ((SearchArray("#IFNDEF gbiflag", asCode)) >= 0)
            Set pasOriginalSource of ghoEngine to asEmpty
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        /* THE FILE'S OWN LINE BREAK, not the platform's. This is the write path for whole-file passes,
           and it used to hand the writer a literal C_NewLine - so a pass over an LF-only source retyped
           every line to CRLF, which shows up as a whole-file diff with the real edit buried in it.
           LF-only DataFlex sources are real: this repo's own RefactorConstants.h.pkg is one.

           Asserted on the file's SIZE because the array can express neither a terminator nor a break
           style - an array comparison passes either way and proves nothing. One CR per line is exactly
           what the old literal added, so the size IS the claim. No macro code in the fixture, so the
           guard passes every line through and what is measured is purely the write. */
        {Published = True}
        Procedure GuardedWrite_KeepsAnLfOnlyFileLf
            Boolean bOk
            Integer iVoid iSizeBefore iSizeAfter
            String sDataPath sTempFile
            String[] asCode
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_GuardLf.tmp") to sTempFile
            Move "Use SQL.pkg"      to asCode[0]
            Move "Set x to True"    to asCode[1]
            Move "Send DoSomething" to asCode[2]
            // An LF-only file with a trailing LF, written by the tested writer itself.
            Get rfWriteEncodedFileFromStringArrayEx (&asCode) sTempFile CS_LF False True to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iSizeBefore
            Get _GuardedWriteEncodedFile of ghoFuncLib sTempFile (&asCode) False to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iSizeAfter
            Send AssertIAreEqual iSizeBefore iSizeAfter
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* POSITIVE CONTROL: a CRLF file must stay CRLF. The fix reads the file's own break rather than
           forcing either one, so this half would pass even with the defect present - it is here to show
           the LF test above is not passing because the writer stopped writing breaks altogether. */
        {Published = True}
        Procedure GuardedWrite_KeepsACrlfFileCrlf
            Boolean bOk
            Integer iVoid iSizeBefore iSizeAfter
            String sDataPath sTempFile
            String[] asCode
            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (sDataPath + "_GuardCrLf.tmp") to sTempFile
            Move "Use SQL.pkg"      to asCode[0]
            Move "Set x to True"    to asCode[1]
            Move "Send DoSomething" to asCode[2]
            Get rfWriteEncodedFileFromStringArrayEx (&asCode) sTempFile C_NewLine False True to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iSizeBefore
            Get _GuardedWriteEncodedFile of ghoFuncLib sTempFile (&asCode) False to bOk
            Send Assert bOk
            Move (rfFileSize(sTempFile)) to iSizeAfter
            // Unchanged means it stayed CRLF: retyping these 3 lines to LF would drop 3 bytes.
            Send AssertIAreEqual iSizeBefore iSizeAfter
            Move (rfDeleteFile(sTempFile)) to iVoid
        End_Procedure

        /* A DF 23 MULTI-LINE STRING'S TEXT AND A #HEADER REGION ARE KEPT AS WRITTEN, masked like macro code
           under their own sentinel (2026-10-29; cRefactorFuncLib's KeptTextFlags / MaskKeptText / RunWholeFileFunction
           and the write-time _GuardKeptTextOnWrite). */
        Procedure BuildKeptSample String[] ByRef asSource
            String sBang
            Move (Character(33)) to sBang
            Move (ResizeArray(asSource, 0)) to asSource
            Move '#HEADER'                                   to asSource[0]
            Move 'Use cFoo'                                  to asSource[1]
            Move '#ENDHEADER'                                to asSource[2]
            Move 'Procedure P'                               to asSource[3]
            Move '    Move """'                              to asSource[4]
            Move '        Use cBar'                          to asSource[5]
            Move ''                                          to asSource[6]
            Move ''                                          to asSource[7]
            Move ('        ' + sBang + 'A text')             to asSource[8]
            Move '    """ to sX'                             to asSource[9]
            Move '    /* a """'                              to asSource[10]
            Move '    */'                                    to asSource[11]
            Move ''                                          to asSource[12]
            Move ''                                          to asSource[13]
            Move '    Move 1 to iX'                          to asSource[14]
            Move 'End_Procedure'                             to asSource[15]
        End_Procedure

        {Published = True}
        { Description = "A #HEADER region and a multi-line string's text are kept; its opening and closing lines, a block comment, code and a macro line are not" }
        Procedure KeptText_FlagsTheRightLines
            String[] asSource
            Boolean[] abKeep abWithCloser
            Integer i
            Send BuildKeptSample (&asSource)
            Get KeptTextFlags of ghoFuncLib (&asSource) False to abKeep
            Get KeptTextFlags of ghoFuncLib (&asSource) True to abWithCloser
            Send AssertIAreEqual 16 (SizeOfArray(abKeep))
            For i from 0 to 15
                Send Assert (abKeep[i] = (i <= 2 or (i >= 5 and i <= 7))) ("line" * String(i))
                Send Assert (abWithCloser[i] = (abKeep[i] or i = 9)) ("line" * String(i) * "with the closing line")
            Loop
        End_Procedure

        {Published = True}
        { Description = "Mask then unmask kept text gives the file back byte for byte; a deleted sentinel's line is put back where it was" }
        Procedure KeptText_MaskUnmaskRoundTrip
            String[] asSource asOrig asSaved
            Integer[] aiIdx
            Integer iMasked iBack iLost i
            Send BuildKeptSample (&asSource)
            Move asSource to asOrig
            Get MaskKeptText of ghoFuncLib (&asSource) False (&asSaved) (&aiIdx) to iMasked
            Send AssertIAreEqual 6 iMasked
            For i from 0 to 15
                Send Assert ((Left(asSource[i], Length(CS_KeptTextSentinel)) = CS_KeptTextSentinel) = (i <= 2 or (i >= 5 and i <= 7))) ("line" * String(i))
            Loop
            Get UnmaskKeptText of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 6 iBack
            Send AssertIAreEqual 0 iLost
            For i from 0 to 15
                Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
            // A function that deleted a masked line - a blank one in the string's text
            Get MaskKeptText of ghoFuncLib (&asSource) False (&asSaved) (&aiIdx) to iMasked
            Move (RemoveFromArray(asSource, 7)) to asSource
            Get UnmaskKeptText of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 5 iBack
            Send AssertIAreEqual 1 iLost
            Send AssertIAreEqual 16 (SizeOfArray(asSource))
            For i from 0 to 15
                Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
        End_Procedure

        /* THE ENGINE'S CALL, around a function that changes text it has no business in: RemoveMultipleBlankLines
           drops the second of two blank lines wherever they are. Called on its own it shortens the string; called
           as the engine calls it the string keeps both, the macro line inside the string comes back too, and the
           two blank lines in the code still become one. */
        {Published = True}
        { Description = "RunWholeFileFunction keeps a string's text, a #HEADER region and a macro line, and the function still changes the code" }
        Procedure KeptText_RunWholeFileFunctionKeepsTheText
            String[] asSource asControl asOrig
            Integer iRetval iMacro iLost i iFn
            Send BuildKeptSample (&asSource)
            Move asSource to asOrig
            Move asSource to asControl
            Send ClearFuncLibProperties of ghoFuncLib
            Get RemoveMultipleBlankLines of ghoFuncLib (&asControl) "1" to iRetval
            Send AssertIAreEqual 14 (SizeOfArray(asControl))
            Send ClearFuncLibProperties of ghoFuncLib
            Move (Eval("get_RemoveMultipleBlankLines")) to iFn
            Get RunWholeFileFunction of ghoFuncLib iFn (&asSource) "1" (&iMacro) (&iLost) to iRetval
            Send AssertIAreEqual 1 iMacro
            Send AssertIAreEqual 0 iLost
            Send AssertIAreEqual 15 (SizeOfArray(asSource))
            For i from 0 to 12
                Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
            Send AssertSAreEqual asOrig[14] asSource[13]
            Send AssertSAreEqual asOrig[15] asSource[14]
        End_Procedure

        {Published = True}
        { Description = "Write guard, same line count: a changed string text or #HEADER line is put back and the pass's other changes stay" }
        Procedure KeptText_WriteGuardRestoresByIndex
            String[] asOld asNew
            Integer iBack iFirst
            Send BuildKeptSample (&asOld)
            Move asOld to asNew
            Move 'Use cFoo.pkg'          to asNew[1]     // the pass added the extension inside the #HEADER
            Move '        Use cBar.pkg'  to asNew[5]     // and inside the string
            Move '        '              to asNew[6]     // a blank text line got spaces - <> cannot see them
            Move '    Move 2 to iX'      to asNew[14]    // a legitimate change
            Get _GuardKeptTextOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual 3 iBack
            Send AssertIAreEqual 0 iFirst
            Send AssertSAreEqual asOld[1] asNew[1]
            Send AssertSAreEqual asOld[5] asNew[5]
            Send AssertIAreEqual 0 (Length(asNew[6]))
            Send AssertSAreEqual '    Move 2 to iX' asNew[14]
        End_Procedure

        {Published = True}
        { Description = "Write guard, different line count: kept lines in the same order are accepted; a dropped blank text line is refused" }
        Procedure KeptText_WriteGuardDifferentLineCount
            String[] asOld asNew
            Integer iBack iFirst
            Send BuildKeptSample (&asOld)
            // A line added in the code: the kept lines are all still there, in order
            Move (InsertInArray(asOld, 3, "Use cApplication.pkg")) to asNew
            Get _GuardKeptTextOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual 0 iBack
            Send AssertIAreEqual 0 iFirst
            // One of the string's two blank lines dropped: a search would still find a blank line somewhere
            Move (RemoveFromArray(asOld, 7)) to asNew
            Get _GuardKeptTextOnWrite of ghoFuncLib (&asOld) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual -1 iBack
            Send AssertIAreEqual 8 iFirst
        End_Procedure

        {Published = True}
        { Description = "A re-indented sentinel goes back to column 0; a comment that is not a sentinel stays where it is" }
        Procedure KeptText_UnindentSentinels
            String[] asCode
            Integer iN
            Move ("        " + CS_KeptTextSentinel + "0")    to asCode[0]
            Move ((Character(9)) + CS_MacroSentinel + "1")   to asCode[1]
            Move "        // a comment"                      to asCode[2]
            Move (CS_KeptTextSentinel + "2")                 to asCode[3]
            Get UnindentSentinels of ghoFuncLib (&asCode) to iN
            Send AssertIAreEqual 2 iN
            Send AssertSAreEqual (CS_KeptTextSentinel + "0") asCode[0]
            Send AssertSAreEqual (CS_MacroSentinel + "1")    asCode[1]
            Send AssertSAreEqual "        // a comment"      asCode[2]
        End_Procedure

        /* THE TEXT ON AN @-STRING'S OPENING AND CLOSING LINES (2026-10-29): only the text is masked - the code and
           the quotes stay, so the lines still open and close the string for every reader - and it comes back
           however the function changed the code on those lines. The write-time check does the same when the line
           count is kept. */
        {Published = True}
        { Description = "On an @-string's opening and closing lines only the text is masked, and it comes back while the code keeps the function's change" }
        Procedure KeptText_AtStringTextParts
            String[] asSource asOrig asSaved asNew
            Integer[] aiIdx
            Integer iMasked iBack iLost iFirst
            Move 'Procedure P'                                      to asSource[0]
            Move '    Move @"Object oA is a WinReport'              to asSource[1]
            Move '        Object oB is a WinReport'                 to asSource[2]
            Move '        Object oC is a WinReport" + @"Object oD'  to asSource[3]
            Move '        Object oE is a WinReport" to sText'       to asSource[4]
            Move '    Move """'                                     to asSource[5]
            Move '        Object oF is a WinReport'                 to asSource[6]
            Move '        """ to sText'                             to asSource[7]
            Move 'End_Procedure'                                    to asSource[8]
            Move asSource to asOrig
            Get MaskKeptText of ghoFuncLib (&asSource) False (&asSaved) (&aiIdx) to iMasked
            // The whole text lines 2 and 6, and four parts: after the quote on 1, both sides of 3, before it on 4
            Send AssertIAreEqual 6 iMasked
            Send Assert (Pos("WinReport", asSource[1]) = 0 and Left(asSource[1], 11) = '    Move @"') "the opening line's text"
            Send Assert (Pos("WinReport", asSource[3]) = 0 and Pos('" + @"', asSource[3]) > 0) "a closing line that opens the next string: both texts"
            Send Assert (Pos("WinReport", asSource[4]) = 0 and Right(asSource[4], 10) = '" to sText') "the closing line's text"
            Send AssertSAreEqual asOrig[5] asSource[5]
            Send AssertSAreEqual asOrig[7] asSource[7]
            // A function changes the code on the closing line: the text comes back and the change stays
            Move (Replace(" to sText", asSource[4], " to sOther")) to asSource[4]
            Get UnmaskKeptText of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 6 iBack
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual asOrig[1] asSource[1]
            Send AssertSAreEqual asOrig[2] asSource[2]
            Send AssertSAreEqual asOrig[3] asSource[3]
            Send AssertSAreEqual '        Object oE is a WinReport" to sOther' asSource[4]
            Send AssertSAreEqual asOrig[6] asSource[6]
            // The write-time check, same line count: a changed text part goes back, a changed code part stays
            Move asOrig to asNew
            Move '    Move @"Object oA is a cWinReport2'            to asNew[1]
            Move '        Object oE is a cWinReport2" to sOther'    to asNew[4]
            Get _GuardKeptTextOnWrite of ghoFuncLib (&asOrig) (&asNew) (&iFirst) to iBack
            Send AssertIAreEqual 2 iBack
            Send AssertSAreEqual asOrig[1] asNew[1]
            Send AssertSAreEqual '        Object oE is a WinReport" to sOther' asNew[4]
        End_Procedure

        /* A BLOCK COMMENT'S AND A REPORT IMAGE'S TEXT (2026-10-30), on a whole-file function's call: the lines wholly
           inside the comment and the image's text lines are masked whole; on the comment's opening and closing
           lines only the text, so the markers stay and the comment still opens and closes; the image's name line
           and its closing '/*' stay visible. The converter still changes the code after the comment. */
        {Published = True}
        { Description = "On a whole-file function's call a block comment's and a report image's text are masked and come back, and the code after them still converts" }
        Procedure KeptText_CommentAndImageText
            String[] asSource asOrig asSaved
            Integer[] aiIdx
            tLineInfo[] aInfo
            Integer iMasked iBack iLost iMacro iRetval iFn i
            Move '/* Object oA is a DFPanel'          to asSource[0]
            Move 'Object oB is a DFPanel'             to asSource[1]
            Move ''                                   to asSource[2]
            Move 'Object oC is a DFPanel */'          to asSource[3]
            Move 'Object oD is a DFPanel'             to asSource[4]
            Move 'End_Object'                         to asSource[5]
            Move '    /Body Resident'                 to asSource[6]
            Move 'Object oE is a DFPanel'             to asSource[7]
            Move '/*'                                 to asSource[8]
            Move '    /*'                             to asSource[9]
            Move '    */'                             to asSource[10]
            Move asSource to asOrig
            Get ScanSourceFile of ghoFuncLib (&asSource) to aInfo
            Get _MaskKeptTextOf of ghoFuncLib (&asSource) (&aInfo) False True (&asSaved) (&aiIdx) to iMasked
            // Whole lines 1, 2 and 7, and two parts: the text after the marker on 0 and before it on 3
            Send AssertIAreEqual 5 iMasked
            Send Assert (Left(asSource[0], 2) = "/*" and Pos("DFPanel", asSource[0]) = 0) "the opening line's text"
            Send Assert (Right(asSource[3], 2) = "*/" and Pos("DFPanel", asSource[3]) = 0) "the closing line's text"
            Send Assert (Left(asSource[1], Length(CS_KeptTextSentinel)) = CS_KeptTextSentinel) "a line inside the comment"
            Send Assert (Left(asSource[2], Length(CS_KeptTextSentinel)) = CS_KeptTextSentinel) "a blank line inside the comment"
            Send Assert (Left(asSource[7], Length(CS_KeptTextSentinel)) = CS_KeptTextSentinel) "the image's text"
            For i from 4 to 10
                If (i <> 7) ;
                    Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
            Get UnmaskKeptText of ghoFuncLib (&asSource) (&asSaved) (&aiIdx) (&iLost) to iBack
            Send AssertIAreEqual 5 iBack
            Send AssertIAreEqual 0 iLost
            For i from 0 to 10
                Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
            // The engine's call around a converter: the text comes back, the code after the comment converts
            Move asOrig to asSource
            Send ClearFuncLibProperties of ghoFuncLib
            Move (Eval("get_ChangeObsoleteClassNames")) to iFn
            Get RunWholeFileFunction of ghoFuncLib iFn (&asSource) "" (&iMacro) (&iLost) to iRetval
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual 'Object oD is a DfBasePanel' asSource[4]
            For i from 0 to 10
                If (i <> 4) ;
                    Send AssertSAreEqual asOrig[i] asSource[i]
            Loop
        End_Procedure

        /* A STRING'S TEXT IS NEVER A MACRO BLOCK (2026-10-29): measured on DataFlex 26, a #COMMAND or #DATA line in
           a multi-line string's text is text - it defines nothing and swallows nothing - so the code after the
           string is code. A directive line there is still flagged: the compiler reads the exclamation mark even
           inside a string. */
        {Published = True}
        { Description = "A #COMMAND or #DATA line in a multi-line string's text opens no macro block; the code after the string is code" }
        Procedure MacroCodeGuard_StringTextOpensNoMacroBlock
            String[] asSource
            tLineInfo[] aInfo
            Boolean[] abFlags
            String sBang
            Integer i
            Move (Character(33)) to sBang
            Move 'Procedure P'                              to asSource[0]
            Move '    Move """'                             to asSource[1]
            Move '        #COMMAND PROBE_CMD'               to asSource[2]
            Move ('        ' + sBang + 'A [] $1')           to asSource[3]
            Move '        """ to sText'                     to asSource[4]
            Move '    Move @"Start'                         to asSource[5]
            Move '        #DATA'                            to asSource[6]
            Move '        End" to sText'                    to asSource[7]
            Move "    Move @'Start"                         to asSource[8]
            Move '        #COMMAND PROBE_TWO'               to asSource[9]
            Move "        End' + @SQL'SELECT"               to asSource[10]
            Move '        #COMMAND PROBE_THREE'             to asSource[11]
            Move "        x' to sText"                      to asSource[12]
            Move '    Move 1 to iX'                         to asSource[13]
            Move 'End_Procedure'                            to asSource[14]
            Move '#COMMAND REAL_CMD'                        to asSource[15]
            Move ('    ' + sBang + 'A [] $2')               to asSource[16]
            Move '#ENDCOMMAND'                              to asSource[17]
            Get ScanSourceFile of ghoFuncLib (&asSource) to aInfo
            Send AssertIAreEqual 18 (SizeOfArray(aInfo))
            For i from 0 to 17
                Send Assert ((aInfo[i].eMacro <> MC_None) = (i = 3 or i >= 15)) ("macro, line" * String(i))
                Send Assert ((aInfo[i].eKind = LK_StringText or aInfo[i].eKind = LK_StringCloser) = ((i >= 2 and i <= 4) or (i >= 6 and i <= 7) or (i >= 9 and i <= 12))) ("string text, line" * String(i))
            Loop
            Send Assert (aInfo[3].eMacro = MC_Directive and aInfo[15].eMacro = MC_CommandBlock and aInfo[17].eMacro = MC_CommandBlock) "the kind of macro code"
            // The guard's own answer is the same walk's
            Get MacroCodeFlags of ghoFuncLib (&asSource) to abFlags
            Send Assert (abFlags[3] = True and abFlags[2] = False and abFlags[13] = False) "MacroCodeFlags"
        End_Procedure

        {Published = True}
        { Description = "Text in a block comment or a report image opens no string, so the macro code after it is still flagged; a string in a macro body is followed, and an #ENDCOMMAND in its text ends no block" }
        Procedure MacroCodeGuard_CommentedOpenerHidesNoMacro
            String[] asSource
            tLineInfo[] aInfo
            Integer i
            Move '/* Write the HTML as a string, like """'  to asSource[0]
            Move '   or an @"open one'                      to asSource[1]
            Move '*/'                                       to asSource[2]
            Move '#COMMAND REAL_ONE'                        to asSource[3]
            Move '#ENDCOMMAND'                              to asSource[4]
            Move '    /Body'                                to asSource[5]
            Move '    Total """'                            to asSource[6]
            Move '/*'                                       to asSource[7]
            Move '#COMMAND REAL_TWO'                        to asSource[8]
            Move '    Move """'                             to asSource[9]
            Move '#ENDCOMMAND'                              to asSource[10]
            Move '    """'                                  to asSource[11]
            Move '#ENDCOMMAND'                              to asSource[12]
            Move '#DATA'                                    to asSource[13]
            Move '#ENDDATA'                                 to asSource[14]
            Move '    Move 1 to iX'                         to asSource[15]
            Get ScanSourceFile of ghoFuncLib (&asSource) to aInfo
            For i from 0 to 15
                Send Assert ((aInfo[i].eMacro <> MC_None) = ((i >= 3 and i <= 4) or (i >= 8 and i <= 14))) ("macro, line" * String(i))
                Send Assert ((aInfo[i].eKind = LK_StringText or aInfo[i].eKind = LK_StringCloser) = (i = 10 or i = 11)) ("string text, line" * String(i))
            Loop
            Send Assert (aInfo[0].eKind = LK_BlockComment and aInfo[1].eKind = LK_BlockComment and aInfo[6].eKind = LK_Image) "the comment and the image"
        End_Procedure

        /* THE ENGINE'S CALL: until 2026-10-29 the #COMMAND line in the string's text made every line after it macro
           code, to the end of the file, so the class name after the string was masked away from the converter and
           never changed. */
        {Published = True}
        { Description = "A whole-file function converts the code after a string whose text holds a #COMMAND line, and keeps the text" }
        Procedure MacroCodeGuard_CodeAfterTheStringIsConverted
            String[] asSource asOrig
            Integer iRetval iMacro iLost iFn
            Move 'Object oY is a DFPanel'                   to asSource[0]
            Move '    Set psHtml to """'                    to asSource[1]
            Move '        #COMMAND PROBE_CMD'               to asSource[2]
            Move '        Object oX is a DFPanel'           to asSource[3]
            Move '        """'                              to asSource[4]
            Move '    Set psText to @"Start'                to asSource[5]
            Move '        #COMMAND PROBE_TWO'               to asSource[6]
            Move '        Object oW is a DFPanel'           to asSource[7]
            Move '        End" + "x"'                       to asSource[8]
            Move 'End_Object'                               to asSource[9]
            Move 'Object oZ is a DFPanel'                   to asSource[10]
            Move 'End_Object'                               to asSource[11]
            Move asSource to asOrig
            Send ClearFuncLibProperties of ghoFuncLib
            Move (Eval("get_ChangeObsoleteClassNames")) to iFn
            Get RunWholeFileFunction of ghoFuncLib iFn (&asSource) "" (&iMacro) (&iLost) to iRetval
            Send AssertIAreEqual 0 iMacro
            Send AssertIAreEqual 0 iLost
            Send AssertSAreEqual 'Object oY is a DfBasePanel' asSource[0]
            Send AssertSAreEqual asOrig[3] asSource[3]
            Send AssertSAreEqual asOrig[7] asSource[7]
            Send AssertSAreEqual 'Object oZ is a DfBasePanel' asSource[10]
        End_Procedure

    End_Object
