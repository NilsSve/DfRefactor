    Object oChangeInToContains is a cTestFixture
        Set psFunctionName to "ChangeInToContains"

        {Published = True}
        Procedure ChangeInToContains_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    indicate Select as sSubString in sHostString // Comment' to sLine
            Move '    indicate Select as (sHostString contains sSubString) // Comment' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    if sSubString in sHostString RunProgram' to sLine
            Move '    if (sHostString contains sSubString) RunProgram' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Until sSubString in sHostString' to sLine
            Move 'Until (sHostString contains sSubString)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_4
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'While sSubString in sHostString' to sLine
            Move 'While (sHostString contains sSubString)' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // This test will fail because the logic assumes the source line to be of proper syntax,
        // e.g. it needs to start with a command (or indicator + command).
        {Published = True}
        Procedure ChangeInToContains_5
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If sSubString    in     sHostString Move True to bFound' to sLine
            Move '    If (sHostString contains sSubString) Move True to bFound' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_6
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'if "." in a_number Move "A" to "B"' to sLine
            Move 'if (a_number contains ".") Move "A" to "B"' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_7
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'if "." in "12.12"' to sLine
            Move 'if ("12.12" contains ".")' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_8
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move (Replaces('`', 'if "`" in "I`m okay"', "'")) to sLine
            Move (Replaces('`', 'if ("I`m okay" contains "`")', "'")) to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_9
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move (Replaces('`', 'if "`" in "I`m okay"', "'")) to sLine
            Move (Replaces('`', 'if ("I`m okay" contains "`")', "'")) to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_10
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "If (Character(10)) in sValue RunProgram" to sLine
            Move "If (sValue contains (Character(10))) RunProgram" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_11
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If "Support Classes" in sShow Set pbDontShowMNS of (VDFCLS_DD(Self)) to True' to sLine
            Move 'If (sShow contains "Support Classes") Set pbDontShowMNS of (VDFCLS_DD(Self)) to True' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_12
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "IF NOT APM.BALANCE_TYPE IN 'BIP' MOVE 'I' TO APM.BALANCE_TYPE" to sLine
            Move "IF NOT ('BIP' contains APM.BALANCE_TYPE) MOVE 'I' TO APM.BALANCE_TYPE" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure ChangeInToContains_13
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "[SELECT] INDICATE SELECT as BATCH.TRAN IN 'APINV,APCDT'" to sLine
            Move "[SELECT] INDICATE SELECT as ('APINV,APCDT' contains BATCH.TRAN)" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A string-LITERAL left operand plus an inline statement carrying a parenthesized call -
        // 'If "," IN temp Move (Replace(",",temp,".")) to temp' (one report view's survivor, x28
        // occurrences, Nils 2026-07-11). Operands swap: legacy 'A IN B' = modern 'B contains A'.
        {Published = True}
        Procedure ChangeInToContains_LiteralOperandInlineStatement
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If "," IN temp Move (Replace(",",temp,".")) to temp' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "contains")
            Send Assert (not(sLine contains " IN "))
        End_Procedure

        // ENGINE-ORDER repro: the same line converts when the tokenizer arrives at it THROUGH the
        // file's preceding lines (sticky lexer state) - the fixture-fresh test above passed while
        // the real 494-file run left the x28 occurrences untouched (Nils 2026-07-11). The flag
        // asserts pin WHICH sticky state trips if this ever fails again.
        {Published = True}
        Procedure ChangeInToContains_EngineOrderStickyState
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData

            Get Tokenizer of ghoFuncLib 'Repeat'                                to TokenizerData
            Get Tokenizer of ghoFuncLib 'If (Not(gbDone)) Begin'                to TokenizerData
            Get Tokenizer of ghoFuncLib 'Write Channel 9 FILE1.FLD_A ","'       to TokenizerData
            Get Tokenizer of ghoFuncLib 'Write Channel 9 FILE1.FLD_B ","'       to TokenizerData
            Get Tokenizer of ghoFuncLib 'Move FILE1.FLD_TIM to temp'            to TokenizerData
            Move 'If "," IN temp Move (Replace(",",temp,".")) to temp' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False)
            Send Assert (TokenizerData.bIsInCommand = False)
            Send Assert (TokenizerData.bIsInImage = False)
            Send Assert (TokenizerData.bIsVariableDeclaration = False)
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send Assert (sLine contains "contains")
        End_Procedure

        /* THE DOUBLE IN (Nils 2026-09-13): a legacy condition IN standing in front of the legacy
           Replace command, whose own IN follows. The first is an operator and converts; the second is
           the command's and is left for ChangeReplaceCommandToFunction. This line sat on the board
           for 28 occurrences with a Run that declined every time: the With guard bailed on the whole
           line, and the Replace converter cannot start until the condition is parenthesised. */
        {Published = True}
        Procedure ChangeInToContains_ConditionInAheadOfAReplaceCommand
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '                    If "," IN temp Replace "," IN temp WITH "."' to sLine
            Move '                    If (temp contains ",") Replace "," IN temp WITH "."' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ...and the Replace command's OWN in, with a parenthesised guard in front, is never touched -
        // that line belongs to the Replace converter, exactly as before.
        {Published = True}
        Procedure ChangeInToContains_TheReplaceCommandsOwnInIsLeftAlone
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        if (sSep = ".") replace "," in sQty with "."' to sLine
            Move sLine to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Engine err 4509 harvest (Nils's LegacyApp3 run 2026-07-11): a ';'-continuation can split an
        // expression around the IN, so a line-by-line pass sees a segment where IN OPENS the line
        // (the unguarded [iItem - 1] read = Err Line 127760, twice) or CLOSES it (the [iItem + 1]
        // read = 127773), or where the neighbour token IS the ';'. One segment alone is missing an
        // operand: the function must bail unchanged - and above all not fault the engine.
        {Published = True}
        Procedure ChangeInToContains_ContinuationSegmentShapesBail
            String sLine sOrg
            Boolean bChanged
            tTokenizer TokenizerData

            // IN opens the segment (continuation line 2 of 'If sChar ;' / '   In sSet Begin').
            Move '   in sHostString Begin' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
            // IN closes the segment.
            Send _InitializeFuncLib of ghoFuncLib
            Move 'If sSubString in' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
            // The continuation ';' right after IN - the host operand lives on the NEXT line.
            Send _InitializeFuncLib of ghoFuncLib
            Move 'If sSubString in ;' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
        End_Procedure

        // "In" is a legal IDENTIFIER, and matching the bare token alone converted a line that has
        // no IN operator at all: 'Move In to Response' (a parameter named In - LegacyApp
        // wslibrary.pkg 'Function Add_Hours tDateTime In Number nHours') became the nonsense
        // '(to contains Move) Response' - the command keyword read as the left operand (Nils
        // 2026-07-25). A real IN only ever sits in a CONDITION, and its left operand is never a
        // structural keyword. Every shape below is an identifier read and must stay VERBATIM.
        {Published = True}
        Procedure ChangeInToContains_IdentifierNamedInUntouched
            String sLine sOrg
            Boolean bChanged
            tTokenizer TokenizerData

            // The live repro: no conditional context at all.
            Move '            Move In to Response' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
            // Lowercase spelling of the same line (the match is case-insensitive).
            Send _InitializeFuncLib of ghoFuncLib
            Move '            Move in to Response' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
            // A message ARGUMENT named In - also no conditional context.
            Send _InitializeFuncLib of ghoFuncLib
            Move '    Send AddHours of oCalc In nHours' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
            // INSIDE a condition, but as the OPERAND - the token before it is the If keyword,
            // so it cannot be an IN operator (a real one has a real operand on its left).
            Send _InitializeFuncLib of ghoFuncLib
            Move '    If In eq 5 Move True to bFound' to sLine
            Move sLine to sOrg
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeInToContains of ghoFuncLib (&sLine) to bChanged
            Send Assert (bChanged = False)
            Send AssertSAreEqual sOrg sLine
        End_Procedure

    End_Object
