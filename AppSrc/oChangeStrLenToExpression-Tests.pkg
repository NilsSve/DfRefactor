//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeStrLenToExpression-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-08
//
// Description : Unit tests for the ChangeStrLenToExpression refactor function: a read of the
//               legacy strlen predefined variable becomes the expression the preceding string
//               command left in it. The expected values follow the DataFlex 26 run time
//               (measured 2026-09-08): Pos and Replace leave strlen = Length(haystack) -
//               Pos(needle, haystack) + 1 (Replace on the value BEFORE the replacement; Length + 1
//               when nothing was found); Right and Mid leave their count; a count-less Right / Mid
//               takes the value and leaves it; the function forms leave it untouched.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeStrLenToExpression is a cTestFixture
        Set psFunctionName to "ChangeStrLenToExpression"

        // After Pos, strlen is the length from the found position to the end (measured: 8 for the
        // space in a 10-character string at position 3).
        { Published = True }
        Procedure ChangeStrLenToExpression_PosCommand_ReadBecomesTailLength
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iLen'                  to asCode[1]
            Move '    Pos " " in sName'              to asCode[2]
            Move '    Move strlen to iLen'           to asCode[3]
            Move 'End_Procedure'                     to asCode[4]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Pos " " in sName'                                          asCode[2]
            Send AssertSAreEqual '    Move (Length(sName) - Pos(" ", sName) + 1) to iLen'        asCode[3]
        End_Procedure

        // Right with a count leaves that count in strlen (measured).
        { Published = True }
        Procedure ChangeStrLenToExpression_RightWithCount_ReadBecomesTheCount
            String[] asCode
            Integer iCount

            Move 'Procedure Tail String sText'     to asCode[0]
            Move '    Integer iN'                  to asCode[1]
            Move '    String sTail'                to asCode[2]
            Move '    Right sText to sTail 4'      to asCode[3]
            Move '    Move strlen to iN'           to asCode[4]
            Move 'End_Procedure'                   to asCode[5]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move 4 to iN' asCode[4]
        End_Procedure

        // Mid with a length only sets strlen to that length (and takes strmark as its start).
        { Published = True }
        Procedure ChangeStrLenToExpression_MidLengthOnly_ReadBecomesTheLength
            String[] asCode
            Integer iCount

            Move 'Procedure Cut String sText'      to asCode[0]
            Move '    Integer iN'                  to asCode[1]
            Move '    String sPart'                to asCode[2]
            Move '    Mid sText to sPart 5'        to asCode[3]
            Move '    Move strlen to iN'           to asCode[4]
            Move 'End_Procedure'                   to asCode[5]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Move 5 to iN' asCode[4]
        End_Procedure

        // After Replace the value exists only before the replacement: the plain Move lifts above it.
        { Published = True }
        Procedure ChangeStrLenToExpression_ReplaceCommand_PlainMoveLiftsAboveIt
            String[] asCode
            Integer iCount

            Move 'Procedure Split String sWork String sSep'    to asCode[0]
            Move '    Integer iRest'                           to asCode[1]
            Move '    Replace sSep in sWork with "$"'          to asCode[2]
            Move '    Move strlen to iRest'                    to asCode[3]
            Move 'End_Procedure'                               to asCode[4]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Move (Length(sWork) - Pos(sSep, sWork) + 1) to iRest'  asCode[2]
            Send AssertSAreEqual '    Replace sSep in sWork with "$"'                          asCode[3]
        End_Procedure

        // The run time's own idiom: save strlen, set it as the count for a count-less command,
        // restore it. Every line of it is the global's legacy input channel - all three keep their
        // lines with the reason, and no local is declared.
        { Published = True }
        Procedure ChangeStrLenToExpression_SaveSetRestoreAroundCountLessRight_KeptAsGlobal
            String[] asCode
            Integer iCount

            Move 'Function Tail String sText Integer iLen Returns String'  to asCode[0]
            Move '    String sOut'                                          to asCode[1]
            Move '    Integer iTmp'                                         to asCode[2]
            Move '    Move strlen to iTmp'                                  to asCode[3]
            Move '    Move iLen to strlen'                                  to asCode[4]
            Move '    Right sText to sOut'                                  to asCode[5]
            Move '    Move iTmp to strlen'                                  to asCode[6]
            Move '    Function_Return sOut'                                 to asCode[7]
            Move 'End_Function'                                             to asCode[8]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 9 (SizeOfArray(asCode))
            Send Assert (asCode[3] contains "no string command")
            Send Assert (asCode[4] contains "count-less")
            Send AssertSAreEqual '    Right sText to sOut' asCode[5]
            Send Assert (asCode[6] contains "count-less")
        End_Procedure

        // Written and read back, with no count-less command in the method: a scratch integer.
        { Published = True }
        Procedure ChangeStrLenToExpression_ScratchUse_BecomesLocalIStrLen
            String[] asCode
            Integer iCount

            Move 'Procedure Count'                to asCode[0]
            Move '    Integer iN'                 to asCode[1]
            Move '    Move 3 to strlen'           to asCode[2]
            Move '    Move strlen to iN'          to asCode[3]
            Move 'End_Procedure'                  to asCode[4]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertIAreEqual 6 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Integer iStrLen'       asCode[1]
            Send AssertSAreEqual '    Move 3 to iStrLen'     asCode[3]
            Send AssertSAreEqual '    Move iStrLen to iN'    asCode[4]
        End_Procedure

        // A count-less Right between the Pos and the read TAKES strlen and leaves it (measured), and
        // only reads the operand: the read still derives from the Pos.
        { Published = True }
        Procedure ChangeStrLenToExpression_CountLessRightBetween_StillDerivesFromPos
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iLen'                  to asCode[1]
            Move '    String sTail'                  to asCode[2]
            Move '    Pos " " in sName'              to asCode[3]
            Move '    Right sName to sTail'          to asCode[4]
            Move '    Move strlen to iLen'           to asCode[5]
            Move 'End_Procedure'                     to asCode[6]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Right sName to sTail'                                    asCode[4]
            Send AssertSAreEqual '    Move (Length(sName) - Pos(" ", sName) + 1) to iLen'      asCode[5]
        End_Procedure

        // strmark is the other function's business: a strmark read stays as it is in this pass.
        { Published = True }
        Procedure ChangeStrLenToExpression_StrMarkRead_LeftToTheOtherFunction
            String[] asCode
            Integer iCount

            Move 'Procedure SplitName String sName'  to asCode[0]
            Move '    Integer iPos'                  to asCode[1]
            Move '    Pos " " in sName'              to asCode[2]
            Move '    Move strmark to iPos'          to asCode[3]
            Move 'End_Procedure'                     to asCode[4]
            Get ChangeStrLenToExpression of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '    Move strmark to iPos' asCode[3]
        End_Procedure

    End_Object
