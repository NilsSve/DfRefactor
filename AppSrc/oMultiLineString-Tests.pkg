    // DF 23 multi-line strings through REAL converters (2026-10-24): a string's body is text, never code, and no
    // converter changes its closing line - though the code after that line's """ still counts (a local used
    // there is in use). The tokenizer stores a body line's own data (it had left the line before in
    // pTokenizer), opens a string after any statement (not only a Move), and the whole-file masking and the Deep
    // Scan use the same rule. Each test puts text a converter would change into the body and checks the code
    // around the string is still converted.
    Object oMultiLineString is a cTestFixture
        Set psFunctionName to "Tokenizer"

        // The engine's line pass over one file (cRefactorEngine): tokenize each line, the engine's gate (a line
        // marked pbKeepLineAsWritten goes to no function), the always-on bracket spacing, then line converters in
        // turn - re-tokenizing after every change, as the engine does.
        Procedure _RunLinePass String[] ByRef asCode
            String sLine sBefore
            Integer i iLast
            Boolean bChanged bKeep

            Send ClearFuncLibProperties of ghoFuncLib
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                Move asCode[i] to sLine
                Send InitializeTokenizer of ghoFuncLib sLine
                Get pbKeepLineAsWritten of ghoFuncLib to bKeep
                If (bKeep = False) Begin
                    Get A_InsertSpaceAfterParenthesis of ghoFuncLib (&sLine) "" to bChanged
                    If (bChanged = True) ;
                        Send InitializeTokenizer of ghoFuncLib sLine
                    Move sLine to sBefore
                    Get ChangeDfTrueDfFalse of ghoFuncLib (&sLine) "" to bChanged
                    If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
                    Move sLine to sBefore
                    Get ChangeLegacyOperators of ghoFuncLib (&sLine) "" to bChanged
                    If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
                    Move sLine to sBefore
                    Get AddUseFileExtension of ghoFuncLib (&sLine) "" to bChanged
                    If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
                    Move sLine to sBefore
                    Get RemoveTrailingSpaces of ghoFuncLib (&sLine) to bChanged
                    If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
                    Move sLine to sBefore
                    Get RemoveEndComments of ghoFuncLib (&sLine) "" to bChanged
                    If (sLine <> sBefore) Send InitializeTokenizer of ghoFuncLib sLine
                    // A remove-function: True drops the line (the engine does not write it back).
                    Get RemoveTypefaceLine of ghoFuncLib (&sLine) "*" to bChanged
                    If (bChanged = True) ;
                        Move "<removed>" to sLine
                End
                Move sLine to asCode[i]
            Loop
        End_Procedure

        Procedure _AssertLines String[] asWant String[] asGot
            Integer i iLast

            Send AssertIAreEqual (SizeOfArray(asWant)) (SizeOfArray(asGot))
            Move (SizeOfArray(asWant) - 1) to iLast
            For i from 0 to iLast
                Send AssertSAreEqual asWant[i] asGot[i]
            Loop
        End_Procedure

        // The body text every line test carries: DFTrue, a Use word, '(C)redit', a legacy operator and trailing
        // spaces - each one something a line converter changes in code.
        Procedure _AddBody String[] ByRef asCode
            Move '        Use cFoo DFTrue (C)redit   ' to asCode[SizeOfArray(asCode)]
            Move '        If (iA eq iB) Begin'         to asCode[SizeOfArray(asCode)]
        End_Procedure

        {Published = True}
        Procedure MultiLineString_MoveBodyUntouched
            // Move """ ... """ to sText
            String[] asCode asWant
            Move '    Move DFTrue to bA' to asCode[0]
            Move '    Move """'          to asCode[1]
            Send _AddBody (&asCode)
            Move '        """ to sText'  to asCode[4]
            Move '    Move DFTrue to bB' to asCode[5]
            Move asCode to asWant
            Move '    Move True to bA'   to asWant[0]
            Move '    Move True to bB'   to asWant[5]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_SetPropertyBodyUntouched
            // Set psHtml to """ ... """ - no Move: the tokenizer used to miss this opener entirely
            String[] asCode asWant
            Move '    Move DFTrue to bA'    to asCode[0]
            Move '    Set psHtml to """'    to asCode[1]
            Send _AddBody (&asCode)
            Move '        """'              to asCode[4]
            Move '    Move DFTrue to bB'    to asCode[5]
            Move asCode to asWant
            Move '    Move True to bA'      to asWant[0]
            Move '    Move True to bB'      to asWant[5]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_DescriptionMetaTagUntouched
            // { Description = """ ... """ } - the meta-tag examples a run on DFRefactor's own source would rewrite
            String[] asCode asWant
            Move '    { Description = """'                                      to asCode[0]
            Move '        Example: Move DFTrue to bFlag -> Move True to bFlag'  to asCode[1]
            Move '        If (iA Eq iB) -> If (iA = iB)'                        to asCode[2]
            Move '        """ }'                                                to asCode[3]
            Move '    Move DFTrue to bC'                                        to asCode[4]
            Move asCode to asWant
            Move '    Move True to bC'                                          to asWant[4]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_SqlTripleQuoteBodyUntouched
            // Get ... @SQL""" ... """ to iRows
            String[] asCode asWant
            Move '    Get SQLExecDirect of hoSQL @SQL"""'          to asCode[0]
            Move '        SELECT * FROM T WHERE (A)B = DFTrue   '  to asCode[1]
            Move '        """ to iRows'                            to asCode[2]
            Move '    Move DFTrue to bD'                           to asCode[3]
            Move asCode to asWant
            Move '    Move True to bD'                             to asWant[3]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_BodyLinesThatLookLikeRegions
            // Body text that looks like a header, a block comment, a report image, a comment, an end comment or a
            // Set Typeface line stays text, a bare closer trimmed by a fix opens nothing, and the code after the
            // string is still converted
            String[] asCode asWant
            Move '    Set psHtml to """'            to asCode[0]
            Move '        /* a CSS comment */'      to asCode[1]
            Move '        /api/v1'                  to asCode[2]
            Move '        #HEADER'                  to asCode[3]
            Move '        // not a comment here'    to asCode[4]
            Move '        End_Procedure // done'    to asCode[5]
            Move '        Set Typeface to "Arial"'  to asCode[6]
            Move '        """   '                   to asCode[7]
            Move '    Move DFTrue to bE'            to asCode[8]
            Move 'End_Procedure // done'            to asCode[9]
            Move asCode to asWant
            Move '        """'                      to asWant[7]
            Move '    Move True to bE'              to asWant[8]
            Move 'End_Procedure'                    to asWant[9]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_OpenerAfterAnAtString
            // Move (@"a" + """ opens a """ string, not an @" one: the """ closer ends it and the code after it is converted
            String[] asCode asWant
            Move '    Move (@"a" + """'          to asCode[0]
            Move '        say "hi"'              to asCode[1]
            Move '        Move DFTrue to bX'     to asCode[2]
            Move '        """) to sText'         to asCode[3]
            Move '    Move DFTrue to bF'         to asCode[4]
            Move asCode to asWant
            Move '    Move True to bF'           to asWant[4]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_OneLineAtStringsOpenNothing
            // A string that closes on its own line opens nothing: the code after it is still converted
            String[] asCode asWant
            Move '    Get SQLExecDirect of hoSQL @SQL"SELECT 1" to iRows'  to asCode[0]
            Move '    Move DFTrue to bA'                                    to asCode[1]
            Move "    Get SQLExecDirect of hoSQL @SQL'SELECT 2' to iRows"  to asCode[2]
            Move '    Move DFTrue to bB'                                    to asCode[3]
            Move '    Move @"a\n" to sText'                                to asCode[4]
            Move '    Move DFTrue to bC'                                    to asCode[5]
            Move '    Send Exec of hoSQL @SQL"""SELECT 3"""'                to asCode[6]
            Move '    Move DFTrue to bD'                                    to asCode[7]
            Move asCode to asWant
            Move '    Move True to bA'                                      to asWant[1]
            Move '    Move True to bB'                                      to asWant[3]
            Move '    Move True to bC'                                      to asWant[5]
            Move '    Move True to bD'                                      to asWant[7]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_TabIndentedCloser
            // A closer indented with tabs closes the string, in the line pass and in the whole-file masking
            String[] asCode asWant
            Integer iCount
            Move '    Move DFTrue to bA'                     to asCode[0]
            Move '    Set psHtml to """'                     to asCode[1]
            Send _AddBody (&asCode)
            Move ((Character(9)) + (Character(9)) + '"""')   to asCode[4]
            Move '    Move DFTrue to bB'                     to asCode[5]
            Move asCode to asWant
            Move '    Move True to bA'                       to asWant[0]
            Move '    Move True to bB'                       to asWant[5]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode

            Move (ResizeArray(asCode, 0)) to asCode
            Move '    Set psHtml to """'                     to asCode[0]
            Move '        Object oX is a DFPanel'            to asCode[1]
            Move ((Character(9)) + '"""')                    to asCode[2]
            Move 'Object oZ is a DFPanel'                    to asCode[3]
            Move 'End_Object'                                to asCode[4]
            Get ChangeObsoleteClassNames of ghoFuncLib (&asCode) "" to iCount
            Send AssertSAreEqual '        Object oX is a DFPanel'   asCode[1]
            Send AssertSAreEqual 'Object oZ is a DfBasePanel'       asCode[3]
        End_Procedure

        {Published = True}
        Procedure MultiLineString_LocalUsedOnTheClosingLine
            // A local used only after the closing """ is in use: the closing line's code is read
            String[] asCode asWant
            Integer iResult
            Move 'Procedure Test'          to asCode[0]
            Move '    String sSql'         to asCode[1]
            Move '    Move """'            to asCode[2]
            Move '        SELECT 1'        to asCode[3]
            Move '        """ to sSql'     to asCode[4]
            Move 'End_Procedure'           to asCode[5]
            Move asCode to asWant
            Get RemoveUnusedLocals of ghoFuncLib (&asCode) to iResult
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_ClosingLineContinues
            // A closing line that ends in ';' continues the next line
            tTokenizer TokenizerData

            Send ClearFuncLibProperties of ghoFuncLib
            Get Tokenizer of ghoFuncLib '    Move ("""'          to TokenizerData
            Get Tokenizer of ghoFuncLib '        body text'      to TokenizerData
            Get Tokenizer of ghoFuncLib '        """ + ;'        to TokenizerData
            Send Assert (TokenizerData.bHasEndSemiColon = True and TokenizerData.bIsInDF23MultiLineString = False) "the closing line ends in a semicolon"
            Get Tokenizer of ghoFuncLib '        sTail) to sX'   to TokenizerData
            Send Assert (TokenizerData.bIsContinuationLine = True) "the line after it continues it"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_OpenerTokenizedTwice
            // The engine re-tokenizes a line a fix changed: the opener again is the opener, not body text
            tTokenizer TokenizerData

            Send ClearFuncLibProperties of ghoFuncLib
            Get Tokenizer of ghoFuncLib '    Set psHtml to """'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False) "the opener is a code line"
            Get Tokenizer of ghoFuncLib '    Set psHtml to """'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False and TokenizerData.bIsInDF23MultiLineString = True) "the opener again is a code line"
            Get Tokenizer of ghoFuncLib '        Move DFTrue to bA' to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = True and TokenizerData.bIsInDF23MultiLineString = True) "the body is still text"
            Get Tokenizer of ghoFuncLib '        """'               to TokenizerData
            Get Tokenizer of ghoFuncLib '    Move DFTrue to bB'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False and TokenizerData.bIsInDF23MultiLineString = False) "the code after the string is code"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_pTokenizerIsTheLinesOwn
            // After a body line and after the closing line, pTokenizer holds THAT line - not the line before
            tTokenizer TokenizerData Stored

            Send ClearFuncLibProperties of ghoFuncLib
            Get Tokenizer of ghoFuncLib '    Move DFTrue to bA' to TokenizerData
            Get Tokenizer of ghoFuncLib '    Move """'          to TokenizerData
            Get Tokenizer of ghoFuncLib '        body text'     to TokenizerData
            Get pTokenizer of ghoFuncLib to Stored
            Send Assert (Stored.sLine = '        body text') "the body line is the stored one"
            Send Assert (Stored.bLineIsReady = True and Stored.bIsInDF23MultiLineString = True) "the body line is text"
            Get Tokenizer of ghoFuncLib '        """ to sText' to TokenizerData
            Get pTokenizer of ghoFuncLib to Stored
            Send Assert (Stored.sLine = '        """ to sText' and Stored.bLineIsReady = True) "the closing line is the stored one"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_WholeFileConvertersLeaveTheBody
            // The whole-file converters read the file through _CodeOnlyFileLines: the body is blank to them
            String[] asCode
            Integer iCount
            Move 'Object oY is a DFPanel'                 to asCode[0]
            Move '    Send Foo of (oY(Self))'             to asCode[1]
            Move '    Set psHtml to """'                  to asCode[2]
            Move '        Object oX is a DFPanel'         to asCode[3]
            Move '        Procedure Paint for BaseClass'  to asCode[4]
            Move '        Send Foo of (oY(Self))'         to asCode[5]
            Move '        """'                            to asCode[6]
            Move 'End_Object'                             to asCode[7]
            // A comment that ends in triple quotes opens no string: the code after it is still converted
            Move 'Define C_X for 1   // with """'         to asCode[8]
            Move 'Object oZ is a DFPanel'                 to asCode[9]
            Move 'Procedure Paint for BaseClass'          to asCode[10]
            Move 'End_Object'                             to asCode[11]
            Get ChangeObsoleteClassNames of ghoFuncLib (&asCode) "" to iCount
            Get ChangeObsoleteMethodTarget of ghoFuncLib (&asCode) "cObject" to iCount
            Get RemoveSelfFromObjectReferences of ghoFuncLib (&asCode) "" to iCount
            Send AssertSAreEqual 'Object oY is a DfBasePanel'             asCode[0]
            Send AssertSAreEqual '    Send Foo of (oY)'                    asCode[1]
            Send AssertSAreEqual '    Set psHtml to """'                   asCode[2]
            Send AssertSAreEqual '        Object oX is a DFPanel'          asCode[3]
            Send AssertSAreEqual '        Procedure Paint for BaseClass'   asCode[4]
            Send AssertSAreEqual '        Send Foo of (oY(Self))'          asCode[5]
            Send AssertSAreEqual '        """'                             asCode[6]
            Send AssertSAreEqual 'Object oZ is a DfBasePanel'             asCode[9]
            Send AssertSAreEqual 'Procedure Paint for cObject'            asCode[10]
        End_Procedure

        /* EVERY published line function - eStandardFunction and eRemoveFunction, from pFuncLibArray, called
           through Eval as the engine does, each with its {InitialValue} as the parameter - over asCode, in the
           engine's order: tokenize the line, the engine's gate (a line marked pbKeepLineAsWritten goes to no
           function), the standard functions (re-tokenized after a reported change), then the remove functions,
           whose True drops the line ("<removed>"). asChangedBy[i] names every function that changed line i, so a
           failing test says who did it - the lengths are compared too, as '<>' does not see trailing spaces. */
        Procedure _RunEveryLineFunction String[] ByRef asCode String[] ByRef asChangedBy
            tFuncLib[] aFuncs
            Integer[] aiStd aiRem
            String[] asStdName asStdParam asRemName asRemParam
            String sLine sBefore sParam
            Integer i iLast j iMax iFn iStdLast iRemLast
            Boolean bChanged bDropped bKeep

            Get pFuncLibArray of ghoFuncLib to aFuncs
            Move (SizeOfArray(aFuncs) - 1) to iMax
            For j from 0 to iMax
                Move "" to sParam
                If (aFuncs[j].bFuncEnumList = True) ;
                    Move aFuncs[j].FuncEnumList.sInitialValue to sParam
                If (aFuncs[j].eFunctionType = eStandardFunction) Begin
                    Move (Eval("get_" - aFuncs[j].sName)) to aiStd[SizeOfArray(aiStd)]
                    Move aFuncs[j].sName to asStdName[SizeOfArray(asStdName)]
                    Move sParam          to asStdParam[SizeOfArray(asStdParam)]
                End
                Else If (aFuncs[j].eFunctionType = eRemoveFunction) Begin
                    Move (Eval("get_" - aFuncs[j].sName)) to aiRem[SizeOfArray(aiRem)]
                    Move aFuncs[j].sName to asRemName[SizeOfArray(asRemName)]
                    Move sParam          to asRemParam[SizeOfArray(asRemParam)]
                End
            Loop
            Move (SizeOfArray(aiStd) - 1) to iStdLast
            Move (SizeOfArray(aiRem) - 1) to iRemLast
            Send Assert (iStdLast > 20 and iRemLast > 1) "the function list holds the line functions"

            Send ClearFuncLibProperties of ghoFuncLib
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                Move asCode[i] to sLine
                Move "" to asChangedBy[i]
                Move False to bDropped
                Send InitializeTokenizer of ghoFuncLib sLine
                Get pbKeepLineAsWritten of ghoFuncLib to bKeep
                If (bKeep = False) Begin
                    For j from 0 to iStdLast
                        Move sLine to sBefore
                        Move aiStd[j] to iFn
                        Get iFn of ghoFuncLib (&sLine) asStdParam[j] to bChanged
                        If (sLine <> sBefore or Length(sLine) <> Length(sBefore)) Begin
                            Move (Trim(asChangedBy[i] * asStdName[j])) to asChangedBy[i]
                            If (bChanged = True) ;
                                Send InitializeTokenizer of ghoFuncLib sLine
                        End
                    Loop
                    For j from 0 to iRemLast
                        Move sLine to sBefore
                        Move aiRem[j] to iFn
                        Get iFn of ghoFuncLib (&sLine) asRemParam[j] to bChanged
                        If (bChanged = True or sLine <> sBefore or Length(sLine) <> Length(sBefore)) ;
                            Move (Trim(asChangedBy[i] * asRemName[j])) to asChangedBy[i]
                        If (bChanged = True) Begin
                            Move True to bDropped
                            If (sLine <> sBefore) ;
                                Send InitializeTokenizer of ghoFuncLib sLine
                        End
                    Loop
                End
                If (bDropped = True) ;
                    Move "<removed>" to sLine
                Move sLine to asCode[i]
            Loop
        End_Procedure

        // pbKeepLineAsWritten after the tokenizer read sLine (the state carries from the line before).
        Function _MarkOf String sLine Returns Boolean
            tTokenizer TokenizerData
            Boolean bKeep
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get pbKeepLineAsWritten of ghoFuncLib to bKeep
            Function_Return bKeep
        End_Function

        {Published = True}
        Procedure MultiLineString_KeepLineAsWrittenMark
            // The engine's gate: a #HEADER region and a string's text are marked; code, an opening and a closing
            // line are not - their code is still converted
            Boolean bKeep
            Send ClearFuncLibProperties of ghoFuncLib
            Get _MarkOf '#HEADER' to bKeep
            Send Assert (bKeep = True) "the #HEADER line"
            Get _MarkOf 'Move DFTrue to bH' to bKeep
            Send Assert (bKeep = True) "a line in the header"
            Get _MarkOf '#ENDHEADER' to bKeep
            Send Assert (bKeep = True) "the #ENDHEADER line"
            Get _MarkOf 'Move DFTrue to bA' to bKeep
            Send Assert (bKeep = False) "code after the header"
            Get _MarkOf '    Set psHtml to """' to bKeep
            Send Assert (bKeep = False) "the opening line"
            Get _MarkOf '    Set psHtml to """' to bKeep
            Send Assert (bKeep = False) "the opening line read again"
            Get _MarkOf '        Move DFTrue to bB' to bKeep
            Send Assert (bKeep = True) "the string's text"
            Get _MarkOf ((Character(9)) + '"""') to bKeep
            Send Assert (bKeep = False) "a tab-indented closing line"
            Get _MarkOf '    Get SQLExecDirect of hoSQL @SQL"""' to bKeep
            Send Assert (bKeep = False) "an @SQL opening line"
            Get _MarkOf '        SELECT 1' to bKeep
            Send Assert (bKeep = True) "the @SQL string's text"
            Get _MarkOf '        """ to iRows' to bKeep
            Send Assert (bKeep = False) "the @SQL closing line"
            Get _MarkOf '    Move DFTrue to bC' to bKeep
            Send Assert (bKeep = False) "code after the strings"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_NoLineFunctionChangesTheText
            // A #HEADER region and a multi-line string - opening line, text and closing line - stay as written
            // whichever line functions run; the text holds what the common converters change in code. Without the
            // engine's gate RemovePropertyPublic, NormalizeArrayNotation, RemoveOldStudioMarkers and
            // RemoveResidentImageOption changed them (measured 2026-10-29). The same for an @-string, whose opening
            // and closing lines hold text as well (2026-10-29).
            String[] asCode asWant asChangedBy
            Boolean[] abKeep
            String sOffenders
            Integer i iLast
            Move '#HEADER'                                  to asCode[0]
            Move 'Property String pH Public ""'             to asCode[1]
            Move 'String [] asH'                            to asCode[2]
            Move '//AB-StoreStart'                          to asCode[3]
            Move 'Move DFTrue to bH'                        to asCode[4]
            Move '#ENDHEADER'                               to asCode[5]
            Move 'Procedure Sweep'                          to asCode[6]
            Move '    Move DFTrue to bA'                    to asCode[7]
            Move '    Set psHtml to """'                    to asCode[8]
            Move '        Property String pX Public ""'     to asCode[9]
            Move '        String [] asNames'                to asCode[10]
            Move '        //AB-StoreStart'                  to asCode[11]
            Move '        //AB/ Object oX is a Container'   to asCode[12]
            Move '        /Body Resident'                   to asCode[13]
            Move '        Get_FileList sName'               to asCode[14]
            Move '        Move DFTrue to bB'                to asCode[15]
            Move '        If (iA eq iB) Begin'              to asCode[16]
            Move '        Use cFoo'                         to asCode[17]
            Move '        Set Typeface to "Arial"'          to asCode[18]
            Move '        Calc (1 + 2) to iX'               to asCode[19]
            Move '        Sysdate dToday'                   to asCode[20]
            Move '        Local String sY'                  to asCode[21]
            Move '        [Found] Move 1 to iZ'             to asCode[22]
            Move '        Left sA to sB 3'                  to asCode[23]
            Move '        Chain "x.exe"'                    to asCode[24]
            Move '        Call Foo'                         to asCode[25]
            Move '        Indicate Found True'              to asCode[26]
            Move '        Move (Trim(ToOEM(sX))) to sX'     to asCode[27]
            Move '        End_Procedure // done'            to asCode[28]
            Move '        text with trailing spaces   '     to asCode[29]
            Move '        """ to sHtml'                     to asCode[30]
            Move '    Set psText to @"String [] asOpen DFTrue (C)redit'     to asCode[31]
            Move '        Property String pY Public x'                      to asCode[32]
            Move '        String [] asMore'                                 to asCode[33]
            Move '        //AB-StoreStart'                                  to asCode[34]
            Move '        /Body Resident'                                   to asCode[35]
            Move '        Move DFTrue to bD'                                to asCode[36]
            Move '        If (iA eq iB) Begin'                              to asCode[37]
            Move '        Use cFoo'                                         to asCode[38]
            Move '        Indicate Found True'                              to asCode[39]
            Move '        text with trailing spaces   '                     to asCode[40]
            Move '        String [] asLast DFTrue (C)redit" to sText'       to asCode[41]
            Move '    Move DFTrue to bC'                    to asCode[42]
            Move 'End_Procedure'                            to asCode[43]
            Move asCode to asWant
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                Move ((i >= 0 and i <= 5) or (i >= 8 and i <= 41)) to abKeep[i]
            Loop
            Send _RunEveryLineFunction (&asCode) (&asChangedBy)
            Move "" to sOffenders
            For i from 0 to iLast
                If (abKeep[i] = True) Begin
                    Send AssertSAreEqual asWant[i] asCode[i]
                    If (asChangedBy[i] <> "") ;
                        Move (sOffenders + " | line" * String(i) + ":" * asChangedBy[i]) to sOffenders
                End
            Loop
            Send Assert (sOffenders = "") ("changed:" + sOffenders)
            // The code around them is still converted
            Send AssertSAreEqual '    Move True to bA' asCode[7]
            Send AssertSAreEqual '    Move True to bC' asCode[42]
        End_Procedure

        {Published = True}
        Procedure MultiLineString_KeepMarkForCommentAndImageText
            // The engine's gate for a block comment and a report image (2026-10-30): a line wholly inside the
            // comment - a blank, a '//' or a '/Body' line too - and an image's text are marked; the comment's opening
            // and closing lines, an image's name lines and its closing marker are not. A '// ... */' line ends the
            // comment, so the code after it is code.
            tTokenizer TokenizerData
            Boolean bKeep
            Send ClearFuncLibProperties of ghoFuncLib
            Get _MarkOf 'Move DFTrue to bA' to bKeep
            Send Assert (bKeep = False) "code"
            Get _MarkOf '/* Use the file' to bKeep
            Send Assert (bKeep = False) "the comment's opening line"
            Get _MarkOf 'Use the file to add your own functions' to bKeep
            Send Assert (bKeep = True) "a line inside the comment"
            Get _MarkOf '' to bKeep
            Send Assert (bKeep = True) "a blank line inside the comment"
            Get _MarkOf '//AB-StoreStart' to bKeep
            Send Assert (bKeep = True) "a '//' line inside the comment"
            Get _MarkOf '/Body Resident' to bKeep
            Send Assert (bKeep = True) "a commented-out image name line"
            Get _MarkOf 'the end */' to bKeep
            Send Assert (bKeep = False) "the comment's closing line"
            Get _MarkOf 'Move DFTrue to bB' to bKeep
            Send Assert (bKeep = False) "code after the comment"
            Get _MarkOf '/*' to bKeep
            Send Assert (bKeep = False) "an opening line alone"
            Get _MarkOf '// old code */' to bKeep
            Send Assert (bKeep = False) "a closing line that starts with '//'"
            Get Tokenizer of ghoFuncLib 'Move DFTrue to bC' to TokenizerData
            Send Assert (pbKeepLineAsWritten(ghoFuncLib) = False and TokenizerData.bIsInDF23MultiLineComment = False and TokenizerData.bIsComment = False) "code after a '// ... */' line"
            Get _MarkOf '    /Body Resident' to bKeep
            Send Assert (bKeep = False) "an image's name line"
            Get _MarkOf '    Use cFoo e.g. [Select]' to bKeep
            Send Assert (bKeep = True) "an image's text"
            Get _MarkOf '' to bKeep
            Send Assert (bKeep = True) "a blank line in an image"
            Get _MarkOf '/Total' to bKeep
            Send Assert (bKeep = False) "a second page's name line"
            Get _MarkOf '/*' to bKeep
            Send Assert (bKeep = False) "the image's closing marker"
            Get _MarkOf 'Move DFTrue to bD' to bKeep
            Send Assert (bKeep = False) "code after the image"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_NoLineFunctionChangesCommentOrImageText
            // A block comment's and a report image's text stay as written whichever line functions run
            // (2026-10-30): on a workspace copy AddUseFileExtension made 'Use the file' in a comment
            // 'Use the.pkg file', and another line function made 'e.g. [Select]' there 'e.g.[Select]'. The code
            // after them is still converted - after a comment that a '// ... */' line closes too.
            String[] asCode asWant asChangedBy
            Boolean[] abKeep
            String sOffenders
            Integer i iLast
            Move 'Move DFTrue to bA'                                to asCode[0]
            Move '/*'                                               to asCode[1]
            Move 'Use the file to add your own functions'           to asCode[2]
            Move 'indicator (e.g. [Select] -> (Select)), DFTrue'    to asCode[3]
            Move 'Property String pX Public ""'                     to asCode[4]
            Move 'String [] asNames'                                to asCode[5]
            Move '//AB-StoreStart'                                  to asCode[6]
            Move '/Body Resident'                                   to asCode[7]
            Move 'text with trailing spaces   '                     to asCode[8]
            Move '    '                                             to asCode[9]
            Move '*/'                                               to asCode[10]
            Move 'Move DFTrue to bB'                                to asCode[11]
            Move '/Body Resident'                                   to asCode[12]
            Move 'Use cFoo e.g. [Select] DFTrue'                    to asCode[13]
            Move 'text with trailing spaces   '                     to asCode[14]
            Move '/*'                                               to asCode[15]
            Move 'Move DFTrue to bC'                                to asCode[16]
            Move '/*'                                               to asCode[17]
            Move 'Move DFTrue to bD'                                to asCode[18]
            Move '// old code */'                                   to asCode[19]
            Move 'Move DFTrue to bE'                                to asCode[20]
            Move asCode to asWant
            Move (SizeOfArray(asCode) - 1) to iLast
            For i from 0 to iLast
                Move ((i >= 2 and i <= 9) or i = 13 or i = 14 or i = 18) to abKeep[i]
            Loop
            Send _RunEveryLineFunction (&asCode) (&asChangedBy)
            Move "" to sOffenders
            For i from 0 to iLast
                If (abKeep[i] = True) Begin
                    Send AssertSAreEqual asWant[i] asCode[i]
                    If (asChangedBy[i] <> "") ;
                        Move (sOffenders + " | line" * String(i) + ":" * asChangedBy[i]) to sOffenders
                End
            Loop
            Send Assert (sOffenders = "") ("changed:" + sOffenders)
            // The code around them is still converted
            Send AssertSAreEqual 'Move True to bA' asCode[0]
            Send AssertSAreEqual 'Move True to bB' asCode[11]
            Send AssertSAreEqual 'Move True to bC' asCode[16]
            Send AssertSAreEqual 'Move True to bE' asCode[20]
        End_Procedure

        // The converters that write files themselves (eOtherFunctionAll) - no engine guard is around them.
        Object oSweepDbGrid is a cDbGridTocDbCJGrid
        End_Object
        Object oSweepGrid is a cGridToCJGrid
        End_Object
        Object oSweepList is a cListToCJGrid
        End_Object
        Object oSweepDbList is a cDbListTocDbCJGridPromptList
        End_Object

        // asFix as a block comment's text (bImage False) or a report image's (True), then as code.
        Function _TextThenCode String[] asFix Boolean bImage Returns String[]
            String[] asIn
            Integer i iLast

            Move (SizeOfArray(asFix) - 1) to iLast
            If (bImage = False) ;
                Move "/*" to asIn[0]
            Else ;
                Move "/Sweep_Img" to asIn[0]
            For i from 0 to iLast
                Move asFix[i] to asIn[SizeOfArray(asIn)]
            Loop
            If (bImage = False) ;
                Move "*/" to asIn[SizeOfArray(asIn)]
            Else ;
                Move "/*" to asIn[SizeOfArray(asIn)]
            For i from 0 to iLast
                Move asFix[i] to asIn[SizeOfArray(asIn)]
            Loop
            Function_Return asIn
        End_Function

        // "" when the text block that opens asIn (its first iLen + 2 lines) stands in asOut as written, else where it
        // first differs. A line the converter put above it moves it, and that is fine.
        Function _TextBlockKept String[] asIn String[] asOut Integer iLen Returns String
            Integer i iAt

            Move (SearchArray(asIn[0], asOut)) to iAt
            If (iAt = -1) ;
                Function_Return ("its first line '" + asIn[0] + "' is gone")
            For i from 1 to (iLen + 1)
                If ((iAt + i) >= SizeOfArray(asOut)) ;
                    Function_Return "the text ends early"
                If (asOut[iAt + i] <> asIn[i] or Length(asOut[iAt + i]) <> Length(asIn[i])) ;
                    Function_Return ("line" * String(i) + ": '" + asIn[i] + "' -> '" + asOut[iAt + i] + "'")
            Loop
            Function_Return ""
        End_Function

        // One grid/list converter's TransformSource over asFix as text, then as code: "" when the text came back as
        // written and the code converted, else what went wrong.
        Function _ConverterKeepsText Handle hoWorker String[] asFix Boolean bImage Returns String
            String[] asIn asOut
            String sWhy
            Integer iN

            Get _TextThenCode asFix bImage to asIn
            Set pasSource of hoWorker to asIn
            Get TransformSource of hoWorker to iN
            Get pasSource of hoWorker to asOut
            Get _TextBlockKept asIn asOut (SizeOfArray(asFix)) to sWhy
            If (sWhy = "" and iN < 1) ;
                Move "the code did not convert" to sWhy
            If (sWhy <> "") ;
                Move (sWhy + " [" + String(iN) + " converted]") to sWhy
            Function_Return sWhy
        End_Function

        {Published = True}
        Procedure MultiLineString_NoGridConverterChangesCommentOrImageText
            // The grid and list converters write files themselves, so the engine's guard is not around them: each
            // must leave a block comment's and a report image's text as written - here an object of its own kind
            // commented out and in an image - and the same object as code still converts (2026-10-30).
            String[] asDbGrid asGrid asList asDbList
            Handle[] ahWorker
            String[] asName
            String sOffenders sWhy sKind
            Integer i j
            Boolean bImage

            Move "Object oMyGrid is a cDbGrid"                  to asDbGrid[0]
            Move "End_Object"                                   to asDbGrid[1]
            Move "Object oGrd is a Grid"                        to asGrid[0]
            Move '    Set Header_Label Item 0 to "Name"'        to asGrid[1]
            Move '    Set Header_Label Item 1 to "Value"'       to asGrid[2]
            Move "    Procedure Fill_List"                      to asGrid[3]
            Move "        Integer iX"                           to asGrid[4]
            Move "        Send Delete_Data"                     to asGrid[5]
            Move '        Send Add_Item Msg_None "a"'           to asGrid[6]
            Move '        Send Add_Item Msg_None "b"'           to asGrid[7]
            Move "    End_Procedure"                            to asGrid[8]
            Move "End_Object"                                   to asGrid[9]
            Move "Object oList1 is a List"                      to asList[0]
            Move "    Set Size to 80 50"                        to asList[1]
            Move "    Set Select_Mode to Multi_Select"          to asList[2]
            Move "    Item_List"                                to asList[3]
            Move '        On_Item "Oil Filter" send None'       to asList[4]
            Move '        On_Item "Spark Plugs" send None'      to asList[5]
            Move "    End_Item_List"                            to asList[6]
            Move "End_Object"                                   to asList[7]
            Move "Object oSelectCustomer is a dbList"           to asDbList[0]
            Move "End_Object"                                   to asDbList[1]
            Move (oSweepDbGrid(Self)) to ahWorker[0]
            Move (oSweepGrid(Self))   to ahWorker[1]
            Move (oSweepList(Self))   to ahWorker[2]
            Move (oSweepDbList(Self)) to ahWorker[3]
            Move "RefactorDbGridTocDbCJGrid"            to asName[0]
            Move "RefactorGridToCJGrid"                 to asName[1]
            Move "RefactorListToCJGrid"                 to asName[2]
            Move "RefactorDbListTocDbCJGridPromptList"  to asName[3]
            Move "" to sOffenders
            For i from 0 to 3
                For j from 0 to 1
                    Move (j = 1) to bImage
                    Move " (comment) " to sKind
                    If (bImage = True) ;
                        Move " (image) " to sKind
                    Send ClearFuncLibProperties of ghoFuncLib
                    If (i = 0) Get _ConverterKeepsText ahWorker[i] asDbGrid bImage to sWhy
                    If (i = 1) Get _ConverterKeepsText ahWorker[i] asGrid   bImage to sWhy
                    If (i = 2) Get _ConverterKeepsText ahWorker[i] asList   bImage to sWhy
                    If (i = 3) Get _ConverterKeepsText ahWorker[i] asDbList bImage to sWhy
                    If (sWhy <> "") ;
                        Move (sOffenders + " | " + asName[i] + sKind + sWhy) to sOffenders
                Loop
            Loop
            Send Assert (sOffenders = "") ("changed:" + sOffenders)
        End_Procedure

        {Published = True}
        Procedure MultiLineString_MenuConverterKeepsCommentOrImageText
            // ChangeDFCreateMenuToCodeJock writes files itself too (2026-10-30): a commented-out menu and one in a
            // report image stay as written, and the menu as code still converts.
            String[] asMenu asIn asWant
            String sDataPath sWhy sOffenders sKind
            Integer iEmitted j iLeft
            Boolean bImage

            Get psDataPath of (phoWorkspace(ghoApplication)) to sDataPath
            Move (vFolderFormat(sDataPath)) to sDataPath
            Move "Object Main is a Panel"                                       to asMenu[0]
            Move "    DFCreate_Menu Main_Menu"                                  to asMenu[1]
            Move '    DFCreate_Menu "&Order" SalesPopupMenu is a ViewPopupMenu' to asMenu[2]
            Move '    On_Item "&New" Send Activate_New'                         to asMenu[3]
            Move "    End_Pull_Down"                                            to asMenu[4]
            Move "    End_Menu"                                                 to asMenu[5]
            Move "    Object oClientArea is a ClientArea"                       to asMenu[6]
            Move "    End_Object"                                               to asMenu[7]
            Move "End_Object"                                                   to asMenu[8]
            Move "" to sOffenders
            For j from 0 to 1
                Move (j = 1) to bImage
                Move "(comment) " to sKind
                If (bImage = True) ;
                    Move "(image) " to sKind
                Send ClearFuncLibProperties of ghoFuncLib
                Get _TextThenCode asMenu bImage to asIn
                Move asIn to asWant
                Get _CJConvertMenuInFile of ghoFuncLib (&asIn) sDataPath to iEmitted
                Get _TextBlockKept asWant asIn 9 to sWhy
                If (sWhy = "" and iEmitted < 1) ;
                    Move "the code did not convert" to sWhy
                Get _CountOfLine asIn "    DFCreate_Menu Main_Menu" to iLeft
                If (sWhy <> "") ;
                    Move (sWhy + " [" + String(iEmitted) + " emitted, menu lines left:" * String(iLeft) + "]") to sWhy
                If (sWhy <> "") ;
                    Move (sOffenders + " | " + sKind + sWhy) to sOffenders
            Loop
            Send Assert (sOffenders = "") ("changed:" + sOffenders)
        End_Procedure

        // How many lines of asLines are sLine, byte for byte.
        Function _CountOfLine String[] asLines String sLine Returns Integer
            Integer i iLast iN

            Move 0 to iN
            Move (SizeOfArray(asLines) - 1) to iLast
            For i from 0 to iLast
                If (asLines[i] = sLine and Length(asLines[i]) = Length(sLine)) ;
                    Increment iN
            Loop
            Function_Return iN
        End_Function

        /* EVERY published one-file whole-file function (eOtherFunction, from pFuncLibArray, called through Eval as
           the engine does, each with its {InitialValue} as the parameter), each on its own copy of asCode, through
           the engine's call (RunWholeFileFunction) - or, with bGuarded False, with only the macro code masked, as
           the engine called them before 2026-10-29 (the control). sOffenders names every function that changed a
           kept line - a multi-line string's text or a #HEADER line (KeptTextFlags) - or one of the asAlso lines (an
           @-string's opening and closing lines, which hold text too: each must come back as often, byte for byte),
           and sExercised every one that changed anything. Four are left out: they read the target workspace's
           DataFlex version, or index the install or the workspace's packages, and the test runner has neither.
           The guard covers them the same. */
        Procedure _RunEveryWholeFileFunction String[] asCode String[] asAlso Boolean bGuarded Boolean bCommentAndImage String ByRef sOffenders String ByRef sExercised
            tFuncLib[] aFuncs
            String[] asRun asSaved asWantKept asGotKept asEmpty
            Integer[] aiMacro
            String sParam sSkip sDiff
            Integer j iMax iFn iRetval iMasked iLost iBack k
            Boolean bSame

            Move "|guardredundantglobalfunctions|guardduplicateexternalfunctions|guardansiexternalfunctionwithwide|makefileautonomous|" to sSkip
            Move "" to sOffenders
            Move "" to sExercised
            Get _SweepTextOf (&asCode) bCommentAndImage to asWantKept
            Get pFuncLibArray of ghoFuncLib to aFuncs
            Move (SizeOfArray(aFuncs) - 1) to iMax
            For j from 0 to iMax
                If (aFuncs[j].eFunctionType = eOtherFunction and Pos(("|" + Lowercase(aFuncs[j].sName) + "|"), sSkip) = 0) Begin
                    Move "" to sParam
                    If (aFuncs[j].bFuncEnumList = True) ;
                        Move aFuncs[j].FuncEnumList.sInitialValue to sParam
                    Move (Eval("get_" - aFuncs[j].sName)) to iFn
                    Move asCode to asRun
                    Send ClearFuncLibProperties of ghoFuncLib
                    Set pasOriginalSource of ghoEngine to asCode
                    Set pasPinnedIndicators of ghoFuncLib to asEmpty
                    If (bGuarded = True) Begin
                        Get RunWholeFileFunction of ghoFuncLib iFn (&asRun) sParam (&iMasked) (&iLost) to iRetval
                    End
                    Else Begin
                        Get MaskMacroCode of ghoFuncLib (&asRun) (&asSaved) (&aiMacro) to iMasked
                        Get iFn of ghoFuncLib (&asRun) sParam to iRetval
                        If (iMasked > 0) ;
                            Get UnmaskMacroCode of ghoFuncLib (&asRun) (&asSaved) (&aiMacro) (&iLost) to iBack
                    End
                    Get _SweepTextOf (&asRun) bCommentAndImage to asGotKept
                    Get _SameLines asWantKept asGotKept to bSame
                    For k from 0 to (SizeOfArray(asAlso) - 1)
                        If (_CountOfLine(Self, asRun, asAlso[k]) <> _CountOfLine(Self, asCode, asAlso[k])) ;
                            Move False to bSame
                    Loop
                    If (bSame = False) Begin
                        Get _FirstDifference asWantKept asGotKept to sDiff
                        Move (Trim(sOffenders * aFuncs[j].sName + sDiff)) to sOffenders
                    End
                    Get _SameLines asCode asRun to bSame
                    If (bSame = False) ;
                        Move (Trim(sExercised * aFuncs[j].sName)) to sExercised
                End
            Loop
            Set pasOriginalSource of ghoEngine to asEmpty
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // The lines a whole-file sweep wants back as written, in file order: those KeptTextFlags keeps (a multi-line
        // string's text, #HEADER lines) - or, with bCommentAndImage, every block-comment and report-image line of
        // the file walk.
        Function _SweepTextOf String[] ByRef asCode Boolean bCommentAndImage Returns String[]
            String[] asOut
            tLineInfo[] aInfo
            Integer i iLast

            If (bCommentAndImage = False) Begin
                Get _KeptLinesOf (&asCode) to asOut
                Function_Return asOut
            End
            Get ScanSourceFile of ghoFuncLib (&asCode) to aInfo
            Move (SizeOfArray(aInfo) - 1) to iLast
            For i from 0 to iLast
                If (aInfo[i].eKind = LK_BlockComment or aInfo[i].eKind = LK_Image) ;
                    Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Function_Return asOut
        End_Function

        // Where a sweep's two line lists first differ, for its failure message: " [<n>: '<want>' -> '<got>']",
        // the two counts when one list runs out first, "" when they are the same.
        Function _FirstDifference String[] asWant String[] asGot Returns String
            Integer i iLast

            Move (SizeOfArray(asWant) - 1) to iLast
            If ((SizeOfArray(asGot) - 1) < iLast) ;
                Move (SizeOfArray(asGot) - 1) to iLast
            For i from 0 to iLast
                If (asWant[i] <> asGot[i] or Length(asWant[i]) <> Length(asGot[i])) ;
                    Function_Return (" [" + String(i) + ": '" + asWant[i] + "' -> '" + asGot[i] + "']")
            Loop
            If (SizeOfArray(asWant) <> SizeOfArray(asGot)) ;
                Function_Return (" [" + String(SizeOfArray(asWant)) + " lines -> " + String(SizeOfArray(asGot)) + "]")
            Function_Return ""
        End_Function

        // The lines of asCode KeptTextFlags keeps as written, in file order.
        Function _KeptLinesOf String[] ByRef asCode Returns String[]
            String[] asOut
            Boolean[] abKeep
            Integer i iLast

            Get KeptTextFlags of ghoFuncLib (&asCode) False to abKeep
            Move (SizeOfArray(abKeep) - 1) to iLast
            For i from 0 to iLast
                If (abKeep[i] = True) ;
                    Move asCode[i] to asOut[SizeOfArray(asOut)]
            Loop
            Function_Return asOut
        End_Function

        // Byte for byte: DataFlex's <> does not see trailing spaces.
        Function _SameLines String[] asA String[] asB Returns Boolean
            Integer i iLast

            If (SizeOfArray(asA) <> SizeOfArray(asB)) ;
                Function_Return False
            Move (SizeOfArray(asA) - 1) to iLast
            For i from 0 to iLast
                If (asA[i] <> asB[i] or Length(asA[i]) <> Length(asB[i])) ;
                    Function_Return False
            Loop
            Function_Return True
        End_Function

        // A block of legacy code, once as a multi-line string's text and once as code, for the whole-file sweep.
        Function _LegacyBlock Returns String[]
            String[] asBlock
            Move '#REPLACE MAX_ROWS 500'                                 to asBlock[0]
            Move 'Use MyCalendar.pkg'                                  to asBlock[1]
            Move 'String P_auto_login@'                                  to asBlock[2]
            Move 'entry_pt:'                                             to asBlock[3]
            Move '    gosub calc_it'                                     to asBlock[4]
            Move '    gosub_return'                                      to asBlock[5]
            Move 'calc_it:'                                              to asBlock[6]
            Move '    move 1 to iSum'                                    to asBlock[7]
            Move '    gosub_return'                                      to asBlock[8]
            Move 'Object oCal is a MyCalendar'                         to asBlock[9]
            Move 'End_Object'                                            to asBlock[10]
            Move 'Object oSweep is a dbEdit'                             to asBlock[11]
            Move '    Property Integer piX Private 0'                    to asBlock[12]
            Move '    Set Server to (oCustomer_DD(Self))'                to asBlock[13]
            Move '    Object oCustomer_WinPrint is a WinReport'          to asBlock[14]
            Move '    End_Object'                                        to asBlock[15]
            Move '    Object oTimer is a DfTimer'                        to asBlock[16]
            Move '    End_Object'                                        to asBlock[17]
            Move '    Object oPanel is a DFPanel'                        to asBlock[18]
            Move '        Procedure Paint for BaseClass'                 to asBlock[19]
            Move '        End_Procedure'                                 to asBlock[20]
            Move '    End_Object'                                        to asBlock[21]
            Move '    Function Insert_Period'                            to asBlock[22]
            Move '        Function_Return 1'                             to asBlock[23]
            Move '    End_Function'                                      to asBlock[24]
            Move '    Function FormatValue String sRaw Returns String'   to asBlock[25]
            Move '        Function_Return sRaw'                          to asBlock[26]
            Move '    End_Function'                                      to asBlock[27]
            Move '    Procedure DoIt'                                    to asBlock[28]
            Move '        Integer iUnused iLen'                          to asBlock[29]
            Move '        String sName sOut'                             to asBlock[30]
            Move '        Begin_Constraints'                             to asBlock[31]
            Move '            Constrain Watchset.mno eq gMnr'            to asBlock[32]
            Move '        End_Constraints'                               to asBlock[33]
            Move '        Cmdline sName'                                 to asBlock[34]
            Move '        Pos " " in sName'                              to asBlock[35]
            Move '        Move strlen to iLen'                           to asBlock[36]
            Move '        Move strmark to iLen'                          to asBlock[37]
            Move '        Move (FormatValue(Self, sName)) to sOut'       to asBlock[38]
            Move '        If (Select) Begin'                             to asBlock[39]
            Move '        End'                                           to asBlock[40]
            Move '        Move "" to P_auto_login@'                      to asBlock[41]
            Move '    End_Procedure'                                     to asBlock[42]
            Move ''                                                      to asBlock[43]
            Move ''                                                      to asBlock[44]
            Move ''                                                      to asBlock[45]
            Move 'End_Object'                                            to asBlock[46]
            Function_Return asBlock
        End_Function

        {Published = True}
        Procedure MultiLineString_NoWholeFileFunctionChangesTheText
            // A #HEADER region and a multi-line string's text stay as written whichever whole-file function runs,
            // called as the engine calls it; the string holds a block of legacy code, and the same block as code
            // is still converted
            String[] asCode asBlock asAlso asControlEx
            String sOffenders sExercised sControl sControlEx sMissing
            Integer i iLast
            Get _LegacyBlock to asBlock
            Move '#HEADER'                          to asCode[0]
            Move 'Use cFoo'                         to asCode[1]
            Move 'Property String pH Private ""'    to asCode[2]
            Move '#REPLACE H_ROWS 5'                to asCode[3]
            Move 'Object oH is a dbEdit'            to asCode[4]
            Move 'End_Object'                       to asCode[5]
            Move '#ENDHEADER'                       to asCode[6]
            Move 'Procedure Sweep'                  to asCode[7]
            Move '    String sHtml'                 to asCode[8]
            Move '    Move """'                     to asCode[9]
            Move (SizeOfArray(asBlock) - 1) to iLast
            For i from 0 to iLast
                If (asBlock[i] = "") ;
                    Move "" to asCode[SizeOfArray(asCode)]
                Else ;
                    Move ('        ' + asBlock[i]) to asCode[SizeOfArray(asCode)]
            Loop
            Move '        """ to sHtml'             to asCode[SizeOfArray(asCode)]
            // ...and once more in an @' string, which ends at its first closing quote - its opening and closing
            // lines hold text as well, and they must come back as written too (2026-10-29)
            Move "    Move @'Object oOpen is a dbEdit (oCustomer_DD(Self))"  to asAlso[0]
            Move "        Object oClose is a WinReport DFPanel' to sHtml"    to asAlso[1]
            Move asAlso[0]                          to asCode[SizeOfArray(asCode)]
            For i from 0 to iLast
                If (asBlock[i] = "") ;
                    Move "" to asCode[SizeOfArray(asCode)]
                Else ;
                    Move ('        ' + asBlock[i]) to asCode[SizeOfArray(asCode)]
            Loop
            Move asAlso[1]                          to asCode[SizeOfArray(asCode)]
            Move 'End_Procedure'                    to asCode[SizeOfArray(asCode)]
            For i from 0 to iLast
                Move asBlock[i] to asCode[SizeOfArray(asCode)]
            Loop
            // Without the guard - only the macro code masked, as before 2026-10-29 - 12 of the 18 functions this
            // block exercises changed the string's text or the #HEADER lines (measured 2026-10-29), among them
            // RemoveMultipleBlankLines, ConvertGosubToProcedure, ChangeReplaceDirectiveToDefine and
            // RefactorDbEditTocDbTextEdit. The control keeps the test honest: when no function changes them, the
            // fixture no longer tests the guard.
            Send _RunEveryWholeFileFunction asCode asAlso False False (&sControl) (&sControlEx)
            Send Assert (sControl <> "") "without the guard, a function changes the string's text or the header"
            // Through the engine's call none does, and every function that changed anything still converts the code.
            // It may convert more: text read as code can hide code from a function - without the guard
            // RefactorBareGlobalsToGlobalVariable counted 'Object oClose' in the @' string's closing line as an
            // object that never ended, so the bare global in the code copy looked nested (measured 2026-10-29).
            Send _RunEveryWholeFileFunction asCode asAlso True False (&sOffenders) (&sExercised)
            Send Assert (sOffenders = "") ("changed:" * sOffenders)
            Move (StrSplitToArray(sControlEx, " ")) to asControlEx
            Move "" to sMissing
            For i from 0 to (SizeOfArray(asControlEx) - 1)
                If (Pos((" " + asControlEx[i] + " "), (" " + sExercised + " ")) = 0) ;
                    Move (Trim(sMissing * asControlEx[i])) to sMissing
            Loop
            Send Assert (sMissing = "") ("no longer converts the code:" * sMissing)
        End_Procedure

        // The block of legacy code as a block comment's text (bImage False) or a report image's (True), then the same
        // block as code, for the comment and image sweeps. A report image's text is free text: the block without
        // its directive line.
        Function _TextThenCodeFixture Boolean bImage Returns String[]
            String[] asCode asBlock
            Integer i iLast

            Get _LegacyBlock to asBlock
            Move (SizeOfArray(asBlock) - 1) to iLast
            If (bImage = False) Begin
                Move '/*'          to asCode[0]
                For i from 0 to iLast
                    Move asBlock[i] to asCode[SizeOfArray(asCode)]
                Loop
                Move '*/'          to asCode[SizeOfArray(asCode)]
            End
            Else Begin
                Move '/Sweep_Img'  to asCode[0]
                For i from 0 to iLast
                    If (Left(asBlock[i], 1) <> "#") ;
                        Move asBlock[i] to asCode[SizeOfArray(asCode)]
                Loop
                Move '/*'          to asCode[SizeOfArray(asCode)]
            End
            For i from 0 to iLast
                Move asBlock[i] to asCode[SizeOfArray(asCode)]
            Loop
            Function_Return asCode
        End_Function

        {Published = True}
        Procedure MultiLineString_NoWholeFileFunctionChangesCommentText
            // A block comment's text stays as written whichever whole-file function runs, called as the engine calls
            // it: it holds the block of legacy code, and the same block as code still converts. Two functions had
            // changed it, found one at a time (RefactorBareGlobalsToGlobalVariable, ConvertGosubToProcedure); this
            // sweep found seven more, and the engine's guard keeps the text since (2026-10-30)
            String[] asCode asNone
            String sOffenders sExercised
            Get _TextThenCodeFixture False to asCode
            Send _RunEveryWholeFileFunction asCode asNone True True (&sOffenders) (&sExercised)
            Send Assert (sOffenders = "") ("a block comment's text changed by:" * sOffenders)
            Send Assert (sExercised <> "") "the block as code still converts"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_NoWholeFileFunctionChangesImageText
            // A report image's text is what the report prints: it stays as written whichever whole-file function
            // runs, called as the engine calls it. It holds the block of legacy code, and the same block as code
            // still converts (2026-10-30 - ConvertGosubToProcedure had rewritten a header line of one)
            String[] asCode asNone
            String sOffenders sExercised
            Get _TextThenCodeFixture True to asCode
            Send _RunEveryWholeFileFunction asCode asNone True True (&sOffenders) (&sExercised)
            Send Assert (sOffenders = "") ("a report image's text changed by:" * sOffenders)
            Send Assert (sExercised <> "") "the block as code still converts"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_OpenerRules
            // The shared delimiter rule, measured on DataFlex 26: a """ opener ends its line, a closer starts its line
            Boolean bYes
            String sCode
            Get _MultiLineStringOpens of ghoFuncLib '    Set psHtml to """' to bYes
            Send Assert (bYes = True) "Set psHtml to triple quotes opens"
            Get _MultiLineStringOpens of ghoFuncLib '    Move ("""' to bYes
            Send Assert (bYes = True) "Move (triple quotes opens"
            Get _MultiLineStringOpens of ghoFuncLib '    Set psCaption to """"' to bYes
            Send Assert (bYes = False) "four quotes do not open"
            Get _MultiLineStringOpens of ghoFuncLib '    Move "TO"""' to bYes
            Send Assert (bYes = False) "a string's closing quote plus an empty string does not open"
            Get _MultiLineStringOpens of ghoFuncLib '#COMMAND FOR_ALL "TO"""' to bYes
            Send Assert (bYes = False) "a directive line does not open"
            Get _MultiLineStringOpens of ghoFuncLib '    Move "abc" + """' to bYes
            Send Assert (bYes = True) "an opener after a closed string opens"
            Get _MultiLineStringOpens of ghoFuncLib '    Move ("""a""" + """b""") to s' to bYes
            Send Assert (bYes = False) "two one-line strings do not open"
            Get _MultiLineStringOpens of ghoFuncLib ("    Move '" + '"""' + "' to s") to bYes
            Send Assert (bYes = False) "triple quotes inside a single-quoted string do not open"
            Get _MultiLineStringOpens of ghoFuncLib '    // Move """' to bYes
            Send Assert (bYes = False) "a comment line does not open"
            Get _MultiLineStringOpens of ghoFuncLib '        """' to bYes
            Send Assert (bYes = False) "a bare closer does not open"
            Get _MultiLineStringOpens of ghoFuncLib '    Move sA to sB // see """' to bYes
            Send Assert (bYes = False) "an end comment ending in triple quotes does not open"
            Get _MultiLineStringOpens of ghoFuncLib '    Move "a//b" + """' to bYes
            Send Assert (bYes = True) "a // inside a string is no comment"
            Get _MultiLineStringOpens of ghoFuncLib ('    Set psHtml to """' + (Character(9))) to bYes
            Send Assert (bYes = True) "a tab after the opener"
            Get _MultiLineStringCloses of ghoFuncLib ((Character(9)) + '"""') to bYes
            Send Assert (bYes = True) "a tab-indented closer closes"
            Get _MultiLineStringOpens of ghoFuncLib '    Move ("""a""" + Name(oY(Self)) + """' to bYes
            Send Assert (bYes = True) "an opener after a one-line triple-quoted string opens"
            Get _MultiLineStringOpenerCode of ghoFuncLib '    Move ("""a""" + Name(oY(Self)) + """' to sCode
            Send Assert (Pos("oY(Self)", sCode) > 0) "the opener's code runs to the LAST triple quotes"
            Get _MultiLineStringCloses of ghoFuncLib '        """ to sText' to bYes
            Send Assert (bYes = True) "a line starting with triple quotes closes"
            Get _MultiLineStringCloses of ghoFuncLib '    Move """' to bYes
            Send Assert (bYes = False) "the opening line is no closer"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_AtStringRules
            // The lexer's line scanner (ScanSourceLine), measured on DataFlex 26 (2026-10-29): an @"... /
            // @SQL"... / @'... / @SQL'... string runs on when its line leaves it open, ends at its FIRST closing
            // quote - in the middle of a line too - and the code after that quote may open the next string
            tLineScan Scan
            String sCode
            Get ScanSourceLine of ghoFuncLib '    Move @"Hello' "" False to Scan
            Send Assert (Scan.sOpenOut = '"' and Scan.iOpenAt = 11) "an @-string left open, and where it opened"
            Get ScanSourceLine of ghoFuncLib '    Set psHtml to @"' "" False to Scan
            Send Assert (Scan.sOpenOut = '"') "after any statement, and with nothing after the quote"
            Get ScanSourceLine of ghoFuncLib "    Move @'Hello" "" False to Scan
            Send Assert (Scan.sOpenOut = "'") "an @' string"
            Get ScanSourceLine of ghoFuncLib "    Get SQLExecDirect of hoSQL @sql'SELECT" "" False to Scan
            Send Assert (Scan.sOpenOut = "'") "an @SQL' string, in any case"
            Get ScanSourceLine of ghoFuncLib '    Get SQLExecDirect of hoSQL @SQL"SELECT' "" False to Scan
            Send Assert (Scan.sOpenOut = '"') "an @SQL double-quoted string"
            Get ScanSourceLine of ghoFuncLib '    Get SQLExecDirect of hoSQL @SQL"""' "" False to Scan
            Send Assert (Scan.sOpenOut = '"""') "an @SQL triple-quoted string is a triple-quoted one"
            Get ScanSourceLine of ghoFuncLib '    Move @"http://example.com' "" False to Scan
            Send Assert (Scan.sOpenOut = '"' and Scan.iCommentAt = 0) "a // in the text is no comment"
            Get ScanSourceLine of ghoFuncLib '    Move @"a" to sText' "" False to Scan
            Send Assert (Scan.sOpenOut = "") "a one-line @-string opens nothing"
            Get ScanSourceLine of ghoFuncLib '    Move "@SQL" to sText' "" False to Scan
            Send Assert (Scan.sOpenOut = "") "@SQL inside a string opens nothing"
            Get ScanSourceLine of ghoFuncLib '    // Move @"Hello' "" False to Scan
            Send Assert (Scan.sOpenOut = "" and Scan.iCommentAt = 5) "a comment line opens nothing"
            Get ScanSourceLine of ghoFuncLib '    Move sA to sB // see @"x' "" False to Scan
            Send Assert (Scan.sOpenOut = "" and Scan.iCommentAt = 19) "an end comment opens nothing"
            Get ScanSourceLine of ghoFuncLib '#REPLACE C_X @"a' "" False to Scan
            Send Assert (Scan.sOpenOut = "") "a directive line opens nothing"
            Get ScanSourceLine of ghoFuncLib '    Showln "Hello' "" False to Scan
            Send Assert (Scan.sOpenOut = "") "a plain string never runs on"
            // Its closing lines
            Get ScanSourceLine of ghoFuncLib '        World" to sText' '"' True to Scan
            Send Assert (Scan.iCloseAt = 14 and Scan.sOpenOut = "") "the first quote ends it"
            Send AssertSAreEqual ((Repeat(" ", 14)) + " to sText") Scan.sCode
            Get ScanSourceLine of ghoFuncLib '        World" + "x") to sText' '"' False to Scan
            Send Assert (Scan.iCloseAt = 14 and Scan.sOpenOut = "") "the code after the quote holds a string of its own"
            Get ScanSourceLine of ghoFuncLib '        http://example.com" to sUrl // done' '"' False to Scan
            Send Assert (Scan.sOpenOut = "" and Scan.iCommentAt = 37) "a // before the quote is text, the one after it a comment"
            Get ScanSourceLine of ghoFuncLib '        no quote here' '"' False to Scan
            Send Assert (Scan.iCloseAt = 0 and Scan.sOpenOut = '"') "a line without the quote is text"
            Get ScanSourceLine of ghoFuncLib '        say "hi"' "'" False to Scan
            Send Assert (Scan.iCloseAt = 0 and Scan.sOpenOut = "'") "a double quote is text in an @' string"
            Get ScanSourceLine of ghoFuncLib '        b" + @"c' '"' False to Scan
            Send Assert (Scan.iCloseAt = 10 and Scan.sOpenOut = '"' and Scan.iOpenAt = 15) "the code after the quote opens the next string"
            Get ScanSourceLine of ghoFuncLib '        b" + """' '"' False to Scan
            Send Assert (Scan.sOpenOut = '"""') "...or a triple-quoted one"
            Get ScanSourceLine of ghoFuncLib '        Move @"x' '"""' False to Scan
            Send Assert (Scan.iCloseAt = 0 and Scan.sOpenOut = '"""') "a triple-quoted string's text opens nothing"
            Get ScanSourceLine of ghoFuncLib '        """ + @"x' '"""' False to Scan
            Send Assert (Scan.iCloseAt = 9 and Scan.sOpenOut = "") "a triple-quoted closer opens nothing more"
            // An end comment and the block-comment markers stand outside every string; the code masks the strings
            Get ScanSourceLine of ghoFuncLib '    Move "a//b /* c" to s /* note */ // end' "" True to Scan
            Send Assert (Scan.iCommentAt = 38 and Scan.iBlockStartAt = 27 and Scan.iBlockEndAt = 35) "the markers outside the string"
            Send AssertSAreEqual ('    Move "         " to s' + Repeat(" ", 12)) Scan.sCode
            Get ScanSourceLine of ghoFuncLib '    x = 1 // a comment /* not a block' "" False to Scan
            Send Assert (Scan.iCommentAt = 11 and Scan.iBlockStartAt = 0) "a /* after the end comment is no block comment"
            // Where an opening line's code ends
            Get _MultiLineStringOpenerCode of ghoFuncLib '    Move (@"a" + @"b DFTrue' to sCode
            Send Assert (Pos("DFTrue", sCode) = 0 and Pos("Move", sCode) > 0 and Length(sCode) = 27) "the code before the open string"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_AtStringBodyUntouched
            // An @-string's text is text however it looks - a comment, a block comment, a #HEADER, a 'Move DFTrue' -
            // its closing line ends it wherever the quote stands, and the code after it is converted (2026-10-29)
            String[] asCode asWant
            Move '    Move DFTrue to bA'                        to asCode[0]
            Move '    Set psHtml to @"Use cFoo DFTrue'          to asCode[1]
            Move '        If (iA eq iB) Begin'                  to asCode[2]
            Move '        // not a comment here'                to asCode[3]
            Move '        /* not a block comment'               to asCode[4]
            Move '        #HEADER'                              to asCode[5]
            Move '        Use cBar DFTrue   '                   to asCode[6]
            Move '        http://example.com" to sUrl'          to asCode[7]
            Move '    Move DFTrue to bB'                        to asCode[8]
            Move "    Get SQLExecDirect of hoSQL @SQL'SELECT"   to asCode[9]
            Move '        WHERE A = "x" AND B = DFTrue'         to asCode[10]
            Move "        ' to iRows"                           to asCode[11]
            Move '    Move DFTrue to bC'                        to asCode[12]
            Move '    Move (@"a'                                to asCode[13]
            Move '        b DFTrue" + @"Move DFTrue to bX'      to asCode[14]
            Move '        If (iA eq iB) Begin'                  to asCode[15]
            Move '        d") to sText'                         to asCode[16]
            Move '    Move DFTrue to bD'                        to asCode[17]
            Move asCode to asWant
            Move '    Move True to bA'                          to asWant[0]
            Move '    Move True to bB'                          to asWant[8]
            Move '    Move True to bC'                          to asWant[12]
            Move '    Move True to bD'                          to asWant[17]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_AtStringOpenerTokenizedTwice
            // The engine re-tokenizes a line a fix changed: an @-string's opening line read again opens the string
            // again - it holds the string's quote, but it is no closing line
            tTokenizer TokenizerData

            Send ClearFuncLibProperties of ghoFuncLib
            Get Tokenizer of ghoFuncLib '    Set psHtml to @"Hello'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False and TokenizerData.bIsInDF23MultiLineString = True) "the opener is a code line"
            Get Tokenizer of ghoFuncLib '    Set psHtml to @"Hello'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False and TokenizerData.bIsInDF23MultiLineString = True) "the opener again is a code line"
            Get Tokenizer of ghoFuncLib '        Move DFTrue to bA'     to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = True and TokenizerData.bIsInDF23MultiLineString = True) "the text is still text"
            Get Tokenizer of ghoFuncLib '        World" to sText // done' to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = True and TokenizerData.bIsInDF23MultiLineString = False) "the closing line ends it"
            Send Assert (pbKeepLineAsWritten(ghoFuncLib) = True) "its text before the quote goes to no line function"
            Send AssertSAreEqual '// done' TokenizerData.sEndComment
            Send Assert (Pos("to sText", TokenizerData.sOverstrikeLine) > 0 and Pos("World", TokenizerData.sOverstrikeLine) = 0) "the code after the quote is code, the text before it masked"
            Get Tokenizer of ghoFuncLib '    Move DFTrue to bB'         to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False and TokenizerData.bIsInDF23MultiLineString = False) "the code after the string is code"
            // A closing line right after the opening one ends the string
            Get Tokenizer of ghoFuncLib '    Move @"Hello'              to TokenizerData
            Get Tokenizer of ghoFuncLib '        World" to sText'       to TokenizerData
            Send Assert (TokenizerData.bIsInDF23MultiLineString = False) "a closing line right after the opener"
            Get Tokenizer of ghoFuncLib '    Move DFTrue to bC'         to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False) "and the code after it is code"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_CloserFollowedByACommentMarker
            // A """ closer followed by + "/*" opens no block comment: a closing line skips the comment tests
            String[] asCode asWant
            Move '    Move ("""'                    to asCode[0]
            Move '        text'                     to asCode[1]
            Move '        """ + "/*") to sText'     to asCode[2]
            Move '    Move DFTrue to bA'            to asCode[3]
            Move asCode to asWant
            Move '    Move True to bA'              to asWant[3]
            Send _RunLinePass (&asCode)
            Send _AssertLines asWant asCode
        End_Procedure

        {Published = True}
        Procedure MultiLineString_BlockCommentEndsAtItsFirstCloser
            // A block comment ends at its first "*/", quotes or not (measured on DataFlex 26). An apostrophe before it
            // ("the framework's DOM nesting. */") opened a string in the line scanner, the "*/" went unseen, and every
            // line below read as comment - in the file walk and the Tokenizer both (2026-10-30, the before/after run)
            tLineScan Scan
            tLineInfo[] aInfo
            tTokenizer TokenizerData
            String[] asWalk asWant asCall
            Integer iCount

            // The line scanner
            Get ScanSourceLine of ghoFuncLib "    /* every row's element */" "" False to Scan
            Send Assert (Scan.iBlockStartAt = 5 and Scan.iBlockEndAt = 28 and Scan.bBlockOpenOut = False) "an apostrophe in a one-line comment"
            Get ScanSourceLine of ghoFuncLib "       the framework's DOM nesting. */" "/*" False to Scan
            Send Assert (Scan.iBlockEndAt = 37 and Scan.bBlockOpenOut = False) "an apostrophe before the closer of an open comment"
            Get ScanSourceLine of ghoFuncLib "       still the comment's text" "/*" False to Scan
            Send Assert (Scan.iBlockEndAt = 0 and Scan.bBlockOpenOut = True) "an open comment's line without a closer"
            Get ScanSourceLine of ghoFuncLib '    say "hi */ Move "a" to sB // c' "/*" False to Scan
            Send Assert (Scan.iBlockEndAt = 13 and Scan.iCommentAt = 31 and Scan.bBlockOpenOut = False) "the code after the closer is code"
            Get ScanSourceLine of ghoFuncLib '    Move 1 to iX /* a // b */ // c' "" True to Scan
            Send Assert (Scan.iBlockStartAt = 18 and Scan.iBlockEndAt = 28 and Scan.iCommentAt = 31) "a // in a comment's text is text"
            Send AssertSAreEqual ('    Move 1 to iX' + Repeat(" ", 14)) Scan.sCode
            Get ScanSourceLine of ghoFuncLib "    /* a */ Move 1 to iX /* it's" "" True to Scan
            Send Assert (Scan.iBlockEndAt = 10 and Scan.bBlockOpenOut = True) "a second comment left open"
            Send AssertSAreEqual (Repeat(" ", 12) + "Move 1 to iX ") Scan.sCode
            Get ScanSourceLine of ghoFuncLib '    say "hi */ Move "a" to sB // c' "/*" True to Scan
            Send AssertSAreEqual (Repeat(" ", 15) + 'Move " " to sB ') Scan.sCode
            Get ScanSourceLine of ghoFuncLib "       still the comment's text" "/*" True to Scan
            Send AssertSAreEqual (Repeat(" ", 31)) Scan.sCode
            Get ScanSourceLine of ghoFuncLib '    /* Set psHtml to """' "" False to Scan
            Send Assert (Scan.sOpenOut = "" and Scan.bBlockOpenOut = True) "a comment's text opens no string"
            Get ScanSourceLine of ghoFuncLib '    Move "*/" to sA /* b' "" False to Scan
            Send Assert (Scan.iBlockStartAt = 21 and Scan.iBlockEndAt = 0 and Scan.bBlockOpenOut = True) "a closer in a string ends nothing"

            // The file walk
            Move "/* HEADER - the note(s) above,"          to asWalk[0]
            Move "   the framework's DOM nesting. */"      to asWalk[1]
            Move "Move DFTrue to bA"                        to asWalk[2]
            Move "/* every row's element */"                to asWalk[3]
            Move "Move DFTrue to bB"                        to asWalk[4]
            Get ScanSourceFile of ghoFuncLib (&asWalk) to aInfo
            Send Assert (aInfo[1].eKind = LK_BlockComment and aInfo[2].eKind = LK_Code) "the walk: the comment ends at its closer"
            Send Assert (aInfo[0].bBlockOpenIn = False and aInfo[1].bBlockOpenIn = True and aInfo[2].bBlockOpenIn = False) "the walk: open at the start"
            Send Assert (aInfo[3].eKind = LK_BlockComment and aInfo[4].eKind = LK_Code) "the walk: a one-line comment"

            // The Tokenizer, through the line functions
            Move asWalk to asWant
            Move "Move True to bA"                          to asWant[2]
            Move "Move True to bB"                          to asWant[4]
            Send _RunLinePass (&asWalk)
            Send _AssertLines asWant asWalk
            Send ClearFuncLibProperties of ghoFuncLib
            Get Tokenizer of ghoFuncLib "/* every row's element */" to TokenizerData
            Get Tokenizer of ghoFuncLib "Move 1 to iX"               to TokenizerData
            Send Assert (TokenizerData.bIsInDF23MultiLineComment = False and TokenizerData.bLineIsReady = False) "the Tokenizer: no carry-over"
            Send ClearFuncLibProperties of ghoFuncLib

            // A whole-file converter: the object call below the comment is flagged, as above it
            Move 'Function HeadPage String sHtml Returns String'    to asCall[0]
            Move '    Function_Return sHtml'                         to asCall[1]
            Move 'End_Function'                                      to asCall[2]
            Move '/* HEADER - the note(s) above,'                    to asCall[3]
            Move "   the framework's DOM nesting. */"                to asCall[4]
            Move 'Procedure End_Construct_Object'                    to asCall[5]
            Move '    Set psHtml to (HeadPage(Self, ""))'            to asCall[6]
            Move 'End_Procedure'                                     to asCall[7]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCall) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertIAreEqual 9 (SizeOfArray(asCall))
            Send Assert (Pos("//TODO DF26 (Get form)", asCall[6]) > 0) "the call below the comment is flagged"
            Send AssertSAreEqual '    Set psHtml to (HeadPage(Self, ""))' asCall[7]
        End_Procedure

        {Published = True}
        Procedure MultiLineString_WalkedCodeLineStopsAtTheOpener
            // A line's code as the file walk read it (_WalkedCodeLine): a string still open at the line's end is text
            // from its opening quote on, as _MultiLineStringOpenerCode reads it - so a tokenizer fed that code never
            // opens the string (the Gosub converter's name list, 2026-10-30)
            String[] asWalk
            tLineInfo[] aInfo
            String sCode

            Move '    Set psHtml to """'      to asWalk[0]
            Move '    Object oText gosub x'   to asWalk[1]
            Move '    """'                    to asWalk[2]
            Move "    Move @'a b to sX"       to asWalk[3]
            Move "    text' to sY"            to asWalk[4]
            Get ScanSourceFile of ghoFuncLib (&asWalk) to aInfo
            Get _WalkedCodeLine of ghoFuncLib asWalk[0] aInfo[0] to sCode
            Send Assert (Trim(sCode) = "Set psHtml to" and Length(sCode) = Length(asWalk[0])) "a triple-quote opener"
            Get _WalkedCodeLine of ghoFuncLib asWalk[1] aInfo[1] to sCode
            Send Assert (Trim(sCode) = "") "the string's text"
            Get _WalkedCodeLine of ghoFuncLib asWalk[3] aInfo[3] to sCode
            Send Assert (Trim(sCode) = "Move @" and Length(sCode) = Length(asWalk[3])) "an @-string opener"
            Get _WalkedCodeLine of ghoFuncLib asWalk[4] aInfo[4] to sCode
            Send Assert (Trim(sCode) = "to sY") "the code after the closing quote"
        End_Procedure

        {Published = True}
        Procedure MultiLineString_ObjectCallAfterAnAtStringConverts
            // ChangeObjectFunctionCallToGet tokenizes only the lines that hold "(self": an @-string opened on one of
            // them hid every call below it, and a call in a string's text is no call (2026-10-29)
            String[] asCode
            Integer iCount
            Move 'Function FormatValue String sRaw Returns String'      to asCode[0]
            Move '    Function_Return sRaw'                              to asCode[1]
            Move 'End_Function'                                          to asCode[2]
            Move 'Procedure Test'                                        to asCode[3]
            Move '    Set psHtml of (oX(Self)) to @"Start'               to asCode[4]
            Move '        Move (FormatValue(Self, sName)) to sOut'       to asCode[5]
            Move '        End" to sText'                                 to asCode[6]
            Move '    Move (FormatValue(Self, sName)) to sOut'           to asCode[7]
            Move 'End_Procedure'                                         to asCode[8]
            Get ChangeObjectFunctionCallToGet of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '        Move (FormatValue(Self, sName)) to sOut' asCode[5]
            Send AssertSAreEqual '    Get FormatValue sName to sOut'               asCode[7]
        End_Procedure

        {Published = True}
        Procedure MultiLineString_AtStringWholeFile
            // The whole-file walk knows an @-string (2026-10-29): its text is kept, its opening line's code is what
            // stands before the quote, its closing line is the editor functions' to keep too, and the code after
            // the string is converted
            String[] asCode
            Boolean[] abKeep abWithCloser
            tLineInfo[] aInfo
            Integer iCount i
            Move 'Object oY is a DFPanel'                     to asCode[0]
            Move '    Set psHtml to @"Object oA is a DFPanel' to asCode[1]
            Move '        Object oX is a DFPanel'             to asCode[2]
            Move '        Procedure Paint for BaseClass'      to asCode[3]
            Move '        End" to sText'                      to asCode[4]
            Move '    Object oZ is a DFPanel'                 to asCode[5]
            Move '    End_Object'                             to asCode[6]
            Move 'End_Object'                                 to asCode[7]
            Get ScanSourceFile of ghoFuncLib (&asCode) to aInfo
            Send Assert (aInfo[0].eKind = LK_Code and aInfo[1].eKind = LK_StringOpener and aInfo[2].eKind = LK_StringText) "the opening line and the text"
            Send Assert (aInfo[3].eKind = LK_StringText and aInfo[4].eKind = LK_StringCloser and aInfo[5].eKind = LK_Code) "the closing line and the code after it"
            Get KeptTextFlags of ghoFuncLib (&asCode) False to abKeep
            Get KeptTextFlags of ghoFuncLib (&asCode) True to abWithCloser
            For i from 0 to 7
                Send Assert (abKeep[i] = (i = 2 or i = 3)) ("kept, line" * String(i))
                Send Assert (abWithCloser[i] = (i >= 2 and i <= 4)) ("kept with the closing line, line" * String(i))
            Loop
            Get ChangeObsoleteClassNames of ghoFuncLib (&asCode) "" to iCount
            Get ChangeObsoleteMethodTarget of ghoFuncLib (&asCode) "cObject" to iCount
            Send AssertSAreEqual 'Object oY is a DfBasePanel'                 asCode[0]
            Send AssertSAreEqual '    Set psHtml to @"Object oA is a DFPanel' asCode[1]
            Send AssertSAreEqual '        Object oX is a DFPanel'             asCode[2]
            Send AssertSAreEqual '        Procedure Paint for BaseClass'      asCode[3]
            Send AssertSAreEqual '    Object oZ is a DfBasePanel'             asCode[5]
        End_Procedure

    End_Object
