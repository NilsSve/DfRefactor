// This is needed to display the source line number for the failed testfixture procedure. The source
// is read from the embedded resource res_UnitTestSource (Include_Resource in UnitTests.src) so
// it works from the .exe alone - no oUnit_Tests.pkg file needed at run time (e.g. the alpha package).
// psUnitTestTestingPackage stays the on-disk fallback / label; psUnitTestResource selects the resource.
Set psUnitTestTestingPackage to "oUnit_Tests.pkg"
Set psUnitTestResource to "res_UnitTestSource"
