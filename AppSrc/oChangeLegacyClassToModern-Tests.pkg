//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeLegacyClassToModern-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-30
//
// Description : Unit tests for ChangeLegacyClassToModern - the parameterised legacy-class swap.
//
//               The real specimen throughout is Nils's case: a donated 2002 package wrapping the
//               Win32 SysMonthCal32 control, which DataFlex now ships as cMonthCalendar.
//                   MyCalendar=cMonthCalendar,use:MyCalendar.pkg=cMonthCalendar.pkg,
//                   get:Current_Item=SelectedDate,set:Current_Item=SetSelectedDate
//
//               Most of these pin what it must NOT do. A class swap that half-converts a workspace
//               is worse than one that does nothing, so every case it cannot attribute has to be
//               left alone AND reported.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeLegacyClassToModern is a cTestFixture
        Set psFunctionName to "ChangeLegacyClassToModern"

        Function CalendarParam Returns String
            Function_Return ("MyCalendar=cMonthCalendar,use:MyCalendar.pkg=cMonthCalendar.pkg," + ;
                             "get:Current_Item=SelectedDate,set:Current_Item=SetSelectedDate")
        End_Function

        // The whole shape at once: Use line, declaration, Get rename, Set-to-Send rewrite.
        {Published = True}
        Procedure LegacyClassSwap_CalendarCase_Converted
            String[] asCode
            String sParam
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Get CalendarParam to sParam
            Move "Use MyCalendar.pkg"                                to asCode[0]
            Move "Object oCal is a MyCalendar"                       to asCode[1]
            Move "End_Object"                                          to asCode[2]
            Move "Procedure Foo"                                       to asCode[3]
            Move "    Date dDate"                                      to asCode[4]
            Move "    Get Current_Item of (oCal(Self)) to dDate"       to asCode[5]
            Move "    Set Current_Item of (oCal(Self)) to dDate"       to asCode[6]
            Move "End_Procedure"                                       to asCode[7]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) sParam to iCount
            Send Assert (iCount = 4)
            Send AssertSAreEqual "Use cMonthCalendar.pkg"                          asCode[0]
            Send AssertSAreEqual "Object oCal is a cMonthCalendar"                 asCode[1]
            Send AssertSAreEqual "    Get SelectedDate of (oCal(Self)) to dDate"   asCode[5]
            Send AssertSAreEqual "    Send SetSelectedDate of (oCal(Self)) dDate"  asCode[6]
        End_Procedure

        /* THE GUARD THAT MATTERS MOST. The member is used on something this file never declared as
           the old class - a handle variable could be anything, and renaming its member is how a
           converter corrupts code that compiled fine. Left alone, and reported. */
        {Published = True}
        Procedure LegacyClassSwap_UnattributableMember_Untouched
            String[] asCode
            String sParam
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CalendarParam to sParam
            Move "Procedure Foo"                                  to asCode[0]
            Move "    Date dDate"                                 to asCode[1]
            Move "    Get Current_Item of hoSomething to dDate"   to asCode[2]
            Move "End_Procedure"                                  to asCode[3]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) sParam to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Get Current_Item of hoSomething to dDate" asCode[2]
        End_Procedure

        // A SUBCLASS is never re-based - that changes what someone's overrides override.
        {Published = True}
        Procedure LegacyClassSwap_Subclass_NotRebased
            String[] asCode
            String sParam
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CalendarParam to sParam
            Move "Class MyCalendar is a MyCalendar"  to asCode[0]
            Move "End_Class"                           to asCode[1]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) sParam to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Class MyCalendar is a MyCalendar" asCode[0]
        End_Procedure

        // "is an" is as legal as "is a" and must convert too.
        {Published = True}
        Procedure LegacyClassSwap_IsAn_Converted
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Object oThing is an OldEditor"  to asCode[0]
            Move "End_Object"                     to asCode[1]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "OldEditor=cTextEdit" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Object oThing is an cTextEdit" asCode[0]
        End_Procedure

        // A name inside a string literal is data, not a class.
        {Published = True}
        Procedure LegacyClassSwap_InLiteral_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move 'Procedure Foo'                                 to asCode[0]
            Move '    Move "Object x is a OldEditor" to sText'   to asCode[1]
            Move 'End_Procedure'                                 to asCode[2]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "OldEditor=cTextEdit" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move "Object x is a OldEditor" to sText' asCode[1]
        End_Procedure

        // A longer class name that merely CONTAINS the old one is a different class.
        {Published = True}
        Procedure LegacyClassSwap_LongerClassName_Untouched
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Object oThing is a OldEditorEx"  to asCode[0]
            Move "End_Object"                      to asCode[1]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "OldEditor=cTextEdit" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Object oThing is a OldEditorEx" asCode[0]
        End_Procedure

        // A malformed parameter does NOTHING rather than something arbitrary.
        {Published = True}
        Procedure LegacyClassSwap_BadParameter_DoesNothing
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Object oCal is a MyCalendar" to asCode[0]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "no-equals-sign-here" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Object oCal is a MyCalendar" asCode[0]
        End_Procedure

        // An empty parameter likewise - a run that silently converts on a default would be worse
        // than one that reports nothing happened.
        {Published = True}
        Procedure LegacyClassSwap_EmptyParameter_DoesNothing
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Object oCal is a MyCalendar" to asCode[0]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "Object oCal is a MyCalendar" asCode[0]
        End_Procedure

        // The class swap alone, with no member pairs given, must still work - the common case for
        // a package whose surface did not change.
        {Published = True}
        Procedure LegacyClassSwap_ClassOnly_Converted
            String[] asCode
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Move "Object oT is a dfTimer"   to asCode[0]
            Move "End_Object"               to asCode[1]
            Get ChangeLegacyClassToModern of ghoFuncLib (&asCode) "dfTimer=cTimer" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "Object oT is a cTimer" asCode[0]
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
