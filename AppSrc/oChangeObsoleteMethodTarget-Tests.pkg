    Object oChangeObsoleteMethodTarget is a cTestFixture
        Set psFunctionName to "ChangeObsoleteMethodTarget"

        // One line through the whole-file function.
        Function _Convert String sLine String sParameter Returns String
            String[] asCode
            Integer iCount
            Move sLine to asCode[0]
            Get ChangeObsoleteMethodTarget of ghoFuncLib (&asCode) sParameter to iCount
            Function_Return asCode[0]
        End_Function

        // A header AFTER another method - the line a line function never sees - and the count.
        {Published = True}
        Procedure ChangeObsoleteMethodTarget_HeaderAfterAMethod
            String[] asCode
            Integer iCount
            Move "Procedure OnStart"                    to asCode[0]
            Move "End_Procedure"                        to asCode[1]
            Move "Procedure Exit_Application For BaseClass" to asCode[2]
            Move "    Send Close_Panel"                 to asCode[3]
            Move "End_Procedure"                        to asCode[4]
            Get ChangeObsoleteMethodTarget of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual "Procedure Exit_Application For cObject" asCode[2]
        End_Procedure

        // for DFDesktop becomes the Desktop keyword, whatever the parameter says.
        {Published = True}
        Procedure ChangeObsoleteMethodTarget_DFDesktop
            String sLine
            Get _Convert "Procedure Desktop_Notify_Exit_Application For DFDesktop" "" to sLine
            Send AssertSAreEqual "Procedure Desktop_Notify_Exit_Application Desktop" sLine
            Get _Convert "    Function Foo for DFDesktop Integer iInt Returns String" "cObject" to sLine
            Send AssertSAreEqual "    Function Foo Desktop Integer iInt Returns String" sLine
        End_Procedure

        // for Desktop and for BaseClass become for cObject by default - parameters and Set kept.
        {Published = True}
        Procedure ChangeObsoleteMethodTarget_DesktopAndBaseClassToCObject
            String sLine
            Get _Convert "Function Confirm For DESKTOP String item_name Returns Integer" "" to sLine
            Send AssertSAreEqual "Function Confirm For cObject String item_name Returns Integer" sLine
            Get _Convert "Procedure Set psName for BaseClass String sValue" "cObject" to sLine
            Send AssertSAreEqual "Procedure Set psName for cObject String sValue" sLine
        End_Procedure

        // The parameter Desktop writes the Desktop keyword instead.
        {Published = True}
        Procedure ChangeObsoleteMethodTarget_ParameterDesktop
            String sLine
            Get _Convert "Procedure Exit_Application For BaseClass" "Desktop" to sLine
            Send AssertSAreEqual "Procedure Exit_Application Desktop" sLine
        End_Procedure

        // Modern headers, a call and a comment stay as they are.
        {Published = True}
        Procedure ChangeObsoleteMethodTarget_LeavesTheRest
            String[] asLines
            String sLine
            Integer i
            Boolean bAny
            Move "Procedure OnStart for cObject"            to asLines[0]
            Move "Function Foo Desktop Returns Integer"     to asLines[1]
            Move "Procedure Bar Global Integer iValue"      to asLines[2]
            Move "// Procedure Old for Desktop"             to asLines[3]
            Move "Procedure Paint for dfPanel"              to asLines[4]
            Move False to bAny
            For i from 0 to (SizeOfArray(asLines) - 1)
                Get _Convert asLines[i] "" to sLine
                If (sLine <> asLines[i]) ;
                    Move True to bAny
            Loop
            Send AssertFalse bAny
        End_Procedure

    End_Object
