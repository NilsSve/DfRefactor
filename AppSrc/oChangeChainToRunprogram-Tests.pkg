    Object oChangeChainToRunprogram is a cTestFixture
        Set psFunctionName to "ChangeChainToRunprogram"

        // Chain <program> -> Runprogram Wait <program>; the rest of the line rides through intact.
        {Published = True}
        Procedure ChangeChainToRunprogram_Basic
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Chain "report.exe"' to sLine
            Move 'Runprogram Wait "report.exe"' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeChainToRunprogram of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure ChangeChainToRunprogram_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '        Chain sProg' to sLine
            Move '        Runprogram Wait sProg' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeChainToRunprogram of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A longer identifier that merely STARTS with 'Chain' must NOT be swapped (whole-token match).
        {Published = True}
        Procedure ChangeChainToRunprogram_NoMatchPrefix
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ChainList Foo' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeChainToRunprogram of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'ChainList Foo' sLine
        End_Procedure

        // 'Chain Wait ...' already carries the Wait: only the command word is swapped (Nils 2026-09-19:
        // 'Runprogram Wait Wait (...) export_files'). Case-blind on both words; the rest rides through.
        {Published = True}
        Procedure ChangeChainToRunprogram_ExistingWaitNotDoubled
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '  chain Wait (slAccRcvble * "ARCHARGE ACTIVEONLY") export_files            //e029d' to sLine
            Move '  Runprogram Wait (slAccRcvble * "ARCHARGE ACTIVEONLY") export_files            //e029d' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeChainToRunprogram of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A program NAMED like the keyword is not the keyword: 'Chain WaitList' gets the full swap.
        {Published = True}
        Procedure ChangeChainToRunprogram_WaitPrefixedNameStillGetsWait
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Chain WaitList' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeChainToRunprogram of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'Runprogram Wait WaitList' sLine
        End_Procedure

    End_Object
