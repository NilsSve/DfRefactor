//****************************************************************************
// $Module type: Test fixture
// $Module name: oCharacterModeInventory-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-20
//
// Description : Unit tests for the character-mode skeleton test (_IsCharacterModeSkeleton) and the
//               inventory scan core (_CharModeInventoryScanFile) in cRefactorFuncLib - both pure,
//               no engine or file state. Identifiers are GENERIC by design.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oCharacterModeInventory is a cTestFixture
        Set psFunctionName to "CharacterModeInventoryReport"

        // The 3.x skeleton: Use UI (bare or .pkg) and no Windows base. An image before the Use list is
        // skipped - its body is screen text, and "Use" inside it is prose.
        {Published = True}
        Procedure CharMode_UiSkeletonIsCharacterMode
            String[] asLines
            Boolean bChar
            Move "/vMain"                 to asLines[0]
            Move "Use the program"        to asLines[1]
            Move "/*"                     to asLines[2]
            Move "Use UI"                 to asLines[3]
            Move "Use DLL.pkg"            to asLines[4]
            Get _IsCharacterModeSkeleton of ghoFuncLib asLines to bChar
            Send Assert (bChar = True)
            // with the extension an earlier run may have given it, still character mode
            Move "Use UI.pkg"             to asLines[3]
            Get _IsCharacterModeSkeleton of ghoFuncLib asLines to bChar
            Send Assert (bChar = True)
        End_Procedure

        {Published = True}
        Procedure CharMode_WindowsSkeletonIsNot
            String[] asLines
            Boolean bChar
            Move "Use DFAllEnt.pkg"       to asLines[0]
            Move "Use cApplication.pkg"   to asLines[1]
            Get _IsCharacterModeSkeleton of ghoFuncLib asLines to bChar
            Send Assert (bChar = False)
        End_Procedure

        // Use UI beside a Windows base (a console-mode program carried into a Windows skeleton) is Windows.
        {Published = True}
        Procedure CharMode_UiBesideWindowsBaseIsNot
            String[] asLines
            Boolean bChar
            Move "Use UI.pkg"             to asLines[0]
            Move "Use Windows.pkg"        to asLines[1]
            Get _IsCharacterModeSkeleton of ghoFuncLib asLines to bChar
            Send Assert (bChar = False)
        End_Procedure

        // One of each kind, the image body skipped (its "Page Accept Entry" is text), a command word in
        // a string not counted, and the per-file tally + report lines matching.
        {Published = True}
        Procedure CharMode_InventoryCountsAndSkipsImageBodies
            String[] asCode asReport
            tCharModeInventory Inv
            Integer iN
            Move "/vMain"                                          to asCode[0]
            Move "Page Accept Entry gotoxy - screen text here"     to asCode[1]
            Move "/*"                                              to asCode[2]
            Move "Page vMain"                                      to asCode[3]
            Move "    Accept Customer.Name"                        to asCode[4]
            Move "Object oCust is a Entry_Form"                    to asCode[5]
            Move "    Entry_Item Customer.Name"                    to asCode[6]
            Move "End_Object"                                      to asCode[7]
            Move "Keyproc Key.F2"                                  to asCode[8]
            Move "    Gotoxy 5 10"                                 to asCode[9]
            Move "Return"                                          to asCode[10]
            Move 'Move "Page" to sLabel'                           to asCode[11]
            Get _CharModeInventoryScanFile of ghoFuncLib (&asCode) (&asReport) (&Inv) to iN
            Send AssertIAreEqual 6 iN
            Send AssertIAreEqual 1 Inv.iImages
            Send AssertIAreEqual 3 Inv.iScreenCmds
            Send AssertIAreEqual 1 Inv.iUiObjects
            Send AssertIAreEqual 1 Inv.iKeyprocs
            Send AssertIAreEqual 1 Inv.iFiles
            Send AssertIAreEqual 6 (SizeOfArray(asReport))
            Send Assert (asReport[0] contains "Line 1: image:")
            Send Assert (asReport[3] contains "UI object (Entry_Form)")   // image, Page, Accept, then the object
        End_Procedure

        // A Windows file: Page as a METHOD name or a message argument is not the screen command, a Panel
        // is not a UI object. Nothing counted, no file counted.
        {Published = True}
        Procedure CharMode_WindowsFileScoresNothing
            String[] asCode asReport
            tCharModeInventory Inv
            Integer iN
            Move "Use DFAllEnt.pkg"                                to asCode[0]
            Move "Object oMain is a Panel"                         to asCode[1]
            Move "    Procedure Page Integer iPageObject"          to asCode[2]
            Move "        Forward Send Page iPageObject"           to asCode[3]
            Move "    End_Procedure"                               to asCode[4]
            Move "End_Object"                                      to asCode[5]
            Get _CharModeInventoryScanFile of ghoFuncLib (&asCode) (&asReport) (&Inv) to iN
            Send AssertIAreEqual 0 iN
            Send AssertIAreEqual 0 Inv.iFiles
            Send AssertIAreEqual 0 (SizeOfArray(asReport))
        End_Procedure

        // THE GATE'S LIST (FunctionNeedsWindowsProgram): the converters that rewrite Windows
        // user-interface objects, and the removals a character-mode program cannot afford, are on it;
        // the syntax converters and the External_Function work are not. Case-blind.
        {Published = True}
        Procedure CharMode_WindowsOnlyConvertersAreListed
            Boolean bNeeds
            Get FunctionNeedsWindowsProgram of ghoFuncLib "RefactorGridToCJGrid" to bNeeds
            Send Assert (bNeeds = True)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "changedfcreatemenutocodejock" to bNeeds
            Send Assert (bNeeds = True)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "ChangeLegacyShadow_State" to bNeeds
            Send Assert (bNeeds = True)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "CommentOutObsoleteDevCommands" to bNeeds
            Send Assert (bNeeds = True)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "MakeFileAutonomous" to bNeeds
            Send Assert (bNeeds = True)
        End_Procedure

        {Published = True}
        Procedure CharMode_SyntaxAndExternalFunctionConvertersAreNotListed
            Boolean bNeeds
            Get FunctionNeedsWindowsProgram of ghoFuncLib "ChangeLegacyOperators" to bNeeds
            Send Assert (bNeeds = False)
            // Local and Chain are the USER'S never-pick choice, not the gate's (Nils 2026-09-23).
            Get FunctionNeedsWindowsProgram of ghoFuncLib "RemoveLocalKeyWord" to bNeeds
            Send Assert (bNeeds = False)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "ChangeChainToRunprogram" to bNeeds
            Send Assert (bNeeds = False)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "ChangeIfNotCommandToExpression" to bNeeds
            Send Assert (bNeeds = False)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "GuardAnsiExternalFunctionWithWide" to bNeeds
            Send Assert (bNeeds = False)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "CharacterModeInventoryReport" to bNeeds
            Send Assert (bNeeds = False)
            Get FunctionNeedsWindowsProgram of ghoFuncLib "" to bNeeds
            Send Assert (bNeeds = False)
        End_Procedure

    End_Object
