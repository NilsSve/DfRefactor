//****************************************************************************
// $Module type: Test fixture
// $Module name: oCompileMixin-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-28
//
// Description : Unit tests for cCompileMixin's DfCliProgramIsListed - the dialect gate for df-cli
//               compiles. THE REGRESSION THAT DEMANDED IT (alpha era, Nils 2026-08-28): "build --target"
//               on a program missing from the workspace's "projects" answers "Could not find project in
//               workspace" and exits without compiling and without an .err - so TestBench's Test Compile
//               of CompiledRefactoredCode.src, which is deliberately NOT a project (a scratch harness in
//               the list would pollute the Studio's and the dashboard's program combos), reported "No
//               errors" whatever the refactored code held. The gate routes an unlisted program to the
//               build-file dialect, which compiles plain files and writes a real .err on failure.
//
//               The mixin is hosted on a bare class here because the DFUnit runner's application object
//               is a plain cApplication - it does not import the mixin. DfCliProgramIsListed is pure
//               (struct + string in, Boolean out), so the bare host needs none of the host properties
//               the compile-launching functions read.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cCompileMixin.pkg

Class _cCompileMixinTestHost is a cObject
    Import_Class_Protocol cCompileMixin
End_Class

Object oCompileMixinTestHost is a _cCompileMixinTestHost
End_Object

    Object oCompileMixin_Tests is a cTestFixture
        Set psFunctionName to "cCompileMixin"

        Function _WsWithProjects Returns tSwsFile
            tSwsFile WS
            Move "TestBench.src"    to WS.aProjects[0].sName
            Move "DFRefactorFT.src" to WS.aProjects[1].sName
            Function_Return WS
        End_Function

        // A listed program keeps the workspace-level "build --target" dialect.
        {Published = True}
        Procedure CompileMixin_ListedProgramIsListed
            tSwsFile WS
            Boolean bListed
            Get _WsWithProjects to WS
            Get DfCliProgramIsListed of oCompileMixinTestHost WS "TestBench.src" to bListed
            Send Assert (bListed = True)
        End_Procedure

        // ...tolerantly: neither case nor the ".src" extension may matter, on either side.
        {Published = True}
        Procedure CompileMixin_ListingIsCaseAndExtensionTolerant
            tSwsFile WS
            Boolean bListed
            Get _WsWithProjects to WS
            Get DfCliProgramIsListed of oCompileMixinTestHost WS "testbench" to bListed
            Send Assert (bListed = True)
            Get DfCliProgramIsListed of oCompileMixinTestHost WS "DFREFACTORFT.SRC" to bListed
            Send Assert (bListed = True)
        End_Procedure

        /* THE REPORTED SHAPE: CompiledRefactoredCode.src is not among the projects and must
           answer False - anything else re-creates the always-successful Test Compile. */
        {Published = True}
        Procedure CompileMixin_UnlistedProgramIsNotListed
            tSwsFile WS
            Boolean bListed
            Get _WsWithProjects to WS
            Get DfCliProgramIsListed of oCompileMixinTestHost WS "CompiledRefactoredCode.src" to bListed
            Send Assert (bListed = False)
        End_Procedure

        // An EMPTY projects list means "nothing to check against" (a legacy INI .ws carries no
        // projects array) - answer True and keep the current dialect, never invent a diversion.
        {Published = True}
        Procedure CompileMixin_EmptyProjectsAnswersListed
            tSwsFile WS
            Boolean bListed
            Get DfCliProgramIsListed of oCompileMixinTestHost WS "CompiledRefactoredCode.src" to bListed
            Send Assert (bListed = True)
        End_Procedure

        // ---- MISSING LINKED IMAGES (Nils 2026-09-18): the three pure helpers behind OfferAndFixMissingLinkImages.

        // The .err of a DF25 example built under DF26, verbatim: one name, from the OPEN FILE line only;
        // the ADD THE BITMAPS / CREATE EXECUTABLE lines carry no name and a real ERROR: line is not a link line.
        {Published = True}
        Procedure CompileMixin_LinkImagesMissingFromErr_NamesTheFileOnce
            String[] asErr asOut
            Move "LINK ERROR:    UNABLE TO OPEN FILE DacAbout.bmp"     to asErr[0]
            Move "LINK ERROR:    UNABLE TO ADD THE BITMAPS"            to asErr[1]
            Move "LINK ERROR:    UNABLE TO CREATE EXECUTABLE"          to asErr[2]
            Move "LINK ERROR:    UNABLE TO OPEN FILE dacabout.BMP"     to asErr[3]   // the same file, another case
            Move "ERROR: 54 Argument must be an existing class name: UNABLE TO OPEN FILE Other.bmp" to asErr[4]
            Move "LINK ERROR:    UNABLE TO OPEN FILE Order Logo.ico"   to asErr[5]   // a name with a space survives whole
            Get LinkImagesMissingFromErr of oCompileMixinTestHost asErr to asOut
            Send AssertIAreEqual 2 (SizeOfArray(asOut))
            Send AssertSAreEqual "DacAbout.bmp"   asOut[0]
            Send AssertSAreEqual "Order Logo.ico" asOut[1]
        End_Procedure

        // A .cfg as the Studio writes it: the images are the VALUES under [Bitmaps] and [Icons] - the
        // [Application] Icon= (the .exe icon) and the [Compiler] keys are not images.
        Function _SampleCfg Returns String[]
            String[] asCfg
            Move "[Application]"                      to asCfg[0]
            Move "Icon=Order.ico"                     to asCfg[1]
            Move "BuildManifestFile=1"                to asCfg[2]
            Move "[Compiler]"                         to asCfg[3]
            Move "Platform=x64"                       to asCfg[4]
            Move "[Bitmaps]"                          to asCfg[5]
            Move "DacAbout.bmp=DacAbout.bmp"          to asCfg[6]
            Move "DR32.bmp=DR32.bmp"                  to asCfg[7]
            Move "[Icons]"                            to asCfg[8]
            Move "ActionAbout.ico=ActionAbout.ico"    to asCfg[9]
            Move "ActionPrompt.ico=ActionPrompt.Ico"  to asCfg[10]  // the Studio's own case slip
            Move "[Precompile]"                       to asCfg[11]
            Move "DacAbout.bmp=NotAnImageSection"     to asCfg[12]
            Function_Return asCfg
        End_Function

        {Published = True}
        Procedure CompileMixin_CfgLinkedImageNames_BitmapsAndIconsOnly
            String[] asCfg asOut
            Get _SampleCfg to asCfg
            Get CfgLinkedImageNames of oCompileMixinTestHost asCfg to asOut
            Send AssertIAreEqual 4 (SizeOfArray(asOut))
            Send AssertSAreEqual "DacAbout.bmp"     asOut[0]
            Send AssertSAreEqual "DR32.bmp"         asOut[1]
            Send AssertSAreEqual "ActionAbout.ico"  asOut[2]
            Send AssertSAreEqual "ActionPrompt.Ico" asOut[3]
        End_Procedure

        // Dropping is case-blind on the value, touches only the image sections, and leaves every other
        // line - including a same-named key in a section that is not an image list - exactly where it was.
        {Published = True}
        Procedure CompileMixin_RemoveCfgLinkedImages_DropsOnlyTheNamedLines
            String[] asCfg asDrop
            Integer iGone
            Get _SampleCfg to asCfg
            Move "dacabout.bmp"    to asDrop[0]
            Move "ActionPrompt.ico" to asDrop[1]
            Get RemoveCfgLinkedImages of oCompileMixinTestHost (&asCfg) asDrop to iGone
            Send AssertIAreEqual 2 iGone
            Send AssertIAreEqual 11 (SizeOfArray(asCfg))
            Send AssertSAreEqual "[Application]"                   asCfg[0]
            Send AssertSAreEqual "Icon=Order.ico"                  asCfg[1]
            Send AssertSAreEqual "[Bitmaps]"                       asCfg[5]
            Send AssertSAreEqual "DR32.bmp=DR32.bmp"               asCfg[6]
            Send AssertSAreEqual "[Icons]"                         asCfg[7]
            Send AssertSAreEqual "ActionAbout.ico=ActionAbout.ico" asCfg[8]
            Send AssertSAreEqual "[Precompile]"                    asCfg[9]
            Send AssertSAreEqual "DacAbout.bmp=NotAnImageSection"  asCfg[10]
        End_Procedure

        // A name that is not listed drops nothing and changes nothing.
        {Published = True}
        Procedure CompileMixin_RemoveCfgLinkedImages_UnknownNameIsANoOp
            String[] asCfg asDrop
            Integer iGone
            Get _SampleCfg to asCfg
            Move "Nowhere.bmp" to asDrop[0]
            Get RemoveCfgLinkedImages of oCompileMixinTestHost (&asCfg) asDrop to iGone
            Send AssertIAreEqual 0 iGone
            Send AssertIAreEqual 13 (SizeOfArray(asCfg))
        End_Procedure

    End_Object
