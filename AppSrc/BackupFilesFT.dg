Use Windows.pkg
Use Cursor.pkg
Use vWin32fh.pkg
Use cFTCJSelectionGrid.pkg
Use cCJCommandBarSystem.pkg
Use RefactorConstants.h.pkg
Use cRDCButtonDPI.pkg    
Use cFTModalPanel.pkg
Use RefactorFileIO.pkg
Use FTAllWebControlClasses.pkg   // FT: cFTWebButton - the two button bars
Use cFTGridHost.pkg              // FT: their hosts - a grid of 8 px columns (RDCFlexTron)
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette
Use FTMessageBox.pkg             // FTStopBox / FTYesNoBox (RDCFlexTron)

Object oBackupFiles_dg is a cFTModalPanel
    Set Label to "Undo Refactoring - Revert Backup Files to Their Original Folder(s)"
    Set Size to 244 664
    Set Location to 2 0
    Set piMinSize to 208 548
    Set Icon to "UndoRefactoring.ico"

    Property tRFSearchResult[] pasSearchResultArray
    // True only while MoveBackBackupFiles is iterating. Drives RefreshBottomButtons, which sets the bars'
    // buttons: Revert becomes a live Stop, and Compare, Close and the select buttons are shut for the move.
    Property Boolean pbOperationInProgress False
    // The grid selection captured in the Revert button's OnClick (a grid-safe context, inside the click),
    // so the move (the click relay -> OnButtonClick -> DoMoveFiles -> MoveBackBackupFiles) never re-queries
    // the grid - a by-handle grid query from the relay's timer faults err 98 (see oRefactorPlanDialogFT.dg).
    Property String[] pasCapturedSelection

    Object oBackupFiles_grd is a cFTCJSelectionGrid
        Set Size to 175 638
        Set Location to 29 14

        Object oCJGridColumnRowIndicator is a cCJGridColumnRowIndicator
            Set piWidth to 24
            Set pbResizable to False
        End_Object

        Object oFileName_col is a cCJGridColumn
            Set piWidth to 217
            Set psCaption to "Backup File Name"
            Set psToolTip to "Backup file name without path"
        End_Object

        Object oFileDate_col is a cCJGridColumn
            Set piWidth to 200
            Set psCaption to "File Date & Time"
            Set psToolTip to "The backed up file name including full path"
        End_Object

        Object oPath_col is a cCJGridColumn
            // This must be here:
            Set phoData_Col to Self

            Set piWidth to 657
            Set psCaption to "Full Path and File Name"
        End_Object

        Procedure LoadData
            Handle hoDataSource
            tDataSourceRow[] TheData TheDataEmpty
            tRFSearchResult[] asSearchResultArray
            Integer iSize iRow iCount iFileNameCol iPathCol iFileDateCol iCheckBoxCol

            If (not(IsComObjectCreated(Self))) Begin
                Procedure_Return
            End

            Get pasSearchResultArray to asSearchResultArray
            Move (SizeOfArray(asSearchResultArray)) to iSize
            If (iSize = 0) Begin
                Send ResetGrid 
                Set psFooterText of oFileName_col  to ""
                Set psFooterText of oPath_col      to ""
                Set psFooterText of oCheckbox_col  to ""
                Procedure_Return
            End

            Move 0 to iCount
            Decrement iSize
            Get phoDataSource to hoDataSource
            Get DataSource of hoDataSource to TheData
            Move TheDataEmpty to TheData
            Get piColumnId of oFileName_col to iFileNameCol
            Get piColumnId of oFileDate_col to iFileDateCol
            Get piColumnId of oPath_col     to iPathCol
            Get piColumnId of (phoCheckbox_Col(Self)) to iCheckBoxCol

            Move 0 to iRow
            For iCount from 0 to iSize
                Move asSearchResultArray[iCount].sFilename           to TheData[iRow].sValue[iFileNameCol]
                Move asSearchResultArray[iCount].dtLastWriteDateTime to TheData[iRow].sValue[iFileDateCol]
                Move (Trim(asSearchResultArray[iCount].sPath) + Trim(asSearchResultArray[iCount].sFilename)) to TheData[iRow].sValue[iPathCol]
                Move False                                           to TheData[iRow].sValue[iCheckBoxCol]
                Increment iRow
            Loop

            If (iRow <> 0) Begin
                Send ReInitializeData TheData False
                Send MoveToFirstRow
            End
            Else Begin
                Send InitializeData TheDataEmpty
            End
            Get CheckedItems to iCount
            Set psFooterText of oFileName_col  to ("No of Backup Files:" * String(iSize + 1))
        End_Procedure

    End_Object

    Object oInfo_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 10 344
        Set Location to 218 31
        Set Label to "The selected file(s) will be MOVED from backup folder(s) to their *original* folders, to 'Undo' refactoring changes."
        Set peAnchors to anBottomRight
        Set Justification_Mode to JMode_Left
    End_Object

    Object oInfo2_tb is a TextBox
        Set Auto_Size_State to False
        Set Size to 10 344
        Set Location to 231 31
        Set Label to "Note: Files are backuped before refactoring, but it doesn't mean that they were actually modified."
        Set peAnchors to anBottomRight
        Set Justification_Mode to JMode_Left
    End_Object

    /* THE BOTTOM BAR: Revert, Compare, Close - framework buttons (cFTWebButton, RDCFlexTron) on a grid host of
       8 px columns, right-aligned: column 0 takes the rest of the width. "Revert" matches the dashboard's Revert
       chip that opens this dialog (Nils 2026-07-04); the action is unchanged - the backup copy is MOVED back
       over the workspace file. Each button's work runs in its OnButtonClick, after the web click has returned
       (the library's click relay), where the Yes/No boxes and Close_Panel are safe.

       WHILE A MOVE RUNS Revert is a live Stop, and Compare and Close are shut (RefreshBottomButtons). The move
       itself runs from the relay - Revert's OnButtonClick - and its loop pumps messages, so a Stop click is
       handled while that move is still running. Stop cancels right there, inside the click (ProgressTickCancel,
       light), and does NOT hand itself to the relay: a relay armed mid-move would fire once the move had ended,
       as a fresh Revert. Revert captures the grid selection inside the click too - a grid read from the relay's
       timer faults (err 98). Spans fit the captions (Revert ~76 px, Stop ~67, Compare ~91, Close ~72, measured
       2026-09-30). */
    Object oWebBottomBar is a cFTGridHost
        Set Location to 215 360
        Set Size to 20 293
        Set peAnchors to anBottomRight
        Set piColumnCount to 36         // column 0, then Revert's 11, Compare's 13 and Close's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oRevertBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Revert"
            Set psCSSClass to "ftbtn ftg-check"
            Set psToolTip to "Revert the selected file(s): the backup copy is moved back to its original folder, overwriting what is there."

            Procedure OnClick
                Boolean bInProgress
                String[] saSel
                Get pbOperationInProgress of oBackupFiles_dg to bInProgress
                If (bInProgress = True) Begin
                    // The button is Stop: cancel the running move, here - and leave the relay alone.
                    Send ProgressTickCancel of ghoApplication
                    Procedure_Return
                End
                Get SelectedItems of oBackupFiles_grd to saSel
                Set pasCapturedSelection of oBackupFiles_dg to saSel
                Forward Send OnClick
            End_Procedure

            Procedure OnButtonClick
                Send DoMoveFiles of oBackupFiles_dg
            End_Procedure
        End_Object

        Object oCompareBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 13
            Set psCaption to "Compare"
            Set psCSSClass to "ftbtn ftg-compare"
            Set psToolTip to "Start the compare tool set up on the Program Settings dialog."

            Procedure OnButtonClick
                Send DoCompare of oBackupFiles_dg
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piColumnIndex to 25
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close this dialog."

            Procedure OnButtonClick
                Send DoClose of oBackupFiles_dg
            End_Procedure
        End_Object
    End_Object

    // The Move action (was oOK_Btn.OnClick), run from the Revert button's OnButtonClick, after the web click.
    // Uses the selection captured in its OnClick (pasCapturedSelection); it never re-queries the grid here.
    Procedure DoMoveFiles
        Integer iCount iRetval
        String sText
        Boolean bCancelled
        String[] saSel
        tRFSearchResult[] SearchResultArray

        Get pasCapturedSelection to saSel
        Move (SizeOfArray(saSel)) to iCount
        If (iCount = 0) Begin
            Send FTInfoBox "No backup files selected - nothing to do."
            Procedure_Return
        End

        Move ("Are you sure you want to overwrite" * String(iCount) * ;
              "source file(s) with the selected backup file(s)?\n\nNo check will be performed if files already exists. Nor will any check be done if files are newer or not." + ;
              "\n\nThe selected backup files will be moved to and overwrite the files in their original folders.\n\nContinue?") to sText
        Get FTYesNoBox sText to iRetval
        If (iRetval <> MBR_Yes) Begin
            Procedure_Return
        End
        Get FTYesNoBox ("Are you REALLY sure?") to iRetval
        If (iRetval <> MBR_Yes) Begin
            Procedure_Return
        End

        // *** Move Files *** (MoveBackBackupFiles reads pasCapturedSelection and toggles the bar to Stop)
        Send MoveBackBackupFiles
        Get ProgressTickCancelled of ghoApplication to bCancelled

        // Reset grid data
        Get AllBackupFolderFiles of ghoApplication to SearchResultArray
        Set pasSearchResultArray to SearchResultArray
        Send LoadData of oBackupFiles_grd

        If (bCancelled = True) Begin
            Send FTInfoBox "Move stopped by user. Any files moved so far remain in their original folders."
        End
        Else Begin
            Send FTInfoBox "Ready!"
        End
    End_Procedure

    // The Compare action (was oCompare_btn.OnClick), run from the Compare button's OnButtonClick.
    Procedure DoCompare
        String sCompareApp
        Get psFileCompareApp of ghoApplication to sCompareApp
        If (sCompareApp = "") Begin
            Send FTInfoBox "No compare tool is set up. Set one on the 'Program Settings' dialog."
            Procedure_Return
        End
        Send ComparePaths of ghoApplication sCompareApp
    End_Procedure

    // The Close action (was oCancel_Btn.OnClick), run from the Close button's OnButtonClick, after the web
    // click, where Close_Panel cleanly ends the modal loop. Also bound to Alt+C (On_Key); guarded so neither
    // the Close button (shut mid-move) nor Alt+C can close the panel while a move runs.
    Procedure DoClose
        Boolean bInProgress
        Get pbOperationInProgress to bInProgress
        If (bInProgress = True) Begin
            Procedure_Return
        End
        Send Close_Panel
    End_Procedure

    Object oTextBox1 is a TextBox
        Set Size to 10 85
        Set Location to 12 25
        Set Label to "Right click grid for options"
    End_Object

    Procedure MoveBackBackupFiles
        Integer iSize iCount iRetval iPos iSep iSelected iTotal
        String sBackupFileName sSourceFileName sMarker sRel sBefore sSWS
        String[] saSelectedItems
        Boolean bCancelled bAnyReverted
        Handle hoStatusBar hoAnalyzer
        tRFSearchResult[] aAllRows
        tModIgnore[] aNoIgnores

        Get Statusbar_Id to hoStatusBar
        // The move runs from the Revert button's OnButtonClick (the click relay's timer); use the selection
        // captured in its OnClick - a by-handle grid query here would fault err 98 from the timer.
        Get pasCapturedSelection to saSelectedItems
        Move (SizeOfArray(saSelectedItems)) to iSize
        Move iSize to iSelected                 // kept whole - iSize becomes the loop bound below
        Decrement iSize

        // Enter "moving" mode: RefreshBottomButtons makes Revert a live Stop and shuts Compare, Close and
        // the select buttons (the Stop is then the only control that acts). PumpMsgQueue forces the WebView2
        // repaint before the first vMoveFile so the transition is visible even for short move sets that
        // would otherwise finish in milliseconds.
        Set pbOperationInProgress to True
        Send RefreshBottomButtons
        Send PumpMsgQueue of Desktop
        Send ProgressTickStart of ghoApplication

        For iCount from 0 to iSize
            Move saSelectedItems[iCount] to sBackupFileName
            // Reconstruct the original full path from the backup path. Two backup
            // layouts can coexist in the same folder, so handle BOTH:
            //   NEW (drive-encoded):  <home>\<BackupFolder>\<drive>\<rest>\<file>
            //       the drive-colon was turned into a folder by
            //       cRefactorApplication.BackupSubfolderForFile, so a file on ANY
            //       root (incl. libraries outside the home) round-trips to its TRUE
            //       location.
            //   OLD (home-relative):  <home>\<BackupFolder>\<rest>\<file>
            //       the pre-fix scheme; only ever correct for files that really live
            //       under the workspace home (e.g. appsrc\, ddsrc\).
            // Strip up to and including "\<BackupFolder>\", then tell the two apart by
            // the first segment: a 1-char segment is a drive letter (NEW) - turn it
            // back into "<drive>:"; anything longer is a real folder (OLD) - prepend
            // the part before the BackupFolder, i.e. the workspace home (sBefore).
            // Without the OLD branch, "appsrc\foo.pkg" would be mangled into the
            // invalid drive "appsrc:\foo.pkg" and the move would silently fail.
            Move (CS_DirSeparator + CS_BackupFolder + CS_DirSeparator) to sMarker
            Move (Pos(sMarker, sBackupFileName)) to iPos
            If (iPos > 0) Begin
                Move (Left(sBackupFileName, (iPos - 1))) to sBefore
                Move (Mid(sBackupFileName, (Length(sBackupFileName)), (iPos + Length(sMarker)))) to sRel
                Move (Pos(CS_DirSeparator, sRel)) to iSep
                If (iSep = 2) Begin
                    // NEW scheme: leading 1-char drive-letter folder -> "<drive>:".
                    Move (Left(sRel, 1) + ":" + Mid(sRel, (Length(sRel)), 2)) to sSourceFileName
                End
                Else Begin
                    // OLD home-relative scheme -> workspace home + relative path.
                    Move (sBefore + CS_DirSeparator + sRel) to sSourceFileName
                End
            End
            Else Begin
                Move sBackupFileName to sSourceFileName
            End
            Move (vMoveFile(sBackupFileName, sSourceFileName)) to iRetval
            Move True to bAnyReverted
            If (hoStatusBar <> 0) Begin
                Set StatusText to ("Moving file:" * String(sSourceFileName) - " (click Stop to cancel)")
            End
            Get ProgressTick of ghoApplication to bCancelled
            If (bCancelled = True) Begin
                Move iSize to iCount
            End
        Loop

        // Restore the bars to their idle state. Flip pbOperationInProgress FIRST so RefreshBottomButtons
        // reads the idle state and sets Revert, Compare, Close and the select buttons back.
        Set pbOperationInProgress to False
        Send RefreshBottomButtons

        // A revert restored pre-run source, so the last analyze behind the "Create Modernization Plan"
        // tile no longer matches what's on disk. INVALIDATE it so the tile falls back to "not analyzed -
        // re-analyze". Two stores hold that state: the persistent per-workspace REGISTRY snapshot AND the
        // in-memory ghiLastAnalyzeDone the tile actually gates on (DashboardFT.ModernizeTileHtml). The
        // registry is only re-seeded into the globals on a workspace CHANGE (RefreshAnalyze ->
        // RestoreAnalyzeSnapshot), so for a SAME-workspace revert clearing the registry alone leaves the
        // tile showing stale numbers - zero the in-memory flag too, then re-render via RefreshAnalyze.
        // The progress HISTORY (ModProgress-<wskey>.json) is deliberately left intact: a selective revert
        // doesn't undo the whole modernization journey, and the next analyze records the bump. (Nils 2026-07-07.)
        If (bAnyReverted = True) Begin
            Get psSWSFile of ghoApplication to sSWS
            Send ClearAnalyzeSnapshot of ghoApplication sSWS
            Move 0 to ghiLastAnalyzeDone
            Broadcast Send RefreshAnalyze of (Client_Id(phoMainPanel(ghoApplication)))
            // ...and the FINDINGS BOARD itself. RefreshAnalyze re-renders the tiles, but the
            // analyzer grid was still holding rows harvested from the source this revert just
            // replaced - and the tick stamps went on certifying them (Nils 2026-08-27: "the
            // dashboard grid should be wiped, but it was not"). SourceReverted is the same wipe a
            // workspace change does, minus the saved-Check restore - the snapshot was cleared
            // above, so there is nothing valid to bring back.
            Broadcast Send SourceReverted of (Client_Id(phoMainPanel(ghoApplication)))
        End

        /* A revert of EVERY backed-up file empties the ignore list as well (Nils 2026-08-05: after
           resetting all of a workspace's source, "N hidden - Show them again" on the Check board
           reads as nonsense - those findings were hidden against code that no longer exists).

           ONLY on a full revert. A selective one keeps the list, for the same reason the progress
           history above survives: hiding a group is a judgement about the work, and reverting three
           files does not retract it. The test is the whole backup set, not "did the user press
           Select All" - and a run stopped part-way is not a full revert either, so bCancelled
           disqualifies it.

           The file is emptied rather than the board told to refresh: the board may not be open, and
           it re-reads the ignore list whenever it next renders. */
        Get pasSearchResultArray to aAllRows
        Move (SizeOfArray(aAllRows)) to iTotal
        If (bAnyReverted = True and bCancelled = False and iTotal > 0 and iSelected >= iTotal) Begin
            Get Create (RefClass(cModAnalyzer)) to hoAnalyzer
            Send WriteIgnored of hoAnalyzer aNoIgnores
            Send Destroy of hoAnalyzer
        End
    End_Procedure

    /* THE SELECT BAR: Select All / None / Invert, framework buttons (cFTWebButton, RDCFlexTron) on a grid host of
       8 px columns, in the top-right corner (column 0 takes the rest of the width). Each routes to the grid
       INSIDE the click - an OnClick override - as the chips did, and is shut while a move runs
       (RefreshBottomButtons): the chips stayed live then and did nothing. Spans fit the captions (Select All
       ~91 px, Select None ~107, Invert ~73, measured 2026-09-30). */
    Object oWebSelectBar is a cFTGridHost
        Set Location to 5 255
        Set Size to 20 397      // spans to the grid's right edge; the buttons keep to the top-right corner
        Set peAnchors to anTopLeftRight
        Set piColumnCount to 40         // column 0, then Select All's 13, Select None's 15 and Invert's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oSelectAllBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 13
            Set psCaption to "Select All"
            Set psCSSClass to "ftbtn ftg-selectall"

            Procedure OnClick
                Boolean bInProgress
                Get pbOperationInProgress of oBackupFiles_dg to bInProgress
                If (bInProgress = True) ;
                    Procedure_Return
                Send SelectAll of oBackupFiles_grd
                Forward Send OnClick
            End_Procedure
        End_Object

        Object oSelectNoneBtn is a cFTWebButton
            Set piColumnIndex to 14
            Set piColumnSpan to 15
            Set psCaption to "Select None"
            Set psCSSClass to "ftbtn ftg-selectnone"

            Procedure OnClick
                Boolean bInProgress
                Get pbOperationInProgress of oBackupFiles_dg to bInProgress
                If (bInProgress = True) ;
                    Procedure_Return
                Send SelectNone of oBackupFiles_grd
                Forward Send OnClick
            End_Procedure
        End_Object

        Object oInvertBtn is a cFTWebButton
            Set piColumnIndex to 29
            Set piColumnSpan to 11
            Set psCaption to "Invert"
            Set psCSSClass to "ftbtn ftg-invert"

            Procedure OnClick
                Boolean bInProgress
                Get pbOperationInProgress of oBackupFiles_dg to bInProgress
                If (bInProgress = True) ;
                    Procedure_Return
                Send SelectInvert of oBackupFiles_grd
                Forward Send OnClick
            End_Procedure
        End_Object
    End_Object

    /* THE BARS' STATE, from pbOperationInProgress: while a move runs Revert is a live Stop - its caption, glyph
       and tooltip - and Compare, Close and the three select buttons are shut: the Stop is the one control that
       acts. MoveBackBackupFiles sends this as the move starts and as it ends. Below the select bar, because it
       names that bar's buttons - an object is known only below its definition. */
    Procedure RefreshBottomButtons
        Boolean bInProgress bIdle
        Handle hoBar hoSel hoRevert
        Get pbOperationInProgress to bInProgress
        Move (not(bInProgress)) to bIdle
        Move (oWebBottomBar(Self)) to hoBar
        Move (oWebSelectBar(Self)) to hoSel
        Move (oRevertBtn(hoBar)) to hoRevert
        If (bInProgress) Begin
            Send UpdateCaption of hoRevert "Stop"
            Send UpdateToolTip of hoRevert "Stop reverting files. Files already reverted stay reverted."
            Send UpdateGlyph   of hoRevert CS_GlyphClose
        End
        Else Begin
            Send UpdateCaption of hoRevert "Revert"
            Send UpdateToolTip of hoRevert "Revert the selected file(s): the backup copy is moved back to its original folder, overwriting what is there."
            Send UpdateGlyph   of hoRevert CS_GlyphCheck
        End
        Send UpdateEnabled of hoRevert True
        Send UpdateEnabled of (oCompareBtn(hoBar)) bIdle
        Send UpdateEnabled of (oCloseBtn(hoBar)) bIdle
        Send UpdateEnabled of (oSelectAllBtn(hoSel)) bIdle
        Send UpdateEnabled of (oSelectNoneBtn(hoSel)) bIdle
        Send UpdateEnabled of (oInvertBtn(hoSel)) bIdle
        If (not(pbInitWebApp(hoBar))) ;
            Send CheckUpdateWebUI of hoBar
        If (not(pbInitWebApp(hoSel))) ;
            Send CheckUpdateWebUI of hoSel
    End_Procedure

    On_Key Key_Alt+Key_A  Send SelectAll    of oBackupFiles_grd
    On_Key Key_Ctrl+Key_A Send SelectAll    of oBackupFiles_grd
    On_Key Key_Alt+Key_N  Send SelectNone   of oBackupFiles_grd
    On_Key Key_Ctrl+Key_N Send SelectNone   of oBackupFiles_grd
    On_Key Key_Alt+Key_I  Send SelectInvert of oBackupFiles_grd
    On_Key Key_Ctrl+Key_I Send SelectInvert of oBackupFiles_grd
    On_Key Key_Alt+Key_C  Send DoClose      // was KeyAction of oCancel_Btn (now a web button); DoClose no-ops mid-move
End_Object

Procedure FillBackupFilesDialog  tRFSearchResult[] SearchResultArray
    Handle ho

    Move (oBackupFiles_dg(Self)) to ho
    Set pasSearchResultArray of ho to SearchResultArray
    Send Popup of ho
End_Procedure
