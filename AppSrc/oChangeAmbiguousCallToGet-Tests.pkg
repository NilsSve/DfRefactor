//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeAmbiguousCallToGet-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-21
//
// Description : Unit tests for _HoistAmbiguousCallsInLines and its helpers - the PURE core of
//               ChangeAmbiguousCallToGet, which clears error 4544 ("Function GET_<name> with ambiguous return type
//               used in expression") by hoisting the expression-style call into a Get statement.
//
//               The transform was verified against the DF25 compiler on a minimal fixture before being written: two
//               classes each declaring Function Value with a different return type make
//                   If (Value(oAaa,"k") = 1)                                -> ERROR 4544
//                   Variant v / Get Value of (oAaa) ("k") to v / If (v = 1) -> compiles clean
//
//               Emission order is: Variant declaration, Get statement, then the rewritten line - all at the original
//               line's indentation. So a hoist on input line 0 puts the rewritten line at output index 2.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeAmbiguousCallToGet is a cTestFixture
        Set psFunctionName to "ChangeAmbiguousCallToGet"

        Function CACG_Names Returns String[]
            String[] asNames
            Move "Value" to asNames[0]
            Function_Return asNames
        End_Function

        // The core case: an ambiguous call nested in a bigger expression is lifted out.
        {Published = True}
        Procedure CACG_SimpleCall_Hoisted
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    If (Value(oAaa,"k") = 1) Begin' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Variant vDfrGet1" asCode[0]
            Send AssertSAreEqual '    Get Value of (oAaa) ("k") to vDfrGet1' asCode[1]
            Send AssertSAreEqual "    If (vDfrGet1 = 1) Begin" asCode[2]
        End_Procedure

        // Self needs no "of" - it is the implicit target.
        {Published = True}
        Procedure CACG_SelfCall_NoOfClause
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    Move (Value(Self,"k")) to i' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Get Value ("k") to vDfrGet1' asCode[1]
            Send AssertSAreEqual "    Move (vDfrGet1) to i" asCode[2]
        End_Procedure

        // Object only, no further arguments.
        {Published = True}
        Procedure CACG_ObjectOnly_Hoisted
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (Value(oAaa)) to i" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get Value of (oAaa) to vDfrGet1" asCode[1]
        End_Procedure

        // NESTED calls hoist INNERMOST first, so the outer call is left holding a plain variable.
        {Published = True}
        Procedure CACG_NestedCalls_InnermostFirst
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    If (Value(oA, Value(oB,"k")) = 1) Begin' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 2)
            Send AssertSAreEqual '    Get Value of (oB) ("k") to vDfrGet1' asCode[1]
            Send AssertSAreEqual "    Get Value of (oA) (vDfrGet1) to vDfrGet2" asCode[3]
            Send AssertSAreEqual "    If (vDfrGet2 = 1) Begin" asCode[4]
        End_Procedure

        // REAL-WORLD SHAPE (the commonest in the sample workspace, ~42 occurrences in one report file):
        // the ambiguous call nested inside a NON-ambiguous one. Only the inner call is ours to touch; the
        // outer call is left exactly as written.
        {Published = True}
        Procedure CACG_NestedInOtherCall_InnerOnly
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    If (Not(Tbl.Fld >= Value(oForm))) Begin" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get Value of (oForm) to vDfrGet1" asCode[1]
            Send AssertSAreEqual "    If (Not(Tbl.Fld >= vDfrGet1)) Begin" asCode[2]
        End_Procedure

        // REAL-WORLD SHAPE: the ambiguous call as the ARGUMENT of a conversion function.
        {Published = True}
        Procedure CACG_NestedInConversion_Hoisted
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (Date(Value(oForm))) to dTo" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get Value of (oForm) to vDfrGet1" asCode[1]
            Send AssertSAreEqual "    Move (Date(vDfrGet1)) to dTo" asCode[2]
        End_Procedure

        // REAL-WORLD SHAPE: two ambiguous calls on ONE line each get their own temp.
        {Published = True}
        Procedure CACG_TwoCallsOneLine_TwoTemps
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    If (Value(oFrom) = "" or Value(oTo) = "") Begin' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 2)
            Send AssertSAreEqual '    If (vDfrGet2 = "" or vDfrGet1 = "") Begin' asCode[4]
        End_Procedure

        // NEGATIVE (regression, Nils's first live run): LEGACY comparison syntax cannot take a Variant
        // operand - "If (v) Ne ..." fails with error 4317. Converting these introduced 10 real errors, so
        // the line is left for ChangeLegacyOperators to modernise first.
        {Published = True}
        Procedure CACG_LegacyOperatorLine_Untouched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    If (Value(oForm18)) Ne "" Begin' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    If (Value(oForm18)) Ne "" Begin' asCode[0]
        End_Procedure

        // NEGATIVE (same regression): an Indicate line is left alone while it still carries a LEGACY
        // operator - a Variant is rejected there with error 4317.
        {Published = True}
        Procedure CACG_IndicateLine_LegacyOperator_Untouched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    [Select] Indicate select as Tbl.Fld Ge (Value(oForm17))" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // ...but ONCE the operators are modernised that same line MUST convert. Blanket-skipping every
        // Indicate line left these permanently declined, and still counted as legacy work, so the tool kept
        // offering an operators run that then had nothing to do. A Variant is valid in a modern comparison
        // (verified against DF25), so there is nothing to avoid here.
        {Published = True}
        Procedure CACG_IndicateLine_Modernised_Converted
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    [Select] Indicate select as (Tbl.Fld >= (Value(oForm17)))" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Get Value of (oForm17) to vDfrGet1" asCode[1]
            Send AssertSAreEqual "    [Select] Indicate select as (Tbl.Fld >= (vDfrGet1))" asCode[2]
        End_Procedure

        // RE-RUN SAFETY: a partly converted file already holds vDfrGet1, so a later pass must number ABOVE
        // it - two vDfrGet1 declarations in one method would be a compile error introduced by the fix.
        {Published = True}
        Procedure CACG_ReRun_NumbersAboveExisting
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Variant vDfrGet1"                to asCode[0]
            Move "    Get Value of (oA) to vDfrGet1"   to asCode[1]
            Move "    If (vDfrGet1 = 1) Begin"         to asCode[2]
            Move "    Move (Value(oB)) to i"           to asCode[3]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Variant vDfrGet2" asCode[3]
            Send AssertSAreEqual "    Move (vDfrGet2) to i" asCode[5]
        End_Procedure

        // The per-run tally is what turns "1 line changed" into a next action, so pin it: a legacy line and
        // a two-line call are counted SEPARATELY, and only lines that actually carry an ambiguous call are
        // counted at all (an ordinary legacy line must not inflate the figure).
        {Published = True}
        Procedure CACG_SkipTally_CountsByReason
            String[] asCode asNames
            Integer iCount iDone iLegacy iTwoLine

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib          // zero the per-run tally
            Get CACG_Names to asNames
            Move '    If (Value(oA)) Ne "" Begin'        to asCode[0]   // legacy   -> counted
            Move "    Move 1 to i"                       to asCode[1]
            Move "    If (bFoo) ;"                       to asCode[2]
            Move "        Move (Value(oB)) to i"         to asCode[3]   // continuation -> CONVERTS since 2026-08-17 (temps above the If)
            Move "    If (Tbl.Fld Ne 1) Begin"           to asCode[4]   // legacy, NO ambiguous call -> not counted
            Move "    Move (Value(oC)) to i"             to asCode[5]   // convertible
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Get piHoistConverted   of ghoFuncLib to iDone
            Get piHoistSkipLegacy  of ghoFuncLib to iLegacy
            Get piHoistSkipTwoLine of ghoFuncLib to iTwoLine
            Send Assert (iCount   = 2) ("converted " + String(iCount))
            Send Assert (iDone    = 2)
            Send Assert (iLegacy  = 1)
            Send Assert (iTwoLine = 0) ("two-line " + String(iTwoLine))
            // The continuation's temp + Get sit ABOVE 'If (bFoo) ;' with ITS indent, and the call is replaced.
            Send AssertSAreEqual "    Variant vDfrGet1"              asCode[2]
            Send AssertSAreEqual "    Get Value of (oB) to vDfrGet1" asCode[3]
            Send AssertSAreEqual "    If (bFoo) ;"                    asCode[4]
            Send AssertSAreEqual "        Move (vDfrGet1) to i"       asCode[5]
        End_Procedure

        // A Find / Constrain / VConstrain line's eq/ge is the command's MODE, not a comparison: still
        // declined (a Variant temp cannot stand in a mode argument), but under ITS OWN reason and counter -
        // not "old comparison words" - so the dashboard says hand work instead of offering a Change
        // legacy operators run that converts nothing (Nils 2026-08-17: 'Constrain WEB_FORM.NR eq
        // (Value(oX))' -> two 0-of-170 runs and "4 still use old comparison words - so why the question?").
        {Published = True}
        Procedure CACG_SkipTally_FindConstrainModeIsItsOwnReason
            String[] asCode asNames asDeclined
            Integer iCount iDone iLegacy iTwoLine iDbMode
            Boolean bReason

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib
            Get CACG_Names to asNames
            Move '    Constrain WEB_FORM.NR eq (Value(oA))'  to asCode[0]   // mode word   -> db-mode, not legacy
            Move '    Find eq Custs by Index.1'              to asCode[1]   // no call     -> not counted at all
            Move '    VConstrain iFile iField EQ (Value(oB))' to asCode[2]   // mode word   -> db-mode
            Move '    If (Value(oC)) Ne "" Begin'             to asCode[3]   // comparison  -> legacy
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Get piHoistConverted   of ghoFuncLib to iDone
            Get piHoistSkipLegacy  of ghoFuncLib to iLegacy
            Get piHoistSkipTwoLine of ghoFuncLib to iTwoLine
            Get piHoistSkipDbMode  of ghoFuncLib to iDbMode
            Get pasHoistDeclined   of ghoFuncLib to asDeclined
            Send Assert (iCount   = 0)
            Send Assert (iDone    = 0)
            Send Assert (iLegacy  = 1)  ("legacy count " + String(iLegacy))
            Send Assert (iDbMode  = 2)  ("db-mode count " + String(iDbMode))
            Send Assert (iTwoLine = 0)
            Move False to bReason
            If (SizeOfArray(asDeclined) > 0) ;
                Move (Pos("|argument of a Find / Constrain", asDeclined[0]) > 0) to bReason
            Send Assert bReason "the declined entry must carry the Find / Constrain reason"
        End_Procedure

        // A declined line's recorded position must be its line in the SAVED file, not in the array being
        // read. Each conversion inserts two lines, so after one conversion the declined line below it has
        // moved down by two - recording the input index made the row open a real line, but the wrong one.
        {Published = True}
        Procedure CACG_DeclinedLine_RecordsOutputPosition
            String[] asCode asNames asDeclined
            Integer iCount

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (Value(oA)) to i"     to asCode[0]   // converts -> inserts 2 lines above it
            Move "    Move 1 to i"               to asCode[1]
            Move '    If (Value(oB)) Ne "" Begin' to asCode[2]   // declined (legacy comparison) - input line 3
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Get pasHoistDeclined of ghoFuncLib to asDeclined
            Send Assert (SizeOfArray(asDeclined) = 1)
            // Input line 3, but two lines were inserted above it, so it is line 5 in the saved file. The
            // entry is file|line|reason|text (the text rides along for the report since 2026-08-17).
            Send AssertSAreEqual "    Move (vDfrGet1) to i" asCode[2]
            Send Assert (Pos('|5|old comparison words|If (Value(oB)) Ne "" Begin', asDeclined[0]) > 0) asDeclined[0]
        End_Procedure

        // The engine puts a whole-file function over the same file MORE THAN ONCE. An unguarded append
        // therefore recorded every declined call twice: the dialog said 26 where the report - which groups
        // by file and so collapsed the pairs - said 13, and the grid carried 13 duplicate rows (Nils
        // 2026-07-22). A second pass must leave the list AND the counter exactly where the first left them.
        {Published = True}
        Procedure CACG_SecondPassDoesNotDoubleTheDeclinedList
            String[] asCode asNames asDeclined
            Integer iCount iTwoLine

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (Value(oA)) to i"     to asCode[0]   // converts
            Move "    Move 1 to i"               to asCode[1]
            Move '    If (Value(oB)) Ne "" Begin' to asCode[2]   // declined - legacy comparison
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Get pasHoistDeclined of ghoFuncLib to asDeclined
            Send Assert (SizeOfArray(asDeclined) = 1)
            // Second pass over the SAME - now already converted - content, as the engine does.
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Get pasHoistDeclined   of ghoFuncLib to asDeclined
            Get piHoistSkipLegacy  of ghoFuncLib to iTwoLine
            Send Assert (SizeOfArray(asDeclined) = 1)
            Send Assert (iTwoLine = 1)
        End_Procedure

        /* A ';'-CONTINUED STATEMENT IS ONE STATEMENT (Nils 2026-08-17: 26 of the 30 calls left "by hand"
           on WinServ were this shape - FramtidaIntakter.rv - and a report of "line 1217 split over two
           lines" x26: "How on earth would that help anybody?"). The calls on the continuation lines are
           hoisted ABOVE THE FIRST LINE of the statement, one temp per call, with the first line's indent;
           the continuation lines keep their own indent and just use the temps. Nothing is "split". */
        {Published = True}
        Procedure CACG_ContinuedStatement_HoistedAboveFirstLine
            String[] asCode asNames
            Integer iCount iTwoLine

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib
            Get CACG_Names to asNames
            Move '        If (MACHINES.BASEDP <> "" and ;'                                                    to asCode[0]
            Move '            (Value(oFormDebFrom) = "" or MACHINES.BASEDP >= Value(oFormDebFrom)) and ;'   to asCode[1]
            Move '            (Value(oFormDebTo) = "" or MACHINES.BASEDP <= Value(oFormDebTo)))  Begin'      to asCode[2]
            Move '            Clear PERIODER'                                                                  to asCode[3]
            Move '        End'                                                                                 to asCode[4]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Get piHoistSkipTwoLine of ghoFuncLib to iTwoLine
            Send Assert (iCount = 4) ("converted " + String(iCount))
            Send Assert (iTwoLine = 0)
            Send Assert (SizeOfArray(asCode) = 13) ("lines " + String(SizeOfArray(asCode)))
            // Eight temp lines above the If (four calls: two on line 2, two on line 3; the later
            // continuation's temps go in above the earlier ones), then the statement, unchanged in shape.
            Send Assert (Left(Trim(asCode[0]), 15) = "Variant vDfrGet")   asCode[0]
            Send Assert (Left(Trim(asCode[1]), 9)  = "Get Value")         asCode[1]
            Send Assert (Left(asCode[0], 8) = "        ")                 "temp lines carry the FIRST line's indent"
            Send AssertSAreEqual '        If (MACHINES.BASEDP <> "" and ;' asCode[8]
            Send Assert (Pos("Value(", asCode[9])  = 0)                    asCode[9]
            Send Assert (Pos("Value(", asCode[10]) = 0)                    asCode[10]
            Send Assert (Pos("vDfrGet", asCode[9])  > 0)                   asCode[9]
            Send Assert (Right(Trim(asCode[10]), 5) = "Begin")             asCode[10]
            Send AssertSAreEqual '            Clear PERIODER' asCode[11]
        End_Procedure

        // NEGATIVE: a call inside a STRING LITERAL is not code and must never be rewritten.
        {Published = True}
        Procedure CACG_InsideStringLiteral_Untouched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move '    Move "Value(oAaa)" to sText' to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move "Value(oAaa)" to sText' asCode[0]
        End_Procedure

        // A CONTINUATION line: nothing may go between it and the line above - so the temp and the Get
        // go ABOVE THE STATEMENT'S FIRST LINE instead (2026-08-17; this test used to pin "left alone").
        // The one continuation still left alone is one whose statement start was never seen: a file
        // that BEGINS mid-statement.
        {Published = True}
        Procedure CACG_ContinuationLine_HoistedAboveTheStatement
            String[] asCode asNames
            Integer iCount iTwoLine

            Send ClearFuncLibProperties of ghoFuncLib
            Send _InitializeFuncLib of ghoFuncLib
            Get CACG_Names to asNames
            Move "    If (bFoo) ;"                to asCode[0]
            Move "        Move (Value(oA)) to i"  to asCode[1]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual "    Variant vDfrGet1"              asCode[0]
            Send AssertSAreEqual "    Get Value of (oA) to vDfrGet1" asCode[1]
            Send AssertSAreEqual "    If (bFoo) ;"                    asCode[2]
            Send AssertSAreEqual "        Move (vDfrGet1) to i"       asCode[3]
            Get piHoistSkipTwoLine of ghoFuncLib to iTwoLine
            Send Assert (iTwoLine = 0)
        End_Procedure

        // NEGATIVE: comment lines are left alone.
        {Published = True}
        Procedure CACG_CommentLine_Untouched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    // Move (Value(oA)) to i" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // NEGATIVE: word boundary - MyValue( must not match Value(.
        {Published = True}
        Procedure CACG_WordBoundary_NotMatched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (MyValue(oA)) to i" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual "    Move (MyValue(oA)) to i" asCode[0]
        End_Procedure

        // NEGATIVE: a name that is not in the ambiguous set is left alone.
        {Published = True}
        Procedure CACG_UnrelatedName_Untouched
            String[] asCode asNames
            Integer iCount
            Send ClearFuncLibProperties of ghoFuncLib
            Get CACG_Names to asNames
            Move "    Move (Other(oA)) to i" to asCode[0]
            Get _HoistAmbiguousCallsInLines of ghoFuncLib (&asCode) asNames to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // Helper: string literals are blanked, quotes included, and length is preserved so positions map.
        {Published = True}
        Procedure CACG_MaskStringLiterals
            String sIn sOut
            Send ClearFuncLibProperties of ghoFuncLib
            Move '    Move "ab(c" to s' to sIn
            Get _MaskStringLiterals of ghoFuncLib sIn to sOut
            Send Assert (Length(sOut) = Length(sIn))
            Send Assert (Pos("(", sOut) = 0)     // a paren INSIDE the literal must not survive
            Send Assert (Pos('"', sOut) = 0)     // the delimiting quotes are blanked too
            Send AssertSAreEqual "    Move " (Left(sOut, 9))   // code OUTSIDE the literal is untouched
        End_Procedure

        // Helper: split at TOP-LEVEL commas only - nested parens and literals do not split.
        {Published = True}
        Procedure CACG_SplitCallArgs_TopLevelOnly
            String[] asArgs
            Send ClearFuncLibProperties of ghoFuncLib
            Get _SplitCallArgs of ghoFuncLib 'oA, Foo(x,y), "a,b"' to asArgs
            Send Assert (SizeOfArray(asArgs) = 3)
            Send AssertSAreEqual "oA"        (Trim(asArgs[0]))
            Send AssertSAreEqual "Foo(x,y)"  (Trim(asArgs[1]))
            Send AssertSAreEqual '"a,b"'     (Trim(asArgs[2]))
        End_Procedure

    End_Object
