// GotoDefinitionPickerFT.dg
//
// The FlexTron twin of GotoDefinitionPicker.dg, the editor's Go to definition chooser: the same grid
// of definitions and ChooseDefinition, on an FT panel, with Go to and Cancel as framework buttons
// (cFTWebButton, RDCFlexTron) on a grid host of 8 px columns.
//
// HOW DFRefactorFT GETS THIS ONE, as the Find, Replace, Go To Line and Drop Self twins:
// cRefactorScintillaEditor.pkg Uses the chooser itself, and every program that edits code gets it
// through that package. DFRefactorFT.src Uses this file BEFORE it, this file defines
// C_OwnGotoDefinitionPicker, and the package then leaves GotoDefinitionPicker.dg out. Both files
// define oGotoDefinitionPicker - the package reaches the chooser by that name - so the two must never
// both be in: used after the package, this file stops the build (below).
//
// LAID OUT as the original: the grid fills the panel, which can be resized, and the buttons sit at
// its bottom right. A resizable FT panel has a status bar under them.
Use Windows.pkg
Use cCJGrid.pkg
Use cCJGridColumn.pkg
Use cSymbolIndex.pkg           // tSymbolDef
Use cFTModalPanel.pkg
Use cFTGridHost.pkg             // the buttons' host - a grid of 8 px columns (RDCFlexTron)
Use FTAllWebControlClasses.pkg  // cFTWebButton - Go to and Cancel

// cRefactorEditorCommands.pkg declares tDropSelfResponse, and cRefactorScintillaEditor.pkg Uses it before
// the chooser. If it exists already, the editor packages are in the program and have brought
// GotoDefinitionPicker.dg with them - there would be two oGotoDefinitionPicker.
#IFDEF _STRUCT_tDropSelfResponse
#ERROR DFERR_PROGRAM "Use GotoDefinitionPickerFT.dg before the editor packages - GotoDefinitionPicker.dg is in the program already."
#ENDIF

// Tells cRefactorScintillaEditor.pkg to leave GotoDefinitionPicker.dg out.
Define C_OwnGotoDefinitionPicker for 1

Object oGotoDefinitionPicker is a cFTModalPanel
    Set Size to 190 470
    Set Label to "Go to definition"
    Set piMinSize to 110 300
    Set Location to 44 47
    Set peAnchors to anAll
    Set Border_Style to Border_Thick
    Set Icon to "LocateInEditor.ico"

    Property tSymbolDef[] paDefs
    Property Integer      piChosen -1
    // The selected row's index, read in Go to's OnClick - inside the web click; DoGoTo, run after the
    // click, reads it. A grid read from after the click faults err 98 (ShowOtherLogFilesFT).
    Property String       psCapIndex ""

    Object oDefs_grd is a cCJGrid
        Set Size to 152 452
        Set Location to 8 8
        Set peAnchors to anAll
        Set pbAllowEdit to False
        Set pbFocusSubItems to False
        Set pbAutoAppend to False
        Set pbAutoSave to False

        Object oKind_col is a cCJGridColumn
            Set piWidth to 95
            Set psCaption to "Kind"
        End_Object

        Object oName_col is a cCJGridColumn
            Set piWidth to 170
            Set psCaption to "Name"
        End_Object

        Object oLine_col is a cCJGridColumn
            Set piWidth to 55
            Set psCaption to "Line"
        End_Object

        Object oFile_col is a cCJGridColumn
            Set piWidth to 440
            Set psCaption to "File"
        End_Object

        // The row's index into paDefs - what ChooseDefinition answers - kept out of sight.
        Object oIndex_col is a cCJGridColumn
            Set piWidth to 10
            Set pbVisible to False
            Set psCaption to "Index"
        End_Object

        Procedure LoadData
            tDataSourceRow[] TheData TheDataEmpty
            tSymbolDef[] aDefs
            Integer i iMax iKind iName iLine iFile iIndex

            If (not(IsComObjectCreated(Self))) ;
                Procedure_Return
            Get paDefs to aDefs
            Get piColumnId of oKind_col  to iKind
            Get piColumnId of oName_col  to iName
            Get piColumnId of oLine_col  to iLine
            Get piColumnId of oFile_col  to iFile
            Get piColumnId of oIndex_col to iIndex
            Move (SizeOfArray(aDefs) - 1) to iMax
            For i from 0 to iMax
                Move aDefs[i].sKind          to TheData[i].sValue[iKind]
                Move aDefs[i].sName          to TheData[i].sValue[iName]
                Move (String(aDefs[i].iLine)) to TheData[i].sValue[iLine]
                Move aDefs[i].sFile          to TheData[i].sValue[iFile]
                Move (String(i))             to TheData[i].sValue[iIndex]
            Loop
            If (iMax >= 0) Begin
                Send ReInitializeData TheData False
                Send MoveToFirstRow
            End
            Else ;
                Send InitializeData TheDataEmpty
        End_Procedure

        // Rows are loaded from both ends of the creation order - whichever comes second finds
        // the grid created and does the work; LoadData is a no-op until then.
        Procedure OnCreate
            Forward Send OnCreate
            Send LoadData
        End_Procedure

        Procedure ChooseSelected
            String sIndex
            Get SelectedRowValue of oIndex_col to sIndex
            If (sIndex <> "") Begin
                Set piChosen to (Cast(sIndex, Integer))
                Send Close_Panel
            End
        End_Procedure

        Procedure OnRowDoubleClick Integer iRow Integer iCol
            Forward Send OnRowDoubleClick iRow iCol
            Send ChooseSelected
        End_Procedure

        On_Key kEnter Send ChooseSelected
    End_Object

    /* GO TO / CANCEL at the bottom right - framework buttons on a grid host of 8 px columns, right-aligned
       with the grid and anchored to the panel's bottom right, as the buttons were. Go to keeps the default
       it had: Enter on the grid goes there (bound in the grid, above), and Go to wears the main action's
       amber. Each runs in OnButtonClick, after the web click has returned (the library's click relay); Go
       to reads the grid's selected row in its OnClick first, inside the click. */
    Object oPickerButtons is a cFTGridHost
        Set Location to 164 337
        Set Size to 20 128
        Set peAnchors to anBottomRight
        Set piColumnCount to 24         // column 0, then Go to's 11 and Cancel's 12
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oGoToBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Go to"
            Set psCSSClass to "ftbtn ftbtn-primary ftg-check"
            Set psToolTip to "Go to the selected definition. Enter or a double-click does the same."

            // The selected row, read here inside the click (see above); OnButtonClick goes there after.
            Procedure OnClick
                String sIndex
                Get SelectedRowValue of oIndex_col to sIndex
                Set psCapIndex of oGotoDefinitionPicker to sIndex
                Forward Send OnClick
            End_Procedure

            Procedure OnButtonClick
                Send DoGoTo of oGotoDefinitionPicker
            End_Procedure
        End_Object

        Object oCancelBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 12
            Set psCaption to "Cancel"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close without going anywhere."

            Procedure OnButtonClick
                Send DoCancel of oGotoDefinitionPicker
            End_Procedure
        End_Object
    End_Object

    // Go to - the button: the row its OnClick read (psCapIndex), never a new read of the grid.
    Procedure DoGoTo
        String sIndex
        Get psCapIndex to sIndex
        If (sIndex <> "") Begin
            Set piChosen to (Cast(sIndex, Integer))
            Send Close_Panel
        End
    End_Procedure

    // Cancel - the button, Esc or the window's X: close; ChooseDefinition then answers -1.
    Procedure DoCancel
        Send Close_Panel
    End_Procedure

    On_Key kCancel Send DoCancel

    Procedure Activating
        Forward Send Activating
        Send LoadData of oDefs_grd
    End_Procedure

    // Pops the chooser over aDefs (already ranked) and returns the index picked, -1 when cancelled.
    Function ChooseDefinition tSymbolDef[] aDefs Returns Integer
        Set paDefs to aDefs
        Set piChosen to -1
        Set Label to ("Go to definition -" * String(SizeOfArray(aDefs)) * "definitions, nearest first")
        Send Popup
        Function_Return (piChosen(Self))
    End_Function

End_Object
