            Move ('    Set Form_Mask Item 0 to "##,###.##"') to asInput[4]
            Move "End_Object"                                to asInput[5]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Set psMask to") Begin
                    If (asOutput[iIdx] contains "##,###.##") Begin
                        Move True to bFound
                    End
                End
            Loop
            Send Assert bFound
        End_Procedure

        /* Numeric_Mask takes the digits left and right of the decimal separator - "Set Numeric_Mask 0 to 4 4" is
           the DataFlex help's own sample - and the column's CreateNumericMask takes the same pair (2026-10-04).
           Until then this test fed it a mask string, which is not what the message takes, and pinned the
           "Set psMask to <value>" that made "Set psMask to 12 2" of real code. */
        {Published = True}
        { Description = "Numeric_Mask without Item keyword -> the column's CreateNumericMask" }
