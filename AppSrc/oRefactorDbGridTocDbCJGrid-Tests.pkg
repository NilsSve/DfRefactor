        // Highlight_Row_State -> the focus rectangle AND row selection (2026-10-04): a cCJGrid shows the row
        // colour (piHighlightBackColor) only on a selected row. One assertion over the whole result.
        {Published = True}
        { Description = "Highlight_Row_State False -> pbShowRowFocus False + pbSelectionEnable False" }
        Procedure HighlightRowState_False
            String[] asResult
            String   sLine sLower sGot
            Integer  i
            Move "    Set Highlight_Row_State to False" to sLine
            Move (Lowercase(Trim(sLine))) to sLower
            Get TranslateGridProperty of oWorker sLine sLower to asResult
            Move "" to sGot
            For i from 0 to (SizeOfArray(asResult) - 1)
                Move (sGot + asResult[i] + "|") to sGot
            Loop
            Send AssertSAreEqual "    Set pbShowRowFocus to False|    Set pbSelectionEnable to False|" sGot
        End_Procedure

        {Published = True}
        { Description = "Highlight_Row_State True -> pbShowRowFocus True + pbSelectionEnable True" }
