            Move "    Set Highlight_Row_State to True" to sLine
            Move (Lowercase(Trim(sLine))) to sLower
            Get TranslateGridProperty of oWorker sLine sLower to asResult
            Move "" to sGot
            For i from 0 to (SizeOfArray(asResult) - 1)
                Move (sGot + asResult[i] + "|") to sGot
            Loop
            Send AssertSAreEqual "    Set pbShowRowFocus to True|    Set pbSelectionEnable to True|" sGot
        End_Procedure
    
