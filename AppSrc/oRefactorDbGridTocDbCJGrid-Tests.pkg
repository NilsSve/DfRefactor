    Object oMainFileLine is a cTestFixture
        Set psFunctionName to "HandleMainFileLine (cDbGridTocDbCJGrid)"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // Helper: runs TransformSource on a single-grid input, returns output array.
        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        {Published = True}
        { Description = "Set Main_File is commented out in the output" }
        Procedure MainFile_IsCommentedOut
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid1 is a DbGrid"                  to asInput[0]
            Move "    Set Main_File to Worktrans.File_Number"  to asInput[1]
            Move "End_Object"                                 to asInput[2]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Left(asOutput[iIdx], 2) = "//" and Lowercase(asOutput[iIdx]) contains "set main_file") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Commented Set Server suggestion is added after the commented Set Main_File" }
        Procedure SetServer_SuggestionAdded
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid1 is a DbGrid"                  to asInput[0]
            Move "    Set Main_File to Worktrans.File_Number"  to asInput[1]
            Move "End_Object"                                 to asInput[2]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "// Set Server to oWorktrans_dd") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Commented Set Server appears immediately after the commented Set Main_File" }
        Procedure SetServer_AppearsBelowCommentedMainFile
            String[] asInput asOutput
            Integer  iIdx iCommentIdx iServerIdx

            Move "Object oGrid1 is a DbGrid"                  to asInput[0]
            Move "    Set Main_File to Worktrans.File_Number"  to asInput[1]
            Move "End_Object"                                 to asInput[2]

            Get RunTransform_as asInput to asOutput

            Move -1 to iCommentIdx
            Move -1 to iServerIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Left(asOutput[iIdx], 2) = "//" and Lowercase(asOutput[iIdx]) contains "set main_file") Begin
                    Move iIdx to iCommentIdx
                End
                If (asOutput[iIdx] contains "// Set Server to oWorktrans_dd") Begin
                    Move iIdx to iServerIdx
                End
            Loop
            // Commented original must appear immediately before the commented Set Server line.
            Send Assert (iCommentIdx >= 0 and iServerIdx = iCommentIdx + 1)
        End_Procedure

        {Published = True}
        { Description = "DDO name is derived from table name before the dot" }
        Procedure DdoName_DerivedFromTableName
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid1 is a DbGrid"                  to asInput[0]
            Move "    Set Main_File to Customer.File_Number"  to asInput[1]
            Move "End_Object"                                 to asInput[2]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "// Set Server to oCustomer_dd") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oCalculatedEntryItem
    //   Tests for Expression Entry_Item -> OnSetCalculatedValue conversion.
    // -----------------------------------------------------------------------
    // TearDown leaves the worker on the EMPTY parameter, which converts the plain dbGrid only since
    // 2026-10-03 - so the samples here are dbGrid objects (a cDbGrid would now be a subclass, left as is).
    Object oCalculatedEntryItem is a cTestFixture
        Set psFunctionName to "CalculatedEntryItem (cDbGridTocDbCJGrid)"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        // -----------------------------------------------------------------------
        // IsEntryItemExpression
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "Expression starting with ( is detected as an expression" }
        Procedure IsExpression_LeadingParen
            Boolean bResult
            Get IsEntryItemExpression of oWorker "(StatLog.FunctionName * string(StatLog.Date))" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "Value with an internal space is detected as an expression" }
        Procedure IsExpression_ContainsSpace
            Boolean bResult
            Get IsEntryItemExpression of oWorker "Table.FieldA + Table.FieldB" to bResult
            Send Assert bResult
        End_Procedure

        {Published = True}
        { Description = "Plain Table.Field is NOT an expression" }
        Procedure IsExpression_PlainFieldRef_False
            Boolean bResult
            Get IsEntryItemExpression of oWorker "StatLog.FunctionName" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "Bare field name without a dot is NOT an expression" }
        Procedure IsExpression_BareFieldName_False
            Boolean bResult
            Get IsEntryItemExpression of oWorker "FunctionName" to bResult
            Send AssertFalse bResult
        End_Procedure

        // -----------------------------------------------------------------------
        // End-to-end TransformSource: expression column
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "Expression Entry_Item produces no Entry_Item line in the column object" }
        Procedure ExpressionColumn_NoEntryItemLine
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "    End_Row"                                                        to asInput[3]
            Move "End_Object"                                                         to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Trim(Lowercase(asOutput[iIdx])) contains "entry_item") Begin
                    Move True to bFound
                End
            Loop
            Send AssertFalse bFound
        End_Procedure

        {Published = True}
        { Description = "Expression Entry_Item produces an OnSetCalculatedValue procedure" }
        Procedure ExpressionColumn_OnSetCalculatedValueEmitted
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "    End_Row"                                                        to asInput[3]
            Move "End_Object"                                                         to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Procedure OnSetCalculatedValue") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "OnSetCalculatedValue body contains the original expression" }
        Procedure ExpressionColumn_MoveExpressionToSValue
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "    End_Row"                                                        to asInput[3]
            Move "End_Object"                                                         to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Move (StatLog.FunctionName * string(StatLog.Date)) to sValue") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Expression column object is named oCalcCol1 (1-based positional name)" }
        Procedure ExpressionColumn_PositionalName
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "    End_Row"                                                        to asInput[3]
            Move "End_Object"                                                         to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Object oCalcCol1 is a") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        // DF26 fix (from a real dbGrid report 2026-07-14): a calculated Entry_Item that is a single IN-FILE
        // method call in the legacy expression form '(Func(Self, args))' must be emitted as the Get command
        // in OnSetCalculatedValue - DF26 rejects the '(Func(Self, ...))' expression form. Dotted file.field
        // arguments (MyTable.Ref) are simple Get args and must survive the comma->space flatten.
        {Published = True}
        { Description = "Calculated column that is an in-file method call (Func(Self,args)) -> Get form, not Move-expression" }
        Procedure ExpressionColumn_LocalMethodCall_GetForm
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFoundGet bFoundMove

            Move "Function RowLabel Integer iRef Integer iKind Returns String"    to asInput[0]
            Move "    Function_Return (Character(iRef))"                          to asInput[1]
            Move "End_Function"                                                   to asInput[2]
            Move "Object oGrid is a dbGrid"                                      to asInput[3]
            Move "    Begin_Row"                                                  to asInput[4]
            Move "        Entry_Item (RowLabel(Self, MyTable.Ref, MyTable.Kind))" to asInput[5]
            Move "    End_Row"                                                    to asInput[6]
            Move "End_Object"                                                     to asInput[7]

            Get RunTransform_as asInput to asOutput

            Move False to bFoundGet
            Move False to bFoundMove
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Get RowLabel MyTable.Ref MyTable.Kind to sValue") ;
                    Move True to bFoundGet
                If (asOutput[iIdx] contains "Move (RowLabel(Self, MyTable.Ref, MyTable.Kind)) to sValue") ;
                    Move True to bFoundMove
            Loop
            Send Assert bFoundGet
            Send AssertFalse bFoundMove
        End_Procedure

        // The count the Get would bury (LegacyApp PlanView.VW, 2026-09-04): a one-parameter method called
        // with two arguments. The Get form is still emitted (it is what DF26 wants for the body), but a
        // TODO naming both counts sits on the line right above it.
        {Published = True}
        { Description = "Calculated column whose in-file method declares fewer parameters than the call passes gets an arity TODO above the Get" }
        Procedure ExpressionColumn_LocalMethodCall_ArityMismatch_GetsTodo
            String[] asInput asOutput
            Integer  iIdx iTodo iGet

            Move "Function RowLabel Integer iRef Returns String"                  to asInput[0]
            Move "    Function_Return (Character(iRef))"                          to asInput[1]
            Move "End_Function"                                                   to asInput[2]
            Move "Object oGrid is a dbGrid"                                      to asInput[3]
            Move "    Begin_Row"                                                  to asInput[4]
            Move "        Entry_Item (RowLabel(Self, MyTable.Ref, MyTable.Kind))" to asInput[5]
            Move "    End_Row"                                                    to asInput[6]
            Move "End_Object"                                                     to asInput[7]

            Get RunTransform_as asInput to asOutput

            Move -1 to iTodo
            Move -1 to iGet
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "// TODO: RowLabel declares 1 parameter (line 1) and this call passes 2.") ;
                    Move iIdx to iTodo
                If (asOutput[iIdx] contains "Get RowLabel MyTable.Ref MyTable.Kind to sValue") ;
                    Move iIdx to iGet
            Loop
            Send Assert (iTodo >= 0)
            Send Assert (iGet = (iTodo + 1))
        End_Procedure

        // POSITIVE CONTROL for the above: the matched count (two declared, two passed) gets NO TODO.
        {Published = True}
        { Description = "Calculated column whose in-file method call matches the declared count gets no arity TODO" }
        Procedure ExpressionColumn_LocalMethodCall_MatchedCount_NoTodo
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFoundTodo bFoundGet

            Move "Function RowLabel Integer iRef Integer iKind Returns String"    to asInput[0]
            Move "    Function_Return (Character(iRef))"                          to asInput[1]
            Move "End_Function"                                                   to asInput[2]
            Move "Object oGrid is a dbGrid"                                      to asInput[3]
            Move "    Begin_Row"                                                  to asInput[4]
            Move "        Entry_Item (RowLabel(Self, MyTable.Ref, MyTable.Kind))" to asInput[5]
            Move "    End_Row"                                                    to asInput[6]
            Move "End_Object"                                                     to asInput[7]

            Get RunTransform_as asInput to asOutput

            Move False to bFoundTodo
            Move False to bFoundGet
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "// TODO: RowLabel declares") ;
                    Move True to bFoundTodo
                If (asOutput[iIdx] contains "Get RowLabel MyTable.Ref MyTable.Kind to sValue") ;
                    Move True to bFoundGet
            Loop
            Send Assert bFoundGet
            Send AssertFalse bFoundTodo
        End_Procedure

        // Safety: a GLOBAL function that merely TAKES Self as a real argument is NOT an object method (Get
        // could not resolve it), so it must stay the Move-expression form.
        {Published = True}
        { Description = "Calculated column calling a GLOBAL function (Self is a real arg) stays the Move form" }
        Procedure ExpressionColumn_GlobalFuncCall_StaysMove
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFoundGet bFoundMove

            Move "Function GlobalCalc Global Integer hoObj Integer iX Returns Integer" to asInput[0]
            Move "End_Function"                                                        to asInput[1]
            Move "Object oGrid is a dbGrid"                                           to asInput[2]
            Move "    Begin_Row"                                                       to asInput[3]
            Move "        Entry_Item (GlobalCalc(Self, MyTable.Amount))"               to asInput[4]
            Move "    End_Row"                                                         to asInput[5]
            Move "End_Object"                                                          to asInput[6]

            Get RunTransform_as asInput to asOutput

            Move False to bFoundGet
            Move False to bFoundMove
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Move (GlobalCalc(Self, MyTable.Amount)) to sValue") ;
                    Move True to bFoundMove
                If (asOutput[iIdx] contains "Get GlobalCalc") ;
                    Move True to bFoundGet
            Loop
            Send Assert bFoundMove
            Send AssertFalse bFoundGet
        End_Procedure

        // Regression: a plain field carrying legacy entry-item options 'Entry_Item Table.Field {Autoclear,
        // Noput}' must NOT be misread as a calculated column (the spaces inside {...} used to trip the
        // expression test), and the {...} must NOT leak into a 'Move field {...} to sValue' (illegal - the
        // LegacyApp POP_PROJ / ITM0010B compile errors). The options are stripped -> the field binds normally, and
        // the dropped options are preserved in a TODO comment.
        {Published = True}
        { Description = "Entry_Item {options} are stripped: field binds (not calculated), no leak, TODO preserved" }
        Procedure EntryItemOptions_StrippedFieldBindsNoLeak
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bCalc bTodo bField

            Move "Object oGrid is a dbGrid"                             to asInput[0]
            Move "    Begin_Row"                                         to asInput[1]
            Move "        Entry_Item ITEM0010.PROJECT {Autoclear, Noput}" to asInput[2]
            Move "    End_Row"                                           to asInput[3]
            Move "End_Object"                                            to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bCalc
            Move False to bTodo
            Move False to bField
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Procedure OnSetCalculatedValue")  Move True to bCalc
                If (asOutput[iIdx] contains "TODO: legacy entry-item options") Move True to bTodo
                If (asOutput[iIdx] contains "ITEM0010.PROJECT")                Move True to bField
            Loop
            Send AssertFalse bCalc     // a plain field + options is a BOUND column, not a calculated one
            Send Assert bTodo          // the dropped options survive in a TODO comment
            Send Assert bField         // the field itself is still present/bound
        End_Procedure

        {Published = True}
        { Description = "Header_Label on an expression column is used as the caption" }
        Procedure ExpressionColumn_HeaderLabelUsedAsCaption
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "    End_Row"                                                        to asInput[3]
            Move '    Set Header_Label Item 0 to "Function / Date"'                  to asInput[4]
            Move "End_Object"                                                         to asInput[5]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains 'Set psCaption to "Function / Date"') Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Plain column alongside expression column: plain column retains Entry_Item" }
        Procedure MixedColumns_PlainColumnRetainsEntryItem
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "        Entry_Item StatLog.Description"                            to asInput[3]
            Move "    End_Row"                                                        to asInput[4]
            Move "End_Object"                                                         to asInput[5]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Entry_Item StatLog.Description") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "Plain column alongside expression column: expression column has no Entry_Item" }
        Procedure MixedColumns_ExpressionColumnHasNoEntryItem
            String[] asInput asOutput
            Integer  iIdx
            Integer  iEntryItemCount

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[2]
            Move "        Entry_Item StatLog.Description"                            to asInput[3]
            Move "    End_Row"                                                        to asInput[4]
            Move "End_Object"                                                         to asInput[5]

            Get RunTransform_as asInput to asOutput

            // Exactly one Entry_Item must appear: the plain column only.
            Move 0 to iEntryItemCount
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Trim(Lowercase(asOutput[iIdx])) contains "entry_item") Begin
                    Increment iEntryItemCount
                End
            Loop
            Send AssertIAreEqual 1 iEntryItemCount
        End_Procedure

        {Published = True}
        { Description = "Second column (expression) gets oCalcCol2 when it is in position 2" }
        Procedure MixedColumns_ExpressionInSecondPosition_IsCalcCol2
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFound

            Move "Object oGrid is a dbGrid"                                         to asInput[0]
            Move "    Begin_Row"                                                      to asInput[1]
            Move "        Entry_Item StatLog.Description"                            to asInput[2]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))"  to asInput[3]
            Move "    End_Row"                                                        to asInput[4]
            Move "End_Object"                                                         to asInput[5]

            Get RunTransform_as asInput to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Object oCalcCol2 is a") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        // -----------------------------------------------------------------------
        // Entry_Item trailing-comment handling (regression)
        //   A plain "Table.Field // comment" must NOT be misread as a calculated
        //   expression, and the comment text must not leak into generated code.
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "StripTrailingComment removes a // comment from a plain field spec" }
        Procedure Strip_PlainFieldWithComment
            String sResult
            Get StripTrailingComment of oWorker "StatLog.Description // Some comment" to sResult
            Send AssertSAreEqual "StatLog.Description" sResult
        End_Procedure

        {Published = True}
        { Description = "StripTrailingComment leaves a spec with no comment unchanged" }
        Procedure Strip_NoComment_Unchanged
            String sResult
            Get StripTrailingComment of oWorker "StatLog.Description" to sResult
            Send AssertSAreEqual "StatLog.Description" sResult
        End_Procedure

        {Published = True}
        { Description = "StripTrailingComment removes a // comment after an expression" }
        Procedure Strip_ExpressionWithComment
            String sResult
            Get StripTrailingComment of oWorker "(StatLog.A * StatLog.B) // calc" to sResult
            Send AssertSAreEqual "(StatLog.A * StatLog.B)" sResult
        End_Procedure

        {Published = True}
        { Description = "Plain field WITH trailing comment is NOT classified as an expression once stripped" }
        Procedure CommentField_NotExpression_AfterStrip
            String  sStripped
            Boolean bResult
            Get StripTrailingComment of oWorker "StatLog.Description // Some comment" to sStripped
            Get IsEntryItemExpression of oWorker sStripped to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "Entry_Item with a trailing comment becomes a plain column (no OnSetCalculatedValue, no oCalcCol) with the comment preserved on the Entry_Item line" }
        Procedure CommentField_BecomesPlainColumn
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bCalcObj bOnSet bPlainEntryWithComment

            Move "Object oGrid is a dbGrid"                       to asInput[0]
            Move "    Begin_Row"                                    to asInput[1]
            Move "        Entry_Item StatLog.Description // Some comment" to asInput[2]
            Move "    End_Row"                                      to asInput[3]
            Move "End_Object"                                       to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bCalcObj
            Move False to bOnSet
            Move False to bPlainEntryWithComment
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Object oCalcCol")                Move True to bCalcObj
                If (asOutput[iIdx] contains "Procedure OnSetCalculatedValue") Move True to bOnSet
                If (Trim(asOutput[iIdx]) = "Entry_Item StatLog.Description // Some comment") Move True to bPlainEntryWithComment
            Loop
            Send AssertFalse bCalcObj
            Send AssertFalse bOnSet
            Send Assert bPlainEntryWithComment
        End_Procedure

        {Published = True}
        { Description = "Trailing comment is preserved ONLY on the Entry_Item line, not in the column name or caption" }
        Procedure CommentField_CommentOnEntryItemLineOnly
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bEntryHasComment bObjLineClean bCaptionClean

            Move "Object oGrid is a dbGrid"                       to asInput[0]
            Move "    Begin_Row"                                    to asInput[1]
            Move "        Entry_Item StatLog.Description // Some comment" to asInput[2]
            Move "    End_Row"                                      to asInput[3]
            Move "End_Object"                                       to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bEntryHasComment
            Move True  to bObjLineClean    // stays True unless the object decl carries the comment
            Move True  to bCaptionClean    // stays True unless the caption carries the comment
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Entry_Item StatLog.Description" and ;
                    asOutput[iIdx] contains "// Some comment")                Move True  to bEntryHasComment
                If (asOutput[iIdx] contains "is a cDbCJGridColumn" and ;
                    asOutput[iIdx] contains "Some comment")                   Move False to bObjLineClean
                If (asOutput[iIdx] contains "Set psCaption" and ;
                    asOutput[iIdx] contains "Some comment")                   Move False to bCaptionClean
            Loop
            // Comment rides along on the Entry_Item line ...
            Send Assert bEntryHasComment
            // ... and the column object name / caption stay clean.
            Send Assert bObjLineClean
            Send Assert bCaptionClean
        End_Procedure

        {Published = True}
        { Description = "Mixed: commented plain field + expression -> plain column (comment preserved) then oCalcCol (user bug repro)" }
        Procedure MixedCommentAndExpression_CorrectSplit
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bPlainEntry bCalcObj bMoveExpr

            Move "Object oGrid is a dbGrid"                                        to asInput[0]
            Move "    Begin_Row"                                                     to asInput[1]
            Move "        Entry_Item StatLog.Description // Some comment"            to asInput[2]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date))" to asInput[3]
            Move "    End_Row"                                                       to asInput[4]
            Move "End_Object"                                                        to asInput[5]

            Get RunTransform_as asInput to asOutput

            Move False to bPlainEntry
            Move False to bCalcObj
            Move False to bMoveExpr
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Trim(asOutput[iIdx]) = "Entry_Item StatLog.Description // Some comment") Move True to bPlainEntry
                If (asOutput[iIdx] contains "Object oCalcCol2 is a")                    Move True to bCalcObj
                If (asOutput[iIdx] contains "Move (StatLog.FunctionName * string(StatLog.Date)) to sValue") Move True to bMoveExpr
            Loop
            // First column: plain field, comment preserved, NOT a calc column.
            Send Assert bPlainEntry
            // Second column: the genuine expression becomes oCalcCol2 with the Move.
            Send Assert bCalcObj
            Send Assert bMoveExpr
        End_Procedure

        {Published = True}
        { Description = "Expression WITH a trailing comment is still a calc column; comment preserved on the Move line" }
        Procedure ExpressionWithComment_StillCalcCol
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bMoveWithComment bCalcObj

            Move "Object oGrid is a dbGrid"                                              to asInput[0]
            Move "    Begin_Row"                                                           to asInput[1]
            Move "        Entry_Item (StatLog.FunctionName * string(StatLog.Date)) // calc" to asInput[2]
            Move "    End_Row"                                                             to asInput[3]
            Move "End_Object"                                                              to asInput[4]

            Get RunTransform_as asInput to asOutput

            Move False to bMoveWithComment
            Move False to bCalcObj
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Object oCalcCol1 is a") Move True to bCalcObj
                If (asOutput[iIdx] contains "Move (StatLog.FunctionName * string(StatLog.Date)) to sValue // calc") Move True to bMoveWithComment
            Loop
            Send Assert bCalcObj
            Send Assert bMoveWithComment
        End_Procedure

    End_Object

    // ParseHeaderLabel now returns the EMITTABLE psCaption value: a quoted string literal keeps its quotes;
    // a NON-quoted value (an expression, variable or constant) comes back verbatim - callers emit it AS-IS.
    // Regression (Nils 2026-07-07): Set Header_Label Item N to (fFindLabelText("X")) had been re-quoted into
    // the broken Set psCaption to "(fFindLabelText("X"))".
    Object oParseHeaderLabel is a cTestFixture
        Set psFunctionName to "ParseHeaderLabel"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        {Published = True}
        Procedure StringLiteral_KeepsQuotes
            String sResult
            Get ParseHeaderLabel of oWorker 'Set Header_Label Item 1 to "Namn"' to sResult
            Send AssertSAreEqual '"Namn"' sResult
        End_Procedure

        {Published = True}
        Procedure StringLiteral_DropsTrailingComment
            String sResult
            Get ParseHeaderLabel of oWorker 'Set Header_Label Item 0 to "Name" // was "Full Name"' to sResult
            Send AssertSAreEqual '"Name"' sResult
        End_Procedure

        {Published = True}
        Procedure Expression_ReturnedVerbatim
            String sResult
            Get ParseHeaderLabel of oWorker 'Set Header_Label Item 1 to (fFindLabelText("Namn"))' to sResult
            Send AssertSAreEqual '(fFindLabelText("Namn"))' sResult
        End_Procedure

        // Either declaration article - 'is a' AND 'is an' (legal DataFlex; the WinServ 'is an
        // edit' lesson, 2026-07-17): the exact-match branch (class-names parameter, stored
        // lowercase) and the dbgrid-suffix pattern branch must both match either form; a line
        // with NO article stays unmatched.
        {Published = True}
        Procedure IsGridDeclaration_EitherArticle
            Handle ho
            Boolean bA bAn bPattern bNone

            Get Create of ghoFuncLib (RefClass(cDbGridTocDbCJGrid)) to ho
            Set psLegacyGridClass of ho to "extgrid"
            Get IsGridDeclaration of ho "object ogrid is a extgrid"   to bA
            Get IsGridDeclaration of ho "object ogrid is an extgrid"  to bAn
            Set psLegacyGridClass of ho to ""
            Get IsGridDeclaration of ho "object ogrid is an mydbgrid" to bPattern
            Get IsGridDeclaration of ho "object ogrid is mydbgrid"    to bNone
            Send Destroy of ho
            Send Assert bA
            Send Assert bAn
            Send Assert bPattern
            Send AssertFalse bNone
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oUsePackageFixup - what becomes of dbGrid's dedicated Dftable.pkg once the
    // grids in the file have converted. The dbList side has covered this since the
    // swap was written; the dbGrid side had no coverage at all until the obsolete-
    // package warning turned up on an already-converted file (Nils 2026-08-10).
    // -----------------------------------------------------------------------
    Object oUsePackageFixup is a cTestFixture
        Set psFunctionName to "UsePackageFixup (cDbGridTocDbCJGrid)"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        Function ArrayHasLine String[] asArr String sLine Returns Boolean
            Integer i iMax
            Move (SizeOfArray(asArr) - 1) to iMax
            For i from 0 to iMax
                If (asArr[i] = sLine) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // The swap that already worked - pinned here so the guard below cannot silently break it.
        {Published = True}
        { Description = "Use Dftable.pkg is swapped in place for cDbCJGrid.pkg" }
        Procedure LegacyUse_SwappedInPlace
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use Dftable.pkg"              to asInput[0]
            Move "Object oGrid is a dbGrid"     to asInput[1]
            Move "End_Object"                   to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Use cDbCJGrid.pkg" asOutput[0]
            Get ArrayHasLine asOutput "Use Dftable.pkg" to bLegacyLive
            Send AssertFalse bLegacyLive
        End_Procedure

        // THE REPORTED BUG: target already Used, so the legacy Use used to survive and keep the
        // compiler complaining about an obsolete package in a fully converted file.
        {Published = True}
        { Description = "Target already present -> the dead Use Dftable.pkg is commented out" }
        Procedure TargetPresent_DeadLegacyUseCommentedOut
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use cDbCJGrid.pkg"            to asInput[0]
            Move "Use Dftable.pkg"              to asInput[1]
            Move "Object oGrid is a dbGrid"     to asInput[2]
            Move "End_Object"                   to asInput[3]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "//Use Dftable.pkg" asOutput[1]
            Get ArrayHasLine asOutput "Use Dftable.pkg" to bLegacyLive
            Send AssertFalse bLegacyLive
        End_Procedure

        // The guard: a subclass of an INTERMEDIATE class from the same package still needs it.
        {Published = True}
        { Description = "A class derived from dbGridDD keeps Use Dftable.pkg alive" }
        Procedure LegacyUse_KeptWhenIntermediateStillDerived
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use Dftable.pkg"              to asInput[0]
            Move "Class MyBase is a dbGridDD"   to asInput[1]
            Move "End_Class"                    to asInput[2]
            Move "Object oGrid is a dbGrid"     to asInput[3]
            Move "End_Object"                   to asInput[4]
            Get RunTransform_as asInput to asOutput
            Get ArrayHasLine asOutput "Use Dftable.pkg" to bLegacyLive
            Send Assert bLegacyLive
        End_Procedure

        /* The ';'-continuation join lives on cGridToCJGridBase and asks the SUBCLASS's
           IsGridDeclaration, so fixing it for plain Grid fixed it here too. Pinned on this side as
           well - the two converters have drifted apart before, and a base-class fix that silently
           stops reaching one of them is exactly the kind of thing no test would catch. */
        {Published = True}
        { Description = "A ';'-continued dbGrid declaration is joined and converted" }
        Procedure ContinuedDeclaration_ConvertedHereToo
            String[] asInput asOutput
            Move "Use Dftable.pkg"          to asInput[0]
            Move "Object oCustomers ;"      to asInput[1]
            Move "    is a dbGrid"          to asInput[2]
            Move "End_Object"               to asInput[3]
            Get RunTransform_as asInput to asOutput
            Send Assert (Lowercase(asOutput[1]) contains "object ocustomers is a cdbcjgrid")
            Send AssertSAreEqual "Use cDbCJGrid.pkg" asOutput[0]
        End_Procedure

        // A commented-out declaration is not a reason to keep the package.
        {Published = True}
        { Description = "A commented-out dbGrid declaration does not hold the legacy Use open" }
        Procedure CommentedDeclaration_DoesNotHoldUseOpen
            String[] asInput asOutput
            Boolean  bLegacyLive
            Move "Use cDbCJGrid.pkg"            to asInput[0]
            Move "Use Dftable.pkg"              to asInput[1]
            Move "//Object oOld is a dbGrid"    to asInput[2]
            Move "Object oGrid is a dbGrid"     to asInput[3]
            Move "End_Object"                   to asInput[4]
            Get RunTransform_as asInput to asOutput
            Get ArrayHasLine asOutput "Use Dftable.pkg" to bLegacyLive
            Send AssertFalse bLegacyLive
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oLegacyLeftovers - what the converter left in a CodeJock grid until the porter's probe over a real
    // workspace counted it (2026-10-04): the older colour names, Numeric_Mask and its Currency_Mask twin,
    // the item forms of Object_Shadow_State / Enabled_State, Select_Mode, and the column messages and
    // Highlight_State that become TODOs. One assertion per test.
    // -----------------------------------------------------------------------
    Object oLegacyLeftovers is a cTestFixture
        Set psFunctionName to "LegacyLeftovers (cDbGridTocDbCJGrid)"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // A dbGrid of two columns - Orders.Amount (item 0) and Orders.Qty (item 1) - with asBody after End_Row.
        Function RunGrid String[] asBody Returns String[]
            String[] asInput asOutput
            Integer  i iGrids
            Move "Object oGrid is a dbGrid"         to asInput[SizeOfArray(asInput)]
            Move "    Begin_Row"                    to asInput[SizeOfArray(asInput)]
            Move "        Entry_Item Orders.Amount" to asInput[SizeOfArray(asInput)]
            Move "        Entry_Item Orders.Qty"    to asInput[SizeOfArray(asInput)]
            Move "    End_Row"                      to asInput[SizeOfArray(asInput)]
            For i from 0 to (SizeOfArray(asBody) - 1)
                Move asBody[i] to asInput[SizeOfArray(asInput)]
            Loop
            Move "End_Object"                       to asInput[SizeOfArray(asInput)]
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        // The output's trimmed lines joined by "|" - the assertion message.
        Function Joined String[] asOut Returns String
            String  s
            Integer i
            Move "" to s
            For i from 0 to (SizeOfArray(asOut) - 1)
                Move (s + Trim(asOut[i]) + "|") to s
            Loop
            Function_Return s
        End_Function

        // True when a line trims to sLine exactly.
        Function HasLine String[] asOut String sLine Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (Trim(asOut[i]) = sLine) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // True when a line contains sPart.
        Function HasPart String[] asOut String sPart Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (asOut[i] contains sPart) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // One object's lines, trimmed and joined by "|": from the line that trims to sFrom to its End_Object.
        Function ObjectBody String[] asOut String sFrom Returns String
            String  s
            Integer i
            Boolean bIn
            Move "" to s
            Move False to bIn
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (bIn = False and Trim(asOut[i]) = sFrom) ;
                    Move True to bIn
                If (bIn = True) Begin
                    Move (s + Trim(asOut[i]) + "|") to s
                    If (Trim(asOut[i]) = "End_Object") ;
                        Move False to bIn
                End
            Loop
            Function_Return s
        End_Function

        // Numeric_Mask's pair becomes the column's CreateNumericMask - never psMask ("Set psMask to 12 2").
        {Published = True}
        Procedure Mask_PairBecomesCreateNumericMask
            String[] asBody asOut
            Move "    Set Numeric_Mask Item 0 to 12 2" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert ((ObjectBody(Self, asOut, "Object oOrders_Amount is a cDbCJGridColumn") contains "|Send CreateNumericMask 12 2|") and not(HasPart(Self, asOut, "psMask"))) (Joined(Self, asOut))
        End_Procedure

        // A template after the pair builds the mask through Number_Default_Mask, as the legacy message did.
        {Published = True}
        Procedure Mask_TemplateBuildsTheMask
            String[] asBody asOut
            Move '    Set Numeric_Mask Item 1 to 4 0 "*%"' to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert (ObjectBody(Self, asOut, "Object oOrders_Qty is a cDbCJGridColumn") contains '|Send CreateNumericMask 4 0|Set psMask to (Number_Default_Mask(4, 0, "*%"))|') (Joined(Self, asOut))
        End_Procedure

        // A comment after the value is no template (2026-10-31): it became 'Number_Default_Mask(10, 2, // Amount)',
        // error 4346. A template string before the comment still builds the mask.
        {Published = True}
        Procedure Mask_TrailingCommentIsNoTemplate
            String[] asBody asOut
            Move '    Set Currency_Mask Item 0 to 8 2   // Amount'   to asBody[0]
            Move '    Set Numeric_Mask Item 1 to 4 0 "*%" // percent' to asBody[1]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Send CreateCurrencyMask 8 2")) (Joined(Self, asOut))
            Send Assert (HasPart(Self, asOut, "Amount))") = False) ("the comment became a template: " + Joined(Self, asOut))
            Send Assert (HasPart(Self, asOut, 'Set psMask to (Number_Default_Mask(4, 0, "*%"))')) (Joined(Self, asOut))
        End_Procedure

        // Currency_Mask, Numeric_Mask's documented twin: the column's CreateCurrencyMask.
        {Published = True}
        Procedure Mask_CurrencyTwin
            String[] asBody asOut
            Move "    Set Currency_Mask Item 0 to 8 2" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Send CreateCurrencyMask 8 2")) (Joined(Self, asOut))
        End_Procedure

        // A mask after the column objects is written in place against its column - it was dropped in silence.
        {Published = True}
        Procedure Mask_AfterTheColumns_WrittenInPlace
            String[] asBody asOut
            Move "    Set Form_Width Item 0 to 50"     to asBody[0]
            Move "    Set Ordering to 1"               to asBody[1]
            Move "    Set Numeric_Mask Item 0 to 8 2"  to asBody[2]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Send CreateNumericMask of oOrders_Amount 8 2")) (Joined(Self, asOut))
        End_Procedure

        // One value is not a pair: a TODO, and no CreateNumericMask made up from half a pair.
        {Published = True}
        Procedure Mask_OneValue_IsATodo
            String[] asBody asOut
            Move "    Set Numeric_Mask Item 0 to 4" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert (HasPart(Self, asOut, "// TODO: Numeric_Mask takes the digits left and right of the decimal separator") and not(HasPart(Self, asOut, "Send CreateNumericMask"))) (Joined(Self, asOut))
        End_Procedure

        // The item form of Object_Shadow_State shadows its column, as Column_Shadow_State does.
        {Published = True}
        Procedure Shadow_ObjectShadowItem_ShadowsTheColumn
            String[] asBody asOut
            Move "    Set Object_Shadow_State Item 1 to True" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert ((ObjectBody(Self, asOut, "Object oOrders_Qty is a cDbCJGridColumn") contains "|Set pbEditable to False|Set pbFocusable to False|") and not(HasPart(Self, asOut, "Object_Shadow_State"))) (Joined(Self, asOut))
        End_Procedure

        // ...and Enabled_State's item form the same, inverted - the form ChangeLegacyShadow_State makes of it.
        {Published = True}
        Procedure Shadow_EnabledItem_ShadowsTheColumn
            String[] asBody asOut
            Move "    Set Enabled_State Item 1 to False" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert ((ObjectBody(Self, asOut, "Object oOrders_Qty is a cDbCJGridColumn") contains "|Set pbEditable to False|Set pbFocusable to False|") and not(HasPart(Self, asOut, "Enabled_State"))) (Joined(Self, asOut))
        End_Procedure

        // The object's OWN Object_Shadow_State and Enabled_State are not column properties: they pass through
        // (ChangeLegacyShadow_State makes Enabled_State of the first; a cCJGrid has Enabled_State).
        {Published = True}
        Procedure Shadow_ObjectForms_PassThrough
            String[] asBody asOut
            Move "    Set Form_Width Item 0 to 50"         to asBody[0]
            Move "    Set Object_Shadow_State to True"     to asBody[1]
            Move "    Set Enabled_State to False"          to asBody[2]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Set Object_Shadow_State to True") and HasLine(Self, asOut, "Set Enabled_State to False")) (Joined(Self, asOut))
        End_Procedure

        // A column message among the column properties: its TODO goes into the column, and the window stays
        // open - the Form_Width after it still reaches column 1.
        {Published = True}
        Procedure ColumnMessage_InTheWindow_TodoInTheColumn
            String[] asBody asOut
            Move "    Set Column_Validate_Msg Item 0 to Get_fCheck" to asBody[0]
            Move "    Set Form_Width Item 1 to 77"                  to asBody[1]
            Get RunGrid asBody to asOut
            Send Assert ((ObjectBody(Self, asOut, "Object oOrders_Amount is a cDbCJGridColumn") contains "|// TODO: Column_Validate_Msg has no CodeJock counterpart - move what its message does into this column's OnValidating event. Was: Set Column_Validate_Msg Item 0 to Get_fCheck|") and (ObjectBody(Self, asOut, "Object oOrders_Qty is a cDbCJGridColumn") contains "|Set piWidth to 77|") and not(HasLine(Self, asOut, "Set Column_Validate_Msg Item 0 to Get_fCheck"))) (Joined(Self, asOut))
        End_Procedure

        // ...and one after the column objects (a real workspace: below the grid's methods) leaves its TODO in
        // place, naming the column object.
        {Published = True}
        Procedure ColumnMessage_AfterTheColumns_TodoInPlace
            String[] asBody asOut
            Move "    Set Ordering to 1"                             to asBody[0]
            Move "    Set Column_Entry_Msg Item 1 to Get_fShow"      to asBody[1]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "// TODO: Column_Entry_Msg has no CodeJock counterpart - move what its message does into oOrders_Qty's OnEntry event (OnEntering to refuse the entry). Was: Set Column_Entry_Msg Item 1 to Get_fShow")) (Joined(Self, asOut))
        End_Procedure

        // The older names of CurrentRowColor and CurrentCellColor reach the same CodeJock properties.
        {Published = True}
        Procedure Colors_OlderNames
            String[] asBody asOut
            Move "    Set Highlight_Row_Color to (fRowColor(Self))" to asBody[0]
            Move "    Set Current_Item_Color to clLime"             to asBody[1]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Set piHighlightBackColor to (fRowColor(Self))") and HasLine(Self, asOut, "Set piFocusCellBackColor to clLime")) (Joined(Self, asOut))
        End_Procedure

        // Select_Mode on a dbGrid as the Grid converter maps it: Multi_Select -> pbMultipleSelection, else gone.
        {Published = True}
        Procedure SelectMode_OnADbGrid
            String[] asBody asMulti asNone
            Move "    Set Select_Mode to Multi_Select" to asBody[0]
            Get RunGrid asBody to asMulti
            Move "    Set Select_Mode to No_Select" to asBody[0]
            Get RunGrid asBody to asNone
            Send Assert (HasLine(Self, asMulti, "Set pbMultipleSelection to True") and not(HasPart(Self, asMulti, "Select_Mode")) and not(HasPart(Self, asNone, "Select_Mode")) and not(HasPart(Self, asNone, "pbMultipleSelection"))) (Joined(Self, asMulti) + " / " + Joined(Self, asNone))
        End_Procedure

        // Highlight_State has no counterpart: a TODO that keeps the line.
        {Published = True}
        Procedure HighlightState_IsATodo
            String[] asBody asOut
            Move "    Set Highlight_State to True" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "// TODO: Highlight_State has no cCJGrid counterpart - pbShowRowFocus and piFocusCellBackColor set how the current row and cell show. Was: Set Highlight_State to True")) (Joined(Self, asOut))
        End_Procedure

    End_Object

End_Object
