    // ---------------------------------------------------------------------------
    
    Object oGridMethodTransformSource is a cTestFixture
        Set psFunctionName to "TransformSource - method overrides"
    
        Object oWorker is a cDbGridTocDbCJGrid
        End_Object
    
        // Helper procedures
        Function RunTransform_i String[] asInput Returns Integer
            Integer iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Function_Return iGrids
        End_Function
    
        Function GetOutput Returns String[]
            String[] asOut
            Get pasSource of oWorker to asOut
            Function_Return asOut
        End_Function
    
        // -----------------------------------------------------------------------
        // Clean rename: declaration and Forward Send renamed
        // -----------------------------------------------------------------------
    
        // A Mouse_Click whose body declares its OWN local named iCol (or iRow): the converted
        // signature injects iRow/iCol as PARAMETERS, and DataFlex rejects a body local of the
        // same name - 4345 "ICOL, SHOULD NOT BE DEFINED" + 4332 "Symbol already defined"
        // (reproduced standalone against DF25; LegacyApp's 388-error break, Nils 2026-07-26).
        // OUR parameter names step aside; the customer's variable is left exactly as written.
        {Published = True}
        { Description = "Mouse_Click body local named iCol makes the injected parameters step aside" }
        Procedure MouseClick_BodyLocalCollision_ParamsRenamed
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bSafeSig bLocalKept bNoClash bFwd

            Move "Object oGrid is a cDbGrid"                            to asInput[0]
            Move "    Procedure Mouse_Click Integer iWin Integer iPos"  to asInput[1]
            Move "        Integer iCol"                                 to asInput[2]
            Move "        Get Current_Col to iCol"                      to asInput[3]
            Move "        Forward Send Mouse_Click iWin iPos"           to asInput[4]
            Move "    End_Procedure"                                    to asInput[5]
            Move "End_Object"                                           to asInput[6]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bSafeSig
            Move True  to bNoClash
            Move False to bLocalKept
            Move False to bFwd
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Procedure OnRowDoubleClick Integer iGridRow Integer iGridCol") Move True to bSafeSig
                // The colliding signature must NOT be emitted.
                If (asOutput[iIdx] contains "Procedure OnRowDoubleClick Integer iRow Integer iCol")         Move False to bNoClash
                // The customer's own declaration survives untouched.
                If (Trim(asOutput[iIdx]) = "Integer iCol")                                                  Move True to bLocalKept
                // The Forward Send carries the SAME names as the signature.
                If (asOutput[iIdx] contains "Forward Send OnRowDoubleClick iGridRow iGridCol")              Move True to bFwd
            Loop
            Send Assert (bSafeSig and bNoClash and bLocalKept and bFwd)
        End_Procedure

        // The normal case must be untouched: no colliding local -> the natural iRow / iCol names,
        // which is what cCJGrid itself uses and what every existing converted file already has.
        {Published = True}
        { Description = "Mouse_Click with no colliding local keeps the natural iRow / iCol names" }
        Procedure MouseClick_NoCollision_KeepsNaturalNames
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bNatural bFwd

            Move "Object oGrid is a cDbGrid"                            to asInput[0]
            Move "    Procedure Mouse_Click Integer iWin Integer iPos"  to asInput[1]
            Move "        Integer iItem"                                to asInput[2]
            Move "        Forward Send Mouse_Click iWin iPos"           to asInput[3]
            Move "    End_Procedure"                                    to asInput[4]
            Move "End_Object"                                           to asInput[5]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bNatural
            Move False to bFwd
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Procedure OnRowDoubleClick Integer iRow Integer iCol") Move True to bNatural
                If (asOutput[iIdx] contains "Forward Send OnRowDoubleClick iRow iCol")              Move True to bFwd
            Loop
            Send Assert (bNatural and bFwd)
        End_Procedure

        /* THE PARAMETER RENAME IS A WHOLE-WORD RENAME (WinServ PROJECT.vw, Nils 2026-08-17: the
           error count went UP after the run). A legacy 'mouse_click Integer window Integer char_pos'
           whose body calls '(Jobbreg_MultiWindow(Self))' came out as '(Jobbreg_MultiiRow(Self))' -
           E 4328 undefined symbol - because the old parameter name was swapped as a bare substring,
           first hit only. Now: identifier boundaries, every occurrence, and never inside a string. */
        {Published = True}
        { Description = "Mouse_Click parameter rename is whole-word: Jobbreg_MultiWindow survives, both bare uses go, a string is untouched" }
        Procedure MouseClick_ParamRename_IsWholeWord
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bObjKept bBothRenamed bStringKept bMangled

            Move "Object oGrid is a cDbGrid"                                          to asInput[0]
            Move "    Procedure mouse_click Integer window Integer char_pos"          to asInput[1]
            Move "        Send SafeCloseView (Jobbreg_MultiWindow(Self))"             to asInput[2]
            Move "        If (window > 0 and Window < 9) Send Info_Box 'window here'" to asInput[3]
            Move "    End_Procedure"                                                  to asInput[4]
            Move "End_Object"                                                         to asInput[5]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bObjKept
            Move False to bBothRenamed
            Move False to bStringKept
            Move False to bMangled
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "(Jobbreg_MultiWindow(Self))")               Move True to bObjKept
                If (asOutput[iIdx] contains "Jobbreg_MultiiRow")                          Move True to bMangled
                If (asOutput[iIdx] contains "If (iRow > 0 and iRow < 9)")                 Move True to bBothRenamed
                If (asOutput[iIdx] contains "Send Info_Box 'window here'")                Move True to bStringKept
            Loop
            Send Assert bObjKept     "the object accessor Jobbreg_MultiWindow(Self) must survive the parameter rename"
            Send AssertFalse bMangled "the parameter rename must not reach inside another identifier"
            Send Assert bBothRenamed "both bare uses of the old parameter on one line must be renamed"
            Send Assert bStringKept  "a string literal must not be renamed"
        End_Procedure

        {Published = True}
        { Description = "Goto_Top_Row declaration is renamed to MoveToFirstRow" }
        Procedure GotoTopRow_DeclRenamed
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFoundNew bFoundOld
    
            Move "Object oGrid is a cDbGrid"       to asInput[0]
            Move "    Procedure Goto_Top_Row"      to asInput[1]
            Move "    End_Procedure"               to asInput[2]
            Move "End_Object"                      to asInput[3]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Move False to bFoundNew
            Move False to bFoundOld
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] = "    Procedure MoveToFirstRow") Begin
                    Move True to bFoundNew
                End
                If (Lowercase(asOutput[iIdx]) contains "goto_top_row") Begin
                    Move True to bFoundOld
                End
            Loop
            Send Assert bFoundNew
            Send AssertFalse bFoundOld
        End_Procedure
    
        {Published = True}
        { Description = "Forward Send of old name is renamed inside the procedure body" }
        Procedure GotoTopRow_ForwardSendRenamed
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFoundNew bFoundOld
    
            Move "Object oGrid is a cDbGrid"            to asInput[0]
            Move "    Procedure Goto_Top_Row"           to asInput[1]
            Move "        Forward Send Goto_Top_Row"    to asInput[2]
            Move "    End_Procedure"                    to asInput[3]
            Move "End_Object"                           to asInput[4]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Move False to bFoundNew
            Move False to bFoundOld
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] = "        Forward Send MoveToFirstRow") Begin
                    Move True to bFoundNew
                End
                If (Lowercase(asOutput[iIdx]) contains "goto_top_row") Begin
                    Move True to bFoundOld
                End
            Loop
            Send Assert bFoundNew
            Send AssertFalse bFoundOld
        End_Procedure
    
        {Published = True}
        { Description = "Down_Row declaration is renamed to MoveDownRow" }
        Procedure DownRow_DeclRenamed
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFoundNew
    
            Move "Object oGrid is a cDbGrid"  to asInput[0]
            Move "    Procedure Down_Row"     to asInput[1]
            Move "    End_Procedure"          to asInput[2]
            Move "End_Object"                 to asInput[3]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Move False to bFoundNew
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] = "    Procedure MoveDownRow") Begin
                    Move True to bFoundNew
                End
            Loop
            Send Assert bFoundNew
        End_Procedure
    
        {Published = True}
