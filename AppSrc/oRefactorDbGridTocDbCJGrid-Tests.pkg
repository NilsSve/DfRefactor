    Object oColumnPropertyTransformSource is a cTestFixture
        Set psFunctionName to "TransformSource - column properties"

        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        Function RunTransform_i String[] asInput Returns Integer
            Integer iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Function_Return iGrids
        End_Function

        Function GetOutput Returns String[]
            String[] asOut
            Get pasSource of oWorker to asOut
            Function_Return asOut
        End_Function

        // -----------------------------------------------------------------------
        // Column_Checkbox_State -> pbCheckBox
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "Column_Checkbox_State Item N True -> Set pbCheckBox to True on column N" }
        Procedure CheckboxState_WithItem_True
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFound

            Move "Object oGrid is a cDbGrid"                    to asInput[0]
            Move "    Begin_Row"                                to asInput[1]
            Move "        Entry_Item Orders.ID"                 to asInput[2]
            Move "    End_Row"                                  to asInput[3]
            Move "    Set Column_Checkbox_State Item 0 to True" to asInput[4]
            Move "End_Object"                                   to asInput[5]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Set pbCheckBox to True") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        // Regression (LegacyApp compin.vw CompH, 2026-07-05): a CONDITIONAL per-column property -
        // 'If (PsLANG eq "es") Set Header_Label N to "..."', the inline-If localization pattern -
        // used to END the pending-columns window: every column AFTER the first such line lost its
        // width/caption to the defaults, and the If-lines passed through raw, referencing item
        // numbers that no longer exist. Now they are collected and re-emitted after the column
        // objects as 'If (...) Set psCaption of <column> to "..."', and the later columns keep
        // their collected properties.
        {Published = True}
        { Description = "Conditional Header_Label lines are rewritten per column and do not break later columns" }
        Procedure ConditionalHeaderLabel_RewrittenAndLaterColumnsKept
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bCond bLater bRaw bPost

            Move "Object oGrid is a cDbGrid"                                    to asInput[0]
            Move "    Begin_Row"                                                to asInput[1]
            Move "        Entry_Item Orders.ID"                                 to asInput[2]
            Move "        Entry_Item Orders.Name"                               to asInput[3]
            Move "        Entry_Item Orders.City"                               to asInput[4]
            Move "    End_Row"                                                  to asInput[5]
            Move "    Set Form_Width 0 to 45"                                   to asInput[6]
            Move ("    Set Header_Label 0 to " + Character(34) + "Id" + Character(34))   to asInput[7]
            Move "    Set Form_Width 1 to 78"                                   to asInput[8]
            Move ("    Set Header_Label 1 to " + Character(34) + "Name" + Character(34)) to asInput[9]
            Move ("    If (PsLANG eq " + Character(34) + "es" + Character(34) + ") Set Header_Label 1 to " + Character(34) + "Nombre" + Character(34)) to asInput[10]
            Move "    Set Form_Width 2 to 67"                                   to asInput[11]
            Move ("    Set Header_Label 2 to " + Character(34) + "City" + Character(34)) to asInput[12]
            // A grid-level property CLOSES the pending window - the conditional after it exercises
            // the POST-flush translation path (LegacyApp: column 13's 'Estado' leaked raw).
            Move "    Set Read_Only_State to True"                              to asInput[13]
            Move ("    If (PsLANG eq " + Character(34) + "es" + Character(34) + ") Set Header_Label 2 to " + Character(34) + "Ciudad" + Character(34)) to asInput[14]
            Move "End_Object"                                                   to asInput[15]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bCond
            Move False to bLater
            Move False to bRaw
            Move False to bPost
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                // The conditional is rewritten against the column OBJECT.
                If (asOutput[iIdx] contains "Set psCaption of oOrders_Name to") Begin
                    If (asOutput[iIdx] contains "PsLANG") ;
                        Move True to bCond
                End
                // A column AFTER the conditional keeps its collected width (67, not the 100 default).
                If (asOutput[iIdx] contains "Set piWidth to 67") Begin
                    Move True to bLater
                End
                // The POST-flush conditional (after the grid-level property) is rewritten too.
                If (asOutput[iIdx] contains "Set psCaption of oOrders_City to") Begin
                    If (asOutput[iIdx] contains "Ciudad") ;
                        Move True to bPost
                End
                // No raw legacy line may survive.
                If (asOutput[iIdx] contains "Set Header_Label") Begin
                    Move True to bRaw
                End
            Loop
            Send Assert bCond
            Send Assert bLater
            Send Assert bPost
            Send AssertFalse bRaw
        End_Procedure

        {Published = True}
        { Description = "Column_Checkbox_State without Item keyword also works" }
        Procedure CheckboxState_WithoutItem
            String[] asInput asOutput
            Integer  iGrids iIdx
