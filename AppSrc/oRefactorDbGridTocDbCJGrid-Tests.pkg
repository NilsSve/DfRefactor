    End_Object
    
    Object oTransformSource is a cTestFixture
        Set psFunctionName to "TransformSource"
    
        Object oWorker is a cDbGridTocDbCJGrid
        End_Object

        // Every run starts with the worker as its constructor left it. Tests below change its parameter on the
        // way - the ParseParam_ tests, and ReplaceGridClassName_Indent leaves the EMPTY parameter, under which only
        // the plain dbGrid converts - and nothing put it back: a second run in the same program ("Run again" in
        // the runner) started from that, and 14 tests here failed.
        Procedure SetupOneTime
            String[] asNone
            Forward Send SetupOneTime
            Set psLegacyGridClass   of oWorker to ""
            Set psTargetGridClass   of oWorker to CS_CJGrid_TargetClass
            Set psTargetColumnClass of oWorker to CS_CJGrid_TargetColumn
            Set pbEmptyParameter    of oWorker to False
            Set pasLegacySubclasses of oWorker to asNone
        End_Procedure
    
        // Helper: load a String[] into oWorker and run TransformSource.
        // Returns the result array via ByRef and the grid count as the function return.
        Function RunTransform_i String[] asInput Returns Integer
            Integer iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Function_Return iGrids
        End_Function
    
        // Helper: retrieve the output array from oWorker after RunTransform_i.
        Function GetOutput Returns String[]
            String[] asOut
            Get pasSource of oWorker to asOut
            Function_Return asOut
        End_Function
    
        // -----------------------------------------------------------------------
        // Class name replacement
        // -----------------------------------------------------------------------
    
        {Published = True}
        { Description = "DbGrid class name is replaced with the default cDbCJGrid target" }
        Procedure ClassNameReplaced
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oMyGrid is a cDbGrid" to asInput[0]
            Move "End_Object"                  to asInput[1]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Send AssertIAreEqual 1 iGrids
            Send AssertSAreEqual "Object oMyGrid is a cDbCJGrid" asOutput[0]
        End_Procedure
    
        {Published = True}
        { Description = "Pattern-match: any class ending in 'dbgrid' is replaced" }
        Procedure PatternMatch_AnyDbGrid
            String[] asInput asOutput
            Integer  iGrids
    
            Move "    Object oGrid is a cTrDbGrid" to asInput[0]
            Move "    End_Object"                    to asInput[1]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Send AssertIAreEqual 1 iGrids
            Send AssertSAreEqual "    Object oGrid is a cDbCJGrid" asOutput[0]
        End_Procedure
    
        {Published = True}
        { Description = "Non-grid objects are passed through unchanged" }
        Procedure NonGridObject_PassedThrough
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oMyPanel is a cPanel" to asInput[0]
            Move "End_Object"                  to asInput[1]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 0 iGrids
            Send AssertSAreEqual "Object oMyPanel is a cPanel" asOutput[0]
            Send AssertSAreEqual "End_Object"                  asOutput[1]
        End_Procedure

        // -----------------------------------------------------------------------
        // Define constants are PRESERVED (regression, Nils LegacyApp 2026-07-03):
        // the converter DELETED 'Define <name> for N' lines inside the grid as
        // "dead column-index constants" - but preserved procedures still REFERENCE
        // them ('Set Item_Option Item (BI+list0041w_Amount)'), so 5 views broke
        // with ~145 'Undefined symbol' errors. A Define is free if unused - keep it.
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "Define constants AFTER the column block are preserved (the list0041 shape)" }
        Procedure DefineConstants_AfterColumnBlock_Preserved
            String[] asInput asOutput
            Integer  iGrids

            Move "Object oAttestrader is a cDbGrid"          to asInput[0]
            Move "    Begin_Row"                             to asInput[1]
            Move "    Entry_Item List0040.VchNo"             to asInput[2]
            Move "    End_Row"                               to asInput[3]
            Move "    Set Form_Width item 0 to 39"           to asInput[4]
            Move "    Set peAnchors to anTopLeftRight"       to asInput[5]
            Move "    Define list0041w_VchNo for 0"          to asInput[6]
            Move "    Define list0041w_Amount for 7"         to asInput[7]
            Move "End_Object"                                to asInput[8]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (SearchArray("    Define list0041w_VchNo for 0", asOutput, Desktop, RefFunc(DFSTRICMP)) <> -1)
            Send Assert (SearchArray("    Define list0041w_Amount for 7", asOutput, Desktop, RefFunc(DFSTRICMP)) <> -1)
        End_Procedure

        {Published = True}
        { Description = "A Define BETWEEN column properties is preserved AND the later column property still collects" }
        Procedure DefineConstants_InColumnBlock_Preserved
            String[] asInput asOutput
            Integer  iGrids i iLast
            Boolean  bCaption

            Move "Object oGrid is a cDbGrid"                 to asInput[0]
            Move "    Begin_Row"                             to asInput[1]
            Move "    Entry_Item Foo.Bar"                    to asInput[2]
            Move "    End_Row"                               to asInput[3]
            Move "    Set Form_Width item 0 to 10"           to asInput[4]
            Move "    Define COL_Bar for 0"                  to asInput[5]
            Move '    Set Header_Label item 0 to "Bar"'      to asInput[6]
            Move "End_Object"                                to asInput[7]

            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (SearchArray("    Define COL_Bar for 0", asOutput, Desktop, RefFunc(DFSTRICMP)) <> -1)
            // The Header_Label AFTER the Define still collected into the column (psCaption).
            Move False to bCaption
            Move (SizeOfArray(asOutput) - 1) to iLast
            For i from 0 to iLast
                If ((asOutput[i] contains "psCaption") and (asOutput[i] contains '"Bar"')) ;
                    Move True to bCaption
            Loop
            Send Assert bCaption
        End_Procedure
    
        {Published = True}
        { Description = "Return value counts the number of grids converted" }
        Procedure GridCount_TwoGrids
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oGrid1 is a cDbGrid" to asInput[0]
            Move "End_Object"                 to asInput[1]
            Move "Object oGrid2 is a cDbGrid" to asInput[2]
            Move "End_Object"                 to asInput[3]
    
            Get RunTransform_i asInput to iGrids
            Send AssertIAreEqual 2 iGrids
        End_Procedure
    
        // -----------------------------------------------------------------------
        // Legacy property removal inside a grid
        // -----------------------------------------------------------------------
    
        {Published = True}
        { Description = "Set Main_File inside a grid is commented out, not removed" }
        Procedure MainFile_CommentedOut
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFoundCommented bFoundRaw
    
            Move "Object oGrid is a cDbGrid"     to asInput[0]
            Move "    Set Main_File to Orders"   to asInput[1]
            Move "    Set Size to 100 200"       to asInput[2]
            Move "End_Object"                    to asInput[3]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            // Verify the commented-out line is present
            Move False to bFoundCommented
            Move False to bFoundRaw
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Left(asOutput[iIdx], 2) = "//" and Lowercase(asOutput[iIdx]) contains "set main_file") Begin
                    Move True to bFoundCommented
                End
                // The raw (un-commented) Set Main_File line must not appear
                If (Trim(Lowercase(asOutput[iIdx])) = "set main_file to orders") Begin
                    Move True to bFoundRaw
                End
            Loop
            Send Assert bFoundCommented
            Send AssertFalse bFoundRaw
    
            // Verify the ordinary property still passes through unchanged
            Move False to bFoundRaw
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] = "    Set Size to 100 200") Begin
                    Move True to bFoundRaw
                End
            Loop
            Send Assert bFoundRaw
        End_Procedure
    
        {Published = True}
        { Description = "Set Item_Limit inside a grid is removed" }
        Procedure ItemLimit_Removed
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFound
    
            Move "Object oGrid is a cDbGrid"   to asInput[0]
            Move "    Set Item_Limit to 5"     to asInput[1]
            Move "End_Object"                  to asInput[2]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "item_limit") Begin
                    Move True to bFound
                End
            Loop
            Send AssertFalse bFound
        End_Procedure
    
        // -----------------------------------------------------------------------
        // Property translation inside a grid
        // -----------------------------------------------------------------------
    
        {Published = True}
        { Description = "No_Create_State True inside a grid -> 2 pbAllow lines (inverted)" }
        Procedure NoCreateState_InGrid
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFoundAppend bFoundInsert
    
            Move "Object oGrid is a cDbGrid"         to asInput[0]
            Move "    Set No_Create_State to True"   to asInput[1]
            Move "End_Object"                        to asInput[2]
    
            Get RunTransform_i asInput to iGrids
            Get GetOutput            to asOutput
    
            Move False to bFoundAppend
            Move False to bFoundInsert
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] = "    Set pbAllowAppendRow to False") Begin
                    Move True to bFoundAppend
                End
                If (asOutput[iIdx] = "    Set pbAllowInsertRow to False") Begin
                    Move True to bFoundInsert
                End
            Loop
            Send Assert bFoundAppend
            Send Assert bFoundInsert
        End_Procedure
    
