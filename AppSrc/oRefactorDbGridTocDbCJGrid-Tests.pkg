    Object oIsCommentOutGridProperty is a cTestFixture
        Set psFunctionName to "IsCommentOutGridProperty"
    
        Object oWorker is a cDbGridTocDbCJGrid
        End_Object
    
        {Published = True}
        { Description = "main_file is a comment-out property" }
        Procedure MainFile_IsCommentOut
            Boolean bResult
            Get IsCommentOutGridProperty of oWorker "set main_file to orders" to bResult
            Send Assert bResult
        End_Procedure
    
        {Published = True}
        { Description = "wrap_state (legacy-remove) must not be a comment-out property" }
        Procedure WrapState_NotCommentOut
            Boolean bResult
            Get IsCommentOutGridProperty of oWorker "set wrap_state to true" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "An ordinary CJGrid property must not be a comment-out property" }
        Procedure OrdinaryProperty_NotCommentOut
            Boolean bResult
            Get IsCommentOutGridProperty of oWorker "set pbeditable to true" to bResult
            Send AssertFalse bResult
        End_Procedure

        /* The embedded-prompt pair is commented out, not passed through. Both have counterparts,
           but on the COLUMN (Prompt_Button_Value / Prompt_Button_Mode) rather than the grid, so a
           rename in place would be wrong. Passed through untouched they do not compile - which is
           how this was found (Nils 2026-08-04, "Set psEmbeddedButtonValue to \"\"" landing in a
           converted cDbCJGridPromptList). */
        { Published = True }
        Procedure IsCommentOutGridProperty_EmbeddedPromptPair
            Boolean bResult
            String  sHint
            Get IsCommentOutGridProperty of oWorker 'set psembeddedbuttonvalue to ""' to bResult
            Send Assert bResult
            Get IsCommentOutGridProperty of oWorker "set pbembeddedprompts to true" to bResult
            Send Assert bResult
            // and each carries a hint naming its column-level counterpart
            Get LegacyOnlyGridPropertyHint of oWorker 'set psembeddedbuttonvalue to ""' to sHint
            Send Assert (sHint contains "Prompt_Button_Value")
            Get LegacyOnlyGridPropertyHint of oWorker "set pbembeddedprompts to true" to sHint
            Send Assert (sHint contains "Prompt_Button_Mode")
        End_Procedure

        // A property with no hint still comments out cleanly - the hint is optional, not required.
        { Published = True }
        Procedure IsCommentOutGridProperty_MainFileHasNoHint
            Boolean bResult
            String  sHint
            Get IsCommentOutGridProperty of oWorker "set main_file to orders" to bResult
            Send Assert bResult
            Get LegacyOnlyGridPropertyHint of oWorker "set main_file to orders" to sHint
            Send AssertSAreEqual "" sHint
        End_Procedure

        /* Batch-triage results, 2026-08-04. Each verified against BOTH installs' declarations
           before being encoded - a name-level match alone is not evidence (Batch_State looked like
           it paired with ComUseBatchAllocation, which is CodeJock memory allocation and nothing to
           do with the legacy DD batch mode; rejected). */
        { Published = True }
        Procedure TranslateGridProperty_StaticStateAndInitialColumn
            Boolean bResult
            String[] asOut
            Get IsTranslatableGridProperty of oWorker "set static_state to true" to bResult
            Send Assert bResult
            Get TranslateGridProperty of oWorker "    Set Static_State to True" "set static_state to true" to asOut
            Send Assert (asOut[0] contains "Set pbStaticData to True")
            // the VALUE is carried across, not assumed - legacy defaults to 0, cCJGrid to -1
            Get TranslateGridProperty of oWorker "    Set Initial_Column to 3" "set initial_column to 3" to asOut
            Send Assert (asOut[0] contains "Set piInitialColumn to 3")
        End_Procedure

        // The Column_* family moves ONTO the column object and drops the column-index parameter,
        // so these are hints, not renames.
        { Published = True }
        Procedure LegacyOnlyGridMethodHint_TriagedMethods
            Boolean bResult
            String  sHint
            Get IsLegacyOnlyGridMethod of oWorker "row_changing" to bResult
            Send Assert bResult
            Get LegacyOnlyGridMethodHint of oWorker "row_changing" to sHint
            Send Assert (sHint contains "OnRowChanging")
            Send Assert (sHint contains "BOOLEAN")
            Get LegacyOnlyGridMethodHint of oWorker "column_combo_fill_list" to sHint
            Send Assert (sHint contains "ComboFillList")
            Send Assert (sHint contains "COLUMN")
            Get LegacyOnlyGridMethodHint of oWorker "column_combo_description_value" to sHint
            Send Assert (sHint contains "ComboDescriptionValue")
        End_Procedure
    
        {Published = True}
        { Description = "A line that does not start with 'set ' must not be a comment-out property" }
        Procedure NonSet_NotCommentOut
            Boolean bResult
            Get IsCommentOutGridProperty of oWorker "object omygrid is a cdbgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
    End_Object
    
    Object oCommentOutLine is a cTestFixture
        Set psFunctionName to "CommentOutLine"
    
        Object oWorker is a cDbGridTocDbCJGrid
        End_Object
    
        // Column-1 style (Nils 2026-07-05): the '//' goes FIRST, the original line - indentation
        // included - is preserved verbatim after it, so a commented block has all its markers
        // aligned and uncommenting is a uniform 2-char strip.
        {Published = True}
        { Description = "Indented line gets '//' prepended at column 1, indentation preserved after it" }
        Procedure IndentedLine
            String sResult
            Get CommentOutLine of oWorker "    Set Main_File to Orders" to sResult
            Send AssertSAreEqual "//    Set Main_File to Orders" sResult
        End_Procedure

        {Published = True}
        { Description = "Unindented line gets '//' prepended" }
        Procedure UnindentedLine
            String sResult
            Get CommentOutLine of oWorker "Set Main_File to Orders" to sResult
            Send AssertSAreEqual "//Set Main_File to Orders" sResult
        End_Procedure

        {Published = True}
        { Description = "Deeply indented line keeps all its leading spaces after the column-1 marker" }
        Procedure DeeplyIndentedLine
            String sResult
            Get CommentOutLine of oWorker "        Procedure Entry_Display" to sResult
            Send AssertSAreEqual "//        Procedure Entry_Display" sResult
        End_Procedure

        {Published = True}
        { Description = "Empty line returns '//'" }
        Procedure EmptyLine
            String sResult
            Get CommentOutLine of oWorker "" to sResult
            Send AssertSAreEqual "//" sResult
        End_Procedure
    
    End_Object
    
