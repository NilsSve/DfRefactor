        // No_Create_State (inverted, expands to 2 lines)
        // -----------------------------------------------------------------------
    
        {Published = True}
        { Description = "No_Create_State True -> pbAllowAppendRow False + pbAllowInsertRow False (2 lines)" }
        Procedure NoCreateState_True
            String[] asResult
            String   sLine sLower
            Move "    Set No_Create_State to True" to sLine
            Move (Lowercase(Trim(sLine))) to sLower
            Get TranslateGridProperty of oWorker sLine sLower to asResult
            Send AssertIAreEqual 2 (SizeOfArray(asResult))
            Send AssertSAreEqual "    Set pbAllowAppendRow to False" asResult[0]
            Send AssertSAreEqual "    Set pbAllowInsertRow to False" asResult[1]
        End_Procedure
    
        {Published = True}
        { Description = "No_Create_State False -> pbAllowAppendRow True + pbAllowInsertRow True (2 lines)" }
        Procedure NoCreateState_False
            String[] asResult
            String   sLine sLower
            Move "    Set No_Create_State to False" to sLine
            Move (Lowercase(Trim(sLine))) to sLower
            Get TranslateGridProperty of oWorker sLine sLower to asResult
            Send AssertIAreEqual 2 (SizeOfArray(asResult))
            Send AssertSAreEqual "    Set pbAllowAppendRow to True" asResult[0]
            Send AssertSAreEqual "    Set pbAllowInsertRow to True" asResult[1]
        End_Procedure
    
        // -----------------------------------------------------------------------
        // No_Delete_State (inverted)
