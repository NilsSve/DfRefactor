//****************************************************************************
// $Module type: Test fixture
// $Module name: oToolTipWrap-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-08
//
// Description : Unit tests for RDCWrapToolTipText (RDCToolsLib's cRDCGridToolTip.pkg), which is what
//               actually gives a grid cell tooltip a sensible width. A CodeJock tooltip takes its
//               shape from the LINE BREAKS IN ITS TEXT - that is why the function-selection grid's
//               tooltips are readable, its columns hand back help text that already carries them -
//               so the fix for a one-line rule hint is to wrap the string, not to set a pixel width.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oToolTipWrap is a cTestFixture
        Set psFunctionName to "RDCWrapToolTipText"

        // The longest line of a wrapped string, so a test can assert the width without caring where
        // the breaks fell.
        Function LongestLine String sText Returns Integer
            String[] asLines
            Integer i iMax iLongest

            Move (StrSplitToArray(sText, C_NewLine)) to asLines
            Move (SizeOfArray(asLines) - 1) to iMax
            Move 0 to iLongest
            For i from 0 to iMax
                If (Length(asLines[i]) > iLongest) ;
                    Move (Length(asLines[i])) to iLongest
            Loop
            Function_Return iLongest
        End_Function

        // Text already short enough comes back untouched, with no line break added.
        { Published = True }
        Procedure ToolTipWrap_ShortTextUnchanged
            String sOut

            Move (RDCWrapToolTipText("Use the Length() function.", 50)) to sOut
            Send AssertSAreEqual "Use the Length() function." sOut
            Send AssertIAreEqual 0 (Pos(C_NewLine, sOut))
        End_Procedure

        // THE CASE THAT STARTED THIS: a real rule hint, one long sentence, no line breaks of its own.
        { Published = True }
        Procedure ToolTipWrap_LongHintWrapsWithinTheWidth
            String sHint sOut
            Integer iLongest

            Move "Use 'Define name for value'. The converter takes literal values and leaves a TODO with the reason on the rest." to sHint
            Send Assert (Length(sHint) > 100)
            Move (RDCWrapToolTipText(sHint, 50)) to sOut
            Get LongestLine sOut to iLongest
            Send Assert (iLongest <= 50)
            Send Assert (Pos(C_NewLine, sOut) > 0)
        End_Procedure

        // Wrapping must not lose or invent a word: strip the breaks back out and the text returns.
        { Published = True }
        Procedure ToolTipWrap_NoTextIsLostOrAdded
            String sHint sOut sBack

            Move "Set only by the legacy string COMMANDS, so a read after a converted command is stale and the converter rewrites it." to sHint
            Move (RDCWrapToolTipText(sHint, 40)) to sOut
            Move (Replaces(C_NewLine, sOut, " ")) to sBack
            Send AssertSAreEqual sHint sBack
        End_Procedure

        // Line breaks the author put in are kept, and each of their lines is wrapped in turn.
        { Published = True }
        Procedure ToolTipWrap_ExistingBreaksAreKept
            String sIn sOut
            String[] asLines

            Move ("First line." + C_NewLine + "Second line.") to sIn
            Move (RDCWrapToolTipText(sIn, 50)) to sOut
            Move (StrSplitToArray(sOut, C_NewLine)) to asLines
            Send AssertIAreEqual 2 (SizeOfArray(asLines))
            Send AssertSAreEqual "First line."  asLines[0]
            Send AssertSAreEqual "Second line." asLines[1]
        End_Procedure

        // A stored escape becomes a real break, the same conversion SelectFunctionsFT.vw does.
        { Published = True }
        Procedure ToolTipWrap_StoredEscapesBecomeRealBreaks
            String sIn sOut
            String[] asLines

            Move ("First line." + Character(92) + "r" + Character(92) + "n" + "Second line.") to sIn
            Move (RDCWrapToolTipText(sIn, 50)) to sOut
            Move (StrSplitToArray(sOut, C_NewLine)) to asLines
            Send AssertIAreEqual 2 (SizeOfArray(asLines))
            Send AssertSAreEqual "Second line." asLines[1]
        End_Procedure

        // A word longer than the width is left whole - a path or an identifier is more use unbroken
        // than sliced in half.
        { Published = True }
        Procedure ToolTipWrap_OverlongWordIsNotCut
            String sIn sOut

            Move "See ChangeStrMarkToExpressionAndAlsoTheOtherOneWithAVeryLongName now" to sIn
            Move (RDCWrapToolTipText(sIn, 20)) to sOut
            Send Assert (sOut contains "ChangeStrMarkToExpressionAndAlsoTheOtherOneWithAVeryLongName")
        End_Procedure

        // Degenerate input must not throw or mangle: empty text, and a width too small to be meant.
        { Published = True }
        Procedure ToolTipWrap_EmptyAndSillyWidthAreSafe
            String sOut

            Move (RDCWrapToolTipText("", 50)) to sOut
            Send AssertSAreEqual "" sOut
            Move (RDCWrapToolTipText("Some hint text here.", 0)) to sOut
            Send AssertSAreEqual "Some hint text here." sOut
        End_Procedure

        // The shipped width is the one place it is decided.
        { Published = True }
        Procedure ToolTipWrap_ShippedWidthIsFifty
            Send AssertIAreEqual 50 CI_RDCTipWrapChars
        End_Procedure

    End_Object
