Use Windows.pkg
Use cTextEdit.pkg
Use seq_chnl.pkg
Use cRDCButtonDPI.pkg
Use cRDCCheckbox.pkg
Use cFTModalPanel.pkg
Use vWin32fh.pkg
Use RefactorConstants.h.pkg      // the shared constants
Use FTAllWebControlClasses.pkg  // FT: the search bar's web controls, and cFTWebButton - the bottom bar's buttons
Use cFTLocalWebControlHost.pkg    // FT: hosts the search bar in this modal panel
Use cFTGridHost.pkg               // FT: the button bar - one host on a grid of 8 px columns (RDCFlexTron)
Use FTMarkupBuilders.pkg         // the HTML vocabulary - OpenHtml, IconLabel, the builders
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

Object oEngineLogFile_dg is a cFTModalPanel
    Set Size to 269 624
    Set Label to "Refactor - Engine Logfile"
    Set piMinSize to 89 211
    Set Location to 2 2
    Set Icon to "OpenLogFile.ico"

    Property String psLogFileName ""
    Property Integer piCurrentMatch 0
    Property Integer piTotalMatches 0
    // FT: the search needle + match-case live here, synced from the web search controls'
    // change events so UpdateMatchCount / DoFindNext (called from web events AND native
    // On_Keys) read a property, never the controls directly.
    Property String  psSearchNeedle ""
    Property Boolean pbMatchCase    False

    // FT search toolbar: Find (cFTWebForm) + Find Next (cFTWebButton) + Match Case (cWebHtmlBox toggle).
    // The needle + match-case sync to psSearchNeedle / pbMatchCase, which UpdateMatchCount / DoFindNext read.
    // The status field (oFindStatus_tb) stays NATIVE - it's set from web events AND native On_Keys (F3),
    // and a native label sets cleanly from both (a web label could not). The search runs directly in the
    // web events: no modals (so no err 4410), and reading / SetSel-ing the native editor from a web event
    // is the same move the BackupFiles select buttons already proved. Location/Size is a FIRST CUT.
    Object oWebSearchBar is a cFTLocalWebControlHost
        Set Location to 8 46
        Set Size to 18 386
        Set peAnchors to anTopLeft
        Set piColumnCount to 14

        Object oWebSearch_wf is a cFTWebForm
            Set piColumnSpan  to 7
            Set psLabel to "Find:"
            Set psToolTip to "Text to search for in the log (Find Next / F3 to jump to the next match)."
            // Sync the needle to psSearchNeedle and refresh the match count on each change.
            Procedure OnChange String sNewValue String sOldValue
                Forward Send OnChange sNewValue sOldValue
                Set psSearchNeedle of (oEngineLogFile_dg(Self)) to sNewValue
                Send UpdateMatchCount of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object

        Object oWebFindNext_btn is a cFTWebButton
            Set piColumnIndex to 7
            Set piColumnSpan  to 3
            Set psCSSClass to "FtFixedBtn"      // natural width (application.css) - don't stretch to fill
            Set psCaption to "Find Next"
            Set psToolTip to "Find the next occurrence of the search text (F3)"
            Procedure OnClick
                Send DoFindNext of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object

        // Match Case as a cWebHtmlBox checkbox (the native cRDCCheckbox label was unreadable on dark).
        Function MatchCaseHtml Returns String
            String sHtml sCls sGlyph
            Boolean bOn

            Get pbMatchCase of (oEngineLogFile_dg(Self)) to bOn
            If (bOn = True) Begin
                Move "cbrow on" to sCls
                Move CS_Check to sGlyph
            End
            Else Begin
                Move "cbrow" to sCls
                Move "" to sGlyph
            End
            Move (CS_PaletteCssLink + CS_PageFitCssLink + CssLink("enginelogfile")) to sHtml
            Move (sHtml + (ClickableHtml("div", (sCls), "toggle", "", ((SpanOpen("cbbox")) + sGlyph + (CS_SpanEnd + 'Match case')), "Match the upper/lower case of the search text."))) to sHtml
            Function_Return sHtml
        End_Function

        Object oWebMatchCase_htm is a cFTWebHtmlBox
            Set piColumnIndex to 10
            Set piColumnSpan  to 4
            Set pbFillHeight to True      // fill the toolbar row so the checkbox centres vertically (was top-aligned)
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse. It is the string the runtime seeds (dumped by the cFTWebHtmlBox design
            // dump, no workspace loaded); the runtime expression sits in End_Construct_Object below.
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="RDCFlexTron/pagefit.css">
            <link rel="stylesheet" href="CssStyle/enginelogfile.css">
            <div class="cbrow" data-ServerOnClick="toggle" title="Match the upper/lower case of the search text."><span class="cbbox"></span>Match case</div>
            """

            // RUNTIME content - here rather than in the object body, so the Designer keeps the literal above.
            Procedure End_Construct_Object
                Forward Send End_Construct_Object
                Set psHtml to (MatchCaseHtml(Self))
            End_Procedure
            Procedure OnClick String sId String sParam
                Boolean b
                Get pbMatchCase of (oEngineLogFile_dg(Self)) to b
                Set pbMatchCase of (oEngineLogFile_dg(Self)) to (not(b))
                Send PushHtml of Self (MatchCaseHtml(Self))
                Send UpdateMatchCount of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object
    End_Object

    Object oFindStatus_tb is a TextBox
        Set Size to 9 174
        Set Location to 16 436
        Set Label to ""
        Set peAnchors to anTopLeft
    End_Object

    // Don't use cRichEdit as we want to save the output
    // as a .txt file.
    Object oEngineLogFile_edt is a cTextEdit
        Set Size to 208 603
        Set Location to 32 11
        Set TextColor to clBlack
        Set peAnchors to anAll
        Set Label_Row_Offset to 3
        Set Label_FontItalics to True
        Set piFontSize to 200
        Set psTypeFace to 'Consolas'
        Set Color to clEditorBackGround
        Set Label_TextColor to clStatusBarColor
        Set TextColor to clAlternateRowBgColor

        Procedure DoSaveDocument
            Boolean bChanged

            Get pbCanUndo to bChanged
            If (bChanged = False) Begin
                Procedure_Return
            End

            // clear undo buffer on save
            // we want undo buffer to only apply to the new document
            Send ClearUndoBuffer
            Send FTInfoBox "Changes saved."
        End_Procedure

        Procedure WriteData
            String sLogFileName
            Get psLogFileName to sLogFileName
            Send Write sLogFileName
        End_Procedure
            
        Procedure LoadData
            String sLogFileName
            Integer iError

            Get psLogFileName to sLogFileName
            Send Read sLogFileName
            Get LastErrorCode to iError
            If (iError = ERR_RE_Cannot_Open_File) Begin
                Send FTInfoBox ("Could not read the logfile:" * String(sLogFileName))
            End
        End_Procedure
        
        // Sets the current line to iLine and highlights it
        Procedure SelectRow Integer iLine
            Integer iPos iLen
            Get FirstCharInLinePos iLine to iPos
            Get LineLength iLine to iLen
            Send SetSel iPos (iPos + iLen)
        End_Procedure
        
        // Get the current selected Line
        Function SelectedRow Returns Integer
            Integer iLine
            Get LineFromChar -1 to iLine
            Function_Return iLine
        End_Function
        
        // This makes copying text from the dialog very difficult and was commented out:
        // Select the current row
//        Procedure Mouse_Up Handle hCell Integer iPos  
//            Integer iLine
//            Get SelectedRow to iLine
//            Send SelectRow iLine
//        End_Procedure
   
        Procedure Down_Row
            Integer iLine
            Get SelectedRow to iLine
            Increment iLine
            Send SelectRow iLine
        End_Procedure
        
        Procedure Up_Row
            Integer iLine
            Get SelectedRow to iLine
            Decrement iLine
            Send SelectRow iLine
        End_Procedure
        
        Procedure Page Integer iPageObject
            Forward Send Page iPageObject
        End_Procedure

        Procedure DisplayCurrentSourceLine
        End_Procedure   
        
        Procedure Mouse_Click
        End_Procedure

        On_Key Key_Ctrl+Key_S Send DoSaveDocument
        On_Key kCancel Send Cancel  
        On_Key kEnter  Send DisplayCurrentSourceLine
        On_Key Key_Ctrl+Key_A Send Select_All
    End_Object

    /* THE BUTTON BAR: one grid host of 8 px columns and four framework buttons (cFTWebButton, RDCFlexTron), as in
       ShowOtherLogFilesFT.dg. A button's work runs in OnButtonClick, after the web click has returned (the
       library's click relay), so the Yes/No box and Close_Panel can run there - no timer of this dialog's own.
       Column 0 takes the rest of the width, so the buttons keep to the right edge. Each is 11 columns (78 px),
       which fits every caption (Clear Log ~72 px, To Top ~57, To Bottom ~77, Close ~72, measured 2026-09-30)
       and keeps the short To Top as wide as its neighbours. Until then this bar was HTML chips
       (BarButtonHtml) with a click-id OnClick and a 1 ms defer timer. */
    Object oWebBottomBar is a cFTGridHost
        Set Location to 243 254
        Set Size to 20 360
        Set peAnchors to anBottomRight
        Set piColumnCount to 45         // column 0, then four buttons of 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oClearLogBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Clear Log"
            Set psToolTip to "Delete all content of this log file."

            Procedure OnButtonClick
                Send DoClearLog of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object

        Object oToTopBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 11
            Set psCaption to "To Top"
            Set psToolTip to "Jump to the top of the log."

            Procedure OnButtonClick
                Send DoToTop of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object

        Object oToBottomBtn is a cFTWebButton
            Set piColumnIndex to 23
            Set piColumnSpan to 11
            Set psCaption to "To Bottom"
            Set psToolTip to "Jump to the bottom of the log."

            Procedure OnButtonClick
                Send DoToBottom of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piColumnIndex to 34
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"
            Set psToolTip to "Close this dialog."

            Procedure OnButtonClick
                Send DoClose of (oEngineLogFile_dg(Self))
            End_Procedure
        End_Object
    End_Object

    // To Top (was oFirstRun_btn.OnClick), run from the To Top button's OnButtonClick - scrolls the native editor.
    Procedure DoToTop
        Send Beginning_of_Data to oEngineLogFile_edt
    End_Procedure

    // To Bottom (was oLatestRun_btn.OnClick), run from the To Bottom button's OnButtonClick.
    Procedure DoToBottom
        Send End_of_Data to oEngineLogFile_edt
    End_Procedure

    // Clear Log (was oClearLog_btn.OnClick), run from the Clear Log button's OnButtonClick, after the web click.
    // YesNo, then wipe + write the file.
    Procedure DoClearLog
        Handle ho
        Integer iRetval
        Get FTYesNoBox "Are you sure you want to delete all content of this log file?" to iRetval
        If (iRetval <> MBR_Yes) Begin
            Procedure_Return
        End
        Move (oEngineLogFile_edt(Self)) to ho
        Send Delete_Data of ho
        Set Changed_State of ho to True
        Send WriteData of ho
    End_Procedure

    // Close (was oCancel_Btn.OnClick), from the Close button's OnButtonClick and from Alt+C. Both run inside
    // the modal's own message pump, so Close_Panel cleanly ends the modal loop.
    Procedure DoClose
        Send Close_Panel
    End_Procedure

    // Automatically load data into the grid when activating.
    Procedure Activating
        Handle ho  
        String sLogFileName
        
        Forward Send Activating
        Move (oEngineLogFile_edt(Self)) to ho
        Send LoadData    of ho
        // We need to active before we can send end_of_data.
        Send Activate    of ho
        Send End_of_Data to ho
        Send Up_Row of ho
        //Send Up_Row of ho
        Get psLogFileName to sLogFileName
        Set StatusText of (Statusbar_Id(Self)) to sLogFileName
    End_Procedure

    Procedure FocusSearch
        Send Activate of oWebSearch_wf
    End_Procedure

    Procedure UpdateMatchCount
        String sNeedle sHaystack
        Integer iPos iOffset iCount iLen
        Boolean bMatchCase

        Get psSearchNeedle to sNeedle
        Set piCurrentMatch to 0
        If (sNeedle = "") Begin
            Set piTotalMatches to 0
            Set Label of oFindStatus_tb to ""
            Procedure_Return
        End

        Get Value of oEngineLogFile_edt to sHaystack
        // Match the CR-stripping done in DoFindNext so the counting traverses
        // the same logical buffer (matters only for needles that contain a CR;
        // the count for normal text is unaffected either way).
        Move (Replaces(Character(13), sHaystack, "")) to sHaystack
        Get pbMatchCase to bMatchCase
        If (not(bMatchCase)) Begin
            Move (Uppercase(sHaystack)) to sHaystack
            Move (Uppercase(sNeedle))   to sNeedle
        End

        Move (Length(sNeedle)) to iLen
        Move 0 to iCount
        Move 1 to iOffset
        Repeat
            Move (Pos(sNeedle, sHaystack, iOffset)) to iPos
            If (iPos > 0) Begin
                Increment iCount
                Move (iPos + iLen) to iOffset
            End
        Until (iPos = 0)

        Set piTotalMatches to iCount
        If (iCount = 0) Begin
            Set Label of oFindStatus_tb to "No matches"
        End
        Else Begin
            Set Label of oFindStatus_tb to (String(iCount) * "matches")
        End
    End_Procedure

    Procedure DoFindNext
        String sNeedle sHaystack sNeedleSearch sHaystackSearch
        Integer iSelEnd iFoundPos iLen iIndex iTotal iScanOffset iScanPos
        Boolean bMatchCase bWrapped
        Handle hoEdit

        Get psSearchNeedle to sNeedle
        If (sNeedle = "") Begin
            Send Activate of oWebSearch_wf
            Procedure_Return
        End

        Move (oEngineLogFile_edt(Self)) to hoEdit
        Get Value  of hoEdit to sHaystack
        // cTextEdit's Value returns the buffer with CR+LF line breaks,
        // but SetSel/SelEnd count each line break as a single character.
        // Strip the CRs so Pos offsets align with editor positions -- otherwise
        // the highlight drifts forward by 1 char per line break before the match.
        Move (Replaces(Character(13), sHaystack, "")) to sHaystack
        Get SelEnd of hoEdit to iSelEnd

        Get pbMatchCase to bMatchCase
        If (not(bMatchCase)) Begin
            Move (Uppercase(sHaystack)) to sHaystackSearch
            Move (Uppercase(sNeedle))   to sNeedleSearch
        End
        Else Begin
            Move sHaystack to sHaystackSearch
            Move sNeedle   to sNeedleSearch
        End

        // Pos is 1-based; SelEnd is 0-based; (iSelEnd + 1) starts the
        // next search at the character right after the current selection.
        Move (Pos(sNeedleSearch, sHaystackSearch, iSelEnd + 1)) to iFoundPos
        Move False to bWrapped
        If (iFoundPos = 0) Begin
            // No match below cursor -- wrap to top of buffer.
            Move (Pos(sNeedleSearch, sHaystackSearch)) to iFoundPos
            If (iFoundPos = 0) Begin
                Set Label of oFindStatus_tb to "Not found"
                Set piCurrentMatch to 0
                Send Activate of oWebSearch_wf
                Procedure_Return
            End
            Move True to bWrapped
        End

        Move (Length(sNeedle)) to iLen
        // Pos result is 1-based; SetSel uses 0-based half-open positions.
        Send SetSel of hoEdit (iFoundPos - 1) (iFoundPos - 1 + iLen)

        // Walk the buffer to compute total + current 1-based match index,
        // so the status is accurate even after the search term or Match Case changed.
        Move 0 to iIndex
        Move 0 to iTotal
        Move 1 to iScanOffset
        Repeat
            Move (Pos(sNeedleSearch, sHaystackSearch, iScanOffset)) to iScanPos
            If (iScanPos > 0) Begin
                Increment iTotal
                If (iScanPos = iFoundPos) Begin
                    Move iTotal to iIndex
                End
                Move (iScanPos + iLen) to iScanOffset
            End
        Until (iScanPos = 0)

        Set piCurrentMatch to iIndex
        Set piTotalMatches to iTotal
        If (bWrapped) Begin
            Set Label of oFindStatus_tb to ("Match" * String(iIndex) * "of" * String(iTotal) * "(wrapped)")
        End
        Else Begin
            Set Label of oFindStatus_tb to ("Match" * String(iIndex) * "of" * String(iTotal))
        End
    End_Procedure

    On_Key Key_Alt+Key_F  Send DoToTop          // was KeyAction of oFirstRun_btn (now a web button)
    On_Key Key_Alt+Key_L  Send DoToBottom       // was KeyAction of oLatestRun_btn (now a web button)
    On_Key Key_Alt+Key_C  Send DoClose          // was KeyAction of oCancel_Btn (now a web button)
    On_Key Key_Alt+Key_N  Send DoFindNext          // was KeyAction of oFindNext_btn (now a web button)
    On_Key Key_Ctrl+Key_F Send FocusSearch
    On_Key Key_F3         Send DoFindNext
    On_Key Key_Ctrl+Key_S Send DoSaveDocument of oEngineLogFile_edt
End_Object

// Public access method:
Procedure ActivateEngineLogFile String sLogFile
    Handle ho
    Boolean bExists

    Get vFilePathExists sLogFile to bExists
    If (bExists = False) Begin
        Send FTInfoBox "The logfile doesn't exist."
        Procedure_Return
    End
    Move (oEngineLogFile_dg(Self)) to ho
    Set psLogFileName of ho to sLogFile
    Send Popup of ho
End_Procedure
