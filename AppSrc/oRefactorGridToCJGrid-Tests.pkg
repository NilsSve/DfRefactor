        {Published = True}
        { Description = "Procedure with conditional non-standard Send Add_Item (e.g. `Send Add_Item 0 X`, not Msg_None) is NOT converted to TheData; original lines stay intact" }
        Procedure NonStandardAddItem_NotConverted
            // Popup-populator pattern (e.g. pval.DG's FillValueList): conditional
            // Send Add_Item calls inside multiple If branches, using `0` as the
            // first arg instead of Msg_None. ParseAddItemValue can't extract a
            // value from these, so the old behaviour emitted broken
            // `Move  to TheData[iRow].sValue[iCol1]` lines. PreScanForDataLoadProc
            // now detects the non-standard form and clears the data-load mark so
            // the body conversion is skipped.
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bBroken bAddItemKept

            Move "Object oGrid1 is a Grid"                    to asInput[0]
            Move "    Set Form_Width 0 to 100"                to asInput[1]
            Move "    Procedure FillValueList Integer iType"  to asInput[2]
            Move "        If (iType=1) Begin"                 to asInput[3]
            Move '            Send Add_Item 0 "A"'            to asInput[4]
            Move "        End"                                to asInput[5]
            Move "        If (iType=2) Begin"                 to asInput[6]
            Move '            Send Add_Item 0 "B"'            to asInput[7]
            Move "        End"                                to asInput[8]
            Move "    End_Procedure"                          to asInput[9]
            Move "End_Object"                                 to asInput[10]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bBroken
            Move False to bAddItemKept
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                // No broken empty-value Move TheData line.
                If (asOutput[iIdx] contains "Move  to TheData") Move True to bBroken
                // Original Send Add_Item lines are preserved.
                If (asOutput[iIdx] contains "Send Add_Item 0") Move True to bAddItemKept
            Loop
            Send Assert (bBroken = False and bAddItemKept = True)
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oInProcedureGuard - a grid declared INSIDE a Procedure body (e.g. a class's
    // Construct_Object) must NOT get a generated Procedure LoadData/Activating, which
    // would nest a procedure inside a procedure (illegal). It is still converted, with a
    // TODO in place of the stubs. (Nils 2026-06-11; needs a real multi-line scope - a
    // single-line Object can't reproduce the bug.)
    // -----------------------------------------------------------------------
    Object oInProcedureGuard is a cTestFixture
        Set psFunctionName to "InProcedureGuard (cGridToCJGrid)"

        Object oWorker is a cGridToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform String[] asInput Returns String[]
            String[] asResult
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asResult
            Function_Return asResult
        End_Function

        Function OutputContains String[] asOut String sNeedle Returns Boolean
            Integer iIdx
            For iIdx from 0 to (SizeOfArray(asOut) - 1)
                If (Lowercase(asOut[iIdx]) contains Lowercase(sNeedle)) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // True only if a line is an ACTUAL procedure DECLARATION "Procedure <name>" (trimmed,
        // case-insensitive) - NOT a comment that merely names it. The in-procedure TODO text
        // mentions "Procedure LoadData", which a bare substring match would wrongly flag.
        Function OutputHasProcDecl String[] asOut String sName Returns Boolean
            Integer iIdx iLen
            String  sTrim sNeedle
            Move (Lowercase("procedure " + sName)) to sNeedle
            Move (Length(sNeedle)) to iLen
            For iIdx from 0 to (SizeOfArray(asOut) - 1)
                Move (Lowercase(Trim(asOut[iIdx]))) to sTrim
                If (Left(sTrim, iLen) = sNeedle) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // Grid inside Construct_Object: converted, but NO Procedure LoadData - TODO instead.
        {Published = True}
        { Description = "Grid in Construct_Object: no nested LoadData, TODO emitted, still converted" }
        Procedure InConstructor_NoLoadData_TodoEmitted
            String[] asInput asOutput
            Boolean  bConverted bLoadData bTodo

            Move "Class cMyThing is a cObject"          to asInput[0]
            Move "    Procedure Construct_Object"       to asInput[1]
            Move "        Forward Send Construct_Object" to asInput[2]
            Move "        Object oGrid1 is a Grid"      to asInput[3]
            Move "            Set Form_Width 0 to 100"  to asInput[4]
            Move "        End_Object"                   to asInput[5]
            Move "    End_Procedure"                    to asInput[6]
            Move "End_Class"                            to asInput[7]

            Get RunTransform asInput to asOutput
            Get OutputContains asOutput "is a ccjgrid"  to bConverted
            Get OutputHasProcDecl asOutput "loaddata"   to bLoadData
            Get OutputContains asOutput "// todo"        to bTodo
            Send Assert bConverted
            Send AssertFalse bLoadData
            Send Assert bTodo
        End_Procedure

        // Regression / happy path: a TOP-LEVEL grid still gets its Procedure LoadData.
        {Published = True}
        { Description = "Top-level grid still generates Procedure LoadData (happy path unchanged)" }
        Procedure TopLevel_StillGeneratesLoadData
            String[] asInput asOutput
            Boolean  bLoadData

            Move "Object oGrid1 is a Grid"          to asInput[0]
            Move "    Set Form_Width 0 to 100"      to asInput[1]
            Move "End_Object"                       to asInput[2]

            Get RunTransform asInput to asOutput
            Get OutputHasProcDecl asOutput "loaddata" to bLoadData
            Send Assert bLoadData
        End_Procedure

        // Two grids in one file - one in a constructor, one top-level: proves the per-grid
        // re-snapshot (a set-once "file has a constructor" flag would get this wrong).
        {Published = True}
        { Description = "Mixed file: constructor grid gets TODO, top-level grid gets LoadData" }
        Procedure MixedFile_PerGridSnapshot
            String[] asInput asOutput
            Boolean  bTodo bLoadData

            Move "Class cMyThing is a cObject"          to asInput[0]
            Move "    Procedure Construct_Object"       to asInput[1]
            Move "        Object oGrid1 is a Grid"      to asInput[2]
            Move "            Set Form_Width 0 to 100"  to asInput[3]
            Move "        End_Object"                   to asInput[4]
            Move "    End_Procedure"                    to asInput[5]
            Move "End_Class"                            to asInput[6]
            Move "Object oGrid2 is a Grid"              to asInput[7]
            Move "    Set Form_Width 0 to 100"          to asInput[8]
            Move "End_Object"                           to asInput[9]

            Get RunTransform asInput to asOutput
            Get OutputContains asOutput "// todo"      to bTodo
            Get OutputHasProcDecl asOutput "loaddata"  to bLoadData
            Send Assert bTodo       // from the constructor-embedded grid
            Send Assert bLoadData   // from the top-level grid
        End_Procedure

    End_Object

