        {Published = True}
        { Description = "Get Value of <grid> (var+N) is converted to Get piColumnId + TheData array access" }
        Procedure GetValue_ConvertedToTheData
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bColId bTheData bOld

            Move "Object oGrid1 is a Grid"                         to asInput[0]
            Move "    Set Form_Width 0 to 100"                     to asInput[1]
            Move "    Set Form_Width 1 to 100"                     to asInput[2]
            Move "    Set Form_Width 2 to 100"                     to asInput[3]
            Move "    Procedure pRead"                             to asInput[4]
            Move "        Integer iItem"                           to asInput[5]
            Move "        String sVal"                             to asInput[6]
            Move "        Get Current_Item to iItem"               to asInput[7]
            Move "        Move (iItem /3 * 3) to iItem"            to asInput[8]
            Move "        Get Value of oGrid1 (iItem + 2) to sVal" to asInput[9]
            Move "    End_Procedure"                               to asInput[10]
            Move "End_Object"                                      to asInput[11]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bColId
            Move False to bTheData
            Move False to bOld
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "get picolumnid of ocol3") Move True to bColId
                If (asOutput[iIdx] contains "TheData[iRow].sValue[iCol]" and ;
                    asOutput[iIdx] contains "sVal") Move True to bTheData
                If (Lowercase(asOutput[iIdx]) contains "get value of") Move True to bOld
            Loop
            Send Assert (bColId and bTheData and bOld = False)
        End_Procedure

        {Published = True}
        { Description = "Full 3-line row-access sequence produces correct cCJGrid pattern" }
        Procedure FullSequence_Converted
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bSelectedRow bTheData bNoCurrentItem bNoNormalise bNoGetValue

            Move "Object oGrid1 is a Grid"                            to asInput[0]
            Move "    Set Form_Width 0 to 100"                        to asInput[1]
            Move "    Set Form_Width 1 to 100"                        to asInput[2]
            Move "    Set Form_Width 2 to 100"                        to asInput[3]
            Move "    Set Form_Width 3 to 0"                          to asInput[4]
            Move "    Procedure pSnooze"                              to asInput[5]
            Move "        Integer iItem iArrayPos"                    to asInput[6]
            Move "        Get Current_Item to iItem"                  to asInput[7]
            Move "        Move (iItem /4 * 4) to iItem"               to asInput[8]
            Move "        Get Value of oGrid1 (iItem + 3) to iArrayPos" to asInput[9]
            Move "    End_Procedure"                                  to asInput[10]
            Move "End_Object"                                         to asInput[11]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bSelectedRow
            Move False to bTheData
            Move True  to bNoCurrentItem
            Move True  to bNoNormalise
            Move True  to bNoGetValue
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "get selectedrow")           Move True  to bSelectedRow
                // iItem is renamed to iRow; column offset 3 -> oCol4 -> iCol (generic)
                If (asOutput[iIdx] contains "TheData[iRow].sValue[iCol]" and ;
                    asOutput[iIdx] contains "iArrayPos")                            Move True  to bTheData
                If (Lowercase(asOutput[iIdx]) contains "get current_item")          Move False to bNoCurrentItem
                If (Lowercase(asOutput[iIdx]) contains "/4 * 4")                    Move False to bNoNormalise
                If (Lowercase(asOutput[iIdx]) contains "get value of")              Move False to bNoGetValue
            Loop
            Send Assert (bSelectedRow and bTheData and bNoCurrentItem and bNoNormalise and bNoGetValue)
        End_Procedure

        // A method that addresses cells by ITEM ARITHMETIC ('(i * iColumns) + N') with no Get
        // Current_Item anchor - and writes cells via Set Value, which has no handler - must be
        // DECLINED whole: signature + note + body verbatim. The old behavior half-converted the
        // GET side into undeclared TheData/iCol references with an item-index used as a row index
        // (LegacyApp Sublager_multi UpdateBalances, Nils 2026-07-25).
        {Published = True}
        { Description = "Item-arithmetic cell access without Current_Item is declined verbatim with a note" }
        Procedure ItemArithmeticMethod_DeclinedVerbatim
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bNote bGetKept bSetKept bNoTheData

            Move "Object oGrid1 is a Grid"                                         to asInput[0]
            Move "    Set Form_Width 0 to 100"                                     to asInput[1]
            Move "    Set Form_Width 1 to 100"                                     to asInput[2]
            Move "    Procedure UpdateTotals"                                      to asInput[3]
            Move "        Integer i iColumns iTotalItems"                          to asInput[4]
            Move "        String sItemId"                                          to asInput[5]
            Move "        Get Line_Size of oGrid1 to iColumns"                     to asInput[6]
            Move "        Get Item_Count of oGrid1 to iTotalItems"                 to asInput[7]
            Move "        For i from 0 to (iTotalItems / iColumns - 1)"            to asInput[8]
            Move "            Get Value of oGrid1 ((i * iColumns) + 1) to sItemId" to asInput[9]
            Move '            Set Value of oGrid1 ((i * iColumns) + 5) to "-"'     to asInput[10]
            Move "        Loop"                                                    to asInput[11]
            Move "    End_Procedure"                                               to asInput[12]
            Move "End_Object"                                                      to asInput[13]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bNote
            Move False to bGetKept
            Move False to bSetKept
            Move True  to bNoTheData
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "DFRefactor: NOT converted")                           Move True to bNote
                If (asOutput[iIdx] contains "Get Value of oGrid1 ((i * iColumns) + 1) to sItemId") Move True to bGetKept
                If (asOutput[iIdx] contains 'Set Value of oGrid1 ((i * iColumns) + 5) to "-"')     Move True to bSetKept
                If (asOutput[iIdx] contains "TheData[(i")                                          Move False to bNoTheData
            Loop
            Send Assert (bNote and bGetKept and bSetKept and bNoTheData)
        End_Procedure

        // A 'Procedure Set <name> <params>' SETTER holding the Send Add_Items cannot take the
        // LoadData rename: ParseProcFuncName's first word is 'set', so the rename emitted the
        // mangled 'Procedure LoadData Totals Number ...' while Activating's bare Send LoadData
        // dropped the arguments and the old Set-callers dangled (LegacyApp jobblista1,
        // Nils 2026-07-25). Such a loader is declined verbatim with the note; the grid still
        // gets the stub LoadData showing the pattern to port into.
        {Published = True}
        { Description = "A Procedure Set data loader is declined verbatim; the stub LoadData still appears" }
        Procedure SetterDataLoader_DeclinedVerbatim
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bSigKept bNote bAddKept bNoMangle bStub

            Move "Object oGrid1 is a Grid"                                to asInput[0]
            Move "    Set Form_Width 0 to 100"                            to asInput[1]
            Move "    Set Form_Width 1 to 100"                            to asInput[2]
            Move "    Procedure Set Totals Number nAmount Number nHours"  to asInput[3]
            Move "        Send Delete_Data"                               to asInput[4]
            Move "        Send Add_Item Msg_None nAmount"                 to asInput[5]
            Move "        Send Add_Item Msg_None nHours"                  to asInput[6]
            Move "    End_Procedure"                                      to asInput[7]
            Move "End_Object"                                             to asInput[8]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bSigKept
            Move False to bNote
            Move False to bAddKept
            Move True  to bNoMangle
            Move False to bStub
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Procedure Set Totals Number nAmount Number nHours") Move True to bSigKept
                If (asOutput[iIdx] contains "DFRefactor: NOT converted")                         Move True to bNote
                If (asOutput[iIdx] contains "Send Add_Item Msg_None nAmount")                    Move True to bAddKept
                If (asOutput[iIdx] contains "LoadData Totals")                                   Move False to bNoMangle
                If (Lowercase(asOutput[iIdx]) contains "procedure loaddata")                     Move True to bStub
            Loop
            Send Assert (bSigKept and bNote and bAddKept and bNoMangle and bStub)
        End_Procedure

        // Two defects from the LegacyApp Sublager_clear_order replay (Nils 2026-07-25):
        // (1) a dynamic 'Set Header_Label N to ...' INSIDE a method body was collected as a
        //     column caption - clobbering the real caption with "" - and re-armed the pending-
        //     columns flush, DUPLICATING every column object;
        // (2) renaming the fill procedure to LoadData left its EXTERNAL callers dangling
        //     ('Send FillList of (oGrid1(Self))' still targeting the vanished name).
        {Published = True}
        { Description = "Dynamic Header_Label in a body neither clobbers nor duplicates columns; external callers follow the LoadData rename" }
        Procedure DynamicHeaderAndExternalCaller
            String[] asInput asOutput
            Integer  iGrids iIdx iCol1Count iCaptionCount
            Boolean  bBodySetKept bCallerRenamed bNoOldCaller

            Move "Object oGrid1 is a Grid"                     to asInput[0]
            Move "    Set Form_Width 0 to 32"                  to asInput[1]
            Move '    Set Header_Label 0 to "Pick"'            to asInput[2]
            Move "    Set Form_Width 1 to 65"                  to asInput[3]
            Move '    Set Header_Label 1 to "Name"'            to asInput[4]
            Move "    Procedure Delete_Data"                   to asInput[5]
            Move "        Forward Send Delete_Data"            to asInput[6]
            Move '        Set Header_Label 1 to ""'            to asInput[7]
            Move "    End_Procedure"                           to asInput[8]
            Move "    Procedure FillList"                      to asInput[9]
            Move '        Send Add_Item Msg_None "x"'          to asInput[10]
            Move '        Send Add_Item Msg_None "y"'          to asInput[11]
            Move "    End_Procedure"                           to asInput[12]
            Move "End_Object"                                  to asInput[13]
            Move "Send FillList of (oGrid1(Self))"             to asInput[14]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move 0 to iCol1Count
            Move 0 to iCaptionCount
            Move False to bBodySetKept
            Move False to bCallerRenamed
            Move True  to bNoOldCaller
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Object oCol1 is a cCJGridColumn") Increment iCol1Count
                If (asOutput[iIdx] contains 'Set psCaption to "Name"')         Increment iCaptionCount
                If (asOutput[iIdx] contains 'Set Header_Label 1 to ""')        Move True to bBodySetKept
                If (asOutput[iIdx] contains "Send LoadData of (oGrid1(Self))") Move True to bCallerRenamed
                If (asOutput[iIdx] contains "Send FillList")                   Move False to bNoOldCaller
            Loop
            Send AssertIAreEqual 1 iCol1Count
            Send AssertIAreEqual 1 iCaptionCount
            Send Assert (bBodySetKept and bCallerRenamed and bNoOldCaller)
        End_Procedure

        {Published = True}
        { Description = "A FUNCTION with Get Current_Item gets var injection, not a TODO comment" }
        // The var-injection prescan and armer keyed on "procedure " only, so a Get Current_Item
        // inside a FUNCTION fell to the TODO-comment fallback and emitted code referencing
        // hoDataSource/TheData without declaring them - 32 post-plan compile errors on the
        // LegacyApp replay (Nils 2026-07-23, the CurrentEulaKey shape).
        Procedure FunctionMethod_VarInjection_NoTodo
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bHandle bTheData bSelectedRow bNoTodo

            Move "Object oGrid1 is a Grid"                            to asInput[0]
            Move "    Set Form_Width 0 to 100"                        to asInput[1]
            Move "    Set Form_Width 1 to 100"                        to asInput[2]
            Move "    Set Form_Width 2 to 100"                        to asInput[3]
            Move "    Function fCurrentKey Returns String"            to asInput[4]
            Move "        Integer iItem"                              to asInput[5]
            Move "        String sValue"                              to asInput[6]
            Move "        Get Current_Item to iItem"                  to asInput[7]
            Move "        Move (iItem /3 * 3) to iItem"               to asInput[8]
            Move "        Get Value of oGrid1 (iItem + 1) to sValue"  to asInput[9]
            Move "        Function_Return sValue"                     to asInput[10]
            Move "    End_Function"                                   to asInput[11]
            Move "End_Object"                                         to asInput[12]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bHandle
            Move False to bTheData
            Move False to bSelectedRow
            Move True  to bNoTodo
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Handle hoDataSource")        Move True  to bHandle
                If (asOutput[iIdx] contains "tDataSourceRow[] TheData")   Move True  to bTheData
                If (Lowercase(asOutput[iIdx]) contains "get selectedrow") Move True  to bSelectedRow
                If (asOutput[iIdx] contains "TODO: Add to var decls")     Move False to bNoTodo
            Loop
            Send Assert (bHandle and bTheData and bSelectedRow and bNoTodo)
        End_Procedure

        {Published = True}
        { Description = "Var decls injected: iRow/iCol/Handle/tDataSourceRow[], no TODO, iItem renamed to iRow" }
        Procedure CurrentItem_VarDecls_Injected
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bHandle bTheData bIRow bColId bNoTodo bNoOldName

            Move "Object oGrid1 is a Grid"                           to asInput[0]
            Move "    Set Form_Width 0 to 100"                       to asInput[1]
            Move "    Procedure pGetRow"                             to asInput[2]
            Move "        Integer iItem"                             to asInput[3]
            Move "        Get Current_Item to iItem"                 to asInput[4]
            Move "        Get Value of oGrid1 (iItem + 0) to sName" to asInput[5]
            Move "    End_Procedure"                                 to asInput[6]
            Move "End_Object"                                        to asInput[7]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bHandle
            Move False to bTheData
            Move False to bIRow
            Move False to bColId
            Move True  to bNoTodo
            Move True  to bNoOldName    // stays True if iItem does not appear in active code
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "handle hodatasource")      Move True  to bHandle
                If (Lowercase(asOutput[iIdx]) contains "tdatasourcerow[] thedata") Move True  to bTheData
                If (Lowercase(asOutput[iIdx]) contains "integer" and ;
                    Lowercase(asOutput[iIdx]) contains "irow")                     Move True  to bIRow
                If (Lowercase(asOutput[iIdx]) contains "get picolumnid of ocol1")  Move True  to bColId
                If (Lowercase(asOutput[iIdx]) contains "todo" and ;
                    Lowercase(asOutput[iIdx]) contains "var decls")                Move False to bNoTodo
                // iItem must not appear in any active (non-commented) output line.
                If (Lowercase(asOutput[iIdx]) contains "iitem" and ;
                    Left(Trim(Lowercase(asOutput[iIdx])), 2) <> "//")              Move False to bNoOldName
            Loop
            Send Assert (bHandle and bTheData and bIRow and bColId and bNoTodo and bNoOldName)
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oTrailingWhitespaceIndent
    //   Regression tests for the indent-math bug where Length(sLine)-Length(Trim(sLine))
    //   was used to compute indent length.  Trim strips BOTH ends, so any source line
    //   with trailing whitespace caused the "indent" to grab part of the line content,
    //   producing corrupted output like "    If (// If (cond) Send cmd args".
    //   Fix: a GetIndent helper that uses LTrim (leading-only) is used everywhere
    //   instead of the open-coded Length-Trim arithmetic.
    // -----------------------------------------------------------------------
    Object oTrailingWhitespaceIndent is a cTestFixture
        Set psFunctionName to "TrailingWhitespaceIndent (cGridToCJGrid)"

        Object oWorker is a cGridToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        // -----------------------------------------------------------------------
        // GetIndent direct unit tests
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "GetIndent returns the leading whitespace for a normal line" }
        Procedure GetIndent_LeadingSpaces
            String sResult
            Get GetIndent of oWorker "    If (a) b"  to sResult
            Send AssertSAreEqual "    " sResult
        End_Procedure

        {Published = True}
        { Description = "GetIndent returns leading whitespace only, NOT trailing whitespace" }
        Procedure GetIndent_IgnoresTrailingWhitespace
            String sResult
            // 4 leading spaces + "If (a) b" + 4 trailing spaces.
            // The old (buggy) math returned 8 chars ("    If (").  The fix returns 4.
            Get GetIndent of oWorker "    If (a) b    " to sResult
            Send AssertSAreEqual "    " sResult
        End_Procedure

        {Published = True}
        { Description = "GetIndent returns empty string for a line with no indent" }
        Procedure GetIndent_NoIndent
            String sResult
            Get GetIndent of oWorker "End_Procedure" to sResult
            Send AssertSAreEqual "" sResult
        End_Procedure

        {Published = True}
        { Description = "GetIndent returns empty string for an empty string" }
        Procedure GetIndent_EmptyString
            String sResult
            Get GetIndent of oWorker "" to sResult
            Send AssertSAreEqual "" sResult
        End_Procedure

        // -----------------------------------------------------------------------
        // CommentOutLine direct unit tests
        // -----------------------------------------------------------------------

        // Column-1 style (Nils 2026-07-05): the '//' goes FIRST and the original line - indentation
        // AND trailing whitespace included - is preserved verbatim after it. The old indent-math
        // corruption ("If (// If (...") cannot recur: there is no indent math at all any more.
        {Published = True}
        { Description = "CommentOutLine prepends // at column 1; the indented line follows verbatim" }
        Procedure CommentOutLine_PreservesIndent
            String sResult
            Get CommentOutLine of oWorker "    Set Main_File to Orders" to sResult
            Send AssertSAreEqual "//    Set Main_File to Orders" sResult
        End_Procedure

        {Published = True}
        { Description = "CommentOutLine keeps a line WITH trailing whitespace verbatim (regression)" }
        Procedure CommentOutLine_TrailingWhitespace_NoCorruption
            String sResult sExpected
            // Source has 4 trailing spaces. The historic bug produced "    If (// If (a <> b) Send c d";
            // the column-1 style keeps the whole line verbatim behind the marker.
            Get CommentOutLine of oWorker "    If (a <> b) Send c d    " to sResult
            Move "//    If (a <> b) Send c d    " to sExpected
            Send AssertSAreEqual sExpected sResult
        End_Procedure

        {Published = True}
        { Description = "CommentOutLine handles a 0-indent line with trailing whitespace" }
        Procedure CommentOutLine_NoIndentTrailingWhitespace
            String sResult
            Get CommentOutLine of oWorker "End_Procedure    " to sResult
            Send AssertSAreEqual "//End_Procedure    " sResult
        End_Procedure

        // -----------------------------------------------------------------------
        // End-to-end TransformSource: the exact bug the user hit
        // -----------------------------------------------------------------------

        {Published = True}
        { Description = "Item_Change body with trailing whitespace on inline If line is commented out cleanly (no 'If (// If (' corruption)" }
        Procedure ItemChange_InlineIf_TrailingWhitespace_NoCorruption
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFoundCorruption bFoundCleanComment

            // Mirror the user's exact failing input: 4 trailing spaces on the If line.
            Move "Object oGrid1 is a Grid"                                      to asInput[0]
            Move "    Procedure Item_Change Integer iFromItem Integer iToItem Returns Integer" to asInput[1]
            Move "        Integer iRetVal"                                       to asInput[2]
            Move "        Forward Get msg_Item_Change iFromItem iToItem to iRetVal" to asInput[3]
            Move "        If (iToItem <> iFromItem) Send pAddLabels iToItem    " to asInput[4]
            Move "        Procedure_Return iRetVal"                              to asInput[5]
            Move "    End_Procedure"                                              to asInput[6]
            Move "End_Object"                                                     to asInput[7]

            Get RunTransform asInput to asOutput

            Move False to bFoundCorruption
            Move False to bFoundCleanComment
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                // The corruption pattern: "If (" appears BEFORE the comment marker on the same line.
                If (asOutput[iIdx] contains "If (//") Begin
                    Move True to bFoundCorruption
                End
                // The clean output: "// If (iToItem <> iFromItem) Send pAddLabels iToItem"
                If (Left(Trim(asOutput[iIdx]), 2) = "//" and Trim(asOutput[iIdx]) contains "If (iToItem <> iFromItem) Send pAddLabels iToItem") Begin
                    Move True to bFoundCleanComment
                End
            Loop
            Send AssertFalse bFoundCorruption
            Send Assert bFoundCleanComment
        End_Procedure

        {Published = True}
        { Description = "Item_Change body with trailing whitespace on Send line is commented out cleanly" }
        Procedure ItemChange_SendLine_TrailingWhitespace_NoCorruption
            String[] asInput asOutput
            Integer  iIdx
            Boolean  bFoundCorruption bFoundCleanComment

            Move "Object oGrid1 is a Grid"                              to asInput[0]
            Move "    Procedure Item_Change Integer iOld Integer iNew"  to asInput[1]
            Move "        Send DoSomething iNew     "                   to asInput[2]
            Move "    End_Procedure"                                    to asInput[3]
            Move "End_Object"                                            to asInput[4]

            Get RunTransform asInput to asOutput

            Move False to bFoundCorruption
            Move False to bFoundCleanComment
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                // Any sign of indent-corruption: original keyword appears BEFORE the comment marker.
                If (asOutput[iIdx] contains "Send //") Move True to bFoundCorruption
                If (Left(Trim(asOutput[iIdx]), 2) = "//" and Trim(asOutput[iIdx]) contains "Send DoSomething iNew") Begin
                    Move True to bFoundCleanComment
                End
            Loop
            Send AssertFalse bFoundCorruption
            Send Assert bFoundCleanComment
        End_Procedure

    End_Object

    /* -----------------------------------------------------------------------
       oContinuedDeclaration - "Object oX ;" / "is a Grid" split over a ';'
       continuation. Every IsGridDeclaration opens with Pos("object ", ..) = 1, so
       the half naming the class was invisible and the object stayed a Grid - while
       the compiler went on reporting 4537 against the continuation line
       (probe-verified against DF25, Nils 2026-08-10).
       ----------------------------------------------------------------------- */
    Object oContinuedDeclaration is a cTestFixture
        Set psFunctionName to "ContinuedGridDeclaration"

        Object oWorker is a cGridToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform_as String[] asInput Returns String[]
            String[] asOutput
            Integer  iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        Function AnyLineContains String[] asArr String sNeedle Returns Boolean
            Integer i iMax
            Move (SizeOfArray(asArr) - 1) to iMax
            For i from 0 to iMax
                If (Lowercase(asArr[i]) contains Lowercase(sNeedle)) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        {Published = True}
        { Description = "A ';'-continued Grid declaration is joined and converted" }
        Procedure Continued_IsConverted
            String[] asInput asOutput
            Boolean  bLegacyLeft
            Move "Object oCustomers ;"      to asInput[0]
            Move "    is a Grid"            to asInput[1]
            Move "End_Object"               to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send Assert (Lowercase(asOutput[0]) contains "object ocustomers is a ccjgrid")
            Get AnyLineContains asOutput "is a grid" to bLegacyLeft
            Send AssertFalse bLegacyLeft
        End_Procedure

        // The joined line keeps the FIRST half's indentation, not the continuation's.
        {Published = True}
        { Description = "The joined declaration keeps the first half's indent" }
        Procedure Continued_KeepsLeadingIndent
            String[] asInput asOutput
            Move "    Object oCustomers ;"  to asInput[0]
            Move "        is a Grid"        to asInput[1]
            Move "    End_Object"           to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "    " (Left(asOutput[0], 4))
            Send AssertFalse (Left(asOutput[0], 5) = "     ")
        End_Procedure

        // "is an" is as legal as "is a" and must join too.
        {Published = True}
        { Description = "A ';'-continued declaration using 'is an' also joins" }
        Procedure Continued_IsAnArticle
            String[] asInput asOutput
            Boolean  bOK
            Move "Object oCustomers ;"      to asInput[0]
            Move "    is an Grid"           to asInput[1]
            Move "End_Object"               to asInput[2]
            Get RunTransform_as asInput to asOutput
            Get AnyLineContains asOutput "ccjgrid" to bOK
            Send Assert bOK
        End_Procedure

        /* THE RESTRAINT. A ';' continuation completing an object of some OTHER class must be left
           byte-for-byte alone - joining every continuation in the file would reflow lines the user
           never asked us to touch and bury the real change in the diff. */
        {Published = True}
        { Description = "A continued declaration of an unrelated class is left untouched" }
        Procedure Continued_UnrelatedClassUntouched
            String[] asInput asOutput
            Move "Object oThing ;"          to asInput[0]
            Move "    is a cWebForm"        to asInput[1]
            Move "End_Object"               to asInput[2]
            Move "Object oGrid is a Grid"   to asInput[3]
            Move "End_Object"               to asInput[4]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Object oThing ;"   asOutput[0]
            Send AssertSAreEqual "    is a cWebForm" asOutput[1]
        End_Procedure

        // A trailing comment after the ';' is not joined - see the procedure's own note.
        {Published = True}
        { Description = "A ';' followed by a trailing comment is left as written" }
        Procedure Continued_TrailingCommentNotJoined
            String[] asInput asOutput
            Move "Object oCustomers ; // the grid" to asInput[0]
            Move "    is a Grid"                   to asInput[1]
            Move "End_Object"                      to asInput[2]
            Get RunTransform_as asInput to asOutput
            Send AssertSAreEqual "Object oCustomers ; // the grid" asOutput[0]
        End_Procedure

        // The normal one-line form must be entirely unaffected by the join pass.
        {Published = True}
        { Description = "A plain one-line declaration is unchanged by the join pass" }
        Procedure Plain_StillConvertsAndLineCountHolds
            String[] asInput asOutput
            Move "Object oGrid is a Grid"   to asInput[0]
            Move "End_Object"               to asInput[1]
            Get RunTransform_as asInput to asOutput
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
        End_Procedure

    End_Object

End_Object
