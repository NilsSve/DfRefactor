// oRefactorGridToCJGrid-Tests.pkg
//
// Unit tests for cGridToCJGrid.pkg (non-data-aware Grid -> cCJGrid subclass).
// Included by oUnit_Tests.pkg inside the oRefactorFuncLib_Tests fixture object.
//
// Test groups:
//   oGridIsGridDeclaration       - IsGridDeclaration (pattern and exact-match)
//   oGridTransformSource         - TransformSource end-to-end (class rename, property translation)
//   oGridDataLoadConversion      - Data-loading procedure -> LoadData conversion
//   oGridColumnProperties        - Per-column Form_Width / Header_Label / etc. extraction
//   oGridCellAccess              - Get Current_Item / Get Value of grid (rowvar + N) conversions
//   oTrailingWhitespaceIndent    - Regression tests for indent-math bug (GetIndent / CommentOutLine)

Use cGridToCJGrid.pkg

Object oRefactorGridToCJGrid is a cTestFixture
    Set psFunctionName to "RefactorGridToCJGrid"
        
    Object oGridIsGridDeclaration is a cTestFixture
        Set psFunctionName to "IsGridDeclaration (cGridToCJGrid)"

        Object oWorker is a cGridToCJGrid
        End_Object

        // Reset oWorker class-name state so the ExactMatch_* tests don't leak
        // a custom psLegacyGridClass into the next test run (which would make
        // Grid_Detected fail on every run after the first).
        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        {Published = True}
        { Description = "Bare 'Grid' class is detected by pattern" }
        Procedure Grid_Detected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a grid" to bResult
            Send Assert bResult
        End_Procedure
    
        {Published = True}
        { Description = "cGrid class is NOT detected by default (use explicit sParameter to target it)" }
        Procedure cGrid_NotDetectedByDefault
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a cgrid" to bResult
            Send AssertFalse bResult
        End_Procedure

        {Published = True}
        { Description = "Custom class ending in Grid is NOT detected by default (use explicit sParameter)" }
        Procedure CustomGrid_NotDetectedByDefault
            Boolean bResult
            Get IsGridDeclaration of oWorker "object omygrid is a ctrgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "DbGrid class is NOT detected (belongs to cDbGridTocDbCJGrid)" }
        Procedure DbGrid_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a dbgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "cDbGrid class is NOT detected (ends in dbgrid)" }
        Procedure cDbGrid_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a cdbgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "cTrDbGrid class is NOT detected (ends in dbgrid)" }
        Procedure cTrDbGrid_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a ctrdbgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "Non-grid class is not detected" }
        Procedure NonGrid_NotDetected
            Boolean bResult
            Get IsGridDeclaration of oWorker "object oform1 is a cdbform" to bResult
            Send AssertFalse bResult
        End_Procedure
    
        {Published = True}
        { Description = "Exact-match mode: specified class is detected" }
        Procedure ExactMatch_Detected
            Boolean bResult
            Get ParseAndSetParameter of oWorker "cMyGrid,cCJGrid" to bResult
            Get IsGridDeclaration of oWorker "object omygrid is a cmygrid" to bResult
            Send Assert bResult
        End_Procedure
    
        {Published = True}
        { Description = "Exact-match mode: other grid class is NOT detected" }
        Procedure ExactMatch_OtherGrid_NotDetected
            Boolean bResult
            Get ParseAndSetParameter of oWorker "cMyGrid,cCJGrid" to bResult
            Get IsGridDeclaration of oWorker "object ogrid1 is a cgrid" to bResult
            Send AssertFalse bResult
        End_Procedure
    
    End_Object
    
    Object oGridTransformSource is a cTestFixture
        Set psFunctionName to "TransformSource (cGridToCJGrid)"
    
        Object oWorker is a cGridToCJGrid
        End_Object
    
        Procedure TearDown
            Boolean bOK
            // Reset oWorker class-name state to defaults so tests cannot contaminate each other.
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    
        // Helper: loads asInput into worker, runs TransformSource, returns grid count.
        Function RunTransform String[] asInput Returns Integer
            Integer iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Function_Return iGrids
        End_Function
    
        Function GetOutput Returns String[]
            String[] asResult
            Get pasSource of oWorker to asResult
            Function_Return asResult
        End_Function
    
        // First index at or after iFrom whose trimmed line starts with sPrefix; -1 when none.
        Function IndexOfTrimmedPrefix String[] asLines String sPrefix Integer iFrom Returns Integer
            Integer i iLast
            Move (SizeOfArray(asLines) - 1) to iLast
            For i from iFrom to iLast
                If (Left(Trim(asLines[i]), Length(sPrefix)) = sPrefix) ;
                    Function_Return i
            Loop
            Function_Return -1
        End_Function

        /* COLUMNS DECLARED BY Header_Label ALONE (2026-09-07). The column objects came from the captions, but
           the merged declaration, the piColumnId lines and the Add_Item rewrite counted the Form_Width list -
           empty here - so the fill procedure referenced iCol1 without declaring it and put every item in its
           own row. One column count serves all of them now (NdColumnCount). */
        {Published = True}
        { Description = "A Header_Label-only grid declares iCol1..iColN, fetches their ids and cycles the columns per row" }
        Procedure HeaderLabelOnlyGrid_FillProcedureDeclaresAndCyclesColumns
            String[] asInput asOutput
            Integer  iGrids iDecl iGet1 iGet2 iA1 iA2 iB1 iB2

            Move "Object oGrd is a Grid"                        to asInput[0]
            Move '    Set Header_Label Item 0 to "Name"'        to asInput[1]
            Move '    Set Header_Label Item 1 to "Value"'       to asInput[2]
            Move "    Procedure Fill_List"                      to asInput[3]
            Move "        Integer iX"                           to asInput[4]
            Move "        Send Delete_Data"                     to asInput[5]
            Move '        Send Add_Item Msg_None "a"'           to asInput[6]
            Move '        Send Add_Item Msg_None "b"'           to asInput[7]
            Move '        Send Add_Item Msg_None "c"'           to asInput[8]
            Move '        Send Add_Item Msg_None "d"'           to asInput[9]
            Move "    End_Procedure"                            to asInput[10]
            Move "End_Object"                                   to asInput[11]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput
            Send AssertIAreEqual 1 iGrids

            Get IndexOfTrimmedPrefix asOutput "Integer iRow iCol1 iCol2" 0 to iDecl
            Send Assert (iDecl >= 0)
            Send Assert (Lowercase(asOutput[iDecl]) contains " ix")
            Get IndexOfTrimmedPrefix asOutput "Get piColumnId of oCol1 to iCol1" iDecl to iGet1
            Get IndexOfTrimmedPrefix asOutput "Get piColumnId of oCol2 to iCol2" iDecl to iGet2
            Send Assert (iGet1 > iDecl)
            Send Assert (iGet2 > iGet1)
            Get IndexOfTrimmedPrefix asOutput 'Move "a" to TheData[iRow].sValue[iCol1]' iGet2 to iA1
            Get IndexOfTrimmedPrefix asOutput 'Move "b" to TheData[iRow].sValue[iCol2]' iGet2 to iA2
            Get IndexOfTrimmedPrefix asOutput 'Move "c" to TheData[iRow].sValue[iCol1]' iGet2 to iB1
            Get IndexOfTrimmedPrefix asOutput 'Move "d" to TheData[iRow].sValue[iCol2]' iGet2 to iB2
            Send Assert (iA1 > iGet2)
            Send Assert (iA2 > iA1)
            Send Assert (iB1 > iA2)
            Send Assert (iB2 > iB1)
            // One row per pair: the row advances after the second column, not after every item.
            Send AssertSAreEqual "Increment iRow" (Trim(asOutput[iA2 + 1]))
            Send AssertSAreEqual "Increment iRow" (Trim(asOutput[iB2 + 1]))
            Send Assert (Trim(asOutput[iA1 + 1]) <> "Increment iRow")
        End_Procedure

        {Published = True}
        { Description = "Grid class name is replaced with cCJGrid" }
        Procedure ClassNameReplaced
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oGrid1 is a Grid" to asInput[0]
            Move "End_Object"              to asInput[1]
    
            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput
    
            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
        End_Procedure

        // A worker whose package-class answer is fixed - it stands in for the run's class index, which the
        // DFUnit runner has no application to build from. Used by the two subclass tests below.
        Object oIdxWorker is a cGridToCJGrid
            Function ClassesOfPackage String sPkgLeaf Returns String[]
                String[] asOut
                If (Lowercase(sPkgLeaf) = "ceditgrid.pkg") ;
                    Move "CEDITGRID" to asOut[0]
                If (Lowercase(sPkgLeaf) = "cbusygrid.pkg") Begin
                    Move "CBUSYGRID"       to asOut[0]
                    Move "CBUSYGRIDHELPER" to asOut[1]
                End
                Function_Return asOut
            End_Function
        End_Object

        /* A CONVERTED SUBCLASS OBJECT LEAVES A CLEAN FILE (Nils 2026-09-05): a TODO opening the object's body
           names the class it came from, and the Use of that class's own package is commented out when the
           package defines nothing the file still names. Since 2026-10-03 only a NAMED parameter converts a
           subclass object (an EMPTY one leaves it - see LearnedSubclass_EmptyParameterLeavesTheObject), so
           the class is named here; the learned set is still loaded, and does not change that. */
        {Published = True}
        Procedure NamedSubclass_MarkerAndDeadUseRetired
            String[] asInput asOutput asNames asRoots asNone
            Integer  iGrids i iMax iHeader iMarker iUse iTarget
            Boolean  bOk

            Move "ceditgrid" to asNames[0]
            Move "grid"      to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move "Use Windows.pkg"          to asInput[0]
            Move "Use cEditGrid.pkg"        to asInput[1]
            Move "Object oX is a cEditGrid" to asInput[2]
            Move "    Set Size to 100 200"  to asInput[3]
            Move "End_Object"               to asInput[4]
            Get ParseAndSetParameter of oIdxWorker "cEditGrid,cCJGrid,cCJGridColumn" to bOk
            Set pasSource of oIdxWorker to asInput
            Get TransformSource of oIdxWorker to iGrids
            Get pasSource of oIdxWorker to asOutput
            Send AssertIAreEqual 1 iGrids
            Move -1 to iHeader
            Move -1 to iMarker
            Move -1 to iUse
            Move -1 to iTarget
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (Trim(asOutput[i]) = "Object oX is a cCJGrid") ;
                    Move i to iHeader
                If (Trim(asOutput[i]) contains "// TODO: oX was a cEditGrid - a subclass of Grid") ;
                    Move i to iMarker
                If (Trim(asOutput[i]) = "//Use cEditGrid.pkg") ;
                    Move i to iUse
                If (Lowercase(Trim(asOutput[i])) = "use ccjgrid.pkg") ;
                    Move i to iTarget
            Loop
            Send Assert (iHeader >= 0) "the object is a cCJGrid now"
            Send Assert (iMarker >= 0) "a TODO names the class it came from"
            Send AssertIAreEqual (iHeader + 1) iMarker
            Send Assert (iUse >= 0)    "the subclass package's Use is commented out"
            Send Assert (iTarget >= 0) "the target package is Used"
            Send AssertSAreEqual "Use Windows.pkg" (Trim(asOutput[0]))
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
        End_Procedure

        // ...but a package that still defines something the file names keeps its Use: the index says the
        // package defines a second class, and the file has an object of it.
        {Published = True}
        Procedure NamedSubclass_UseKeptWhilePackageStillNeeded
            String[] asInput asOutput asNames asRoots asNone
            Integer  iGrids i iMax iUse iHelper
            Boolean  bOk

            Move "cbusygrid" to asNames[0]
            Move "grid"      to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move "Use Windows.pkg"                to asInput[0]
            Move "Use cBusyGrid.pkg"              to asInput[1]
            Move "Object oX is a cBusyGrid"       to asInput[2]
            Move "End_Object"                     to asInput[3]
            Move "Object oH is a cBusyGridHelper" to asInput[4]
            Move "End_Object"                     to asInput[5]
            Get ParseAndSetParameter of oIdxWorker "cBusyGrid,cCJGrid,cCJGridColumn" to bOk
            Set pasSource of oIdxWorker to asInput
            Get TransformSource of oIdxWorker to iGrids
            Get pasSource of oIdxWorker to asOutput
            Send AssertIAreEqual 1 iGrids
            Move -1 to iUse
            Move -1 to iHelper
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (Trim(asOutput[i]) = "Use cBusyGrid.pkg") ;
                    Move i to iUse
                If (Trim(asOutput[i]) = "Object oH is a cBusyGridHelper") ;
                    Move i to iHelper
            Loop
            Send Assert (iUse >= 0)    "the Use stays: the package still defines a class the file names"
            Send Assert (iHelper >= 0) "the helper object is untouched"
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
        End_Procedure

        /* AN EMPTY PARAMETER LEAVES THE SUBCLASS OBJECT AS IT IS (Nils 2026-10-03: "a subclass can't be
           blindly swapped for a CodeJock grid class without first have converted the cEntryGrid
           subclass"). The scan learned cEditGrid and the parameter is EMPTY: the plain Grid beside it
           converts, the cEditGrid object comes back line for line with no TODO, its package's Use stays,
           and the run note names the class with what to do instead. */
        {Published = True}
        Procedure LearnedSubclass_EmptyParameterLeavesTheObject
            String[] asInput asOutput asNames asRoots asNone asLeft
            String   sNotes
            Integer  iGrids i
            Boolean  bOk bMarker

            Move "ceditgrid" to asNames[0]
            Move "grid"      to asRoots[0]
            Set pasLearnedSubclassNames of ghoFuncLib to asNames
            Set pasLearnedSubclassRoots of ghoFuncLib to asRoots
            Move "Use Windows.pkg"          to asInput[0]
            Move "Use cEditGrid.pkg"        to asInput[1]
            Move "Object oX is a cEditGrid" to asInput[2]
            Move "    Set Size to 100 200"  to asInput[3]
            Move "End_Object"               to asInput[4]
            Move "Object oG is a Grid"      to asInput[5]
            Move "End_Object"               to asInput[6]
            Send _ClearSubclassesLeft of oIdxWorker
            Get ParseAndSetParameter of oIdxWorker "" to bOk
            Set pasSource of oIdxWorker to asInput
            Get TransformSource of oIdxWorker to iGrids
            Get pasSource of oIdxWorker to asOutput
            Send AssertIAreEqual 1 iGrids
            Send Assert (SearchArray("Object oG is a cCJGrid", asOutput) <> -1)   "the plain Grid converts"
            Send Assert (SearchArray("Object oX is a cEditGrid", asOutput) <> -1) "the subclass object keeps its class"
            Send Assert (SearchArray("    Set Size to 100 200", asOutput) <> -1)  "its body is as written"
            Send Assert (SearchArray("Use cEditGrid.pkg", asOutput) <> -1)        "its package's Use stays"
            Move False to bMarker
            For i from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[i] contains "was a cEditGrid") ;
                    Move True to bMarker
            Loop
            Send AssertFalse bMarker
            Get pasSubclassLeftNames of oIdxWorker to asLeft
            Send AssertIAreEqual 1 (SizeOfArray(asLeft))
            // ...and the run note, once per class, with what to do instead.
            Set psExecutionContext of ghoFuncLib to "RefactorGridToCJGrid"
            Send NoteSubclassesLeft of oIdxWorker
            Get RunNotesText of ghoFuncLib "RefactorGridToCJGrid" "" to sNotes
            Send Assert (sNotes contains "1 object(s) of cEditGrid left as they are - a workspace subclass of Grid") "the run note names the class"
            Send Assert (sNotes contains "Run ConvertGridSubclassToCodeJock with the parameter 'cEditGrid'") "the run note names the subclass converter and its parameter"
            Set psExecutionContext of ghoFuncLib to ""
            Set pasLearnedSubclassNames of ghoFuncLib to asNone
            Set pasLearnedSubclassRoots of ghoFuncLib to asNone
        End_Procedure

        /* A TOKENIZED LINE LEAVES THE RUNNING FUNCTION'S NAME AS IT WAS (2026-11-01): the tokenizer set psExecutionContext
           to "Tokenizer" and left it there, so a converter that tokenized a line filed its later run notes under
           "Tokenizer", which no summary prints - "N object(s) of <subclass> left as they are" was lost. */
        {Published = True}
        Procedure Tokenizer_LeavesTheRunningFunctionsName
            tTokenizer TokenizerData
            String sAfter
            Set psExecutionContext of ghoFuncLib to "RefactorDbListTocDbCJGridPromptList"
            Get Tokenizer of ghoFuncLib "    Move 1 to iCount" to TokenizerData
            Get psExecutionContext of ghoFuncLib to sAfter
            Set psExecutionContext of ghoFuncLib to ""
            Send AssertSAreEqual "RefactorDbListTocDbCJGridPromptList" sAfter
        End_Procedure

        // ...while a List subclass's run note keeps the by-hand recipe: ConvertGridSubclassToCodeJock refuses
        // the List family for now (2026-10-04), so the note must not send the user there.
        {Published = True}
        Procedure ListSubclassLeftReason_KeepsTheByHandRecipe
            Handle ho
            String s

            Get Create (RefClass(cListToCJGrid)) to ho
            Get SubclassLeftReason of ho "MyList" to s
            Send Destroy of ho
            Send Assert ((s contains "'MyList,<the new class>,") and not(s contains "ConvertGridSubclassToCodeJock")) s
        End_Procedure

        // SAFETY: Grid lives in the foundational Windows.pkg, which must NEVER be swapped
        // out (unlike dbGrid's Dftable.pkg / dbList's Dfsellst.pkg). The converter only
        // ADDS Use cCJGrid.pkg after the leading Use block; Windows.pkg stays put.
        {Published = True}
        { Description = "Windows.pkg is preserved; cCJGrid.pkg is injected (never a Windows.pkg swap)" }
        Procedure WindowsPkg_Preserved_TargetInjected
            String[] asInput asOutput
            Integer  iGrids i iMax
            Boolean  bWindowsKept bTargetAdded

            Move "Use Windows.pkg"          to asInput[0]
            Move "Object oGrid1 is a Grid"  to asInput[1]
            Move "End_Object"               to asInput[2]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Move False to bWindowsKept
            Move False to bTargetAdded
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (asOutput[i] = "Use Windows.pkg") ;
                    Move True to bWindowsKept
                If (asOutput[i] = "Use cCJGrid.pkg") ;
                    Move True to bTargetAdded
            Loop
            Send Assert bWindowsKept
            Send Assert bTargetAdded
        End_Procedure

        {Published = True}
        { Description = "cGrid class name is replaced with cCJGrid when sParameter explicitly targets it" }
        Procedure cGridClassNameReplaced
            String[] asInput asOutput
            Integer  iGrids
            Boolean  bOK

            Move "Object oGrid1 is a cGrid" to asInput[0]
            Move "End_Object"               to asInput[1]

            Get ParseAndSetParameter of oWorker "cGrid,cCJGrid" to bOK
            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
        End_Procedure
    
        {Published = True}
        { Description = "Returns 0 and leaves source unchanged for non-grid object" }
        Procedure NonGrid_Unchanged
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oForm1 is a cDbForm" to asInput[0]
            Move "End_Object"                 to asInput[1]
    
            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput
    
            Send AssertIAreEqual 0 iGrids
            Send AssertSAreEqual "Object oForm1 is a cDbForm" asOutput[0]
        End_Procedure
    
        {Published = True}
        { Description = "DbGrid object is NOT converted by cGridToCJGrid" }
        Procedure DbGrid_NotConverted
            String[] asInput asOutput
            Integer  iGrids
    
            Move "Object oGrid1 is a DbGrid" to asInput[0]
            Move "End_Object"                to asInput[1]
    
            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput
    
            Send AssertIAreEqual 0 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a dbgrid")
        End_Procedure
    
        {Published = True}
        { Description = "Grid-level Set properties are translated (pbAllowAppendRow)" }
        Procedure GridLevelProperty_Translated
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFound

            Move "Object oGrid1 is a Grid"                  to asInput[0]
            Move "    Set Allow_Bottom_Add_State to True"   to asInput[1]
            Move "End_Object"                               to asInput[2]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            // Verify the grid was detected and the legacy property was translated
            Send AssertIAreEqual 1 iGrids
            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "pbAllowAppendRow") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure
    
        {Published = True}
        { Description = "sParameter overrides both class names" }
        Procedure Parameter_OverridesClassNames
            String[] asInput asOutput
            Integer  iGrids
    
            Boolean bOK

            Move "Object oGrid1 is a cMyGrid" to asInput[0]
            Move "End_Object"                 to asInput[1]

            Get ParseAndSetParameter of oWorker "cMyGrid,cMyCJGrid" to bOK
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get GetOutput to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a cmycjgrid")
        End_Procedure
    
        {Published = True}
        { Description = "Entry_Display color is extracted and placed before commented block" }
        Procedure EntryDisplay_ColorExtracted
            String[] asInput asOutput
            Integer  iGrids iIdx iTranslatedIdx iCommentedIdx

            Move "Object oGrid1 is a Grid"                     to asInput[0]
            Move "    Procedure Entry_Display"                 to asInput[1]
            Move "        Set CurrentRowColor to RGB(1,2,3)"   to asInput[2]
            Move "    End_Procedure"                           to asInput[3]
            Move "End_Object"                                  to asInput[4]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move -1 to iTranslatedIdx
            Move -1 to iCommentedIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Set piHighlightBackColor to RGB(1,2,3)") Begin
                    Move iIdx to iTranslatedIdx
                End
                If (Left(asOutput[iIdx], 2) = "//" and Lowercase(asOutput[iIdx]) contains "procedure entry_display") Begin
                    Move iIdx to iCommentedIdx
                End
            Loop
            // Translated property must exist and appear before the commented declaration
            Send Assert (iTranslatedIdx >= 0 and iCommentedIdx >= 0 and iTranslatedIdx < iCommentedIdx)
        End_Procedure

        {Published = True}
        { Description = "Entry_Display value using a method local is NOT hoisted; a constant sibling still is" }
        Procedure EntryDisplay_LocalValueNotHoisted
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bBadHoist bNote bConstHoist

            Move "Object oGrid1 is a Grid"                                 to asInput[0]
            Move "    Procedure Entry_Display Integer iFile Integer iType" to asInput[1]
            Move "        Integer iColor"                                  to asInput[2]
            Move "        Move (RGB(1,2,3)) to iColor"                     to asInput[3]
            Move "        Set CurrentRowColor to iColor"                   to asInput[4]
            Move "        Set CurrentCellColor to (RGB(0,255,255))"        to asInput[5]
            Move "        Forward Send Entry_Display iFile iType"          to asInput[6]
            Move "    End_Procedure"                                       to asInput[7]
            Move "End_Object"                                              to asInput[8]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bBadHoist
            Move False to bNote
            Move False to bConstHoist
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                // The pi name only appears on a real (bad) hoist - the decline note and the
                // commented-out original both carry the LEGACY property name.
                If (asOutput[iIdx] contains "Set piHighlightBackColor to iColor") Begin
                    Move True to bBadHoist
                End
                If (asOutput[iIdx] contains "NOT hoisted (value uses an Entry_Display local)") Begin
                    Move True to bNote
                End
                If (asOutput[iIdx] contains "Set piFocusCellBackColor to (RGB(0,255,255))") Begin
                    Move True to bConstHoist
                End
            Loop
            Send AssertFalse bBadHoist
            Send Assert bNote
            Send Assert bConstHoist
        End_Procedure

        {Published = True}
        { Description = "Column objects generated from Form_Width and Header_Label" }
        Procedure ColumnObjects_Generated
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bCol1 bCol2

            Move "Object oGrid1 is a Grid"           to asInput[0]
            Move "    Set Form_Width 0 to 200"       to asInput[1]
            Move "    Set Form_Width 1 to 150"       to asInput[2]
            Move '    Set Header_Label 0 to "Name"'  to asInput[3]
            Move '    Set Header_Label 1 to "Value"' to asInput[4]
            Move "End_Object"                        to asInput[5]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Move False to bCol1
            Move False to bCol2
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "object ocol1 is a") Begin
                    Move True to bCol1
                End
                If (Lowercase(asOutput[iIdx]) contains "object ocol2 is a") Begin
                    Move True to bCol2
                End
            Loop
            Send Assert (bCol1 and bCol2)
        End_Procedure

        {Published = True}
