        {Published = True}
        { Description = "Mouse_Down2 with Get Current_Item is converted, not emitted raw" }
        Procedure MouseDown2_WithCurrentItem_NotEmittedRaw
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bConverted bRaw

            Move "Object oGrid1 is a Grid"                                 to asInput[0]
            Move "    Set Form_Width 0 to 100"                             to asInput[1]
            Move "    Procedure Mouse_Down2 Integer iWin Integer iPos"     to asInput[2]
            Move "        Integer iItem"                                   to asInput[3]
            Move "        Get Current_Item to iItem"                       to asInput[4]
            Move "        If (iItem > 0) Send pHandle iItem"               to asInput[5]
            Move "    End_Procedure"                                       to asInput[6]
            Move "End_Object"                                              to asInput[7]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bConverted
            Move False to bRaw
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "procedure onrowrightclick") Move True to bConverted
                // The raw legacy declaration must not appear (commented or active).
                If (Lowercase(asOutput[iIdx]) contains "procedure mouse_down2")    Move True to bRaw
            Loop
            Send Assert (bConverted and bRaw = False)
        End_Procedure

        {Published = True}
        { Description = "Mid-procedure var decl of old row var in mouse method does not produce duplicate iRow" }
        Procedure MouseClick_MidProcVarDecl_NoduplicateIRow
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bNoDuplicate

            // Legacy: Integer iCurrentItem iItems appears AFTER a code line (mid-proc).
            // The old var must be removed, not renamed to iRow, since iRow is a parameter.
            Move "Object oGrid1 is a Grid"                                       to asInput[0]
            Move "    Set Form_Width 0 to 100"                                   to asInput[1]
            Move "    Procedure Mouse_Click Integer iWin Integer iPos"           to asInput[2]
            Move "        Forward Send Mouse_Click iWin iPos"                    to asInput[3]
            Move "        Send Cursor_Wait of Cursor_Control"                    to asInput[4]
            Move "        Integer iCurrentItem iItems"                           to asInput[5]
            Move "        Get Current_Item to iCurrentItem"                      to asInput[6]
            Move "        If (iCurrentItem > 0) Send pHandle iCurrentItem"       to asInput[7]
            Move "    End_Procedure"                                             to asInput[8]
            Move "End_Object"                                                    to asInput[9]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            // Check: no non-comment line should contain both "integer irow" and "iitems".
            // Such a line (e.g. "Integer iRow iItems") would mean iCurrentItem was wrongly
            // renamed to iRow instead of being removed from the mid-procedure var decl.
            // Note: lines like "Integer iRow iCol1" (from the generated LoadData stub) are
            // intentional and are excluded by the "iitems" part of the check.
            Move True to bNoDuplicate
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "integer irow" and ;
                    Lowercase(asOutput[iIdx]) contains "iitems" and ;
                    Left(Trim(asOutput[iIdx]), 2) <> "//") Begin
                    Move False to bNoDuplicate
                End
            Loop
            Send Assert bNoDuplicate
        End_Procedure

        {Published = True}
        { Description = "Column objects appear before LoadData in output" }
        Procedure ColumnObjects_BeforeLoadData
            String[] asInput asOutput
            Integer  iGrids iIdx iColIdx iLoadIdx

            Move "Object oGrid1 is a Grid"      to asInput[0]
            Move "    Set Form_Width 0 to 100"  to asInput[1]
            Move "End_Object"                   to asInput[2]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move -1 to iColIdx
            Move -1 to iLoadIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "object ocol1 is a") Begin
                    Move iIdx to iColIdx
                End
                If (Lowercase(asOutput[iIdx]) contains "procedure loaddata") Begin
                    Move iIdx to iLoadIdx
                End
            Loop
            Send Assert (iColIdx >= 0 and iLoadIdx >= 0 and iColIdx < iLoadIdx)
        End_Procedure

        /* A GRID WITHOUT COLUMN DEFINITIONS IS LEFT ALONE (Nils 2026-09-07): a workspace whose grids get
           their columns from a helper command ('Send <Helper> "Caption" 30' at object level) had every one
           of them converted against ONE forced column - each Add_Item its own row in an iCol1 nobody
           declared, the helper lines commented out, nothing said so. Now such an object passes through
           verbatim, is not counted, adds no Use line, and the run note names it and the likely helper. */
        {Published = True}
        { Description = "A grid with no Form_Width/Header_Label of its own passes through under a skip-marker, uncounted, and is named in the run notes" }
        Procedure ColumnlessGrid_LeftUntouchedAndNoted
            String[] asInput asOutput
            String   sNotes
            Integer  iGrids i iMax

            Move "Use Windows.pkg"                       to asInput[0]
            Move "Object oGrd is a Grid"                 to asInput[1]
            Move "    Set Size to 100 200"               to asInput[2]
            Move '    Send Columns_Add "Code" 30'        to asInput[3]
            Move '    Send Columns_Add "Name" 80'        to asInput[4]
            Move "    Send Columns_Apply Self"           to asInput[5]
            Move "    Procedure Fill_List"               to asInput[6]
            Move "        Send Delete_Data"              to asInput[7]
            Move '        Send Add_Item Msg_None "A"'    to asInput[8]
            Move '        Send Add_Item Msg_None "B"'    to asInput[9]
            Move "    End_Procedure"                     to asInput[10]
            Move "End_Object"                            to asInput[11]

            Set psExecutionContext of ghoFuncLib to "RefactorGridToCJGrid"
            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput
            Get RunNotesText of ghoFuncLib "RefactorGridToCJGrid" "" to sNotes
            Set psExecutionContext of ghoFuncLib to ""

            Send AssertIAreEqual 0 iGrids
            // One line more: the skip-marker above the object (the scan and the analyzer honour it, so the
            // row is not offered again); everything else verbatim, in order.
            Send AssertIAreEqual (SizeOfArray(asInput) + 1) (SizeOfArray(asOutput))
            Send AssertSAreEqual asInput[0] asOutput[0]
            Send Assert (Left(Trim(asOutput[1]), 37) = "// TODO (DFRefactor): NOT converted -")
            Send Assert (asOutput[1] contains "Form_Width")
            Move (SizeOfArray(asInput) - 1) to iMax
            For i from 1 to iMax
                Send Assert (asOutput[i + 1] = asInput[i])
            Loop
            Send Assert (sNotes contains "oGrd left as Grid")
            Send Assert (sNotes contains "Form_Width")
            Send Assert (sNotes contains "Columns_Add")
        End_Procedure

        // A second run over the marked file adds nothing: the marker above the object is recognised as the
        // converter's own verdict, so the file stays byte-identical and the count stays 0.
        {Published = True}
        { Description = "A declined grid's skip-marker is written once; a re-run leaves the marked file byte-identical" }
        Procedure ColumnlessGrid_MarkerNotDuplicatedOnRerun
            String[] asInput asFirst asSecond
            Integer  iGrids i iMax iMarkers
            Boolean  bWrite

            Move "Use Windows.pkg"                       to asInput[0]
            Move "Object oGrd is a Grid"                 to asInput[1]
            Move '    Send Columns_Add "Code" 30'        to asInput[2]
            Move "    Procedure Fill_List"               to asInput[3]
            Move '        Send Add_Item Msg_None "A"'    to asInput[4]
            Move "    End_Procedure"                     to asInput[5]
            Move "End_Object"                            to asInput[6]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asFirst
            Send AssertIAreEqual 0 iGrids
            Send AssertIAreEqual (SizeOfArray(asInput) + 1) (SizeOfArray(asFirst))
            // A marker is a reason to write the file back even though nothing converted - the file loop
            // used to write only on a conversion, so the marker never reached the disk.
            Get piDeclineMarkers of oWorker to iMarkers
            Send AssertIAreEqual 1 iMarkers
            Get FileNeedsWrite of oWorker 0 to bWrite
            Send Assert bWrite

            Get RunTransform asFirst to iGrids
            Get GetOutput            to asSecond
            Send AssertIAreEqual 0 iGrids
            Send AssertIAreEqual (SizeOfArray(asFirst)) (SizeOfArray(asSecond))
            Move (SizeOfArray(asFirst) - 1) to iMax
            For i from 0 to iMax
                Send Assert (asSecond[i] = asFirst[i])
            Loop
            // ...and the re-run has no reason to write: no conversion, no new marker.
            Get piDeclineMarkers of oWorker to iMarkers
            Send AssertIAreEqual 0 iMarkers
            Get FileNeedsWrite of oWorker 0 to bWrite
            Send AssertFalse bWrite
        End_Procedure

        {Published = True}
        { Description = "A declined grid does not stop the next grid in the file from converting, and that one still earns the Use line" }
        Procedure ColumnlessGrid_DoesNotBlockSiblings
            String[] asInput asOutput
            Integer  iGrids i iMax iFirst iHelper iSecond iCol2 iUse

            Move "Use Windows.pkg"                       to asInput[0]
            Move "Object oGrd is a Grid"                 to asInput[1]
            Move '    Send Columns_Add "Code" 30'        to asInput[2]
            Move "End_Object"                            to asInput[3]
            Move "Object oGrid2 is a Grid"               to asInput[4]
            Move "    Set Form_Width Item 0 to 30"       to asInput[5]
            Move "    Set Form_Width Item 1 to 80"       to asInput[6]
            Move "End_Object"                            to asInput[7]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Move -1 to iFirst
            Move -1 to iHelper
            Move -1 to iSecond
            Move -1 to iCol2
            Move -1 to iUse
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (Trim(asOutput[i]) = "Object oGrd is a Grid") ;
                    Move i to iFirst
                If (Trim(asOutput[i]) = 'Send Columns_Add "Code" 30') ;
                    Move i to iHelper
                If (Lowercase(asOutput[i]) contains "object ogrid2 is a ccjgrid") ;
                    Move i to iSecond
                If (Lowercase(asOutput[i]) contains "object ocol2 is a ccjgridcolumn") ;
                    Move i to iCol2
                If (Lowercase(Trim(asOutput[i])) = "use ccjgrid.pkg") ;
                    Move i to iUse
            Loop
            Send Assert (iFirst >= 0 and iHelper > iFirst)
            Send Assert (iSecond > iHelper)
            Send Assert (iCol2 > iSecond)
            Send Assert (iUse >= 0)
        End_Procedure

        {Published = True}
        { Description = "Header_Label lines alone are column definitions: the grid converts with one column object per label" }
        Procedure HeaderLabelOnlyGrid_StillConverts
            String[] asInput asOutput
            Integer  iGrids i iMax iCol2

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move '    Set Header_Label 0 to "Code"'      to asInput[1]
            Move '    Set Header_Label 1 to "Name"'      to asInput[2]
            Move "End_Object"                            to asInput[3]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
            Move -1 to iCol2
            Move (SizeOfArray(asOutput) - 1) to iMax
            For i from 0 to iMax
                If (Lowercase(asOutput[i]) contains "object ocol2 is a ccjgridcolumn") ;
                    Move i to iCol2
            Loop
            Send Assert (iCol2 > 0)
        End_Procedure

        {Published = True}
        { Description = "The boundary: a column-less grid that neither fills itself nor sends a helper with arguments still converts as before" }
        Procedure ColumnlessBareGrid_StillConverts
            String[] asInput asOutput
            Integer  iGrids

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move "    Set Size to 100 200"               to asInput[1]
            Move "    Send Fill_the_List"                to asInput[2]
            Move "    Send Close_Panel to (oPanel(Self))" to asInput[3]
            Move "End_Object"                            to asInput[4]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Send AssertIAreEqual 1 iGrids
            Send Assert (Lowercase(asOutput[0]) contains "is a ccjgrid")
        End_Procedure

    End_Object

    // -----------------------------------------------------------------------
    // oGridNumericMask - Numeric_Mask on a Grid's columns (2026-10-04): the CodeJock column's
    // CreateNumericMask. Until then the legacy line stayed in the converted grid, which does not understand
    // it (161 grids of one workspace).
    // -----------------------------------------------------------------------
    Object oGridNumericMask is a cTestFixture
        Set psFunctionName to "Numeric_Mask (cGridToCJGrid)"

        Object oWorker is a cGridToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // A Grid of two columns (A and B) with asBody after them.
        Function RunGrid String[] asBody Returns String[]
            String[] asInput asOutput
            Integer  i iGrids
            Move "Object oG is a Grid"                to asInput[SizeOfArray(asInput)]
            Move "    Set Form_Width Item 0 to 40"    to asInput[SizeOfArray(asInput)]
            Move '    Set Header_Label Item 0 to "A"' to asInput[SizeOfArray(asInput)]
            Move "    Set Form_Width Item 1 to 50"    to asInput[SizeOfArray(asInput)]
            Move '    Set Header_Label Item 1 to "B"' to asInput[SizeOfArray(asInput)]
            For i from 0 to (SizeOfArray(asBody) - 1)
                Move asBody[i] to asInput[SizeOfArray(asInput)]
            Loop
            Move "End_Object"                         to asInput[SizeOfArray(asInput)]
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Get pasSource of oWorker to asOutput
            Function_Return asOutput
        End_Function

        // The output's trimmed lines joined by "|" - the assertion message.
        Function Joined String[] asOut Returns String
            String  s
            Integer i
            Move "" to s
            For i from 0 to (SizeOfArray(asOut) - 1)
                Move (s + Trim(asOut[i]) + "|") to s
            Loop
            Function_Return s
        End_Function

        // True when a line trims to sLine exactly.
        Function HasLine String[] asOut String sLine Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (Trim(asOut[i]) = sLine) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // True when a line contains sPart.
        Function HasPart String[] asOut String sPart Returns Boolean
            Integer i
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (asOut[i] contains sPart) ;
                    Function_Return True
            Loop
            Function_Return False
        End_Function

        // One object's lines, trimmed and joined by "|": from the line that trims to sFrom to its End_Object.
        Function ObjectBody String[] asOut String sFrom Returns String
            String  s
            Integer i
            Boolean bIn
            Move "" to s
            Move False to bIn
            For i from 0 to (SizeOfArray(asOut) - 1)
                If (bIn = False and Trim(asOut[i]) = sFrom) ;
                    Move True to bIn
                If (bIn = True) Begin
                    Move (s + Trim(asOut[i]) + "|") to s
                    If (Trim(asOut[i]) = "End_Object") ;
                        Move False to bIn
                End
            Loop
            Function_Return s
        End_Function

        // The mask lands in its column (item 1 = oCol2), and the legacy line is gone.
        {Published = True}
        Procedure Mask_InItsColumn
            String[] asBody asOut
            Move "    Set Numeric_Mask Item 1 to 12 2" to asBody[0]
            Get RunGrid asBody to asOut
            Send Assert ((ObjectBody(Self, asOut, "Object oCol2 is a cCJGridColumn") contains "|Send CreateNumericMask 12 2|") and not(HasPart(Self, asOut, "umeric_mask"))) (Joined(Self, asOut))
        End_Procedure

        // After the column objects (written at the first method), in place against oCol<N+1>.
        {Published = True}
        Procedure Mask_AfterTheColumns_WrittenInPlace
            String[] asBody asOut
            Move "    Procedure DoNothing"              to asBody[0]
            Move "    End_Procedure"                    to asBody[1]
            Move "    Set Numeric_Mask Item 0 to 6 0"   to asBody[2]
            Get RunGrid asBody to asOut
            Send Assert (HasLine(Self, asOut, "Send CreateNumericMask of oCol1 6 0")) (Joined(Self, asOut))
        End_Procedure

    End_Object

    Object oGridDataLoadConversion is a cTestFixture
        Set psFunctionName to "DataLoadConversion (cGridToCJGrid)"

        Object oWorker is a cGridToCJGrid
        End_Object

        Procedure TearDown
            Boolean bOK
            Get ParseAndSetParameter of oWorker "" to bOK
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        Function RunTransform String[] asInput Returns Integer
            Integer iGrids
            Set pasSource of oWorker to asInput
            Get TransformSource of oWorker to iGrids
            Function_Return iGrids
        End_Function

        Function GetOutput Returns String[]
            String[] asResult
            Get pasSource of oWorker to asResult
            Function_Return asResult
        End_Function

        {Published = True}
        { Description = "Legacy data-loading procedure is renamed to LoadData" }
        Procedure DataLoadProc_RenamedToLoadData
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bLoadData bOldName

            Move "Object oGrid1 is a Grid"           to asInput[0]
            Move "    Set Form_Width 0 to 100"       to asInput[1]
            Move "    Procedure Fill_the_List"       to asInput[2]
            Move "        Send Add_Item Msg_None 42" to asInput[3]
            Move "    End_Procedure"                 to asInput[4]
            Move "End_Object"                        to asInput[5]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bLoadData
            Move False to bOldName
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "procedure loaddata") Move True to bLoadData
                If (Lowercase(asOutput[iIdx]) contains "procedure fill_the_list") Move True to bOldName
            Loop
            Send Assert (bLoadData and bOldName = False)
        End_Procedure

        {Published = True}
        { Description = "Send Add_Item is converted to TheData row assignment" }
        Procedure AddItem_ConvertedToTheData
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFound

            Move "Object oGrid1 is a Grid"            to asInput[0]
            Move "    Set Form_Width 0 to 100"        to asInput[1]
            Move '    Set Header_Label 0 to "Name"'   to asInput[2]
            Move "    Procedure Fill_the_List"        to asInput[3]
            Move '        Send Add_Item Msg_None "X"' to asInput[4]
            Move "    End_Procedure"                  to asInput[5]
            Move "End_Object"                         to asInput[6]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains 'TheData[iRow].sValue[iCol1]') Move True to bFound
            Loop
            Send Assert bFound
        End_Procedure

        // Legacy fill loops annotate each Add_Item with its column name. The comment used to
        // be parsed as part of the VALUE, so the generated " to TheData[iRow].sValue[iCol1]"
        // was appended AFTER it and commented out - leaving a one-argument "Move sStatus"
        // that the compiler rejects (LegacyApp's TekiFalt, 2026-07-26). The statement must be
        // complete and the annotation must survive at the end of the line.
        {Published = True}
        { Description = "Add_Item's trailing comment does not swallow the assignment target" }
        Procedure AddItem_TrailingCommentKeepsTarget
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFullStatement bCommentKept

            Move "Object oGrid1 is a Grid"                               to asInput[0]
            Move "    Set Form_Width 0 to 100"                           to asInput[1]
            Move "    Procedure Fill_the_List"                           to asInput[2]
            Move "        Send Add_Item Msg_None sStatus       //Status" to asInput[3]
            Move "    End_Procedure"                                     to asInput[4]
            Move "End_Object"                                            to asInput[5]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bFullStatement
            Move False to bCommentKept
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "Move sStatus to TheData[iRow].sValue[iCol1]") Begin
                    Move True to bFullStatement
                    If (asOutput[iIdx] contains "//Status") Move True to bCommentKept
                End
            Loop
            Send Assert bFullStatement
            Send Assert bCommentKept
        End_Procedure

        /* Injected var declarations must never be emitted at OBJECT level. DataFlex makes a
           declaration outside a method body a MODULE-SCOPE symbol, so a stranded
           "Integer iRow iCol" / "Handle hoDataSource" / "tDataSourceRow[] TheData" block
           defines those names globally and collides with every later declaration of the same
           name in the whole build - three such lines in one .sl produced 387 of LegacyApp's
           389 compile errors (Nils 2026-07-26). The buffer leaked when the data-loader rewrite
           consumed the method's End_Procedure before the reset could run, so the flush fired
           on the next line, already back at object level.

           The assertion is structural rather than string-matched: walk the output tracking
           method depth and fail on ANY declaration seen at depth 0. */
        {Published = True}
        { Description = "Injected var declarations never land at OBJECT level" }
        Procedure VarDecls_NeverOrphanedAtObjectLevel
            String[] asInput asOutput
            Integer  iGrids iIdx iDepth
            String   sLow
            Boolean  bOrphan

            // Mirrors the real shape: a Current_Item method (which switches var injection ON)
            // sitting BEFORE a separate data-load method whose End_Procedure the loader
            // rewrite emits itself. That is the combination that stranded the buffer.
            Move "Object oGrid1 is a Grid"                                to asInput[0]
            Move "    Property Boolean pbUpdatingList False"              to asInput[1]
            Move "    Set Form_Width 0 to 37"                             to asInput[2]
            Move '    Set Header_Label 0 to "Insert"'                     to asInput[3]
            Move "    Set Form_Width 1 to 273"                            to asInput[4]
            Move '    Set Header_Label 1 to "Type"'                       to asInput[5]
            Move "    Procedure Activating Returns Integer"               to asInput[6]
            Move "        Integer iRetVal iItem"                          to asInput[7]
            Move "        If ((Item_Count(Self)) > 1) Begin"              to asInput[8]
            Move "            Get Current_Item to iItem"                  to asInput[9]
            Move "        End"                                            to asInput[10]
            Move "        Procedure_Return iRetVal"                       to asInput[11]
            Move "    End_Procedure"                                      to asInput[12]
            Move "    Procedure Fill_the_List"                            to asInput[13]
            Move "        Send Delete_Data"                               to asInput[14]
            Move "        Send Add_Item Msg_None False"                   to asInput[15]
            Move "        Set Checkbox_Item_State (Item_Count (Self) - 1) to True" to asInput[16]
            Move '        Send Add_Item Msg_None (Trim(CODES.CODE))'      to asInput[17]
            Move "        Set Item_Shadow_State (Item_Count (Self) - 1) to True" to asInput[18]
            Move "    End_Procedure"                                      to asInput[19]
            Move "End_Object"                                             to asInput[20]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move 0     to iDepth
            Move False to bOrphan
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                Move (Lowercase(Trim(asOutput[iIdx]))) to sLow
                If (Left(sLow, 10) = "procedure " or Left(sLow, 9) = "function ") Begin
                    Increment iDepth
                End
                Else If (Left(sLow, 13) = "end_procedure" or Left(sLow, 12) = "end_function") Begin
                    If (iDepth > 0) Decrement iDepth
                End
                Else If (iDepth = 0) Begin
                    If (Left(sLow, 8)  = "integer "         or ;
                        Left(sLow, 7)  = "handle "          or ;
                        Left(sLow, 16) = "tdatasourcerow[]") Begin
                        Move True to bOrphan
                    End
                End
            Loop
            Send AssertFalse bOrphan
        End_Procedure

        /* The merged Integer declaration injects "iRow iCol1..iColN" and then appends the
           method's own Integer names. When the legacy method ALREADY declares iRow - a
           perfectly ordinary thing for a fill loop to do (LegacyApp's forsta_faktura
           AddEmptyItems) - the name landed in the statement twice:
               Integer iRow iCol1 ... iCol8 iRow
           which is a duplicate declaration the compiler rejects. The clashing name must be
           dropped INDIVIDUALLY - the method's other Integer variables still have to survive. */
        {Published = True}
        { Description = "A method that already declares iRow does not get it merged in twice" }
        Procedure MergedVarDecls_ExistingIRowNotDuplicated
            String[] asInput asOutput
            Integer  iGrids iIdx iPos
            String   sLow
            Boolean  bDuplicate bOtherKept bSawIntDecl

            Move "Object oGrid1 is a Grid"           to asInput[0]
            Move "    Set Form_Width 0 to 100"       to asInput[1]
            Move "    Set Form_Width 1 to 100"       to asInput[2]
            Move "    Procedure AddEmptyItems"       to asInput[3]
            Move "        Integer iRow iOther"       to asInput[4]
            Move '        Send Add_Item Msg_None ""' to asInput[5]
            Move "        Send Add_Item Msg_None 0"  to asInput[6]
            Move "    End_Procedure"                 to asInput[7]
            Move "End_Object"                        to asInput[8]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bDuplicate
            Move False to bOtherKept
            Move False to bSawIntDecl
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                Move (Lowercase(Trim(asOutput[iIdx]))) to sLow
                If (Left(sLow, 8) = "integer ") Begin
                    Move True to bSawIntDecl
                    Move (" " + sLow + " ") to sLow
                    If (sLow contains " iother ") Move True to bOtherKept
                    Move (Pos(" irow ", sLow)) to iPos
                    If (iPos > 0) Begin
                        // Resume at the trailing space so a second " irow " is still matched.
                        Move (Mid(sLow, CI_EOL, iPos + 5)) to sLow
                        If (sLow contains " irow ") Move True to bDuplicate
                    End
                End
            Loop
            Send Assert bSawIntDecl
            Send AssertFalse bDuplicate
            Send Assert bOtherKept
        End_Procedure

        {Published = True}
        { Description = "Increment iRow emitted after last column's Add_Item" }
        Procedure IncrementIRow_AfterLastColumn
            String[] asInput asOutput
            Integer  iGrids iIdx iMoveIdx iIncrIdx
            Boolean  bCorrectOrder

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move "    Set Form_Width 0 to 100"           to asInput[1]
            Move "    Set Form_Width 1 to 100"           to asInput[2]
            Move "    Procedure Populate"                to asInput[3]
            Move "        Send Add_Item Msg_None ColA"   to asInput[4]
            Move "        Send Add_Item Msg_None ColB"   to asInput[5]
            Move "    End_Procedure"                     to asInput[6]
            Move "End_Object"                            to asInput[7]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move -1 to iMoveIdx
            Move -1 to iIncrIdx
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (asOutput[iIdx] contains "TheData[iRow].sValue[iCol2]") Move iIdx to iMoveIdx
                If (Lowercase(asOutput[iIdx]) contains "increment irow")   Move iIdx to iIncrIdx
            Loop
            // Increment iRow must exist and come right after the last column Move
            Move (iMoveIdx >= 0 and iIncrIdx = iMoveIdx + 1) to bCorrectOrder
            Send Assert bCorrectOrder
        End_Procedure

        {Published = True}
        { Description = "Get piColumnId calls are inserted after variable declarations" }
        Procedure GetPiColumnId_Inserted
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bCol1 bCol2

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move "    Set Form_Width 0 to 100"           to asInput[1]
            Move "    Set Form_Width 1 to 100"           to asInput[2]
            Move "    Procedure Fill_the_List"           to asInput[3]
            Move "        Send Add_Item Msg_None X"      to asInput[4]
            Move "        Send Add_Item Msg_None Y"      to asInput[5]
            Move "    End_Procedure"                     to asInput[6]
            Move "End_Object"                            to asInput[7]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bCol1
            Move False to bCol2
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "get picolumnid of ocol1") Move True to bCol1
                If (Lowercase(asOutput[iIdx]) contains "get picolumnid of ocol2") Move True to bCol2
            Loop
            Send Assert (bCol1 and bCol2)
        End_Procedure

        {Published = True}
        { Description = "Existing Integer vars are merged with new iRow/iColN vars" }
        Procedure IntegerVars_Merged
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bFound

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move "    Set Form_Width 0 to 100"           to asInput[1]
            Move "    Procedure Fill_the_List"           to asInput[2]
            Move "        Integer iCount"                to asInput[3]
            Move "        Send Add_Item Msg_None iCount" to asInput[4]
            Move "    End_Procedure"                     to asInput[5]
            Move "End_Object"                            to asInput[6]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            // One Integer line must contain both iRow/iCol1 (new) and iCount (original)
            Move False to bFound
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "integer " and ;
                    asOutput[iIdx] contains "iRow" and ;
                    asOutput[iIdx] contains "iCol1" and ;
                    asOutput[iIdx] contains "iCount") Begin
                    Move True to bFound
                End
            Loop
            Send Assert bFound
        End_Procedure

        {Published = True}
        { Description = "If/Else ReInitializeData block is appended before End_Procedure" }
        Procedure IfElseBlock_Generated
            String[] asInput asOutput
            Integer  iGrids iIdx
            Boolean  bReInit bInitEmpty

            Move "Object oGrid1 is a Grid"               to asInput[0]
            Move "    Set Form_Width 0 to 100"           to asInput[1]
            Move "    Procedure Fill_the_List"           to asInput[2]
            Move "        Send Add_Item Msg_None X"      to asInput[3]
            Move "    End_Procedure"                     to asInput[4]
            Move "End_Object"                            to asInput[5]

            Get RunTransform asInput to iGrids
            Get GetOutput            to asOutput

            Move False to bReInit
            Move False to bInitEmpty
            For iIdx from 0 to (SizeOfArray(asOutput) - 1)
                If (Lowercase(asOutput[iIdx]) contains "send reinitializedata") Move True to bReInit
                If (Lowercase(asOutput[iIdx]) contains "send initializedata")   Move True to bInitEmpty
            Loop
            Send Assert (bReInit and bInitEmpty)
        End_Procedure

