//****************************************************************************
// ProgramSetupFT.dg - the FT (FlexTron) copy of ProgramSetup.dg: Program Settings, one page of web controls.
// The native original (ProgramSetup.dg) stays for the other programs; only DFRefactorFT Uses this copy.
//
// THE PAGE (Nils 2026-10-01: "convert the whole ProgramSetupFT to cFT objects"), built as CompilerSetupFT's:
//   - ONE data-aware grid host of 8 px columns, cFTDbGridHost (oSetupPage), owns the SysFile DD. The three
//     SysFile fields - backup days and the two program paths - are cFTWebForms bound to it (Entry_Item);
//     the other settings live in the registry, as before, and their controls are seeded from it.
//   - The seven sections are cFTWebHtmlBoxes: the title is the box's label, with the section's glyph in
//     front of it (its ftg- class), and the note under it is the content, with the download links where a
//     section has them. programsetup.css styles them.
//   - The check boxes and combos are web controls, which take the FT colours themselves - no caption
//     TextBoxes beside the check boxes, no combos refusing the dark colours. A combo holds a value and a
//     caption for each item, so the toolbar icon size and the tab-page position are numbers.
//   - Backup days and the Studio version are number fields: Save checks the days (1 to 365, as the spin
//     form allowed), Add to Studio the version.
//   - Each program path has a Browse... button. A web form's prompt would open the file dialog inside the
//     web click (err 4410); the button opens it after the click (OnButtonClick).
//   - Save goes live when a saved setting changes: its control reports the change (OnChange -> MarkChanged).
//   - DoSave reads every value with WebGet and saves the DD with a TARGETED Request_Save - never a Broadcast
//     Recursive, which faults err 98 GET_SERVERDEO on the web controls (CompilerSetupFT).
//****************************************************************************
Use File_dlg.pkg                 // OpenDialog - the Browse... buttons
Use cRegistry.pkg                // AddProgramToStudioToolsMenu - the Studio's Tools menu keys
Use vWin32fh.pkg                 // vFolderFormat - AddProgramToStudioToolsMenu

Use cFTDbModalPanel.pkg
Use RefactorConstants.h.pkg
Use FTConstants.h.pkg            // CI_FTTheme* and where the theme choice is saved
Use FTAllWebControlClasses.pkg   // the web controls: cFTWebForm, cFTWebCombo, cFTWebCheckbox, cFTWebHtmlBox, cFTWebButton
Use FTMarkupBuilders.pkg         // the section notes' markup - DivOpen, ClickableHtml, CssLink
Use cFTDbGridHost.pkg            // FT: the page - a data-aware host on a grid of 8 px columns (RDCFlexTron)
Use cFTGridHost.pkg              // FT: the Save / Close bar's host (RDCFlexTron)
Use FTThemeColors.pkg            // FTWebBg / FTCJTheme - the FT palette

Use cSysFileDataDictionary.dd

Object oProgramSetup_dg is a cFTDbModalPanel
    Set Size to 405 400
    Set Label to "Program Settings"
    Set piMinSize to 79 211
    Set Location to 1 2
    Set Icon to "Settings.ico"

    // A saved setting has changed since the dialog opened or was last saved - Save is live (SaveIsEnabled).
    Property Boolean pbFTChanged False

    Object oOpenDialog is a OpenDialog
        Set Dialog_Caption to "Select a program"
        Set Filter_String to "Programs|*.exe|Any file|*.*"
    End_Object

    // A saved setting's control reports a change here (its OnChange).
    Procedure MarkChanged
        Set pbFTChanged to True
    End_Procedure

    /* THE DOWNLOAD LINKS are RefactorConstants.h.pkg's anchors for the native dialog's link labels
       ('<A href="http://...">Text</A>'). The address and the text are taken out of them, so each link is
       written in one place. Defined above SectionHtml, which calls them in an expression. */
    Function AnchorUrl String sAnchor Returns String
        String sRest
        Move (Mid(sAnchor, Length(sAnchor), (Pos('href="', sAnchor) + 6))) to sRest
        Function_Return (Left(sRest, (Pos('"', sRest) - 1)))
    End_Function

    Function AnchorText String sAnchor Returns String
        String sRest
        Move (Mid(sAnchor, Length(sAnchor), (Pos(">", sAnchor) + 1))) to sRest
        Function_Return (Left(sRest, (Pos("<", sRest) - 1)))
    End_Function

    /* A SECTION BOX's content: the style sheets, then the note - text, so escaped: Backup's holds a "<" -
       followed by the download links, each a span whose click opens its address (the box's OnClick). A
       section with neither note nor links gets the style sheets only. Defined above the page, whose boxes
       call it in an expression. */
    Function SectionHtml String sNote String[] asAnchors Returns String
        String sHtml
        Integer i
        Move (CS_PaletteCssLink + CssLink("programsetup")) to sHtml
        If ((sNote = "") and (SizeOfArray(asAnchors) = 0)) ;
            Function_Return sHtml
        Move (sHtml + DivOpen("psnote") + FTHtmlEscape(sNote)) to sHtml
        For i from 0 to (SizeOfArray(asAnchors) - 1)
            Move (sHtml + " " + ClickableHtml("span", "pslink", "link", AnchorUrl(Self, asAnchors[i]), ;
                AnchorText(Self, asAnchors[i]), "Opens the page in your web browser")) to sHtml
        Loop
        Function_Return (sHtml + CS_DivEnd)
    End_Function

    /* THE PAGE: one data-aware grid host of 8 px columns (cFTDbGridHost) that owns the DD, as CompilerSetupFT's.
       Each section is a box over the full width, and its settings sit in the rows under it, 4 columns in - the
       title's text starts there, past the glyph. Columns 0..69 are 8 px; column 70 takes what the dialog has
       beyond them. Every row is at least an FT row (33 px) and a section box grows to its note. */
    Object oSetupPage is a cFTDbGridHost
        Set Location to 6 8
        Set Size to 365 384
        Set peAnchors to anAll
        Set piColumnCount to 71         // columns 0..69, then column 70 for the rest of the width
        Set psColumnWidths to "70/1fr"

        Object oSysFile_DD is a cSysFileDataDictionary
        End_Object

        Set Main_DD to oSysFile_DD
        Set Server  to oSysFile_DD

        Object oBackup_hb is a cFTWebHtmlBox
            Set piRowIndex to 0
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Backup Files Setting"
            Set psCSSClass to "pssect ftg-save"
            Set psToolTip to "Number of days before overwriting Backup files. Backup files will be created in backup folders <workspace name>\DFRefactor Backup\..."
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">Backup files will be created in: &lt;workspace name>\DFRefactor Backup\...</div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Set psHtml to (SectionHtml(Self, "Backup files will be created in: <workspace name>\DFRefactor Backup\...", asLinks))
            End_Procedure
        End_Object

        // A number field: Save checks it is 1 to 365, as the spin form allowed.
        Object oBackupDays_wf is a cFTWebForm
            Entry_Item SysFile.iBackupDaysOverwriteCycle
            Set Server to oSysFile_DD
            Set piRowIndex to 1
            Set piColumnIndex to 4
            Set piColumnSpan to 30
            Set piLabelOffset to 190
            Set psLabel to "No of Days for Overwrite Cycle:"
            Set psToolTip to "After x number of days the files in the backup folder gets overwritten by new refactored files. Good for when applying one or a few functions at a time, as you then don't want the original to get overwritten by the next selection of refactoring function(s). 1 to 365 days."

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oSourceExplorer_hb is a cFTWebHtmlBox
            Set piRowIndex to 2
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Starzen's DataFlex Source Explorer"
            Set psCSSClass to "pssect ftg-code"
            Set psToolTip to "This tool needs to be downloaded and installed separately"
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">The Starzen's tool can be downloaded from: <span class="pslink" data-ServerOnClick="link"
                data-OnClickParam="http://www.starzen.com/products/dataflex-tools/dataflex-source-code-browser"
                title="Opens the page in your web browser">Starzen.com</span></div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Move CS_LinkStarzen to asLinks[-1]
                Set psHtml to (SectionHtml(Self, "The Starzen's tool can be downloaded from:", asLinks))
            End_Procedure

            // A download link: the address is the link's OnClick parameter (SectionHtml).
            Procedure OnClick String sId String sParam
                If (sId = "link") Begin
                    Runprogram Shell Background sParam
                End
            End_Procedure
        End_Object

        /* A PROGRAM PATH and its Browse... button share a group of their own, with no border and no caption
           (Nils 2026-10-01: the path anchored left and right, the button top-right). A web grid has no anchors,
           and on this page's grid a column that stretches stretches every control across it - the combos, Add
           to Studio. The group's own grid has two columns: the path's takes the width, the button's is 112 px.
           The group spans to the page's column 70, which takes what the dialog gains, so the path grows with the
           dialog and the button keeps to its right edge. The framework gives such a group no margin and no
           padding (system.css), so the pair sits as the other rows do. */
        Object oSourceExplorerPath_grp is a cWebGroup
            Set piRowIndex to 3
            Set piColumnIndex to 4
            Set piColumnSpan to 67
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set peLayoutType to ltGrid
            Set piColumnCount to 2
            Set psColumnWidths to "1/112px"     // column 0 the path (1fr), column 1 the button - 14 columns of 8 px
            Set psDefaultRowHeight to "minmax(var(--ft-row, 33px), max-content)"

            Object oSourceExplorer_wf is a cFTWebForm
                Entry_Item SysFile.PathStarZen
                Set Server to oSysFile_DD
                Set piRowIndex to 0
                Set piColumnIndex to 0
                Set piColumnSpan to 1
                Set piLabelOffset to 115
                Set psLabel to "Path and file name:"

                Procedure OnChange String sNewValue String sOldValue
                    Send MarkChanged
                End_Procedure
            End_Object

            Object oSourceExplorerBrowse_btn is a cFTWebButton
                Set piRowIndex to 0
                Set piColumnIndex to 1
                Set piColumnSpan to 1
                Set psCaption to "Browse..."
                Set psCSSClass to "ftbtn ftg-folderopen"
                Set psToolTip to "Find the program on disk."

                // After the web click: the file dialog cannot open inside it (err 4410).
                Procedure OnButtonClick
                    Send BrowseForProgram of oProgramSetup_dg (oSourceExplorer_wf(Self))
                End_Procedure
            End_Object
        End_Object

        Object oCompare_hb is a cFTWebHtmlBox
            Set piRowIndex to 4
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Compare Tool"
            Set psCSSClass to "pssect ftg-compare"
            Set psToolTip to "This tool needs to be downloaded and installed separately"
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">Select a file comparison tool like: <span class="pslink" data-ServerOnClick="link"
                data-OnClickParam="http://www.scootersoftware.com"
                title="Opens the page in your web browser">Beyond Compare</span> <span class="pslink" data-ServerOnClick="link"
                data-OnClickParam="http://www.winmerge.org"
                title="Opens the page in your web browser">WinMerge</span> <span class="pslink" data-ServerOnClick="link"
                data-OnClickParam="http://www.araxis.com/merge"
                title="Opens the page in your web browser">Araxis Merge</span></div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Move CS_LinkBeyondCompare to asLinks[-1]
                Move CS_LinkWinMerge to asLinks[-1]
                Move CS_LinkAraxisMerge to asLinks[-1]
                Set psHtml to (SectionHtml(Self, "Select a file comparison tool like:", asLinks))
            End_Procedure

            // A download link: the address is the link's OnClick parameter (SectionHtml).
            Procedure OnClick String sId String sParam
                If (sId = "link") Begin
                    Runprogram Shell Background sParam
                End
            End_Procedure
        End_Object

        Object oComparePath_grp is a cWebGroup
            Set piRowIndex to 5
            Set piColumnIndex to 4
            Set piColumnSpan to 67
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set peLayoutType to ltGrid
            Set piColumnCount to 2
            Set psColumnWidths to "1/112px"     // column 0 the path (1fr), column 1 the button - 14 columns of 8 px
            Set psDefaultRowHeight to "minmax(var(--ft-row, 33px), max-content)"

            Object oCompare_wf is a cFTWebForm
                Entry_Item SysFile.PathSourceCompareTool
                Set Server to oSysFile_DD
                Set piRowIndex to 0
                Set piColumnIndex to 0
                Set piColumnSpan to 1
                Set piLabelOffset to 115
                Set psLabel to "Path and file name:"
                Set psToolTip to "Select a file comparison tool, such as 'Beyond Compare', 'WinMerge', 'Araxis Merge' etc.."

                Procedure OnChange String sNewValue String sOldValue
                    Send MarkChanged
                End_Procedure
            End_Object

            Object oCompareBrowse_btn is a cFTWebButton
                Set piRowIndex to 0
                Set piColumnIndex to 1
                Set piColumnSpan to 1
                Set psCaption to "Browse..."
                Set psCSSClass to "ftbtn ftg-folderopen"
                Set psToolTip to "Find the program on disk."

                // After the web click: the file dialog cannot open inside it (err 4410).
                Procedure OnButtonClick
                    Send BrowseForProgram of oProgramSetup_dg (oCompare_wf(Self))
                End_Procedure
            End_Object
        End_Object

        Object oVisual_hb is a cFTWebHtmlBox
            Set piRowIndex to 6
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Visual Settings"
            Set psCSSClass to "pssect ftg-eye"
            Set psToolTip to "Various visual program settings."
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Set psHtml to (SectionHtml(Self, "", asLinks))
            End_Procedure
        End_Object

        /* THE COMBOS: an item is a value and a caption (AddComboItem), and OnFill selects the saved value
           (psValue). Toolbar Icon Size, the toolbar text and the tab-page position keep a number, which DoSave
           reads as it is. The right column's labels are 85 px wide (95 until 2026-10-04): the toolbar text's
           "Show Icon Descriptions" is 123 px at the page's 12 px Segoe UI and did not fit beside a 95 px label. */
        Object oToolbarIconSize_wc is a cFTWebCombo
            Set piRowIndex to 7
            Set piColumnIndex to 4
            Set piColumnSpan to 34
            Set piLabelOffset to 135
            Set psLabel to "Toolbar Icon Size"
            Set peSortItems to csUnsorted

            Procedure OnFill
                Integer iSize
                Send AddComboItem "16" "16x16 Icons"
                Send AddComboItem "24" "24x24 Icons"
                Send AddComboItem "32" "32x32 Icons"
                Get piToolbarIconSize of ghoApplication to iSize
                Set psValue to iSize
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oGridRowColor_wc is a cFTWebCombo
            Set piRowIndex to 7
            Set piColumnIndex to 40
            Set piColumnSpan to 30
            Set piLabelOffset to 85
            Set psLabel to "Grid row color"
            Set psToolTip to "Sets the current row background color (piSelectedRowBackColor)"
            Set peSortItems to csUnsorted

            Procedure OnFill
                String sColor
                String[] asColors
                Integer i
                Move (StrSplitToArray("clActiveRow clGreenGreyLight clGreenGrey clStatusBarColor clEditorBackGround clNone clAqua clBlack clBlue clDkGray clFuchsia clGray clGreen clLime clLtGray clMaroon clNavy clOlive clPurple clRed clSilver clTeal", " ")) to asColors
                For i from 0 to (SizeOfArray(asColors) - 1)
                    Send AddComboItem asColors[i] asColors[i]
                Loop
                Get psGridRowBackgroundColor of ghoApplication to sColor
                Set psValue to sColor
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oTabPagePosition_wc is a cFTWebCombo
            Set piRowIndex to 8
            Set piColumnIndex to 4
            Set piColumnSpan to 34
            Set piLabelOffset to 135
            Set psLabel to "Position for tab-pages"
            Set peSortItems to csUnsorted

            Procedure OnFill
                Integer iType
                Send AddComboItem xtpTabPositionTop    "Top"
                Send AddComboItem xtpTabPositionLeft   "Left"
                Send AddComboItem xtpTabPositionBottom "Bottom"
                Send AddComboItem xtpTabPositionRight  "Right"
                Get peTabpagePosition of ghoApplication to iType
                Set psValue to iType
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oGridFontSize_wc is a cFTWebCombo
            Set piRowIndex to 8
            Set piColumnIndex to 40
            Set piColumnSpan to 30
            Set piLabelOffset to 85
            Set psLabel to "Grid font size"
            Set psToolTip to "Sets the font size for grids"
            Set peSortItems to csUnsorted

            Procedure OnFill
                Integer iSize
                For iSize from 6 to 16
                    Send AddComboItem iSize iSize
                Loop
                Get ReadInteger of ghoApplication CS_Settings CS_GridFontSize 10 to iSize
                Set psValue to iSize
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        /* COLOUR THEME. Written to CS_FTTheme; the FlexTron hosts read it as they are built
           (cFTThemeHost_mixin.pkg), so a change needs a restart - which Save says, and does, rather than
           leaving the user to wonder why nothing happened. "Follow Windows" is the framework's own
           tpSystemPreference, which follows the Windows setting live. */
        Object oFTTheme_wc is a cFTWebCombo
            Set piRowIndex to 9
            Set piColumnIndex to 4
            Set piColumnSpan to 34
            Set piLabelOffset to 135
            Set psLabel to "Colour theme"
            Set psToolTip to "Dark, Light, or follow the Windows setting. Takes effect after a restart."
            Set peSortItems to csUnsorted

            Procedure OnFill
                Integer iMode
                Send AddComboItem CI_FTThemeDark   CS_FTThemeDarkText
                Send AddComboItem CI_FTThemeLight  CS_FTThemeLightText
                Send AddComboItem CI_FTThemeSystem CS_FTThemeSystemText
                Get ReadInteger of ghoApplication CS_FTThemeSection CS_FTTheme CI_FTThemeDark to iMode
                Set psValue to iMode
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        /* THE TOOLBAR TEXT (Nils 2026-10-04: the toolbar takes a lot of horizontal space). Shown, a toolbar item
           that has a caption shows it beside its icon; hidden, the icon alone - the icon-only items stay as they
           are. The value is the CodeJock button style itself, saved in the registry (peToolbarButtonStyle) and
           applied at once by the command bar system (ApplyToolbarButtonStyle, DFRefactorFT.src). */
        Object oToolbarButtonStyle_wc is a cFTWebCombo
            Set piRowIndex to 9
            Set piColumnIndex to 40
            Set piColumnSpan to 30
            Set piLabelOffset to 85
            Set psLabel to "Toolbar"
            Set psToolTip to "Show or hide the text beside the toolbar icons. Hidden, the toolbar takes much less room."
            Set peSortItems to csUnsorted

            Procedure OnFill
                Integer eStyle
                Send AddComboItem xtpButtonIconAndCaption "Show Icon Descriptions"
                Send AddComboItem xtpButtonIcon           "Hide Icon Descriptions"
                Get peToolbarButtonStyle of ghoApplication to eStyle
                Set psValue to eStyle
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        /* RETIRED 2026-08-12: 'Position for Modernize dialog'. The Test Compile bar now pins itself
           to xtpBarBottom at design time (TestCompileFT.dg) because cRDCCJToolPanel reads peBarPosition
           when it ADDS the dialog bar - a bar that is already docked does not move when the property
           changes later, so the control could only ever appear to work. It is gone rather than
           disabled: a setting that silently does nothing is worse than no setting.
           The stored ModernizePanelPosition value is left in the registry untouched (harmless, and
           deleting a user's saved state to tidy up is not this dialog's business). */

        Object oEngine_hb is a cFTWebHtmlBox
            Set piRowIndex to 10
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Refactor Engine Settings"
            Set psCSSClass to "pssect ftg-play"
            Set psToolTip to "Should a question be asked before starting the refactoring Engine, and should a Summary be shown automatically be shown at the end."
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">Handle how the Engine starts and ends</div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Set psHtml to (SectionHtml(Self, "Handle how the Engine starts and ends", asLinks))
            End_Procedure
        End_Object

        /* THE CHECK BOXES are registry settings: seeded from the registry as they are built, written by DoSave.
           psChecked / psUnchecked are the values the registry holds. */
        Object oShowStartQuestion_cb is a cFTWebCheckbox
            Set piRowIndex to 11
            Set piColumnIndex to 4
            Set piColumnSpan to 30
            Set psCaption to "Show start question"
            Set psToolTip to "Show a 'Yes/No' question, with informative text, before starting the refactoring engine?"
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set pbServerOnChange to True

            Procedure End_Construct_Object
                Integer iVal
                Forward Send End_Construct_Object
                Get ReadInteger of ghoApplication CS_Settings CS_ShowQuestion True to iVal
                Set psValue to iVal
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oShowSummary_cb is a cFTWebCheckbox
            Set piRowIndex to 11
            Set piColumnIndex to 40
            Set piColumnSpan to 30
            Set psCaption to "Show Summary"
            Set psToolTip to "Should the summary dialog be automatically shown after the refactoring engine is done? The summary can also be shown by clicking the toolbar's 'View log file'."
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set pbServerOnChange to True

            Procedure End_Construct_Object
                Integer iVal
                Forward Send End_Construct_Object
                Get ReadInteger of ghoApplication CS_Settings CS_ShowSummary True to iVal
                Set psValue to iVal
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object

        Object oStudio_hb is a cFTWebHtmlBox
            Set piRowIndex to 12
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "DataFlex Studio Integration"
            Set psCSSClass to "pssect ftg-add"
            Set psToolTip to "Adds this tool to the Studio's 'Tools' menu for easy access"
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">Add to Studio's Tools Menu</div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Set psHtml to (SectionHtml(Self, "Add to Studio's Tools Menu", asLinks))
            End_Procedure
        End_Object

        /* THE STUDIO VERSION feeds Add to Studio only - nothing here to save, so the two report no change. Number
           fields: Add to Studio checks the major version, as it did. */
        Object oStudioMajor_wf is a cFTWebForm
            Set piRowIndex to 13
            Set piColumnIndex to 4
            Set piColumnSpan to 22
            Set piLabelOffset to 95
            Set psLabel to "Major Version"
            Set psToolTip to "DataFlex main version - e.g. '23'"
            Set peDataType to typeNumber
            Set piPrecision to 0
            Set piMaxLength to 4
            Set psValue to FMAC_VERSION
        End_Object

        Object oStudioMinor_wf is a cFTWebForm
            Set piRowIndex to 13
            Set piColumnIndex to 28
            Set piColumnSpan to 22
            Set piLabelOffset to 95
            Set psLabel to "Minor Version"
            Set psToolTip to "DataFlex minor version - e.g. '0'"
            Set peDataType to typeNumber
            Set piPrecision to 0
            Set piMaxLength to 1
            Set psValue to FMAC_REVISION
        End_Object

        /* ADD TO STUDIO adds the program to that Studio's Tools menu (AddProgramToStudioToolsMenu, on the panel) and
           says how it went in a message box - so it runs in OnButtonClick, after the web click has returned (the
           library's click relay): a message box faults err 4410 inside the click. 16 columns fit "Add to Studio"
           with its glyph (~116 px, measured 2026-09-30). */
        Object oAddToStudioBtn is a cFTWebButton
            Set piRowIndex to 13
            Set piColumnIndex to 54
            Set piColumnSpan to 16
            Set psCaption to "Add to Studio"
            Set psCSSClass to "ftbtn ftg-add"
            Set psToolTip to "Add to DataFlex Studio's Tools menu. The Studio version can be selected with the two version fields. The program gets added to the Studios Tools menu. When selected from the Studio it will pass the current project name on the command line so that the current program's manifest file is automatically loaded by the program."

            Procedure OnButtonClick
                Integer iRetval iMajorVersion iMinorVersion
                String sText sStudioVersion

                WebGet psValue of oStudioMajor_wf to iMajorVersion
                WebGet psValue of oStudioMinor_wf to iMinorVersion
                If (iMajorVersion < 14) Begin
                    Send FTInfoBox ("Really? You have a DataFlex Studio version" * String(iMajorVersion) * "and expect this to work?")
                    Procedure_Return
                End
                Move (String(iMajorVersion) + "." + String(iMinorVersion)) to sStudioVersion
                Get AddProgramToStudioToolsMenu of oProgramSetup_dg sStudioVersion to iRetval

                Case Begin
                    Case (iRetval = cx_RegKeyAlreadyExist)
                        Move ("The program already exists in the" * sStudioVersion * "DataFlex Studios Tools menu.") to sText
                        Break
                    Case (iRetval = cx_RegKeyCreated)
                        Move ("Success. The tool was added to the" * sStudioVersion *  "DataFlex Studios Tools menu.") to sText
                        Break
                    Case (iRetval = cx_RegkeyFailed)
                        Move "Failed. Could not create the registry key For adding the program to the DataFlex Studio's Tools menu." to sText
                        Break
                    Case (iRetval = cx_RegKeyDFKeyDoesNotExist)
                        Move ("Could not find the Studio registry key. Is DataFlex Studio version" * sStudioVersion * "really installed on this machine?") to sText
                        Break
                    Case (iRetval = cx_InstalledOkDFUnder16)
                        Move ("The program was added to the" * sStudioVersion * "Studios Tools menu successfully, but because you installed For an earlier version of the Studio than 16.0 you need to compile the program under that same VDF version, else the Studio can't start the program properly. (Sorry, just a 'feature' of earlier versions of the Studio)") to sText
                        Break
                Case End

                Send FTInfoBox sText
            End_Procedure
        End_Object

        Object oPackageUpdates_hb is a cFTWebHtmlBox
            Set piRowIndex to 14
            Set piColumnSpan to 70
            Set pbShowLabel to True
            Set peLabelPosition to lpTop
            Set psLabel to "Library and Package Updates"
            Set psCSSClass to "pssect ftg-download"
            Set psToolTip to "The Libraries tile can report that a package or git library has a newer version than the one this workspace is pinned to. The check only reads - it never installs anything - and it asks once per workspace."
            // DESIGN-TIME PLACEHOLDER for the Studio's Windows Designer, which models the LAST literal
            // psHtml it can parse; the runtime markup is built in End_Construct_Object (SectionHtml).
            Set psHtml to """
            <link rel="stylesheet" href="RDCFlexTron/palette.css">
            <link rel="stylesheet" href="RDCFlexTron/buttons.css">
            <link rel="stylesheet" href="RDCFlexTron/bars.css">
            <link rel="stylesheet" href="CssStyle/programsetup.css">
            <div class="psnote">Ask each remote what is newer when a workspace is opened</div>
            """

            Procedure End_Construct_Object
                String[] asLinks
                Forward Send End_Construct_Object
                Set psHtml to (SectionHtml(Self, "Ask each remote what is newer when a workspace is opened", asLinks))
            End_Procedure
        End_Object

        Object oCheckPackageUpdates_cb is a cFTWebCheckbox
            Set piRowIndex to 15
            Set piColumnIndex to 4
            Set piColumnSpan to 50
            Set psCaption to "Check for package updates on workspace load"
            Set psToolTip to "Off means the Libraries tile says nothing about updates and no network call is made. The Update Check button in the Libraries dialog still works either way - this only governs the automatic check."
            Set psChecked to "1"
            Set psUnchecked to "0"
            Set pbServerOnChange to True

            Procedure End_Construct_Object
                Integer iVal
                Forward Send End_Construct_Object
                Get ReadInteger of ghoApplication CS_Settings CS_CheckPackageUpdates True to iVal
                Set psValue to iVal
            End_Procedure

            Procedure OnChange String sNewValue String sOldValue
                Send MarkChanged
            End_Procedure
        End_Object
    End_Object

    /* SAVE + CLOSE - framework buttons (cFTWebButton, RDCFlexTron) on a grid host of 8 px columns since
       2026-09-30, right-aligned: column 0 takes the rest of the width. They were one FlexTron band of chips
       from 2026-08-14 (replacing two cRDCButtonDPIs). Save is live only when something has changed -
       oPSSaveIdle below watches SaveIsEnabled - and says so in its tooltip when it is not. Both run in
       OnButtonClick, after the web click has returned (the library's click relay): DoSave pops an Info_Box and
       can call Exit_Application, and Close_Panel ends the modal - all of which fault err 4410 inside the click,
       which is what oPSDeferTimer was for. A plain grid host, not the data-aware one: the bar holds no field
       bound to the DD.

       Under the page, 12 units above the panel's bottom edge, as before. The page of web controls needs a little
       less height than the groups did, so the panel, the page and this bar moved up 20 units together - one FT
       row (Nils 2026-10-01). Four rows hid the last check box: most of the gap there was padding, under the
       page's last row and above these buttons. */
    Object oWebButtonBar is a cFTGridHost
        Set Location to 375 8
        Set Size to 20 384
        Set peAnchors to anBottomLeftRight
        Set piColumnCount to 23         // column 0, then Save's 11 and Close's 11
        Set psColumnWidths to "0/1fr"   // column 0 takes the extra width

        Object oSaveBtn is a cFTWebButton
            Set piColumnIndex to 1
            Set piColumnSpan to 11
            Set psCaption to "Save"
            Set psCSSClass to "ftbtn ftg-check"
            Set pbEnabled to False
            Set psToolTip to "Nothing has changed yet"

            Procedure OnButtonClick
                Send DoSave of oProgramSetup_dg
            End_Procedure
        End_Object

        Object oCloseBtn is a cFTWebButton
            Set piColumnIndex to 12
            Set piColumnSpan to 11
            Set psCaption to "Close"
            Set psCSSClass to "ftbtn ftg-close"

            Procedure OnButtonClick
                Send Close_Panel of oProgramSetup_dg
            End_Procedure
        End_Object

        /* Save's state follows SaveIsEnabled: live when something has changed, shut - with "Nothing has changed
           yet" as its tooltip - when not (a live Save must not claim that nothing has changed). Stored for a page
           that loads and pushed to a page that is up, only when the answer flips. Below the buttons, because it
           names one - an object is known only below its definition. */
        Object oPSSaveIdle is a cIdleHandler
            Set pbEnabled to True
            Procedure OnIdle
                Boolean bEnabled
                Handle hoBar hoSave

                Get SaveIsEnabled of oProgramSetup_dg to bEnabled
                Move (Parent(Self)) to hoBar
                Move (oSaveBtn(hoBar)) to hoSave
                If (pbEnabled(hoSave) = bEnabled) ;
                    Procedure_Return
                Send UpdateEnabled of hoSave bEnabled
                Send UpdateToolTip of hoSave (If(bEnabled, "", "Nothing has changed yet"))
                If (not(pbInitWebApp(hoBar))) ;
                    Send CheckUpdateWebUI of hoBar
            End_Procedure
        End_Object
    End_Object

    // Browse... for one of the two program paths, after the web click: the file dialog, then the pick into the
    // field - unsaved until Save, as a typed path is.
    Procedure BrowseForProgram Handle hoForm
        Boolean bOpen
        String sFileName
        Get Show_Dialog of oOpenDialog to bOpen
        If (bOpen) Begin
            Get File_Name of oOpenDialog to sFileName
            WebSet psValue of hoForm to sFileName
            Send MarkChanged
        End
    End_Procedure

    /* SAVE - from the Save button's OnButtonClick (after the web click) and Alt+O / Ctrl+S. Each value is read
       from its web control (WebGet) and saved where it lives: the three SysFile fields through the DD - a
       TARGETED save, never a Broadcast Recursive (see the top) - and the rest in the registry, through the
       application's properties, as the native dialog did. */
    Procedure DoSave
        String sValue sOldValue sProgram sStarZen sCompare
        Integer iDays iIconSize iOldIconSize eMode eOldMode iSize iOldSize iTheme iOldTheme eStyle eOldStyle
        Boolean bThemeChanged bChecked

        // Backup days: a number field now - the spin form kept it to 1..365, this check does.
        WebGet psValue of oBackupDays_wf to sValue
        Move sValue to iDays
        If ((iDays < 1) or (iDays > 365)) Begin
            Send FTInfoBox "The overwrite cycle is 1 to 365 days." "Backup Files Setting"
            Procedure_Return
        End
        WebGet psValue of oSourceExplorer_wf to sStarZen
        WebGet psValue of oCompare_wf        to sCompare
        Set Field_Changed_Value of oSysFile_DD Field SysFile.iBackupDaysOverwriteCycle to iDays
        Set Field_Changed_Value of oSysFile_DD Field SysFile.PathStarZen               to sStarZen
        Set Field_Changed_Value of oSysFile_DD Field SysFile.PathSourceCompareTool     to sCompare
        Send Request_Save of oSysFile_DD
        Set psStarZenSourceExplorer    of ghoApplication to sStarZen
        Set psFileCompareApp           of ghoApplication to sCompare
        Set piBackupDaysOverwriteCycle of ghoApplication to iDays

        WebGet psValue of oToolbarIconSize_wc to iIconSize
        Get piToolbarIconSize of ghoApplication to iOldIconSize
        If (iIconSize <> iOldIconSize) Begin
            Set piToolbarIconSize of ghoApplication to iIconSize
            Send DisplayTabWorkspace to ghoCommandBars
        End

        // The toolbar text, shown or hidden at once: the command bar system restyles the items that have a caption.
        WebGet psValue of oToolbarButtonStyle_wc to eStyle
        If (eStyle <> xtpButtonIcon) ;
            Move xtpButtonIconAndCaption to eStyle
        Get peToolbarButtonStyle of ghoApplication to eOldStyle
        If (eStyle <> eOldStyle) Begin
            Set peToolbarButtonStyle of ghoApplication to eStyle
            Send ApplyToolbarButtonStyle to ghoCommandBars
        End

        // The tab-page position's NUMBER. The native combo held the constant's NAME as text, and DoSave moved
        // that text into an Integer - a name, where a number was wanted.
        WebGet psValue of oTabPagePosition_wc to eMode
        Get peTabpagePosition of ghoApplication to eOldMode
        If (eMode <> eOldMode) Begin
            Set peTabpagePosition of ghoApplication to eMode
            Send DisplayTabWorkspace to ghoCommandBars
        End

        WebGet psValue of oGridRowColor_wc to sValue
        If (sValue = "") Begin
            Move clActiveRow to sValue
        End
        Get psGridRowBackgroundColor of ghoApplication to sOldValue
        If (sValue <> sOldValue) Begin
            Set psGridRowBackgroundColor of ghoApplication to sValue
        End

        WebGet psValue of oGridFontSize_wc to iSize
        Get ReadInteger   of ghoApplication CS_Settings CS_GridFontSize 9 to iOldSize
        If (iSize <> iOldSize) Begin
            Send WriteInteger of ghoApplication CS_Settings CS_GridFontSize iSize
            Broadcast Recursive Send DoChangeFontSize of (Client_Id(ghoCommandBars))
        End

        // Colour theme. Every FlexTron host reads this as it constructs, and the ones already
        // built cannot be re-themed in place, so this is a restart-to-apply setting - say so
        // instead of leaving the user staring at an unchanged screen.
        WebGet psValue of oFTTheme_wc to iTheme
        Get ReadInteger  of ghoApplication CS_FTThemeSection CS_FTTheme CI_FTThemeDark to iOldTheme
        If (iTheme <> iOldTheme) Begin
            Send WriteInteger of ghoApplication CS_FTThemeSection CS_FTTheme iTheme
            Move True to bThemeChanged
        End

        // The three check boxes, in the registry. The package-updates one was never saved by the native dialog:
        // its Save reached the Engine group's two check boxes only, and that one has a group of its own.
        Get GetChecked of oShowStartQuestion_cb to bChecked
        Send WriteInteger of ghoApplication CS_Settings CS_ShowQuestion bChecked
        Get GetChecked of oShowSummary_cb to bChecked
        Send WriteInteger of ghoApplication CS_Settings CS_ShowSummary bChecked
        Get GetChecked of oCheckPackageUpdates_cb to bChecked
        Send WriteInteger of ghoApplication CS_Settings CS_CheckPackageUpdates bChecked
        Set pbFTChanged to False

        If (bThemeChanged = True) Begin
            Send Info_Box "Changes saved - DFRefactor will now be restarted to apply the new colour theme."
            Get GetApplicationFileName of ghoApplication to sProgram
            Runprogram Background sProgram
            Send Close_Panel
            Send Exit_Application
        End
        Else Begin
            Set StatusText of (Statusbar_Id(Self)) to "Changes saved."
        End
    End_Procedure

    // Whether Save is live - oPSSaveIdle, in the bar, watches it: a saved setting has changed (MarkChanged).
    Function SaveIsEnabled Returns Boolean
        Function_Return (pbFTChanged(Self))
    End_Function

    Function AddProgramToStudioToolsMenu String sStudioVersion Returns Integer
        Boolean bOk bExists bOpen
        String sKey sValue sProgramPath sProgram sProduct sStudioPath sTag sCommandLine
        Handle hoReg hoArray
        Integer i iItems iCreated iRetval

        Move False to bOk
        Move (CS_RegWorkspace * CS_RegFileName * CS_SaveAll) to sTag

        Move (CS_StudioPath + (Trim(sStudioVersion)))  to sStudioPath
        If (sStudioVersion > "17.1") Begin
            Move (Replace("Visual ", sStudioPath, "")) to sStudioPath
        End

        Get psProgramPath of (phoWorkspace(ghoApplication)) to sProgramPath
        Get PathAtIndex of (phoWorkspace(ghoApplication)) sProgramPath 1 to sProgramPath
        Move (vFolderFormat(sProgramPath)) to sProgramPath
        Get psProduct of (phoWorkspace(ghoApplication)) to sProduct
        Get Module_Name to sProgram

        Get Create (RefClass(cRegistry)) to hoReg
        Set phRootKey of hoReg to HKEY_CURRENT_USER
        // First check if the DataFlex version is installed
        Get KeyExists of hoReg sStudioPath to bExists
        If (bExists = False) Begin
            Send Destroy of hoReg
            Function_Return cx_RegKeyDFKeyDoesNotExist
        End

        // Then check if any tools have been installed in the Tools Menu.
        // If no tools created yet, create the Tools registry key.
        Move (sStudioPath + CS_StudioTools) to sStudioPath
        Get KeyExists of hoReg sStudioPath to bExists
        If (bExists = False) Begin
            Set pfAccessRights of hoReg to KEY_ALL_ACCESS
            Get CreateKey of hoReg sStudioPath to iCreated
            If (iCreated <> 0) Begin
                Move cx_RegkeyFailed to iRetval
            End
            Else Begin
                Move True to bExists
            End
        End

        If (bExists = True) Begin
            Get OpenKey of hoReg sStudioPath to bOk
            If (bOk = True) Begin
                Get Create (RefClass(Array)) to hoArray
                Get GetSubkeys of hoReg hoArray to iItems
                Decrement iItems
                Move False to bExists
                Set pfAccessRights of hoReg to KEY_READ
                // Check if the key already exists:
                For i From 0 to iItems
                    Get Value of hoArray i to sKey
                    Move (sStudioPath + CS_DirSeparator + sKey) to sKey
                    Get OpenKey of hoReg sKey to bOpen
                    If (bOpen = True) Begin
                        Get ReadString of hoReg CS_Name to sValue
                        Get ReadString of hoReg CS_CommandLine to sCommandLine
                        If (Uppercase(sValue) = Uppercase(sProduct) and Uppercase(sCommandLine) = Uppercase(sTag)) Begin
                            Move True to bExists
                        End
                    End
                Loop
                Send Destroy of hoArray

                If (bExists = False) Begin
                    Set pfAccessRights of hoReg to KEY_ALL_ACCESS
                    // We need to create the next key number:
                    // The studio expect tools menu items to be numbered 1,2,3...n
                    Increment iItems
                    Increment iItems
                    Get CreateKey of hoReg (sStudioPath + CS_DirSeparator + String(iItems)) to iCreated
                    If (iCreated = 0) Begin
                        Send WriteString of hoReg CS_Name sProduct
                        // From DataFlex 16 and up the params For the Studio's Tools menu changed slightly:
                        If (sStudioVersion >= "16.0") Begin
                            Send WriteString of hoReg CS_Command (sProgramPath + sProgram)
                            Send WriteString of hoReg CS_CommandLine sTag
                        End
                        Else Begin
                            Send WriteString of hoReg CS_CommandLine ('"' + sProgramPath + sProgram + ".exe" + '"' * String(sTag))
                            Move cx_InstalledOkDFUnder16 to iRetval
                        End
                        Send WriteDword of hoReg CS_Separator 1
                        Move cx_RegKeyCreated to iRetval
                    End
                    Else Begin
                        Move cx_RegkeyFailed to iRetval
                    End
                End
                Else Begin
                    Move cx_RegKeyAlreadyExist to iRetval
                End
                Send CloseKey of hoReg
            End
        End

        Send Destroy of hoReg
        Function_Return iRetval
    End_Function

    Procedure Popup
        If (SysFile.Recnum = 0) Begin
            Find ge SysFile by Recnum
        End
        Forward Send Popup
    End_Procedure

    On_Key Key_Alt+Key_O  Send DoSave
    On_Key Key_Ctrl+Key_S Send DoSave
    On_Key Key_Alt+Key_C  Send Close_Panel
    On_Key kCancel        Send Close_Panel
End_Object
