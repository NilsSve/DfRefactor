//****************************************************************************
// $Module type: Test fixture
// $Module name: oChangeReplaceDirectiveToDefine-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-08
//
// Description : Unit tests for ChangeReplaceDirectiveToDefine: the legacy '#REPLACE name value'
//               compiler directive becomes 'Define name for value'. The expected values follow
//               DataFlex 26 as measured on 2026-09-08: the two are one substitution mechanism for
//               numbers, quoted strings, parenthesised groups and '$'/dotted names, but a Define
//               with a value RESETS an Enum_List counter that a #REPLACE leaves alone, an unquoted
//               value with spaces does not compile as a Define, and a reserved word as the name
//               raises error 4330.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oChangeReplaceDirectiveToDefine is a cTestFixture
        Set psFunctionName to "ChangeReplaceDirectiveToDefine"

        // The ordinary case: a number, a trailing comment, and the value left in its own column.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NumberValueConverts
            String[] asCode
            Integer iCount

            Move '#REPLACE MAX_ROWS   500   // the limit' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define MAX_ROWS for 500   // the limit' asCode[0]
        End_Procedure

        // A block of aligned constants comes out still aligned - the value column is what the
        // padding is computed from, so 'for' and the values both line up.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_AlignedBlockKeepsItsColumn
            String[] asCode
            Integer iCount

            Move '#REPLACE A_ONE     1' to asCode[0]
            Move '#REPLACE A_LONGER  2' to asCode[1]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual 'Define A_ONE   for 1'    asCode[0]
            Send AssertSAreEqual 'Define A_LONGER for 2'   asCode[1]
        End_Procedure

        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_QuotedStringValueConverts
            String[] asCode
            Integer iCount

            Move '#Replace DB_ID  "RDC Tools"' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define DB_ID for "RDC Tools"' asCode[0]
        End_Procedure

        // Measured convertible, and common in real code: a negative constant.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NegativeNumberConverts
            String[] asCode
            Integer iCount

            Move '#REPLACE PE_ALLLINES  -1' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define PE_ALLLINES for -1' asCode[0]
        End_Procedure

        // MEASURED: a #REPLACE value is lazy TEXT, a Define resolves its value AT ITS OWN LINE.
        // '#Replace X (A ior B)' compiles with A and B declared further down; the same as a Define
        // is error 4328. Whether the names are known yet cannot be decided from one file, so a
        // parenthesised value is left alone however convertible it looks.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_ParenthesisedValueLeftAlone
            String[] asCode
            Integer iCount

            Move '#Replace TB_CHECKGROUP (TBSTYLE_GROUP ior TBSTYLE_CHECK)' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#Replace TB_CHECKGROUP (TBSTYLE_GROUP ior TBSTYLE_CHECK)' asCode[0]
        End_Procedure

        // The directive is spelled both ways in real DataFlex source and the compiler takes either.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_MixedCaseDirectiveConverts
            String[] asCode
            Integer iCount

            Move '   #Replace CP_UTF8 65001' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '   Define CP_UTF8 for 65001' asCode[0]
        End_Procedure

        // A value that is another identifier is a TYPE or COMMAND alias. It would compile as a
        // Define, but it is substitution machinery, not a constant - left exactly as it is, and
        // without a marker, because the Deep Scan does not offer it either.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_IdentifierValueLeftAlone
            String[] asCode
            Integer iCount

            Move '#REPLACE OLE_Handle   Integer' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE OLE_Handle   Integer' asCode[0]
        End_Procedure

        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_MacroFragmentValueLeftAlone
            String[] asCode
            Integer iCount

            Move '#REPLACE CW_DEFAULT16 |CI$8000' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE CW_DEFAULT16 |CI$8000' asCode[0]
        End_Procedure

        // A reserved word as the name is a macro by definition, and 'Define Send for ...' is
        // error 4330.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_ReservedWordNameLeftAlone
            String[] asCode
            Integer iCount

            Move '#REPLACE Send 5' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE Send 5' asCode[0]
        End_Procedure

        // The legacy shell's workspace-name macro belongs to the Workspace-shell converter, which
        // comments the directive out as part of converting the object it feeds.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_CurrentWorkspaceLeftAlone
            String[] asCode
            Integer iCount

            Move '#REPLACE CURRENT$WORKSPACE "MyApp"' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE CURRENT$WORKSPACE "MyApp"' asCode[0]
        End_Procedure

        // THE MEASURED TRAP. A #REPLACE does not touch an Enum_List's running counter; a Define
        // with a value resets it. Converting would renumber every entry below, silently, and the
        // file would still compile - so the line stays and says why.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_InsideEnumListIsMarked
            String[] asCode
            Integer iCount

            Move 'Enum_List'          to asCode[0]
            Move '    Define eOne'    to asCode[1]
            Move '#REPLACE eMid 40'   to asCode[2]
            Move '    Define eThree'  to asCode[3]
            Move 'End_Enum_List'      to asCode[4]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[2] contains "NOT converted -")
            Send Assert (asCode[2] contains "renumber")
            Send Assert (Left(asCode[2], 16) = '#REPLACE eMid 40')
        End_Procedure

        // ... and the block ENDS, so a directive after End_Enum_List converts as usual.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_AfterEnumListConvertsAgain
            String[] asCode
            Integer iCount

            Move 'Enum_List'         to asCode[0]
            Move '    Define eOne'   to asCode[1]
            Move 'End_Enum_List'     to asCode[2]
            Move '#REPLACE AFTER 7'  to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define AFTER for 7' asCode[3]
        End_Procedure

        // The other measured trap: the directive takes the REST OF THE LINE, so an unquoted value
        // with spaces has no Define equivalent - 'Define X for 15 ...' is error 4345.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_UnquotedValueWithSpacesIsMarked
            String[] asCode
            Integer iCount

            Move "#Replace SB_SEPARATOR 15 ''" to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[0] contains "NOT converted -")
            Send Assert (asCode[0] contains "unquoted text with spaces")
        End_Procedure

        // A #HEADER ... #ENDHEADER region is precompiled and is never refactored.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_InsideHeaderRegionLeftAlone
            String[] asCode
            Integer iCount

            Move '#HEADER'             to asCode[0]
            Move '#REPLACE HDR_MAX 9'  to asCode[1]
            Move '#ENDHEADER'          to asCode[2]
            Move '#REPLACE OUT_MAX 9'  to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '#REPLACE HDR_MAX 9' asCode[1]
            Send AssertSAreEqual 'Define OUT_MAX for 9' asCode[3]
        End_Procedure

        // A directive inside a DF23 block comment is comment text, not code.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_InsideBlockCommentLeftAlone
            String[] asCode
            Integer iCount

            Move '/* the old form was'   to asCode[0]
            Move '#REPLACE OLD_MAX 3'    to asCode[1]
            Move '   which we dropped */' to asCode[2]
            Move '#REPLACE NEW_MAX 4'    to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '#REPLACE OLD_MAX 3' asCode[1]
            Send AssertSAreEqual 'Define NEW_MAX for 4' asCode[3]
        End_Procedure

        // A '#replace' written inside a comment or a string is not the directive.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_CommentedOutDirectiveLeftAlone
            String[] asCode
            Integer iCount

            Move '// #REPLACE DEAD_MAX 3'            to asCode[0]
            Move 'Move "#REPLACE X 1" to sSample'    to asCode[1]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '// #REPLACE DEAD_MAX 3'         asCode[0]
            Send AssertSAreEqual 'Move "#REPLACE X 1" to sSample' asCode[1]
        End_Procedure

        // A Language_*.inc IS the substitution mechanism DataFlex builds a localised app with.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_LanguageFileLeftAlone
            String[] asCode
            Integer iCount

            Set psCurrentSourceFileName of ghoEngine to "C:\Test\Language_DD_English.inc"
            Move '#REPLACE DD_TEXT_MAX 30' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Set psCurrentSourceFileName of ghoEngine to ""
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE DD_TEXT_MAX 30' asCode[0]
        End_Procedure

        // A name that does not start with a letter cannot be a Define symbol.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NameNotStartingWithALetterLeftAlone
            String[] asCode
            Integer iCount

            Move '#REPLACE $ODD 5' to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual '#REPLACE $ODD 5' asCode[0]
        End_Procedure

        // A name carrying '$' or a dot AFTER the first letter is fine - both measured.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_DollarAndDottedNamesConvert
            String[] asCode
            Integer iCount

            Move '#REPLACE CFG$DEBUG 0'        to asCode[0]
            Move '#REPLACE CFG.NO_SIZE 1'  to asCode[1]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 2 iCount
            Send AssertSAreEqual 'Define CFG$DEBUG for 0'       asCode[0]
            Send AssertSAreEqual 'Define CFG.NO_SIZE for 1' asCode[1]
        End_Procedure

        // A re-run over an already-marked line adds nothing, so the file stays byte-identical.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_MarkerNotDuplicatedOnRerun
            String[] asCode
            String sFirst
            Integer iCount

            Move 'Enum_List'        to asCode[0]
            Move '#REPLACE eMid 40' to asCode[1]
            Move 'End_Enum_List'    to asCode[2]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Move asCode[1] to sFirst
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual sFirst asCode[1]
        End_Procedure

        // A file with no directive at all costs nothing and changes nothing.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NoDirectiveReturnsZero
            String[] asCode
            Integer iCount

            Move 'Procedure Something' to asCode[0]
            Move 'End_Procedure'       to asCode[1]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Procedure Something' asCode[0]
        End_Procedure

        // The run notes say what was converted and what was refused.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_RunNotesReportBothOutcomes
            String[] asCode
            String sNotes
            Integer iCount

            Move '#REPLACE GOOD_MAX 5'  to asCode[0]
            Move 'Enum_List'            to asCode[1]
            Move '#REPLACE eMid 40'     to asCode[2]
            Move 'End_Enum_List'        to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Get RunNotesText of ghoFuncLib "ChangeReplaceDirectiveToDefine" "  " to sNotes
            Send AssertIAreEqual 1 iCount
            Send Assert (sNotes contains "rewritten as Define")
            Send Assert (sNotes contains "Enum_List")
        End_Procedure

        // MEASURED: '#IFDEF X' is blind to a '#REPLACE X ...' but it DOES see a Define, so
        // converting would switch on an arm that is dead today. The line keeps its directive.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NameTestedByIfDefIsMarked
            String[] asCode
            Integer iCount

            Move '#REPLACE CFG$DEBUG 0'      to asCode[0]
            Move '#IFDEF CFG$DEBUG'          to asCode[1]
            Move '    Move 1 to iDebugging' to asCode[2]
            Move '#ENDIF'                   to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send Assert (asCode[0] contains "NOT converted -")
            Send Assert (asCode[0] contains "#IFDEF")
        End_Procedure

        // A compile-time '#IF <name>' reads a Define exactly as it reads a #REPLACE, so it is no
        // obstacle - a shape a legacy layout library is full of.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_NameTestedByPlainIfStillConverts
            String[] asCode
            Integer iCount

            Move '#REPLACE CFG$DEBUG 0'      to asCode[0]
            Move '#IF CFG$DEBUG'             to asCode[1]
            Move '    Move 1 to iDebugging' to asCode[2]
            Move '#ENDIF'                   to asCode[3]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define CFG$DEBUG for 0' asCode[0]
        End_Procedure

        // The #IFDEF has to name THIS constant - another name's test must not block it.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_IfDefOnAnotherNameDoesNotBlock
            String[] asCode
            Integer iCount

            Move '#REPLACE MAX_ROWS 500' to asCode[0]
            Move '#IFDEF SOMETHING_ELSE' to asCode[1]
            Move '#ENDIF'                to asCode[2]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Define MAX_ROWS for 500' asCode[0]
        End_Procedure

        // THE SPELLING A LEGACY WORKSPACE ACTUALLY WRITES. DataFlex takes 'Enumeration_List' as
        // well as 'Enum_List', lower case, with a trailing comment - and it is the form the fork's
        // own source uses. Matching only the short spelling would let the counter trap through in
        // exactly the files that have it.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_LongEnumerationSpellingAlsoBlocks
            String[] asCode
            Integer iCount

            Move 'enumeration_list // Enumerate attribute types' to asCode[0]
            Move '    Define eFirst'                             to asCode[1]
            Move '#REPLACE eMid 40'                              to asCode[2]
            Move '    Define eLast'                              to asCode[3]
            Move 'end_enumeration_list'                          to asCode[4]
            Move '#REPLACE AFTER 7'                              to asCode[5]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send Assert (asCode[2] contains "renumber")
            Send AssertSAreEqual 'Define AFTER for 7' asCode[5]
        End_Procedure

        // A macro-argument mark in the name makes it an ARGUMENT, not a symbol. The mark is built
        // with Character(33): the compiler reads a literal one followed by a digit as macro syntax
        // even inside a string, and a test that types it fills the listing with error 4337.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_MacroArgumentNameLeftAlone
            String[] asCode
            String sLine
            Integer iCount

            Move ("#Replace U_" + Character(33) + "1 0") to sLine
            Move sLine to asCode[0]
            Get ChangeReplaceDirectiveToDefine of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual sLine asCode[0]
        End_Procedure

        // ONE ASSERTION PER ENTRY for the value table - it is the whole refusal rule in one place.
        { Published = True }
        Procedure ChangeReplaceDirectiveToDefine_ValueKindTable
            Integer iKind

            Get _ReplaceDirectiveValueKind of ghoFuncLib "500" to iKind
            Send AssertIAreEqual 1 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "-1" to iKind
            Send AssertIAreEqual 1 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib '"RDC Tools"' to iKind
            Send AssertIAreEqual 2 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "'x'" to iKind
            Send AssertIAreEqual 2 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "(A ior B)" to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "15 ''" to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "Integer" to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "|CI$8000" to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "" to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib '"unterminated' to iKind
            Send AssertIAreEqual 0 iKind
            Get _ReplaceDirectiveValueKind of ghoFuncLib "-" to iKind
            Send AssertIAreEqual 0 iKind
        End_Procedure

    End_Object
