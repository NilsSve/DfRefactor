    Object oChangeIfNotCommandtoExpression is a cTestFixture
        Set psFunctionName to "ChangeIfNotCommandToExpression"

        {Published = True}
        Procedure ChangeIfNotCommandToExpression_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    IFNOT Found Begin' to sLine
            Move '    If (Not(Found)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Line with no IFNOT must be returned unchanged and return False.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_NoIfNot
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move "Move 1 to iCount" to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual "Move 1 to iCount" sLine
        End_Procedure

        // Hardening (2026-06-10 audit): "ifnot" appearing only inside a string
        // literal must never trigger the transform (the keyword is now located on
        // the masked line, boundary-aware).
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_InsideString_NotChanged
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Showln "use IFNOT here"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Showln "use IFNOT here"' sLine
        End_Procedure

        // Lowercase 'ifnot' is matched case-insensitively; bChanged must be True.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_Lowercase
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    ifnot bFound begin" to sLine
            Move "    If (Not(bFound)) begin" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // IFNOT with no trailing keyword -- result ends after the Not() expression.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_NoBegin
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "IFNOT bFlag" to sLine
            Move "If (Not(bFlag))" to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // The TWO-WORD form (Nils's LegacyApp3 find 2026-07-10): 'If Not (Found) Begin' - the redundant
        // outer paren pair is folded into the Not() wrap, never double-wrapped.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotParenOperand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If Not (Found) Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    If (Not(Found)) Begin' sLine
        End_Procedure

        // Bare operand + inline statement tail: the tail is re-emitted after the wrap.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotBareOperand
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not Found Procedure_Return' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (Not(Found)) Procedure_Return' sLine
        End_Procedure

        // A parenthesized MULTI-TERM operand is one tokenizer expression token - it converts whole.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotParenExpression
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not (iA = iB) Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (Not(iA = iB)) Begin' sLine
        End_Procedure

        // A leading Else rides along untouched.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_ElseIfNot
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Else If Not (bOK) Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual '    Else If (Not(bOK)) Begin' sLine
        End_Procedure

        // BAIL: a multi-term UNparenthesized condition ('If Not a eq b') - wrapping only the first
        // operand would rip the condition apart; the line must pass through untouched.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotLegacyOperatorBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not sName eq "X" Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If Not sName eq "X" Begin' sLine
        End_Procedure

        // BAIL: a [bracket] indicator operand belongs to the indicator converters.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotBracketBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not [Found] Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If Not [Found] Begin' sLine
        End_Procedure

        // BAIL (one-word IFNOT): a [bracket] indicator condition belongs to the indicator converters -
        // ChangeLegacyIndicators finishes 'ifnot [seqeof] begin' as 'If (Not(seqeof)) begin' itself (since
        // 2026-09-07; before that it left 'ifnot (seqeof) begin' for a second run). Wrapping the raw bracket
        // here emitted the un-compilable 'If (Not([seqeof])) begin'. Mirrors the two-word bail above.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_IfNotOneWordBracketBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot [seqeof] begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'ifnot [seqeof] begin' sLine
        End_Procedure

        // Already modern: 'If (Not(Found)) Begin' has no bare Not token after If - untouched.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_ModernUntouched
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (Not(Found)) Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If (Not(Found)) Begin' sLine
        End_Procedure

        // The trailing-';' continuation form - 'If NOT (Found) ;' with the Begin on the NEXT
        // line (the LegacyApp3 house style) - converts with the ';' preserved: the wrap is local
        // to this line, so the continuation stays valid. Was a bail; it survived the first
        // Deep Scan fix-plan run as the biggest auto-fix leftover (Nils 2026-07-10).
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_TrailingSemicolonConverts
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If NOT (Found) ;' to sLine
            Move '    If (Not(Found)) ;' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A NESTED parenthesized comparison operand - 'If Not ((Right(sPath,1)) = DirSep) Begin'
        // (WINQL32-shape survivor, Nils 2026-07-11): the outer pair encloses the whole token, so
        // it folds into the Not(...) wrap like any user-written group.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_NestedParenComparison
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not ((Right(sPath,1)) = DirSep) Begin'   to sLine
            Move 'If (Not((Right(sPath,1)) = DirSep)) Begin'  to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ENGINE-ORDER repro (WINQL32-shape survivor, Nils 2026-07-11): the nested-paren If-Not
        // converts when the tokenizer arrives THROUGH its procedure's preceding lines - incl. a
        // mid-body 'String DirSep' declaration and a COMMENT carrying quote-backslash-quote
        // string patterns. The flag asserts pin WHICH sticky state trips if this fails.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_EngineOrderStickyState
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData

            Get Tokenizer of ghoFuncLib 'Procedure Convert_Items'                            to TokenizerData
            Get Tokenizer of ghoFuncLib 'Integer iCount iMax'                                to TokenizerData
            Get Tokenizer of ghoFuncLib 'String sLocation sPath'                             to TokenizerData
            Get Tokenizer of ghoFuncLib 'String DirSep'                                      to TokenizerData
            Get Tokenizer of ghoFuncLib 'Move (Sysconf(SYSCONF_DIR_SEPARATOR)) to DirSep'    to TokenizerData
            Get Tokenizer of ghoFuncLib 'Get NItems to iMax'                                 to TokenizerData
            Get Tokenizer of ghoFuncLib 'Get Data_Path to sPath'                             to TokenizerData
            Get Tokenizer of ghoFuncLib '//If Not (Right(sPath,1)) Eq "\" Move (sPath-"\") To sPath' to TokenizerData
            Move 'If Not ((Right(sPath,1)) = DirSep) Begin'  to sLine
            Move 'If (Not((Right(sPath,1)) = DirSep)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send Assert (TokenizerData.bLineIsReady = False)
            Send Assert (TokenizerData.bIsInCommand = False)
            Send Assert (TokenizerData.bIsInImage = False)
            Send Assert (TokenizerData.bIsVariableDeclaration = False)
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A NESTED chained If whose outer condition is the two-word 'If not (X)' (Nils 2026-07-13):
        // only the OUTER If-not is wrapped; the inner nested If is left intact (a valid nested If).
        // This is what feeds ChangeLegacyOperators - which then combines the chain correctly BECAUSE
        // the not is now wrapped (see oChangeLegacyOperators ChainedNotWrappedCombines). The trailing
        // end-comment rides along.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_NestedIfChain
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    If not (MORE_ROWS) If (Orders.Emp_Nr EQ Emp.Emp_Nr) Goto NextOrder  // trans.' to sLine
            Move '    If (Not(MORE_ROWS)) If (Orders.Emp_Nr EQ Emp.Emp_Nr) Goto NextOrder // trans.' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // ... and a bare operand with a ';' plus an end-comment: both survive, in order.
        {Published = True}
        Procedure ChangeIfNotCommandToExpression_TrailingSemicolonWithComment
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Not bDone ; // retro check' to sLine
            Move 'If (Not(bDone)) ; // retro check' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* THE OPERAND MUST BE THE WHOLE CONDITION (2026-09-07): 'ifnot A in B stmt' used to come out as
           'If (Not(A)) in B stmt', which ChangeInToContains then swapped into '(B contains Not(A))' - 29
           silently inverted conditions in one run. A lone legacy IN is composed the modern way here. */
        {Published = True}
        { Description = "One-word IFNOT with a legacy IN condition composes If (Not(B Contains A))" }
        Procedure ChangeIfNotCommandToExpression_InOperand_ComposesContains
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot sSub in sSet Begin' to sLine
            Move 'If (Not(sSet contains sSub)) Begin' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        { Description = "IFNOT with parenthesised IN operands and an inline statement keeps the statement after the composed condition" }
        Procedure ChangeIfNotCommandToExpression_InOperand_ParenOperandsAndStatement
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot ("|"+Lowercase(sDir)+"|") in (Lowercase(sList)) Move (sList+sDir+"|") to sList' to sLine
            Move 'If (Not((Lowercase(sList)) contains ("|"+Lowercase(sDir)+"|"))) Move (sList+sDir+"|") to sList' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // BAIL (one-word IFNOT): a legacy comparison after the operand - the operator pass parenthesises
        // it first; wrapping only the operand would produce 'If (Not(iCount)) gt 0'.
        {Published = True}
        { Description = "One-word IFNOT followed by a legacy comparison bails untouched" }
        Procedure ChangeIfNotCommandToExpression_IfNotOneWordLegacyOperatorBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot iCount gt 0 Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'ifnot iCount gt 0 Begin' sLine
        End_Procedure

        // BAIL: an IN condition that continues with and/or is more than the lone form this composes.
        {Published = True}
        { Description = "One-word IFNOT with IN followed by AND bails untouched" }
        Procedure ChangeIfNotCommandToExpression_InOperand_FollowedByAndBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'ifnot sSub in sSet and bMore Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'ifnot sSub in sSet and bMore Begin' sLine
        End_Procedure

        // BAIL: 'Status <file>' is a legacy test COMMAND with an argument, not a Boolean operand. Wrapping
        // the word alone gave 'If (Not(Status)) ArAccnt Function_Return "Cancelled"' (Nils 2026-09-19).
        {Published = True}
        { Description = "Two-word If Not on the Status <file> test command bails untouched" }
        Procedure ChangeIfNotCommandToExpression_StatusFileCommandBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If not Status ArAccnt Function_Return "Cancelled" //no message number' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If not Status ArAccnt Function_Return "Cancelled" //no message number' sLine
        End_Procedure

        // ...and the one-word IFNOT path declines the same shape.
        {Published = True}
        { Description = "One-word IFNOT on the Status <file> test command bails untouched" }
        Procedure ChangeIfNotCommandToExpression_IfNotStatusFileCommandBails
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Ifnot Status ArAccnt Begin' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Ifnot Status ArAccnt Begin' sLine
        End_Procedure

        // POSITIVE CONTROL beside the bail: an argument-less test word still converts.
        {Published = True}
        { Description = "Two-word If Not on Found still converts" }
        Procedure ChangeIfNotCommandToExpression_FoundStillConverts
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If not Found Function_Return "Cancelled"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get ChangeIfNotCommandToExpression of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual 'If (Not(Found)) Function_Return "Cancelled"' sLine
        End_Procedure

    End_Object
