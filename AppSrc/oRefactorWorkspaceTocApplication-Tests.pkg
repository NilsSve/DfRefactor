// Web-site    : http://www.rdctools.com
// Created     : 2026-07-11
//
// Description : Unit tests for the RefactorWorkspaceTocApplication refactor function.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oRefactorWorkspaceTocApplication is a cTestFixture
        Set psFunctionName to "RefactorWorkspaceTocApplication"

        // The canonical wizard-era shell, full pipeline: object conversion + shell SCAFFOLDING (the
        // file has a live 'Use DfAllEnt.pkg', so it counts as a real program). Asserts the COMPLETE
        // expected output by index: CJ command-bar Uses at the top; #REPLACE / Register_Object /
        // Workspc / Std_Help commented out; oHtmlHelp above the renamed cApplication object;
        // commented psCompany/psProduct placeholders + peHelpType after psAutoOpenWorkspace; the
        // TODO-tagged unmapped property; oToolTipController after End_Object; oCommandBarSystem
        // inside the panel before the client area; AppClientArea -> ClientArea with Client_Area
        // renamed to oClientArea INCLUDING the trailing reference.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_FullShell
            String[] asCode
            Integer iCount

            Move 'Use DfAllEnt.pkg'                                    to asCode[0]
            Move ''                                                    to asCode[1]
            Move '#REPLACE CURRENT$WORKSPACE   "MyApp"'                to asCode[2]
            Move 'Register_Object Client_Area'                         to asCode[3]
            Move ''                                                    to asCode[4]
            Move 'Use Workspc.pkg'                                     to asCode[5]
            Move ''                                                    to asCode[6]
            Move 'Object ProgramWorkspace is a Workspace'              to asCode[7]
            Move '    Set WorkspaceName to CURRENT$WORKSPACE'          to asCode[8]
            Move '    Set kEnter_Next_State to True'                   to asCode[9]
            Move 'End_Object'                                          to asCode[10]
            Move ''                                                    to asCode[11]
            Move 'Use Std_Help.pkg'                                    to asCode[12]
            Move ''                                                    to asCode[13]
            Move 'Object Main is a Panel'                              to asCode[14]
            Move '    Set Label to "My program"'                       to asCode[15]
            Move '    Object Client_Area is a AppClientArea'           to asCode[16]
            Move 'Use MyView.vw'                                       to asCode[17]
            Move '    End_Object'                                      to asCode[18]
            Move 'End_Object'                                          to asCode[19]
            Move ''                                                    to asCode[20]
            Move 'Send Activate_The_View of (Client_Area(Main(Self)))' to asCode[21]
            Move 'Start_UI'                                            to asCode[22]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "MyApp.ws" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 40 (SizeOfArray(asCode))
            Send AssertSAreEqual 'Use DfAllEnt.pkg'                     asCode[0]
            Send AssertSAreEqual 'Use cCJStandardCommandBarSystem.pkg' asCode[1]
            Send AssertSAreEqual 'Use cCJCommandBarSystem.pkg'         asCode[2]
            Send AssertSAreEqual '// #REPLACE CURRENT$WORKSPACE   "MyApp"   // DFRefactor: CURRENT$WORKSPACE retired with the Workspace object.' asCode[4]
            Send AssertSAreEqual '// Register_Object Client_Area   // DFRefactor: retired - not needed with the modern shell.' asCode[5]
            Send AssertSAreEqual '// Use Workspc.pkg   // DFRefactor: Workspc.pkg retired - cApplication (via DfAllEnt.pkg) replaces the Workspace object.' asCode[7]
            Send AssertSAreEqual 'Object oHtmlHelp is a cHtmlHelp'      asCode[9]
            Send AssertSAreEqual '    Set pbAlwaysOnTop to False'       asCode[10]
            Send AssertSAreEqual 'End_Object'                           asCode[11]
            Send AssertSAreEqual 'Object oApplication is a cApplication' asCode[13]
            Send AssertSAreEqual '    Set psAutoOpenWorkspace to "MyApp.ws"' asCode[14]
            Send AssertSAreEqual '    // Set psCompany to "Your company name"   // TODO (DFRefactor): fill in and uncomment.' asCode[15]
            Send AssertSAreEqual '    // Set psProduct to "Your product name"   // TODO (DFRefactor): fill in and uncomment.' asCode[16]
            Send AssertSAreEqual '    Set peHelpType to htHtmlHelp'     asCode[17]
            Send AssertSAreEqual '    // Set kEnter_Next_State to True   // TODO (DFRefactor): no direct cApplication equivalent - review.' asCode[18]
            Send AssertSAreEqual 'End_Object'                           asCode[19]
            Send AssertSAreEqual 'Use cToolTipController.pkg'           asCode[21]
            Send AssertSAreEqual 'Object oToolTipController is a cToolTipController' asCode[22]
            Send AssertSAreEqual 'End_Object'                           asCode[23]
            Send AssertSAreEqual '// Use Std_Help.pkg   // DFRefactor: replaced by the oHtmlHelp object (peHelpType htHtmlHelp).' asCode[25]
            Send AssertSAreEqual 'Object Main is a Panel'               asCode[27]
            Send AssertSAreEqual '    Object oCommandBarSystem is a cCJCommandBarSystem' asCode[29]
            Send AssertSAreEqual '        Set pbTimerUpdate to True'    asCode[30]
            Send AssertSAreEqual '    End_Object'                       asCode[31]
            Send AssertSAreEqual '    Object oClientArea is a ClientArea' asCode[33]
            Send AssertSAreEqual 'Use MyView.vw'                        asCode[34]
            Send AssertSAreEqual 'Send Activate_The_View of (oClientArea(Main(Self)))' asCode[38]
            Send AssertSAreEqual 'Start_UI'                             asCode[39]
        End_Procedure

        // The About wiring: a 'Use StdAbout.pkg' sitting OUTSIDE the client area (the wizard put it
        // after the client area's End_Object, still inside the panel) is MOVED to the end of the
        // client area's body - verbatim, trailing comment and all - and the Activate_About skeleton
        // follows it with the DoAbout example line commented for the user to fill in.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_AboutMovedIntoClientArea
            String[] asCode
            Integer iCount

            Move 'Use DfAllEnt.pkg'                              to asCode[0]
            Move 'Object oWs is a Workspace'                     to asCode[1]
            Move '    Set WorkspaceName to "X"'                  to asCode[2]
            Move 'End_Object'                                    to asCode[3]
            Move 'Object Main is a Panel'                        to asCode[4]
            Move '    Object Client_Area is a AppClientArea'     to asCode[5]
            Move 'Use MyView.vw'                                 to asCode[6]
            Move '    End_Object'                                to asCode[7]
            Move 'Use StdAbout.pkg // Standard "About" package.' to asCode[8]
            Move 'End_Object'                                    to asCode[9]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertIAreEqual 31 (SizeOfArray(asCode))
            Send AssertSAreEqual '    Object oClientArea is a ClientArea' asCode[22]
            Send AssertSAreEqual 'Use MyView.vw' asCode[23]
            Send AssertSAreEqual 'Use StdAbout.pkg // Standard "About" package.' asCode[24]
            Send AssertSAreEqual '        Procedure Activate_About' asCode[25]
            Send AssertSAreEqual '            //         Send DoAbout "Order Entry Sample Application" "2026.0" "Copyright (c) 2026 Data Access Corporation" "Data Access Worldwide" ""' asCode[26]
            Send AssertSAreEqual '        End_Procedure' asCode[27]
            Send AssertSAreEqual '    End_Object' asCode[29]
        End_Procedure

        // An object NAME that is referenced elsewhere in the file is KEPT - only the class swaps.
        // Also proves the scaffolding GATE: a bare fragment (no live Use line) gets the object
        // conversion alone - no chrome is sprouted and the line count stays put.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_ReferencedNameKept
            String[] asCode
            Integer iCount
            Move 'Object ProgramWorkspace is a Workspace'                to asCode[0]
            Move '    Set WorkspaceName to "X"'                          to asCode[1]
            Move 'End_Object'                                            to asCode[2]
            Move 'Send DoSomething of (ProgramWorkspace(Self))'          to asCode[3]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "MyApp.ws" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual 'Object ProgramWorkspace is a cApplication' asCode[0]
            Send AssertSAreEqual 'Send DoSomething of (ProgramWorkspace(Self))' asCode[3]
            Send AssertIAreEqual 4 (SizeOfArray(asCode))
            Send AssertIAreEqual -1 (SearchArray('Use cCJCommandBarSystem.pkg', asCode))
        End_Procedure

        // A blank parameter falls back to the DataFlex default workspace config, Config.ws.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_DefaultParameter
            String[] asCode
            Integer iCount
            Move 'Object oWs is a Workspace'          to asCode[0]
            Move '    Set WorkspaceName to "MyApp"'   to asCode[1]
            Move 'End_Object'                         to asCode[2]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Set psAutoOpenWorkspace to "Config.ws"' asCode[1]
        End_Procedure

        // Idempotent / whole-token: an already-modern cApplication object and a cWorkspace object are
        // both untouched ('Workspace' must match as a whole token, never as a substring).
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_ModernUntouched
            String[] asCode
            Integer iCount
            Move 'Object oApplication is a cApplication'                 to asCode[0]
            Move '    Set psAutoOpenWorkspace to "Config.ws"'            to asCode[1]
            Move 'End_Object'                                            to asCode[2]
            Move 'Object oWorkspace is a cWorkspace'                     to asCode[3]
            Move 'End_Object'                                            to asCode[4]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Object oApplication is a cApplication' asCode[0]
            Send AssertSAreEqual '    Set psAutoOpenWorkspace to "Config.ws"' asCode[1]
            Send AssertSAreEqual 'Object oWorkspace is a cWorkspace' asCode[3]
        End_Procedure

        // A 'Class X is a Workspace' SUBCLASS is deliberately NOT converted - subclassing
        // cApplication is a design decision, not a mechanical swap.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_SubclassNotConverted
            String[] asCode
            Integer iCount
            Move 'Class cMyWorkspace is a Workspace'   to asCode[0]
            Move 'End_Class'                           to asCode[1]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 0 iCount
            Send AssertSAreEqual 'Class cMyWorkspace is a Workspace' asCode[0]
        End_Procedure

        // The #REPLACE feeder is KEPT when another (non-comment) line still reads the token; the dead
        // Use Workspc.pkg is still retired.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_ReplaceKeptWhenStillRead
            String[] asCode
            Integer iCount

            Move '#REPLACE CURRENT$WORKSPACE "MyApp"'          to asCode[0]
            Move 'Use Workspc.pkg'                             to asCode[1]
            Move 'Object oWs is a Workspace'                   to asCode[2]
            Move '    Set WorkspaceName to CURRENT$WORKSPACE'  to asCode[3]
            Move 'End_Object'                                  to asCode[4]
            Move 'Move CURRENT$WORKSPACE to gsName'            to asCode[5]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "MyApp.ws" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '#REPLACE CURRENT$WORKSPACE "MyApp"' asCode[0]
            Send AssertSAreEqual '// Use Workspc.pkg   // DFRefactor: Workspc.pkg retired - cApplication (via DfAllEnt.pkg) replaces the Workspace object.' asCode[1]
            Send AssertSAreEqual 'Move CURRENT$WORKSPACE to gsName' asCode[5]
        End_Procedure

        // A Set inside a nested Procedure body is RUNTIME code, not a workspace property - it must
        // pass through untouched while the direct-body WorkspaceName still converts.
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_SetInsideProcedureUntouched
            String[] asCode
            Integer iCount
            Move 'Object oWs is a Workspace'            to asCode[0]
            Move '    Set WorkspaceName to "MyApp"'     to asCode[1]
            Move '    Procedure OnStartUp'              to asCode[2]
            Move '        Set Label to "Hello"'         to asCode[3]
            Move '    End_Procedure'                    to asCode[4]
            Move 'End_Object'                           to asCode[5]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "MyApp.ws" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual '    Set psAutoOpenWorkspace to "MyApp.ws"' asCode[1]
            Send AssertSAreEqual '        Set Label to "Hello"' asCode[3]
        End_Procedure

        // Tab-indented declarations convert too (Trim strips only spaces - the detection copy is
        // tab-normalised, splices preserve the raw indent).
        { Published = True }
        Procedure RefactorWorkspaceTocApplication_TabIndentedDeclaration
            String[] asCode
            Integer iCount
            Move (Character(9) + 'Object ProgramWorkspace is a Workspace') to asCode[0]
            Move (Character(9) + 'End_Object')                             to asCode[1]
            Get RefactorWorkspaceTocApplication of ghoFuncLib (&asCode) "" to iCount
            Send AssertIAreEqual 1 iCount
            Send AssertSAreEqual (Character(9) + 'Object oApplication is a cApplication') asCode[0]
        End_Procedure

    End_Object
