//****************************************************************************
// $Module type: Include file
// $Module name: ScintillaLexerApi.h
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-07-28
//
// Description : What DFRefactor needs on TOP of the Scintilla API proper: the DataFlex lexer's style
//               numbers, the Windows messages and imports the control host needs, the editor's
//               encoding enum, and the command IDs the hotkey engine registers and the mixin binds.
//
//               BROUGHT HOME from SciControlLib's cSciLexer.h, and TRIMMED. That file carries 543
//               symbols; DFRefactor references 177. The rest is the CodeMax control's surface - its
//               options, notification codes, printing and drag-drop constants - the vocabulary of an
//               editor component we no longer use. Unlike ScintillaApi.h.pkg next door, this was never
//               a generated interface to anything: there is nothing to regenerate it FROM, so keeping
//               the unused remainder would just be keeping it.
//
//               THE KEEP-SET IS COMPUTED, NOT EYEBALLED: every symbol referenced anywhere in AppSrc,
//               closed transitively over this header's own cross-references. That closure is what
//               brings CMD_FIRST in - nothing names it directly, but every CMD_* below is defined as
//               an offset from it.
//
//               AND IT IS COMPUTED AGAINST THE CURRENT AppSrc, which matters more than it sounds. An
//               earlier trim of this file was made while the hotkey engine still lived in the library,
//               so it kept only the 46 CMD_* the mixin binds. The engine REGISTERS 143 - the whole
//               bindable command list the Keyboard page offers - and moving it home turned 97 dropped
//               constants into 223 compile errors. Regenerate this file whenever what AppSrc contains
//               changes shape, and let the compiler confirm it.
//
//               EVERY VALUE IS BYTE-IDENTICAL to the library's. The CMD_* numbers especially are DATA,
//               not merely constants: they are what a user's saved keyboard bindings refer to, so a
//               changed value silently repoints someone's shortcuts.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use ScintillaApi.h.pkg      // SCI_*, SC_*, STYLE_*, and the tSci_* structs
Use VDFBase.pkg             // C_NewLine - the system CRLF; never redeclared (Nils 2026-08-28)

Define CS_CR   For (Character(13))
Define CS_LF   for (Character(10))

  Define eTE_UTF8    for 1
  Define eTE_OEM     for 2
  Define eTE_ANSI    for 3

Define WM_RBUTTONUP             For |CI$0205 // 0x0205

#IFNDEF get_RedrawWindow
  External_Function RedrawWindow       'RedrawWindow'         User32.dll  Handle hwnd Pointer pRect Handle hUpdReg Integer iFlags Returns Integer
#ENDIF

Define WM_DROPFILES              For |CI$0233
#IFNDEF get_DragAcceptFiles
External_Function DragAcceptFiles    'DragAcceptFiles'      Shell32.dll Handle hwnd Integer iFlag Returns Integer
#ENDIF
#IFNDEF get_DragQueryFile
External_Function DragQueryFile      'DragQueryFile'        Shell32.dll Handle hDrop Integer iFileIndex Pointer pFileBuff Integer iBuffSize Returns Integer
#ENDIF
#IFNDEF get_DragFinish
External_Function DragFinish         'DragFinish'           Shell32.dll Handle hDrop Returns Integer
#ENDIF

