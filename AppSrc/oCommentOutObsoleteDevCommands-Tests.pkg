    Object oCommentOutObsoleteDevCommands is a cTestFixture
        Set psFunctionName to "CommentOutObsoleteDevCommands"

        // A dev-only command (Debug) is commented out with the note.
        {Published = True}
        Procedure CommentOutObsoleteDevCommands_Debug
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Debug "checkpoint"' to sLine
            Move '// Debug "checkpoint" // obsolete command - no-op in modern DataFlex' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutObsoleteDevCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A character-mode Set_ relic is commented out too.
        {Published = True}
        Procedure CommentOutObsoleteDevCommands_SetCursorVisible
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Set_cursor_visible False' to sLine
            Move '// Set_cursor_visible False // obsolete command - no-op in modern DataFlex' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutObsoleteDevCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Leading indentation is preserved.
        {Published = True}
        Procedure CommentOutObsoleteDevCommands_Indented
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move '    Memory' to sLine
            Move '    // Memory // obsolete command - no-op in modern DataFlex' to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutObsoleteDevCommands of ghoFuncLib (&sLine) to bChanged
            Send Assert bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Idempotent: an already-commented line is left alone (never stacks "// //").
        {Published = True}
        Procedure CommentOutObsoleteDevCommands_NoChange_AlreadyCommented
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move '// Debug "checkpoint"' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutObsoleteDevCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual '// Debug "checkpoint"' sLine
        End_Procedure

        // Command position only: a dev word that is NOT the first token never matches (e.g. "memory"
        // used as a message name), so ordinary code is not touched.
        {Published = True}
        Procedure CommentOutObsoleteDevCommands_NoChange_NotCommandPosition
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'Get memory to iVal' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get CommentOutObsoleteDevCommands of ghoFuncLib (&sLine) to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'Get memory to iVal' sLine
        End_Procedure

    End_Object
