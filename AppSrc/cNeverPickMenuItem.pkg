Use cCJCommandBarSystem.pkg      // cCJMenuItem
Use cFTDbCJGrid.pkg              // the grid whose right-click menu carries this item - it registers phoData_Col
Use cRefactorApplication.pkg     // IsNeverPickFunction / SetNeverPickFunction - the list lives there

/* THE ROW'S OWN "NEVER PICK" SWITCH, on the grid's right-click menu (Nils 2026-09-23: "the user
   should be able to select functions that never should be selected for e.g. auto-fixable - as it
   is now, the user needs to untick those functions each and every time"). The list itself lives
   on cRefactorApplication (NeverPickFunctions - a per-user setting, no table field, no DUF step);
   what it means is written there. Reached through the grid's data column, like the library's
   own menu items (phoData_Col delegates up to the grid).

   SelectFunctionsFT.vw's grid adds it to its right-click menu. Its own package since 2026-09-30: a
   class belongs in a package, never in a view file - there it sat between Activate_View and the
   view's object, and the Studio's Designer refused the whole view ("This source is not structured
   properly", Nils). */
Class cNeverPickMenuItem is a cCJMenuItem
    Procedure Construct_Object
        Forward Send Construct_Object
        Set psCaption to "Never pick this function for me - it does not run"
        Set psToolTip to "Ticked: this function does not run - not from a refactoring plan, not by Select All, not even when ticked. Untick it to let the function run again."
        Set pbControlBeginGroup to True
        Set pbActiveUpdate to True
    End_Procedure

    Function IsChecked Returns Boolean
        String sFn
        Get SelectedRowValue of (phoData_Col(Self)) to sFn
        Function_Return (IsNeverPickFunction(ghoApplication, Trim(sFn)))
    End_Function

    Procedure OnExecute Variant vCommandBarControl
        String sFn
        Boolean bNever
        Handle hoGrid

        Get SelectedRowValue of (phoData_Col(Self)) to sFn
        Move (Trim(sFn)) to sFn
        If (sFn = "") ;
            Procedure_Return
        Get IsNeverPickFunction of ghoApplication sFn to bNever
        // The grid's switch writes the list, unticks a function put on it, and re-reads the row (2026-10-06).
        Move (Parent(Parent(Self))) to hoGrid
        Send SetNeverPick of hoGrid sFn (not(bNever))
    End_Procedure
End_Class
