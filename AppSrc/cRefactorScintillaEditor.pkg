    Object oWhitespaceItem is a cCJMenuItem
        Set pbControlBeginGroup to True
        Set psCaption   to "Toggle Whitespace"
        Set psToolTip to "Toggle Whitespace"
        Set psDescription to "Show Whitespace in an Editor Window"
