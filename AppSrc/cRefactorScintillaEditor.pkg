     // Toggle comments.
     // The logic checks if there is a comment for the first 2 characters at the first
     // line, if there is.. it will try to remove the comments
     // if there is not, then it will insert comments -in the first two positions- for
     // all selected lines.
    Procedure ToggleComment
        Boolean bAddComments bHasSelection
        Integer iStart iEnd iLine iRet iEndCol iStartCol iCurrLine
        String sVal sChk
        
        Append sChk "//"
        Get RefreshSelectionState to bHasSelection
        Get piSelEndCol    to iEndCol
        Get piSelStartCol  to iStartCol
        Get piSelStartLine to iStart
        Get piSelEndLine   to iEnd
        Move iEnd          to iCurrLine

        // Is selection at end line column 1? Don't include that line...
        If (iStart<>iEnd) Begin
            If (iEndCol=0) Decrement iEnd
        End
        //
        // Check the first line to see if we are going to add or remove comments
        Move False to bAddComments
        Get LineText iStart to sVal
        If (Left(sVal,2) <> sChk) Begin
          Move True to bAddComments
        End

            // Run all lines and toggle the comment mark.
        Send BeginUndoGroup
        For iLine from iStart to iEnd
            Get LineText iLine to sVal
            If (bAddComments) Begin
              Move (Append(sChk,sVal)) to sVal
            End
            Else Begin
              If (Left(sVal,2) = sChk) Move (Replace(sChk,sVal,"")) to sVal
            End
            Send SetLineText iLine sVal
        Loop
        Send EndUndoGroup
        // Keep the selection
        Send SelectRange iStart iStartCol iCurrLine iEndCol
        // This must be after the SelectRange line
        Send EditorMessage SCI_GOTOLINE iLine 
    End_Procedure

    Procedure ChangeTextEncoding
      Integer  iEncoding
      Integer  iOldEncoding
      Integer  iCharSet
      Boolean  bConvertText

      Get EncodingMode to iEncoding
        Case Begin
            Case (iEncoding = eTE_UTF8) // 1
            Send EditorMessage SCI_SETCODEPAGE SC_CP_UTF8
            Send EditorMessage SCI_STYLESETCHARACTERSET STYLE_DEFAULT SC_CHARSET_ANSI
            Set pbOemMode       to False
            Set pbUtf8Mode      to True
            Case Break
        Case (iEncoding = eTE_OEM)  // 2
            Send EditorMessage SCI_SETCODEPAGE 0  // must tell scintilla to switch to single byte mode
            Send EditorMessage SCI_STYLESETCHARACTERSET STYLE_DEFAULT SC_CHARSET_OEM
            Set pbOemMode       to True
            Set pbUtf8Mode      to False
            Case Break
        Case (iEncoding = eTE_ANSI) // 3
            Send EditorMessage SCI_SETCODEPAGE 0  // must tell scintilla to switch to single byte mode
            Send EditorMessage SCI_STYLESETCHARACTERSET STYLE_DEFAULT SC_CHARSET_ANSI
            Set pbOemMode       to False
            Set pbUtf8Mode      to False
            Case Break
        Case End
    End_Procedure

    Procedure SetAdjustments Boolean bIsPaged
        Boolean bIsOemMode
        Boolean bIsUtf8Mode
        Integer hoIni iRet
        // Font Face
        String  sLanguage
        String  sFontData
        String  sFontTemp
        String  sFontFace
        Integer iFontSize
        Integer iCharSet

        //

        Move ghoEditorProperties  to hoIni
        Send ShowLineNumbers (Low(piLineNumbering(hoIni)))
        Send EnableFolding   (pbLeftMargin(hoIni))    // the "left margin" setting has
                                                      // always been the fold margin
        Get psLanguage of hoIni to sLanguage

        Send ApplyEditorLanguage sLanguage
        Send ShowHorizontalScrollBar (pbScrollBarH(hoIni))
        Send ShowVerticalScrollBar   (pbScrollBarV(hoIni))
        // Editor font face?
        Move (psFontFace(ghoEditorProperties))                          to sFontData
        If (sFontData="") Begin
            Move "11pt; 0; Courier New"                   to sFontData
        End
        // Font Size
        Move (Left(sFontData, Pos(";", sFontData)))                     to sFontTemp
        Move (Trim(Replace(sFontTemp, sFontData, "")))                  to sFontData
        Move (Trim(Replace("PT;", Uppercase(sFontTemp), "")))           to iFontSize
        // Code Page
        Move (Left(sFontData, Pos(";", sFontData)))                     to sFontTemp
        Move (Trim(Replace(sFontTemp, sFontData, "")))                  to sFontData
        Move (Trim(Replace(";", sFontTemp, "")))                        to iCharSet
        
        Move True to bIsOemMode
        If (bIsPaged) Begin
          Move False to bIsUtf8Mode
        End
        Else Begin
          // Don't change an existing UTF8 mode of a document when this method is called from the
          // Hammer Options screen.
          Get pbUtf8Mode to bIsUtf8Mode
        End
        //
        If (bIsUtf8Mode) Begin
          Send EditorMessage SCI_SETCODEPAGE SC_CP_UTF8
          Move SC_CHARSET_ANSI to iCharSet
          Set pbOemMode       to False
          Set pbUtf8Mode      to True
        End
        Else Begin
          //
          Send EditorMessage SCI_SETCODEPAGE 0  // must tell scintilla to switch to single byte mode
          //
          Set pbUtf8Mode      to False 
          Set pbOemMode       to bIsOemMode
          If (bIsOemMode) Begin
            If (iCharSet<=0) Begin
              Move SC_CHARSET_OEM to iCharSet
            End
          End
        End

        // Font Face
        Move (Trim(sFontData))                                          to sFontFace
        //
        Send EditorMessage SCI_STYLESETFONT STYLE_DEFAULT (AddressOf(sFontFace))
        Send EditorMessage SCI_STYLESETSIZE STYLE_DEFAULT iFontSize
        Send EditorMessage SCI_STYLESETCHARACTERSET STYLE_DEFAULT iCharSet
        Send EditorMessage SCI_STYLESETSIZE STYLE_LINENUMBER (iFontSize-1) // Set font size
        //
        Set pbShowMatchingBraces to (pbShowMatchingBraces(hoIni))
        Send SetIndentationGuides      (pbShowIndentGuides(hoIni))
        Send SetSelectionFillsLineEnd  (pbSelectWholeLine(hoIni))
        Send SetAutoIndentMode         (piAutoIndentMode(hoIni))
        Send SetTabWidth               (piTabSize(hoIni))
        // "Tab expand" means tabs become spaces, so it is the inverse of use-tabs.
        Send SetUseTabs                (not(pbTabExpand(hoIni)))
        Set pbNormalizeCase to (pbNormalizeCase(hoIni))
        Get ApplySearchOptions (pbWholeWord(hoIni)) (pbCaseSensitive(hoIni)) False ;
                             (pbFindDocumentStart(Self)) to iRet
        /* Four settings are deliberately gone: Drag and Drop, Column Select, Selection
           Bounds and Global Properties. Each sent a CodeMax window message that a
           Scintilla control does not implement, so all four have been doing nothing
           since the day the facade was written - the switches for the first three are
           still on the Options page and still have no effect. Wiring them up for real
           is its own change; pretending they work is not. */
    End_Procedure
        

    Procedure LoadEntries
        String sLanguage
        Integer iC    
        tSCLanguage SCLanguage

        Move CS_EditorLanguage to sLanguage
        Get FindLanguage of ghoEditorProperties sLanguage to iC
        If (iC < 0) Begin
            Error DFERR_PROGRAM "Scintilla Language settings could not be loaded (LoadEntries - cRefactorScintillaEditor)"
        End
        
        /* Eleven more sub-values used to be read into SCLanguage here - dwStyle,
           bIsCaseSensitive, the string delimiters, the escape and terminator characters,
           the three comment markers and the three HTML/XML tag lists. Every one of them
           was WRITE-ONLY: measured across all of AppSrc, nothing ever read those struct
           members back. They are Hammer-era leftovers from when this dialog was built
           (Nils, 2026-07-28).
        
           Only the four the engine consumes are filled now. _AddAllKeyWords in
           cBaseFuncLib reads saScopeStart, saScopeStop, saKeywords and saOperators, and
           those are what seed ghoFuncLib's keyword arrays.
        
           The SETTINGS themselves are untouched - psLanguages still stores all fifteen
           sub-values at their original indices, because those indices are the on-disk
           format and renumbering them would misread every saved language definition.
           This drops the reads, not the data. */

        Send RefactorAppendSplitLine (psLanguages.szScopeKeywords1(ghoEditorProperties,iC))       "\n" (&SCLanguage.saScopeStart)
        Send RefactorAppendSplitLine (psLanguages.szScopeKeywords2(ghoEditorProperties,iC))       "\n" (&SCLanguage.saScopeStop)
        Send RefactorAppendSplitLine (psLanguages.szKeywords(ghoEditorProperties,iC))             "\n" (&SCLanguage.saKeywords)
        Send RefactorAppendSplitLine (psLanguages.szOperators(ghoEditorProperties,iC))            "\n" (&SCLanguage.saOperators)

        Set pSCLanguage of ghoApplication to SCLanguage 
        Send _AddAllKeyWords of ghoFuncLib
    End_Procedure
    
    // Note: This calls "LoadEntries" above.
    // We have a bit of a timing problem as we get here when the ghoFuncLib has been created,
    // and its AddAllKeyWords message relies on that the ghoApplication's pSCLanguage was set.
    // But it wasn't (too early), so we load the Scintilla editor language properties here, sets the pSCLanguage
    // property and call AddAllKeyWords.
    // The editor's own post-page setup. The LANGUAGE half - lexer, keyword lists,
    // normalize-case dictionary - is ApplyLanguage in cScintillaSchemeView, shared with
    // the settings preview so both lex DataFlex identically. Everything below it is the
    // editor's alone: its command table, its hotkeys, and the engine wiring LoadEntries
    // does.
    Procedure SetLexer
        Integer iRet
        String  sHotKeys

        Send ApplyLanguage
        // Use shortcut keys as defined in hammer config codemaxedit.ini file.
        Send RegisterAllInternalCommands
        Send RegisterExtraCommands 
        
        // To set the pSCLanguage of ghoApplication and to
        // send AddAllKeyWords of ghoEngine.
        Send LoadEntries

        Get psEditorHotKeys of ghoEditorProperties to sHotKeys
        Get SetEditorHotKeys sHotKeys  to iRet
        // The bindings are live now, so the context menu can advertise the real keys.
        // Reached again after a settings save, which broadcasts ApplyEditorOptions.
        Send RefreshShortcutCaptions of oSciContextMenu
    End_Procedure

    Function Line_Count Returns Integer
        Integer iCount
        Get DocumentLineCount to iCount
        Function_Return iCount
    End_Function

    Function Line Integer iLine Returns String
        String sLine
        Get LineText iLine to sLine
        Function_Return sLine
    End_Function

    // Like LineText but deliberately does NOT convert the encoding - raw buffer bytes.
    Function EditorLine Integer iLine Returns String
        Integer iEOLPos iStartPos iLineLength iRet
        String  sBuffer
        tSci_TextRange Sel
        
        Move "" to sBuffer
        Get EditorMessage SCI_POSITIONFROMLINE   iLine to iStartPos
        If (iStartPos >- 1) Begin
            Get EditorMessage SCI_GETLINEENDPOSITION iLine to iEOLPos
            Move (iEOLPos - iStartPos) to iLineLength
            If (iLineLength <> 0) Begin
                Move iStartPos to Sel.chrg.cpMin
                Move iEOLPos   to Sel.chrg.cpMax
                Move (ZeroString(iLineLength + 1)) to sBuffer
                Move (AddressOf(sBuffer)) to Sel.lpstrText
                Get EditorMessage SCI_GETTEXTRANGE 0 (AddressOf(Sel)) to iRet
                Move (CString(sBuffer)) to sBuffer
            End
        End
        Function_Return sBuffer
    End_Function

    Procedure AppendText String sText
        Send AddTextAtCaret sText
    End_Procedure

    Procedure Page_Object Integer bState
        Handle hWnd
        Forward Send Page_Object bState
        Get Window_Handle to hWnd
        If (hWnd <> 0) Begin
            Send SetAdjustments True
        End
    End_Procedure

End_Class
