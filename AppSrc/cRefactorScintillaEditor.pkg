            Move (Focus(Self)) to hoEditor
            Get IsWhitespaceVisible of hoEditor to bIsWhiteSpace
            Send ShowWhitespace of hoEditor (not(bIsWhiteSpace))
        End_Procedure
        
    End_Object

    // Works on the SELECTION, so it is enabled only when there is one - a menu item that
    // can only report "select something first" is a dead click.
    Object oConvertCDeclMenuItem is a cCJMenuItem
        Set psCaption to "Convert C Declaration to External_Function"
        Set psToolTip to "Convert a C prototype to an External_Function"
        Set psDescription to "Converts the selected C function prototype into a DataFlex External_Function declaration"
