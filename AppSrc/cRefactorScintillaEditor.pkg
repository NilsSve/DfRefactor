        End_Procedure
    End_Object

    /* Quick Marks - a stack of places. Push records where you are; Pop returns you to the
       newest place recorded, in another file if that is where it was pushed. In Goto Line's
       group because it is the other way of moving the caret somewhere on purpose. */
    Object oPushQuickMarkMenuItem is a cCJMenuItem
        Set psCaption to "Push Quick Mark"
        Set psToolTip to "Push Quick Mark"
        Set psDescription to "Pushes the current line onto the Quick Mark stack"
        Set psShortcut to "Ctrl+Q"
        Set psImage to "PushQuickMark.ico"

        Procedure OnExecute Variant vCommandBarControl
            Send PushQuickMark of (phoServedObject(Self))
        End_Procedure

        Function IsEnabled Returns Boolean
            String sFile
            Get psCodeFile of (phoServedObject(Self)) to sFile
            Function_Return (sFile <> "")
        End_Function
    End_Object

    Object oPopQuickMarkMenuItem is a cCJMenuItem
        Set psCaption to "Pop Quick Mark"
        Set psToolTip to "Pop Quick Mark"
        Set psDescription to "Pops the newest Quick Mark and returns to it"
        Set psShortcut to "Ctrl+Shift+Q"
        Set psImage to "PopQuickMark.ico"

        Procedure OnExecute Variant vCommandBarControl
            Send PopQuickMark of (phoServedObject(Self))
        End_Procedure

        Function IsEnabled Returns Boolean
            Integer iCount
            Get QuickMarkCount of (phoServedObject(Self)) to iCount
            Function_Return (iCount > 0)
        End_Function
    End_Object

    Object oSelectAllMenuItem is a cCJMenuItem
