Use cCJStandardMenuItemClasses.pkg
Use cRefactorApplication.pkg
Use cRefactorEditorHotKeys.pkg          // DFRefactor's own hotkey mixin (new vocabulary)
Use cRefactorEditorCommands.pkg         // the bridge + Normalize Case / Re-indent / Drop Self
Use cEditorColourScheme.pkg             // the theme's own selection settings
Use cDeepScanner.pkg                    // BuildDefaultDeepScanRules - the obsolete-symbol list F1 gates on
Use cRefactorEditorSettings.pkg
Use cQuickMarkStack.pkg                 // the Push / Pop Quick Mark stack - pure; the Scintilla side is below
Use cSymbolIndex.pkg                    // Go to definition's name -> file/line index - pure; built on first use below
// A program with a Go to definition chooser of its own Uses it before this package, and that file
// defines C_OwnGotoDefinitionPicker - then this one stays out.
#IFNDEF C_OwnGotoDefinitionPicker
Use GotoDefinitionPicker.dg             // the chooser for a name defined in several places
#ENDIF
Use cShadowedPackageFiles.pkg           // NewestListingFile / IncludedFileFromPrnLine - the index scope's fallback
Use Cursor.pkg                          // the wait cursor over the index build
Use RefactorLineSplit.pkg               // RefactorSplitLine - replaces the library's
Use RefactorFileIO.pkg           // rfOpenOutput / rfCloseOutput - channel file I/O
Use cEncodingHelpers.pkg         // rfHtmlEscape and the encoding helpers
                                        // Array-derived cLineParser

Declare_Datafile FunctionsA

// The fold and bookmark margin icons come from Scintilla's image DLL. Declared here
// because the editor is the only thing that draws them - the control class has no
// opinion about appearance. (Guarded: the declaration used to live in cSciLexer.pkg,
// which other programs may still pull in.)
// SCIMAGE_DLL / SciEditorIconXpm - the fold-margin and bookmark pixmaps - are declared
// in cScintillaSchemeView.pkg, which is where ApplyFoldingStyle now lives.

// Authoritative copy is in RefactorConstants.h.pkg; this guard only covers a program that pulls
// this package in without that header.
#IFNDEF C_CtrlShiftTab
    Define C_CtrlShiftTab for 7170
#ENDIF
Register_Object oOpenFolderMenuItem
// Defined on cRefactorScintillaEditor BELOW this menu - register so the menu items
// can reference them at compile time.
Register_Procedure CloseFile
Register_Function psCodeFile Returns String
Register_Function QuickMarkCount Returns Integer   // Quick Marks - the Pop item's IsEnabled asks it
// Defined on cRefactorScintillaEditor below, claimed by On_Key statements in its
// Construct_Object - which is compiled before the procedure bodies.
Register_Procedure SelectSourceFileHotKey
Register_Procedure WorkspaceDialogHotKey
Register_Procedure SourceExplorerHotKey
Register_Procedure SettingsDialogHotKey
Register_Procedure SwallowEditorHotKey
/* The three application actions those handlers reach are defined in DFRefactorFT.src's
   oClientArea, which is compiled AFTER this package - and is not part of the
   UnitTests build AT ALL. Without these the editor package compiles in the FT app
   (the definition arrives later in the same program) but fails the test runner with
   "4306 Forward reference not resolved", which is how this was caught. Registering the
   messages satisfies both: the Send resolves up the delegation chain to oClientArea where
   it exists, and is an inert no-op in the programs where it does not. */
Register_Procedure ActivateWorkspaceDialog
Register_Procedure ActivateSourceExplorer
Register_Procedure ActivateSettings

Object oSciContextMenu is a cCJContextMenu
    Property Handle phoServedObject 0

    /* Go to definition - first, as in the Studio. The caption names the word under the caret
       and is set as the menu pops (OnBeforeFloatingMenu in the editor below: the bridge sends
       it just before Popup, after Scintilla has already moved the caret to the right-click). */
    Object oGotoDefinitionMenuItem is a cCJMenuItem
        Set psCaption to "Go to definition"
        Set psToolTip to "Go to definition"
        Set psDescription to "Jumps to where the word under the cursor is defined - in this file, the workspace or the DataFlex packages (Ctrl+Shift+G, or F12)"
        Set psShortcut to "Ctrl+Shift+G / F12"
        Set psImage to "LocateInEditor2.ico"

        Procedure OnExecute Variant vCommandBarControl
            Send GotoDefinition of (phoServedObject(Self))
        End_Procedure

        Function IsEnabled Returns Boolean
            Handle ho
            String sFile sWord
            Move (phoServedObject(Self)) to ho
            Get psCodeFile of ho to sFile
            If (sFile = "") ;
                Function_Return False
            Get WordAtCaret of ho to sWord
            Function_Return (Trim(sWord) <> "")
        End_Function
    End_Object

    Object oSourceFileText_MenuItem is a cCJMenuItem
        Set pbControlBeginGroup to True
        Set psCaption to "Select Source File"
        Set psDescription to "Displays an Open File dialog to select a source file from (Ctrl+O)"
        Set psImage to "ActionOpen.ico"
        Set psShortcut to "Ctrl+O"

        Procedure OnExecute Variant vCommandBarControl
            Forward Send OnExecute vCommandBarControl
            Send SelectSourceFile of ghoApplication
        End_Procedure

        Function IsEnabled Returns Boolean
            Boolean bState
            String sSWSFile

            Move False to bState
            Get psSWSFile of ghoApplication to sSWSFile
            Move (sSWSFile <> "") to bState

            Function_Return bState
        End_Function

    End_Object

    Object oRefreshFile_MenuItem is a cCJMenuItem
        Set psCaption to "Refresh File"
        Set psDescription to "Refresh the file by loading it again from disk"
        Set psImage to "Refresh.ico"

        Procedure OnExecute Variant vCommandBarControl
            Integer iCurrentLine iRet
            String sFileName
            Handle ho
            
            Move (phoServedObject(Self)) to ho
            Get CurrentLine of ho to iCurrentLine
            Get psCodeFile of ho to sFileName
            Get OpenFile of ho sFileName to iRet
            Send EditorMessage of ho SCI_SETSAVEPOINT
            If (iCurrentLine <> 0) Begin
                Send EditorMessage of ho SCI_GOTOLINE iCurrentLine
            End
            Send FillFileTimeStamp of ho sFileName // Update the file modified datetime.
        End_Procedure

        Function IsEnabled Returns Boolean
            String sFile
            Get psCodeFile of (phoServedObject(Self)) to sFile
            Function_Return (sFile <> "")
        End_Function

    End_Object

    Object oOpenFileUnderCursor_MenuItem is a cCJMenuItem
        Set psCaption to "Open File Under Cursor"
        Set psDescription to "Opens the file under the cursor in the editor"
        Set psImage to "ActionOpenContainingFolder.ico"

        Procedure OnExecute Variant vCommandBarControl
            String sFileName sExt sSystemMakePath sPkgPath
            String[] asPaths
            Handle ho
            Boolean bExists 
            Integer iSize i
            
            Move (phoServedObject(Self)) to ho
            Get WordAtCaretIncludingDots of ho to sFileName
            Get ParseFileExtension sFileName to sExt

            If (sFileName = "" or Lowercase(sExt) = "") Begin
                Send Info_Box "OpenFileUnderCursor: There is no file to open under the cursor."
                Procedure_Return
            End
            Get ResolveSourceFileInTree of ghoApplication sFileName to sFileName
            // If not found in the workspace, it might be a system file:
            If (sFileName = "") Begin                         
                Get psSystemMakePath of (phoWorkspace(ghoApplication)) to sSystemMakePath
                Move (StrSplitToArray(sSystemMakePath, ";")) to asPaths
                Move (SizeOfArray(asPaths) -1) to iSize
                For i from 0 to iSize
                    If (Lowercase(asPaths[i]) contains "\pkg") Begin
                        Move asPaths[i] to sPkgPath
                        Get vFolderFormat sPkgPath to sPkgPath
                        Get WordAtCaretIncludingDots of ho to sFileName
                        Move (sPkgPath + sFileName) to sFileName
                    End
                Loop
            End
            Get vFilePathExists sFileName to bExists
            If (bExists = False) Begin
                Send Info_Box ("The file could not be found:" * (String(sFileName)))
                Procedure_Return
            End
            Send OnFileNameUpdate of ghoApplication sFileName
            Send LoadFile of (phoEditor(ghoApplication)) sFileName
        End_Procedure

        Function IsEnabled Returns Boolean
            String sFile
            Get psCodeFile of (phoServedObject(Self)) to sFile
            Function_Return (sFile <> "")
        End_Function

    End_Object

    Object oCloseFileMenuItem is a cCJMenuItem
        Set psCaption to "Close File"
        Set psToolTip to "Close File"
        Set psDescription to "Closes the file currently loaded in the editor (asks to save pending changes first)"
        Set psImage to "ActionClose.ico"

        Procedure OnExecute Variant vCommandBarControl
            Send CloseFile of (phoServedObject(Self))
        End_Procedure

        Function IsEnabled Returns Boolean
            String sFile
            Get psCodeFile of (phoServedObject(Self)) to sFile
            Function_Return (sFile <> "")
        End_Function
    End_Object

    Object oCutMenuItem is a cCJCutMenuItem
    End_Object

