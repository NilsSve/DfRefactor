//****************************************************************************
// $Module type: Package
// $Module name: FTThemeSeed
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-08-13
//
// Description : SeedFTTheme: giFTThemeMode from the saved theme choice, once, as soon as the application
//               object exists - before any FT panel or dialog is built, since those colour themselves as
//               they are. DFRefactorFT's application object sends it at the end of its construction.
//
//               DFRefactor's own since 2026-09-28, no longer the RDCFlexTron library's: the library's
//               cFTApplication reads the theme itself, and DFRefactorFT's application object cannot be one -
//               cRefactorApplication is shared with the light builds and the test programs, which must not
//               pull in FlexTron.
//
//               Since the pin moved to 0.9.1 (2026-09-29) it also sends FTThemeLateObjects: the FT objects built
//               before this read take the theme then. SeedFTAppGlyphs names DFRefactor's own glyph folder.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use FTConstants.h.pkg   // CI_FTTheme*, giFTThemeMode, CS_FTThemeSection / CS_FTTheme, CS_FTAppGlyphFolder
Use FTThemeColors.pkg   // FTThemeLateObjects - the FT objects that waited for the theme
Use FTAppGlyphs.pkg     // FTLoadAppGlyphsFrom - DFRefactor's own glyphs
Use cRefactorApplication.pkg    // pOrgWS - DFRefactor's OWN workspace

Procedure SeedFTTheme Global
    Integer iMode

    If (giFTThemeMode <> CI_FTThemeUnset) ;
        Procedure_Return
    If (ghoApplication = 0) ;
        Procedure_Return

    Get ReadInteger of ghoApplication CS_FTThemeSection CS_FTTheme CI_FTThemeDark to iMode
    // A value written by a future version - or a hand-edited registry - must not leave the global on
    // a meaningless number, so anything unrecognised falls back to dark.
    If (iMode < CI_FTThemeDark or iMode > CI_FTThemeSystem) ;
        Move CI_FTThemeDark to iMode
    Move iMode to giFTThemeMode
    // The FT objects built before the theme was known waited for it (FTThemeLater): now they take it.
    Send FTThemeLateObjects
End_Procedure

/* DFRefactor's own glyphs - the SVG files in its AppHtml\FTGlyphs (CS_GlyphCompile & co, RefactorConstants.h.pkg) -
   read, and their style sheet written when it is out of date, by the library's FTAppGlyphs.pkg.

   THE FOLDER IS NAMED FROM pOrgWS, DFRefactor's OWN workspace, captured before a target workspace is opened. The
   library would otherwise take it from phoWorkspace, which DFRefactor points at the workspace being worked on - and
   a /bm run replays its target inside the application object's construction, before this is sent (2026-09-29).
   Sent once, from oApplication's End_Construct_Object; the library reads the folder only the first time. */
Procedure SeedFTAppGlyphs Global
    tWorkspacePaths OrgWS
    String sHtml
    If (ghoApplication = 0) ;
        Procedure_Return
    Get pOrgWS of ghoApplication to OrgWS
    Move (Trim(OrgWS.sAppHtml)) to sHtml
    If (sHtml = "") ;
        Procedure_Return
    If (Right(sHtml, 1) <> "\") ;
        Move (sHtml + "\") to sHtml
    Send FTLoadAppGlyphsFrom (sHtml + CS_FTAppGlyphFolder)
End_Procedure
