// Self-terminate with an exit code for a headless /bm run (a DataFlex GUI app can't return one from a
// graceful close). TerminateProcess(-1, code) is the project's safe forced-exit - ExitProcess deadlocks on
// COM/ActiveX detach. Guarded so it can't collide with StartProg.pkg's identical declaration.
#IFNDEF get_TerminateProcessEf
    External_Function TerminateProcessEf "TerminateProcess" kernel32.dll Handle hProcess Integer uExitCode Returns Integer
#ENDIF

Class cRefactorApplication is a cRDCApplication

    Import_Class_Protocol cCompileMixin

    Procedure Construct_Object
        String sVal

        Forward Send Construct_Object

        Send Define_cCompileMixin

        Property Integer piBackupDaysOverwriteCycle 2

        // Cached result of BackupsPastCycleCount (a backup-tree walk, too costly to repeat on every
        // tile repaint - the Workspace tile is painted by THREE views). -1 = not computed yet.
        // Invalidated by a workspace change (UpdateWorkspaceSelectorDisplay) and by every backup
        // actually written (SaveBackupFile). A CYCLE change needs no invalidation call: the cycle the
        // count was computed for is cached alongside it and compared on every read.
        Property Integer piBackupsPastCycleCache -1
        Property Integer piBackupsNearingCycleCache -1
        Property Integer piBackupsCacheCycle 0


        // True once program exit is COMMITTED (every exit confirmation passed - set by the desktop
        // Exit_Application augment in the .src). During teardown the CodeJock MDI activates the NEXT
        // view as the current one closes, and a view's Activate handler that (re)shows a dock then
        // hits half-destroyed CJ COM objects (error 4399, pvComObject NULL in ComEnableGroups - exit
        // with the Modernize pane open, Nils 2026-07-03). Dock/panel show paths check this and no-op
        // once the app is exiting. Never reset - the process is going away.
        Property Boolean pbAppExiting False

        // ProgressTick state. See ProgressTick / ProgressTickStart below.
        {Visibility=Private}
        Property Integer private.piTickThresholdMs 100
        {Visibility=Private}
        Property Integer private.piLastTickCount 0
        {Visibility=Private}
        Property Boolean private.pbCancelRequested False

        // Accumulators for the recursive workspace-library folder walk
        // (GetWorkspaceLibrarySourceFolders). Reset at the start of each walk.
        // pasLibVisited holds lowercased .sws paths already processed (cycle
        // guard); pasLibFolders accumulates the resolved library source folders.
        {Visibility=Private}
        Property String[] pasLibVisited
        {Visibility=Private}
        Property String[] pasLibFolders

        {Visibility=Private}
        Property String private.psFileCompareApp
        {Visibility=Private}
        Property String private.psStarZenSourceExplorer
        {Visibility=Private}
        Property Integer private.piToolbarIconSize 0
        {Visibility=Private}
        Property Integer private.peTabpagePosition xtpTabPositionLeft
        {Visibility=Private}
        Property String private.psGridRowBackgroundColor 0
        {Visibility=Private}
        Property Boolean private.pbWorkspaceMode True
        {Visibility=Private}
        Property Integer private.piActiveView -1
        {Visibility=Private}
        Property Handle private.phoActiveView -1     
        {Visibility=Private}
        Property tSCLanguage pSCLanguage
        {Visibility=Private}    
        Property String private_psHomeTarget ""
        
        {Visibility=Public}
        Property Handle phoFolderSelHeaDD
        {Visibility=Private}
        Property String private_psCompiler ""
        // Output-file suffixes injected into a legacy .cfg that has none (see InjectCfgSuffixes below).
        // Studio's suggestions: "" for 32-bit, "x64" for 64-bit - the x64 default matches the resolvers'
        // old hardcoded fallback, so behavior is unchanged until the user configures them. Registry-
        // persisted per user (Compiler Setup panel; Nils 2026-07-08 - NOT SysFile like the compiler).
        Property String private_psCompilerSuffix32 ""
        Property String private_psCompilerSuffix64 "x64"
        // Resolved target of the refactoring session (set by ResolveTargetDataFlex from psCompiler,
        // fallback DFRefactor's own runtime). Never blank. Read by the analyzer scan + the UI label.
        {Visibility=Public}
        Property String psTargetDfVersion ""
        {Visibility=Public}
        Property String psTargetPkgFolder ""
        // "x64" / "x86" for the selected compiler (psCompiler), or "" if none / undetectable. Resolved by
        // ResolveTargetDataFlex alongside the version; shown on the dashboard Target DataFlex version tile.
        Property String psCompilerBitness ""
        {Visibility=Public}
        Property String psCompOpt CS_CompOptions
        {Visibility=Public}
        Property String psUserName ""
        {Visibility=Public}
        Property Handle phoEditorView 0
        {Visibility=Public}
        Property Handle phoRefactorView 0
        {Visibility=Public}
        Property Handle phoFunctionView 0
        {Visibility=Public}
        Property Handle phoFoldersView 0
        {Visibility=Public}
        Property Handle phoEditor 0
        {Visibility=Public}
        Property String psCurrentSourceFileName ""

        Property Boolean pbBatchMode False
        // Full path where a headless /bm run writes its outcome (STATUS=SUCCESS|FAILED), read from the
        // CmdLine INI's [Result Section] -> Result File Name. "" = don't write one. See WriteBatchResult.
        Property String psBatchResultFile ""

        // Zero based.
        Property Integer piWorkspaceItems 9
        // guided-flow-redesign (branch): the Check Workspace view drove the current compile+analyze, so
        // StartAnalyze's tail hands the analyzed grid to that view's ONE findings list (RenderGuidedFindings)
        // instead of firing the old dashboard nudges (name-collision / Tidy Up / Deep Scan). One-shot: set
        // by the view's Check button, consumed at the next analyze.
        Property Boolean pbGuidedCheckRun False
        /* True while a run the GUIDED TRAIL sent the user off to make is in flight (today: the
           findings board's "Open Tidy Up"). The manual-run handoff in DFRefactorFT.src then closes
           the loop back to the trail - "run Check to verify" - instead of offering the pre-trail
           "Open Test Compile" dialog, which drops the user out of the flow they were following
           (Nils 2026-07-29, after the first Tidy Up pass reached through the trail). One-shot:
           set when the trail routes to Functions, consumed by the next manual run that changed
           files - so a run the user starts on their own still gets the old, correct handoff. */
        Property Boolean pbGuidedTidyUpRun False
        /* (psGuidedTidyUpDoneWS / pbGuidedTidyUpDirty lived here for a few hours on 2026-07-29 and
           were retired the same day: session properties lost the Tidy Up stage - and the Ready badge
           with it - on every restart, and re-earning it costs a full pass. Both facts now persist per
           workspace in the registry; see WriteTidyUpStamp / ReadTidyUpStamp / ReadSourceUnverified.) */
        // STICKY session companion: True once the Check Workspace view has been activated at all.
        // From then on EVERY analyze hands back to the guided findings list, however the compile was
        // started - a dock-driven compile+analyze that left the user in the grid+editor read as the
        // flow losing its place (Nils 2026-07-23).
        Property Boolean pbGuidedSurfaceUsed False
        /* THE COPY'S LIBRARIES DIALOG, PARKED UNTIL THE SCOPE QUESTION HAS BEEN ASKED (Nils
           2026-09-14). The copy step wants the copy's Libraries dialog shown once the copy is open;
           the dashboard wants to ask about scan scope once the board has rendered. Opened from the
           copy's own timer the Libraries modal was up when the scope timer fired, and the two
           interleaved. The copy step now stamps the copy's .sws here; the dashboard's scope timer
           consumes it right after its question and opens the dialog - only when the loaded
           workspace IS that .sws, so a stamp nobody consumed can never fire on another one. */
        Property String psLibrariesAfterScopeWS ""
        // The board the user is working on, stamped by each board's own Activate. Read by screens
        // that are not boards (the Editor's back crumb) so they can return to the RIGHT one. See
        // the eBoard* Defines in RefactorConstants.h.pkg for why the other flags cannot answer it.
        Property Integer piLastBoardView eBoardGuided
        /* Files AllSourceFiles left out because they belong to a dead dependency, packed
           "fullpath|why" (see DeadDependencies.inc). Refilled by every collection.

           It exists so the skip can be SHOWN. Excluding a quarter of a workspace's findings is a
           defensible decision and a terrible secret: reported, the user can disagree and remove a
           token; silent, it reads as "nothing to fix here". Same reasoning as the no-silent-caps
           rule the scan loops follow. */
        Property String[] pasDeadDepSkipped
        /* Files AllSourceFiles left out because they belong to a third-party library, packed
           "fullpath|why" - the same shape and the same reasoning as pasDeadDepSkipped above.

           A library with an upstream is refactored THERE and released; editing the workspace's
           copy forks it, and the next update clobbers the edits or conflicts. A library with NO
           upstream is a different thing entirely - local, private, nobody else's - and stays in
           scope, because refactoring it in place is the only way it is ever modernised
           (Nils 2026-09-16: "libraries might be local and private and those should also be
           possible to refactor"). See rfLibrarySkipReason (RefactorFileIO.pkg) for the three tiers. */
        Property String[] pasLibrarySkipped
        // Selected folders that contributed NO source file - see AllSourceFiles.
        Property String[] pasEmptyFolders
        // The folder list the last collection was handed, verbatim - see AllSourceFiles.
        Property String[] pasLastScopeFolders
        /* The Studio-generated COM proxies the LAST AllSourceFiles call left out. Published for
           the same reason as pasDeadDepSkipped - a skip the user cannot see reads as coverage -
           and for one consumer more: the FlexCOM blocker. A FlexCOM-era proxy is exactly the file
           the exclusion hides, so the Deep Scan sweep and the engine's halt both read THIS list
           for it; without that, DS 9220 could never fire on the only files it exists for
           (rcmail.pkg, LegacyApp4 2026-08-27 - scanned board showed nothing while the
           workspace was unrefactorable). */
        Property String[] pasProxySkipped
        // The full-screen surface the user came FROM - the Start Center as well as the three boards,
        // stamped by all four Activates. Read by the Select Folders / Select Functions crumbs, which
        // are reachable from the Start Center too and so cannot use piLastBoardView (its eBoardGuided
        // default would claim a board the user never opened). Values: eSurfaceStartCenter + eBoard*.
        Property Integer piLastSurface eSurfaceStartCenter
        /* CHECK PHASE STAMPS (Nils 2026-07-26: "64s to compile, 83s before everything is ready -
           does that seem reasonable?"). Check is FOUR phases and only one of them is the compiler,
           so a single total cannot be judged. GetTickCount at each boundary; the guided board
           reports the split when it renders, turning the question into a measurement. All four are
           re-stamped by every Check, and a 0 start means "no Check this session" (a dock-driven
           compile+analyze reports nothing). Timing only - nothing here changes behaviour. */
        Property Integer piChkTickStart   0   // Check pressed
        Property Integer piChkTickScan    0   // deep scan finished (it runs BEFORE the compile)
        Property Integer piChkTickCompile 0   // compiler finished, analyze about to start
        Property Integer piChkTickAnalyze 0   // analyze finished, board about to render
        /* THE COMPILER'S OWN WORDS WHEN A CHECK'S COMPILE DID NOT RUN (Nils 2026-09-23): a non-zero
           exit with no listing - a workspace file it could not load, a project it could not find.
           "" when the compile ran. Set by FinishCompile (TestCompileFT) once its retry is spent,
           cleared by RunGuidedCheck, read by the Check-done dialog - which otherwise judged the
           listing of the PREVIOUS compile and called a program that was never compiled clean. */
        Property String  psChkCompileBail ""
        /* THE COMPILER CRASHED DURING A CHECK'S COMPILE (2026-10-05): what happened, in words - "stack
           overflow, exit code 0xC00000FD" - or "" when it exited. Set by FinishCompile (TestCompileFT)
           from the exit code, cleared by RunGuidedCheck, read by the Check-done dialog, which
           otherwise takes a listing that stops mid-compile for the whole story. */
        Property String  psChkCompileCrash ""
        // The user's "never pick" list, memoised - see NeverPickFunctions. Loaded on first ask.
        Property String[] pasNeverPickCache
        Property Boolean  pbNeverPickLoaded False
        Property String[] pasSelectedFolders
        // Folder list seeded ONLY by the command line (the /folders flag or the CmdLine INI's
        // [Folders] section), consumed ONCE by the folder view's Relate_Main_File ->
        // MarkCmdLineSetSelectedFolders DB sync, then emptied. Deliberately separate from
        // pasSelectedFolders: that one is a LIVE CACHE (re-synced with full paths on workspace
        // load and on every folder-grid refresh), and using it as the sync trigger made every
        // interactive folder-row save (a checkbox tick, Select All) re-run the cmd-line marking,
        // which mis-resolved deep folder paths and faulted err-28 duplicate creates in FolderSelDtl.
        Property String[] pasCmdLineFolders

        /* The [Functions Section] entries from a command-line INI, verbatim - each one a
           "Name" or "Name,Parameter" spec. Kept whole (rather than only the names, which
           is all SelectRecordsFromStringArray needs) because the PARAMETER half has to
           reach the table before the run: the engine reads a function's parameter from
           FunctionsA.Parameter, never from whoever started the run.
           See ApplyCmdLineFunctionParameters below. */
        Property String[] pasCmdLineFunctionSpecs

        /* What was wrong with the command-line INI, in the reader's words - emitted into the run
           summary (and so into both the log file and the batch RESULT.txt) by CollectSummary.

           A /bm run is unattended by definition: a folder that has moved and a function name that
           no longer exists both make the run quietly do LESS than the INI asked for, and every
           readout afterwards looks like an honest success. Nils, 2026-08-03, on exactly this class
           of silence: the empty psSWSFile that made a whole run's classification untrustworthy
           without one visible symptom. Warnings, not errors - a stale entry in an 88-line INI is
           not a reason to throw away a refactoring run, but it IS a reason to say so. */
        Property String[] pasCmdLineIniWarnings
        /* A .sws that arrived before pOrgWS existed (the command-line INI is read during
           argument parsing, ahead of End_Construct_Object). Replayed there - see the note
           in UpdateDFOpenPath. */
        Property String psPendingTargetSWS ""
        // The user's own parameters, saved by the apply so the restore can put them back.
        Property String[] pasCmdLineParamRestore
        /* The Functions DD the apply was handed. Remembered because the restore has to be
           callable from ExitBatchWithCode, which has no DD of its own and cannot name the
           class (see ApplyCmdLineFunctionParameters). The object outlives the run - the
           batch path never reaches its Destroy, because it never returns. */
        Property Handle phoCmdLineParamDD 0
        // The FolderSelHea DD ApplyCmdLineFolderTicks was handed - remembered for the same reason.
        Property Handle phoCmdLineFolderDD 0
        // The INI's [File Filter Section], as ReadCmdLineIniFile read it - ApplyCmdLineSelections puts it in.
        Property String   psCmdLineFilter ""
        /* The user's own function ticks and file filter, saved by ApplyCmdLineSelections before it puts the INI's
           in (2026-11-20) - RestoreCmdLineSelections puts them back. The pb*Saved flags say there is something to
           put back, and make the restore run once though two places call it. */
        Property String[] pasCmdLineTicksRestore
        Property Boolean  pbCmdLineTicksSaved   False
        Property String   psCmdLineFilterRestore ""
        Property Boolean  pbCmdLineFilterSaved  False

        // Workspace-state snapshots. Replace the older psOrg* / psStartup*
        // scalars; see tWorkspacePaths in RefactorConstants.h.pkg for fields.
        //   pOrgWS    - DFRefactor's OWN workspace at startup. Captured
        //               once in End_Construct_Object. Used by
        //               RestoreActiveFilelist and UpdateDFOpenPath to put
        //               state back the way it was after a target run.
        //   pTargetWS - The user-selected target workspace. Refreshed by
        //               UpdateDFOpenPath on every Set psSWSFile; all members
        //               are "" when no target is selected (the "no target"
        //               sentinel).
        // Target readers (Phase 2) must operate on the user-selected target;
        // do NOT migrate cCompileMixin or TestBench's own sample-compile
        // path to pTargetWS - those intentionally read from phoWorkspace.
        Property tWorkspacePaths pOrgWS
        Property tWorkspacePaths pTargetWS

        /* THE tSwsFile REPLACEMENTS for the two above, added alongside them so the migration can
           move one consumer at a time with the tree green throughout (2026-08-06).

           TWO SUBJECTS, not one property used twice, which is why there are two:
             pOwnSws     - DFRefactor's OWN workspace. Restores DF_OPEN_PATH when a target closes,
                           and is what TestBench compiles its own sample against.
             pCurrentSws - the workspace being worked ON (see RefreshCurrentSws).
           Collapsing them would lose the target-vs-own distinction the current code is careful
           about, and quietly point DFRefactor's own restore paths at a customer's workspace.

           Why tSwsFile at all: tWorkspacePaths keeps ONE String per path key and is filled with the
           first entry only, so a workspace declaring "AppSrcPath=.\AppSrc;.\Shared" had the rest
           discarded at the boundary. tSwsPaths carries the arrays both readers already produce.

           psCurrentSwsKey is pCurrentSws's staleness guard - "<lowercased path>|<last write>". The
           target file really does change underneath us: DFRefactor rewrites a .sws in the migration
           copy step, and the DF26 Studio converts one when it migrates a workspace. pOwnSws needs
           no such guard - DFRefactor's own .sws does not change under a running instance. */
        Property tSwsFile pOwnSws
        Property tSwsFile pCurrentSws
        Property String   psCurrentSwsKey ""

        Property Handle phoWorkspaceSelector_Menuitem
        Property Handle phoSwsOpenDialog
        Property Handle phoOpenSourceFileDialog

        Object oSwsOpenDialog is an OpenDialog
            Set phoSwsOpenDialog to Self
            Set Dialog_Caption to CS_SelectWorkspaceFile
            Set Filter_String  to CS_WorkspaceFilterString
        End_Object

        Object oOpenSourceFileDialog is a OpenDialog
            Set Dialog_Caption to "Select a source file"
            Set phoOpenSourceFileDialog to Self
            Set Filter_String to (CS_SourceCodeFilters + "|All Files (*.*)|*.*")
        End_Object

        Set psVersion to C_DFVersion

    End_Procedure

    { MethodType=Property }
    Procedure Set psHomeTarget String sPath
        Set private_psHomeTarget to sPath
    End_Procedure
    
    Function psHomeTarget Returns String
        Function_Return (Private_psHomeTarget(Self))
    End_Function

    // The RDC Windows library's grids ask the application for psHomePath - the folder their Add Folder dialog
    // opens in (cRDCCJGrid / cRDCDbCJGrid.BrowseForFolder). Here that is the selected workspace's home,
    // psHomeTarget; DFRefactor's own home is psHome of phoWorkspace.
    Function psHomePath Returns String
        Function_Return (Private_psHomeTarget(Self))
    End_Function

    // psCompiler is the target compiler. Setting it auto-resolves the target DataFlex version + Pkg
    // folder, so the version label, the scan, and the recipe cache always track the chosen compiler.
    Procedure Set psCompiler String sCompiler
        Set private_psCompiler to sCompiler
        Send ResolveTargetDataFlex
    End_Procedure

    Function psCompiler Returns String
        Function_Return (private_psCompiler(Self))
    End_Function

    // The 32/64-bit output suffixes (registry-persisted; see the private props for the rationale).
    Procedure Set psCompilerSuffix32 String sSuffix
        Set private_psCompilerSuffix32 to (Trim(sSuffix))
        Send WriteString CS_Settings "CompilerSuffix32" (Trim(sSuffix))
    End_Procedure

    Function psCompilerSuffix32 Returns String
        Function_Return (private_psCompilerSuffix32(Self))
    End_Function

    Procedure Set psCompilerSuffix64 String sSuffix
        Set private_psCompilerSuffix64 to (Trim(sSuffix))
        Send WriteString CS_Settings "CompilerSuffix64" (Trim(sSuffix))
    End_Procedure

    Function psCompilerSuffix64 Returns String
        Function_Return (private_psCompilerSuffix64(Self))
    End_Function

    // ---- Temporary .cfg output-suffix injection (Nils 2026-07-08) --------------------------------
    // Legacy (pre-DF20) program .cfgs carry no [Compiler] 32BitSuffix/64BitSuffix, so an x64 build lands
    // UNSUFFIXED (Skinning.exe) and collides with a 32-bit build. Injecting the keys JUST for the compile
    // gives Studio-style suffixed output without permanently changing the customer's cfg. Rules: only an
    // ABSENT key is injected (an explicit value - even blank - is respected); the .cfg must exist (never
    // created); the restore DELETES the injected keys (DeleteKey - writing "" would NOT restore "absent",
    // it would flip the resolvers' absent-default). A registry BREADCRUMB ("CfgSuffixInjected" =
    // "<cfg>|key;key") makes a mid-compile crash self-heal: RestoreInjectedCfgSuffixes runs from the
    // breadcrumb alone, at FinishCompile AND as a stale-sweep at the next StartCompile.
    Function InjectCfgSuffixes String sProgram tSwsFile WS Returns Boolean
        String sBase sCfg sVal sErr sInjected
        Boolean bOK

        Move sProgram to sBase
        If (sBase contains ".") ;
            Move (Left(sBase, Pos(".", sBase) - 1)) to sBase
        Move (vFolderFormat(AppSrcFolderFor(Self, WS, sBase + ".cfg")) + sBase + ".cfg") to sCfg
        If (vFilePathExists(sCfg) = False) ;
            Function_Return False
        Move "" to sInjected
        // Sentinel default so an ABSENT key is distinguishable from an explicit blank value.
        Get GetProgramCfgValue sProgram WS "Compiler" "32BitSuffix" "<DFR-ABSENT>" to sVal
        If (sVal = "<DFR-ABSENT>") Begin
            Get psCompilerSuffix32 to sVal
            Get SetProgramCfgValue sProgram WS "Compiler" "32BitSuffix" sVal (&sErr) to bOK
            If (bOK = True) ;
                Move "32BitSuffix" to sInjected
        End
        Get GetProgramCfgValue sProgram WS "Compiler" "64BitSuffix" "<DFR-ABSENT>" to sVal
        If (sVal = "<DFR-ABSENT>") Begin
            Get psCompilerSuffix64 to sVal
            Get SetProgramCfgValue sProgram WS "Compiler" "64BitSuffix" sVal (&sErr) to bOK
            If (bOK = True) ;
                Move (If(sInjected = "", "64BitSuffix", sInjected + ";64BitSuffix")) to sInjected
        End
        If (sInjected = "") ;
            Function_Return False
        Send WriteString CS_Settings "CfgSuffixInjected" (sCfg + "|" + sInjected)
        Function_Return True
    End_Function

    // Restore (= delete) the keys the last InjectCfgSuffixes added, driven ENTIRELY by the breadcrumb so
    // it also heals a crash leftover. Idempotent: blank breadcrumb / missing cfg = no-op.
    Procedure RestoreInjectedCfgSuffixes
        String sCrumb sCfg sKeys sKey
        Integer iPos
        Handle hoIni
        Boolean bExists

        Get ReadString CS_Settings "CfgSuffixInjected" "" to sCrumb
        If (Trim(sCrumb) = "") ;
            Procedure_Return
        Move (Pos("|", sCrumb)) to iPos
        If (iPos = 0) Begin
            Send WriteString CS_Settings "CfgSuffixInjected" ""   // malformed - just clear it
            Procedure_Return
        End
        Move (Left(sCrumb, (iPos - 1))) to sCfg
        Move (Mid(sCrumb, (Length(sCrumb)), (iPos + 1))) to sKeys
        Get vFilePathExists sCfg to bExists
        If (bExists = True) Begin
            Get Create (RefClass(cIniFile)) to hoIni
            Set psFilename of hoIni to sCfg
            While (sKeys <> "")
                Move (Pos(";", sKeys)) to iPos
                If (iPos > 0) Begin
                    Move (Left(sKeys, (iPos - 1))) to sKey
                    Move (Mid(sKeys, (Length(sKeys)), (iPos + 1))) to sKeys
                End
                Else Begin
                    Move sKeys to sKey
                    Move "" to sKeys
                End
                If (Trim(sKey) <> "") ;
                    Send DeleteKey of hoIni "Compiler" (Trim(sKey))
            Loop
            Send Destroy of hoIni
        End
        Send WriteString CS_Settings "CfgSuffixInjected" ""
    End_Procedure

    // ---- Temporary .cfg manifest-build injection (Nils 2026-07-10) -------------------------------
    // A hand-modernized legacy cfg can say EmbedManifestFile=1 + BuildManifestFile=0 ("embed, but
    // never generate"): the linker then demands an EXISTING <output>.exe.manifest - which a SUFFIXED
    // build has never produced (LegacyApp3: app.exe.manifest hand-written 2019, but the x64
    // output wants appx64.exe.manifest -> "UNABLE TO OPEN FILE ... UNABLE TO CREATE EXECUTABLE").
    // Injecting BuildManifestFile=1 JUST for the compile lets the DataFlex toolchain generate and
    // embed the manifest exactly as the Studio would, without permanently changing the customer's
    // cfg. Rules: the .cfg must exist (never created); only when EmbedManifestFile=1 (otherwise the
    // linker never asks for the file); only when BuildManifestFile is not already 1; and ONLY when
    // the output's manifest (ManifestFileForProgram) is genuinely ABSENT - so the toolchain can only
    // CREATE the missing file, never REGENERATE (silently overwrite) a hand-written one. The
    // generated manifest STAYS afterwards (a build artifact, like the .exe): the next compile finds
    // it and the injection self-retires. The registry BREADCRUMB ("CfgManifestInjected" =
    // "<cfg>|<prev>", <prev> = the key's previous literal value or <DFR-ABSENT>) makes a mid-compile
    // crash self-heal: the restore runs from the breadcrumb alone, at FinishCompile AND as a
    // stale-sweep at the next StartCompile. Run AFTER InjectCfgSuffixes: ManifestFileForProgram
    // reads the suffix keys, so it must see what the compiler will see.
    Function InjectCfgManifestBuild String sProgram tSwsFile WS Returns Boolean
        String sBase sCfg sEmbed sBuild sManifest sErr
        Boolean bOK bExists

        Move sProgram to sBase
        If (sBase contains ".") ;
            Move (Left(sBase, Pos(".", sBase) - 1)) to sBase
        Move (vFolderFormat(AppSrcFolderFor(Self, WS, sBase + ".cfg")) + sBase + ".cfg") to sCfg
        If (vFilePathExists(sCfg) = False) ;
            Function_Return False
        Get GetProgramCfgValue sProgram WS "Application" "EmbedManifestFile" "" to sEmbed
        If (Trim(sEmbed) <> "1") ;
            Function_Return False
        Get GetProgramCfgValue sProgram WS "Application" "BuildManifestFile" "<DFR-ABSENT>" to sBuild
        If (Trim(sBuild) = "1") ;
            Function_Return False
        Get ManifestFileForProgram sProgram WS to sManifest
        Get vFilePathExists sManifest to bExists
        If (bExists = True) ;
            Function_Return False
        Get SetProgramCfgValue sProgram WS "Application" "BuildManifestFile" "1" (&sErr) to bOK
        If (bOK = False) ;
            Function_Return False
        Send WriteString CS_Settings "CfgManifestInjected" (sCfg + "|" + Trim(sBuild))
        Function_Return True
    End_Function

    // Restore BuildManifestFile to what it was before the last InjectCfgManifestBuild - driven
    // ENTIRELY by the breadcrumb so it also heals a crash leftover. <DFR-ABSENT> deletes the key
    // (writing "0" would NOT restore "absent"). Idempotent: blank breadcrumb / missing cfg = no-op.
    Procedure RestoreInjectedCfgManifestBuild
        String sCrumb sCfg sPrev
        Integer iPos
        Handle hoIni
        Boolean bExists

        Get ReadString CS_Settings "CfgManifestInjected" "" to sCrumb
        If (Trim(sCrumb) = "") ;
            Procedure_Return
        Move (Pos("|", sCrumb)) to iPos
        If (iPos = 0) Begin
            Send WriteString CS_Settings "CfgManifestInjected" ""   // malformed - just clear it
            Procedure_Return
        End
        Move (Left(sCrumb, (iPos - 1))) to sCfg
        Move (Mid(sCrumb, (Length(sCrumb)), (iPos + 1))) to sPrev
        Get vFilePathExists sCfg to bExists
        If (bExists = True) Begin
            Get Create (RefClass(cIniFile)) to hoIni
            Set psFilename of hoIni to sCfg
            If (Trim(sPrev) = "<DFR-ABSENT>") ;
                Send DeleteKey of hoIni "Application" "BuildManifestFile"
            Else ;
                Send WriteString of hoIni "Application" "BuildManifestFile" (Trim(sPrev))
            Send Destroy of hoIni
        End
        Send WriteString CS_Settings "CfgManifestInjected" ""
    End_Procedure

    /* ---- The compiled-scope / definition-index cache, on disk ---------------------------------
       Mirrors the ModProgress + DeepScanCache trio exactly: DFRefactor's OWN Data folder (pOrgWS,
       never a customer's), per-workspace key, version gate, NO BOM. See tScopeIndexFile for why. */
    Function ScopeIndexJsonPath Returns String
        String sData sKey sFile sSWS
        tWorkspacePaths OrgWS

        Get pOrgWS to OrgWS
        Move OrgWS.sData to sData
        If (Trim(sData) = "") ;
            Get psDataPath of (phoWorkspace(Self)) to sData
        If (Trim(sData) = "") ;
            Function_Return ""
        Get psSWSFile to sSWS
        Get AnalyzeSnapshotKey sSWS to sKey
        Move CS_ScopeIndexJson to sFile
        If (Trim(sKey) <> "") ;
            Move (Replace(".json", sFile, ("-" + sKey + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    // Returns the cache with sStamp = "" when there is nothing usable to read.
    Function ReadScopeIndex Returns tScopeIndexFile
        Handle hoJson
        tScopeIndexFile TheFile TheEmpty
        String sFile

        Get ScopeIndexJsonPath to sFile
        If (sFile = "") ;
            Function_Return TheEmpty
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return TheEmpty
        Get JsonToDataType of hoJson to TheFile
        Send Destroy of hoJson
        If (TheFile.iVersion <> CI_ScopeIndexVersion) ;
            Function_Return TheEmpty
        Function_Return TheFile
    End_Function

    Procedure WriteScopeIndex tScopeIndexFile TheFile
        Handle hoJson
        UChar[] ucJson
        Integer iCh
        String sFile

        Move CI_ScopeIndexVersion to TheFile.iVersion
        Get ScopeIndexJsonPath to sFile
        If (sFile = "") ;
            Procedure_Return
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson TheFile
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    /* FORCE COMPILER WARNINGS ON FOR THE COMPILE - the same temporary-injection pattern as
       InjectCfgManifestBuild above, and for a sharper reason (Nils 2026-08-20).

       A project's .cfg can say [Application] CompilerWarnings=0, and WinServ's does. That is a
       perfectly reasonable thing for a production build to want, and while DFRefactor issued
       "build-file" it did not matter: build-file ignores the .cfg entirely. Switching to
       "build --target" - which is what finally put the .exe in Programs and got the platform
       right - means the .cfg is honoured, warnings included. The listing then came back
       "Total Warnings : 0" and the whole Modernization analysis had nothing to read.

       Warnings ARE the product here: every obsolete-feature finding the analyzer triages is a
       compiler warning. So they are turned on for the duration of OUR compile and put back after.
       There is no df-cli switch for it (--no-warnings only turns them OFF), so it has to be the
       cfg. Same guarantees as the manifest injection: the .cfg must already exist (never created),
       only when it actually says 0, and a registry BREADCRUMB restores it even if we crash
       mid-compile - at FinishCompile AND as a stale-sweep on the next StartCompile. */
    Function InjectCfgCompilerWarnings String sProgram tSwsFile WS Returns Boolean
        String sBase sCfg sWarn sErr
        Boolean bOK

        Move sProgram to sBase
        If (sBase contains ".") ;
            Move (Left(sBase, Pos(".", sBase) - 1)) to sBase
        Move (vFolderFormat(AppSrcFolderFor(Self, WS, sBase + ".cfg")) + sBase + ".cfg") to sCfg
        If (vFilePathExists(sCfg) = False) ;
            Function_Return False
        Get GetProgramCfgValue sProgram WS "Application" "CompilerWarnings" "<DFR-ABSENT>" to sWarn
        // Absent means the compiler's own default, which is warnings ON - nothing to do.
        If (Trim(sWarn) <> "0") ;
            Function_Return False
        Get SetProgramCfgValue sProgram WS "Application" "CompilerWarnings" "1" (&sErr) to bOK
        If (bOK = False) ;
            Function_Return False
        Send WriteString CS_Settings "CfgWarningsInjected" (sCfg + "|" + Trim(sWarn))
        Function_Return True
    End_Function

    // Put CompilerWarnings back exactly as it was - breadcrumb-driven, so a crash mid-compile heals
    // itself. <DFR-ABSENT> deletes the key (writing "0" would not restore "absent"). Idempotent.
    Procedure RestoreInjectedCfgCompilerWarnings
        String sCrumb sCfg sPrev
        Integer iPos
        Handle hoIni
        Boolean bExists

        Get ReadString CS_Settings "CfgWarningsInjected" "" to sCrumb
        If (Trim(sCrumb) = "") ;
            Procedure_Return
        Move (Pos("|", sCrumb)) to iPos
        If (iPos = 0) Begin
            Send WriteString CS_Settings "CfgWarningsInjected" ""
            Procedure_Return
        End
        Move (Left(sCrumb, (iPos - 1))) to sCfg
        Move (Mid(sCrumb, (Length(sCrumb)), (iPos + 1))) to sPrev
        Get vFilePathExists sCfg to bExists
        If (bExists = True) Begin
            Get Create (RefClass(cIniFile)) to hoIni
            Set psFilename of hoIni to sCfg
            If (Trim(sPrev) = "<DFR-ABSENT>") ;
                Send DeleteKey of hoIni "Application" "CompilerWarnings"
            Else ;
                Send WriteString of hoIni "Application" "CompilerWarnings" (Trim(sPrev))
            Send Destroy of hoIni
        End
        Send WriteString CS_Settings "CfgWarningsInjected" ""
    End_Procedure

    // Resolve the TARGET of the refactoring session from psCompiler (the compiler that compiles the
    // source against the version being migrated TO), falling back to DFRefactor's OWN runtime bin so
    // psTargetDfVersion + psTargetPkgFolder are NEVER blank. Called from Set psCompiler (every change)
    // and once from End_Construct_Object (startup safety net, before ProgramSetup's form sets it).
    // Does NOT set psCompiler - that would recurse through the setter above.
    Procedure ResolveTargetDataFlex
        String sComp sBin sRoot sPkg sVer sBits
        Integer iPos

        Get psCompiler to sComp
        If (sComp <> "") Begin
            Move (RightPos("\", sComp)) to iPos          // strip the compiler exe -> bin folder
            If (iPos > 0) ;
                Move (Left(sComp, (iPos - 1))) to sBin
        End
        If (sBin = "") ;
            Get DFBinPath to sBin                         // fallback: DFRefactor's own runtime bin
        If (sBin = "") ;
            Procedure_Return
        // bin -> install root -> Pkg.
        If (Right(sBin, 1) = "\") ;
            Move (Left(sBin, (Length(sBin) - 1))) to sBin
        Move (RightPos("\", sBin)) to iPos
        If (iPos > 0) Begin
            Move (Left(sBin, (iPos - 1))) to sRoot
            Move (vFolderFormat(sRoot) + "Pkg") to sPkg
        End
        Get DFVersionFromPath sBin to sVer
        Set psTargetPkgFolder to sPkg
        Set psTargetDfVersion  to sVer
        /* Hand the funclib the folder its language catalogue is read from, and re-seed the keyword
           arrays for the new target. PUSHED because the funclib cannot pull it: _AddAllKeyWords runs
           from End_Construct_Object, and under UnitTests the app object is a plain
           cApplication with no psTargetPkgFolder to ask for (error 98, Nils 2026-08-01).

           ghoFuncLib is 0 while the app itself is constructing - it is created later, inside the
           Client_Area - so the startup path arrives here twice: once with nothing to tell, and again
           when the compiler is set. The second one is what actually seeds the grammar. */
        If (ghoFuncLib <> 0) Begin
            Set psLangPkgFolder of ghoFuncLib to sPkg
            Send _AddAllKeyWords of ghoFuncLib
        End
        // Bitness comes from the compiler EXE itself (sComp), not the fallback bin - blank when no compiler
        // is picked (sComp = "" -> DFCompilerBitness returns "").
        Get DFCompilerBitness sComp to sBits
        Set psCompilerBitness to sBits
    End_Procedure
        
    // The psUserName has already have been set, if the /c flag and the name of an ini-file
    // was specified on the command line.
    Procedure InitUserName
        String sName
        Get psUserName to sName
        If (sName = "") Begin  
            Get WindowsUserName to sName
//            Get_Environment "USERNAME" to sName
            Set psUserName to sName
        End
    End_Procedure         
                                  
    Procedure End_Construct_Object
        tWorkspacePaths OrgWS
        String sRegVal

        Forward Send End_Construct_Object

        // Resolve the target DataFlex version + Pkg up front (psCompiler may still be blank here -
        // ProgramSetup's form sets it slightly later and re-resolves via Set psCompiler), so the two
        // are never blank from the very start.
        Send ResolveTargetDataFlex

        Send InitUserName
        /* NOTHING THAT TOUCHES THE DATABASE BELONGS HERE. This procedure runs while the schema is
           still whatever the last release left behind: the update is carried out by a SEPARATE
           program (DUFUpdateProgram.src), launched from DoDatabaseUpdateStuff.pkg, which is Used
           far below this point in all three programs.

           That separation is the fix for a genuine chicken-and-egg. The .fd files are committed, so
           a reference to a new field COMPILES against an old database - and then fails at runtime
           the moment the value is actually used. A separate updater never names the new fields, so
           it builds against any schema and can bring the database forward first.

           Anything needing the database at startup goes in PostDUFWork (DoDatabaseUpdateStuff.pkg),
           which runs only when no update was required - after an update, RunProgram has replaced
           this process and the user starts the program again against the new schema. */

        // The per-user output-suffix settings (Compiler Setup panel; defaults = the Studio suggestions).
        // Loaded into the PRIVATE props - the public setters would write the registry right back.
        Get ReadString CS_Settings "CompilerSuffix32" ""    to sRegVal
        Set private_psCompilerSuffix32 to (Trim(sRegVal))
        Get ReadString CS_Settings "CompilerSuffix64" "x64" to sRegVal
        Set private_psCompilerSuffix64 to (Trim(sRegVal))

        // Snapshot the program's own workspace state at startup. Used by:
        //   UpdateDFOpenPath      - restores DF_OPEN_PATH when target closes
        //   RestoreActiveFilelist - puts the filelist back after a target
        //                           refactor function redirected it
        //   cCompileMixin         - TestBench-side compile passes pOrgWS
        // SysFile / Functions / FunctionsA are already open above, so the
        // workspace properties read here reflect the program's own filelist.
        // If phoWorkspace isn't fully populated at this point (can happen
        // depending on .src startup ordering), the resulting struct can be
        // partly empty - subclasses that need a guaranteed-populated snapshot
        // can call CapturephoWorkspace again later (TestBench does this
        // from OnWorkspaceOpened, see TestBench.src).
        Get CapturephoWorkspace to OrgWS
        Set pOrgWS to OrgWS
        // The tSwsFile form of the same capture, filled from the SAME moment so the two cannot
        // describe different states while both exist. Reads DFRefactor's own .sws through the one
        // parser, so its path ARRAYS survive - CapturephoWorkspace above keeps only the first of
        // each. Retire pOrgWS once every consumer has moved.
        Send RefreshOwnSws

        /* NOW replay a target workspace that arrived too early to be resolved. A /bm run's
           INI is read during argument parsing, before the snapshot above existed, so
           UpdateDFOpenPath could not populate pTargetWS - which is what `Get psSWSFile`
           reads. Without this the whole headless run believes no workspace is loaded. */
        Get psPendingTargetSWS to sRegVal
        If (sRegVal <> "") Begin
            Set psPendingTargetSWS to ""
            Send UpdateDFOpenPath sRegVal
        End
    End_Procedure

    /* The .sws DFRefactor is running in, when it is not called what CS_SWSFile says.

       One .sws in the folder is unambiguous, so it is taken. With several, the one whose leaf
       starts with "DFRefactor" is ours - and if that is still ambiguous, "" is returned rather
       than a coin toss: a wrong answer here silently redirects log files and own-source lookups.

       RETURNS THE FULL PATH (Nils 2026-08-17). rfFileSearch fills tRFSearchResult.sFilename with the
       LEAF only (the Win32 find-data name; sPath stays empty), and this returned that leaf as if it
       were a path. RefreshOwnSws then asked vFilePathExists("DFRefactorFlexTron.sws") - a RELATIVE
       name, resolved against the process's CURRENT DIRECTORY. Launched from the Studio (CWD = the
       workspace home) it happened to resolve; launched any other way it did not, pOwnSws stayed
       unparsed, PrimaryPrograms(pOwnSws) came back "", the compile log landed at the DRIVE ROOT
       ("\dfrefactor_compile.log" -> E:\), and DfCliCapture bailed before starting df-cli - so Add
       Package did nothing at all, on every restart, while the same build had worked the night
       before. Prefixing the home here is the whole fix; the leaf strip below stays as a guard. */
    { Visibility=Private }
    /* Delegates to OwnSwsCandidateInFolder (cLibraryInventory, beside SwsFormatOf), asking for
       the format THIS build reads as its own. DFRefactor is DF26-only since 2026-09-16, so that
       is always JSON here; the preference stays because the CANDIDATES in the folder may still
       be either format. Without it,
       "first DFRefactor* found" picked the then-tracked DF25-compat DFRefactor25.0.sws over
       DFRefactorFlexTron.sws by alphabetical accident (Nils 2026-08-28), and everything built
       on pOwnSws - TestBench's Test Compile first of all - ran against the wrong workspace. */
    Function _OwnSwsInFolder String sHome Returns String
        Handle hoFile
        String sFound
        Integer eWant

        Move eSwsJson to eWant
        Get Create (RefClass(cWorkspaceFile)) to hoFile
        Get OwnSwsCandidateInFolder of hoFile sHome eWant to sFound
        Send Destroy of hoFile
        Function_Return sFound
    End_Function

    /* The full path of the .sws DFRefactor is RUNNING in - the one place that answers it.

       CS_SWSFile is a hardcoded name - "DFRefactor.sws" since the DF26-only trim on 2026-09-16 -
       and the FlexTron build runs in a workspace called DFRefactorFlexTron.sws, which does not
       match it. RefreshOwnSws learned the fallback on 08-14; TestBench and CapturephoWorkspace
       still built the name straight from the constant, so TestBench on the DF26 workspace opened
       with "Filename missing: E:\DfRefactor\DFRefactor.sws" (Nils 2026-08-16). Now all three ask
       here: the fixed name when it exists, else the .sws actually in home (one, or the one named
       DFRefactor*), else the fixed name unchanged - so a folder with no .sws at all still yields
       the same non-empty answer it always did, and the callers' own existence checks still fire. */
    Function OwnSwsFile Returns String
        String sHome sOwnSws sFound
        Get psHome of (phoWorkspace(Self)) to sHome
        If (sHome = "") ;
            Function_Return ""
        Move (vFolderFormat(sHome) + CS_SWSFile) to sOwnSws
        If (vFilePathExists(sOwnSws) = 0) Begin
            Get _OwnSwsInFolder sHome to sFound
            If (sFound <> "") ;
                Move sFound to sOwnSws
        End
        Function_Return sOwnSws
    End_Function

    // Reads phoWorkspace into a tWorkspacePaths struct. Extracted from
    // End_Construct_Object so callers that need a fresh snapshot AFTER
    // the workspace data has been fully loaded (e.g. TestBench, which has
    // no target-workspace selector and seeds pTargetWS = self from
    // OnWorkspaceOpened so refactor functions find its own files) can
    // reuse the exact same capture logic.
    //
    // sAppSrc / sDDSrc / sAppHtml can be semicolon-delimited multi-path
    // lists; only the first entry is taken so callers can use WS.sAppSrc
    // directly without PathAtIndex. sSWSFile comes from OwnSwsFile (the
    // hard-coded per-DF-version name, else the .sws actually in home) rather
    // than a property, because phoWorkspace doesn't expose it directly.
    Function CapturephoWorkspace Returns tWorkspacePaths
        tWorkspacePaths WS
        String sRaw
        Handle hoIni

        Get_Attribute DF_OPEN_PATH     to WS.sOpenPath
        Get_Attribute DF_FILELIST_NAME to WS.sFilelistName

        // sWSFile  = Programs\*.ws  (DataFlex's psWorkspaceWSFile; legacy
        //            folder-paths config file).
        // sSWSFile = Home\<name>.sws (what Studio + the compiler use).
        Get psHome            of (phoWorkspace(Self))  to WS.sHome
        Get psWorkspaceWSFile of (phoWorkspace(Self))  to WS.sWSFile
        Get OwnSwsFile to WS.sSWSFile                   // fixed name, else the .sws actually in home

        Get psAppSrcPath  of (phoWorkspace(Self)) to sRaw
        Get PathAtIndex   of (phoWorkspace(Self)) sRaw 1 to WS.sAppSrc

        Get psDdSrcPath   of (phoWorkspace(Self)) to sRaw
        Get PathAtIndex   of (phoWorkspace(Self)) sRaw 1 to WS.sDDSrc

        Get psAppHtmlPath of (phoWorkspace(Self)) to sRaw
        Get PathAtIndex   of (phoWorkspace(Self)) sRaw 1 to WS.sAppHtml

        Get psBitmapPath  of (phoWorkspace(Self)) to WS.sBitmaps
        Get psDataPath    of (phoWorkspace(Self)) to WS.sData
        Get psFileList    of (phoWorkspace(Self)) to WS.sFileList
        Get psHelpPath    of (phoWorkspace(Self)) to WS.sHelp
        Get psProgramPath of (phoWorkspace(Self)) to WS.sPrograms
        // Own workspace's DataFlex version, read from the .sws [Properties] Version. DFRefactor's own .sws
        // is INI-format, so a plain cIniFile read - NO #IF gate (the note's whole point: don't compile-gate
        // a runtime value). Feeds the compiler/workspace version-mismatch pre-flight (BuildCompileCommand ->
        // MajorVersionFromVersionString); without it that pre-flight silently no-ops for own-workspace /
        // TestBench self-compiles. Stays "" if the .sws is absent/keyless (no regression vs before).
        If (WS.sSWSFile <> "") Begin
            Get Create (RefClass(cIniFile)) to hoIni
            Set psFilename of hoIni to WS.sSWSFile
            Get ReadString of hoIni "Properties" "Version" "" to WS.sDfVersion
            Send Destroy of hoIni
        End
        Function_Return WS
    End_Function

    Function SourceFilePath Returns String
        String sFileName sPath

        Get psHomeTarget to sPath
        Get psCurrentSourceFileName to sFileName
        If (sFileName <> "") Begin
            Get ParseFolderName sFileName to sPath
        End
        Function_Return sPath
    End_Function

    { MethodType=Property }
    { EnumList="16, 24, 32" }
    Procedure Set piToolbarIconSize Integer iSize
        Send WriteInteger CS_Settings CS_ToolbarIconSize iSize
        Set private.piToolbarIconSize to iSize
    End_Procedure

    { MethodType=Property }
    Function piToolbarIconSize Returns Integer
        Integer iSize
        Get private.piToolbarIconSize to iSize
        If (iSize = 0) Begin
            Get ReadInteger CS_Settings CS_ToolbarIconSize 32 to iSize
            If (iSize = 0) Begin
                Move 32 to iSize
            End
            Set private.piToolbarIconSize to iSize
        End
        Function_Return iSize
    End_Function

    { MethodType=Property }
    { EnumList="xtpTabPositionTop, xtpTabPositionLeft, xtpTabPositionBottom, xtpTabPositionRight" }
    Procedure Set peTabpagePosition Integer eMode
        Set private.peTabpagePosition to eMode
        Send WriteInteger CS_Settings CS_TabPosition eMode   
    End_Procedure

    { MethodType=Property }
    Function peTabpagePosition Returns Integer
        Integer eMode
        Get ReadInteger CS_Settings CS_TabPosition xtpTabPositionLeft to eMode
        Function_Return eMode
    End_Function

    /* THE TOOLBAR TEXT (Nils 2026-10-04): the style the toolbar items that have a caption take -
       xtpButtonIconAndCaption shows the text beside the icon, xtpButtonIcon the icon alone, which gives the
       toolbar much less width. Set in the Program Settings dialog and applied by the command bar system
       (ApplyToolbarButtonStyle, DFRefactorFT.src). Any other stored value reads as the text shown. */
    { MethodType=Property }
    { EnumList="xtpButtonIconAndCaption, xtpButtonIcon" }
    Procedure Set peToolbarButtonStyle Integer eStyle
        Send WriteInteger CS_Settings CS_ToolbarButtonStyle eStyle
    End_Procedure

    { MethodType=Property }
    Function peToolbarButtonStyle Returns Integer
        Integer eStyle
        Get ReadInteger CS_Settings CS_ToolbarButtonStyle xtpButtonIconAndCaption to eStyle
        If (eStyle <> xtpButtonIcon) ;
            Move xtpButtonIconAndCaption to eStyle
        Function_Return eStyle
    End_Function

    { MethodType=Property }
    Procedure Set psGridRowBackgroundColor String sColor
        Set private.psGridRowBackgroundColor to sColor
        Send WriteString CS_Settings CS_GridRowBackgroundColor sColor
        Broadcast Recursive Set piSelectedRowBackColor of (Client_Id(phoMainPanel(ghoApplication))) to sColor
        Broadcast Recursive Set piHighlightBackColor   of (Client_Id(phoMainPanel(ghoApplication))) to sColor
    End_Procedure

    { MethodType=Property }
    Function psGridRowBackgroundColor Returns String
        String sColor
        Get private.psGridRowBackgroundColor to sColor
        If (sColor = "0") Begin
            Get ReadString CS_Settings CS_GridRowBackgroundColor clActiveRow to sColor
            If (sColor contains "clBlueGrey") Begin
                Move (Replace("clBlueGrey", sColor, "clStatusBarColor")) to sColor
            End
            Set private.psGridRowBackgroundColor to sColor
        End
        Function_Return sColor
    End_Function

    { MethodType=Property }
    Procedure Set psFileCompareApp String sProgramName
        Send WriteString CS_Settings CS_FileCompareProgram sProgramName
        Set private.psFileCompareApp to sProgramName
    End_Procedure

    { MethodType=Property }
    Function psFileCompareApp Returns String
        String sProgramName
        Get private.psFileCompareApp to sProgramName
        If (sProgramName = "") Begin
            Get ReadString CS_Settings CS_FileCompareProgram "" to sProgramName
            Set private.psFileCompareApp to sProgramName
        End
        Function_Return sProgramName
    End_Function

    { MethodType=Property }
