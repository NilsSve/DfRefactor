    Function SelectWorkspaceFile Returns String
        Boolean bOpen
        String sFileName

        Move "" to sFileName
        Get Show_Dialog of (phoSwsOpenDialog(Self)) to bOpen
        If (bOpen = True) Begin
            Get File_Name of (phoSwsOpenDialog(Self)) to sFileName
            Send UpdateWorkSpaceFileToRegistry sFileName
        End
        Function_Return sFileName
    End_Function

    Procedure OnWorkspaceLoaded
    End_Procedure

    Procedure UpdateWorkspaceSelectorDisplay String sFileName
        String sText sVersion sWorkspaceText
        Handle hoIniFile hoJSONFile
        Integer iPos
        Boolean bExists

        If (sFileName <> "") Begin
            Move (RightPos(". ", sFileName)) to iPos
            If (iPos <> 0) Begin
                Move (Mid(sFileName, CI_EOL, 4)) to sFileName
                Get vFilePathExists sFileName to bExists
                If (bExists = False) Begin
                    Send Info_Box "The .sws file doesn't exist! Please select another."
                    Procedure_Return
                End
            End
            Move CS_CurrentWorkspace to sWorkspaceText
            Get Create (RefClass(cIniFile)) to hoIniFile
            Set psFilename of hoIniFile to sFileName
            Get ReadString of hoIniFile CS_PropertiesKeyWord CS_VersionKeyWord "" to sVersion
            Send Destroy of hoIniFile

            // Remove any number pre-facing the .sws file path & name
            Move (Pos(":", sFileName)) to iPos
            If (iPos <> 2) Begin
                Move (Mid(sFileName, CI_EOL, 4)) to sFileName
            End
            Get ParseFileName sFileName to sText
            // A saved-workspace chip can point at a .sws that was since deleted/moved. Bail BEFORE the
            // 'Set psSWSFile' below cascades into ReadSwsJsonFile (which faults err 33 on the missing file)
            // and before the views/tiles switch to a workspace that isn't there - warn and leave the current
            // workspace as-is. (Nils 2026-07-07 - stale chip -> err 33 "Can't open input file".)
            Get vFilePathExists sFileName to bExists
            If (bExists = False) Begin
                Send Info_Box ("Filename missing:" * String(sFileName))
                Procedure_Return
            End
        End
        Else Begin
            Move CS_OpenWorkspace to sWorkspaceText
            Move CS_NoActiveWorkspaceText to sText
            If ((phoWorkspaceSelector_Menuitem(Self))) Begin
                If (IsComObjectCreated(phoWorkspaceSelector_Menuitem(Self))) Begin
                    Send ResetComboForm of (phoWorkspaceSelector_Menuitem(Self))
                End
            End
        End
        
        // It is probably safest to clear all views when switching workspace.
        If (phoMainPanel(Self) <> 0) Begin
            Broadcast Send Request_Clear_All of (Client_Id(phoMainPanel(ghoApplication)))
            If (phoWorkspaceSelector_Menuitem(Self) <> 0) ;   // 0 in builds with no workspace combo (e.g. the FlexTron dashboard build)
                Set psCaption of (phoWorkspaceSelector_Menuitem(Self)) to sWorkspaceText
        End
        /* RECORDED BEFORE THE BROADCAST (Nils 2026-09-03: the copied LegacyApp "never got saved to
           the previous workspaces list"). OnWorkspaceLoaded below repaints the Start Center, whose
           Recent list is read from the registry - so a caller that recorded the workspace AFTER
           this call (the copy's deferred open did) painted a list without it. Every load lands in
           the list here, once, before anyone is told; a caller that also records is harmless, the
           second write reorders nothing. */
        If (sFileName <> "") ;
            Send UpdateWorkSpaceFileToRegistry sFileName
        Set psSWSFile to sFileName
        /* Parse the new workspace's .sws ONCE, here, before anything is told it loaded. Every
           consumer downstream then reads one already-parsed answer instead of opening the file
           again - and the OnWorkspaceLoaded broadcast below is what wakes those consumers, so the
           parse has to precede it. */
        Send RefreshCurrentSws
        // A different workspace has a different backup tree, so the at-risk count must be re-asked.
        // Cleared BEFORE the OnWorkspaceLoaded broadcast below, because that is what repaints the
        // Workspace tile - and the tile reads BackupsPastCycleCount.
        Set piBackupsPastCycleCache to -1
        // A workspace change means the new workspace has nothing compiled yet - reset the flag that gates
        // the dashboard guided tile's Analyze step, so a fresh workspace lights only Compile. (Nils 2026-07-12.)
        Move False to ghbHaveCompileOutput
        If (phoMainPanel(Self) <> 0) Begin
            // Send to all views
            Broadcast Send OnWorkspaceLoaded of (Client_Id(phoMainPanel(ghoApplication)))
        End
        Send OnFileNameUpdate ""
        // Loading a workspace ESTABLISHES workspace mode (Nils 2026-07-13): pbWorkspaceMode must be False ONLY
        // right after the Single File button, so a workspace (re)load clears any stale single-file flag left by a
        // prior single-file run - otherwise the engine wrongly reloads + ACTIVATES the editor on a WORKSPACE run
        // (cRefactorEngine ~552/618 gate the single-file editor reload purely on bWorkspaceMode=False). Set LAST,
        // after OnFileNameUpdate above, so nothing can undo it.
        If (sFileName <> "") ;
            Set pbWorkspaceMode to True
    End_Procedure
    
    // Pushes the passed sFileName on top of the previously opened workspace stack.
    Procedure UpdateWorkSpaceFileToRegistry String sFileName
        Integer iCount iSize
        String[] asWorkspaces
        String sWorkspaceFile
        Boolean bFound

        Get piWorkspaceItems to iSize
        Move sFileName to asWorkspaces[0]
        // Read
        For iCount from 0 to iSize
            Get ReadString CS_WorkspacesKey (CS_WorkspaceRecentKey + String(iCount)) "" to sWorkspaceFile
            If (sWorkspaceFile <> "" and sWorkspaceFile <> sFileName) Begin
                Move sWorkspaceFile to asWorkspaces[-1]
            End
        Loop

        // Write
        Move (SizeOfArray(asWorkspaces)) to iSize
        Decrement iSize           
        For iCount from 0 to iSize
            If (asWorkspaces[iCount] <> "") Begin
                Send WriteString CS_WorkspacesKey (CS_WorkspaceRecentKey + String(iCount)) asWorkspaces[iCount]
            End
        Loop
    End_Procedure

    Function ReadWorkspaceKeysFromRegistry Returns String[]
        Integer iCount iSize iItem
        String[] asWorkspaces
        String sWorkspace

        Move 0 to iItem
        Get piWorkspaceItems to iSize
        For iCount from 0 to iSize
            Get ReadString CS_WorkspacesKey (CS_WorkspaceRecentKey + String(iCount)) '' to sWorkspace
            If (sWorkspace <> "") Begin
                Move sWorkspace to asWorkspaces[iItem]
                Increment iItem
            End
        Loop
        Function_Return asWorkspaces
    End_Function

    /* THE WORKSPACE COPY RECORD (Nils 2026-10-07: "It doesn't make much sense to copy a copy, does it?
       ... it can be confusing to see the suggestion to copy when it already has been done"). Every copy
       the migration copy makes is remembered here, beside the Recent list - never in the copy itself,
       where a marker file would turn up in the customer's source control. Two sections, both keyed by a
       .sws path folded the way the snapshot store folds it (AnalyzeSnapshotKey): the copy names its
       original, the original names its latest copy, each with the day (WorkspaceCopyRecord.pkg). The
       Start Center's copy card reads both. */
    Procedure RecordWorkspaceCopy String sOriginalSws String sCopySws
        String sIso sCopyKey sOrigKey

        If (sOriginalSws = "" or sCopySws = "") ;
            Procedure_Return
        Get TodayIsoDate to sIso
        Get AnalyzeSnapshotKey sCopySws     to sCopyKey
        Get AnalyzeSnapshotKey sOriginalSws to sOrigKey
        Send WriteString CS_WorkspaceCopyOfKey   sCopyKey (WorkspaceCopyRecord(sOriginalSws, sIso))
        Send WriteString CS_WorkspaceCopiedToKey sOrigKey (WorkspaceCopyRecord(sCopySws, sIso))
    End_Procedure

    // The record of the original sSws was copied from ("<original .sws>|<yyyy-mm-dd>"), or "" when sSws is
    // not a copy DFRefactor made.
    Function WorkspaceCopyOriginRecord String sSws Returns String
        String sKey sRecord

        If (sSws = "") ;
            Function_Return ""
        Get AnalyzeSnapshotKey sSws to sKey
        Get ReadString CS_WorkspaceCopyOfKey sKey "" to sRecord
        Function_Return sRecord
    End_Function

    // The record of the latest copy DFRefactor made of sSws ("<copy .sws>|<yyyy-mm-dd>"), or "" when there is
    // none - or when that copy's .sws is no longer on disk: a copy deleted or moved since is not offered.
    Function WorkspaceCopyMadeRecord String sSws Returns String
        String sKey sRecord sCopy

        If (sSws = "") ;
            Function_Return ""
        Get AnalyzeSnapshotKey sSws to sKey
        Get ReadString CS_WorkspaceCopiedToKey sKey "" to sRecord
        Move (WorkspaceCopyRecordPath(sRecord)) to sCopy
        If (sCopy = "") ;
            Function_Return ""
        If ((vFilePathExists(sCopy)) = False) ;
            Function_Return ""
        Function_Return sRecord
    End_Function

    // ---- Per-workspace "last analyze" snapshot ----------------------------------------------------
    // The FT dashboard's Last-analyze tile is normally fed by process-memory globals that die on exit.
    // To show the last counts when a workspace is RE-opened in a later run, cache them in the per-EXE
    // registry, keyed by the .sws path - mirroring the recent-workspaces store above. (SysFile is one
    // global record so it would share counts across every workspace; the Data\*.json caches key by DF
    // version - neither fits a per-workspace value.)

    // Today's date as ISO yyyy-mm-dd (locale-safe: no separator ambiguity, sorts naturally).
    Function TodayIsoDate Returns String
        DateTime dtNow
        Integer  iY iM iD
        Move (CurrentDateTime()) to dtNow
        Move (DateGetYear(dtNow))  to iY
        Move (DateGetMonth(dtNow)) to iM
        Move (DateGetDay(dtNow))   to iD
        Function_Return (String(iY) + "-" + Right(("0" + String(iM)), 2) + "-" + Right(("0" + String(iD)), 2))
    End_Function

    // Today's date + time as "yyyy-mm-dd HH:MM" (24-hour, locale-safe, sorts naturally). Used for the
    // analyze-snapshot "last run" stamp so the Modernize tile can show the time alongside the date.
    Function TodayIsoDateTime Returns String
        DateTime dtNow
        Integer  iY iM iD iH iMin
        Move (CurrentDateTime()) to dtNow
        Move (DateGetYear(dtNow))   to iY
        Move (DateGetMonth(dtNow))  to iM
        Move (DateGetDay(dtNow))    to iD
        Move (DateGetHour(dtNow))   to iH
        Move (DateGetMinute(dtNow)) to iMin
        Function_Return (String(iY) + "-" + Right(("0" + String(iM)), 2) + "-" + Right(("0" + String(iD)), 2) + " " + Right(("0" + String(iH)), 2) + ":" + Right(("0" + String(iMin)), 2))
    End_Function

    // Write a headless /bm run's outcome to the configured result file (psBatchResultFile) so a build /
    // toolchain can tell success from failure. The run also returns an exit code (see ExitBatchWithCode),
    // but the file is the robust signal - it survives a crash or hang that returns no code at all.
    // A machine-readable STATUS line comes first, then the human summary. The build DELETES this file
    // before the run and reads it after: file missing = the run crashed / hung; STATUS=SUCCESS or FAILED
    // otherwise. No-op when no result file is configured (interactive runs, or a /bm run without the key).
    Procedure WriteBatchResult Integer eResponse String sSummary
        String sPath sStatus sOut sCRLF
        Integer iCh

        Get psBatchResultFile to sPath
        If (Trim(sPath) = "") ;
            Procedure_Return
        Move (Character(13) + Character(10)) to sCRLF
        If (eResponse = eEngineOK) ;
            Move "SUCCESS" to sStatus
        Else ;
            Move "FAILED" to sStatus
        Move ("STATUS=" + sStatus + sCRLF) to sOut
        Move (sOut + "ResponseCode=" + String(eResponse) + sCRLF) to sOut
        Move (sOut + "Finished=" + (TodayIsoDateTime(Self)) + sCRLF) to sOut
        /* THE SUMMARY CARRIES LITERAL "\n" SEQUENCES, NOT LINE BREAKS (Nils 2026-08-03).
           DataFlex string literals have no backslash escapes, so every `Append sText "\n..."`
           in CollectSummary puts a real backslash and an n into the text; the message boxes
           translate them at DISPLAY time. Written straight to a file they stay literal, which
           is why this result file opened as one endless line in Notepad while
           DFRefactorLogFile.txt read perfectly - the log writer already converts them
           (cRefactorEngine ~1641). Same conversion here, so a build engineer opening the file
           the wrapper points at sees the same thing the log shows. */
        Move (Replaces("\n", sSummary, sCRLF)) to sSummary
        Move (sOut + sCRLF + "Summary:" + sCRLF + sSummary + sCRLF) to sOut
        Get rfOpenOutput sPath to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh sOut
        Send rfCloseOutput iCh
    End_Procedure

    /* Check what the INI asked for against what actually exists, and record the gaps.

       Called by both builds' ReadCmdLineIniFile right after the folders and functions are read.
       One home rather than a copy in DFRefactor.src and DFRefactorFT.src - the two readers have
       drifted apart before. */
    Procedure ValidateCmdLineIniSelections String[] asFolders String[] asSpecs Handle hoDD
        String[] asWarnings asUnknown
        Integer  i iLast
        String   sFolder

        Move (SizeOfArray(asFolders) - 1) to iLast
        For i from 0 to iLast
            Move (Trim(asFolders[i])) to sFolder
            // vPathIsDirectory, not vFolderExists: that is True for an existing FILE too (2026-11-20).
            If (sFolder <> "" and (vPathIsDirectory(sFolder) = False)) Begin
                If (vFilePathExists(sFolder) = True) ;
                    Move ("INI [Folder Section]: this is a file, not a folder, so nothing was scanned for it -" * sFolder) to asWarnings[SizeOfArray(asWarnings)]
                Else ;
                    Move ("INI [Folder Section]: this folder does not exist, so no file in it was scanned -" * sFolder) to asWarnings[SizeOfArray(asWarnings)]
            End
        Loop

        If (hoDD <> 0) Begin
            Get UnknownFunctionNames of hoDD asSpecs to asUnknown
            Move (SizeOfArray(asUnknown) - 1) to iLast
            For i from 0 to iLast
                Move ("INI [Functions Section]: this build has no refactoring function by that name, so it was NOT run -" * asUnknown[i]) to asWarnings[SizeOfArray(asWarnings)]
            Loop
        End

        Set pasCmdLineIniWarnings to asWarnings
    End_Procedure

    /* THE COMMAND-LINE INI'S FUNCTION PARAMETERS, applied before the run and taken back
       after it (Nils 2026-08-03).

       The INI exports "Function1=Name,Parameter", but the only thing that consumed those
       strings was SelectRecordsFromStringArray, which splits the comma off to find the
       name and DISCARDS the parameter - so a headless run used whatever parameter happened
       to be in the local database, and the exported one was decoration. The guided flow
       had it right all along (CheckWorkspaceFT ~2020: select, SetFunctionParameter, run,
       put it back); the command-line path simply never made the second call.

       RESTORED AFTERWARDS, deliberately (Nils's choice over apply-and-keep). A batch INI
       run on a developer's own workstation must not silently rewrite parameters they set
       by hand - the same "a transient run leaves the standing configuration as it found
       it" rule the DD states over SetFunctionParameter, and the same rule the LegacyApp2
       incident taught about touching a user's data.

       Lives HERE, on the shared application class, because both DFRefactor.src and
       DFRefactorFT.src drive the batch path and a second copy would drift. The Functions DD
       is passed IN rather than created here: this package compiles BEFORE
       cFunctionsDataDictionary.dd in the UnitTests build (the two apps Use the DD
       first, the runner never does), so naming the class here is error 54 in CI only.
       Not unit-tested
       (it is database work); the part that CAN be got wrong silently - the encoding of the
       spec itself - is in cCmdLineIniFile and is tested there. */
    Procedure ApplyCmdLineFunctionParameters Handle hoDD
        String[] asSpecs asRestore
        String   sSpec sName sParam sPrev
        Integer  i iMax
        Handle   hoIni

        Move (ResizeArray(asRestore, 0)) to asRestore
        Set pasCmdLineParamRestore to asRestore
        // Remembered first, whatever the INI holds: RestoreCmdLineSelections puts the user's ticks back through it.
        Set phoCmdLineParamDD to hoDD
        Get pasCmdLineFunctionSpecs to asSpecs
        Move (SizeOfArray(asSpecs) - 1) to iMax
        If (iMax < 0) ;
            Procedure_Return
        Get Create (RefClass(cCmdLineIniFile)) to hoIni
        For i from 0 to iMax
            Move asSpecs[i] to sSpec
            Get DecodeFunctionParameter of hoIni sSpec to sParam
            // Only a spec that CARRIES a parameter touches the table. A bare name must
            // not blank the stored value.
            If (sParam <> "") Begin
                Get DecodeFunctionName of hoIni sSpec to sName
                Get SetFunctionParameter of hoDD sName sParam to sPrev
                // Remember the pair so the restore knows what to put back.
                Move sName to asRestore[SizeOfArray(asRestore)]
                Move sPrev to asRestore[SizeOfArray(asRestore)]
            End
        Loop
        Send Destroy of hoIni
        Set pasCmdLineParamRestore to asRestore
    End_Procedure

    // The other half. Walks the name/value pairs the apply saved, in order.
    Procedure RestoreCmdLineFunctionParameters
        String[] asRestore
        String   sMsg
        Integer  i iMax
        Handle   hoDD

        Get phoCmdLineParamDD to hoDD
        Get pasCmdLineParamRestore to asRestore
        Move (SizeOfArray(asRestore) - 2) to iMax
        // Nothing applied, or no DD to apply it through: nothing to undo.
        If (iMax < 0 or hoDD = 0) ;
            Procedure_Return
        // Pairs, walked two at a time - DataFlex's For has no step clause.
        Move 0 to i
        While (i <= iMax)
            Get SetFunctionParameter of hoDD asRestore[i] asRestore[i + 1] to sMsg
            Move (i + 2) to i
        Loop
        Move (ResizeArray(asRestore, 0)) to asRestore
        Set pasCmdLineParamRestore to asRestore
    End_Procedure

    /* THE INI'S FUNCTION TICKS AND FILE FILTER, PUT IN FOR THE RUN (Nils 2026-11-20) - from the batch block, just
       before the run, and never from ReadCmdLineIniFile. The reader used to do it while the command line was parsed,
       for good: a run of an exported INI with 99 functions left those 99 ticked and the user's filter gone. And a
       first fix that only saved there and restored after the run was not enough: a live test stopped at the
       start-up database check, after the reader had replaced the user's ticks and filter and before anything could
       put them back. Here the user's own are saved first, and RestoreCmdLineSelections puts them back after the
       run (or from ExitBatchWithCode). An INI without a [Functions Section] runs the current selection, as the
       Export dialog says, so the ticks are left alone then - and the filter too without a [File Filter Section]. */
    Procedure ApplyCmdLineSelections Handle hoDD
        String[] asSpecs asSaved
        String   sFilter sOwn

        If (hoDD = 0) ;
            Procedure_Return
        Set phoCmdLineParamDD to hoDD
        Get psCmdLineFilter to sFilter
        If (sFilter <> "") Begin
            Get FileExtensionFilter of hoDD to sOwn
            Set psCmdLineFilterRestore to sOwn
            Set pbCmdLineFilterSaved   to True
            Send SetFileExtensionFilter of hoDD sFilter
        End
        Get pasCmdLineFunctionSpecs to asSpecs
        If (SizeOfArray(asSpecs) > 0) Begin
            Get SelectedFunctionNames of hoDD to asSaved
            Set pasCmdLineTicksRestore to asSaved
            Set pbCmdLineTicksSaved    to True
            Send UnSelectAllRecords of hoDD
            Send SelectRecordsFromStringArray of hoDD asSpecs
        End
    End_Procedure

    /* The other half: the user's function ticks and file filter, put back after a /bm run - through the
       Functions DD the batch block handed in (phoCmdLineParamDD), and only what ApplyCmdLineSelections saved (the
       pb*Saved flags), once, though the batch block and ExitBatchWithCode both call it. The selection counters - the
       total and each type's - are counted again from the ticks and saved (RecountSelectionCounters). */
    Procedure RestoreCmdLineSelections
        Handle   hoDD
        String[] asNames
        String   sFilter

        Get phoCmdLineParamDD to hoDD
        If (hoDD = 0) ;
            Procedure_Return
        If (pbCmdLineFilterSaved(Self) = True) Begin
            Set pbCmdLineFilterSaved to False
            Get psCmdLineFilterRestore to sFilter
            Send SetFileExtensionFilter of hoDD sFilter
        End
        If (pbCmdLineTicksSaved(Self) = True) Begin
            Set pbCmdLineTicksSaved to False
            Get pasCmdLineTicksRestore to asNames
            Send UnSelectAllRecords of hoDD
            Send SelectRecordsFromStringArray of hoDD asNames
            Send RecountSelectionCounters of hoDD
        End
    End_Procedure

    /* THE COMMAND LINE'S FOLDERS, TICKED FOR THE RUN (Nils 2026-10-24). The run itself scans
       pasSelectedFolders; this only makes the stored ticks - which the Start Center's Source folders
       line counts - say the same while the run lasts (ApplyBatchFolderTicks of the FolderSelHea DD).
       ExitBatchWithCode sends the other half first thing, so the earlier ticks are back before the
       process ends. */
    Procedure ApplyCmdLineFolderTicks Handle hoDD
        String[] asFolders

        Get pasCmdLineFolders to asFolders
        If (hoDD = 0 or SizeOfArray(asFolders) = 0) ;
            Procedure_Return
        Send ApplyBatchFolderTicks of hoDD asFolders
        Set phoCmdLineFolderDD to hoDD
    End_Procedure

    Procedure RestoreCmdLineFolderTicks
        Handle hoDD

        Get phoCmdLineFolderDD to hoDD
        If (hoDD = 0) ;
            Procedure_Return
        Set phoCmdLineFolderDD to 0
        Send RestoreBatchFolderTicks of hoDD
    End_Procedure

    /* The result file is named AFTER THE INI, not just "Result.txt" (Nils 2026-08-03).
       A folder holds MANY INIs - one per workspace - and one shared Result.txt means the
       second run overwrites the first's outcome, a build cannot tell which result belongs
       to which INI, and the generated wrapper's "clear any stale result" step deletes
       another INI's answer. CmdLineData_Order_Entry.ini -> CmdLineData_Order_Entry_RESULT.txt.
       A SUFFIX, not a prefix: it keeps the INI and its two generated files adjacent in a
       directory listing, which "Run-..." did not (Nils 2026-08-03).

       EXISTING INIs ARE UNAFFECTED: the path is stored in the INI's [Result Section] when
       it is exported, and the run reads it from there - so an INI exported before this keeps
       using its own Result.txt, and only a fresh export picks up the new name. */
    Function BatchResultPathForIni String sIniPath Returns String
        String sStem
        // Get form: BatchArtifactBase is defined below this, so the expression form
        // (BatchArtifactBase(Self, ...)) would not resolve at compile time.
        Get BatchArtifactBase sIniPath to sStem
        Function_Return (sStem + "_RESULT.txt")
    End_Function

    /* Folder + INI base name with the extension removed - the stem both generated
       artifacts hang off, so their names cannot drift apart. */
    Function BatchArtifactBase String sIniPath Returns String
        Integer iPos iLast iLen iDot
        String  sStem

        Move (Length(sIniPath)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sIniPath, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Move sIniPath to sStem
        // Cut the extension at the LAST dot, and only if it comes after the last separator
        // (a dotted FOLDER name must not be mistaken for the file's extension).
        Move 0 to iDot
        For iPos from (iLast + 1) to iLen
            If (Mid(sIniPath, 1, iPos) = ".") ;
                Move iPos to iDot
        Loop
        If (iDot > 0) ;
            Move (Left(sIniPath, iDot - 1)) to sStem
        Function_Return sStem
    End_Function

    /* "<ini base name>_RUN.ps1" - the wrapper's file name, derived from the INI so a folder of
       INIs gets a wrapper each, suffixed so it sorts beside the INI it belongs to. Public because both exporters name it in the message they
       show after a successful export, and that message must not guess. */
    Function RunnerScriptName String sIniPath Returns String
        String sName
        Get BatchArtifactLeaf sIniPath "_RUN.ps1" to sName
        Function_Return sName
    End_Function

    // "<ini base name>" + sSuffix, without the folder: the name of a file written beside the INI, named after it.
    Function BatchArtifactLeaf String sIniPath String sSuffix Returns String
        String  sStem
        Integer iPos iLast iLen
        Get BatchArtifactBase sIniPath to sStem
        Move (Length(sStem)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sStem, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Function_Return (Mid(sStem, (iLen - iLast), (iLast + 1)) + sSuffix)
    End_Function

    // "<ini base name>_SCAN.ps1" - the CI scan's wrapper (WriteScanScript), beside the INI (2026-11-20).
    Function ScanScriptName String sIniPath Returns String
        String sName
        Get BatchArtifactLeaf sIniPath "_SCAN.ps1" to sName
        Function_Return sName
    End_Function

    // "<ini base name>_CI-SAMPLE.yml" - the starter CI workflow (WriteCIWorkflowSample), beside the INI (2026-11-20).
    Function CIWorkflowSampleName String sIniPath Returns String
        String sName
        Get BatchArtifactLeaf sIniPath "_CI-SAMPLE.yml" to sName
        Function_Return sName
    End_Function

    // sText for a single-quoted PowerShell or YAML string: a ' in it is doubled.
    Function SingleQuoted String sText Returns String
        Function_Return (Replaces("'", sText, "''"))
    End_Function

    // Headless /bm exit: write the outcome to the result file, then force-exit with a code (0 = success,
    // 1 = failure) so a build can check BOTH the result file AND %ERRORLEVEL%. TerminateProcess(-1) is the
    // project's safe self-terminate (ExitProcess deadlocks on COM/ActiveX detach); Exit_Application is only
    // a fallback for the unlikely case the forced terminate does not take.
    Procedure ExitBatchWithCode Integer eResponse String sSummary
        Integer iExitCode iRet

        /* PUT THE USER'S FUNCTION PARAMETERS BACK FIRST. This is the LAST code that runs in
           a headless run - TerminateProcess below kills the process from inside
           StartRefactoreCode, so the restore call that sits after StartRefactoreCode in
           DFRefactor.src / DFRefactorFT.src is never reached (found 2026-08-03, before Nils
           ran the verification that would have left the INI's values in his database for
           good). Those calls stay as the belt for any path that returns normally. */
        Send RestoreCmdLineFunctionParameters
        // ...and the folder ticks the batch start-up set for the run (2026-10-24).
        Send RestoreCmdLineFolderTicks
        // ...and the user's function ticks and file filter (2026-11-20).
        Send RestoreCmdLineSelections
        Send WriteBatchResult eResponse sSummary
        If (eResponse = eEngineOK) ;
            Move 0 to iExitCode
        Else ;
            Move 1 to iExitCode
        Move (TerminateProcessEf(-1, iExitCode)) to iRet
        Send Exit_Application
    End_Procedure

    // Generate a ready-to-run PowerShell wrapper (Run-DFRefactor.ps1) next to an exported CmdLine INI, so the
    // exported pair is immediately usable in a build / toolchain. Pre-filled for this INI + its result file;
    // $Exe defaults to the bare exe name (override with a full path if it is not on PATH). Best-effort: a
    // write failure just leaves the INI without a wrapper - the export itself still succeeds.
    // (The DataFlex string delimiter is chosen per line - " when the PowerShell line contains ', ' otherwise -
    //  so the embedded script needs no character escaping. Keep new lines free of BOTH quote characters.)
    Procedure WriteRunnerScript String sIniPath String sResultPath String sExeName
        String sFolder sIniName sScriptPath sScriptName sScript sCRLF
        Integer iPos iLast iLen iCh

        // Split the INI path into folder (incl. trailing "\") + bare filename, on the last separator.
        Move (Length(sIniPath)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sIniPath, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Move (Left(sIniPath, iLast)) to sFolder
        Move (Mid(sIniPath, (iLen - iLast), (iLast + 1))) to sIniName
        /* The wrapper is named after the INI too - "Run-DFRefactor.ps1" was one name per
           FOLDER for a file whose contents name ONE INI, so exporting a second workspace
           silently overwrote the first workspace's wrapper. */
        Get RunnerScriptName sIniPath to sScriptName
        Move (sFolder + sScriptName) to sScriptPath
        Move (Character(13) + Character(10)) to sCRLF

        Move "" to sScript
        Move (sScript + "# " + sScriptName + " - generated by DFRefactor for " + sIniName + "." + sCRLF) to sScript
        Move (sScript + "# Headless (/bm) build wrapper: runs DFRefactor, exit 0 = success, 1 = failure, 2 = bad input." + sCRLF) to sScript
        Move (sScript + "# Pre-filled for this folder. Set $Exe to a full path if the exe is not on your PATH; re-export to refresh." + sCRLF) to sScript
        Move (sScript + "param(" + sCRLF) to sScript
        Move (sScript + "    [string]$Exe = '" + sExeName + "'," + sCRLF) to sScript
        Move (sScript + "    [string]$Ini = (Join-Path $PSScriptRoot '" + sIniName + "')," + sCRLF) to sScript
        Move (sScript + "    [string]$ResultFile = '" + sResultPath + "'," + sCRLF) to sScript
        Move (sScript + "    [int]$TimeoutSeconds = 1800" + sCRLF) to sScript
        Move (sScript + ")" + sCRLF) to sScript
        Move (sScript + "$ErrorActionPreference = 'Stop'" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + 'if (-not (Test-Path -LiteralPath $Ini)) { Write-Host "FAILED: INI not found: $Ini" -ForegroundColor Red; exit 2 }' + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + 'Write-Host "Exe         : $Exe"' + sCRLF) to sScript
        Move (sScript + 'Write-Host "Ini         : $Ini"' + sCRLF) to sScript
        Move (sScript + 'Write-Host "Result file : $ResultFile"' + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "# 1) Clear any stale result." + sCRLF) to sScript
        Move (sScript + "if (Test-Path -LiteralPath $ResultFile) { Remove-Item -LiteralPath $ResultFile -Force }" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "# 2) Run headless, with a watchdog timeout." + sCRLF) to sScript
        Move (sScript + "$psi = [System.Diagnostics.ProcessStartInfo]::new()" + sCRLF) to sScript
        Move (sScript + "$psi.FileName = $Exe" + sCRLF) to sScript
        /* /bm - which this script emitted all along, against a parser that did not accept it.
           The switch matched nothing, the INI path had no recognised switch in front of it so it
           was never read, and the exe just opened its GUI: the wrapper could not work, which is
           why nobody was using it. Rather than change the script to the then-only working /c,
           /bm was made real (Nils 2026-08-03) - it is the clearer name, and it means every
           wrapper generated BEFORE today starts working too. */
        Move (sScript + '$psi.Arguments = "/bm `"$Ini`""' + sCRLF) to sScript
        Move (sScript + "$psi.UseShellExecute = $false" + sCRLF) to sScript
        Move (sScript + "$proc = [System.Diagnostics.Process]::Start($psi)" + sCRLF) to sScript
        Move (sScript + "if (-not $proc.WaitForExit($TimeoutSeconds * 1000)) {" + sCRLF) to sScript
        Move (sScript + '    Write-Host "FAILED: timed out after $TimeoutSeconds s - killing the process tree." -ForegroundColor Red' + sCRLF) to sScript
        Move (sScript + "    Start-Process taskkill -ArgumentList '/F','/T','/PID', $proc.Id -NoNewWindow -Wait" + sCRLF) to sScript
        Move (sScript + "    exit 1" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "$code = $proc.ExitCode" + sCRLF) to sScript
        Move (sScript + 'Write-Host "Exit code   : $code"' + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "# 3) Result file = source of truth; exit code = cross-check." + sCRLF) to sScript
        Move (sScript + "if (-not (Test-Path -LiteralPath $ResultFile)) {" + sCRLF) to sScript
        Move (sScript + "    Write-Host 'FAILED: no result file - the run crashed, hung, or never finished.' -ForegroundColor Red" + sCRLF) to sScript
        Move (sScript + "    exit 1" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "$status = (Get-Content -LiteralPath $ResultFile -TotalCount 1).Trim()" + sCRLF) to sScript
        Move (sScript + "if ($status -ne 'STATUS=SUCCESS' -or $code -ne 0) {" + sCRLF) to sScript
        Move (sScript + '    Write-Host "FAILED: status=$status exitcode=$code" -ForegroundColor Red' + sCRLF) to sScript
        Move (sScript + "    Get-Content -LiteralPath $ResultFile | Write-Host" + sCRLF) to sScript
        Move (sScript + "    exit 1" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "Write-Host 'SUCCESS.' -ForegroundColor Green" + sCRLF) to sScript
        Move (sScript + "exit 0" + sCRLF) to sScript

        Get rfOpenOutput sScriptPath to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh sScript
        Send rfCloseOutput iCh
    End_Procedure

    /* THE CI SCAN'S WRAPPER (2026-11-20): "<ini>_SCAN.ps1" beside an exported INI, for DFRefactorFT's /scan - the
       way a build server runs it. Exit 0 = no new findings, 1 = new findings, 2 = the scan could not run; -Baseline
       accepts today's findings. The scan runs a COPY of the INI in TEMP, never the INI itself: with -WorkspaceRoot
       the INI's paths under sWorkspaceRoot (where the workspace was at export) move to where it is on that machine,
       and the result, baseline, findings and SARIF files go beside the INI wherever it is then - so the INI, this
       script and the baseline can be committed together to the workspace's repository. sExePath is the program's
       full path, the script's default for -Exe. Best-effort, as WriteRunnerScript: a write failure leaves no script.
       (The DataFlex lines were generated from the plain script, one quote character per line - keep it so.) */
    Procedure WriteScanScript String sIniPath String sExePath String sWorkspaceRoot
        String sFolder sIniName sScriptName sScript sCRLF sIniQ sExeQ sRootQ
        Integer iPos iLast iLen iCh

        Move (Length(sIniPath)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sIniPath, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Move (Left(sIniPath, iLast)) to sFolder
        Move (Mid(sIniPath, (iLen - iLast), (iLast + 1))) to sIniName
        Get ScanScriptName sIniPath to sScriptName
        Get SingleQuoted sIniName       to sIniQ
        Get SingleQuoted sExePath       to sExeQ
        Get SingleQuoted sWorkspaceRoot to sRootQ
        Move (Character(13) + Character(10)) to sCRLF

        Move "" to sScript
        Move (sScript + "# " + sScriptName + " - generated by DFRefactor for " + sIniQ + "." + sCRLF) to sScript
        Move (sScript + "# The CI scan (" + CS_CmdLineScan + "): Analyze Source, read-only, on the workspace the INI names, with its findings compared to" + sCRLF) to sScript
        Move (sScript + "# the baseline - <ini name>.baseline.json beside the INI. Exit 0 = no new findings, 1 = new findings, 2 = the scan" + sCRLF) to sScript
        Move (sScript + "# could not run. Run it once with -Baseline to accept today's findings as the baseline." + sCRLF) to sScript
        Move (sScript + "# -WorkspaceRoot: where the workspace is on THIS machine (a build server's checkout folder). The INI's paths under" + sCRLF) to sScript
        Move (sScript + "# " + sRootQ + " are then read under it instead. Re-export to refresh this file." + sCRLF) to sScript
        Move (sScript + "param(" + sCRLF) to sScript
        Move (sScript + "    [string]$Exe = '" + sExeQ + "'," + sCRLF) to sScript
        Move (sScript + "    [string]$Ini = (Join-Path $PSScriptRoot '" + sIniQ + "')," + sCRLF) to sScript
        Move (sScript + "    [string]$WorkspaceRoot = ''," + sCRLF) to sScript
        Move (sScript + "    [switch]$Baseline," + sCRLF) to sScript
        Move (sScript + "    [int]$TimeoutSeconds = 1800" + sCRLF) to sScript
        Move (sScript + ")" + sCRLF) to sScript
        Move (sScript + "$ErrorActionPreference = 'Stop'" + sCRLF) to sScript
        Move (sScript + "$ExportRoot = '" + sRootQ + "'" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + 'if (-not (Test-Path -LiteralPath $Ini)) { Write-Host "FAILED: INI not found: $Ini" -ForegroundColor Red; exit 2 }' + sCRLF) to sScript
        Move (sScript + "$Ini = (Resolve-Path -LiteralPath $Ini).Path" + sCRLF) to sScript
        Move (sScript + "$stem = Join-Path (Split-Path -Parent $Ini) ([System.IO.Path]::GetFileNameWithoutExtension($Ini))" + sCRLF) to sScript
        Move (sScript + "$ResultFile = $stem + '_SCAN-RESULT.txt'" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "# Key in [Section] of the INI text set to Value; with -IfMissing a key that is there is left alone." + sCRLF) to sScript
        Move (sScript + "function Set-IniValue([string]$Text, [string]$Section, [string]$Key, [string]$Value, [switch]$IfMissing) {" + sCRLF) to sScript
        Move (sScript + "    $lines = [System.Collections.Generic.List[string]]::new([string[]]($Text -split '\r?\n'))" + sCRLF) to sScript
        Move (sScript + "    $start = -1" + sCRLF) to sScript
        Move (sScript + "    for ($i = 0; $i -lt $lines.Count; $i++) { if ($lines[$i].Trim() -ieq ('[' + $Section + ']')) { $start = $i; break } }" + sCRLF) to sScript
        Move (sScript + "    if ($start -lt 0) {" + sCRLF) to sScript
        Move (sScript + "        $lines.Add(''); $lines.Add('[' + $Section + ']'); $lines.Add($Key + '=' + $Value)" + sCRLF) to sScript
        Move (sScript + "        return ($lines -join [Environment]::NewLine)" + sCRLF) to sScript
        Move (sScript + "    }" + sCRLF) to sScript
        Move (sScript + "    for ($i = $start + 1; $i -lt $lines.Count; $i++) {" + sCRLF) to sScript
        Move (sScript + "        if ($lines[$i].Trim().StartsWith('[')) { break }" + sCRLF) to sScript
        Move (sScript + "        if ($lines[$i] -match ('^\s*' + [regex]::Escape($Key) + '\s*=')) {" + sCRLF) to sScript
        Move (sScript + "            if (-not $IfMissing) { $lines[$i] = $Key + '=' + $Value }" + sCRLF) to sScript
        Move (sScript + "            return ($lines -join [Environment]::NewLine)" + sCRLF) to sScript
        Move (sScript + "        }" + sCRLF) to sScript
        Move (sScript + "    }" + sCRLF) to sScript
        Move (sScript + "    $lines.Insert($start + 1, $Key + '=' + $Value)" + sCRLF) to sScript
        Move (sScript + "    return ($lines -join [Environment]::NewLine)" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "# The scan runs a COPY of the INI, in TEMP: its paths moved to -WorkspaceRoot, and the result, baseline, findings" + sCRLF) to sScript
        Move (sScript + "# and SARIF files beside THIS INI, wherever it is now. The INI itself is never changed." + sCRLF) to sScript
        Move (sScript + "$latin1 = [System.Text.Encoding]::GetEncoding(28591)" + sCRLF) to sScript
        Move (sScript + "$text = [System.IO.File]::ReadAllText($Ini, $latin1)" + sCRLF) to sScript
        Move (sScript + "if ($WorkspaceRoot -ne '' -and $ExportRoot -ne '') {" + sCRLF) to sScript
        Move (sScript + "    $from = '(?im)' + [regex]::Escape($ExportRoot.TrimEnd('\')) + '(?=[\\,]|\r?$)'" + sCRLF) to sScript
        Move (sScript + "    $text = [regex]::Replace($text, $from, $WorkspaceRoot.TrimEnd('\').Replace('$', '$$'))" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "$text = Set-IniValue $text '" + CS_CmdIniResultSection + "' '" + CS_CmdIniResultFile + "' $ResultFile" + sCRLF) to sScript
        Move (sScript + "$text = Set-IniValue $text '" + CS_CmdIniScanSection + "' '" + CS_CmdIniScanBaselineFile + "' ($stem + '.baseline.json') -IfMissing" + sCRLF) to sScript
        Move (sScript + "$text = Set-IniValue $text '" + CS_CmdIniScanSection + "' '" + CS_CmdIniScanJsonFile + "' ($stem + '.findings.json') -IfMissing" + sCRLF) to sScript
        Move (sScript + "$text = Set-IniValue $text '" + CS_CmdIniScanSection + "' '" + CS_CmdIniScanSarifFile + "' ($stem + '.findings.sarif') -IfMissing" + sCRLF) to sScript
        Move (sScript + "$runIni = Join-Path ([System.IO.Path]::GetTempPath()) ('DFRefactor_scan_' + [System.IO.Path]::GetFileName($Ini))" + sCRLF) to sScript
        Move (sScript + "[System.IO.File]::WriteAllText($runIni, $text, $latin1)" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + 'Write-Host "Exe         : $Exe"' + sCRLF) to sScript
        Move (sScript + 'Write-Host "Ini         : $Ini"' + sCRLF) to sScript
        Move (sScript + 'Write-Host "Result file : $ResultFile"' + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "if (Test-Path -LiteralPath $ResultFile) { Remove-Item -LiteralPath $ResultFile -Force }" + sCRLF) to sScript
        Move (sScript + "$psi = [System.Diagnostics.ProcessStartInfo]::new()" + sCRLF) to sScript
        Move (sScript + "$psi.FileName = $Exe" + sCRLF) to sScript
        Move (sScript + '$psi.Arguments = "' + CS_CmdLineScan + ' `"$runIni`""' + sCRLF) to sScript
        Move (sScript + "if ($Baseline) { $psi.Arguments += ' " + CS_CmdLineScanBaseline + "' }" + sCRLF) to sScript
        Move (sScript + "$psi.UseShellExecute = $false" + sCRLF) to sScript
        Move (sScript + "$proc = [System.Diagnostics.Process]::Start($psi)" + sCRLF) to sScript
        Move (sScript + "if (-not $proc.WaitForExit($TimeoutSeconds * 1000)) {" + sCRLF) to sScript
        Move (sScript + '    Write-Host "FAILED: timed out after $TimeoutSeconds s - killing the process tree." -ForegroundColor Red' + sCRLF) to sScript
        Move (sScript + "    Start-Process taskkill -ArgumentList '/F','/T','/PID', $proc.Id -NoNewWindow -Wait" + sCRLF) to sScript
        Move (sScript + "    Remove-Item -LiteralPath $runIni -Force -ErrorAction SilentlyContinue" + sCRLF) to sScript
        Move (sScript + "    exit 2" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "$code = $proc.ExitCode" + sCRLF) to sScript
        Move (sScript + "Remove-Item -LiteralPath $runIni -Force -ErrorAction SilentlyContinue" + sCRLF) to sScript
        Move (sScript + 'Write-Host "Exit code   : $code"' + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "if (-not (Test-Path -LiteralPath $ResultFile)) {" + sCRLF) to sScript
        Move (sScript + "    Write-Host 'FAILED: no result file - the scan crashed, hung, or never finished.' -ForegroundColor Red" + sCRLF) to sScript
        Move (sScript + "    exit 2" + sCRLF) to sScript
        Move (sScript + "}" + sCRLF) to sScript
        Move (sScript + "Get-Content -LiteralPath $ResultFile | Write-Host" + sCRLF) to sScript
        Move (sScript + "if ($code -eq 0 -and $Baseline) { Write-Host 'BASELINE WRITTEN.' -ForegroundColor Green; exit 0 }" + sCRLF) to sScript
        Move (sScript + "if ($code -eq 0) { Write-Host 'PASSED: no new findings.' -ForegroundColor Green; exit 0 }" + sCRLF) to sScript
        Move (sScript + "if ($code -eq 1) { Write-Host 'FAILED: new findings - the first are listed above; the JSON and SARIF files have them all.' -ForegroundColor Red; exit 1 }" + sCRLF) to sScript
        Move (sScript + 'Write-Host "FAILED: the scan could not run (exit code $code)." -ForegroundColor Red' + sCRLF) to sScript
        Move (sScript + "exit 2" + sCRLF) to sScript

        Get rfOpenOutput (sFolder + sScriptName) to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh sScript
        Send rfCloseOutput iCh
    End_Procedure

    /* A STARTER CI WORKFLOW (2026-11-20): "<ini>_CI-SAMPLE.yml" beside an exported INI - GitHub Actions on a
       self-hosted Windows runner with DataFlex: build the workspace with df-cli, run a DFUnit test program, run the
       CI scan through the _SCAN.ps1 wrapper (WriteScanScript), and upload its SARIF to code scanning. A sample to
       copy and adjust, named so - the header says where it goes and what to commit with it. Best-effort. */
    Procedure WriteCIWorkflowSample String sIniPath String sExePath String sSWSFile
        String sFolder sIniName sScriptName sScript sCRLF sIniQ sExeQ sScanQ sStemQ sSwsQ sValue
        Integer iPos iLast iLen iCh

        Move (Length(sIniPath)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sIniPath, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Move (Left(sIniPath, iLast)) to sFolder
        Move (Mid(sIniPath, (iLen - iLast), (iLast + 1))) to sIniName
        Get CIWorkflowSampleName sIniPath to sScriptName
        Get SingleQuoted sIniName to sIniQ
        Get SingleQuoted sExePath to sExeQ
        Get ScanScriptName sIniPath to sValue
        Get SingleQuoted sValue to sScanQ
        Get BatchArtifactLeaf sIniPath "" to sValue
        Get SingleQuoted sValue to sStemQ
        // The workspace file by its name: the workflow runs from the repository root, where it usually is.
        Move (Length(sSWSFile)) to iLen
        Move 0 to iLast
        For iPos from 1 to iLen
            If (Mid(sSWSFile, 1, iPos) = "\") ;
                Move iPos to iLast
        Loop
        Get SingleQuoted (Mid(sSWSFile, (iLen - iLast), (iLast + 1))) to sSwsQ
        Move (Character(13) + Character(10)) to sCRLF

        Move "" to sScript
        Move (sScript + "# " + sScriptName + " - a STARTER GitHub Actions workflow, generated by DFRefactor for " + sIniQ + "." + sCRLF) to sScript
        Move (sScript + "# Copy it to .github/workflows/ in the workspace's repository, and commit these to a ci folder there:" + sCRLF) to sScript
        Move (sScript + "#   " + sIniQ + ", " + sScanQ + " and " + sStemQ + ".baseline.json (run " + sScanQ + " -Baseline once to write it)." + sCRLF) to sScript
        Move (sScript + "# It needs a SELF-HOSTED Windows runner with DataFlex 26 and DFRefactor installed - GitHub's own runners have no" + sCRLF) to sScript
        Move (sScript + "# DataFlex. Give the runner the labels self-hosted, windows and dataflex, and check the env values below." + sCRLF) to sScript
        Move (sScript + "# The SARIF upload needs code scanning on the repository (public repositories, or GitHub Advanced Security)." + sCRLF) to sScript
        Move (sScript + "name: DataFlex CI" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "on:" + sCRLF) to sScript
        Move (sScript + "  push:" + sCRLF) to sScript
        Move (sScript + "  pull_request:" + sCRLF) to sScript
        Move (sScript + "  workflow_dispatch:" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "permissions:" + sCRLF) to sScript
        Move (sScript + "  contents: read" + sCRLF) to sScript
        Move (sScript + "  security-events: write" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "env:" + sCRLF) to sScript
        Move (sScript + "  DF_CLI: 'C:\Program Files\DataFlex 26.0\Bin64\df-cli.exe'" + sCRLF) to sScript
        Move (sScript + "  DFREFACTOR_EXE: '" + sExeQ + "'" + sCRLF) to sScript
        Move (sScript + "  # The workspace file, from the repository root. df-cli builds a DataFlex 26 (JSON) workspace file." + sCRLF) to sScript
        Move (sScript + "  WORKSPACE_FILE: '" + sSwsQ + "'" + sCRLF) to sScript
        Move (sScript + "  # The DFUnit test program df-cli builds, from the repository root - e.g. Programs\UnitTests64.exe. Blank: no tests." + sCRLF) to sScript
        Move (sScript + "  TEST_PROGRAM: ''" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "jobs:" + sCRLF) to sScript
        Move (sScript + "  build-test-scan:" + sCRLF) to sScript
        Move (sScript + "    runs-on: [self-hosted, windows, dataflex]" + sCRLF) to sScript
        Move (sScript + "    steps:" + sCRLF) to sScript
        Move (sScript + "      - uses: actions/checkout@v4" + sCRLF) to sScript
        Move (sScript + "        with:" + sCRLF) to sScript
        Move (sScript + "          submodules: recursive" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "      - name: Build the workspace (df-cli)" + sCRLF) to sScript
        Move (sScript + "        shell: pwsh" + sCRLF) to sScript
        Move (sScript + "        run: |" + sCRLF) to sScript
        Move (sScript + "          & $env:DF_CLI build $env:WORKSPACE_FILE --toolchain 26.0.0+windows-64" + sCRLF) to sScript
        Move (sScript + "          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "      - name: Unit tests (DFUnit)" + sCRLF) to sScript
        Move (sScript + "        if: env.TEST_PROGRAM != ''" + sCRLF) to sScript
        Move (sScript + "        shell: pwsh" + sCRLF) to sScript
        Move (sScript + "        run: |" + sCRLF) to sScript
        Move (sScript + "          Start-Process -FilePath $env:TEST_PROGRAM -ArgumentList '-c','-o','dfunit-results.xml' -Wait" + sCRLF) to sScript
        Move (sScript + "          if (-not (Test-Path dfunit-results.xml)) { Write-Host 'No test results - the test program did not finish.'; exit 1 }" + sCRLF) to sScript
        Move (sScript + "          if (Select-String -Path dfunit-results.xml -Pattern '<failure' -Quiet) { Write-Host 'Unit tests failed.'; exit 1 }" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "      - name: DFRefactor CI scan" + sCRLF) to sScript
        Move (sScript + "        shell: pwsh" + sCRLF) to sScript
        Move (sScript + "        run: ./ci/" + sScanQ + " -Exe $env:DFREFACTOR_EXE -WorkspaceRoot $env:GITHUB_WORKSPACE" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "      - name: Upload the findings (SARIF)" + sCRLF) to sScript
        Move (sScript + "        if: always() && hashFiles('ci/" + sStemQ + ".findings.sarif') != ''" + sCRLF) to sScript
        Move (sScript + "        uses: github/codeql-action/upload-sarif@v3" + sCRLF) to sScript
        Move (sScript + "        with:" + sCRLF) to sScript
        Move (sScript + "          sarif_file: ci/" + sStemQ + ".findings.sarif" + sCRLF) to sScript
        Move (sScript + "          category: dfrefactor" + sCRLF) to sScript
        Move (sScript + sCRLF) to sScript
        Move (sScript + "      - name: Keep the test results and the findings" + sCRLF) to sScript
        Move (sScript + "        if: always()" + sCRLF) to sScript
        Move (sScript + "        uses: actions/upload-artifact@v4" + sCRLF) to sScript
        Move (sScript + "        with:" + sCRLF) to sScript
        Move (sScript + "          name: dataflex-ci" + sCRLF) to sScript
        Move (sScript + "          path: |" + sCRLF) to sScript
        Move (sScript + "            dfunit-results.xml" + sCRLF) to sScript
        Move (sScript + "            ci/" + sStemQ + ".findings.json" + sCRLF) to sScript
        Move (sScript + "            ci/" + sStemQ + ".findings.sarif" + sCRLF) to sScript
        Move (sScript + "            ci/" + sStemQ + "_SCAN-RESULT.txt" + sCRLF) to sScript
        Move (sScript + "          if-no-files-found: ignore" + sCRLF) to sScript

        Get rfOpenOutput (sFolder + sScriptName) to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh sScript
        Send rfCloseOutput iCh
    End_Procedure

    // Folds a full .sws path into a registry-safe value-name stem: lowercased (Windows paths are
    // case-insensitive, matching the recent-list identity) with \ / : and spaces turned into "_".
    Function AnalyzeSnapshotKey String sSWSFile Returns String
        String  sIn sOut sChar
        Integer i iLen
        Move (Lowercase(Trim(sSWSFile))) to sIn
        Move (Length(sIn)) to iLen
        Move "" to sOut
        For i from 1 to iLen
            Move (Mid(sIn, 1, i)) to sChar
            If (sChar = "\" or sChar = "/" or sChar = ":" or sChar = " ") ;
                Move "_" to sChar
            Move (sOut + sChar) to sOut
        Loop
        Function_Return sOut
    End_Function

    /* Stamps the analyze counts + today's date for the CURRENTLY-loaded workspace (psSWSFile).
       iWarn is the COMPILER's warnings and iScan the source-scan findings merged into the same
       analysis (see tModProgressEntry). The REGISTRY slots keep taking the two added together,
       exactly the number they have always held - they are the dashboard's latest-only cue and
       nothing reads them expecting a split. The history gets the two separately, because its
       table shows them in their own columns. */
    Procedure WriteAnalyzeSnapshot Integer iWarn Integer iErr Integer iAuto Integer iSuggest Integer iScan
        String sSWSFile sKey sIso sProgram sProgKey

        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get TodayIsoDateTime to sIso   // date + time, so the tile's "last run" shows both
        // Single-slot = the LAST analyzed program's counts (the tile's primary readout).
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Warn")    (String(iWarn + iScan))
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Err")     (String(iErr))
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Auto")    (String(iAuto))
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Suggest") (String(iSuggest))
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Date")    sIso
        // Tag the snapshot with WHICH program it is for + stamp a per-program snapshot so AnalyzeRollup can
        // total "N of M analyzed" across a many-program workspace. The analyzed program == the last-compiled
        // one (CS_LastCompileKeyPrefix), whose name is verbatim a GetWorkspaceProjects entry - so the per-
        // program key here matches the one AnalyzeRollup derives when it enumerates the workspace's programs.
        Get ReadString CS_Settings (CS_LastCompileKeyPrefix + sSWSFile) "" to sProgram
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Program") sProgram
        If (sProgram <> "") Begin
            Get AnalyzeSnapshotKey sProgram to sProgKey
            Send WriteString CS_AnalyzeSnapshotKey (sKey + ".P_" + sProgKey + ".Warn") (String(iWarn + iScan))
            Send WriteString CS_AnalyzeSnapshotKey (sKey + ".P_" + sProgKey + ".Date") sIso
        End
        // Also append these counts to the per-workspace progress HISTORY (the burn-down time series); the
        // registry slots above stay the dashboard's latest-only fast cue. De-duped vs the last entry.
        Send AppendModProgressEntry iWarn iErr iAuto iSuggest sProgram iScan
    End_Procedure

    // Reads the snapshot for the CURRENTLY-loaded workspace. TheData.bFound is True only when a stored
    // date was found; counts come back via a lenient string->Integer Move (never Integer(), which faults
    // on a blank/garbage value).
    Function ReadAnalyzeSnapshot Returns tAnalyzeSnapshot
        tAnalyzeSnapshot TheData
        String sSWSFile sKey sDate sWarn sErr sAuto sSuggest sProgram

        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Function_Return TheData
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Date") "" to sDate
        If (sDate = "") ;
            Function_Return TheData
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Warn")    "0" to sWarn
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Err")     "0" to sErr
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Auto")    "0" to sAuto
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Suggest") "0" to sSuggest
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".Program") ""  to sProgram
        Move sWarn    to TheData.iWarn
        Move sErr     to TheData.iErr
        Move sAuto    to TheData.iAuto
        Move sSuggest to TheData.iSuggest
        Move sDate    to TheData.sDate
        Move sProgram to TheData.sProgram
        Move True     to TheData.bFound
        Function_Return TheData
    End_Function

    // Workspace-wide roll-up across the per-program snapshots WriteAnalyzeSnapshot stamps (.P_<prog>.Warn /
    // .Date). iTotal = every program in the .sws [Projects]; iAnalyzed = those with a stored snapshot;
    // iWarnTotal = the sum of their warning counts. Enumerates GetWorkspaceProjects so the per-program keys
    // match what WriteAnalyzeSnapshot wrote (both fold the SAME program-name strings via AnalyzeSnapshotKey).
    // Counts use the lenient string->Integer Move (never Integer(), which faults on a blank value).
    Function AnalyzeRollup Returns tAnalyzeRollup
        tAnalyzeRollup TheData
        String[] asProjects
        String sSWSFile sKey sProgKey sDate sWarn
        Integer i iSize iWarnVal

        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Function_Return TheData
        Get AnalyzeSnapshotKey sSWSFile to sKey
        // The programs ON DISK (2026-09-23): a listed program whose file is gone can never be
        // analyzed, so counting it made "N of M" a total no Check could reach.
        Get WorkspaceProgramsOnDisk sSWSFile to asProjects
        Move (SizeOfArray(asProjects)) to TheData.iTotal
        Move (SizeOfArray(asProjects) - 1) to iSize
        For i from 0 to iSize
            Get AnalyzeSnapshotKey asProjects[i] to sProgKey
            Get ReadString CS_AnalyzeSnapshotKey (sKey + ".P_" + sProgKey + ".Date") "" to sDate
            If (sDate <> "") Begin
                Increment TheData.iAnalyzed
                Get ReadString CS_AnalyzeSnapshotKey (sKey + ".P_" + sProgKey + ".Warn") "0" to sWarn
                Move sWarn to iWarnVal
                Move (TheData.iWarnTotal + iWarnVal) to TheData.iWarnTotal
            End
        Loop
        Function_Return TheData
    End_Function

    // Drops the snapshot for an explicit .sws path - called when a workspace is removed from the recent
    // list, so its cached counts don't linger as orphaned registry values.
    Procedure ClearAnalyzeSnapshot String sSWSFile
        String sKey
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Warn")    ""
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Err")     ""
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Auto")    ""
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Suggest") ""
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".Date")    ""
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".PlanRun") ""
    End_Procedure

    // Stamps "a Modernization plan run finished NOW" for the CURRENTLY-loaded workspace (same
    // registry fold as the analyze snapshot). Written by the ENGINE at the end of every eRunPlan run
    // (any outcome - even a cancelled run may have applied fixes, so "recompile to verify" stays the
    // right advice). The dashboard's guided cycle strip compares this against the snapshot's .Date:
    // stamp NEWER than the last analyze = the loop has wrapped, so the strip relights step 1
    // (Compile) instead of leaving Run Fix Plan lit (Nils 2026-07-10). Self-healing: the next
    // analyze writes a newer .Date, which supersedes the stamp with no explicit clear.
    Procedure WritePlanRunStamp
        String sSWSFile sKey sIso
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get TodayIsoDateTime to sIso
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".PlanRun") sIso
    End_Procedure

    // The last plan-run stamp for the CURRENTLY-loaded workspace ("" = never / cleared). ISO date +
    // time from TodayIsoDateTime, so a plain string compare against the snapshot's .Date orders them.
    Function ReadPlanRunStamp Returns String
        String sSWSFile sKey sStamp
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Function_Return ""
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".PlanRun") "" to sStamp
        Function_Return sStamp
    End_Function

    // Full path to this workspace's saved "last refactoring plan" JSON: the Data folder + LastPlan-<wskey>.json,
    // <wskey> being the SAME AnalyzeSnapshotKey fold the registry snapshot uses, so plan + snapshot are co-keyed
    // per workspace. CANONICAL home - cModAnalyzer.SavedPlanJsonPath delegates here. Reads only app state, so it
    // is safe to call before the analyzer dock exists (the dashboard tile calls it as early as its first paint).
    Function SavedPlanJsonPath Returns String
        String sData sSWS sKey sFile
        Get psDataPath of (phoWorkspace(Self)) to sData
        Get psSWSFile to sSWS
        Get AnalyzeSnapshotKey sSWS to sKey
        Move CS_SavedPlanJson to sFile
        If (Trim(sKey) <> "") ;
            Move (Replace(".json", sFile, ("-" + sKey + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    /* ---- Guided trail: the Tidy Up stage, remembered per workspace -------------------------------

       Stage 3/4 of the trail used to live in a session property, so "Tidy Up has run" - and with it
       the Ready badge - evaporated on every restart, and on a large workspace earning it back costs
       another full pass (Nils 2026-07-29, asked for it to persist). Same registry fold and the same
       <wskey> as the analyze snapshot and the plan-run stamp, so all three move together when the
       workspace changes and none of them can describe the wrong .sws.

       TWO values, because "it ran" and "what it left behind" are different facts:
         .TidyUp      ISO date+time of the last trail-routed Tidy Up ("" = never).
         .SrcDirty    "1" while source has been REWRITTEN and no Check has looked at it since -
                      whoever rewrote it. Ready will not light while it stands, because changed
                      files leave a build nobody has compiled. A run that changed nothing is never
                      dirty: there is nothing to verify, so Ready may light immediately.

       .SrcDirty IS NOT TIDY-UP-SPECIFIC, though it started that way (2026-07-29). Every guided row
       action rewrites source through RunScopedFunction exactly as a Tidy Up does, and none of them
       said so - a conversion could rewrite files while the board went on showing the previous
       Check's verdict and the trail went on showing Ready. The flag belongs to the SOURCE, not to
       one stage. */
    Procedure WriteTidyUpStamp Boolean bLeftUnverifiedChanges
        String sSWSFile sKey sIso
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get TodayIsoDateTime to sIso
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".TidyUp") sIso
        If (bLeftUnverifiedChanges = True) ;
            Send MarkSourceUnverified
        Else ;
            Send ClearSourceUnverified
    End_Procedure

    // Source has just been rewritten and nothing has compiled it since. Called by EVERY path that
    // writes source on the user's behalf, not only the Tidy Up stage.
    Procedure MarkSourceUnverified
        String sSWSFile sKey
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".SrcDirty") "1"
    End_Procedure

    // "" = no trail Tidy Up has ever finished for the currently-loaded workspace.
    Function ReadTidyUpStamp Returns String
        String sSWSFile sKey sStamp
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Function_Return ""
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".TidyUp") "" to sStamp
        Function_Return sStamp
    End_Function

    // True while source has been rewritten with no Check since.
    Function ReadSourceUnverified Returns Boolean
        String sSWSFile sKey sFlag
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Function_Return False
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Get ReadString CS_AnalyzeSnapshotKey (sKey + ".SrcDirty") "" to sFlag
        Function_Return (Trim(sFlag) <> "")
    End_Function

    // A completed Check has now looked at the code as it stands - whatever it found, it found it in
    // the rewritten source, so the debt is settled and Ready may light again on that verdict.
    Procedure ClearSourceUnverified
        String sSWSFile sKey
        Get psSWSFile to sSWSFile
        If (sSWSFile = "") ;
            Procedure_Return
        Get AnalyzeSnapshotKey sSWSFile to sKey
        Send WriteString CS_AnalyzeSnapshotKey (sKey + ".SrcDirty") ""
    End_Procedure

    // ---- Modernization progress history (per-workspace burn-down) ----------------------------------

    // Full path to this workspace's progress-history JSON: Data folder + ModProgress-<wskey>.json, the SAME
    // AnalyzeSnapshotKey fold the saved plan / registry snapshot use. Mirrors SavedPlanJsonPath.
    Function ModProgressJsonPath Returns String
        String sData sSWS sKey sFile
        Get psDataPath of (phoWorkspace(Self)) to sData
        Get psSWSFile to sSWS
        Get AnalyzeSnapshotKey sSWS to sKey
        Move CS_ModProgressJson to sFile
        If (Trim(sKey) <> "") ;
            Move (Replace(".json", sFile, ("-" + sKey + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    // Read the workspace's progress history. Returns an empty (version-stamped) file when absent, unparseable,
    // or a stale layout. Existence-checked BEFORE opening (rfOpenInput does not fail-negative on a missing file
    // - see feedback_rfopeninput_check_existence_first). Mirrors ReadSavedPlan.
    Function ReadModProgress Returns tModProgressFile
        Handle hoJson
        Integer i iLast
        tModProgressFile TheFile TheEmpty
        String sFile

        Move CI_ModProgressVersion to TheEmpty.iVersion
        Get ModProgressJsonPath to sFile
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return TheEmpty
        Get JsonToDataType of hoJson to TheFile
        Send Destroy of hoJson
        If (TheFile.iVersion <> CI_ModProgressVersion) ;
            Function_Return TheEmpty
        // Entries written before the iWarn / iScan split carry both numbers in iWarn. Recovering
        // what can be recovered happens HERE, once, so no reader downstream has to know the file
        // ever had another shape (the rule, and why a compile row is left alone, are in
        // ModProgressCounts.pkg).
        Move (SizeOfArray(TheFile.aEntries) - 1) to iLast
        For i from 0 to iLast
            Move (ModProgressBackFilledEntry(TheFile.aEntries[i])) to TheFile.aEntries[i]
        Loop
        Function_Return TheFile
    End_Function

    // Write the progress history (pretty, NO BOM - a BOM breaks ParseUtf8). Mirrors WriteSavedPlan.
    Procedure WriteModProgress tModProgressFile TheFile
        Handle hoJson
        UChar[] ucJson
        Integer iCh
        String sFile

        Move CI_ModProgressVersion to TheFile.iVersion
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson TheFile
        Set peWhiteSpace of hoJson to jpWhitespace_Pretty
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get ModProgressJsonPath to sFile
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    /* ---- Deep Scan cache persistence (Nils 2026-07-28) ----------------------------------
       The incremental scan cache was session-lifetime, so every program start paid a cold scan of
       the whole workspace even when nothing had been edited. These three mirror the ModProgress /
       SavedPlan trio exactly - same folded-.sws key, same version gate, same NO-BOM write. */
    Function DeepScanCacheJsonPath Returns String
        String sData sKey sFile sSWS
        tWorkspacePaths OrgWS

        /* pOrgWS, not phoWorkspace (Nils 2026-07-28). Both resolve to DFRefactor's own Data folder
           in practice, and the three sibling path functions above use phoWorkspace - but they are
           correct only because ApplyTargetFilelist REDIRECTS phoWorkspace's psDataPath at the
           target workspace and the bracket around that is kept tiny by convention. pOrgWS is
           DFRefactor's own workspace by definition: captured once in End_Construct_Object, never
           redirected. This file must never be written into a customer's Data folder, so it takes
           the definition rather than the discipline. (psDataPath lives on the WORKSPACE object,
           not the application - a Get without phoWorkspace is a runtime Error 98 the compiler
           cannot see, which is how the first version of this failed.) */
        Get pOrgWS to OrgWS
        Move OrgWS.sData to sData
        If (Trim(sData) = "") ;
            Get psDataPath of (phoWorkspace(Self)) to sData      // pre-capture fallback
        If (Trim(sData) = "") ;
            Function_Return ""
        Get psSWSFile to sSWS
        Get AnalyzeSnapshotKey sSWS to sKey
        Move CS_DeepScanCacheJson to sFile
        If (Trim(sKey) <> "") ;
            Move (Replace(".json", sFile, ("-" + sKey + ".json"))) to sFile
        Function_Return (vFolderFormat(sData) + sFile)
    End_Function

    // Empty (version-stamped) on absent / unparseable / stale-version, so a caller never has to
    // distinguish "no cache" from "bad cache" - both simply scan.
    Function ReadDeepScanCache Returns tDeepScanCacheFile
        Handle hoJson
        tDeepScanCacheFile TheFile TheEmpty
        String sFile

        Move CI_DeepScanCacheVersion to TheEmpty.iVersion
        Get DeepScanCacheJsonPath to sFile
        If (sFile = "") ;
            Function_Return TheEmpty
        Get rfParseJsonFile sFile to hoJson
        If (hoJson = 0) ;
            Function_Return TheEmpty
        Get JsonToDataType of hoJson to TheFile
        Send Destroy of hoJson
        If (TheFile.iVersion <> CI_DeepScanCacheVersion) ;
            Function_Return TheEmpty
        Function_Return TheFile
    End_Function

    // Written COMPACT, not pretty: nobody reads this by hand and the pretty printer roughly doubles
    // it. No BOM - a BOM breaks ParseUtf8.
    Procedure WriteDeepScanCache tDeepScanCacheFile TheFile
        Handle hoJson
        UChar[] ucJson
        Integer iCh
        String sFile

        Get DeepScanCacheJsonPath to sFile
        If (sFile = "") ;
            Procedure_Return
        Move CI_DeepScanCacheVersion to TheFile.iVersion
        Get Create (RefClass(cJsonObject)) to hoJson
        Send DataTypeToJson of hoJson TheFile
        Get StringifyUtf8 of hoJson to ucJson
        Send Destroy of hoJson
        Get rfOpenOutput sFile to iCh
        If (iCh < 0) ;
            Procedure_Return
        Write channel iCh ucJson
        Send rfCloseOutput iCh
    End_Procedure

    // Append one analyze's counts to the history - UNLESS identical to the last entry (same four counts +
    // program), so a re-analyze with unchanged counts adds no flat row. Stamps today's date + the target DF
    // version. Called from WriteAnalyzeSnapshot, so every analyze that has a workspace records one point.
    Procedure AppendModProgressEntry Integer iWarn Integer iErr Integer iAuto Integer iSuggest String sProgram Integer iScan
        tModProgressFile TheFile
        tModProgressEntry Entry
        Integer iLast

        Get ReadModProgress to TheFile
        Move (SizeOfArray(TheFile.aEntries) - 1) to iLast
        /* The platform is resolved BEFORE the de-dup test, because it is PART of it. A Deep
           Scan reads SOURCE and is the same whatever the build targets, so it records nothing
           rather than an answer that would look like a property of the scan.
           EffectiveCompilePlatform is the same single answer the command line, the compile
           banner and the listing-name predictor use. */
        Move "" to Entry.sPlatform
        If (sProgram <> CS_ModProgressDeepScanLabel) Begin
            If ((EffectiveCompilePlatform(Self)) contains "64") ;
                Move "x64" to Entry.sPlatform
            Else ;
                Move "x86" to Entry.sPlatform
        End
        /* IDENTICAL LAPS ARE NOT WORTH A ROW - but the PLATFORM is part of "identical"
           (Nils 2026-08-20). Re-checking WinServ after the 32->64 switch produced the very
           same counts, so without this the one lap the new column exists to show - the
           transition itself - was the row that got suppressed. */
        If (iLast >= 0) Begin
            // iScan is part of "identical" for the same reason the platform is: a lap whose warning
            // and finding MIX moved is a different lap, even where the two still add up the same.
            If ((TheFile.aEntries[iLast].iWarn = iWarn) and (TheFile.aEntries[iLast].iErr = iErr) ;
                and (TheFile.aEntries[iLast].iScan = iScan) ;
                and (TheFile.aEntries[iLast].iAuto = iAuto) and (TheFile.aEntries[iLast].iSuggest = iSuggest) ;
                and (TheFile.aEntries[iLast].sProgram = sProgram) ;
                and (TheFile.aEntries[iLast].sPlatform = Entry.sPlatform)) ;
                Procedure_Return
        End
        Move iWarn    to Entry.iWarn
        Move iScan    to Entry.iScan
        Move iErr     to Entry.iErr
        Move iAuto    to Entry.iAuto
        Move iSuggest to Entry.iSuggest
        Move sProgram to Entry.sProgram
        Get TodayIsoDateTime  to Entry.sDate
        Get psTargetDfVersion to Entry.sDfVersion
        Move Entry to TheFile.aEntries[SizeOfArray(TheFile.aEntries)]
        Send WriteModProgress TheFile
    End_Procedure

    // Clear this workspace's progress history (the Reset action, wired to the dashboard tile in phase 2).
    // Deletes the file so a fresh baseline starts; per-workspace, so other workspaces keep theirs.
    Procedure ResetModProgress
        String sFile
        Boolean bExists
        Integer iRet
        Get ModProgressJsonPath to sFile
        Get vFilePathExists sFile to bExists
        If (bExists = True) ;
            Get vDeleteFile sFile to iRet
    End_Procedure

    // True only when the saved-plan file for the CURRENT workspace actually exists on disk - so callers don't
    // offer a plan whose file was deleted out from under them (the in-memory analyze flag / registry snapshot
    // can outlive the file). Used by the dashboard to gate "View last plan" + "Run Modernization Plan". Blank
    // workspace -> False.
    Function SavedPlanFileExists Returns Boolean
        String sSWS sFile
        Boolean bExists
        Get psSWSFile to sSWS
        If (sSWS = "") ;
            Function_Return False
        Get SavedPlanJsonPath to sFile
        Get vFilePathExists sFile to bExists
        Function_Return bExists
    End_Function

    // Pass an SWS file with full path.
    // Returns the .ws file name of the Programs folder.
    /* A BLANK .sws NAME IS A NO-ANSWER, NOT AN ERROR (Nils 2026-08-03).
       cIniFile.ReadString raises DFERR_INI_FILE "Ini file name not defined" when it is asked
       to read with no psFilename set - so passing a blank name here surfaced as a runtime
       error deep inside GET_READSTRING, several frames below the caller that actually had
       nothing to look up. That is how RestyleDDOs failed in the first headless run over
       Order Entry: StartDDORestyler passes psSWSFile straight through, and that run had no
       workspace loaded, so the name was empty.

       Every caller already treats "" as "no filelist, carry on" - GetTargetWorkspaceFilelistPath
       checks the file exists and ApplyTargetFilelist returns False on a blank path - so the
       only thing missing was refusing to ask the question in the first place. Same rule as
       vFilePathExists before rfOpenInput: check before you hand it to something that errors. */
    Function WsFileNameFromSWSFileName String sSWSFilename Returns String
        Handle hoIni
        String sWs sWorkspaceFileName

        If (Trim(sSWSFilename) = "") ;
            Function_Return ""
        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni  to sSWSFilename
        Get ReadString of hoIni CS_WorkspacePaths CS_ConfigFile "" to sWs
        Send Destroy   of hoIni
        Move (Replace(".\", sWs, ExtractFilePath(sSWSFilename))) to sWorkspaceFileName

        Function_Return sWorkspaceFileName
    End_Function

    // Finds a program icon file name for a "ProjectNN" in the .sws file.
    // The first icon file for a project is returned.
    Function AppIconFromSWSFileName String sSWSFilename Returns String
        Handle hoIni hoWorkspace
        String sPath sProgramFile sProgramConfigFile sIconFileName sWorkspaceFileName sBitmapPath sAppSrcPath s
        Integer iCount iSize
        Boolean bExists
        
        Move 20 to iSize        
        Get phoWorkspace to hoWorkspace
        // Get .ws file name
        Get WsFileNameFromSWSFileName sSWSFilename to sWorkspaceFileName
        Get ParseFolderName sSWSFilename to sPath
        Move (vFolderFormat(sPath)) to sPath
        
        // Get the first project file (program file)
        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni  to sSWSFilename
        For iCount from 0 to iSize
            Get ReadString of hoIni CS_Projects (String(CS_Project + String(iCount))) "" to sProgramFile
            If (sProgramFile <> "") Begin
                Move (Replace(".src", Lowercase(sProgramFile), ".cfg")) to sProgramConfigFile
                // Open workspace file and get AppSrcPath + BitmapPath
                Set psFilename of hoIni  to sWorkspaceFileName
                Get ReadString of hoIni CS_Workspace CS_AppSrcPath CS_AppSrcPath to sAppSrcPath
                Get PathAtIndex of hoWorkspace sAppSrcPath 1 to sAppSrcPath
                Move (Replace(".\", sAppSrcPath, "")) to sAppSrcPath
                Move (vFolderFormat(sAppSrcPath)) to sAppSrcPath
                Get ReadString of hoIni CS_Workspace CS_BitmapPath CS_BitmapPath to sBitmapPath
                Get PathAtIndex of hoWorkspace sBitmapPath 1 to sBitmapPath
                Move (Replace(".\", sBitmapPath, "")) to sBitmapPath
                Move (vFolderFormat(sBitmapPath)) to sBitmapPath
                // Open .cfg file and get the icon file name
                Set psFileName of hoIni to  (sPath + sAppSrcPath + sProgramConfigFile)
                Get ReadString of hoIni CS_Application CS_Icon "" to sIconFileName 
                // Reset ini-file name so we can get the next project item
                Set psFilename of hoIni  to sSWSFilename
                // We keep checking until we find a project (program) with an icon.
                If (sIconFileName <> "") Begin
                    Move iSize to iCount // Get out of here.
                End                                     
            End
        Loop  
        
        Send Destroy   of hoIni
        // The icon file might not exist in the selected workspace BitmapPath, or no project icon
        // was ever set, in which case we use DataFlex default icon "Default.ico".
        Get vFilePathExists  (sPath + sBitmapPath + sIconFileName) to bExists
        If (bExists = False) Begin 
            Move "Default.ico" to sIconFileName
        End
        Else Begin
            Move (sPath + sBitmapPath + sIconFileName) to sIconFileName
        End
        
        Function_Return sIconFileName
    End_Function

    // Reads a JSON member that the DF26 .sws spec allows to be either a
    // string or an array of strings into a String[]. A scalar value becomes
    // a one-element array; an absent or empty member yields an empty array.
    //
    // Uses MemberJsonType to distinguish array from scalar — Get Member on a
    // scalar member does not reliably return 0 in cJsonObject, so type-based
    // detection is the documented pattern (see JsonEnhancement.RemoveNulls).
    { Visibility=Private }
    Function ReadJsonStringOrArray Handle hoParent String sMemberName Returns String[]
        Handle   hoArray
        Integer  iCount iMax iJsonType
        String   sVal
        String[] asResult

        Get MemberJsonTypeEnh of hoParent sMemberName to iJsonType
        If (iJsonType = jsonTypeArray) Begin
            Get MemberEnh of hoParent sMemberName to hoArray
            Set pbRequireAllMembers of hoArray to False
            Get MemberCount of hoArray to iMax
            Decrement iMax
            For iCount from 0 to iMax
                Get MemberValueEnh of hoArray iCount to asResult[iCount]
            Loop
            Send Destroy of hoArray
        End
        Else Begin
            Get MemberValueEnh of hoParent sMemberName to sVal
            If (sVal <> "") Move sVal to asResult[0]
        End

        Function_Return asResult
    End_Function

    // Reads a DataFlex 26+ JSON-format .sws workspace file.
    // Pass the full path to the .sws file.
    // Returns a populated tSwsFile struct, or an empty struct on parse failure
    // (callers use SwsFile.sDfVersion <> "" as the successful-parse sentinel).
    //
    // Field shape mirrors the locked spec at
    // https://docs.dataflex.dev/Tools/DfCli/Workspace/. Paths the spec allows
    // as string-or-array are returned as String arrays (a scalar is promoted
    // to a single element). Maps (conditionals, preferredClasses, overrides)
    // are iterated via MemberNameByIndex so the JSON key becomes a struct
    // field (Conditional.sName, PrefClass.sName, Override.sKey).
    Function ReadSwsJsonFile String sFileName Returns tSwsFile
        Handle   hoJson hoArray hoItem hoPaths hoStudio hoConds hoPrefs hoPkg
        Handle   hoIncludes hoOverrides hoInstall hoVer
        UChar[]  ucData
        Integer  iCh iCount iMax iJsonType
        Integer  iMajor iMinor iRev
        Boolean  bOK
        String   sVal sKey
        tSwsFile           SwsFile
        tSwsDependency     Dep
        tSwsDependency     EmptyDep
        tSwsOverride       Override
        tSwsOverride       EmptyOverride
        tSwsProject        Project
        tSwsProject        EmptyProject
        tSwsConditional    Conditional
        tSwsPreferredClass PrefClass
        tSwsPreferredClass EmptyPrefClass
        tSwsHtmlInclude    HtmlInc
        tSwsHtmlInclude    EmptyHtmlInc
        tSwsInstallItem    InstallItem
        tSwsInstallItem    EmptyInstallItem

        // Check existence BEFORE opening: rfOpenInput allocates a channel and THEN does Direct_Input, which
        // faults err 33 "Can't open input file" on a MISSING .sws yet still returns the allocated (non-negative)
        // channel - so the iCh<0 guard below never catches it. Warn + return the empty struct (sDfVersion = ""
        // is the failure sentinel callers already handle) so the failing open is never attempted. (Nils 2026-07-07.)
        Get vFilePathExists sFileName to bOK
        If (bOK = False) Begin
            Send Info_Box ("Filename missing:" * String(sFileName))
            Function_Return SwsFile
        End
        Get rfOpenInput sFileName to iCh
        If (iCh < 0) ;
            Function_Return SwsFile

        Read_Block channel iCh ucData -1
        Move (rfStripUtf8Bom(ucData)) to ucData
        Send rfCloseInput iCh

        Get Create (RefClass(cJsonObject)) to hoJson
        Get ParseUtf8 of hoJson ucData to bOK
        If (bOK = False) Begin
            Send Destroy of hoJson
            Function_Return SwsFile
        End

        // The DF26 .sws spec lists most fields as optional. Disable strict
        // "member must exist" mode so MemberValue / MemberJsonType return
        // empty / jsonTypeNull for missing keys instead of erroring. Without
        // this, DF25's cJsonObject errors at the first absent top-level key
        // (e.g. "workspaceName" is missing from many real .sws files).
        Set pbRequireAllMembers of hoJson to False

        // Top-level scalars (per spec).
        Get MemberValueEnh of hoJson "workspaceName" to SwsFile.sWorkspaceName
        Get MemberValueEnh of hoJson "df"            to SwsFile.sDfVersion
        Get MemberValueEnh of hoJson "description"   to SwsFile.sDescription

        Get MemberValueEnh of hoJson "no-update-html" to sVal
        Move (Lowercase(sVal) = "true") to SwsFile.bNoUpdateHtml

        Get MemberValueEnh of hoJson "no-html-include-versioning" to sVal
        Move (Lowercase(sVal) = "true") to SwsFile.bNoHtmlIncludeVersioning

        // "paths" — source and data path configuration. All multi-form
        // entries (appHtml, indexHtml, appSrc, data, ddSrc, bitmap, programs,
        // help) accept either a scalar string or an array of strings.
        Get MemberEnh of hoJson "paths" to hoPaths
        If (hoPaths <> 0) Begin
            Set pbRequireAllMembers of hoPaths to False
            Get MemberValueEnh of hoPaths "configFile"    to SwsFile.Paths.sConfigFile
            Get MemberValueEnh of hoPaths "fileList"      to SwsFile.Paths.sFileList
            Get MemberValueEnh of hoPaths "connectionIni" to SwsFile.Paths.sConnectionIni
            Get MemberValueEnh of hoPaths "ideSrc"        to SwsFile.Paths.sIdeSrc

            Get ReadJsonStringOrArray hoPaths "appHtml"   to SwsFile.Paths.asAppHtml
            Get ReadJsonStringOrArray hoPaths "indexHtml" to SwsFile.Paths.asIndexHtml
            Get ReadJsonStringOrArray hoPaths "appSrc"    to SwsFile.Paths.asAppSrc
            Get ReadJsonStringOrArray hoPaths "data"      to SwsFile.Paths.asData
            Get ReadJsonStringOrArray hoPaths "ddSrc"     to SwsFile.Paths.asDdSrc
            Get ReadJsonStringOrArray hoPaths "bitmap"    to SwsFile.Paths.asBitmap
            Get ReadJsonStringOrArray hoPaths "programs"  to SwsFile.Paths.asPrograms
            Get ReadJsonStringOrArray hoPaths "help"      to SwsFile.Paths.asHelp

            Send Destroy of hoPaths
        End

        // "dependencies" — array of strings or {source, version, sws} objects.
        // Use MemberJsonType for the string-vs-object decision: Get Member on
        // a scalar array element does NOT reliably return 0 in cJsonObject,
        // so we must consult the JSON type first (see JsonEnhancement.pkg's
        // RemoveNulls pattern).
        Get MemberEnh of hoJson "dependencies" to hoArray
        If (hoArray <> 0) Begin
            Set pbRequireAllMembers of hoArray to False
            Get MemberCount of hoArray to iMax
            Decrement iMax
            For iCount from 0 to iMax
                Move EmptyDep to Dep
                Get MemberJsonTypeEnh of hoArray iCount to iJsonType
                If (iJsonType = jsonTypeObject) Begin
                    Move True to Dep.bIsObject
                    Get MemberEnh of hoArray iCount to hoItem
                    Set pbRequireAllMembers of hoItem to False
                    Get MemberValueEnh of hoItem "source"  to Dep.sSource
                    Get MemberValueEnh of hoItem "version" to Dep.sVersion
                    Get MemberValueEnh of hoItem "sws"     to Dep.sSws
                    Send Destroy of hoItem
                End
                Else Begin
                    Move False to Dep.bIsObject
                    Get MemberValueEnh of hoArray iCount to Dep.sPath
                End
                Move Dep to SwsFile.aDependencies[iCount]
            Loop
            Send Destroy of hoArray
        End

        // "overrides" — JSON map of dependency-identifier → version-string or
        // override-object. The KEY is the dependency identifier being
        // overridden; iterate via MemberNameByIndex to get it.
        Get MemberEnh of hoJson "overrides" to hoOverrides
        If (hoOverrides <> 0) Begin
            Set pbRequireAllMembers of hoOverrides to False
            Get MemberCount of hoOverrides to iMax
            Decrement iMax
            For iCount from 0 to iMax
                Move EmptyOverride to Override
                Get MemberNameByIndex of hoOverrides iCount to sKey
                Move sKey to Override.sKey
                Get MemberJsonTypeEnh of hoOverrides sKey to iJsonType
                If (iJsonType = jsonTypeObject) Begin
                    Move True to Override.bIsObject
                    Get MemberEnh of hoOverrides sKey to hoItem
                    Set pbRequireAllMembers of hoItem to False
                    Get MemberValueEnh of hoItem "version" to Override.sVersion
                    Get MemberValueEnh of hoItem "sws"     to Override.sSws
                    Get MemberValueEnh of hoItem "type"    to Override.sType
                    Get MemberValueEnh of hoItem "htmlIncludes" to sVal
                    Move (Lowercase(sVal) = "true") to Override.bHtmlIncludes
                    Get MemberValueEnh of hoItem "cacheCheck"   to sVal
                    Move (Lowercase(sVal) = "true") to Override.bCacheCheck
                    Get MemberValueEnh of hoItem "installFiles" to sVal
                    Move (Lowercase(sVal) = "true") to Override.bInstallFiles
                    Send Destroy of hoItem
                End
                Else Begin
                    Move False to Override.bIsObject
                    Get MemberValueEnh of hoOverrides sKey to Override.sVersion
                End
                Move Override to SwsFile.aOverrides[iCount]
            Loop
            Send Destroy of hoOverrides
        End

        // "projects" — array of strings or {name, testProject} objects.
        Get MemberEnh of hoJson "projects" to hoArray
        If (hoArray <> 0) Begin
            Set pbRequireAllMembers of hoArray to False
            Get MemberCount of hoArray to iMax
            Decrement iMax
            For iCount from 0 to iMax
                Move EmptyProject to Project
                Get MemberJsonTypeEnh of hoArray iCount to iJsonType
                If (iJsonType = jsonTypeObject) Begin
                    Move True to Project.bIsObject
                    Get MemberEnh of hoArray iCount to hoItem
                    Set pbRequireAllMembers of hoItem to False
                    Get MemberValueEnh of hoItem "name" to Project.sName
                    Get MemberValueEnh of hoItem "testProject" to sVal
                    Move (Lowercase(sVal) = "true") to Project.bTestProject
                    Send Destroy of hoItem
                End
                Else Begin
                    Move False to Project.bIsObject
                    Get MemberValueEnh of hoArray iCount to Project.sName
                End
                Move Project to SwsFile.aProjects[iCount]
            Loop
            Send Destroy of hoArray
        End

        // "studio" — DataFlex Studio-specific settings.
        Get MemberEnh of hoJson "studio" to hoStudio
        If (hoStudio <> 0) Begin
            Set pbRequireAllMembers of hoStudio to False
            Get MemberValueEnh of hoStudio "windowsTestProject" to SwsFile.Studio.sWindowsTestProject
            Get MemberValueEnh of hoStudio "defaultFormSpacing" to SwsFile.Studio.iDefaultFormSpacing

            Get MemberValueEnh of hoStudio "tableEditorReadOnly" to sVal
            Move (Lowercase(sVal) = "true") to SwsFile.Studio.bTableEditorReadOnly

            Get MemberValueEnh of hoStudio "hideSystemClasses" to sVal
            Move (Lowercase(sVal) = "true") to SwsFile.Studio.bHideSystemClasses

            // "studio.conditionals" — JSON map of flag-name → boolean.
            Get MemberEnh of hoStudio "conditionals" to hoConds
            If (hoConds <> 0) Begin
                Set pbRequireAllMembers of hoConds to False
                Get MemberCount of hoConds to iMax
                Decrement iMax
                For iCount from 0 to iMax
                    Get MemberNameByIndex of hoConds iCount to Conditional.sName
                    Get MemberValue       of hoConds Conditional.sName to sVal
                    Move (Lowercase(sVal) = "true") to Conditional.bValue
                    Move Conditional to SwsFile.Studio.aConditionals[iCount]
                Loop
                Send Destroy of hoConds
            End

            // "studio.preferredClasses" — JSON map of slot-name → {class, file}.
            // (The slot/name is the KEY; the value object holds class/file.)
            Get MemberEnh of hoStudio "preferredClasses" to hoPrefs
            If (hoPrefs <> 0) Begin
                Set pbRequireAllMembers of hoPrefs to False
                Get MemberCount of hoPrefs to iMax
                Decrement iMax
                For iCount from 0 to iMax
                    Move EmptyPrefClass to PrefClass
                    Get MemberNameByIndex of hoPrefs iCount to PrefClass.sName
                    Get MemberEnh of hoPrefs PrefClass.sName to hoItem
                    If (hoItem <> 0) Begin
                        Set pbRequireAllMembers of hoItem to False
                        Get MemberValueEnh of hoItem "class" to PrefClass.sClass
                        Get MemberValueEnh of hoItem "file"  to PrefClass.sFile
                        Send Destroy of hoItem
                    End
                    Move PrefClass to SwsFile.Studio.aPreferredClasses[iCount]
                Loop
                Send Destroy of hoPrefs
            End

            Send Destroy of hoStudio
        End

        // "package" — package/library distribution metadata.
        Get MemberEnh of hoJson "package" to hoPkg
        If (hoPkg <> 0) Begin
            Set pbRequireAllMembers of hoPkg to False
            Get MemberValueEnh of hoPkg "icon"        to SwsFile.Package.sIcon
            Get MemberValueEnh of hoPkg "license"     to SwsFile.Package.sLicense
            Get MemberValueEnh of hoPkg "licenseFile" to SwsFile.Package.sLicenseFile

            /* "df-min" / "df-max" - the DataFlex releases this package SUPPORTS.

               The package's own statement about its compatibility, and the only honest source for
               one: everything else DFRefactor could look at describes a .sws file, and a package is
               not one. Read as STRINGS even though the JSON holds numbers, for the reason
               SwsFile.sDfVersion is a string - a numeric read goes through the locale's decimal
               separator, and on a machine set to a comma "26.0" does not survive the trip
               ([[feedback_dataflex_locale_decimal_separator]]). */
            Get MemberValueEnh of hoPkg "df-min"      to SwsFile.Package.sDfMin
            Get MemberValueEnh of hoPkg "df-max"      to SwsFile.Package.sDfMax

            // "package.version" — string OR {major, minor, revision} object.
            Get MemberJsonTypeEnh of hoPkg "version" to iJsonType
            If (iJsonType = jsonTypeObject) Begin
                Get MemberEnh of hoPkg "version" to hoVer
                Set pbRequireAllMembers of hoVer to False
                Move 0 to iMajor
                Move 0 to iMinor
                Move 0 to iRev
                Get MemberValueEnh of hoVer "major"    to iMajor
                Get MemberValueEnh of hoVer "minor"    to iMinor
                Get MemberValueEnh of hoVer "revision" to iRev
                Move (String(iMajor) + "." + String(iMinor) + "." + String(iRev)) to SwsFile.Package.sVersion
                Send Destroy of hoVer
            End
            Else Begin
                Get MemberValueEnh of hoPkg "version" to SwsFile.Package.sVersion
            End

            Get ReadJsonStringOrArray hoPkg "includeFiles" to SwsFile.Package.asIncludeFiles
            Get ReadJsonStringOrArray hoPkg "excludeFiles" to SwsFile.Package.asExcludeFiles

            // "package.install" — array of strings or {path} objects.
            Get MemberEnh of hoPkg "install" to hoInstall
            If (hoInstall <> 0) Begin
                Set pbRequireAllMembers of hoInstall to False
                Get MemberCount of hoInstall to iMax
                Decrement iMax
                For iCount from 0 to iMax
                    Move EmptyInstallItem to InstallItem
                    Get MemberJsonTypeEnh of hoInstall iCount to iJsonType
                    If (iJsonType = jsonTypeObject) Begin
                        Move True to InstallItem.bIsObject
                        Get MemberEnh of hoInstall iCount to hoItem
                        Set pbRequireAllMembers of hoItem to False
                        Get MemberValueEnh of hoItem "path" to InstallItem.sPath
                        Send Destroy of hoItem
                    End
                    Else Begin
                        Move False to InstallItem.bIsObject
                        Get MemberValueEnh of hoInstall iCount to InstallItem.sPath
                    End
                    Move InstallItem to SwsFile.Package.aInstall[iCount]
                Loop
                Send Destroy of hoInstall
            End

            // "package.htmlIncludes" — array of strings or
            // {file, type, async, integrity, crossorigin} objects.
            Get MemberEnh of hoPkg "htmlIncludes" to hoIncludes
            If (hoIncludes <> 0) Begin
                Set pbRequireAllMembers of hoIncludes to False
                Get MemberCount of hoIncludes to iMax
                Decrement iMax
                For iCount from 0 to iMax
                    Move EmptyHtmlInc to HtmlInc
                    Get MemberJsonTypeEnh of hoIncludes iCount to iJsonType
                    If (iJsonType = jsonTypeObject) Begin
                        Move True to HtmlInc.bIsObject
                        Get MemberEnh of hoIncludes iCount to hoItem
                        Set pbRequireAllMembers of hoItem to False
                        Get MemberValueEnh of hoItem "file"        to HtmlInc.sFile
                        Get MemberValueEnh of hoItem "type"        to HtmlInc.sType
                        Get MemberValueEnh of hoItem "integrity"   to HtmlInc.sIntegrity
                        Get MemberValueEnh of hoItem "crossorigin" to HtmlInc.sCrossorigin
                        Get MemberValueEnh of hoItem "async" to sVal
                        Move (Lowercase(sVal) = "true") to HtmlInc.bAsync
                        Send Destroy of hoItem
                    End
                    Else Begin
                        Move False to HtmlInc.bIsObject
                        Get MemberValueEnh of hoIncludes iCount to HtmlInc.sFile
                    End
                    Move HtmlInc to SwsFile.Package.aHtmlIncludes[iCount]
                Loop
                Send Destroy of hoIncludes
            End

            Send Destroy of hoPkg
        End

        Send Destroy of hoJson

        // Apply Studio's conventional path defaults for anything the JSON
        // omitted. The DF26 .sws spec lets a workspace skip paths it doesn't
        // override — e.g. FlexTron.sws only sets indexHtml and relies on the
        // documented defaults (https://docs.dataflex.dev/Tools/DfCli/Workspace/)
        // for AppSrc/Programs/Data/etc. Filling them here means both
        // ResolveTargetWorkspacePaths (-> pTargetWS) and CollectSwsSourcePaths
        // (-> DF_OPEN_PATH) see populated values, without each caller having
        // to repeat the default lookup. The folders may or may not exist on
        // disk — that's a separate concern handled by vFilePathExists checks
        // in callers (e.g. ApplyTargetFilelist).
        //
        // Only applied when the parse succeeded (sDfVersion non-empty);
        // failed parses fall through to the INI path and shouldn't be masked.
        If (SwsFile.sDfVersion <> "") Begin
            If (SizeOfArray(SwsFile.Paths.asAppSrc)   = 0) Move "AppSrc"               to SwsFile.Paths.asAppSrc[0]
            If (SizeOfArray(SwsFile.Paths.asDdSrc)    = 0) Move "DDSrc"                to SwsFile.Paths.asDdSrc[0]
            If (SizeOfArray(SwsFile.Paths.asData)     = 0) Move "Data"                 to SwsFile.Paths.asData[0]
            If (SizeOfArray(SwsFile.Paths.asAppHtml)  = 0) Move "AppHtml"              to SwsFile.Paths.asAppHtml[0]
            If (SizeOfArray(SwsFile.Paths.asBitmap)   = 0) Move "Bitmaps"              to SwsFile.Paths.asBitmap[0]
            If (SizeOfArray(SwsFile.Paths.asPrograms) = 0) Move "Programs"             to SwsFile.Paths.asPrograms[0]
            If (SizeOfArray(SwsFile.Paths.asHelp)     = 0) Move "Help"                 to SwsFile.Paths.asHelp[0]
            If (SwsFile.Paths.sFileList      = "") Move "Data\FileList.cfg"      to SwsFile.Paths.sFileList
            If (SwsFile.Paths.sConfigFile    = "") Move "Programs\Config.ws"     to SwsFile.Paths.sConfigFile
            If (SwsFile.Paths.sConnectionIni = "") Move "Data\connection.ini"    to SwsFile.Paths.sConnectionIni
            If (SwsFile.Paths.sIdeSrc        = "") Move "idesrc"                 to SwsFile.Paths.sIdeSrc
        End

        Function_Return SwsFile
    End_Function

    Procedure ToggleWorkspaceMode
    End_Procedure

    Procedure Set pbWorkspaceMode Boolean bState
        Set private.pbWorkspaceMode to bState
        Send ToggleWorkspaceMode
    End_Procedure

    Function pbWorkspaceMode Returns Boolean
        Function_Return (private.pbWorkspaceMode(Self))
    End_Function

    { MethodType=Property }
    Procedure Set psSWSFile String sSWSFile
        String sPath sExt sOldSWSFile
        String[] asFolders

        Get psSWSFile to sOldSWSFile

        Get ParseFolderName sSWSFile to sPath
        Get ParseFileExtension sSWSFile to sExt
        // Has the user selected a ".ws" instead of a ".sws" file?
        // Then we need to adjust the path from "Programs" -> "Home"
        // aka one level up.
        If (Lowercase(sExt) = "ws") Begin
            Move (Left(sPath, Length(sPath) -1)) to sPath
            Get ParseFolderName sPath to sPath
        End
        If (sPath <> "") Begin
            Move (vFolderFormat(sPath)) to sPath
        End
        Set psHomeTarget to sPath

        // Redirect DF_OPEN_PATH to the target workspace's source folders so
        // that Get_File_Path resolves packages there instead of in DFRefactor's
        // own workspace, and refresh the pTargetWS snapshot (which is also
        // where psSWSFile reads its value from). Passing "" restores the
        // original path and empties pTargetWS.
        Send UpdateDFOpenPath sSWSFile

        // The selected-folders list is per workspace (the FolderSel tables are keyed by WorkspaceHomeFolder,
        // and OnWorkspaceLoaded re-keys the folder view to the new workspace). When the workspace actually
        // changes, RE-SYNC the cache from the DB (keyed by the now-current psHomeTarget, via the header DD's
        // alias-based SelectedFolderPathsByHome) rather than just emptying it - so SizeOfArray(pasSelectedFolders)
        // stays in step with TotalSelectedFolders even on load paths (e.g. the dashboard) that never open a
        // folder view. phoFolderSelHeaDD is 0 only very early at startup (before the DDs exist); then asFolders
        // stays empty (the lazy CollectFileData re-read still covers a later run). Guarded on an actual change
        // so redundant same-workspace setter calls (e.g. combo re-display) don't disturb the selection.
        If (Lowercase(Trim(sSWSFile)) <> Lowercase(Trim(sOldSWSFile))) Begin
            If (phoFolderSelHeaDD(Self) <> 0) ;
                Get SelectedFolderPathsByHome of (phoFolderSelHeaDD(Self)) to asFolders
            Set pasSelectedFolders to asFolders
        End
    End_Procedure

    { MethodType=Property }
    Function psSWSFile Returns String
        tWorkspacePaths TargetWS
        Get pTargetWS to TargetWS
        Function_Return TargetWS.sSWSFile
    End_Function

    // Resolves one raw workspace path entry to an absolute path.
    // sHomePath must end with CS_DirSeparator (produced by vFolderFormat).
    // Relative entries like "AppSrc" or ".\AppSrc" are resolved against
    // sHomePath. Returns "" for empty input.
    { Visibility=Private }
    Function ResolveWorkspacePath String sRawPath String sHomePath Returns String
        Move (Trim(sRawPath)) to sRawPath
        If (sRawPath = "") Begin
            Function_Return ""
        End
        If (not(sRawPath contains ":")) Begin
            // Relative path: strip any leading ".\" then prepend workspace home.
            If (Left(sRawPath, 2) = ".\") Begin
                Move (Mid(sRawPath, CI_EOL, 3)) to sRawPath
            End
            Move (sHomePath + sRawPath) to sRawPath
        End
        // DF_OPEN_PATH entries must not have a trailing backslash.
        If (Right(sRawPath, 1) = CS_DirSeparator) Begin
            Move (Left(sRawPath, (Length(sRawPath) - 1))) to sRawPath
        End
        Function_Return sRawPath
    End_Function

    // Appends sPath to sPathList (semicolon-delimited) when not already present.
    // Uses exact matching (avoids false positives such as "C:\A" in "C:\AB").
    { Visibility=Private }
    Function AppendToPathList String sPath String sPathList Returns String
        If (sPath <> "") Begin
            // Appending ";" ensures every entry ends with ";", enabling exact
            // token matching regardless of position in the list.
            If (not((Lowercase(sPathList) + ";") contains (Lowercase(sPath) + ";"))) Begin
                If (sPathList = "") Begin
                    Function_Return sPath
                End
                Function_Return (sPathList + ";" + sPath)
            End
        End
        Function_Return sPathList
    End_Function

    // Merges each individual path from sSrcPaths (semicolon-delimited, already
    // resolved) into sAccum, skipping duplicates. Returns the updated list.
    { Visibility=Private }
    Function MergeIntoPathList String sSrcPaths String sAccum Returns String
        String sPath
        Integer iIdx iCount

        Get CountOfPaths of (phoWorkspace(Self)) sSrcPaths to iCount
        For iIdx from 1 to iCount
            Get PathAtIndex of (phoWorkspace(Self)) sSrcPaths iIdx to sPath
            Get AppendToPathList sPath sAccum to sAccum
        Loop
        Function_Return sAccum
    End_Function

    // Collects AppSrc, DdSrc, and AppHtml paths from a parsed tSwsFile struct,
    // resolving each entry against sHomePath. Returns a semicolon-delimited
    // list of absolute paths (no trailing backslashes).
    { Visibility=Private }
    Function CollectSwsSourcePaths tSwsFile WsData String sHomePath Returns String
        String sResult sPath
        Integer iCount iSize

        Move "" to sResult

        Move (SizeOfArray(WsData.Paths.asAppSrc)) to iSize
        For iCount from 0 to (iSize - 1)
            Get ResolveWorkspacePath WsData.Paths.asAppSrc[iCount] sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Move (SizeOfArray(WsData.Paths.asDdSrc)) to iSize
        For iCount from 0 to (iSize - 1)
            Get ResolveWorkspacePath WsData.Paths.asDdSrc[iCount] sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Move (SizeOfArray(WsData.Paths.asAppHtml)) to iSize
        For iCount from 0 to (iSize - 1)
            Get ResolveWorkspacePath WsData.Paths.asAppHtml[iCount] sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Function_Return sResult
    End_Function

    // Collects AppSrc, DdSrc, and AppHtml paths from an OLD INI-format .sws
    // workspace file (DataFlex 25 and earlier). The .sws is INI and its
    // [Workspace] Filename entry points to a companion .ws config file in
    // Programs\; that .ws holds the semicolon-separated path lists. Returns
    // a semicolon-delimited list of resolved absolute paths, or "" when
    // either file is missing.
    //
    // This helper is also used to read library/package .sws files: per
    // DataFlex 26 the root workspace .sws is JSON, but dependency
    // ("package") .sws files remain in the legacy INI format.
    { Visibility=Private }
    Function CollectIniSwsSourcePaths String sSWSFile String sHomePath Returns String
        String sWsFile sAppSrcRaw sDdSrcRaw sAppHtmlRaw sResult sRaw sPath
        Integer iPathCount iPathIdx
        Handle hoIni
        Boolean bExists

        Move "" to sResult

        Get WsFileNameFromSWSFileName sSWSFile to sWsFile
        Get vFilePathExists sWsFile to bExists
        If (bExists = False) Function_Return sResult

        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni to sWsFile
        Get ReadString of hoIni CS_Workspace CS_AppSrcPath  "" to sAppSrcRaw
        Get ReadString of hoIni CS_Workspace CS_DdSrcPath   "" to sDdSrcRaw
        Get ReadString of hoIni CS_Workspace CS_AppHtmlPath "" to sAppHtmlRaw
        Send Destroy of hoIni

        Get CountOfPaths of (phoWorkspace(Self)) sAppSrcRaw to iPathCount
        For iPathIdx from 1 to iPathCount
            Get PathAtIndex of (phoWorkspace(Self)) sAppSrcRaw iPathIdx to sRaw
            Get ResolveWorkspacePath sRaw sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Get CountOfPaths of (phoWorkspace(Self)) sDdSrcRaw to iPathCount
        For iPathIdx from 1 to iPathCount
            Get PathAtIndex of (phoWorkspace(Self)) sDdSrcRaw iPathIdx to sRaw
            Get ResolveWorkspacePath sRaw sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Get CountOfPaths of (phoWorkspace(Self)) sAppHtmlRaw to iPathCount
        For iPathIdx from 1 to iPathCount
            Get PathAtIndex of (phoWorkspace(Self)) sAppHtmlRaw iPathIdx to sRaw
            Get ResolveWorkspacePath sRaw sHomePath to sPath
            Get AppendToPathList sPath sResult to sResult
        Loop

        Function_Return sResult
    End_Function

    // Collects all source folder paths for the target workspace indicated by
    // sSWSFile, covering AppSrc, DdSrc, and AppHtml, for both:
    //
    //   JSON format (DataFlex 26+):
    //     Reads the parsed .sws struct. Local library/package dependencies
    //     are followed one level deep so their source folders also resolve
    //     via Get_File_Path. Git/cloud references are skipped. Each library
    //     dep may itself be either JSON or legacy INI — DF26 ships package
    //     .sws files in INI even when the root workspace is JSON — so each
    //     dep is tried as JSON first and falls back to INI on parse failure.
    //
    //   Old INI-format .sws workspace (DataFlex 25 and earlier):
    //     The companion .ws config file's AppSrcPath / DdSrcPath / AppHtmlPath
    //     are semicolon-separated lists that already include all library
    //     paths as configured in DataFlex Studio.
    //
    // Returns a semicolon-delimited list of absolute paths with no trailing
    // backslashes, ready to be prepended to DF_OPEN_PATH.
    Function GetTargetWorkspaceSourcePaths String sSWSFile Returns String
        tSwsFile WsData WsLibData
        String sResult sHomePath sDepPath sDepHome sWsFile sLibPaths sPath
        Integer iCount iDepCount
        Boolean bExists

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath
        Move "" to sResult

        // JSON format (DataFlex 26+).
        // ReadSwsJsonFile sets sDfVersion <> "" on successful JSON parse.
        Get ReadSwsJsonFile sSWSFile to WsData
        If (WsData.sDfVersion <> "") Begin
            Get CollectSwsSourcePaths WsData sHomePath to sResult

            // Follow simple (non-git/cloud) local dependencies one level deep.
            Move (SizeOfArray(WsData.aDependencies)) to iDepCount
            Decrement iDepCount
            For iCount from 0 to iDepCount
                If (WsData.aDependencies[iCount].bIsObject = False) Begin
                    Move (Trim(WsData.aDependencies[iCount].sPath)) to sDepPath
                    // Skip cloud/git references (they contain "://").
                    If (sDepPath <> "" and not(sDepPath contains "://")) Begin
                        /* ONE RESOLVER (2026-08-31). This was a second copy of
                           ResolveDependencySwsFile carrying the identical file-form defect -
                           its own "Some references already point to the .sws file" fallback
                           appended ".sws" to a path that already ended in it. Message-style
                           Get, so the callee being further down the file is fine. */
                        Get ResolveDependencySwsFile sDepPath sHomePath to sWsFile
                        Move (sWsFile <> "") to bExists
                        If (bExists) Begin
                            // The library's home is the folder its .sws sits in.
                            Get ParseFolderName sWsFile to sDepHome
                            Move (vFolderFormat(sDepHome)) to sDepHome
                            // Try JSON first; per DF26 most package .sws
                            // files are still legacy INI, so fall back to
                            // INI parsing when JSON doesn't parse.
                            Get ReadSwsJsonFile sWsFile to WsLibData
                            If (WsLibData.sDfVersion <> "") Begin
                                Get CollectSwsSourcePaths WsLibData sDepHome to sLibPaths
                            End
                            Else Begin
                                Get CollectIniSwsSourcePaths sWsFile sDepHome to sLibPaths
                            End
                            Get MergeIntoPathList sLibPaths sResult to sResult
                        End
                    End
                End
            Loop
            Function_Return sResult
        End

        // Old INI-format .sws workspace (DataFlex 25 and earlier).
        Get CollectIniSwsSourcePaths sSWSFile sHomePath to sResult
        Function_Return sResult
    End_Function

    // ----------------------------------------------------------------------
    //  Workspace LIBRARY source-folder discovery.
    //
    //  The Folders tab is filled by recursively scanning the workspace home
    //  (cFolderSelHeaDataDictionary.SaveNewHeaderAndChildRecords ->
    //  AllSourceFolders). A workspace can also reference LIBRARY workspaces
    //  whose source lives OUTSIDE the home and would therefore never be
    //  scanned. These helpers follow those references so the library source
    //  folders can be added as extra scan roots.
    //
    //  Library references come from the .sws:
    //    - JSON .sws (DataFlex 26+): the "aDependencies" list (a local, non
    //      git/cloud dependency sPath is a DIRECTORY holding the library .sws).
    //    - INI  .sws (DataFlex 25-): the [Libraries] section, keys Lib1, Lib2,
    //      ... (1-based; note [Projects] is 0-based) - each value is the path
    //      to the library .sws, relative to the referencing .sws.
    //  The chain is followed transitively (a library may reference libraries);
    //  pasLibVisited guards against circular references.
    //
    //  Two bases matter and they DIFFER for a Studio Library: source paths
    //  (AppSrcPath/DdSrcPath/...) resolve against the library's true HOME, which
    //  its .ws may put ABOVE the .sws folder via [Workspace] Home=..\ (the .sws
    //  sits in a StudioLibrary\ subfolder); but [Libraries] refs resolve against
    //  the .sws folder. Resolved paths can carry embedded "..\" - canonicalize.
    // ----------------------------------------------------------------------

    // Collapses "." and ".." segments in a (drive-letter) absolute path, e.g.
    // "E:\A\B\..\.\C" -> "E:\A\C" and "E:\A\StudioLibrary\..\" -> "E:\A". The
    // leading drive segment is never popped. Returns no trailing backslash.
    // (UNC \\server\share paths are not handled - DFRefactor uses drive paths.)
    { Visibility=Private }
    Function rfCanonicalizePath String sPath Returns String
        String[] asSegs asOut
        String sSeg sResult
        Integer iMax iIdx iOutSize

        Move (Trim(sPath)) to sPath
        If (sPath = "") ;
            Function_Return ""

        Move (StrSplitToArray(sPath, "\")) to asSegs
        Move (SizeOfArray(asSegs)) to iMax
        Decrement iMax
        For iIdx from 0 to iMax
            Move (Trim(asSegs[iIdx])) to sSeg
            If (sSeg = "..") Begin
                Move (SizeOfArray(asOut)) to iOutSize
                If (iOutSize > 1) ;
                    Move (ResizeArray(asOut, iOutSize - 1)) to asOut
            End
            Else If (sSeg <> "" and sSeg <> ".") Begin
                Move sSeg to asOut[SizeOfArray(asOut)]
            End
        Loop

        Move "" to sResult
        Move (SizeOfArray(asOut)) to iMax
        Decrement iMax
        For iIdx from 0 to iMax
            If (iIdx = 0) Begin
                Move asOut[iIdx] to sResult
            End
            Else Begin
                Move (sResult + "\" + asOut[iIdx]) to sResult
            End
        Loop
        Function_Return sResult
    End_Function

    // Returns the true HOME folder of library workspace sLibSWSFile - the base
    // its .ws source paths resolve against. Studio Libraries keep the .sws in a
    // StudioLibrary\ subfolder and set [Workspace] Home=..\ in the .ws, so the
    // home is ABOVE the .sws folder. Falls back to the .sws folder when there is
    // no .ws / no Home entry. Result is vFolderFormat'd (trailing separator).
    { Visibility=Private }
    Function LibraryWorkspaceHome String sLibSWSFile Returns String
        String sSwsFolder sWsFile sWsFolder sHomeRaw sHome
        Handle hoIni
        Boolean bExists

        Get ParseFolderName sLibSWSFile to sSwsFolder
        Move (vFolderFormat(sSwsFolder)) to sSwsFolder

        Get WsFileNameFromSWSFileName sLibSWSFile to sWsFile
        Get vFilePathExists sWsFile to bExists
        If (bExists = False) ;
            Function_Return sSwsFolder

        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni to sWsFile
        Get ReadString of hoIni CS_Workspace CS_Home "" to sHomeRaw
        Send Destroy of hoIni
        Move (Trim(sHomeRaw)) to sHomeRaw

        // No Home entry, or "." / ".\": the home IS the .ws folder.
        If (sHomeRaw = "" or sHomeRaw = "." or sHomeRaw = ".\") ;
            Function_Return sSwsFolder

        // Absolute Home.
        If (sHomeRaw contains ":") Begin
            Get rfCanonicalizePath sHomeRaw to sHome
            Function_Return (vFolderFormat(sHome))
        End

        // Relative Home: resolve against the .ws folder, then canonicalize.
        Get ParseFolderName sWsFile to sWsFolder
        Move (vFolderFormat(sWsFolder)) to sWsFolder
        Get rfCanonicalizePath (sWsFolder + sHomeRaw) to sHome
        Function_Return (vFolderFormat(sHome))
    End_Function

    // Resolves a JSON dependency reference (aDependencies[].sPath, a DIRECTORY)
    // to the library .sws file path. Tries <dir>\<dirname>.sws first, then
    // <dir>.sws. Returns "" when neither exists.
    { Visibility=Private }
    Function ResolveDependencySwsFile String sDepPathRaw String sHomePath Returns String
        String sDepPath sDepHome sName sWsFile sExt
        Boolean bExists

        Get ResolveWorkspacePath sDepPathRaw sHomePath to sDepPath
        /* TWO SHAPES OF DEPENDENCY, and only one of them ever resolved.

           DF26's JSON .sws names the library's .sws FILE:
               "..\WebAppSrc\WebAppSrc-Library-DF260.sws"
           the older form names its FOLDER, with the file found inside as <dir>\<dirname>.sws.
           Both branches below assume the FOLDER form: the first looks inside the path as if it
           were a directory, and the second appends ".sws" to something already ending in it -
           "...DF260.sws.sws". So every file-form dependency resolved to "" and the workspace's
           entire library set vanished, with no error and nothing in the log to see: WinServ
           declares seven dependencies and the harvest returned zero library folders, which is why
           E:\WebAppSrc\AppSrc (152 packages, compiled on every build) was never once offered for
           selection (Nils 2026-08-31). The second resolver in GetTargetWorkspaceSourcePaths had
           the same defect and now calls this. */
        Get ParseFileExtension sDepPathRaw to sExt
        If (Lowercase(Trim(sExt)) = "sws") Begin
            Get vFilePathExists sDepPath to bExists
            If (bExists = True) ;
                Function_Return sDepPath
            Function_Return ""
        End
        Move (vFolderFormat(sDepPath)) to sDepHome
        Get ParseFileName sDepPath to sName
        Move (sDepHome + sName + ".sws") to sWsFile
        Get vFilePathExists sWsFile to bExists
        If (bExists = False) Begin
            Move (sDepPath + ".sws") to sWsFile
            Get vFilePathExists sWsFile to bExists
        End
        If (bExists = False) ;
            Function_Return ""
        Function_Return sWsFile
    End_Function

    // Splits a semicolon-delimited path list and returns asFolders with each
    // non-duplicate (case-insensitive) path appended.
    { Visibility=Private }
    Function AppendPathListToArray String sPathList String[] asFolders Returns String[]
        String sPath sLower
        Integer iCount iIdx iExist iExistMax
        Boolean bFound bExists

        Get CountOfPaths of (phoWorkspace(Self)) sPathList to iCount
        For iIdx from 1 to iCount
            Get PathAtIndex of (phoWorkspace(Self)) sPathList iIdx to sPath
            Move (Trim(sPath)) to sPath
            If (sPath <> "") Begin
                // Collapse any embedded "..\" / "." so stored folders are clean
                // and de-dup compares canonical forms.
                Get rfCanonicalizePath sPath to sPath
                Move (Lowercase(sPath)) to sLower
                Move False to bFound
                Move (SizeOfArray(asFolders)) to iExistMax
                Decrement iExistMax
                For iExist from 0 to iExistMax
                    If (Lowercase(asFolders[iExist]) = sLower) ;
                        Move True to bFound
                Loop
                /* A DECLARED PATH IS NOT A FOLDER THAT EXISTS (Nils 2026-08-31). A workspace can
                   name a source path it does not have: E:\WebAppSrc's config.ws declares
                   DDSrcPath=.\DDSrc and there is no such folder. Adding it created a permanently
                   dead row in the folder selection - Re-scan put it back every time it was deleted,
                   and the workspace-open warning then reported it as "no longer exists on disk"
                   for ever, a loop neither end could break.
                   Discovery offers folders that are really there. The "gone" half of the scope
                   report is for paths the USER selected which have since disappeared - a different
                   question, and still asked. */
                Get rfDirectoryExists sPath to bExists
                If (bFound = False and bExists = True) ;
                    Move sPath to asFolders[SizeOfArray(asFolders)]
            End
        Loop
        Function_Return asFolders
    End_Function

    // True when sSWSFile (case-insensitive) is already in pasLibVisited.
    { Visibility=Private }
    Function IsLibVisited String sSWSFile Returns Boolean
        String[] asVisited
        Get pasLibVisited to asVisited
        Function_Return (SearchArray(Lowercase(Trim(sSWSFile)), asVisited) >= 0)
    End_Function

    // Records sSWSFile (lowercased) in pasLibVisited.
    { Visibility=Private }
    Procedure MarkLibVisited String sSWSFile
        String[] asVisited
        Get pasLibVisited to asVisited
        Move (Lowercase(Trim(sSWSFile))) to asVisited[SizeOfArray(asVisited)]
        Set pasLibVisited to asVisited
    End_Procedure

    // Returns the resolved .sws file paths of the DIRECT library references in
    // sSWSFile. Handles both the JSON aDependencies list (DataFlex 26+) and the
    // INI [Libraries] section (DataFlex 25-). sHomePath resolves relative refs.
    { Visibility=Private }
    Function DirectLibrarySwsFiles String sSWSFile String sHomePath Returns String[]
        String[] asChildSws
        String sChildRaw sChildSws sKey
        Integer iIndex
        Handle hoIni

        tSwsFile WsData
        Integer iDep iDepMax
        // JSON .sws: follow simple (non git/cloud) local dependencies.
        Get ReadSwsJsonFile sSWSFile to WsData
        If (WsData.sDfVersion <> "") Begin
            Move (SizeOfArray(WsData.aDependencies)) to iDepMax
            Decrement iDepMax
            For iDep from 0 to iDepMax
                If (WsData.aDependencies[iDep].bIsObject = False) Begin
                    Move (Trim(WsData.aDependencies[iDep].sPath)) to sChildRaw
                    If (sChildRaw <> "" and not(sChildRaw contains "://")) Begin
                        Get ResolveDependencySwsFile sChildRaw sHomePath to sChildSws
                        If (sChildSws <> "") ;
                            Move sChildSws to asChildSws[SizeOfArray(asChildSws)]
                    End
                End
            Loop
            Function_Return asChildSws
        End

        // INI .sws: [Libraries] Lib0 .. Lib99, one key at a time; a blank key is
        // skipped, not the end of the list.
        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni to sSWSFile
        For iIndex from 0 to 99
            Move (CS_LibraryPrefix + String(iIndex)) to sKey
            Get ReadString of hoIni CS_Libraries sKey "" to sChildRaw
            Move (Trim(sChildRaw)) to sChildRaw
            If (sChildRaw <> "") Begin
                Get ResolveWorkspacePath sChildRaw sHomePath to sChildSws
                Move sChildSws to asChildSws[SizeOfArray(asChildSws)]
            End
        Loop
        Send Destroy of hoIni

        Function_Return asChildSws
    End_Function

    // Recursively walks the library workspace sLibSWSFile: adds its own source
    // folders to pasLibFolders, then recurses into its own library references.
    // The library home is the folder that holds its .sws. pasLibVisited guards
    // against cycles / repeated work.
    { Visibility=Private }
    Procedure CollectLibraryFolders String sLibSWSFile
        String sSwsFolder sLibHome sLibPaths
        String[] asChildSws asFolders
        Integer iChild iChildMax
        Boolean bExists bVisited

        tSwsFile WsLibData

        Move (Trim(sLibSWSFile)) to sLibSWSFile
        If (sLibSWSFile = "") ;
            Procedure_Return
        // Canonicalize first: resolved refs carry embedded "..\", so the cycle
        // guard, config reads and recursion all key off one clean form.
        Get rfCanonicalizePath sLibSWSFile to sLibSWSFile
        Get IsLibVisited sLibSWSFile to bVisited
        If (bVisited = True) ;
            Procedure_Return
        // Mark visited up front so a missing/broken ref is not retried.
        Send MarkLibVisited sLibSWSFile
        Get vFilePathExists sLibSWSFile to bExists
        If (bExists = False) ;
            Procedure_Return

        // The .sws folder ([Libraries] refs are relative to it).
        Get ParseFolderName sLibSWSFile to sSwsFolder
        Move (vFolderFormat(sSwsFolder)) to sSwsFolder

        // This library's own source folders. INI source paths resolve against
        // the TRUE home (its .ws may set Home=..\ above the .sws folder).
        Move "" to sLibPaths
        Get ReadSwsJsonFile sLibSWSFile to WsLibData
        If (WsLibData.sDfVersion <> "") Begin
            Get CollectSwsSourcePaths WsLibData sSwsFolder to sLibPaths
        End
        Else Begin
            Get LibraryWorkspaceHome sLibSWSFile to sLibHome
            Get CollectIniSwsSourcePaths sLibSWSFile sLibHome to sLibPaths
        End

        Get pasLibFolders to asFolders
        Get AppendPathListToArray sLibPaths asFolders to asFolders
        Set pasLibFolders to asFolders

        // Recurse into this library's own library references (.sws-folder based).
        Get DirectLibrarySwsFiles sLibSWSFile sSwsFolder to asChildSws
        Move (SizeOfArray(asChildSws)) to iChildMax
        Decrement iChildMax
        For iChild from 0 to iChildMax
            Send CollectLibraryFolders asChildSws[iChild]
        Loop
    End_Procedure

    // Returns the source folders contributed by the workspace's libraries, by
    // following the .sws library references (JSON aDependencies / INI
    // [Libraries]) transitively. The workspace's OWN folders are NOT included
    // (the caller already scans the home). Resolved absolute folder paths, de-
    // duplicated; circular references are guarded against. Returns an empty
    // array when sSWSFile is missing or references no (resolvable) libraries.
    Function GetWorkspaceLibrarySourceFolders String sSWSFile Returns String[]
        String[] asEmpty asChildSws asFolders
        String sHomePath
        Integer iChild iChildMax
        Boolean bExists

        Set pasLibVisited to asEmpty
        Set pasLibFolders to asEmpty

        Get vFilePathExists sSWSFile to bExists
        If (bExists = False) ;
            Function_Return asEmpty

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath

        // Mark the root workspace visited: its own folders are the caller's
        // home (already scanned), and this stops a library that points back at
        // the root from being re-walked.
        Send MarkLibVisited sSWSFile

        Get DirectLibrarySwsFiles sSWSFile sHomePath to asChildSws
        Move (SizeOfArray(asChildSws)) to iChildMax
        Decrement iChildMax
        For iChild from 0 to iChildMax
            Send CollectLibraryFolders asChildSws[iChild]
        Loop

        Get pasLibFolders to asFolders
        Function_Return asFolders
    End_Function

    // Returns the list of project (.src) file names defined in the given
    // .sws workspace file. Handles both formats:
    //   JSON .sws (DataFlex 26+): aProjects from the parsed struct. Each
    //                             tSwsProject's sName is the .src file name
    //                             regardless of string-vs-object JSON form.
    //   INI  .sws (DataFlex 25-): every Project<n> LINE of [Projects], by slot number,
    //                             each program once - SwsIniProjectsFromLines.
    // Used by the Test Compile dialog to populate its program-picker combo.
    // Returns an empty array if the .sws cannot be read or has no projects.
    Function GetWorkspaceProjects String sSWSFile Returns String[]
        String[] asProjects
        Integer iCount iMax
        Boolean bExists

        tSwsFile WsData

        Get vFilePathExists sSWSFile to bExists
        If (bExists = False) ;
            Function_Return asProjects

        // DF26+: try JSON first. sDfVersion <> "" indicates successful parse.
        Get ReadSwsJsonFile sSWSFile to WsData
        If (WsData.sDfVersion <> "") Begin
            Move (SizeOfArray(WsData.aProjects)) to iMax
            Decrement iMax
            For iCount from 0 to iMax
                If (WsData.aProjects[iCount].sName <> "") ;
                    Move WsData.aProjects[iCount].sName to asProjects[-1]
            Loop
            Function_Return asProjects
        End

        /* INI-format .sws (DF25 and earlier): the [Projects] LINES, never its keys (Nils
           2026-09-11). This read Project0 to Project99 one key at a time, which cannot see two
           lines that share a key - it got one, and the other program was simply not in the list -
           and it stopped at slot 99 without a word. SwsIniProjectsFromLines reads every slot line,
           orders them by slot number, and lists each program once. A global, so nothing is created
           here: the dashboard's program combo fills from this in its OnFill, and an object Create
           inside the WebView2 pump hangs it. */
        Move (SwsIniProjectsFromLines(rfReadEncodedFileAsStringArray(sSWSFile))) to asProjects
        Function_Return asProjects
    End_Function

    /* THE LISTED PROGRAMS THAT ARE ON DISK (Nils 2026-09-23). A .sws can name programs that are
       not there: the file travels with the workspace and its .src files do not always follow - a
       test workspace listed six, of which one existed. Every name went into the Program combo, and
       a pick among them sent the compiler after a file that is not there.

       GetWorkspaceProjects stays the CATALOGUE - what the file says - because the workspace
       conversion checks compare one catalogue with another, and a program must not read as lost
       in the conversion when only its file is missing. This is the catalogue held against the
       disk: each entry is looked for in every declared AppSrc folder, then under the workspace
       home; an entry written with a folder is resolved as written. The names left out are
       available too (WorkspaceProgramsNotOnDisk), so the board can say which they were - a
       program that silently vanishes from a list gets reported as the list losing it.

       NO OBJECT IS CREATED HERE. The combo's OnFill calls this from inside the WebView2 pump,
       where a Create hangs, so the parsed workspace is read through the pCurrentSws property -
       filled when the workspace was opened - and not through the refreshing accessors. For a
       file that is not the open workspace the declared folders are unknown here, and AppSrc
       beside it is the one folder tried. */
    Function _WorkspaceProgramsSplit String sSWSFile Boolean bOnDisk Returns String[]
        String[] asProjects asOut asFolders
        String sName sHome sFolder
        tSwsFile Sws
        Integer i iMax j jMax iPos
        Boolean bFound

        Get GetWorkspaceProjects sSWSFile to asProjects
        If (Lowercase(Trim(sSWSFile)) = Lowercase(Trim(psSWSFile(Self)))) Begin
            Get pCurrentSws to Sws
            Move Sws.Paths.asAppSrc to asFolders
            Move Sws.RuntimePaths.sHome to sHome
        End
        If (sHome = "") Begin
            Move (RightPos("\", sSWSFile)) to iPos
            If (iPos > 1) ;
                Move (Left(sSWSFile, (iPos - 1))) to sHome
        End
        If (SizeOfArray(asFolders) = 0) ;
            Move "AppSrc" to asFolders[0]
        Move (SizeOfArray(asProjects) - 1) to iMax
        Move (SizeOfArray(asFolders) - 1) to jMax
        For i from 0 to iMax
            Move (Trim(asProjects[i])) to sName
            Move False to bFound
            If ((sName contains "\") or (sName contains "/")) Begin
                // Written with a folder: resolved as written, against the home when relative.
                Move (vFilePathExists(ResolveWorkspacePath(Self, Replaces("/", sName, "\"), vFolderFormat(sHome))) <> 0) to bFound
            End
            Else If (sName <> "") Begin
                For j from 0 to jMax
                    If (bFound = False) Begin
                        Get _ResolvedFolder asFolders[j] sHome to sFolder
                        If (sFolder <> "") ;
                            Move (vFilePathExists(vFolderFormat(sFolder) + sName) <> 0) to bFound
                    End
                Loop
                If (bFound = False and sHome <> "") ;
                    Move (vFilePathExists(vFolderFormat(sHome) + sName) <> 0) to bFound
            End
            If (bFound = bOnDisk) ;
                Move asProjects[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    Function WorkspaceProgramsOnDisk String sSWSFile Returns String[]
        Function_Return (_WorkspaceProgramsSplit(Self, sSWSFile, True))
    End_Function

    // The listed programs whose file is NOT on disk - what the Program combo left out, by name.
    Function WorkspaceProgramsNotOnDisk String sSWSFile Returns String[]
        Function_Return (_WorkspaceProgramsSplit(Self, sSWSFile, False))
    End_Function

    // ======================================================================================
    // Guided-flow redesign foundation (Nils 2026-07-20, branch guided-flow-redesign):
    //   The new trail's STEP 1 anchor = a "main program" + a "whole workspace" scope. These are the
    //   two accessors the anchor UI (and the rest of the redesign) builds on, so the concepts have a
    //   clean single home instead of every caller reaching into the raw INI key / re-deriving folders.
    // ======================================================================================

    // The workspace's MAIN PROGRAM - the .src the trail compiles and anchors on. Persisted per
    // workspace under CS_LastCompileKeyPrefix, the SAME key StartCompile (TestCompileFT) reads, so the
    // anchor and the compile step share ONE source of truth - no second setting to drift. (The Test
    // Compile bar's own program combo was retired for this reason.) "" when none has been picked yet
    // (or no workspace loaded). The value is verbatim a GetWorkspaceProjects entry.
    Function MainProgram Returns String
        String sSWS sProgram
        Get psSWSFile to sSWS
        If (sSWS = "") ;
            Function_Return ""
        Get ReadString CS_Settings (CS_LastCompileKeyPrefix + sSWS) "" to sProgram
        Function_Return sProgram
    End_Function

    /* FUNCTIONS THE TOOL MUST NEVER PICK FOR THE USER (Nils 2026-09-23: "the user should be able
       to select functions that never should be selected for e.g. auto-fixable - as it is now, the
       user needs to untick those functions each and every time"). The character-mode work showed
       why a fixed gate is not enough: which converters a workspace can take is the USER'S call -
       Local and Chain for a 3.x compiler today, whatever the next workspace cannot take tomorrow.

       What the list means: the tool never TICKS the function for the user - not a plan's
       pre-tick (oRefactorPlanDialogFT), not Select All (cRDCDbCJGrid.IsSelectableItem) - and its
       findings sit in the Review band, listed in the plan unticked (DashboardFT._BuildFindingRow).
       The user's own tick still runs it; this is a default, not a block.

       A per-user SETTING, not a Functions-table field: a new field is a DUF schema step and the
       separate updater for every alpha tester, and the list is a handful of names. Joined by ';'
       under CS_NeverPickFunctions; memoised for the session, refreshed by every write. Set from
       the Select Functions grid (the row's right-click menu, shown in its "Never pick" column). */
    Function NeverPickFunctions Returns String[]
        String[] asOut asNone
        String sList

        If (pbNeverPickLoaded(Self) = False) Begin
            Get ReadString CS_Settings CS_NeverPickFunctions "" to sList
            If (Trim(sList) <> "") ;
                Move (StrSplitToArray(Trim(sList), ";")) to asOut
            Set pasNeverPickCache to asOut
            Set pbNeverPickLoaded to True
        End
        Get pasNeverPickCache to asOut
        Function_Return asOut
    End_Function

    // Case-blind: function names are DataFlex symbols.
    Function IsNeverPickFunction String sFn Returns Boolean
        String[] asList

        Move (Trim(sFn)) to sFn
        If (sFn = "") ;
            Function_Return False
        Get NeverPickFunctions to asList
        Function_Return (SearchArray(sFn, asList, Desktop, RefFunc(DFSTRICMP)) <> -1)
    End_Function

    // asNames without the listed ones; order kept.
    Function NeverPickFiltered String[] asNames Returns String[]
        String[] asOut
        Integer i iMax

        Move (SizeOfArray(asNames) - 1) to iMax
        For i from 0 to iMax
            If (IsNeverPickFunction(Self, asNames[i]) = False) ;
                Move asNames[i] to asOut[SizeOfArray(asOut)]
        Loop
        Function_Return asOut
    End_Function

    // Put sFn on the list (bNever True) or take it off. Written at once; the memo follows.
    Procedure SetNeverPickFunction String sFn Boolean bNever
        String[] asList asNew
        Integer i iMax

        Move (Trim(sFn)) to sFn
        If (sFn = "") ;
            Procedure_Return
        Get NeverPickFunctions to asList
        Move (SizeOfArray(asList) - 1) to iMax
        For i from 0 to iMax
            If (Trim(asList[i]) <> "" and Lowercase(Trim(asList[i])) <> Lowercase(sFn)) ;
                Move (Trim(asList[i])) to asNew[SizeOfArray(asNew)]
        Loop
        If (bNever = True) ;
            Move sFn to asNew[SizeOfArray(asNew)]
        Send WriteString CS_Settings CS_NeverPickFunctions (StrJoinFromArray(asNew, ";"))
        Set pasNeverPickCache to asNew
        Set pbNeverPickLoaded to True
    End_Procedure

    /* IS THE MAIN PROGRAM A CHARACTER-MODE PROGRAM (Nils 2026-09-20)? Its .src, read on each ask,
       against the funclib's pure skeleton test: Use UI and no Windows base. The path is the
       .sws project entry under the target's AppSrc (where the compile runs), else under Home.
       False when no program is picked or its file cannot be found - "not character mode" is then
       only "nothing says so", and the Check compiles as it always has. */
    Function MainProgramIsCharacterMode Returns Boolean
        tWorkspacePaths WS
        String sProgram sPath
        String[] asLines
        Boolean bExists bChar

        Get MainProgram to sProgram
        If (Trim(sProgram) = "") ;
            Function_Return False
        Get pTargetWS to WS
        Move (vFolderFormat(WS.sAppSrc) + sProgram) to sPath
        Get vFilePathExists sPath to bExists
        If (bExists = False) Begin
            Move (vFolderFormat(WS.sHome) + sProgram) to sPath
            Get vFilePathExists sPath to bExists
        End
        If (bExists = False) ;
            Function_Return False
        Move (rfReadEncodedFileAsStringArray(sPath)) to asLines
        Get _IsCharacterModeSkeleton of ghoFuncLib asLines to bChar
        Function_Return bChar
    End_Function

    /* WHICH PROGRAMS COMPILE sFullPath - read from each workspace project's compile listing (the
       "Including file:" lines), the one record of what a build actually read.

       Backs the FlexCOM halt, narrowed 2026-09-03 (Nils, LegacyApp): CleanCash_1_0.pkg, a 2009
       FlexCOM proxy that no program in the workspace builds - in no listing, its wrapper named
       by no .src - halted the whole workspace. A proxy nobody compiles is dead code to retire,
       not a reason to refuse every run.

       A program never built here has no listing and cannot vouch either way; that reads as "not
       compiled", which is accepted - the board's DS 9220 row still names the file. A STALE listing
       errs towards halting, the safe side. Read only when a candidate has been found, so the cost
       of opening every listing is paid rarely. */
    Function ProgramsCompilingFile String sFullPath Returns String[]
        String[] asProjects asIncluded asOut
        String sSws sPrn sWant
        tSwsFile WS
        Integer i iMax j jMax

        Get psSWSFile to sSws
        If (sSws = "" or Trim(sFullPath) = "") ;
            Function_Return asOut
        Move (Lowercase(Trim(sFullPath))) to sWant
        Get pCurrentSws to WS
        Get GetWorkspaceProjects sSws to asProjects
        Move (SizeOfArray(asProjects) - 1) to iMax
        For i from 0 to iMax
            Get ResolveCompiledFile asProjects[i] WS "prn" to sPrn
            If (sPrn <> "") Begin
                Move (rfPrnIncludedFiles(sPrn)) to asIncluded
                Move (SizeOfArray(asIncluded) - 1) to jMax
                For j from 0 to jMax
                    If (Lowercase(Trim(asIncluded[j])) = sWant) Begin
                        Move asProjects[i] to asOut[SizeOfArray(asOut)]
                        Move jMax to j
                    End
                Loop
            End
        Loop
        Function_Return asOut
    End_Function

    // Set (persist) the workspace's main program. No-op without a loaded workspace. Writing the same
    // key the compile combo uses keeps the two in lockstep - a change here shows in the combo and back.
    Procedure SetMainProgram String sProgram
        String sSWS
        Get psSWSFile to sSWS
        If (sSWS = "") ;
            Procedure_Return
        Send WriteString CS_Settings (CS_LastCompileKeyPrefix + sSWS) sProgram
    End_Procedure

    // The "WHOLE WORKSPACE" source scope the trail defaults to: the target workspace's AppSrc + DDSrc,
    // plus every library source folder, each expanded to itself and ALL its subfolders. This is the
    // set the anchor auto-selects ONCE (set-once), and what "Reset to whole workspace" returns to.
    // Composes the same roots ResolveSourceFileInTree gathers, through AllSourceFolders (recursive,
    // honouring the NoFolderList exclusions). Read-only folder walk; empty when no workspace is loaded.
    /* The workspace's source ROOTS: every declared AppSrc and DdSrc folder, plus every library
       source folder. Shared by the two callers that need them - the default refactoring scope and
       the compiler-output double-click resolver - which carried identical copies of this and would
       have had to be fixed twice.

       EVERY declared folder, not the first. tWorkspacePaths held one String per key and was filled
       with the first entry only, so a workspace declaring "AppSrcPath=.\AppSrc;.\Shared" had half
       its source outside the default scope, silently. CurrentSwsFolders returns the whole array
       from the one parse done at workspace open.

       The pTargetWS fallback stays for now: it is the behaviour that has been shipping, and this is
       a migration rather than a rewrite. It only engages when the parse yields nothing, which
       should not happen for either format - if it ever does, the old answer is still better than an
       empty scope. */
    Function WorkspaceSourceRoots Returns String[]
        String sSWS
        String[] asRoots asFolders asLibs
        tWorkspacePaths WS
        Integer i iMax

        Get CurrentSwsFolders "appsrc" to asFolders
        Move (SizeOfArray(asFolders) - 1) to iMax
        For i from 0 to iMax
            If (asFolders[i] <> "") ;
                Move asFolders[i] to asRoots[-1]
        Loop
        Get CurrentSwsFolders "ddsrc" to asFolders
        Move (SizeOfArray(asFolders) - 1) to iMax
        For i from 0 to iMax
            If (asFolders[i] <> "") ;
                Move asFolders[i] to asRoots[-1]
        Loop

        If (SizeOfArray(asRoots) = 0) Begin
            Get pTargetWS to WS
            If (WS.sAppSrc <> "") ;
                Move WS.sAppSrc to asRoots[-1]
            If (WS.sDDSrc <> "") ;
                Move WS.sDDSrc to asRoots[-1]
        End

        Get psSWSFile to sSWS
        Get GetWorkspaceLibrarySourceFolders sSWS to asLibs
        Move (SizeOfArray(asLibs) - 1) to iMax
        For i from 0 to iMax
            Move asLibs[i] to asRoots[-1]
        Loop
        Function_Return asRoots
    End_Function

    Function WholeWorkspaceSourceFolders Returns String[]
        String[] asRoots asAll
        Get WorkspaceSourceRoots to asRoots
        If (SizeOfArray(asRoots) = 0) ;
            Function_Return asRoots
        Get AllSourceFolders asRoots to asAll
        Function_Return asAll
    End_Function

    // Resolves the target workspace's filelist.cfg path from its .sws/.ws.
    //   JSON .sws (DataFlex 26+): paths.fileList from the parsed struct.
    //   Old INI .ws (DataFlex 25-): [Workspace] Filelist from the config .ws.
    // Returns "" if it cannot be resolved or the file does not exist.
    { Visibility=Private }
    Function GetTargetWorkspaceFilelistPath String sSWSFile Returns String
        tSwsFile WsData
        String sHomePath sRaw sFileList sWsFile
        Handle hoIni
        Boolean bExists

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath
        Move "" to sRaw

        // JSON format (DataFlex 26+).
        Get ReadSwsJsonFile sSWSFile to WsData
        If (WsData.sDfVersion <> "") Begin
            Move WsData.Paths.sFileList to sRaw
        End

        If (sRaw = "") Begin
            // Old INI-format .ws workspace (DataFlex 25 and earlier).
            Get WsFileNameFromSWSFileName sSWSFile to sWsFile
            Get vFilePathExists sWsFile to bExists
            If (bExists) Begin
                Get Create (RefClass(cIniFile)) to hoIni
                Set psFilename of hoIni to sWsFile
                Get ReadString of hoIni CS_Workspace CS_FileList "" to sRaw
                Send Destroy of hoIni
            End
        End

        If (sRaw = "") Begin
            Function_Return ""
        End

        Get ResolveWorkspacePath sRaw sHomePath to sFileList
        Get vFilePathExists sFileList to bExists
        If (bExists = False) Begin
            Function_Return ""
        End
        Function_Return sFileList
    End_Function

    /*  WARNING - KEEP THE REDIRECT WINDOW AS SHORT AS POSSIBLE.
      
        ApplyTargetFilelist redirects the PROCESS-WIDE DataFlex filelist
        (DF_FILELIST_NAME plus the workspace psFileList/psDataPath) to the
        user-selected target workspace. While it is active, DFRefactor's OWN
        database (SysFile/Functions/FunctionsA/StatLog) and its error logging
        are unsafe: any runtime Error raised during the redirect is logged
        through the wrong filelist and is lost or cascades. 
      
        RULE for any future caller: bracket ONLY the minimal, error-free
        metadata work (e.g. a single Get_Attribute DF_FILE_* enumeration),
        capture what you need into your own array, then call
        RestoreActiveFilelist IMMEDIATELY - before ANY processing that can
        raise an error or do DFRefactor's own DB I/O. Never wrap a whole
        refactor run. (The engine also calls RestoreActiveFilelist
        defensively as a safety net, but callers must not rely on that.)
      
        No Close DF_ALL is done (the engine holds an open Constrained_Find
        over FunctionsA), so target-workspace file state can leak across runs
        when the window is wide - another reason to keep it tiny.
        ===================================================================
       
        Function activates the target workspace's filelist so the Get_Attribute
        DF_FILE_* enumeration sees that workspace's tables. Returns True when
        applied; the caller MUST then call RestoreActiveFilelist.
    */
    Function ApplyTargetFilelist String sSWSFile Returns Boolean
        String sFileList sDataPath

        Get GetTargetWorkspaceFilelistPath sSWSFile to sFileList
        If (sFileList = "") Begin
            Function_Return False
        End
        Get ParseFolderName sFileList to sDataPath
        If (Right(sDataPath, 1) = CS_DirSeparator) Begin
            Move (Left(sDataPath, (Length(sDataPath) - 1))) to sDataPath
        End
        Set psDataPath of (phoWorkspace(Self)) to sDataPath
        Set psFileList of (phoWorkspace(Self)) to sFileList
        Set_Attribute DF_FILELIST_NAME to sFileList
        Function_Return True
    End_Function

    // Restores DFRefactor's own active filelist captured at
    // End_Construct_Object. Pairs with ApplyTargetFilelist - call this
    // IMMEDIATELY after the minimal redirected work (see the WARNING above
    // ApplyTargetFilelist). Idempotent: a no-op when nothing was swapped, so
    // it is safe to call defensively/unconditionally.
    Procedure RestoreActiveFilelist
        tWorkspacePaths OrgWS

        Get pOrgWS to OrgWS
        If (OrgWS.sFilelistName <> "") Begin
            Set psDataPath of (phoWorkspace(Self)) to OrgWS.sData
            Set psFileList of (phoWorkspace(Self)) to OrgWS.sFileList
            Set_Attribute DF_FILELIST_NAME to OrgWS.sFilelistName
        End
    End_Procedure

    // Parses the target workspace's .sws/.ws and returns a snapshot of its
    // resolved (absolute) paths. Used by UpdateDFOpenPath to populate the
    // pTargetWS property. Differs from GetTargetWorkspaceSourcePaths in that
    // it does NOT fold library/dependency paths in - each member is the
    // FIRST resolved path of the workspace itself, suitable for "where does
    // the target's AppSrc / Data / FileList live" lookups.
    //
    // Library/dependency source folders still reach Get_File_Path via the
    // composite DF_OPEN_PATH that UpdateDFOpenPath installs.
    //
    // sOpenPath is stored verbatim into the returned struct's sOpenPath
    // field (the composite DF_OPEN_PATH value UpdateDFOpenPath is about to
    // install). All members are "" when sSWSFile = "" or the file is missing.
    { Visibility=Private }
    Function ResolveTargetWorkspacePaths String sSWSFile String sOpenPath Returns tWorkspacePaths
        tWorkspacePaths TargetWS
        String sHomePath sWsFile sRaw sPath
        Handle hoIni
        Boolean bExists

        tSwsFile WsData

        If (sSWSFile = "") Begin
            Function_Return TargetWS
        End

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath
        // Remember the user's selection even if the .sws is missing or
        // unparseable - matches the previous private.psSWSFile behaviour.
        Move sSWSFile   to TargetWS.sSWSFile
        Move sHomePath  to TargetWS.sHome
        Move sOpenPath  to TargetWS.sOpenPath

        Get vFilePathExists sSWSFile to bExists
        If (bExists = False) Begin
            Function_Return TargetWS
        End

        // JSON .sws (DataFlex 26+). sDfVersion <> "" on successful parse.
        Get ReadSwsJsonFile sSWSFile to WsData
        If (WsData.sDfVersion <> "") Begin
            Move WsData.sDfVersion to TargetWS.sDfVersion
            If (SizeOfArray(WsData.Paths.asAppSrc) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asAppSrc[0] sHomePath to TargetWS.sAppSrc
            End
            If (SizeOfArray(WsData.Paths.asDdSrc) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asDdSrc[0]  sHomePath to TargetWS.sDDSrc
            End
            If (SizeOfArray(WsData.Paths.asData) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asData[0]   sHomePath to TargetWS.sData
            End
            If (SizeOfArray(WsData.Paths.asAppHtml) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asAppHtml[0]  sHomePath to TargetWS.sAppHtml
            End
            If (SizeOfArray(WsData.Paths.asBitmap) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asBitmap[0]   sHomePath to TargetWS.sBitmaps
            End
            If (SizeOfArray(WsData.Paths.asPrograms) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asPrograms[0] sHomePath to TargetWS.sPrograms
            End
            If (SizeOfArray(WsData.Paths.asHelp) > 0) Begin
                Get ResolveWorkspacePath WsData.Paths.asHelp[0]     sHomePath to TargetWS.sHelp
            End
            Get ResolveWorkspacePath WsData.Paths.sFileList   sHomePath to TargetWS.sFileList
            Get ResolveWorkspacePath WsData.Paths.sConfigFile sHomePath to TargetWS.sWSFile
            Move TargetWS.sFileList to TargetWS.sFilelistName
            Function_Return TargetWS
        End

        // TARGET DataFlex version for an INI-format .sws (DataFlex 25 and earlier). Every .sws carries a
        // version - the Studio refuses to open one without it - but until now only the JSON branch above
        // filled sDfVersion, so every legacy workspace (i.e. essentially every migration candidate, e.g. a
        // 19.1 app) reported NO target version at all. Mirrors the own-workspace read in the pOrgWS capture.
        // Two placement details: the version lives in the .sws [Properties], NOT in the .ws config file read
        // below; and this runs BEFORE the .ws existence check, so a missing .ws cannot cost us the version.
        // Guarded on "" so a successful JSON parse above always wins. Feeds the compiler/workspace
        // version-mismatch pre-flight (BuildCompileCommand -> MajorVersionFromVersionString), which until now
        // silently no-opped for legacy targets. Nils 2026-07-20.
        If (TargetWS.sDfVersion = "") Begin
            Get Create (RefClass(cIniFile)) to hoIni
            Set psFilename of hoIni to sSWSFile
            Get ReadString of hoIni CS_PropertiesKeyWord CS_VersionKeyWord "" to TargetWS.sDfVersion
            Send Destroy of hoIni
        End

        // Old INI-format .ws workspace (DataFlex 25 and earlier). Path
        // values may be semicolon-separated lists - take the first entry.
        Get WsFileNameFromSWSFileName sSWSFile to sWsFile
        Move sWsFile to TargetWS.sWSFile
        Get vFilePathExists sWsFile to bExists
        If (bExists = False) Begin
            Function_Return TargetWS
        End

        Get Create (RefClass(cIniFile)) to hoIni
        Set psFilename of hoIni to sWsFile

        Get ReadString of hoIni CS_Workspace CS_AppSrcPath  "" to sRaw
        Get PathAtIndex of (phoWorkspace(Self)) sRaw 1       to sPath
        Get ResolveWorkspacePath sPath sHomePath to TargetWS.sAppSrc

        Get ReadString of hoIni CS_Workspace CS_DdSrcPath   "" to sRaw
        Get PathAtIndex of (phoWorkspace(Self)) sRaw 1       to sPath
        Get ResolveWorkspacePath sPath sHomePath to TargetWS.sDDSrc

        Get ReadString of hoIni CS_Workspace CS_AppHtmlPath "" to sRaw
        Get PathAtIndex of (phoWorkspace(Self)) sRaw 1       to sPath
        Get ResolveWorkspacePath sPath sHomePath to TargetWS.sAppHtml

        Get ReadString of hoIni CS_Workspace CS_BitmapPath  "" to sRaw
        Get ResolveWorkspacePath sRaw sHomePath to TargetWS.sBitmaps

        Get ReadString of hoIni CS_Workspace "ProgramPath"  "" to sRaw
        Get ResolveWorkspacePath sRaw sHomePath to TargetWS.sPrograms

        Get ReadString of hoIni CS_Workspace "DataPath"     "" to sRaw
        Get ResolveWorkspacePath sRaw sHomePath to TargetWS.sData

        Get ReadString of hoIni CS_Workspace "HelpPath"     "" to sRaw
        Get ResolveWorkspacePath sRaw sHomePath to TargetWS.sHelp

        Get ReadString of hoIni CS_Workspace CS_FileList    "" to sRaw
        Get ResolveWorkspacePath sRaw sHomePath to TargetWS.sFileList
        Move TargetWS.sFileList to TargetWS.sFilelistName

        Send Destroy of hoIni
        Function_Return TargetWS
    End_Function

    // Updates DF_OPEN_PATH whenever a target workspace is opened or closed,
    // and refreshes the pTargetWS path snapshot in the same step.
    // Called automatically from Set psSWSFile on every workspace change.
    //
    // Passing sSWSFile = "" restores DFRefactor's original DF_OPEN_PATH and
    // empties pTargetWS. All refactoring functions that use Get_File_Path
    // benefit automatically without any per-function path management.
    Procedure UpdateDFOpenPath String sSWSFile
        String sNewPaths sOpenPath
        tWorkspacePaths OrgWS TargetWS

        Get pOrgWS to OrgWS
        /* TOO EARLY - REMEMBER IT, do not just drop it (Nils 2026-08-03).

           pOrgWS is captured at the END of End_Construct_Object, but the command line is
           parsed BEFORE that, so a /bm run's `Set psSWSFile` lands here first and used to
           return having done nothing. pTargetWS therefore stayed empty - and since
           `Get psSWSFile` READS pTargetWS.sSWSFile, the workspace silently vanished for the
           whole run even though the INI named it correctly.

           That is why EVERY batch run's log is missing its "SWS File:" line, and why
           RestyleDDOs handed a blank name to cIniFile and errored. It is not specific to
           this workspace or to spaces in its path - it is every headless run.

           The pending name is re-applied at the end of End_Construct_Object, as soon as
           pOrgWS exists. */
        If (OrgWS.sOpenPath = "") Begin
            Set psPendingTargetSWS to sSWSFile
            Procedure_Return
        End

        If (sSWSFile = "") Begin
            // Workspace closed — restore DFRefactor's own paths.
            Set_Attribute DF_OPEN_PATH to OrgWS.sOpenPath
            // Reset the target snapshot; empty TargetWS = no target selected.
            Set pTargetWS to TargetWS
            Procedure_Return
        End

        Get GetTargetWorkspaceSourcePaths sSWSFile to sNewPaths
        If (sNewPaths <> "") Begin
            // Prepend target workspace paths; retain DFRefactor's own and
            // DataFlex system paths as a fallback.
            Move (sNewPaths + ";" + OrgWS.sOpenPath) to sOpenPath
            Set_Attribute DF_OPEN_PATH to sOpenPath
        End
        Else Begin
            // No target paths found; DF_OPEN_PATH stays as-is. Capture the
            // current value so the struct reflects what Get_File_Path sees.
            Get_Attribute DF_OPEN_PATH to sOpenPath
        End

        Get ResolveTargetWorkspacePaths sSWSFile sOpenPath to TargetWS
        Set pTargetWS to TargetWS
    End_Procedure

    { MethodType=Property }
    Function psWorkspaceHomePath Returns String
        String sPath 
        Get psHomeTarget to sPath
        Function_Return sPath
    End_Function

    // Add a directory separator if it is not present.
    // Example sFoldername = "x:\FolderA". The function returns "x:\FolderA\"
    Function AddFolderSeperator String sFolderName Returns String
        String sDirSep
        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sDirSep
        Move (Trim(sFolderName)) to sFolderName
        If (Right(sFolderName, 1) <> sDirSep) Begin
            Move (sFolderName + sDirSep) to sFolderName
        End
        Function_Return sFolderName
    End_Function

    // Removes a directory separator if it is present.
    // Example sFoldername = "x:\FolderA\". The function returns "x:\FolderA"
    Function RemoveFolderSeperator String sFolderName Returns String
        String sDirSep
        Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sDirSep
        Move (Trim(sFolderName)) to sFolderName
        If (Right(sFolderName, 1) = sDirSep) Begin
            Move (Left(sFolderName, Length(sFolderName) - 1)) to sFolderName
        End
        Function_Return sFolderName
    End_Function

    // Returns sFile's folder path RELATIVE to the workspace home (psHomeTarget),
    // i.e. just the sub-folder structure (e.g. "appsrc\"). Returns "" when
    // sFile is blank or sits directly in the workspace root. Shared by the
    // DFRefactor_Backup logic and the UnusedSourceFiles quarantine .bat
    // so both mirror the original folder structure identically.
    Function WorkspaceRelativeSubfolder String sFile Returns String
        String sPath sHomePath
        Integer iPos

        Move "" to sPath
        If (sFile = "") Begin
            Function_Return sPath
        End
        Get psHomeTarget to sHomePath
        Get ParseFolderName sFile to sPath
        Move (Replace(Lowercase(sHomePath), Lowercase(sPath), "")) to sPath // Only want the subfolder structure
        Move (Pos(":", sPath)) to iPos
        If (iPos > 0) Begin
            Move (Mid(sPath, CI_EOL, (iPos + 1))) to sPath
            Move (Pos(CS_DirSeparator, sPath)) to iPos
            If (iPos > 0) Begin
                Move (Mid(sPath, CI_EOL, (iPos + 1))) to sPath
            End
        End
        Function_Return sPath
    End_Function

    // Backup mirror of a file's location: its full folder path with the drive
    // colon turned into a folder, so files on ANY root - including library files
    // OUTSIDE the workspace home - map 1:1 into the backup tree and round-trip on
    // restore. E.g. "E:\WebAppSrc\otherdev\VdfWebTools\" -> "E\WebAppSrc\otherdev\VdfWebTools\".
    //
    // Replaces the old home-relative backup scheme (WorkspaceRelativeSubfolder),
    // which silently mis-mapped a file on a different root than the home: the home
    // prefix wasn't found, so the backup was stored as if home-relative and could
    // never be restored to its real path. The reverse mapping is in BackupFiles.dg
    // (MoveBackBackupFiles). NOTE: this changes the backup-tree layout, so any
    // pre-existing Backup folder from the old scheme should be cleared.
    Function BackupSubfolderForFile String sFile Returns String
        String sPath
        Move "" to sPath
        If (sFile = "") ;
            Function_Return sPath
        Get ParseFolderName sFile to sPath
        Move (Replace(":", sPath, "")) to sPath
        Function_Return sPath
    End_Function

    // Will create a backup-folder for the passed file, if-and-only-if it doesn't exists.
    // Returns the full path to the backup folder.
    Function CreateBackupFolder String sFile Returns String
        String sPath sHomePath sBackupFolder
        Boolean bFolderExists bSuccess
        Integer iRetval

        Get psHomeTarget to sHomePath
        Get BackupSubfolderForFile sFile to sPath

        Move (sHomePath + CS_BackupFolder + CS_DirSeparator + sPath) to sBackupFolder
        Get RemoveFolderSeperator sBackupFolder to sBackupFolder
        Move (vFolderExists(sBackupFolder)) to bFolderExists
        If (bFolderExists = False) Begin
            Move (rfDirectoryCreateEx(sBackupFolder, False)) to bSuccess
            If (bSuccess = False) Begin
                Get YesNo_Box ("Warning! The" * String(sHomePath) + "\DFRefactor Backup folder could not be created. You should abort the program now, fix the cause and restart. Abort the program?") to iRetval
                If (iRetval = MBR_Yes) Begin
                    Send Exit_Application
                End
            End
        End
        Move (vFolderFormat(sBackupFolder)) to sBackupFolder
        Function_Return sBackupFolder
    End_Function

    Function IsBackupFolder Returns Boolean
        String sHomePath sBackupFolder
        Boolean bExists

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath
        Move (sHomePath + CS_BackupFolder) to sBackupFolder
        Move (vFolderExists(sBackupFolder)) to bExists

        Function_Return bExists
    End_Function

    // Takes a source file name with full path as parameter.
    // Returns a name with full path for it's backup file counterpart.
    // If the backup folder doesn't exist, it will be created, aka
    // the BackupFolder function is used.
    Function CreateBackupFileName String sPathFileName Returns String
        String sBackupFolder sFileName sBackupFile
        Integer iPos

        Get CreateBackupFolder sPathFileName   to sBackupFolder
        Move (vFolderFormat(sBackupFolder)) to sBackupFolder
        Get ParseFileName sPathFileName  to sFileName
        Move (Pos(":", sFileName))       to iPos
        If (iPos > 0) Begin
            Move (Mid(sFileName, CI_EOL, iPos)) to sFileName
        End
        Move (sBackupFolder + sFileName) to sBackupFile

        Function_Return sBackupFile
    End_Function

    Function HomeBackupFilePath Returns String
        Boolean bExist
        String sPath sPathBackup

        Get psHomeTarget to sPath
        If (sPath <> "") Begin
            Move (vFolderFormat(sPath)) to sPath
            Move (sPath + CS_BackupFolder) to sPathBackup
            Move (vFolderExists(sPathBackup)) to bExist
            If (bExist) Begin
                Move sPathBackup to sPath
            End
            Else Begin
                Move "" to sPath
            End
        End
        Function_Return sPath
    End_Function

    Function SaveBackupFile String sSourceFile Returns Boolean
        Boolean bOK bExists bShouldBackup bVoid
        String sBackupFile
        Date dWriteSource dWriteBackup
        Integer iBackupDaysOverwriteCycle iVoid
        tRFFileTime ftCurrentTime
        
        Move True to bShouldBackup
        Get piBackupDaysOverwriteCycle to iBackupDaysOverwriteCycle
        Get CreateBackupFileName sSourceFile to sBackupFile
        Get vFilePathExists sBackupFile to bExists
        If (bExists = True) Begin
            Move (rfFileDate(sSourceFile)) to dWriteSource
            Move (rfFileDate(sBackupFile)) to dWriteBackup
            Move ((dWriteSource - dWriteBackup) > iBackupDaysOverwriteCycle or (dWriteBackup - dWriteSource) > iBackupDaysOverwriteCycle) to bShouldBackup
        End

        // If we make a backup copy of the file we change the date & time,
        // to present time. This is so we later - if the 'Start Process' button is
        // pressed again - decide to _not_ backup the file again iif it has todays,
        // or yesterday's date. That way the user can press the "Start Process"
        // button several times without the backup file gets overwritten by a
        // file that has been changed all ready - keeping the original source file
        // intact.
        If (bShouldBackup = True) Begin
            Move (vCopyFile(sSourceFile, sBackupFile)) to bOK
            // The copy inherits the source's attributes. A READ-ONLY source (a DfPkg package checkout, a
            // VCS working copy) therefore made a read-only backup: the restamp below then failed
            // (its CreateFileW asks for GENERIC_WRITE), the next overwrite cycle's copy would be refused,
            // and a Restore would copy from a file it cannot later refresh. The backup copy is OURS -
            // the attribute serves nothing there. The source keeps its attribute untouched (2026-08-18).
            Move (rfClearFileReadOnly(sBackupFile)) to bVoid
            Move (rfCurrentSystemTimeAsFileTime()) to ftCurrentTime
            Move (rfSetFileLastWriteTime(sBackupFile, ftCurrentTime)) to iVoid
            Get vFilePathExists sBackupFile to bExists
            // This file's backup was just re-stamped to today, so it is no longer past the cycle -
            // drop the cached at-risk count and let the next tile paint re-ask. (A plain property
            // write per backed-up file; the walk itself happens once, on the next read.)
            Set piBackupsPastCycleCache to -1
        End

        Function_Return bExists
    End_Function

    // Resolve the BACKUP copy of sCurrentFileName (the pre-refactoring original saved by
    // SaveBackupFile). Returns the full backup path, or "" when none exists.
    //
    // PRIMARY: the deterministic mirror path the backup WRITER uses - <backup root>\<drive-encoded
    // file folder>\<file name> (BackupSubfolderForFile turns the drive colon into a folder:
    // C:\<path>\ -> C\<path>\ - see the ComparePaths notes). One vFilePathExists, no disk walk,
    // and NO folder creation (CreateBackupFileName is the writer's resolver: CreateBackupFolder
    // inside it CREATES the folder chain as a side effect, so a read-only probe must not use it).
    // FALLBACK: a recursive name-search of the whole backup tree, for backups written by older
    // versions whose mirror was home-RELATIVE (pre drive-encoding) - the exact probe misses those.
    Function IsBackupFile String sCurrentFileName Returns String
        String sFile sSub sExt sBackupRoot sBackupFile
        Boolean bExists
        tRFSearchResult[] SearchResultArray

        If (sCurrentFileName = "") Begin
            Function_Return ""
        End
        // The backup root (<home>\DFRefactor_Backup), normalized; "" when it does not exist yet.
        Get HomeBackupFilePath to sBackupRoot
        If (sBackupRoot = "") Begin
            Function_Return ""
        End

        // (1) The exact drive-encoded mirror path for this file.
        Get BackupSubfolderForFile sCurrentFileName to sSub
        Get ParseFileName sCurrentFileName to sFile
        Move (vFolderFormat(sBackupRoot) + vFolderFormat(sSub) + sFile) to sBackupFile
        Get vFilePathExists sBackupFile to bExists
        If (bExists = True) Begin
            Function_Return sBackupFile
        End

        // (2) Legacy fallback: search the tree for "<name>.*". The extension is stripped from the
        // END of the name (the old Replace() cut the first occurrence ANYWHERE, so "dgUtils.dg"
        // searched as "Utils.dg*" and missed).
        Get ParseFileExtension sFile to sExt
        If (sExt <> "") ;
            Move (Left(sFile, Length(sFile) - Length(sExt))) to sFile
        Move (vFolderFormat(sBackupRoot) + sFile + "*") to sFile
        Move (rfFileSearchRecursive(sFile, DIRMODE_FILES_ONLY, True)) to SearchResultArray
        Move "" to sBackupFile
        If (SizeOfArray(SearchResultArray)) Begin
            Move SearchResultArray[0].sFilename to sBackupFile
        End

        Function_Return sBackupFile
    End_Function

    Function AllBackupFolderFiles Returns tRFSearchResult[]
        Boolean bExists bSkip
        String sBackupHomeFolder sBackupFolder sHomePath sFileMask sFileName sFileNameLC
        String[] asNoFolderSearch asBackupFolders
        tRFSearchResult[] asBackupFilesEmpty asBackupFiles asBackupFilesTotal
        Integer iFolder iFolders iFile iFiles

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath
        Move (sHomePath + CS_BackupFolder) to sBackupHomeFolder
        Move (vFolderExists(sBackupHomeFolder)) to bExists
        If (bExists = False) Begin
            Function_Return asBackupFilesEmpty
        End

        Get NoFolderListAsArray True to asNoFolderSearch
        Get RecursiveSearchFolders sBackupHomeFolder asNoFolderSearch to asBackupFolders
        Move (SizeOfArray(asBackupFolders)) to iFolders
        Decrement iFolders
        For iFolder from 0 to iFolders
            Move asBackupFolders[iFolder] to sBackupFolder
            Move (vFolderFormat(sBackupFolder)) to sBackupFolder
            Move (sBackupFolder + "*.*") to sFileMask

            // File loop:
            Move (rfFileSearch(sFileMask, DIRMODE_FILES_ONLY, False)) to asBackupFiles
            // Filter out DFRefactor's own report artifacts. Three rules:
            //   1. The summary log itself (CS_SummaryLogfileName = "DFRefactorLogFile.txt").
            //   2. Any "*.log.txt" - the "Other log files" naming convention.
            //   3. Any "*.bat"     - companion scripts (e.g. MoveUnusedSourceFiles.bat).
            // (The previous filter only inspected asBackupFiles[0] and only knew
            // about two specific filenames - it relied on a folder ordering
            // rfFileSearch doesn't guarantee, and missed *.log.txt / *.bat.)
            Move (SizeOfArray(asBackupFiles)) to iFiles
            Decrement iFiles
            For iFile from 0 to iFiles
                Move asBackupFiles[iFile].sFilename to sFileName
                Move (Lowercase(sFileName)) to sFileNameLC
                Move False to bSkip
                If (sFileNameLC = Lowercase(CS_SummaryLogfileName)) Move True to bSkip
                If (Right(sFileNameLC, 8) = ".log.txt")              Move True to bSkip
                If (Right(sFileNameLC, 4) = ".bat")                  Move True to bSkip
                If (bSkip = False) Begin
                    Move sBackupFolder to asBackupFiles[iFile].sPath
                    Move asBackupFiles[iFile] to asBackupFilesTotal[-1]
                End
            Loop
        Loop

        Function_Return asBackupFilesTotal
    End_Function

    /* The ORIGINAL source path a backup file was taken from - the reverse of
       BackupSubfolderForFile. Canonical home for the mapping; the Undo Refactoring dialogs
       (BackupFiles.dg / BackupFilesFT.dg) carry their own copy inline, and this is the one to
       adopt when either is next touched.

       Two backup layouts can coexist in the same tree, so BOTH are handled:
         NEW (drive-encoded): <home>\<BackupFolder>\<drive>\<rest>\<file> - the drive colon was
             turned into a folder, so a file on ANY root (incl. libraries outside the home)
             round-trips to its TRUE location.
         OLD (home-relative): <home>\<BackupFolder>\<rest>\<file> - the pre-fix scheme, only ever
             correct for files that really live under the workspace home (appsrc\, ddsrc\).
       They are told apart by the first segment: a 1-char segment is a drive letter (NEW) - turn it
       back into "<drive>:"; anything longer is a real folder (OLD) - prepend the part before the
       BackupFolder, i.e. the workspace home. Without the OLD branch "appsrc\foo.pkg" would be
       mangled into the invalid drive "appsrc:\foo.pkg". */
    Function SourceFileForBackupFile String sBackupFileName Returns String
        String sMarker sBefore sRel sSourceFileName
        Integer iPos iSep

        If (sBackupFileName = "") ;
            Function_Return ""
        Move (CS_DirSeparator + CS_BackupFolder + CS_DirSeparator) to sMarker
        Move (Pos(sMarker, sBackupFileName)) to iPos
        If (iPos = 0) ;
            Function_Return sBackupFileName

        Move (Left(sBackupFileName, (iPos - 1))) to sBefore
        Move (Mid(sBackupFileName, (Length(sBackupFileName)), (iPos + Length(sMarker)))) to sRel
        Move (Pos(CS_DirSeparator, sRel)) to iSep
        If (iSep = 2) ;
            Move (Left(sRel, 1) + ":" + Mid(sRel, (Length(sRel)), 2)) to sSourceFileName
        Else ;
            Move (sBefore + CS_DirSeparator + sRel) to sSourceFileName

        Function_Return sSourceFileName
    End_Function

    /* How many backups the NEXT refactoring run would overwrite with source that has since moved
       on - i.e. how many pristine originals are about to be lost. 0 = nothing at risk.

       WHY IT EXISTS. SaveBackupFile keeps the first backup sacred for piBackupDaysOverwriteCycle
       days (99 by default - a whole campaign), which is what makes "Undo Refactoring" mean "back to
       how it was before I started". Past that window the next run silently re-backs-up, replacing
       the pristine original with already-refactored source. Nothing warned about it; this feeds the
       Workspace tile's warning row so the user sees it when the workspace is OPENED, while there is
       still time to raise the cycle or bank the originals.

       THE HARD CASE ONLY. SaveBackupFile re-backs-up when the two dates differ by more than the
       cycle in EITHER direction; only one direction can lose work:
         source NEWER than backup by > cycle -> the source has diverged from the pristine copy since
             it was taken, so overwriting REPLACES the original with refactored code. Counted.
         backup NEWER than source by > cycle -> the source has not been touched since long before
             the backup, so the re-copy writes identical content. Harmless, and the common shape for
             files no refactoring function ever changed. NOT counted - counting it would cry wolf on
             a workspace where nothing is actually at risk.
       Both dates come from rfFileDate, the same call SaveBackupFile decides with, so this cannot
       disagree with what the run will do.

       THE SECOND, EARLIER STATE - "nearing". The delta above is NOT a countdown: both dates are
       fixed stamps, so it does not creep up with the calendar. A file sits at delta 40 for years and
       then JUMPS, because a run rewrites the source and delta becomes (today - backup date) in one
       step. So "3 days until expiry" can never be computed, and the useful early signal is a
       different quantity - the AGE OF THE BACKUP, which is exactly what delta becomes the moment a
       run touches that file:
         backup older than the cycle, delta still within it -> safe TODAY (this run's SaveBackupFile
             still skips, so the original survives this run), but any file this run CHANGES comes out
             with delta = age > cycle, and the run AFTER that overwrites its original. Counted as
             "nearing" - one run of grace.
       This is not a corner case: measured 2026-08-05, a workspace here had 0 past and 45 nearing on
       485-day-old backups, i.e. the hard count alone would have said "all clear" right up to the run
       that put a 485-day-old archive in the firing line.

       COST. ONE backup-tree walk plus a stat per backup file feeds BOTH counts, and the result is
       CACHED - the Workspace tile is painted by three separate views. With no workspace loaded it
       answers 0 without walking and without caching, so the answer is computed for real once a
       workspace arrives. */
    Procedure _ProbeBackupCycle
        tRFSearchResult[] asBackups
        String sWS sBackupFile sSourceFile
        Integer i iMax iPast iNear iCycle iCached iCachedCycle
        Date dWriteSource dWriteBackup dToday
        DateTime dtNow
        Boolean bExists

        Get piBackupDaysOverwriteCycle to iCycle
        Get piBackupsPastCycleCache to iCached
        Get piBackupsCacheCycle to iCachedCycle
        // The cached counts are only an answer for the cycle they were computed with, so the cycle is
        // part of the cache key - changing the setting re-asks by itself, with no invalidation call to
        // forget at the ProgramSetup end (and no Set-accessor override on a same-class Property).
        If (iCached >= 0 and iCachedCycle = iCycle) ;
            Procedure_Return

        Move 0 to iPast
        Move 0 to iNear
        Get psSWSFile to sWS
        If (sWS = "" or iCycle <= 0) Begin
            // Nothing to answer FROM - do not cache, so a real answer is computed once a workspace
            // (or a sane cycle) arrives.
            Set piBackupsPastCycleCache to -1
            Set piBackupsNearingCycleCache to -1
            Procedure_Return
        End

        Move (CurrentDateTime()) to dtNow
        Move dtNow to dToday
        Get AllBackupFolderFiles to asBackups
        Move (SizeOfArray(asBackups)) to iMax
        For i from 0 to (iMax - 1)
            Move (vFolderFormat(asBackups[i].sPath) + asBackups[i].sFilename) to sBackupFile
            Get SourceFileForBackupFile sBackupFile to sSourceFile
            Get vFilePathExists sSourceFile to bExists
            If (bExists = True) Begin
                Move (rfFileDate(sSourceFile)) to dWriteSource
                Move (rfFileDate(sBackupFile)) to dWriteBackup
                If ((dWriteSource - dWriteBackup) > iCycle) ;
                    Increment iPast
                Else If ((dToday - dWriteBackup) > iCycle) ;
                    Increment iNear
            End
        Loop

        Set piBackupsPastCycleCache to iPast
        Set piBackupsNearingCycleCache to iNear
        Set piBackupsCacheCycle to iCycle
    End_Procedure

    // Backups the NEXT run would overwrite - see _ProbeBackupCycle. 0 = nothing at risk.
    Function BackupsPastCycleCount Returns Integer
        Integer iCount
        Send _ProbeBackupCycle
        Get piBackupsPastCycleCache to iCount
        If (iCount < 0) ;
            Function_Return 0
        Function_Return iCount
    End_Function

    // Backups still safe this run, but whose ORIGINALS a run today would put in the firing line for
    // the run after - see the "nearing" paragraph in _ProbeBackupCycle. 0 = no such file.
    Function BackupsNearingCycleCount Returns Integer
        Integer iCount
        Send _ProbeBackupCycle
        Get piBackupsNearingCycleCache to iCount
        If (iCount < 0) ;
            Function_Return 0
        Function_Return iCount
    End_Function

    /* ---- THE CURRENT WORKSPACE, PARSED ONCE ------------------------------------------------------
       One parse at the boundary, whatever shape the .sws is in, so no consumer has to sniff the file
       for itself. Four readers used to do that independently (GetWorkspaceProjects,
       WorkspaceConfigFile, SwsLibraryEntries, DeclaredCopyItems) and two of them answered wrongly
       for a file they could not read. */

    // "<lowercased path>|<last write>" - changes when the workspace changes OR when the same file is
    // rewritten, which happens for real: the copy step writes a .sws, the DF26 Studio converts one.
    Function _CurrentSwsKeyFor String sSwsFile Returns String
        DateTime dtWrite
        If (sSwsFile = "") ;
            Function_Return ""
        Move (rfFileDate(sSwsFile)) to dtWrite
        Function_Return (Lowercase(sSwsFile) + "|" + String(dtWrite))
    End_Function

    /* Parse the open workspace's .sws into pCurrentSws, unless it is already current.

       Format decides the reader, and the format is a fact about the FILE: SwsFormatOf reads its
       first non-blank character. A JSON workspace goes through this class's own ReadSwsJsonFile
       (which already returns a tSwsFile and models the path ARRAYS); an INI one through
       cWorkspaceFile, which is standalone so the suite can test it.

       The resolved group is filled here for BOTH shapes - it is the same question either way, and
       filling it in one place is what stops a second tWorkspacePaths growing back. */
    // The runtime paths both .sws readers resolve the same way once the file is parsed: the config file
    // (relative to the home when it is not absolute; "/" and a leading ".\" tolerated), the filelist name,
    // and the live DF_OPEN_PATH, captured the same way ResolveWorkspacePaths does it.
    Procedure _ResolveSwsRuntimePaths tSwsFile ByRef Sws String sHome
        String sCfg

        Move "" to Sws.RuntimePaths.sWsConfigFile
        If (Trim(Sws.Paths.sConfigFile) <> "") Begin
            Move (Replaces("/", Trim(Sws.Paths.sConfigFile), "\")) to sCfg
            If (Left(sCfg, 2) = ".\") ;
                Move (Mid(sCfg, Length(sCfg), 3)) to sCfg
            If (Mid(sCfg, 1, 2) = ":") ;
                Move sCfg to Sws.RuntimePaths.sWsConfigFile
            Else ;
                Move (vFolderFormat(sHome) + sCfg) to Sws.RuntimePaths.sWsConfigFile
        End
        Move (Trim(Sws.Paths.sFileList)) to Sws.RuntimePaths.sFilelistName
        Get_Attribute DF_OPEN_PATH to Sws.RuntimePaths.sOpenPath
    End_Procedure

    // An .sws in either shape - the DF26 JSON file or the classic INI - read into a tSwsFile; bParsed says
    // whether the read succeeded (for the JSON shape, ReadSwsJsonFile's own sentinel is a non-blank df version).
    Function _ReadSwsFileAnyFormat String sSws Returns tSwsFile
        tSwsFile Sws
        Handle hoFile
        Integer iFormat

        Get Create (RefClass(cWorkspaceFile)) to hoFile
        Get SwsFormatOf of hoFile sSws to iFormat
        If (iFormat = eSwsJson) Begin
            Get ReadSwsJsonFile sSws to Sws
            Move eSwsJson to Sws.eSwsFormat
            Move (Sws.sDfVersion <> "") to Sws.bParsed
        End
        Else Begin
            Get ReadWorkspaceFile of hoFile sSws to Sws
        End
        Send Destroy of hoFile
        Function_Return Sws
    End_Function

    Procedure RefreshCurrentSws
        tSwsFile Sws
        String sSws sKey sCur sHome
        Integer iPos

        Get psSWSFile to sSws
        Get _CurrentSwsKeyFor sSws to sKey
        Get psCurrentSwsKey to sCur
        If (sKey <> "" and sKey = sCur) ;
            Procedure_Return

        Set psCurrentSwsKey to sKey
        If (sSws = "" or vFilePathExists(sSws) = 0) Begin
            Set pCurrentSws to Sws          // bParsed False - "nothing read", not "nothing there"
            Procedure_Return
        End

        Get _ReadSwsFileAnyFormat sSws to Sws

        // ---- the resolved group, identical work for either shape ----
        Move sSws to Sws.RuntimePaths.sSwsPath
        Move (RightPos("\", sSws)) to iPos
        If (iPos > 0) ;
            Move (Left(sSws, iPos - 1)) to sHome
        Move sHome to Sws.RuntimePaths.sHome
        Send _ResolveSwsRuntimePaths (&Sws) sHome

        Set pCurrentSws to Sws
    End_Procedure

    /* pOwnSws may never be empty - see OwnSwsGuardText (cWorkspaceFile.pkg) for the rule
       and the 2026-08-28 BOM incident that motivated it. Sent from every RefreshOwnSws
       exit, so a bad own-workspace announces itself AT THE SOURCE instead of surfacing as
       a wrong df-cli dialect (or a dead Libraries dialog) three layers later. */
    Procedure _RaiseIfOwnSwsBad
        tSwsFile Sws
        Handle hoFile
        String sText

        Get pOwnSws to Sws
        Get Create (RefClass(cWorkspaceFile)) to hoFile
        Get OwnSwsGuardText of hoFile Sws to sText
        Send Destroy of hoFile
        If (sText <> "") ;
            Error DFERR_PROGRAM sText
    End_Procedure

    /* Parse DFRefactor's OWN .sws into pOwnSws.

       Separate from RefreshCurrentSws because the subject is different: this is the workspace
       DFRefactor is RUNNING in, which is what its own restore paths and TestBench's sample compile
       need. Reading the open workspace here would point them at whatever the user last opened.

       Read once at startup and not cached against a key: DFRefactor's own .sws does not change
       under a running instance, unlike the target, which this tool itself rewrites. */
    Procedure RefreshOwnSws
        tSwsFile Sws
        String sOwnSws sHome

        /* home + the fixed .sws name FIRST, then whatever .sws is actually there - OwnSwsFile.

           Before 08-14 this used the fixed name alone; the FlexTron build's workspace is
           DFRefactorFlexTron.sws, so pOwnSws was left unparsed and everything downstream failed
           SILENTLY: PrimaryPrograms returned "", so DfCliCapture bailed before running df-cli at
           all, and the Libraries dialog reported "Package not installed" with no output to explain
           it. Search was equally dead. Found after a package install that could not fail, did.

           The fallback takes the single .sws in home when there is exactly one, and otherwise the
           one whose name starts with "DFRefactor" - never a guess between equals. Deliberately not
           just "add FlexTron to the constant": the next build with another name would break the
           same way, and this is a lookup that should not depend on being told every name in
           advance. */
        Get psHome of (phoWorkspace(Self)) to sHome
        If (sHome = "") Begin
            Set pOwnSws to Sws          // bParsed False - "not read", never "nothing there"
            Send _RaiseIfOwnSwsBad
            Procedure_Return
        End
        Get OwnSwsFile to sOwnSws
        If (sOwnSws = "" or vFilePathExists(sOwnSws) = 0) Begin
            Set pOwnSws to Sws
            Send _RaiseIfOwnSwsBad
            Procedure_Return
        End

        Get _ReadSwsFileAnyFormat sOwnSws to Sws

        Move sOwnSws to Sws.RuntimePaths.sSwsPath
        Move (RemoveFolderSeperator(Self, sHome)) to Sws.RuntimePaths.sHome
        Move (RemoveFolderSeperator(Self, sHome)) to sHome
        Send _ResolveSwsRuntimePaths (&Sws) sHome
        Set pOwnSws to Sws
        Send _RaiseIfOwnSwsBad
    End_Procedure

    /* DFRefactor's OWN primary AppSrc folder.

       SINGULAR on purpose, unlike CurrentSwsFolders. Every caller of this builds a path to READ or
       WRITE one file in DFRefactor's own source folder (the function-library export/import JSONs),
       and a write needs one destination, not a list. The one-vs-all question still has to be asked
       per site - this is a site where "the first" is the right answer, not a truncation.

       Falls back to pOrgWS while both properties exist. */
    Function OwnAppSrcFolder Returns String
        tSwsFile Sws
        tWorkspacePaths WS
        Get pOwnSws to Sws
        If (SizeOfArray(Sws.Paths.asAppSrc) > 0) Begin
            If (Sws.Paths.asAppSrc[0] <> "") ;
                Function_Return Sws.Paths.asAppSrc[0]
        End
        Get pOrgWS to WS
        Function_Return WS.sAppSrc
    End_Function

    // eSwsIni / eSwsJson for the open workspace.
    Function CurrentSwsFormat Returns Integer
        tSwsFile Sws
        Send RefreshCurrentSws
        Get pCurrentSws to Sws
        Function_Return Sws.eSwsFormat
    End_Function

    // False = the .sws was never read, or could not be. NOT the same as "it declares nothing", and
    // every consumer that draws a conclusion from an empty list has to test this first.
    Function CurrentSwsParsed Returns Boolean
        tSwsFile Sws
        Send RefreshCurrentSws
        Get pCurrentSws to Sws
        Function_Return Sws.bParsed
    End_Function

    Function CurrentSwsHome Returns String
        tSwsFile Sws
        Send RefreshCurrentSws
        Get pCurrentSws to Sws
        Function_Return Sws.RuntimePaths.sHome
    End_Function

    // Full path of the legacy .ws, "" when the workspace carries its paths inline (JSON).
    Function CurrentSwsConfigFile Returns String
        tSwsFile Sws
        Send RefreshCurrentSws
        Get pCurrentSws to Sws
        Function_Return Sws.RuntimePaths.sWsConfigFile
    End_Function

    /* ALL folders declared for one path key - the whole point of this change.

       tWorkspacePaths kept a single String per key and was filled with the FIRST entry only
       (cRefactorApplication ~605 for INI, and asAppSrc[0] for JSON - the array was read and then
       discarded). Workspaces that declare several AppSrc or DdSrc folders are common, so every
       caller that scanned "the" source folder was scanning one of them.

       sWhich: "appsrc" / "ddsrc" / "data" / "apphtml" / "bitmap" / "programs" / "help".
       An ARRAY return, which marshals across objects where a bare struct does not. */
    Function CurrentSwsFolders String sWhich Returns String[]
        tSwsFile Sws
        String[] asNone
        String sLow

        Send RefreshCurrentSws
        Get pCurrentSws to Sws
        Move (Lowercase(Trim(sWhich))) to sLow
        If (sLow = "appsrc")   Function_Return Sws.Paths.asAppSrc
        If (sLow = "ddsrc")    Function_Return Sws.Paths.asDdSrc
        If (sLow = "data")     Function_Return Sws.Paths.asData
        If (sLow = "apphtml")  Function_Return Sws.Paths.asAppHtml
        If (sLow = "bitmap")   Function_Return Sws.Paths.asBitmap
        If (sLow = "programs") Function_Return Sws.Paths.asPrograms
        If (sLow = "help")     Function_Return Sws.Paths.asHelp
        Function_Return asNone
    End_Function

    Function AllSourceFolders String[] asSelectedFolders Returns String[]
        String sHomePath
        String[] asNoFolderSearch asSourceFolders asAllSourceFolders
        Integer iSize iCount

        Get psHomeTarget to sHomePath
        Move (vFolderFormat(sHomePath)) to sHomePath

        Get NoFolderListAsArray False to asNoFolderSearch
        Move (SizeOfArray(asSelectedFolders)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Get RecursiveSearchFolders asSelectedFolders[iCount] asNoFolderSearch to asSourceFolders
            Move (AppendArray(asAllSourceFolders, asSourceFolders)) to asAllSourceFolders
        Loop

        Function_Return asAllSourceFolders
    End_Function

    // Resolve a source file by BASENAME anywhere under the target workspace's SOURCE tree - AppSrc, DdSrc and the
    // workspace's library source folders, each searched RECURSIVELY. The compiler-output double-click resolver
    // needs this because report views (.rv) and other sources often live in a SUBFOLDER of a source path - a
    // folder that is not itself a DF_OPEN_PATH entry, so the flat AppSrc / Get_File_Path lookups in
    // _ResolveRawDiagnosticFile miss it. Returns the first match's full path, or "" if not found. Read-only
    // folder walk; called only on the double-click fallback (after every flat lookup fails), so the one-time
    // recursion cost is acceptable.
    Function ResolveSourceFileInTree String sFile Returns String
        String sPath
        String[] asRoots asAllFolders
        Integer i iMax

        If (sFile = "") ;
            Function_Return ""
        // Same roots as the default scope - a file the scope can refactor is a file this must be
        // able to open. Before, both built the list themselves and both took only the FIRST AppSrc,
        // so a double-click on a diagnostic in a second source folder found nothing.
        Get WorkspaceSourceRoots to asRoots
        If (SizeOfArray(asRoots) = 0) ;
            Function_Return ""
        // Expand each root to itself + all its subfolders, then probe each folder for the basename.
        Get AllSourceFolders asRoots to asAllFolders
        Move (SizeOfArray(asAllFolders) - 1) to iMax
        For i from 0 to iMax
            Move (vFolderFormat(asAllFolders[i]) + sFile) to sPath
            If (vFilePathExists(sPath)) ;
                Function_Return sPath
        Loop
        Function_Return ""
    End_Function

    // One root's dead dependencies, recursively, as "<file>|<why>" rows in asOut - each file once; sSeen carries
    // the files already listed as "[path]" keys.
    Procedure _CollectDeadDependencies String sRoot String ByRef sSeen String[] ByRef asOut
        tRFSearchResult[] asFiles
        String sFull sWhy sKey
        Integer j jLast

        Move (rfFileSearchRecursive(sRoot, DIRMODE_FILES_ONLY, False)) to asFiles
        Move (SizeOfArray(asFiles) - 1) to jLast
        For j from 0 to jLast
            Move asFiles[j].sFilename to sFull
            Get _DeadDependencyFor of ghoFuncLib sFull to sWhy
            If (sWhy <> "") Begin
                Move ("[" + Lowercase(sFull) + "]") to sKey
                If (not(sSeen contains sKey)) Begin
                    Move (sSeen + sKey) to sSeen
                    Move (sFull + "|" + sWhy) to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
    End_Procedure

    /* Every dead-dependency source file in the WORKSPACE, packed "fullpath|why" - regardless of
       what the user selected for the run.

       WHY THIS EXISTS SEPARATELY (Nils 2026-08-09, on the E:\LegacyApp3 test): the skip list that
       AllSourceFiles fills can only ever name files it COLLECTED, and collection is deliberately
       non-recursive - rfFileSearch(..., False). In that workspace two WinQL32 files sat directly
       in the two selected folders and were skipped and reported, while a third in AppSrc\Norwegian
       and both Crystal files - one in Pkg-filer\CustomPreviewCrystal, one deep inside a library -
       were never collected, so they could not be skipped either. The report was true about the
       CHECK and read as an inventory of the workspace, which it is not.

       So the two questions get two answers: what did this Check leave out (pasDeadDepSkipped, free,
       filled by the pass that ran) and what does this workspace contain (here, a walk).

       ON DEMAND ONLY. WholeWorkspaceSourceFolders reaches the disk, which is fine when the user
       asks "which ones?" and indefensible on a tile repaint - the same rule the scope band follows.
       Nothing calls this during a render. */
    Function WorkspaceDeadDependencyFiles Returns String[]
        String[] asOut asLibs asSkipped
        String sHome sSeen sKey sRow
        Integer i iLast iBar

        If (ghoFuncLib = 0) ;
            Function_Return asOut
        /* RECURSIVE, FROM THE WORKSPACE HOME - not from the registered source roots.

           WholeWorkspaceSourceFolders was the first attempt and it under-reported on the
           E:\LegacyApp3 test: it found AppSrc and its sub-folders but not Pkg-filer, which the user
           had SELECTED for the run, so a file this very feature had just skipped was missing from
           the inventory that was supposed to contain it. "This workspace contains" has to mean the
           directory tree, which is what the reader means by it, not the subset the .sws declares as
           source.

           Library roots are added because a workspace can reference them from outside its home, and
           the skipped list is UNIONED in at the end because a selected folder need not be under
           home at all. Nothing that was skipped can be absent from the inventory - that
           contradiction is what made the first version read as broken. */
        Get psHomeTarget to sHome
        Move "" to sSeen
        If (sHome <> "") ;
            Send _CollectDeadDependencies (vFolderFormat(sHome) + "*.*") (&sSeen) (&asOut)
        // Libraries the workspace points at, which can live anywhere on disk.
        Get GetWorkspaceLibrarySourceFolders (psSWSFile(Self)) to asLibs
        Move (SizeOfArray(asLibs) - 1) to iLast
        For i from 0 to iLast
            Send _CollectDeadDependencies (vFolderFormat(asLibs[i]) + "*.*") (&sSeen) (&asOut)
        Loop
        // ...and anything the last Check skipped that neither walk reached.
        Get pasDeadDepSkipped to asSkipped
        Move (SizeOfArray(asSkipped) - 1) to iLast
        For i from 0 to iLast
            Move asSkipped[i] to sRow
            Move (Pos("|", sRow)) to iBar
            If (iBar > 1) Begin
                Move ("[" + Lowercase(Left(sRow, (iBar - 1))) + "]") to sKey
                If (sSeen contains sKey) Begin
                End
                Else Begin
                    Move (sSeen + sKey) to sSeen
                    Move sRow to asOut[SizeOfArray(asOut)]
                End
            End
        Loop
        Function_Return asOut
    End_Function

    /* THE LIBRARY FOLDERS THIS COLLECTION SKIPS, resolved ONCE - a cLibraryInventory Create per
       FILE would be absurd, and the per-file test below is then a prefix match on a lowercased,
       separator-normalised path.

       Only libraries we RECOGNISE are listed. LibraryHomeUrl answers non-blank exactly when the
       catalogue knows where a library's releases live, which is the same question as "does an
       upstream exist" - and that is the whole test. An unrecognised [Libraries] entry is presumed
       LOCAL AND PRIVATE and is left in scope. Getting this backwards is the difference between
       "we skipped someone else's code" and "we silently refused to refactor yours". */
    Procedure _LibrarySkipFolders String[] ByRef asSkipFolders String[] ByRef asSkipNames
        Handle hoInv
        String[] asLibs asNone
        String sSWS sFolder sName sUrl
        Integer i iMax

        Move asNone to asSkipFolders
        Move asNone to asSkipNames
        Get psSWSFile to sSWS
        If (Trim(sSWS) = "") ;
            Procedure_Return
        Get GetWorkspaceLibrarySourceFolders sSWS to asLibs
        Move (SizeOfArray(asLibs) - 1) to iMax
        If (iMax < 0) ;
            Procedure_Return
        Get Create (RefClass(cLibraryInventory)) to hoInv
        For i from 0 to iMax
            Move asLibs[i] to sFolder
            If (Trim(sFolder) <> "") Begin
                Get LibraryDisplayName of hoInv sFolder to sName
                Get LibraryHomeUrl     of hoInv sName   to sUrl
                // non-blank = the catalogue knows an upstream for it = not ours to edit here
                If (Trim(sUrl) <> "") Begin
                    Move (Lowercase(vFolderFormat(sFolder))) to asSkipFolders[SizeOfArray(asSkipFolders)]
                    Move sName                               to asSkipNames[SizeOfArray(asSkipNames)]
                End
            End
        Loop
        Send Destroy of hoInv
    End_Procedure


    /* IS THIS FILE THE WORKSPACE'S TO WRITE? The one rule every compiler-message action applies to
       the files the compiler named (2026-09-20): still on disk, not inside the target DataFlex's
       Pkg tree (the same prefix guard AllSourceFiles below applies to a folder walk), and not
       carrying the READ-ONLY attribute (a DfPkg checkout, the package cache, a VCS-locked copy).
       Written once, here, so the board's scope builder, the grid's per-name site counts and the
       rewrite offers cannot disagree about whose a file is - they did: the offer counted "Files: 3"
       and the scope builder then dropped all three. A blank psTargetPkgFolder skips the install
       test, as it does below. */
    Function IsCompilerNamedFileWritable String sFile Returns Boolean
        String sPkg
        Boolean bExists

        Get vFilePathExists sFile to bExists
        If (bExists = False) ;
            Function_Return False
        Get psTargetPkgFolder to sPkg
        If (sPkg <> "" and rfIsPathUnderFolder(sFile, sPkg) = True) ;
            Function_Return False
        Function_Return (Not(rfIsFileReadOnly(sFile)))
    End_Function

    Function AllSourceFiles String[] asFolders String sFileFilter Returns tRefactorFiles
        Boolean bIsFileInFilter bIsCOMProxy bIsInstallFile
        String sFolderName sFileMask sFileName sFullFileName sPkgFolderLow sDeadWhy sLibWhy
        String[] asDeadSkipped asProxySkipped asEmptyFolders asLibSkipped asLibFold asLibName
        tRFSearchResult[] asSourceFiles asSourceFilesTotal
        Integer iFolder iFolders iCount iSize iFile iFileAtFolderStart
        tRefactorFiles FileData
        
        Move (SizeOfArray(asFolders)) to iFolders  
        // There is a special function (SingleSourceFile) for a single file,
        // but in case this function is called make it work the same.
        If (iFolders = 0) Begin
            Get psCurrentSourceFileName   to sFileName
            Move                sFileName to FileData.asFullFileNames[0] 
            Get ParseFolderName sFileName to FileData.asFolders[0]
            Function_Return FileData
        End

        // ONCE per collection, never per file - see _LibrarySkipFolders.
        Send _LibrarySkipFolders (&asLibFold) (&asLibName)

        // If the File Filter contains ",", we consider that to be an oversight by the user,
        // and auto-replace comma separators with the correct ";" separator.
        If (sFileFilter contains ",") Begin
            Move (Replaces(",", sFileFilter, ";")) to sFileFilter
        End
        Decrement iFolders
        Move 0 to iFile
        // Safety net: NEVER collect any file under the DataFlex install's Pkg tree (read-only
        // system packages). Computed once; normalized to a lower-case, trailing-separator prefix
        // so the per-file test below is a cheap case-insensitive Left() match. Blank when the
        // target Pkg folder is unknown -> the guard is simply skipped (degrades safely).
        Get psTargetPkgFolder to sPkgFolderLow
        If (sPkgFolderLow <> "") ;
            Move (Lowercase(vFolderFormat(sPkgFolderLow))) to sPkgFolderLow
        // Folder loop:
        For iFolder from 0 to iFolders
            Move asFolders[iFolder] to sFolderName
            Move (vFolderFormat(sFolderName)) to sFolderName
            Move (sFolderName + "*.*") to sFileMask

            Move (rfFileSearch(sFileMask, DIRMODE_FILES_ONLY, False)) to asSourceFiles
            Move (SizeOfArray(asSourceFiles)) to iSize
            Move iFile to iFileAtFolderStart
            Decrement iSize
            
            // File loop:
            For iCount from 0 to iSize
                Move asSourceFiles[iCount].sFilename to sFileName
                Get IsFileInFilter sFileName sFileFilter to bIsFileInFilter
                If (bIsFileInFilter = True) Begin
                    // Exclude DataFlex Studio COM proxy packages (.ocx wrappers etc.) right
                    // here, at collection - they are huge (e.g. chilkat_9.5.0.pkg ~68k lines)
                    // and never refactored, so they should never enter the file list the engine
                    // works on. _IsDataFlexCOMProxyClassesFile reads only the file's FIRST line,
                    // so it is cheap to run per file here. Guarded on ghoFuncLib in case collection
                    // is ever called before the funclib object exists (degrades to "collect it;
                    // the engine's own per-file proxy skip catches it at processing time").
                    Move (sFolderName + String(sFileName)) to sFullFileName
                    Move False to bIsCOMProxy
                    If (ghoFuncLib <> 0) ;
                        Get _IsDataFlexCOMProxyClassesFile of ghoFuncLib sFullFileName to bIsCOMProxy
                    // Hard guard: a file under the DataFlex install Pkg tree is a read-only system
                    // package - the engine must never read it into a refactor run (and so never
                    // overwrite it). The analyzer surfaces its warnings read-only; this keeps the
                    // engine itself from ever touching the install, however the folder was selected.
                    Move False to bIsInstallFile
                    If (sPkgFolderLow <> "" and Left(Lowercase(sFullFileName), Length(sPkgFolderLow)) = sPkgFolderLow) ;
                        Move True to bIsInstallFile
                    /* DEAD DEPENDENCIES, skipped for the same reason as the COM proxies above and
                       recorded, not silently dropped (Nils 2026-08-09, on Crystal Reports and
                       WinQL32: "it is pointless to try to fix any Crystal Reports classes or
                       reports ... the same is true for WinQl32").

                       A package family with no successor is not modernised, it is deleted - so
                       every finding inside one is work thrown away. Measured across the DF18/DF19
                       trees, those two families hold 26% of the entire legacy-Type surface, which
                       is 26% of that report buried under code nobody will keep.

                       The reason travels with the skip so the board can NAME it. Silence here
                       would read as coverage, which is the one thing a skip must never do. */
                    Move "" to sDeadWhy
                    If (ghoFuncLib <> 0 and bIsCOMProxy = False and bIsInstallFile = False) ;
                        Get _DeadDependencyFor of ghoFuncLib sFullFileName to sDeadWhy
                    If (sDeadWhy <> "") ;
                        Move (sFullFileName + "|" + sDeadWhy) to asDeadSkipped[SizeOfArray(asDeadSkipped)]
                    If (bIsCOMProxy = True) ;
                        Move sFullFileName to asProxySkipped[SizeOfArray(asProxySkipped)]
                    /* THIRD-PARTY LIBRARY CODE, skipped and NAMED. Tested last of the four so a
                       file that is also a proxy or a dead dependency keeps the more specific
                       reason - and so the counts below never double-report one file. */
                    Move "" to sLibWhy
                    If (bIsCOMProxy = False and bIsInstallFile = False and sDeadWhy = "") ;
                        Move (rfLibrarySkipReason(sFullFileName, &asLibFold, &asLibName)) to sLibWhy
                    If (sLibWhy <> "") ;
                        Move (sFullFileName + "|" + sLibWhy) to asLibSkipped[SizeOfArray(asLibSkipped)]
                    If (bIsCOMProxy = False and bIsInstallFile = False and sDeadWhy = "" and sLibWhy = "") Begin
                        Move sFullFileName to FileData.asFullFileNames[iFile]
                        Increment iFile
                    End
                End
            Loop
            If (iFile = iFileAtFolderStart) ;
                Move sFolderName to asEmptyFolders[SizeOfArray(asEmptyFolders)]
        Loop
        Move asFolders to FileData.asFolders
        /* FOLDERS THAT GAVE NOTHING, named for the same reason the skipped FILES are (Nils
           2026-08-31). A selected folder holding 152 packages contributed ZERO to a WinServ
           scan, and the only way to see it was to diff the scan cache against the compile
           scope by hand. A folder in the list that yields no source file is either not the
           folder the user thinks they ticked, or is being filtered out - and either way the
           board must be able to say so rather than present the gap as coverage. */
        Set pasEmptyFolders     to asEmptyFolders
        Set pasLastScopeFolders to asFolders     // exactly what this collection was handed
        // Published so the boards can NAME what was left out. A skip the user cannot see is
        // indistinguishable from coverage, which is the failure this whole feature exists to avoid.
        Set pasDeadDepSkipped to asDeadSkipped
        Set pasProxySkipped   to asProxySkipped
        Set pasLibrarySkipped to asLibSkipped

        // Process files in a predictable, eyeball-able order: sort the full-path
        // list CASE-INSENSITIVELY, so files group by folder alphabetically then
        // by filename within each folder. Case-insensitive matters - a plain
        // ASCII sort would place a capitalised library path (e.g. ...\WebAppSrc)
        // BEFORE the lower-cased workspace home (...\customerapp\AppSrc),
        // defeating the goal of seeing AppSrc processed early. The folder list
        // (FileData.asFolders) is intentionally left in selection order.
        Move (SortArray(FileData.asFullFileNames, Desktop, RefFunc(DFSTRICMP))) to FileData.asFullFileNames

        Function_Return FileData
    End_Function
    
    Function SingleSourceFile Returns tRefactorFiles
        String sFolder sFileName
        Integer iItem         
        String sFullFileName 
        tRefactorFiles RefactorFiles
        
        Move 0 to iItem
        Get psCurrentSourceFileName       to sFullFileName
        Get ParseFolderName sFullFileName to sFolder
        Get ParseFileName   sFullFileName to sFileName
        
        Move sFullFileName to RefactorFiles.asFullFileNames[iItem]
        Move sFolder       to RefactorFiles.asFolders[iItem]
        
        Function_Return RefactorFiles
    End_Function  
    
    Function CollectFileData Handle oFolderSelDtl_DD Returns tRefactorFiles
        tRefactorFiles RefactorFiles RefactorFilesEmpty
        String[] asFolders  
        
        Open SysFile
        If (SysFile.FileExtensionFilter = "") Begin
            Send UserError "SysFile.FileExtensionFilter is blank! (Function CollectAllFiles)"
            Function_Return RefactorFilesEmpty
        End
        If (pbWorkspaceMode(Self) = True) Begin
            Get pasSelectedFolders to asFolders
            If (SizeOfArray(asFolders) = 0) Begin
                Get SelectedFolders of oFolderSelDtl_DD to asFolders
                Set pasSelectedFolders to asFolders
            End
            Get AllSourceFiles asFolders SysFile.FileExtensionFilter to RefactorFiles
        End
        Else Begin     
            Get SingleSourceFile to RefactorFiles
        End
    
        Function_Return RefactorFiles    
    End_Function

    // The one IsFileInFilter is cRefactorUtilities' (ghoFuncLib), where it is unit-tested; this is the
    // application's door to it.
    Function IsFileInFilter String sFileName String sFileFilter Returns Boolean
        Boolean bInFilter

        Get IsFileInFilter of ghoFuncLib sFileName sFileFilter to bInFilter
        Function_Return bInFilter
    End_Function

    // The one RecursiveFolderSearch is the function library's (ghoFuncLib), where it is unit-tested; this is the
    // application's door to it, from the target workspace's home.
    Function RecursiveSearchFolders String sFolderName String[] asNoFolderList Returns String[]
        String sHome
        String[] asFolders

        Get psHomeTarget to sHome
        Get RecursiveFolderSearch of ghoFuncLib sFolderName sHome asNoFolderList to asFolders
        Function_Return asFolders
    End_Function

    Procedure ComparePaths String sCompareApp
        String sPath sPathBackup sBackupRoot sDriveEncoded sCheck

        Get psHomeTarget to sPath
        Get HomeBackupFilePath to sBackupRoot
        If (sPath <> "" and sBackupRoot <> "") Begin
            // Backups mirror each file's FULL path with the drive colon turned into a folder
            // (BackupSubfolderForFile): E:\<home>\ -> <Backup>\E\<home>\. So to line the two trees up in the
            // compare tool, point the backup side at that drive-encoded home subfolder, NOT the bare <Backup>
            // root - whose first level is now just the lone drive letter, which is why the folders stopped
            // matching after the drive-encoded backup change. Fall back to the root if the home-rooted backup
            // subtree doesn't exist yet (e.g. only library files on other roots have been backed up).
            Move (Replace(":", sPath, "")) to sDriveEncoded
            Move (vFolderFormat(sBackupRoot) + vFolderFormat(sDriveEncoded)) to sPathBackup
            Get RemoveFolderSeperator sPathBackup to sCheck
            If (vFolderExists(sCheck) = False) ;
                Move sBackupRoot to sPathBackup
            Runprogram Background ('"' + sCompareApp + '"') ('"' + sPath + '" "' + sPathBackup + '"')
        End
    End_Procedure

    // Compare ONE source file against its backed-up original (the pre-refactoring copy in the Backup
    // area) in the external compare tool. The per-file counterpart of ComparePaths, and the ONE home
    // for the file+backup pairing: the mode-aware CompareFiles below (the toolbar / dashboard Compare
    // in single-file mode) and the Refactoring Editor's Compare chip (EditorViewFT.vw) both route
    // here. The editor chip passes the file actually LOADED in the editor (psCodeFile) - an Analyzer /
    // Compiler Output jump loads the editor WITHOUT touching psCurrentSourceFileName, so reading that
    // property there would compare a stale file.
    Procedure CompareFileWithBackup String sCompareApp String sFileName
        Boolean bExist
        String sFileBackup

        If (sFileName = "") Begin
            Send Info_Box "You have to select a file first."
            Procedure_Return
        End
        Get vFilePathExists sFileName to bExist
        If (bExist = False) Begin
            Send Info_Box ("The source file" * sFileName * "does not exist.")
            Procedure_Return
        End
        Get IsBackupFile sFileName to sFileBackup
        If (sFileBackup = "") Begin
            Send Info_Box ("No backup was found for" * sFileName * "- backups are created when a refactoring run changes the file.")
            Procedure_Return
        End
        Runprogram Background ('"' + sCompareApp + '"') ('"' + sFileName + '" "' + sFileBackup + '"')
    End_Procedure

    Procedure CompareFiles String sCompareApp
        String sFileName

        Get psCurrentSourceFileName to sFileName
        Send CompareFileWithBackup sCompareApp sFileName
    End_Procedure

    // Tick helper for long-running synchronous loops. Throttles
    // Send PumpMsgQueue of Desktop to at most every piTickThresholdMs (wall
    // clock) and exposes a pbCancelRequested flag for Cancel/Abort button
    // wiring.
    //
    // Usage:
    //     Send ProgressTickStart of ghoApplication
    //     For iCount from 0 to iSize
    //         // ...per-iteration work + caller's own status-text update...
    //         Get ProgressTick of ghoApplication to bCancelled
    //         If (bCancelled = True) Begin
    //             Move iSize to iCount   // canonical DF loop-exit
    //         End
    //     Loop
    //
    // The Cancel/Abort button's OnClick does Send ProgressTickCancel of
    // ghoApplication. The flag is read on the next ProgressTick call after
    // PumpMsgQueue dispatches the click.
    Procedure ProgressTickStart
        Set private.piLastTickCount   to 0
        Set private.pbCancelRequested to False
    End_Procedure

    Function ProgressTick Returns Boolean
        Integer iNow iLast iThreshold
        Boolean bShouldPump

        Move (GetTickCount()) to iNow
        Get private.piLastTickCount   to iLast
        Get private.piTickThresholdMs to iThreshold
        // First call (iLast = 0) always pumps so the first paint is visible.
        Move (iLast = 0 or iNow - iLast >= iThreshold) to bShouldPump
        If (bShouldPump = True) Begin
            Set private.piLastTickCount to iNow
            Send PumpMsgQueue of Desktop
        End

        Function_Return (private.pbCancelRequested(Self))
    End_Function

    Procedure ProgressTickCancel
        Set private.pbCancelRequested to True
    End_Procedure

    Function ProgressTickCancelled Returns Boolean
        Function_Return (private.pbCancelRequested(Self))
    End_Function

    // Returns the current Studio "File mask" setting as a string. See
    Function StudioFileMaskSettings Returns String
        Handle hoReg
        String sStudioRegPath sRetval sDFVersion
        Boolean bExists bOk
        Integer iMajorVersion iMinorVersion

        Move FMAC_VERSION  to iMajorVersion
        Move FMAC_REVISION to iMinorVersion
        Move (String(iMajorVersion) + "." + String(iMinorVersion)) to sDFVersion

        Get Create (RefClass(cRegistry)) to hoReg
        Set pfAccessRights of hoReg to Key_Read

        Move CS_StudioToolsPathStart to sStudioRegPath
        Move (sStudioRegPath + sDFVersion + CS_StudioToolsPathEnd) to sStudioRegPath
        Set phRootKey of hoReg to HKEY_CURRENT_USER

        // First check if the DF version is installed
        Get KeyExists of hoReg sStudioRegPath to bExists
        If (bExists = False) Begin
            Send Destroy of hoReg
            Function_Return cx_RegKeyDFKeyDoesNotExist
        End

        Get OpenKey of hoReg sStudioRegPath to bOk
        If (bOk = True) Begin
            Set pfAccessRights of hoReg to KEY_READ
            Get ReadString of hoReg CS_DFExtensionsKey to sRetval
        End

        Send CloseKey of hoReg
        Send Destroy of hoReg
        Function_Return sRetval
    End_Function

    Function StudioFileExtensions String sDFVersion Returns String
        Handle hoReg
        String sStudioRegPath  sRetval
        Boolean bExists bOk

        Get Create (RefClass(cRegistry)) to hoReg
        Move CS_StudioPath to sStudioRegPath
        If (sDFVersion > "17.1") Begin
            Move (Replace("Visual ", sStudioRegPath, "")) to sStudioRegPath
        End
        Move (sStudioRegPath + sDFVersion + CS_StudioPathEnd) to sStudioRegPath
        Set phRootKey of hoReg to HKEY_CURRENT_USER

        // First check if the DF version is installed
        Get KeyExists of hoReg sStudioRegPath to bExists
        If (bExists = False) Begin
            Send Destroy of hoReg
            Function_Return cx_RegKeyDFKeyDoesNotExist
        End

        Get OpenKey of hoReg sStudioRegPath to bOk
        If (bOk = True) Begin
            Set pfAccessRights of hoReg to KEY_READ
            // In the Studio this key is still call "VDF".
            Get ReadString of hoReg "VdfExtensions" to sRetval
        End

        Send CloseKey of hoReg
        Send Destroy of hoReg
        Function_Return (Trim(sRetval))
    End_Function

    // The one NoFolderListAsArray and IsFolderInNoFolderList are the function library's (ghoFuncLib), where they
    // are unit-tested; these are the application's doors to them.
    Function NoFolderListAsArray Boolean bNoBackupFolder Returns String[]
        String[] asList

        Get NoFolderListAsArray of ghoFuncLib bNoBackupFolder to asList
        Function_Return asList
    End_Function

    Function IsFolderInNoFolderList String[] saNoFolderList String sFolderName Returns Boolean
        Boolean bFound

        Get IsFolderInNoFolderList of ghoFuncLib saNoFolderList sFolderName to bFound
        Function_Return bFound
    End_Function

    Function IsFolderInDefaultsFolderList String sFolderName Returns Boolean
        Integer iSize iCount iIndex
        Boolean bOK
        String sDefaultFolders
        String[] asDefaultFolderList asFolderList
        
        Move False to bOK 
        Move -1 to iIndex
        
        Move CS_DefaultSourceFolders to sDefaultFolders
        Move (Lowercase(sDefaultFolders)) to sDefaultFolders
        Move (StrSplitToArray(sDefaultFolders, CS_D)) to asDefaultFolderList

        Move (Lowercase(sFolderName)) to sFolderName
        Move (StrSplitToArray(sFolderName, "\")) to asFolderList

        Move (SizeOfArray(asFolderList)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move asFolderList[iCount] to sFolderName
            Move (SearchArray(sFolderName, asDefaultFolderList)) to iIndex
            If (iIndex <> -1) Begin
                Move True to bOK
            End
            If (bOK = True) ;
                Break
        Loop

        Function_Return bOK
    End_Function
    
    // Event for updating file name display.
    Procedure OnFileNameUpdate String sFileName
    End_Procedure
    
    Procedure ShowLogFile
        String sPath sLogFile
        Boolean bLogFileExists

        Get psHomeTarget of ghoApplication to sPath
        Move (vFolderFormat(sPath)) to sPath
        Move (sPath + CS_BackupFolder + CS_DirSeparator + CS_SummaryLogfileName) to sLogFile
        Get vFilePathExists sLogFile to bLogFileExists
        If (bLogFileExists = False) Begin
            Send Info_Box "Can't find the log file"
            Procedure_Return
        End

        Send ActivateEngineLogFile of (Client_Id(phoMainPanel(Self))) sLogFile
    End_Procedure

    Procedure ShowOtherLogFiles
        String[] asOtherLogFiles

        // The workspace's Backup folder is the single source of truth (OtherLogFiles globs it for
        // *.log.txt), so the dialog matches the dashboard's "Read other logs (N)" chip - which counts
        // the SAME glob (DashboardFT ActionRowHtml). This used to prefer pasOtherLogFiles of ghoFuncLib
        // (only the LAST run's report logs), which showed 1 while the chip counted 3 files on disk, hid
        // valid older reports until an app restart cleared it, and went stale across a workspace switch
        // (Nils 2026-07-20). The glob is workspace-scoped and a superset that always includes the log a
        // report just wrote, so nothing is lost.
        Get OtherLogFiles to asOtherLogFiles
        Send ShowOtherLogFilesDialog of (Client_Id(ghoCommandBars)) asOtherLogFiles
    End_Procedure
    
    Function OtherLogFiles Returns String[]
        tRFSearchResult[] asSearchResult
        String[] asOtherLogFiles
        String sPath sLogFiles
        Boolean bLogFileExists
        Integer iSize iCount
        
        Get psHomeTarget of ghoApplication to sPath
        Move (vFolderFormat(sPath)) to sPath
        Move (sPath + CS_BackupFolder + CS_DirSeparator) to sPath
        Move (sPath + "*.log.txt") to sLogFiles
        Move (rfFileSearch(sLogFiles, DIRMODE_FILES_ONLY, False)) to asSearchResult
        Move (SizeOfArray(asSearchResult)) to iSize
        Decrement iSize
        For iCount from 0 to iSize
            Move (sPath + asSearchResult[iCount].sFilename) to asOtherLogFiles[-1]
        Loop
        Function_Return asOtherLogFiles
    End_Function

    // To get the version info from a .Dll or .exe file.
    // The sFileName param must include the full path.
    Function FileVersionInfo String sFileName Returns String
        Handle hoVersionInfo    
        Boolean bIncluded
        Integer iVersionMajor iVersionMinor iVersionRelease iVersionBuild
        String sVersion
        
        Move "" to sVersion
        Get Create (RefClass (cVersionInfo)) to hoVersionInfo
        Send DoCreate of hoVersionInfo sFileName
        Get pbIncluded of hoVersionInfo to bIncluded
        If (bIncluded = True) Begin
            Get piVersionMajor of hoVersionInfo to iVersionMajor
            Get piVersionMinor of hoVersionInfo to iVersionMinor
            Get piVersionRelease of hoVersionInfo to iVersionRelease
            Get piVersionBuild of hoVersionInfo to iVersionBuild
            Move (SFormat ("%1.%2.%3.%4", iVersionMajor, iVersionMinor, iVersionRelease, iVersionBuild)) to sVersion
        End
        Send Destroy of hoVersionInfo
        Function_Return sVersion
    End_Function

    // Code to be run in other countries than the USA, to mimic US local settings.
    // Curtesy by Wil van Antwerpen.
    Procedure SetLocasitationToUS 
        Set_Attribute DF_DATE_FORMAT         to DF_DATE_USA // date format mm/dd/yy
        Set_Attribute DF_DATE_SEPARATOR      to 47          // date separator "/"
        Set_Attribute DF_THOUSANDS_SEPARATOR to 44 // ","
        Set_Attribute DF_DECIMAL_SEPARATOR   to 46 // "." number format 10,000.00
    End_Procedure        
            
End_Class

/* NO ERROR DIALOG IN BATCH MODE (Nils 2026-08-03).

   A headless run that pops a modal is not headless: the box waits for a click that will
   never come, and a build hangs until its timeout instead of failing. Nils's first real
   /bm run over the Order Entry workspace raised 40 engine errors and stopped for a YesNo
   box on each one.

   Errors are NOT swallowed, only their DIALOG is. Everything that records them is
   untouched: Error_Count is maintained by the runtime (the engine reads it for the
   "Process ended with: N Error(s)" line in the log), and each one is already written to
   StatLog by cRefactorStatusLog.Log_Status - the rows behind the "Refactor Engine Error
   log" toolbar button. So a batch run still reports how many errors it hit and still keeps
   every detail; it just does not stop to ask about them.

   AUGMENTS THE DESKTOP because that is where an unhandled error ends up
   (cRefactorStatusLog.Error_Report forwards there for anything outside its own save), so
   this is the one place that catches all of them regardless of which object raised it.

   Interactive runs are completely unaffected - the guard is pbBatchMode, and the ghoApplication
   test covers an error raised before the application object exists, when there is no flag to
   read and the dialog is the right answer anyway. */
Procedure Error_Report for cDesktop Integer iErrNum Integer iErrLine String sErrMsg
    Boolean bBatch

    Move False to bBatch
    If (ghoApplication <> 0) ;
        Get pbBatchMode of ghoApplication to bBatch
    If (bBatch = True) ;
        Procedure_Return
    Forward Send Error_Report iErrNum iErrLine sErrMsg
End_Procedure
