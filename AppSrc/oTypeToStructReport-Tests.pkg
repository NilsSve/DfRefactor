    Object oTypeToStructReport is a cTestFixture
        Set psFunctionName to "TypeToStructReport"

        // A simple Type with two Integer fields -> Struct with two Integer members.
        { Published = True }
        Procedure TypeToStructReport_BasicTwoFields
            String[] asBlock asResult
            Move 'Type tPoint'        to asBlock[0]
            Move 'Field x AS Integer' to asBlock[1]
            Move 'Field y AS Integer' to asBlock[2]
            Move 'End_Type'           to asBlock[3]
            Get _TypeDefToStruct of ghoFuncLib asBlock to asResult
            Send Assert (SizeOfArray(asResult) = 4)
            Send AssertSAreEqual 'Struct tPoint' asResult[0]
            Send AssertSAreEqual '    Integer iX' asResult[1]
            Send AssertSAreEqual '    Integer iY' asResult[2]
            Send AssertSAreEqual 'End_Struct'     asResult[3]
        End_Procedure

        // A sized String and an array field -> sized members: String 30 -> String[30],
        // Integer 5 -> Integer[5] (the byte layout is preserved).
        { Published = True }
        Procedure TypeToStructReport_SizedAndArrayFields
            String[] asBlock asResult
            Move 'Type tRec'                to asBlock[0]
            Move 'Field sName AS String 30' to asBlock[1]
            Move 'Field aVals AS Integer 5' to asBlock[2]
            Move 'End_Type'                 to asBlock[3]
            Get _TypeDefToStruct of ghoFuncLib asBlock to asResult
            Send Assert (SizeOfArray(asResult) = 4)
            Send AssertSAreEqual 'Struct tRec'         asResult[0]
            Send AssertSAreEqual '    String[30] sName' asResult[1]
            Send AssertSAreEqual '    Integer[5] iAVals' asResult[2]
            Send AssertSAreEqual 'End_Struct'          asResult[3]
        End_Procedure

        // Comments and other non-Type/Field/End_Type lines pass through unchanged, so the
        // worksheet keeps the author's notes and flags anything it could not parse.
        { Published = True }
        Procedure TypeToStructReport_PassesThroughComments
            String[] asBlock asResult
            Move 'Type tX'            to asBlock[0]
            Move '    // a note'      to asBlock[1]
            Move 'Field a AS Integer' to asBlock[2]
            Move 'End_Type'           to asBlock[3]
            Get _TypeDefToStruct of ghoFuncLib asBlock to asResult
            Send Assert (SizeOfArray(asResult) = 4)
            Send AssertSAreEqual 'Struct tX'     asResult[0]
            Send AssertSAreEqual '    // a note'  asResult[1]
            Send AssertSAreEqual '    Integer iA' asResult[2]
            Send AssertSAreEqual 'End_Struct'     asResult[3]
        End_Procedure

        // Finds every Type...End_Type definition in a file's lines (powers the package catalog).
        { Published = True }
        Procedure TypeToStructReport_CatalogsTypeDefs
            String[] asLines
            tTypeDef[] aDefs

            Move 'Use Foo.pkg'          to asLines[0]
            Move 'Type tA'              to asLines[1]
            Move 'Field x AS Integer'   to asLines[2]
            Move 'End_Type'             to asLines[3]
            Move 'Procedure Bar'        to asLines[4]
            Move 'Type tB'              to asLines[5]
            Move 'Field s AS String 10' to asLines[6]
            Move 'End_Type'             to asLines[7]
            Get _TypeDefsFromLines of ghoFuncLib asLines to aDefs
            Send Assert (SizeOfArray(aDefs) = 2)
            Send AssertSAreEqual 'tA' aDefs[0].sName
            Send Assert (SizeOfArray(aDefs[0].asBlock) = 3)
            Send AssertSAreEqual 'tB' aDefs[1].sName
        End_Procedure

        // Pulls the used Type names out of the accessors (ZeroType operand + At <type>.<field>),
        // de-duplicating repeats of the same type.
        { Published = True }
        Procedure TypeToStructReport_ExtractsUsedTypeNames
            String[] asLines asUsed
            Move 'ZeroType tTcItem to sTcItem'                 to asLines[0]
            Move 'Put TCIF_TEXT to sTcItem At tTcItem.mask'    to asLines[1]
            Move 'Put lpszText to sTcItem At tTcItem.pszText'  to asLines[2]
            Move 'Move 1 to x'                                 to asLines[3]
            Move 'Size_of_Field tOther fld to iSz'             to asLines[4]
            Get _UsedTypeNamesFromLines of ghoFuncLib asLines to asUsed
            Send Assert (SizeOfArray(asUsed) = 2)
            Send Assert (SearchArray("tTcItem", asUsed, Desktop, RefFunc(DFSTRICMP)) <> -1)
            Send Assert (SearchArray("tOther", asUsed, Desktop, RefFunc(DFSTRICMP)) <> -1)
        End_Procedure

        // PART 2 suggestion: a GetBuff field-read -> a direct Struct member Move, with the member
        // prefixed to match PART 1 (message -> iMessage, looked up in the catalog).
        { Published = True }
        Procedure TypeToStructReport_SuggestsGetBuffRead
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Move 'tPrMsg' to aCatalog[0].sName
            Move 'Type tPrMsg'                         to aCatalog[0].asBlock[0]
            Move '    Field tPrMsg.message as Integer' to aCatalog[0].asBlock[1]
            Move 'End_Type'                            to aCatalog[0].asBlock[2]
            Get _SplitSourceWords of ghoFuncLib 'GetBuff from sMsg At tPrMsg.message to iPendingMessage' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send AssertSAreEqual 'Move TheData.iMessage to iPendingMessage' sSuggest
        End_Procedure

        // With the field's Type NOT in the catalog, the suggestion falls back to the bare field name.
        { Published = True }
        Procedure TypeToStructReport_SuggestFallsBackWithoutCatalog
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Get _SplitSourceWords of ghoFuncLib 'GetBuff from sMsg At tPrMsg.message to iPendingMessage' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send AssertSAreEqual 'Move TheData.message to iPendingMessage' sSuggest
        End_Procedure

        // A Put field-write -> Move <src> to TheData.<prefixed field>.
        { Published = True }
        Procedure TypeToStructReport_SuggestsPutWrite
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Move 'tTcItem' to aCatalog[0].sName
            Move 'Type tTcItem'                      to aCatalog[0].asBlock[0]
            Move '    Field tTcItem.mask as Integer' to aCatalog[0].asBlock[1]
            Move 'End_Type'                          to aCatalog[0].asBlock[2]
            Get _SplitSourceWords of ghoFuncLib 'Put TCIF_TEXT to sTcItem At tTcItem.mask' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send AssertSAreEqual 'Move TCIF_TEXT to TheData.iMask' sSuggest
        End_Procedure

        // ArrayPut <val> to <arr> At <Type>.<field> <idx> -> a Move into a Struct[] element, with the
        // field prefixed from the catalog (message -> iMessage).
        { Published = True }
        Procedure TypeToStructReport_SuggestsArrayPut
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Move 'tPrMsg' to aCatalog[0].sName
            Move 'Type tPrMsg'                         to aCatalog[0].asBlock[0]
            Move '    Field tPrMsg.message as Integer' to aCatalog[0].asBlock[1]
            Move 'End_Type'                            to aCatalog[0].asBlock[2]
            Get _SplitSourceWords of ghoFuncLib 'ArrayPut iVal TO aMsg AT tPrMsg.message 3' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send Assert (sSuggest contains "Move iVal to TheData[i].iMessage")
        End_Procedure

        // ZeroType -> the buffer becomes a (zeroed) Struct local; the suggestion names Type + buffer.
        { Published = True }
        Procedure TypeToStructReport_SuggestsZeroTypeAsStructDecl
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Get _SplitSourceWords of ghoFuncLib 'ZeroType tTcItem to sTcItem' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send Assert (sSuggest contains "tTcItem TheData")
            Send Assert (sSuggest contains "Struct local")
            Send Assert (sSuggest contains "sTcItem -> TheData")
        End_Procedure

        // A non-accessor line (or one with no <Type>.<field>) yields no suggestion.
        { Published = True }
        Procedure TypeToStructReport_NoSuggestionForNonAccessor
            String[] asWords
            tTypeDef[] aCatalog
            String sSuggest
            Get _SplitSourceWords of ghoFuncLib 'Move 1 to x' to asWords
            Get _SuggestStructLine of ghoFuncLib asWords aCatalog to sSuggest
            Send AssertSAreEqual '' sSuggest
        End_Procedure

        // _FieldAfterDot drops the Type prefix; a token with no dot yields "".
        { Published = True }
        Procedure TypeToStructReport_FieldAfterDot
            String sField
            Get _FieldAfterDot of ghoFuncLib 'tPrMsg.message' to sField
            Send AssertSAreEqual 'message' sField
            Get _FieldAfterDot of ghoFuncLib 'noDotHere' to sField
            Send AssertSAreEqual '' sField
        End_Procedure

        // Older type-first field syntax ("<datatype> <TypeName>.<field>", e.g. a Win32 MSG Type) ->
        // clean Struct members: the "<TypeName>." byte-offset prefix is stripped. Regression for the
        // tPrMsg report that came through as "Handle tPrMsg.hwnd".
        { Published = True }
        Procedure TypeToStructReport_OlderTypeFirstSyntax
            String[] asBlock asResult

            Move 'Type tPrMsg'               to asBlock[0]
            Move '    Handle tPrMsg.hwnd'     to asBlock[1]
            Move '    Integer tPrMsg.message' to asBlock[2]
            Move '    Pointer tPrMsg.pt'      to asBlock[3]
            Move 'End_Type'                  to asBlock[4]
            Get _TypeDefToStruct of ghoFuncLib asBlock to asResult
            Send Assert (SizeOfArray(asResult) = 5)
            Send AssertSAreEqual 'Struct tPrMsg'      asResult[0]
            Send AssertSAreEqual '    Handle hwnd'     asResult[1]
            Send AssertSAreEqual '    Integer iMessage' asResult[2]
            Send AssertSAreEqual '    Pointer pt'       asResult[3]
            Send AssertSAreEqual 'End_Struct'         asResult[4]
        End_Procedure

        // The "Field <TypeName>.<field> as <type>" form (the real tPrMsg syntax) -> clean Hungarian
        // members. Regression for "Handle tPrMsg.hwnd" coming through with the prefix.
        { Published = True }
        Procedure TypeToStructReport_FieldDottedSyntax
            String[] asBlock asResult

            Move 'Type tPrMsg'                         to asBlock[0]
            Move '    Field tPrMsg.hwnd    as Handle'  to asBlock[1]
            Move '    Field tPrMsg.message as Integer' to asBlock[2]
            Move '    Field tPrMsg.pt      as Pointer' to asBlock[3]
            Move 'End_Type'                           to asBlock[4]
            Get _TypeDefToStruct of ghoFuncLib asBlock to asResult
            Send Assert (SizeOfArray(asResult) = 5)
            Send AssertSAreEqual 'Struct tPrMsg'       asResult[0]
            Send AssertSAreEqual '    Handle hwnd'      asResult[1]
            Send AssertSAreEqual '    Integer iMessage' asResult[2]
            Send AssertSAreEqual '    Pointer pt'       asResult[3]
            Send AssertSAreEqual 'End_Struct'          asResult[4]
        End_Procedure

        // _HungarianMember: prefix by type with the first letter upper-cased; skip when already
        // prefixed; unmapped type -> bare name.
        { Published = True }
        Procedure TypeToStructReport_HungarianMember
            String s
            Get _HungarianMember of ghoFuncLib 'Integer' 'message' to s
            Send AssertSAreEqual 'iMessage' s
            Get _HungarianMember of ghoFuncLib 'Handle' 'hwnd' to s
            Send AssertSAreEqual 'hwnd' s
            Get _HungarianMember of ghoFuncLib 'DWord' 'Time' to s
            Send AssertSAreEqual 'dwTime' s
            Get _HungarianMember of ghoFuncLib 'NoSuchType' 'foo' to s
            Send AssertSAreEqual 'foo' s
        End_Procedure

        // _ParseTypeField: both legacy field forms parse to (bareName, dataType); a non-field -> False.
        { Published = True }
        Procedure TypeToStructReport_ParseTypeField
            String sBare sDt sCt
            Boolean b
            Get _ParseTypeField of ghoFuncLib 'Field tPrMsg.hwnd as Handle' (&sBare) (&sDt) (&sCt) to b
            Send Assert (b = True)
            Send AssertSAreEqual 'hwnd'   sBare
            Send AssertSAreEqual 'Handle' sDt
            Get _ParseTypeField of ghoFuncLib '    Integer tMsg.message' (&sBare) (&sDt) (&sCt) to b
            Send Assert (b = True)
            Send AssertSAreEqual 'message' sBare
            Send AssertSAreEqual 'Integer' sDt
            Get _ParseTypeField of ghoFuncLib '// just a comment' (&sBare) (&sDt) (&sCt) to b
            Send Assert (b = False)
        End_Procedure

        // A whole-line comment yields NO source words, so its prose is never harvested as a Type name
        // (the comment "...no rounding at all." had been mis-read as the Type "all"). Regression for
        // the false-positive "--- all (definition not found) ---" PART 1 row.
        { Published = True }
        Procedure TypeToStructReport_WholeLineCommentNotTokenized
            String[] asWords asLines asUsed
            Get _SplitSourceWords of ghoFuncLib '//   a value will perform no rounding at all.  A zero' to asWords
            Send Assert (SizeOfArray(asWords) = 0)
            Move '//   a value will perform no rounding at all.  A zero' to asLines[0]
            Get _UsedTypeNamesFromLines of ghoFuncLib asLines to asUsed
            Send Assert (SizeOfArray(asUsed) = 0)
        End_Procedure

        // MARSHALED classification: a buffer bound to a Type (ZeroType) has its address taken
        // (GetAddress OF) and is passed to a Windows_Message - the real LegacyApp myDayPlanner pattern.
        { Published = True }
        Procedure TypeToStructReport_MarshaledTypeDetected
            String[] asLines asMarshaled
            Move 'Zerotype tSYSTEMTIME to sSystemTime'              to asLines[0]
            Move 'GetAddress OF sSystemTime to pSystemTime'         to asLines[1]
            Move 'Put iDay to sSystemTime AT tSYSTEMTIME.wDay'      to asLines[2]
            Move 'Send Windows_Message SZDPM_SETDATE 0 pSystemTime' to asLines[3]
            Get _MarshaledTypeNames of ghoFuncLib asLines to asMarshaled
            Send Assert (SizeOfArray(asMarshaled) = 1)
            Send AssertSAreEqual 'tSYSTEMTIME' asMarshaled[0]
        End_Procedure

        // PURE classification: a Type used only via ZeroType + Put/GetBuff, with NO address ever taken,
        // is an in-app record -> not marshaled (safe to convert).
        { Published = True }
        Procedure TypeToStructReport_PureTypeNotMarshaled
            String[] asLines asMarshaled
            Move 'ZeroType tRec to sRec'                 to asLines[0]
            Move 'Put 5 to sRec AT tRec.count'           to asLines[1]
            Move 'GetBuff from sRec AT tRec.count to iN' to asLines[2]
            Get _MarshaledTypeNames of ghoFuncLib asLines to asMarshaled
            Send Assert (SizeOfArray(asMarshaled) = 0)
        End_Procedure

        // MARSHALED via the AddressOf(<buf>) function form (not the GetAddress command).
        { Published = True }
        Procedure TypeToStructReport_MarshaledViaAddressOf
            String[] asLines asMarshaled
            Move 'ZeroType tMsg to sMsg'          to asLines[0]
            Move 'Move (AddressOf(sMsg)) to pMsg' to asLines[1]
            Move 'Put 1 to sMsg AT tMsg.id'       to asLines[2]
            Get _MarshaledTypeNames of ghoFuncLib asLines to asMarshaled
            Send Assert (SizeOfArray(asMarshaled) = 1)
            Send AssertSAreEqual 'tMsg' asMarshaled[0]
        End_Procedure

        // _AccessorTypeBuffer parses the (Type, buffer) binding out of each accessor form; a non-accessor
        // returns False.
        { Published = True }
        Procedure TypeToStructReport_AccessorTypeBuffer
            String[] asWords
            String sType sBuffer
            Boolean b

            Get _SplitSourceWords of ghoFuncLib 'ZeroType tX to sBuf' to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to b
            Send Assert b
            Send AssertSAreEqual 'tX'   sType
            Send AssertSAreEqual 'sBuf' sBuffer
            Get _SplitSourceWords of ghoFuncLib 'GetBuff from sBuf AT tX.field to dest' to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to b
            Send Assert b
            Send AssertSAreEqual 'tX'   sType
            Send AssertSAreEqual 'sBuf' sBuffer
            Get _SplitSourceWords of ghoFuncLib 'Put val to sBuf AT tX.field' to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to b
            Send Assert b
            Send AssertSAreEqual 'tX'   sType
            Send AssertSAreEqual 'sBuf' sBuffer
            Get _SplitSourceWords of ghoFuncLib 'Move 1 to x' to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to b
            Send AssertFalse b
        End_Procedure

        // _AddressTakenVar extracts the operand of GetAddress OF / AddressOf(); "" when no address taken.
        { Published = True }
        Procedure TypeToStructReport_AddressTakenVar
            String s
            Get _AddressTakenVar of ghoFuncLib 'GetAddress OF sSystemTime to pSystemTime' to s
            Send AssertSAreEqual 'sSystemTime' s
            Get _AddressTakenVar of ghoFuncLib 'Move (AddressOf(sMsg)) to pMsg' to s
            Send AssertSAreEqual 'sMsg' s
            // Space between AddressOf and "(" - the real LegacyApp cSystemInfo form (was a false-negative).
            Get _AddressTakenVar of ghoFuncLib 'Move (GetNativeSystemInfoEf (AddressOf (sSystemInfo))) To iVoid' to s
            Send AssertSAreEqual 'sSystemInfo' s
            Get _AddressTakenVar of ghoFuncLib 'Move 1 to x' to s
            Send AssertSAreEqual '' s
        End_Procedure

        // Regression for the SYSTEM_INFO false-negative: the real cSystemInfo pattern ('AddressOf (buf)'
        // with a space) must classify the Type as MARSHALED.
        { Published = True }
        Procedure TypeToStructReport_MarshaledViaAddressOfSpaced
            String[] asLines asMarshaled
            Move 'ZeroType SYSTEM_INFO To sSystemInfo'                             to asLines[0]
            Move 'Move (GetNativeSystemInfoEf (AddressOf (sSystemInfo))) To iVoid' to asLines[1]
            Move 'GetBuff From sSystemInfo At SYSTEM_INFO.dwNumberOfProcessors To iN' to asLines[2]
            Get _MarshaledTypeNames of ghoFuncLib asLines to asMarshaled
            Send Assert (SizeOfArray(asMarshaled) = 1)
            Send AssertSAreEqual 'SYSTEM_INFO' asMarshaled[0]
        End_Procedure

        /* ---- TIER 2: the legacy Type -> shipped tWin<X> Struct converter (2026-08-31) ----------
           Every test here points the catalogue at a fixture tWinStructs.pkg through
           psWinStructPkgOverride. Without that seam the runner's plain cApplication yields no target
           install, the catalogue loads empty, and the verification refuses everything - a green
           fixture exercising nothing. */
        Function T2_WriteCatalog Returns String
            String sPath
            Integer iCh
            // In the Windows TEMP folder since 2026-10-05, not in the workspace's Data folder as before (Nils:
            // "I saw them in the Data folder and thought they had landed in the wrong folder"). The file stays
            // on disk after the run - the catalogue reads it when it is first asked - and Data is the folder
            // a deploy zip is made from. vFolderFormat gives the separator whatever the API hands back.
            // vGetTempPath is a method of the Desktop, not a global function: called with no object it
            // compiles and answers nothing.
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_tWinStructsFixture.pkg") to sPath
            Get rfOpenOutput sPath to iCh
            If (iCh < 0) ;
                Function_Return ""
            Writeln channel iCh "Struct tWinPoint"
            Writeln channel iCh "    Integer x"
            Writeln channel iCh "    Integer y"
            Writeln channel iCh "End_Struct"
            Writeln channel iCh ""
            Writeln channel iCh "Struct tWinRect"
            Writeln channel iCh "    Integer left"
            Writeln channel iCh "    Integer top"
            Writeln channel iCh "    Integer right"
            Writeln channel iCh "    Integer bottom"
            Writeln channel iCh "End_Struct"
            Writeln channel iCh ""
            Writeln channel iCh "Struct tWinPaintStruct"
            Writeln channel iCh "    Handle hdc"
            Writeln channel iCh "    Integer fErase"
            Writeln channel iCh "    tWinRect rcPaint"
            Writeln channel iCh "End_Struct"
            Send rfCloseOutput iCh
            Set psWinStructPkgOverride of ghoFuncLib to sPath
            Set pbWinStructCatalogLoaded of ghoFuncLib to False
            Function_Return sPath
        End_Function

        // The name rule is a candidate; the INSTALL is the authority. A pair whose struct the target
        // does not declare is refused, however well the name matches.
        {Published = True}
        Procedure Tier2_UnknownStructIsRefused
            String sPath
            Boolean b
            Move (T2_WriteCatalog(Self)) to sPath
            Send Assert (sPath <> "")
            Get _WinStructExists of ghoFuncLib "tWinPoint" to b
            Send Assert b
            // tWinTvItem is a real pair, absent from THIS catalogue - so it must not verify.
            Get _WinStructExists of ghoFuncLib "tWinTvItem" to b
            Send Assert (b = False)
        End_Procedure

        /* A dotted path is WALKED, which is the whole reason the old flat spelling and the new
           nested one are comparable: the Type wrote rcPaint.left as one field name, the struct
           writes tWinRect rcPaint, and both reach the same source text. */
        {Published = True}
        Procedure Tier2_NestedFieldPathResolves
            String sPath
            Boolean b
            Move (T2_WriteCatalog(Self)) to sPath
            Get _WinStructHasField of ghoFuncLib "tWinPaintStruct" "rcPaint.left" to b
            Send Assert b
            Get _WinStructHasField of ghoFuncLib "tWinPaintStruct" "hdc" to b
            Send Assert b
            // ...and a member that does not exist does not resolve.
            Get _WinStructHasField of ghoFuncLib "tWinPaintStruct" "rcPaint.middle" to b
            Send Assert (b = False)
            Get _WinStructHasField of ghoFuncLib "tWinPaintStruct" "ptOrigin.x" to b
            Send Assert (b = False)
        End_Procedure

        // An empty catalogue must refuse, never wave through: a missing install is not evidence
        // that a field exists.
        {Published = True}
        Procedure Tier2_EmptyCatalogueFailsClosed
            Boolean b
            Set psWinStructPkgOverride   of ghoFuncLib to "C:\no\such\tWinStructs.pkg"
            Set pbWinStructCatalogLoaded of ghoFuncLib to False
            Get _WinStructExists of ghoFuncLib "tWinPoint" to b
            Send Assert (b = False)
            Get _WinStructHasField of ghoFuncLib "tWinPoint" "x" to b
            Send Assert (b = False)
        End_Procedure

        // The candidate table: a legacy Type DataFlex replaced has a twin; one it did not, has none.
        {Published = True}
        Procedure Tier2_TwinNameCandidates
            String s
            Get _WinStructTwinName of ghoFuncLib "tPOINT" to s
            Send AssertSAreEqual "tWinPOINT" s
            Get _WinStructTwinName of ghoFuncLib "tpoint" to s
            Send AssertSAreEqual "tWinPOINT" s
            // tWindowPlacement restructures its members; since slice 2 it carries a member map,
            // so it HAS a twin - see Tier2_MappedPairHasATwin.
            Get _WinStructTwinName of ghoFuncLib "tWindowPlacement" to s
            Send AssertSAreEqual "tWinWindowPlacement" s
            // ...and a Type with no shipped struct at all.
            Get _WinStructTwinName of ghoFuncLib "tRegKeyInfo" to s
            Send AssertSAreEqual "" s
        End_Procedure

        /* THE WHOLE IDIOM, including the taken address that Tier 1 refuses. This is the shape
           cApplication.pkg itself uses, and the reason Tier 2 exists. */
        {Published = True}
        Procedure Tier2_ConvertsTheWholeCluster
            String[] asCode asNotes
            String sPath
            Integer iConv i iZero
            Move (T2_WriteCatalog(Self)) to sPath
            Move 'Procedure DoIt'                                to asCode[0]
            Move '    String sPt'                                to asCode[1]
            Move '    Pointer aPt'                               to asCode[2]
            Move '    Integer iY'                                to asCode[3]
            Move '    ZeroType tPOINT to sPt'                    to asCode[4]
            Move '    Put 4 to sPt At tPOINT.x'                  to asCode[5]
            Move '    Move (AddressOf(sPt)) to aPt'              to asCode[6]
            Move '    GetBuff from sPt At tPOINT.y to iY'        to asCode[7]
            Move 'End_Procedure'                                 to asCode[8]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 1 iConv
            /* THE FILE NOW DEPENDS ON tWinStructs.pkg. Every buffer this tier retypes is
               retyped to a struct the INSTALL declares, so a file without the Use names a
               type it cannot resolve (Nils 2026-09-01, apply_hide_tab_page.pkg). */
            Send AssertSAreEqual 'Use tWinStructs.pkg' asCode[0]
            // the declaration is retyped...
            Send AssertSAreEqual '    tWinPOINT sPt' asCode[2]
            // ...the ZeroType is GONE (a Struct local is already zero)...
            Move 0 to iZero
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "ZeroType") ;
                    Increment iZero
            Loop
            Send AssertIAreEqual 0 iZero
            // ...the accessors became plain Moves, indentation kept...
            Send AssertSAreEqual '    Move 4 to sPt.x'      asCode[5]
            Send AssertSAreEqual '    Move sPt.y to iY'     asCode[7]
            // ...and the taken address is untouched, which is the point of the tier.
            Send AssertSAreEqual '    Move (AddressOf(sPt)) to aPt' asCode[6]
        End_Procedure

        // A declaration sharing its line with another variable is refused: retyping it would
        // silently retype the neighbour too.
        {Published = True}
        Procedure Tier2_SharedDeclarationLineIsRefused
            String[] asCode asNotes
            String sPath
            Integer iConv
            Move (T2_WriteCatalog(Self)) to sPath
            Move 'Procedure DoIt'                        to asCode[0]
            Move '    String sPt sOther'                 to asCode[1]
            Move '    ZeroType tPOINT to sPt'            to asCode[2]
            Move '    Put 4 to sPt At tPOINT.x'          to asCode[3]
            Move 'End_Procedure'                          to asCode[4]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 0 iConv
            Send AssertSAreEqual '    String sPt sOther' asCode[1]
            Send AssertIAreEqual 5 (SizeOfArray(asCode))
        End_Procedure

        // A field the struct does not carry refuses the cluster rather than emitting a member that
        // will not compile - the restructured pairs are exactly this case.
        {Published = True}
        Procedure Tier2_UnknownFieldRefusesTheCluster
            String[] asCode asNotes
            String sPath
            Integer iConv
            Move (T2_WriteCatalog(Self)) to sPath
            Move 'Procedure DoIt'                             to asCode[0]
            Move '    String sPt'                             to asCode[1]
            Move '    ZeroType tPOINT to sPt'                 to asCode[2]
            Move '    Put 4 to sPt At tPOINT.notAMember'      to asCode[3]
            Move 'End_Procedure'                               to asCode[4]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 0 iConv
            Send AssertSAreEqual '    ZeroType tPOINT to sPt' asCode[2]
        End_Procedure

        // Idempotent: a converted cluster has no accessors left, so a second pass finds nothing.
        {Published = True}
        Procedure Tier2_SecondPassChangesNothing
            String[] asCode asNotes
            String sPath
            Integer iConv iSize
            Move (T2_WriteCatalog(Self)) to sPath
            Move 'Procedure DoIt'                        to asCode[0]
            Move '    String sPt'                        to asCode[1]
            Move '    Integer iY'                        to asCode[2]
            Move '    ZeroType tPOINT to sPt'            to asCode[3]
            Move '    GetBuff from sPt At tPOINT.y to iY' to asCode[4]
            Move 'End_Procedure'                          to asCode[5]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 1 iConv
            Move (SizeOfArray(asCode)) to iSize
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 0 iConv
            Send AssertIAreEqual iSize (SizeOfArray(asCode))
        End_Procedure

        // A literal containing " to " must not cut the source expression in the wrong place - the
        // reason the slice runs over a length-preserving mask instead of the word splitter.
        {Published = True}
        Procedure Tier2_LiteralWithKeywordSurvives
            String[] asCode asNotes
            String sPath
            Integer iConv
            Move (T2_WriteCatalog(Self)) to sPath
            Move 'Procedure DoIt'                                     to asCode[0]
            Move '    String sPt'                                     to asCode[1]
            Move '    ZeroType tPOINT to sPt'                         to asCode[2]
            Move ('    Put (Length("go to bed")) to sPt At tPOINT.x')  to asCode[3]
            Move 'End_Procedure'                                       to asCode[4]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "t.vw" (&asNotes) to iConv
            Send AssertIAreEqual 1 iConv
            Send AssertSAreEqual ('    Move (Length("go to bed")) to sPt.x') asCode[3]
        End_Procedure


        /* ---- The MAPPED pairs (2026-08-31, slice 2) -------------------------------------------
           tWindowPlacement and tTvInsertStruct did not merely nest their members, they RENAMED the
           head: the old Type spelled the nesting into the field name with a Hungarian prefix
           (ptMinPosition.x, rcNormalPosition.left) and the struct made the nesting real and dropped
           it (tWinPoint MinPosition, tWinRect NormalPosition). Only the head segment moves, which
           is why the map is three entries rather than eleven. */
        Function T2_WriteMappedCatalog Returns String
            String sPath
            Integer iCh
            // In the Windows TEMP folder since 2026-10-05, not in the workspace's Data folder as before (Nils:
            // "I saw them in the Data folder and thought they had landed in the wrong folder"). The file stays
            // on disk after the run - the catalogue reads it when it is first asked - and Data is the folder
            // a deploy zip is made from. vFolderFormat gives the separator whatever the API hands back.
            // vGetTempPath is a method of the Desktop, not a global function: called with no object it
            // compiles and answers nothing.
            Move (vFolderFormat(vGetTempPath(Desktop)) + "DFRefactorTests_tWinStructsMapped.pkg") to sPath
            Get rfOpenOutput sPath to iCh
            If (iCh < 0) ;
                Function_Return ""
            Writeln channel iCh "Struct tWinPoint"
            Writeln channel iCh "    Integer x"
            Writeln channel iCh "    Integer y"
            Writeln channel iCh "End_Struct"
            Writeln channel iCh ""
            Writeln channel iCh "Struct tWinRect"
            Writeln channel iCh "    Integer left"
            Writeln channel iCh "    Integer top"
            Writeln channel iCh "    Integer right"
            Writeln channel iCh "    Integer bottom"
            Writeln channel iCh "End_Struct"
            Writeln channel iCh ""
            Writeln channel iCh "Struct tWinWindowPlacement"
            Writeln channel iCh "    DWord length"
            Writeln channel iCh "    DWord flags"
            Writeln channel iCh "    DWord showCmd"
            Writeln channel iCh "    tWinPoint MinPosition"
            Writeln channel iCh "    tWinPoint MaxPosition"
            Writeln channel iCh "    tWinRect NormalPosition"
            Writeln channel iCh "End_Struct"
            Send rfCloseOutput iCh
            Set psWinStructPkgOverride   of ghoFuncLib to sPath
            Set pbWinStructCatalogLoaded of ghoFuncLib to False
            Function_Return sPath
        End_Function

        // The map translates only the HEAD segment, and leaves everything else exactly as written.
        {Published = True}
        Procedure Tier2_MemberMapTranslatesTheHeadOnly
            String s
            Get _WinStructMapField of ghoFuncLib "tWindowPlacement" "ptMinPosition.x" to s
            Send AssertSAreEqual "MinPosition.x" s
            Get _WinStructMapField of ghoFuncLib "tWindowPlacement" "rcNormalPosition.bottom" to s
            Send AssertSAreEqual "NormalPosition.bottom" s
            // an unmapped member of a mapped pair passes through...
            Get _WinStructMapField of ghoFuncLib "tWindowPlacement" "showCmd" to s
            Send AssertSAreEqual "showCmd" s
            // ...and so does every field of an unmapped pair.
            Get _WinStructMapField of ghoFuncLib "tPOINT" "x" to s
            Send AssertSAreEqual "x" s
            // The other mapped pair.
            Get _WinStructMapField of ghoFuncLib "tTvInsertStruct" "tTvItemEx.mask" to s
            Send AssertSAreEqual "TvItemEx.mask" s
        End_Procedure

        // The mapped pair now HAS a twin - the assertion that used to pin its deliberate absence.
        {Published = True}
        Procedure Tier2_MappedPairHasATwin
            String s
            Get _WinStructTwinName of ghoFuncLib "tWindowPlacement" to s
            Send AssertSAreEqual "tWinWindowPlacement" s
            Get _WinStructTwinName of ghoFuncLib "tTvInsertStruct" to s
            Send AssertSAreEqual "tWinTvInsertStruct" s
            // ...and the map itself only exists for those two.
            Get _WinStructMemberMap of ghoFuncLib "tPOINT" to s
            Send AssertSAreEqual "" s
        End_Procedure

        // A mapped field resolves on the struct only AFTER translation - the old spelling must not.
        {Published = True}
        Procedure Tier2_MappedFieldResolvesOnlyTranslated
            String sPath sMapped
            Boolean b
            Move (T2_WriteMappedCatalog(Self)) to sPath
            Send Assert (sPath <> "")
            Get _WinStructHasField of ghoFuncLib "tWinWindowPlacement" "ptMinPosition.x" to b
            Send Assert (b = False)
            Get _WinStructMapField of ghoFuncLib "tWindowPlacement" "ptMinPosition.x" to sMapped
            Get _WinStructHasField of ghoFuncLib "tWinWindowPlacement" sMapped to b
            Send Assert b
        End_Procedure

        /* THE REPORTED CASE, verbatim from WinServ's VDFTranslator.pkg - the cluster that started
           this: a marshaled buffer (AddressOf), the Type's generated _size constant, and a member
           the struct kept (.length, .showCmd) beside ones it renamed. */
        {Published = True}
        Procedure Tier2_WindowPlacementClusterConverts
            String[] asCode asNotes
            String sPath
            Integer iConv i iZero
            Move (T2_WriteMappedCatalog(Self)) to sPath
            Move 'Procedure Load_Environment'                                          to asCode[0]
            Move '    String sWindowPlacement'                                          to asCode[1]
            Move '    Pointer aWindowPlacement'                                         to asCode[2]
            Move '    Integer eShowCmd'                                                 to asCode[3]
            Move '    ZeroType tWindowPlacement to sWindowPlacement'                    to asCode[4]
            Move '    Put tWindowPlacement_size to sWindowPlacement At tWindowPlacement.length' to asCode[5]
            Move '    Move (AddressOf(sWindowPlacement)) to aWindowPlacement'           to asCode[6]
            Move '    GetBuff from sWindowPlacement At tWindowPlacement.showCmd to eShowCmd' to asCode[7]
            Move '    Put 0 to sWindowPlacement At tWindowPlacement.rcNormalPosition.left' to asCode[8]
            Move 'End_Procedure'                                                        to asCode[9]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "v.pkg" (&asNotes) to iConv
            Send AssertIAreEqual 1 iConv
            Send AssertSAreEqual '    tWinWindowPlacement sWindowPlacement' asCode[2]
            Move 0 to iZero
            For i from 0 to (SizeOfArray(asCode) - 1)
                If (asCode[i] contains "ZeroType") ;
                    Increment iZero
            Loop
            Send AssertIAreEqual 0 iZero
            // the _size constant becomes the struct's own size, and .length is unmapped
            Send AssertSAreEqual '    Move (SizeOfType(tWinWindowPlacement)) to sWindowPlacement.length' asCode[5]
            // AddressOf untouched - the marshalling this tier exists to permit
            Send AssertSAreEqual '    Move (AddressOf(sWindowPlacement)) to aWindowPlacement' asCode[6]
            Send AssertSAreEqual '    Move sWindowPlacement.showCmd to eShowCmd' asCode[7]
            // ...and the RENAMED member is emitted as the struct spells it
            Send AssertSAreEqual '    Move 0 to sWindowPlacement.NormalPosition.left' asCode[8]
        End_Procedure

        // A map that named a member the struct does not carry must fail at VERIFICATION, not emit
        // code that will not compile. Pinned with a field outside the map and outside the struct.
        {Published = True}
        Procedure Tier2_MappedPairStillRefusesAnUnknownField
            String[] asCode asNotes
            String sPath
            Integer iConv
            Move (T2_WriteMappedCatalog(Self)) to sPath
            Move 'Procedure DoIt'                                              to asCode[0]
            Move '    String sWP'                                              to asCode[1]
            Move '    ZeroType tWindowPlacement to sWP'                        to asCode[2]
            Move '    Put 1 to sWP At tWindowPlacement.ptNoSuchThing.x'        to asCode[3]
            Move 'End_Procedure'                                                to asCode[4]
            Get _LegacyTypeToWinStructInLines of ghoFuncLib (&asCode) "v.pkg" (&asNotes) to iConv
            Send AssertIAreEqual 0 iConv
            Send AssertSAreEqual '    ZeroType tWindowPlacement to sWP' asCode[2]
        End_Procedure

        /* THE GRADED LINES COME BACK WITH THE VERDICT (2026-08-31, Tier 2). A converter has to
           rewrite exactly what the grading looked at; re-deriving the scope in a second walk is how
           the two would drift apart, and the grader already has the line numbers. iDeclLine is the
           String declaration, aiAccLines every accessor - both 1-BASED, like iFirstLine. */
        {Published = True}
        Procedure TypeToStructReport_ClusterReturnsItsLines
            String[] asLines
            tTypeBufferCluster[] aClusters

            Move 'Procedure DoIt'                          to asLines[0]
            Move '    Local String sBuf'                   to asLines[1]
            Move '    ZeroType tPoint to sBuf'             to asLines[2]
            Move '    Put iX to sBuf At tPoint.x'          to asLines[3]
            Move '    GetBuff from sBuf At tPoint.y to iY' to asLines[4]
            Move 'End_Procedure'                           to asLines[5]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send AssertIAreEqual 1 (SizeOfArray(aClusters))
            Send AssertIAreEqual 2 aClusters[0].iDeclLine
            Send AssertIAreEqual 3 (SizeOfArray(aClusters[0].aiAccLines))
            Send AssertIAreEqual 3 aClusters[0].aiAccLines[0]
            Send AssertIAreEqual 4 aClusters[0].aiAccLines[1]
            Send AssertIAreEqual 5 aClusters[0].aiAccLines[2]
        End_Procedure

        {Published = True}
        Procedure TypeToStructReport_ClusterCleanLocalBuffer
            String[] asLines
            tTypeBufferCluster[] aClusters

            Move 'Procedure DoIt'                          to asLines[0]
            Move '    Local String sBuf'                   to asLines[1]
            Move '    ZeroType tPoint to sBuf'             to asLines[2]
            Move '    Put iX to sBuf At tPoint.x'          to asLines[3]
            Move '    GetBuff from sBuf At tPoint.y to iY' to asLines[4]
            Move 'End_Procedure'                           to asLines[5]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Send AssertSAreEqual 'tPoint'  aClusters[0].sTypeName
            Send AssertSAreEqual 'DoIt'    aClusters[0].sScope
            Send AssertSAreEqual 'sBuf'    aClusters[0].sBuffer
            Send AssertSAreEqual 'test.vw' aClusters[0].sFile
            Send Assert (aClusters[0].iBindings = 3)
            Send Assert (aClusters[0].iFirstLine = 3)
            Send Assert (SizeOfArray(aClusters[0].asBlockers) = 0)
        End_Procedure

        // A buffer bound to TWO Types is the reused-byte-block pattern: both Types' rows carry the
        // shared-buffer blocker (there is no single Struct instance to rewrite to).
        { Published = True }
        Procedure TypeToStructReport_ClusterSharedBufferBlocked
            String[] asLines
            tTypeBufferCluster[] aClusters

            Move 'Procedure DoIt'                    to asLines[0]
            Move '    Local String sBuf'             to asLines[1]
            Move '    Put iX to sBuf At tPoint.x'    to asLines[2]
            Move '    Put iZ to sBuf At tOther.z'    to asLines[3]
            Move 'End_Procedure'                     to asLines[4]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 2)
            Send AssertSAreEqual 'tPoint' aClusters[0].sTypeName
            Send AssertSAreEqual 'tOther' aClusters[1].sTypeName
            Send Assert (SizeOfArray(aClusters[0].asBlockers) > 0)
            Send Assert (aClusters[0].asBlockers[0] contains "more than one Type")
            Send Assert (SizeOfArray(aClusters[1].asBlockers) > 0)
        End_Procedure

        // Any use of the buffer BEYOND the accessors (here a Move alias) blocks the cluster and the
        // blocker cites the offending line; the declaration line itself never counts as a use.
        { Published = True }
        Procedure TypeToStructReport_ClusterEscapeUseBlocked
            String[] asLines
            tTypeBufferCluster[] aClusters
            Move 'Procedure DoIt'                 to asLines[0]
            Move '    Local String sBuf'          to asLines[1]
            Move '    ZeroType tPoint to sBuf'    to asLines[2]
            Move '    Move sBuf to sSave'         to asLines[3]
            Move 'End_Procedure'                  to asLines[4]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Send Assert (SizeOfArray(aClusters[0].asBlockers) = 1)
            Send Assert (aClusters[0].asBlockers[0] contains "outside the byte-buffer accessors")
            Send Assert (aClusters[0].asBlockers[0] contains "line 4")
        End_Procedure

        // A buffer with NO String declaration in the file (here a method parameter) is not a
        // file-local conversion - the no-declaration blocker fires.
        { Published = True }
        Procedure TypeToStructReport_ClusterParameterBufferBlocked
            String[] asLines
            tTypeBufferCluster[] aClusters
            Boolean bDeclBlocked
            Integer i iLast

            Move 'Procedure DoIt String sBuf'     to asLines[0]
            Move '    Put iX to sBuf At tPoint.x' to asLines[1]
            Move 'End_Procedure'                  to asLines[2]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Move False to bDeclBlocked
            Move (SizeOfArray(aClusters[0].asBlockers) - 1) to iLast
            For i from 0 to iLast
                If (aClusters[0].asBlockers[i] contains "no String declaration") ;
                    Move True to bDeclBlocked
            Loop
            Send Assert bDeclBlocked
        End_Procedure

        // SCOPE PRECISION: the same buffer name in two methods (each with its own Local) is TWO
        // independent clusters - no false shared-Type blocker, both clean.
        { Published = True }
        Procedure TypeToStructReport_ClusterScopeSeparation
            String[] asLines
            tTypeBufferCluster[] aClusters

            Move 'Procedure ProcA'                to asLines[0]
            Move '    Local String sBuf'          to asLines[1]
            Move '    Put iX to sBuf At tA.x'     to asLines[2]
            Move 'End_Procedure'                  to asLines[3]
            Move 'Procedure ProcB'                to asLines[4]
            Move '    Local String sBuf'          to asLines[5]
            Move '    Put iY to sBuf At tB.y'     to asLines[6]
            Move 'End_Procedure'                  to asLines[7]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 2)
            Send AssertSAreEqual 'tA'    aClusters[0].sTypeName
            Send AssertSAreEqual 'ProcA' aClusters[0].sScope
            Send Assert (SizeOfArray(aClusters[0].asBlockers) = 0)
            Send AssertSAreEqual 'tB'    aClusters[1].sTypeName
            Send AssertSAreEqual 'ProcB' aClusters[1].sScope
            Send Assert (SizeOfArray(aClusters[1].asBlockers) = 0)
        End_Procedure

        // A FILE-SCOPE buffer (the gosub-era global style) merges its bindings from every method
        // into ONE "(file)" cluster, graded across the whole file.
        { Published = True }
        Procedure TypeToStructReport_ClusterFileScopeBufferMerges
            String[] asLines
            tTypeBufferCluster[] aClusters

            Move 'String gsBuf'                             to asLines[0]
            Move 'Procedure ProcA'                          to asLines[1]
            Move '    Put iX to gsBuf At tA.x'              to asLines[2]
            Move 'End_Procedure'                            to asLines[3]
            Move 'Procedure ProcB'                          to asLines[4]
            Move '    GetBuff from gsBuf At tA.y to iY'     to asLines[5]
            Move 'End_Procedure'                            to asLines[6]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Send AssertSAreEqual 'tA'     aClusters[0].sTypeName
            Send AssertSAreEqual '(file)' aClusters[0].sScope
            Send Assert (aClusters[0].iBindings = 2)
            Send Assert (SizeOfArray(aClusters[0].asBlockers) = 0)
        End_Procedure

        // FillType (no mechanical Struct form) and byte-offset arithmetic on the Type each block
        // the cluster with their own named reason.
        { Published = True }
        Procedure TypeToStructReport_ClusterFillTypeAndOffsetBlocked
            String[] asLines
            tTypeBufferCluster[] aClusters
            Boolean bFill bOffset
            Integer i iLast

            Move 'Procedure DoIt'                     to asLines[0]
            Move '    Local String sBuf'              to asLines[1]
            Move '    FillType tA to sBuf'            to asLines[2]
            Move '    Offset_of_Field tA.x to iOff'   to asLines[3]
            Move 'End_Procedure'                      to asLines[4]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Move False to bFill
            Move False to bOffset
            Move (SizeOfArray(aClusters[0].asBlockers) - 1) to iLast
            For i from 0 to iLast
                If (aClusters[0].asBlockers[i] contains "FillType") ;
                    Move True to bFill
                If (aClusters[0].asBlockers[i] contains "byte-offset") ;
                    Move True to bOffset
            Loop
            Send Assert bFill
            Send Assert bOffset
        End_Procedure

        // The used-Type detector is VERB-GATED: a char-mode print-position "At x.y" on a
        // non-accessor line must NOT mint a phantom used Type (the LegacyApp2 transdate/FormRow
        // "definition not found" noise rows), and Offset_of_Field's dotted "<Type>.<field>"
        // form strips to the bare Type so the catalog lookup matches.
        { Published = True }
        Procedure TypeToStructReport_UsedTypeNamesVerbGated
            String[] asLines asUsed
            Move 'Print sTotal At FormRow.3'          to asLines[0]
            Move 'Showln sName At transdate.7'           to asLines[1]
            Move 'Offset_of_Field tRec.sName to iOff' to asLines[2]
            Move 'Put iX to sBuf At tReal.x'          to asLines[3]
            Get _UsedTypeNamesFromLines of ghoFuncLib asLines to asUsed
            Send Assert (SizeOfArray(asUsed) = 2)
            Send Assert (SearchArray("tRec", asUsed, Desktop, RefFunc(DFSTRICMP)) <> -1)
            Send Assert (SearchArray("tReal", asUsed, Desktop, RefFunc(DFSTRICMP)) <> -1)
            Send Assert (SearchArray("FormRow", asUsed, Desktop, RefFunc(DFSTRICMP)) = -1)
        End_Procedure

        // An address-taken buffer is marshaled to native code - the cluster blocks even though the
        // helper is graded standalone (the report additionally excludes the whole Type via the
        // MARSHALED tag).
        { Published = True }
        Procedure TypeToStructReport_ClusterAddressTakenBlocked
            String[] asLines
            tTypeBufferCluster[] aClusters
            Boolean bAddr
            Integer i iLast

            Move 'Procedure DoIt'                        to asLines[0]
            Move '    Local String sBuf'                 to asLines[1]
            Move '    ZeroType tA to sBuf'               to asLines[2]
            Move '    Move (AddressOf(sBuf)) to pBuf'    to asLines[3]
            Move 'End_Procedure'                         to asLines[4]
            Get _TypeClustersFromLines of ghoFuncLib asLines "test.vw" to aClusters
            Send Assert (SizeOfArray(aClusters) = 1)
            Move False to bAddr
            Move (SizeOfArray(aClusters[0].asBlockers) - 1) to iLast
            For i from 0 to iLast
                If (aClusters[0].asBlockers[i] contains "ADDRESS is taken") ;
                    Move True to bAddr
            Loop
            Send Assert bAddr
        End_Procedure

        /* ---- THE PACKAGE-QUALIFIED TYPE REFERENCE ---------------------------------------------
           DataFlex lets a Type declared in a Use'd package be reached as "<Package>$<Type>.<field>".
           Taking everything before the dot yields "Dates$SystemTime", which names no Type anywhere,
           so those clusters were graded against an impossible name and refused for a reason that
           was not the true one (Nils 2026-09-01, VDFQuery's fvsystempounder.pkg). */
        {Published = True}
        Procedure TypeName_PackageQualifierIsStripped
            String s
            Get _TypeBeforeDot of ghoFuncLib "Dates$SystemTime.iHour" to s
            Send AssertSAreEqual "SystemTime" s
            // the ordinary form is untouched...
            Get _TypeBeforeDot of ghoFuncLib "tPrMsg.message" to s
            Send AssertSAreEqual "tPrMsg" s
            // ...as is an undotted Type name, which ZeroType passes in whole.
            Get _TypeBeforeDot of ghoFuncLib "tPrMsg" to s
            Send AssertSAreEqual "tPrMsg" s
            Get _TypeBeforeDot of ghoFuncLib "Dates$SystemTime" to s
            Send AssertSAreEqual "SystemTime" s
            // a token that is nothing but a qualifier names no Type
            Get _TypeBeforeDot of ghoFuncLib ".field" to s
            Send AssertSAreEqual "" s
        End_Procedure

        // ...and the accessor parser now reports the real Type, so the cluster is graded against a
        // name that can actually be looked up. THE REPORTED LINE, verbatim.
        {Published = True}
        Procedure Accessor_PackageQualifiedTypeIsRead
            String[] asWords
            String sType sBuffer
            Boolean bOK
            Get _SplitSourceWords of ghoFuncLib "    getbuff from lsValue at Dates$SystemTime.iHour to liHour" to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to bOK
            Send Assert bOK
            Send AssertSAreEqual "SystemTime" sType
            Send AssertSAreEqual "lsValue"    sBuffer
        End_Procedure

        // The qualifier is stripped on ZeroType too, where the Type arrives whole rather than dotted.
        {Published = True}
        Procedure Accessor_PackageQualifiedZeroTypeIsRead
            String[] asWords
            String sType sBuffer
            Boolean bOK
            Get _SplitSourceWords of ghoFuncLib "    ZeroType Dates$SystemTime to lsValue" to asWords
            Get _AccessorTypeBuffer of ghoFuncLib asWords (&sType) (&sBuffer) to bOK
            Send Assert bOK
            Send AssertSAreEqual "SystemTime" sType
            Send AssertSAreEqual "lsValue"    sBuffer
        End_Procedure

    End_Object
