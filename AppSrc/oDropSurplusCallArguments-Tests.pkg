//****************************************************************************
// $Module type: Test fixture
// $Module name: oDropSurplusCallArguments-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-04
//
// Description : Unit tests for the DropSurplusCallArguments refactor function - the arithmetic
//               half of E 4379 (LegacyApp PlanView.VW: a one-parameter fHeadValue called with two).
//               The rewrite must be provably nothing at run time, so most of these are REFUSALS.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oDropSurplusCallArguments is a cTestFixture
        Set psFunctionName to "DropSurplusCallArguments"

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure

        // The LegacyApp line, verbatim: the second argument goes, the sibling call with a matching count
        // (fporder declares two) is not touched, the declaration is not touched.
        { Published = True }
        Procedure DropSurplus_EntryItem_DropsTheSecondArgument
            String[] asCode
            Integer iCount
            Move '        Function fHeadValue Number nono Returns Number'                     to asCode[0]
            Move '        End_Function'                                                        to asCode[1]
            Move '            Entry_Item (fporder(Self, plandetail.ref, plandetail.porder))'      to asCode[2]
            Move '            Entry_Item (fheadvalue(Self, plandetail.ref, plandetail.porder))'  to asCode[3]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "fHeadValue|1" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '        Function fHeadValue Number nono Returns Number'                 asCode[0]
            Send AssertSAreEqual '            Entry_Item (fporder(Self, plandetail.ref, plandetail.porder))'  asCode[2]
            Send AssertSAreEqual '            Entry_Item (fheadvalue(Self, plandetail.ref))'               asCode[3]
        End_Procedure

        // The Move shape, two surplus arguments, indent and trailing comment preserved.
        { Published = True }
        Procedure DropSurplus_MoveForm_DropsTwo_KeepsIndentAndComment
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, iB, iC)) to iR // note'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Move (Calc(Self, iA)) to iR // note' asCode[0]
        End_Procedure

        // Down to no arguments at all: "(Self)" is what remains.
        { Published = True }
        Procedure DropSurplus_ToZero_LeavesSelfAlone
            String[] asCode
            Integer iCount
            Move '    Move (RowCount(Self, iX)) to iN'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "RowCount|0" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Move (RowCount(Self)) to iN' asCode[0]
        End_Procedure

        // POSITIVE CONTROL: a call whose count already fits is not touched.
        { Published = True }
        Procedure DropSurplus_MatchedCount_Untouched
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|2" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA, iB)) to iR' asCode[0]
        End_Procedure

        // Too FEW arguments is never "fixed" - the old runtime handed the method blanks it may rely on.
        { Published = True }
        Procedure DropSurplus_TooFew_Untouched
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|2" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA)) to iR' asCode[0]
        End_Procedure

        // A surplus argument that is itself a call could have side effects - "changes nothing" no longer holds.
        { Published = True }
        Procedure DropSurplus_NestedCallInSurplus_LeftAlone
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, String(iB))) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA, String(iB))) to iR' asCode[0]
        End_Procedure

        // A nested call in a KEPT argument is fine - only the surplus is judged.
        { Published = True }
        Procedure DropSurplus_NestedCallInKeptArg_StillDrops
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, String(iA), iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Move (Calc(Self, String(iA))) to iR' asCode[0]
        End_Procedure

        // A call continued over lines is counted by the board on the joined line, but never rewritten here.
        { Published = True }
        Procedure DropSurplus_ContinuedCall_LeftAlone
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, ;'  to asCode[0]
            Move '               iB)) to iR'    to asCode[1]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA, ;' asCode[0]
        End_Procedure

        // A handle receiver is the OTHER 4379 row - measured against a declaration this file may not own.
        { Published = True }
        Procedure DropSurplus_HandleReceiver_LeftAlone
            String[] asCode
            Integer iCount
            Move '    Move (Calc(hoGrid, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
        End_Procedure

        // Identifier boundary: a longer name ending in the method name is not the method.
        { Published = True }
        Procedure DropSurplus_LongerName_LeftAlone
            String[] asCode
            Integer iCount
            Move '    Move (MyCalc(Self, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (MyCalc(Self, iA, iB)) to iR' asCode[0]
        End_Procedure

        // The masked twin: a call inside a string literal or a comment is invisible.
        { Published = True }
        Procedure DropSurplus_InsideLiteralOrComment_LeftAlone
            String[] asCode
            Integer iCount
            Move '    Move "Calc(Self, iA, iB)" to sText'          to asCode[0]
            Move '    // Move (Calc(Self, iA, iB)) to iR'          to asCode[1]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move "Calc(Self, iA, iB)" to sText' asCode[0]
            Send AssertSAreEqual '    // Move (Calc(Self, iA, iB)) to iR' asCode[1]
        End_Procedure

        // The name is matched without regard to case, as DataFlex resolves it.
        { Published = True }
        Procedure DropSurplus_CaseInsensitiveName
            String[] asCode
            Integer iCount
            Move '    Move (CALC(Self, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "calc|1" to iCount
            Send Assert (iCount = 1)
            Send AssertSAreEqual '    Move (CALC(Self, iA)) to iR' asCode[0]
        End_Procedure

        // Idempotent: a second run over the trimmed line finds nothing to do.
        { Published = True }
        Procedure DropSurplus_SecondRun_ChangesNothing
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 1)
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA)) to iR' asCode[0]
        End_Procedure

        // A blank or malformed parameter changes nothing - never a guess at which name or count.
        { Published = True }
        Procedure DropSurplus_BlankOrBadParameter_DoesNothing
            String[] asCode
            Integer iCount
            Move '    Move (Calc(Self, iA, iB)) to iR'  to asCode[0]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "" to iCount
            Send Assert (iCount = 0)
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc" to iCount
            Send Assert (iCount = 0)
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "Calc|x" to iCount
            Send Assert (iCount = 0)
            Get DropSurplusCallArguments of ghoFuncLib (&asCode) "|1" to iCount
            Send Assert (iCount = 0)
            Send AssertSAreEqual '    Move (Calc(Self, iA, iB)) to iR' asCode[0]
        End_Procedure

        // The per-run tally the board's dialog reports is the sum over the run, not the last file.
        { Published = True }
        Procedure DropSurplus_PerRunTally_Accumulates
            String[] asCode asCode2
            Integer iCount iTally
            Send _InitializeFuncLib of ghoFuncLib
            Move '    Move (Calc(Self, iA, iB)) to iR'  to asCode[0]
            Move '    Move (Calc(Self, iA, iC)) to iS'  to asCode2[0]
            Move '    Move (Calc(Self, iA, iD)) to iT'  to asCode2[1]
            Get DropSurplusCallArguments of ghoFuncLib (&asCode)  "Calc|1" to iCount
            Get DropSurplusCallArguments of ghoFuncLib (&asCode2) "Calc|1" to iCount
            Get piSurplusArgsDropped of ghoFuncLib to iTally
            Send Assert (iTally = 3)
        End_Procedure
    End_Object
