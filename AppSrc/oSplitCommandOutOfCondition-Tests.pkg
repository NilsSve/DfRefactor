//****************************************************************************
// $Module type: Test fixture
// $Module name: oSplitCommandOutOfCondition-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-05
//
// Description : SplitCommandOutOfCondition - the repair for compile error 52 "(operator) <WORD>": a
//               command that was wrapped into a condition, 'If (a = b Command args)', goes back out,
//               'If (a = b) Command args'. a workspace, 2026-09-05, one report file, six lines - the shape a converter left
//               when the word after the operand was a user #COMMAND no keyword list knew.
//
//               Pinned: the line as it was found; While / Else If; an and-chain; the end comment kept; and
//               every shape it must leave alone - a group that closes early, no comparison, an operator
//               after the operand (+ / max), a nested chain, a Move with parentheses, a comment line.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
    Object oSplitCommandOutOfCondition_Tests is a cTestFixture
        Set psFunctionName to "SplitCommandOutOfCondition"

        // Runs the converter on one line the way the engine and the analyzer's dry-run do.
        Function Run String sLine Boolean ByRef bChanged Returns String
            tTokenizer TokenizerData
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitCommandOutOfCondition of ghoFuncLib (&sLine) "" to bChanged
            Function_Return sLine
        End_Function

        {Published = True}
        Procedure SplitCommand_WrappedUserCommand
            String sOut
            Boolean bChanged
            Get Run '                If (Cust.Flag = "1" MyWritePos "*" 18.7 (FONT_DEFAULT))' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '                If (Cust.Flag = "1") MyWritePos "*" 18.7 (FONT_DEFAULT)' sOut
        End_Procedure

        {Published = True}
        Procedure SplitCommand_WhileAndElseIf
            String sOut
            Boolean bChanged
            Get Run '    While (i < 10 Increment i)' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '    While (i < 10) Increment i' sOut
            Get Run '    Else If (sMode = "A" Send DoA of oX)' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '    Else If (sMode = "A") Send DoA of oX' sOut
        End_Procedure

        {Published = True}
        Procedure SplitCommand_ChainAndEndComment
            String sOut
            Boolean bChanged
            Get Run '    If (a = 1 and b <> 2 Move 3 to c)' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '    If (a = 1 and b <> 2) Move 3 to c' sOut
            Get Run '    If (a = b Foo x) // note' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '    If (a = b) Foo x // note' sOut
            // a parenthesised operand and a masked string with a space: cut points still align
            Get Run '    If (Trim(sX) = "a b" DoIt (1))' (&bChanged) to sOut
            Send Assert bChanged
            Send AssertSAreEqual '    If (Trim(sX) = "a b") DoIt (1)' sOut
        End_Procedure

        // Every one of these is valid DataFlex, or not this shape - and must come back untouched.
        {Published = True}
        Procedure SplitCommand_LeavesOtherShapesAlone
            String[] asKeep
            String sOut
            Boolean bChanged
            Integer i
            Move '    If (a = b + 1)'                       to asKeep[0]
            Move '    If (a = b and c = d) Begin'           to asKeep[1]
            Move '    If (a = Trim(x)) Foo'                 to asKeep[2]
            Move '    If (a = b max c)'                     to asKeep[3]
            Move '    If (bFlag) Send Foo'                  to asKeep[4]
            Move '    If ((a = b) and (c = d))'             to asKeep[5]
            Move '    Move (a = b) to bX'                   to asKeep[6]
            Move '    // If (a = b Foo)'                    to asKeep[7]
            Move '    If (a = b)'                           to asKeep[8]
            Move '    If (sX = "Foo bar")'                  to asKeep[9]
            Move '    If (a = b contains c)'                to asKeep[10]
            For i from 0 to 10
                Get Run asKeep[i] (&bChanged) to sOut
                Send Assert (bChanged = False) asKeep[i]
                Send AssertSAreEqual asKeep[i] sOut
            Loop
        End_Procedure

        Procedure TearDown
            Send _InitializeFuncLib of ghoFuncLib
        End_Procedure
    End_Object
