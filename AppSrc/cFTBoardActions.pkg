Use RefactorConstants.h.pkg

/*  cFTBoardActions - the after-a-run utilities every board offers: Compare Source and Revert.

    THESE ARE FLOW-AGNOSTIC. Read log, Read other logs, Compare and Revert follow a refactoring run
    whichever flow produced it, which is why the action row is shared markup (cFTTileMarkup) and
    painted identically on all three boards. The two log entries are single Sends and each board just
    makes them; these two were not, and living only inside oDashboard_vw is what made them
    un-offerable anywhere else - the Manual board rendered both chips fully enabled and neither did
    anything (Nils 2026-08-02). A chip that looks live and is not is worse than one that is absent.

    THE REPAINT IS DELIBERATELY NOT HERE. RevertFromBackup ends when its modal closes; the caller
    then repaints ITS OWN action row, because a restore moves backups out of the folder and both the
    Revert count and the Compare gate go stale. Which board to repaint is exactly what differs, so
    the shared half stops at the work - the same split as cFTManualBoard.PickSingleFile.

    Also the way out for the guided trail, which still routes these four chips through the
    Dashboard's oDeferTimer - the last markup-adjacent borrow left after the untangle.
*/
Class cFTBoardActions is a cObject

    /* Compare before/after in the external file-compare tool - mirrors oCompare_MenuItem.OnExecute
       (DFRefactorFT.src). Workspace mode diffs the folder PATHS, single-file mode diffs the FILES;
       that branch is the whole reason this is not a one-liner. No board-specific half at all: the
       compare tool opens in its own window and nothing here needs repainting. */
    Procedure CompareSource
        String sCompareApp
        Boolean bWsMode
        Get psFileCompareApp of ghoApplication to sCompareApp
        Get pbWorkspaceMode  of ghoApplication to bWsMode
        If (bWsMode = True) ;
            Send ComparePaths of ghoApplication sCompareApp
        Else ;
            Send CompareFiles of ghoApplication sCompareApp
    End_Procedure

    /* Open the Undo dialog on this workspace's backup set. FillBackupFilesDialog is modal (Send
       Popup), so control returns only once the user closes it - which is why the caller can safely
       repaint immediately afterwards, with no modal still up. */
    Procedure RevertFromBackup
        tRFSearchResult[] BackupFiles
        Get AllBackupFolderFiles of ghoApplication to BackupFiles
        Send FillBackupFilesDialog of (Client_Id(ghoCommandBars)) BackupFiles
    End_Procedure

    /* Pop the modal Compiler Settings dialog. One Send - shared not to save lines but because WHICH
       dialog and where it hangs (oCompilerSetup_dg off the command bars, from CompilerSetupFT.dg) is
       the part a third board would otherwise have to rediscover. Blocks until closed; the caller then
       repaints, because the target version and the library verdicts that depend on it may both have
       changed. */
    Procedure OpenCompilerSettings
        Send Popup of (oCompilerSetup_dg(Client_Id(ghoCommandBars)))
    End_Procedure

    /* Drop one .sws from the saved recent list, by its index into ReadWorkspaceKeysFromRegistry
       (mirrors cCmdLinkButton.DeleteWorkspaceKey): read the list, remove that entry, CLEAR every
       RecentNN key, then rewrite the survivors - a partial rewrite would leave the tail of the old
       list behind. Its analyze snapshot goes too: keeping a verdict for a workspace the user has
       just forgotten is how a stale result resurfaces against the wrong .sws.

       Out of range is a no-op, not an error: the list is re-read here rather than trusted from the
       click, so a chip clicked after the list moved simply does nothing. */
    Procedure RemoveRecentWorkspace Integer iIdx
        String[] asRecent
        String sFileName
        Integer iSize iCount

        Get ReadWorkspaceKeysFromRegistry of ghoApplication to asRecent
        If (iIdx < 0 or iIdx >= (SizeOfArray(asRecent))) ;
            Procedure_Return
        Move asRecent[iIdx] to sFileName
        Move (RemoveFromArray(asRecent, iIdx)) to asRecent
        Get piWorkspaceItems of ghoApplication to iSize
        For iCount from 0 to iSize
            Send WriteString of ghoApplication CS_WorkspacesKey (CS_WorkspaceRecentKey + String(iCount)) ""
        Loop
        Move (SizeOfArray(asRecent) - 1) to iSize
        For iCount from 0 to iSize
            Send WriteString of ghoApplication CS_WorkspacesKey (CS_WorkspaceRecentKey + String(iCount)) asRecent[iCount]
        Loop
        Send ClearAnalyzeSnapshot of ghoApplication sFileName
    End_Procedure

End_Class

// One instance. Every board runs these through this handle and then repaints its own action row.
#IFNDEF ghoBoardActions
    Global_Variable Handle ghoBoardActions
    Move 0 to ghoBoardActions
#ENDIF

Object oBoardActions is a cFTBoardActions
    Move Self to ghoBoardActions
End_Object
