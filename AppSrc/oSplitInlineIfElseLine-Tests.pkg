    Object oSplitInlineIfElseLine is a cTestFixture
        Set psFunctionName to "SplitInlineIfElseLine"

        {Published = True}
        Procedure SplitInlineIfElseLine_1
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (WindowIndex = 0) Move "Go"   to sLabel' to sLine
            Move ('If (WindowIndex = 0) Begin' + C_NewLine + '    Move "Go"   to sLabel' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* A COMMAND WORD INSIDE A VARIABLE NAME (2026-10-31): the split position was a plain Pos of 'Open', which
           found it inside 'bOpen' - 'If (not( Begin' / 'bOpen)) Open hTable' / 'End'. */
        {Published = True}
        Procedure SplitInlineIfElseLine_CommandWordInsideAVariable
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (not(bOpen)) Open hTable' to sLine
            Move ('If (not(bOpen)) Begin' + C_NewLine + '    Open hTable' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        /* A NAME HOLDS '#', '$', '@' AND '.' TOO (2026-11-02): the command 'close' was found inside the variable 'close#',
           and the condition was gone: 'if Begin' / 'close# close file#' / 'End'. */
        {Published = True}
        Procedure SplitInlineIfElseLine_CommandWordInsideANameWithAHash
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move ('if close' + Character(35) + ' close file' + Character(35)) to sLine
            Move ('if close' + Character(35) + ' Begin' + C_NewLine + '    close file' + Character(35) + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // A variable with the very name of a command: no split could leave a condition on the If line, so none is made.
        {Published = True}
        Procedure SplitInlineIfElseLine_NoSplitThatLeavesNoCondition
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If Close Close hFile' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertFalse bChanged
            Send AssertSAreEqual 'If Close Close hFile' sLine
        End_Procedure

        /* THE MODE WORD OF A FIND IS NO COMPARISON (2026-10-31): the tokenizer bundled '(Found) Find lt Invoice'
           into one token, and with By and Find among the commands - as DataFlex 26's language has them - the split
           came before 'by': 'If (Found) Find lt Invoice Begin' / 'by Index.3' / 'End'. */
        {Published = True}
        Procedure SplitInlineIfElseLine_FindModeIsNoComparison
            String[] asCommands asSaved
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Get pasCommands of ghoFuncLib to asSaved
            Move asSaved to asCommands
            If (SearchArray("by", asCommands, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                Move "by" to asCommands[SizeOfArray(asCommands)]
            If (SearchArray("find", asCommands, Desktop, RefFunc(DFSTRICMP)) = -1) ;
                Move "find" to asCommands[SizeOfArray(asCommands)]
            Set pasCommands of ghoFuncLib to asCommands
            Move 'If (Found) Find lt Invoice by Index.3' to sLine
            Move ('If (Found) Begin' + C_NewLine + '    Find lt Invoice by Index.3' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Send Assert (SearchArray("Find", TokenizerData.asLineTokens, Desktop, RefFunc(DFSTRICMP)) <> -1) "Find is a token of its own"
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Set pasCommands of ghoFuncLib to asSaved
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_2
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (WindowIndex = 0) Move "Go"   to sLabel' to sLine
            Move ('If (WindowIndex = 0);' + C_NewLine + '    Move "Go"   to sLabel') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitBySemicolon to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_3
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (WindowIndex = 0) Move "Go"   to sLabel' to sLine
            Move ('If (WindowIndex = 0) ;' + C_NewLine + '    Move "Go"   to sLabel') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitBySpaceAndSemicolon to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        // Regression (2026-06-10): the UI parameter combo stores the enum NAME in
        // Functions.Parameter - the old bare Move of the name into the Integer enum
        // yielded eSplitUnknown from the UI. _ParameterIsEnum accepts both the NAME
        // string and the numeric constant; this is the NAME-string twin of test _2.
        {Published = True}
        Procedure SplitInlineIfElseLine_ByParameterName
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (WindowIndex = 0) Move "Go"   to sLabel' to sLine
            Move ('If (WindowIndex = 0);' + C_NewLine + '    Move "Go"   to sLabel') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) "eSplitBySemicolon" to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_4
            // Regression: keywords inside the condition (e.g. "and") must not be used as the split point
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (bShouldSave and user.jobbhist = 0) Move False to bShouldSave' to sLine
            Move ('If (bShouldSave and user.jobbhist = 0) Begin' + C_NewLine + '    Move False to bShouldSave' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_5
            // Regression: Goto must not be wrapped in a Begin/End block
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (RetVal =MBR_No) Goto forderreg_enter' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send Assert (bChanged = False)
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_6
            // Regression: Gosub must not be wrapped in a Begin/End block
            String sLine
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If (RetVal =MBR_No) Gosub forderreg_Cont' to sLine
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send Assert (bChanged = False)
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_7
            // Regression: unparenthesised condition must split at the command, not a condition keyword
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move 'If user.ut_sdat ne 0 DFWritePos (_("Uppsagt den")) 14.0 (FONT_BOLD)' to sLine
            Move ('If user.ut_sdat ne 0 Begin' + C_NewLine + '    DFWritePos (_("Uppsagt den")) 14.0 (FONT_BOLD)' + C_NewLine + 'End') to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

        {Published = True}
        Procedure SplitInlineIfElseLine_8
            // Regression: IF NOT (expr) pattern -- NOT must not be treated as second command
            String sLine sExpected
            Boolean bChanged
            tTokenizer TokenizerData
            Move "    IF NOT ('BIP' contains BALANCE_TYPE) MOVE 'I' TO BALANCE_TYPE" to sLine
            Move ("    IF NOT ('BIP' contains BALANCE_TYPE) Begin" + C_NewLine + "        MOVE 'I' TO BALANCE_TYPE" + C_NewLine + "    End") to sExpected
            Get Tokenizer of ghoFuncLib sLine to TokenizerData
            Get SplitInlineIfElseLine of ghoFuncLib (&sLine) eSplitToBeginEndBlock to bChanged
            Send AssertSAreEqual sExpected sLine
        End_Procedure

    End_Object
