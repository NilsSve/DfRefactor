//****************************************************************************
// $Module type: Test fixture
// $Module name: oQuickMarkStack-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-10
//
// Description : Unit tests for cQuickMarkStack - the stack behind the editor's Push / Pop
//               Quick Mark commands. The class is pure so that these can run in the console
//               runner, where there is no editor control; the Scintilla side (the margin
//               glyph, the line a marker has moved to, the jump) is the editor's and is not
//               under test here.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cQuickMarkStack.pkg

Object oQuickMarkStack is a cTestFixture
    Set psFunctionName to "QuickMarkStack"

    // A mark at a place. The column is derived so a test can tell one entry's column from another's.
    Function MarkFor String sFile Integer iLine Returns tQuickMark
        tQuickMark QM
        Move sFile        to QM.sFile
        Move iLine        to QM.iLine
        Move (iLine + 3)  to QM.iCol
        Function_Return QM
    End_Function

    /* THE ORDER. Three pushes across two files come back newest first, each with the file and
       line it was pushed with, and the stack is empty afterwards. */
    {Published = True}
    Procedure QuickMarks_PopReturnsTheNewestFirst
        Handle ho
        Boolean bOk
        tQuickMark QM

        Get Create (RefClass(cQuickMarkStack)) to ho
        Get MarkFor "C:\Work\AppSrc\First.pkg" 10 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Get MarkFor "C:\Work\AppSrc\Second.pkg" 20 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Get MarkFor "C:\Work\AppSrc\First.pkg" 30 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Send AssertIAreEqual 3 (Count(ho))

        Get PopMark of ho (&QM) to bOk
        Send Assert bOk
        Send AssertSAreEqual "C:\Work\AppSrc\First.pkg" QM.sFile
        Send AssertIAreEqual 30 QM.iLine
        Send AssertIAreEqual 33 QM.iCol
        Get PopMark of ho (&QM) to bOk
        Send Assert bOk
        Send AssertSAreEqual "C:\Work\AppSrc\Second.pkg" QM.sFile
        Send AssertIAreEqual 20 QM.iLine
        Get PopMark of ho (&QM) to bOk
        Send Assert bOk
        Send AssertIAreEqual 10 QM.iLine
        Send AssertIAreEqual 0 (Count(ho))
        Send Destroy of ho
    End_Procedure

    /* EMPTY. Pop and Top both say so and leave the caller's variable exactly as it was - the
       editor reads QM only when the answer is True, and a stale value would be a jump to nowhere. */
    {Published = True}
    Procedure QuickMarks_PopOnAnEmptyStackIsFalseAndLeavesTheOutputAlone
        Handle ho
        Boolean bOk
        tQuickMark QM

        Get Create (RefClass(cQuickMarkStack)) to ho
        Move "untouched" to QM.sFile
        Move 99 to QM.iLine
        Get PopMark of ho (&QM) to bOk
        Send AssertFalse bOk
        Send AssertSAreEqual "untouched" QM.sFile
        Send AssertIAreEqual 99 QM.iLine
        Get TopMark of ho (&QM) to bOk
        Send AssertFalse bOk
        Send AssertIAreEqual 99 QM.iLine
        Send AssertIAreEqual 0 (Count(ho))
        // Once something is there, popping it leaves the stack empty again - not at -1.
        Get MarkFor "C:\Work\AppSrc\First.pkg" 5 to QM
        Get PushMark of ho QM to bOk
        Get PopMark of ho (&QM) to bOk
        Send Assert bOk
        Get PopMark of ho (&QM) to bOk
        Send AssertFalse bOk
        Send AssertIAreEqual 0 (Count(ho))
        Send Destroy of ho
    End_Procedure

    /* THE ONE RULE A PLAIN STACK DOES NOT HAVE. Pushing the place already on top records nothing
       and says so; a different line in the same file pushes, the same line in another file
       pushes (it is a different place), and a spelling of the same file that differs only in
       case is the same file. */
    {Published = True}
    Procedure QuickMarks_PushingThePlaceOnTopAgainRecordsNothing
        Handle ho
        Boolean bOk
        tQuickMark QM

        Get Create (RefClass(cQuickMarkStack)) to ho
        Get MarkFor "C:\Work\AppSrc\First.pkg" 10 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Get PushMark of ho QM to bOk
        Send AssertFalse bOk
        Send AssertIAreEqual 1 (Count(ho))

        Get MarkFor "C:\Work\AppSrc\First.pkg" 11 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Send AssertIAreEqual 2 (Count(ho))

        Get MarkFor "C:\Work\AppSrc\Second.pkg" 11 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Send AssertIAreEqual 3 (Count(ho))

        Get MarkFor "c:\work\appsrc\SECOND.PKG" 11 to QM
        Get PushMark of ho QM to bOk
        Send AssertFalse bOk
        Send AssertIAreEqual 3 (Count(ho))

        // Only the TOP counts: the first place is still on the stack, and pushing it again is a
        // new entry (the user has been elsewhere since).
        Get MarkFor "C:\Work\AppSrc\First.pkg" 10 to QM
        Get PushMark of ho QM to bOk
        Send Assert bOk
        Send AssertIAreEqual 4 (Count(ho))
        Send Destroy of ho
    End_Procedure

    /* THE EDITOR'S WRITE-BACKS. SetLine and SetHandle change exactly the entry they name and
       nothing else; an index outside the stack is ignored rather than growing it; MarkAt reads
       the result back and answers an empty mark for an index that is not there. */
    {Published = True}
    Procedure QuickMarks_LineAndHandleWriteBacksReachTheEntry
        Handle ho
        Boolean bOk
        tQuickMark QM

        Get Create (RefClass(cQuickMarkStack)) to ho
        Get MarkFor "C:\Work\AppSrc\First.pkg" 10 to QM
        Get PushMark of ho QM to bOk
        Get MarkFor "C:\Work\AppSrc\Second.pkg" 20 to QM
        Get PushMark of ho QM to bOk

        Send SetLine   of ho 0 12
        Send SetHandle of ho 1 4711 3
        Get MarkAt of ho 0 to QM
        Send AssertIAreEqual 12 QM.iLine
        Send AssertIAreEqual 0  QM.iHandle
        Send AssertIAreEqual 0  QM.iGen
        Get MarkAt of ho 1 to QM
        Send AssertIAreEqual 20   QM.iLine
        Send AssertIAreEqual 4711 QM.iHandle
        Send AssertIAreEqual 3    QM.iGen

        Send SetLine   of ho 5 99
        Send SetHandle of ho -1 8 8
        Send AssertIAreEqual 2 (Count(ho))
        Get MarkAt of ho 5 to QM
        Send AssertSAreEqual "" QM.sFile
        Send AssertIAreEqual 0 QM.iLine

        // What the editor pops is the entry as written back, not as pushed.
        Get TopMark of ho (&QM) to bOk
        Send Assert bOk
        Send AssertIAreEqual 4711 QM.iHandle
        Get PopMark of ho (&QM) to bOk
        Get PopMark of ho (&QM) to bOk
        Send AssertIAreEqual 12 QM.iLine
        Send Destroy of ho
    End_Procedure

End_Object
