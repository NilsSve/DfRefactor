//****************************************************************************
// $Module type: Test fixture
// $Module name: oSymbolIndex-Tests
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
// Created     : 2026-09-10
//
// Description : Unit tests for cSymbolIndex - the name -> defining file and line index behind
//               the editor's Go to definition. The scanner is fed arrays, so the shapes it must
//               recognise (and the ones it must not) are pinned without touching the disk; the
//               lookup is fed keys built by that same scanner for two "files".
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cSymbolIndex.pkg

Object oSymbolIndex is a cTestFixture
    Set psFunctionName to "SymbolIndex"

    // True when the exact key "NAME|Kind|line|file|Name" is among asKeys - sName as spelt in the source.
    Function HasDef String[] ByRef asKeys String sName String sKind Integer iLine String sFile Returns Boolean
        Function_Return ((SearchArray((Uppercase(sName) + "|" + sKind + "|" + String(iLine) + "|" + sFile + "|" + sName), asKeys)) <> -1)
    End_Function

    /* EVERY SHAPE THAT DEFINES A NAME, one of each, at the line it stands on - and the total is
       exactly that many, so a line matched twice or a non-definition slipping through shows up
       as a count, not just as a missing key. Indented and tabbed lines count the same as
       column-zero ones. */
    {Published = True}
    Procedure SymbolIndex_EveryDefinitionShapeIsFound
        Handle ho
        String[] asL asKeys
        Integer iAdded

        Move "Use VdfBase.pkg"                                    to asL[0]    // 1
        Move "Struct tOrderLine"                                  to asL[1]    // 2
        Move "    Integer iQty"                                   to asL[2]    // 3
        Move "End_Struct"                                         to asL[3]    // 4
        Move "Define CS_Greeting for 'hello'"                     to asL[4]    // 5
        Move "Global_Variable Integer ghoOrders"                  to asL[5]    // 6
        Move "Enum_List"                                          to asL[6]    // 7
        Move "    eFirstMode"                                     to asL[7]    // 8
        Move "    eSecondMode for 5"                              to asL[8]    // 9
        Move "End_Enum_List"                                      to asL[9]    // 10
        Move "Class cOrderView is a cView"                        to asL[10]   // 11
        Move "    Procedure Construct_Object"                     to asL[11]   // 12
        Move "        Forward Send Construct_Object"              to asL[12]   // 13
        Move "        Property Integer piCount 0"                 to asL[13]   // 14
        Move "    End_Procedure"                                  to asL[14]   // 15
        Move (Character(9) + "Function TotalOf Integer iRow Returns Number") to asL[15]   // 16
        Move "    End_Function"                                   to asL[16]   // 17
        Move "    Procedure Set psTitle String sValue"            to asL[17]   // 18
        Move "    End_Procedure"                                  to asL[18]   // 19
        Move "End_Class"                                          to asL[19]   // 20
        Move "Object oOrderView is a cOrderView"                  to asL[20]   // 21
        Move "End_Object"                                         to asL[21]   // 22
        Move (Character(35) + "COMMAND ForEachRow R")             to asL[22]   // 23
        Move (Character(35) + "ENDCOMMAND")                       to asL[23]   // 24
        Move (Character(35) + "REPLACE MAX_ROWS 200")             to asL[24]   // 25
        Move "Type tLegacyBuffer"                                 to asL[25]   // 26
        Move "End_Type"                                           to asL[26]   // 27
        Move "lblRetry:"                                          to asL[27]   // 28
        Move "    Gosub lblRetry"                                 to asL[28]   // 29
        Move "Procedure DoGlobalThing Global"                     to asL[29]   // 30
        Move "End_Procedure"                                      to asL[30]   // 31

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsFromLines of ho (&asL) "X.pkg" (&asKeys) to iAdded
        Send Assert (HasDef(Self, &asKeys, "tOrderLine",    "Struct",        2,  "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "CS_Greeting",   "Define",        5,  "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "ghoOrders",     "Global",        6,  "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "eFirstMode",    "Enum",          8,  "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "eSecondMode",   "Enum",          9,  "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "cOrderView",    "Class",         11, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "Construct_Object", "Procedure",  12, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "piCount",       "Property",      14, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "TotalOf",       "Function",      16, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "psTitle",       "Procedure Set", 18, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "oOrderView",    "Object",        21, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "ForEachRow",    "Command",       23, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "MAX_ROWS",      "Replace",       25, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "tLegacyBuffer", "Type",          26, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "lblRetry",      "Label",         28, "X.pkg"))
        Send Assert (HasDef(Self, &asKeys, "DoGlobalThing", "Procedure",     30, "X.pkg"))
        Send AssertIAreEqual 16 iAdded
        Send AssertIAreEqual 16 (SizeOfArray(asKeys))
        Send AssertIAreEqual 31 (piLinesScanned(ho))
        Send Destroy of ho
    End_Procedure

    /* WHAT IS NOT A DEFINITION: a comment line, anything inside a comment block that starts at a
       line start, a Register_Procedure (a declaration), a keyword later in a line, the *_Return
       forms, and a "Class" line without its "is". The definition AFTER the block is found, which
       proves the block was closed and not merely skipped to the end. */
    {Published = True}
    Procedure SymbolIndex_CommentsAndDeclarationsAreNotDefinitions
        Handle ho
        String[] asL asKeys
        Integer iAdded

        Move "// Procedure Commented"                             to asL[0]    // 1
        Move "/* A block comment that spans lines."               to asL[1]    // 2
        Move "   Procedure InsideBlock"                           to asL[2]    // 3
        Move "   Class cInsideBlock is a cObject"                 to asL[3]    // 4
        Move "   ends here */"                                    to asL[4]    // 5
        Move "Register_Procedure DeclaredOnly"                    to asL[5]    // 6
        Move "Register_Function DeclaredFn Returns Integer"       to asL[6]    // 7
        Move "Send Procedure_Return_Value 1"                      to asL[7]    // 8
        Move "    Procedure_Return"                               to asL[8]    // 9
        Move "    Function_Return 0"                              to asL[9]    // 10
        Move "Move (Object oNotOne) to iX"                        to asL[10]   // 11
        Move "Class_Name cNotAClass"                              to asL[11]   // 12
        Move "Class cAlsoNot"                                     to asL[12]   // 13
        Move "/* one-line block */ Procedure NotEither"           to asL[13]   // 14
        Move "Procedure AfterTheBlock"                            to asL[14]   // 15
        Move "End_Procedure"                                      to asL[15]   // 16
        Move "Procedure"                                          to asL[16]   // 17 - broken, no name

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsFromLines of ho (&asL) "Y.pkg" (&asKeys) to iAdded
        Send Assert (HasDef(Self, &asKeys, "AfterTheBlock", "Procedure", 15, "Y.pkg"))
        Send AssertIAreEqual 1 iAdded
        Send AssertIAreEqual 1 (SizeOfArray(asKeys))
        Send Destroy of ho
    End_Procedure

    /* THE LOOKUP. Keys from two files, sorted the way BuildIndex sorts them: a name defined in
       both comes back twice with the right file and line each; the search is case-blind; a
       property's three faces (Property, Procedure Set, Function) all answer to the one name;
       and an unknown name, or a blank one, answers nothing. */
    {Published = True}
    Procedure SymbolIndex_DefinitionsOfIsCaseBlindAndFindsEveryFile
        Handle ho
        String[] asA asB asKeys
        tSymbolDef[] aDefs
        tSymbolDef D
        Integer iVoid

        Move "Class cAlpha is a cObject"                to asA[0]
        Move "    Procedure Construct_Object"           to asA[1]
        Move "        Property String psValue ''"       to asA[2]
        Move "    End_Procedure"                        to asA[3]
        Move "    Procedure Set psValue String sValue"  to asA[4]
        Move "    End_Procedure"                        to asA[5]
        Move "    Function psValue Returns String"      to asA[6]
        Move "    End_Function"                         to asA[7]
        Move "End_Class"                                to asA[8]
        Move "Object oBeta is a cAlpha"                 to asB[0]
        Move "    Procedure Construct_Object"           to asB[1]
        Move "    End_Procedure"                        to asB[2]
        Move "End_Object"                               to asB[3]

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsFromLines of ho (&asA) "C:\Work\AppSrc\Alpha.pkg" (&asKeys) to iVoid
        Get DefinitionsFromLines of ho (&asB) "C:\Work\AppSrc\Beta.vw"   (&asKeys) to iVoid
        Move (SortArray(asKeys)) to asKeys
        Set pasKeys of ho to asKeys

        Get DefinitionsOf of ho "construct_OBJECT" to aDefs
        Send AssertIAreEqual 2 (SizeOfArray(aDefs))
        // Same kind and line in both files, so key order is file order: Alpha before Beta. The
        // name comes back as the SOURCE spells it, not as the search spelt it.
        Move aDefs[0] to D
        Send AssertSAreEqual "Procedure" D.sKind
        Send AssertSAreEqual "C:\Work\AppSrc\Alpha.pkg" D.sFile
        Send AssertIAreEqual 2 D.iLine
        Send AssertSAreEqual "Construct_Object" D.sName
        Move aDefs[1] to D
        Send AssertSAreEqual "C:\Work\AppSrc\Beta.vw" D.sFile
        Send AssertIAreEqual 2 D.iLine
        Send AssertSAreEqual "Construct_Object" D.sName

        Get DefinitionsOf of ho "psValue" to aDefs
        Send AssertIAreEqual 3 (SizeOfArray(aDefs))
        Move aDefs[0] to D
        Send AssertSAreEqual "Function"      D.sKind
        Send AssertIAreEqual 7 D.iLine
        Move aDefs[1] to D
        Send AssertSAreEqual "Procedure Set" D.sKind
        Send AssertIAreEqual 5 D.iLine
        Move aDefs[2] to D
        Send AssertSAreEqual "Property"      D.sKind
        Send AssertIAreEqual 3 D.iLine
        Send AssertSAreEqual "psValue"       D.sName

        Get DefinitionsOf of ho "cAlpha" to aDefs
        Send AssertIAreEqual 1 (SizeOfArray(aDefs))
        Move aDefs[0] to D
        Send AssertSAreEqual "Class" D.sKind
        Send AssertIAreEqual 1 D.iLine
        Send AssertSAreEqual "C:\Work\AppSrc\Alpha.pkg" D.sFile

        Get DefinitionsOf of ho "cAlph" to aDefs          // a prefix is not a name
        Send AssertIAreEqual 0 (SizeOfArray(aDefs))
        Get DefinitionsOf of ho "NoSuchThing" to aDefs
        Send AssertIAreEqual 0 (SizeOfArray(aDefs))
        Get DefinitionsOf of ho "  " to aDefs
        Send AssertIAreEqual 0 (SizeOfArray(aDefs))
        Send Destroy of ho
    End_Procedure

    /* THE SPELLINGS OLDER CODE USES: a visibility keyword on either side of a property's name,
       a typed array property, a Global with an array type, and "Function X for Integer" - the
       name is still the word after the keyword. */
    {Published = True}
    Procedure SymbolIndex_OlderSpellingsStillNameTheRightWord
        Handle ho
        String[] asL asKeys
        Integer iAdded

        Move "Property Integer Private piHidden 0"        to asL[0]   // 1
        Move "Property Integer piShown Public 0"           to asL[1]   // 2
        Move "Property String[] pasNames"                  to asL[2]   // 3
        Move "Global_Variable Integer[] gaiCounts"         to asL[3]   // 4
        Move "Function OldStyle for Integer"               to asL[4]   // 5
        Move "Procedure Set Value Integer iItem String sV" to asL[5]   // 6

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsFromLines of ho (&asL) "Z.pkg" (&asKeys) to iAdded
        Send Assert (HasDef(Self, &asKeys, "piHidden",  "Property",      1, "Z.pkg"))
        Send Assert (HasDef(Self, &asKeys, "piShown",   "Property",      2, "Z.pkg"))
        Send Assert (HasDef(Self, &asKeys, "pasNames",  "Property",      3, "Z.pkg"))
        Send Assert (HasDef(Self, &asKeys, "gaiCounts", "Global",        4, "Z.pkg"))
        Send Assert (HasDef(Self, &asKeys, "OldStyle",  "Function",      5, "Z.pkg"))
        Send Assert (HasDef(Self, &asKeys, "Value",     "Procedure Set", 6, "Z.pkg"))
        Send AssertIAreEqual 6 iAdded
        Send Destroy of ho
    End_Procedure

    /* THE LIVE-BUFFER ANSWER. DefinitionsInLines scans an array and answers for one name only -
       every definition of it, with the file and line - and nothing for a name not in it. */
    {Published = True}
    Procedure SymbolIndex_DefinitionsInLinesAnswersForTheLiveBuffer
        Handle ho
        String[] asL
        tSymbolDef[] aDefs
        tSymbolDef D

        Move "Class cGamma is a cObject"                to asL[0]
        Move "    Procedure Set psValue String sValue"  to asL[1]
        Move "    End_Procedure"                        to asL[2]
        Move "    Function psValue Returns String"      to asL[3]
        Move "    End_Function"                         to asL[4]
        Move "End_Class"                                to asL[5]

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsInLines of ho (&asL) "C:\Work\AppSrc\Gamma.pkg" "PSVALUE" to aDefs
        Send AssertIAreEqual 2 (SizeOfArray(aDefs))
        Move aDefs[0] to D
        Send AssertSAreEqual "Procedure Set" D.sKind
        Send AssertIAreEqual 2 D.iLine
        Send AssertSAreEqual "C:\Work\AppSrc\Gamma.pkg" D.sFile
        Send AssertSAreEqual "psValue" D.sName
        Move aDefs[1] to D
        Send AssertSAreEqual "Function" D.sKind
        Send AssertIAreEqual 4 D.iLine
        Get DefinitionsInLines of ho (&asL) "C:\Work\AppSrc\Gamma.pkg" "cDelta" to aDefs
        Send AssertIAreEqual 0 (SizeOfArray(aDefs))
        Send Destroy of ho
    End_Procedure

    /* THE SAVE REFRESH. ReplaceFileDefinitions drops exactly one file's keys - matched without
       regard to case - adds the file's new ones, and leaves the index searchable (sorted): the
       moved definition is found at its new line, the deleted one is gone, the other file's two
       are untouched, and the total says nothing else changed. */
    {Published = True}
    Procedure SymbolIndex_ReplaceFileDefinitionsSwapsOneFilesKeysOnly
        Handle ho
        String[] asA asB asNew asKeys
        tSymbolDef[] aDefs
        tSymbolDef D
        Integer iVoid

        Move "Struct tOne"                    to asA[0]
        Move "End_Struct"                     to asA[1]
        Move "Procedure Gone"                 to asA[2]
        Move "End_Procedure"                  to asA[3]
        Move "Procedure Moved"                to asA[4]
        Move "End_Procedure"                  to asA[5]
        Move "Struct tTwo"                    to asB[0]
        Move "End_Struct"                     to asB[1]
        Move "Procedure Elsewhere"            to asB[2]
        Move "End_Procedure"                  to asB[3]

        Get Create (RefClass(cSymbolIndex)) to ho
        Get DefinitionsFromLines of ho (&asA) "C:\Work\AppSrc\Alpha.pkg" (&asKeys) to iVoid
        Get DefinitionsFromLines of ho (&asB) "C:\Work\AppSrc\Beta.pkg"  (&asKeys) to iVoid
        Move (SortArray(asKeys)) to asKeys
        Set pasKeys of ho to asKeys

        // Alpha saved again: Gone deleted, ten lines inserted above Moved.
        Move "Struct tOne"                    to asNew[0]
        Move "End_Struct"                     to asNew[1]
        Move "// ten lines of new comment"    to asNew[2]
        Move "// ..."                         to asNew[3]
        Move "// ..."                         to asNew[4]
        Move "// ..."                         to asNew[5]
        Move "// ..."                         to asNew[6]
        Move "// ..."                         to asNew[7]
        Move "// ..."                         to asNew[8]
        Move "// ..."                         to asNew[9]
        Move "// ..."                         to asNew[10]
        Move "// ..."                         to asNew[11]
        Move "Procedure Moved"                to asNew[12]
        Move "End_Procedure"                  to asNew[13]
        Send ReplaceFileDefinitions of ho "c:\work\appsrc\ALPHA.PKG" (&asNew)

        Get DefinitionsOf of ho "Moved" to aDefs
        Send AssertIAreEqual 1 (SizeOfArray(aDefs))
        Move aDefs[0] to D
        Send AssertIAreEqual 13 D.iLine
        // The path is stored as the SAVE spelt it - the index does not second-guess a caller's case.
        Send AssertSAreEqual "c:\work\appsrc\ALPHA.PKG" D.sFile
        Get DefinitionsOf of ho "Gone" to aDefs
        Send AssertIAreEqual 0 (SizeOfArray(aDefs))
        Get DefinitionsOf of ho "Elsewhere" to aDefs
        Send AssertIAreEqual 1 (SizeOfArray(aDefs))
        Get DefinitionsOf of ho "tTwo" to aDefs
        Send AssertIAreEqual 1 (SizeOfArray(aDefs))
        Get pasKeys of ho to asKeys
        Send AssertIAreEqual 4 (SizeOfArray(asKeys))
        Send Destroy of ho
    End_Procedure

    /* THE RANKING. Five definitions of one name - two under the Pkg folder, one elsewhere in the
       workspace, one beside the current file, one in it - come back nearest first, and the two
       Pkg ones keep their relative order. Paths compare without case. */
    {Published = True}
    Procedure SymbolIndex_RankingPutsTheNearestFirst
        Handle ho
        tSymbolDef[] aDefs aRanked
        tSymbolDef D

        Move "C:\Program Files\DataFlex 26.0\Pkg\cObject.pkg"   to aDefs[0].sFile
        Move 10                                                   to aDefs[0].iLine
        Move "C:\Work\Lib\AppSrc\cLibThing.pkg"                  to aDefs[1].sFile
        Move 20                                                   to aDefs[1].iLine
        Move "C:\Work\AppSrc\Neighbour.pkg"                      to aDefs[2].sFile
        Move 30                                                   to aDefs[2].iLine
        Move "C:\Work\AppSrc\Current.vw"                         to aDefs[3].sFile
        Move 40                                                   to aDefs[3].iLine
        Move "C:\Program Files\DataFlex 26.0\Pkg\cWebObject.pkg" to aDefs[4].sFile
        Move 50                                                   to aDefs[4].iLine

        Get Create (RefClass(cSymbolIndex)) to ho
        Get RankDefinitions of ho aDefs "c:\work\appsrc\CURRENT.VW" "C:\Program Files\DataFlex 26.0\Pkg" to aRanked
        Send AssertIAreEqual 5 (SizeOfArray(aRanked))
        Move aRanked[0] to D
        Send AssertIAreEqual 40 D.iLine
        Move aRanked[1] to D
        Send AssertIAreEqual 30 D.iLine
        Move aRanked[2] to D
        Send AssertIAreEqual 20 D.iLine
        Move aRanked[3] to D
        Send AssertIAreEqual 10 D.iLine
        Move aRanked[4] to D
        Send AssertIAreEqual 50 D.iLine
        // No current file and no Pkg folder: everything is tier 2 and the order is the input's.
        Get RankDefinitions of ho aDefs "" "" to aRanked
        Move aRanked[0] to D
        Send AssertIAreEqual 10 D.iLine
        Move aRanked[4] to D
        Send AssertIAreEqual 50 D.iLine
        Send Destroy of ho
    End_Procedure

    /* THE LOCK. A DF26 .sws.lock of the shape df-cli writes - dependencies keyed by
       "<host>/<owner>/<repo>.git/<sws stem>", each with a "ref" - yields every ref in file order,
       transitive ones included, since that is the whole point of reading the lock rather than
       the .sws. A lock with no dependencies member, and no lock at all, yield none. */
    {Published = True}
    Procedure SymbolIndex_LockPinnedRefsReadsEveryDependency
        Handle ho
        String sLock
        String[] asRefs

        Move '{ "dependencies": {' to sLock
        Move (sLock + ' "github.com/Someone/Library-One.git/One26.0": { "ref": "1111111111111111111111111111111111111111" },') to sLock
        Move (sLock + ' "github.com/Someone/Library-Two.git/Sub/Two26.0": { "ref": "2222222222222222222222222222222222222222" },') to sLock
        Move (sLock + ' "github.com/Someone/Library-Three.git/Three26.0": { "ref": "3333333333333333333333333333333333333333" }') to sLock
        Move (sLock + ' }, "lockVersion": "1.0.0" }') to sLock

        Get Create (RefClass(cSymbolIndex)) to ho
        Get LockPinnedRefs of ho sLock to asRefs
        Send AssertIAreEqual 3 (SizeOfArray(asRefs))
        Send AssertSAreEqual "1111111111111111111111111111111111111111" asRefs[0]
        Send AssertSAreEqual "2222222222222222222222222222222222222222" asRefs[1]
        Send AssertSAreEqual "3333333333333333333333333333333333333333" asRefs[2]
        Get LockPinnedRefs of ho '{ "lockVersion": "1.0.0" }' to asRefs
        Send AssertIAreEqual 0 (SizeOfArray(asRefs))
        Get LockPinnedRefs of ho "" to asRefs
        Send AssertIAreEqual 0 (SizeOfArray(asRefs))
        Send Destroy of ho
    End_Procedure

End_Object
