//****************************************************************************
// $Module type: Class
// $Module name: cPointerConverterBase
// $Author     : Nils Svedmyr, RDC Tools International, <mailto:support@rdctools.com>
// Web-site    : http://www.rdctools.com
//
// Description : What the three pointer converters share - cUnicodePointerToString,
//               cUnicodeStringToPointer and cWin64PointerTruncation. Each walks a file
//               method by method, keeping the names declared with a pointer-like type
//               and with the second type it cares about, so it can tell which bare
//               "Move <a> to <b>" lines are its business. The type test, the name sets
//               and the signature walk were three verbatim copies; they live here once.
//               The converters keep what differs: the second type they track and what
//               they do with a hit.
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use RefactorConstants.h.pkg

Class cPointerConverterBase is a cObject

    // True when the datatype keyword is pointer-like, for the 4539 conversion and the x64
    // truncation audit alike: DataFlex treats Address the same as Pointer in an assignment.
    // sType is the raw first token of a declaration line.
    Function IsPointerLikeType String sType Returns Boolean
        Move (Lowercase(Trim(sType))) to sType
        Function_Return (sType = "pointer" or sType = "address")
    End_Function

    // Case-insensitive membership test. asNames already holds lowercased names.
    Function NameInArray String[] asNames String sName Returns Boolean
        Integer iCount iMax
        Move (Lowercase(Trim(sName))) to sName
        Move (SizeOfArray(asNames)) to iMax
        Decrement iMax
        For iCount from 0 to iMax
            If (asNames[iCount] = sName) ;
                Function_Return True
        Loop
        Function_Return False
    End_Function

    // Append a name (lowercased, non-blank) to a name set.
    Procedure AddName String[] ByRef asNames String sName
        Move (Lowercase(Trim(sName))) to sName
        If (sName <> "") ;
            Move sName to asNames[SizeOfArray(asNames)]
    End_Procedure

    // Parse a Procedure/Function signature (overstruck) and collect its Pointer/Address and
    // String PARAMETER names into the per-method sets. Parameters take the form
    // <Type> [ByRef|ByVal] <name> repeated; for a Function the list ends at "Returns". The
    // walk only acts on String / Pointer / Address type keywords and skips everything else
    // token-by-token, so decorators ("Global"), other types (Integer, UChar[], ...) and their
    // names stay harmlessly ignored. cWin64PointerTruncation overrides this with its own
    // second set, the 32-bit integer types.
    Procedure CollectParameters String sOverSignature String[] ByRef asPointerVars String[] ByRef asStringVars
        String[] asTokens
        Integer  iIdx iNum
        String   sTok sName

        Move (StrSplitToArray(Trim(sOverSignature), CS_S)) to asTokens
        Move (SizeOfArray(asTokens)) to iNum
        Move 2 to iIdx                              // skip Procedure|Function + the method name
        While (iIdx < iNum)
            Move (Lowercase(asTokens[iIdx])) to sTok
            If (sTok = "returns") ;
                Procedure_Return                    // a Function's return type follows - done
            If (sTok = "string" or sTok = "pointer" or sTok = "address") Begin
                Increment iIdx
                If (iIdx < iNum) Begin
                    If (Lowercase(asTokens[iIdx]) = "byref" or Lowercase(asTokens[iIdx]) = "byval") ;
                        Increment iIdx
                End
                If (iIdx < iNum) Begin
                    Move asTokens[iIdx] to sName
                    Increment iIdx
                    If (sTok = "string") ;
                        Send AddName (&asStringVars) sName
                    Else ;
                        Send AddName (&asPointerVars) sName
                End
            End
            Else Begin
                Increment iIdx
            End
        Loop
    End_Procedure

End_Class
